        "term": [
            {
                "speaker_id": "1",
                "transcription": "비용도 절약되고 좋을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.352
            },
            {
                "speaker_id": "1",
                "transcription": "저는 혼자라.",
                "sound_type": [
                    2
                ],
                "start": 1.362,
                "end": 2.277
            },
            {
                "speaker_id": "1",
                "transcription": "에휴 혼자일 때 이런 게 좀 아쉽죠.",
                "sound_type": [
                    2
                ],
                "start": 2.287,
                "end": 5.720
            },
            {
                "speaker_id": "1",
                "transcription": "가족이 오면 이렇게 푱푱푱푱 이렇게 자전거 타면서.",
                "sound_type": [
                    2
                ],
                "start": 5.730,
                "end": 10.168
            },
            {
                "speaker_id": "1",
                "transcription": "또 새로운 추억을 만들 수 있을 텐데.",
                "sound_type": [
                    2
                ],
                "start": 10.164,
                "end": 13.422
            },
            {
                "speaker_id": "1",
                "transcription": "그 부분이 조금 아쉽긴 하지만.",
                "sound_type": [
                    2
                ],
                "start": 13.432,
                "end": 16.140
            },
            {
                "speaker_id": "1",
                "transcription": "기동력 하나는 끝내줍니다.",
                "sound_type": [
                    2
                ],
                "start": 16.150,
                "end": 18.472
            },
            {
                "speaker_id": "1",
                "transcription": "아유 잔디 저쪽이나 좀 미리 깎지.",
                "sound_type": [
                    2
                ],
                "start": 18.483,
                "end": 22.644
            },
            {
                "speaker_id": "1",
                "transcription": "아이 저쪽에서 발 다 젖었는데.",
                "sound_type": [
                    2
                ],
                "start": 22.644,
                "end": 24.686
            },
            {
                "speaker_id": "1",
                "transcription": "아휴 그래도 잔디 깎는 냄새가 좋네요.",
                "sound_type": [
                    2
                ],
                "start": 24.696,
                "end": 29.904
            }
        ]
    },
    "summary": "가족이 같이 왔으면 저렇게 자전거를 타면서 새로운 추억을 만들 수 있을 텐데 그 부분은 조금 아쉽다.",
