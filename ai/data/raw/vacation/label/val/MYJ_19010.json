        "term": [
            {
                "speaker_id": "1",
                "transcription": "걈 식스 갖고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.690
            },
            {
                "speaker_id": "2",
                "transcription": "아 고렇게 2개 가지고",
                "sound_type": [
                    2
                ],
                "start": 1.700,
                "end": 3.052
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 두 동 갖고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 3.062,
                "end": 3.978
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1님은 텐트 많이 사보신 거 아니에요?",
                "sound_type": [
                    2
                ],
                "start": 3.988,
                "end": 5.902
            },
            {
                "speaker_id": "2",
                "transcription": "캠핑 처음 하셨으니까?",
                "sound_type": [
                    2
                ],
                "start": 5.912,
                "end": 6.992
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 예전에 이제 MSR 처음에 쓰다가 겨울에는 MSR 무터허바를 못 쓰겠더라고요 너무 추워서.",
                "sound_type": [
                    2
                ],
                "start": 7.002,
                "end": 16.908
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이제 몽벨 스텔라릿지로 가서",
                "sound_type": [
                    2
                ],
                "start": 16.918,
                "end": 21.000
            },
            {
                "speaker_id": "2",
                "transcription": "아 다 대부분 이렇게 좀 이렇게 미니멀한 거?",
                "sound_type": [
                    2
                ],
                "start": 21.010,
                "end": 24.409
            },
            {
                "speaker_id": "1",
                "transcription": "네 원래 백패킹으로 많이 가서",
                "sound_type": [
                    2
                ],
                "start": 24.419,
                "end": 26.523
            },
            {
                "speaker_id": "2",
                "transcription": "거의 백패킹만 하셨나 봐요.",
                "sound_type": [
                    2
                ],
                "start": 26.533,
                "end": 27.931
            },
            {
                "speaker_id": "1",
                "transcription": "네 백패킹만 하다가 오토 캠핑으로 넘어오니까 너무 편해가지고 오토 캠핑만 하게 되더라고요.",
                "sound_type": [
                    2
                ],
                "start": 27.941,
                "end": 34.281
            },
            {
                "speaker_id": "2",
                "transcription": "아니 백패킹이 진짜 좋긴 한데 너무 좋은데 어 그 올라간 것까지만 거기까지만 순간이동 했으면 좋겠어요.",
                "sound_type": [
                    2
                ],
                "start": 34.291,
                "end": 46.793
            },
            {
                "speaker_id": "2",
                "transcription": "아 그 너무 힘들어가지고",
                "sound_type": [
                    2
                ],
                "start": 46.803,
                "end": 50.413
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 기억들이 되게 크게 남더라고요 오토 캠핑보다 훨씬 더.",
                "sound_type": [
                    2
                ],
                "start": 50.423,
                "end": 54.700
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 힘들어야 기억에",
                "sound_type": [
                    2
                ],
                "start": 54.710,
                "end": 55.918
            },
            {
                "speaker_id": "2",
                "transcription": "힘들어야 기억에 많이 남고",
                "sound_type": [
                    2
                ],
                "start": 55.928,
                "end": 58.500
            }
        ]
    },
    "summary": "백패킹은 힘들지만 기억들이 되게 크게 남고 오토캠핑으로 넘어오니까 너무 편해서 오토 캠핑만하게 된다.",
