        "term": [
            {
                "speaker_id": "1",
                "transcription": "옆에 아주 고급스러운 건물이 있죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 2.496
            },
            {
                "speaker_id": "1",
                "transcription": "호텔 같아요 왠지.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.506,
                "end": 7.225
            },
            {
                "speaker_id": "1",
                "transcription": "아닐 수도 있고 자 그 유명한 카지노 몬테카를로 정문의 모습입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.235,
                "end": 14.653
            },
            {
                "speaker_id": "1",
                "transcription": "딴 이거 조형물 한번 보고요 같이.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.663,
                "end": 18.599
            },
            {
                "speaker_id": "1",
                "transcription": "아유 멋있게 생겼네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 18.609,
                "end": 26.227
            },
            {
                "speaker_id": "1",
                "transcription": "네 몬테카를로 카지노입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 26.237,
                "end": 33.235
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 큽니다 이렇게.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 33.245,
                "end": 34.565
            },
            {
                "speaker_id": "1",
                "transcription": "일단 안으로 들어왔고요.",
                "sound_type": [
                    2
                ],
                "start": 34.575,
                "end": 38.949
            },
            {
                "speaker_id": "1",
                "transcription": "제지하는 사람이 없으면 계속 사진을 찍어보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.959,
                "end": 46.537
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 화려하네요.",
                "sound_type": [
                    2
                ],
                "start": 46.547,
                "end": 50.552
            },
            {
                "speaker_id": "1",
                "transcription": "자 안의 모습 이런 모습들입니다.",
                "sound_type": [
                    2
                ],
