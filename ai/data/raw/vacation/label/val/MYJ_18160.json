        "term": [
            {
                "speaker_id": "1",
                "transcription": "애초에 눈이 많이 오면 할 수 있는게 없어 형.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 1.937
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 눈 보러 가는 거지 뭐.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 1.947,
                "end": 3.395
            },
            {
                "speaker_id": "3",
                "transcription": "눈 많이 오면 못 나가는거 아니야?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 3.405,
                "end": 5.102
            },
            {
                "speaker_id": "3",
                "transcription": "막 비행기 못 타고 그러면 어떡함?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 5.112,
                "end": 7.133
            },
            {
                "speaker_id": "1",
                "transcription": "거기는 눈이 녹긴 하잖아요 근데 다른데는 눈을 잘 안 치우니까",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 7.143,
                "end": 11.133
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 치워도 그거랑 똑같애 군대에서 그거랑 똑같애.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 11.143,
                "end": 14.836
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 쓱쓱쓱쓱 했는데 뒤에 보니까 바로 쌓여 있다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 14.846,
                "end": 18.372
            },
            {
                "speaker_id": "3",
                "transcription": "나 제설해본 적 없는데",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 18.382,
                "end": 19.662
            },
            {
