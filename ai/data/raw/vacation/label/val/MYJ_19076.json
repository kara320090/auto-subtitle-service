                    1,
                    2
                ],
                "start": 3.229,
                "end": 4.141
            },
            {
                "speaker_id": "2",
                "transcription": "네, 저희도 그때 바다 처음 갈 때였는데",
                "sound_type": [
                    1,
                    2
                ],
                "start": 4.151,
