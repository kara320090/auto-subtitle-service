                "start": 7.935,
                "end": 12.401
            },
            {
                "speaker_id": "2",
                "transcription": "처음에는 행님 보러 다녔었는데 바다",
                "sound_type": [
                    1,
                    2
                ],
                "start": 12.411,
                "end": 14.467
            },
            {
                "speaker_id": "3",
                "transcription": "내 찾으러 댕겼네.",
