                ],
                "start": 7.062,
                "end": 7.925
            },
            {
                "speaker_id": "4",
                "transcription": "아 그래도 벌써 3년째 바다 다니고 있지 않습니까 유튜브 보고",
                "sound_type": [
                    1,
                    2
