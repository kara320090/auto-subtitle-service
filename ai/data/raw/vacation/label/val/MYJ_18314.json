        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기가 산방산인데 엄청 높은 거 같아 가지고 찾아봤거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.205
            },
            {
                "speaker_id": "1",
                "transcription": "근데 300 몇 미터 정도 되고 오늘의 해가 지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.215,
                "end": 9.018
            },
            {
                "speaker_id": "1",
                "transcription": "오랫만에 왔는데 역시 제주는 정말 좋네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.028,
                "end": 12.281
            },
            {
                "speaker_id": "1",
                "transcription": "제주는 좀 서쪽이 볼 게 많더라고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 12.291,
                "end": 14.810
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 오늘 일정이 조금 많았어 가지고 다들 피곤해 하는데 오늘 이제 밝을 때 숙소를 갔다가 좀 쉬고 시장 가서 뭐 먹을거를 사서 오려고 했었는데 이제 시간이 너무 지체가 되서 바로 시장에 가가지고 먹을 걸 사서 숙소가서 저녁 먹고 좀 일찍 쉬려고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.820,
                "end": 34.088
            },
            {
                "speaker_id": "1",
                "transcription": "너무 좋다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 34.098,
                "end": 35.629
            },
