        "term": [
            {
                "speaker_id": "1",
                "transcription": "하노이에는 요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.523
            },
            {
                "speaker_id": "1",
                "transcription": "물건파는 행상분들이 길거리에 되게 많으시거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.533,
                "end": 4.605
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 좀 소심해가지고 그런 분들 한테 물건값을 좀 못 깎아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.615,
                "end": 8.920
            },
            {
                "speaker_id": "1",
                "transcription": "근대 저 같은 분들이 그런 분들 한테 물건 사시잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.930,
                "end": 12.030
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 딱 이렇게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.040,
                "end": 13.759
            },
            {
                "speaker_id": "1",
                "transcription": "누가 빵을 팔길래 샀어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.769,
                "end": 19.439
            },
            {
                "speaker_id": "1",
                "transcription": "근대 뭐가 분위기가 이상한 거야 그냥 봐도 적어 보이잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.449,
                "end": 35.577
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 보면 먹은 거거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.587,
                "end": 38.902
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 뭐 대놓고 먹인거지 요만큼 해서 15만동을 줬어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.912,
                "end": 47.714
            }
        ]
    },
    "summary": "하노이에는 길거리 행상분들이 되게 많으시다. 그러나 소심하고 물건값 못 깎는 겁 많은 사람들이 물건을 사면 호객행위 제대로 당하는 거다. 별로 안 되 보이는 빵을 15만동을 줬다. 한화로 약 8, 000원 되는 거 같다.",
