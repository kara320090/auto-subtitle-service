                ],
                "start": 0.000,
                "end": 0.942
            },
            {
                "speaker_id": "1",
                "transcription": "겨울 캠핑을 해보고 원래 있던 몽가2로 안 되겠더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.952,
                "end": 4.133
            },
            {
                "speaker_id": "1",
                "transcription": "그게 완전 안에는 모기장이고 다 뚫려있어가지고 공격형 텐트가 필요하겠다 싶어가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.133,
                "end": 9.330
            },
            {
                "speaker_id": "1",
                "transcription": "이게 되게 가성비 좋고 좋다고 들어서 사고 싶었는데 맨날 품절인 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.340,
                "end": 13.902
            },
            {
                "speaker_id": "1",
                "transcription": "최근에 한번 열렸는데 바로 구매를 해가지고 샀습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.912,
                "end": 17.506
            },
            {
                "speaker_id": "1",
                "transcription": "핑크를 갖고 싶어서 핑크를 샀는데 이거만 품절이 됐더라고요 또",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.506,
                "end": 20.949
            },
            {
                "speaker_id": "1",
                "transcription": "열어보려고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.959,
                "end": 22.018
            },
            {
                "speaker_id": "1",
                "transcription": "새거거든요.",
