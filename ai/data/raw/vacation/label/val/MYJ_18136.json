        "term": [
            {
                "speaker_id": "1",
                "transcription": "동해답네요 역시",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.899
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 마을분들이 더군다나 청소를 깨끗이 하고 다니시니까 어 위에 바닷가가 굉장히 깨끗해요.",
                "sound_type": [
                    2
                ],
                "start": 1.909,
                "end": 11.837
            },
            {
                "speaker_id": "1",
                "transcription": "으 뭐 해풍작용에 의해서 저런 자욱들이 막 생겼어요.",
                "sound_type": [
                    2
                ],
                "start": 11.847,
                "end": 17.127
            },
            {
                "speaker_id": "1",
                "transcription": "예 그런 것들이 더 신비롭고 자연스러워서 참 보기가 좋습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.137,
                "end": 22.122
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 결론은 여기 소원바위 울산 소원바위 뭐 유명한 아 울산 소원바위랜다 포항 소원바위 어 거기도 있고 또 어쨌든 간에 여기보면 포항도 유명한 데 많잖아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 22.132,
                "end": 36.660
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 호미곶이라던지 뭐 많이 있는데 소문난 데보다는 뭐 아직은 소문은 안 났지만 어 아기자기하게 꾸며 놓은 해상공원 비슷한 그런 산책길 트레킹을 하는 것도 참 좋습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 36.670,
                "end": 54.915
            },
            {
                "speaker_id": "1",
                "transcription": "이게 마을에 오니까 여기저기서 해초 수거하시는 분도 계시고 특이한 바위도 많고",
                "sound_type": [
                    1,
                    2
                ],
                "start": 54.925,
                "end": 65.140
            },
            {
                "speaker_id": "2",
                "transcription": "저 아저씨는 뭐 하는 걸까?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 65.150,
                "end": 66.811
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 해초 잡는 것 같애.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 66.821,
                "end": 68.209
            },
            {
                "speaker_id": "2",
                "transcription": "아까부터 계속 그 근데 물이 많이 들어온거거든 지금?",
                "sound_type": [
                    1,
