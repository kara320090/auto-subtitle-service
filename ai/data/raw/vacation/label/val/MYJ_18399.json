                    2
                ],
                "start": 14.931,
                "end": 17.704
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 퀄리티가 너무 안 좋아.",
                "sound_type": [
                    2
                ],
                "start": 17.714,
                "end": 20.108
            },
            {
                "speaker_id": "2",
                "transcription": "깎을 필요가 없겠어.",
