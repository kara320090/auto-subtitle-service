        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기 라탄백들이 벌써 시작했다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.896
            },
            {
                "speaker_id": "1",
                "transcription": "우와 신발 진짜 많다.",
                "sound_type": [
                    2
                ],
                "start": 1.906,
                "end": 3.362
            },
            {
                "speaker_id": "2",
                "transcription": "진짜 같이 생겼네?",
                "sound_type": [
                    2
                ],
                "start": 3.372,
                "end": 4.621
            },
            {
                "speaker_id": "1",
                "transcription": "짭이야 짭 여기는 다 짝퉁이라고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.631,
                "end": 8.964
            },
            {
                "speaker_id": "2",
                "transcription": "얼굴이 너무 커서 안 들어가나?",
                "sound_type": [
                    2
                ],
                "start": 8.974,
                "end": 11.392
            },
            {
                "speaker_id": "2",
                "transcription": "맞아?",
