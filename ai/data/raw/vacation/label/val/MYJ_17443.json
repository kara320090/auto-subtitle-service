        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 마요르카의 날씨죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.221
            },
            {
                "speaker_id": "1",
                "transcription": "네 지금 개별 자유 여행하는 사람들은 저렇게 걸어서 가고 있죠.",
                "sound_type": [
                    2
                ],
                "start": 5.231,
                "end": 19.096
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 인제 저희가 타게 될 제가 타게 될 버스들 여기 쫙 전시하여 서 있죠?",
                "sound_type": [
                    2
                ],
                "start": 19.106,
                "end": 27.683
            },
            {
                "speaker_id": "1",
                "transcription": "오 알사 버스가 와있네?",
                "sound_type": [
                    2
                ],
                "start": 27.693,
                "end": 30.035
            },
            {
                "speaker_id": "1",
                "transcription": "네 이런 게 이제 기항지 투어 버스가 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.045,
                "end": 35.051
            },
            {
                "speaker_id": "1",
                "transcription": "너무 이쁘죠?",
                "sound_type": [
                    2
                ],
                "start": 35.061,
                "end": 38.323
            },
            {
                "speaker_id": "1",
                "transcription": "이게 아까 버스에서 봤을 때는 더 이뻤어요.",
                "sound_type": [
                    2
                ],
                "start": 38.333,
                "end": 44.731
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 설명이 필요 없고 조용히 발데모사 곳곳을 걸어다니도록 하겠습니다.",
                "sound_type": [
                    2
