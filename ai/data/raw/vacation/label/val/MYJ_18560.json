        "term": [
            {
                "speaker_id": "1",
                "transcription": "산방산을 완전히 벗어났구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 19.091
            },
            {
                "speaker_id": "1",
                "transcription": "30분쯤 달렸는데 아직도 돌고래가 나타나지 않네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.101,
                "end": 26.915
            },
            {
                "speaker_id": "1",
                "transcription": "돌고래를 찾았다는데 방금 찾았다고 하셨는데 안 보이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.925,
                "end": 34.975
            },
            {
                "speaker_id": "1",
                "transcription": "내려가 볼까나.",
                "sound_type": [
                    2
                ],
                "start": 34.985,
                "end": 36.979
            },
            {
                "speaker_id": "2",
                "transcription": "오른쪽 보세요 바위 있는 오른 쪽 보시면 돼요.",
                "sound_type": [
                    2
                ],
                "start": 36.989,
                "end": 41.815
            },
            {
                "speaker_id": "1",
                "transcription": "바위 있는 데 돌고래 있다.",
