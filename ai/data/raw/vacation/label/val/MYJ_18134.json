                    2
                ],
                "start": 16.504,
                "end": 36.005
            },
            {
                "speaker_id": "4",
                "transcription": "근데 사실 그걸 제가 잘 몰랐었는데 소원바위 뒤에 소원바위라는 그 팻말이 붙어 있어 가지고 어저께 게스트 예약해 가지고 바로 지금 내려왔네요.",
                "sound_type": [
