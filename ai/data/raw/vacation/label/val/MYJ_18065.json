        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 앞으로는 방파제 쪽에서는 낚시 하시는 분들이 되게 많아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.198
            },
            {
                "speaker_id": "1",
                "transcription": "근데 지금은 시간이 뭐 이 전부 물이 빠져 가지고 고기가 하나도 안 잡혀 이거.",
                "sound_type": [
                    2
                ],
                "start": 5.208,
                "end": 15.589
            },
            {
                "speaker_id": "1",
                "transcription": "여기 있잖아 청각.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.599,
                "end": 17.399
            },
            {
                "speaker_id": "1",
                "transcription": "와 엄청 많네 청각이.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.409,
                "end": 29.777
            },
            {
                "speaker_id": "1",
                "transcription": "와 여기는 고성치고는 고성에서는 사람이 별로 없던데 여기는 되게 많네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.787,
                "end": 41.351
            },
            {
                "speaker_id": "1",
                "transcription": "뭐가 나올까?",
                "sound_type": [
                    2
                ],
                "start": 41.361,
                "end": 42.314
            },
            {
                "speaker_id": "1",
                "transcription": "여기 조개 나올까요?",
                "sound_type": [
                    2,
                    5
                ],
