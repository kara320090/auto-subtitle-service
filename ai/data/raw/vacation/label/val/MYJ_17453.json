        "term": [
            {
                "speaker_id": "1",
                "transcription": "사람이 그렇게 많아 보이지는 않네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 1.814
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 여기 온 이유는 이것 때문이죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 1.824,
                "end": 4.534
            },
            {
                "speaker_id": "1",
                "transcription": "이 이누시케의 모습을 담기 위해서입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 4.544,
                "end": 8.700
            },
            {
                "speaker_id": "1",
                "transcription": "네 저기가 구시가거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.710,
                "end": 20.145
            },
            {
                "speaker_id": "1",
                "transcription": "칸의 구시가지고 이따가 저기까지 갔다가 탄도보트 선착장으로 갈 겁니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.155,
                "end": 31.859
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 좀 서둘러야 해요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 31.869,
                "end": 32.920
            },
            {
                "speaker_id": "1",
                "transcription": "이제 1시간 정도밖에 안 남았거든요 탄도보트 타는 시간이.",
                "sound_type": [
                    1,
                    2
                ],
