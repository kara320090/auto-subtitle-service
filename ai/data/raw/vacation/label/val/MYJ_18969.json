        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 과정을 그것도 캠핑의 과정으로 즐기시는 것",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.810
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 여기 음주 좀 많이 하는 사람은 없는 거 같죠.",
                "sound_type": [
                    2
                ],
                "start": 2.824,
                "end": 6.400
            },
            {
                "speaker_id": "1",
                "transcription": "떠드시는 분도 못 봤고",
                "sound_type": [
                    2
                ],
                "start": 6.470,
                "end": 7.790
            },
            {
                "speaker_id": "2",
                "transcription": "그러게.",
                "sound_type": [
                    2
                ],
                "start": 7.840,
                "end": 8.360
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 술을 늦게까지 드시는 분도 못 본 것 같고",
                "sound_type": [
                    2
                ],
                "start": 8.377,
                "end": 10.840
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 완전 좀 일찍 자고 그냥 새벽까지 일어나가지고",
                "sound_type": [
                    2
                ],
                "start": 10.990,
                "end": 14.490
            },
            {
                "speaker_id": "1",
                "transcription": "캠핑이라 해야 되나 불건전하는 건 아닌데 술 드시는 게 물론 즐기러 가는 거니까 아 예.",
                "sound_type": [
                    2
                ],
                "start": 14.680,
                "end": 20.592
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 저는 다른 게 사실 저도 @이름1와 비슷한 마인드인 게 엄청 뭔가 다른 게 쫌 있겠지라고 생각했는데 어 밀키트 자판기 있는 거 하나",
                "sound_type": [
                    2
                ],
                "start": 20.600,
                "end": 31.145
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 뭐 그런 거 몇 가지 빼고는 아 아까 남자 샤워실에 온천 있는 거 어 그런 거 빼고는 거의 비슷한 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 31.155,
                "end": 39.370
            },
            {
                "speaker_id": "2",
                "transcription": "크게 다르진 않아. 근데 잔잔하게 좀 성숙한 느낌이",
                "sound_type": [
                    2
                ],
                "start": 39.450,
                "end": 42.960
            },
            {
                "speaker_id": "1",
                "transcription": "예쁘고",
                "sound_type": [
                    2
                ],
                "start": 43.100,
                "end": 43.584
            },
            {
                "speaker_id": "2",
                "transcription": "에 어",
                "sound_type": [
                    2
                ],
                "start": 43.594,
                "end": 44.910
            },
            {
                "speaker_id": "1",
                "transcription": "나무가 좀 예쁘고 일본 어딜 캠핑장을 가나 휴지나 이런 게 항상 떨어져 있지 않고",
                "sound_type": [
                    2
                ],
                "start": 44.910,
                "end": 50.200
            },
            {
                "speaker_id": "2",
                "transcription": "어 그것도 맞다.",
                "sound_type": [
                    2
                ],
                "start": 50.310,
                "end": 51.450
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 한국은 다 치워 놓잖아요 가져가 버리시는 분도 있고 막 이러니까.",
                "sound_type": [
                    2
                ],
                "start": 51.560,
                "end": 55.356
            },
            {
                "speaker_id": "1",
                "transcription": "다 구비가 잔뜩 되어 있더라고 근데 그거 빼고는 비슷한 것 같아요.",
                "sound_type": [
