                    2
                ],
                "start": 17.462,
                "end": 18.836
            },
            {
                "speaker_id": "1",
                "transcription": "알지 알지 대전갈 때 맨날 저거서 지나가면서 63빌딩 사진 찍고.",
                "sound_type": [
                    2
