        "term": [
            {
                "speaker_id": "1",
                "transcription": "여름 캠핑 시원하게 하는 노하우가 있어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.851
            },
            {
                "speaker_id": "2",
                "transcription": "일단 계곡으로 가서 텐트를 딱 치고 바로 계곡으로 뛰어 들어가야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.861,
                "end": 5.353
            },
            {
                "speaker_id": "2",
                "transcription": "바로 뛰어들고 놀고 나와서 샤워하고 딱 있으면 아 그게 최고예요 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.363,
                "end": 11.307
            },
            {
                "speaker_id": "1",
                "transcription": "음 아 다들 이제 웬만하면 계곡으로 가고 샤워하고 땀 나자마자 바로 샤워하고 그냥 누워있고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.317,
                "end": 18.103
            },
            {
                "speaker_id": "2",
                "transcription": "맞아 그게 그게 최고인 것 같아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.113,
                "end": 19.449
            },
            {
                "speaker_id": "1",
                "transcription": "의견을 쫙 들어봤는데 역시 우리 대원님들은 이 어떤 뭐랄까 자연적인 거 그니까 인위적이지 않은 것들을 좋아하시는 것 같아",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.459,
                "end": 27.931
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.941,
                "end": 34.932
            },
            {
                "speaker_id": "3",
                "transcription": "그게 뭐라고 그러지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.942,
                "end": 36.209
            },
            {
                "speaker_id": "4",
                "transcription": "나 나중에 나 나가 클",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.219,
                "end": 40.250
            }
        ]
    },
