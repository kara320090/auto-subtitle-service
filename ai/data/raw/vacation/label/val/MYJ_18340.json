        "term": [
            {
                "speaker_id": "1",
                "transcription": "짜잔.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.186
            },
            {
                "speaker_id": "1",
                "transcription": "풍선이에요 풍선.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.196,
                "end": 2.950
            },
            {
                "speaker_id": "1",
                "transcription": "어? 잠깐만 잘못 왔잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.960,
                "end": 5.108
            },
            {
                "speaker_id": "1",
                "transcription": "뭐지? 나 주문 잘못했나? 헐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.118,
                "end": 7.500
            },
            {
                "speaker_id": "1",
                "transcription": "내가 주문을 잘 못했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.510,
                "end": 9.076
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이거는 해피뉴이어 이게 왔거든요? 저는 분명히 저는 메리 크리스마스를 했는데 왜.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.086,
                "end": 16.816
            },
            {
                "speaker_id": "1",
                "transcription": "이게 너무 옵션이 많아서 제가 헷갈렸나 봐요. 해피뉴이어가 왔는데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.826,
                "end": 21.456
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 지금 12월 6일인데 벌써 하기에는 좀 그렇긴 한데 그냥 이걸로 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.466,
                "end": 28.444
            },
            {
                "speaker_id": "1",
                "transcription": "요기 위쪽에 이걸로 꾸며보려고 하거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.454,
                "end": 32.484
            },
            {
                "speaker_id": "1",
                "transcription": "저 이런 거 한 번도 안 해봐 가지고 어떻게 하는지 모르는데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.494,
                "end": 35.793
            },
            {
                "speaker_id": "1",
                "transcription": "일단 빨대가 들어있고 끈인 것 같아요 끈. 이제 요것들이 풍선인가 봐요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.803,
                "end": 42.189
            },
            {
                "speaker_id": "1",
                "transcription": "오 뭐야. 왜 이렇게 커. 엄청 큰데? 글자 하나가 이만해. 오 크다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.199,
                "end": 49.191
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 다 언제 불고 있어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.201,
                "end": 51.806
            },
            {
                "speaker_id": "1",
                "transcription": "고난이 예상이 되는 가운데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.816,
                "end": 54.385
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 하는 걸까? 아 이거 풍선은 그냥 네이버에 헬륨풍선 뭐 이런 식으로 검색 해가지고 제일 순위 높은 데서 주문했어요. 어떻게 하는 거야 근데? 여기에 그냥 넣나? 집어넣어 빨대를.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.395,
                "end": 68.320
            }
        ]
    },
    "summary": "헬륨풍선으로 검색해서 제일 순위 높은 데서 구매를 했는데 메리 크리스마스를 주문했는데 해리뉴이어로 옵션을 잘못 선택했다.",
