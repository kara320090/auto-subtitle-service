        "term": [
            {
                "speaker_id": "1",
                "transcription": "맛있는 음식 다 해 먹을 수 있는 어차피 여기 강 한가운데 호수 한가운데니까 그런 어떤 장점들도 다 가져왔고 그다음에 이 백패킹에서는 백패킹 어떤 약간 모험의 느낌이 나잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.104
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 오토 캠핑은 뭐 모험 느낌 하나도 안 나지.",
                "sound_type": [
                    2
                ],
                "start": 11.114,
                "end": 17.150
            },
            {
                "speaker_id": "1",
                "transcription": "노지를 가더라도 다 어차피 남이 찾은 노지 검색해서 가거나 그런 느낌이잖아요 다.",
                "sound_type": [
                    2
                ],
                "start": 17.160,
                "end": 22.895
            },
            {
                "speaker_id": "1",
                "transcription": "근데 백패킹은 모험 느낌 난단 말이에요.",
                "sound_type": [
                    2
                ],
                "start": 22.905,
                "end": 25.100
            },
            {
                "speaker_id": "1",
                "transcription": "막 숲도 헤치고 등산도 하고 근데 그것도 다 등산로 정해진 길 간단 말이에요.",
                "sound_type": [
                    2
                ],
                "start": 25.110,
                "end": 30.475
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거는 완전 자유도가 이거는 진짜 대모험 느낌이에요 대모험.",
                "sound_type": [
                    2
                ],
                "start": 30.485,
                "end": 36.185
            },
            {
                "speaker_id": "1",
                "transcription": "오토 캠핑이 모험 느낌 주는 게 한 1점이다.",
                "sound_type": [
                    2
                ],
                "start": 36.195,
                "end": 39.580
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 백패킹은 10점 되거든요.",
                "sound_type": [
                    2
                ],
                "start": 39.590,
                "end": 41.256
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 한 1000점 그 정도예요 진짜.",
                "sound_type": [
                    2
                ],
                "start": 41.266,
                "end": 43.591
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 너무 반해버리네.",
                "sound_type": [
                    2
                ],
                "start": 43.601,
                "end": 45.205
            },
            {
                "speaker_id": "1",
                "transcription": "하 솔직히 저 지금 가지고 있는 텐트들 엔간한 거 다 팔고 배 좀 사고 싶어요 더.",
                "sound_type": [
                    2
                ],
                "start": 45.215,
                "end": 50.133
            }
        ]
    },
    "summary": "오토 캠핑이 모험 느낌 주는 게 한 1점이면 백패킹은 10점 되고 얘는 한 1000점 정도라서 가지고 있는 텐트들 엔간한 거 다 팔고 배 좀 사고 싶다.",
