                    4,
                    5
                ],
                "start": 16.021,
                "end": 28.533
            },
            {
                "speaker_id": "1",
                "transcription": "여행이라는 게 뭐 항상 느꼈지만 참 그런 게 있는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 28.543,
                "end": 33.570
            },
            {
                "speaker_id": "1",
                "transcription": "사람들도 참 다 좋고 그리고 좋은 인연들 또 만나서 이야기도 하고 대화도 하고 야 해무 봐.",
                "sound_type": [
