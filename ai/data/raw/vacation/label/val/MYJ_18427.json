        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 한국말로 나와 바나힐",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.621
            },
            {
                "speaker_id": "1",
                "transcription": "케이블카를 타러 가고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.631,
                "end": 36.281
            },
            {
                "speaker_id": "1",
                "transcription": "하이 산포에 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.291,
                "end": 39.340
            },
            {
                "speaker_id": "1",
                "transcription": "해산물 식당 밑에 엄청 많이 왔어.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 39.350,
                "end": 49.759
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 커.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.769,
                "end": 51.092
            },
            {
                "speaker_id": "1",
                "transcription": "해물볶음밥",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.102,
                "end": 58.423
            },
            {
                "speaker_id": "2",
                "transcription": "날씨가 이러니까 더 좋은 거 같애.",
                "sound_type": [
                    2
                ],
                "start": 58.433,
                "end": 62.824
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하세요 저 오늘 다낭 7일째입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.834,
                "end": 68.016
            },
            {
                "speaker_id": "1",
                "transcription": "내일 한국 가고 오늘이 거의 노는 거는 마지막 날이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 68.026,
                "end": 72.045
            },
            {
                "speaker_id": "1",
                "transcription": "이제 호텔에서 체크아웃하고 지금 포피스 피자에 피자를 먹으러 가고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 72.055,
                "end": 77.301
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 막 아프고 컨디션도 안 좋고 그래서 촬영을 많이 못 한 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 77.311,
                "end": 83.249
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 좀 열심히 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 83.259,
                "end": 88.417
            },
            {
                "speaker_id": "1",
                "transcription": "2층으로 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 88.427,
                "end": 90.844
            },
            {
                "speaker_id": "1",
                "transcription": "안에 게살 있어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 90.854,
                "end": 92.470
            },
            {
                "speaker_id": "1",
                "transcription": "게살 많네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 92.480,
                "end": 94.600
            }
        ]
    },
    "summary": "여성이 바나힐에 있는 세계에서 두 번째로 긴 케이블카를 타고 관광을 한 뒤 하이 산포 해산물 식당에서 식사를 하고 한국으로 돌아가기 마지막 날에 포피스 피자집으로 식사를 하러 가고 있습니다.",
