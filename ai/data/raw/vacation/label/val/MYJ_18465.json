        "term": [
            {
                "speaker_id": "1",
                "transcription": "싱가폴이 같은 건물 모양으로 짓는 거를 법으로 금지를 시키고 있대요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 24.206
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 건물 모양들이 되게 다양하고 멋있는 건물들도 진짜 많은 것 같아요.",
                "sound_type": [
