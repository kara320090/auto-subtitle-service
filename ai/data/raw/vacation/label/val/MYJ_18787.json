    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "가을에도 밤이 깊어지면 꽤 쌀쌀해지고 거기다가 이제 숲 속은 좀 더 추우니까 많이들 이제 사용하시는 용품 두 개를 가져 왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.472
            },
            {
                "speaker_id": "1",
                "transcription": "반사식 난로 그리고 온풍기 아 근데 이제 얘네 둘은 장단이 확실해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.482,
                "end": 13.609
            },
            {
                "speaker_id": "1",
                "transcription": "저는 반사식 난로 한 이삼 년 전 전부터 이제 구입을 해 가지고 쓰고 있는데 아 얘는 조금 특수한 분들한테 추천을 드리고 싶은 게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.619,
                "end": 23.583
            },
            {
                "speaker_id": "1",
                "transcription": "사실은 이 난로를 사용할 시간이 애초에 한 가을에 요때 4주?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.593,
                "end": 29.341
            },
            {
                "speaker_id": "1",
                "transcription": "고정도 밖에 없거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.351,
                "end": 31.086
            },
            {
                "speaker_id": "1",
                "transcription": "사실 11월만 돼도 이거보다 이제 더 큰 옴니 같은 등유난로를 들고 다녀도 이제 전혀 아깝지 않은 그런 계절이기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.096,
                "end": 38.277
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 사용할 수 있는 시간이 4주 밖에 없는데 우리 대부분 이제 캠핑을 저 같이 매주 나가는 사람이라면 또 모르겠는데 뭐 한 달에 한두 번 정도 간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.287,
                "end": 47.916
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 1년에 봄 가을 두 달 중에 한 두 번 내지 한 네 번?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.926,
                "end": 52.438
            },
            {
                "speaker_id": "1",
                "transcription": "고정도 쓰자고 얘를 구입하기에는 아 솔직히 좀 모르겠어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.448,
                "end": 57.810
            },
            {
                "speaker_id": "1",
                "transcription": "사실 밤에 좀 추워지는 거지 그렇게 안 춥잖아요 밤에도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.820,
                "end": 62.184
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 코가 시려울 정도 아니니까 그래서 들고 왔다가 아 좀 아닌가 귀찮은데 그냥 꺼내지 말까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.194,
                "end": 69.158
            },
            {
                "speaker_id": "1",
                "transcription": "이런 적도 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.168,
                "end": 70.532
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 얘는 진짜 캠핑 빡세게 가시는 분들 아니면 거의 노지로만 간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.542,
                "end": 76.391
            },
            {
                "speaker_id": "1",
                "transcription": "이런 분들 전기가 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.401,
                "end": 78.221
            },
            {
                "speaker_id": "1",
                "transcription": "이런 분들만 좀 구입해서 쓰시면은 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.231,
                "end": 82.209
            },
            {
                "speaker_id": "1",
                "transcription": "아 그렇지 않으면 너무 아까워서 그리고 방금 말씀드린 분에 해당하지 않은 분들 그런 분들은 차라리 그냥 조금 이거보다 좀 멋은 좀 떨어질지 몰라도",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.219,
                "end": 91.575
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 요런 그 온풍기?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 91.585,
                "end": 94.160
            },
            {
                "speaker_id": "1",
                "transcription": "온풍기 하나 사 가지고 다니시는 게 차라리 나은 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 94.170,
                "end": 96.894
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 웬만하면 뭐 안 틀어도 되는데 가을에는 요거 되게 작아서 차에도 쏙 들어가거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 96.904,
                "end": 102.424
            },
            {
                "speaker_id": "1",
                "transcription": "차에 그냥 하나 넣어 놓고 너무 춥다 그럴 때만 이너 텐트 같은 데 안에만 쏙 틀어 놓고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 102.434,
                "end": 108.041
            }
        ]
    },
    "summary": "반사식 난로 그리고 온풍기는 장단이 확실해서 저는 반사식 난로는 특수한 분들한테 추천을 드리고 싶어요.",
