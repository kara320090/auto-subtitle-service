                    2,
                    3
                ],
                "start": 3.819,
                "end": 5.732
            },
            {
                "speaker_id": "1",
                "transcription": "약간 컨셉이 전쟁 그런 건가 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.742,
                "end": 8.663
            },
            {
                "speaker_id": "1",
                "transcription": "드디어 그 유명한 콩카페에 왔습니다.",
