        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 근데 나 너무 좋아 나 진짜 나도 이런거 여기 제일 와 보고 싶었어.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.658
            },
            {
                "speaker_id": "1",
                "transcription": "선인장 종류도 와 진짜 크다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.668,
                "end": 9.051
            },
            {
                "speaker_id": "1",
                "transcription": "와 신기하다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.061,
                "end": 12.671
            },
            {
                "speaker_id": "1",
                "transcription": "이파리가 쟁반 같아.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.681,
                "end": 15.593
            },
            {
                "speaker_id": "2",
                "transcription": "하트모양같아.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.603,
                "end": 18.137
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 너무 너무 너무 진짜 예술이다 와.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.147,
                "end": 22.478
            },
            {
                "speaker_id": "1",
                "transcription": "여기가 클라우드 돔인데 안에보면 폭포가 흐르고 있어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.488,
                "end": 27.616
            },
            {
                "speaker_id": "1",
                "transcription": "인공폭포 여기 들어가려면 유료입장을 해야 되는데 지금 여길 갈지 말지 생각을 하고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.626,
                "end": 33.596
            },
            {
                "speaker_id": "1",
                "transcription": "들어가면 꽤 멋있을것 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 33.606,
                "end": 37.026
            },
            {
                "speaker_id": "1",
                "transcription": "기프트샵에 왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 37.036,
                "end": 38.684
            },
            {
                "speaker_id": "1",
                "transcription": "이것저것 뭐 많이 팔고 있어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 38.694,
                "end": 40.604
            },
            {
                "speaker_id": "1",
                "transcription": "이런것도 너무 예뻐요.",
                "sound_type": [
                    2,
                    4
                ],
