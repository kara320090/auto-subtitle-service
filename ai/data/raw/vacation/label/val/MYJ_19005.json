        "term": [
            {
                "speaker_id": "1",
                "transcription": "진행되면서 향후에 같이 일을 참여하실 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.937
            },
            {
                "speaker_id": "1",
                "transcription": "회사 들어오실 것 같아요 저희 회사에.",
                "sound_type": [
                    2
                ],
                "start": 3.947,
                "end": 5.521
            },
            {
                "speaker_id": "2",
                "transcription": "아 진짜요?",
                "sound_type": [
                    2
                ],
                "start": 5.531,
                "end": 6.566
            },
            {
                "speaker_id": "1",
                "transcription": "하시다가 재미있다고 그러니까 거의 뭐 뭐 대원님도 그렇고 저희 나이 들면 그냥 회사 다니잖아요.",
                "sound_type": [
                    2
                ],
                "start": 6.576,
                "end": 12.948
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그거 같이 기획하고 진행하고 개발하시면서 대학교 때 같은 느낌을 받았다.",
                "sound_type": [
                    2
                ],
                "start": 12.958,
                "end": 20.752
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 회사에 가면은 사실은 자기 일 한다는 느낌을 못 받죠.",
                "sound_type": [
                    2
                ],
                "start": 20.762,
                "end": 24.955
            },
            {
                "speaker_id": "2",
                "transcription": "그런 게 없죠.",
                "sound_type": [
                    2
                ],
                "start": 24.965,
                "end": 25.897
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 오랜만에 이게 열정적으로 일 했다 그런 기분이 들었다라고 하시면서 아마 저희 뭐 개발하시고 하시는 분들 곧 조인하실 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 25.907,
                "end": 36.916
            }
        ]
    },
    "summary": "화자3은 개발하시는 분들이 대학교 때의 열정적인 느낌을 받았다며 향후에는 조인하실 것 같다고 말한다.",
