        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쫌 신기했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.760
            },
            {
                "speaker_id": "1",
                "transcription": "이 시간에 불을",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.760,
                "end": 2.630
            },
            {
                "speaker_id": "2",
                "transcription": "아 그리고 근데 저는 인제 오기 전에는 약간 좀 그런 걸 생각했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.640,
                "end": 6.977
            },
            {
                "speaker_id": "2",
                "transcription": "그까 나는 좀 그 멋 부리는 게 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.987,
                "end": 10.830
            },
            {
                "speaker_id": "1",
                "transcription": "아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.840,
                "end": 11.840
            },
            {
                "speaker_id": "2",
                "transcription": "어 난 저는 그럴 줄 알았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.910,
                "end": 14.024
            },
            {
                "speaker_id": "2",
                "transcription": "근데 아 근데 그거는 실제로 좀 그런 것 같기도 한데 그 우리도 우리처럼 이제 막 좀 유튜브를 한다거나 인스타를 한다거나 이런 사람들이 각을 잡는 거지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.034,
                "end": 24.970
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.050,
                "end": 25.550
            },
            {
                "speaker_id": "2",
                "transcription": "일반 캠핌장 가면 안 그러잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.620,
                "end": 27.261
            },
            {
                "speaker_id": "1",
                "transcription": "그러긴 하죠 근데 근데 제가 느꼈을 때 대부분 이제 한국 캠핑장 가면 옛날에 그 우리 캠핑 좋아하시는 분들이 하는 말이 저 봐 저 봐 각 봐라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.271,
                "end": 35.841
            },
            {
                "speaker_id": "1",
                "transcription": "그까 각 봐라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.851,
                "end": 37.770
            },
            {
                "speaker_id": "1",
                "transcription": "저거 하수다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.780,
                "end": 38.990
            },
            {
                "speaker_id": "1",
                "transcription": "어 그까 하수, 고수의 기준을 약간 텐션을 많이 이제 부여를 하시는 것 같아요 타프나 뭐 이런 것도 그렇고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.999,
                "end": 45.670
            },
            {
                "speaker_id": "2",
                "transcription": "네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.730,
                "end": 46.093
            },
            {
                "speaker_id": "1",
                "transcription": "그러 내일 뭐 저는 많이 들었거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.103,
                "end": 48.308
            },
            {
                "speaker_id": "1",
                "transcription": "그 아저씨들이 막 우주캠 하실 때 옆 사이트 보시고 막 내일 무너진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.318,
                "end": 52.370
            },
            {
                "speaker_id": "1",
                "transcription": "저 각 봐라 하면서 막 이러셨는데 여기는 다 진짜 무너지기 직전 상태로 쳐놓으신 분들이 많더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.382,
                "end": 57.590
            },
            {
                "speaker_id": "2",
                "transcription": "그럼 그건 그걸 수 있겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.700,
                "end": 59.080
            },
            {
                "speaker_id": "2",
                "transcription": "여기 일본은 취미들이 다 오래됐잖아 그니까 우리나라처럼 그냥 그니까 논리를 별로 펼치지 않고 그냥 빵빵한 거 이런 거 보다는 그냥 오래 캠핑을 해보니",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.220,
                "end": 69.640
            },
            {
                "speaker_id": "1",
                "transcription": "흐름을 맡기는 경험상",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.700,
                "end": 71.190
            },
            {
                "speaker_id": "2",
                "transcription": "어 경험상 근데 경험상 꽤 논리적이고 되게 과학적인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.250,
                "end": 75.274
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 저도 지난번에 후진항 갔을 때 텐트들이 그때는 더 심하게 다 플렉시블하게 쳐져 있었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.284,
                "end": 81.270
            },
            {
                "speaker_id": "1",
                "transcription": "그 영상에 보면 이제 어 @이름1 캠핑이 영상에 나옵니다만 거기 보면 다 흐물흐물하게 서터스 텐트들도 쳐져 있고 했는데 그래야 안 부셔져진다고 그렇게 얘기하시더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.280,
                "end": 91.759
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 실제적으로 진짜 좀 경험이 다들 쫌 그래도 있고 그리고 눈에 보이는 거보다는 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.769,
                "end": 97.960
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 즐기시는 거 같아 저도 그걸 느꼈어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.020,
                "end": 100.250
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 아까 그 장작도 저희 나라는 다 쪼개서 나오잖아요 근데 이제 물론 안 쪼개진 것도 팔지만 여기는 아예 그냥 완전 산에서 팬 나무 같이 팔잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.330,
                "end": 110.880
            },
            {
                "speaker_id": "2",
                "transcription": "깔끔한 나무가 아니고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.990,
                "end": 112.250
            },
            {
                "speaker_id": "1",
                "transcription": "그거 준비를 그냥 즐기시는 거 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 112.330,
                "end": 114.791
            }
        ]
    },
    "summary": "일본 캠핑 문화는 한국의 유튜브나 인스타와 같은 멋 부리는 게 없다면서 오래 캠핑을 하다 보니 흐름을 맡기는 듯한 느낌이지만 논리적이고 텐트 설치에 있어서도 무너지기 직전 상태로 쳐놓는 것이 과학적이라고 언급했고 이곳 사람들은 캠핑에 대한 준비 과정을 즐기는 거 같다고 말한다.",
