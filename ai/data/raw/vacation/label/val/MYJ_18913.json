        "term": [
            {
                "speaker_id": "1",
                "transcription": "예쁜데 또 그렇게 비싸요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.175
            },
            {
                "speaker_id": "2",
                "transcription": "필드에 그럼 나가면은 저 안 쳐봤는데 막 옆에 사람들 보여요?",
                "sound_type": [
                    2
                ],
                "start": 2.175,
                "end": 6.205
            },
            {
                "speaker_id": "2",
                "transcription": "옆에 치고 다른 일행들?",
                "sound_type": [
                    2
                ],
                "start": 6.205,
                "end": 7.650
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지 그냥 실력이 보이는 게 아니라 그 사람은 잘치고 안치고 그걸 보이는 게 아니라 무슨 옷을 입었냐?",
                "sound_type": [
                    2
                ],
                "start": 7.650,
                "end": 13.200
            },
            {
                "speaker_id": "2",
                "transcription": "아",
                "sound_type": [
                    2
                ],
                "start": 13.200,
                "end": 13.695
            },
            {
                "speaker_id": "1",
                "transcription": "무슨 모자를 썼고 무슨 가방을 들고 약간 그런 게 좀 생겨요.",
                "sound_type": [
                    2
                ],
                "start": 13.695,
                "end": 17.792
            },
            {
                "speaker_id": "2",
                "transcription": "아 그러니까 골프에서는 골프웨어가",
                "sound_type": [
                    2
                ],
                "start": 17.795,
                "end": 19.642
            },
            {
                "speaker_id": "1",
                "transcription": "예",
                "sound_type": [
                    2
                ],
                "start": 19.642,
                "end": 20.075
            },
            {
                "speaker_id": "2",
                "transcription": "골프웨어가 돈이 훨씬 많이 들겠는데요? 하다보면",
                "sound_type": [
                    2
                ],
                "start": 20.075,
                "end": 22.547
            },
            {
                "speaker_id": "1",
                "transcription": "맞아요 그니까 이 제가 보니까 그 캠핑에서 뭐 텐트도 텐트지만 그 자질구레한 거 되게 살게 되게 많잖아요?",
                "sound_type": [
                    2
                ],
                "start": 22.547,
                "end": 29.862
            },
            {
                "speaker_id": "1",
                "transcription": "근데 근데 이게 골프웨어는 집으면은 20, 30만 원이다 보니까",
                "sound_type": [
                    2
                ],
                "start": 29.862,
                "end": 35.697
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 골프 들어가면 비싸지는구나?",
                "sound_type": [
                    2
                ],
                "start": 35.697,
                "end": 37.527
            },
            {
                "speaker_id": "1",
                "transcription": "골 자만 들어가면 다 비싸져요.",
