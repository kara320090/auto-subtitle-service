        "term": [
            {
                "speaker_id": "1",
                "transcription": "따님 분 안 보이시네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.117
            },
            {
                "speaker_id": "2",
                "transcription": "예?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.127,
                "end": 1.643
            },
            {
                "speaker_id": "1",
                "transcription": "안 보이셔 나이드신 분밖에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.653,
                "end": 26.622
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 여기도 화장실이 엄청 깨끗하고 관리가 잘 돼 있네요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 26.632,
                "end": 32.338
            },
            {
                "speaker_id": "1",
                "transcription": "그 안에는 진짜 최신식으로 다 해 놨어요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 32.348,
                "end": 35.627
            },
            {
                "speaker_id": "1",
                "transcription": "그 애기들 저기 수학 여행 오는 건가?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 35.637,
                "end": 39.039
            },
            {
                "speaker_id": "1",
                "transcription": "그 수학 여행을 왔는지 모래 사장에서 애들이 재밌게 잘 놀고 있네요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 39.049,
                "end": 45.019
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 약간 특이한 게 모래 사장하고 뻘하고 섞여 있어요.",
                "sound_type": [
                    1,
                    2,
                    3,
                    4
                ],
                "start": 45.029,
