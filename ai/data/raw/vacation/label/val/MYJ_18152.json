                ],
                "start": 0.000,
                "end": 3.637
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 2층으로 올라가는 길이 있습니다 2층으로 올라가는 길이 있구요 2층도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.647,
                "end": 7.813
            },
            {
                "speaker_id": "1",
                "transcription": "2층은 이제 더 넓어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.823,
                "end": 9.184
            },
            {
                "speaker_id": "1",
                "transcription": "더 넓게 카페 좌석이 이렇게 마련이 되있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.194,
                "end": 12.277
            },
            {
                "speaker_id": "1",
                "transcription": "와 상당하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.287,
                "end": 14.003
            },
            {
                "speaker_id": "1",
                "transcription": "정말 깔끔하게 돼 있고 창이 상당히 큽니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.013,
                "end": 17.628
            },
            {
                "speaker_id": "1",
                "transcription": "이게 양쪽으로 양 사이드로 창이 엄청 큰데",
