        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요 여러분.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.339
            },
            {
                "speaker_id": "1",
                "transcription": "저는 지금 뚝섬유원지에 와있는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.349,
                "end": 6.339
            },
            {
                "speaker_id": "1",
                "transcription": "제가 오늘 여길 왜 왔냐면 오늘 뚝섬유원지에서 농부의 시장이 열린다고 해서 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.349,
                "end": 12.139
            },
            {
                "speaker_id": "1",
                "transcription": "이 농부의 시장이 뭐냐면 각 지자체에서 엄선한 우수 농작물들을 시중가 대비해서 최대 30퍼센트 저렴하게 구매할 수 있는 도심 속 직거래 장터에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.149,
                "end": 24.311
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 우리 소비자들은 저렴하게 착한 소비를 할 수 있는 거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.321,
                "end": 29.036
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이따가 캠핑 갈 건데 캠핑 가서 먹을 것들 좀 사가지고 가려고 하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.046,
                "end": 34.467
            },
            {
                "speaker_id": "1",
                "transcription": "같이 가보시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.477,
                "end": 38.360
            }
        ]
    },
