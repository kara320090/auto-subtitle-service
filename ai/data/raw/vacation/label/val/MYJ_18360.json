        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분 서울 연희동에 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.138
            },
            {
                "speaker_id": "1",
                "transcription": "저는 뭐 촬영이 있어서 왔는데 제가 연희동은 처음 와 보는 거 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.148,
                "end": 8.921
            },
            {
                "speaker_id": "1",
                "transcription": "되게 동네가 예쁘고 되게 크고 좋은 집들 많아 보여요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.931,
                "end": 13.555
            },
            {
                "speaker_id": "1",
                "transcription": "저는 지금 스튜디오로 가고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.565,
                "end": 17.094
            },
            {
                "speaker_id": "1",
                "transcription": "되게 골목에 있어가지고 걸어가고 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.104,
                "end": 21.227
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 많이 춥진 않아서 다행입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.237,
                "end": 23.624
            },
            {
                "speaker_id": "1",
                "transcription": "촬영을 하러 가는데 얼굴이 별로 마음에 안 들어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.634,
                "end": 28.141
            },
            {
                "speaker_id": "1",
                "transcription": "저기인가?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.151,
                "end": 28.913
            },
            {
                "speaker_id": "1",
                "transcription": "저기 되게 뭔가 예뻐보이는 스튜디오 같은 곳이 보이는데 맞는 거 같애요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.923,
                "end": 34.569
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 들어가면 될까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.579,
                "end": 36.304
            },
            {
                "speaker_id": "1",
                "transcription": "이런 주택 스튜디오인가 봐요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.314,
                "end": 39.424
            },
            {
                "speaker_id": "1",
                "transcription": "여기 맞아?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.434,
                "end": 40.544
            },
            {
                "speaker_id": "1",
                "transcription": "아멜리 스튜디오 너무 예쁘다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.554,
                "end": 46.140
            },
            {
                "speaker_id": "1",
                "transcription": "이뻐요.",
                "sound_type": [
                    2,
