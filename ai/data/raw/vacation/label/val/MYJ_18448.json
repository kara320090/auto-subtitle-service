        "term": [
            {
                "speaker_id": "1",
                "transcription": "크리미한 맛이 나요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.920
            },
            {
                "speaker_id": "1",
                "transcription": "이건 뭘까요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.930,
                "end": 2.929
            },
            {
                "speaker_id": "1",
                "transcription": "이게 무슨 맛이지?",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 2.939,
                "end": 10.315
            },
            {
                "speaker_id": "1",
                "transcription": "어묵 같은 느낌인데 엄청 으깨져요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 10.325,
                "end": 13.943
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 맛있지는 않고 엄청 맛없지도 않아요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 13.953,
                "end": 17.448
            },
            {
                "speaker_id": "1",
                "transcription": "사진으로 봤을 때는 건물 하나 였는데",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 17.458,
                "end": 27.229
            },
            {
                "speaker_id": "1",
                "transcription": "제가 간 데는 이런 쇼핑센터 안에 있는 조그만 지점이었어요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 27.239,
                "end": 32.399
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이제 세븐일레븐을 찾아서 교통카드를 사고 다음장소로 이동 하려고요.",
                "sound_type": [
