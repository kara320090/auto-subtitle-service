            },
            {
                "speaker_id": "2",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "텐트 욕심이 많아요 제가",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.497
            },
            {
                "speaker_id": "2",
                "transcription": "지금 몇 동 있는데요?",
                "sound_type": [
                    2
                ],
                "start": 1.497,
                "end": 3.375
            },
            {
                "speaker_id": "1",
                "transcription": "하나, 둘, 셋, 네 개.",
                "sound_type": [
                    2
                ],
                "start": 3.375,
                "end": 5.945
            },
            {
                "speaker_id": "2",
                "transcription": "아 텐트 4개랑 뭐 잡다구리 막 용품들 막 의자 테이블 이런 거에?",
                "sound_type": [
                    2
                ],
                "start": 5.945,
                "end": 10.577
            },
            {
                "speaker_id": "1",
                "transcription": "네 근데 테이블도 하나 밖에 없고",
                "sound_type": [
                    2
                ],
                "start": 10.577,
                "end": 12.707
            },
            {
                "speaker_id": "2",
                "transcription": "벌써 돈 천만 원을 썼다고요?",
                "sound_type": [
                    2
                ],
                "start": 12.707,
                "end": 14.202
            },
            {
                "speaker_id": "1",
                "transcription": "그 선풍기처럼 생긴 거 있잖아요 난로 위에 올라가는 거 아까 그런 거",
                "sound_type": [
                    2
                ],
                "start": 14.202,
                "end": 18.180
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 너무 비싸더라고요.",
                "sound_type": [
                    2
                ],
                "start": 18.180,
                "end": 19.820
            },
            {
                "speaker_id": "2",
                "transcription": "저건 얼마인데요?",
                "sound_type": [
                    2
                ],
                "start": 19.822,
                "end": 21.177
            },
            {
                "speaker_id": "1",
                "transcription": "저 저거 한 35만원?",
                "sound_type": [
                    2
                ],
                "start": 21.177,
                "end": 22.702
            },
            {
                "speaker_id": "2",
                "transcription": "오 저것도 비싸네?",
                "sound_type": [
                    2
                ],
                "start": 22.702,
                "end": 24.000
            },
            {
                "speaker_id": "1",
                "transcription": "예.",
                "sound_type": [
                    2
                ],
                "start": 24.000,
                "end": 24.585
            },
            {
                "speaker_id": "2",
                "transcription": "아 그래 뭐 이것저것 해가지고 한 천만 원?",
                "sound_type": [
                    2
                ],
                "start": 24.585,
                "end": 26.742
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 26.742,
                "end": 27.085
            },
            {
                "speaker_id": "2",
                "transcription": "와 엄청 많이 썼다.",
                "sound_type": [
                    2
                ],
                "start": 27.085,
                "end": 28.225
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 난로도 있죠?",
                "sound_type": [
                    2
                ],
                "start": 28.225,
                "end": 29.440
            },
            {
                "speaker_id": "2",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 29.440,
                "end": 30.040
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이제 아까도 얘기했지만 겨울부터 시작하다 보니까 난로 동계 용품이 너무 비싸더라고요.",
                "sound_type": [
                    2
                ],
                "start": 30.040,
                "end": 36.280
            },
            {
                "speaker_id": "2",
                "transcription": "아 그렇지 그리고 겨울부터 시작했었으니까 용품을 많이 사야 되는구나.",
                "sound_type": [
                    2
                ],
                "start": 36.280,
                "end": 40.297
            },
            {
                "speaker_id": "1",
                "transcription": "네 처음에 구매를 해야 될 게 너무 많더라고요.",
                "sound_type": [
                    2
                ],
                "start": 40.297,
                "end": 42.695
            },
            {
                "speaker_id": "2",
                "transcription": "예 응.",
                "sound_type": [
                    2
                ],
                "start": 42.695,
                "end": 43.625
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 침대도 사실 에어 침대도 하나 사고",
                "sound_type": [
                    2
                ],
                "start": 43.625,
                "end": 48.380
            },
            {
                "speaker_id": "2",
                "transcription": "아 이 막 두꺼운 거 이만한 거?",
                "sound_type": [
                    2
                ],
                "start": 48.380,
                "end": 50.967
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 그것도 하나 사고 뭐 야전 침대도 거의 3개 가까이 있고?",
                "sound_type": [
                    2
                ],
                "start": 50.967,
                "end": 55.710
            },
            {
                "speaker_id": "2",
                "transcription": "와 진짜 4개월 동안 진짜 많이 샀네요?",
                "sound_type": [
                    2
                ],
                "start": 55.712,
                "end": 58.255
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 모르겠어요 그냥",
                "sound_type": [
                    2
                ],
                "start": 58.255,
                "end": 60.332
            },
            {
                "speaker_id": "1",
                "transcription": "하루종일 하는 게 쉴 때 마다 그 핸드폰 보면은",
                "sound_type": [
                    2
                ],
                "start": 60.332,
                "end": 63.247
            },
            {
                "speaker_id": "2",
                "transcription": "캠핑용품 검색하는 거?",
                "sound_type": [
                    2
                ],
                "start": 63.247,
                "end": 64.542
            },
            {
                "speaker_id": "1",
                "transcription": "네 너무 예쁜",
                "sound_type": [
                    2
                ],
                "start": 64.542,
                "end": 65.254
            },
            {
                "speaker_id": "2",
                "transcription": "인스타도 캠핑 봐요?",
                "sound_type": [
                    2
                ],
                "start": 65.254,
                "end": 67.250
            },
            {
                "speaker_id": "1",
                "transcription": "잘 보진 않는데",
                "sound_type": [
                    2
                ],
                "start": 67.250,
                "end": 68.540
            },
            {
                "speaker_id": "2",
                "transcription": "용품 검색만 하는구나? 뭐 살지",
                "sound_type": [
                    2
                ],
                "start": 68.540,
                "end": 70.202
            },
            {
                "speaker_id": "1",
                "transcription": "네 네 내가 이제 뭘 해야겠다 생각하면 이제 그거에만 꽂혀가지고",
                "sound_type": [
                    2
                ],
                "start": 70.202,
                "end": 74.275
            },
            {
                "speaker_id": "2",
                "transcription": "우와 4개월 만에 천만 원 썼으면 이제 앞으로 무궁무진하겠네?",
                "sound_type": [
                    2
                ],
                "start": 74.275,
                "end": 78.422
            },
            {
                "speaker_id": "1",
                "transcription": "이제 안 사려고요.",
                "sound_type": [
                    2
                ],
                "start": 78.422,
                "end": 80.010
            },
            {
                "speaker_id": "2",
                "transcription": "요즘에는 뭐 보고 있는 거 있어요?",
                "sound_type": [
                    2
                ],
                "start": 80.010,
                "end": 81.487
            },
            {
                "speaker_id": "1",
                "transcription": "요즘에는 티피 텐트?",
                "sound_type": [
                    2
                ],
                "start": 81.487,
                "end": 86.166
            }
        ]
    },
