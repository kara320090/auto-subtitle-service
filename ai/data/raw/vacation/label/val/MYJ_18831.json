                ],
                "start": 0.000,
                "end": 6.679
            },
            {
                "speaker_id": "1",
                "transcription": "다만 디자인을 보시고 개인의 취향에 맞게 적절한 걸 구입하시면 될 것 같아요.",
                "sound_type": [
                    2,
