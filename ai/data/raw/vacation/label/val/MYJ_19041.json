        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래 방금 얘기한 것처럼 헥사만 폴대 4개 모드가 안 돼요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.124
            },
            {
                "speaker_id": "1",
                "transcription": "렉타랑 옥타는 다 되는데 이제 렉타랑 옥타 중에는 그냥 디자인 선호하는 대로 그렇게 고르면 될 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 3.134,
                "end": 9.920
            },
            {
                "speaker_id": "1",
                "transcription": "렉타가 크기 대비 효율이 좋은데 약간 디자인이 좀 투박하죠.",
                "sound_type": [
                    2
                ],
                "start": 9.930,
                "end": 15.056
            },
            {
                "speaker_id": "1",
                "transcription": "근데 또 그런 좋아하시는 분도 있으니까 저도 살짝 반반이거든요.",
                "sound_type": [
                    2
                ],
                "start": 15.066,
                "end": 18.782
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 옥타는 렉타보다는 쪼금 이 효율이 떨어지긴 하지만 어쨌든 굉장히 유리한 디자인이니까 고거 2개 중에 하나 놓고 고민하시는 게 여러모로 맞는 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 18.792,
                "end": 32.593
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 가야지.",
                "sound_type": [
                    2
                ],
                "start": 32.603,
                "end": 34.627
            },
            {
                "speaker_id": "1",
                "transcription": "우와 우와 잘 놔야 돼요.",
