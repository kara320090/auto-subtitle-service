                    2
                ],
                "start": 13.760,
                "end": 14.753
            },
            {
                "speaker_id": "2",
                "transcription": "언니 근데 나 이거 진짜 처음 보는데 너무 신기해.",
                "sound_type": [
                    2
                ],
