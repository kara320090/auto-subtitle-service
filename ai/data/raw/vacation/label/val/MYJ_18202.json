                    2
                ],
                "start": 2.123,
                "end": 3.660
            },
            {
                "speaker_id": "1",
                "transcription": "비닐 많이 쓰잖아 그거 대신 쓸 수 있는 이거 실리콘",
                "sound_type": [
                    2
                ],
                "start": 3.670,
                "end": 7.030
            },
            {
                "speaker_id": "2",
                "transcription": "우와 언니 진짜 신기하다",
                "sound_type": [
                    2
                ],
