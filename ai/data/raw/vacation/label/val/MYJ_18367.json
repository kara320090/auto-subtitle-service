            },
            {
                "speaker_id": "1",
                "transcription": "쿠션이라고 이게?",
                "sound_type": [
                    2
                ],
                "start": 0.615,
                "end": 1.730
            },
            {
                "speaker_id": "1",
                "transcription": "쿠션 샘플 그 다음에 오우 야 립스틱 있네 대박.",
                "sound_type": [
                    2,
                    5
                ],
