        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 워킹 하기가 너무 좋았을 것 같은데.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.081
            },
            {
                "speaker_id": "1",
                "transcription": "그 부분 하나가 좀 아쉽네요.",
                "sound_type": [
                    2
                ],
                "start": 2.091,
                "end": 3.600
            },
            {
                "speaker_id": "1",
                "transcription": "저기는 연결 돼 있는데 앞부분이 연결이 안 돼 있어요.",
                "sound_type": [
                    2
                ],
                "start": 3.610,
                "end": 6.667
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 삥삥삥삥 돌려면 한 계층 내려와야 되고요.",
                "sound_type": [
                    2
                ],
                "start": 6.677,
                "end": 11.492
            },
            {
                "speaker_id": "1",
                "transcription": "아까 제일 먼저 갔던 데가 7층이었어요.",
                "sound_type": [
                    2
                ],
                "start": 11.502,
                "end": 15.743
            },
            {
                "speaker_id": "1",
                "transcription": "제가 어제 7층을 통해서 이제 이 배에 승선을 했는데.",
                "sound_type": [
                    2
                ],
                "start": 15.753,
                "end": 19.757
            },
            {
                "speaker_id": "1",
                "transcription": "거기도 이제 이런 천장이 있는 야외 공간이 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 19.767,
                "end": 24.249
            },
            {
                "speaker_id": "1",
                "transcription": "근데 거기도 지금 뭐 이런 식으로 중간에 다리가 끊겨 있어요 길이.",
                "sound_type": [
                    2
                ],
                "start": 24.259,
                "end": 30.656
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 계속 삥삥삥삥 돌면서 이 크루즈를.",
                "sound_type": [
                    2
                ],
                "start": 30.656,
                "end": 35.216
            },
            {
                "speaker_id": "1",
                "transcription": "네 워킹하기가 조금 안 좋습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.226,
                "end": 39.191
            },
            {
                "speaker_id": "1",
                "transcription": "그 부분만 빼면 제가 봤을 때는.",
                "sound_type": [
                    2
                ],
                "start": 39.201,
                "end": 42.656
            },
            {
                "speaker_id": "1",
                "transcription": "에픽.",
                "sound_type": [
                    2
                ],
                "start": 42.666,
                "end": 44.457
            },
            {
                "speaker_id": "1",
                "transcription": "도르이자 에픽은",
                "sound_type": [
                    2
                ],
                "start": 44.467,
                "end": 47.338
            }
        ]
    },
    "summary": "길이 중간에 끊겨 있어서 워킹 하기에 안 좋은 부분이 아쉽다.",
