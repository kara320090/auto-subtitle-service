        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 물이 생각보다 엄청 깨끗하네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.042
            },
            {
                "speaker_id": "1",
                "transcription": "와 연못이 연 연못 안에 고기도 많이 살고 있는 것 같더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.052,
                "end": 9.399
            },
            {
                "speaker_id": "1",
                "transcription": "그 막 고기가 막 뛰놀더라고요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 9.409,
                "end": 12.842
            },
            {
                "speaker_id": "1",
                "transcription": "여기도 연못이고 좌측에도 연못이고 우측에도 연못이고 연못이 꽤 많습니다 생각보다.",
