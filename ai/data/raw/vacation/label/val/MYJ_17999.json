                    4,
                    5
                ],
                "start": 12.852,
                "end": 21.512
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 닭 키우나 여기는 뭐지?",
                "sound_type": [
                    2,
                    5
                ],
