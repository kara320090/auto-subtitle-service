        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분 전 집에서 나온 지 12시간 만에 다낭 공항에 도착했어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.595
            },
            {
                "speaker_id": "1",
                "transcription": "여기 입국 소속하고 나오자마자 여기 유심 파는 데가 바로 있더라고요.",
                "sound_type": [
                    2
                ],
                "start": 5.605,
                "end": 9.570
            },
            {
                "speaker_id": "1",
                "transcription": "한국말도 되게 잘하세요.",
                "sound_type": [
                    2
                ],
                "start": 9.580,
                "end": 11.099
            },
            {
                "speaker_id": "1",
                "transcription": "유심 되게 싸요.",
                "sound_type": [
                    2
                ],
                "start": 11.109,
                "end": 12.003
            },
            {
                "speaker_id": "1",
                "transcription": "1인당 무제한인데 8일에 7달러 진짜 싸요.",
                "sound_type": [
                    2
                ],
                "start": 12.013,
                "end": 16.406
            },
            {
                "speaker_id": "1",
                "transcription": "유심 파는 데가 쫘르륵 있어서 되게 편한 거 같애요.",
                "sound_type": [
                    2
                ],
                "start": 16.416,
                "end": 19.793
            },
            {
                "speaker_id": "1",
                "transcription": "공항이 생각보다 되게 좋아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.803,
                "end": 21.513
            },
            {
                "speaker_id": "1",
                "transcription": "밖에 나왔는데 엄청 더워요.",
                "sound_type": [
                    2
                ],
                "start": 21.523,
                "end": 23.845
            },
            {
                "speaker_id": "1",
                "transcription": "공항은 되게 깨끗한 거 같애요.",
                "sound_type": [
                    2
                ],
                "start": 23.855,
                "end": 26.807
            },
            {
                "speaker_id": "1",
                "transcription": "저 싱가폴 작년에 갔던 데랑 좀 비슷한 느낌?",
                "sound_type": [
                    2
                ],
                "start": 26.817,
                "end": 29.599
            },
            {
                "speaker_id": "1",
                "transcription": "공항에서 바로 나오니까 이렇게 환전하는 데로 바로 있더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.609,
                "end": 33.649
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여기서 바로 했어요.",
                "sound_type": [
                    2
                ],
                "start": 33.659,
                "end": 35.238
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 지금은 택시를 이제 탈려고 그랩 어플을 깔고 부르고 있는 중입니다.",
                "sound_type": [
                    2
                ],
                "start": 35.248,
                "end": 40.495
            },
            {
                "speaker_id": "1",
                "transcription": "짜잔 호텔 도착했어요.",
                "sound_type": [
                    2
                ],
                "start": 40.505,
                "end": 44.069
            },
            {
                "speaker_id": "1",
                "transcription": "와 수영장이 이렇게 민트색으로 예뻐서 여기 선택했거든요.",
                "sound_type": [
                    2
                ],
                "start": 44.079,
                "end": 48.449
            },
            {
                "speaker_id": "1",
                "transcription": "짜잔",
                "sound_type": [
                    2
                ],
                "start": 48.459,
                "end": 51.480
            }
        ]
    },
    "summary": "12시간만에 다낭 공항에 도착하여 1인당 무제한인 유심을 싸게 구입했다. 공항이 생각보다 좋고 깨끗했고 환전하는 곳이 있어서 바로 환전하고 택시를 불러서 호텔에 도착했다.",
