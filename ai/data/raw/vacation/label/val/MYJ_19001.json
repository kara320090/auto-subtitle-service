        "term": [
            {
                "speaker_id": "1",
                "transcription": "별점 안 내리면 나 계약 끊어버린다고 별점 당장 지우라고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.116
            },
            {
                "speaker_id": "2",
                "transcription": "거기다가 인제 그걸 굉장히 투명하게 별점 시스템 같은 걸 운영하면 캠핑장 사장님들은 싫을 수 있겠네요.",
                "sound_type": [
                    2
                ],
                "start": 5.126,
                "end": 11.665
            },
            {
                "speaker_id": "3",
                "transcription": "어 싫을 수 있죠.",
                "sound_type": [
                    2
                ],
                "start": 11.675,
                "end": 13.181
            },
            {
                "speaker_id": "2",
                "transcription": "안 좋은 걸로 평가받는 거니까",
                "sound_type": [
                    2
                ],
                "start": 13.191,
                "end": 15.285
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 별점 안좋은 걸 올리면 그래서 그 앱이 캠핑장 주인분이 요청을 하면 별점을 안 보이게 하는 거를 결국 만들었대요.",
                "sound_type": [
                    2
                ],
                "start": 15.295,
                "end": 24.754
            },
            {
                "speaker_id": "1",
                "transcription": "그거는 사실 객관적인 정보가 아니잖아요.",
                "sound_type": [
                    2
                ],
                "start": 24.764,
                "end": 26.939
            },
            {
                "speaker_id": "2",
                "transcription": "그렇죠 그렇죠.",
                "sound_type": [
                    2
                ],
                "start": 26.949,
                "end": 27.770
            },
            {
                "speaker_id": "1",
                "transcription": "예 그건",
                "sound_type": [
                    2
                ],
                "start": 27.780,
                "end": 29.151
            },
            {
                "speaker_id": "2",
                "transcription": "그나마 다행이기는 하네요.",
                "sound_type": [
                    2
                ],
                "start": 29.161,
                "end": 30.535
            },
            {
                "speaker_id": "2",
                "transcription": "조작한 건 아니니까",
                "sound_type": [
                    2
                ],
                "start": 30.545,
                "end": 32.125
            },
            {
                "speaker_id": "1",
                "transcription": "조작은 할 수 없으니까 안 보이게만 안 보이게만 해달라.",
                "sound_type": [
                    2
                ],
                "start": 32.135,
                "end": 35.093
            },
            {
                "speaker_id": "1",
                "transcription": "네 또 저희가 생각하는 부분은 1차적으로는 어쨌든 캠프 캠핑하시는 분들이 객관적인 정보를 신뢰도 높은 정보를 얻어 가실 수 있게 하는 거를 최종의 목표로 생각했기 때문에 그래서 예약을 일단 안 받았겠다.",
                "sound_type": [
                    2
                ],
                "start": 35.103,
                "end": 50.445
            },
            {
                "speaker_id": "2",
                "transcription": "아 훨씬 낮죠.",
                "sound_type": [
                    2
                ],
                "start": 50.455,
                "end": 51.396
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 뭐 지금 당장은 좀 힘들 수 있어도",
                "sound_type": [
                    2
                ],
                "start": 51.406,
                "end": 54.662
            },
            {
                "speaker_id": "1",
                "transcription": "아 힘듭니다.",
                "sound_type": [
                    2
                ],
                "start": 54.672,
                "end": 56.185
            },
            {
                "speaker_id": "2",
                "transcription": "아니 저희 같은 사람들은 훨씬 낫죠.",
                "sound_type": [
                    2
                ],
                "start": 56.195,
                "end": 58.306
            },
            {
                "speaker_id": "1",
                "transcription": "그렇죠.",
                "sound_type": [
                    2
                ],
                "start": 58.316,
                "end": 59.094
            },
            {
                "speaker_id": "1",
                "transcription": "캠핑하시는 분 소비 그니까 유저분들한테는 훨씬 효용이 있는 거고요.",
                "sound_type": [
                    2
                ],
                "start": 59.104,
                "end": 62.351
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저희는 이게 이걸 준비하고 캠핑장 리뷰도 받고 그다음에 평가도 하는데 이걸 저희가 인제 스타트업이고 돈이 이렇게 없다 보니 이걸 누가 남겨주지 했는데 의외로 잘 남겨 주시고 의외로 정말 상세하게 남겨주세요.",
                "sound_type": [
                    2
                ],
                "start": 62.361,
                "end": 77.768
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 가면 어느 사이트가 좋고 거기는 그늘이 좋은데 뭐가 어떻고",
                "sound_type": [
                    2
                ],
