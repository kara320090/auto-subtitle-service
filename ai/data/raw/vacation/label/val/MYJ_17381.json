        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아마 스티커 같은 거 받고 그리고 하선을 해서 버스에 탑승하게 될 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.083
            },
            {
                "speaker_id": "1",
                "transcription": "자 11번 버스는 바로 여기에 있는데 또 비가 내리고 있습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.093,
                "end": 18.474
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 버스에 승선을 했습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 18.484,
                "end": 22.433
            },
            {
                "speaker_id": "1",
                "transcription": "아직 다 안 나왔나?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 22.443,
                "end": 25.972
            },
            {
                "speaker_id": "1",
                "transcription": "네 이 자리가 좋아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 25.982,
                "end": 27.827
            },
            {
                "speaker_id": "1",
                "transcription": "앞자리가 없어서 그렇죠?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 27.837,
                "end": 32.105
            },
            {
                "speaker_id": "1",
                "transcription": "왜 굳이 저 다닥다닥 붙어서 앉는지 모르겠네.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 32.115,
                "end": 35.916
            },
            {
                "speaker_id": "1",
                "transcription": "어 바로 출발합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 35.926,
                "end": 37.462
            },
            {
                "speaker_id": "1",
                "transcription": "네 인원은 딱 이게 다인가 봐요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 37.472,
                "end": 43.058
            },
            {
                "speaker_id": "1",
                "transcription": "아 너무 좋다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 43.068,
                "end": 44.669
            }
        ]
    },
    "summary": "여성이 배에서 니려서 버스를 타고 출발한다.",
