        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 진짜 바람이 하나도 없어서 너무 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.162
            },
            {
                "speaker_id": "1",
                "transcription": "제가 아무래도 드론을 사야 될 것 같아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.172,
                "end": 17.512
            },
            {
                "speaker_id": "1",
                "transcription": "제 이 느낌을 어떻게 전달해 드릴 수가 없어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 17.522,
                "end": 20.326
            },
            {
                "speaker_id": "1",
                "transcription": "근데 힘들긴 힘들다.",
