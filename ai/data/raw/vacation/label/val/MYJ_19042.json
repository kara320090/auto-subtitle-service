                    1,
                    2
                ],
                "start": 20.336,
                "end": 22.143
            },
            {
                "speaker_id": "1",
                "transcription": "아 물론 백패킹하고는 비교가 안 되죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 22.153,
                "end": 25.410
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 이제 하체는 거의 힘이 안 들고 이 상체 그러니까 특히 배랑 이 팔이 힘들어요.",
