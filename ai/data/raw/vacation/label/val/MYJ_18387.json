        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 예쁘다 색깔.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.909
            },
            {
                "speaker_id": "1",
                "transcription": "도저히 카메라에 담을 얼굴이 아니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.919,
                "end": 9.535
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 저는 5시 40분에 일어나 가지고 이제 펜션을 빠져나가고 있어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.545,
                "end": 14.770
            },
            {
                "speaker_id": "1",
                "transcription": "여기 완전 산이어 가지고 완전 캄캄해요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.780,
                "end": 17.342
            },
            {
                "speaker_id": "1",
                "transcription": "시간이 6시 25분인데 왜목마을을 찍고 가고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.352,
                "end": 23.794
            },
            {
                "speaker_id": "1",
                "transcription": "근데 거기가 아침에 엄청 막힌다고 해서 사람이 엄청 많이 몰리니까 과연 거기를 갈 수 있을지 궁금하군요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.804,
                "end": 31.857
            },
            {
                "speaker_id": "1",
                "transcription": "이제 왜목마을이 1.4키로 정도 남았는데 차가 벌써 이렇게 밀리기 시작해 가지고 아 이제 여기다가 차 대고 걸어갈려고요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 31.867,
                "end": 39.587
            },
            {
                "speaker_id": "1",
                "transcription": "가면 차가 엄청 많으니까 나올 때도 고생이라고 하더라고요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 39.597,
                "end": 42.978
            },
            {
                "speaker_id": "1",
                "transcription": "여기가 1.4키로인데 걸어갈 수 있을지 모르겠지만 한번 가 보겠습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 42.988,
                "end": 49.960
            }
        ]
    },
    "summary": "왜목마을을 가는데 사람이 몰린다고 해서 아침 일찍 출발했다. 1.4키로 남은 시점에 벌써 차가 밀려서 차를 대고 걸어가려고 한다.",
