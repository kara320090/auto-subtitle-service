        "term": [
            {
                "speaker_id": "1",
                "transcription": "천원 충전하면 300키로키로 정도 탈 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.252
            },
            {
                "speaker_id": "2",
                "transcription": "300키로요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.262,
                "end": 3.062
            },
            {
                "speaker_id": "2",
                "transcription": "그렇게 많이 타요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.072,
                "end": 4.160
            },
            {
                "speaker_id": "3",
                "transcription": "그 많이 타는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.170,
                "end": 5.146
            },
            {
                "speaker_id": "3",
                "transcription": "우리가 통틀어서 300키로를 안탈 건데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.156,
                "end": 7.469
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.479,
                "end": 8.110
            },
            {
                "speaker_id": "3",
                "transcription": "300이면 한바퀴잖아 제주도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.120,
                "end": 10.437
            },
            {
                "speaker_id": "1",
                "transcription": "넘죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.447,
                "end": 12.049
            },
            {
                "speaker_id": "2",
                "transcription": "뭐 필요 없을 거 같은데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.059,
                "end": 14.194
            },
            {
                "speaker_id": "3",
                "transcription": "그지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.204,
                "end": 15.149
            },
            {
                "speaker_id": "2",
                "transcription": "이것도 뭐 또 깔아야 되는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.159,
                "end": 22.177
            },
            {
                "speaker_id": "2",
                "transcription": "이거 아니 여기서도 깔아야 되는 거 아닌 가 프로그램 이름 뭔데 잠깐만 전자금융뭐 어쩌 구 저쩌 구 안 뜨나",
                "sound_type": [
                    2,
