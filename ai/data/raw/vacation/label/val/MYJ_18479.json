        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기가 다 부기스인데 호텔이 여기 근처거든요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.803
            },
            {
                "speaker_id": "1",
                "transcription": "근처가 아니고 부기스예요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.813,
                "end": 5.581
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기가 위치가 진짜 좋아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.591,
                "end": 7.478
            },
            {
                "speaker_id": "1",
                "transcription": "왠만한데는 다 걸어다니고 있어 가지고 그때 카드 충전한거가 쓸모가 없어졌어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.488,
                "end": 15.001
            },
            {
                "speaker_id": "1",
                "transcription": "건물로 된 쇼핑센터 좀 그런 깨끗한 데도 있고 저쪽 뒷쪽으로 가면은 막 시장같이 막 기념품팔고 그런데가 있거든요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.011,
                "end": 25.304
            },
            {
                "speaker_id": "1",
                "transcription": "사람 되게 많고 재미있어요 여기도.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.314,
                "end": 27.709
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 뭐 마실것도 하나 맛있게 생겨 가지고 사가지고 가려고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.719,
                "end": 34.920
            }
        ]
    },
    "summary": "호텔이 부기스에 있는데 위치가 좋아 왠만한 곳은 다 걸어다닌다.",
