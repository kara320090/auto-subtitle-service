        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "원래는 이렇게 손잡이 달린 머그 컵을 좋아하는데 그거는 예쁜 게 없더라고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.115
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 볼 때 이게 제일 그림 같은 게 좀 멋있죠?",
                "sound_type": [
                    2
                ],
                "start": 5.125,
                "end": 9.469
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 요거를 사 왔어요.",
                "sound_type": [
                    2
                ],
                "start": 9.479,
                "end": 11.027
            },
            {
                "speaker_id": "1",
                "transcription": "어 구멍에서 엄청 이상한 냄새나요.",
                "sound_type": [
                    2
                ],
                "start": 11.037,
                "end": 13.463
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 컵 이거 이렇게 써야 될 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 13.473,
                "end": 16.264
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 이거는 케이스가 너무 예뻐 가지고 샀어요.",
                "sound_type": [
                    2
                ],
                "start": 16.274,
                "end": 20.298
            },
            {
                "speaker_id": "1",
                "transcription": "보니까 뭔지 몰랐거든요?",
                "sound_type": [
                    2
                ],
                "start": 20.308,
                "end": 22.604
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 레몬 티백이 안에 들어 있는 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 22.614,
                "end": 26.782
            },
            {
                "speaker_id": "1",
                "transcription": "저는 사실 여기 와도 남줄 건 잘 안 사고요.",
                "sound_type": [
                    2
                ],
                "start": 26.792,
                "end": 29.698
            },
            {
                "speaker_id": "1",
                "transcription": "저 쓰려고 사거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.708,
                "end": 31.760
            }
        ]
    },
    "summary": "여행 기념으로 구매한 컵과 레몬티백을 보여주며 이야기한다.",
