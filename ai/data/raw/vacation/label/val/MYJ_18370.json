        "term": [
            {
                "speaker_id": "1",
                "transcription": "왜 이렇게 속삭여?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.184
            },
            {
                "speaker_id": "1",
                "transcription": "안 들려.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.194,
                "end": 3.006
            },
            {
                "speaker_id": "1",
                "transcription": "안 들려.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.016,
                "end": 4.587
            },
            {
                "speaker_id": "2",
                "transcription": "내 말에 집중하지 않으니까.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.597,
                "end": 6.506
            },
            {
                "speaker_id": "2",
                "transcription": "집중하는데 안 너무 작아서 안 들려.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.516,
                "end": 8.679
            },
            {
                "speaker_id": "2",
                "transcription": "지금 시간이 이제 딱 10시인데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.689,
                "end": 11.442
            },
            {
                "speaker_id": "2",
                "transcription": "내일이 크리스마스 이브거든요.",
                "sound_type": [
                    2
                ],
                "start": 11.452,
                "end": 13.355
            },
            {
                "speaker_id": "2",
                "transcription": "저는 지금까지 편집을 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.365,
                "end": 15.585
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 진짜 쉬지 않고 열심히 편집만 한 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 15.595,
                "end": 19.035
            },
            {
                "speaker_id": "2",
                "transcription": "내일이 크리스마스 이브인데 이제는 편집을 다 했으니까 저도 이제 씻고 와서 좀 놀아야겠어요.",
                "sound_type": [
                    2
                ],
                "start": 19.045,
                "end": 24.541
            },
            {
                "speaker_id": "2",
                "transcription": "이거 붙인 지가 도대체 지금 몇 주가 지났는지 모르겠네.",
                "sound_type": [
                    2
                ],
                "start": 24.551,
                "end": 28.140
            },
            {
                "speaker_id": "2",
                "transcription": "이거 얼마나 됐지?",
                "sound_type": [
                    2
                ],
                "start": 28.150,
                "end": 29.345
            },
            {
                "speaker_id": "2",
                "transcription": "거의 한 달은 된 거 같은데 제가 지금 찾아보니까 진짜 이거 한 지 한 달 됐어요.",
                "sound_type": [
                    2
                ],
                "start": 29.355,
                "end": 34.068
            },
            {
                "speaker_id": "2",
                "transcription": "대박",
                "sound_type": [
                    2
                ],
                "start": 34.078,
                "end": 34.827
            },
            {
                "speaker_id": "2",
                "transcription": "근데 아직도 반짝거리고 진짜 오래 간다.",
                "sound_type": [
                    2
                ],
                "start": 34.837,
                "end": 38.068
            },
            {
                "speaker_id": "2",
                "transcription": "잘 떨어지지도 않네 이거?",
                "sound_type": [
                    2
                ],
                "start": 38.078,
                "end": 39.927
            },
            {
                "speaker_id": "2",
                "transcription": "웬일이야.",
                "sound_type": [
                    2
                ],
                "start": 39.937,
                "end": 43.000
            }
        ]
    },
    "summary": "동행인에게 안 들린다고 속삭인다고 하자 얘기에 집중하지 않아서 안 들리는 거라고 얘기했다. 크리스마스 이브 전날까지 쉬지 않고 편집을 한 뒤 씻고 와서 손톱을 보며 붙인 지 한달은 되었는데 아직 반짝거리고 오래간다고 감탄한다.",
