        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "티볼리 산 산프란체스코라는 동상도 보이고 어우 여기 멋있네요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.973
            },
            {
                "speaker_id": "1",
                "transcription": "멋있는 게이트에요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.983,
                "end": 11.750
            },
            {
                "speaker_id": "1",
                "transcription": "정면의 모습을 좀 담아 볼게요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.760,
                "end": 15.501
            },
            {
                "speaker_id": "1",
                "transcription": "네 성프란치스코 성당이 있고 여기가 입구에요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.511,
                "end": 19.460
            },
            {
                "speaker_id": "1",
                "transcription": "에 이런 얘가 있죠?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.470,
                "end": 23.109
            },
            {
                "speaker_id": "1",
                "transcription": "티켓을 구매를 했고 13유로에 구매를 하면 인제 이렇게 입장권하고 인제 빌라데스테의 지도를 보여 줍니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.119,
                "end": 34.451
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요렇게 요렇게 가라 요렇게 요 길로 따라서 가면 될 것 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 34.461,
                "end": 39.332
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요 길을 따라서 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 39.342,
                "end": 42.067
            },
            {
                "speaker_id": "1",
                "transcription": "뭐는 단체는 요 길로 들어오더라구요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 42.077,
                "end": 44.422
            },
            {
                "speaker_id": "1",
                "transcription": "네 아이구 천장도 멋있게 잘 돼 있죠?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 44.432,
                "end": 49.049
            }
        ]
    },
    "summary": "남성이 성프란치스코 성당에 왔고 티켓을 구매하면 입장권과 빌라데스테의 지도를 줍니다.",
