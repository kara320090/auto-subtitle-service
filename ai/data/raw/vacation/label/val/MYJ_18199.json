                ],
                "start": 3.128,
                "end": 9.658
            },
            {
                "speaker_id": "1",
                "transcription": "근데 일단 텐트 실물이 아주 예쁘네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.668,
                "end": 11.814
            },
            {
                "speaker_id": "1",
                "transcription": "아 일단 치는 게 너무 쉬워서 너무 마음에 들어.",
