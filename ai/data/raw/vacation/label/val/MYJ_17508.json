            },
            {
                "speaker_id": "1",
                "transcription": "저는 다시 칸으로 돌아왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.493,
                "end": 12.373
            },
            {
                "speaker_id": "1",
