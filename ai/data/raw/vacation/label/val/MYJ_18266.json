        "term": [
            {
                "speaker_id": "1",
                "transcription": "3시간 넘으면 안 돼요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.129
            },
            {
                "speaker_id": "1",
                "transcription": "어우 피곤해 죽겠어.",
                "sound_type": [
                    2
                ],
                "start": 1.139,
                "end": 2.199
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 오늘은 여기 디오스에서 하는 줌바 클래스를 신청을 해가지고 이제 들어갈 거거든요?",
                "sound_type": [
                    2
                ],
                "start": 2.209,
                "end": 8.550
            },
            {
                "speaker_id": "1",
                "transcription": "제가 어제 이제 매트 필라테스를 신청해가지고 필라테스는 좀 오래 해가지고 고수는 아니고 한 중수 정도는 되는 것 같은데 여러분들이랑 같이 하는 거다 보니까 사실 난이도가 조금 저한테는 너무 쉬워가지고 오늘은 이제 줌바 들어가는데 이제 줌바는 난생 처음이어가지고 어떨지 모르겠어요.",
                "sound_type": [
                    2
                ],
                "start": 8.560,
                "end": 27.610
            },
            {
                "speaker_id": "1",
                "transcription": "와 줌바 갔다 왔습니다. 여러분.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.620,
                "end": 36.601
            },
            {
                "speaker_id": "1",
                "transcription": "태어나서 줌바 처음 해봤는데 엄청 재밌네요.",
                "sound_type": [
                    2
                ],
                "start": 36.611,
                "end": 39.112
            },
            {
                "speaker_id": "1",
                "transcription": "근데 가기 전에는 좀 걱정이 있었죠.",
                "sound_type": [
                    2
                ],
                "start": 39.122,
                "end": 41.108
            },
            {
                "speaker_id": "1",
                "transcription": "원래 한국인들이 좀 샤이하잖아요?",
                "sound_type": [
                    2
                ],
                "start": 41.118,
                "end": 43.368
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 아 남들 앞에서 춤 어떻게 추나 이랬는데 어둡게 해놓고 선생님만 보고 해가지고 다른 사람들 신경 쓸 틈이 없더라고요.",
                "sound_type": [
                    2
                ],
                "start": 43.378,
                "end": 52.508
            },
            {
                "speaker_id": "1",
                "transcription": "강사님 열정이 막 땀을 막 떨어뜨리면서 춤을 추시더라고요.",
                "sound_type": [
                    2
                ],
                "start": 52.518,
                "end": 56.537
            },
            {
                "speaker_id": "1",
                "transcription": "저도 열심히 했는데 저는 역시나 땀이 별로 안 나요.",
                "sound_type": [
                    2
                ],
                "start": 56.547,
                "end": 60.176
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 좀 나긴 났어요.",
                "sound_type": [
                    2
                ],
                "start": 60.186,
                "end": 61.276
            },
            {
                "speaker_id": "1",
                "transcription": "막 어떤 거 하냐면.",
                "sound_type": [
                    2,
                    3
                ],
