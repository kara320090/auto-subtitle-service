        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 도대체 이 모닝글로리가 뭔데 그렇게 맛있다고 하는지 제가 먹어 볼게요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.357
            },
            {
                "speaker_id": "1",
                "transcription": "약간 시금치 같은데 쓴맛이 없는 맛?",
                "sound_type": [
                    2
                ],
                "start": 5.367,
                "end": 10.157
            },
            {
                "speaker_id": "1",
                "transcription": "되게 달짝지근하고 음 이런 맛이구나.",
