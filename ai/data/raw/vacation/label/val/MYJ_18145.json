                "end": 4.585
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 해서 봤더니만 예술 전시 공간 그렇게 표현해야 되겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.595,
                "end": 10.307
            },
            {
                "speaker_id": "1",
                "transcription": "매 월마다 주제를 정해서 다양한 전시를 계획한다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.317,
                "end": 14.220
            },
            {
                "speaker_id": "1",
                "transcription": "제가 갔을 때는 이렇게 전시를 하고 있었고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.230,
                "end": 17.566
            },
            {
                "speaker_id": "1",
                "transcription": "공백이라서 공백의 미가 많은 것 같아요.",
