        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 그렇게 티볼리의 분수 마지막을 보고 저쪽이 출구에요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 9.478
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이제 출구로 나갈려고 합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.488,
                "end": 13.798
            },
            {
                "speaker_id": "1",
                "transcription": "아유 우리 아저씨 힘들겠다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.808,
                "end": 17.045
            },
            {
                "speaker_id": "1",
                "transcription": "구시가들 이렇게 걷고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.055,
                "end": 22.067
            },
            {
                "speaker_id": "1",
                "transcription": "골목 골목 아름다운 곳들이 많죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.077,
                "end": 26.848
            },
            {
                "speaker_id": "1",
                "transcription": "100년 전 200년 전에도 크게 이 모습하고 다르진 않을 것 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.858,
                "end": 36.273
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기 왜 이렇게 계단이 많냐",
                "sound_type": [
                    1,
                    2
                ],
                "start": 36.283,
                "end": 48.123
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기 티볼리가 다 좋은데 계단이 너무 많아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 48.133,
                "end": 54.332
            },
            {
                "speaker_id": "1",
                "transcription": "못 가겠어요 계단",
                "sound_type": [
                    2,
                    4
                ],
                "start": 54.342,
                "end": 59.456
            },
            {
                "speaker_id": "1",
                "transcription": "아 그런데 풍경이 너무 아름답죠 이런 데 보면",
                "sound_type": [
                    2,
                    4
                ],
                "start": 59.466,
                "end": 66.512
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 집들이 참 예쁘게 돼 있네.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 66.522,
                "end": 71.488
            }
        ]
    },
    "summary": "남성이 티볼리의 분수를 마지막으로 보고 출구로 나왔고 구시가들을 걷고 있고 티볼리는 계단이 많습니다.",
