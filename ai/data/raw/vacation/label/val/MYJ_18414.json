                    1,
                    2,
                    5
                ],
                "start": 6.600,
                "end": 9.060
            },
            {
                "speaker_id": "2",
                "transcription": "안녕 여러분 저는 호이안에 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.060,
                "end": 12.680
            },
            {
                "speaker_id": "2",
                "transcription": "아오자이를 입고 지금은 밥 먼저 먹으러 가려고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.680,
                "end": 18.210
            },
            {
                "speaker_id": "2",
                "transcription": "와 여기 호이안에 사람이 많다고 하더니 진짜 많네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.210,
                "end": 22.060
            },
            {
                "speaker_id": "2",
                "transcription": "일단 초입인데 많은 상점들이랑 전등이랑 사람들이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.060,
                "end": 27.460
            },
            {
                "speaker_id": "2",
                "transcription": "여기다 여기야.",
                "sound_type": [
                    2
                ],
                "start": 27.460,
                "end": 29.840
            },
            {
                "speaker_id": "2",
                "transcription": "자리가 없다.",
                "sound_type": [
                    2
                ],
                "start": 29.840,
                "end": 31.910
            },
            {
                "speaker_id": "2",
                "transcription": "1시간 기다려야 된 데서 그냥 가려고요.",
                "sound_type": [
                    2
                ],
                "start": 31.910,
                "end": 34.480
            },
            {
                "speaker_id": "2",
                "transcription": "다른 데로 아쉽지만 다른데도 맛있는 데가 있겠죠.",
