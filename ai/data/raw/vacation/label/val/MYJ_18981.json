                ],
                "start": 34.314,
                "end": 44.850
            },
            {
                "speaker_id": "3",
                "transcription": "야영은 올해초에 런칭한 캠핑장 정보 제공 그리고 검색의 서비스이고요.",
                "sound_type": [
                    2
                ],
                "start": 44.860,
                "end": 50.261
            },
            {
