        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기가 다 장안산 줄기인 거 같거든요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.002
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아까 사진 보니까 장안산 이제 위에도 너무 멋있더라고요.",
                "sound_type": [
                    1,
                    2,
                    3,
                    5
                ],
                "start": 3.012,
                "end": 6.335
            },
            {
                "speaker_id": "1",
                "transcription": "등산으로 꼭 와야겠어요 너무 멋있더라고요?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 6.345,
                "end": 9.398
            },
            {
                "speaker_id": "1",
                "transcription": "산새가 진짜 멋있어.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 9.408,
                "end": 11.120
            },
            {
                "speaker_id": "1",
                "transcription": "최근에 가본 계곡들 중에 최고예요 최고",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 11.125,
                "end": 16.280
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 의자 갖다 놓고 앉아서 물멍하고 싶다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 16.280,
                "end": 21.417
            },
            {
                "speaker_id": "1",
                "transcription": "우와",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 21.427,
                "end": 22.955
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 제가 장수에 온 목적은 사실 따로 있었습니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 22.965,
                "end": 26.844
            },
            {
                "speaker_id": "1",
                "transcription": "저희 막내 고모가 스님이세요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 26.854,
                "end": 29.533
            },
            {
                "speaker_id": "1",
                "transcription": "스님이 계신 절에 한 번도 안 와봐가지고 놀러 온다 해야 되나?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 29.526,
                "end": 34.350
            },
            {
                "speaker_id": "1",
                "transcription": "절에 놀러 왔다니까 약간 뭔가 죄를 짓는 느낌인가?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 34.360,
                "end": 37.693
            },
            {
                "speaker_id": "1",
                "transcription": "암튼 좀 와보고 싶어가지고 동생네랑 온 거거든요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 37.703,
                "end": 42.023
            },
            {
                "speaker_id": "1",
                "transcription": "지금 도착을 했는데 생각보다 절이 엄청 크고 좋아요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 42.033,
                "end": 48.760
            }
        ]
    },
    "summary": "여자가 장수에 온 목적이 고모가 스님이신데 스님이 계신 절에 한 번도 안 와봐서 동생네랑 같이 왔다고 한다.",
