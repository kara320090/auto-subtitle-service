        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 사실 이 타프에 장점이 이것저것 굉장히 많지만 뭐 많은 얘기를 별로 하고 싶지 않아요.",
                "sound_type": [
                    2,
