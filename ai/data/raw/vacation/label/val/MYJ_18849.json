                ],
                "start": 0.000,
                "end": 5.200
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 힙노타이즈라는 타프 브랜드 이름처럼 종종 힙하거나 또는 섹시한 아빠가 되고 싶을 때 어우 고럴 때 딱 쓰면 좋을 타프 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.210,
                "end": 13.946
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 이게 하나만 더 얘기하고 가면은 그냥 안에서 보면 밖의 무늬가 다 보이잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.956,
                "end": 19.399
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 해서 이 타프가 실타프가 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.409,
                "end": 21.294
            },
            {
                "speaker_id": "1",
                "transcription": "어 블랙 코팅이 되어있는 타프입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.304,
                "end": 24.029
            },
            {
                "speaker_id": "1",
                "transcription": "안에도 이렇게 바깥이랑 똑같은 색상으로 블랙 코팅이 되어있는 거죠",
                "sound_type": [
