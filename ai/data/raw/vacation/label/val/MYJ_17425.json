        "term": [
            {
                "speaker_id": "1",
                "transcription": "안 내렸다가 해도 돼요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.230
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 방에다가 놓고 다음에 제가 보 보낼 방들이 있을 거 아니에요?",
                "sound_type": [
                    2
                ],
                "start": 1.230,
                "end": 5.668
            },
            {
                "speaker_id": "1",
                "transcription": "에 그렇게 가만히 두면은 네 방을 방으로 방으로 다 옮겨줍니다.",
                "sound_type": [
                    2
                ],
                "start": 5.670,
                "end": 11.111
            },
            {
                "speaker_id": "1",
                "transcription": "근데 어느 정도 짐만 싸놓으면 돼요.",
                "sound_type": [
                    2
                ],
                "start": 11.121,
                "end": 13.059
            },
            {
                "speaker_id": "1",
                "transcription": "하여튼 백투백은 좋은 게 많습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.069,
                "end": 17.840
            },
            {
                "speaker_id": "1",
                "transcription": "백투백 하면서 저렇게 이제 설명 같은 거 하면서 여기서 경품 추첨하는 데도 있고 뭐",
                "sound_type": [
                    2
                ],
                "start": 17.830,
                "end": 23.898
            }
        ]
    },
    "summary": "백투백을 하면 방에 짐을 싸놓고 가만히 두면 옮겨주고 설명 및 경품 추첨도 한다.",
