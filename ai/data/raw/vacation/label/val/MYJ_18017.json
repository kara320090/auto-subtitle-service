                    2
                ],
                "start": 6.531,
                "end": 19.049
            },
            {
                "speaker_id": "1",
                "transcription": "하 개운하네요 정말.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.059,
                "end": 27.281
            },
            {
                "speaker_id": "1",
                "transcription": "인제 좀 일 좀 하고 저녁 때 한번 낚시를 한번 해 볼까 합니다.",
                "sound_type": [
