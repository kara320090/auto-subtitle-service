        "term": [
            {
                "speaker_id": "1",
                "transcription": "색다른 체험 원하시는 분들은 여기 모슬포항 오셔서 M1971 요트 투어 한 번 즐겨 보시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.431
            },
            {
                "speaker_id": "1",
                "transcription": "아 저는 여자친구랑 조만간 같이 올 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.441,
                "end": 10.538
            },
            {
                "speaker_id": "1",
                "transcription": "네 100마리 돌고래 100마리를 보고 싶어서 같이 올 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.548,
                "end": 15.223
            },
            {
                "speaker_id": "1",
                "transcription": "그 정도로 정말 즐거운 시간이었고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.233,
                "end": 17.184
            },
            {
                "speaker_id": "1",
                "transcription": "굉장히 진귀한 경험이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.194,
                "end": 19.548
            },
            {
                "speaker_id": "1",
                "transcription": "아기들 있는 식구 이렇게 아기들 있는 분들은 특히나 오시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.558,
                "end": 26.613
            },
            {
                "speaker_id": "1",
                "transcription": "애기들이 너무 좋아하더라고요.",
