            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "날씨는 계속 찌뿌러져 있는 상황입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 8.280
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 배 위에서 어우 좀 추워요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.280,
                "end": 13.532
            },
            {
                "speaker_id": "1",
                "transcription": "아이구 저기도 또 한 크루즈가 있네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.542,
                "end": 17.461
            },
            {
                "speaker_id": "1",
                "transcription": "네 크루즈가 거의 팔마 데 마요르카에 도착을 했습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 17.471,
                "end": 24.595
            },
            {
                "speaker_id": "1",
                "transcription": "저기 멀리 보이는 게 이제 마요르카 대성당 요게 마요르카 대성당이고요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 24.605,
                "end": 31.347
            },
            {
                "speaker_id": "1",
                "transcription": "잘 보이죠?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 31.357,
                "end": 33.900
            },
            {
                "speaker_id": "1",
                "transcription": "네 여기 아이다호 아이다 크루즈가 있습니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 33.910,
                "end": 38.641
            },
            {
                "speaker_id": "1",
                "transcription": "아직 무슨 선박인지는 잘 모르겠네요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 38.651,
                "end": 43.773
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 아이다 위에 보면은 저기 산꼭대기에 있는 저거 저게 벨베르성이에요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 43.783,
                "end": 52.482
            },
            {
                "speaker_id": "1",
                "transcription": "네 아이다 뭔가 볼까요?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 52.492,
                "end": 56.855
            },
            {
                "speaker_id": "1",
                "transcription": "아이다 코스마네요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 56.865,
                "end": 65.033
            },
            {
                "speaker_id": "1",
                "transcription": "네 이쁘게 생겼죠? 아이다 코스마",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 65.043,
                "end": 68.051
            },
            {
                "speaker_id": "1",
                "transcription": "네 입술이 아주 매력적으로 생긴 아이다 코스마홉니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 68.061,
                "end": 74.093
            },
            {
                "speaker_id": "1",
                "transcription": "네 드디어 저희 배도",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 74.103,
                "end": 78.995
            }
        ]
    },
