        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "화력이 좋으니까 금방 익네?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.967
            },
            {
                "speaker_id": "1",
                "transcription": "듬뿍듬뿍 그래야 맛있으니까",
                "sound_type": [
                    2
                ],
                "start": 11.970,
                "end": 15.527
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 올리고?",
                "sound_type": [
                    2
                ],
                "start": 15.527,
                "end": 19.165
            },
            {
                "speaker_id": "1",
                "transcription": "아휴 불 좋다.",
                "sound_type": [
                    2
                ],
                "start": 19.167,
                "end": 21.622
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1씨 근데 겨울 캠핑은 많이 해보셨어요?",
                "sound_type": [
                    2
                ],
                "start": 21.625,
                "end": 23.980
            },
            {
                "speaker_id": "1",
                "transcription": "겨울 캠핑은 사실 제가 캠핑한지 얼마 안돼가지고",
                "sound_type": [
                    2
                ],
                "start": 23.982,
                "end": 26.962
            },
            {
                "speaker_id": "2",
                "transcription": "얼마나 되셨어요?",
                "sound_type": [
                    2
                ],
                "start": 26.962,
                "end": 28.210
            },
            {
                "speaker_id": "1",
                "transcription": "이제 4개월 됐어요.",
                "sound_type": [
                    2
                ],
                "start": 28.210,
                "end": 29.425
            },
            {
                "speaker_id": "2",
                "transcription": "4개월? 아 진짜요?",
                "sound_type": [
                    2
                ],
                "start": 29.425,
                "end": 31.317
            },
            {
                "speaker_id": "2",
                "transcription": "근데 텐트 3개라 그러셨잖아요 아까",
                "sound_type": [
                    2
                ],
                "start": 31.317,
                "end": 33.770
            },
            {
                "speaker_id": "1",
                "transcription": "돈질 많이 했어요.",
                "sound_type": [
                    2
                ],
                "start": 33.772,
                "end": 36.092
            },
            {
                "speaker_id": "2",
                "transcription": "겨울캠핑은요 그러면?",
                "sound_type": [
                    2
                ],
                "start": 36.092,
                "end": 37.232
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 이제 시작할 때부터 거의 이제 가을 끝 무렵에서 겨울이다 보니까 저는 이제 시작 자체를 겨울 캠핑부터 시작했어요.",
                "sound_type": [
                    2
                ],
                "start": 37.232,
                "end": 44.640
            },
            {
                "speaker_id": "2",
                "transcription": "얼마나 몇 번 갔다오셨어요?",
                "sound_type": [
                    2
                ],
                "start": 44.640,
                "end": 46.480
            },
            {
                "speaker_id": "1",
                "transcription": "저 매주 한 번씩 꼭 간 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 46.480,
                "end": 48.520
            },
            {
                "speaker_id": "2",
                "transcription": "아 진짜요?",
                "sound_type": [
                    2
                ],
                "start": 48.520,
                "end": 49.100
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 49.100,
                "end": 50.410
            },
            {
                "speaker_id": "2",
                "transcription": "아 진짜 4개월 동안 거의?",
                "sound_type": [
                    2
                ],
                "start": 50.410,
                "end": 52.100
            },
            {
                "speaker_id": "1",
                "transcription": "네 너무 좋아해가지고",
                "sound_type": [
                    2
                ],
                "start": 52.100,
                "end": 54.265
            },
            {
                "speaker_id": "2",
                "transcription": "제대로 빠졌네요?",
                "sound_type": [
                    2
                ],
                "start": 54.265,
                "end": 55.212
            },
            {
                "speaker_id": "1",
                "transcription": "네 단시간에",
                "sound_type": [
                    2
                ],
                "start": 55.212,
                "end": 56.795
            },
            {
                "speaker_id": "2",
                "transcription": "우와",
                "sound_type": [
                    2
                ],
                "start": 56.797,
                "end": 58.140
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 4개월 동안 한 달에 못해도 3번 이상은 갔던 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 58.140,
                "end": 63.897
            },
            {
                "speaker_id": "2",
                "transcription": "아 진짜요?",
                "sound_type": [
                    2
                ],
                "start": 63.897,
                "end": 64.523
            },
            {
                "speaker_id": "1",
                "transcription": "4번 이상은 안되니까 2번 3번은 꼭 갔고 시간 되면은 웬만하면은 갔고",
                "sound_type": [
                    2
                ],
                "start": 64.532,
                "end": 71.922
            },
            {
                "speaker_id": "2",
                "transcription": "우와 그래서 아까 저기 그 무동력 팬 그것도 있던 거구나.",
                "sound_type": [
                    2
                ],
                "start": 71.922,
                "end": 76.045
            },
            {
                "speaker_id": "1",
                "transcription": "네 그것도 산 지 지금 일주일 밖에 안됐어요.",
                "sound_type": [
                    2
                ],
                "start": 76.045,
                "end": 78.710
            },
            {
                "speaker_id": "2",
                "transcription": "아 지금 처음 쓰는 거예요?",
                "sound_type": [
                    2
                ],
                "start": 78.712,
                "end": 79.880
            },
            {
