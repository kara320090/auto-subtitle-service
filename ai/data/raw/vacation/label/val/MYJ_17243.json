                ],
                "start": 0.000,
                "end": 4.679
            },
            {
                "speaker_id": "1",
                "transcription": "저 위로는 가기에는 좀 힘들 거 같죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.689,
                "end": 7.374
            },
            {
                "speaker_id": "1",
                "transcription": "딱 봐도 힘들 거 같죠?",
