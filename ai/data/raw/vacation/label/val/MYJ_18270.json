        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와 여기 뭐야?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.470
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 짱이다.",
                "sound_type": [
                    2
                ],
                "start": 1.480,
                "end": 2.638
            },
            {
                "speaker_id": "2",
                "transcription": "글쿠나.",
                "sound_type": [
                    2
                ],
                "start": 2.648,
                "end": 3.481
            },
            {
                "speaker_id": "3",
                "transcription": "분위기 있던 데로 가자.",
                "sound_type": [
                    2
                ],
                "start": 3.491,
                "end": 5.851
            },
            {
                "speaker_id": "1",
                "transcription": "와 나 고기 먹고 싶었는데 완전 좋다.",
                "sound_type": [
                    2
                ],
                "start": 5.861,
                "end": 10.167
            },
            {
                "speaker_id": "2",
                "transcription": "좋아 좋아 좋아.",
                "sound_type": [
                    2
                ],
                "start": 10.177,
                "end": 11.183
            },
            {
                "speaker_id": "1",
                "transcription": "어우 찌개 맛있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.193,
                "end": 24.817
            },
            {
                "speaker_id": "1",
                "transcription": "내가 생각한 게 뭔지 알아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.827,
                "end": 26.127
            },
            {
                "speaker_id": "1",
                "transcription": "서울에 식당 가면 웬만한 데 다 맛있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.137,
                "end": 27.850
            },
            {
                "speaker_id": "1",
                "transcription": "월세 비싼데 어떻게 버티냐고 맛 없으면.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.860,
                "end": 30.567
            },
            {
                "speaker_id": "2",
                "transcription": "맞아 그거 맞는 말이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.577,
                "end": 32.155
            },
            {
                "speaker_id": "2",
                "transcription": "그거 맞는 말이여.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.165,
                "end": 33.664
            },
            {
                "speaker_id": "1",
                "transcription": "어 나 서울 어딜 가도 맛있더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.674,
                "end": 34.805
            },
            {
                "speaker_id": "2",
                "transcription": "남자가 있을 듯 법 한데",
                "sound_type": [
                    2
                ],
                "start": 34.815,
                "end": 38.397
            },
            {
                "speaker_id": "4",
                "transcription": "고깃집 카레 가루 나오지 않아요?",
                "sound_type": [
                    2
                ],
                "start": 38.407,
                "end": 40.430
            },
            {
                "speaker_id": "1",
                "transcription": "처음 봐요.",
                "sound_type": [
                    2
                ],
                "start": 40.440,
                "end": 40.610
            },
            {
                "speaker_id": "2",
                "transcription": "처음 봐.",
                "sound_type": [
                    2
                ],
                "start": 40.620,
                "end": 41.322
            },
            {
                "speaker_id": "4",
                "transcription": "아 대전 촌사람들.",
                "sound_type": [
                    2
                ],
                "start": 41.332,
                "end": 42.679
            },
            {
                "speaker_id": "1",
                "transcription": "오 여러분 서울은 카레 가루가 나와요.",
                "sound_type": [
                    2
                ],
                "start": 42.689,
                "end": 45.800
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 신기하다.",
                "sound_type": [
                    2
                ],
                "start": 45.810,
                "end": 46.923
            },
            {
                "speaker_id": "4",
                "transcription": "처음 봐?",
                "sound_type": [
                    2
                ],
                "start": 46.933,
                "end": 47.840
            },
            {
                "speaker_id": "2",
                "transcription": "완전.",
                "sound_type": [
                    2
                ],
                "start": 47.850,
                "end": 48.360
            },
            {
                "speaker_id": "1",
                "transcription": "완전 진심.",
                "sound_type": [
                    2
                ],
                "start": 48.370,
                "end": 49.111
            },
            {
                "speaker_id": "2",
                "transcription": "어.",
                "sound_type": [
                    2
                ],
                "start": 49.121,
                "end": 49.728
            },
            {
                "speaker_id": "1",
                "transcription": "아니 서울은 원래 다 나와요?",
                "sound_type": [
                    2
                ],
                "start": 49.738,
                "end": 51.039
            },
            {
                "speaker_id": "4",
                "transcription": "아니 다 나오지 않고 난 많이 봤는데?",
                "sound_type": [
                    2
                ],
                "start": 51.049,
                "end": 53.771
            },
            {
                "speaker_id": "2",
                "transcription": "어 진짜? 완전 처음.",
                "sound_type": [
                    2
                ],
                "start": 53.781,
                "end": 54.815
            },
            {
                "speaker_id": "1",
                "transcription": "나 완전 처음 말도 처음 들어 아 그리고 심지어 맛있지도 않아.",
                "sound_type": [
                    2
                ],
                "start": 54.825,
                "end": 58.337
            },
            {
                "speaker_id": "1",
                "transcription": "왜 나오는 거야.",
                "sound_type": [
                    2
                ],
                "start": 58.347,
                "end": 59.494
            },
            {
                "speaker_id": "2",
                "transcription": "하하하하.",
                "sound_type": [
                    2
                ],
                "start": 59.504,
                "end": 63.280
            }
        ]
