        "term": [
            {
                "speaker_id": "1",
                "transcription": "나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.627
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 열심히 걸어가는 이유는 제가.",
                "sound_type": [
                    2
                ],
                "start": 0.637,
                "end": 3.866
            },
            {
                "speaker_id": "1",
                "transcription": "네 피사를 25년 만에 한 번 더.",
                "sound_type": [
                    2
                ],
                "start": 3.876,
                "end": 7.369
            },
            {
                "speaker_id": "1",
                "transcription": "피사의 사탑이 있는 데를 가보기 위해서고.",
                "sound_type": [
                    2
                ],
                "start": 7.379,
                "end": 9.947
            },
            {
                "speaker_id": "1",
                "transcription": "저는 루카.",
                "sound_type": [
                    2
                ],
                "start": 9.957,
                "end": 12.349
            },
            {
                "speaker_id": "1",
                "transcription": "투어를 마치고.",
                "sound_type": [
                    2
                ],
                "start": 12.359,
                "end": 14.986
            },
            {
                "speaker_id": "1",
                "transcription": "피사로 이동 해보도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.996,
                "end": 19.143
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 이제 루카에서 피사로 가는 길에 피사 산 로도로라는 역이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 19.153,
                "end": 27.314
            },
            {
                "speaker_id": "1",
                "transcription": "어 거기가 이제 피사의 사탑이 저기 보이죠.",
                "sound_type": [
                    2
                ],
                "start": 27.324,
                "end": 31.923
            },
            {
                "speaker_id": "1",
                "transcription": "가장 가까운 역입니다.",
                "sound_type": [
                    2
                ],
                "start": 31.933,
                "end": 35.475
            },
            {
                "speaker_id": "1",
                "transcription": "에 전체적으로 이제 두오모나 네 그런 게 여기 볼 게 다죠.",
                "sound_type": [
                    2
                ],
                "start": 35.485,
                "end": 46.087
            }
        ]
    },
