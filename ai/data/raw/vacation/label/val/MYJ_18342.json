        "term": [
            {
                "speaker_id": "1",
                "transcription": "풍선들을 더 오래가게 해주려면 입구를 테이프로 막아주면 된대요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.286
            },
            {
                "speaker_id": "1",
                "transcription": "이거 해피뉴이어로 왔잖아요 잘못 시켜가지고 근데 어떻게 보면 더 잘 된 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.296,
                "end": 10.366
            },
            {
                "speaker_id": "1",
                "transcription": "메리 크리스마스로 했으면은 올해 끝나면 떼야 되는데 이걸로는 내년 1월까지 붙여 놓을 수 있을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.376,
                "end": 16.583
            },
            {
                "speaker_id": "1",
                "transcription": "테이프로 아예 주입구를 다 막아 버렸어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.593,
                "end": 20.088
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 다 불었어요. 예쁘다. 예쁘죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.098,
                "end": 23.476
            },
            {
                "speaker_id": "1",
                "transcription": "해피뉴이어 요거는 세트로 주문을 한 거고 얘네 하트들은 3개를 이렇게 따로 고른 거예요 이렇게 꾸미려고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.486,
                "end": 31.813
            },
            {
                "speaker_id": "1",
                "transcription": "해피.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.823,
                "end": 37.361
            },
            {
                "speaker_id": "1",
                "transcription": "짠 요렇게 완성했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.371,
                "end": 42.400
            }
        ]
    },
    "summary": "풍선을 오래 유지하려면 주입구를 테이프로 막아주고 해피뉴이어로 잘못 시켜서 1월 까지 붙여도 되니까 오히려 다행이다.",
