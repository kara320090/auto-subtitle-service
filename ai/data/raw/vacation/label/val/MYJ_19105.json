                    5
                ],
                "start": 0.000,
                "end": 2.154
            },
            {
                "speaker_id": "1",
                "transcription": "둘이 합치면 26킬로가 조금 넘거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.164,
                "end": 4.907
            },
            {
                "speaker_id": "1",
                "transcription": "같이 있으면 아무래도 운반하기가 좀 어려운데 따로 있어서 운반이 좀 용이한 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.917,
                "end": 10.529
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 플라이 이거는 이너텐트, 텐트 이렇게 놓고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.539,
                "end": 15.187
            },
            {
                "speaker_id": "1",
                "transcription": "그라운드 시트 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.197,
                "end": 16.429
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 폴대 가방 여기 팩 있어요.",
                "sound_type": [
