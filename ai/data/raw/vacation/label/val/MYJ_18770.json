        "term": [
            {
                "speaker_id": "1",
                "transcription": "가을은 캠핑 하기 날씨가 너무 좋아서 특별한 캠핑 용품이 필요 없는 계절이긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.377
            },
            {
                "speaker_id": "1",
                "transcription": "아니 우리가 언제부터 필요에 의해서만 캠핑 용품을 샀습니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.387,
                "end": 8.515
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 따지면 텐트, 테이블, 의자, 매트, 침낭, 버너, 난로 이렇게만 있으면 솔직히 캠핑 다 하죠 4계절",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.525,
                "end": 15.400
            },
            {
                "speaker_id": "1",
                "transcription": "이제 가을은 날씨가 남녀노소 누구나 캠핑하기에 너무 좋은 계절이잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.410,
                "end": 19.172
            },
            {
                "speaker_id": "1",
                "transcription": "이럴 때 우리가 이 사랑하는 가족,연인, 뭐 친구들하고 이 인생을 풍요롭게 해 주는 추억을 최대한 많이 쌓아 놔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.182,
                "end": 24.983
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 오늘 고런 추억 쌓는데 좀 도움이 되는 어떤 용품들하고 같이 가을 캠핑해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.993,
                "end": 31.958
            }
        ]
    },
