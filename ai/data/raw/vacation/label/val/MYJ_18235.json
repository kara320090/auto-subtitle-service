        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "저녁 먹고 고모랑 5시간 반 정도 6시간 가까이 계속 얘기했거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.677
            },
            {
                "speaker_id": "1",
                "transcription": "너무 막 재밌고 되게 감동이 엄청 있고 엄청 울고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.687,
                "end": 10.429
            },
            {
                "speaker_id": "2",
                "transcription": "울다 웃다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.439,
                "end": 11.787
            },
            {
                "speaker_id": "1",
                "transcription": "어 그러고서 방에 딱 들어왔는데 이런 게 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.797,
                "end": 14.760
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 너무 감동이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.770,
                "end": 16.260
            },
            {
                "speaker_id": "1",
                "transcription": "산 소리가 겁나 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.270,
                "end": 18.277
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 꿀잠 잘 것 같은 소리.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.287,
                "end": 19.970
            },
            {
                "speaker_id": "1",
                "transcription": "저랑 동생이랑 요즘에 그런 얘기를 많이 했거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.980,
                "end": 22.983
            },
            {
                "speaker_id": "1",
                "transcription": "우리 둘 다 왜 이렇게 마음이 편하고 걱정이 하나도 없고 앞으로 잘 될 것만 같고 모든 일이 고모가 저희를 위해 기도도 엄청 많이 해주시고 아빠도 저희를 위해서 그런 마음을 담아서 하는 걸 알게 되니까 그게 너무 감동이고 어른들한테 더 잘해야겠다 이런 마음?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.993,
                "end": 40.432
            },
            {
                "speaker_id": "1",
                "transcription": "고모가 딱 해주신 말씀이 모든 게 이유없이 일어나는 일은 없다라는 거였어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.442,
                "end": 45.012
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 자기가 한 거는 좋은 거든 나쁜 거든 다 돌아온다고 앞으로 더 인생을 착하게 그리고 나를 갈고 닦으면서 좋은 마음으로 좋은 말을 하면서 살아야겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.022,
                "end": 55.561
            },
            {
                "speaker_id": "1",
                "transcription": "이런 생각을 굉장히 많이 해서 너무너무 좋은 시간이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.571,
                "end": 58.814
            },
            {
                "speaker_id": "1",
                "transcription": "제가 템플스테이를 해보고 싶었는데 1번도 안 해봤거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.824,
                "end": 61.809
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기는 돈 받고 하는 프로그램이 아니고 찐 템플스테이이기 때문에 그리고 사실 여길 아무나 와가지고 이렇게 할 수 있는 거는 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.819,
                "end": 71.023
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 이 경험이 더 감사하고 소중하고 그렇습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.033,
                "end": 75.516
            },
            {
                "speaker_id": "1",
                "transcription": "굿나잇.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.526,
                "end": 77.996
            },
            {
                "speaker_id": "1",
                "transcription": "풀벌레 소리.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.006,
                "end": 82.920
            }
        ]
