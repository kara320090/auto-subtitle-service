        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "일단",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.385
            },
            {
                "speaker_id": "2",
                "transcription": "어 한국말 하시네요.",
                "sound_type": [
                    2
                ],
                "start": 0.385,
                "end": 1.778
            },
            {
                "speaker_id": "1",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 1.788,
                "end": 5.807
            },
            {
                "speaker_id": "1",
                "transcription": "일단 저는 이 커넥터가 일단 너무 자연스럽게",
                "sound_type": [
                    2
                ],
                "start": 5.817,
                "end": 10.550
            },
            {
                "speaker_id": "3",
                "transcription": "어 심플해가지고",
                "sound_type": [
                    2
                ],
                "start": 10.561,
                "end": 11.490
            },
            {
                "speaker_id": "1",
                "transcription": "심플해가지고 하기도 편하고 일단 커넥터 연결하니까 이제 도킹을 해도 이질적인 그게 생길 수 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 11.490,
                "end": 21.570
            },
            {
                "speaker_id": "3",
                "transcription": "그쵸 그쵸.",
                "sound_type": [
                    2
                ],
                "start": 21.575,
                "end": 22.110
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아까 들어오면서 촬 촬영했었던 것처럼 위에서 봤을 때도 그렇고 옆에 봤을 때도 그렇고 아 쉐입이 아예 너무 잘 빠졌더라고요.",
                "sound_type": [
                    2
                ],
                "start": 22.120,
                "end": 32.300
            },
            {
                "speaker_id": "1",
                "transcription": "예 너무 곡선",
                "sound_type": [
                    2
                ],
                "start": 32.310,
                "end": 33.574
            },
            {
                "speaker_id": "3",
                "transcription": "어 저도 그거 느낀 게 한 동보다 두 동이 이쁘던데요.",
                "sound_type": [
                    2
                ],
                "start": 33.584,
                "end": 36.785
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜요?",
                "sound_type": [
                    2
                ],
                "start": 36.795,
                "end": 37.383
            },
            {
                "speaker_id": "3",
                "transcription": "어 얘가 앞뒤로 좀 짜리몽땅하다 보니까 옆으론 풍성하고 앞뒤는 좀 짧다 보니까 두 동 딱 붙여놨을 때 진짜 넉넉해 보여.",
                "sound_type": [
                    2
                ],
                "start": 37.393,
                "end": 46.210
            },
            {
                "speaker_id": "2",
                "transcription": "음 공간감도",
                "sound_type": [
                    2
                ],
                "start": 46.219,
                "end": 47.440
            },
            {
                "speaker_id": "3",
                "transcription": "어 풍성해 보여.",
                "sound_type": [
                    2
                ],
                "start": 47.440,
                "end": 48.291
            },
            {
                "speaker_id": "2",
                "transcription": "저도 그 생각은 했어요.",
                "sound_type": [
                    2
                ],
                "start": 48.301,
                "end": 49.700
            },
            {
                "speaker_id": "2",
                "transcription": "그 텐트들 보면 도킹하는 텐트들이 제대로 된 커넥터가 있어서 도킹한 게 아니라 대부분 그냥 캠퍼들이 그냥 붙여서 그냥 억지로 붙여서 딱 딱 붙여서 그런 도킹은 많이 봤는데 이렇게 제대로 된 도킹을 계속 이를 수 있는 거잖아요 이거는.",
                "sound_type": [
                    2
                ],
                "start": 49.710,
                "end": 66.677
            },
            {
                "speaker_id": "2",
                "transcription": "어떻게 보면 무한대가 될 수 있는 거잖아요. 좀 재밌는 거 같아요 시스템이.",
                "sound_type": [
                    2
                ],
                "start": 66.687,
                "end": 70.348
            },
            {
                "speaker_id": "3",
                "transcription": "아 근데 저 같은 경우는 딱 보니까 이게 도킹을 하니까 집이 되잖아요. 그니까 완전 방이잖아요.",
                "sound_type": [
                    2
                ],
                "start": 70.358,
                "end": 76.893
            },
            {
                "speaker_id": "3",
                "transcription": "여기 방문 닫아버리면 그니까 좀 안 위험한 거 잔뜩 좀 이렇게 안 위험하게 세팅 잘 해놓고 애들 여기서 그라운드 시트 딱 해 놓고 카페트",
                "sound_type": [
                    2
                ],
                "start": 76.903,
                "end": 86.285
            },
            {
                "speaker_id": "2",
                "transcription": "한쪽에 놀라고 하고",
                "sound_type": [
                    2
                ],
                "start": 86.285,
                "end": 87.812
            },
            {
                "speaker_id": "3",
                "transcription": "완전 놀이방처럼 거기서 어른들 신경 끄고 막 니들끼리 맘대로",
                "sound_type": [
                    2
                ],
                "start": 87.822,
                "end": 91.505
            },
            {
                "speaker_id": "2",
                "transcription": "하나 더 붙이면 뭐 차도 하나 놓 주차하고",
                "sound_type": [
                    2
                ],
                "start": 91.500,
                "end": 95.375
            }
        ]
    },
    "summary": "화자들은 제대로 된 커넥터가 있어서 두 동을 붙여놨을 때 모양이 예쁘고 공간을 나눌 수 있어 어른들이 신경쓰지 않고 아이들이 놀 수 있는 놀이방을 만들 수 있어 좋다고 얘기하고 있다.",
