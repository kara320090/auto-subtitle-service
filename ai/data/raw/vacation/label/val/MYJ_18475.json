        "term": [
            {
                "speaker_id": "1",
                "transcription": "티가 마시고 싶어가지고 찾아다니다가 여기를 발견해서 땡큐",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.386
            },
            {
                "speaker_id": "1",
                "transcription": "밀크티가 나왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.396,
                "end": 8.421
            },
            {
                "speaker_id": "1",
                "transcription": "음 엄청 달아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.431,
                "end": 11.134
            },
            {
                "speaker_id": "1",
                "transcription": "저번에 우연히 들어왔다가 큰 마트를 발견해서 거기 가려고 했는데 못 찾겠네요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.144,
                "end": 19.405
            },
            {
                "speaker_id": "1",
                "transcription": "다리가 너무 아파서 그냥 호텔로 돌아가야겠어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.415,
                "end": 23.150
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 저녁을 먹으러 가려고 나왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.160,
                "end": 32.140
            },
            {
                "speaker_id": "2",
                "transcription": "뭐가 제일 맛있을까.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 32.150,
                "end": 33.633
            },
            {
                "speaker_id": "1",
                "transcription": "남자친구가 좋은 데를 간다 하는데 어디를 가는지 모르겠어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 33.643,
                "end": 38.585
            },
            {
                "speaker_id": "1",
                "transcription": "여기 와서 처음으로 치마를 입었어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 38.595,
                "end": 42.474
            },
            {
                "speaker_id": "1",
                "transcription": "우버를 기다리고 있는데 우버가 가까운 거리 갈 때는 일반 택시랑 크게 차이를 못 느꼈는데 좀 먼 거리를 가니까 우버가 확실히 더 싸더라고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 42.484,
                "end": 52.768
            },
            {
                "speaker_id": "1",
                "transcription": "안녕.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 52.778,
                "end": 57.940
            },
            {
                "speaker_id": "1",
                "transcription": "오 저희는 라오파샷에 왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 57.950,
                "end": 62.912
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 사태거리라고 여기서 사태가 꼬치같은 거거든요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 62.922,
                "end": 67.106
            },
            {
                "speaker_id": "1",
                "transcription": "막 닭이랑 소랑 막 이것저것 끼워서 파는 그래서 와 보고 싶었는데 여기를 데리고 왔어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 67.116,
                "end": 74.760
            }
        ]
    },
    "summary": "여성이 오전에는 밀크티를 마시며 마트를 찾다가 못 찾고 호텔로 돌아와 라면을 먹고 오후에는 라오파샷 사태거리에 꼬치를 먹으러 나왔다.",
