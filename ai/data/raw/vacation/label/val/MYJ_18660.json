                ],
                "start": 6.028,
                "end": 15.279
            },
            {
                "speaker_id": "1",
                "transcription": "냄새도 엄청 많이 나고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.289,
                "end": 17.110
            },
            {
                "speaker_id": "1",
                "transcription": "아 서울에서도 이제 이정도로 더러운 데는 찾기가 안 쉬울 거 같은 데",
                "sound_type": [
                    2,
                    3
                ],
