            },
            {
                "speaker_id": "1",
                "transcription": "빨리 한국 돌아가서 좀 쉬고 싶습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.083,
                "end": 6.018
            },
            {
                "speaker_id": "1",
                "transcription": "물이 진짜 더러워요.",
