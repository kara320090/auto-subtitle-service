        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이쪽은 영암이고 저 건너편은 목포인 것 같애.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.698
            },
            {
                "speaker_id": "1",
                "transcription": "자전거 길을 이렇게 만들어 놨네요.",
                "sound_type": [
                    2
                ],
                "start": 3.708,
                "end": 8.147
            },
            {
                "speaker_id": "1",
                "transcription": "트레킹 길 겸 자전거 길을 이렇게 만들어 놨구나.",
                "sound_type": [
                    2
                ],
                "start": 8.157,
                "end": 12.453
            },
            {
                "speaker_id": "1",
                "transcription": "이게 분간이 안 가요.",
                "sound_type": [
                    2
                ],
                "start": 12.463,
                "end": 22.124
            },
            {
                "speaker_id": "1",
                "transcription": "바다인지 호수인지 근데 아까 또 아까 보니까 멸치 떼가 엄청 많이 있는 것 같던데 막 떼거리로 막 저기 다니더라고요.",
                "sound_type": [
                    2
                ],
                "start": 22.134,
                "end": 31.753
            },
            {
                "speaker_id": "1",
                "transcription": "그 삼치인가 그거한테 쫓겨 가지고 근데 또 여기 보면 녹조가 있단 말이에요.",
                "sound_type": [
                    2
                ],
                "start": 31.763,
                "end": 38.317
            },
            {
                "speaker_id": "1",
                "transcription": "바다에도 녹조가 있나?",
                "sound_type": [
                    2
                ],
                "start": 38.327,
                "end": 40.005
            },
            {
                "speaker_id": "1",
                "transcription": "아 헷갈리네.",
                "sound_type": [
                    2
                ],
                "start": 40.015,
                "end": 46.657
            },
            {
                "speaker_id": "1",
                "transcription": "야 진짜 전망은 하나 끝내 주네 진짜.",
                "sound_type": [
                    2
                ],
                "start": 46.667,
                "end": 51.335
            },
            {
                "speaker_id": "1",
                "transcription": "여기가 이제 저 건너편이 목포 삼학도 쪽입니다.",
                "sound_type": [
                    2
                ],
                "start": 51.345,
                "end": 61.665
            },
            {
                "speaker_id": "1",
                "transcription": "삼학도 쪽 야 진짜 이쁘네요.",
                "sound_type": [
                    2
                ],
                "start": 61.675,
                "end": 69.400
            }
        ]
    },
    "summary": "한 남성이 이쪽은 영암이고 건너편은 목포인 것 같다며 트레킹 길 겸 자전거 길을 만들었다고 설명하고 있고 여전히 바다인지 호수인지 분간이 안 간다고 말하고 있다.",
