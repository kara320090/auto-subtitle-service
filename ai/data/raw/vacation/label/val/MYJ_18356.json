                    2
                ],
                "start": 6.145,
                "end": 7.316
            },
            {
                "speaker_id": "1",
                "transcription": "많이 달지 않고 담백해요.",
                "sound_type": [
                    2
                ],
                "start": 7.326,
                "end": 9.087
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 생크림도 뭔가 신기해.",
