        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기 이렇게 발코니가 있는데 야경이 쫙 엄청 빵빵거리고 내 앞에 막 저런 데 막 포장마차처럼 다 그런 데더라고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 11.976
            },
            {
                "speaker_id": "1",
                "transcription": "저기 가서 맥주 한 잔 하고 마사지 받을 수 있으면 받고 오늘 자려고요.",
                "sound_type": [
                    2
                ],
                "start": 11.986,
                "end": 17.349
            },
            {
                "speaker_id": "1",
                "transcription": "빨리 여기서 수영하고 싶어요.",
                "sound_type": [
                    2
                ],
                "start": 17.359,
                "end": 19.586
            },
            {
                "speaker_id": "1",
                "transcription": "호텔 밖에 나왔는데 막 한국 마트 닫았는데 여기 한국 가든이라고 써 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.596,
                "end": 25.735
            },
            {
                "speaker_id": "1",
                "transcription": "한국에 관련된 거 되게 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.745,
                "end": 27.695
            },
            {
                "speaker_id": "1",
                "transcription": "저쪽에 보면은 포장마차 같은 게 여기 막 여러 개 쫙 있는데 여기가 사람이 진짜 많은 거 같애 가지고 여기를 가볼까 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.705,
                "end": 35.699
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기는 다 이렇게 실외에 있나 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.709,
                "end": 37.977
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 더운데 지금 여기는 이렇게 얼음 얼음에다가 맥주를 넣어 먹어야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.987,
                "end": 43.578
            },
            {
                "speaker_id": "1",
                "transcription": "아 이게 미지근하네.",
                "sound_type": [
                    2
                ],
                "start": 43.588,
                "end": 46.016
            },
            {
                "speaker_id": "1",
                "transcription": "기본 반찬으로 메추리알이랑 땅콩이 나왔어요.",
                "sound_type": [
                    2
                ],
                "start": 46.026,
                "end": 48.794
            },
            {
                "speaker_id": "1",
                "transcription": "여기 엄청 시끄럽고 엄청 웃겨요.",
                "sound_type": [
                    2
                ],
                "start": 48.804,
                "end": 51.345
            },
            {
                "speaker_id": "1",
                "transcription": "새우랑 막 모닝글로리 그게 하도 맛있다해 가지고 그거랑 치킨 아니야 쭈꾸미 아니 오징어 오징어를 시켜봤어요.",
                "sound_type": [
                    2
                ],
                "start": 51.355,
                "end": 60.230
            },
            {
                "speaker_id": "1",
                "transcription": "맛있는 냄새 먹어 봐.",
                "sound_type": [
                    2
                ],
                "start": 60.240,
                "end": 62.176
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 맛있어.",
                "sound_type": [
                    2
                ],
                "start": 62.186,
                "end": 66.862
            },
            {
                "speaker_id": "1",
                "transcription": "흠 와 진짜",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.872,
                "end": 71.080
            }
        ]
    },
    "summary": "한국 마트는 닫았는데 한국 가든이 있었고 포장마차가 여러 개 있는 곳을 방문해서 실외에서 얼음에 맥주를 넣어서 먹는다. 기본 반찬으로 메추리알과 땅콩이 나왔고 새우랑 여러 가지 주문해서 먹는데 맛있다.",
