    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 여러분 저는 세수를 하고 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.086
            },
            {
                "speaker_id": "1",
                "transcription": "보여드릴 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.096,
                "end": 6.258
            },
            {
                "speaker_id": "1",
                "transcription": "제가 저번에 캠팽을 동생이랑 갔는데 동생이 이런 걸 주는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.268,
                "end": 11.242
            },
            {
                "speaker_id": "1",
                "transcription": "얼굴 닦으라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.252,
                "end": 12.848
            },
            {
                "speaker_id": "1",
                "transcription": "저는 처음 써봤거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.858,
                "end": 13.920
            },
            {
                "speaker_id": "1",
                "transcription": "일회용 순면 같은 거거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.930,
                "end": 15.882
            },
            {
                "speaker_id": "1",
                "transcription": "이걸로 이제 얼굴을 닦으니까 너무 좋은 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.892,
                "end": 18.246
            },
            {
                "speaker_id": "1",
                "transcription": "캠핑 다닐 때 수건 가지고 다니기 번거롭잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.256,
                "end": 21.280
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 잘 까먹고 1박 2일 가면 샤워 잘 안 하잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.290,
                "end": 24.671
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 수건이 필요 없단 말이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.681,
                "end": 26.440
            },
            {
                "speaker_id": "1",
                "transcription": "이거 하나 있으니까 얼굴만 닦기 너무 괜찮은 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.433,
                "end": 29.506
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저도 샀거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.506,
                "end": 31.074
            },
            {
                "speaker_id": "1",
                "transcription": "캠팽 1박 2일 할 때는 이거 가지고 다니면 정말 너무 너무 너무 편합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.084,
                "end": 34.758
            },
            {
                "speaker_id": "1",
                "transcription": "주변 사람들도 쓰라고 이렇게 주기도 좋고 폴리백에 이렇게 몇개 넣어가지고 어제 쓰고 오늘도 썼어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.768,
                "end": 41.186
            },
            {
                "speaker_id": "1",
                "transcription": "아주 좋아 이거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.196,
                "end": 41.975
            },
            {
                "speaker_id": "1",
                "transcription": "로션은 그냥 집에 있는 거 샘플 조그만 거 가져왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.985,
                "end": 46.253
            },
            {
                "speaker_id": "1",
                "transcription": "와 햇빛이 진짜 뜨겁다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.263,
                "end": 48.993
            },
            {
                "speaker_id": "1",
                "transcription": "와 근데 어제 먹은 게를 아직도 안 꺼졌는데 하나도?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.000,
                "end": 52.714
            },
            {
                "speaker_id": "1",
                "transcription": "어제 정말 많이 먹은 거 같아요 하루 종일",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.724,
                "end": 57.440
            }
        ]
    },
    "summary": "여자는 저번에 동생이 준 일회용 순면 같은 걸 소개 하면서 하나씩 가지고 다니면서 얼굴만 닦을 때 너무 좋다고 한다.",
