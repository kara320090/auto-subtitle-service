        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요 여러분 트하의 여행 일기입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.784
            },
            {
                "speaker_id": "1",
                "transcription": "저는 지금 속초에 와 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.794,
                "end": 3.887
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 적당한 산책과 약간의 대중교통으로 즐길 수 있는 속초의 여행지 6곳을 소개해 드리려고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.897,
                "end": 11.524
            },
            {
                "speaker_id": "1",
                "transcription": "거두절미하고 지금 바로 시작하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.534,
                "end": 14.113
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째로 소개해 드릴 곳은 속초 아이 대관람차입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.123,
                "end": 17.960
            },
            {
                "speaker_id": "1",
                "transcription": "속초 해수욕장의 초입에 자리하고 있는 굉장히 독특한 관람차입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.970,
                "end": 22.033
            },
            {
                "speaker_id": "1",
                "transcription": "우리나라를 샅샅히 훑어도 여기보다 바닷가에서 가까운 관람차는 없다고 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.043,
                "end": 27.217
            },
            {
                "speaker_id": "1",
                "transcription": "입지가 굉장히 훌륭합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.227,
                "end": 29.575
            },
            {
                "speaker_id": "1",
                "transcription": "시외버스 터미널에서는 시내버스랑 걷는 시간을 합쳐서 40분 남짓 걸리는데 고속버스 터미널에서는 10분 걸어서 10분도 걸리지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.585,
                "end": 40.740
            }
        ]
    },
    "summary": "화자가 우리나라 바닷가에서 제일 가까운 관람차가 있는 속초 해수욕장의 아이 대관람차를 소개하고 있다.",
