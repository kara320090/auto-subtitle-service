        "term": [
            {
                "speaker_id": "1",
                "transcription": "김태균 김태균",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 0.801
            },
            {
                "speaker_id": "2",
                "transcription": "김태균",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 0.811,
                "end": 1.754
            },
            {
                "speaker_id": "1",
                "transcription": "많이 들었제?",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 1.764,
                "end": 2.899
            },
            {
                "speaker_id": "2",
                "transcription": "처음 듣는데요 형님",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.909,
                "end": 4.054
            },
            {
                "speaker_id": "1",
                "transcription": "보조개가 매력적이다 진짜",
                "sound_type": [
                    1,
                    2
                ],
                "start": 4.064,
                "end": 5.970
            },
            {
                "speaker_id": "2",
                "transcription": "고맙습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 5.980,
                "end": 6.813
            },
            {
                "speaker_id": "1",
                "transcription": "반갑데이.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 6.823,
                "end": 8.809
            },
            {
                "speaker_id": "1",
                "transcription": "진안 와 봤나?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.819,
                "end": 10.553
            },
            {
                "speaker_id": "3",
                "transcription": "처음 왔어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.563,
                "end": 11.396
            },
            {
                "speaker_id": "3",
                "transcription": "너무 좋아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 11.406,
                "end": 12.172
            },
            {
                "speaker_id": "1",
                "transcription": "네, 조용하고 너무 좋은 것 같애요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 12.182,
                "end": 13.854
            },
            {
                "speaker_id": "4",
                "transcription": "아니 근데 생각보다 깨끗한데 여기",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.864,
                "end": 15.186
            },
            {
                "speaker_id": "3",
                "transcription": "쓰레기가 별로 없어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 15.196,
                "end": 16.266
            },
            {
                "speaker_id": "1",
                "transcription": "화이팅",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.276,
                "end": 17.274
            },
            {
                "speaker_id": "4",
                "transcription": "화이팅 좋아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 17.284,
                "end": 18.704
            },
            {
                "speaker_id": "1",
                "transcription": "션 닮았다 션 지누션의 션",
                "sound_type": [
                    2
                ],
                "start": 18.714,
                "end": 21.076
            },
            {
                "speaker_id": "5",
                "transcription": "닮은 것 같애.",
                "sound_type": [
                    2
                ],
                "start": 21.086,
                "end": 22.154
            },
            {
                "speaker_id": "5",
                "transcription": "션 닮았어.",
                "sound_type": [
                    2
                ],
                "start": 22.164,
                "end": 22.867
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐 여자친구라고",
                "sound_type": [
                    2
                ],
                "start": 22.877,
                "end": 23.991
            },
            {
                "speaker_id": "6",
                "transcription": "예.",
                "sound_type": [
                    2
                ],
                "start": 24.001,
                "end": 24.516
            },
            {
                "speaker_id": "1",
                "transcription": "코가 똑같이 생겼는데",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 24.526,
                "end": 26.942
            },
            {
                "speaker_id": "1",
                "transcription": "가족인 줄 알았다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.952,
                "end": 28.106
            },
            {
                "speaker_id": "5",
                "transcription": "우리가 남매 할까 봐.",
                "sound_type": [
                    2
                ],
                "start": 28.116,
                "end": 29.430
            },
            {
                "speaker_id": "1",
                "transcription": "남매인 줄 남맨 줄 알았다.",
                "sound_type": [
                    2
                ],
                "start": 29.440,
                "end": 30.515
            },
            {
                "speaker_id": "6",
                "transcription": "형님 다 치워놔 가지고 깨끗하네요 여기",
                "sound_type": [
                    2
                ],
                "start": 30.525,
                "end": 32.258
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 그 요새는 뭐 어르신들이 이렇게 좀 치우고 하신다 하더라고 그래 화이팅",
                "sound_type": [
                    1,
                    2
                ],
                "start": 32.268,
                "end": 36.513
            },
            {
                "speaker_id": "5",
                "transcription": "화이팅",
                "sound_type": [
                    2
                ],
                "start": 36.523,
                "end": 36.905
            },
            {
                "speaker_id": "6",
                "transcription": "화이팅",
                "sound_type": [
                    2
                ],
                "start": 36.915,
                "end": 37.875
            },
            {
                "speaker_id": "7",
                "transcription": "아 그니까 생각보다 많없네요.",
                "sound_type": [
                    2
                ],
                "start": 37.885,
                "end": 39.044
            },
            {
                "speaker_id": "7",
                "transcription": "저는 창원에서 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.054,
                "end": 40.566
            },
            {
                "speaker_id": "1",
                "transcription": "창원도 마산이 있고",
                "sound_type": [
                    2
                ],
                "start": 40.576,
                "end": 41.904
            },
            {
                "speaker_id": "7",
                "transcription": "진해 진해에서 왔어요.",
                "sound_type": [
                    2
                ],
                "start": 41.914,
                "end": 42.899
            },
            {
                "speaker_id": "1",
                "transcription": "행님 진해 한 5년 근무했다 아이가.",
                "sound_type": [
                    2
                ],
                "start": 42.909,
                "end": 44.582
            },
            {
                "speaker_id": "7",
                "transcription": "어 해군이셨어요?",
                "sound_type": [
                    2
                ],
                "start": 44.592,
                "end": 45.756
            },
            {
                "speaker_id": "7",
                "transcription": "그래.",
                "sound_type": [
                    2
                ],
                "start": 45.766,
                "end": 46.125
            },
            {
                "speaker_id": "1",
                "transcription": "어 니 해군이가?",
                "sound_type": [
                    2
                ],
                "start": 46.135,
                "end": 47.497
            },
            {
                "speaker_id": "7",
                "transcription": "예, 장교 지금 7월에 대위를 답니다.",
                "sound_type": [
                    2
                ],
                "start": 47.507,
                "end": 51.138
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 고생 많다.",
                "sound_type": [
                    2
                ],
                "start": 51.148,
                "end": 52.980
            },
            {
                "speaker_id": "7",
                "transcription": "아닙니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.990,
                "end": 55.522
            }
        ]
    },
    "summary": "김태균 닮은 보조개가 매력적인 남자를 봤고 요새는 어르신들이 치워서 쓰레기가 많이 없고 나도 진해에서 5년 동안 해군으로 근무를 했었다.",
