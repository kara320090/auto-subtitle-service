                    2
                ],
                "start": 8.625,
                "end": 9.446
            },
            {
                "speaker_id": "1",
                "transcription": "네 머시룸 치킨 숲입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.456,
                "end": 12.848
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 소음이 들리는 거 보이시죠?",
