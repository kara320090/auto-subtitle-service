        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기가 소음이 좀 있어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.276
            },
            {
                "speaker_id": "1",
                "transcription": "스크류 때문에 그래서 대부분 크루즈들이 이쪽에다가 식당을 합니다.",
                "sound_type": [
                    2
                ],
                "start": 1.286,
                "end": 5.914
            },
            {
                "speaker_id": "1",
                "transcription": "여기다 선실을 할 수는 없잖아요?",
                "sound_type": [
                    2
                ],
                "start": 5.924,
                "end": 7.580
            },
            {
                "speaker_id": "1",
                "transcription": "땡큐.",
                "sound_type": [
                    2
                ],
                "start": 7.590,
                "end": 8.615
            },
            {
                "speaker_id": "2",
                "transcription": "유 어 웰컴.",
