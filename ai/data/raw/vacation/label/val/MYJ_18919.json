        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇죠 아니 그정도는 그럴 수 있지.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.484
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 @이름1씨 혼자 텐트 2동을 다 접었다는 얘기잖아.",
                "sound_type": [
                    2
                ],
                "start": 1.484,
                "end": 4.562
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 익숙하지 않을 때",
                "sound_type": [
                    2
                ],
                "start": 4.562,
                "end": 6.080
            },
            {
                "speaker_id": "2",
                "transcription": "네 네 그리고 하나는 엄청 큰 거였는데 처음 쳤던 날이에요.",
                "sound_type": [
                    2
                ],
                "start": 6.080,
                "end": 10.690
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 거두는 거를 못하겠는 거예요 이거를",
                "sound_type": [
                    2
                ],
                "start": 10.690,
                "end": 14.202
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 그냥 막 접어가지고 급한 마음에",
                "sound_type": [
                    2
                ],
                "start": 14.202,
                "end": 16.447
            },
            {
                "speaker_id": "1",
                "transcription": "원래 천천히 어떻게 접어야 되지 이러면서 원래 접어야 되는데",
                "sound_type": [
                    2
                ],
                "start": 16.447,
                "end": 19.522
            },
            {
                "speaker_id": "2",
                "transcription": "해야 되는데 그냥 막 다 막 말아가지고 그것도 무게가 한 30킬로 가까이 되는 무거운 텐트인데 그걸 차에다 그냥 에잇 몰라하고 실어놓고 다 때려 넣듯이 막 때려 넣고 해도 3시간이 걸렸는데 그것도 정리가 안돼서 빨리 데크부터 좀 치워주고 뒷 사람부터 죄송한데 여기서 먼저 텐트 먼저 치세요.",
                "sound_type": [
                    2
                ],
                "start": 19.522,
                "end": 42.187
            },
            {
                "speaker_id": "2",
                "transcription": "하고 이제 나머지 이제 정리를 한 거예요.",
                "sound_type": [
                    2
                ],
                "start": 42.187,
                "end": 45.310
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 이제 끝나니까 한 4시간이 걸린 거예요.",
                "sound_type": [
                    2
                ],
                "start": 45.310,
                "end": 47.507
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 이제 퇴실해야 될 시간보다 1시간을 훌쩍 더 넘어가 가지고 뒷 팀한테는 민폐가 되고 나는 이제 체력 바닥 되고 언니는 녹초가 되고 그리고 이제 집에 왔어요.",
                "sound_type": [
                    2
                ],
                "start": 47.507,
                "end": 59.427
            },
            {
                "speaker_id": "2",
                "transcription": "아 그때 너무 힘들어서 아 앞으로 캠핑은 초대캠은 절대 하면 안 되고 여럿이 하면 안 되고 뭐 캠핑하시는 분들끼리 같이 가면은 몰라도 절대로 내 거를 가지고 다른 사람들 부르는 건 아니구나.",
                "sound_type": [
                    2
                ],
                "start": 59.427,
                "end": 75.860
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 너무 그거 했는데?",
                "sound_type": [
                    2
                ],
                "start": 75.862,
                "end": 78.095
            },
            {
                "speaker_id": "1",
                "transcription": "너무 기부천사였는데요?",
                "sound_type": [
                    2
                ],
                "start": 78.095,
                "end": 79.732
            },
            {
                "speaker_id": "2",
                "transcription": "그땐 몰랐으니깐요.",
                "sound_type": [
                    2
                ],
                "start": 79.732,
                "end": 81.455
            },
            {
                "speaker_id": "2",
                "transcription": "그때는 몰라 할 때 한지 얼마 안 되니까 몰라서 막 퍼줬는데 그때 너무 큰 깨달음을 얻고 지금은 전혀 안 하고",
