        "term": [
            {
                "speaker_id": "1",
                "transcription": "째날이 밝았어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.333
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 유니버셜스튜디오에 갈 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.343,
                "end": 4.271
            },
            {
                "speaker_id": "1",
                "transcription": "우버를 불러서 센토사 섬까지 갈 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.281,
                "end": 7.897
            },
            {
                "speaker_id": "1",
                "transcription": "저는 헐리우드랑 오사카에 있는 유니버셜을 가봤고 여기는 3번째 유니버셜이에요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.907,
                "end": 26.328
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 인터넷으로 사면은 좀 더 싼 거 같아가지고 이렇게 인터넷으로 사서 바우처를 프린트 해 왔어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.338,
                "end": 33.785
            },
            {
                "speaker_id": "1",
                "transcription": "티켓으로 안 바꾸고 바로 입장 가능한 것 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 33.795,
                "end": 37.202
            },
            {
                "speaker_id": "1",
                "transcription": "후 유니버셜 스튜디오스 싱가포르",
                "sound_type": [
                    2,
                    4
                ],
                "start": 37.212,
                "end": 43.811
            },
            {
                "speaker_id": "1",
                "transcription": "드디어 입장을 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 43.821,
                "end": 47.112
            },
            {
                "speaker_id": "1",
                "transcription": "가장 먼저 트랜스포머를 타러 가야 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 47.122,
                "end": 49.430
            },
            {
                "speaker_id": "1",
                "transcription": "트랜스포머가 어디 있지 찾으러 가 봅시다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 49.440,
                "end": 52.480
            }
        ]
    },
    "summary": "싱가포르 유니버셜스튜디오 티켓을 한국에서 인터넷으로 끊어 표를 프린트 해 왔다.",
