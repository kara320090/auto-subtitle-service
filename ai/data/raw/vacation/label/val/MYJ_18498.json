                ],
                "start": 0.000,
                "end": 1.255
            },
            {
                "speaker_id": "1",
                "transcription": "익스프레스 티켓을 샀는데 우리는 한 사람당 한 50이면 될 줄 알았는데 하나에 70이 둘이 140달러를 냈어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.265,
                "end": 9.524
            },
            {
                "speaker_id": "1",
                "transcription": "한 12만원 이거를 뽕을 빼고 가겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.534,
                "end": 14.212
            },
            {
                "speaker_id": "1",
                "transcription": "얼마나 익스프레스한지 봅시다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.222,
                "end": 16.743
            },
            {
                "speaker_id": "1",
                "transcription": "익스프레스티켓은 한 놀이기구에 한 번만 탈 수 있어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.753,
                "end": 23.355
            },
            {
                "speaker_id": "2",
                "transcription": "뭐야.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.365,
                "end": 24.782
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 무슨 새우국수인데 원래 11.50인데 그 바우처에 음식 5달러 할인해주는 것도 들어있더라고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.792,
                "end": 35.277
            },
            {
                "speaker_id": "1",
                "transcription": "그래 가지고 6.50에 샀습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 35.287,
                "end": 38.810
            },
            {
                "speaker_id": "1",
                "transcription": "이 그릇은 되게 허접하게 나와요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 38.820,
                "end": 41.161
            },
            {
