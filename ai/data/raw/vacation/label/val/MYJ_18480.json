        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "커피 엄청 달아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.099
            },
            {
                "speaker_id": "1",
                "transcription": "흥 달줄 알긴 했지만 이거는 연어 샐러드 밤에 술안주 여기가 밤에 10시 반 넘으면 술도 안 팔아요.",
                "sound_type": [
                    2
                ],
                "start": 1.109,
                "end": 9.696
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 편의점도 막 뭐 그렇게 잘 돼 있는 그런게 아니라서 밤에 살게 살만한게 없거든요?",
                "sound_type": [
                    2
                ],
                "start": 9.706,
                "end": 16.617
            },
            {
                "speaker_id": "1",
                "transcription": "가게들도 일찍 닫고 그래갖고 뭐 혹시 밤에 맥주랑 먹고 싶으면 이거 연어 샐러드 사 봤고 그 다음에 요거는 연어 초밥을 살까 하다가 어차피 많이 먹을거라서 간단하게 요런거 마끼 사 봤고요.",
                "sound_type": [
                    2
                ],
                "start": 16.627,
                "end": 31.493
            },
            {
                "speaker_id": "1",
                "transcription": "오니기리도 하나 사 봤고 요기 대게 특이한데 이게 유부초밥인데 안에 내용물이 뭐 신기한것들이 들어있더라고요.",
                "sound_type": [
                    2
                ],
                "start": 31.503,
                "end": 40.530
            },
            {
                "speaker_id": "1",
                "transcription": "지금 다 찌부됐는데 새우롤 과자 이거 무슨 맛인지 궁금해서 과자 이거는 과일같은데 이게 뭔지 모르겠거든요 사실 .",
                "sound_type": [
                    2
                ],
                "start": 40.540,
                "end": 48.730
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그냥 뭔가 맛있을거 같기도 하고 그렇게 싸지 않아요.",
                "sound_type": [
                    2
                ],
                "start": 48.740,
                "end": 52.816
            },
            {
                "speaker_id": "1",
                "transcription": "5달러 90센트면 5천원 그정도인데 무슨 맛인지 궁금해 사봤어요.",
                "sound_type": [
                    2
                ],
                "start": 52.826,
                "end": 57.599
            },
            {
                "speaker_id": "1",
                "transcription": "맛 없으면 다 버려야 돼요.",
                "sound_type": [
                    2
                ],
                "start": 57.609,
                "end": 58.827
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도 사왔고 여기에 제 컵라면이 한국에서 가져온게 있어가지고 여거랑 먹을려고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.837,
                "end": 66.530
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 지금 다 먹을건 아니고 몇 개만 먹을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 66.540,
                "end": 70.216
            },
            {
                "speaker_id": "1",
                "transcription": "안해?",
                "sound_type": [
                    2,
