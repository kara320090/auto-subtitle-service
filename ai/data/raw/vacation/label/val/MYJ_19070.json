                    5
                ],
                "start": 0.000,
                "end": 2.564
            },
            {
                "speaker_id": "1",
                "transcription": "와 여기 거북손들 엄청 많은데",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 2.574,
                "end": 20.803
            },
            {
                "speaker_id": "1",
                "transcription": "지금 여기 얘들보다 요 밑에 있는 얘들이 지금 사이즈가 더 좋거든 근데 제가 좀 채취하기가 좀 번거롭긴 해 구석이라서",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.813,
                "end": 30.411
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 좀 약간 큰 거를 좀 따 봐야지.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 30.421,
                "end": 33.187
            },
            {
                "speaker_id": "1",
                "transcription": "아야야야 아 아우 다 캤다.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 33.197,
                "end": 50.469
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도면 뭐 충분할 것 같네.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 50.479,
                "end": 55.602
            },
            {
                "speaker_id": "1",
                "transcription": "지금 물이 없어 가지고 졸졸졸 내려오는 게 지금 산 물이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.612,
                "end": 78.776
            },
            {
                "speaker_id": "1",
                "transcription": "요 산 물 요거는 담수니까 요다가 살짝 헹가 가지고 삶은면 될 것 같애요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 78.786,
                "end": 84.300
            }
        ]
    },
    "summary": "거북손이 엄청 많고 밑에 거북손이 크기가 더 커서 내려가서 채취하고 산 물을 이용해서 헹궈서 삶으면 될 것 같다.",
