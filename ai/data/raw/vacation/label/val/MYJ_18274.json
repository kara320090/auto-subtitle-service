        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 이렇게 반가울 일인가.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.622
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 12시네 이제.",
                "sound_type": [
                    2
                ],
                "start": 1.632,
                "end": 3.897
            },
            {
                "speaker_id": "1",
                "transcription": "술집 끝나가지고 나와가지고 지금 2시 넘었거든요?",
                "sound_type": [
                    2
                ],
                "start": 3.907,
                "end": 6.914
            },
            {
                "speaker_id": "1",
                "transcription": "와 이제야 왔어 이제야.",
                "sound_type": [
                    2
                ],
                "start": 6.924,
                "end": 8.322
            },
            {
                "speaker_id": "1",
                "transcription": "내가 자차 소유한 사람인데 어?",
                "sound_type": [
                    2
                ],
                "start": 8.332,
                "end": 10.925
            },
            {
                "speaker_id": "1",
                "transcription": "택시가 잡기가 이렇게 힘들어가지고.",
                "sound_type": [
                    2
                ],
                "start": 10.935,
                "end": 13.559
            },
            {
                "speaker_id": "1",
                "transcription": "대전에서도 이렇게 뭐 나가서 술 먹고 이러지를 않으니까 택시 안 잡히고 이런 경험을 처음 해보는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 13.569,
                "end": 19.994
            },
            {
                "speaker_id": "1",
                "transcription": "코로나 시대에 대박이다 진짜.",
                "sound_type": [
                    2
                ],
                "start": 20.004,
                "end": 22.288
            },
            {
                "speaker_id": "1",
                "transcription": "어제는 새벽에 늦게 들어왔었는데 오늘 또 나갑니다.",
