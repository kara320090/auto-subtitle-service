            },
            {
                "speaker_id": "1",
                "transcription": "그렇죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.145,
                "end": 2.276
            },
            {
                "speaker_id": "1",
                "transcription": "와 이걸 일부러 이렇게 울퉁불퉁하게 한 것 같은데 또",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.286,
                "end": 5.650
            },
            {
                "speaker_id": "2",
                "transcription": "그렇죠 자연스럽게 해",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.660,
                "end": 6.874
            },
            {
                "speaker_id": "1",
                "transcription": "그렇죠 아 이거 그리고 뭐 좀 흘리고 막 해도 아무 상관 없겠는데요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.884,
                "end": 10.758
            },
            {
                "speaker_id": "1",
                "transcription": "막 기스 나도 상관 없겠는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.768,
                "end": 12.314
            },
            {
                "speaker_id": "1",
                "transcription": "느낌이 어차피 원래 그러니까",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.324,
                "end": 14.002
            },
            {
                "speaker_id": "2",
                "transcription": "자연 그 느낌이다 보니까",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.012,
                "end": 16.728
            },
            {
                "speaker_id": "1",
                "transcription": "네 형님은 보니까 딱 보니까 보통 혼자 다니세요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.738,
                "end": 19.856
            },
            {
                "speaker_id": "2",
                "transcription": "보통 여자친구를 두 명이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.866,
                "end": 21.347
            },
            {
                "speaker_id": "1",
                "transcription": "두 분이?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.357,
                "end": 21.830
            },
            {
                "speaker_id": "1",
                "transcription": "딱 요기에서?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.840,
                "end": 22.672
            },
            {
                "speaker_id": "2",
                "transcription": "네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.682,
                "end": 23.225
            },
            {
                "speaker_id": "1",
                "transcription": "야침 하나 딱",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.235,
                "end": 24.013
            },
            {
                "speaker_id": "2",
                "transcription": "하나 더 추가하고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.023,
                "end": 25.228
            },
            {
                "speaker_id": "1",
                "transcription": "근데 살짝 어때요 좁아요 어때요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.238,
                "end": 27.315
            },
            {
                "speaker_id": "2",
                "transcription": "아 겨울에는 이제 난로까지 하면은 좀 좁은데 그래도 딱",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.325,
                "end": 31.108
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 계절에는 좀 충분히 쓸만하고 어 형님 캠핑의 전체적인 그 컨셉이 뭐예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.118,
                "end": 37.245
            },
            {
                "speaker_id": "2",
                "transcription": "다 필요 없고 그냥 무조건 미니멀",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.255,
                "end": 39.090
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 미니멀?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.100,
                "end": 39.957
            },
            {
                "speaker_id": "2",
                "transcription": "그래야 자주 나간다 한 번 더 나가고 그래 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.967,
                "end": 42.723
            },
            {
                "speaker_id": "1",
                "transcription": "여자친구분은 근데 좋아하세요?",
                "sound_type": [
