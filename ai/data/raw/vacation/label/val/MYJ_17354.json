        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "저녁에 보니까 좀 느낌이 다르긴 하네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.841
            },
            {
                "speaker_id": "1",
                "transcription": "바람도 아까보다는 좀 덜 불고 어 구름도 지금 다 없어졌습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 3.851,
                "end": 10.399
            },
            {
                "speaker_id": "1",
                "transcription": "야 내일 바로셀로나는 되게 날씨가 좋을 것 같아요, 왠지.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.409,
                "end": 15.517
            },
            {
                "speaker_id": "1",
                "transcription": "어 내일은 되게 일찍 도착해요 바르셀로나에.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 15.527,
                "end": 20.338
            },
            {
                "speaker_id": "1",
                "transcription": "오전 5시 정도에 도착해요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.348,
                "end": 23.915
            },
            {
                "speaker_id": "1",
                "transcription": "거기가 이제 주요 모항이라 어 빨리 도착해서 빨리 하선 준비를 해야 되기 때문이죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 23.925,
                "end": 30.511
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 내일은 좀 서둘러서 어 아침",
                "sound_type": [
                    1,
                    2
                ],
                "start": 30.521,
                "end": 35.577
            }
        ]
    },
