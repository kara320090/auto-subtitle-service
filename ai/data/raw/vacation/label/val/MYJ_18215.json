            },
            {
                "speaker_id": "1",
                "transcription": "내 선크림 왜 안 와 왜 안 와",
                "sound_type": [
                    2
                ],
                "start": 1.067,
                "end": 4.680
            },
            {
                "speaker_id": "1",
                "transcription": "내 선크림 빌려줬는데 왜 안 와",
                "sound_type": [
                    2
                ],
                "start": 4.690,
                "end": 9.079
            },
            {
                "speaker_id": "1",
                "transcription": "백패킹에는 이런 주머니가 있으니까 진짜 좋은 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 9.089,
                "end": 12.846
            },
            {
                "speaker_id": "1",
                "transcription": "씨투써밋 건데 진짜 완전 가볍고 이게 이렇게 조여지고 슝",
                "sound_type": [
                    2
                ],
                "start": 12.840,
                "end": 17.255
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 딱 쓸 것만 이렇게 넣어왔거든요.",
                "sound_type": [
                    2
                ],
                "start": 17.265,
                "end": 19.314
            },
            {
                "speaker_id": "1",
                "transcription": "너무 좋은 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 19.324,
                "end": 20.359
            },
            {
                "speaker_id": "1",
                "transcription": "선크림 주세요.",
