                    2
                ],
                "start": 24.080,
                "end": 26.175
            },
            {
                "speaker_id": "1",
                "transcription": "지금 햇빛이 엄청 강렬한 게 느껴지시죠",
                "sound_type": [
                    2
                ],
                "start": 26.185,
                "end": 28.996
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 선크림을 빨리 발라야 돼요.",
