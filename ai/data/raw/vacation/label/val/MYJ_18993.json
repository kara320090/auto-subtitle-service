        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 저랑 먼저 얘기하셨을 때 뭐 햄 만드는 회사에 있으셨다면서요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.553
            },
            {
                "speaker_id": "2",
                "transcription": "목우촌 아세요?",
                "sound_type": [
                    2
                ],
                "start": 3.563,
                "end": 5.072
            },
            {
                "speaker_id": "2",
                "transcription": "햄도 말들고 베이컨도 만들고 하는데 정말 기억에 남는 게 제가 그 프로젝트 할 때 목우촌 핫도그를 정말 좋아했어요.",
                "sound_type": [
                    2
                ],
                "start": 5.082,
                "end": 12.618
            },
            {
                "speaker_id": "2",
                "transcription": "핫도그가 너무 맛있더라고요.",
                "sound_type": [
                    2
                ],
                "start": 12.628,
                "end": 13.451
            },
            {
                "speaker_id": "1",
                "transcription": "아 원래도?",
                "sound_type": [
                    2
                ],
                "start": 13.461,
                "end": 14.139
            },
            {
                "speaker_id": "2",
                "transcription": "아 예 근데 그 프로젝트 하면서 제가 핫도그 좋아한다고 하니까 그 클라인트분이 매일 그 프로젝트 때 핫도그를 채워 놓으시는거예요 냉장고에.",
                "sound_type": [
                    2
                ],
                "start": 14.149,
                "end": 22.540
            },
            {
                "speaker_id": "2",
                "transcription": "그걸 다 먹었거든요.",
                "sound_type": [
                    2
                ],
                "start": 22.550,
                "end": 24.094
            },
            {
                "speaker_id": "2",
                "transcription": "그 프로젝트 끝날 때 저의 집주소를 여쭤보시더라고요.",
                "sound_type": [
                    2
                ],
                "start": 24.104,
                "end": 27.879
            },
            {
                "speaker_id": "2",
                "transcription": "어디 사시냐고 알려드렸더니 집으로 프로젝트 끝나고 핫도그를 1박스 보내주셨어요.",
                "sound_type": [
                    2
                ],
                "start": 27.889,
                "end": 33.651
            },
            {
                "speaker_id": "1",
                "transcription": "유통 기한도 없잖아요 거의.",
                "sound_type": [
                    2
                ],
                "start": 33.661,
                "end": 34.949
            },
            {
                "speaker_id": "2",
                "transcription": "냉동실에 넣어 놓고 먹으면 된다고 보내주셔서 그게 정말 기억에 남는",
                "sound_type": [
                    2
                ],
                "start": 34.959,
                "end": 39.123
            },
            {
                "speaker_id": "1",
                "transcription": "아 그런 것 좀 재미있는데요?",
                "sound_type": [
                    2
                ],
                "start": 39.133,
                "end": 40.705
            },
            {
                "speaker_id": "2",
                "transcription": "근데 항상 재미있는 건 아니에요.",
                "sound_type": [
                    2
                ],
                "start": 40.715,
                "end": 42.621
            },
            {
                "speaker_id": "2",
                "transcription": "힘들었던 프로젝트를 하고 나면 저는 거기 제 나름대로 소심하게 복수한다고 불매합니다.",
                "sound_type": [
                    2
                ],
                "start": 42.631,
                "end": 49.043
            },
            {
                "speaker_id": "2",
                "transcription": "거기건 절대 안 사야지 뭐 이런 불매도 하고 그 우울했던 프로젝트 막 회사가 어려워서 법정 관리 가냐 안가냐 이런 프로젝트 있어요.",
                "sound_type": [
                    2
                ],
                "start": 49.053,
                "end": 59.706
            },
            {
                "speaker_id": "2",
                "transcription": "그러면은 가면 저도 우울해 지더라고요.",
                "sound_type": [
                    2
                ],
                "start": 59.716,
                "end": 62.027
            },
            {
                "speaker_id": "2",
                "transcription": "가면 힘도 없고 어둡고 항상 즐거운 것만은 아니었어요.",
                "sound_type": [
                    2
                ],
                "start": 62.037,
                "end": 65.966
            },
            {
                "speaker_id": "1",
                "transcription": "아 와 신기한 일을 하셨네요.",
                "sound_type": [
                    2
                ],
                "start": 65.976,
                "end": 67.959
            },
            {
                "speaker_id": "2",
                "transcription": "예 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 67.969,
                "end": 68.001
            },
            {
                "speaker_id": "1",
                "transcription": "아니 근데 그렇게 완전 이 캠핑이랑 생뚱맞은 동떨어진 일 하시다가 이건 어떻게 시작하신 거예요 갑자기?",
                "sound_type": [
                    2
                ],
                "start": 68.011,
                "end": 76.144
            },
            {
                "speaker_id": "2",
                "transcription": "인제 한 2년 정도 캠핑한지 2년 정도 된 캠린이인데요.",
                "sound_type": [
                    2
                ],
                "start": 76.154,
                "end": 79.651
            },
            {
                "speaker_id": "2",
                "transcription": "캠핑을 시작하면서 캠핑 2번 갔다 온 다음에 뭔가 사업할 만한 기회가 있겠다라는 느낌을 딱 받았어요.",
                "sound_type": [
                    2
                ],
                "start": 79.661,
                "end": 87.786
            },
            {
                "speaker_id": "2",
                "transcription": "이게 캠핑 시장 막 성장한다 하고 저도 코로나 때 큰 딸이 막 캠핑하자고 졸라서 시작을 했거든요.",
                "sound_type": [
                    2
                ],
                "start": 87.796,
                "end": 94.799
            },
            {
                "speaker_id": "2",
                "transcription": "그때 보면 뭐 캠핑 시장 어마어마하게 성장한다 막 그래서 대단히 발전한 시장이라고 생각을 했는데 막상 캠핑을 해보니까 낙후된 시장이더라고요.",
                "sound_type": [
                    2
                ],
                "start": 94.809,
                "end": 103.506
            },
            {
                "speaker_id": "1",
                "transcription": "아 그거를 그런 일을 해 보셔서 감이 오셨나 보다.",
                "sound_type": [
                    2
                ],
                "start": 103.516,
                "end": 107.362
            },
            {
                "speaker_id": "2",
                "transcription": "예 뭐 그럴 수도 있는데",
                "sound_type": [
                    2
                ],
                "start": 107.372,
                "end": 109.958
            }
        ]
    },
    "summary": "화자3은 목우촌에서 일할 때 핫도그를 제공받았던 게 기억에 남고 우울한 프로젝트를 할 때는 힘들었다고 하며 딸이 졸라서 시작한 캠핑을 하다보니 캠핑 시장이 낙후되었다고 생각하여 사업을 시작하게 되었다고 말한다.",
