        "term": [
            {
                "speaker_id": "1",
                "transcription": "저희는 이제 그 부분은 좀 리뉴얼하는데 신경을 좀 쓸 생각입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.054
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 사이트 간격도 좀 넓게 해 주실 거예요?",
                "sound_type": [
                    2
                ],
                "start": 3.064,
                "end": 5.184
            },
            {
                "speaker_id": "1",
                "transcription": "아 저희 저 텐트 발할이잖아요.",
                "sound_type": [
                    2
                ],
                "start": 5.194,
                "end": 8.192
            },
            {
                "speaker_id": "2",
                "transcription": "기본적으로 발할칠 때 있는 데가 별로 없어요.",
                "sound_type": [
                    2
                ],
                "start": 8.202,
                "end": 10.636
            },
            {
                "speaker_id": "2",
                "transcription": "얘가 몇 미터죠?",
