        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 이런 쓰레기들이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.209
            },
            {
                "speaker_id": "1",
                "transcription": "그런 것들을 아무데나 버려 가지고 이 우리나라 항구가 사실 다니다 보면 굉장히 이쁘고 아름답습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.219,
                "end": 9.737
            },
            {
                "speaker_id": "1",
                "transcription": "여기도 보면 막 쓰레기 그냥 아까 버리더라구요 이렇게.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.747,
                "end": 13.322
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 버려요 그냥 아무 생각 없이.",
                "sound_type": [
                    2
                ],
                "start": 13.332,
                "end": 16.569
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거는 사실 다 분리 수거를 해야 되고 플라스틱은 플라스틱대로",
                "sound_type": [
                    2
                ],
                "start": 16.579,
