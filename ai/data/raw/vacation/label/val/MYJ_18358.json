        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 맛있어.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.542
            },
            {
                "speaker_id": "1",
                "transcription": "이거 막 이 막 즙이 막 쫙쫙 나와요.",
                "sound_type": [
                    2
                ],
                "start": 0.552,
                "end": 3.485
            },
            {
                "speaker_id": "1",
                "transcription": "너무 맛있어.",
                "sound_type": [
                    2
                ],
                "start": 3.495,
                "end": 5.511
            },
            {
                "speaker_id": "1",
                "transcription": "이거 나는 냉동실에 못 넣을 것 같애.",
                "sound_type": [
                    2
                ],
                "start": 5.521,
                "end": 7.877
            },
            {
                "speaker_id": "1",
                "transcription": "다 먹어야 될 거 같애 내가.",
                "sound_type": [
                    2
                ],
                "start": 7.887,
                "end": 9.364
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 뭔가 술 안주로 대박 저는 오징어 말린 거 이런 거 너무 딱딱한 건 이 아파서 잘 안 먹거든요.",
                "sound_type": [
                    2
                ],
                "start": 9.374,
                "end": 15.961
            },
            {
                "speaker_id": "1",
                "transcription": "근데 얘는 말랑말랑하고 너무 맛있어.",
                "sound_type": [
                    2
                ],
                "start": 15.971,
                "end": 18.132
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 진짜 살까 말까 했던 건데 사길 너무 잘한 거 같애.",
                "sound_type": [
                    2
                ],
                "start": 18.142,
                "end": 21.200
            },
            {
                "speaker_id": "1",
                "transcription": "너무 맛있어.",
                "sound_type": [
                    2
                ],
                "start": 21.210,
                "end": 22.229
            },
            {
                "speaker_id": "1",
                "transcription": "막간을 이용해서 저가 지금 이렇게 네 가지의 택배가 있어 가지고 열어 보려고 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.239,
                "end": 29.535
            },
            {
                "speaker_id": "1",
                "transcription": "우선 요거 짠 포에버링 포에버링은 제가 그 광고 찍었던 그 사이트인데 여기가 진짜 좋거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.545,
                "end": 40.425
            },
            {
                "speaker_id": "1",
                "transcription": "요런 귀걸이도 맨날 서비스로 이렇게 넣어 줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.435,
                "end": 43.345
            },
            {
                "speaker_id": "1",
                "transcription": "이 포에버링이 뭐냐면은 진짜 좋아서 제가 또 말씀드리는 건데 골드 주얼리를 파는 곳이거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.355,
                "end": 49.153
            },
            {
                "speaker_id": "1",
                "transcription": "처음에 사서 끼다가 좀 질리고 다른 걸 사고 싶다 하면은 내가 끼던 걸 보내서 교환하는 그런 서비스예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.163,
                "end": 56.316
            },
            {
                "speaker_id": "1",
                "transcription": "근데 진짜 좋은 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.326,
                "end": 57.562
            },
            {
                "speaker_id": "1",
                "transcription": "그 저는 벌써 교환을 거의 5번 4번 그 정도 한 거 같애요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.572,
                "end": 61.659
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 61.669,
                "end": 62.469
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이번에 신청한 제품은 짠",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.479,
                "end": 66.400
            }
        ]
    },
    "summary": "문어에서 즙이 나오고 말랑말랑해서 너무 맛있다고 한다. 택배를 개봉하면서 주얼리를 사고 교환할 수 있는 서비스를 제공하는 포에버링에 대해 소개한다.",
