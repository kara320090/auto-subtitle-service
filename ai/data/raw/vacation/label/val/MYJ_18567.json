                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.459
            },
            {
                "speaker_id": "1",
                "transcription": "현장 구매 가능하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.469,
                "end": 2.806
            },
            {
                "speaker_id": "1",
                "transcription": "네이버 지도에서 속초 아이 대관람차 검색하시면 예매도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.816,
                "end": 6.899
            },
            {
                "speaker_id": "1",
                "transcription": "다만 예매는 오전 11시부터 12시까지 1회차만 가능한 점 주의하시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.909,
                "end": 12.995
            },
            {
                "speaker_id": "1",
                "transcription": "아파트 22층 높이라고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.005,
                "end": 15.786
            },
            {
                "speaker_id": "1",
                "transcription": "경치가 굉장하겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.796,
                "end": 17.441
            },
            {
                "speaker_id": "1",
                "transcription": "풍경을 직접 보여드리면 참 좋을 텐데 그러지 못해서 죄송합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.451,
                "end": 22.160
            },
            {
                "speaker_id": "1",
                "transcription": "백견이 불여일행이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.161,
                "end": 24.130
            },
            {
                "speaker_id": "1",
                "transcription": "궁금하신 분들은 그냥 직접 경험해 보시길 바라면서 다음 장소로 이동하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.120,
                "end": 29.665
            },
            {
                "speaker_id": "1",
                "transcription": "미디어에 노출된 적이 워낙에 많죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.675,
                "end": 32.456
            },
            {
                "speaker_id": "1",
                "transcription": "꽤 많은 분들이 친숙함을 느낄 것 같습니다.",
