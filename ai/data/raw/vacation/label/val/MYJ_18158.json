        "term": [
            {
                "speaker_id": "1",
                "transcription": "동영상 촬영이니까 왜 영상만 찍히는 줄 알았어?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 2.334
            },
            {
                "speaker_id": "2",
                "transcription": "아니 그냥 이러저런 발언을 많이 할것 같아서",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 2.344,
                "end": 5.163
            },
            {
                "speaker_id": "1",
                "transcription": "조심해야지.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 5.173,
                "end": 6.474
            },
            {
                "speaker_id": "2",
                "transcription": "그건 알아서 이케 거르시겠지.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 6.484,
                "end": 8.903
            },
            {
                "speaker_id": "1",
                "transcription": "왜.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 8.913,
                "end": 9.545
            },
            {
                "speaker_id": "2",
                "transcription": "아니 뭐.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 9.555,
                "end": 10.080
            },
            {
                "speaker_id": "1",
                "transcription": "내가 말한 것도 아닌데",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 10.090,
                "end": 11.766
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 조지는 것보다 형이 조지잖아요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 11.776,
                "end": 13.750
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그런 친구들 저급한 친구들을 갱생시켜주는 선한 영향력을 미치는 사람",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 13.760,
                "end": 20.767
            },
            {
                "speaker_id": "2",
                "transcription": "윗물이 맑아야 아랫물이 맑다고 형이 맑지 않으니",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 20.777,
                "end": 24.257
            }
        ]
    },
    "summary": "영상을 찍는것을 말하며 형에게 윗물이 맑아야 아랫물이 맑다고 이야기한다.",
