        "term": [
            {
                "speaker_id": "1",
                "transcription": "역시 2개 어 4개인가?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.121
            },
            {
                "speaker_id": "1",
                "transcription": "어 4개네 아 4개가 들어 있어요.",
                "sound_type": [
                    2
                ],
                "start": 2.131,
                "end": 4.698
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 되게 가성비 좋네.",
                "sound_type": [
                    2
                ],
                "start": 4.708,
                "end": 6.761
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 기념품은 아닌데 이거 공병이거든요.",
                "sound_type": [
                    2
                ],
                "start": 6.771,
                "end": 10.419
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 2달러밖에 안 나왔는데 이게 깔대기도 들어 있고 되게 좋아 보이더라고요.",
                "sound_type": [
                    2
                ],
                "start": 10.429,
                "end": 16.342
            },
            {
                "speaker_id": "1",
                "transcription": "저녁을 먹으러 유튼 호커 센터에 왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.352,
                "end": 19.918
            },
            {
                "speaker_id": "1",
                "transcription": "푸드 코트처럼 이렇게 바깥의 야외 자리가 쫙 있고 가게들이 주변에 쫙 있는 그런 곳이래요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.928,
                "end": 26.580
            },
            {
                "speaker_id": "1",
                "transcription": "생각보다 되게 깔끔하다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.590,
                "end": 28.538
            },
            {
                "speaker_id": "1",
                "transcription": "27번째로 가랬는데",
                "sound_type": [
                    2,
                    4
                ],
                "start": 28.548,
                "end": 31.180
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기가 맛있대.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 31.190,
                "end": 32.961
            },
            {
                "speaker_id": "1",
                "transcription": "이거 이거 시키면 돼 이거 A",
                "sound_type": [
                    2,
                    4
                ],
                "start": 32.971,
                "end": 35.351
            },
            {
                "speaker_id": "2",
                "transcription": "이거 하나면 돼?",
