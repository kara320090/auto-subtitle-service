        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.336
            },
            {
                "speaker_id": "2",
                "transcription": "아 안녕하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.346,
                "end": 2.139
            },
            {
                "speaker_id": "1",
                "transcription": "저 커피 한잔 해주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.149,
                "end": 3.047
            },
            {
                "speaker_id": "2",
                "transcription": "아 그럼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.057,
                "end": 13.217
            },
            {
                "speaker_id": "1",
                "transcription": "일단 저 이 의자부터 진짜 예뻤잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.227,
                "end": 15.967
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.977,
                "end": 16.736
            },
            {
                "speaker_id": "1",
                "transcription": "인터넷으로 봤을 땐 사진으로 조금 별로였거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.746,
                "end": 19.345
            },
            {
                "speaker_id": "2",
                "transcription": "예 맞아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.355,
                "end": 20.104
            },
            {
                "speaker_id": "1",
                "transcription": "근데 되게 뭔가 쨍하고 쿨한 느낌이네요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.114,
                "end": 22.446
            },
            {
                "speaker_id": "2",
                "transcription": "특히 이제 요즘 같은 날씨랑 딱 맞는 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.456,
                "end": 25.483
            },
            {
                "speaker_id": "2",
                "transcription": "봄 여름",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.493,
                "end": 26.028
            },
            {
                "speaker_id": "1",
                "transcription": "이게 저는 별로 쓸모 없을 줄 알았는데 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.038,
                "end": 29.362
            },
            {
                "speaker_id": "2",
                "transcription": "생각보다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.372,
                "end": 29.935
            },
            {
                "speaker_id": "1",
                "transcription": "오 아 커피인데 아니 아빤데 @이름1 아빠님은 딱 보니까 컨셉이 전체적으로 딱 한 한두마디로 정리하면 뭐예요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.945,
                "end": 38.551
            },
            {
                "speaker_id": "2",
                "transcription": "겉멋?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.561,
                "end": 39.367
            },
            {
                "speaker_id": "1",
                "transcription": "용품에 아 건멋 아 솔직하시네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.377,
                "end": 42.274
            },
            {
                "speaker_id": "2",
                "transcription": "겉멋만 좀 겉멋 내는 걸 좋아해 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.284,
                "end": 45.827
            },
            {
                "speaker_id": "1",
                "transcription": "아 겉멋의 끝으로 아 근데 아빠님은 애기 둘 데리고 다니시잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.837,
                "end": 50.001
            },
            {
                "speaker_id": "2",
                "transcription": "아 아기 하나 근데 저희가 그렇게 밥을 막 해먹거나 뭐 부산스럽게 하는 게 없어서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.011,
                "end": 55.741
            },
            {
                "speaker_id": "1",
                "transcription": "애기 근데 애기 저도 그런데 저도 원래 그런 스타일이었는데 애기한테 뭐 해줄 때 어때요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.751,
                "end": 61.148
            },
            {
                "speaker_id": "2",
                "transcription": "딱히 저는 그 생선 구이를 되게 좋아해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.158,
                "end": 63.945
            },
            {
                "speaker_id": "1",
                "transcription": "애기가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.955,
                "end": 64.449
            },
            {
                "speaker_id": "2",
                "transcription": "예",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.459,
                "end": 64.668
            },
            {
                "speaker_id": "1",
                "transcription": "아 그냥 딱 고것만 가지고 오면 끝나는 느낌인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.678,
                "end": 66.779
            },
            {
                "speaker_id": "2",
                "transcription": "햇반 지금 요즘에는 또 전자레인지로 돌릴 수 있게 나오거든요 비비고에서?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.789,
                "end": 70.890
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 그거 그냥 전자레인지에 돌려서 와서 주면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.900,
                "end": 73.861
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 제일 좋아하는 것 딱 하나 가져오는 느낌으로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.871,
                "end": 76.821
            },
            {
                "speaker_id": "2",
                "transcription": "그 정도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.831,
                "end": 77.662
            },
            {
                "speaker_id": "1",
                "transcription": "아 저도 그걸 공감되는 게 저는 칼국수 만들고 다니잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.672,
                "end": 81.028
            },
            {
                "speaker_id": "1",
                "transcription": "스파게티랑 칼국수 아니 근데 지금 딱 이 용품들을 보면은 되게 디테일한 용품이 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.038,
                "end": 87.107
            },
            {
                "speaker_id": "1",
                "transcription": "이런 디테일한 용품들은 약간 애기랑 다닐 때 부담되잖아 어 그게 안 돼 안 돼 그 일 해야 되잖아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.117,
                "end": 93.110
            },
            {
                "speaker_id": "2",
                "transcription": "약간 이게 저도 모르게 눈치를 보기는 보는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.120,
                "end": 98.166
            }
        ]
    },
