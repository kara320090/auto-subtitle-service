        "term": [
            {
                "speaker_id": "1",
                "transcription": "귀엽죠 하트 집게 이것도 집게 이거는 두 개 1500원 너무 귀여워.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.118
            },
            {
                "speaker_id": "1",
                "transcription": "사실 이런 집게 쓸 일 잘 없는데 너무 귀요미야.",
                "sound_type": [
                    2
                ],
                "start": 9.128,
                "end": 12.818
            },
            {
                "speaker_id": "1",
                "transcription": "이번 산 것 중에 제일 쓸모없는 이거 통이에요 통.",
                "sound_type": [
                    2
                ],
                "start": 12.828,
                "end": 17.913
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 사탕 모양 인데 케이스 케이스 웃기죠 살까 말까 하다가 그냥 샀거든요.",
                "sound_type": [
                    2
                ],
                "start": 17.923,
                "end": 24.665
            },
            {
                "speaker_id": "1",
                "transcription": "연남동 소품샵 들어가면 이렇게 다 이렇게 스티커 들을 주더라고요 이런 귀요미 들을 샀다.",
                "sound_type": [
                    2
                ],
                "start": 24.675,
                "end": 30.844
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 양재동 갈 거예요 양재동.",
                "sound_type": [
                    2
                ],
                "start": 30.854,
                "end": 32.874
            },
            {
                "speaker_id": "1",
                "transcription": "여기가 양재천인가.",
                "sound_type": [
                    2
                ],
                "start": 32.884,
                "end": 34.215
            },
            {
                "speaker_id": "2",
                "transcription": "여기 다 양재천 이야 예쁘다.",
                "sound_type": [
                    2
                ],
                "start": 34.225,
                "end": 37.000
            }
        ]
    },
    "summary": "연남동 소품샵에서 산 물건들을 보여주며 리뷰하고 있다.",
