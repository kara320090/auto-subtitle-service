                    3,
                    4
                ],
                "start": 2.049,
                "end": 12.044
            },
            {
                "speaker_id": "1",
                "transcription": "거기 마리나베이에서 기념품을 샀는데 여기다가 이렇게 넣어줬어요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
