                "start": 0.000,
                "end": 2.039
            },
            {
                "speaker_id": "1",
                "transcription": "마리나베이 레이저쇼는 우와 머라이언파크가 아니라 마리나베이 쪽에서 봐야 됩니다.",
                "sound_type": [
