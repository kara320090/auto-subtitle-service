        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어머머 이렇게까지 안 떨어지는 건 또 처음 보네.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.100
            },
            {
                "speaker_id": "1",
                "transcription": "참나",
                "sound_type": [
                    2
                ],
                "start": 3.110,
                "end": 3.914
            },
            {
                "speaker_id": "1",
                "transcription": "어 힘들게 다 뗐어요.",
                "sound_type": [
                    2
                ],
                "start": 3.924,
                "end": 5.467
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 크리스마스를 맞아서 트리가 있는 요거를 할 거예요.",
                "sound_type": [
                    2
                ],
                "start": 5.477,
                "end": 10.184
            },
            {
                "speaker_id": "1",
                "transcription": "앞에 거는 너무 예뻐 가지고 제가 한 달 동안이나 붙이고 있었거든요.",
                "sound_type": [
                    2
                ],
                "start": 10.194,
                "end": 14.232
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 과연?",
                "sound_type": [
                    2
                ],
                "start": 14.242,
                "end": 15.796
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 이렇게 생긴 거예요.",
                "sound_type": [
                    2
                ],
                "start": 15.806,
                "end": 17.675
            },
            {
                "speaker_id": "1",
                "transcription": "약간 베이지 톤이랑 이렇게 은색깔 반짝이 이쁘다.",
                "sound_type": [
                    2
                ],
                "start": 17.685,
                "end": 21.806
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 붙여봐야겠다.",
                "sound_type": [
                    2
                ],
                "start": 21.816,
                "end": 23.235
            },
            {
                "speaker_id": "1",
                "transcription": "이게 메인이네 반짝반짝.",
                "sound_type": [
                    2
                ],
                "start": 23.245,
                "end": 25.308
            },
            {
                "speaker_id": "1",
                "transcription": "짜잔 일단 스티커는 다 붙였고 여기에다가 저는 요런 파츠들을 더 올려가지고 조금 더 반짝반짝하게 해줄 거예요.",
                "sound_type": [
                    2
                ],
                "start": 25.318,
                "end": 37.069
            },
            {
                "speaker_id": "1",
                "transcription": "짜잔 저는 이렇게 스티커를 붙이고 그 위에다가 이렇게 파츠를 제가 막 마음대로 올리거든요?",
                "sound_type": [
                    2
                ],
                "start": 37.079,
                "end": 43.592
            },
            {
                "speaker_id": "1",
                "transcription": "이 트리 위에 원래 별 그림이 있는데 거기에다가 별 파츠를 붙였어요.",
                "sound_type": [
                    2
                ],
                "start": 43.602,
                "end": 49.436
            },
            {
                "speaker_id": "1",
                "transcription": "별 파츠를 올리고 이런 데에는 그냥 금색 동그란 거?",
                "sound_type": [
                    2
                ],
                "start": 49.446,
                "end": 53.481
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 올려주고 여기도 동그란 거 그리고 여기는 큰 거 하나 올렸어요 달 모양.",
                "sound_type": [
                    2
                ],
                "start": 53.491,
                "end": 59.897
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 크리스마스 셀프 네일 완성",
                "sound_type": [
                    2
                ],
                "start": 59.907,
                "end": 64.212
            },
            {
                "speaker_id": "1",
                "transcription": "우와우",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.222,
                "end": 67.040
            }
        ]
    },
    "summary": "손톱을 떼고 크리스마스를 맞아 트리가 있는 네일을 새로 붙이며 다양한 파츠를 올리면서 셀프 네일을 완성했다.",
