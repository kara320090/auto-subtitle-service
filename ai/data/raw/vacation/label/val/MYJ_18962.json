        "term": [
            {
                "speaker_id": "1",
                "transcription": "다 나무로 돼 있고 이렇게 조립하는데 의자가 엄청 넓어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.637
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 약간 스킨이 약간 뭐라고 하지 이거를.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.647,
                "end": 7.650
            },
            {
                "speaker_id": "1",
                "transcription": "집디 체어 같은 그런 느낌 이 무늬가 와 장난 아니에요 저 처음 봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.660,
                "end": 13.225
            },
            {
                "speaker_id": "1",
                "transcription": "이거 하나 사가지고 가고 싶다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.235,
                "end": 15.500
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 이게 지금 아웃 사이드 인이라는 의자의 조립 완성된 상태인데 저 진짜 놀랬어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.510,
                "end": 21.411
            },
            {
                "speaker_id": "1",
                "transcription": "완전 판타스틱 어 보세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.421,
                "end": 25.458
            }
        ]
    },
    "summary": "아웃 사이드 인이라는 의자는 무늬가 마치 집디체어 같아 장난 아니라면서 처음 봐서 사고 싶다고 언급했으며 조립 완성된 게 판타스틱이라고 말한다.",
