        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "국내에서 가장 뛰어나신 분들이 그 재미있겠다라고 생각하시면서 참여해 주셨어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.391
            },
            {
                "speaker_id": "2",
                "transcription": "아 농담으로 뛰어나가는 거 아니고 아 디자인적으로",
                "sound_type": [
                    2
                ],
                "start": 5.401,
                "end": 9.027
            },
            {
                "speaker_id": "1",
                "transcription": "디자인으로 저희 뭐 참해주셨던 분들이 들으면 알만한 국내 대기업 또는 IT대 기업 뭐 카카오 뭐 이런 데서 일하시는",
                "sound_type": [
                    2
                ],
                "start": 9.037,
                "end": 18.504
            },
            {
                "speaker_id": "1",
                "transcription": "디자인 개발하시는 분들 참여해 주셨고 여성분들이 되게 좋아하세요.",
                "sound_type": [
                    2
                ],
                "start": 18.514,
                "end": 22.635
            },
            {
                "speaker_id": "1",
                "transcription": "저희 앱에",
                "sound_type": [
                    2
                ],
                "start": 22.645,
                "end": 23.381
            },
            {
                "speaker_id": "3",
                "transcription": "아 맞아요. 맞아요. 맞아요.",
                "sound_type": [
                    2
                ],
                "start": 23.391,
                "end": 24.497
            },
            {
                "speaker_id": "1",
                "transcription": "귀엽다 뭐 디자인도 예쁘다 뭐 편하다 UI베이스가 사용하기에 되게 편하게 되어있다.",
                "sound_type": [
                    2
                ],
                "start": 24.507,
                "end": 31.047
            },
            {
                "speaker_id": "2",
                "transcription": "사실 앱은 그에 다거든요 어찌 보면.",
                "sound_type": [
                    2
                ],
                "start": 31.057,
                "end": 33.531
            },
            {
                "speaker_id": "2",
                "transcription": "처음에 딱 첫 인상에 이상하면 바로 지워버리거든요.",
                "sound_type": [
                    2
                ],
                "start": 33.541,
                "end": 36.380
            },
            {
                "speaker_id": "1",
                "transcription": "저희가 처음에 저도 아까 말씀 말씀하신게 맞아요.",
                "sound_type": [
                    2
                ],
                "start": 36.390,
                "end": 41.516
            },
            {
                "speaker_id": "1",
                "transcription": "저 문과생 이어가지고 뭐 UI에 대해서 잘 모르는데 이런 아이템 한번 해 보겠다라고 생각했을 때 주변에 누구 말씀을 드렸어요.",
                "sound_type": [
                    2
                ],
                "start": 41.526,
                "end": 48.001
            },
            {
                "speaker_id": "1",
                "transcription": "주변 분들한테 근데 그분들이 또 자기 아는 지인들한테 내가 아는 애가 뭐 이런 준비하는데 이렇게 막 얘기하다가 누가 듣고 재미있겠는데?",
                "sound_type": [
                    2
                ],
                "start": 48.011,
                "end": 56.410
            },
            {
                "speaker_id": "2",
                "transcription": "아 그냥",
                "sound_type": [
                    2
                ],
                "start": 56.420,
                "end": 57.464
            },
            {
                "speaker_id": "1",
                "transcription": "예 재밌겠는 돈도 안 받으시고 재미있겠는데 나 한번 그거 같이 해볼래 돈도 안 받고 참여하시는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 57.474,
                "end": 64.329
            },
            {
                "speaker_id": "3",
                "transcription": "너무 감사하지.",
                "sound_type": [
                    2
                ],
                "start": 64.339,
                "end": 66.816
            },
            {
                "speaker_id": "1",
                "transcription": "그 대기업에 있는 앱 그 기획하시는 분이 재미있겠다고 참여하셨어요.",
                "sound_type": [
                    2
                ],
                "start": 66.826,
                "end": 71.897
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 그분은 캠핑도 안 하세요.",
                "sound_type": [
                    2
                ],
                "start": 71.907,
                "end": 74.039
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그냥 재미있어 보인다 참여해 주시고 개발자분들도 원래 캠핑하시는 분이었는데 아 나도 캠핑하 그런 것 있으면 좋겠다고 생각했다 그래서 참해 주시고",
                "sound_type": [
                    2
                ],
                "start": 74.049,
                "end": 85.545
            },
            {
                "speaker_id": "2",
                "transcription": "아 운이 좋았네요.",
                "sound_type": [
                    2
                ],
                "start": 85.555,
                "end": 86.530
            },
            {
                "speaker_id": "1",
                "transcription": "네 정말 운이 좋았고요.",
                "sound_type": [
                    2
                ],
                "start": 86.540,
                "end": 87.636
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 인연이 닿으신 분들 중에 일부는 저희 인제 이번에 좀",
                "sound_type": [
                    2
                ],
                "start": 87.646,
                "end": 92.875
            }
        ]
    },
    "summary": "화자3은 국내 대기업 개발자들이 재미있겠다고 참여해 주셔서 너무 감사하다고 운이 좋았다고 말한다.",
