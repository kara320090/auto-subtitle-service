        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 머리띠 하나 더 샀어 하얀 색깔 되게 많이 넓지 않은 머리띠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.530
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 머리띠를 제가 아예 안 하는데 단발로 하니까 할 수 있는 스타일링이 한정적이라 머리띠로 이렇게 포인트를 주는 게 예쁜 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 4.540,
                "end": 11.980
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 잘 어울리기도 하고 그리고 선글라스를 사고 싶었었거든요.",
                "sound_type": [
                    2
                ],
                "start": 11.990,
                "end": 16.471
            },
            {
                "speaker_id": "1",
                "transcription": "선글라스가 이거 저는 큰 거는 조금 안 좋아하는데 얘가 크긴 한데 그래도 크니까 얼굴도 작아 보이고 기본적인 그런 디자인이라서 이거 있으면은 잘 쓰겠다 싶어서 이런 게 없어서 샀거든요.",
                "sound_type": [
                    2
                ],
                "start": 16.481,
                "end": 29.185
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 3만 7천원인가 8천원 그 다음에 제가 이런 갈색깔 선글라스를 진짜 갖고 싶었어요.",
                "sound_type": [
                    2
                ],
                "start": 29.195,
                "end": 36.031
            },
            {
                "speaker_id": "1",
                "transcription": "지나가는데 그냥 가판에 있더라고요.",
                "sound_type": [
                    2
                ],
                "start": 36.041,
                "end": 38.986
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 딱 봐도 저렴한 건데 썼을 때는 내가 원하던 스타일 화사해 보이게 이거는 만 오천원.",
                "sound_type": [
                    2
                ],
                "start": 38.996,
                "end": 45.953
            },
            {
                "speaker_id": "1",
                "transcription": "예쁘죠 그 다음에 에어팟 케이스.",
                "sound_type": [
                    2
                ],
                "start": 45.963,
                "end": 50.480
            }
        ]
    },
    "summary": "발화자는 구매한 선그라스와 머리띠를 함께 착용하고 리뷰하는 영상이다.",
