                    2,
                    4
                ],
                "start": 12.500,
                "end": 16.349
            },
            {
                "speaker_id": "1",
                "transcription": "에 인제 툴롱 해수욕장 제일 큰 데 왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.359,
                "end": 23.518
            },
            {
                "speaker_id": "1",
                "transcription": "어 저쪽이에요 바로",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.528,
                "end": 26.325
            },
            {
                "speaker_id": "1",
                "transcription": "여기가 툴롱에서 가장 해안선이 긴 해수욕장이래요.",
