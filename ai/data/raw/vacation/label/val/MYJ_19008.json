        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 형님들은 평소에 뭐 무슨 캠핑 좋아하세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 17.703
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 식으로 캠핑하세요?",
                "sound_type": [
                    2
                ],
                "start": 17.713,
                "end": 19.199
            },
            {
                "speaker_id": "2",
                "transcription": "제가 하는 캠핑은 @이름1이랑 좀 다르게요.",
                "sound_type": [
                    2
                ],
                "start": 19.209,
                "end": 22.334
            },
            {
                "speaker_id": "2",
                "transcription": "장비도 좀 많이 깔고 가족들이랑 하는데",
                "sound_type": [
                    2
                ],
                "start": 22.344,
                "end": 24.959
            },
            {
                "speaker_id": "1",
                "transcription": "애들 있고?",
                "sound_type": [
                    2
                ],
                "start": 24.969,
                "end": 25.696
            },
            {
                "speaker_id": "2",
                "transcription": "애가 둘이나 있다 보니까 좀 안락하고 편안한 캠핑",
                "sound_type": [
                    2
                ],
                "start": 25.706,
                "end": 29.529
            },
            {
                "speaker_id": "1",
                "transcription": "음 진짜 애들 있으면 그런 거 신경 안 쓸 수가 없죠.",
                "sound_type": [
                    2
                ],
                "start": 29.539,
                "end": 32.607
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요.",
                "sound_type": [
                    2
                ],
                "start": 32.617,
                "end": 33.113
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 좋은 장비 있으면 꼭 사보고 싶어 하고 아 이거 있으면 좀 더 편할 것 같은데 하고 또 사게 되고",
                "sound_type": [
                    2
                ],
                "start": 33.123,
                "end": 39.427
            },
            {
                "speaker_id": "1",
                "transcription": "어 그럼 지금 텐트 몇 동 가지고 계세요?",
                "sound_type": [
                    2
                ],
                "start": 39.437,
                "end": 41.745
            },
            {
                "speaker_id": "2",
                "transcription": "지금 텐트 3동이에요.",
                "sound_type": [
                    2
                ],
                "start": 41.755,
                "end": 42.877
            },
            {
                "speaker_id": "1",
                "transcription": "어 뭐 뭐 뭐요?",
                "sound_type": [
                    2
                ],
                "start": 42.887,
                "end": 44.221
            },
            {
                "speaker_id": "2",
                "transcription": "저는 얘랑 하나 있고 그다음에 쪼마난 2인용인데",
                "sound_type": [
                    2
                ],
                "start": 44.231,
                "end": 48.666
            },
            {
                "speaker_id": "1",
                "transcription": "아 그냥 여름 같은 때 간편하게 있는 거",
                "sound_type": [
                    2
                ],
                "start": 48.676,
                "end": 50.550
            },
            {
                "speaker_id": "2",
                "transcription": "간편하게 쓸 수 있는 거 있고 하나는 그냥 진짜 그 캠프닉 갈 때 하는 그 텐 타워 텐 쪼그만 거 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 50.560,
                "end": 56.796
            },
            {
                "speaker_id": "2",
                "transcription": "싼 거 그것도 하나 있어요.",
                "sound_type": [
                    2
                ],
                "start": 56.806,
                "end": 58.172
            },
            {
                "speaker_id": "2",
                "transcription": "의외로 맨날 갖고 나갈 수 있는 거",
                "sound_type": [
                    2
                ],
                "start": 58.182,
                "end": 59.386
            },
            {
                "speaker_id": "1",
                "transcription": "아 간편한 거 2개랑 요렇게 완전히 하는 거 하나랑",
                "sound_type": [
                    2
                ],
                "start": 59.396,
                "end": 63.307
            },
            {
                "speaker_id": "2",
                "transcription": "요즘은 돔 쉘터가 눈에 자꾸 밟히더라고요.",
                "sound_type": [
                    2
                ],
                "start": 63.317,
                "end": 67.658
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 어떤 거요?",
                "sound_type": [
                    2
                ],
                "start": 67.668,
                "end": 68.397
            },
            {
                "speaker_id": "2",
                "transcription": "제일 갖고 싶은 텐트는 전 요새는 그냥 걈 에잇",
                "sound_type": [
                    2
                ],
                "start": 68.407,
                "end": 72.016
            },
            {
                "speaker_id": "1",
                "transcription": "아 걈8",
                "sound_type": [
                    2
                ],
                "start": 72.026,
                "end": 73.398
            },
            {
                "speaker_id": "2",
                "transcription": "네 걈8 사고 싶어요.",
                "sound_type": [
                    2
                ],
                "start": 73.408,
                "end": 74.944
