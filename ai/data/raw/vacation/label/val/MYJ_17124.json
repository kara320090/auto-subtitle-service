                ],
                "start": 1.170,
                "end": 5.013
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 맨날 있는 파운드 케익하고 네 바나나 케익은 항상 있죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.023,
                "end": 9.617
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 여기는 여기도 똑같나?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.627,
                "end": 14.561
            },
            {
                "speaker_id": "1",
                "transcription": "네 여기도 뭐 거의 비슷하죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.571,
                "end": 20.657
            },
            {
                "speaker_id": "1",
                "transcription": "아 한 발 늦었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.667,
                "end": 22.978
            },
            {
                "speaker_id": "1",
                "transcription": "지금 십항채선당에 왔는데 아 배가 출항했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.988,
                "end": 27.644
            },
            {
                "speaker_id": "1",
                "transcription": "한 출항한지 한 10분 정도 지난 거 같은데 10분 15분 네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.654,
                "end": 32.422
            },
            {
                "speaker_id": "1",
                "transcription": "아 아까 아침에 안 보였던 우리 갈매기들 얘네들은 진짜 멀리까지 따라와요 나폴리에서는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.432,
                "end": 38.970
            },
            {
                "speaker_id": "1",
                "transcription": "한 한 시간 따라오나 얘네들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.980,
                "end": 41.211
            },
            {
                "speaker_id": "1",
                "transcription": "네 근데 얘네들이 진짜 먹을 걸 잘 먹어요 던져주면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.221,
                "end": 46.275
            },
            {
                "speaker_id": "1",
                "transcription": "나폴리에 오시면은 꼭 출항할 때",
                "sound_type": [
                    2,
                    3
                ],
