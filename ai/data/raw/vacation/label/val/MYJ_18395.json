        "term": [
            {
                "speaker_id": "1",
                "transcription": "메뉴 하나 더 시켰어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.402
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 얼만지 모르겠어 아직.",
                "sound_type": [
                    2
                ],
                "start": 2.412,
                "end": 5.343
            },
            {
                "speaker_id": "1",
                "transcription": "길을 가다가 아무 마사지샵이나 들어왔는데 마사지 간판만 보고 근데 좀 무서워요.",
                "sound_type": [
                    2
                ],
                "start": 5.353,
                "end": 11.486
            },
            {
                "speaker_id": "1",
                "transcription": "말도 영어도 안 되고 무서워.",
                "sound_type": [
                    2
                ],
                "start": 11.496,
                "end": 13.972
            },
            {
                "speaker_id": "1",
                "transcription": "이런 세운 데였어.",
                "sound_type": [
                    2
                ],
                "start": 13.982,
                "end": 16.316
            },
            {
                "speaker_id": "1",
                "transcription": "딱 침대밖에 없어.",
                "sound_type": [
                    2
                ],
                "start": 16.326,
                "end": 19.482
            },
            {
                "speaker_id": "1",
                "transcription": "조식을 먹습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.492,
                "end": 23.319
            },
            {
                "speaker_id": "1",
                "transcription": "여기 숙소 근처에 빈컵 플라자가 있어서 여기를 한번 와봤는데요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.329,
                "end": 28.645
            },
            {
                "speaker_id": "1",
                "transcription": "횡단보도에 신호등이 없어요.",
                "sound_type": [
                    2
                ],
                "start": 28.655,
                "end": 30.583
            },
            {
                "speaker_id": "1",
                "transcription": "그래 갖고 여기 사이를 뚫고 가야 되는데 진짜 무서워요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 30.593,
                "end": 37.680
            }
        ]
    },
    "summary": "길을 가다가 간판만 보고 마사지샵에 들어왔는데 영어가 안 되고 침대밖에 없어서 무서웠다. 조식을 먹고 숙소 근처 빈컵 플라자에 방문했는데 신호등이 없는 횡단보도를 건너야 해서 무섭다고 한다.",
