                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 꽃 진짜 일품이지",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.739
            },
            {
                "speaker_id": "2",
                "transcription": "여기 단풍지면 진짜 멋있겠다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 1.749,
                "end": 3.880
            },
            {
                "speaker_id": "1",
                "transcription": "가을에도 멋있지",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 3.890,
                "end": 5.206
            },
            {
                "speaker_id": "1",
                "transcription": "가을 되면 이 은행나무잖아.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 5.220,
                "end": 7.486
            },
            {
                "speaker_id": "2",
                "transcription": "진짜 크다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 7.486,
                "end": 8.072
            },
            {
                "speaker_id": "1",
                "transcription": "이게 막 노랗게 물들어",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 8.082,
                "end": 10.193
            },
            {
                "speaker_id": "1",
                "transcription": "그거 달밤 이럴 때 참 좋다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 10.203,
                "end": 12.774
            },
            {
                "speaker_id": "1",
                "transcription": "아무 때나 와라",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 12.784,
                "end": 13.873
            },
            {
                "speaker_id": "2",
                "transcription": "정말요?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 13.881,
                "end": 14.940
            },
            {
                "speaker_id": "1",
                "transcription": "언제든지 환영한다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 14.940,
                "end": 16.615
            },
            {
                "speaker_id": "1",
                "transcription": "새벽예불만 참석하면 아무도 간섭 안 한다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 16.625,
                "end": 19.266
            },
            {
                "speaker_id": "2",
                "transcription": "아니 근데 그런 걸 해야 된다고 했을 때 되게 좋지 않았어 나는 되게 좋았는데",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 19.276,
                "end": 23.759
            },
            {
                "speaker_id": "1",
                "transcription": "새벽에 일어나서 기도 한 30분 하면 돼.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 23.769,
                "end": 26.287
            },
            {
                "speaker_id": "2",
                "transcription": "명상하는 것처럼 마음이 깨끗해질 거 같은데",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 26.297,
                "end": 29.646
            },
            {
                "speaker_id": "1",
                "transcription": "니네 그런 걸 좋아하냐?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 29.646,
                "end": 30.999
            },
            {
                "speaker_id": "2",
                "transcription": "저 좋아해요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 31.009,
                "end": 32.082
            },
            {
                "speaker_id": "1",
                "transcription": "아 난 니네 그런 거 싫어해서 이거 야들 오면 어쩌나 싶었는데",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 32.092,
                "end": 36.432
            },
            {
                "speaker_id": "2",
                "transcription": "저희도 이제 나이가 들어가지고 산 좋아하고 저희 등산 엄청 다녀요 요즘에 아빠랑",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 36.442,
                "end": 42.426
            },
            {
                "speaker_id": "1",
                "transcription": "야 너네 아빠가 웬일이냐",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 42.426,
                "end": 44.025
            },
            {
                "speaker_id": "2",
                "transcription": "아빠가 등산은 또 좋아하더라고 유일하게 좋아하는 게 없는데 등산은 좋아하더라고요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 44.035,
                "end": 48.455
            },
            {
                "speaker_id": "1",
                "transcription": "야 느네 참 잘 지내서 좋다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 48.465,
                "end": 50.383
            },
            {
                "speaker_id": "2",
                "transcription": "네 잘 지네요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 50.393,
                "end": 51.870
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 돼",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 51.880,
                "end": 52.839
            },
            {
                "speaker_id": "2",
                "transcription": "아무 걱정도 문제도 없어요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 52.849,
                "end": 54.931
            },
            {
                "speaker_id": "1",
                "transcription": "짐을 일단 풀까?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 54.941,
                "end": 56.247
            },
            {
                "speaker_id": "2",
                "transcription": "네",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 56.257,
                "end": 56.794
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 착해라 여기까지 오고",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 56.804,
                "end": 59.035
            },
            {
                "speaker_id": "2",
                "transcription": "안녕하세요",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 59.045,
                "end": 60.848
            },
            {
                "speaker_id": "3",
                "transcription": "어서 오세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.858,
                "end": 62.371
            },
            {
                "speaker_id": "2",
                "transcription": "우와 생각보다 방이 너무나 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.381,
                "end": 66.609
            },
            {
                "speaker_id": "2",
                "transcription": "이 창이 있어서 나는 여기서 자고 싶었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.619,
                "end": 69.490
            },
            {
                "speaker_id": "2",
                "transcription": "지치고 막 머리 아프고 힘들 때 여기 와가지고 있으면 좋을 거 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.500,
                "end": 75.405
            },
            {
                "speaker_id": "2",
                "transcription": "정말 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.415,
                "end": 76.446
            },
            {
                "speaker_id": "2",
                "transcription": "저게 지리산이래요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.456,
                "end": 77.937
            },
            {
                "speaker_id": "2",
                "transcription": "내가 생각한 거보다 방이 너무 좋고 화장실도 있고 짱 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.947,
                "end": 82.920
            }
        ]
    },
    "summary": "스님이 언제든지 오라고 새벽예불만 참석하면 아무도 간섭 안 한다고 하자 여자가 명상하는 것처럼 마음이 깨끗해질 거 같다고 좋다고 한다.",
