        "term": [
            {
                "speaker_id": "1",
                "transcription": "각종 술을 다 먹었습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 2.309
            },
            {
                "speaker_id": "1",
                "transcription": "네 저 계단있는데 있죠 위에?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.319,
                "end": 7.205
            },
            {
                "speaker_id": "1",
                "transcription": "저 안에 인사이드 선실이 있거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.215,
                "end": 9.482
            },
            {
                "speaker_id": "1",
                "transcription": "저기 묵었었어요.",
