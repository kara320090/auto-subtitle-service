        "term": [
            {
                "speaker_id": "1",
                "transcription": "실패하지 않기 위해서 유명한 집을 많이 다니긴 하는데 사실 유명하지 않아도 그냥 딱 느낌이 오잖아.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.270
            },
            {
                "speaker_id": "1",
                "transcription": "지나가면 아 이 집 맛있을 거 같다 하는데 들어가면 맛있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.270,
                "end": 9.650
            },
            {
                "speaker_id": "1",
                "transcription": "베트남 와서 음식 실패를 안 했어.",
                "sound_type": [
                    2
                ],
                "start": 9.650,
                "end": 11.160
            },
            {
                "speaker_id": "1",
                "transcription": "다 너무 맛있어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.160,
                "end": 17.650
            },
            {
                "speaker_id": "1",
                "transcription": "음 나 이거 맛있어.",
                "sound_type": [
                    2
                ],
                "start": 17.650,
                "end": 18.990
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 베트남 음식 왜 이렇게 입맛에 잘 맞냐?",
                "sound_type": [
                    2
                ],
                "start": 18.990,
                "end": 22.120
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 완전 취향 저격이야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.120,
                "end": 23.730
            },
            {
                "speaker_id": "1",
                "transcription": "미쳤어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.730,
                "end": 24.920
            },
            {
                "speaker_id": "1",
                "transcription": "이제 배를 타러 갑니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.920,
                "end": 27.800
            },
            {
                "speaker_id": "1",
                "transcription": "지금 배 탔어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 27.800,
                "end": 30.320
            },
            {
                "speaker_id": "1",
                "transcription": "배를 타고 가고 있습니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 30.320,
                "end": 32.970
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 다니는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.970,
                "end": 36.880
            }
        ]
    },
    "summary": "음식을 실패하지 않기 위해서 유명한 집을 다녔는데 느낌이 오는 곳에 들어가면 맛있고 베트남 음식이 입맛에 잘 맞았으며 배를 타러 왔다.",
