                    2,
                    3
                ],
                "start": 26.700,
                "end": 27.609
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 녹여먹는 요리에 다 녹여드시면 진짜 맛있어요.",
                "sound_type": [
                    2,
                    3
                ],
