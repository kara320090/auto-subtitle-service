        "term": [
            {
                "speaker_id": "1",
                "transcription": "클락키에 이런 놀이기구가 있어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.626
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 봐 장난 아닐 거야 맞지?",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 2.636,
                "end": 9.137
            },
            {
                "speaker_id": "2",
                "transcription": "더 가네 아래로 쑹 쑹.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.147,
                "end": 11.972
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 무서울 것 같은데 바이킹에 100배는 무섭겠다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.982,
                "end": 15.653
            },
            {
                "speaker_id": "1",
                "transcription": "허 근데 진짜 높이 올라가지 않았어?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.663,
                "end": 18.472
            },
            {
                "speaker_id": "1",
                "transcription": "야 저거 봐 나 심장 심장 떨릴 것 같아 저기 있으면.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.482,
                "end": 22.991
            },
            {
                "speaker_id": "1",
                "transcription": "와 저기 확 놓는 거야.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.001,
                "end": 25.205
            },
            {
                "speaker_id": "2",
                "transcription": "야 진짜 애기들 저거 어떻게 타냐?",
