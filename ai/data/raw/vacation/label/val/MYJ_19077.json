                "sound_type": [
                    2,
                    5
                ],
                "start": 3.096,
                "end": 4.761
            },
            {
                "speaker_id": "1",
                "transcription": "혼자서 묵묵히 또 쓰레기 청소하고 있네.",
                "sound_type": [
                    2
                ],
                "start": 4.771,
                "end": 7.736
            },
            {
                "speaker_id": "1",
                "transcription": "어디서 왔는데?",
