                    2
                ],
                "start": 7.746,
                "end": 9.757
            },
            {
                "speaker_id": "3",
                "transcription": "저 기장에서 왔습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.767,
                "end": 11.164
            },
            {
                "speaker_id": "3",
                "transcription": "늘 뵙고 싶었는데 이런 좋은데 참가하게 돼 가지고",
                "sound_type": [
                    1,
                    2
                ],
                "start": 11.174,
                "end": 14.363
            },
            {
                "speaker_id": "4",
                "transcription": "부산 집은 저기 수영 쪽에 바다를 좋아하는데 우연찮게 또 형님 채널 보게 되니까",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.373,
                "end": 19.347
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.357,
                "end": 19.736
            },
            {
                "speaker_id": "4",
                "transcription": "바다에 중독이 되고 또 이렇게 뜻 깊은 동생과 함께 바다를 깨끗이",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.746,
                "end": 24.149
            },
            {
                "speaker_id": "5",
                "transcription": "안녕하십니까 부산에서 올라온 부산 사나이 @이름1입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 24.159,
                "end": 27.581
            },
            {
                "speaker_id": "5",
                "transcription": "오늘 쓰레기 많이 줍고 가겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 27.591,
                "end": 29.026
            },
            {
                "speaker_id": "5",
                "transcription": "오늘 쓰레기 제일 많이 주으려고 왔는데 생각보다 쓰레기 없어서 좀 마음이 안타깝긴한데",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 29.036,
                "end": 35.370
            },
            {
                "speaker_id": "1",
                "transcription": "저 갯바위 가면 돌틈 사이에 쓰레기 꽉꽉 끼 있다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 35.380,
                "end": 38.838
            },
            {
                "speaker_id": "1",
                "transcription": "빨리 뛰 가라.",
