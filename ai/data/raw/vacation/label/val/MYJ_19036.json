        "term": [
            {
                "speaker_id": "1",
                "transcription": "이벤트가 뭐냐면 바로 이거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.833
            },
            {
                "speaker_id": "1",
                "transcription": "오일 램프예요 오일 램프.",
                "sound_type": [
                    2
                ],
                "start": 1.843,
                "end": 3.327
            },
            {
                "speaker_id": "1",
                "transcription": "근데 진짜 쪼그맣고 갬성있죠?",
                "sound_type": [
                    2
                ],
                "start": 3.337,
                "end": 5.313
            },
            {
                "speaker_id": "1",
                "transcription": "재질도 오일은 파라핀을 씁니다.",
                "sound_type": [
                    2
                ],
                "start": 5.323,
                "end": 8.981
            },
            {
                "speaker_id": "1",
                "transcription": "오 됐다 됐다.",
                "sound_type": [
                    2
                ],
                "start": 8.991,
                "end": 9.949
            },
            {
                "speaker_id": "1",
                "transcription": "요 상태에서 위 뚜껑을 열면 심지가 나와요.",
                "sound_type": [
                    2
                ],
                "start": 9.959,
                "end": 13.128
            },
            {
                "speaker_id": "1",
                "transcription": "일단 심지 좀 젖을 때까지 기다릴게요.",
                "sound_type": [
                    2
                ],
                "start": 13.138,
                "end": 15.677
            },
            {
                "speaker_id": "1",
                "transcription": "오 젖었다.",
                "sound_type": [
                    2
                ],
                "start": 15.687,
                "end": 16.483
            },
            {
                "speaker_id": "1",
                "transcription": "요 상태에서 크 역시 LED 랜턴이랑은 차원이 달라요 감성이.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.493,
                "end": 24.307
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 요 일 램프를 요번 영상에 댓글 올려주신 분 중의 2분을 추첨해서 드리겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.317,
                "end": 30.342
            },
            {
                "speaker_id": "1",
                "transcription": "근데 댓글을 뭐 굳이 막 좋게 그렇게 쓰실 필요 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.352,
                "end": 33.402
            },
            {
                "speaker_id": "1",
                "transcription": "그냥",
                "sound_type": [
                    2
                ],
                "start": 33.412,
                "end": 33.966
            }
        ]
    },
