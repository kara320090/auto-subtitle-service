        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 형님은 야영이라는 그 검색 앱 하시기 전에 무슨 일을 하셨던 거예요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.267
            },
            {
                "speaker_id": "2",
                "transcription": "캠핑이랑 전혀 상관없는 일 했고요.",
                "sound_type": [
                    2
                ],
                "start": 4.277,
                "end": 6.392
            },
            {
                "speaker_id": "1",
                "transcription": "뭔데요.",
                "sound_type": [
                    2
                ],
                "start": 6.402,
                "end": 7.323
            },
            {
                "speaker_id": "2",
                "transcription": "어 일반인들은 잘 모르실 수 있는데 전략 컨설턴트라는 직업을 갖고 있었어요.",
                "sound_type": [
                    2
                ],
                "start": 7.333,
                "end": 13.617
            },
            {
                "speaker_id": "1",
                "transcription": "전략 컨설턴트요?",
                "sound_type": [
                    2
                ],
                "start": 13.627,
                "end": 14.868
            },
            {
                "speaker_id": "2",
                "transcription": "아실 만한 대기업이 중견기업들이랑 같이 일을 하는 건데요.",
                "sound_type": [
                    2
                ],
                "start": 14.878,
                "end": 18.537
            },
            {
                "speaker_id": "2",
                "transcription": "그런 대기업에서 중견기업들이 뭔가 새로운 사업을 한다거나 아니면 어디 다른 해외 시장을 진출을 한다거나 아니면 5개년 사업 계획을 뭐 세우겠다.",
                "sound_type": [
                    2
                ],
                "start": 18.547,
                "end": 26.971
            },
            {
                "speaker_id": "1",
                "transcription": "아 큰 사업 좀 인제 준비할 때",
                "sound_type": [
                    2
                ],
                "start": 26.981,
                "end": 29.508
            },
            {
                "speaker_id": "2",
                "transcription": "그럴 때 저희들을 불러서 그런 걸 좀 부탁을 하죠.",
                "sound_type": [
                    2
                ],
                "start": 29.518,
                "end": 32.476
            },
            {
                "speaker_id": "2",
                "transcription": "우리가 이번에 예를 들어 원래 드라마나 영화 만들던 회사인데 웹툰 시장에 한번 들어가고 싶어.",
                "sound_type": [
                    2
                ],
                "start": 32.486,
                "end": 39.000
            }
        ]
