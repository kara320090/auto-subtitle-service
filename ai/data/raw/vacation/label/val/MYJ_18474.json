        "term": [
            {
                "speaker_id": "1",
                "transcription": "그게 너무 맛있었어가지고 거길 또 찾아가볼려고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.399
            },
            {
                "speaker_id": "1",
                "transcription": "찾았어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.409,
                "end": 11.884
            },
            {
                "speaker_id": "1",
                "transcription": "여기가 부기스 스트리트로 걷다 보면은 있는 데거든요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.894,
                "end": 16.141
            },
            {
                "speaker_id": "1",
                "transcription": "관광객은 잘 없는 것 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.151,
                "end": 18.376
            },
            {
                "speaker_id": "1",
                "transcription": "그때 먹은 거를 시킬게요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.386,
                "end": 20.614
            },
            {
                "speaker_id": "1",
                "transcription": "핫 싸워 글래스 누들",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.624,
                "end": 22.594
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 시켰어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.604,
                "end": 24.248
            },
            {
                "speaker_id": "1",
                "transcription": "음료수는 다른 집에서 따로 사야 되더라고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.258,
                "end": 27.777
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 좀 마셔볼까.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.787,
                "end": 29.319
            },
            {
                "speaker_id": "1",
                "transcription": "커피 빈티지 이 라임 주스도 시켰어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 29.329,
                "end": 34.270
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 원래는 1.6달러인데 여기서 먹고 갈거라 했는데 머그컵에 줄 것 같아서 여기다 테이크아웃 잔에다 담아달라했더니 10센트를 더 받는데요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 34.280,
                "end": 43.325
            },
            {
                "speaker_id": "1",
                "transcription": "제가 시킨 음식은 요런건데 그때도 먹어봤지만 진짜 특이한 맛이에요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 43.335,
                "end": 48.988
            },
            {
                "speaker_id": "1",
                "transcription": "우동같이 생긴 당면은 처음 봤거든요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 48.998,
                "end": 51.613
            },
            {
                "speaker_id": "1",
                "transcription": "근데 너무 맛있는 거예요 처음 먹어본 맛인데",
                "sound_type": [
                    2,
                    4
                ],
                "start": 51.623,
                "end": 53.915
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 생각이 나가지고 계속 먹고싶었어서 또 먹으러 왔어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 53.925,
                "end": 59.504
            },
            {
                "speaker_id": "1",
                "transcription": "미끌미끌하고 맛있어.",
