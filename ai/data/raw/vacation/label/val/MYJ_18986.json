                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그렇죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.543
            },
            {
                "speaker_id": "1",
                "transcription": "여유 있는 텐트 가져오면 갈 때는 아 칠 때 맨날 후회하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.553,
                "end": 5.109
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요.",
                "sound_type": [
                    2
                ],
                "start": 5.119,
                "end": 5.882
            },
            {
                "speaker_id": "2",
                "transcription": "어차피 걷을 건데 이 고생을 하나 이러면서",
                "sound_type": [
                    2
                ],
                "start": 5.892,
                "end": 8.523
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 잠만 잘 거 그냥 펼쳐 놓고 자다가 그냥 갈걸.",
                "sound_type": [
                    2
                ],
                "start": 8.533,
                "end": 12.089
            },
            {
                "speaker_id": "1",
                "transcription": "와 그런데 진짜 여기 뭐예요?",
                "sound_type": [
                    2
                ],
                "start": 12.099,
                "end": 13.891
            },
            {
                "speaker_id": "1",
                "transcription": "여기 너무 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 13.901,
                "end": 15.535
            },
            {
                "speaker_id": "2",
                "transcription": "아 여기요?",
                "sound_type": [
                    2
                ],
                "start": 15.545,
                "end": 16.221
            },
            {
                "speaker_id": "2",
                "transcription": "여기 저희가 장기 임대한 캠핑장이예요.",
                "sound_type": [
                    2
                ],
                "start": 16.231,
                "end": 19.211
            },
            {
                "speaker_id": "2",
                "transcription": "한 2년 정도 휴업 중인데 저희가 직접 투자해서 좀 리뉴얼을 해서 직접 운영해 보려고",
                "sound_type": [
                    2
                ],
                "start": 19.221,
                "end": 25.220
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜요?",
                "sound_type": [
                    2
                ],
                "start": 25.230,
                "end": 27.095
            },
            {
                "speaker_id": "1",
                "transcription": "아니 여기를 지금 장기 임대해 두신 상태인 거예요?",
                "sound_type": [
                    2
                ],
                "start": 27.105,
                "end": 30.133
            },
            {
                "speaker_id": "2",
                "transcription": "네 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.143,
                "end": 30.495
            },
            {
                "speaker_id": "2",
                "transcription": "10년 임대했고요.",
                "sound_type": [
                    2
                ],
                "start": 30.505,
                "end": 31.960
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 직접 투자하고 해서 인제 아마 바뀔 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 31.970,
                "end": 35.338
            },
            {
                "speaker_id": "1",
                "transcription": "와 그거 진짜 나만의 캠핑장 내가 직접 하나 갖고 싶다.",
                "sound_type": [
                    2
                ],
                "start": 35.348,
                "end": 40.006
            },
            {
                "speaker_id": "2",
                "transcription": "아 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 40.016,
                "end": 40.445
            },
            {
                "speaker_id": "1",
                "transcription": "완전 꿈이잖아요.",
                "sound_type": [
                    2
                ],
                "start": 40.455,
                "end": 41.163
            },
            {
                "speaker_id": "1",
                "transcription": "물론 뭐 개인 취미로 하시는 건 아닐 테지만",
                "sound_type": [
                    2
                ],
                "start": 41.173,
                "end": 43.990
            },
            {
                "speaker_id": "2",
                "transcription": "아 근데 이 지금 프로젝트 일반 캠퍼분들도 참여하실 수가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 44.000,
                "end": 48.317
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 저희가 투자하는 전체 금액 중 일부를 일반 캠퍼분들한테 클라우디 펀딩으로 금액을 모집하고 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 48.327,
                "end": 55.576
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜요?",
                "sound_type": [
                    2
                ],
                "start": 55.586,
                "end": 56.603
            },
            {
                "speaker_id": "2",
                "transcription": "네 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 56.613,
                "end": 57.077
            },
            {
                "speaker_id": "1",
                "transcription": "와 대박이네요.",
                "sound_type": [
                    2
                ],
                "start": 57.087,
                "end": 58.128
            },
            {
                "speaker_id": "2",
                "transcription": "예 그래서 저희가 클라우디라는 그 플랫폼이랑 함께",
                "sound_type": [
                    2
                ],
                "start": 58.138,
                "end": 61.435
            },
            {
                "speaker_id": "1",
                "transcription": "와디즈 비슷한 거예요?",
                "sound_type": [
                    2
                ],
                "start": 61.445,
                "end": 62.734
            },
            {
                "speaker_id": "2",
                "transcription": "아 예 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 62.744,
                "end": 63.246
            },
            {
                "speaker_id": "2",
                "transcription": "와디즈랑 비슷한 클라우드 펀딩 플랫폼이구요.",
                "sound_type": [
                    2
                ],
                "start": 63.256,
                "end": 65.344
            },
            {
                "speaker_id": "2",
                "transcription": "거기서 이 캠핑장을 리뉴얼하는 프로젝트에 지금 캠퍼분들을 초대하고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 65.354,
                "end": 70.012
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이거 뭐 캠핑 용품 펀딩은 들어봤어도 캠핑장 펀딩 진짜 처음 들어보는데요?",
                "sound_type": [
                    2
                ],
                "start": 70.022,
                "end": 74.807
            },
            {
                "speaker_id": "2",
                "transcription": "만약에 캠퍼분들 참여하시면 당연히 인제 캠핑장 운영에서 나는 수익을 돌려 드리지만 그 외에 앰버서더처럼 대우 해드릴려고 하고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 74.817,
                "end": 83.480
            },
            {
                "speaker_id": "1",
                "transcription": "아 뭐 아 약간 리조트 회원권 비슷한 그런 느낌인가?",
                "sound_type": [
                    2
                ],
                "start": 83.490,
                "end": 89.365
            },
            {
                "speaker_id": "2",
                "transcription": "우선 예약을 받아 드리고 머 투자금에 따라 좀 다르지만 무료 장박 겨울에 장박도 3개월씩 무료로 시켜드리고",
                "sound_type": [
                    2
                ],
                "start": 89.375,
                "end": 96.730
            },
            {
                "speaker_id": "1",
                "transcription": "오 대박인데요.",
                "sound_type": [
                    2
                ],
                "start": 96.740,
                "end": 97.935
            },
            {
                "speaker_id": "2",
                "transcription": "통 대여도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 97.945,
                "end": 98.607
            },
            {
                "speaker_id": "2",
                "transcription": "캠핑장 하루 통 대여 여기 전체 통 대여하는",
                "sound_type": [
                    2
                ],
                "start": 98.617,
                "end": 100.536
            },
            {
                "speaker_id": "1",
                "transcription": "아 뭐 여러 가지 옵션에 따라서 아 통 대여 이벤 통대여 뭐 쿠폰 같은 그런 거 그런 개념?",
                "sound_type": [
                    2
                ],
                "start": 100.546,
                "end": 106.754
            },
            {
                "speaker_id": "2",
                "transcription": "예 그래서 참여하시는 분들한테 참여하길 잘 했다 캠퍼로서 좀 재밌다라고 느낄 만한 포인트들을 좀 많이 만들었어요.",
                "sound_type": [
                    2
                ],
                "start": 106.764,
                "end": 113.196
            },
            {
                "speaker_id": "1",
                "transcription": "아 대박",
                "sound_type": [
                    2
                ],
