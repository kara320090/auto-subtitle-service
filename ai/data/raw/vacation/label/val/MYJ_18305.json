        "term": [
            {
                "speaker_id": "1",
                "transcription": "짐을 미리 싸 놓을까 싶어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.110
            },
            {
                "speaker_id": "1",
                "transcription": "내일 딱 그냥 일어나서 퇴소 절차 하고 갈 수 있게 갈거면 빨리 가는 게 좋으니까.",
                "sound_type": [
                    2
                ],
                "start": 3.120,
                "end": 8.781
            },
            {
                "speaker_id": "1",
                "transcription": "어 벌써 심란하네.",
                "sound_type": [
                    2
                ],
                "start": 8.791,
                "end": 20.792
            },
            {
                "speaker_id": "1",
                "transcription": "차 짐 갖다 넣으려 왔는데 차키를 안 가지고 왔어.",
                "sound_type": [
                    2
                ],
                "start": 20.802,
                "end": 28.961
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 저녁은 이거 소스 다 먹고 버리고 가려고 파스타.",
                "sound_type": [
                    2
                ],
                "start": 28.971,
                "end": 34.524
            },
            {
                "speaker_id": "1",
                "transcription": "재료가 아무것도 없어.",
                "sound_type": [
                    2
                ],
                "start": 34.534,
                "end": 36.353
            },
            {
                "speaker_id": "1",
                "transcription": "원래 양송이 꼭 넣고 하는데 양송이랑 양파 오늘은 소스랑 면만.",
                "sound_type": [
                    2
                ],
                "start": 36.363,
                "end": 41.875
            },
            {
                "speaker_id": "1",
                "transcription": "양 짱 많아.",
                "sound_type": [
                    2
                ],
                "start": 41.885,
                "end": 42.653
            },
            {
                "speaker_id": "1",
                "transcription": "이거 튀길 것 같은데.",
                "sound_type": [
                    2
                ],
                "start": 42.663,
                "end": 45.360
            }
        ]
    },
    "summary": "발화자는 이삿짐을 모두 쌌고 마지막 저녁으로 파스타를 해서 먹고 있다.",
