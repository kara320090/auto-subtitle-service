                    2,
                    3
                ],
                "start": 34.744,
                "end": 42.070
            },
            {
                "speaker_id": "2",
                "transcription": "솔직히 걔만 그런 거겠지 싶었거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.080,
                "end": 58.920
            },
            {
                "speaker_id": "2",
                "transcription": "다른 것도 다 똑같아 그냥 핵노맛 리셉션 직원분이 삼만동을 주고 사고 있더라고요.",
