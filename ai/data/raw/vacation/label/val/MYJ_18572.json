        "term": [
            {
                "speaker_id": "1",
                "transcription": "다음으로 소개할 곳은 속초 등대 전망대입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.664
            },
            {
                "speaker_id": "1",
                "transcription": "이름 그대로 속초 등대에 자리하는 전망대입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.674,
                "end": 5.414
            },
            {
                "speaker_id": "1",
                "transcription": "다리 운동이 조금은 필요하겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.424,
                "end": 7.795
            },
            {
                "speaker_id": "1",
                "transcription": "아바이 마을의 북쪽 끝자락인 금강 대교에서 도보로 20분 남짓 걸립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.805,
                "end": 13.720
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그건 입구까지가 그렇다는 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.730,
                "end": 16.743
            },
            {
                "speaker_id": "1",
                "transcription": "본 게임은 이렇게 등대로 향하는 계단을 본격적으로 마주하고 선 순간부터 시작됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.753,
                "end": 23.156
            },
            {
                "speaker_id": "1",
                "transcription": "꽤나 가파른 계단이 5분 정도 이어집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.166,
                "end": 27.109
            },
            {
                "speaker_id": "1",
                "transcription": "걷는 게 죽어도 싫은 분들이나 무릎이 좋지 못한 분들은 아마도 못 본체하고 지나치는 게 좋을지도 모릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.119,
                "end": 34.017
            },
            {
                "speaker_id": "1",
                "transcription": "물론 저는 걷는 걸 좋아하기 때문에 가뿐하게 주파하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.027,
                "end": 40.040
            }
        ]
    },
