                "start": 0.000,
                "end": 17.232
            },
            {
                "speaker_id": "1",
                "transcription": "제주도 회국수는 대부분 만원부터 시작하고요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 17.242,
                "end": 20.280
            },
            {
                "speaker_id": "1",
                "transcription": "제가 개인적으로 회랑 국수를 너무 좋아 하는데 그 회국수라는 조합이 상당히 저한테 메리트가 있죠.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 20.290,
                "end": 26.311
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 잘 비벼서",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 26.321,
                "end": 28.713
            },
            {
                "speaker_id": "1",
                "transcription": "저 먹으면 되는데 제가 반찬 소개를 안 했네요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 28.723,
                "end": 31.634
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 콩나물 무침 미역국 깍두기 있는데 뭐 그렇게 먹을만한 건 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 31.644,
                "end": 37.284
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 메인 회국수에 집중하면 됩니다 자.",
