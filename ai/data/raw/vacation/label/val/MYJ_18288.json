        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 조금 밖에 안 남았다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.104
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 사촌 언니랑 놀기로 했거든요?",
                "sound_type": [
                    2
                ],
                "start": 1.114,
                "end": 3.253
            },
            {
                "speaker_id": "1",
                "transcription": "이제 나가기 전에 시간이 좀 있어가지고 제가 금, 토, 일 3일 동안 서울 가서 놀았잖아요?",
                "sound_type": [
                    2
                ],
                "start": 3.263,
                "end": 8.379
            },
            {
                "speaker_id": "1",
                "transcription": "이것저것 좀 샀거든요?",
                "sound_type": [
                    2
                ],
                "start": 8.389,
                "end": 9.721
            },
            {
                "speaker_id": "1",
                "transcription": "서울 왜케 이쁜 게 많은 거야.",
                "sound_type": [
                    2
                ],
                "start": 9.731,
                "end": 11.949
            },
            {
                "speaker_id": "1",
                "transcription": "제가 막 나가면은 옷은 안 사는데 귀여운 거는 정신을 못 차리거든요?",
                "sound_type": [
                    2
                ],
                "start": 11.959,
                "end": 16.481
            },
            {
                "speaker_id": "1",
                "transcription": "귀여운 게 너무 많은 거야.",
                "sound_type": [
                    2
                ],
                "start": 16.491,
                "end": 17.700
            },
            {
                "speaker_id": "1",
                "transcription": "빨리 보여드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 17.710,
                "end": 18.538
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 요거 트위드 머리띠 이거 진짜 예쁘지 않아요?",
                "sound_type": [
                    2
                ],
                "start": 18.548,
                "end": 22.122
            },
            {
                "speaker_id": "1",
                "transcription": "봤는데 너무 이쁜 거예요. 색깔도 보라색.",
                "sound_type": [
                    2
                ],
                "start": 22.132,
                "end": 24.553
            },
            {
                "speaker_id": "1",
                "transcription": "2만 원 정도만 하려 했거든?",
                "sound_type": [
                    2
                ],
                "start": 24.563,
                "end": 26.041
            },
            {
                "speaker_id": "1",
                "transcription": "근데 8000원이라는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 26.051,
                "end": 27.487
            },
            {
                "speaker_id": "1",
                "transcription": "바로 샀죠.",
