    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 좋아하는 네 요거트 요거는 좀 이따 먹을 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.433
            },
            {
                "speaker_id": "1",
                "transcription": "어 아이고 되게 예쁘게 해놨죠?",
                "sound_type": [
                    2
                ],
                "start": 5.443,
                "end": 11.729
            },
            {
                "speaker_id": "1",
                "transcription": "어우 이건 뭘로 만들었을까요?",
                "sound_type": [
                    2
                ],
                "start": 11.739,
                "end": 20.003
            },
            {
                "speaker_id": "1",
                "transcription": "네 수박도 이렇게 이쁘게 만들어놨고요.",
                "sound_type": [
                    2
                ],
                "start": 20.013,
                "end": 27.305
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 브릭 샐러드 자리.",
                "sound_type": [
                    2
                ],
                "start": 27.315,
                "end": 29.036
            },
            {
                "speaker_id": "1",
                "transcription": "빵은 항상 빠지지 않죠.",
                "sound_type": [
                    2
                ],
                "start": 29.046,
                "end": 32.200
            },
            {
                "speaker_id": "1",
                "transcription": "저쪽에 사람이 없는 거 같으니까 저쪽으로 가볼게요.",
                "sound_type": [
                    2
                ],
                "start": 32.210,
                "end": 38.591
            },
            {
                "speaker_id": "1",
                "transcription": "캐럿 비스켓, 빅 비프 스낵, 칙이었고요.",
                "sound_type": [
                    2
                ],
                "start": 38.601,
                "end": 46.930
            },
            {
                "speaker_id": "1",
                "transcription": "쏘 로스티드 치킨 치킨이네요.",
                "sound_type": [
                    2
                ],
                "start": 46.938,
                "end": 50.240
            },
            {
                "speaker_id": "1",
                "transcription": "어 비프 블라시 이런 거 그다음에 파이닝도 있네요.",
                "sound_type": [
                    2
                ],
                "start": 50.240,
                "end": 60.160
            },
            {
                "speaker_id": "1",
                "transcription": "파이닝도 있고 그다음에 크리 치킨, 무사카 이런 음식들이 있고요.",
                "sound_type": [
                    2
                ],
                "start": 60.160,
                "end": 69.092
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 샐러드 자립니다.",
                "sound_type": [
                    2
                ],
                "start": 69.102,
                "end": 71.617
            },
            {
                "speaker_id": "1",
                "transcription": "여기도 샐러드와 인제 치즈 그다음에 샌드위치 뭐 항상 있는 요 인도 요리들.",
                "sound_type": [
                    2
                ],
                "start": 71.627,
                "end": 88.200
            },
            {
                "speaker_id": "1",
                "transcription": "마카니 아 맛있겠다.",
                "sound_type": [
                    2
                ],
                "start": 88.210,
                "end": 95.761
            },
            {
                "speaker_id": "1",
                "transcription": "그다음 여기는 아까 봤던 버거하고 네 위드카 크림 소스네요.",
                "sound_type": [
                    2
                ],
                "start": 95.771,
                "end": 107.785
            },
            {
                "speaker_id": "1",
                "transcription": "파스타는 알리오 올리오는 항상 있고요.",
                "sound_type": [
                    2
                ],
                "start": 107.795,
                "end": 111.035
            },
            {
                "speaker_id": "1",
                "transcription": "피자도 까르보나라 피자",
                "sound_type": [
                    2
                ],
                "start": 111.045,
                "end": 115.073
            }
        ]
    },
