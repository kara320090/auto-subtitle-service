                    2
                ],
                "start": 3.057,
                "end": 8.002
            },
            {
                "speaker_id": "1",
                "transcription": "아니 멀쩡해요 근데 멀쩡한데 괜찮아요.",
                "sound_type": [
                    2
                ],
                "start": 8.002,
                "end": 14.065
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 캠핑 다니면서 에피소드는 또 뭐 없어요?",
                "sound_type": [
                    2
                ],
                "start": 14.065,
                "end": 18.070
            },
            {
