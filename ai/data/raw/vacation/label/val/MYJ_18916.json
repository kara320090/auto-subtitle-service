                    2
                ],
                "start": 19.475,
                "end": 21.455
            },
            {
                "speaker_id": "2",
                "transcription": "아직 4개월 밖에 안되긴 했지만 이게 캠핑을 좀 처음시작하니까 이게 너무 좋으니까 이제 주변 지인들도 초대하고 싶고 약간 주변 사람들을 끌어들이고 싶고 약간 그런 게 좀 생기잖아요.",
                "sound_type": [
                    2
                ],
                "start": 21.455,
                "end": 32.627
            },
            {
                "speaker_id": "2",
                "transcription": "그래가지고 이제 친한 사람들 3명을 이제 초대를 했어요.",
                "sound_type": [
                    2
                ],
                "start": 32.627,
                "end": 37.055
            },
            {
                "speaker_id": "2",
                "transcription": "거기서 이제 저 말고는 캠핑을 하는 사람이 아무도 없는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 37.055,
                "end": 40.460
            },
            {
                "speaker_id": "1",
                "transcription": "다 캠핑 한번 하나도 모르는 사람?",
