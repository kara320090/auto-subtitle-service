        "term": [
            {
                "speaker_id": "1",
                "transcription": "촬영 3개 할 생각하니까 막막하네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.228
            },
            {
                "speaker_id": "1",
                "transcription": "세팅을 해 놨습니다 예쁘죠?",
                "sound_type": [
                    2
                ],
                "start": 2.238,
                "end": 5.016
            },
            {
                "speaker_id": "1",
                "transcription": "촬영 2개 끝났습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.026,
                "end": 7.628
            },
            {
                "speaker_id": "1",
                "transcription": "네 여러분 이제 촬영 다 했습니다 3개 오늘 오전 10시 11시부터 시작했는데 6시가 넘었습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.638,
                "end": 16.007
            },
            {
                "speaker_id": "1",
                "transcription": "촬영은 3개 했고 이렇게 하면은 제가 여기 와서 찍으려고 했던 다 찍은 거에요.",
                "sound_type": [
                    2
                ],
                "start": 16.017,
                "end": 21.263
            },
            {
                "speaker_id": "1",
                "transcription": "기분 좋네.",
                "sound_type": [
                    2
                ],
                "start": 21.273,
                "end": 21.873
            },
            {
                "speaker_id": "1",
                "transcription": "이제 진짜 마무리가 되어가는 느낌이네요.",
                "sound_type": [
                    2
                ],
                "start": 21.883,
                "end": 24.776
            },
            {
                "speaker_id": "1",
                "transcription": "이제 슬슬 갈 준비를 해야 되기 때문에 아니 나 진짜 저 여기 맨 처음 온 날 기억나시죠.",
                "sound_type": [
                    2
                ],
                "start": 24.786,
                "end": 30.522
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 더 늘어났어.",
                "sound_type": [
                    2
                ],
                "start": 30.532,
                "end": 32.718
            },
            {
                "speaker_id": "1",
                "transcription": "이거 먹을까 이게 그렇게 맛있다던데.",
                "sound_type": [
                    2
                ],
                "start": 32.728,
                "end": 39.440
            }
        ]
    },
    "summary": "발화자는 촬영을 모두 마치고 기분이 좋다고 이야기하는 영상이다.",
