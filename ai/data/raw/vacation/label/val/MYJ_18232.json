        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "불바다야 불바다",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.400
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 지금 대운까지 불이네.",
                "sound_type": [
                    2
                ],
                "start": 1.400,
                "end": 3.910
            },
            {
                "speaker_id": "1",
                "transcription": "지금 결혼 운이 들어왔네.",
                "sound_type": [
                    2
                ],
                "start": 3.920,
                "end": 5.871
            },
            {
                "speaker_id": "2",
                "transcription": "엥?",
                "sound_type": [
                    2
                ],
                "start": 5.881,
                "end": 6.584
            },
            {
                "speaker_id": "1",
                "transcription": "올해, 내년에 결혼 운 들어왔네.",
                "sound_type": [
                    2
                ],
                "start": 6.594,
                "end": 8.585
            },
            {
                "speaker_id": "2",
                "transcription": "지나면 못하겠네.",
                "sound_type": [
                    2
                ],
                "start": 8.595,
                "end": 9.821
            },
            {
                "speaker_id": "1",
                "transcription": "아니여 지나면 또 할 수 있어.",
                "sound_type": [
                    2
                ],
                "start": 9.831,
                "end": 11.615
            },
            {
                "speaker_id": "1",
                "transcription": "야 너 요새 돈 벌었냐?",
                "sound_type": [
                    2
                ],
                "start": 11.625,
                "end": 13.626
            },
            {
                "speaker_id": "2",
                "transcription": "아니요 전혀",
                "sound_type": [
                    2
                ],
                "start": 13.636,
                "end": 14.662
            },
            {
                "speaker_id": "1",
                "transcription": "목돈 들어오는 운이 너한테 있는데",
                "sound_type": [
                    2
                ],
                "start": 14.672,
                "end": 16.825
            },
            {
                "speaker_id": "1",
                "transcription": "재물운이 억시로 좋을 땐데 운은",
                "sound_type": [
                    2
                ],
                "start": 16.835,
                "end": 20.836
            },
            {
                "speaker_id": "2",
                "transcription": "제가 일 열심히 안 하고 맨날 놀러 다녀요.",
                "sound_type": [
                    2
                ],
                "start": 20.846,
                "end": 23.097
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 그렇지",
                "sound_type": [
                    2
                ],
                "start": 23.107,
                "end": 24.294
            },
            {
                "speaker_id": "1",
                "transcription": "너 이제 고생 끝났다 @이름1아",
                "sound_type": [
                    2
                ],
                "start": 24.304,
                "end": 26.300
            },
            {
                "speaker_id": "2",
                "transcription": "고생을 한 적이 없는데",
                "sound_type": [
                    2
                ],
                "start": 26.312,
                "end": 28.573
            },
            {
                "speaker_id": "2",
                "transcription": "고생을 한 적이 없는데 더 좋네 오호호",
                "sound_type": [
                    2
                ],
                "start": 28.580,
                "end": 33.461
            },
            {
                "speaker_id": "2",
                "transcription": "고생을",
                "sound_type": [
                    2
                ],
                "start": 33.471,
                "end": 33.976
            },
            {
                "speaker_id": "1",
                "transcription": "한 적이 없어도 끝났어",
                "sound_type": [
                    2
                ],
                "start": 33.986,
                "end": 35.388
            },
            {
                "speaker_id": "2",
                "transcription": "어",
                "sound_type": [
                    2
                ],
                "start": 35.398,
                "end": 35.783
            },
            {
                "speaker_id": "1",
                "transcription": "야 네가 마음을 고생한 적이 없다고 생각할 정도면 참 괜찮다 야",
                "sound_type": [
                    2
                ],
                "start": 35.793,
                "end": 41.405
            },
            {
                "speaker_id": "1",
                "transcription": "너는 24살에서부터 33까지가 고비여 네 인생에 고비",
                "sound_type": [
                    2
                ],
                "start": 41.415,
                "end": 45.756
            },
            {
                "speaker_id": "1",
                "transcription": "그때 이후로는 힘들 게 없어 힘든 거 다 지나갔어.",
                "sound_type": [
                    2
                ],
                "start": 45.766,
                "end": 49.556
            },
            {
                "speaker_id": "1",
                "transcription": "힘든 대운이 너한테 들어있는데 네가 힘들다고 못 느꼈으면 앞으로는 넌 참 편하다는 얘기야",
                "sound_type": [
                    2
                ],
                "start": 49.566,
                "end": 54.791
            },
            {
                "speaker_id": "1",
                "transcription": "대운이 돈이 따박따박 들어오는 운이었어",
                "sound_type": [
                    2
                ],
                "start": 54.801,
                "end": 57.820
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 월급쟁이처럼 고정 수입이 정기적으로 이렇게 따박따박 편하게",
                "sound_type": [
                    2
                ],
                "start": 57.830,
                "end": 62.320
            },
            {
                "speaker_id": "1",
                "transcription": "돈흐름은 그런데 나머지가 좀 힘든 일이 좀 있었는데 이거 상으로 보면",
                "sound_type": [
                    2
                ],
                "start": 62.330,
                "end": 66.897
            },
            {
                "speaker_id": "1",
                "transcription": "근데 네가 본인이 힘든 일이 없었다고 하니 참 장하다.",
                "sound_type": [
                    2
                ],
                "start": 66.907,
                "end": 70.330
            },
            {
                "speaker_id": "1",
                "transcription": "고생 끝났어 @이름1이는",
                "sound_type": [
                    2
                ],
                "start": 70.340,
                "end": 71.901
            },
            {
                "speaker_id": "1",
                "transcription": "그런 운이었는데 34살부터는 목돈이 막 들어오는 운이야",
                "sound_type": [
                    2
                ],
                "start": 71.911,
                "end": 76.874
            },
            {
                "speaker_id": "1",
                "transcription": "43살까지는 목돈이 팍 들어올 수 있는 그런 운을 갖고 있어.",
                "sound_type": [
                    2
                ],
                "start": 76.884,
                "end": 82.600
            }
        ]
    },
    "summary": "스님이 재림이한테 지금 대운이 들어와서 목돈 들어오는 운이라고 한다.",
