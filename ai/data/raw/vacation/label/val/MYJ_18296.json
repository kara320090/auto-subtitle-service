        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 쥬쥬로 변신하는 거야.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.674
            },
            {
                "speaker_id": "2",
                "transcription": "이걸 끼면 쥬쥬가 되는겨?",
