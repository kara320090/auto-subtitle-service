                ],
                "start": 14.795,
                "end": 18.321
            },
            {
                "speaker_id": "1",
                "transcription": "자 텐트를 이렇게 펼치면 주황색이 있고 빨간색이 있어요.",
                "sound_type": [
                    2,
                    3,
