        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런 게 붙여져 있다 이러나?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.453
            },
            {
                "speaker_id": "1",
                "transcription": "그래 가지구 좀 빛이 안 예쁘게 들어와 가지고 저를 찍으면 별로 예쁘게 안 나와요.",
                "sound_type": [
                    2
                ],
                "start": 1.463,
                "end": 6.983
            },
            {
                "speaker_id": "1",
                "transcription": "일단 제가 아까 아랍스트립트에서 기념품 가게를 갔다가 이것저것 사 왔거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.993,
                "end": 13.585
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 샀는지 잠깐 보여드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 13.595,
                "end": 15.232
            },
            {
                "speaker_id": "1",
                "transcription": "어 기념품 같은 거를 쓸데없는 뭐 자석이나 그런 거는 진짜 사와도 아무데 없을 데 없더라고요.",
                "sound_type": [
                    2
                ],
                "start": 15.242,
                "end": 20.773
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이제 되게 어디를 가도 기념품 같은 거 굳이 뭐 좋아하지도 않고 굳이 안 사도 되고 근데 이제 좀 살려면 그래도 실용성 있는 거 사는 게 더 좋다고 생각을 해 가지고",
                "sound_type": [
                    2
                ],
                "start": 20.783,
                "end": 32.758
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 컵이에요 컵 함 열어 볼까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.768,
                "end": 37.480
            }
        ]
    },
