        "term": [
            {
                "speaker_id": "1",
                "transcription": "마트를 와서 라면도 있고 커피도 샀어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.351
            },
            {
                "speaker_id": "1",
                "transcription": "이게 하나는 백 얼마 백 얼마 우리나라 라면이 훨씬 맛있을 거 같아서 조금만 샀고 커피를 여러 개 담았습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.361,
                "end": 11.215
            },
            {
                "speaker_id": "1",
                "transcription": "여기 김치랑 한국 음식이랑 한국 라면 같은 거 엄청 많이 팔아요.",
                "sound_type": [
                    2
                ],
                "start": 11.225,
                "end": 17.451
            },
            {
                "speaker_id": "1",
                "transcription": "요거 봐.",
                "sound_type": [
                    2
                ],
                "start": 17.461,
                "end": 17.836
            },
            {
                "speaker_id": "1",
                "transcription": "붕어싸만코 여기는 되게 큰 마켓이에요.",
                "sound_type": [
                    2
                ],
                "start": 17.846,
                "end": 21.752
            },
            {
                "speaker_id": "1",
                "transcription": "되게 큰 마켓 여기가 저희 묵는 호텔이에요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 21.762,
                "end": 25.632
            },
            {
                "speaker_id": "1",
                "transcription": "내가 너무 배가 많이 나왔어.",
                "sound_type": [
