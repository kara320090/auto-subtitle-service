        "term": [
            {
                "speaker_id": "1",
                "transcription": "한 40, 50개 샀을걸요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.397
            },
            {
                "speaker_id": "1",
                "transcription": "근데 근데 아직도 살게 남아있다니까요?",
                "sound_type": [
                    2
                ],
                "start": 2.397,
                "end": 5.695
            },
            {
                "speaker_id": "2",
                "transcription": "헉 그럼 그 40, 50개 집에 다 있으신 거예요?",
                "sound_type": [
                    2
                ],
                "start": 5.695,
                "end": 8.392
            },
            {
                "speaker_id": "1",
                "transcription": "아이 아니죠.",
