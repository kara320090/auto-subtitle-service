        "term": [
            {
                "speaker_id": "1",
                "transcription": "텐션이 왜 없냐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.990
            },
            {
                "speaker_id": "2",
                "transcription": "일본 분한테",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.006,
                "end": 1.960
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 물어봤더니 그게 일본은 바람이 많이 불어서 텐션이 가득 없어야 더 그냥 플렉시블하게 바람을 이겨 낼 수 있다고 그러더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.020,
                "end": 11.490
            },
            {
                "speaker_id": "2",
                "transcription": "쿨하게 하는 게 아니고 바람을 이기기 위해서 적당히 있어야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.580,
                "end": 16.370
            },
            {
                "speaker_id": "1",
                "transcription": "부로 부러진다 하더라고요 탱탱한 폴이나 그쪽 의견은 이제 플렉시블하게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.420,
                "end": 19.930
            },
            {
                "speaker_id": "2",
                "transcription": "음 아 아 근데 저는 인제 약간 좀 그래도 그까 캠퍼의 어떤 분위기 같은 문화적인 그런 느낌.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.940,
                "end": 27.070
            },
            {
                "speaker_id": "1",
                "transcription": "크게 뭐가 다른지 모르겠어 근데 하나 다른 거는 뭐 아침 6시에 불멍하시는 분들이 많다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.160,
                "end": 31.806
            },
            {
                "speaker_id": "1",
                "transcription": "아침에 화장실 갈려고 일어났는데 한국 분들 다 저희는 캠핑 끝나고 아침에 좀 자잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.816,
                "end": 37.950
            },
            {
                "speaker_id": "1",
                "transcription": "다들 편하게 주무시는데 혼자 오신 분들 막 아침에 다 6시에 불 쬐고 계시고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.958,
                "end": 42.600
            },
