        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 이러나 저러나 어쨌든 해야 되는 그런 느낌 어",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.480
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1님 오늘 어땠어요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 3.490,
                "end": 4.964
            },
            {
                "speaker_id": "2",
                "transcription": "저 와이프한테 오늘 힘들었다고 카톡 보내고 있었어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 4.974,
                "end": 8.802
            },
            {
                "speaker_id": "2",
                "transcription": "아 이게 제가 힘들었던 거는 지금 유튜브를 하고 있다 보니까 뭔가 생각해 놓은 대로 가야 좀 마음이 편한데",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.812,
                "end": 15.949
            },
            {
                "speaker_id": "1",
                "transcription": "아 나도 나도",
                "sound_type": [
                    1,
                    2
                ],
                "start": 15.959,
                "end": 16.800
            },
            {
                "speaker_id": "2",
                "transcription": "그게 좀 뭐라 하지 오늘 계속 바뀌니까 상황이",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.810,
                "end": 20.639
            },
            {
                "speaker_id": "1",
                "transcription": "아 맞아 맞아.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.649,
                "end": 21.503
            },
            {
                "speaker_id": "2",
                "transcription": "사실 인제 어떤 느낌이냐면 그래도 일본까지 왔는데 뭐 하나 찍어 가야 되는데",
                "sound_type": [
                    1,
                    2
                ],
                "start": 21.513,
                "end": 26.644
            },
            {
                "speaker_id": "1",
                "transcription": "아 그러니까 여기 4명 중에 유튜버가 있는 게 진짜 천만다행이다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 26.654,
                "end": 29.670
            },
            {
                "speaker_id": "2",
                "transcription": "뭔가 지금 뭘 찍어야 될지를 모르겠어서",
                "sound_type": [
                    1,
                    2
                ],
                "start": 29.681,
                "end": 32.475
            },
            {
                "speaker_id": "1",
                "transcription": "이 공감이 확 되네.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 32.470,
                "end": 33.756
            },
            {
                "speaker_id": "2",
                "transcription": "네 그래서 조금 심적으로 힘들었는데 그래도 내일 또 재밌는 일들이 앞으로 생기지 않을까 그래서 저는 오늘은 그냥 일찍 잘려고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 33.766,
                "end": 44.500
            }
        ]
    },
    "summary": "유튜버인 남성은 뭔가 생각해 놓은 대로 가야 마음이 편한데 상황이 계속 바뀌니까 뭘 찍어야 할지 모르겠어서 심적으로 힘들었다고 말했다.",
