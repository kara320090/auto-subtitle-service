        "term": [
            {
                "speaker_id": "1",
                "transcription": "도착을 했는데 솔직히 좀 무서워요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.020
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래도 진짜 그나마 다행인 거는 지금 바람이 순방향이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.030,
                "end": 10.193
            },
            {
                "speaker_id": "1",
                "transcription": "아 이게 그나마 위안이 되네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.203,
                "end": 16.267
            },
            {
                "speaker_id": "1",
                "transcription": "자 아까 연습한 대로 가는 거예요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.277,
                "end": 24.319
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 배 받고부터 이 순간이 기다려지긴 했는데 아 긴장감이 장난 아니에요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 24.329,
                "end": 29.174
            },
            {
                "speaker_id": "1",
                "transcription": "근데 먼저 해보신 분이 분명히 생각보다는 굉장히 안정적이라고 했긴 했거든요.",
