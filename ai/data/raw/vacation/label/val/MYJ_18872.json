    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "마침내 한 끗을 채웠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.948
            },
            {
                "speaker_id": "1",
                "transcription": "어 이게 캠핑 장사할 때 항상 그래요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.958,
                "end": 12.815
            },
            {
                "speaker_id": "1",
                "transcription": "항상 진짜 요만큼이 부족해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.825,
                "end": 15.222
            },
            {
                "speaker_id": "1",
                "transcription": "어 예산이 그럴 때 이제 집에 인터넷 약정이 끝났는지 잘 보시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.232,
                "end": 19.954
            },
            {
                "speaker_id": "1",
                "transcription": "어 만약에 끝났다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.964,
                "end": 22.111
            },
            {
                "speaker_id": "1",
                "transcription": "어 그러면은 다른 곳 막 찾을 필요가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.121,
                "end": 24.290
            },
            {
                "speaker_id": "1",
                "transcription": "아주 많은 사은품 정직한 가격 당일 지급하는 아정당에 전화를 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.300,
                "end": 30.538
            },
            {
                "speaker_id": "1",
                "transcription": "아정당 특징이 뭐냐면 아정당은 방통위에 경품고시제라는 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.548,
                "end": 35.062
            },
            {
                "speaker_id": "1",
                "transcription": "그 기준 최대 금액인 47만 원을 주고 만약에 정수기도 끝났다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.072,
                "end": 38.840
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 30만 원 더 주고 이 대목에서 선발대원 저거 약 파는 거 아니야라고 생각하시는 분이 계실 수도 있는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.850,
                "end": 45.514
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 수가 없는 게 아정당에 네이버 카페 회원 수가 무려 22만 명이고 유튜브 채널 구독자 수가 14만 명입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.524,
                "end": 53.058
            },
            {
                "speaker_id": "1",
                "transcription": "어 저의 거의 열 배에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.068,
                "end": 54.861
            },
            {
                "speaker_id": "1",
                "transcription": "어 365일 밤 열 시까지 이제 상담이 되니까 필요하신 분들은 바로 전화를 해 보시고 저는 출발해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.871,
                "end": 65.666
            }
        ]
    },
    "summary": "아정당 특징은 방통위에 경품고시제라는 게 있어서 약정이 끝났으면 인터넷은 최대 47만 원, 정수기는 30만 원 줍니다.",
