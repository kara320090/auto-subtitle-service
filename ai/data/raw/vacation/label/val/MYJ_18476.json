                    2,
                    4
                ],
                "start": 13.614,
                "end": 15.009
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 들어온 데는 이렇게 건물같은데 가 있고 밖에 저기 보면 사람들 저기 다 길에 앉아 있거든요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.019,
                "end": 22.544
            },
            {
                "speaker_id": "2",
                "transcription": "대게 야외에서 맥주 마시기 좋은 것 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.554,
                "end": 26.114
            },
            {
                "speaker_id": "3",
                "transcription": "되게 맛있겠네.",
