        "term": [
            {
                "speaker_id": "1",
                "transcription": "시그니처라 해서 제가 함 시켰봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.984
            },
            {
                "speaker_id": "1",
                "transcription": "이게 크로와상을 구운 거라서 소리 들어보시면 아시겠지만 식감이 상당히 독특합니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 1.994,
                "end": 7.796
            },
            {
                "speaker_id": "1",
                "transcription": "꼭 한번 드셔 보시길 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 7.806,
                "end": 10.351
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 맛있게 먹고 깨끗이 먹고 퇴근해 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 10.361,
                "end": 13.882
            },
            {
                "speaker_id": "1",
                "transcription": "네 주소는 그 유튜브 밑에 더보기란에 남겨 놓을 테니까 한번씩 가보실 분들은 가보시기 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 13.892,
                "end": 21.463
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 구독과 좋아요 부탁드리구요 안뇽.",
                "sound_type": [
                    2
                ],
                "start": 21.473,
                "end": 24.126
            }
        ]
    },
    "summary": "크로플은 식감이 독특하기 때문에 꼭 한번 먹어보길 추천한다.",
