                ],
                "start": 0.000,
                "end": 10.502
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 내가 치킨은 굳이 먹지 않지만 이걸 시켜 봤구요.",
                "sound_type": [
                    2,
                    3
                ],
