                    2,
                    5
                ],
                "start": 18.797,
                "end": 20.001
            },
            {
                "speaker_id": "2",
                "transcription": "연기는 절향이 나는데 여기에서는 되게 과일향이 나는 것 같아. 아 너무 좋다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.011,
                "end": 24.212
            },
            {
