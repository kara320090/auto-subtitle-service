        "term": [
            {
                "speaker_id": "1",
                "transcription": "여깁니다 여러분.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.733
            },
            {
                "speaker_id": "1",
                "transcription": "아이구 아이구 아이구 진짜 맛있게 먹고 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.743,
                "end": 13.240
            },
            {
                "speaker_id": "1",
                "transcription": "저는 분짜가 제일 맛있었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.250,
                "end": 15.032
            },
            {
                "speaker_id": "1",
                "transcription": "분짜는 제가 원래 한국에서도 되게 좋아했었고 반쎄오는 한 번도 안 먹어봐가지고 되게 기대했는데 엄청 맛있을 줄 알았는데 그 정도는 아니었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.042,
                "end": 23.477
            },
            {
                "speaker_id": "1",
                "transcription": "다낭 재밌는 거 같애요 진짜.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.487,
                "end": 27.662
            },
            {
                "speaker_id": "1",
                "transcription": "좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.672,
                "end": 31.949
            },
            {
                "speaker_id": "1",
                "transcription": "골드파인을 가기 전에 콩카페를 가려고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 31.959,
                "end": 35.969
            },
            {
                "speaker_id": "1",
                "transcription": "다낭 대성당이랑 한시장이랑 다 가까이에 있어서 다니는 게 쉬워요.",
                "sound_type": [
                    2
                ],
                "start": 35.979,
                "end": 42.247
            },
            {
                "speaker_id": "1",
                "transcription": "없으면 테이크 아웃해도 되고",
                "sound_type": [
                    2,
                    4
                ],
