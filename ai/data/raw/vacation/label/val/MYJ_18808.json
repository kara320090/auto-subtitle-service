        "term": [
            {
                "speaker_id": "1",
                "transcription": "브이 타프 도나돈",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.624
            },
            {
                "speaker_id": "2",
                "transcription": "도나돈 터널",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.634,
                "end": 2.552
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 근데 요거만 딱 남은 거예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.562,
                "end": 4.458
            },
            {
                "speaker_id": "2",
                "transcription": "지금은 케트커피드 그다음 터널",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.468,
                "end": 6.789
            },
            {
                "speaker_id": "1",
                "transcription": "얘랑?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.799,
                "end": 7.148
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 다 정리하고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.158,
                "end": 8.505
            },
            {
                "speaker_id": "2",
                "transcription": "예",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.515,
                "end": 8.771
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 이 딱 해 놓으신 게 텐트 진짜 좋은데 막 여기에 물건들 막 되게 힘 막 세게 주고 그러진 않으신 것 같아요 그렇죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.781,
                "end": 18.626
            },
            {
                "speaker_id": "2",
                "transcription": "일단은 저는 아이가 있기 때문에 욕심을 부리고 싶어도 많으면 많을수록 불편하니까",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.636,
                "end": 24.183
            },
            {
                "speaker_id": "1",
                "transcription": "아 원래는 욕심을 부리고 싶으신데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.193,
                "end": 26.161
            },
            {
                "speaker_id": "2",
                "transcription": "예전에는 이것저것 많이 놓다가 지금은 점점 최대한 편하게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.171,
                "end": 30.108
            },
            {
                "speaker_id": "1",
                "transcription": "애들 때문에?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.118,
                "end": 31.240
            },
            {
                "speaker_id": "2",
                "transcription": "예 아이들 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.250,
                "end": 32.142
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 다 막",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.152,
                "end": 32.832
            },
            {
                "speaker_id": "2",
                "transcription": "예 다 더러워지고 부닥치고 떨어뜨리고 그래 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.842,
                "end": 36.937
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 다 그냥 최대한 그냥 좀 편안한 느낌으로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.947,
                "end": 39.727
            },
            {
                "speaker_id": "2",
                "transcription": "가장",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.737,
                "end": 40.217
            },
            {
                "speaker_id": "1",
                "transcription": "텐트는 요렇게 딱 하시고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.227,
                "end": 41.788
            },
            {
                "speaker_id": "2",
                "transcription": "텐트는 놔 두고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.798,
                "end": 44.204
            },
            {
                "speaker_id": "1",
                "transcription": "보셨죠 그니까 이 형님의 세팅이 저도 요즘은 사실 좀 공감이 많이 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.214,
                "end": 48.772
            },
            {
                "speaker_id": "1",
                "transcription": "저도 이제 @이름1 데리고 다니면서 저는 막 욕심은 좋은 장비 많이 쓰고 싶은데 이제 @이름1가 막 어차피 막 치우고 다니고 뿌개고 다니고 할 거니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.782,
                "end": 57.271
            },
            {
                "speaker_id": "1",
                "transcription": "저도 용품을 그리고 딱 최소한으로 조그만한 것 들고 다니게 되더라고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.281,
                "end": 61.663
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저도 막 요즘에 스노우피크 테이블 그거 하나만 들고 다니잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.673,
                "end": 64.822
            },
            {
                "speaker_id": "1",
                "transcription": "그건 사실 그 화롯대 장작 불멍 이런 것도 못해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.832,
                "end": 68.502
            },
