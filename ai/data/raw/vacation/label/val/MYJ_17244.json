                    5
                ],
                "start": 10.621,
                "end": 14.899
            },
            {
                "speaker_id": "1",
                "transcription": "아 저기가 전망대구나 저 위에가.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.909,
                "end": 18.744
            },
            {
