                ],
                "start": 5.750,
                "end": 13.825
            },
            {
                "speaker_id": "1",
                "transcription": "기차역에서 피사의 사탑이 있는 데까지가 그리고 볼게 딱 그거였어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.835,
                "end": 18.963
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뭐 옛날의 추억을 되새기며 한번 가볼 만하지 않나 이런 생각을 하네요.",
