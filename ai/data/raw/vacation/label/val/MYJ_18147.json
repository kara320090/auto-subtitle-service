                ],
                "start": 0.000,
                "end": 5.320
            },
            {
                "speaker_id": "1",
                "transcription": "예술은 좀 어렵습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.330,
                "end": 8.531
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 있다가 다시 제주시 쪽으로 가서 함덕 해수욕장으로 갔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.541,
                "end": 14.384
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 또 한가롭게 앉아서 바닷가 멍하니 구경하다가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.394,
                "end": 23.317
            },
            {
                "speaker_id": "1",
                "transcription": "다시 또 카페갔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.327,
                "end": 29.577
            },
            {
                "speaker_id": "1",
                "transcription": "할게 너무 없더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.587,
                "end": 30.790
            },
            {
                "speaker_id": "1",
                "transcription": "아 이제 와이프랑 둘이 다녀야겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.800,
                "end": 33.793
            },
            {
                "speaker_id": "1",
                "transcription": "혼자는 좀 어렵네요.",
