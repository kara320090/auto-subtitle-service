        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 제 시야에서 느낌이 딱 이래요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.553
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 경치 대박 물 위에 동동 떠있는 느낌 진짜 죽였다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.563,
                "end": 11.543
            },
            {
                "speaker_id": "1",
                "transcription": "아 일단은 좀 가자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.553,
                "end": 13.869
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 일단은 좀 갈게요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 13.879,
                "end": 21.197
            },
            {
                "speaker_id": "1",
                "transcription": "저 앞에 섬 봐봐요.",
                "sound_type": [
                    2
                ],
                "start": 21.207,
                "end": 23.267
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 호수에 동동 떠서 여기를 보니까 진짜 유럽 같은 느낌 나요.",
                "sound_type": [
                    2
                ],
                "start": 23.277,
                "end": 27.976
            },
            {
                "speaker_id": "1",
                "transcription": "이게 다 도롯가만 봐서 그랬던 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 27.986,
                "end": 31.089
            },
            {
                "speaker_id": "1",
                "transcription": "여기 인제 호숫가는 이쪽을 아무도 헤친 적이 없잖아요.",
                "sound_type": [
                    2
                ],
                "start": 31.099,
                "end": 35.533
            }
        ]
