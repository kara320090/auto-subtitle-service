                "start": 0.000,
                "end": 2.059
            },
            {
                "speaker_id": "1",
                "transcription": "승선하는 날 승선하는 날 갈지 아니면 그 전날 갈지 한번 가볼려고 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.069,
                "end": 10.589
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 여기 왔으니까 다시 한번 지비타베키의 모습을 보여드립니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.599,
                "end": 17.135
            },
            {
                "speaker_id": "1",
                "transcription": "자 저기까지 걸어가야죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.145,
                "end": 20.276
            },
            {
                "speaker_id": "1",
                "transcription": "에 지하철 아니 지하철 기차역이 저기니까",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.286,
                "end": 22.747
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 근데 걸어갈 필요가 없죠.",
