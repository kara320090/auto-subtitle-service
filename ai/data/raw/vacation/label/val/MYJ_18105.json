                ],
                "start": 0.000,
                "end": 1.025
            },
            {
                "speaker_id": "1",
                "transcription": "중간에 저렇게 또 바위들이 큰 바위들이 있어 갖고 그 앉아서 쉴 수 있게 어 시간을 어 보낼 수 있는 그런 자리인 것 같습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 1.035,
                "end": 13.958
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 물 봐 보세요 한번.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.968,
                "end": 16.606
            },
            {
                "speaker_id": "1",
                "transcription": "이게 계곡물이라고 아니 계곡물이 아니고 이 강물이라고 이 보기에는 정말 와 정말 깨끗하네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.616,
                "end": 27.482
            },
            {
                "speaker_id": "1",
                "transcription": "강에서 이런 물 보기는 참 드물죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 27.492,
                "end": 34.135
            },
            {
                "speaker_id": "1",
                "transcription": "와 정말 이쁘다.",
                "sound_type": [
                    1,
