                "sound_type": [
                    2,
                    3
                ],
                "start": 8.149,
                "end": 9.006
            },
            {
                "speaker_id": "2",
                "transcription": "맛 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.016,
                "end": 10.089
            },
            {
                "speaker_id": "2",
                "transcription": "우렁 시래기 된장국이요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.099,
                "end": 15.163
            },
            {
                "speaker_id": "1",
                "transcription": "음.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.173,
                "end": 16.159
            },
            {
                "speaker_id": "2",
                "transcription": "엄청 실하고 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.169,
                "end": 17.413
            },
            {
                "speaker_id": "2",
                "transcription": "이거를 넣고 물만 넣고 끓이는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.423,
                "end": 19.648
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 하나 하면은 몇 인분 정도 돼요? 아 이거 하나에요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.658,
                "end": 22.523
            },
            {
                "speaker_id": "2",
                "transcription": "4인분.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.533,
                "end": 23.033
            },
            {
                "speaker_id": "2",
                "transcription": "네이버 들어가면은 이게 만5000원이에요 이게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.043,
                "end": 25.520
            },
            {
                "speaker_id": "2",
                "transcription": "근데 여기서는 7600원에서 또 여기 DC해서 2만 원에 드려 3팩에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.530,
                "end": 30.462
            },
            {
                "speaker_id": "1",
                "transcription": "아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.472,
                "end": 31.553
            },
            {
                "speaker_id": "2",
                "transcription": "냉장고에 넣어 놓고 이게 비상용으로 국 없을 때 반찬 없을 때 최고예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.563,
                "end": 35.880
            },
            {
                "speaker_id": "1",
                "transcription": "이 안에 우렁이도 들어있어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.890,
                "end": 37.530
            },
            {
                "speaker_id": "2",
                "transcription": "이게 다 들어있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.540,
                "end": 38.609
            },
            {
                "speaker_id": "2",
                "transcription": "우렁이랑 시래기, 된장, 멸치, 다시마까지 다 있어 이게 다 들어있어요. 물만 없어요 물만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.619,
                "end": 43.714
            },
            {
                "speaker_id": "1",
                "transcription": "물은 얼마나 넣어야 돼요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.724,
                "end": 44.946
            },
            {
                "speaker_id": "2",
