        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "컵에다 넣는다는 게 그냥 여기다 넣어 버렸네.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.458
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 진짜 어우 컵이 너무 큰데 이거?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.468,
                "end": 6.698
            },
            {
                "speaker_id": "1",
                "transcription": "가끔 이래요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.708,
                "end": 8.450
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 나 황당해 가지고 컵 지금 뭐 코펫에다가 지금 커피를 끓이고 있네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.460,
                "end": 14.381
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기서 끓여서 이쪽으로 옮겨야 될 것 같애.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.391,
                "end": 19.983
            },
            {
                "speaker_id": "1",
                "transcription": "이곳에서 어 차박 하면서 어 야경이 있는데 이 영신재 호텔에서 나오는 어 조명이 어우 굉장히 이쁘네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.993,
                "end": 31.100
            }
        ]
    },
    "summary": "한 남성이 컵에 커피를 넣는다는 것을 다른 곳에 넣어 황당해 하고 있고 차박을 하면서 야경을 보는데 영신재 호텔에서 나오는 조면이 예쁘다고 말하고 있다.",
