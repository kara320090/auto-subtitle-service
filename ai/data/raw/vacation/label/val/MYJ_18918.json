        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 자는 게 이제 밖에서 자기가 싫다고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.772
            },
            {
                "speaker_id": "2",
                "transcription": "어색하다고?",
                "sound_type": [
                    2
                ],
                "start": 1.772,
                "end": 2.820
            },
            {
                "speaker_id": "1",
                "transcription": "싫다고 그리고 가버린 거예요.",
                "sound_type": [
                    2
                ],
                "start": 2.820,
                "end": 4.447
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 남자 두 사람이 친한 남자 2명이었는데 그 두 사람이 가버리고 이제 한 명 남은 지인이 여자였어요.",
                "sound_type": [
                    2
                ],
                "start": 4.447,
                "end": 13.212
            },
            {
                "speaker_id": "1",
                "transcription": "저랑 되게 친한 언니였는데 언니랑 나랑 그 다음 날에 이제 정말 일어날 그 뭐 이런 힘든 거는 전혀 생각 못하고 나도 이제 한지 얼마 안 됐으니까",
                "sound_type": [
                    2
                ],
                "start": 13.212,
                "end": 24.665
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 4명이 썼던 건 다 잔뜩 깔아 놓고?",
                "sound_type": [
                    2
                ],
                "start": 24.665,
                "end": 27.822
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그냥 오케이 그냥 어 가 잘가 하고 인사 열심히 하고 갔는데 다음날 이제 언니랑 둘이 치우는데 사실 언니도 언니께 아니다 보니까 이 캠핑도 처음이고",
                "sound_type": [
                    2
                ],
                "start": 27.822,
                "end": 37.112
            },
            {
                "speaker_id": "2",
                "transcription": "아 그렇지 뭘 어떻게 정리해야 될지 모르고",
                "sound_type": [
                    2
                ],
                "start": 37.112,
                "end": 39.035
            },
            {
                "speaker_id": "1",
                "transcription": "아무것도 모르잖아요 그니까",
                "sound_type": [
                    2
                ],
                "start": 39.035,
                "end": 39.985
            },
            {
                "speaker_id": "2",
                "transcription": "그렇지.",
                "sound_type": [
                    2
                ],
                "start": 39.985,
                "end": 40.482
            },
            {
                "speaker_id": "1",
                "transcription": "사실 나도 익숙하지 않은 상태에서 하려니까 시간도 많이 걸리고 한 3시간을 했는데 안 치워지는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 40.482,
                "end": 49.397
            },
            {
                "speaker_id": "2",
                "transcription": "뭘 얼마나 깔아놨길래 그래.",
                "sound_type": [
                    2
                ],
                "start": 49.397,
                "end": 51.510
            },
            {
                "speaker_id": "1",
                "transcription": "텐트를 2동을 치고",
                "sound_type": [
                    2
                ],
                "start": 51.510,
                "end": 53.900
            },
            {
                "speaker_id": "2",
                "transcription": "아 그것도 다 보빈씨 걸로요?",
                "sound_type": [
                    2
                ],
                "start": 53.900,
                "end": 55.527
            },
            {
                "speaker_id": "1",
                "transcription": "예 2동 있는 거 내가 그때 갖고 있었던게 딱 2개 있었는데 그걸 2개 다 가져간 거예요.",
                "sound_type": [
                    2
                ],
                "start": 55.527,
                "end": 60.447
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 하나는 잠자리 하나는 이제 그 부엌처럼 이렇게 왜 식당처럼 이렇게 먹으려고 그렇게 해서 가져갔는데",
                "sound_type": [
                    2
                ],
                "start": 60.447,
                "end": 67.590
            },
            {
                "speaker_id": "2",
                "transcription": "기부 캠퍼네.",
                "sound_type": [
                    2
                ],
                "start": 67.590,
                "end": 68.662
            },
            {
                "speaker_id": "1",
                "transcription": "네 저는 그걸 몰랐어요.",
                "sound_type": [
                    2
                ],
                "start": 68.665,
                "end": 70.180
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이렇게 약간 퍼주는 걸 좋아해서 하 갔는데 이제 다음날 그거 다 치우는데 3시간이 걸려도 안되는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 70.180,
                "end": 76.385
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 언니는 이미 지쳐서 저쪽에 나가 떨어져 있고 나도 이제 끝나야 되는데 더 대박인 거는 우리 다음에 와야 되는 사람들이 와서 한 1시간을 기다렸어요.",
                "sound_type": [
