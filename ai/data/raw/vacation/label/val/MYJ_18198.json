                    2,
                    3
                ],
                "start": 0.727,
                "end": 7.930
            },
            {
                "speaker_id": "1",
                "transcription": "이거 살 때 이런 걸 같이 주거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.940,
                "end": 10.038
            },
            {
                "speaker_id": "1",
                "transcription": "방수액 심실리라는 건데 방수가 덜 되는 부위에 도포하면 된다고 하는데 풀처럼 생겼어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.048,
                "end": 17.967
            },
            {
                "speaker_id": "1",
                "transcription": "어 진짜 풀이네 이게 완전 우와 신기하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.977,
                "end": 27.301
            },
            {
                "speaker_id": "1",
                "transcription": "모서리 부분을 하라는데 여기를 하라는 건가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.311,
                "end": 33.222
            },
            {
