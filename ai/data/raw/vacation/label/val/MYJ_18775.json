        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "입문하시는 것도 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.539
            },
            {
                "speaker_id": "1",
                "transcription": "이게 뭐 가을에만 좋다 그런 게 아니고 사실 장마철 여름 빼고는 전 계절 저는 면 텐트가 다 좋다고 보거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.549,
                "end": 12.397
            },
            {
                "speaker_id": "1",
                "transcription": "사실 이 코트 텐트는 가을 캠핑하고는 사실 그닥 관련이 없죠 이번에 제고가 풀렸길래 또 구하기도 그렇게 어렵지 않더라고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.407,
                "end": 20.290
            },
            {
                "speaker_id": "1",
                "transcription": "이 10만 원 짜리 또는 몇 만원 대 저가용보다는 신경을 쓰긴 썼네 요런 데 있잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.300,
                "end": 26.700
            },
            {
                "speaker_id": "1",
                "transcription": "요기서 이렇게 올라가는 부분 완전히 수직으로 발가락 끝에 안 닿게 그리고 폴대가 요렇게 바깥으로 튀어나가는 걸 스킨으로 잡아줘서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.710,
                "end": 35.863
            },
            {
                "speaker_id": "1",
                "transcription": "이 머리 공간을 확 옆으로 벌어지게 아 요런 거는 확실히 신경을 썼는데 저는 이제 멋도 있고 그다음 제가 가진 텐트들하고 굉장히 색이 잘 맞고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.873,
                "end": 45.757
            },
            {
                "speaker_id": "1",
                "transcription": "예전에 샀던 그 야침 텐트가 약간 의외로 색이 안 맞아서 그래서 이제 구입을 한 거지 특별한 얘가 5만 원이나 10만 원짜리보다 엄청 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.767,
                "end": 55.308
            },
            {
                "speaker_id": "1",
                "transcription": "아 그렇게까지는 볼 건 없을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.318,
                "end": 58.176
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 뭐 테이블하고 의자는 가을이라고 해서 특별히 뭐 달라질 건 없죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.186,
                "end": 65.000
            }
        ]
    },
    "summary": "장마철 여름 빼고 전 계절 저는 면 텐트가 다 좋다고 보고 야침 텐트가 의외로 색이 안 맞아서 구입을 한 거예요.",
