        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "모습을 음 실시간 스트리밍으로 한번 보려고 합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 7.348
            },
            {
                "speaker_id": "1",
                "transcription": "바르셀로나가 진짜 괜찮거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.358,
                "end": 9.215
            },
            {
                "speaker_id": "1",
                "transcription": "바르셀로나 그다음에 제가 가는 다음에 가게 되는 나폴리 아작시오는 안 가봐서 모르겠어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.225,
                "end": 16.230
            },
            {
                "speaker_id": "1",
                "transcription": "얼마나 예쁠지 그래도 예쁘지 않을까 생각합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.240,
                "end": 20.500
            },
            {
                "speaker_id": "1",
                "transcription": "자 어디 도시를 가든 이렇게 크루즈가 입항하거나 출항할 때 또는 정박해 있을 때 이렇게 도시를 바라보는 모습은 정말 아름답죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.510,
                "end": 31.689
            },
            {
                "speaker_id": "1",
                "transcription": "크루즈를 타지 않은 사람은 모르는 거죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 31.699,
                "end": 37.785
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 보니까 또 다르지 않습니까?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 37.795,
                "end": 42.077
            },
            {
                "speaker_id": "1",
                "transcription": "저 마요르카 대성당도 아 오늘 파도는 진짜 겁나게 치네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 42.087,
                "end": 51.244
            },
            {
                "speaker_id": "1",
                "transcription": "저 마요르카 대성당 앞에 파도 치는 거 보세요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 51.254,
                "end": 56.490
            },
            {
                "speaker_id": "1",
                "transcription": "야 아까 파도 치는 거 진짜 무섭더라고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 56.500,
                "end": 59.304
            },
            {
                "speaker_id": "1",
                "transcription": "쓰나미 오는 줄 알았는데",
                "sound_type": [
                    1,
                    2
                ],
                "start": 59.314,
                "end": 63.229
            }
        ]
    },
    "summary": "남성이 크루즈가 마요르카를 떠나는 모습을 보면서 이야기한다.",
