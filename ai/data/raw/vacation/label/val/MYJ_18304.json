        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 좋아.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.683
            },
            {
                "speaker_id": "2",
                "transcription": "여러분 저 사진 찍으려고 의자에 앉았다가 벌 쏘였어요.",
                "sound_type": [
                    2
                ],
                "start": 0.693,
                "end": 4.340
            },
            {
                "speaker_id": "2",
                "transcription": "저기 앉았거든요 근데 이제 모서리 쪽에 앉았는데 옆에 벌이 있길래 앉았는데 뭐가 엄청 아픈 거에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.350,
                "end": 10.291
            },
            {
                "speaker_id": "2",
                "transcription": "다리 허벅다리가 엉덩이 쪽이 나무가시 찔린 줄 알고 일어나 가지고 손으로 휙 털었는데 벌이 손에 딱 있는 거에요.",
                "sound_type": [
                    2
                ],
                "start": 10.301,
                "end": 17.545
            },
            {
                "speaker_id": "2",
                "transcription": "처음에 너무 아파가지고 깜짝 놀랬는데 금방 또 괜찮아지네요.",
                "sound_type": [
                    2
                ],
                "start": 17.555,
                "end": 21.221
            },
            {
                "speaker_id": "2",
                "transcription": "벌에 쏘이다니.",
                "sound_type": [
                    2
                ],
                "start": 21.231,
                "end": 22.391
            },
            {
                "speaker_id": "2",
                "transcription": "이제 진짜 여기서의 일정이 다 끝났네요.",
                "sound_type": [
                    2
                ],
                "start": 22.401,
                "end": 24.851
            },
            {
                "speaker_id": "2",
                "transcription": "근데 저희 언니가 사촌 언니인데 친가 쪽 사촌언니여가지고 사실 살면서 본 적이 다해서 10번도 안 될 거에요.",
                "sound_type": [
                    2
                ],
                "start": 24.861,
                "end": 33.002
            },
            {
                "speaker_id": "2",
                "transcription": "친가 쪽 사촌 언니 오빠들은 다 위쪽에 살아 가지고 못 보고 살았거든요 평생.",
                "sound_type": [
                    2
                ],
                "start": 33.012,
                "end": 37.746
            },
            {
                "speaker_id": "2",
                "transcription": "근데 이제 언니가 저 지금 지내는 곳에서 한 20분 거리 살아 가지고 오기 전에도 든든했어요.",
                "sound_type": [
                    2
                ],
                "start": 37.756,
                "end": 43.508
            },
            {
                "speaker_id": "2",
                "transcription": "언니가 가까이 있으니까 가족이니까 그래 가지고 와서 언니랑 처음으로 단둘이 만나서 놀고 얘기하고 하는 게 잘 통하기도 하고 좋은 거에요.",
                "sound_type": [
                    2
                ],
                "start": 43.518,
                "end": 53.337
            },
            {
                "speaker_id": "2",
                "transcription": "언니랑 여기 와서 벌써 몇 번째 만난거지? 4번 만난 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 53.347,
                "end": 56.412
            },
            {
                "speaker_id": "2",
                "transcription": "그 짧은 시간 동안 4번 만나 가지고 어제 만나고 오늘 또 만났잖아요.",
                "sound_type": [
                    2
                ],
                "start": 56.422,
                "end": 60.456
            },
            {
                "speaker_id": "2",
                "transcription": "내일 대전에 가는데 제일 아쉬운 게 언니랑 다시 떨어지는 게 가장 아쉽더라고요.",
                "sound_type": [
                    2
                ],
                "start": 60.466,
                "end": 66.285
            },
            {
                "speaker_id": "2",
                "transcription": "죽이 잘 맞고 재밌었거든요.",
                "sound_type": [
                    2
                ],
                "start": 66.295,
                "end": 68.195
            },
            {
                "speaker_id": "2",
                "transcription": "제가 대전이 있어도 종종 보고 살면 좋을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 68.205,
                "end": 71.580
            },
            {
                "speaker_id": "2",
                "transcription": "이제 진짜 끝났네 여기서 할 일이 내일 돌아가서 정리도 좀 하고.",
                "sound_type": [
                    2
                ],
                "start": 71.590,
                "end": 77.000
            }
        ]
    },
    "summary": "발화자는 언니와의 추억을 회상하며 이 곳에서의 마지막을 이야기하고 있는 영상이다.",
