        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 그런데 이 도시 모험가 야영 어플 운영하시는 거 스타트업 기업하는 거잖아요 사실은.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.654
            },
            {
                "speaker_id": "2",
                "transcription": "그렇죠.",
                "sound_type": [
                    2
                ],
                "start": 13.664,
                "end": 14.163
            },
            {
                "speaker_id": "1",
                "transcription": "그런 게 사실 되게 쉽지 않다고 듣기도 했고 그럴 것도 같고 수익이라는 게 현재 그렇다 보니까",
                "sound_type": [
                    2
                ],
                "start": 14.173,
                "end": 24.339
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 캠핑회사 정보를 제공하고 뭐 검색 기능을 강화시켰지만 계약을 받지는 않잖아요.",
                "sound_type": [
                    2
                ],
                "start": 24.349,
                "end": 31.094
            },
            {
                "speaker_id": "1",
                "transcription": "그쵸 아 그러니까 여기서 잠깐 설명해 드리면 이 야영이라는 앱은 검색 이 아영이라는 앱 내에서 검색하고 예약도 할 수 있기는 있어요.",
                "sound_type": [
                    2
                ],
                "start": 31.104,
                "end": 38.266
            },
            {
                "speaker_id": "1",
                "transcription": "근데 인제 예약을 링크를 타고 들어가는 걸 인제 야영에서 보여주는 거잖아요.",
                "sound_type": [
                    2
                ],
                "start": 38.276,
                "end": 42.486
            },
            {
                "speaker_id": "2",
                "transcription": "그쵸 연결만 해주죠.",
                "sound_type": [
                    2
                ],
                "start": 42.496,
                "end": 43.388
            },
            {
                "speaker_id": "1",
                "transcription": "근데 어쨌든 앱에서 다 할 수 있게는 할 수 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 43.398,
                "end": 45.848
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 앱을 끄고 뭘 해야 되는 건 아니고",
                "sound_type": [
                    2
                ],
                "start": 45.858,
                "end": 48.168
            },
            {
                "speaker_id": "2",
                "transcription": "맞습니다 예.",
                "sound_type": [
                    2
                ],
                "start": 48.178,
                "end": 49.424
            },
            {
                "speaker_id": "1",
                "transcription": "대신에 그 예약하는 그 시스템을 운영하는 그런 뭐 사이트라든지 그런 데로 링크가 가는 거잖아요.",
                "sound_type": [
                    2
                ],
                "start": 49.434,
                "end": 55.053
            },
            {
                "speaker_id": "2",
                "transcription": "맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 55.063,
                "end": 55.446
            },
            {
                "speaker_id": "1",
                "transcription": "네이버라든지 많이 또 뭐 있죠?",
                "sound_type": [
                    2
                ],
                "start": 55.456,
                "end": 58.164
            },
            {
                "speaker_id": "2",
                "transcription": "뭐 땡큐 캠핑",
                "sound_type": [
                    2
                ],
                "start": 58.174,
                "end": 59.489
            },
            {
                "speaker_id": "1",
                "transcription": "그런 곳 되게 여러 곳 있는 각자 캠핑장이 계약 된 곳으로 가는 거죠?",
                "sound_type": [
                    2
                ],
                "start": 59.499,
                "end": 64.773
            },
            {
                "speaker_id": "2",
                "transcription": "맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 64.783,
                "end": 65.899
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 예.",
                "sound_type": [
                    2
                ],
                "start": 65.909,
                "end": 66.500
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 왜 예약을 안 받느냐?",
                "sound_type": [
                    2
                ],
                "start": 66.510,
                "end": 68.946
            },
            {
                "speaker_id": "2",
                "transcription": "다들 인제 예약하면 돈 받을 수 있는데 왜 예약을 안하냐고 물어보시는 분들 되게 많으세요.",
                "sound_type": [
                    2
                ],
                "start": 68.956,
                "end": 73.782
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 운영을 하면 예약할 때마다 수수료를 받는 시스템",
                "sound_type": [
                    2
                ],
                "start": 73.792,
                "end": 76.896
            },
            {
                "speaker_id": "2",
                "transcription": "예 수수료를 받을 수 있으니까 근데 그걸 안 받는 이유는 저희가 이 DB를 모으는데 한 8개월이 걸렸어요.",
                "sound_type": [
                    2
                ],
                "start": 76.906,
                "end": 82.744
            },
            {
                "speaker_id": "2",
                "transcription": "8개월 걸리고 캠핑장에 그 정보들을 모으는데",
                "sound_type": [
                    2
                ],
                "start": 82.754,
                "end": 86.084
            },
            {
                "speaker_id": "1",
                "transcription": "아 무슨 캠핑장 있고?",
                "sound_type": [
                    2
                ],
                "start": 86.094,
                "end": 87.564
            },
            {
                "speaker_id": "2",
                "transcription": "예 무슨 캠핑장에서 뭐가 있고 시설은 뭐가 있고 뭐",
                "sound_type": [
                    2
                ],
                "start": 87.574,
                "end": 91.214
            },
            {
                "speaker_id": "1",
                "transcription": "강아지 되고",
                "sound_type": [
                    2
                ],
                "start": 91.224,
                "end": 92.319
            },
            {
                "speaker_id": "2",
                "transcription": "매너타임 몇 시고 뭐는 하면 안 되고 뭐는 해도 되고",
                "sound_type": [
                    2
                ],
                "start": 92.329,
                "end": 96.212
            },
            {
                "speaker_id": "1",
                "transcription": "계곡 있고",
                "sound_type": [
                    2
                ],
                "start": 96.222,
                "end": 96.985
            },
            {
                "speaker_id": "2",
                "transcription": "예 맞아요.",
                "sound_type": [
                    2
                ],
                "start": 96.995,
                "end": 97.596
            },
            {
                "speaker_id": "2",
                "transcription": "계곡 있고 어디 있고 산이 있고 나 이거 모으는 데 8개월이 걸렸고요.",
                "sound_type": [
                    2
                ],
                "start": 97.606,
                "end": 101.646
            },
            {
                "speaker_id": "2",
                "transcription": "그거 할 때 제가 알바하시는 분을 11명을 썼어요.",
                "sound_type": [
                    2
                ],
                "start": 101.656,
                "end": 105.737
            },
            {
                "speaker_id": "2",
                "transcription": "11명을 썼는데",
                "sound_type": [
                    2
                ],
                "start": 105.747,
                "end": 106.630
            },
            {
                "speaker_id": "1",
                "transcription": "아 그거 모으느라고요?",
                "sound_type": [
