                    2
                ],
                "start": 2.785,
                "end": 3.757
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 이제 그 의미있는 나의 그런 노동인 느낌도 나고 그리고 나서 맥주 한잔 딱 먹었을 때 그 상쾌한 느낌?",
                "sound_type": [
                    2
                ],
                "start": 3.757,
                "end": 13.052
            },
            {
                "speaker_id": "2",
                "transcription": "아 진짜 캠핑 오래 하시겠다.",
                "sound_type": [
                    2
                ],
                "start": 13.052,
                "end": 15.415
            },
            {
                "speaker_id": "1",
                "transcription": "그게 너무 좋아가지고 처음에 그래서 제가 술을 잘 못해요 사실은",
                "sound_type": [
                    2
                ],
                "start": 15.415,
