            },
            {
                "speaker_id": "1",
                "transcription": "작년에 품절 대란이었던 폴라리스의 타우루스 텐트아시나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.531,
                "end": 13.116
            },
            {
                "speaker_id": "1",
                "transcription": "그 텐트의 이제 리뉴얼 버전이라고 합니다.",
                "sound_type": [
