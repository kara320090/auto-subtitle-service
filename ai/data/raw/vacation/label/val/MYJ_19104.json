                    3,
                    5
                ],
                "start": 13.126,
                "end": 15.828
            },
            {
                "speaker_id": "1",
                "transcription": "폴라리스의 케투스라는 텐트 리뷰해 드릴 거거든요.",
                "sound_type": [
                    2,
