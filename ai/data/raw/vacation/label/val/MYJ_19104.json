                    5
                ],
                "start": 15.838,
                "end": 19.241
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 예쁘고 감성 넘치고 텐트니까 가족 캠핑 다니시는 분들이나 혹은 커플 캠핑 다니시는데 좀 큰 텐트가 좋다 하시는 분들 그리고 감성은 포기 못하시는 분들 끝까지 채널 고정해 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.251,
                "end": 30.852
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러면 이제 텐트 쳐 볼 건데요.",
