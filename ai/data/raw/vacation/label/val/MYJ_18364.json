        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 주변에 이런 불빛들이 막 움직여요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.356
            },
            {
                "speaker_id": "1",
                "transcription": "너무 예뻐.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.366,
                "end": 5.003
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 동생이 올리브영 가서 이런 걸 샀는데 5만 원 이상 사니까 이런 거를 줬다고 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.013,
                "end": 11.917
            },
            {
                "speaker_id": "1",
                "transcription": "이거 어떻게 여는 거야?",
                "sound_type": [
                    2
                ],
                "start": 11.927,
                "end": 13.096
            },
            {
                "speaker_id": "1",
                "transcription": "열어봐.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.106,
                "end": 13.758
            },
            {
                "speaker_id": "1",
                "transcription": "뚜루루 우와 와 우와 이거",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.768,
                "end": 17.925
            },
            {
                "speaker_id": "2",
                "transcription": "아 이거 까면 되나봐.",
                "sound_type": [
                    2
                ],
                "start": 17.935,
                "end": 19.131
            },
            {
                "speaker_id": "1",
                "transcription": "우와 생각보다 나는 뭐 그냥 몇 개 딱 들어있을 줄 알았는데 뭐가 많네?",
                "sound_type": [
                    2
                ],
                "start": 19.141,
                "end": 23.161
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 뭐야.",
                "sound_type": [
                    2
                ],
                "start": 23.171,
                "end": 25.597
            },
            {
                "speaker_id": "1",
                "transcription": "샘플이야?",
                "sound_type": [
                    2
                ],
                "start": 25.607,
                "end": 26.507
            },
            {
                "speaker_id": "1",
                "transcription": "아 이렇게 샘플 같은 거가 들어 있나 보다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.517,
                "end": 28.630
            },
            {
                "speaker_id": "1",
                "transcription": "뜯기 아깝잖아.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.640,
                "end": 29.743
            },
            {
                "speaker_id": "2",
                "transcription": "아 다 뜯어 어차피 버리 버리고 가 가면 나야 좋지.",
