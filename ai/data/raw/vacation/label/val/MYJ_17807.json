            },
            {
                "speaker_id": "1",
                "transcription": "저도 이제 처음 찾는 요령 이렇게 있죠?",
                "sound_type": [
                    2
                ],
                "start": 4.871,
                "end": 8.578
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 제 방이 115로 시작해요 여기거든요.",
