                    2
                ],
                "start": 8.588,
                "end": 13.318
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저는 여기서 왼쪽으로 더 가면 돼요.",
                "sound_type": [
                    2
                ],
                "start": 13.328,
