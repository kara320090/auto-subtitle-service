        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "날씨는 엄청 더운데 못 다닐 정도는 아니에요.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.431
            },
            {
                "speaker_id": "1",
                "transcription": "괜찮은 거 같아요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 3.441,
                "end": 7.564
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 예쁜 분수대가 있어서 와봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.574,
                "end": 17.919
            },
            {
                "speaker_id": "1",
                "transcription": "오 안에는 되게 더럽네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.929,
                "end": 23.005
            },
            {
                "speaker_id": "1",
                "transcription": "저거를 한국 기업에서 만들었다고 한 거 같은 데 맞나요?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 23.015,
                "end": 30.006
            },
            {
                "speaker_id": "1",
                "transcription": "아 저기 멀리 머라이언이 보여요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 30.016,
                "end": 33.947
            },
            {
                "speaker_id": "1",
                "transcription": "여기로 오니까 다리가 있고 이쪽 보면 빌딩이 쫙 있는데 금융 빌딩인 것 같아요.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 33.957,
                "end": 41.762
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 저쪽에는 물을 뿜어대고 있는 사자가 있습니다.",
                "sound_type": [
                    1,
