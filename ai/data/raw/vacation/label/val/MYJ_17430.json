        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 저 아이다 코스마호 옆에 이제 정박을 할 거고요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.388
            },
            {
                "speaker_id": "1",
                "transcription": "중심부는 저쪽 네 대성당 있는 쪽이에요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 3.398,
                "end": 6.977
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 거리가 꽤 멉니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 6.987,
                "end": 9.173
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 뭐 저기까지 갈려면 어 도보로는 한 30분 한 제가 한번 걸어봤는데 여기는 6년 전에 왔었거든요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 9.183,
                "end": 20.163
            },
            {
                "speaker_id": "1",
                "transcription": "걸어봤는데 한 30분 이상 걸립니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 20.173,
                "end": 22.972
            },
            {
                "speaker_id": "1",
                "transcription": "네 아주 빠른 걸음으로 근데 쭉 이 해변가를 걸어가면서 보는 풍경도 나쁘진 않아요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 22.982,
                "end": 29.201
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 좀 힘들어서 여기 아마 크루즈 터미널 밖에 나가면 어 버스 같은 게 있을 거예요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 29.211,
                "end": 35.895
            },
            {
                "speaker_id": "1",
                "transcription": "홉온오프 버스 같은 거 진짜 괜찮거든요?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 35.905,
                "end": 38.050
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이제 저렴한 비용으로 이 마요르카 팔마 마요 팔마 데 마요르카의 어 도시 중간중간 이제 유명한 장소들을 편하게 보실 수가 있을 겁니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 38.060,
                "end": 53.970
            }
        ]
    },
    "summary": "정박 후 대성당까지 빠른 걸음으로 30분 이상 걸리기 때문에 크루즈 터미널 밖에 있는 홉온오프 버스를 타고 팔마 데 마요르카의 장소들을 편하게 보는 것을 추천한다.",
