        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래요? 근데 저는 바로던데?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.727
            },
            {
                "speaker_id": "2",
                "transcription": "어 그니까 시작한 타이밍이 되게 좋네요.",
                "sound_type": [
                    2
                ],
                "start": 1.727,
                "end": 4.620
            },
            {
                "speaker_id": "1",
                "transcription": "어우 너무 너무 바로던데?",
                "sound_type": [
                    2
                ],
                "start": 4.620,
                "end": 6.872
            },
            {
                "speaker_id": "2",
                "transcription": "그럼 근데 캠핑 스타일은 어떤 스타일 좋아하세요?",
                "sound_type": [
                    2
                ],
                "start": 6.872,
                "end": 10.625
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 제일 제가 제일 깨달았던 건 뭐냐면 짐을 너무 많이 가져가지 말자.",
                "sound_type": [
                    2
                ],
                "start": 10.627,
                "end": 15.620
            },
            {
                "speaker_id": "2",
                "transcription": "아 적당히 가자?",
                "sound_type": [
                    2
                ],
                "start": 15.620,
                "end": 17.155
            },
            {
                "speaker_id": "1",
                "transcription": "너무 힘들더라고요.",
                "sound_type": [
                    2
                ],
                "start": 17.155,
                "end": 17.930
            },
            {
                "speaker_id": "2",
                "transcription": "아 근데 오늘도 되게 적당히던데요? 딱 좋게",
                "sound_type": [
                    2
                ],
                "start": 17.932,
                "end": 21.030
            },
            {
                "speaker_id": "1",
                "transcription": "예 딱 그냥 미니멀 하게 침대 테이블 끝",
                "sound_type": [
                    2
                ],
                "start": 21.030,
                "end": 24.015
            },
            {
                "speaker_id": "1",
                "transcription": "그 캠핑을 시작할 때 취지가 좀 쉬고 싶어서 였기 때문에 근데 노동을 하면서도 좀 캠핑 노동은 전 좀 건강한 노동이라 생각하거든요?",
                "sound_type": [
                    2
                ],
                "start": 24.015,
                "end": 33.840
            },
            {
                "speaker_id": "2",
                "transcription": "오 진짜 오우 그거를 벌써요?",
                "sound_type": [
                    2
                ],
                "start": 33.840,
                "end": 36.142
            },
            {
                "speaker_id": "1",
                "transcription": "예 몰라 난 처음부터 그랬어요.",
                "sound_type": [
                    2
                ],
                "start": 36.142,
                "end": 38.820
            },
            {
                "speaker_id": "2",
                "transcription": "아 근데 원래 한국에 캠핑하시는 분들이 그런 거 잘 못 느끼는분도 많거든요.",
                "sound_type": [
                    2
                ],
                "start": 38.820,
                "end": 44.555
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래요?",
                "sound_type": [
                    2
                ],
                "start": 44.555,
                "end": 46.060
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 막 설치하는 거 짜증나고 철수하는 거 짜증나서 캠핑 접는다 뭐 이런 얘기도 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 46.060,
                "end": 51.642
            },
            {
                "speaker_id": "1",
                "transcription": "아 저는 근데 그거부터가 되게 좋았던것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 51.642,
                "end": 54.827
            },
            {
                "speaker_id": "1",
                "transcription": "그 건강한 그니까 노동인데 뭔가",
                "sound_type": [
                    2
                ],
                "start": 54.830,
                "end": 59.000
            }
        ]
    },
    "summary": "캠핑 스타일은 미니멀하게 다니며 캠핑 노동은 건강한 노동이라고 생각한다고 얘기하고 있습니다.",
