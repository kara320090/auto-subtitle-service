                    3
                ],
                "start": 0.000,
                "end": 4.490
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 아기들 이렇게 말 좀 하고 좀 걸어다니는 얘기들 있는 분들은 꼭 같이 한 번 발걸음하셨으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.500,
                "end": 13.801
            },
            {
                "speaker_id": "1",
                "transcription": "네 저는 여기까지구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.811,
                "end": 16.617
            },
            {
                "speaker_id": "1",
                "transcription": "다음에도 새로운 영상으로 찾아뵐 수 있도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.627,
                "end": 19.616
            },
            {
                "speaker_id": "1",
                "transcription": "시청해주신 모든 분들께 감사드리고요 .",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.626,
                "end": 21.809
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 트하의 여행 일기였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.819,
                "end": 23.826
            },
            {
