                    2
                ],
                "start": 13.766,
                "end": 17.522
            },
            {
                "speaker_id": "1",
                "transcription": "어 제가 처음 어 처음 오늘 처음으로 하게 될 것은 비하인드 씬 투어예요.",
                "sound_type": [
                    2
                ],
                "start": 17.532,
                "end": 24.309
            },
            {
                "speaker_id": "1",
                "transcription": "그게 뭐냐면 이제 뭐 겔리라든지 아니면은 공연장 뒤쪽 이렇게 여행 그니까 투어하는 프로그램이고",
                "sound_type": [
