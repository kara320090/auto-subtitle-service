                "end": 9.686
            },
            {
                "speaker_id": "1",
                "transcription": "시청해 주셔서 감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 9.696,
                "end": 13.756
            },
            {
                "speaker_id": "1",
                "transcription": "네 오늘 씨데이 첫 번째 날이고요.",
