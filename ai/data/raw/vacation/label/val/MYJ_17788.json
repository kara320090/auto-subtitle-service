        "term": [
            {
                "speaker_id": "1",
                "transcription": "되게 어, 치비타베키아도 저, 항구에 또 제대로 된 게 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.292
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 걸어가는 사람들 보이시죠?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.302,
                "end": 7.294
            },
            {
                "speaker_id": "1",
                "transcription": "네 충분히 걸어가도 되는 거리이긴 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.304,
                "end": 11.352
            },
            {
                "speaker_id": "1",
                "transcription": "치비타베키아역에서 여기까지요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.362,
                "end": 13.855
            },
            {
                "speaker_id": "1",
                "transcription": "네 이제 노르웨이지안 스타호가 보입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.865,
                "end": 21.720
            },
            {
                "speaker_id": "1",
                "transcription": "스타호는 9만 6천 정도 되는 규모에요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.730,
                "end": 25.567
            },
            {
                "speaker_id": "1",
                "transcription": "배도 먹을 것이 아주 좋습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.577,
                "end": 32.923
            },
            {
                "speaker_id": "1",
                "transcription": "노르웨이지안 자체가 먹을 게 없지만 이거는 제가 탄 다음에 바로 리뉴얼을 했다고 하더라고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 32.933,
                "end": 51.450
            },
            {
                "speaker_id": "1",
                "transcription": "자, 이제 에픽입니다.",
                "sound_type": [
                    2,
