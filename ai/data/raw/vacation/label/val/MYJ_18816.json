        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 오늘 처음 설치한 브이 터프 근데 이 캠핑 장비들 막 구입하고 세팅하고 하잖아요 캠핑 나가서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 11.107
            },
            {
                "speaker_id": "1",
                "transcription": "전체적인 컨셉이 어떤 느낌이에요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.117,
                "end": 13.112
            },
            {
                "speaker_id": "2",
                "transcription": "저는 약간 밀리터리 멀티 캠 위주로 가려고 하는데 이제 점점 카키도 섞이고 칸도 섞이고 그냥 이제 짬뽕이 되는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.122,
                "end": 22.200
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 @이름1도 폼 엄청 좋아하잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.210,
                "end": 24.134
            },
            {
                "speaker_id": "2",
                "transcription": "그렇죠 뭐 제가 선발대원님 처음에 채널 구독한 것도 이런 멀티캠이 아니라 밀리터리 이 장비를 보고 싶어서 구독을 했었고 많이 배웠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.144,
                "end": 34.712
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 이제 요즘에 약간 좀 이런 밀리터리하던가 카키라든지 살짝 좀 시들어지는 느낌인 것 같긴 않아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.722,
                "end": 43.117
            },
            {
                "speaker_id": "2",
                "transcription": "근데 항상 제가 생각했을 때는 밀리터리는 비줄이었던 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.127,
                "end": 46.870
            },
            {
                "speaker_id": "1",
                "transcription": "원래도?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.880,
                "end": 47.515
            },
            {
                "speaker_id": "2",
                "transcription": "예 저는 원래도 대학교 다닐 때부터 약간 야생도 많이 입었었고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.525,
                "end": 51.601
            },
            {
                "speaker_id": "1",
                "transcription": "아 원래부터도?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.611,
                "end": 52.472
            },
            {
                "speaker_id": "2",
                "transcription": "원래 밀리터리를 좋아했었어 가지고 그래서 주변 친구들도 너 그럴 거면 군대를 다시 가라 군대 말뚝 박아라 이런 말을 많이 들었었는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.482,
                "end": 60.005
            },
            {
                "speaker_id": "2",
                "transcription": "캠핑을 시작할 때도 아 무조건 나는 밀리터리로만 간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.015,
                "end": 63.883
            },
            {
                "speaker_id": "2",
                "transcription": "남들이 아이보리 뭐 블랙이다 뭐 이런 거도 신경 안 쓰고 난 무조건 오로지 밀리터리다 그렇게만 생각했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.893,
                "end": 70.803
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 이런 거다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.813,
                "end": 71.974
            },
            {
                "speaker_id": "1",
                "transcription": "원래 밀리터리는 항상 매니아들한테 인기가 있었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.984,
                "end": 75.168
            },
            {
                "speaker_id": "2",
                "transcription": "네 항상",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.178,
                "end": 75.795
            },
            {
                "speaker_id": "1",
                "transcription": "작년 막 재작년 그럴 때 좀 커졌을 뿐 그리고 다시 원래대로 돌아갈 뿐 아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.805,
                "end": 82.361
            },
            {
                "speaker_id": "2",
                "transcription": "아마 밀리터리 하시는 분들은 계속 하시는 분들은 계속 하실 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.371,
                "end": 85.402
            },
            {
                "speaker_id": "1",
                "transcription": "아 결국에는 이제 유행이 지나더라도 나는 요런 느낌이 계속 좋다.",
