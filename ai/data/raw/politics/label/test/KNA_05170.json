            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 지금이 위기 극복을 위해 힘을 모아야 할 때라며 피해 지역을 조속히 특별 재난 지역으로 선포할 것을 정부에 요청했습니다.",
                "sound_type": [
                    2,
