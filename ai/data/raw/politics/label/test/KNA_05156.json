        "term": [
            {
                "speaker_id": "1",
                "transcription": "반면 국민의 힘은 행안부 수장이 주요 현안에 개입할 권한이 있다고 맞섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.581
            },
            {
                "speaker_id": "2",
                "transcription": "경찰국은 법적 근거에 따라서 지금 그거 행안부 장관의 업무를 보조하기 위한 기구예요.",
                "sound_type": [
                    2
                ],
                "start": 5.591,
                "end": 12.649
            },
            {
                "speaker_id": "2",
                "transcription": "행안부 직제로 가능하다는 게 법제적 해석이고",
                "sound_type": [
                    2
                ],
                "start": 12.659,
                "end": 16.096
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 청장 후보자는 경찰국의 법적 논란에 대해서는 구체적 답변을 피했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.106,
                "end": 22.095
            },
            {
                "speaker_id": "3",
                "transcription": "다양한 의견이 있기 때문에 이거는 법적으로 해결을 해야 될 부분이라고 알고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.105,
                "end": 26.726
            }
        ]
    },
    "summary": "국민의 힘은 행안부 수장이 주요 현안에 개입할 권한이 있다고 맞섰고 청장 후보자는 경찰국의 법적 논란에 대해서는 구체적 답변을 피했다.",
