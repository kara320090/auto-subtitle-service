        "term": [
            {
                "speaker_id": "1",
                "transcription": "정식으로 중앙선거관리위원회에 안건 상정을 해서 결론 난 것도 아닌데 그 사무처 직원들이 그렇게 얘기하는 건 월권 아닌가요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.283
            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 법안을 국민투표에 부치는 건 삼권분립에 어긋나는 위헌적 발상이라며 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.293,
                "end": 17.264
            },
            {
                "speaker_id": "2",
                "transcription": "검찰을 옹호하고 정파적 이익만 취하려는 시도라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.274,
                "end": 22.227
            },
            {
                "speaker_id": "2",
                "transcription": "법사위 처리 과정에 몸싸움 책임을 물어 국민의힘 측을 고발하겠다는 방침도 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.237,
                "end": 28.878
            },
            {
                "speaker_id": "3",
                "transcription": "수사권을 사수하고자 국민의힘과 검찰 대통령 당선인과 인수위가 한 몸이 되어 똘똘 뭉친 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 28.888,
                "end": 37.604
            }
        ]
    },
