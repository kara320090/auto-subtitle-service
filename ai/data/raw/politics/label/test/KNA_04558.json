        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 씨는 오일팔 광주민주화운동과 관련한 노태우 전 대통령의 사과도 대신 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.097
            },
            {
                "speaker_id": "1",
                "transcription": "노 전 대통령이 오일팔 희생자에 대한 가슴 아픈 부분 그 이후 재임 시절 일어난 여러 일에 대해 본인의 책임과 과오가 있었다며 용서해 달라고 했다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.107,
                "end": 17.461
            },
            {
                "speaker_id": "1",
                "transcription": "다만 10년 넘게 누워 있고 소통이 전혀 안 되다 보니 직접 사과하지 못한 건 아쉽고 안타깝다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.471,
                "end": 25.405
            },
            {
                "speaker_id": "1",
                "transcription": "노 전 대통령은 생전에 오일팔 피해자들에게 공식 사과한 적은 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.415,
                "end": 30.722
            },
            {
                "speaker_id": "1",
                "transcription": "빈소에는 조문객들의 발길이 이어지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.732,
                "end": 34.123
            },
            {
                "speaker_id": "1",
                "transcription": "안철수 국민의당 대표와 김종인 전 국민의힘 비대위원장 등이 오전에 유족을 찾아 위로했고요.",
                "sound_type": [
                    2
                ],
                "start": 34.133,
                "end": 41.011
            },
            {
                "speaker_id": "1",
                "transcription": "노 전 대통령의 딸 노소영 씨와 이혼 소송 중인 최태원 SK그룹 회장도 빈소를 찾았습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.021,
                "end": 47.351
            },
            {
                "speaker_id": "1",
                "transcription": "이재용 삼성전자 부회장도 조금 전 조문을 마쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.361,
                "end": 51.488
            },
            {
                "speaker_id": "1",
                "transcription": "더불어민주당에선 송영길 대표와 이재명 대선후보 이낙연 전 대표 등이 조문했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.498,
                "end": 57.421
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘에선 이준석 대표가 오전에 빈소를 방문했고 윤석열 홍준표 유승민 원희룡 등 대선 경선 후보들이 토론회를 마치고 곧 빈소를 찾을 계획입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.431,
                "end": 68.892
            },
            {
                "speaker_id": "1",
                "transcription": "김부겸 국무총리도 밤 9시쯤 빈소를 방문할 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 68.902,
                "end": 73.037
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 서울대병원 장례식장에서 KBS 뉴스 @이름2입니다.",
                "sound_type": [
                    2
                ],
                "start": 73.047,
                "end": 77.544
            }
        ]
    },
    "summary": "노태우 전 대통령의 아들 @이름1 씨는 오일팔 광주민주화운동과 관련된 아버지의 사과를 대신 전했고 빈소에는 각계 인사들의 조문이 이어지고 있다.",
