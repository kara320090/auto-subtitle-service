        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 소상공인을 위한 세재지원책도 나왔는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.719
            },
            {
                "speaker_id": "1",
                "transcription": "식당이나 숙박업 등 피해자 납세자를 대상으로 법인세 신고 납부기간을 최대 9개월 연장하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.729,
                "end": 10.181
            },
            {
                "speaker_id": "1",
                "transcription": "또 세무조사도 잠정 유예하고 부가가치세 환급금도 열흘 정도 일찍 지급됩니다.",
                "sound_type": [
                    2
                ],
                "start": 10.191,
                "end": 16.136
            },
            {
                "speaker_id": "1",
                "transcription": "학원들도 요즘 휴원이 계속돼 힘들 텐데요.",
                "sound_type": [
                    2
                ],
                "start": 16.146,
                "end": 18.857
            },
            {
                "speaker_id": "1",
                "transcription": "교육부는 휴원으로 어려움을 처한 영세학원들에 대해 연 2퍼센트 대 저금리로 자금을 빌릴 수 있도록 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.867,
                "end": 26.147
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 중앙재난안전대책본부에서 KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 26.157,
                "end": 30.296
            }
        ]
    },
    "summary": "중앙안전대책본부에서는 소상공인을 위한 세재지원책을 발표했다.",
