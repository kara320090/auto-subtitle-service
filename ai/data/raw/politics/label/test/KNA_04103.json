        "term": [
            {
                "speaker_id": "1",
                "transcription": "경실련은 심지어 문재인 정부 집권 이전인 2017 년 1 월과 비교해 지난 5 월 132 퍼센트가 오른 단지도 2 곳 있었다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.420
            },
            {
                "speaker_id": "1",
                "transcription": "특공 제도가 지역 균형 발전을 위한 공무원 등의 주거 안정이라는 본래 취지를 상실했다는 지적이 나오는 상황 세종시 공무원 특공이 관련 규칙 개정 공포로 폐지된 가운데 경실련은 폐지 범위를 확대해야 한다고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.430,
                "end": 23.707
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 세종시 특공만 폐지하겠다는 입장이지만 혁신도시 등 모든 공무원의 특공 제도를 폐지해야 한다.",
                "sound_type": [
                    2
                ],
                "start": 23.717,
                "end": 31.619
            },
            {
                "speaker_id": "1",
                "transcription": "또 현재의 부동산 정책과 세종시 이전책을 재검토하고 근본적인 집값 안정 대책 마련을 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.629,
                "end": 39.108
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
