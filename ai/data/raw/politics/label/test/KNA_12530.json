        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부는 다주택자 종합 부동산세 세율을 최고 6퍼센트로 높이기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.343
            },
            {
                "speaker_id": "1",
                "transcription": "현재 최고 세율인 3.2퍼센트보다 2배 가까운 수준이고 십이십육 대책에서 나온 4퍼센트보다도 높습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.353,
                "end": 13.373
            },
            {
                "speaker_id": "2",
                "transcription": "다주택자와 단기차익을 노리는 투기성 거래에 대해서는 더 단호히 대응해 취득 보유 및 양도 모든 단계에서 세 부담을 크게 강화하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.383,
                "end": 25.953
            },
            {
                "speaker_id": "1",
                "transcription": "양도세는 2년 미만 보유에 대해선 기본 세율을 높이고 규제지역 다주택자 양도세 중과 세율도 10퍼센트 포인트 높이기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.963,
                "end": 35.708
            },
            {
                "speaker_id": "1",
                "transcription": "다만 매물을 유도하기 위해 내년 5월 말까지 시행을 유예하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.718,
                "end": 40.789
            },
            {
                "speaker_id": "1",
                "transcription": "다주택자 취득세율도 높아지는데 2주택 이상은 8퍼센트 3주택 이상이나 법인은 12퍼센트입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.799,
                "end": 48.595
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 또 4년 단기 임대를 폐지하는 등 임대 사업자 등록 제도를 개편하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 48.605,
                "end": 54.744
            },
            {
                "speaker_id": "1",
                "transcription": "아울러 민영 주택에도 생애 최초 주택 구매자를 위한 특별 공급을 도입하고 3기 신도시 사전 청약 물량도 늘리기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 54.754,
                "end": 63.506
            },
            {
                "speaker_id": "1",
                "transcription": "신혼부부 특별 공급 소득 기준은 완화하고 생애 최초 주택 구매 시 취득세 감면 혜택은 확대하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 63.516,
                "end": 71.337
            }
        ]
    },
    "summary": "정부는 다주택자 종합 부동산세 세율을 최고 6퍼센트로 높이기로 했고 양도세는 2년 미만 보유에 대해선 기본 세율을 높이고 규제지역 다주택자 양도세 중과 세율도 10퍼센트 포인트 높이기로 했으며 다만 매물을 유도하기 위해 내년 5월 말까지 시행을 유예하기로 했다.",
