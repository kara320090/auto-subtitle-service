        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난 10일 고발 사주 의혹과 관련해 국민의힘 김웅 의원실에 대해 압수수색에 나선 공수처.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.074
            },
            {
                "speaker_id": "1",
                "transcription": "김 의원 측이 위법한 영장 집행이라고 강력 반발하면서 11시간 만에 중단됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.084,
                "end": 13.700
            },
            {
                "speaker_id": "1",
                "transcription": "사흘만인 오늘 공수처가 김 위원실에 대한 압수수색을 재개했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.710,
                "end": 19.116
            },
            {
                "speaker_id": "1",
                "transcription": "투입 인력은 검사 2명 포함 모두 17명.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.126,
                "end": 23.028
            },
            {
                "speaker_id": "1",
                "transcription": "지난 압수수색 때보다 배 이상 많았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.038,
                "end": 26.090
            },
            {
                "speaker_id": "1",
                "transcription": "공수처는 지난 압수수색 중단을 인식한 듯 압수수색 대상과 방법 등에 대해 사전 협의부터 거쳤습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.100,
                "end": 33.831
            },
            {
                "speaker_id": "1",
                "transcription": "약 3시간 반 만에 김 의원이 사용한 컴퓨터와 유에스비 물품 등을 확인하고 압수수색을 종료했습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.841,
                "end": 41.561
            },
            {
                "speaker_id": "1",
                "transcription": "지난 압수수색 때 논란이 됐던 보좌관 컴퓨터 등은 김 의원이 사용하지 않은 점을 확인해 압수수색 대상에서 제외했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.571,
                "end": 50.531
            },
            {
                "speaker_id": "1",
                "transcription": "김 의원 측이 항의했던 이른바 키워드 검색도 내용을 살펴보고 관련이 없다는 점을 확인한 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.541,
                "end": 58.841
            },
            {
                "speaker_id": "1",
                "transcription": "김 의원은 이와 관련해 영장에 관련 있는 증거물이 없어 공수처 측에서 가져간 물건은 없다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.851,
                "end": 66.549
            },
            {
                "speaker_id": "1",
                "transcription": "김 의원은 지난해 총선을 앞두고 @이름1 당시 대검 수사 정보 정책관으로부터 범여권 인사 등에 대한 고발장을 받아 당에 전달했다는 의혹을 받고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 66.559,
                "end": 78.508
            },
            {
                "speaker_id": "1",
                "transcription": "압수수색을 마친 공수처는 확보한 자료에 대한 분석을 마치는 대로 사건 관계자들을 불러 조사할 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 78.518,
                "end": 86.080
            },
            {
                "speaker_id": "1",
                "transcription": "한편 공수처의 고발 사주 의혹을 고발한 시민단체는 오늘 김 의원을 직권 남용 혐의 등으로 추가 고발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 86.090,
                "end": 93.822
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름2입니다.",
                "sound_type": [
                    2
                ],
                "start": 93.832,
                "end": 96.763
            }
        ]
    },
    "summary": "공수처가 고발 사주 의혹과 관련해 국민의힘 김웅 의원실에 대해 압수수색에 나섰으며 확보한 자료에 대한 분석을 마치는 대로 사건 관계자들을 불러 조사할 방침이라고 밝혔다.",
