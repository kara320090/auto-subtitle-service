        "term": [
            {
                "speaker_id": "1",
                "transcription": "물밑에 숨으면 추적이 어려운 잠수함.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.539
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 발사하는 SLBM은 언제 어디서 날아올지 예측이 어렵습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.549,
                "end": 7.947
            },
            {
                "speaker_id": "1",
                "transcription": "육지 가까이서 쏜다면 사거리가 길지 않아도 됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.957,
                "end": 11.840
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 전장의 판도를 바꿀 수 있는 이른바 게임체인저로도 불립니다.",
                "sound_type": [
                    2
                ],
                "start": 11.850,
                "end": 17.113
            },
            {
                "speaker_id": "1",
                "transcription": "이때문에 북한도 SLBM 개발에 총력을 쏟고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.123,
                "end": 21.118
            },
            {
                "speaker_id": "1",
                "transcription": "우리 군도 이달 초 SLBM 시험 발사에서 성과를 거둔 것으로 전해졌습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.128,
                "end": 26.673
            },
            {
                "speaker_id": "1",
                "transcription": "수직 발사관을 갖춘 3000톤급 국산 잠수함 안창호함에서 실제로 SLBM을 발사한 겁니다.",
                "sound_type": [
