        "term": [
            {
                "speaker_id": "1",
                "transcription": "절차와 규정에 따라서 왔다고 하더라도 국민의 눈높이에 맞지 않는 그런 오해가 있었다는 거에 대해서 다시 한번 굉장히 마음 아프게 생각하고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.318
            },
            {
                "speaker_id": "2",
                "transcription": "의혹이 점점 더 불거지자 일부 해당 간부들은 도의적 책임을 지겠다며 사퇴했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.328,
                "end": 15.711
            },
            {
                "speaker_id": "3",
                "transcription": "아빠 찬스?",
                "sound_type": [
                    2
                ],
                "start": 15.721,
                "end": 16.375
            },
            {
                "speaker_id": "1",
                "transcription": "아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 16.385,
                "end": 17.488
            },
            {
                "speaker_id": "3",
                "transcription": "책임을 지는 건 사퇴를 포함하시는 거죠?",
                "sound_type": [
                    2
                ],
                "start": 17.498,
                "end": 19.347
            },
            {
                "speaker_id": "1",
                "transcription": "그렇습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.357,
                "end": 20.820
            },
            {
                "speaker_id": "2",
                "transcription": "중앙 선거 관리 위원장도 결국 직접 나서 공식 사과했습니다.",
