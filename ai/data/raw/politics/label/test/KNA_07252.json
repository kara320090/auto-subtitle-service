        "term": [
            {
                "speaker_id": "1",
                "transcription": "청와대와 경복궁 사이 굳게 닫혔던 철문이 열립니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.018
            },
            {
                "speaker_id": "1",
                "transcription": "대통령이 드나들던 길을 이제 누구나 자유롭게 오갑니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.028,
                "end": 8.739
            },
            {
                "speaker_id": "1",
                "transcription": "정부 수립 74년 만에 청와대 전역이 일반에 완전히 공개됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.749,
                "end": 14.440
            },
            {
                "speaker_id": "1",
                "transcription": "대통령이 집무를 보던 본관 앞은 관람객들로 인산인해를 이뤘습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.450,
                "end": 19.620
            },
            {
                "speaker_id": "2",
                "transcription": "지붕이 정말 어떻게 푸른지를 눈으로 확인할 수 있어서 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 19.630,
                "end": 23.876
            },
            {
                "speaker_id": "3",
                "transcription": "첫 개방한다는 그 청와대를 그 의미를 제일 많이 두고 싶어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.886,
                "end": 27.961
            }
        ]
    },
    "summary": "청와대가 74년 만에 일반에 완전히 공개되었다.",
