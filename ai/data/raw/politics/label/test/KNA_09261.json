        "term": [
            {
                "speaker_id": "1",
                "transcription": "다만 정 전 실장이 모든 일을 이 대표에게 보고하고 공유했을 거란 말을 덧붙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.151
            },
            {
                "speaker_id": "2",
                "transcription": "빛과 그림자였다고 할 수 있는 정진상 실장이 본인이 알고 있는 내용들 그런 것들을 공유하지 않고 혼자 독단적으로 모든 걸 처리할 수 있다고 믿지는 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.161,
                "end": 16.673
            },
            {
                "speaker_id": "1",
                "transcription": "이에 대해서도 이 대표 측은 시장이 시 사업을 챙긴 건 당연하며 민간 사업자를 배 불리기 위해 행동한 건 아니라고 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.683,
                "end": 26.489
            },
            {
                "speaker_id": "1",
                "transcription": "유 전 본부장은 정진상 김용 두 사람과 의형제를 맺은 건 2009년도라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.499,
                "end": 32.170
            },
            {
                "speaker_id": "1",
                "transcription": "김만배 씨도 나중에 합류했는데 이후 정 전 실장이 김 씨와 잘 지내라는 말을 했다고 회고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.180,
                "end": 39.439
            }
        ]
    },
