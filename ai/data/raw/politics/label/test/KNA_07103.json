        "term": [
            {
                "speaker_id": "1",
                "transcription": "앞서 검찰청법 개정안을 처리한 국회는 사흘 만에 본회의를 다시 소집해 형사 소송법 개정안을 통과시켰습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.589
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘이 표결에 불참하면서 민주당 단독으로 처리됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.599,
                "end": 11.348
            },
            {
                "speaker_id": "1",
                "transcription": "정의당은 기권표를 던졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.358,
                "end": 13.639
            },
            {
                "speaker_id": "1",
                "transcription": "이른바 중대범죄수사청 설치를 논의할 사법개혁특별위원회의 구성 결의안도 함께 통과됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.649,
                "end": 19.170
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 일단 소기의 성과를 이뤘다고 자평하는 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.180,
                "end": 23.056
            }
        ]
    },
    "summary": "국회는 사흘 만에 본회의를 다시 소집해 민주당 단독으로 형사 소송법 개정안과 사법개혁특별위원회의 구성 결의안이 통과되었다.",
