        "term": [
            {
                "speaker_id": "1",
                "transcription": "힘을 몰아 주어야 앞으로 윤석열 정부가 5년 동안 국정 운영을 잘해 나갈 것이다라는 그런 판단하에서",
                "sound_type": [
