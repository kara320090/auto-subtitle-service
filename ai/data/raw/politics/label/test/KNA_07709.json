        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번 지방 선거에서 선거 보조금을 받은 정당은 여섯 곳 국회 의원 다섯 명 이상 원내 정당 세 곳이 넉넉하게 받았고 다음으로 많이 받은 정당 원외 정당인 민생당입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.634
            },
            {
                "speaker_id": "1",
                "transcription": "지난 총선 득표율에 따라 9억 3000만 원을 받아갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.644,
                "end": 15.596
            },
            {
                "speaker_id": "1",
                "transcription": "지방 선거 출마자 현황입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.606,
                "end": 17.957
            },
            {
                "speaker_id": "1",
                "transcription": "전국에서 7000여 명이 출마했는데 민생당 후보 한 명입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.967,
                "end": 22.419
            },
            {
                "speaker_id": "1",
                "transcription": "보조금을 못 받은 정당보다도 적습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.429,
                "end": 25.778
            },
            {
                "speaker_id": "1",
                "transcription": "유일한 민생당 후보를 찾아가 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.788,
                "end": 28.562
            },
            {
                "speaker_id": "2",
                "transcription": "선거 사무실이 있었어요 이 건물에?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 28.572,
                "end": 30.943
            },
            {
                "speaker_id": "3",
                "transcription": "선거요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 30.953,
                "end": 31.752
            },
            {
