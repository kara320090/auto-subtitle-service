        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당도 이재명 대표가 공언한 22개 민생 입법 과제에 노란봉투법을 포함시키는 등 정기 국회 처리에 힘을 싣고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.303
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 여당인 국민의힘과 재계의 반발은 거셉니다.",
                "sound_type": [
                    2
                ],
                "start": 8.313,
                "end": 12.407
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 권성동 원내대표는 노조의 이기주의적 극단적 투쟁을 무엇으로 막을 수 있냐며 노란봉투법은 불법 파업을 조장하는 황건적 보호법에 불과하다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.417,
                "end": 24.059
            },
            {
                "speaker_id": "1",
                "transcription": "국회 상임위에서도 여야 의원들의 공방이 거셌습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.069,
                "end": 28.215
            },
            {
                "speaker_id": "2",
                "transcription": "못 받는 돈을 청구한다는 것은 이건 정치적인 보복이고",
                "sound_type": [
                    2
                ],
                "start": 28.225,
                "end": 34.701
            }
        ]
    },
    "summary": "노란봉투법은 국회 상임위에서도 여야 의원들의 공방이 거셌다.",
