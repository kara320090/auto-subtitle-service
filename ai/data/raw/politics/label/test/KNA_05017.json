        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 대표 예비 경선 후보는 모두 8명.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.860
            },
            {
                "speaker_id": "1",
                "transcription": "28일 경선에서 3명만 추려 본선에 올라가는데 벌써부터 비이재명계 후보가 단일화 조짐도 감지됩니다.",
                "sound_type": [
                    2
                ],
                "start": 2.870,
                "end": 11.785
            },
            {
                "speaker_id": "1",
                "transcription": "한편 기준 미달 논란을 빚은 박지현 전 비대위원장은 서류 접수부터 불발됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.795,
                "end": 18.532
            },
            {
                "speaker_id": "2",
                "transcription": "서류 접수 자체를 진행할 수 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.542,
                "end": 20.812
            },
            {
                "speaker_id": "3",
                "transcription": "당에서 네 서류는 알아서 해주시는 걸로 하고 전 서류를 두고 가겠습니다.",
                "sound_type": [
