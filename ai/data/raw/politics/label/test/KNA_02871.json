        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐가 악의적이라고 하는 거냐고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.091
            },
            {
                "speaker_id": "1",
                "transcription": "저희가 뭘 조작했다는 거예요?",
                "sound_type": [
                    2
                ],
                "start": 2.101,
                "end": 4.059
            },
            {
                "speaker_id": "2",
                "transcription": "왜 몰라요?",
                "sound_type": [
                    2
                ],
                "start": 4.050,
                "end": 5.082
            },
            {
                "speaker_id": "3",
                "transcription": "대통령실은 격벽 설치와는 무관하다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.090,
                "end": 8.667
            },
            {
                "speaker_id": "3",
                "transcription": "사전 절차 없이 이틀 만에 공사하는 곳이 아니라는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 8.677,
                "end": 12.323
            },
            {
                "speaker_id": "3",
                "transcription": "다만 당시 설전에 대해선 불미스러운 일이라고 표현하며 매우 심각하게 보고 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.333,
                "end": 17.988
            },
            {
                "speaker_id": "3",
                "transcription": "실제 대통령실 내부에선 금요일 설전과 같은 상황이 되풀이되는 것을 막기 위한 여러 조치를 검토하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.998,
                "end": 25.291
            }
        ]
    },
    "summary": "격벽 설치와는 무관하나 당시 설전에 대해선 불미스러운 일이라고 표현하며 매우 심각하게 보고 있다고 했고 대통령실 내부에선 같은 상황이 되풀이되는 것을 막기 위한 여러 조치를 검토하고 있습니다.",
