        "term": [
            {
                "speaker_id": "1",
                "transcription": "미국이 우크라이나 탄약 지원 계획을 세워 한국에 요청했고 한국은 이를 거절하기 어려워 폴란드로 우회 지원하는 방안을 검토했을 가능성이 제기됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.831
            },
            {
                "speaker_id": "1",
                "transcription": "실제 한국 국방부는 국내 업체와 미국 사이에 모종의 협의가 있다는 사실을 공개하기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.841,
                "end": 16.880
            },
            {
                "speaker_id": "2",
                "transcription": "한국 업체와 미 국방부 간에 탄약 수출 협상이 진행되고 있는 것으로 알고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.890,
                "end": 23.239
            },
            {
                "speaker_id": "1",
                "transcription": "국방부 고위 연기자는 미군의 자체 계획이 있었는지는 알 수는 없다며 우리 군 당국이 직접 수출을 계획한 건 없는 것으로 안다고 말했습",
                "sound_type": [
                    2
