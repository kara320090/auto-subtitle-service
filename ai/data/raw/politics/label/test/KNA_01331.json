            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령은 오늘 김창기 국세청장 후보자에 대한 인사 청문 경과 보고서를 송부해 달라고 국회에 다시 요청했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.864,
                "end": 11.145
            },
            {
                "speaker_id": "1",
                "transcription": "국회가 보고서를 보내지 않을 경우 이르면 이번 주말 김 후보자를 임명할 것으로 보입니다.",
                "sound_type": [
