        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회에서 자신의 거취에 대한 입장을 밝히겠다고 했던 이상민 행안부장관",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.817
            },
            {
                "speaker_id": "1",
                "transcription": "대통령에게 사의를 표명한 적 없다며 사퇴서를 일축했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.827,
                "end": 10.756
            },
            {
                "speaker_id": "2",
                "transcription": "더 빨리 사퇴하면 좋다고 생각하는데 어떻게 생각하십니까?",
                "sound_type": [
                    2
                ],
                "start": 10.766,
                "end": 13.471
            },
            {
                "speaker_id": "3",
                "transcription": "현재 위치에서 제가 할 수 있는 최선을 다하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.481,
                "end": 16.970
            },
            {
                "speaker_id": "1",
                "transcription": "우려할 만한 인파가 아니었다 등 논란을 빚은 발언을 거듭 사과하면서도 당시 경찰이 제대로 보고하지 않았다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.980,
                "end": 25.992
            }
        ]
    },
