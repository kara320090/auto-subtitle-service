        "term": [
            {
                "speaker_id": "1",
                "transcription": "철저하게 진상을 밝히고 예외 없이 최고 수준의 징계를 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.255
            },
            {
                "speaker_id": "1",
                "transcription": "피해자께서 국민들께서 됐다고 하실 때까지 계속해서 사과드리겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.265,
                "end": 13.493
            },
            {
                "speaker_id": "1",
                "transcription": "죄송합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.503,
                "end": 14.958
            },
            {
                "speaker_id": "2",
                "transcription": "이런 가운데 다른 성비위가 더 있다는 지적도 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.968,
                "end": 18.938
            },
            {
                "speaker_id": "2",
                "transcription": "민주당 보좌진 협의회는 온라인 회의에서 성희롱 발언을 한 혐의로 조사를 받고 있는 최강욱 의원 사건 이후 많은 제보가 들어왔다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.948,
                "end": 27.696
            },
            {
                "speaker_id": "2",
                "transcription": "공개적으로 올리기 민망한 성희롱성 발언들을 확인했다며 다른 성비위 건에 대해서도 올바른 조치를 해주기 바란다고 밝혔습니다.",
                "sound_type": [
