        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 대선을 포기하고 서울시장에 도전하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.663
            },
            {
                "speaker_id": "1",
                "transcription": "걱정하지 않으셔도 된다고 생각하고요.",
                "sound_type": [
                    2
                ],
                "start": 3.673,
                "end": 6.344
            },
            {
                "speaker_id": "2",
                "transcription": "소통에 문제 있다는 지적을 여러 군데서 받고 계십니다.",
                "sound_type": [
                    2
                ],
                "start": 6.354,
                "end": 10.358
            },
            {
                "speaker_id": "1",
                "transcription": "사실이 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 10.368,
                "end": 12.136
            },
            {
                "speaker_id": "1",
                "transcription": "저는 절대로 혼자서 이렇게 의사 결정을 하진 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.146,
                "end": 15.991
            },
            {
                "speaker_id": "3",
                "transcription": "안 대표는 금 전 의원 개인 신상보다는 방역이나 재난 지원금 지급 등의 현안을 집중 질문했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.001,
                "end": 23.674
            },
            {
                "speaker_id": "1",
                "transcription": "K 방역 어떤 것들이 문제라고 생각하십니까?",
