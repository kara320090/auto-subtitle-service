        "term": [
            {
                "speaker_id": "1",
                "transcription": "해당 꽃집에 가봤습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 1.662
            },
            {
                "speaker_id": "1",
                "transcription": "대표님 안녕하세요 저 여기",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 1.672,
                "end": 3.897
            },
            {
                "speaker_id": "1",
                "transcription": "동대문구 의회가 강동구까지 와서 꽃을 사 간 경위를 묻자 이런 답이 돌아옵니다.",
                "sound_type": [
                    2
                ],
                "start": 3.907,
                "end": 10.034
            },
            {
                "speaker_id": "2",
                "transcription": "솔직히 내가 직접적으로 의회하고 거래한 건 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.044,
                "end": 13.420
            },
            {
                "speaker_id": "1",
                "transcription": "실제 꽃을 판 곳은 따로 있다는 주장입니다.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 13.430,
                "end": 17.296
            },
            {
                "speaker_id": "1",
                "transcription": "자신들은 지인 부탁을 받아 명의만 빌려줬고 꽃값도 대신 결제받아서 진짜 거래처로 보내줬단 겁니다",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.306,
                "end": 25.420
            },
            {
                "speaker_id": "1",
                "transcription": "그곳은 바로 동대문구의회 의장이 하는 꽃집이라고 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.430,
                "end": 29.896
            }
        ]
    },
    "summary": "동대문구 의회가 강동구까지 와서 꽃을 사 간 경위를 묻자 자신들은 지인 부탁을 받아 명의만 빌려줬고 꽃값도 대신 결제받아서 진짜 거래처로 보내줬다고 하는데 그곳은 바로 동대문구의회 의장이 하는 꽃집이라고 했다.",
