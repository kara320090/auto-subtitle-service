        "term": [
            {
                "speaker_id": "1",
                "transcription": "전혀 그런 거 없었고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.378
            },
            {
                "speaker_id": "1",
                "transcription": "소명할 부분들은 많이 소명이 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.388,
                "end": 4.613
            },
            {
                "speaker_id": "2",
                "transcription": "서울 영등포을 면접에선 현역 신경민 의원과 김민석 전 의원이 신경전을 벌였습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.623,
                "end": 11.585
            },
            {
                "speaker_id": "2",
                "transcription": "한국당도 수도권을 시작으로 후보 면접에 돌입했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.595,
                "end": 15.967
            },
            {
                "speaker_id": "2",
                "transcription": "서울 광진을에 단독 공천신청한 오세훈 전 서울시장을 비롯해 후보 84명이 면접을 봤는데 공천결과에 승복하겠느냐는 질문도 나왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.977,
                "end": 27.265
            },
            {
                "speaker_id": "3",
                "transcription": "누가 오시든지 최선을 다해서 선의의 경쟁을 해야 되겠다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.275,
                "end": 32.899
            }
        ]
    },
    "summary": "민주당과 한국당은 총선을 위한 후보 면접에 돌입했고 서울 광진을에 단독 공천신청한 오세훈 전 서울시장은 선의의 경쟁을 다짐했다.",
