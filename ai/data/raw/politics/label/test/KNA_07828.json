        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러니까 세력화를 위해서 나는 뭘 하고 있죠?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.822
            },
            {
                "speaker_id": "2",
                "transcription": "타워 싸움이나 회계 문이나 이거 다 저 부질 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.832,
                "end": 7.377
            },
            {
                "speaker_id": "3",
                "transcription": "종일 침묵하던 이 대표는 언론에 나와 친윤계를 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.387,
                "end": 12.247
            },
            {
                "speaker_id": "3",
                "transcription": "지방 선거 이후 자신을 겨냥한 조직적 움직임이 있다고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.257,
                "end": 16.568
            },
            {
                "speaker_id": "4",
                "transcription": "권력이라고 하는 것들을 그분들이 향유하고 싶은 것인지 잘 모르겠으나 그러면 전당 대회를 통해서 하시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 16.578,
                "end": 24.035
            },
            {
                "speaker_id": "4",
                "transcription": "이런 방식이 아니라",
                "sound_type": [
                    2
                ],
                "start": 24.045,
                "end": 26.208
            },
            {
                "speaker_id": "3",
                "transcription": "이런 가운데 공천 개혁을 명분으로 이 대표가 띄운 혁신 위원회가 첫 회의를 열었습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.218,
                "end": 31.931
            }
        ]
    },
