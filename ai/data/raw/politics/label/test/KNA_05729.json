        "term": [
            {
                "speaker_id": "1",
                "transcription": "고성을 지르는 등 불미스러운 일로 인해 본래 취지를 살리기 어려워졌다는 판단이 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.489
            },
            {
                "speaker_id": "2",
                "transcription": "고성을 지른 불미스러운 일 지난 금요일 출근길 문답에서 MBC 기자가 돌아서서 가는 윤 대통령에게 한 이 질문을 말하는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 9.499,
                "end": 18.870
            },
            {
                "speaker_id": "3",
                "transcription": "안전 보장과 관련되는 것일 때에는 그 중요성은 이루 말할 수가 없다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 18.880,
                "end": 25.782
            },
            {
                "speaker_id": "4",
                "transcription": "MBC가 뭘 악의적으로 했다는 거죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.792,
                "end": 28.003
            },
            {
                "speaker_id": "4",
                "transcription": "뭐가 악의적이에요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.013,
                "end": 30.529
            },
            {
                "speaker_id": "2",
                "transcription": "이후 @이름1 홍보 기획 비서관이 가시는 분한테 그만 좀 하라고 했고 MBC 기자는 이 비서관과 2분여간 설전을 벌였습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.539,
                "end": 38.868
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 대통령실은 이 설전은 사안의 본질이 아니라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.878,
                "end": 43.195
            },
            {
                "speaker_id": "2",
                "transcription": "결국 MBC 기자가 윤 대통령에게 뭐가 악의적이냐고 2번 반복해 물은 것이 문답 중단의 주요 이유인 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 43.205,
                "end": 51.574
            },
            {
                "speaker_id": "2",
                "transcription": "여야의 반응은 크게 엇갈렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 51.584,
                "end": 54.091
            },
            {
                "speaker_id": "5",
                "transcription": "그러나 MBC는 지금까지 일련의 모든 논란에도 불구하고 사과 한마디조차 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 54.101,
                "end": 61.827
            },
            {
                "speaker_id": "5",
                "transcription": "언론의 자유와 방종은 분명히 다릅니다.",
                "sound_type": [
                    2
                ],
                "start": 61.837,
                "end": 65.789
            },
            {
                "speaker_id": "6",
                "transcription": "대통령에게 불편한 질문을 던지는 것이 불미스러운 사태입니까?",
                "sound_type": [
                    2
                ],
                "start": 65.799,
                "end": 71.547
            },
            {
                "speaker_id": "6",
                "transcription": "참 권위적인 발상이고 좀스러운 대응입니다.",
                "sound_type": [
                    2
                ],
                "start": 71.557,
                "end": 76.230
            },
            {
                "speaker_id": "2",
                "transcription": "대통령실은 청사 1층 통로에 설치한 가벽에 대해선 문답 중단과 관련이 없다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 76.240,
                "end": 83.099
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 83.109,
                "end": 86.086
            }
        ]
    },
    "summary": "MBC 기자가 묻는 질문으로 문답이 종료됐고 여야는 의견이 다르다.",
