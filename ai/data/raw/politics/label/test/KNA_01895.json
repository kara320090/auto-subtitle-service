        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령실 조직 개편을 예고해오던 윤석열 당선인이 민정수석실 폐지를 먼저 공식화했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.101
            },
            {
                "speaker_id": "1",
                "transcription": "청와대 민정수석실이 사정 기관을 장악해 합법을 가장해서 정적을 통제하는 경우가 많았고 세평 검증을 한다며 뒷조사를 벌여왔다는 이유를 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.111,
                "end": 16.060
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인은 이런 인식을 후보 시절부터 공공연히 밝혀 왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.070,
                "end": 20.661
            },
            {
                "speaker_id": "2",
                "transcription": "정치적인 반대 그 세력을 에 이걸로써 좀 합법을 위장해서 통제하는 경우가 비일비재했기 때문에 그 본연의 기능에서 완전히 벗어났습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.671,
                "end": 34.285
            },
            {
                "speaker_id": "1",
                "transcription": "민정수석실은 사정 업무와 인사 검증 공직 기강 등을 맡습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.295,
                "end": 38.686
            },
            {
                "speaker_id": "1",
                "transcription": "대통령 친인척 비리를 막기 위한 조직도 갖추고 있습니다.",
