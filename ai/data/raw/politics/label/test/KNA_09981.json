                    2
                ],
                "start": 3.951,
                "end": 13.632
            },
            {
                "speaker_id": "2",
                "transcription": "핵 사용 시도를 억제할 수 있는 미국의 강력한 핵 전력 활동 범위를 한국까지 확장하겠다는 약속을 이전보다 강화한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 13.642,
                "end": 23.717
            },
            {
                "speaker_id": "2",
                "transcription": "차이는 우선 작동 방식에 있습니다.",
