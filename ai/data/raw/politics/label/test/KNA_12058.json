        "term": [
            {
                "speaker_id": "1",
                "transcription": "미래한국당 공관위는 공천 반발을 곧바로 일축했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.529
            },
            {
                "speaker_id": "2",
                "transcription": "포함시키기를 황교안 측이 원했다면 @이름1라는 사람을 공천관리 위원장으로 인선하지 말았어야 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.539,
                "end": 12.743
            },
            {
                "speaker_id": "1",
                "transcription": "비례 전담 위성정당이 독자 행보에 나선 모양새지만 한선교 대표를 제외한 통합당 출신의 반발로 미래한국당 최고위는 아직 비례 후보 명단을 의결하지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.753,
                "end": 23.507
            },
            {
                "speaker_id": "1",
                "transcription": "미래한국당을 거세게 비판하던 민주당 뒤늦게 비례연합정당 준비에 분주합니다.",
                "sound_type": [
                    2
                ],
                "start": 23.517,
                "end": 29.701
            },
            {
                "speaker_id": "1",
                "transcription": "연합 정당에 이른바 플랫폼은 시민을 위하여 당으로 공식화했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.711,
                "end": 34.215
            },
            {
                "speaker_id": "1",
                "transcription": "또 불출마 위원들의 이적을 설득 중인 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.225,
                "end": 37.837
            }
        ]
    },
