        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "방산수소 등 미래에너지 또 문화 관광 분야를 중심으로 한국과 사우디에 협력을 한층 더 확대하고 발전시켜 나가기를 기대합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.842
            },
            {
                "speaker_id": "2",
                "transcription": "무함마드빈살만 왕세자도 에너지와 방위 산업 건설 인프라 세 분야에서 한국과 협력을 획기적으로 강화하고 싶다고 화답했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.852,
                "end": 20.547
            },
            {
                "speaker_id": "2",
                "transcription": "이와 관련해 한국과 사우디는 20여 건에 mou를 체결했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.557,
                "end": 24.709
            },
            {
                "speaker_id": "2",
                "transcription": "네옴시티 내 철도건설 협력부터 그린수소 생산을 공동 추진하는 등 모두 26건이 체결됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.719,
                "end": 31.767
            },
            {
                "speaker_id": "2",
                "transcription": "특히 사우디 국영 회사인 아람코에 자회사가 최대 주주인 s오일은 울산에 차세대 공장을 짓는데 단일 외국인 투자 중 최대 규모인 9조 2000여 억원을 투자하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.777,
                "end": 43.371
            },
            {
                "speaker_id": "2",
                "transcription": "무함마드빈살만 왕세자는 국내 기업 총수 등 경제인들과 간담회를 가졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.381,
                "end": 49.198
            },
            {
                "speaker_id": "3",
                "transcription": "오늘 어떤 말씀나누실 거예요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.208,
                "end": 51.769
            },
            {
                "speaker_id": "2",
                "transcription": "이재용 삼성전자 회장과 최태원 Sk 그룹 회장 정의선 현대차 그룹 회장을 비롯해 한화와 두산 등 에너지 인프라 관련기업 경제인들이 자리를 함께 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.779,
                "end": 62.487
            },
            {
                "speaker_id": "2",
                "transcription": "한국과에 경제협력 강화에 초점을 맞췄던 사우디 왕세자에 방한일정 철저히 언론 접촉을 피한채 철통보완 속에 진행됐고 무함마드빈살만 왕세자는 오늘 저녁 출국했습니다.",
                "sound_type": [
                    2
                ],
                "start": 62.497,
                "end": 75.684
            },
            {
                "speaker_id": "2",
                "transcription": "KBS뉴스 @이름1입니다.",
