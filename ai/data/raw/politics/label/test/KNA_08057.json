        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰 내부망도 들끓었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.305
            },
            {
                "speaker_id": "1",
                "transcription": "특히 @이름1 장관의 쿠데타 발언을 놓고 망언이다.",
                "sound_type": [
                    2
                ],
                "start": 2.315,
                "end": 6.415
            },
            {
                "speaker_id": "1",
                "transcription": "의견 제시가 쿠데타인가. 등등의 날 선 말이 쏟아졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.425,
                "end": 10.403
            },
            {
                "speaker_id": "2",
                "transcription": "경찰권을 장악하려는 게 쿠데타지.",
                "sound_type": [
                    2
                ],
                "start": 10.413,
                "end": 13.473
            },
            {
                "speaker_id": "2",
                "transcription": "정치적 중립을 지키겠다고 모이는 게 쿠데타가 되겠습니까. 우리는 쿠데타를 막는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 13.483,
                "end": 19.781
            },
            {
                "speaker_id": "1",
                "transcription": "내가 @이름1이다 같은 응원 글과 함께 류 총경을 돕자는 모금 운동까지 시작됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.791,
                "end": 26.656
            },
            {
                "speaker_id": "1",
                "transcription": "류 총경은 대기 발령에 대해 효력 정지 가처분에 나설 뜻을 내비쳤습니다.",
                "sound_type": [
                    2
