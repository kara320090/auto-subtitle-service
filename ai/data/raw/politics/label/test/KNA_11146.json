        "term": [
            {
                "speaker_id": "1",
                "transcription": "올해 공개된 국회 의원과 공직자들의 재산 변동 내용을 확인해 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.227
            },
            {
                "speaker_id": "1",
                "transcription": "두 명만 가상 자산의 보유 내역을 스스로 알렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.237,
                "end": 9.046
            },
            {
                "speaker_id": "1",
                "transcription": "박범수 대통령 비서실 비서관은 배우자의 현금 300만 원이 150만 원으로 줄었다고 공개하면서 비트 코인 값의 변동이 이유라고 적었습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.056,
                "end": 19.515
            },
            {
                "speaker_id": "1",
                "transcription": "박 비서관은 정확하게 신고하고 싶어서 그랬고 현금으로 적은 건 필요할 때 찾을 수 있기 때문이라고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.525,
                "end": 27.120
            },
            {
                "speaker_id": "1",
                "transcription": "이승연 부산시 의회 의원도 코인을 4억 원어치 갖고 있다가 1억 4000만 원의 손해를 봤다며 공개했습니다.",
                "sound_type": [
                    2
                ],
