        "term": [
            {
                "speaker_id": "1",
                "transcription": "지지 여부와 상관없이 당선 전망도 물었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.119
            },
            {
                "speaker_id": "1",
                "transcription": "응답자의 46.9퍼센트가 이재명 후보라고 37.4퍼센트는 윤석열 후보라고 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.129,
                "end": 10.008
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보가 넉넉히 앞선 결과지만 보름 전 30퍼센트 포인트에 가까웠던 격차는 한자릿수로 좁혀졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.018,
                "end": 17.736
            },
            {
                "speaker_id": "1",
                "transcription": "지금의 선택을 계속 유지할지도 물었더니 이재명 윤석열 후보 지지자는 10명 중 8명이 그대로 지지하겠다고 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.746,
                "end": 26.198
            },
            {
                "speaker_id": "1",
                "transcription": "반면 심상정 안철수 후보 지지층에선 60퍼센트 안팎이 지지 후보를 바꿀 수 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.208,
                "end": 32.966
            }
        ]
    },
