        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인이 파견한 대표단은 오늘 제이크 설리번 국가 안보 보좌관을 만나 한미 간 전략 자산 전개를 협의했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.864
            },
            {
                "speaker_id": "1",
                "transcription": "워싱턴에서 김양순 특파원이 보도합니다.",
                "sound_type": [
                    2
                ],
                "start": 8.874,
                "end": 12.385
            },
            {
                "speaker_id": "2",
                "transcription": "북한의 탄도미사일 발사 능력이 미 본토에 실질적 위험을 초래할 수준이라는 평가가 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.395,
                "end": 20.125
            },
            {
                "speaker_id": "2",
                "transcription": "마크 밀리 합참 의장은 미 하원 군사위원회에 낸 서면 답변에서 북한이 무기 시험과 개발을 지속하고 있다며 이는 미 본토는 물론 인도 태평양 지역 동맹에 실질적 위협이 되고 있다고 평가했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.135,
                "end": 35.409
            },
            {
                "speaker_id": "2",
                "transcription": "최근 북한의 잇단 무기 시험과 그에 따른 기술 진전의 위험성을 지적한 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.419,
                "end": 42.066
            },
            {
                "speaker_id": "2",
                "transcription": "이와 관련 윤석열 당선인이 미국에 파견한 한미 정책 협의 대표단은 제이크 설리번 미 백악관 국가 안보 보좌관을 만나 한미 간 전략 자산 전개와 관련해 협의했다고 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.076,
                "end": 55.944
            },
            {
                "speaker_id": "2",
                "transcription": "대북 억지력을 강화하기 위해 한미 연합 방위 태세와 전략 자산 배치 전개에 대해 상당히 깊은 논의를 했다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 55.954,
                "end": 66.050
            },
            {
                "speaker_id": "3",
                "transcription": "전략 자산 전개는 어 그 아까 말씀드린대로 확장 억제 강화에 중요한 요소입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 66.057,
                "end": 74.050
            },
            {
                "speaker_id": "3",
                "transcription": "으 그런 차원에서 오늘 한미 간에 협의를 했다고 보시면 됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 74.060,
                "end": 78.278
            }
        ]
    },
    "summary": "북한의 탄도미사일 발사 능력이 미 본토는 물론 인도 태평양 지역 동맹에 실질적 위협이 되고 있다고 평가했고 이와 관련해 윤석열 당선인이 미국에 파견한 대표단은 제이크 설리번 미 백악관 국가 안보 보좌관을 만나 한미 간 전략 자산 전개를 협의했다고 밝혔다며 기자는 보도하였다.",
