        "term": [
            {
                "speaker_id": "1",
                "transcription": "앞선 뉴스에서 이재명 후보는 리더가 유능하고 성실하고 그리고 책임감 있어야 나라가 제대로 된다면서 오늘 인물론을 특히 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.875
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보를 겨냥해서는 국정은 초보 아마추어의 연습장이 아니라고 지적했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.885,
                "end": 14.410
            },
            {
                "speaker_id": "1",
                "transcription": "자신은 국회의 민주당 소속 172석을 가지고 안정적으로 국정을 운영할 수 있다고 강조하기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.410,
                "end": 21.869
            },
            {
                "speaker_id": "1",
                "transcription": "정권 교체를 내건 야권 단일화에 맞서 경제와 위기 극복을 앞세운 능력을 부각하는 메시지를 내놓으며 부동층 표심 공략에 주력하는 모습입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.879,
                "end": 31.801
            },
            {
                "speaker_id": "1",
                "transcription": "지역별 공약도 거듭 확인해 부산 유세에서는 이 후보는 부울경 메가시티와",
                "sound_type": [
                    2,
                    4
                ],
                "start": 31.811,
                "end": 37.437
            }
        ]
    },
    "summary": "이재명 후보는 윤석열 후보에 대해 지적하며 특히 인물론을 강조하였고 안정적 국정 운영을 통해 경제 위기 극복을 앞세운 능력을 부각하는 메시지를 내놓으며 부동층 표심 공략에 주력했다.",
