        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "청해부대가 독자적인 작전을 펼치는 방식으로 호르무즈 해협 일대에 파견됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.730
            },
            {
                "speaker_id": "1",
                "transcription": "국방부는 현재 중동 지역 정세를 감안해 우리 국민의 안전과 선박의 자유 항해 보장을 위해 청해부대 파견 지역을 한시적으로 확대하기로 결정했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.740,
                "end": 16.502
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 청해부대의 파견 지역은 현재 아덴만 일대에서 오만만과 아라비아만 일대까지 확대됩니다.",
                "sound_type": [
                    2
                ],
                "start": 16.512,
                "end": 24.217
            },
            {
                "speaker_id": "1",
                "transcription": "우리 군 지휘하에 우리 국민과 선박 보호 임무를 수행할 예정이라고 국방부는 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.227,
                "end": 30.229
            },
            {
                "speaker_id": "1",
                "transcription": "미국이 주도하는 국제 해양 안보 구상 즉 호르무즈 호위연합에 참여하지 않는 독자 파견 형태로 청해부대가 독자적인 작전을 수행한다는 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 30.239,
                "end": 40.860
            },
            {
                "speaker_id": "1",
                "transcription": "대신에 청해부대 소속 장교 2명을 바레인에 있는 호위연합 본부에 연락 장교로 파견하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 40.870,
                "end": 48.450
            },
            {
                "speaker_id": "2",
                "transcription": "독자적으로 작전을 수행하더라도 필요한 경우에는 IMSC 국제해양안보구상과 협력할 예정이며",
                "sound_type": [
                    2
                ],
                "start": 48.460,
                "end": 59.673
            },
            {
                "speaker_id": "1",
                "transcription": "국방부 관계자는 지난해 5월 중동 지역 긴장 고조 이후 다양한 방안을 검토해왔다면서 유사시 우리 국민과 선박 보호 안정적 원유 수송을 최우선적으로 고려했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.683,
                "end": 72.503
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 청해부대는 지난해 7월 이후 호르무즈 해협과 가까운 오만의 무스카트항을 주 기항지로 정했다고 국방부는 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 72.513,
                "end": 81.886
            },
            {
                "speaker_id": "1",
                "transcription": "한국시각으로 오늘 오후 5시 30분에 오만 무스카트항에서는 왕건함이 강감찬함과 임무를 교대했고 호르무즈 해협 일대로 작전 구역을 넓혀서 임무를 수행합니다.",
                "sound_type": [
                    2
                ],
                "start": 81.896,
                "end": 93.988
            },
            {
                "speaker_id": "1",
                "transcription": "이번 결정에 대해 미국은 한국의 결정을 환영하고 기대한다는 입장을 표명했고 이란은 한국 결정을 이해한다면서 자국의 기본 입장을 설명했다고 국방부 관계자는 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 93.998,
                "end": 107.076
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 107.086,
                "end": 109.676
            }
        ]
    },
