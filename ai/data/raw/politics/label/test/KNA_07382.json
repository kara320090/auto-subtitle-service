        "term": [
            {
                "speaker_id": "1",
                "transcription": "경북 도의원에 무투표 당선된 국민의힘 박창석 후보.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.892
            },
            {
                "speaker_id": "1",
                "transcription": "전과 기록 7회로 무투표 당선자 가운데 가장 많습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.902,
                "end": 8.263
            },
            {
                "speaker_id": "1",
                "transcription": "음주 운전과 무면허 뺑소니 등으로 6차례 벌금형을 선고받았고 횡령으로 징역 1년 6개월에 집행유예 2년형을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.273,
                "end": 16.995
            },
            {
                "speaker_id": "2",
                "transcription": "개인적으로 이득을 취한 부분은 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.005,
                "end": 19.401
            },
            {
                "speaker_id": "2",
                "transcription": "과거에 있었던 모든 일들에 대해선 크게 반성하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.411,
                "end": 22.835
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 지방선거 단기입니다.",
                "sound_type": [
                    2
                ],
                "start": 22.845,
                "end": 25.211
            },
            {
                "speaker_id": "1",
                "transcription": "횡령으로 집행유예 이상의 형이 확정되면 공천 대상에서 배제한다고 돼 있지만 박 후보는 심사를 통과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.221,
                "end": 32.732
            }
        ]
    },
    "summary": "횡령 등의 혐의로 집행유예 이상의 형이 확정되면 공천 대상에서 배제한다고 돼 있지만 지방선거에 무투표 당선된 국민의힘 박 후보는 심사를 통과했다고 보도했다.",
