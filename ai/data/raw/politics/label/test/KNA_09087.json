        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘 내부에선 박 구청장 사퇴론도 나오고 있지만 정작 용산구 의회에선 언론보도에 희생양이라며 구명 운동에 나선 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.010
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 용산구 의원들은 박 구청장이 탄원추진 사실을 알았는지에 대해선 말을 아꼈습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.020,
                "end": 16.620
            },
            {
                "speaker_id": "2",
                "transcription": "아직 잘은 모를 거예요 그렇치만 이제 이게 또 이 소문을 이렇게 이런 거는 또 비밀이 없으니까 지역주민분들이 일부 소속 단체 이런 분들이 이거는 아닌 거 같다 이렇게 이제 나선 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 16.630,
                "end": 29.467
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 용산구 위원들은 이태원 참사 특위 구성 요구와 관련해 대응책도 함께 논의했습니다.",
                "sound_type": [
                    2
