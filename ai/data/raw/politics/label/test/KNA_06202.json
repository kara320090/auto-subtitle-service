        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 이재명 후보 이른 아침 기자회견을 열어 여의도 기득권 정치의 교체를 선언했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.380
            },
            {
                "speaker_id": "1",
                "transcription": "세대교체를 핵심으로 내세웠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.390,
                "end": 9.444
            },
            {
                "speaker_id": "1",
                "transcription": "젊은 내각을 만들고 총리는 국민이나 국회의 추천을 받겠다고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.454,
                "end": 14.956
            },
            {
                "speaker_id": "1",
                "transcription": "송영길 대표 불출마 선언과 86 세대 용퇴론 등이 나오는 당 쇄신 움직임의 연장선입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.966,
                "end": 22.233
            },
            {
                "speaker_id": "2",
                "transcription": "30대 40대 장관을 적극 기용하겠습니다.",
                "sound_type": [
