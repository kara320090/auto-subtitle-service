            },
            {
                "speaker_id": "1",
                "transcription": "집값 상승 추이 등을 고려해 더 많은 고령층이 안정적인 노후 소득 기반을 마련할 수 있도록 가입 기준을 상향 조정해야 한다는 겁니다.",
                "sound_type": [
                    2
