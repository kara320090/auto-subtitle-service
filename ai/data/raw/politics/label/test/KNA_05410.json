        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 박진 장관 해임 건의안 통과 하루 만에 거부 의사를 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.737
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 홍보 수석의 공지를 통해 윤석열 대통령은 해임 건의를 받아들이지 않는다고 말했다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.747,
                "end": 13.023
            },
            {
                "speaker_id": "1",
                "transcription": "국회에선 후폭풍이 오늘도 이어졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.033,
                "end": 15.898
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 해임안을 상정했던 민주당 출신 김진표 국회 의장에 대한 사퇴 촉구 결의안을 제출했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.908,
                "end": 23.570
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘과 협의도 제대로 하지 않고 일방적으로 은사 일정 변경을 동의해 줌으로써 중립성에 대한 어 국회 법의 취지를 정면으로 어 배치했다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.570,
                "end": 37.923
            },
            {
                "speaker_id": "1",
                "transcription": "민주당의 외교 참사 비판에 대해선 상대국도 괜찮다고 했다며 민주당의 억지 자해라고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.933,
                "end": 44.614
            },
            {
                "speaker_id": "3",
                "transcription": "민주당이 외교 참사 외교 참사 이렇게 이야기하는데 예 사실은 실상을 알고 보니까 외교 참사가 아니라 민주당의 억지 자해 참사인 거 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 44.624,
                "end": 57.090
            }
        ]
    },
    "summary": "윤석열 대통령은 박진 장관 해임 건의안 통과 하루 만에 거부 의사를 밝혔고 국민의힘은 민주당 출신 김진표 국회 의장에 대한 사퇴 촉구 결의안을 제출했다.",
