        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 불과 5개월 전 이상민 장관은 행안부 경찰국 신설을 추진하면서 이와 정반대되는 말을 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.325
            },
            {
                "speaker_id": "1",
                "transcription": "정부 조직법을 근거로 경찰청에 대한 지휘 감독 권한이 있다고 한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 8.335,
                "end": 13.441
            },
            {
                "speaker_id": "1",
                "transcription": "직무 유기란 표현까지 사용해 경찰을 지휘할 필요가 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.451,
                "end": 18.271
            },
            {
                "speaker_id": "2",
                "transcription": "이러한 정부 조직법 규정에 따라서 행안부 장관이 치안 업무를 직접 수행하지는 않더라도 경찰청의 업무가 과연 제대로 돌아가고 있는지 수시로 확인하고 지휘 감독할 책임과 권한이 있는 것이고",
                "sound_type": [
                    2
                ],
                "start": 18.281,
                "end": 34.067
