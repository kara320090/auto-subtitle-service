        "term": [
            {
                "speaker_id": "1",
                "transcription": "6월 합의를 정부가 어겼기 때문에 굉장히 분노하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.615
            },
            {
                "speaker_id": "1",
                "transcription": "파업에 돌입하게 되면 이 법안이 반드시 통과될 때까지 총파업 이어갈 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 4.625,
                "end": 11.280
            },
            {
                "speaker_id": "2",
                "transcription": "안전운임제와 관련한 논의는 그간 지지부진했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.290,
                "end": 15.115
            },
            {
                "speaker_id": "2",
                "transcription": "지난 7월부터 석 달간 국회 민생경제안정특별위원회에서 안전운임제를 논의하는 회의는 단 한 차례에 그쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.125,
                "end": 24.098
            },
            {
                "speaker_id": "2",
                "transcription": "지난달 민생특위 활동이 종료됐지만 상임위인 국토교통위원회에서도 관련 논의는 이뤄지지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.108,
                "end": 31.574
            },
            {
                "speaker_id": "2",
                "transcription": "정부와 화물연대의 입장이 평행선을 그리고 있어 파업이 장기화될 수 있단 우려가 나오고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
