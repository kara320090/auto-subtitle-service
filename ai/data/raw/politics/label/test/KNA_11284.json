                    5
                ],
                "start": 5.435,
                "end": 23.596
            },
            {
                "speaker_id": "2",
                "transcription": "내가 보기에 한 표는 부로 보는게 맞고 한 표는 제가 볼 때는 또 무효로 봐야 되기 때문에",
                "sound_type": [
