        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 기관의 그 주변 상황이라든지 그 자치단체와의 협의를 사전에 하지 않고 일방적으로 정했다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.963
            },
            {
                "speaker_id": "2",
                "transcription": "아 미국이나 호주나 다른 나라가 그거 몰라서 공항에다 하고 군부대를 이용하고 섬을 이용하겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 8.973,
                "end": 15.162
            },
            {
                "speaker_id": "2",
                "transcription": "지금이라도 다시 생각해 보고.",
                "sound_type": [
                    2
                ],
                "start": 15.172,
                "end": 17.016
            },
            {
                "speaker_id": "3",
                "transcription": "복지 차관은 종합적으로 고려한 결정이었다면서 주민들에게 사과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.026,
                "end": 21.782
            },
            {
                "speaker_id": "4",
                "transcription": "특히 지역에 상당한 불만과 혼선을 초래했다라는 점에 대해서는 사과를 드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.792,
                "end": 27.648
            },
            {
                "speaker_id": "4",
                "transcription": "지역 주민들과도 충분히 소통하고 양해를 구하는 것이 순서였을 거라고 저도 생각을 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.658,
                "end": 34.334
            }
        ]
    },
    "summary": "복지 차관은 종합적으로 고려한 결정이었다면서도 지역 주민과 충분한 협의를 거치지 않은 점을 사과했다.",
