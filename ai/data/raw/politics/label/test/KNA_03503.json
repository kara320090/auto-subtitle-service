                    2
                ],
                "start": 0.000,
                "end": 9.466
            },
            {
                "speaker_id": "1",
                "transcription": "여야는 민주당이 제안한 국회의원 전수조사도 합의하지 못했습니다.",
                "sound_type": [
                    2,
