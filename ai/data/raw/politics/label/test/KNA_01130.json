        "term": [
            {
                "speaker_id": "1",
                "transcription": "권 원내 대표는 그러면서 대통령실에도 이런 의견을 전달했다고 덧붙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.348
            },
            {
                "speaker_id": "1",
                "transcription": "정 후보자의 임명 여부에 대해 윤석열 대통령은 오늘 아침 출근길에 명확한 입장을 밝히지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.358,
                "end": 12.311
            },
            {
                "speaker_id": "2",
                "transcription": "정호영 장관 후보자 임명 여부 결정하셨습니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.321,
                "end": 16.293
            },
            {
                "speaker_id": "3",
                "transcription": "글쎄 뭐 시간이 조금 더 필요한 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.303,
                "end": 19.597
            },
            {
                "speaker_id": "1",
                "transcription": "여야로부터 동시에 사퇴 압박을 받고 있는 정 후보자는 외부 연락을 끊고 막판 고심에 들어간 것으로 전해졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.607,
                "end": 28.125
            },
            {
                "speaker_id": "1",
                "transcription": "이르면 오늘이나 내일쯤 정 후보자가 자진 사퇴 형식으로 거취를 표명할 것이라는 전망이 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 28.125,
                "end": 34.753
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 한승연입니다.",
                "sound_type": [
                    2
                ],
                "start": 34.763,
                "end": 37.574
            },
            {
                "speaker_id": "4",
                "transcription": "오늘 오전 경기도 이천시의 한 물류 창고에서 불이 나 소방 당국이 아직까지 진화 작업을 벌이고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.584,
                "end": 44.844
            }
        ]
    },
    "summary": "정 후보자의 임명 여부에 대해 윤석열 대통령은 명확한 입장을 밝히지 않았고 오늘이나 내일쯤 자진 사퇴 형식으로 표명할 것이라는 전망이 나온다.",
