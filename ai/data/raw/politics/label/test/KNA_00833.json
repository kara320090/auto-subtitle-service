        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당이 추진 중인 검찰 수사권 폐지 법안 입법을 즉각 중단하라고 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.544
            },
            {
                "speaker_id": "1",
                "transcription": "사법부조차 반대하는 위헌적인 법안이라며 반대 수위를 한층 높였습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.554,
                "end": 10.924
            },
            {
                "speaker_id": "1",
                "transcription": "인수위 정무사법 행정분과 이용무 의원은 민주당 정권의 입법 폭주 행태는 이사를 앞두고 대들보를 훼손하는 것이라며 국정 운영을 방해하는 행위라고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.934,
                "end": 23.065
            },
            {
                "speaker_id": "1",
                "transcription": "또 의석수가 많다고 70년 넘게 유지된 형사 사법 체계를 무너트리는 건 민주주의에 대한 위협이라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.075,
                "end": 31.031
            },
            {
                "speaker_id": "1",
                "transcription": "다만 법안이 처리될 경우 인수위나 당선인 차원의 대응 방향을 묻는 질문에는 즉답을 피했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.041,
                "end": 38.115
            },
            {
                "speaker_id": "2",
                "transcription": "자녀 편입 특례 의혹을 받는 정호영 후보자와 관련해서도 당선인 측이 추가 설명을 내놨다고요.",
                "sound_type": [
                    2
                ],
                "start": 38.125,
                "end": 45.011
            }
        ]
    },
