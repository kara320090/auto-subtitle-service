        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 이재명 대표 수사를 두고도 정치 탄압이다 범죄 수사다 공방이 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.914
            },
            {
                "speaker_id": "2",
                "transcription": "사정 정국을 조성을 하고 정치 탄압을 감행하고 있는 것처럼 보이기 때문에",
                "sound_type": [
                    2
                ],
                "start": 5.924,
                "end": 12.985
            },
            {
                "speaker_id": "3",
                "transcription": "위원님도 검사장을 지내셨지만 사정 정국을 만 만들지는 않는다는 점은 누구보다 잘 아실 거로 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 12.995,
                "end": 18.602
            },
            {
                "speaker_id": "2",
                "transcription": "내가 검찰 출신인데 그런 거 같습니다.",
                "sound_type": [
