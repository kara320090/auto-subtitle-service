        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래야 안정적으로 우리가 가는 것이지",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.115
            },
            {
                "speaker_id": "2",
                "transcription": "황 대표는 통합의 과정이라며 즉답을 내놓지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.125,
                "end": 9.040
            },
            {
                "speaker_id": "2",
                "transcription": "이런 가운데 정계 복귀 의사를 밝힌 안철수 전 의원은 정치 개혁을 위해 세대 교체를 하자고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.050,
                "end": 17.565
            },
            {
                "speaker_id": "3",
                "transcription": "새 술을 새 부대에 담아야 할 때가 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.575,
                "end": 21.054
            },
            {
                "speaker_id": "3",
                "transcription": "저도 이런 담대한 변화의 밀알이 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.064,
                "end": 25.866
            },
            {
                "speaker_id": "1",
                "transcription": "안 전 의원은 설 연휴 전 귀국할 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
