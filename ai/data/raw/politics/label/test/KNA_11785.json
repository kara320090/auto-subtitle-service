        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 흩어진 쪽은 보수정당 하지만 이들 사이엔 깊은 탄핵의 강이 흐릅니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 5.403
            },
            {
                "speaker_id": "2",
                "transcription": "탄핵의 강을 건너지 않고는 보수가 제대로 화합할 수도 통합할 수도 없다는 점을",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.413,
                "end": 13.946
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 남은 시간 통합 시계는 언제든 빨라질 수 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.956,
                "end": 18.504
            },
            {
                "speaker_id": "3",
                "transcription": "황교안 대표가 승부를 걸 수도 있다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.514,
                "end": 20.914
            },
            {
                "speaker_id": "3",
                "transcription": "극적으로 이러한 그 통합과 연대를 할 수 있는 가능성은 언제든지 남아있는 거라고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.924,
                "end": 27.394
            },
            {
                "speaker_id": "1",
                "transcription": "매 총선 등장하는 정권 심판론은 민주당의 고민입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.404,
                "end": 32.180
            },
            {
                "speaker_id": "1",
                "transcription": "경제와 남북관계 모두 교착 상태에서 집권 여당 어떤 전략, 인물로 중도층을 사로잡을지가 관건입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 32.190,
                "end": 40.642
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
