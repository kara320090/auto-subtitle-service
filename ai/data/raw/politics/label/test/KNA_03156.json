        "term": [
            {
                "speaker_id": "1",
                "transcription": "가덕도 신공항 특별법을 2월 임시 국회에서는 반드시 처리하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.630
            },
            {
                "speaker_id": "1",
                "transcription": "야당도 동참해 주기 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 4.640,
                "end": 6.706
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 힘이 협조하지 않는다면 단독 처리도 불사한다는 입장입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.716,
                "end": 11.195
            },
            {
                "speaker_id": "2",
                "transcription": "부산에서 국민의 힘 지지세가 주춤하는 것 같은 틈을 타서 지역 숙원 사업인 신공항을 밀어붙여 표심을 모으려는 전략입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.205,
                "end": 20.125
            },
            {
                "speaker_id": "2",
                "transcription": "반면 국민의 힘은 여전히 속내가 복잡합니다.",
                "sound_type": [
                    2
                ],
                "start": 20.135,
                "end": 23.604
            },
            {
                "speaker_id": "2",
                "transcription": "일단 당지도부는 민주당이 가덕도 신공항을 선거용으로 활용한다고 판단하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.614,
                "end": 29.829
            }
        ]
    },
    "summary": "더불어민주당은 부산에서 국민의 힘 지지세가 주춤하는 것 같은 틈을 타서 지역 숙원 사업인 신공항을 밀어붙여 표심을 모으려는 전략입니다.",
