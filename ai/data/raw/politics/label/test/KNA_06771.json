        "term": [
            {
                "speaker_id": "1",
                "transcription": "이듬해 후보자의 큰딸은 서울 사당동의 5억대 아파트를 샀는데 부모인 후보자 부부가 1억 8000만 원을 빌려줬습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.937
            },
            {
                "speaker_id": "1",
                "transcription": "관사 거주로 받게 된 전세 보증금 일부로 딸의 아파트 매입을 도와준 것 아니냐는 이른바 관사 테크 의혹입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.947,
                "end": 15.400
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보자 측은 군 업무의 특수성 때문에 관사에 살 수밖에 없었다며 주택 보유나 증여 과정에서 불법은 없었지만 국민 눈높이에 맞지 않았는지 되돌아보는 기회로 삼겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.410,
                "end": 28.411
            },
            {
                "speaker_id": "1",
                "transcription": "다른 후보자들은 과거 기고문이 논란이 되고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.421,
                "end": 32.179
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 복지부 장관 후보자는 여자가 남자보다 이력서 사진 포샵이 심하다 결혼과 출산은 애국이라는 글을 기고한 사실이 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.189,
                "end": 41.408
            }
        ]
    },
    "summary": "국방 장관 후보자는 관사 보증금 일부를 딸의 아파트 매입에 도와준 것 아니냐는 의혹에 불법은 없었다고 말했고 다른 후보자들은 과거 기고문이 논란이 됐다고 말했다.",
