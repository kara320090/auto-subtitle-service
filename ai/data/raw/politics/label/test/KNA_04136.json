        "term": [
            {
                "speaker_id": "1",
                "transcription": "집중 견제를 받는 이낙연 후보는 일일이 대응할 가치를 느끼지 않는다고 반응했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.161
            },
            {
                "speaker_id": "2",
                "transcription": "우리가 검증과 네거티브는 구분했으면 좋겠다고 생각을 합니다.",
                "sound_type": [
                    2
                ],
                "start": 5.171,
                "end": 11.928
            },
            {
                "speaker_id": "2",
                "transcription": "생각보다 참을성이 약하시네요.",
                "sound_type": [
                    2
                ],
                "start": 11.938,
                "end": 13.921
            },
            {
                "speaker_id": "2",
                "transcription": "지지율 조금 올라간다고 그걸 못 참고 그냥",
                "sound_type": [
                    2
                ],
                "start": 13.931,
                "end": 16.572
            },
            {
                "speaker_id": "1",
                "transcription": "정치 활동을 선언한 최재영 전 감사원장은 국민의힘 대외 협력 위원장인 권영세 의원과 만났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.582,
                "end": 23.485
            },
            {
                "speaker_id": "1",
                "transcription": "입당 문제가 주요하게 논의됐는데 권 의원은 가급적 빠른 입당을 권유했고 최 전 원장은 숙고해 결정하겠다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.495,
                "end": 31.703
            },
            {
                "speaker_id": "3",
                "transcription": "보다 나은 대한민국을 만들기 위해서",
                "sound_type": [
                    2
                ],
                "start": 31.713,
                "end": 35.035
            }
        ]
