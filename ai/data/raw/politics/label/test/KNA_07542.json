        "term": [
            {
                "speaker_id": "1",
                "transcription": "이복현 전 검사가 임명된 금감원장 자리나 강수진 전 검사가 거론되는 공정위원장직 모두 검사 출신이 임명됐던 전례가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.628
            },
            {
                "speaker_id": "1",
                "transcription": "박민식 국가 보훈처장도 검사 출신으론 첫 사례입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.638,
                "end": 14.033
            },
            {
                "speaker_id": "1",
                "transcription": "현재까지 윤석열 정부 장 차관급 일곱 명 대통령실 비서관급 이상 여섯 명이 검찰 출신으로 임명 또는 내정됐습니다.",
                "sound_type": [
                    2
