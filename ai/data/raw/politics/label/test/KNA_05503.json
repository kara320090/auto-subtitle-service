        "term": [
            {
                "speaker_id": "1",
                "transcription": "재개된 회의에서 여야 의원들은 찬반 토론을 이어가며 팽팽한 신경전을 펼쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.420
            },
            {
                "speaker_id": "2",
                "transcription": "어차피 이게 여야 간에 지금 합의점을 찾을 수가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.430,
                "end": 9.032
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 그러면은 양보해가지고 대안 제시했는데도 지금 의무 격리에 대해서는 요지부동이거든요.",
                "sound_type": [
                    2
                ],
                "start": 9.042,
                "end": 15.903
            },
            {
                "speaker_id": "3",
                "transcription": "날치기하면서 이 법안을 진행시키고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.913,
                "end": 19.486
            },
            {
                "speaker_id": "3",
                "transcription": "심지어 거짓말까지 동원하면서 일방적으로",
                "sound_type": [
                    2
                ],
                "start": 19.496,
                "end": 23.898
            },
            {
                "speaker_id": "1",
                "transcription": "개정안 처리 후 국민의힘은 개정안이 쌀의 공급 과잉 구조를 심화시킬 거다 반면 민주당은 농민들의 요구가 있는 만큼 법제화가 필요하다는 내용의 회견을 여는 등 여론전을 이어갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.908,
                "end": 35.869
            }
        ]
    },
    "summary": "국민의힘은 개정안이 쌀의 공급 과잉 구조를 심화시킬 거라고 보고 민주당은 농민들의 요구가 있는 만큼 법제화가 필요하다는 내용의 팽팽한 신경전을 벌였다.",
