        "term": [
            {
                "speaker_id": "1",
                "transcription": "MB 정부 때 장관으로 강력 추진했던 자사고와 일제고사에 대한 야당의 비판과 우려가 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.603
            },
            {
                "speaker_id": "2",
                "transcription": "자립형사립고가 교육격차를 해소하는 데 도움이 됐다고 보시는 겁니까 아니면 교육격차를 악화시키는 데 더 영향을 미쳤다고 보시는 겁니까?",
                "sound_type": [
                    2
                ],
                "start": 7.613,
                "end": 19.249
            },
            {
                "speaker_id": "3",
                "transcription": "아이들을 줄세우기 교육 또 경쟁교육으로 내몰았던 장본인이라고 평가하기 때문이라고 저는 보고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.259,
                "end": 28.455
            },
            {
                "speaker_id": "3",
                "transcription": "그 당시의 그 경쟁교육에 대해서 사과할 그런 의사 없습니까?",
                "sound_type": [
                    2
                ],
                "start": 28.465,
                "end": 34.177
            },
            {
                "speaker_id": "4",
                "transcription": "저는 다 옳았다고는 생각하지 않습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.187,
                "end": 36.186
            },
            {
                "speaker_id": "4",
                "transcription": "송구스럽게 생각합니다.",
