                "start": 0.000,
                "end": 7.540
            },
            {
                "speaker_id": "1",
                "transcription": "이 가운데 2년 연속 실적이 미흡한 한국 건강 증진 개발원장 등 네 개 기관장에 대한 해임 건의도 의결됐습니다.",
                "sound_type": [
