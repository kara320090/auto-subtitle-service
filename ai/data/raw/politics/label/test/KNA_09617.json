            },
            {
                "speaker_id": "1",
                "transcription": "이해관계가 충돌되는 이 녹십자 주식을 가지고 있는",
                "sound_type": [
                    2
                ],
                "start": 3.738,
                "end": 7.395
            },
            {
                "speaker_id": "2",
                "transcription": "큰 기술을 부하 직원하고 개발해서 공로주로 전부 받은 겁니다.",
