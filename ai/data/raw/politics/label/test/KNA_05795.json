        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난달 18일 노웅래 더불어민주당 의원의 자택에 들이닥친 검사와 수사관.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.967
            },
            {
                "speaker_id": "1",
                "transcription": "무거워 보이는 종이 상자 여러 개를 들고 나와 차량에 싣습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.977,
                "end": 10.214
            },
            {
                "speaker_id": "1",
                "transcription": "가방 안에 들어 있는 게 다 현금인가요?",
                "sound_type": [
                    2
                ],
                "start": 10.224,
                "end": 12.340
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 물품 압수하셨는지요?",
                "sound_type": [
                    2
                ],
                "start": 12.340,
                "end": 15.166
            },
            {
                "speaker_id": "1",
                "transcription": "이틀 전 압수수색 때 발견한 3억 원가량의 현금 다발을 다시 압수 영장을 발부받아 확보한 건데 검찰은 이 안에 사업가 박모 씨로부터 사업 청탁과 함께 건네받은 불법 정치 자금 6000만 원이 섞여있다고 의심하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.176,
                "end": 31.192
            },
            {
                "speaker_id": "1",
                "transcription": "약 3주간 자금 흐름을 좇던 검찰은 오늘 노 의원을 피의자 신분으로 소환했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.202,
                "end": 36.369
            }
        ]
    },
    "summary": "지난달 18일 노웅래 더불어민주당 의원의 자택에 들이닥친 검사와 수사관이 3억 원가량의 현금을 압수했다.",
