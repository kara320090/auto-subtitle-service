        "term": [
            {
                "speaker_id": "1",
                "transcription": "이곳에 케이블카를 설치해 산악 관광 산업으로 발전시키자는 요구가 강원도에서 꾸준히 제기돼 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.933
            },
            {
                "speaker_id": "1",
                "transcription": "가장 큰 걸림돌은 환경부의 환경 영향 평가였습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.943,
                "end": 11.270
            },
            {
                "speaker_id": "1",
                "transcription": "환경 협의 부동의에 보완 재보완을 거쳐 행정 심판까지 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.280,
                "end": 16.994
            },
            {
                "speaker_id": "1",
                "transcription": "결국 환경 평가 협의를 시작한 지 8년 만에 조건부 동의 결정이 내려졌습니다.",
                "sound_type": [
                    2
