        "term": [
            {
                "speaker_id": "1",
                "transcription": "육성으로는 저에게 소신껏 해라.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.598
            },
            {
                "speaker_id": "1",
                "transcription": "그게 아버님께서 저에게 남겨주신 음 마지막 잎새이셨습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.608,
                "end": 12.690
            },
            {
                "speaker_id": "2",
                "transcription": "빈소엔 국민의힘 이준석 대표와 소속 의원들이 잇따라 조문했고 잠재적 대선 경쟁자인 윤석열 전 검찰총장도 찾아와 최 전 원장을 위로했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.700,
                "end": 23.831
            },
            {
                "speaker_id": "3",
                "transcription": "특별한 배경이라기보다 뭐 당연히 와야 될 자리라 아 느껴서 왔고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.841,
                "end": 29.383
            },
            {
                "speaker_id": "3",
                "transcription": "뭐 정치를 하시고 안 하시고와 관계없이",
                "sound_type": [
                    2,
                    4
                ],
                "start": 29.393,
                "end": 33.068
            },
            {
                "speaker_id": "2",
                "transcription": "윤 전 총장은 앞서 스타트업 청년 창업가들을 만나 정치가 자유로운 기업 활동을 방해해선 안 된다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 33.078,
                "end": 41.283
            },
            {
