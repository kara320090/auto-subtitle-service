        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 당 소속 의원 전원에 대한 부동산 투기 전수 조사를 감사원에 의뢰했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.674
            },
            {
                "speaker_id": "1",
                "transcription": "감사원법상 국회의원은 감사원의 직무 감찰 대상에서 제외되는 만큼 논란이 예상되는데 국민의힘은 일단 감사원 의견에 따라 다른 기관 조사도 검토하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.684,
                "end": 19.449
            },
            {
                "speaker_id": "2",
                "transcription": "어떤 기관을 선정하고 조사 방법을 선정함에 있어서 어 어떠한 주저함도 없다.",
                "sound_type": [
                    2
                ],
                "start": 19.459,
                "end": 25.299
            },
            {
                "speaker_id": "2",
                "transcription": "당당하게 가장 철저하게 조사받을 수 있는 방법과 기관을 택할 것이다.",
