        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 2017년 열린 a작가의 개인전 관련 sns 게시물.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.552
            },
            {
                "speaker_id": "1",
                "transcription": "작품 옆에 판매 완료 표시인 빨간색 스티커가 붙어 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.562,
                "end": 9.569
            },
            {
                "speaker_id": "2",
                "transcription": "금액을 지불하고 완료가 됐을 때 빨간 딱지를 붙이는 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.579,
                "end": 12.628
            },
            {
                "speaker_id": "2",
                "transcription": "판매는 많이 됐어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.638,
                "end": 14.149
            },
            {
                "speaker_id": "2",
                "transcription": "작품이 그 당시에 인기가 많았고.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.159,
                "end": 16.753
            },
            {
                "speaker_id": "1",
                "transcription": "영리 목적으로 작품이 판매됐다면 사업 소득 신고 의무가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.763,
                "end": 22.300
            },
            {
                "speaker_id": "3",
                "transcription": "화가로서 자기가 계속적 반복적으로 그림을 판매했을 때는 자기의 사업 소득으로 보기 때문에 종합 소득세 신고 의무가 발생하고 거기에 따른 세금도 납부를 하셔야 됩니다.",
                "sound_type": [
                    2
