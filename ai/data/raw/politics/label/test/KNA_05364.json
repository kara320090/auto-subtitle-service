        "term": [
            {
                "speaker_id": "1",
                "transcription": "초등학교 인근에 한 교차로.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.606
            },
            {
                "speaker_id": "1",
                "transcription": "생소한 신호등 하나가 더 설치됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.616,
                "end": 4.409
            },
            {
                "speaker_id": "1",
                "transcription": "우회전 전용 신호등으로 빨간불이 들어오면 차는 보행자가 없어도 멈춰야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.419,
                "end": 10.454
            },
            {
                "speaker_id": "1",
                "transcription": "내년 1월 우회전 신호등 설치 관련 개정 도로교통법 시행을 앞두고 2달 간 서울과 대전 등 10개 시도 15곳에서 시범 운영되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.464,
                "end": 21.258
            },
            {
                "speaker_id": "1",
                "transcription": "이 우회전 신호등은 주 신호등의 보조 신호등 성격이 아니라 하나의 독립된 신호등이기 때문에 붉은 색 등이 들어왔을 때 운행을 하면 신호 위반에 해당합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.268,
                "end": 31.064
            }
        ]
    },
    "summary": "우회전 신호등은 주 신호등의 보조 신호등 성격이 아니라 하나의 독립된 신호등이기 때문에 붉은 색 등이 들어왔을 때 운행을 하면 신호 위반에 해당한다.",
