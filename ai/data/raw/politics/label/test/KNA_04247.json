        "term": [
            {
                "speaker_id": "1",
                "transcription": "의장대가 유해를 묘역으로 운구합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.160
            },
            {
                "speaker_id": "1",
                "transcription": "하관 뒤에는 카자흐스탄 대통령이 전해 온 현지 묘역의 흙이 뿌려집니다.",
                "sound_type": [
                    2
                ],
                "start": 3.170,
                "end": 8.426
            },
            {
                "speaker_id": "1",
                "transcription": "연해주로 이주한 지 100년 카자흐스탄에서 순국한 지 78년 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 8.436,
                "end": 14.961
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 대통령은 장군이 고향 흙에 흘린 눈물이 대한민국을 더 강하고 뜨거운 나라로 이끌어줄 것이라고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.971,
                "end": 23.441
            },
            {
                "speaker_id": "2",
                "transcription": "장군의 귀환은 어려운 시기 서로를 믿고 의지하며 위기극복에 함께하고 있는",
                "sound_type": [
                    2
                ],
                "start": 23.451,
                "end": 30.263
            }
        ]
    },
    "summary": "홍범도 장군의 안장식 상황을 전하고 있다.",
