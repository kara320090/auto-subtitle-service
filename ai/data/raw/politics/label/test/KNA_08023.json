        "term": [
            {
                "speaker_id": "1",
                "transcription": "그동안 윤석열 대통령은 출근길 기자들과 만나 현안에 대한 생각을 밝혀왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.375
            },
            {
                "speaker_id": "2",
                "transcription": "그 민생 물가를 어떻게든 에 최선을 다 해서 좀 잡기 위해서 노력하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.385,
                "end": 12.761
            },
            {
                "speaker_id": "1",
                "transcription": "때로는 정제되지 않은 발언이 나오면서 논란에 불을 지피기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.771,
                "end": 17.404
            },
            {
                "speaker_id": "2",
                "transcription": "전 정권에 그 지명된 장관 중에 이렇게 훌륭한 사람 봤어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.414,
                "end": 22.197
            },
            {
                "speaker_id": "1",
                "transcription": "메시지를 둘러싼 논란에도 이 같은 대통령의 약식 회견은 형식 자체만으로 소통의 새로운 장을 시작했단 평가를 받았습니다.",
