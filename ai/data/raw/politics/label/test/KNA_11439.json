                    5
                ],
                "start": 0.000,
                "end": 6.198
            },
            {
                "speaker_id": "1",
                "transcription": "기존 요금 수준에서 각각 5.3퍼센트 오른 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.208,
                "end": 10.322
            },
            {
                "speaker_id": "1",
                "transcription": "4인 가족 평균 사용량으로 보면 한 달 전기 요금은 약 3000원 가스 요금은 4400원가량 더 부담하게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 10.332,
                "end": 17.609
            },
            {
                "speaker_id": "1",
                "transcription": "2분기 요금 결정이 예년보다 1달 반 정도 늦었지만 인상분은 소급 적용되지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.619,
                "end": 23.894
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 경영난에 처한 에너지 공기업들의 정상화를 위해 요금 인상이 불가피하다며 국민들의 이해를 구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.904,
                "end": 32.065
