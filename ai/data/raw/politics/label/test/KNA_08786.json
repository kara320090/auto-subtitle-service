        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "거기에 대한 경비는 당신들한테 청구할 테니까 처리해 주시오.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.108
            },
            {
                "speaker_id": "1",
                "transcription": "나는 그만큼 절박하다.",
                "sound_type": [
                    2
                ],
                "start": 4.118,
                "end": 6.445
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 경찰은 CCTV에 운전자 얼굴이 찍혀도 신원을 특정하기 어렵다.",
                "sound_type": [
                    2
                ],
                "start": 6.455,
                "end": 12.549
            },
            {
                "speaker_id": "2",
                "transcription": "이 사건에만 집중할 수도 없다는 입장이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.559,
                "end": 15.976
            },
            {
                "speaker_id": "3",
                "transcription": "한 달 정도 됐을 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.986,
                "end": 17.910
            },
            {
                "speaker_id": "3",
                "transcription": "이런 차 있으면 좀 신고 좀 해 달라 하더라고.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.920,
                "end": 20.945
            },
            {
                "speaker_id": "3",
                "transcription": "경찰은 뭐 보이지도 않고.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.950,
                "end": 23.186
            },
            {
                "speaker_id": "2",
                "transcription": "취재가 시작되자 경찰과 지자체는 좀 더 적극적으로 움직이기 시작했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.196,
                "end": 28.565
            },
            {
                "speaker_id": "2",
                "transcription": "체납 고지서도 보류되는 분위기입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.575,
                "end": 30.697
            }
        ]
    },
    "summary": "취재가 시작되자 경찰과 지자체는 좀 더 적극적으로 움직이기 시작했고 체납 고지서도 보류되는 분위기다.",
