        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 이번엔 검찰 쪽 분위기 알아보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.305
            },
            {
                "speaker_id": "1",
                "transcription": "어제 평검사들에 이어서 오늘은 전국 검찰청의 부장 검사 대표들도 한 자리에 모여 회의를 회의를 열고 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 2.315,
                "end": 9.143
            },
            {
                "speaker_id": "1",
                "transcription": "취재 기자 연결합니다.",
                "sound_type": [
                    2
                ],
                "start": 9.153,
                "end": 10.547
            },
            {
                "speaker_id": "1",
                "transcription": "자 박진수 기자 부장 검사 회의 시작 됐습니다?",
                "sound_type": [
                    2
                ],
                "start": 10.557,
                "end": 13.976
            },
            {
                "speaker_id": "2",
                "transcription": "네 조금 전인 7시 쯤 전국 부장 검사 대표 회의가 시작됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.986,
                "end": 21.540
            },
            {
                "speaker_id": "2",
                "transcription": "수사 실무 책임자인 전국 검찰청 부장 검사 대표들이 자발적으로 한 자리에 모인 건 검찰 역사상 청음입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.550,
                "end": 29.477
            },
            {
                "speaker_id": "2",
                "transcription": "각 검찰청 대표 60여 명 정도가 참석할 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.487,
                "end": 33.898
            },
            {
                "speaker_id": "2",
                "transcription": "검찰 수사권 폐지의 문제점과 함께 정치적 중립성 확보 방안에 대해서도 폭넓게 논의될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 33.908,
                "end": 40.956
            },
            {
                "speaker_id": "2",
                "transcription": "회의는 오늘 밤 늦게까지 이어질 예정인데 내일 오전 입장문이 발표될 예정입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 40.966,
                "end": 46.639
            },
            {
                "speaker_id": "2",
                "transcription": "민주당의 법안 논의 속도에 맞춰 검찰은 바쁘게 움직이고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 46.649,
                "end": 51.179
            },
            {
                "speaker_id": "2",
                "transcription": "수도권에서 처음으로 의정부 지검장이 기자들을 만나 법안의 문제점을 지적했고 대검찰청 형사부도 기자 간담회를 열어 인권 보호가 어려워진다고 강조했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 51.189,
                "end": 62.896
            }
        ]
    },
    "summary": "어제 평검사들에 이어서 오늘은 전국 검찰청의 부장 검사 대표들도 한 자리에 모여 회의를 회의를 열었고 수도권에서 처음으로 의정부 지검장이 기자들을 만나 법안의 문제점을 지적했고 대검찰청 형사부도 기자 간담회를 열어 인권 보호가 어려워진다고 강조했다.",
