        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "투표를 하려면 반드시 마스크를 써야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.702
            },
            {
                "speaker_id": "1",
                "transcription": "투표소에 도착하면 발열체크를 하고 이상이 없는 경우 입장합니다.",
                "sound_type": [
                    2
                ],
                "start": 2.712,
                "end": 8.096
            },
            {
                "speaker_id": "1",
                "transcription": "손을 소독하고 비닐장갑을 착용한 뒤 투표를 할 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.106,
                "end": 12.332
            },
            {
                "speaker_id": "1",
                "transcription": "줄을 설 때도 일정 거리를 둬야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 12.342,
                "end": 15.590
            },
            {
                "speaker_id": "1",
                "transcription": "기표용구와 기표대 등은 수시로 소독합니다.",
                "sound_type": [
                    2
                ],
                "start": 15.600,
                "end": 19.516
            },
            {
                "speaker_id": "1",
                "transcription": "열이 나는 등 현장에서 건강 이상이 확인된 경우엔 별도로 마련된 임시 기표소로 이동해 투표하게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 19.526,
                "end": 27.148
            },
            {
                "speaker_id": "1",
                "transcription": "확진자 등 격리된 사람들도 투표권을 행사할 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.158,
                "end": 31.163
            },
            {
                "speaker_id": "1",
                "transcription": "확진자는 거소 투표와 생활치료센터에 마련된 사전 투표소에서 투표를 할 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.173,
                "end": 37.448
            },
            {
                "speaker_id": "1",
                "transcription": "증상이 없는 자가격리자가 안전하게 투표할 수 있는 방법도 검토 중입니다.",
                "sound_type": [
                    2
                ],
                "start": 37.458,
                "end": 42.680
            },
            {
                "speaker_id": "1",
                "transcription": "아울러 후보자와 선거 사무관계자도 선거 운동기간 동안 대면 접촉을 최소화해달라고 정부는 당부했습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.690,
                "end": 50.603
            },
            {
                "speaker_id": "1",
                "transcription": "한편 어제부터 시작된 재외국민투표는 코로나19 확산에 따라 일부 지역에서는 중단됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 50.613,
                "end": 57.057
            }
        ]
    },
    "summary": "여성이 투표소에서의 코로나19 방역수칙을 설명했다.",
