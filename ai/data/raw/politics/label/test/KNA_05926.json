        "term": [
            {
                "speaker_id": "1",
                "transcription": "백령도에서 포 훈련도 하지 못하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.014
            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 대통령실 용산 이전으로 군의 사기를 꺾을 때부터 예견된 일이라며 책임을 대통령실로 돌렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.024,
                "end": 11.452
            },
            {
                "speaker_id": "2",
                "transcription": "윤 대통령의 연이은 강경 발언을 무책임한 말 폭탄이라고 지칭하며 안보 위기를 해소할 실질적 대책을 마련하라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.462,
                "end": 20.146
            },
            {
                "speaker_id": "3",
                "transcription": "연일 확전 각오부터 원점 타격까지 강경 일변도의 발언으로 대통령이 오히려 국민 불안을 부추기고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.156,
                "end": 29.362
            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 대통령이 안보 무능을 국민에게 사과하고 관계자를 문책하라고도 요구했습니다.",
                "sound_type": [
