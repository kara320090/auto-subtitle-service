        "term": [
            {
                "speaker_id": "1",
                "transcription": "김기현 의원이 이제 김장 끝이다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.159
            },
            {
                "speaker_id": "1",
                "transcription": "김장 연대 없다 이런 식으로 하니까 제가 장제원 의원이라면 인간적으로 좀 섭섭하기는 할 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.169,
                "end": 7.658
            },
            {
                "speaker_id": "2",
                "transcription": "김장 연대의 균열을 부추기는 듯한 말로 해석됐는데 곧바로 친윤계 의원들의 집중포화가 쏟아졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.668,
                "end": 15.386
            },
            {
                "speaker_id": "2",
                "transcription": "사적인 통화를 그것도 허위사실 유포라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.396,
                "end": 19.253
            },
            {
                "speaker_id": "3",
                "transcription": "개인적인 통화였는데 그걸 마치 장제원 의원이 이번에는 안철수 쪽으로 줄을 대는 것처럼 이렇게 포장을 해서 나간 게 아주 안타까운 일이죠.",
                "sound_type": [
