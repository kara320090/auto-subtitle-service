        "term": [
            {
                "speaker_id": "1",
                "transcription": "제 임기 중에 인허가를 했던 사안은 아닌 걸로 기억이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.029
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 해당 사업 인허가는 오 시장 임기 중인 2009년에 났습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.039,
                "end": 8.729
            },
            {
                "speaker_id": "2",
                "transcription": "이에 일부 시민 단체들은 오 시장이 고의로 허위 사실을 유포했다며 공직 선거법 위반 등의 혐의로 경찰에 고발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.739,
                "end": 17.019
            },
            {
                "speaker_id": "2",
                "transcription": "고발 넉 달여 만에 서울 경찰청 반부패 공공 범죄 수사대가 서울 시청을 압수 수색했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.029,
                "end": 23.650
            },
            {
                "speaker_id": "3",
                "transcription": "압수 수색 오늘 끝난 건가요.",
                "sound_type": [
                    2
                ],
                "start": 23.660,
                "end": 25.458
            }
        ]
    },
