                ],
                "start": 0.000,
                "end": 6.381
            },
            {
                "speaker_id": "1",
                "transcription": "대통령실 관계자는 시진핑 주석과는 회담장에서 자연스럽게 만날 것이다.",
                "sound_type": [
                    2
                ],
