                "end": 11.609
            },
            {
                "speaker_id": "1",
                "transcription": "그 기회로 소통이 이뤄지지 않을까라며 사실상 의제 조율도 안 된 상태임을 내비쳤습니다.",
                "sound_type": [
                    2
