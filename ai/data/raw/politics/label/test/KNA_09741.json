        "term": [
            {
                "speaker_id": "1",
                "transcription": "밥 1공기 다 비우기 이런 것들에 대해서도 우리가 논의를 한 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.705
            },
            {
                "speaker_id": "1",
                "transcription": "여성분들 같은 경우 다이어트를 위해서도 밥을 잘 먹지 않는 분들이 많거든요.",
                "sound_type": [
                    2
                ],
                "start": 3.715,
                "end": 8.536
            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 황당한 구상에 입을 다물지 못하겠다며 사과를 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.546,
                "end": 14.020
            },
            {
                "speaker_id": "3",
                "transcription": "밥 1공기 다 먹으면 해결될 문제를 가지고 농민들이 절규하고 있다는 말입니까?",
                "sound_type": [
                    2
                ],
                "start": 14.030,
                "end": 20.376
            },
            {
                "speaker_id": "3",
                "transcription": "엉터리 해법으로 국민을 기만하는 것에도 정도가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.386,
                "end": 24.871
            },
            {
                "speaker_id": "2",
                "transcription": "여당 내에서도 갈수록 태산 아예 밥공기 그릇을 2배로 만들라 하지 그랬냐는 비판이 이어졌습니다.",
