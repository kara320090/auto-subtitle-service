        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번 대통령 선거는 여성을 공격하고 갈라치기하고 혐오하는 대선이 되는 거 이거 역주행 아닙니까 여러분?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.356
            },
            {
                "speaker_id": "2",
                "transcription": "심 후보는 청년의 미래 기회를 빼앗은 건 거대 양당의 독점 정치라고 했습니다.",
                "sound_type": [
                    2,
