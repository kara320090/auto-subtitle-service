        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "5박 7일 해외 순방의 마지막 일정으로 윤석열 대통령이 쥐스탱 트뤼도 캐나다 총리와 만났습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.642
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 캐나다가 한국 전쟁 당시 미국 영국에 이은 3대 참전국이자 전통적 우방이라며 친근감을 나타냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.652,
                "end": 15.154
            },
            {
                "speaker_id": "2",
                "transcription": "글로벌 어젠다에 대해서도 함께 협력하고 발전 방향을 모색할 수 있는 정말 친구 같은 나라라고 생각합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.164,
                "end": 26.431
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.441,
                "end": 34.968
            },
            {
                "speaker_id": "1",
                "transcription": "회담의 우선 의제는 광물 자원 협력이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.978,
                "end": 38.360
            },
            {
                "speaker_id": "1",
                "transcription": "캐나다는 우리나라의 두 번째 광물 공급국입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.370,
                "end": 41.947
            },
            {
                "speaker_id": "1",
                "transcription": "자동차 배터리 핵심 재료인 니켈 같은 광물이 풍부한 캐나다와 배터리 제조 기술이 뛰어난 한국이 힘을 합쳐 공동 이익을 키워나가기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.957,
                "end": 51.344
            },
            {
                "speaker_id": "2",
                "transcription": "팬데믹 이후 안정적인 공급망 확보를 위해 양국 정부와 기업 간 광물 자원 분야의 협력 체계를 굳건하게 구축해 나갈 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 51.354,
                "end": 64.464
            },
            {
                "speaker_id": "1",
                "transcription": "또 인공 지능 같은 미래 산업 분야에서도 협력을 다짐했습니다.",
                "sound_type": [
                    2
                ],
                "start": 64.474,
                "end": 69.069
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 69.079,
                "end": 76.603
            },
            {
                "speaker_id": "1",
                "transcription": "한 캐나다 정상 회담을 끝으로 윤 대통령은 5박 7일 순방 일정을 모두 마무리하고 귀국길에 올랐습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 76.613,
                "end": 83.678
            },
            {
                "speaker_id": "1",
                "transcription": "자유에 기반한 가치 연대를 강조했고 공급망 강화 등의 성과를 얻었다는 게 대통령실 평가입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 83.688,
                "end": 90.791
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 대통령실이 예고했던 한미 정상 회담은 결국 열리지 않았고 조문 논란부터 비속어 논란까지 잡음도 적지 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.801,
                "end": 99.069
            },
            {
                "speaker_id": "1",
                "transcription": "이를 수습하는 게 윤 대통령의 우선 과제가 될 걸로 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.079,
                "end": 102.922
            },
            {
                "speaker_id": "1",
                "transcription": "캐나다 오타와에서 KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 102.932,
                "end": 106.072
            }
        ]
    },
    "summary": "5박 7일 해외 순방의 마지막 일정으로 윤석열 대통령이 쥐스탱 트뤼도 캐나다 총리와 만나 협력 체계를 굳건하게 구축해 나갈 것을 다짐했으나 대통령실이 예고했던 한미 정상 회담은 결국 열리지 않았고 조문 논란부터 비속어 논란까지 잡음도 적지 않았습니다.",
