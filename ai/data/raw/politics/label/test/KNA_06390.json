        "term": [
            {
                "speaker_id": "1",
                "transcription": "이걸 표준화 작업이라 하는데 이 작업을 도맡아 할 건강 보험 심사 평가원 같은 기관과 예산이 필요하다는 게 수의사들 설명입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.726
            },
            {
                "speaker_id": "2",
                "transcription": "동물의 경우에는 약 한 150억 정도의 비용이 들어야 되고요.",
                "sound_type": [
                    2
                ],
                "start": 8.736,
                "end": 12.957
            },
            {
                "speaker_id": "2",
                "transcription": "또 하더라도 금방 올해 안에 될 순 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.967,
                "end": 15.971
            },
            {
                "speaker_id": "2",
                "transcription": "최소한 5년 정도의 기간을 둬 가지고 표준화 작업을 해야 되고",
                "sound_type": [
                    2
                ],
                "start": 15.981,
                "end": 21.031
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 대통령도 후보 당시 표준 수가제 도입을 약속했었지만 현실화하진 못했습니다.",
                "sound_type": [
