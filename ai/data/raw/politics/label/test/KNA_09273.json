                    5
                ],
                "start": 5.166,
                "end": 13.299
            },
            {
                "speaker_id": "2",
                "transcription": "민주당의 그 감액 중심의 수정안을 만드는 작업에 박차를 가해왔고 지금은 거의 이제 완성 단계에 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.309,
                "end": 24.982
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘은 할 테면 해보라는 입장입니다.",
