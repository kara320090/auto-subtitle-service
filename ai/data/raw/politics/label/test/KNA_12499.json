        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "평년도 1학기 등록금 일부 반환을 직접 선언하라.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.028
            },
            {
                "speaker_id": "2",
                "transcription": "코로나19로 1학기 내내 원격 수업을 받은 대학생들이 대학 측을 상대로 등록금 반환 운동을 펼치고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.038,
                "end": 13.360
            },
            {
                "speaker_id": "3",
                "transcription": "온라인 강의의 기술적 오류 및 수업의 질 하향 평준화가 가장 큰 문제라고 외치고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.370,
                "end": 18.852
            },
            {
                "speaker_id": "3",
                "transcription": "실험 실습 과목도 예외는 아닙니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.862,
                "end": 21.717
            },
            {
                "speaker_id": "2",
                "transcription": "전국 40여 개 대학 학생 3000여 명은 국가와 대학을 상대로 등록금 반환 집단 소송까지 냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.717,
                "end": 28.442
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 대책을 내놨습니",
                "sound_type": [
                    2
                ],
                "start": 28.452,
                "end": 30.720
            },
            {
                "speaker_id": "2",
                "transcription": "국회에서 통과된 3차 추경 예산 1000억 원을 대학의 온라인 교육 강화 지원금으로 쓰겠다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 30.730,
                "end": 37.179
            },
            {
                "speaker_id": "2",
                "transcription": "국회는 각 대학에 특별 장학금 지원 실적과 관련 노력을 고려하라는 부대 의견을 교육부에 냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.189,
                "end": 44.320
            },
            {
                "speaker_id": "2",
                "transcription": "특별 장학금 등을 통해 등록금을 일부 돌려주는 대학에 우선적으로 지원을 해주라는 의미입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 44.320,
                "end": 50.925
            },
            {
                "speaker_id": "2",
                "transcription": "그러나 상당수 대학들은 지원 액수가 기대치의 3분의 1 수준이라며 실망감을 나타냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.935,
                "end": 57.389
            },
            {
                "speaker_id": "2",
                "transcription": "1학기 등록금의 3분의 1 약 100만 원 수준의 반환을 기대했던 대학생들도 실망이 큽니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.399,
                "end": 64.254
            },
            {
                "speaker_id": "4",
                "transcription": "1인당 뭐 10퍼센트 해서 40만 원 정도로 산정을 했다고 했는데 결국에 통과된 금액은 한 1000억 원 정도고 이게 대학생들 수로 나눴을 때 인당 5만 원 정도의 수준이더라고요.",
                "sound_type": [
                    2
                ],
                "start": 64.264,
                "end": 75.175
            },
            {
                "speaker_id": "2",
                "transcription": "교육부는 대학 혁신 지원 사업비 명목으로 예산 1000억 원을 추가한 뒤 이달 중 구체적인 계획안을 내놓을 방침입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 75.185,
                "end": 83.164
            },
            {
                "speaker_id": "2",
                "transcription": "대학의 등록금 반환을 간접 지원하기 위해서입니다.",
                "sound_type": [
                    2
                ],
                "start": 83.174,
                "end": 86.703
            },
            {
                "speaker_id": "2",
                "transcription": "그러나 등록금을 얼마나 어떤 방식으로 돌려줄지는 각 대학의 사정에 따라 크게 달라질 것으로 보여 갈등은 당분간 계속될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 86.713,
                "end": 96.628
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 96.638,
                "end": 98.798
            }
        ]
    },
    "summary": "코로나19로 1학기 내내 원격 수업을 받은 대학생들이 대학 측을 상대로 등록금 반환 운동을 펼치고 전국 40여 개 대학 학생 3000여 명은 국가와 대학을 상대로 등록금 반환 집단 소송까지 낸 결과 정부는 국회에서 통과된 3차 추경 예산 1000억 원을 대학의 온라인 교육 강화 지원금으로 쓰겠다는 대책을 내놨다.",
