        "term": [
            {
                "speaker_id": "1",
                "transcription": "내각 인선 발표는 이번 주부터 순차적으로 이어질 것으로 보입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.176
            },
            {
                "speaker_id": "1",
                "transcription": "경제부총리로는 추경호 의원과 인수위원인 최상목 전 기재부 차관이 외교부 장관으로는 당선인이 미국에 파견한 한미정책협의대표단에 포함된 박진 조태용 국민의힘 의원이 거론됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.186,
                "end": 20.228
            },
            {
                "speaker_id": "1",
                "transcription": "당선인 측은 인사청문 일정을 감안해 15일 이전까지 인선 발표를 마무리할 예정입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.238,
                "end": 27.198
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 강나루입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.208,
                "end": 30.339
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 당선인의 대외 정책 조율 행보도 본격화되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.349,
                "end": 35.459
            },
            {
                "speaker_id": "2",
                "transcription": "당선인 측 대표단이 미국을 찾았습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.469,
                "end": 38.258
            },
            {
                "speaker_id": "2",
                "transcription": "북한의 ICBM 발사로 한반도 안보 상황이 엄중해지고 있다며 동맹 강화에 초점을 맞추겠다고 밝혔습니다.",
                "sound_type": [
                    2
