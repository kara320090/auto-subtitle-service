        "term": [
            {
                "speaker_id": "1",
                "transcription": "천화동인 1호 배당금 절반은 그분 것이다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.043
            },
            {
                "speaker_id": "1",
                "transcription": "대장동 수사가 한창이던 지난 해 10월 화천대유 대주주 @이름1 씨가 이렇게 말한 녹취록이 공개됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.053,
                "end": 11.226
            },
            {
                "speaker_id": "1",
                "transcription": "이때부터 그분의 실체를 규명하는 게 수사의 과제가 됐는데 검찰은 일단 이재명 대표는 아니라고 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.236,
                "end": 19.502
            },
            {
                "speaker_id": "2",
                "transcription": "세간에서 얘기하는 그 인물을 특정해서 하는 업무는 아니고 다른 사람을 지칭해서 하는 표현일 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.512,
                "end": 25.843
            },
            {
                "speaker_id": "2",
                "transcription": "근데 지금 정치인 그분을 얘기하는 부분은 아닙니다.",
                "sound_type": [
                    2
