        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "광주가 지역구인 새정치연합 임내현 의원이 오늘 기자 회견을 열어 정권 교체를 위해선 강력한 야당이 필요하다며 탈당을 선언했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.931
            },
            {
                "speaker_id": "1",
                "transcription": "임 의원은 안철수 신당과 함께 낡은 진보를 청산하고 중도 세력과 합리적 보수까지 외연을 넓혀 정권 교체 희망의 싹을 틔우겠다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.941,
                "end": 19.900
            },
            {
                "speaker_id": "1",
                "transcription": "이로써 탈당한 광주 지역 의원이 4명으로 늘어난 가운데 장병완 의원도 이번 주 내로 탈당 여부를 결정할 것으로 전해졌으며 권은희 의원도 탈당을 고심하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.910,
                "end": 31.501
            },
            {
                "speaker_id": "1",
                "transcription": "수도권 비주류 의원들에게 영향력이 큰 김한길 전 대표도 탈당을 고심하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.511,
                "end": 37.459
            },
            {
                "speaker_id": "1",
                "transcription": "김 전 대표는 아직 최종적으로 탈당 결심을 한 것은 아니지만 문재인 대표의 답을 기다리고 있다며 문 대표를 압박했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.469,
                "end": 46.317
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 대표는 탈당은 대의가 아니라며 정면 돌파 의지를 거듭 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.327,
                "end": 51.562
            },
            {
                "speaker_id": "1",
                "transcription": "탈당과 분열은 어떤 명분으로든 정당화될 수 없다고 비판하고 혁신을 지키고 통합을 이룰 수 있다면 대표직에는 아무 미련이 없다고도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.572,
                "end": 62.143
            },
            {
                "speaker_id": "1",
                "transcription": "특히 탈당한 의원들을 겨냥해 엊그제까지 개혁 대상이던 사람들이 개혁 주체인 양 행세하는 것을 호남 민심은 용납하지 않을 것이라며 어떤 쪽이 혁신이고 개혁인지 보여드리고 당당히 선택받겠다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.153,
                "end": 77.027
            },
            {
                "speaker_id": "1",
                "transcription": "안철수 의원은 오늘 자신의 조직 기반인 정책 네트워크 내일의 정기 총회를 열어 지역 조직 구축에 나설 방침입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 77.037,
                "end": 85.246
            },
            {
                "speaker_id": "1",
                "transcription": "안 의원은 당분간 지역 일정을 잡지 않고 신당의 이름을 정하기 위한 작업을 직접 챙기기로 하는 등 창당 실무 작업에 속도를 내고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 85.256,
                "end": 94.935
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
