        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "박근혜 전 대통령에 추가 구속 여부가 이르면 내일 결정됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.967
            },
            {
                "speaker_id": "1",
                "transcription": "서울 중앙 지법 형사 합의 22부는 내일 열리는 공판에서 검찰과 박 전 대통령 측의 입장을 최종적으로 확인한 뒤 영장 발부 여부를 결정할 예정입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.977,
                "end": 15.890
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 국정 농단 사건의 핵심이라는 점 등을 내세워 지난달 26일 재판부에 영장 발부를 요청했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.900,
                "end": 24.505
            },
            {
                "speaker_id": "1",
                "transcription": "또 박 전 대통령이 석방될 경우 남은 재판에 성실하게 출석할지 보장하기 어렵다고 주장하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.515,
                "end": 31.635
            },
            {
                "speaker_id": "1",
                "transcription": "반면 박 전 대통령 측은 발가락 부상과 허리 통증 등 건강 문제를 부각하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.645,
                "end": 38.259
            },
            {
                "speaker_id": "1",
                "transcription": "피의자 보호를 위해 1심 구속 기간을 6개월로 제한한 형사 소송법 취지도 강조하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.269,
                "end": 45.769
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 기소 시점부터 1심 선고 전까지 최대 6개월 동안 피고인을 구속할 수 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.779,
                "end": 52.231
            },
            {
                "speaker_id": "1",
                "transcription": "박 전 대통령은 지난 4월 17일 뇌물 수수 등 18개 혐의로 구속 기소 돼 오늘 16일에서 17일로 넘어가는 자정에 구속 기간이 만료됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.241,
                "end": 62.703
            },
            {
                "speaker_id": "1",
                "transcription": "재판부가 추가 구속 영장을 발부하지 않으면 박 전 대통령은 17일 0시 이후 석방돼 불구속 상태에서 재판을 받게 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.713,
                "end": 71.622
            },
            {
                "speaker_id": "1",
                "transcription": "공범으로 기소된 @이름1씨와 핵심 피고인 @이름2 전 청와대 수석, @이름3 전 청와대 비서관, @이름4 전 문화 체육 관광부 차관, @이름5 전 광고 감독 등은 구속이 연장된 상태입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 71.632,
                "end": 85.120
            },
            {
