        "term": [
            {
                "speaker_id": "1",
                "transcription": "문산, 개성 고속도로는 파주시 문산읍과 북한에 개성 구간을 잇는 도로로 2015년 추진됐다가 중단된 바 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.310
            },
            {
                "speaker_id": "1",
                "transcription": "이 도로가 건설되면 서울에서 평양까지 가는 도로망이 완성됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.320,
                "end": 11.472
            },
            {
                "speaker_id": "1",
                "transcription": "이를 위해서는 북한의 평양 고속도로를 현대화하는 데 대한 논의도 필요합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.482,
                "end": 16.885
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 대북제재가 계속되고 있는 상황을 감안해 이번 회담에서는 구체적인 조치가 논의 되지는 않을 것으로 보입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.895,
                "end": 24.416
            },
            {
                "speaker_id": "1",
                "transcription": "남북은 우선 공동 연구조사단을 꾸리고 북측지역 실태조사 일정 등을 합의할 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.426,
                "end": 30.762
            },
