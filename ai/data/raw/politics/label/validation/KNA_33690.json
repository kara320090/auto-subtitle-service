                    5
                ],
                "start": 0.000,
                "end": 8.847
            },
            {
                "speaker_id": "1",
                "transcription": "당초 오늘 본회의에서 통과시킬 예정이었던 메르스 관련 법안에 대해서도 논의를 중단하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.857,
                "end": 15.226
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 대표는 정치는 사라지고 대통령의 고집과 독선만 남았다며 단호히 맞서겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.236,
                "end": 22.633
            },
            {
                "speaker_id": "1",
                "transcription": "새정치 연합은 의원 총회를 열어 대응 방안을 논의했습니다.",
