        "term": [
            {
                "speaker_id": "1",
                "transcription": "답변을 준비한 김현숙 장관은 정작 국회에 출석하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.760
            },
            {
                "speaker_id": "1",
                "transcription": "출석 대상에 대한 여야 합의 실패를 이유로 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.771,
                "end": 9.360
            },
            {
                "speaker_id": "1",
                "transcription": "야당 의원들은 김 장관이 국회에 있으면서 회의장에는 불참했다며 찾아 나서기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.350,
                "end": 15.865
            },
            {
                "speaker_id": "2",
                "transcription": "아니 어떻게 하시려고 도망가요? 여가부 장관 어디 있어요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.875,
                "end": 18.974
            },
            {
                "speaker_id": "2",
                "transcription": "아니 국회에 어디 있어요? 갑시다. 어디 화장실로 도망가요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.984,
                "end": 22.956
            }
        ]
    },
    "summary": "김현숙 장관은 국회에 출석하지 않았고 야당 의원들은 국회에 있으면서 불참했다며 찾아 나섰다.",
