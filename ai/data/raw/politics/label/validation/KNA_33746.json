        "term": [
            {
                "speaker_id": "1",
                "transcription": "버스와 승용차 이용도 자연스럽게 줄어들 것으로 보고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.202
            },
            {
                "speaker_id": "2",
                "transcription": "현재 38퍼센트 되는데요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.212,
                "end": 6.928
            },
            {
                "speaker_id": "2",
                "transcription": "10개 노선이 완료되게 되면 45프로까지 향상되리라 봅니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.938,
                "end": 13.031
            },
            {
                "speaker_id": "2",
                "transcription": "평상시 한 4 50분 걸리던게 한 3 40분으로",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.041,
                "end": 18.445
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 10년 동안 투입되는 예산은 8조가 넘습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.455,
                "end": 22.206
            },
            {
                "speaker_id": "1",
                "transcription": "업체와 협약을 마친 신림선은 올 연말 공사에 착공합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.216,
                "end": 26.824
            },
            {
                "speaker_id": "1",
                "transcription": "위례선과 목동선 난곡선 등은 조만간 민간 사업자를 유치하기로 했습니다.",
