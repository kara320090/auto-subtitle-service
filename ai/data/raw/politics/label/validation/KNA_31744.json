        "term": [
            {
                "speaker_id": "1",
                "transcription": "세월호 특별법 처리를 둘러싼 여야 간 입장 차가 좁혀지지 않으면서 새누리당이 추진했던 오늘 국회 본 회의는 열리기 힘들 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.481
            },
            {
                "speaker_id": "1",
                "transcription": "정의화 국회 의장은 오늘 새누리당 소장파 의원들을 만난 자리에서 여야 합의 없이 본 회의를 개최하긴 어렵다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.491,
                "end": 18.449
            },
            {
                "speaker_id": "1",
                "transcription": "새누리당은 오늘 오후 의원 총회를 열어 본 회의 개최와 민생 법안 처리 방안 등 대응책을 논의할 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.459,
                "end": 26.399
            },
            {
                "speaker_id": "1",
                "transcription": "새누리당은 당초 오늘 오후에 본 회의를 열어 계류 중인 91개 법안을 처리하겠다며 의원 소집령을 내려놓은 상태입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.409,
                "end": 35.132
            },
            {
                "speaker_id": "1",
                "transcription": "새누리당은 다만 오늘 법안 처리를 하지 못하더라도 내일 운영 위원회를 열어 의사 일정을 논의한 뒤 국회 의장이 본 회의 날로 제시한 오는 26일에는 법안을 처리한다는 방침인 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.142,
                "end": 49.128
            },
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 정의화 의장이 국회 정상화를 위해 추진했던 의장단과 여야 지도부 회동은 새정치연합 박영선 원내 대표의 참석 여부가 불투명해지면서 무산됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 49.138,
                "end": 61.164
            },
