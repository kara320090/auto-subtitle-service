        "term": [
            {
                "speaker_id": "1",
                "transcription": "부하 여군과 술을 마시다 모텔로 데려가 성폭행을 한 혐의입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.483
            },
            {
                "speaker_id": "1",
                "transcription": "이후에는 자신의 사무실과 차량에서 수차례에 걸쳐 상습적으로 강제 추행한 혐의도 받고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.493,
                "end": 11.113
            },
            {
                "speaker_id": "1",
                "transcription": "이 사실은 피해 여군이 아는 사람에게 털어놓으면서 알려졌고 신고를 받은 군 헌병대가 가해 중령을 긴급 체포해 구속 수감했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.123,
                "end": 20.049
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 당사자는 성폭행 혐의를 강력히 부인하는 것으로 전해졌습니다.",
                "sound_type": [
                    2,
                    4
                ],
