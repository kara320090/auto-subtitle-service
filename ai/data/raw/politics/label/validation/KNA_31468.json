        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회의장이 단명으로 끝난 일이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.813
            },
            {
                "speaker_id": "1",
                "transcription": "지금도 그 소신에는 아무런 변동이 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.823,
                "end": 6.203
            },
            {
                "speaker_id": "2",
                "transcription": "정계 은퇴 후에도 사랑과 정치는 계산하면 안된다며 오직 국민만 바라볼 것을 주문하는 등 후배 정치인들에게 쓴소리를 아끼지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.213,
                "end": 16.340
            },
            {
                "speaker_id": "1",
                "transcription": "국민을 위해서 올바르게 하면 되지.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.350,
                "end": 18.541
            },
            {
                "speaker_id": "1",
                "transcription": "내가 이렇게 얘기하면 나한테 플러스가 되고 대통령한테 잘 보이고 이거 계산하는 친구들은 오래 못 간다고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.551,
                "end": 24.199
            },
            {
                "speaker_id": "1",
                "transcription": "겨우 장관 한 번 할까 말까 그래요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.209,
                "end": 26.657
            },
            {
                "speaker_id": "2",
                "transcription": "영결식은 오는 18일 국회장으로 엄수될 예정인 가운데 빈소에는 정의화 의장을 비롯한 각계 인사들의 조문 행렬이 잇따르고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.667,
                "end": 36.365
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.375,
                "end": 39.166
            }
        ]
    },
    "summary": "이만섭 전 국회의장은 정계 은퇴 후에도 후배들에게 소신 있는 모습을 보이고 쓴소리를 아끼지 않았으며 이 전 국회의장의 영결식은 국회장으로 예정이며 빈소에는 각계 인사들의 조문 행렬이 잇따르고 있다.",
