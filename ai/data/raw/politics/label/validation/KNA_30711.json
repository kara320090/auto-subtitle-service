        "term": [
            {
                "speaker_id": "1",
                "transcription": "특검 후보자 2명을 모두 야당이 추천하도록 한 조항에 대해 정치적 중립성을 담보할 수 없다며 수정을 요구하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.209
            },
            {
                "speaker_id": "1",
                "transcription": "반면 야당 의원들은 여당에서 야당 추천 특검 후보를 받을 용의가 있다며 여야 3당 원내 지도부가 이미 합의한 법안이라고 맞서고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.219,
                "end": 16.028
            },
            {
                "speaker_id": "1",
                "transcription": "특검 법안은 소위를 거쳐 오늘 오후 법사위 전체 회의에서 처리되면 본회의에 상정될 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.038,
                "end": 22.242
            },
            {
                "speaker_id": "1",
                "transcription": "국회 법사위 전체 회의에서 특검 법안이 통과되지 않을 경우 정세균 국회 의장은 본회의에 특검 법안을 직권상정해 통과시킬 계획인 것으로 전해졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
