        "term": [
            {
                "speaker_id": "1",
                "transcription": "특히 우리나라가 생산한 기동 장비 가운데 K9 자주포가 처음으로 실물로 공개돼 눈길을 끌었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.620
            },
            {
                "speaker_id": "2",
                "transcription": "이제는 세계 방산 시장의 핵심이라고 볼 수 있는 미국에 와서 저희가 경쟁을 해야 되겠다.",
                "sound_type": [
                    2
                ],
                "start": 7.630,
                "end": 14.285
            },
            {
                "speaker_id": "2",
                "transcription": "그래야만 글로벌 시장을 공략할 수 있다는 생각이 들었고",
                "sound_type": [
                    2
                ],
                "start": 14.295,
                "end": 19.089
            },
            {
                "speaker_id": "1",
                "transcription": "올해는 코트라와 방위 산업 진흥회가 한국관을 통합 운영해 군대 중소 방산 업체들에 세계 시장 진출을 도왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.099,
                "end": 28.340
            },
            {
                "speaker_id": "1",
                "transcription": "워싱턴에서 KBS 뉴스 @이름1입니다.",
