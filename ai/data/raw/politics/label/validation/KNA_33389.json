        "term": [
            {
                "speaker_id": "1",
                "transcription": "전 세계 어디에 계시든 우리 동포의 아픔을 보듬는 것이 국가의 책무라고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.324
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1 초대 청장은 문턱이 낮은 재외 동포청이 되도록 조직을 이끌겠다고 밝혔는데 재외 동포들도 큰 기대감을 보였습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.334,
                "end": 18.257
            },
            {
                "speaker_id": "3",
                "transcription": "촘촘하게 우리 재외 동포들이 바라는 그 내용을 맞춤형으로 좀 서비스를 해 주셨으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.267,
                "end": 26.458
            },
            {
                "speaker_id": "2",
                "transcription": "인천시는 새로운 청사진을 제시했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.468,
                "end": 30.046
            },
            {
                "speaker_id": "4",
                "transcription": "초일류 도시를 향한 인천의 꿈이 재외 동포와 함께 대한민국의 미래가 되도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.056,
                "end": 37.275
            },
            {
                "speaker_id": "2",
                "transcription": "이를 위해 재외 동포 지원 기관인 웰컴 센터를 설립하고 재외 동포 주거 단지 조성 등에 나설 방침입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.285,
                "end": 45.357
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름2입니다.",
                "sound_type": [
                    2
                ],
                "start": 45.367,
                "end": 47.747
            }
        ]
    },
    "summary": "국가의 책무는 전 세계 동포의 아픔을 보듬는 것이고 @이름1 초대 청장은 문턱이 낮은 재외 동포청이 되게 하겠다고 했고 재외 동포들도 맞춤형 서비스를 해 주면 좋겠다고 했으며 인천시는 초일류 도시를 향한 청사진을 제시하고 재외 동포 지원 기관 웰컴 센터 설립과 재외 동포 주거 단지 조성 등에 나선다.",
