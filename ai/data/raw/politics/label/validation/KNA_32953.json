        "term": [
            {
                "speaker_id": "1",
                "transcription": "이후 경기도와 서울시가 각각 자체 의견을 행안부에 보내면 행안부가 검토 뒤 법률안 제출 여부를 결정합니다.",
                "sound_type": [
