        "term": [
            {
                "speaker_id": "1",
                "transcription": "문재인 정부의 첫 정기국회가 오늘 마지막 본회의에서 46건의 법안을 처리하는 것을 끝으로 100일간의 일정을 마무리했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.351
            },
            {
                "speaker_id": "1",
                "transcription": "본회의에서는 우선 세무사법 일부 개정 법률안이 가결됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.361,
                "end": 12.538
            },
            {
                "speaker_id": "1",
                "transcription": "세무사 법 개정안은 변호사 자격이 있는 사람에게 세무사 자격을 자동으로 부여하는 규정을 삭제한다는 내용이 핵심입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.548,
                "end": 20.988
            },
            {
                "speaker_id": "1",
                "transcription": "국회는 또 아이코스등 궐련형 전자담배에 부과하는 지방세를 인상하는 내용의 지방세법 개정안도 가결했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.998,
                "end": 28.341
            },
            {
                "speaker_id": "1",
                "transcription": "개정안은 궐련형 전자담배의 담배 소비세율을 궐련의 89퍼센트 수준인 20개비당 897원으로 올리는 것을 핵심 내용으로 담았습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.351,
                "end": 38.234
            },
            {
                "speaker_id": "1",
                "transcription": "지진 화산재의 대책법 개정안도 국회를 통과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.244,
                "end": 42.184
            },
            {
                "speaker_id": "1",
                "transcription": "법안은 지방 안전을 위한 단층조사 대상에 원자로 관계시설을 추가하고 한반도 전역에 단층을 대상으로 조사 연구를 수행하도록 한다는 내용을 핵심으로 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.194,
                "end": 53.034
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 함께 통과된 국유 재산법 일부 개정안은 일반 재산의 대부기간을 종류에 따라 최대 20년까지로 연장해 국유 재산을 활용도를 높이는 것이 핵심입니다.",
                "sound_type": [
                    2
                ],
                "start": 53.044,
                "end": 63.608
            },
            {
                "speaker_id": "1",
                "transcription": "또 중소기업 창업자나 벤처기업에 대해 국가 소유의 지식재산 사용료 등을 면제할 수 있는 근거를 규정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 63.618,
                "end": 71.000
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 정기국회는 끝났지만 여야는 다음주 월요일부터 2주동안 임시국회를 열어 쟁점 법안들을 처리할 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 71.010,
                "end": 79.458
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
