        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령께 이 이 세 가지 주사가 놔진 건 맞죠?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.689
            },
            {
                "speaker_id": "2",
                "transcription": "필요한 처방에 따라 처방 되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.699,
                "end": 6.862
            },
            {
                "speaker_id": "3",
                "transcription": "위원들은 이른바 세월호 사고 당일 7시간 동안의 대통령 행적도 집중 추궁했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.872,
                "end": 14.048
            },
            {
                "speaker_id": "4",
                "transcription": "저 의무실 2층짜리 건물 의무동에 대통령에 들렀다는 데 맞습니까?",
                "sound_type": [
                    2
                ],
                "start": 14.058,
                "end": 18.969
            },
            {
                "speaker_id": "5",
                "transcription": "제가 아는 바로는 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.979,
                "end": 21.009
            },
            {
                "speaker_id": "3",
                "transcription": "대통령이 이때 의료 시술을 받았다는 의혹도 제기했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.019,
                "end": 25.800
            }
        ]
    },
    "summary": "위원들은 세월호 사고 당일 7시간 동안의 대통령 행적을 집중 추궁했으며 대통령이 의료 시술을 받았다는 의혹도 제기했다.",
