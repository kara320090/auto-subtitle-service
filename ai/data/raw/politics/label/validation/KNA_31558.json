        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 씨와 친분이 있다는 의혹 때문에 청문회 증인으로 채택된 우병우 전 수석의 장모 @이름2 씨도 불출석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.918
            },
            {
                "speaker_id": "2",
                "transcription": "청력이 매우 나쁘기 때문에 사실은 저기 귀에 바짝 대고 큰소리로 얘기해야 들을 수 있는 그런 상황입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.928,
                "end": 16.116
            },
            {
                "speaker_id": "2",
                "transcription": "본인이 그런 상황을 공개 석상에 보이고 싶어 하지 않는 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.126,
                "end": 21.279
            },
            {
                "speaker_id": "1",
                "transcription": "장모 김 씨와 @이름1 씨와의 관계와 관련한 녹음 파일이 공개되자 우 전 수석은 장모를 대신해 해명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.289,
                "end": 28.474
            },
            {
                "speaker_id": "3",
                "transcription": "@이름1이가 옴과 동시에 우병우가 민정 비서관으로 청와대로 들어갔어.",
                "sound_type": [
                    2
                ],
                "start": 28.484,
                "end": 36.397
            },
            {
                "speaker_id": "2",
                "transcription": "저는 저런 이야기를 도저히 나는 납득할 수가 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.407,
                "end": 40.285
            },
            {
                "speaker_id": "1",
                "transcription": "우 전 수석은 장모에게 직접 물어봤더니 장모도 @이름1 씨를 잘 모른다고 했다고 덧붙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 40.295,
                "end": 46.582
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름3입니다.",
                "sound_type": [
                    2
                ],
                "start": 46.592,
                "end": 49.200
            }
        ]
    },
    "summary": "@이름1 씨와의 친분 의혹으로 청문회 증인으로 채택된 우 전 수석의 장모도 불출석하며 우 전 수석이 장모를 대신해 해명했고 녹음 파일에도 우 전 수석은 납득할 수 없다고 말했다.",
