        "term": [
            {
                "speaker_id": "1",
                "transcription": "식당 등 관련 업계도 발등에 불이 떨어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.203
            },
            {
                "speaker_id": "1",
                "transcription": "국회 인근의 한 한식당엔 벌써부터 공무원들의 발길이 눈에 띄게 줄었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.213,
                "end": 8.664
            },
            {
                "speaker_id": "1",
                "transcription": "대부분 음식이 김영란법이 정한 기준 3만 원을 넘는 탓에 가격 인하를 고민하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.674,
                "end": 14.927
            },
            {
                "speaker_id": "2",
                "transcription": "메뉴를 조정한다 하면은 결국은 인원도 조정을 해야 되고 가격을 조정한다 하면은 결국은 이제 이 많은 인원을 정리를 해야 되고.",
                "sound_type": [
                    2
                ],
                "start": 14.937,
                "end": 25.191
            },
            {
                "speaker_id": "1",
                "transcription": "가격 조정이 어려운 업계는 여전히 대책 마련에 어려움을 호소하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.201,
                "end": 30.198
            },
            {
                "speaker_id": "3",
                "transcription": "사례가 아직 뭐 확정된 부분이 없어서.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.208,
                "end": 33.300
            }
        ]
    },
    "summary": "국회 인근의 한 식당은 벌써부터 공무원들의 발길이 줄었고 음식 대부분의 가격이 김영란법 기준인 3만 원을 넘기 때문에 가격 인하를 고민하고 있는 상황이며 가격 조정이 어려운 업계에서는 대책 마련에 어려움을 호소하고 있습니다.",
