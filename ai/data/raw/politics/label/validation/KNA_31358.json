        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭔가 말씀을 하시고 싶은데 말씀을 잇지 못하시는 분들이 많으세요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.281
            },
            {
                "speaker_id": "1",
                "transcription": "또 아까 작별 상봉 중에서도 가족에게 남기는 쪽지 같은 것들을 쓰시면서 다 쓰지 못하고 울어버리시는 분들도 많았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.291,
                "end": 15.519
            },
            {
                "speaker_id": "2",
                "transcription": "어 잘 있고 무튼 튼튼하면 돼요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 15.529,
                "end": 19.477
            },
            {
                "speaker_id": "2",
                "transcription": "어 알았죠?",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 19.487,
                "end": 20.772
            },
            {
                "speaker_id": "2",
                "transcription": "건강해야지 또 다시 만나지 응.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 20.782,
                "end": 24.252
            },
            {
                "speaker_id": "3",
                "transcription": "응 건강해야 다시 만나지.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 24.262,
                "end": 30.890
            },
            {
                "speaker_id": "1",
                "transcription": "그나마 문이 열려서 저렇게 손을 잡을 수 있는 가족들은 참 손 1번",
                "sound_type": [
