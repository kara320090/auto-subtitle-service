        "term": [
            {
                "speaker_id": "1",
                "transcription": "특히 이 과정에서 이재명 성남시장이 관여했다는 게 검찰이 보는 구도입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.973
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 대표는 정권이 위기에 빠질 때마다 검찰이 이재명 죽이기에 나섰다고 주장하며 역사와 국민이 심판할 거라고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.983,
                "end": 13.895
            },
            {
                "speaker_id": "2",
                "transcription": "정권의 무능을 감추기 위한 정치 수사라고 생각합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.905,
                "end": 20.477
            },
            {
                "speaker_id": "2",
                "transcription": "없는 죄를 만들어 뒤집어 씌우는 것이.",
                "sound_type": [
