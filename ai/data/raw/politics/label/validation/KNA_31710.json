        "term": [
            {
                "speaker_id": "1",
                "transcription": "우선 안전과 인허가 업무 유관 단체장에 공무원을 배제하겠다고 말했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.070
            },
            {
                "speaker_id": "1",
                "transcription": "또 퇴직 공무원의 취업 제한 기관 수를 3배 이상 확대하고 취업 제한 기간도 3년으로 늘리기로 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.080,
                "end": 12.530
            },
            {
                "speaker_id": "1",
                "transcription": "공직 사회 혁신을 위해 5급 공채와 민간 경력자 채용을 5대 5 수준으로 맞추고 직무별로 필요한 시기에 전문가를 뽑는 체제로 만들겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.540,
                "end": 22.798
            },
            {
                "speaker_id": "1",
                "transcription": "박 대통령은 또 기업이 국민의 생명과 재산에 피해를 입힐 경우 숨겨놓은 재산까지 환수하는 특별법을 만들겠다고 말했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.808,
                "end": 31.234
            },
            {
                "speaker_id": "2",
                "transcription": "이번에 크나큰 희생을 당한 분들이 부도덕한 기업과 범죄자들로부터 피해를 보상받느라 또 한 번 고통을 받는 일이 없도록 할 것입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 31.244,
                "end": 44.607
            },
            {
                "speaker_id": "1",
                "transcription": "이번 사고와 관련해 국가가 먼저 피해자들에게 신속히 보상하고 사고 책임자에게 구상권을 행사하는 특별법도 제정하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 44.617,
                "end": 54.300
            }
        ]
    },
    "summary": "공직 사회 혁신을 위해 퇴직 공무원의 취업 제한 기관 수와 기간을 늘리고 민간 경력자 채용을 확대하고 기업이 국민의 생명과 재산에 피해를 줄 때 모든 재산을 환수하는 특별법을 만들겠다고 말했고 국가가 먼저 신속히 보상하고 사고책임자에게 구상권을 행사하는 특별법을 제정하겠다고 밝혔다.",
