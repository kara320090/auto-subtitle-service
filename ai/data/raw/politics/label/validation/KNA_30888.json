        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령께서 관저에만 계셨습니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.396
            },
            {
                "speaker_id": "2",
                "transcription": "청와대분들이 다 말하기를 그날 관저에 있었다고 하기 때문에 저도 이제 관저에 있는 줄 알게 되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.406,
                "end": 9.351
            },
            {
                "speaker_id": "3",
                "transcription": "김 전 실장은 세월호 참사 당일 박 대통령에게 서면보고만 한 데 대해선 회환이 많다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.361,
                "end": 16.057
            },
            {
                "speaker_id": "1",
                "transcription": "비서 실장이 이런 상황에선 직접 대면 보고해야 되는 거 아니에요?",
                "sound_type": [
                    2
                ],
                "start": 16.067,
                "end": 20.293
            },
            {
                "speaker_id": "2",
                "transcription": "지금 지나고 보면은",
                "sound_type": [
                    2
