    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "50대 이상",
                "gender": "여성"
            },
            {
                "speaker_id": "2",
                "age": "50대 이상",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰 차량이 연이어 구치소 안으로 들어갑니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.206
            },
            {
                "speaker_id": "1",
                "transcription": "이명박 전 대통령에 대한 방문 조사 일행입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.216,
                "end": 6.459
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 시작부터 핵심을 파고들기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.469,
                "end": 9.951
            },
            {
                "speaker_id": "1",
                "transcription": "주요 혐의 성립의 전제 조건 다스 실소유주 문제입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.961,
                "end": 14.524
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 조사는 1시간 반 만에 끝났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.534,
                "end": 17.800
            },
            {
                "speaker_id": "1",
                "transcription": "이 전 대통령이 검찰 조사를 일체 거부했기 때문입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.810,
                "end": 21.862
            },
            {
                "speaker_id": "1",
                "transcription": "공정한 수사를 기대하기 어렵다는 것이 그 이유였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.872,
                "end": 25.952
            },
            {
                "speaker_id": "2",
                "transcription": "비서진을 비롯한 주변 사람들을 끊임없이 불러 조사하고 있고 일방적인 피해 사실도 무차별적으로 공개하고 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.962,
                "end": 35.810
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 외부와의 끈을 완전히 놓고 있는 건 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 35.820,
                "end": 39.536
            },
            {
                "speaker_id": "1",
                "transcription": "측근을 통해 천안함 피격 사건 8주기 추모 메시지를 SNS에 남겼습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.546,
                "end": 45.401
            },
            {
                "speaker_id": "1",
                "transcription": "정치 보복이라는 주장을 다시 한번 강조하는 효과도 노렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.411,
                "end": 49.829
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 수사는 차질이 불가피해졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.839,
                "end": 53.042
            },
            {
                "speaker_id": "1",
                "transcription": "기존의 혐의 보강도 새로운 혐의 조사도 못한 채 이 전 대통령을 재판에 넘길 수밖에 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.052,
                "end": 59.876
            },
            {
                "speaker_id": "1",
                "transcription": "부인 @이름1 여사의 소환과 아들 @이름2 씨 재소환 가능성은 더욱 높아지게 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.886,
                "end": 65.786
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 관계자는 방어권 보장 차원에서라도 이 전 대통령에게 조사에 응할 것을 계속 설득하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 65.796,
                "end": 74.000
            }
        ]
    },
    "summary": "검찰이 이 전 대통령에 대한 조사를 하기 위해 구치소를 방문했으나 이 전 대통령이 공정한 수사를 기대하기 어렵다며 검찰 조사를 거부해 조사가 1시간 반 만에 끝났고 최근에는 정치 보복이라는 주장을 강조하기 위해 측근을 통해 SNS에 천안함 피격 사건 8주기 추모 메시지를 올렸으며 검찰 수사의 차질이 불가피해진 상황으로 부인과 아들의 재소환 가능성이 높아졌습니다.",
