        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 이산가족 문제를 협의할 후속 적십자 실무 접촉을 오는 12일 개최하자고 북한에 제의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.030
            },
            {
                "speaker_id": "1",
                "transcription": "통일부는 이산가족 정례화 등 이산가족 문제의 근본적 해결 방안을 협의할 적십자 실무 접촉을 오는 12일 판문점 우리 측 지역인 평화의 집에서 열 것을 북한에 제의했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.040,
                "end": 20.073
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 오늘 아침 판문점 연락관 접촉을 통해 회담 제의 의사를 전달했고 북한은 오전 11시 15분쯤 회담 제의 내용이 담긴 통지문을 공식 수령했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.083,
                "end": 31.480
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 통일부 부대변인은 이번 제의는 이산가족들의 한을 하루라도 빨리 풀어주자는 박근혜 대통령의 3.1절 기념사의 후속 조치 차원이라고 설명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.490,
                "end": 42.550
            },
            {
                "speaker_id": "1",
                "transcription": "또 남북 이산가족들의 아픔과 고통을 고려해 북한이 이번 제의에 조속히 호응해 오기를 기대한다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.560,
                "end": 50.471
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 이산가족 문제가 인도적 사안인 만큼 고위급 접촉보다는 우선 적십자 채널을 통하는 게 적절하다고 판단한 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 50.481,
                "end": 60.063
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 박근혜 대통령은 3.1절 기념사를 통해 북한에 이산가족 상봉 정례화를 제안했고 어제는 서신왕래와 화상 상봉 문제 등을 북측과 협의할 것을 지시했습니다.",
                "sound_type": [
