        "term": [
            {
                "speaker_id": "1",
                "transcription": "여야는 다음 주 중 국정 조사 요구서를 공동 제출하고 늦어도 6월 말까지는 특위를 가동하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.804
            },
            {
                "speaker_id": "1",
                "transcription": "국정 조사 기간은 관례에 따라 30일로 하되 필요하면 더 늘려 나갈 방침입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.814,
                "end": 12.556
            },
            {
                "speaker_id": "1",
                "transcription": "양당은 당초 선관위에 대한 국정 조사를 진행한다는 큰 틀에는 합의했지만 조사 대상 등을 두고 이견을 보여 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.566,
                "end": 20.871
            },
            {
                "speaker_id": "1",
                "transcription": "여야는 또 일본 후쿠시마 원전 오염수 방류와 관련해서도 검증 특위를 구성하고 청문회를 개최하는데 합의했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.881,
                "end": 29.256
            },
            {
                "speaker_id": "1",
                "transcription": "다음 주 중으로 특위 구성에 관한 동의안을 국회 본회의에 제출하고 청문회 일정도 정하기로 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 29.266,
                "end": 36.215
            },
            {
                "speaker_id": "2",
                "transcription": "다음 주 중으로 그 특위 구성에 관한 의안을 본회의에 제출해서 그 본회의 의결을 거쳐서 구체적인 활동 일자나 이런 것은 특위 차원에서 협의해서 결정을 해야 될 것 같습니다.",
                "sound_type": [
                    2,
