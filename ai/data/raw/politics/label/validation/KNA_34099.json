        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 국방 장관과 제임스 매티스 미 국방 장관이 함께 판문점 공동 경비 구역을 방문했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.950
            },
            {
                "speaker_id": "1",
                "transcription": "매티스 장관은 이 자리에서 전쟁이 아닌 완전한 비핵화가 목표라고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.961,
                "end": 12.990
            },
            {
                "speaker_id": "2",
                "transcription": "외국어 발화",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.980,
                "end": 23.779
            },
            {
                "speaker_id": "1",
                "transcription": "매티스 장관은 이에 이번 주 아세안 확대 국방 장관 회의에서 송 장관과 만나 북한에 무모한 행동에 대응할 외교적 해법에 대한 의지를 분명히 했다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.789,
                "end": 34.502
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 장관은 북한이 개발한 핵과 미사일은 사용할 수 없는 무기라고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.512,
                "end": 41.038
            },
            {
                "speaker_id": "1",
                "transcription": "만약 사용을 하게 된다면 강한 한미의 연합 전력으로 그 의도를 응징할 것을 확실히 확인하는 바입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.048,
                "end": 53.933
            }
        ]
    },
