        "term": [
            {
                "speaker_id": "1",
                "transcription": "야당 질의는 @이름1 후보자 아들에게 학교폭력 의혹이 있었는데도 왜 학폭위가 열리지 않았냐에 집중됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.693
            },
            {
                "speaker_id": "2",
                "transcription": "후보자의 아들에 대해서만 방금 가해 사실이 있다고 반성하고 있다고 얘기했는데도 불구하고 왜 학폭위가 열리지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 6.703,
                "end": 14.625
            },
            {
                "speaker_id": "3",
                "transcription": "임의적으로 열고 말고가 아니라 학교폭력대책위원회가 필수적으로 개최되어야 했지만 당시에 어쨌든 개최가 되지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.635,
                "end": 23.331
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보자는 학폭위를 열 만한 사실이 아니었고 피해 학생과 화해했다는 입장을 재강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.341,
                "end": 29.705
            },
            {
                "speaker_id": "1",
                "transcription": "화해한 것이 아니라는 과거 담임 교사의 입장에 대해서도 교사가 입장을 바꾼 것이라고 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.715,
                "end": 36.267
            },
            {
                "speaker_id": "1",
                "transcription": "피해 학생 진술서의 신빙성을 의심하기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.277,
                "end": 39.908
            },
            {
                "speaker_id": "4",
                "transcription": "지금 아무 서명, 날인도 돼 있지 않은 거를 이게 진실이니까 그 이걸 인정하라고 그러면 그건 좀 강변 아니신가 싶습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.918,
                "end": 48.973
            },
            {
                "speaker_id": "4",
                "transcription": "여당도 피해 사실이 과장됐다며 엄호에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 48.983,
                "end": 52.732
            },
            {
                "speaker_id": "5",
                "transcription": "300번 이상 머리를 박게 하면 살아 있을 수가 있나요?",
                "sound_type": [
                    2
                ],
                "start": 52.742,
                "end": 56.785
            },
            {
                "speaker_id": "6",
                "transcription": "그러니까 말입니다.",
                "sound_type": [
                    2
                ],
                "start": 56.795,
                "end": 57.983
            },
            {
                "speaker_id": "6",
                "transcription": "이런 가학 행위가 과장 왜곡되고 과도한 폭력이 없고",
                "sound_type": [
                    2
                ],
                "start": 57.993,
                "end": 65.331
            }
        ]
    },
    "summary": "야당의 질의는 후보자 아들의 학교폭력 의혹에 집중돼 왜 학폭위가 열리지 않았는지 물었고 이 후보자는 학폭위를 열 만한 사실이 아니었고 화해했다는 입장을 강조했고 여당도 피해 사실이 과장되었다며 엄호했다.",
