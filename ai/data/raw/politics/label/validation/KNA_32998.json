        "term": [
            {
                "speaker_id": "1",
                "transcription": "새누리당 공천관리위는 지방선거 광역단체장 경선에 참여할 예비 후보군을 추리는 자격 심사 이른바 컷오프 작업에 착수했습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 0.000,
                "end": 8.997
            },
            {
                "speaker_id": "1",
                "transcription": "공천위는 컷오프를 통해 예비 후보를 3배수로 추리는 것을 원칙으로 하고 있지만 후보 간 지지율 격차가 크지 않을 경우 4에서 5배수까지도 대상자를 늘릴 방침입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 9.007,
                "end": 20.641
            },
            {
                "speaker_id": "1",
                "transcription": "현재 새누리당에서 4명 이상이 광역단체장 후보 공천을 신청해 컷오프가 필요한 지역은 대구와 서울 대전 울산 등 모두 8곳입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 20.651,
                "end": 31.028
            },
            {
                "speaker_id": "1",
                "transcription": "민주당과 새정치연합은 야권 통합 신당인 새정치민주연합의 정강 정책과 당헌당규에 대한 막바지 합의 작업을 하고 있습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 31.038,
                "end": 40.562
            },
            {
                "speaker_id": "1",
                "transcription": "신당의 정강 정책에는 삭제 논란을 일으켰던 6 15와 10 4선언이 명시됐고 박정희 전 대통령 시절 체결된 7 4성명과 노태우 전 대통령 시절 체결된 남북기본합의서도 추가됐습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 40.572,
                "end": 54.885
            },
            {
                "speaker_id": "1",
                "transcription": "또 당헌당규에는 최고 의사 결정 기구로 25명 이내의 최고위원회를 두고 지역민이나 직장인 등 일반 국민을 최고위원으로 참여시키는 안이 제시됐습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 54.895,
                "end": 67.206
            },
            {
                "speaker_id": "1",
                "transcription": "새정치민주연합은 내일 열리는 창당 대회에서 정강 정책과 당헌당규를 최종 추인할 예정입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 67.216,
                "end": 74.470
            },
            {
                "speaker_id": "1",
