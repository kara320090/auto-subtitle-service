        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "문재인 대통령은 오늘 오전 러시아 블라디보스톡에 도착했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.531
            },
            {
                "speaker_id": "1",
                "transcription": "이어 오후에 푸틴 러시아 대통령과 단독과 확대 정상회담을 잇따라 가졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.541,
                "end": 11.063
            },
            {
                "speaker_id": "1",
                "transcription": "두 정상은 언론 공동 성명을 통해 북한의 6차 핵 실험 강행을 강력히 규탄하고 북한 핵미사일 문제를 조속히 해결하는 게 무엇보다 중요하다는 데 의견을 함께했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.073,
                "end": 24.677
            },
            {
                "speaker_id": "1",
                "transcription": "또 북한이 추구하는 핵미사일 개발은 잘못된 길이며 한반도에서 긴장을 완화하는 것이 시급한 과제라는데도 인식을 함께했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.687,
                "end": 34.788
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령은 푸틴 대통령이 북핵 문제 해결과 남북 관계 개선을 위한 우리 정부의 입장과 노력에 대해 전폭적인 이해와 지지를 표명한 데 기쁘게 생각한다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.798,
                "end": 47.575
            },
            {
                "speaker_id": "1",
                "transcription": "다만 푸틴 대통령은 북핵 문제는 압박과 제재로만 해결할 수 없는 문제라면서 냉정하게 접근해야 하고 긴장 완화를 위해 노력해야 한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.585,
                "end": 58.298
            },
            {
                "speaker_id": "1",
                "transcription": "이를 위한 러시아의 평화적 해결 로드맵 구축에 관심을 가져달라고도 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.308,
                "end": 64.125
            },
            {
                "speaker_id": "1",
                "transcription": "경제 협력과 관련해 두 정상은 에너지와 조선 산업, 인프라 건설 등 다양한 분야에서 경제 교류를 통해 호혜적인 경제 관계를 유지하기로 했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.135,
                "end": 76.179
            },
            {
                "speaker_id": "1",
                "transcription": "또 한반도와 극동 지역을 연결하는 남북러 3각 기초를 확실히 다지기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
