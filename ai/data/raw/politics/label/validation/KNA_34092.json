        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부는 오늘 국무 회의에서 신고리 공론화 위원회 권고에 따른 후속 조치와 보안 대책을 의결했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.208
            },
            {
                "speaker_id": "1",
                "transcription": "우선 신고리 5, 6호기 건설을 재개하되 이를 위한 후속 조치를 신속하게 추진하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.218,
                "end": 13.335
            },
            {
                "speaker_id": "1",
                "transcription": "또 원자력 발전 감축 차원에서 신규 원전 6개 계획은 백지화하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.345,
                "end": 19.260
            },
            {
                "speaker_id": "1",
                "transcription": "2038년까지 수명이 만료되는 노후 원전 14기는 수명 연장을 금지하고 월성 1호기는 조기 폐쇄하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.270,
                "end": 28.719
            },
            {
                "speaker_id": "1",
                "transcription": "계획대로라면 국내 총 원전은 현재 24개에서 2038년까지 14기로 줄어들게 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.729,
                "end": 36.534
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 대통령은 국무 회의를 주재한 자리에서 신고리 5, 6호기 공론화 과정이 민주주의를 성숙시키고 사회적 갈등 현안 해결에 새로운 모델을 만드는 계기가 됐다고 평가했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.544,
                "end": 48.970
            },
            {
                "speaker_id": "2",
                "transcription": "공론화의 뜻이 승자와 패자",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.970,
                "end": 53.266
            }
        ]
    },
    "summary": "정부는 오늘 국무 회의에서 신고리 공론화 위원회 권고에 따른 후속 조치와 보안 대책을 의결했으며 신규 원전 6개 계획은 백지화하기로 했다.",
