        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 과정에서 민주당 의원들과 다시 고성이 오갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.491
            },
            {
                "speaker_id": "2",
                "transcription": "태영호 의원이 온 자체가 소란이고 그건 예의에 어긋나는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 3.501,
                "end": 8.007
            },
            {
                "speaker_id": "2",
                "transcription": "예의에 어긋나.",
                "sound_type": [
                    2
                ],
                "start": 8.017,
                "end": 9.200
            },
            {
                "speaker_id": "2",
                "transcription": "여길 왜 와.",
                "sound_type": [
                    2
                ],
                "start": 9.210,
                "end": 10.033
            },
            {
                "speaker_id": "3",
                "transcription": "당에서 출당시키고 그리고 국회의원직 이거 대표님께서 책임지고 이거 박탈시켜야 됩니다.",
                "sound_type": [
