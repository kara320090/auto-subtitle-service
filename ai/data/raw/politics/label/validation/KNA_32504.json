        "term": [
            {
                "speaker_id": "1",
                "transcription": "언론장악, 재산 증식, 권력 남용 등 각종 의혹들을 부인하고 명백한 잘못이 드러나도 모르쇠로 일관하고 문제없다고 둘러대는 태도는 가관이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.507
            },
            {
                "speaker_id": "2",
                "transcription": "과방위 전체회의도 파행을 빚어 오늘까지가 시한인 인사청문보고서 채택은 불발됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.517,
                "end": 20.257
            },
            {
                "speaker_id": "2",
                "transcription": "여당은 청문보고서 채택을 전제로 회의를 열어야 한다며 대거 불참했고 야당은 규탄 발언을 이어갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.267,
                "end": 28.040
            },
            {
                "speaker_id": "3",
                "transcription": "@이름1 후보자는 방통위원장 자리가 아니라 경찰청 조사실로 가야 한다고 봅니다.",
                "sound_type": [
                    2
