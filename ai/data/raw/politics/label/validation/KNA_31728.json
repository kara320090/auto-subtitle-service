        "term": [
            {
                "speaker_id": "1",
                "transcription": "산더미처럼 쌓인 선물 상자가 쉴 새 없이 옮겨지고 의원회관 로비는 아예 택배 물류센터로 변했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.870
            },
            {
                "speaker_id": "2",
                "transcription": "삼사백 개 정도 생각하시면 될 거예요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.885,
                "end": 9.191
            },
            {
                "speaker_id": "2",
                "transcription": "많게는 오육백 개 정도",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.201,
                "end": 12.240
            },
            {
                "speaker_id": "1",
                "transcription": "택배회사 직원들과 손수레까지 끌고 선물을 찾아가는 의원실 직원들이 뒤엉켜 북새통을 이룹니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.330,
                "end": 19.176
            },
            {
                "speaker_id": "1",
                "transcription": "사과, 배, 멸치 등 식품류가 많지만 굴비와 버섯, 홍삼 같은 고가의 선물도 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.186,
                "end": 25.756
            },
            {
                "speaker_id": "1",
                "transcription": "대부분 정부 산하기관이나 지역구 인사들이 보낸 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.766,
                "end": 29.424
            },
            {
                "speaker_id": "3",
                "transcription": "도움받았던 분들이나 기관에서 그런 정도 피감 기관에서 한번 잘 봐달라고 보냈는데, 또 안 보내면은 그게 문제가 되니까",
                "sound_type": [
                    2,
                    4
                ],
                "start": 29.434,
                "end": 42.852
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 국회는 지난 4달간 법안 처리를 전혀 하지 못해 입법부 본연의 활동은 멈춘 상태.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 42.862,
                "end": 49.050
            },
            {
                "speaker_id": "1",
                "transcription": "쏟아지는 선물 꾸러미를 바라보는 시선이 고을 리 없습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 49.060,
                "end": 53.062
            },
            {
                "speaker_id": "4",
                "transcription": "하여간 뭐 씁쓸하죠 국회의원들은 뭐 맨날",
                "sound_type": [
                    2,
                    4
                ],
                "start": 53.072,
                "end": 58.233
            }
        ]
    },
    "summary": "의원회관 로비가 택배 물류센터로 변했는데 대부분 정부 산하기관이나 지역구 인사들이 보낸 것으로 4달간 법안 처리를 전혀 하지 못한 국회에 쏟아지는 선물 꾸러미를 바라보는 시선이 곱지 않다.",
