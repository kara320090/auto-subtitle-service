        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지정 기간은 10일부터 14일로 미국 대사관과 중국 대사관 싱가포르 외무부 등도 포함됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.711
            },
            {
                "speaker_id": "1",
                "transcription": "싱가포르 경찰도 내무부가 지정한 특별 행사구역 내의 일부를 특별 구역으로 규정한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.721,
                "end": 14.705
            },
            {
                "speaker_id": "1",
                "transcription": "특별 구역에는 외부인과 차량 출입이 제한되며 경찰의 불심검문이 이뤄질 수 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.715,
                "end": 22.040
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 회담장 후보로 거론됐던 센토사 섬이나 북측 대표단이 묵었던 풀러턴 호텔 싱가포르 대통령궁 등은 특별행사구역으로 언급되지 않았습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 22.050,
                "end": 33.673
            },
            {
                "speaker_id": "1",
                "transcription": "샹그릴라 호텔이 북미 정상회담 장소로 유력하게 떠오른 이유입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 33.683,
                "end": 38.814
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 아직 공식 발표가 나지 않아 단정하긴 어렵습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 38.824,
                "end": 42.775
            },
            {
                "speaker_id": "1",
                "transcription": "일단 샹그릴라 호텔을 정상회담 장소나 숙소 등으로 이용하고 다른 장소를 추가로 특별 행사구역으로 지정할 가능성도 있습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 42.785,
                "end": 52.214
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 미국과 일본 언론 등은 주로 센토사 섬을 싱가포르 언론들은 샹그릴라 호텔을 각각 회담장으로 점찍어 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.224,
                "end": 61.581
            },
            {
                "speaker_id": "1",
                "transcription": "싱가포르에서 KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 61.591,
                "end": 65.400
            }
        ]
    },
    "summary": "싱가포르 경찰도 내무부가 지정한 특별 행사구역 내의 일부를 특별 구역으로 규정해 외부인과 차량 출입이 제한되며 경찰의 불심검문이 이뤄질 수 있고 샹그릴라 호텔이 북미 정상회담 장소로 유력하다.",
