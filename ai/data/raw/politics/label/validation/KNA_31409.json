        "term": [
            {
                "speaker_id": "1",
                "transcription": "박근혜 대통령이 우리 정상으로는 처음으로 유네스코 본부를 방문했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.380
            },
            {
                "speaker_id": "1",
                "transcription": "특별 연설에서 테러 등 극단적 폭력 주의의 악순환을 근본적으로 해결하기 위한 교육의 중요성을 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.380,
                "end": 14.304
            },
            {
                "speaker_id": "1",
                "transcription": "폭력이 아닌 대화를 좌설이 아닌 희망의 꿈을 심어주는 일이야말로 오래도록 유지될평화의 방벽을 세우는 일입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.314,
                "end": 25.860
            },
            {
                "speaker_id": "2",
                "transcription": "저는 그 해답이 바로 교육에 있다고 생각하며.",
                "sound_type": [
                    2
                ],
                "start": 25.870,
                "end": 30.495
            },
            {
                "speaker_id": "1",
                "transcription": "또 국제사회 전체에 위협이 되고 있는 북한의 핵 개발과 인권 문제 평화 통일로 풀어 가겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.505,
                "end": 38.304
            },
            {
                "speaker_id": "1",
                "transcription": "특히 유네스코는 우리의 발장과 번영의 동반자였다며 인류 평화와 번영을 위해 교육과 과학, 문화 분야에서의 유네스코와 협력을 확대하겠다고 말했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.314,
                "end": 49.100
            }
        ]
    },
    "summary": "박근혜 대통령이 우리 정상으로는 처음으로 유네스코 본부를 방문했고 특별 연설에서 테러 등 극단적 폭력 주의의 악순환을 근본적으로 해결하기 위한 교육의 중요성을 강조했다.",
