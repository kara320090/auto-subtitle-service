        "term": [
            {
                "speaker_id": "1",
                "transcription": "노사정이 대타협에 실패하자 정부가 노동 개혁과 관련해 긴급 합동 담화문을 발표했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.876
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로도 노사정 합의가 이루어지지 않으면 정부 주도로 노동 개혁 발령 법안을 입법하겠다고 밝힌 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.886,
                "end": 13.042
            },
            {
                "speaker_id": "1",
                "transcription": "다음 주 초부터 새누리당과 당정 협의 등을 통해 관련 절차를 진행하겠다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.052,
                "end": 18.652
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 그간 노사정 논의를 토대로 노동 개혁 법안 입법을 추진하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.662,
                "end": 25.779
            },
            {
                "speaker_id": "1",
                "transcription": "노동 개혁에 핵심 과제로는 임금 피크제 도입과 업무 부적응자 해고를 꼽았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.789,
                "end": 32.049
            },
            {
                "speaker_id": "1",
                "transcription": "내년부터 정년이 60세로 연장되는 데다 기업들이 채용을 늘리기 위해선 이 2가지가 반드시 추진돼야 한다며 관련 기준과 절차를 포함 시키겠다고 말했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 32.059,
                "end": 42.966
            }
        ]
    },
    "summary": "노사정이 대타협에 실패하자 정부는 노동 개혁과 관련해 합의가 이루어지지 않으면 정부 주도로 노동 개혁 발령 법안을 입법하겠다고 밝혔고 노동 개혁의 핵심 과제로는 임금 피크제 도입과 업무 부적응자 해고 등을 꼽았습니다.",
