                "end": 9.901
            },
            {
                "speaker_id": "1",
                "transcription": "황 후보자의 딸은 증여세 450만원을 후보 내정 발표 사흘 전에 납부한 것으로 드러났습니다.",
                "sound_type": [
                    2
                ],
