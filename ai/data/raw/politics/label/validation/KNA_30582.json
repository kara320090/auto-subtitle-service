        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 때문에 물밑 협상을 진행하면서도 추경 처리 무산 책임을 두고 여야의 네 탓 공방도 계속됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.134
            },
            {
                "speaker_id": "1",
                "transcription": "정진석 새누리당 원내 대표는 우상우 원내 대표가 딱하다는 생각이 든다며 여야 원내 대표가 합의서에 서명해도 무슨 구속력이 있겠느냐고 목소리를 높였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.144,
                "end": 18.074
            },
            {
                "speaker_id": "1",
                "transcription": "우상우 더민주 원내 대표는 부실 대기업에 수조 원은 퍼주면서 민생 예산 증액에는 야박한 정부 여당을 모른 척할 수 없다고 맞받았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.084,
                "end": 27.876
            },
            {
                "speaker_id": "1",
                "transcription": "여야 3당이 협상 타결을 위한 논의를 계속할 방침이지만 추경안 세부 내용을 놓고 이견을 좁히기 쉽지 않아 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
