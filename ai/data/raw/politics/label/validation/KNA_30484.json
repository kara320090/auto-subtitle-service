        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 판사님들께서 어 각기 이해 당사들 간의 의견을 소상히 듣고 공정을 공정한 판단을 했다고 저는 생각을 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.473
            },
            {
                "speaker_id": "2",
                "transcription": "법원은 도주 우려가 적고 증거 인멸 가능성이 있다고 보기 어려운 상황이라며 여전히 박 의원의 방어권을 보장할 필요가 있다고 기각 이유를 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.483,
                "end": 19.572
            },
            {
                "speaker_id": "2",
                "transcription": "지난 5월 검찰은 박 의원을 3억 5000만 원 상당의 공천 헌금 수수 혐의로 구속 영장을 청구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.582,
                "end": 26.864
            },
            {
                "speaker_id": "2",
                "transcription": "이 구속 영장이 법원에서 기각되자 불법 선거 비용이 지출된 혐의를 추가로 확인해 영장을 다시 청구했지만 이번에도 기각된 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.874,
                "end": 36.637
            },
            {
                "speaker_id": "2",
                "transcription": "앞서 같은 당 소속 박선숙 김수민 의원에 대해서도 지난 총선 당시 업체로부터 억대의 리베이트를 받은 혐의로 2번이나 구속 영장을 청구했지만 법원이 기각한 바 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
