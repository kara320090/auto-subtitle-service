        "term": [
            {
                "speaker_id": "1",
                "transcription": "부자 상봉이었죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 0.941
            },
            {
                "speaker_id": "2",
                "transcription": "새복이 어딨어 새복이 새복이.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.951,
                "end": 6.603
            },
            {
                "speaker_id": "1",
                "transcription": "저 버스 좌석이 문이 열리는 좌석이 있고 열리지 않는 좌석이 있는 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.613,
                "end": 11.494
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 문이 열리지 않는 쪽은 저렇게 손을 맞대고 있고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.504,
                "end": 15.210
            },
            {
                "speaker_id": "3",
                "transcription": "네 몸이 편찮으신데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.220,
                "end": 17.387
            },
            {
                "speaker_id": "1",
                "transcription": "남측 최고령자 지금 @이름1 씨의 모습인데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.397,
                "end": 21.575
            },
            {
                "speaker_id": "4",
                "transcription": "두 딸을 만나셨던",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.585,
                "end": 23.646
            },
            {
                "speaker_id": "1",
                "transcription": "예 딸을 만나셨는데 꽃신을 전해 주셨죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.656,
                "end": 26.549
            },
            {
                "speaker_id": "1",
                "transcription": "고령이시라 그런지 좀 건강이 안 좋아 보이시고요.",
