        "term": [
            {
                "speaker_id": "1",
                "transcription": "종전 선언을 노래 부르고 다녔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.500
            },
            {
                "speaker_id": "2",
                "transcription": "사실상 문재인 정권을 겨냥한 것이란 해석이 나왔는데 민주당은 강하게 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.510,
                "end": 9.891
            },
            {
                "speaker_id": "2",
                "transcription": "대통령이 해야 할 국민 통합의 가치를 정면 부정했다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.901,
                "end": 15.220
            },
            {
                "speaker_id": "2",
                "transcription": "문재인 정부 청와대 출신 의원들은 긴급 기자 회견을 열고 대통령의 편협한 사고 체계에 우려를 표명하지 않을 수 없다며 사과를 요구했습니다.",
                "sound_type": [
