        "term": [
            {
                "speaker_id": "1",
                "transcription": "이건 영세 업체지 않습니까.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.905
            },
            {
                "speaker_id": "1",
                "transcription": "현금 15억이면 어마어마하게 큰돈입니다.",
                "sound_type": [
                    2
                ],
                "start": 1.905,
                "end": 4.435
            },
            {
                "speaker_id": "2",
                "transcription": "공공 기관 압류는 지역 첫 사례로 이례적입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.445,
                "end": 7.955
            },
            {
                "speaker_id": "2",
                "transcription": "공공 기관의 지급 능력을 믿고 그동안 압류까지는 안 했지만 최근에는 경기 악화로 채권을 보다 빨리 회수하려고 이 같은 수단이 동원되는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.965,
                "end": 17.745
            },
            {
                "speaker_id": "2",
                "transcription": "법원이 공공 기관에 지급 책임을 더 강하게 묻는 것도 한몫한 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.742,
                "end": 22.591
            },
            {
                "speaker_id": "3",
                "transcription": "관급 계약에 있어서 을의 위치에 있던 이 계약 상대방들의",
                "sound_type": [
                    2
                ],
                "start": 22.601,
                "end": 25.900
            }
        ]
    },
    "summary": "그동안 법원은 공공 기관의 지급 능력을 믿고 압류를 한 적이 없었지만 최근 경기 악화로 채권을 빨리 회수하기 위해 공공 기관을 압류하는 수단이 동원되기 시작했으며 이는 법원이 공공 기관에 대해 지급 책임을 더 강하게 물었던 것이 한몫했습니다.",
