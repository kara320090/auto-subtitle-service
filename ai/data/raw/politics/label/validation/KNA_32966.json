        "term": [
            {
                "speaker_id": "1",
                "transcription": "8층 높이의 구청 주차 빌딩이 현수막으로 덮였습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.921
            },
            {
                "speaker_id": "1",
                "transcription": "가로 15미터 세로 21미터 이런 크기면 제작비는 400만원 정도 듭니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.931,
                "end": 9.761
            },
            {
                "speaker_id": "1",
                "transcription": "행복한 구를 강조하지만 정작 시민들의 반응은 차갑습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.771,
                "end": 15.089
            },
            {
                "speaker_id": "2",
                "transcription": "왜 저기다가 저 수백만 원을 들여 갖고 저렇게 해놔요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.099,
                "end": 18.679
            },
            {
                "speaker_id": "2",
                "transcription": "국민들 세금 뜯어 가지고.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.689,
                "end": 20.451
            },
            {
                "speaker_id": "1",
                "transcription": "역시 대형 현수막이 걸린 이곳 가린 건물은 구청 주민센터입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.461,
                "end": 25.180
            },
            {
                "speaker_id": "1",
                "transcription": "이 구청의 주민센터는 18곳.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.190,
                "end": 28.533
            }
        ]
    },
    "summary": "정부가 공공기관 건물에 대형 현수막을 거는 비용이 커서 시민들이 불만을 표했다.",
