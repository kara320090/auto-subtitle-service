        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "청와대는 추미애 민주당 대표가 박근혜 대통령에게 제안한 긴급 영수 회담을 수용했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.242
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 청와대 대변인은 박 대통령이 추 대표의 제안을 수용했으며 내일 회담의 구체적인 시간 등을 조율 중이라고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.252,
                "end": 15.401
            },
            {
                "speaker_id": "1",
                "transcription": "추 대표는 앞서 지난 12일 촛불 집회 이후 대통령 퇴진 여론이 커진 상황에서 청와대 난국을 헤쳐나가기 위한 만남이 필요하다고 보고 긴급 회담을 요청했다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.411,
                "end": 28.253
            },
            {
                "speaker_id": "1",
                "transcription": "새누리당은 야 3당 모두가 참여하는 영수 회담에 대한 아쉬움은 있지만 꽉 막힌 정국을 푸는 단추가 되길 바란다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.263,
                "end": 37.107
            },
            {
                "speaker_id": "1",
                "transcription": "또 회담 결과를 지켜보고 새누리당이 정국 안정화에 기여할 역할이 있다면 적극적으로 뒷받침하겠다고 덧붙였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.117,
                "end": 45.932
            },
            {
                "speaker_id": "1",
                "transcription": "다른 야당들은 일제히 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.942,
                "end": 48.850
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 당은 박 대통령과 추 대표의 회동 합의에 대해 대단히 유감스럽고 잘못된 결정이라고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.860,
                "end": 56.657
            },
            {
                "speaker_id": "1",
                "transcription": "박지원 국민의 당 비상 대책 위원장은 추 대표의 진위가 어디에서 출발했는지 또 촛불 민심을 알고 있는지 의아하다고 비난하면서 야권 공조를 튼튼히 하는 게 옳은 일이라고 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.667,
                "end": 69.566
            }
        ]
    },
    "summary": "민주당 추미애 대표는 청와대 난국을 헤쳐나가기 위해 박근혜 대통령에게 긴급 회담을 요청했는데 청와대가 이 제안을 수용했으며 새누리당은 회담 결과를 지켜보다가 정국 안정화에 기여할 역할이 있으면 적극적으로 뒷받침하겠다고 밝혔고 다른 야당들은 긴급 영수 회담에 대해 유감스럽고 잘못된 결정이라며 일제히 비판했습니다.",
