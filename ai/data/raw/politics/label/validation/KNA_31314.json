        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 오늘 오전 열 9시 반부터 11시 반까지 금강산 호텔에서 있었던 작별 상봉 지금은 모두 끝이 났습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.458
            },
            {
                "speaker_id": "1",
                "transcription": "들어온 화면을 보고 계신데요.",
                "sound_type": [
                    2
                ],
                "start": 6.468,
                "end": 8.124
            },
            {
                "speaker_id": "1",
                "transcription": "이 @이름1 씨는 남북자 가족입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.134,
                "end": 12.106
            },
            {
                "speaker_id": "1",
                "transcription": "이 1972년에 오대양 62호 선원이었던 당시 21살 아들이었는데 이제는 64이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.116,
                "end": 18.605
            },
            {
                "speaker_id": "1",
                "transcription": "셋째 아들 @이름1 씨를 만나면서 그야말로 3일 내내 이 어머니 우셨거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.615,
                "end": 23.674
            },
            {
                "speaker_id": "1",
                "transcription": "예 오늘도 눈물을 보이고 계십니다.",
                "sound_type": [
                    2
                ],
                "start": 23.684,
                "end": 26.443
            },
            {
                "speaker_id": "2",
                "transcription": "그렇군요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.453,
                "end": 28.100
            }
        ]
    },
    "summary": "그녀는 남북 가족 상봉의 순간을 설명하고 있다.",
