        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번 정부 대책의 방향성에 대해서는 의료계를 포함해 대부분 공감하는 분위기입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.551
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 세부 항목에서는 앞으로 해결해야 할 부분이 적지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.561,
                "end": 10.212
            },
            {
                "speaker_id": "1",
                "transcription": "우선 각 지역에서 거점 역할을 하는 국립대병원에 대한 지원 문제입니다.",
                "sound_type": [
                    2
                ],
                "start": 10.222,
                "end": 15.841
            },
            {
                "speaker_id": "1",
                "transcription": "소관 부처가 교육부에서 복지부로 바뀌면서 예산이나 인력에 대한 규제가 완화되는 건 긍정적이지만 늘어나는 인력과 예산이 필수 의료 분야에 직접 투입되는 게 중요합니다.",
                "sound_type": [
                    2
                ],
                "start": 15.851,
                "end": 28.194
            }
        ]
    },
    "summary": "정부 대책에 대해 의료계를 포함 대부분 공감하는 분위기이지만 지역의 국립대병원에 대한 지원 문제 등 해결해야 할 부분이 적지 않다고 했다.",
