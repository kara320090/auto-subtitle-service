        "term": [
            {
                "speaker_id": "1",
                "transcription": "새누리당 김무성 대표는 공무원연금 개혁안 후퇴 논란과 관련해 비판을 겸허히 수용하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.848
            },
            {
                "speaker_id": "1",
                "transcription": "공무원연금의 재정절감 효과에 대한 우려를 보완하고 공적연금 강화도 국가재정을 고려해 국민이 원하는 방향으로 진행하겠다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.858,
                "end": 18.794
            },
            {
                "speaker_id": "1",
                "transcription": "유승민 원내대표도 국민연금 소득대체율을 50퍼센트로 높이는 건 국민적 동의와 사회적 합의가 대원칙이라며 선을 그었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.804,
                "end": 29.060
            },
            {
                "speaker_id": "1",
                "transcription": "서청원 최고위원은 배보다 배꼽이 큰 담합은 국민에게 재앙이 될 수 있고 합의를 지키지 않을 경우 당도 지뢰를 밟은 것일 수 있다며 협상 결과를 공개 질타했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.070,
                "end": 42.866
            }
        ]
    },
    "summary": "국민연금 소득대체율을 50퍼센트까지 높이기로 한 것에 대해 새누리당은 국민연금 강화는 사회적 합의가 먼저라고 선을 그었다.",
