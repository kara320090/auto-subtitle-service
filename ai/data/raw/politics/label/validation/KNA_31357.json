        "term": [
            {
                "speaker_id": "1",
                "transcription": "자매",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 0.545
            },
            {
                "speaker_id": "2",
                "transcription": "네 자매가 만난 네 북의 세 여동생이죠.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.555,
                "end": 8.049
            },
            {
                "speaker_id": "2",
                "transcription": "보고싶었던 어 언니를 65년 만에 만났는데 제대로 얘기도 나누지 못하고 떠난다면서 아쉬워했던 가족입니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 8.059,
                "end": 16.830
            },
            {
                "speaker_id": "3",
                "transcription": "네.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 16.840,
                "end": 20.495
            },
            {
                "speaker_id": "2",
                "transcription": "저기 맨 왼쪽에 언니 @이름1 씨의 모습이 보이네요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 20.505,
                "end": 29.942
            },
            {
                "speaker_id": "1",
                "transcription": "아까 네 자매도 이렇게 나란히 같이 앉아서 사진 찍으시는데 너무 닮았겠어요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 29.952,
                "end": 34.045
            },
            {
                "speaker_id": "2",
                "transcription": "네 아 한 가족이구나 싶은 사연이죠.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 34.055,
                "end": 40.249
            },
            {
                "speaker_id": "3",
                "transcription": "아마 이 TV를 보면서 지금 6만여 명의 대기자분들 남은 이산가족들이 참 어떻게 보면 또 부럽기도 하고 그랬을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 40.259,
                "end": 48.193
            },
            {
                "speaker_id": "3",
                "transcription": "나간 분들은 사실 생사 확인만이라도 좀 해달라고 요구하는데요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 48.203,
                "end": 51.332
            },
            {
                "speaker_id": "2",
                "transcription": "그렇죠.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 51.342,
                "end": 52.788
            },
            {
                "speaker_id": "2",
                "transcription": "사실은 생사 확인도 아까 말씀하신 것처럼 의지의 문제입니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 52.798,
                "end": 57.282
            },
            {
                "speaker_id": "2",
                "transcription": "생사 확인을 하려면 할 수도 있을 텐데 남북 간의 의지가 가장 중요하고요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 57.292,
                "end": 61.717
            },
            {
                "speaker_id": "2",
                "transcription": "또 북측 같은 경우에는 저렇게 100명씩 만나도 사실은 우리보다는 어 전산망이라든가 통신망이 발달돼있지 않기 때문에 좀 찾는데 시간도 더 걸린다는 말도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 61.727,
                "end": 75.614
            },
            {
                "speaker_id": "1",
                "transcription": "약간 못되게 말씀하시는 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 75.624,
                "end": 84.433
            }
        ]
    },
    "summary": "이산가족들은 헤어지면서 아쉬워했고 북한의 경우 전산망이나 통신망이 우리보다는 발달돼있지 않기 때문에 이산가족을 찾는데 시간이 더 걸린다는 말이 있다.",
