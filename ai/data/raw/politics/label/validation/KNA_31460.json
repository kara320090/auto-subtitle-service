        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안철수 전 대표를 따르는 새정치연합 의원들이 이르면 내일 동반 탈당할 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.802
            },
            {
                "speaker_id": "1",
                "transcription": "안 전 대표의 측근인 문병우 의원은 자신과 전남 전북 도당 위원장인 황주홍 유성열 의원이 내일 동반 탈당할 것이라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.812,
                "end": 15.755
            },
            {
                "speaker_id": "1",
                "transcription": "다만 황 의원 등이 탈당 전 지역 주민들을 만나야 한다며 일정 연기를 요청하고 있어서 하루 이틀 연기될 가능성도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.765,
                "end": 24.177
            },
            {
                "speaker_id": "1",
                "transcription": "문 의원은 또 이번 주말 한두 명이 더 탈당할 것으로 예상되고 연말까지는 20명 정도가 탈당할 것이라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.187,
                "end": 32.906
            },
            {
                "speaker_id": "1",
                "transcription": "비주류 구당 모임은 어젯밤 회동을 갖고 당의 분열에 대해 문재인 대표의 무한 책임을 요구하기로 했고 박지원 의원은 문 대표의 사퇴를 촉구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.916,
                "end": 43.354
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 비주류 모임인 민진모와 호남 비주류 의원들이 각각 회동하는데 이들의 추가 탈당 여부가 독자 세력화 여부의 관건이 될 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.364,
                "end": 53.269
            },
            {
                "speaker_id": "1",
                "transcription": "당내에서는 야권 분열은 총선 필패라는 위기 의식도 적지 않아 실제 탈당 규모는 크지 않을 것이라는 분석도 나오고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.279,
                "end": 62.696
            },
            {
                "speaker_id": "1",
                "transcription": "새정치연합은 오늘 오후 의원 총회와 중앙위원회를 잇따라 열고 위기 수습 방안을 집중 논의하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.706,
                "end": 70.547
            },
            {
                "speaker_id": "1",
                "transcription": "이틀 간 당무을 쉬고 정부 구상을 하겠다던 문재인 대표는 오늘 오전 어머니를 만나러 간다며 부산으로 향했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 70.557,
                "end": 78.197
            },
            {
                "speaker_id": "1",
                "transcription": "안철수 전 대표는 내일과 오늘 17일 각각 부산과 광주에서 기자 간담회 등을 갖고 탈당 배경과 향후 계획을 설명할 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 78.207,
                "end": 88.148
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 88.158,
                "end": 91.200
            }
        ]
    },
    "summary": "안철수 전 대표는 뜻을 같이 하는 의원들과 함께 새정치연합에서 탈당하기로 하고 부산과 광주 기자 간담회에서 탈당 배경과 향후 계획을 설명할 예정입니다.",
