        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "회의를 마친 뒤 @이름1 본부장은 회의에 만족감을 표시하면서 북미 실무 협상이 개최되도록 노력하기로 했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.669
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 회의 내용도 공개했는데요. 우선 26일로 예정된 남북 철도 도로 착공식에 사용될",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.679,
                "end": 12.770
            },
            {
                "speaker_id": "1",
                "transcription": "각종 물자에 대한 제재를 적용하지 않기로 원칙적인 합의를 했습니다. 예정대로 열린다는 뜻입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.780,
                "end": 18.648
            },
            {
                "speaker_id": "1",
                "transcription": "회의에 앞서 조명규 통일부 장관과 면담한 비건 대표는 이 남북 철도 사업에 깊은 관심을 보였고 또 평화의 문을 열어 놓고 있다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.658,
                "end": 27.663
            },
            {
                "speaker_id": "1",
                "transcription": "이밖에 어 이산가족 화상 상봉과 북한 양노장 현대화 사업",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.673,
                "end": 32.353
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 남북 간 국제 항공로 신설에 대해서도 전형적으로 진행하기로 한 것으로 알려졌습니다. 또 어 남북 간 유해 발굴도 차질 없이 진행하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.363,
                "end": 41.047
            },
            {
                "speaker_id": "1",
                "transcription": "관심을 모았던 800만 달러의 인도적 대북 지원 여부도 @이름1 본부장은 지원할 수 있게 됐다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.057,
                "end": 47.837
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 지난해 9월 유니세프와 세계 식량 기획에 북한 모자보건 영양 지원 사업에 800만 달러를 공유하는 방안을 의결했지만 아직 집행하지 않고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.847,
                "end": 57.696
            },
            {
                "speaker_id": "1",
                "transcription": "어 비건 대표는 오후에 정의용 국가안보실장과 면담할 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.706,
                "end": 61.658
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 통일 외교부에서 전해드렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.668,
                "end": 65.033
            }
        ]
    },
    "summary": "비건 대표는 이산가족 화상 상봉, 남북 간 국제 항공로 신설 등을 진행하고 800만 달러의 인도적 대북 지원 여부에 대해서도 지원이 가능할 것이라고 밝혔다.",
