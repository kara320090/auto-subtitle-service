        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 대해 김 씨는 한 씨를 알지도 못하며 대선 때 홍문종 의원과 관련 있는 일을 하지도 않았다며 의혹을 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.932
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 조만간 김 씨를 소환해 조사할 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.942,
                "end": 11.352
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.362,
                "end": 14.386
            },
            {
                "speaker_id": "2",
                "transcription": "이번에는 @이름2 청와대 전 교육문화수석과 관련한 수사 속보입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.396,
                "end": 19.427
            },
            {
                "speaker_id": "2",
                "transcription": "검찰이 어젯밤 박 전 수석에 대해 사전구속영장을 청구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.437,
                "end": 23.637
            },
            {
                "speaker_id": "2",
                "transcription": "적용된 혐의는 직권남용과 업무상 횡령, 배임, 사기와 뇌물수수, 사립학교법 위반 등 총 6가지입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.647,
                "end": 31.814
            },
            {
                "speaker_id": "2",
                "transcription": "박 전 수석은 청와대에 재직하던 2011년에서 2012년 본교와 분교 통합, 적십자 간호대 인수 등 중앙대의 역점 사업들을 원활하게 추진하라며 교육부 고위 관료들에게 압력을 행사한 혐의 등을 받고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.824,
                "end": 45.494
            },
            {
                "speaker_id": "2",
                "transcription": "검찰은 박 전 수석에 대한 구속영장이 발부되면 중앙대 이사장이었던 @이름3 전 두산 회장을 소환 조사하는 방안을 검토하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 45.504,
                "end": 55.400
            }
        ]
    },
    "summary": "검찰은 박 전 청와대 교육문화수석에 대해 직권남용 및 업무상 횡령 등 6개의 혐의로 구속영장을 청구했고 중앙대 이사장이었던 박 전 회장도 소환 조사할 계획이다.",
