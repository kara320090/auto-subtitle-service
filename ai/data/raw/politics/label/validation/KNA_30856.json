        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 서울대 병원장은 지난해 7월 @이름2 경제수석과 만난 자리에 @이름3의 단골 성형외과 원장 부인 박 모 씨가 함께 있다고 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.024
            },
            {
                "speaker_id": "1",
                "transcription": "@이름4 당시 서울대 병원장이 안 전 수석을 소개해 달라고 요청해 자리를 만들었는데 그 자리에 @이름5 원장 부인 박 모 씨가 함께 있었다고 말했다고 서울대 병원 관계자가 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.034,
                "end": 21.803
            },
            {
                "speaker_id": "1",
                "transcription": "@이름4 당시 병원장과 박 대표는 잘 모르는 사이였기 때문에 박 대표는 안 전 수석이 데려온 것으로 보인다는 게 서 병원장 주장이라고 이 관계자는 전했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.813,
                "end": 33.029
            },
            {
                "speaker_id": "1",
                "transcription": "박 씨는 김 원장 일가가 운영하는 성형 수술실 제작 업체의 대표입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.039,
                "end": 38.212
            },
            {
                "speaker_id": "1",
                "transcription": "이에 대해 박 모 대표 측은 서 원장과 안 전 수석을 만났지만 안 전 수석으로부터 참여 권유를 받지 않았다고 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.222,
                "end": 46.933
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 원장은 또 지난해 3월 박 대표를 만나기 전 알고 지내던 순천향대 병원 이 모 교수가 박 씨를 만나 보라고 추천했다고 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.943,
                "end": 56.743
            },
            {
                "speaker_id": "1",
                "transcription": "이 교수는 @이름3 자매를 오랫동안 진료하고 @이름6 씨가 출산한 뒤에도 도움을 준 것으로 알려져 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.753,
                "end": 64.599
            }
        ]
    },
    "summary": "서울대 병원장은 지난해 7월 경제수석과 만난 자리에 성형외과 원장 부인 박 모 씨가 함께 있었다고 안 전 수석이 데려온 것으로 보인다며 주장했고 이에 대해 박 모 대표 측은 안 전 수석으로부터 참여 권유를 받지 않았다고 주장했다.",
