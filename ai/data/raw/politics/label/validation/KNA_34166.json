        "term": [
            {
                "speaker_id": "1",
                "transcription": "문재인 대통령이 지진 피해가 발생한 지 닷새 만에 포항시를 특별 재난 지역으로 지정하도록 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.874
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령은 오늘 수석 비서관 보좌관 회의를 주재한 자리에서 이 같이 밝히고 모든 행정력을 동원해 신속한 피해 복구와 차질 없는 입시 일정을 위해 최선을 다하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.884,
                "end": 19.782
            },
            {
                "speaker_id": "2",
                "transcription": "당장은 피해 복구와 차질 없는 수능 실시가 최우선입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.792,
                "end": 25.810
            },
            {
                "speaker_id": "2",
                "transcription": "긴급한 일이 끝나면 안전과 재난에 대한 대비를 전면적으로 점검하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.820,
                "end": 33.312
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령은 오는 23일로 연기된 수능과 관련해 여진 등 모든 가능성에 대비해 지침을 미리 마련해 주겠다면서 수험생과 핵심들로 수험장에서 이루어지는 조치에 따라 달라고 당부했습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.322,
                "end": 47.230
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 추운 날씨와 여진의 공포 속에 집을 떠나 힘든 생활을 하는 포항과 인근 주민들, 수험생들에게 위로를 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.240,
                "end": 56.300
            }
        ]
    },
    "summary": "문재인 대통령이 포항을 특별 재난 지역으로 선포하고 수능에 차질이 없도록 하겠다고 했다.",
