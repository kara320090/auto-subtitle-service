        "term": [
            {
                "speaker_id": "1",
                "transcription": "박근혜 대통령은 급여와 인세 등으로 1년 만에 2억 7000만 원 늘어난 28억 3000만 원을 신고했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.102
            },
            {
                "speaker_id": "1",
                "transcription": "정홍원 국무총리의 재산은 지난 2012년과 비슷한 18억 8000만 원으로 나타났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.112,
                "end": 13.421
            },
            {
                "speaker_id": "1",
                "transcription": "현오석 기획 재정부 장관 등 장관급 인사 24명의 평균 재산은 15억 9000만 원이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.431,
                "end": 20.723
            },
            {
                "speaker_id": "1",
                "transcription": "중앙 지방정부 고위 공직자의 평균 재산은 11억 9800만 원으로 1년 전에 비해 2800만 원이 늘었습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 20.733,
                "end": 28.736
            },
            {
                "speaker_id": "1",
                "transcription": "고위 법관과 헌법 재판관 등 사법부 고위 인사도 10명 중 4명꼴로 재산이 늘었습니다.",
                "sound_type": [
