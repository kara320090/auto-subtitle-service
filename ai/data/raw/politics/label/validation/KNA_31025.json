        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 @이름1 특별검사팀이 김기춘 전 대통령 비서실장 등 핵심 수사대상자 여러 명에 대해 출국을 금지했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.726
            },
            {
                "speaker_id": "1",
                "transcription": "앞선 검찰 수사 때 출국금지 조치가 내려지지 않은 관련자들이 그 대상입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.736,
                "end": 12.036
            },
            {
                "speaker_id": "1",
                "transcription": "수차례 청와대를 드나든 성형외과 원장 @이름2 씨, 박 대통령의 자문의를 맡았던 @이름3 씨 등도 출금 대상에 포함된 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.046,
                "end": 20.826
            },
            {
                "speaker_id": "1",
                "transcription": "@이름4 특검보는 청와대 관저도 필요하다면 압수수색하는 방안을 강구하겠다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.836,
                "end": 26.756
            },
            {
                "speaker_id": "1",
                "transcription": "또 대기업들도 필요하다면 추가 압수수색을 할 수 있다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.766,
                "end": 31.075
            },
            {
                "speaker_id": "1",
                "transcription": "이 특검보는 이번 주말까지는 기록 검토를 끝내겠다고 말해 이르면 다음 주 초 압수수색이나 관련자 소환 등 본격 수사가 시작될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 31.085,
                "end": 40.096
            },
            {
                "speaker_id": "1",
                "transcription": "특검팀은 국회 국정조사 특위 청문회에 출석한 증인들의 위증 논란에 대해서도 위증 여부를 심도있게 지켜보고 있으며 필요하다면 수사 대상에 포함하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.106,
                "end": 51.148
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 서울 대치동 특검 사무실에서 KBS 뉴스 @이름5입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.158,
                "end": 56.300
            }
        ]
    },
    "summary": "@이름1 특별검사팀이 김 전 비서실장 등 주요 수사대상자의 출국을 금지하고 청와대와 대기업들의 압수수색 가능성을 언급한 가운데 다음 주에는 본격적인 수사에 돌입할 것으로 보인다.",
