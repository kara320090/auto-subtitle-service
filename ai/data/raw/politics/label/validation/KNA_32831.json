        "term": [
            {
                "speaker_id": "1",
                "transcription": "왜 항일 독립운동한 공간을 다 역사를 없애려고 그러세요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.575
            },
            {
                "speaker_id": "1",
                "transcription": "그게 독립운동이 없으면 우리나라 광복도 없는 거고 지금 현재 대한민국이 없는 건데 그 뿌리를 다 무시하고 왜곡하고",
                "sound_type": [
                    2
                ],
                "start": 3.585,
                "end": 11.569
            },
            {
                "speaker_id": "2",
