        "term": [
            {
                "speaker_id": "1",
                "transcription": "경기도 지사 선거도 중진 차출론이 현실화되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.081
            },
            {
                "speaker_id": "1",
                "transcription": "출마 권유를 강하게 받고 있는 새누리당 @이름1 의원의 출마는 초읽기에 들어갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.091,
                "end": 10.343
            },
            {
                "speaker_id": "2",
                "transcription": "지방선거에서 경기도가 중요하고 그래서 반드시 승리해야겠다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.353,
                "end": 17.058
            },
            {
                "speaker_id": "1",
                "transcription": "야권에서는 @이름2 경기 교육감의 출마 여부가 변수가 되고 있습니다.",
                "sound_type": [
                    2,
                    5
