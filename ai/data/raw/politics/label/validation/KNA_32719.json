            },
            {
                "speaker_id": "1",
                "transcription": "투표가 끝나면 투표함들은 이곳 인근에 있는 개표소로 옮겨져 곧바로 개표가 진행되고 당선자는 결정되는 즉시 임기를 시작합니다.",
                "sound_type": [
