        "term": [
            {
                "speaker_id": "1",
                "transcription": "김 실장 국민 앞에서 겸손해지고 국민 앞에 진실을 말하십시오.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.937
            },
            {
                "speaker_id": "2",
                "transcription": "개인 정보를 물으면서 생방송 도중 휴대전화 번호가 유출되기도 했습니다.",
                "sound_type": [
