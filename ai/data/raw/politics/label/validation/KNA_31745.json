        "term": [
            {
                "speaker_id": "1",
                "transcription": "서울 중앙 지검 특수 1부는 오늘 철도 부품 업체로부터 청탁과 함께 6500만 원을 받은 혐의로 새누리당 송광호 의원을 불구속 기소했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 10.403
            },
            {
                "speaker_id": "1",
                "transcription": "또 특수 2부도 새정치민주연합 신계륜, 신학용 의원을 불구속 기소했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.413,
                "end": 15.857
            },
            {
                "speaker_id": "1",
                "transcription": "두 의원은 서울 종합 예술 실용 학교 @이름1 이사장으로부터 학교 이름을 변경할 수 있도록 법을 바꿔주고 수천만 원의 금품을 받은 혐의 등으로 검찰 조사를 받아왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.867,
                "end": 27.070
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 송광호 의원은 국회에서 체포 동의안이 부결됐으며 신계륜, 신학용 의원의 경우 법원에서 구속영장이 기각됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.080,
                "end": 35.931
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 이들 3명의 의원을 일괄적으로 불구속 기소하지만 관련 증거를 충분히 확보한 만큼 혐의 입증에는 문제 없다는 입장입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.941,
                "end": 45.360
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 조현룡, 박상은, 김재윤 의원이 구속 기소된 데 이어 오늘 나머지 의원 3명을 불구속 기소함에 따라 칠삼공 재보선 뒤 본격화됐던 이른바 비리 의원들에 대한 검찰 수사는 마무리됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.370,
                "end": 58.979
            },
            {
                "speaker_id": "1",
                "transcription": "이번 수사는 내용 면에서 그동안 정치권의 관행으로 여겨져 온 출판 기념회나 입법 로비 등에 칼을 들이댔다는 점에서 주목받아왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 58.989,
                "end": 68.233
            },
            {
                "speaker_id": "1",
                "transcription": "또 검찰이 수사 대상 의원 6명 가운데 3명을 구속하는 과정에서 강제 구인에 나서고 체포 동의안이 국회에서 부결되면서 의원들의 불체포 특권에 대한 논란이 수면 위로 떠오르기도 했습니다.",
                "sound_type": [
                    2,
