        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 검사 독재 정권의 폭거다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.186
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 부당한 영장 청구이자 정치 영장이다.",
                "sound_type": [
                    2
                ],
                "start": 4.196,
                "end": 9.396
            },
            {
                "speaker_id": "2",
                "transcription": "아울러 민주당은 한덕수 국무총리 해임안을 국회에 내고 대통령실 앞에서 규탄 집회를 여는 등 대정부 투쟁 기조를 뚜렷이 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.406,
                "end": 20.986
            },
            {
                "speaker_id": "2",
                "transcription": "다만 이르면 오는 21일 이재명 대표 체포 동의안에 대한 국회 표결을 앞두고 계파 갈등의 재점화 가능성도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.996,
                "end": 29.042
