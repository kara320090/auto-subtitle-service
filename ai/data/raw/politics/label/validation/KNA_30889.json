        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "특위위원들은 김영환 메모는 사실상 김기춘 지시사항이었다며 청문회 시작부터 몰아붙였지만 김 전 실장은 의혹을 전면 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.551
            },
            {
                "speaker_id": "2",
                "transcription": "시신 인양을 했을 경우에는 정부 책임과 부담으로 돌아온다라는 얘기를 당시 김기춘 비서실장 증인께서 했고",
                "sound_type": [
                    2
                ],
                "start": 9.561,
                "end": 20.200
            },
            {
                "speaker_id": "3",
                "transcription": "저는 그렇게 얘기한 일이 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.210,
                "end": 23.352
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식의 답변이 이어지자 여당 위원까지 나서 태도를 지적했지만",
                "sound_type": [
                    2
                ],
                "start": 23.362,
                "end": 27.546
            },
            {
                "speaker_id": "4",
                "transcription": "아 비망록에 다 있는데",
                "sound_type": [
                    2
                ],
                "start": 27.556,
                "end": 29.317
            },
            {
                "speaker_id": "3",
                "transcription": "아 비망록에",
                "sound_type": [
                    2
                ],
                "start": 29.327,
                "end": 30.684
            },
            {
                "speaker_id": "4",
                "transcription": "다 돌아가신 분이 다 거짓으로 적었습니까?",
                "sound_type": [
                    2
                ],
                "start": 30.694,
                "end": 32.747
            },
            {
                "speaker_id": "1",
                "transcription": "김 전 실장은 메모에 김영환 전 수석의 주관이나 생각이 담겼을 수도 있다며 끝내 물러서지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.757,
                "end": 39.693
            },
            {
                "speaker_id": "3",
                "transcription": "노트에 있다고 해서 모두 제가 알고 있는 사실이라고는 생각하지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.703,
                "end": 45.857
            },
            {
                "speaker_id": "1",
                "transcription": "김기춘 전 실장이 향후 특검수사에 대비해 철저히 계산된 답변만 했을 것이란 관측이 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.867,
                "end": 52.833
            }
        ]
    },
    "summary": "특위위원들은 김영환 메모에 대해 김 전 실장을 몰아붙였으나 김 전 실장은 의혹을 부인하며 모르쇠로 일관했다.",
