        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 치솟는 달걀 값을 안정시키기 위해 수급 안정 대책을 논의 중입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.279
            },
            {
                "speaker_id": "1",
                "transcription": "정부와 새누리당은 오늘 오전 긴급 민생 경제 현안 점검 회의를 열고 달걀을 수입하는 업체에 운송비 50퍼센트를 지원하기로 했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.289,
                "end": 15.208
            },
            {
                "speaker_id": "1",
                "transcription": "또 신선란 등 일부 달걀에 대해서는 할당 관세를 적용해 현재 27퍼센트인 관세율을 물리지 않는 방안도 추진하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.218,
                "end": 24.449
            },
            {
                "speaker_id": "1",
                "transcription": "국내 산란계의 20퍼센트가 넘게 매몰 처분되면서 달걀 공급이 줄어들게 되자 달걀 가격이 몇 차례 오르고 구매 제한 조치까지 취해지면서 나온 대책입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.459,
                "end": 35.296
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 미국과 캐나다 등 달걀을 수입할 수 있는 AI 청정국의 달걀 값이 국내보다 3배 이상 높은 데다가 비싼 항공편을 통해 운송해야 하는데 수입 업체들이 달걀 수입에 나설지는 미지수입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.306,
                "end": 49.444
            },
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 농식품부와 공정위는 달걀 유통 과정에서 일부 수집 판매상이 사재기하고 있다는 의혹이 있어 이에 대한 실태 조사에 나서기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.454,
                "end": 59.746
            },
            {
                "speaker_id": "1",
                "transcription": "또 달걀 값 담합 여부도 파악하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.756,
                "end": 62.750
            },
            {
                "speaker_id": "1",
                "transcription": "황교안 대통령 권한 대행도 AI 점검 회의를 주재한 자리에서 산란계 농장과 오염 지역을 중심으로 한 철저한 방역을 주문했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.760,
                "end": 72.300
            }
        ]
    },
    "summary": "정부와 새누리당은 달걀 값 안정을 위해 운송비를 지원하기고 관세율을 물리지 않는 방안도 추진하기로 했으며 농식품부와 공정위는 사재기에 대한 실태 조사에 나서기로 했다.",
