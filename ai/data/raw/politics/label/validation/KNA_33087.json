        "term": [
            {
                "speaker_id": "1",
                "transcription": "화천대유 대주주 @이름1 씨가 오늘 밤 자정 이후 석방됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.197
            },
            {
                "speaker_id": "1",
                "transcription": "서울 중앙지법 형사합의 22부는 @이름1 씨에 대한 구속 영장 심문을 한 결과 김 씨에 대해 추가 구속 영장을 발부하지 않기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.207,
                "end": 13.351
            },
            {
                "speaker_id": "1",
                "transcription": "법원은 구속 영장을 발부하지 않은 이유에 대해 따로 밝히지 않았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.361,
                "end": 17.946
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 내일로 구속 기한이 끝나는 김 씨는 이르면 내일 새벽 0시 이후에 나올 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.956,
                "end": 24.618
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 오전 김 씨에 대한 구속 영장 심문에선 검찰과 김 씨 변호인 측이 추가 구속 필요성을 놓고 공방을 벌였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.628,
                "end": 32.907
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 김 씨에 대해 횡령과 이해 충돌 방지법 위반 혐의로 구속 영장을 청구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.917,
                "end": 38.578
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 김 씨가 석방되면 증거를 인멸할 우려가 있다는 건 삼척동자도 알 수 있다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.588,
                "end": 45.912
            }
        ]
    },
    "summary": "검찰은 화천대유 대주주 김 씨에 대한 구속 영장 심문 결과 추가 구속 영장을 발부하지 않기로 해 오늘 밤 자정이 이후 석방된다고 밝혔다.",
