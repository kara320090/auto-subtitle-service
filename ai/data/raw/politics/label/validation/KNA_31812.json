        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부는 오늘 경제 관계 장관 회의를 열어 이 같은 계획을 확정했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.476
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 중소기업과 중견기업에 대한 정책 금융과 설비 투자 펀드를 확대하고 공공 기관이 부채를 줄인 돈을 시설에 투자하도록 유도하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.486,
                "end": 16.598
            },
            {
                "speaker_id": "1",
                "transcription": "또 소비를 활성화하기 위해 주요 도시에 시내 면세점을 추가로 허용하고 다주택자도 주택 연금에 가입할 수 있도록 할 방침입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.608,
                "end": 26.269
            },
            {
                "speaker_id": "1",
                "transcription": "이 밖에 중소기업과 소상공인이 근로자에게 임금을 체불하지 않도록 500억 원 한도로 자금을 지원하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.279,
                "end": 35.053
            },
            {
                "speaker_id": "1",
                "transcription": "엔화 약세 현상에도 적극 대응하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.063,
                "end": 38.613
            },
            {
                "speaker_id": "1",
                "transcription": "일본에 대한 수출 비중이 20퍼센트가 넘는 중소기업 4000여 곳에 대해선 환 변동 보험에 가입하도록 보험료 부담을 절반으로 줄이고 연말까지 1조 원 이상의 정책 자금을 지원하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
