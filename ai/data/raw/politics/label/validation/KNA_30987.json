        "term": [
            {
                "speaker_id": "1",
                "transcription": "저희들이 대포차로 추정을 해서",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.323
            },
            {
                "speaker_id": "2",
                "transcription": "정확한 현황 파악도 이뤄지지 않고 있는 외국인 대포차 도로 위의 흉기가 되고 있습니다.",
                "sound_type": [
