        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 대해 박영선 새정치민주연합 원내 대표는 박근혜 정부가 부의 대물림을 장려하는 부자 지킴이 정권이라고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.210
            },
            {
                "speaker_id": "1",
                "transcription": "박 원내 대표는 원내 대책 회의에서 정부가 대기업 세금 감면은 고집하면서 서민 증세로 재정 적자를 메우려 한다며 이렇게 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.220,
                "end": 17.246
            },
            {
                "speaker_id": "1",
                "transcription": "문희상 새정치연합 비대 위원장은 오늘 오후 당 소속 의원들과 광역 자치단체장 등이 참석한 확대 회의에서 새 비대위 출범을 공식 선언합니다.",
                "sound_type": [
                    2,
                    5
                ],
