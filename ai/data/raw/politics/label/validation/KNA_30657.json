        "term": [
            {
                "speaker_id": "1",
                "transcription": "제 거입니다 예.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.065
            },
            {
                "speaker_id": "2",
                "transcription": "중국에서 어디에 있었습니까 그동안?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.075,
                "end": 3.075
            },
            {
                "speaker_id": "1",
                "transcription": "상하이하고 청도에 있었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.084,
                "end": 4.694
            },
            {
                "speaker_id": "3",
                "transcription": "일본에는 다녀오지 않으셨습니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.704,
                "end": 6.260
            },
            {
                "speaker_id": "1",
                "transcription": "네 잠시 다녀왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.270,
                "end": 7.642
            },
            {
                "speaker_id": "3",
                "transcription": "국정 농단 의혹에 대해서 어떻게 생각하십니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.640,
                "end": 10.510
            },
            {
                "speaker_id": "1",
                "transcription": "네 진심으로 제가 물의를 일으켜드려 너무나 죄송하고.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.520,
                "end": 16.066
            },
            {
                "speaker_id": "4",
                "transcription": "안종범 씨하고 잘 아나요?",
