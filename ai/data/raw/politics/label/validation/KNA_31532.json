        "term": [
            {
                "speaker_id": "1",
                "transcription": "비상대책위원장 선임 문제를 논의하는 새누리당 의원총회에서 의원들 간 격론이 벌어지고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.191
            },
            {
                "speaker_id": "1",
                "transcription": "비박계 중심의 비주류 측이 유승민 의원을 비대위원장에 추천한 것을 놓고 주류 측이 오히려 갈등을 키울 후보라며 반발하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.201,
                "end": 14.883
            },
            {
                "speaker_id": "1",
                "transcription": "비주류 측 의원들도 비주류 측 추천을 받아 정하겠다고 해 놓고 다른 소리를 하고 있다고 반박하는 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.893,
                "end": 22.274
            },
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 정 원내대표는 모두 발언을 통해 친박의 해체를 요청드린다며 소위 친박 실세라고 불리는 몇 분들은 2선 후퇴 백의종군해주실 것을 정중하지만 강력히 요청하겠다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.284,
                "end": 35.431
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 비대위원장엔 당 외부 인사도 가능하다며 왜 유 의원이 꼭 비상대책위원장을 해야 하는지 답변을 요구한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.441,
                "end": 44.135
            },
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 새누리당 중도성향 의원 모임은 유 의원을 비대위원장으로 선출하는 데 뜻을 모았다고 이주영 의원이 전했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.145,
                "end": 51.901
            },
            {
                "speaker_id": "1",
                "transcription": "주류와 비주류 측이 서로 한 발도 물러서지 않으면서 집단 탈당 가능성이 높아졌다는 관측이 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.911,
                "end": 59.103
            },
            {
                "speaker_id": "1",
                "transcription": "한편 새누리당 친박 주류 모임인 혁신과 통합 보수연합은 앞으로 친박을 의미하는 어떤 모임도 구성하지 않겠다며 오늘 해산을 선언했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.113,
                "end": 69.191
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
