        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "정당 지지율은 경북 김천에서만 한국당이 오차범위내 1위였는데요",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.157
            },
            {
                "speaker_id": "1",
                "transcription": "다만 전 지역에서 지지 후보가 없다거나 모르겠다는 응답이 40퍼센트 안팎으로 나타났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.167,
                "end": 12.820
            },
            {
                "speaker_id": "1",
                "transcription": "이번 국회의원 재보궐 선거에서 특이한 것은 12곳 전체에서 꼭 투표를 하겠다는 응답이 평균 78퍼센트 수준으로 비교적 높은 투표 참여 의지를 나타냈다는 건데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.830,
                "end": 25.503
            },
            {
                "speaker_id": "1",
                "transcription": "이번 조사는 KBS와 MBC SBS가 칸타 퍼블릭과 코리아 리서치센터 한국 리서치에 의뢰해 재보선 12개 선거구의 만 19세 이상 남녀 각 5백명에서 506명씩을 대상으로 지난 1일부터 3일까지 유무선 전화조사 방식으로 진행을 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.513,
                "end": 47.530
            },
            {
                "speaker_id": "1",
                "transcription": "표본오차는 95퍼센트 신뢰수준에서 플러스 마이너스 4.4퍼센트 포인트입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.540,
                "end": 55.766
            }
        ]
    },
    "summary": "이번 국회의원 재보궐 선거에서는 꼭 투표를 하겠다는 응답이 평균 78퍼센트 수준으로 비교적 높은 투표 참여 의지를 나타냈다는 것이 특이점이다.",
