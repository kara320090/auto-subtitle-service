        "term": [
            {
                "speaker_id": "1",
                "transcription": "김무성 대표는 당 내의 유승민 원내 대표 사퇴 요구를 잘 수습해보겠다고 밝혔지만 친박계 윤상현 의원은 유승민 원내 대표의 사퇴 문제가 아직 일단락된 것은 아니라고 밝혀 논란을 예고했습니다.",
                "sound_type": [
