                "start": 0.000,
                "end": 2.743
            },
            {
                "speaker_id": "2",
                "transcription": "헤어지지 않았더라면 아버지를 기다리던 4살, 7살 두 딸은 꽃신을 받고 이렇게 좋아했을지 모릅니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.753,
                "end": 11.121
            },
            {
                "speaker_id": "1",
                "transcription": "아버지 우리 딸들이 춤도 잘 추고 노래도 잘 하고 꼭 변해는서 마냥.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.131,
                "end": 17.800
            },
            {
                "speaker_id": "2",
                "transcription": "이 모습을 보기 위해 아버지는 60여 년을 돌아 약속을 지켰습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.810,
                "end": 22.943
            },
            {
                "speaker_id": "3",
                "transcription": "팔아가지고 아주 신 신발을 사주고 저 뭐 하라고.",
                "sound_type": [
                    2
                ],
                "start": 22.953,
                "end": 28.992
            },
            {
                "speaker_id": "1",
                "transcription": "한참 눈물을 쏟아내고서도 좀처럼 기억하지 못했던 아들.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 29.002,
                "end": 36.404
            },
            {
                "speaker_id": "4",
                "transcription": "만났잖아 엄마 거짓말 다른 사람이 다른 사람이야.",
