        "term": [
            {
                "speaker_id": "1",
                "transcription": "위측 가족분들은 앞서 말씀해 주신 것처럼 이제 웅정각으로 가서 식사를 하고 인지 지금 시간으로 보면은 돌아올 준비를 하고 계시는 데요?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 7.938
            },
            {
                "speaker_id": "1",
                "transcription": "하나씩 다 안 잡고 이게",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 7.948,
                "end": 9.511
            },
            {
                "speaker_id": "2",
                "transcription": "구급차를 떠나고 타고 떠나오신 분들 있네요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 9.521,
                "end": 13.687
            },
            {
                "speaker_id": "2",
                "transcription": "얼마나 허탈하실까요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.697,
                "end": 20.021
            },
            {
                "speaker_id": "1",
                "transcription": "착잡하시고 마음이 무거우시고",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 20.031,
                "end": 21.711
            },
            {
                "speaker_id": "2",
                "transcription": "그나마 올라가서 구급차 안에서 상봉을 하시지 않은 것이 다행이시긴 한데 고령화가 진행되면서 저런 장면들을 자주 볼 수 있는 게 참 안타깝습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.721,
                "end": 30.842
            },
            {
                "speaker_id": "2",
                "transcription": "아직까지 분들이 노래를 부르고 계시네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.852,
                "end": 35.000
            }
        ]
    },
    "summary": "남은 가족들은 떠나는 가족을 위해서 노래를 부르고 있다.",
