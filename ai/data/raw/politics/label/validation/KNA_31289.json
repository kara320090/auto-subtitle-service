        "term": [
            {
                "speaker_id": "1",
                "transcription": "한미 군 당국이 오늘부터 을지프리덤 가디언 유에프지 연습을 시작했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.093
            },
            {
                "speaker_id": "1",
                "transcription": "매년 실시되는 유에프지 연습은 한반도 유사시를 가정해 한미 연합 방위 태세를 점검하는 방어적 성격의 지휘소 훈련입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.103,
                "end": 14.446
            },
            {
                "speaker_id": "1",
                "transcription": "이번 훈련에는 우리 군 5만여 명과 미군 3만여 명이 참가하며 컴퓨터 시뮬레이션으로 전장 상황을 가정해 진행됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.456,
                "end": 23.324
            },
            {
                "speaker_id": "1",
                "transcription": "훈련에 앞서 유엔사령부 군사정전위원회는 그제 판문점에서 확성기를 통해 북측에도 연습 일정을 통보했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.334,
                "end": 31.336
            },
            {
                "speaker_id": "1",
                "transcription": "북한은 국방위 대변인 성명을 통해 유에프지 연습 취소를 요구하고 받아들여지지 않을 경우 거센 군사적 대응을 하겠다고 위협했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.346,
                "end": 41.078
            },
            {
                "speaker_id": "1",
                "transcription": "또 훈련이 끝나는 오는 28일까지 특별 경계 강화 기간으로 설정한 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 41.088,
                "end": 48.000
            }
        ]
    },
    "summary": "한미연합 군사 훈련인 을지프리덤 가디언 연습이 시작됐으며 이에 북한은 성명을 통해 유에프지 연습 취소를 요구하며 받아들여지지 않을 시엔 군사적 대응을 하겠다고 위협했다.",
