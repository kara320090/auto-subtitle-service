        "term": [
            {
                "speaker_id": "1",
                "transcription": "한미 양국이 이달말 열릴 국방 장관 회담에서 사드 문제를 공론화하는 방안을 놓고 본격 검토에 착수했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.075
            },
            {
                "speaker_id": "1",
                "transcription": "싱가포르에서 열리는 샹그릴라 안보대화 기간에 두 나라 국방장관이 만나 사드 배치 문제 관련 미국의 요청을 받고 양국간 합의 방침을 밝힌다는 것입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.085,
                "end": 18.440
            },
            {
                "speaker_id": "1",
                "transcription": "조기 공론화 필요성은 다음달 열릴 한미 정상회담이 사드 논란에 휩쓸려 빛이 바래는 것을 막자는 차원에서 제기되는 것으로 전해졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
