        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리나라의 발전상과 자유민주주의 체제의 우월성도 함께 전달됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.400
            },
            {
                "speaker_id": "1",
                "transcription": "외부 소식에 어두운 최전방 북한 병사들이 동요할 수밖에 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.410,
                "end": 11.036
            },
            {
                "speaker_id": "2",
                "transcription": "처음엔 거짓말이라고 생각하지만 계속 듣다보면 거짓말이라고 생각할 수가 없어요.",
                "sound_type": [
                    2
                ],
                "start": 11.046,
                "end": 16.729
            },
            {
                "speaker_id": "2",
                "transcription": "사람들이 이걸 들으면 말을 퍼 날라요.",
                "sound_type": [
                    2
                ],
                "start": 16.739,
                "end": 20.189
            },
            {
                "speaker_id": "3",
                "transcription": "김정은이 자신감이 부족하다는 것을 의미합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.199,
                "end": 25.235
            },
            {
                "speaker_id": "1",
                "transcription": "고정식의 경우 출력을 최대로 하면 야간에 24킬로미터 주간에 10킬로미터 거리까지도 방송 내용이 퍼져나갑니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.245,
                "end": 35.046
            },
            {
                "speaker_id": "1",
                "transcription": "최근 우리 군이 투입한 것으로 알려진 이동식은 주간에도 20킬로미터 이상 도달하는 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.056,
                "end": 43.033
            }
        ]
    },
    "summary": "우리나라의 발전상과 자유민주주의 체제의 우월성도 함께 전달하며 외부 소식에 어두운 최전방 북한 병사들이 처음엔 거짓말라고 생각하지만 계속 듣다보면 말에 동요할 수밖에 없고 최근 우리 군이 투입한 이동식은 주간에도 20킬로미터 이상까지 도달하는 것으로 알려졌다.",
