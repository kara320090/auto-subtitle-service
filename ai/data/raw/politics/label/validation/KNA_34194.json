        "term": [
            {
                "speaker_id": "1",
                "transcription": "우병우 전 청와대 민정 수석이 검찰에 소환됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.110
            },
            {
                "speaker_id": "1",
                "transcription": "이번이 네 번째 피의자 신분 소환입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.120,
                "end": 6.175
            },
            {
                "speaker_id": "1",
                "transcription": "이번엔 공직자와 민간인들에 대한 불법 사찰을 지시한 혐의 등이 적용됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.185,
                "end": 11.932
            },
            {
                "speaker_id": "1",
                "transcription": "우 전 수석은 조사에 앞서 기다리고 있던 취재진에게 숙명이라면 받아들이겠다며 헤쳐나가는 것도 본인 몫이라고 생각한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.942,
                "end": 21.619
            },
            {
                "speaker_id": "1",
                "transcription": "우 전 수석은 @이름1 전 감찰관과 박민권 1차관 등 문체부 고위 간부들에 대한 사찰을 @이름2 전 국정원 국익 정보 국장에게 지시한 혐의를 받고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.629,
                "end": 32.981
            },
            {
                "speaker_id": "1",
                "transcription": "또 @이름3 우리 은행장 등 민간인들도 불법 사찰하도록 추 전 국장에게 지시한 혐의도 있습니다.",
                "sound_type": [
