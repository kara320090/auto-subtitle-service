        "term": [
            {
                "speaker_id": "1",
                "transcription": "김 대변인은 북미 정상 회담 이후 남북 간에도 다양한 채널들을 통한 평가가 있었고 앞으로 전망에 대해서도 충분히 소통해 왔다며 북측으로부터도 김정은 위원장의 중국 방문 방문 사실을 통보받았음을 내비쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 14.128
            },
            {
                "speaker_id": "1",
                "transcription": "청와대는 다만 아직까지 김정은 위원장과 시진핑 주석 간 3번째 북중 정상 회담 등 구체적인 일정과 논의 내용이 알려지지 않고 있는 만큼 관련 입장을 내는 데는 신중한 태도를 보이고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.138,
                "end": 27.003
            },
            {
                "speaker_id": "1",
                "transcription": "청와대 고위 관계자는 이와 관련해 김 위원장의 이번 방중 목적과 함께 북중 정상 회담 결과가 나올 때까지는 특별한 입장을 낼 계획을 갖고 있지 않다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.013,
                "end": 38.110
            },
            {
                "speaker_id": "1",
                "transcription": "김정은 위원장이 시진핑 주석과 나누게 될 구체적 대화 내용 등에 대한 파악이 우선이라는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.120,
                "end": 44.297
            },
            {
                "speaker_id": "1",
                "transcription": "청와대 고위 관계자는 다만 싱가포르 북미 정상회담 이후 한반도 비핵화와 항구적 평화를 위한 큰 그림이 그려진 데다 중국 역시 여기에 근본적으로 찬성하는 입장을 보이고 있다며 북중 간 현재 흐름을 바꿀 수 있는 움직임이 있을 것으로 생각하지는 않는다는 뜻을 전했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.307,
                "end": 61.668
            },
            {
                "speaker_id": "1",
                "transcription": "그럼에도 불구하고 북중 정상 회담 결과가 앞으로 북미 간 후속 협상과 종전 선언 그리고 평화 협정 체결 등 한반도 주변 상황에 끼칠 영향을 면밀하게 분석하는 모습입니다.",
                "sound_type": [
