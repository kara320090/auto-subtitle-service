        "term": [
            {
                "speaker_id": "1",
                "transcription": "경제사회발전노사정위원회가 노동시장 구조개선을 위한 노사정 합의문을 만장일치로 의결했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.290
            },
            {
                "speaker_id": "1",
                "transcription": "이번 합의문은 지난해 12월부터 120차례 정도 회의를 거쳐 마련됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.300,
                "end": 11.882
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 회의에는 노사정 대표와 공익위원들이 참여해 노동시장 이중구조 완화를 위한 원하청, 대중소기업 상생협력 등에 합의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.892,
                "end": 21.123
            },
            {
                "speaker_id": "1",
                "transcription": "또 비정규직 고용과 차별 시정을 위한 제도 개선 등도 추진하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.133,
                "end": 26.238
            },
            {
                "speaker_id": "1",
                "transcription": "아울러 사회안전망 확충을 위한 사회보험 사각지대 해소와 실업급여 개선 등 현안 해결에도 의견을 모읍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.248,
                "end": 34.082
            },
            {
                "speaker_id": "1",
                "transcription": "노사정은 노동시장구조개선특별위원회 운영을 내년 9월 18일까지 1년 연장해서 합의서에 담긴 후속과제 등을 지속적으로 협의하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.092,
                "end": 44.333
            }
        ]
    },
    "summary": "경제사회발전노사정위원회는 오늘 노동시장 구조 개선을 위한 대타협 합의문을 최종 의결하여 비정규직 고용이나 노동시장 활성화 그리고 사회보험과 실업급여 개선 등을 추진하기로 하고 나아가 후속과제의 협의를 위해 위원회를 1년 더 연장하기로 결정했다.",
