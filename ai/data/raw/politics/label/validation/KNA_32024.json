        "term": [
            {
                "speaker_id": "1",
                "transcription": "즉 당무위원과 의원들 합동총회에서 정치적 재신임을 묻고 대표는 재신임 투표를 철회하라는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.027
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 대표는 대표에 대한 흔들기가 계속돼 힘들다면서도 신중하게 고려하겠다고 응답했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.037,
                "end": 13.693
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 창당 60주년을 맞아 열린 기념식에서도 김원기, 임채정, 권노갑 상임고문은 당의 화합을 강도 높게 주문하기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.703,
                "end": 22.737
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 문 대표가 모레 합동 총회를 열어 중진 제안을 수용할지가 재신임 정국의 분수령이 될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 22.747,
