        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난 해 기준으로 징병검사자 36만3천여명 가운데 현역병 판정 비율은 90.4퍼센트입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.282
            },
            {
                "speaker_id": "1",
                "transcription": "징병 검사자 대부분이 현역판정을 받았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.292,
                "end": 11.522
            },
            {
                "speaker_id": "1",
                "transcription": "이때문에 현역병 판정을 받은 입영대상자는 몇달에서 길게는 1년넘게 기다리게 입대를 해 불만이 제기돼 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.532,
                "end": 19.714
            },
            {
                "speaker_id": "1",
                "transcription": "군대 가기가 하늘의 별따기라는 말까지 나오자 병무청이 병역 처분 기준을 변경해 시행한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.724,
                "end": 27.888
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 올해 징병검사에서 신체등위 1에서 3등급을 받아 현역 입영대상자로 분류된 고등학교 중퇴나 중학교 졸업 학력을 가진 사람은 보충력으로 전환됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.898,
                "end": 39.705
            },
            {
                "speaker_id": "1",
                "transcription": "또 앞으로 징병검사를 받아 현역 대상자로 분류되는 경우에도 동일하게 적용된다고 병무청은 설명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.715,
                "end": 47.733
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 보충력으로 전환되는 대상 인원은 6천여명으로 추정됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.743,
                "end": 52.528
            },
            {
                "speaker_id": "1",
                "transcription": "병무청은 내년도 고교 중퇴 중졸 학력자 가운데 신체등이 1에서 3급인 사람은 보충력으로 전환하는 방안을 고려중이라며 올해와 내년 각각 6천여명씩 보충력으로 전환되면 입영 대기 시간이 줄어들 것이라고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.538,
                "end": 69.588
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 이들 가운데 현역병으로 복무하고 싶어 하는 경우도 있어 학력 약자에게 심적인 상처를 주는 행정 편의주의적 발상이라는 지적도 나오고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 69.598,
                "end": 79.961
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 79.971,
                "end": 83.600
            }
        ]
    },
    "summary": "징병 검사자 대부분이 현역판정을 받고 입대까지 대기 기간이 길어 불만이 제기되자 병무청이 병역 처분 기준을 변경해 시행한다고 밝혔다.",
