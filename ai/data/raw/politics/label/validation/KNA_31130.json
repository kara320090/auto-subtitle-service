        "term": [
            {
                "speaker_id": "1",
                "transcription": "남북한은 이번 협상에서 추석을 계기로 이산 가족 상봉을 진행하고 그 이후에도 상봉 행사를 이어가기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.159
            },
            {
                "speaker_id": "1",
                "transcription": "상봉 행사를 주관하는 대한 적십자사는 당장 태스크포스를 구성하는 등 실무 작업에 착수했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.169,
                "end": 13.697
            },
            {
                "speaker_id": "2",
                "transcription": "헤어진 시기가 육이오 이전인지 이후인지",
                "sound_type": [
                    2
                ],
                "start": 13.707,
                "end": 18.073
            },
            {
                "speaker_id": "3",
                "transcription": "이후야. 육이오 나서 바로 헤어졌으니까.",
                "sound_type": [
                    2
                ],
                "start": 18.083,
                "end": 22.187
            },
            {
                "speaker_id": "1",
                "transcription": "우선 다음 달 초 열리는 실무 접촉 전까지 상봉 신청 접수를 받고 생존자 확인 작업 등을 벌이게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 22.197,
                "end": 29.254
            },
            {
                "speaker_id": "1",
                "transcription": "실무 접촉이 마무리되면 합의 내용을 토대로 상봉 후보자를 선정한 뒤 북측과 생사 확인 절차를 거쳐 생존자 가운데 최종 대상자를 선정합니다.",
                "sound_type": [
                    2
                ],
                "start": 29.264,
                "end": 39.200
            }
        ]
    },
