        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 씨와 @이름2 전 언론 노조 위원장의 이른바 허위 인터뷰 의혹과 관련해 검찰이 특별 수사팀을 구성했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.615
            },
            {
                "speaker_id": "1",
                "transcription": "서울 중앙지검은 오늘 이른바 대선 개입 여론 조작 사건 특별 수사팀을 구성했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.625,
                "end": 13.367
            },
            {
                "speaker_id": "1",
                "transcription": "반부패 수사 3부 @이름3 부장검사를 팀장으로 하고 선거와 명예 훼손 등의 전문성을 갖춘 중앙지검 검사 10여 명 규모로 구성됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.377,
                "end": 23.135
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 이번 사건을 대선 목전에서 유력 후보에 대한 허위 사실을 공표하고 민의를 왜곡하려 시도한 선거 농단이라고 규정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.145,
                "end": 32.277
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 오늘 @이름2 전 언론 노조 위원장도 배임 수재와 청탁 금지법 위반 혐의 피의자 신분으로 불러 조사했습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 32.287,
                "end": 39.628
            },
            {
                "speaker_id": "1",
                "transcription": "2021년 @이름1 씨로부터 1억 6000여만 원을 받고 2011년 부산 저축은행 당시 윤석열 당시 대검 중수과장이 대장동 사업 자금책 @이름4 씨의 수사를 무마해줬단 허위 내용이 담긴 인터뷰를 한 혐의입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.638,
                "end": 54.826
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 어제 있었던 추가 구속영장 심문에서 김 씨가 1억 6000여만 원의 대가성을 숨기고 허위 계약서를 작성해 책 3권을 산 것처럼 위장했다고 주장했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 54.836,
                "end": 65.865
            }
        ]
    },
    "summary": "서울 중앙지검은 오늘 김 씨와 신 전 언론 노조 위원장의 허위 인터뷰 의혹과 관련해 중앙지검 검사 10여 명으로 구성된 특별 수사팀을 구성했다고 밝혔다.",
