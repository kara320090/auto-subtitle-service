        "term": [
            {
                "speaker_id": "1",
                "transcription": "의용소방대 지원비로는 고위 간부 방석을 샀고 사무실 화분을 구입하기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.016
            },
            {
                "speaker_id": "2",
                "transcription": "해당 사업에 매월 이렇게 돈이 배정이 되는데 이제 돈이 만약에 없으면 우선 다른 사업에서 우선 하고 그다음 달에 다시 이제 정정하는 그런 과정입니다. 잘못된 거는 맞습",
                "sound_type": [
                    2
                ],
                "start": 6.026,
                "end": 18.255
            },
            {
                "speaker_id": "1",
                "transcription": "행정자치부는 정부 3.0 추진 위원회 사업비로 명절 선물을 구입해 주고받았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.265,
                "end": 24.742
            },
            {
                "speaker_id": "1",
                "transcription": "정보자원관리 사업비로는 전출자 송별회, 승진자 축하 오찬 등 회식비로 썼습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.752,
                "end": 31.630
            },
            {
                "speaker_id": "2",
                "transcription": "직원들 하고 그 이렇게 같은 일을 하다 보면 그런 회의가 필요하지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 31.640,
                "end": 36.065
            },
            {
                "speaker_id": "2",
                "transcription": "소액 금액을 한 일이십 만 원씩 쓴 것은 사실입니다.",
                "sound_type": [
                    2
                ],
                "start": 36.075,
                "end": 39.440
            },
            {
                "speaker_id": "2",
                "transcription": "명확하게 좀 엄밀하게 좀 앞으로 쓰도록 이렇게 하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.450,
                "end": 43.858
            },
            {
                "speaker_id": "1",
                "transcription": "연말엔 남은 사업비를 직원들 식대로 썼습니다.",
                "sound_type": [
                    2
                ],
                "start": 43.868,
                "end": 47.033
            }
        ]
    },
    "summary": "행정자치부는 의용 소방대 지원비, 추진 위원회 사업비, 정보자원관리 사업비 등으로 사무실 구비 물품이나 회식비 등으로 사용했다.",
