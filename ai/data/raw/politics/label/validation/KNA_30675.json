        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "박근혜 대통령의 지시였나요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.990
            },
            {
                "speaker_id": "2",
                "transcription": "검찰에서 물어보시는 사실들에 대해서 있는 그대로 성실히 답변드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.000,
                "end": 11.185
            },
            {
                "speaker_id": "3",
                "transcription": "@이름1 전 비서관은 @이름2 씨와의 관계에 대한 질문에도 검찰 조사에서 성실히 답변하겠다고 짧게 말한 뒤 검찰 조사실로 들어갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.195,
                "end": 22.429
            },
            {
                "speaker_id": "3",
                "transcription": "이 전 비서관은 청와대 문서 보안 책임자로 이 전 비서관의 승인이나 묵인 없이는 내부 문건의 외부 유출이 불가능하다는 게 검찰 판단입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.439,
                "end": 31.810
            },
            {
                "speaker_id": "3",
                "transcription": "검찰은 이 전 비서관을 상대로 기밀문서의 유출 경위와 박 대통령의 지시 여부 등을 조사 중입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.820,
                "end": 38.174
            },
            {
                "speaker_id": "3",
                "transcription": "앞서 @이름3 전 비서관도 검찰 청사에 모습을 드러냈지만 취재진을 피해 급히 조사실로 향했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.184,
                "end": 44.606
            },
            {
                "speaker_id": "3",
                "transcription": "안 전 비서관 역시 @이름2 씨와의 관계를 묻는 말에 검찰 조사에서 말하겠다는 원론적인 대답만 되풀이했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.616,
                "end": 52.087
            },
            {
                "speaker_id": "3",
                "transcription": "검찰은 안 전 비서관이 최 씨가 청와대 관저를 오가도록 편의를 봐줬다는 의혹 등을 조사하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.097,
                "end": 58.554
            },
            {
                "speaker_id": "3",
                "transcription": "이들은 일단 참고인 신분이지만 조사 과정에서 직무 유기나 공무상 비밀 누설 등의 범죄 혐의가 드러나면 피의자로 신분이 전환될 가능성도 있는 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.564,
                "end": 70.033
            }
        ]
    },
    "summary": "검찰은 @이름1 전 비서관이 청와대 문서 보안 책임자였기 때문에 이 씨의 승인이나 묵인 없이는 내부 문건의 외부 유출이 불가능하다고 판단해 이 씨를 두고 기밀문서의 유출 경위와 박 대통령의 지시 여부를 조사하고 있고 @이름3 전 비서관에 대해서는 최 씨가 청와대 관저를 오가도록 편의를 봐줬다는 의혹에 대해 조사하고 있으며 이들은 아직 참고인 신분이지만 조사 과정에서 범죄 혐의가 드러나면 피의자 신분으로 전환될 가능성이 있습니다.",
