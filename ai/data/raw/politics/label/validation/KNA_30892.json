    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "탄핵안을 보고 시점이 굉장히 중요합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.012
            },
            {
                "speaker_id": "1",
                "transcription": "지금 2시에 본회의가 열려지게 돼 있지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 3.022,
                "end": 5.604
            },
            {
                "speaker_id": "1",
                "transcription": "이게 늦춰질 수가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 5.614,
                "end": 7.191
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 6시에 만약에 보고가 되고 24시간 후에 이 탄핵을 절차를 밟기 때문에 내일 오후 6시 늦게도 가능한 것이죠 그래서 어느 시점에 본회의에 인제 보고가 되느냐가 굉장히 중요하고요.",
                "sound_type": [
                    2
                ],
                "start": 7.201,
                "end": 23.008
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 나서 만약에 예 절차적으로 따라서 대통령인 탄핵이 결국은 국회에서 가결이 되면 바로 헌법 재판소로 가게 돼 있고요 현재는 이 경우는 헌법 재판소 법에 의하면 180 이 이내라고 되어 있지만요.",
                "sound_type": [
                    2
                ],
                "start": 23.018,
                "end": 39.098
            },
            {
                "speaker_id": "1",
                "transcription": "저 임의규정입니다 꼭 180일을 지킬 수 필요는 없는 건데요 예를 들어서 노무현 대통령 때는 64일 정도 걸렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.108,
                "end": 48.083
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 통진단 해산 같은 경우에는 1년 1개월이 걸렸거든요.",
                "sound_type": [
                    2
                ],
                "start": 48.093,
                "end": 51.675
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 지금 아주 그 설왕설래를 하고 있습니다 워낙 이 저 헌법과 법률에 위반사항이 강하기 때문에 @이름1 헌재소장이 임기를 마치고 끝나기 전 1월 말까지 현재의 판결이 나올 것이다라고 주장하는 사람이 있는가 하면은 워낙 복잡하기 때문에 특히 이번에는 특검하고 국정조사를 동시하지 않습니까.",
                "sound_type": [
                    2
                ],
                "start": 51.685,
                "end": 72.780
            },
            {
                "speaker_id": "1",
                "transcription": "특검 결과를 보고 헌재가 결론을 내리겠다고 한다면 저는 헌재 판결은 내년 3월 내지 4월까지 갈 수도 있다라고 보는 것이죠.",
                "sound_type": [
                    2
                ],
                "start": 72.790,
                "end": 82.860
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 만약에 어 최종적으로 헌재에서 판결이 이루어져서 대통령의 에 탄핵이 인용이 되면 헌법에 따라서 60일 내에 대통령 선거를 치루게 된다는 거 다시 요약해서 말씀을 드리면 1월 달에 만약에 현재가 판결하면 3월에 대통령 선거를 치러야 되는 것이고 4월달에 만약에 결론을 내리면 6월달에 대통령 선거를 치르기 때문에 결국은",
                "sound_type": [
                    2
                ],
                "start": 82.870,
                "end": 106.300
            }
        ]
    },
    "summary": "대통령 탄핵 절차에 따라 국회에서 탄핵이 가결되면 헌법 재판소로 가게 되는데 헌재가 탄핵 인용 시 이 판결 시기에 따라 다음 대통령 선거의 시기가 달라지게 된다.",
