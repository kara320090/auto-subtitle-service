        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 현장에서는 아직 효과를 체감하지 못하고 있고 조선과 자동차 등 제조업 밀집 지역은 여전히 어렵다고 진단했습니다.",
                "sound_type": [
