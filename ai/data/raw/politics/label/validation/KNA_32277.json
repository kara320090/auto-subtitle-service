        "term": [
            {
                "speaker_id": "1",
                "transcription": "새누리당은 개성공단 조업 중단 조치는 북한의 핵 위협 속에 국가 안위와 국민 안전을 지키기 위한 불가피한 결단이었는데도",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.547
            },
            {
                "speaker_id": "1",
                "transcription": "야당이 북풍과 선거 전략을 운운하며 정부를 비난하고 있다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.557,
                "end": 15.441
            },
            {
                "speaker_id": "1",
                "transcription": "원유철 원내 대표는 오늘 원내 대책 회의에서 북한의 태도 변화가 없는 한 개성공단은 밑 빠진 독에 물 붓기라며",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.451,
                "end": 23.516
            },
            {
                "speaker_id": "1",
                "transcription": "야당은 북한 눈치를 보고 북한을 우선하는 사고를 할 것이 아니라 국민을 최우선시해야 한다고 지적했습니다.",
                "sound_type": [
