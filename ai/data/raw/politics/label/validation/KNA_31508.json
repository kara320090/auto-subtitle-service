        "term": [
            {
                "speaker_id": "1",
                "transcription": "야당의 주요 쟁점 법안인 탄소산업 지원법과 최저임금법 개정안은 어제 법사위를 통과했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.427
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 여당 반대로 본회의 안건에서 제외되면서 야당이 반발하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.437,
                "end": 12.112
            },
            {
                "speaker_id": "1",
                "transcription": "이와 함께 여야 합의 실패로 선거구 획정 문제도 해를 넘기게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.122,
                "end": 17.168
            },
            {
                "speaker_id": "1",
                "transcription": "정의화 국회의장은 이와관련해 현행 국회의원 선거구가 법적으로 무효가 되는 내일 새벽 0시 선거구획정위원회에 획정 기준을 전달할 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.178,
                "end": 27.732
            },
            {
                "speaker_id": "1",
                "transcription": "정 의장이 넘길 획정 기준은 현행 의석 비율인 지역구 246석 비례대표 54석입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.742,
                "end": 35.221
            },
            {
                "speaker_id": "1",
                "transcription": "정 의장은 획정위의 의결을 거쳐 국회로 다시 넘어오면 다음 달 8일 본회의에서 처리할 방침인 것으로 알려지고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.231,
                "end": 43.252
            },
            {
                "speaker_id": "1",
                "transcription": "올해 마지막 날 열린 본회의에서 쟁점법안 처리가 무산되면서 국회에 대한 비판이 거세질 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 43.262,
                "end": 50.817
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 국회에서 KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 50.827,
                "end": 54.466
            }
        ]
    },
    "summary": "어제 법사위를 통과한 탄소산업 지원법과 최저임금법 개정안은 본회의에서 여당 반대로 제외돼 야당이 반발했고 정 의장은 새벽 0시에 선거구획정위원회에 현행 의석 비율 기준으로 획정 기준을 전달할 예정이다.",
