        "term": [
            {
                "speaker_id": "1",
                "transcription": "문재인 대통령이 오늘 오전 홍종학 중소 벤처 기업부 장관을 공식 임명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.428
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령은 새 정부 경제 정책에서 중소 기업과 중소상공인, 벤처 기업 지원 육성이 가장 중요하고 정부 조각 마무리도 시급하다며 이번 임명에 대한 야당의 양해를 당부했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.438,
                "end": 18.996
            },
            {
                "speaker_id": "2",
                "transcription": "정부 조각이 좀 시급하게 좀 마무리 돼야 된다 그다음에 또 중소 벤처 기업부의 갈길이 아주 바쁘다 이런 좀 사정들을 감안해서 어 야당들도 어 뭐 양해해 주시기를 어 당부를 드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.006,
                "end": 39.117
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 문 대통령은 어제까지 홍종악 장관 후보자 청문 보고서 채택을 국회에 재차 요청했지만 자유 한국당 등 야당들의 반대로 무산됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.127,
                "end": 49.846
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 홍 장관 임명으로 문 대통령 취임 195일만에 새 정부 1기 구성이 완료됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.856,
                "end": 56.590
            },
            {
                "speaker_id": "1",
                "transcription": "초대 중기부 장관에 취임한 홍 장관은 문재인 정부들어 국회의 청문 보고서 채택 없이 임명된 다섯 번째 장관급 고위 공직자가 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.600,
                "end": 66.184
            },
            {
                "speaker_id": "1",
                "transcription": "정치권의 반응은 엇갈렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 66.194,
                "end": 68.834
            },
            {
                "speaker_id": "1",
                "transcription": "더불어민주당은 후보자의 능력과 자질이 충분히 검증된 데 따른 당연한 결정이라며 이번 인사가 정쟁의 수단으로 비화되는 일이 없길 바란다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 68.844,
                "end": 79.433
            }
        ]
    },
    "summary": "문재인 대통령이 중소 벤처 기업부 장관을 청문 보고서 채택 없이 임명해 정치권의 반응이 엇갈렸다.",
