        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오전 중에는 박근혜 대통령 측의 답변서가 헌재에 전달되지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.480
            },
            {
                "speaker_id": "1",
                "transcription": "탄핵소추의결서에 대한 박 대통령의 답변서 제출 기한이 오늘까지기 때문에 오후에는 제출할 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.490,
                "end": 11.445
            },
            {
                "speaker_id": "1",
                "transcription": "박 대통령은 10명 정도로 꾸려진 탄핵심판 변호인단의 선임계도 함께 낼 것으로 전망됩니다.",
                "sound_type": [
                    2
                ],
                "start": 11.455,
                "end": 17.229
            },
            {
                "speaker_id": "1",
                "transcription": "헌법재판소는 오늘 탄핵심판사건 심리에 착수한 이후 처음으로 재판관 전원 참여하는 회의를 열었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.239,
                "end": 24.837
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 재판관이 해외출장에서 귀국하면서 탄핵소추의결서 접수 일주일 만에 재판관 9명이 모두 모였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.847,
                "end": 33.482
            },
            {
                "speaker_id": "1",
                "transcription": "재판관들은 이르면 다음주 열릴 첫 준비절차기일을 언제로 정할지 어떻게 진행할 지 등을 논의한 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.492,
                "end": 41.303
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 박 대통령이 답변서를 제출하면 헌재는 입증계획와 증거목록 등의 논의를 구체적으로 진행할 계획입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.313,
                "end": 49.071
            },
            {
                "speaker_id": "1",
                "transcription": "답변서에는 박 대통령이 최순실 씨 등과 공범이라는 검찰의 주장은 논리는 비약이며 청와대 문건을 최씨에게 건네라고 지시하지 않았다는 내용이 포함된 것으로 확인됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.081,
                "end": 60.686
            },
            {
                "speaker_id": "1",
                "transcription": "또 세월호 참사 당일 박 대통령은 관저에서 업무를 봤으며 미용 시술 의혹 등은 사실이 아니라고 적극 해명한 것으로 전해졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.696,
                "end": 69.364
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 헌법재판소에서 KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 69.374,
                "end": 74.200
            }
        ]
    },
    "summary": "헌법재판소는 오늘 탄핵관련 심리에 착수한 이후 처음으로 재판관 전원이 참석하는 회의를 열어 준비절차 기일 일정과 진행 방식 여부등을 논의했고 박 대통령과 최 씨가 공범이라는 주장은 비약이며 세월호 참사 당일의 미용 의혹은 사실이 아니라는 내용이 포함됐다.",
