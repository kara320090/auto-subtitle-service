        "term": [
            {
                "speaker_id": "1",
                "transcription": "공정 인사 지침은 저성과자 해고가 가능하도록 일반 해고를 허용하는 게 핵심 내용입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.005
            },
            {
                "speaker_id": "1",
                "transcription": "취업 규칙 해석 및 운영에 관한 지침은 사업주가 노동자에 불리한 근로 조건을 도입할 때 노조나 노동자 과반 동의를 받도록 한 법규를 완화하는 내용을 담고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.015,
                "end": 19.985
            },
            {
                "speaker_id": "1",
                "transcription": "고용 노동부는 양대 지침 도입 과정에서 노사 간 협의가 부족했고 적용 과정에서도 노사 갈등과 소송 등 혼란이 지속돼 폐기를 결정했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.995,
                "end": 32.438
            },
            {
                "speaker_id": "1",
                "transcription": "한국 노총은 정부의 양대 지침 폐기는 노정사의 신뢰 회복과 노동 존중 사유를 위해 당연하고 필수적인 조치라며 적극 환영한다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.448,
                "end": 45.133
            }
        ]
    },
