        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회 인사 청문 특위 여야 간사가 @이름1 대법원장 후보자에 대한 인사 청문 보고서 채택을 위해 만났지만 합의에 이르지 못했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.254
            },
            {
                "speaker_id": "1",
                "transcription": "여당인 민주당은 적격 의견을 자유한국당과 바른정당은 부적격 의견을 제시했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.264,
                "end": 18.416
            },
            {
                "speaker_id": "1",
                "transcription": "국민의당은 보고서에 적격, 부적격 의견을 병기하자는 입장입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.426,
                "end": 23.381
            },
            {
                "speaker_id": "1",
                "transcription": "각 당의 지도부도 김 후보자의 인준 문제를 놓고 충돌했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.391,
                "end": 28.202
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 우원식 원내 대표는 야당은 존재감 과시나 근육 자랑 말고 국민의 기대에 부합한 결론을 내려달라고 압박했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.212,
                "end": 37.691
            },
            {
                "speaker_id": "1",
                "transcription": "박홍근 원내 수석 부대표는 야당이 계속 어깃장을 놓으면 퇴계 이황이나 황희 정승을 모셔와도 청문회 통과가 어렵다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.701,
                "end": 48.028
            },
            {
                "speaker_id": "1",
                "transcription": "자유한국당 정우택 원내 대표는 사법부 코드화의 정점에 있는 김 후보자는 안된다며 청와대도 김 후보자를 더는 집착하면 안된다고 못박았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.038,
                "end": 59.744
            },
            {
                "speaker_id": "1",
                "transcription": "바른정당 주호영 원내 대표는 삼권 분립의 한 축인 대법원을 이끌 분이냐는 데 대해 전혀 확신을 못 줬다고 평가했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.740,
                "end": 68.945
            },
            {
                "speaker_id": "1",
                "transcription": "한편 국민의당은 의원 총회를 열고 @이름2 헌법 재판소장 후보자 인준안 부결 이후 민주당 추미애 대표와 우원식 원내 대표가 국민의당을 땡깡과 적폐 연대로 표현한 것과 관련해 사과를 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 68.955,
                "end": 84.576
            },
            {
                "speaker_id": "1",
                "transcription": "국민의당은 두 당사자가 사과하지 않는 한 @이름1 대법원장 후보자 인준안 상정 등 어떤 절차적 협의도 하지 않겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 84.586,
                "end": 94.096
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름3입니다.",
                "sound_type": [
                    2
                ],
                "start": 94.106,
                "end": 96.333
            }
        ]
    },
    "summary": "@이름1 대법원장 후보자의 인사 청문 보고서에 대해 여당은 적격 의견을 야당은 부적격 의견을 제시했고 각 당의 지도부들은 김 후보자의 인준 문제를 놓고 충돌해 합의가 이르지 못했다.",
