        "term": [
            {
                "speaker_id": "1",
                "transcription": "일사 후퇴 때 원산 철수 작전으로 헤어졌던 언니의 혈육을 이제서야 만났습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.627
            },
            {
                "speaker_id": "2",
                "transcription": "음 우리 엄마 그 귀중한 물품을 날 이만큼을 싸 준 걸 내가 잊어 오다가 잊어버렸어 소달구지에다 싣고 오다가.",
                "sound_type": [
                    2
                ],
                "start": 5.637,
                "end": 13.547
            },
            {
                "speaker_id": "1",
                "transcription": "혹시 음식이 질기진 않을까 서로를 챙기는 팔순의 노부부 60여 년 만에 재회해 많은 없어도 항상 옆자리를 지킵니다.",
                "sound_type": [
                    2
                ],
                "start": 13.557,
                "end": 23.238
            },
            {
                "speaker_id": "1",
                "transcription": "동생은 체면도 잊은 채 오빠 무릎에 앉아 어리광을 부리고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.248,
                "end": 28.005
            },
            {
                "speaker_id": "3",
                "transcription": "진짜 오빠잖아 같이 살았으면 좋겠네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.015,
                "end": 31.274
            },
            {
                "speaker_id": "4",
                "transcription": "거 여기서 살아 그냥.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.284,
                "end": 33.300
            }
        ]
    },
    "summary": "상봉 가족들은 서로를 만나서 매우 기뻐하고 있다.",
