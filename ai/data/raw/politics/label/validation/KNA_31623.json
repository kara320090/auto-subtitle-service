        "term": [
            {
                "speaker_id": "1",
                "transcription": "홍 위원은 조사에 앞서 혐의를 모두 부인했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.948
            },
            {
                "speaker_id": "2",
                "transcription": "범죄자가 되니까 그렇습니다 그런 적이 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.958,
                "end": 5.710
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 홍 위원을 상대로 경민학원이 받은 기부금으로 김 모 씨의 서화를 구입한 배경을 집중적으로 조사하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.720,
                "end": 13.313
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 김 씨에게 지급한 서화 구입 대금 가운데 일부가 홍 의원 측으로 다시 넘어가는 방식으로 불법자금이 세탁 됐을 가능성이 높다고 판단하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.323,
                "end": 22.812
            },
            {
                "speaker_id": "1",
                "transcription": "김 씨는 검찰 조사에서 서화 대금 대부분을 홍 위원에게 건넸다고 진술한 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.822,
                "end": 28.962
            },
            {
                "speaker_id": "1",
                "transcription": "김 씨는 홍 의원의 측근이자 친박연대 간부출신입니다.",
                "sound_type": [
                    2
                ],
                "start": 28.972,
                "end": 33.466
            }
        ]
    },
    "summary": "김 씨는 경민학원의 기부금으로 서화를 구입하는 척 대금의 일부를 다시 홍 위원에게 보냈다고 의심을 받고 있으며 홍 위원은 이에 대해 자신은 무죄라고 주장하고 있다.",
