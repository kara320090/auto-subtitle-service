        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 이곳 상도동 자택은 간간이 눈발이 날리는 가운데 매우 차분한 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.497
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 3시간이 좀 넘은 시간이 되면 이곳에 올 고인을 기다리면서 마지막 준비를 하고 있는 모습입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.507,
                "end": 12.743
            },
            {
                "speaker_id": "1",
                "transcription": "현재 상도동 자택에는 김영삼 전 대통령의 부인인 @이름1 여사가 친지들과 함께 오후 2시에 국회에서 열릴 영결식에 갈 준비를 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.753,
                "end": 22.991
            },
            {
                "speaker_id": "1",
                "transcription": "손 여사는 1시간 정도 지나면 자택을 떠나 국회로 갈 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 23.001,
                "end": 27.684
            },
            {
                "speaker_id": "1",
                "transcription": "상도동 이웃 주민들은 김 전 대통령을 애도하며 집집마다 조기를 걸었습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.694,
                "end": 32.694
            },
            {
                "speaker_id": "1",
                "transcription": "운구 행렬은 국회에서 영결식이 끝나면 상도동 자택을 잠시 들릴 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 32.704,
                "end": 38.585
            },
            {
                "speaker_id": "1",
                "transcription": "고인의 영정은 80년대 가택 연금과 23일간의 단식 투쟁 상도동계라고 불리는 수많은 거물 정치인을 배출해 낸 자택을 두며 마지막 인사를 할 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 38.595,
                "end": 49.814
            },
            {
                "speaker_id": "1",
                "transcription": "고인이 46년 살아온 상도동 자택은 앞으로 우리나라 민주화의 역사를 간직한 기념관 형태로 보존하는 방안도 논의되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 49.824,
                "end": 58.958
            },
            {
                "speaker_id": "1",
                "transcription": "김 전 대통령의 운구 행렬은 이곳에서 500미터 정도 떨어진 곳에 있는 김영삼 기념 도서관도 지납니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 58.968,
                "end": 66.533
            },
            {
                "speaker_id": "1",
                "transcription": "내년 초에 개관 예정인 기념 도서관엔 김 전 대통령의 일생과 민주화 투쟁 과정을 보여주는 각종 자료 등이 전시될 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 66.543,
                "end": 75.739
            },
            {
                "speaker_id": "1",
                "transcription": "운구 행렬은 김영삼 기념 도서관을 지나면 곧바로 서울 현충원으로 이동합니다.",
                "sound_type": [
                    2
                ],
                "start": 75.749,
                "end": 81.800
            }
        ]
    },
    "summary": "상도동 자택은 김영삼 전 대통령 운구 행렬을 기다리고 있는 가운데 운구 행렬은 국회에서 영결식이 끝나면 상도동 자택을 잠시 들리고 김영삼 기념 도서관을 지나 현충원으로 곧바로 이동합니다.",
