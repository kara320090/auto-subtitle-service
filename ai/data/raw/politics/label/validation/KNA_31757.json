                "end": 24.022
            },
            {
                "speaker_id": "1",
                "transcription": "외교 통일위에선 여야 의원들이 함께 나진 하산 프로젝트가 추진되는 러시아 하산 지역으로 시찰을 떠났습니다.",
                "sound_type": [
