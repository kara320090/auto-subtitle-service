        "term": [
            {
                "speaker_id": "1",
                "transcription": "오는 24일부터 이틀 간 네덜란드 헤이그에서 개최되는 핵 안보 정상회의 기간에 한미일 3국 정상회담이 열립니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.695
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 청와대 대변인은 헤이그에서 있게 될 한미일 정상회담은 오늘 오후 외교부에서 공식 발표할 것이라고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.705,
                "end": 15.868
            },
            {
                "speaker_id": "1",
                "transcription": "일본 언론들도 한미일 세 나라가 핵안보 정상회의 기간에 3국 정상회담을 여는 것에 합의했다고 보도했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.878,
                "end": 23.790
            },
            {
                "speaker_id": "1",
                "transcription": "이로써 박근혜 정부 출범 이후 비록 3국 회담 형태이기는 하지만 한일 두 정상이 처음으로 마주하게 됐습니다.",
                "sound_type": [
