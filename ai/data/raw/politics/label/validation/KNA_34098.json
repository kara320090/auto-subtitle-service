        "term": [
            {
                "speaker_id": "1",
                "transcription": "한국당에 국감 중단으로 각 상임회 국감이 줄줄이 파행을 빚게 되자 더불어민주당은 긴급 대책 회의를 열어 국감은 정상적으로 진행되어야 한다는 원칙을 확인했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.507
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 한국당이 억지를 부리며 공영 방송을 정쟁에 악용하고 있다고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.517,
                "end": 17.775
            },
            {
                "speaker_id": "1",
                "transcription": "또 방문진 보궐 의사는 법에 따라 여당이 아닌 방통위가 추천했다고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.785,
                "end": 24.123
            },
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 오늘 열릴 예정이었던 국회 과방위의 KBS와 EBS에 대한 국감은 한국당에 불참으로 파행된듯해 11월 중에 다시 열기로 했습니다.",
                "sound_type": [
