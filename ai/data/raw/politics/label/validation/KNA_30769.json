            },
            {
                "speaker_id": "1",
                "transcription": "산업 통상 당국은 물론 무역 협회와 경제 단체 업종별 협회 연구 기관 등이 모여 대미 통상 대책과 양국 간 신규 협력 방안 등을 논의합니다.",
                "sound_type": [
