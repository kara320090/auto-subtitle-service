                "start": 0.000,
                "end": 7.830
            },
            {
                "speaker_id": "2",
                "transcription": "그걸 가지고 다 뿌려라.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.840,
                "end": 9.675
            },
            {
                "speaker_id": "2",
                "transcription": "알바가 아니라 매크로를 쓰는 캠프라면 매크로에 같이 태워라.",
                "sound_type": [
