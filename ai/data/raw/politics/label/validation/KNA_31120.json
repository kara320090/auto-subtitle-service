        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "강 대 강 대결 국면으로 치닫던 남북 관계가 이번 합의로 극적 전환의 계기를 맞게 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.163
            },
            {
                "speaker_id": "1",
                "transcription": "무엇보다 고조된 군사적 긴장 상태를 남북이 당국 간 대화를 통해 해결했다는 점은 시사하는 바가 큽니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.173,
                "end": 13.952
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 꽉 막혔던 당국 간 채널이 복원됐기 때문입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.962,
                "end": 18.227
            },
            {
                "speaker_id": "2",
                "transcription": "남북 관계에 새로운 흐름 그것은 결국 남북 대화를 통해서 아 뭔가 남북 남북을 개선하는 쪽으로 변화하는 그런 흐름으로 갈 가능성이 높다고 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 18.237,
                "end": 29.508
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 남북 당국 간 회담이 정례화되고 보도문에 명시된 것처럼 여러 분야에 대화와 협상도 순탄하게 진행된다면 남북 관계는 질적인 변화를 맞을 가능성이 커졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.518,
                "end": 42.226
            },
            {
                "speaker_id": "1",
                "transcription": "특히 이번 합의로 꽁꽁 얼어붙었던 남북 관계가 해빙기에 접어들면서 한반도 신뢰 프로세스도 탄력을 받을 것으로 보입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 42.236,
                "end": 51.388
            },
            {
                "speaker_id": "1",
                "transcription": "정부의 유라시아 이니셔티브와 통일 대박론 등 대북 구상도 진전을 기대할 수 있게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 51.398,
                "end": 58.485
            },
            {
                "speaker_id": "1",
                "transcription": "이 때문에 지금은 아니라는 청와대의 설명에도 불구하고 남북 정상 회담에 대한 기대감이 벌써부터 나오고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 58.495,
                "end": 66.270
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 남북 간에는 오이사 조치와 금강산 관광 문제는 물론 핵과 미사일 등 풀기 힘든 난제들이 얽혀 있어 남북 관계 전망에 대한 신중론도 만만치 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 66.280,
                "end": 77.826
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.836,
                "end": 80.966
            }
        ]
    },
    "summary": "남북 관계의 이번 합의는 시사하는 바가 크고 앞으로 남북 관계가 질적인 변화를 맞을 가능성이 커졌지만 핵과 미사일 등 풀기 힘든 난제들도 많이 남아 있어 남북 관계에 대한 신중론도 만만치 않아 보입니다.",
