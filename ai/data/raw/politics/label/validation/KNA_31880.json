                "end": 9.440
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 국회의장과 여야 대표 등은 기념식에서 임을 위한 행진곡을 다함께 같이 불렀습니다.",
                "sound_type": [
                    2,
