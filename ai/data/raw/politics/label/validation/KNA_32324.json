        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 총리는 농산물 등 상대의 관심 분야는 우리에게 민감한 분야라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.670
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 지혜를 모아 부담을 최소화하며 서로 이익을 극대화하는 방향으로 협의해 갈 수 있다고 말했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.680,
                "end": 13.181
            },
            {
                "speaker_id": "1",
                "transcription": "메르코수르는 브라질과 아르헨티나, 우루과이, 파라과이 등 남미 4개국이 무역 장벽을 허문 공동 시장입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.191,
                "end": 21.838
            },
            {
                "speaker_id": "1",
                "transcription": "남미 인구의 70퍼센트, GDP의 76퍼센트를 차지하는 거대 시장입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.848,
                "end": 27.662
            },
            {
                "speaker_id": "1",
                "transcription": "이 가운데 브라질은 우리나라의 27번째 규모의 교역 상대국입니다.",
                "sound_type": [
                    2
                ],
                "start": 27.672,
                "end": 33.213
            },
            {
                "speaker_id": "1",
                "transcription": "브라질은 메르코수르 회원국의 핵심 국가로 유럽 연합 EU와도 연내에 자유 무역 협정을 타결 짓는다는 계획을 갖고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 33.223,
                "end": 42.800
            }
        ]
    },
    "summary": "이 총리는 브라질과 서로 이익을 극대화하는 방향으로 협의해 갈 수 있다고 말했고 브라질은 메르코수르 회원국의 핵심 국가이며 연내에 유럽 연합과도 자유 무역 협정을 타결할 계획을 갖고 있다.",
