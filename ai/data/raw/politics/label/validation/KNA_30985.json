                "end": 14.177
            },
            {
                "speaker_id": "1",
                "transcription": "검찰이 청와대로 드나든 물건 등을 조사한 결과 최 씨가 지난 2013년 3월부터 11월 사이에 청와대 행정관의 차량을 타고 무단 출입한 것으로 드러났다는 겁니다.",
                "sound_type": [
                    2
                ],
