        "term": [
            {
                "speaker_id": "1",
                "transcription": "새누리당은 오늘이 핵안보 정상회의 시작 전에 원자력법 개정안을 처리할 수 있는 마지막 날이라며 야당의 협조를 촉구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.017
            },
            {
                "speaker_id": "1",
                "transcription": "황우여 대표는 원자력법을 방송법과 연계하는 건 새 정치를 하겠다며 통합 신당 창당 수순을 밟고 있는 야당이 반드시 피해야 할 일이라고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.027,
                "end": 18.435
            },
            {
                "speaker_id": "1",
                "transcription": "최경환 원내대표는 원자력법이 지난 정기국회 최우선 협상 법안이었는데도 야당이 모든 책임을 정부 여당에 전가하며 관계 장관 사퇴까지 요구하는 건 무책임하다며 이런 게 새 정치라면 당장 집어치워야 한다고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.445,
                "end": 33.214
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 원자력법이 그토록 대통령 체면에 중요한 것이라면 방송법이나 민생 관련법도 같이 처리하지 못할 이유가 없다고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.224,
                "end": 42.923
            },
            {
                "speaker_id": "1",
                "transcription": "전병헌 원내대표는 마지막 순간까지 책임을 인정하지 않고 한 치의 양보도 안 하면서 오직 야당에게만 책임을 전가하는 데 골몰하는 여당 모습은 비겁하다고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.933,
                "end": 54.278
            },
            {
                "speaker_id": "1",
                "transcription": "전 원내대표는 원자력법과 방송법 기초연금법을 동시 처리해 민생도 살리고 의회주의도 살리고 대통령의 체면도 살리는 일석삼조의 현명한 선택을 하길 요구한다고 말했습니다.",
                "sound_type": [
                    2,
