        "term": [
            {
                "speaker_id": "1",
                "transcription": "이후에도 상도동계와 동교동계는 민추협 결성을 기념해 한 자리에 모이기도 했지만 가슴 속 앙금은 여전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.969
            },
            {
                "speaker_id": "1",
                "transcription": "오랫동안 소원하게 지내온 두 세력은 지난 2009년 김영삼 전 대통령이 병상에 김대중 전 대통령을 방문하면서 화해의 길로 접어들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.979,
                "end": 18.462
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 방문하신 것을 두 분이 화해로 봐도 되겠습니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.472,
                "end": 21.453
            },
            {
                "speaker_id": "3",
                "transcription": "아 그렇게 봐도 좋죠.",
