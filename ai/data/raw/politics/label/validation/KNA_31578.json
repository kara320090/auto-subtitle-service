    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 @이름1 씨와 @이름2 씨, 김종 전 차관은 모두 재판에 나오지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.370
            },
            {
                "speaker_id": "1",
                "transcription": "1시간 30분 가량 진행된 재판은 조금 전에 끝났는데요.",
                "sound_type": [
                    2
                ],
                "start": 5.380,
                "end": 9.827
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 측과 김존적 김종 전 차관 측은 한국 동계 스포츠 영재 센터의 후원금을 삼성에 강요한 공모 혐의를 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.837,
                "end": 19.462
            },
            {
                "speaker_id": "1",
                "transcription": "반면 @이름2 씨 측은 삼성에 후원금을 요구해 받은 것은 인정했는데요.",
                "sound_type": [
                    2
                ],
                "start": 19.472,
                "end": 24.700
            },
            {
                "speaker_id": "1",
                "transcription": "다만 삼성이 강요에 의해서 후원금을 낸 것인지는 의문이고 특검이 뇌물죄로 수사하고 있는 부분이라고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.710,
                "end": 33.255
            },
            {
                "speaker_id": "1",
                "transcription": "조금 전에는 박근혜 대통령의 지시로 CJ그룹 측의 @이름3 부회장 퇴진 압력을 넣은 혐의를 받고 있는 조원동 전 청와대 경제 수석에 대한 1차 공판 준비 재판이 끝났는데 조 전 수석은 나오지 않았고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.265,
                "end": 47.294
            },
            {
                "speaker_id": "1",
                "transcription": "변호인의 재판 준비가 덜돼 7분 만에 끝났습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.304,
                "end": 51.185
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 오후에는 2시 10분에 박 대통령과 공모해 미르K 스포츠 재단 출연금을 강제 모금한 혐의로 기소된 @이름1 씨와 안종범 전 청와대 수석, 최 씨에게 연설문 등을 넘긴 혐의를 받고 있는 정호성 전 청와대 비서관의 준비 재판이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 51.195,
                "end": 67.901
            },
            {
                "speaker_id": "1",
                "transcription": "이어 오후 3시에는 광고사를 강탈하려한 혐의 등으로 기소된 @이름4 씨와 @이름5 전 한국 콘텐츠 진흥원장 등의 재판이 진행되는데요.",
                "sound_type": [
                    2
                ],
                "start": 67.911,
                "end": 77.163
            },
            {
                "speaker_id": "1",
                "transcription": "재판부는 오늘 재판에서 준비 절차를 모두 마치고 1월 둘째 주부터 본격 변론을 진행할 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 77.173,
                "end": 84.908
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 서울 중앙 지법에서 KBS 뉴스 @이름6입니다.",
                "sound_type": [
                    2
                ],
                "start": 84.918,
                "end": 90.566
            }
        ]
    },
    "summary": "재판에 참석하지 않은 사람이 많지만 재판부는 오늘까지 준비 과정을 모두 마칠 예정이다.",
