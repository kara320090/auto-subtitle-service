        "term": [
            {
                "speaker_id": "1",
                "transcription": "당 지도부가 어제 사실상 자유 투표 허용 방침을 밝힌 가운데 오늘 의총에서는 주류와 비주류 간의 치열한 논리 싸움이 예상됩니다.",
                "sound_type": [
                    2,
