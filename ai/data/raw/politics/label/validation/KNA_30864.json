                ],
                "start": 0.000,
                "end": 9.172
            },
            {
                "speaker_id": "1",
                "transcription": "이에 앞서 비주류 측은 오전에 모임을 갖고 탄핵 가결에 최선을 다하겠다고 다짐했습니다.",
                "sound_type": [
                    2,
