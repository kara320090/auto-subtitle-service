                    2
                ],
                "start": 0.000,
                "end": 6.591
            },
            {
                "speaker_id": "2",
                "transcription": "번호판 자체가 아예 없기 때문에 중고차나 새 차일 텐데요.",
                "sound_type": [
                    2
                ],
                "start": 6.601,
                "end": 9.847
            },
            {
                "speaker_id": "2",
                "transcription": "그럴 경우에는 이거는 이런 예외 조항에 해당되는 물품 반입이 아니라 아예 제재 위반으로 봐야 되고",
                "sound_type": [
                    2
                ],
                "start": 9.857,
                "end": 16.337
            },
            {
                "speaker_id": "1",
                "transcription": "북한으로 반출된 SUV 차량들은 민수용이 아닌 북한 기관과 지도층을 위한 차량으로 보입니다.",
                "sound_type": [
