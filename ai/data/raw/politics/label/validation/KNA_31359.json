        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "맨 뒷좌석이 또 문이 열렸고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.918
            },
            {
                "speaker_id": "1",
                "transcription": "앞쪽은 좀 차가 높아서 손 잡기는 어렵죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.928,
                "end": 5.635
            },
            {
                "speaker_id": "2",
                "transcription": "창문도 색상이 있는 창문이라서 안쪽에서나 바깥쪽에서 가족들을 보시기가 조금 어려운 구조이긴 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.645,
                "end": 16.799
            },
            {
                "speaker_id": "3",
                "transcription": "이리 봐 손 한번만 들어.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.809,
                "end": 23.476
            },
            {
                "speaker_id": "4",
                "transcription": "어떻게 해야 또 만날까.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.486,
                "end": 26.504
            },
            {
                "speaker_id": "4",
                "transcription": "조심해서 헤어지자.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 26.514,
                "end": 31.752
            },
            {
                "speaker_id": "2",
                "transcription": "가족분들이 헤어지면서 가장 작별 상봉 때 많이 하는 말은 100살까지 삽시다 200살까지 사세요 하는 말입니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 31.762,
                "end": 39.629
            },
            {
                "speaker_id": "2",
                "transcription": "언제 또 볼지 모르니까 그리고 이미 가신 분들은 너무 연세가 많이 되셨으니까 나오는 말입니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 39.639,
                "end": 47.389
            },
            {
                "speaker_id": "5",
                "transcription": "어떤 1차, 2차 상봉을 통해서 남북이 똑같이 느낀 건 시간이 없다는 것",
                "sound_type": [
                    2,
                    4
                ],
                "start": 47.399,
                "end": 51.586
            },
            {
                "speaker_id": "2",
                "transcription": "그렇죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 51.596,
                "end": 52.569
            },
            {
                "speaker_id": "2",
                "transcription": "사실은 정말 지금 고령화가 이제는 너무 많이 돼서 한 한 해에 4800분 정도 사망하신다고 통계가 나와있거든요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 52.579,
                "end": 61.746
            },
            {
                "speaker_id": "2",
                "transcription": "그걸 하루로 따지면 하루에 10분가량",
                "sound_type": [
                    2,
                    4
                ],
                "start": 61.756,
                "end": 64.400
            }
        ]
    },
    "summary": "이산가족 상봉 차량은 창문에 색상이 있어 서로를 보기가 어려운 구조였고 가족들이 헤어지면서 가장 많이 하는 말은 오래 살아라는 말로 고령화가 너무 많이 진행돼 한 해에 4800명 정도 사망하신다는 통계다.",
