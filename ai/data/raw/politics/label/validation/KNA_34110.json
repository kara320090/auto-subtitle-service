        "term": [
            {
                "speaker_id": "1",
                "transcription": "잼버리 대회장만 만든다고 되는 게 아니고 그 행사장 주변에 추진 중인 그 기반 시설이 같이 돼야 되기 때문에 각별하게 그 신경을 쓰셔야 될 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.146
            },
            {
                "speaker_id": "2",
                "transcription": "최근 여수 엑스포 세계 박람회와 평창 동계 올림픽이 특별법 제정을 통해 전폭적인 지원을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.156,
                "end": 19.583
            },
            {
                "speaker_id": "3",
                "transcription": "예상이 아니고 해 해야 된다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 19.593,
                "end": 23.467
            },
            {
                "speaker_id": "3",
                "transcription": "지금의 속도로 보면.",
                "sound_type": [
                    2
                ],
                "start": 23.477,
                "end": 25.170
            },
            {
                "speaker_id": "3",
                "transcription": "지금의 속도보다는 빨라야 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 25.180,
                "end": 28.430
            },
            {
                "speaker_id": "2",
                "transcription": "전북 발전을 획기적으로 앞당길 기회가 될 새만금 세계 잼버리.",
                "sound_type": [
                    2
