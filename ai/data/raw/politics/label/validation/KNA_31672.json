        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다시 한번 모든 분들께 죄송합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.203
            },
            {
                "speaker_id": "1",
                "transcription": "합의에 의한 관계였다고 생각했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.213,
                "end": 9.204
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 고소인들께서 그런 것이 아니었다고 하십니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.214,
                "end": 14.034
            },
            {
                "speaker_id": "1",
                "transcription": "사과드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.044,
                "end": 16.363
            },
            {
                "speaker_id": "2",
                "transcription": "안 전 지사는 검찰 조사를 충실히 받고 그에 따른 사법 처리도 달게 받겠다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.373,
                "end": 25.368
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 안 전 지사의 출석은 검찰 수사 일정에 따른 소환 조사인데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.378,
                "end": 30.273
            },
            {
                "speaker_id": "2",
                "transcription": "지난 9일 자진 출석한 지 열흘만입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.283,
                "end": 33.038
            },
            {
                "speaker_id": "2",
                "transcription": "안 전 지사는 정무 비서를 맡았던 @이름1 씨와 자신이 설립한 연구소 직원을 성폭행한 혐의를 받고 있는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.048,
                "end": 40.671
            },
            {
                "speaker_id": "2",
                "transcription": "업무상 위력에 의한 강간 등의 혐의를 받는 피의자 신분입니다.",
                "sound_type": [
                    2
                ],
                "start": 40.681,
                "end": 44.800
            },
            {
                "speaker_id": "2",
                "transcription": "검찰은 열흘 전 안전 지사의 일방적인 출석 통보로 제대로 진행되지 못했던 부분들을 조사할 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 44.810,
                "end": 52.738
            },
            {
                "speaker_id": "2",
                "transcription": "검찰은 특히 추가로 확보한 증거를 바탕으로 안 전 지사와 피해자 간 진술이 엇갈리는 부분을 집중 조사할 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.748,
                "end": 61.419
            },
            {
                "speaker_id": "2",
                "transcription": "특히 안 전 지사가 합의한 관계였다고 주장함에 따라 두 피해자 관계에서 업무상 위력이 있었는지를 조사할 방침입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.429,
                "end": 70.165
            },
            {
                "speaker_id": "2",
                "transcription": "검찰은 주말 동안 안 전 지사 피해자 주고받은 문자와 통화 내용을 분석하고 범행 장소로 지목된 서울 마포 오피스텔과 충남도 지사관사에서 확보한 시시 티브이 분석 등을 통해 기초 조사를 마친 상태입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 70.175,
                "end": 85.166
            }
        ]
    },
    "summary": "안 전 지사는 현재 성폭행 혐의로 수사를 받고 있는데 안 전 지사는 합의된 관계라고 주장하고 있고 피해자들과 서로 다른 진술을 하여 여러 증거와 함께 조사를 계속 이어 나갈 방침이라고 합니다.",
