            },
            {
                "speaker_id": "1",
                "transcription": "새누리당 조해진, 새정치연합 이춘석 원내수석 부대표는 세월호법 시행령 문제를 집중 논의했지만 협상이 결렬됐습니다.",
                "sound_type": [
                    2,
