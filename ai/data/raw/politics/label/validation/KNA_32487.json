        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 후보자가 신고한 2019년 종합소득액은 사업소득 1260만 원을 포함해 3000만 원이 넘습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.674
            },
            {
                "speaker_id": "1",
                "transcription": "2020년에는 7000여만 원을 신고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.684,
                "end": 10.946
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이 후보자는 2020년 12월부터 1년 가까이 직장인 아들의 건강보험 피부양자로 등록돼 건강보험료를 내지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.956,
                "end": 21.166
            },
            {
                "speaker_id": "1",
                "transcription": "사업소득 500만 원, 종합소득이 3400만 원이 넘으면 피부양자 등록이 불가능합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.176,
                "end": 27.705
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보자 측은 소득 요건 등이 충족돼 건강보험공단이 피부양자로 인정했다며 문제가 없다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.715,
                "end": 35.926
            },
            {
                "speaker_id": "1",
                "transcription": "아들의 학교폭력 의혹도 핵심 쟁점입니다.",
                "sound_type": [
                    2
                ],
                "start": 35.936,
                "end": 39.587
            },
            {
                "speaker_id": "1",
                "transcription": "2012년 하나고 학생 2명은 이 후보자 아들에게서 폭행을 당했다는 피해 진술서를 썼는데 당시 법적으로 열렸어야 할 학교폭력위원회는 열리지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.597,
                "end": 50.383
            }
        ]
    },
    "summary": "@이름1 후보자는 2019년 종합소득액이 3000만 원이 넘고 2020년에는 7000여만 원을 신고했지만 1년 가까이 아들의 건강보험 피부양자로 건강보험료를 내지 않았고 아들의 학교폭력 의혹도 핵심 쟁점이라고 기자는 설명했다.",
