        "term": [
            {
                "speaker_id": "1",
                "transcription": "이후 기자 회견과 청문회에서 논란에 대해 거듭 해명했지만 국회는 박 후보자가 장관으로 부적격하다는 청문 보고서를 채택했고 결국 중소 벤처 기업부 초대 장관 후보자로 지명된 지 22일 만에 물러났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 16.442
            },
            {
                "speaker_id": "1",
                "transcription": "청와대는 박 후보자의 사퇴를 존중한단 입장을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.452,
                "end": 20.578
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 대통령 비서 실장은 박 후보자에 대해 부적격 보고서를 채택했던 국회의 의사를 존중하고 수용한다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.588,
                "end": 29.900
            },
            {
                "speaker_id": "1",
                "transcription": "더불어민주당은 안타깝지만 박 장관 후보자의 자진 사퇴를 존중한다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.910,
                "end": 36.203
            },
            {
                "speaker_id": "1",
                "transcription": "자유한국당은 박 후보자의 자진 사퇴는 사필귀정이라며 청와대 인사 라인의 교체가 필요하다고 논평했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.213,
                "end": 43.816
            },
            {
                "speaker_id": "1",
                "transcription": "국민의당은 결정을 존중한다며 인사 난맥으로 인한 피해자가 더 이상 없길 바란다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.826,
                "end": 50.984
            },
            {
                "speaker_id": "1",
                "transcription": "바른정당은 당연한 결과라고 논평했고 정의당은 만시지탄이라고 평가했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.994,
                "end": 56.889
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름2입니다.",
                "sound_type": [
                    2,
