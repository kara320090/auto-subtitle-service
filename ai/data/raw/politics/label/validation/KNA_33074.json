        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 내년도 국가 연구 개발 예산을 대폭 삭감하겠다고 발표한 뒤 과학 기술 관련 10개 단체가 공동 대응에 나선 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.287
            },
            {
                "speaker_id": "1",
                "transcription": "이들은 정부의 예산 삭감 발표가 현장과 소통 없는 일방적 결정이었다며 연구 현장이 파괴될 것이라고 우려했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.297,
                "end": 16.403
            },
            {
                "speaker_id": "2",
                "transcription": "비정규 있는 학생들 인건비가 줄어들게 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.413,
                "end": 19.892
            },
            {
                "speaker_id": "2",
                "transcription": "이게 돈이 없어서 계약을 할 수가 없는 상황에 처몰리게 되는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.902,
                "end": 23.664
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 학생들이 가장 먼저 계약이 해지되고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.674,
                "end": 26.783
            },
            {
                "speaker_id": "3",
                "transcription": "저희 전기료 또 어떻게 분담하나 그 고민하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.793,
                "end": 30.497
            }
        ]
