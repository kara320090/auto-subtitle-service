                "end": 30.613
            },
            {
                "speaker_id": "1",
                "transcription": "환경부는 이러한 사실을 인정하면서도 장 차관을 비롯해 윗선에 보고 하지는 않았다고 선을 그었습니다.",
                "sound_type": [
                    2
