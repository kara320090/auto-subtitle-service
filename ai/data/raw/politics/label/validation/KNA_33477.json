        "term": [
            {
                "speaker_id": "1",
                "transcription": "사시는 곳 슬로건이 뭔지 아세요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.909
            },
            {
                "speaker_id": "2",
                "transcription": "아니요 모르고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.919,
                "end": 3.144
            },
            {
                "speaker_id": "2",
                "transcription": "아무도 모르는데 계속 예산을 들여서 한다는 게 어 시대에 맞지 않는 것 같습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.144,
                "end": 9.486
            },
            {
                "speaker_id": "3",
                "transcription": "학교에 교장이나 선생님 바뀌었다고 해 가지고 막 교훈을 마음대로 바꾸는 거하고 별반 차이가 없다고 생각해요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 9.496,
                "end": 15.788
            },
            {
                "speaker_id": "1",
                "transcription": "슬로건이 효과를 거두려면 지속 기간이 중요하다는 지적입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.798,
                "end": 20.720
            }
        ]
    },
    "summary": "슬로건이 효과를 거두려면 지속 기간이 중요하고 아무도 모르는 슬로건에 예산을 들이는 건 시대에 맞지 않고 학교 교장이나 선생님이 바뀌어 교훈을 마음대로 바꾸는 것과 차이가 없다고 했다.",
