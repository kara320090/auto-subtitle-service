        "term": [
            {
                "speaker_id": "1",
                "transcription": "유엔 안보리 대북 체제 결의안의 수위를 높이기 위해 외교 장관이 직접 유엔 외교에 나서기는 처음입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.948
            },
            {
                "speaker_id": "1",
                "transcription": "중국 러시아 대사를 포함한 안보리 15개 이사국과 의장을 모두 만났습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.958,
                "end": 12.149
            },
            {
                "speaker_id": "1",
                "transcription": "유엔 제재는 북한의 추가 핵 도발을 확실히 막을 수 있을 정도의 이른바 끝장 결의안이 되어야 한다는 입장을 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.159,
                "end": 20.923
            },
            {
                "speaker_id": "1",
                "transcription": "윤 장관은 이어 유엔 제재가 실효를 거두려면 더 강력한 각국의 독자 제재가 더해져야 한다며 개성 공단 중단도 그런 차원이라고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.933,
                "end": 31.975
            },
            {
                "speaker_id": "2",
                "transcription": "개성 공단에 대한 그런 어려운 결정을 내린 것도 이러한 국제 사회의 노력에 부흥하고자 하는 우리의 이런 엄중한 자세를",
                "sound_type": [
                    2
                ],
                "start": 31.985,
                "end": 40.633
            }
        ]
    },
    "summary": "유엔 안보리 대북 체제 결의안의 수위를 높이기 위해 외교 장관이 직접 유엔 외교에 나서 안보리 15개 이사국과 의장을 모두 만났고 유엔 제재는 북한의 핵 도발을 확실히 억제할 수 있는 끝장 결의안이 되어야 한다고 했습니다.",
