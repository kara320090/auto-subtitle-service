        "term": [
            {
                "speaker_id": "1",
                "transcription": "이르면 이달 말 열릴 2차 고위급 접촉에선 이산 가족 상봉 문제를 최우선 의제로 삼을 방침입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.238
            },
            {
                "speaker_id": "1",
                "transcription": "류길재 통일부 장관은 특히 이에 대한 특단의 방안을 협의할 계획이라며 강력한 의지를 내비쳤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.248,
                "end": 13.617
            },
            {
                "speaker_id": "2",
                "transcription": "특단의 좀 더 특별한 그런 지금 방안을 북한과 같이 협 협의를 해나가야 될 시점이 아닌가",
                "sound_type": [
                    2
                ],
                "start": 13.627,
                "end": 21.974
            },
            {
                "speaker_id": "1",
                "transcription": "이산 상봉과 오이사 조치 금강산 관광 북핵 문제 등 모든 현안을 고위급 접촉에서 논의하되 분야별로 다양한 형식의 대화를 병행할 가능성도 밝혔습니다.",
                "sound_type": [
