        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰은 @이름1 전 경제수석이 지난 2013년 7월 @이름2 CJ그룹 회장을 만나 @이름3 부회장의 사퇴를 압박했다며 강요미수 혐의로 재판에 넘겼습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.364
            },
            {
                "speaker_id": "1",
                "transcription": "당시 조 전 수석이 손 회장을 만나기 전 청와대에서 박 대통령으로부터 지시를 받았다는 게 검찰의 판단입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.374,
                "end": 17.714
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 @이름4 전 문화체육관광부 차관을 기소하면서 그랜드코리아레저에 압력을 행사해 장애인 펜싱팀을 창단하게 한 혐의도 박 대통령과 공모 관계가 있었다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.724,
                "end": 28.809
            },
            {
                "speaker_id": "1",
                "transcription": "검찰의 수사 결과를 종합하면 @이름5 게이트의 박 대통령 공모 혐의는 8건에 이릅니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.819,
                "end": 34.976
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 지난 10월 수사에 착수한 뒤 검사 40여 명을 투입해 410여 명을 조사하고 헌정 사상 처음으로 현역 대통령을 피의자로 입건했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.986,
                "end": 44.841
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 뒷북 수사 논란과 김기춘 전 청와대 비서실장, @이름6 전 민정수석을 강도 높게 조사하지 못한 건 한계라는 평가를 받고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.851,
                "end": 54.204
            },
            {
                "speaker_id": "1",
                "transcription": "이들에 대한 수사와 기업들이 재단에 지원한 것의 대가성 여부, 세월호 7시간 의혹 등은 @이름7 특별검사팀이 밝혀야 할 과제가 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 54.214,
                "end": 63.496
            },
            {
                "speaker_id": "1",
                "transcription": "검찰로부터 수사 기록과 증거물 등을 넘겨 받은 특검팀은 서울 대치동 사무실로 입주하는 13일부터 본격 수사에 착수합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 63.506,
                "end": 71.562
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름8입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 71.572,
                "end": 74.933
            }
        ]
    },
    "summary": "조 전 청와대 경제수석이 CJ 그룹 부회장 퇴진 압박 과정에도 대통령이 공모했다고 밝히면서 검찰은 @이름5 게이트의 박 대통령 공모 혐의 총 8건을 밝혀냈고 기업들의 재단 지원 대가성 여부와 세월호 7시간 의혹 등은 추가 수사가 필요하다며 특검으로 공을 넘겨 특검팀이 13일부터 수사에 들어갈 예정이다.",
