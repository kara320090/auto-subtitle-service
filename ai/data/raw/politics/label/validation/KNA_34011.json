                ],
                "start": 0.000,
                "end": 8.421
            },
            {
                "speaker_id": "2",
                "transcription": "지금 이 차선 가지고도 애매한데 조금 줄이면 조금 더 혼잡해질 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
