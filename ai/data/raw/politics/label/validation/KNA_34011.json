        "term": [
            {
                "speaker_id": "1",
                "transcription": "도로 양쪽을 한 차로씩 줄이고 교통 혼잡이 예상되는 일부 구간은 한쪽 차로만 줄일 계획이지만 우려도 큽니다.",
                "sound_type": [
                    2,
