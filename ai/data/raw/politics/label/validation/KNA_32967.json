        "term": [
            {
                "speaker_id": "1",
                "transcription": "이같은 치적 홍보용 현수막을 모든 주민센터에 설치하는데 1000만 원이 넘는 돈이 들었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.989
            },
            {
                "speaker_id": "1",
                "transcription": "더욱이 구청이 인용한 살기 좋은 구 1위라는 연구 결과는 표절로 드러나 공표가 금지된 자료입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.999,
                "end": 14.149
            },
            {
                "speaker_id": "2",
                "transcription": "폐기했고 연구자에 대한 제재 조치를 했고 인용하지 말라는 보도자료를 냈었거든요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.159,
                "end": 20.802
            },
            {
                "speaker_id": "2",
                "transcription": "특히 그 등수를 매긴 건 아니에요.",
                "sound_type": [
                    2
                ],
                "start": 20.812,
                "end": 22.777
            },
            {
                "speaker_id": "3",
                "transcription": "좀 미스가 있었던 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.787,
                "end": 24.720
            },
            {
                "speaker_id": "3",
                "transcription": "좋은 쪽으로 한 번 홍보라도 해보고 싶어 가지고 그렇게 하다 보니까.",
                "sound_type": [
                    2
                ],
                "start": 24.730,
                "end": 28.000
            }
        ]
    },
