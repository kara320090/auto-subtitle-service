        "term": [
            {
                "speaker_id": "1",
                "transcription": "중앙 선관위가 간부 자녀의 특혜 채용 의혹에 대해 감사원 감사를 받아들이기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.086
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 선관 위원 9명의 만장일치로 감사를 받을 수 없다고 결론낸 지 일주일 만입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.096,
                "end": 13.072
            },
            {
                "speaker_id": "2",
                "transcription": "헌법 위에 군림하는 기관이라는 비판도 있는데 어떻게 보세요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.082,
                "end": 16.744
            },
            {
                "speaker_id": "3",
                "transcription": "수고하십니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.754,
                "end": 17.942
            },
            {
                "speaker_id": "1",
                "transcription": "선관위는 헌법 97조에 따라 선관위는 행정 기관이 아니며 따라서 감사원의 직무 감찰 대상도 아니라고 주장해 왔지만 총선을 앞두고 잇따른 채용 비리 의혹이 불거진 데 따른 부담감이 작용한 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.952,
                "end": 33.241
            },
            {
                "speaker_id": "1",
                "transcription": "다만 선관위는 감사원 감사의 법적 근거를 따져보겠다는 입장을 내놓았습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.251,
                "end": 38.769
            },
            {
                "speaker_id": "1",
                "transcription": "선관위와 감사원이 다투는 것으로 비춰지는 건 바람직하지 않다며 이를 명확히 하기 위해 헌법 재판소에 권한 쟁의 심판을 신청하겠다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 38.779,
                "end": 49.015
            }
        ]
    },
    "summary": "중앙 선관위는 헌법 97조에서 행정 기관이 아니라 감사원 직무 감찰 대상도 아니라며 선관 위원들의 만장일치로 감사를 받을 수 없다고 한 지 일주일 만에 부담감이 작용해 간부 자녀 특혜 채용 의혹의 감사원 감사를 받아들였지만 감사원 감사의 법적 근거를 따지기 위해 헌법 재판소에 권한 쟁의 심판을 신청하겠다고 했다.",
