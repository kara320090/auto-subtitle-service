        "term": [
            {
                "speaker_id": "1",
                "transcription": "착공식마다 으레 등장하는 첫 삽을 뜨는 모습",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.539
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이번에는 볼 수 없었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.549,
                "end": 6.029
            },
            {
                "speaker_id": "1",
                "transcription": "남북 대표가 침묵의 기념 서명을 하고 궤도를 연결하는 등의 행사로 마무리해야 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.039,
                "end": 12.182
            },
            {
                "speaker_id": "1",
                "transcription": "착공식이라 해도 일의 시작을 알리는 착수식의 성격이 크다는 정부의 설명과 같은 맥락입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.192,
                "end": 18.674
            },
            {
                "speaker_id": "2",
                "transcription": "바로 공사에 들어가는 것은 아니고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.684,
                "end": 21.199
            },
            {
                "speaker_id": "2",
                "transcription": "북측과 현대화의 수준이라든가 노선 그리고 사업 방식 등에 대해서 구체적인 내용을 협의해 나갈 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.209,
                "end": 28.910
            },
            {
                "speaker_id": "1",
                "transcription": "가장 시급한 건 북한의 철도 도로 상태에 대한 본격적인 조사",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.920,
                "end": 33.443
            },
            {
                "speaker_id": "1",
                "transcription": "지난달 말부터 진행된 북측 경의선, 동해선 선로 조사",
                "sound_type": [
                    2
                ],
                "start": 33.453,
                "end": 37.600
            }
        ]
    },
    "summary": "남북 대표는 기념 서명을 하고 궤도를 연결하는 등의 행사로 마무리했고 구체적인 조사를 한 뒤 공사에 들어갈 것이라고 밝혔다.",
