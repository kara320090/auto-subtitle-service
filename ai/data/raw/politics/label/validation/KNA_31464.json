        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "총선 120일 전인 오늘 현행 246개 지역구를 대상으로 예비 후보자 등록이 시작됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.340
            },
            {
                "speaker_id": "1",
                "transcription": "오전 11시 반 현재 서울과 부산 등 전국에서 30여 명이 예비 후보 등록을 마쳤습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.350,
                "end": 12.441
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 내년 총선 선거구가 아직 정해지지 않은 상태여서 분구와 합구가 예상되는 지역에서는 혼란도 예상됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.451,
                "end": 20.910
            },
            {
                "speaker_id": "1",
                "transcription": "특히 보름쯤 뒤인 이달 31일까지 선거구 획정안이 마련되지 않을 경우 현행 선거구가 없어지고 예비 후보 등록도 무효가 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.920,
                "end": 30.367
            },
            {
                "speaker_id": "1",
                "transcription": "여야는 선거구 획정을 놓고 어제 심야 회동에 이어 오늘 오전 11시에 양당 대표, 원내대표가 국회의장과 함께 만나 담판을 벌이고 있지만 이견이 커 합의를 볼 수 있을 지는 불투명합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.377,
                "end": 43.749
            },
            {
                "speaker_id": "1",
                "transcription": "새정치연합 문재인 대표는 모두 발언에서 선거구 협상에서 더 이상 물러설 곳이 없다며 새누리당이 움직이지 않고 있어 합의가 되지 않고 있다고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.759,
                "end": 54.460
            },
            {
                "speaker_id": "1",
                "transcription": "이에 새누리당 원유철 원내 대표는 선거 룰을 정하는 것은 양보의 문제가 아니라 공정성의 문제라며 선거 제도에 관해서는 얼마든지 열린 자세로 논의할 수 있다고 반박했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 54.470,
                "end": 67.133
            }
        ]
    },
    "summary": "20대 국회의원 선거 예비 후보자 등록이 시작됐지만 선거구가 획정되지 않은 상태이고 여야 지도부는 국회의장 중재로 만나 선거구 획정 담판을 벌이고 있다.",
