        "term": [
            {
                "speaker_id": "1",
                "transcription": "다만 아직은 한계가 뚜렷합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.158
            },
            {
                "speaker_id": "1",
                "transcription": "농업과 환경 분야의 규제 특례는 3년짜리 시한부 특례입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.168,
                "end": 6.345
            },
            {
                "speaker_id": "1",
                "transcription": "연장을 하려면 정부 평가와 국회 동의를 다시 받아야 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.355,
                "end": 10.459
            },
            {
                "speaker_id": "1",
                "transcription": "또 교육 특례와 자치권 확보도 미흡합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.469,
                "end": 14.091
            },
            {
                "speaker_id": "1",
                "transcription": "강원 특별 자치도는 이번 주 일요일에 공식 출범합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.101,
                "end": 18.105
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 특별법에 담긴 각종 특례는 앞으로 1년 뒤에나 시행이 될 예정입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.115,
                "end": 23.390
            }
        ]
    },
    "summary": "강원 특별 자치도는 이번 주 일요일에 공식 출범하지만 특례는 1년 뒤 시행 예정이며 농업, 환경 규제 특례는 3년 시한부로 한계가 있고 연장하려면 정부 평가와 국회 동의를 받아야 하며 교육 특례, 자치권 확보도 미흡하다.",
