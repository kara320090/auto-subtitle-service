        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "새누리당 김무성 대표는 개성공단 조업 중단은 불가피한 결정이라고 평가했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.941
            },
            {
                "speaker_id": "1",
                "transcription": "북한 김정은 정권을 럭비공 정권 악동 정권으로 규정하며 강도 높고 실효적인 제재를 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.951,
                "end": 13.041
            },
            {
                "speaker_id": "1",
                "transcription": "야당을 향해선 화해와 협력 타령만 늘어 놓는 어설픈 평화론자들은 생각을 바꿔야 한다며 안보 보안 통과에 적극 협조해 달라고 당부했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.051,
                "end": 23.248
            },
            {
                "speaker_id": "1",
                "transcription": "원유철 원내 대표도 개성공단 가동 중단에 책임은 전적으로 김정은 정권에 있다며 우리가 제공하는 평화의 땅이 공포의 무기로 돌아오는 악순환을 끊어야 한다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.258,
                "end": 35.704
            },
            {
                "speaker_id": "1",
                "transcription": "더불어 민주당 이종걸 원내 대표는 개성공단은 통일 대박의 징검다리 역할을 하는 곳이라며 조업 중단 결정을 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.714,
                "end": 44.305
            },
            {
                "speaker_id": "1",
                "transcription": "개성공단을 통한 북한의 수익보다 우리 기업들의 수익이 더 많다며 공단 폐쇄는 실효적 제재 수단이 아닐 뿐 아니라 공단 입주 기업들의 생계에 영향을 미치는 문제라고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.315,
                "end": 56.811
            },
            {
                "speaker_id": "1",
                "transcription": "또 개성 공단 조업 중단이 선거를 앞둔 고풍 전략이 아니냐고 주장하며 선거 전략을 국민 생계와 남북한 운명 등으로 떠넘기는 건 하책 중에 하책이라고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.821,
                "end": 69.104
            },
            {
                "speaker_id": "1",
                "transcription": "안보 상황을 악용한 테러 방지법 등 안보 법률에 졸속 강행 처리에도 응하지 않겠다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 69.114,
                "end": 76.566
            }
        ]
    },
    "summary": "새누리당 김무성 대표는 개성공단 조업 중단은 불가피한 상황으로 김정은 정권은 럭비공 정권이라며 실효적인 제재를 강조했고 더불어 민주당 이종걸 원내 대표는 개성 공단은 통일 대박의 징검다리를 역할을 한다며 조업 중단 결정을 비판했습니다.",
