        "term": [
            {
                "speaker_id": "1",
                "transcription": "새누리당은 트럼프 당선과 관련해 최고 위원 회의를 현안 보고 형식으로 진행하고 간담회와 세미나를 잇따라 여는 등 사실상 트럼프 비상 체제를 가동했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.269
            },
            {
                "speaker_id": "1",
                "transcription": "정진석 원내 대표는 기자 간담회를 열고 트럼프 당선에 따른 초당적 대응이 필요하다며 정국을 빨리 정상화해야 한다고 야당에 촉구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.279,
                "end": 21.298
            },
            {
                "speaker_id": "1",
                "transcription": "정 원내 대표는 또 거국 중립 내각이 구성되면 야당이 요구하는 대로 대통령이 당적을 정리하는 것을 검토할 수 있다면서 트럼프 당선으로 인한 시장 불확실성을 잠재우기 위해 @이름1 경제 부총리 내정자 청문회부터 먼저 시작하자고 야당에 공개 제안했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.308,
                "end": 39.371
            },
            {
                "speaker_id": "1",
                "transcription": "이정현 대표는 문재인 민주당 전 대표가 국군 통수권과 계엄권까지도 총리에게 넘겨야 한다고 말했다며 헌정을 중단시키겠다는 의도인지 해명을 들어야 한다고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.381,
                "end": 51.981
            },
            {
                "speaker_id": "1",
                "transcription": "더불어민주당은 지금은 총리 추천보다 @이름2 사건 진상 규명이 우선이라고 맞섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.991,
                "end": 57.977
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 추미애 대표는 오늘 의원 총회에서 진실 규명과 책임자 처벌에 집중하자면서 대통령은 국정에서 손을 떼야한다고 거듭 압박했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.987,
                "end": 68.385
            },
            {
                "speaker_id": "1",
                "transcription": "우상우 원내 대표는 미 의회 지도자들은 한미 관계의 변화를 원하지 않는다며 트럼프 당선에 국민들이 과도하게 불안을 느끼지 않아도 좋다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 68.395,
                "end": 78.848
            },
            {
                "speaker_id": "1",
                "transcription": "박지원 국민의 당 비상 대책 위원장도 대통령의 탈당과 영수 회담을 통해 총리 추천이 필요하다고 강조하면서 트럼프 당선인은 실리적으로 접근할 것으로 보여 우리나라의 전화위복의 계기가 될 수 있다고 진단했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 78.858,
                "end": 93.099
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름3입니다.",
