        "term": [
            {
                "speaker_id": "1",
                "transcription": "서울 중앙 지법 형사 22부는 오늘 신계륜 의원에게 징역 2년에 벌금 2500만 원, 신학용 의원에게는 징역 2년 6개월에 벌금 3100만 원의 실형을 각각 선고했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.700
            },
            {
                "speaker_id": "1",
                "transcription": "재판부는 피고인이 혐의를 다투고 있어 방어권 보장을 위해 두 의원을 법정 구속하지는 않기로 했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.710,
                "end": 17.829
            },
            {
                "speaker_id": "1",
                "transcription": "신계륜 의원은 학교 이름에서 직업을 빼고 실용을 넣을 수 있게 법을 고쳐주는 대가로 서울 종합 예술 실용 학교 @이름1 이사장으로부터 현금과 상품권 등 5500만 원을 받은 혐의로 기소됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.839,
                "end": 30.540
            },
            {
                "speaker_id": "1",
                "transcription": "신학용 의원도 김 이사장으로부터 같은 청탁과 함께 1500만 원을 받은 혐의로 재판에 넘겨졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.550,
                "end": 37.279
            },
            {
                "speaker_id": "1",
                "transcription": "신학용 의원은 또 사립 유치원 관련 법안을 대표 발의한 대가로 출판 기념회에서 한국 유치원 총연합회로부터 3000여만 원을 받은 혐의로 기소됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.289,
                "end": 47.817
            },
            {
                "speaker_id": "1",
                "transcription": "신학용 의원은 1심 선고에 앞선 지난 10일 내년 4월 총선 불출마를 선언했습니다.",
                "sound_type": [
