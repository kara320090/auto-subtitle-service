        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이른 아침 백발이 성성한 노객들이 열차에 오릅니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.564
            },
            {
                "speaker_id": "2",
                "transcription": "고향이 어디세요?",
                "sound_type": [
                    2
                ],
                "start": 3.574,
                "end": 4.985
            },
            {
                "speaker_id": "3",
                "transcription": "고향이요? 황해도 평산이요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.995,
                "end": 7.494
            },
            {
                "speaker_id": "4",
                "transcription": "고향은 평북이에요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.504,
                "end": 9.343
            },
            {
                "speaker_id": "2",
                "transcription": "평북 어디요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.353,
                "end": 10.959
            },
            {
                "speaker_id": "4",
                "transcription": "정주.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.969,
                "end": 12.239
            },
            {
                "speaker_id": "1",
                "transcription": "북녘에 가족을 둔 이산 가족들입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.249,
                "end": 15.385
            },
            {
                "speaker_id": "1",
                "transcription": "북으로 가는 열차를 타고 2시간 넘게 달려 도착한 곳은 더 이상 올라갈 수 없는 백마 고지역",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.395,
                "end": 22.136
            },
            {
                "speaker_id": "1",
                "transcription": "여기서부턴 끊긴 철로 대신 차를 타고 곳곳을 둘러봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.146,
                "end": 27.081
            },
            {
                "speaker_id": "5",
                "transcription": "가슴이 아픈데 늘 전쟁만 얘기 할 수는 없잖아요.",
                "sound_type": [
                    2
                ],
                "start": 27.091,
                "end": 31.293
            },
            {
                "speaker_id": "5",
                "transcription": "그렇죠?",
                "sound_type": [
                    2
                ],
                "start": 31.303,
                "end": 32.154
            },
            {
                "speaker_id": "5",
                "transcription": "그래서 여기가 이제 평화를 의미하는 곳으로",
                "sound_type": [
                    2
                ],
                "start": 32.164,
                "end": 36.692
            },
            {
                "speaker_id": "1",
                "transcription": "한눈에 들어온 북녘땅을 바라보며 고향 생각 가족 생각에 빠져듭니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.702,
                "end": 42.287
            },
            {
                "speaker_id": "6",
                "transcription": "신청했죠.",
                "sound_type": [
                    2
                ],
                "start": 42.297,
                "end": 43.649
            },
            {
                "speaker_id": "2",
                "transcription": "어떠세요 마음이?",
                "sound_type": [
                    2
                ],
                "start": 43.659,
                "end": 45.192
            },
            {
                "speaker_id": "6",
                "transcription": "만날 수 있을까 쉽지.",
                "sound_type": [
                    2
                ],
                "start": 45.202,
                "end": 48.100
            }
        ]
    },
    "summary": "이산 가족들이 백마 고지역에서 할 수 없이 내려 북녘땅을 바라보며 고향 생각 가족 생각에 빠져듭니다.",
