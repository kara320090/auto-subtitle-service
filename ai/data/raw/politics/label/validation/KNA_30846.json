        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 오늘 발표한 독자 대북 제재에는 중국 홍샹 실업이 포함됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.244
            },
            {
                "speaker_id": "1",
                "transcription": "홍샹 실업은 북한 핵과 미사일 개발에 필요한 물자를 수출한 혐의로 이미 미국의 제재를 받고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.254,
                "end": 12.418
            },
            {
                "speaker_id": "1",
                "transcription": "중국 기업이 우리 제재 대상에 오른 건 처음으로 현재 북한과 관계를 맺고 있는 다른 국제 기업들에 대한 경고의 메시지로 해석됩니다.",
                "sound_type": [
                    2
                ],
                "start": 12.428,
                "end": 21.705
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 앞으로도 북한의 불법 활동을 지원하는 개인과 단체에 대해서는 국적을 불문하고 단호히 대응해 나갈 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.715,
                "end": 31.878
            },
            {
                "speaker_id": "1",
                "transcription": "황병서와 최룡해 조선 노동당과 국무 위원회 등 북한 정권을 떠받치는 핵심 기관과 개인도 제재 대상에 올랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.888,
                "end": 40.236
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 관심을 끌었던 김정은과 김여정은 포함되지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 40.246,
                "end": 44.733
            }
        ]
    },
    "summary": "정부가 발표한 독자 대북 제재에는 중국 홍샹 실업이 포함됐는데 중국 기업이 우리 제재 대상에 오른 건 처음으로 북한과 관계 맺고 있는 다른 국제 기업들에 대한 경고의 메시지로 해석되며 북한 정권을 떠받치는 핵심 기관과 개인도 제재 대상에 올랐지만 김정은과 김여정은 포함되지 않았다.",
