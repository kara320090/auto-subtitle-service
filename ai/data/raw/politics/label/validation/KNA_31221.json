        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "국정화 확정 공시에 반발해 새 정치 연합이 의사 일정을 거부하면서 국회 일정은 이틀째 파행됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.944
            },
            {
                "speaker_id": "1",
                "transcription": "내년도 예산안 심사를 위한 국회 예결위 회의는 새누리당 의원들만 참석했다 30분 만에 정회됐고",
                "sound_type": [
                    2
                ],
                "start": 6.954,
                "end": 13.712
            },
            {
                "speaker_id": "1",
                "transcription": "강호인 국토 교통부 장관 후보자 청문회는 연기됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.722,
                "end": 18.045
            },
            {
                "speaker_id": "1",
                "transcription": "새 정치 연합은 문재인 대표가 대국민 담화를 발표했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.055,
                "end": 22.217
            },
            {
                "speaker_id": "1",
                "transcription": "문 대표는 정부의 확정 고시 강행은 명백한 불법 행정으로 국정 교과서를 만들어도 1년 짜리 시한부일 뿐이라며 국민들이 불복종 운동에 나서달라고 호소했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.227,
                "end": 33.773
            },
            {
                "speaker_id": "1",
                "transcription": "또 헌법 소원과 국정 교과서 금지법 등 법적 제도적 수단을 모두 동원하고 국정화에 반대하는 다른 정당 학계 시민 사회와 강력한 연대의 틀을 논의하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.783,
                "end": 46.976
            },
            {
                "speaker_id": "1",
                "transcription": "새누리당은 역사 교과서의 매몰되면 산적한 국정 현안은 어떻게 되냐며 야당을 성토했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.986,
                "end": 53.683
            },
            {
                "speaker_id": "1",
                "transcription": "김무성 대표는 국회의원이 무단 결근을 계속하면 국민이 결코 용서하지 않을 것이라며 야당은 국회 파행을 멈추라고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.693,
                "end": 63.318
            },
            {
                "speaker_id": "1",
                "transcription": "새누리당 예결 위원들은 기자회견을 열어 국정화 확정 고시가 국회 고유 권한인 예산 심의권을 거부할 사유가 될 순 없다면서 야당은 즉시 내년도 예산안 심의에 착수하라고 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 63.328,
                "end": 76.230
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 76.240,
                "end": 79.633
            }
        ]
    },
    "summary": "역사 교과서 국정화 확정 고시를 둘러싼 정쟁으로 국회 의사 일정이 이틀째 파행되고 있고 문재인 새 정치 연합 대표는 국민들이 함께 불복종 운동에 나서달라고 호소했고 김무성 새누리당 대표는 국민들이 국회 파행을 용서하지 않을 것이라고 비판했습니다.",
