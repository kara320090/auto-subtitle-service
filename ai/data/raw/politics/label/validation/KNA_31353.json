        "term": [
            {
                "speaker_id": "1",
                "transcription": "화상 상봉 같은 경우는 이미 센터가 몇 군데 마련이 돼있잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.204
            },
            {
                "speaker_id": "2",
                "transcription": "네 그렇지만 화상 상봉 같은 경우에는 한 7번 정도 진행이 됐었는데 2005년부터 2007년에 진행이 됐었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.214,
                "end": 11.610
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 그 이후에는 안타깝게도 더 이상 진행되지 않고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.620,
                "end": 15.983
            },
            {
                "speaker_id": "1",
                "transcription": "기술적인 문제가 아니라 의지 문제겠네요.",
