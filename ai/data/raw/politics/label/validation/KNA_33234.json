                "end": 5.279
            },
            {
                "speaker_id": "1",
                "transcription": "경찰 조사 단계에서 진술을 하지 않았던 @이름1 씨가 검찰 조사에서는 구체적으로 진술해 한때 기소가 가능하다는 견해가 있었지만",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.289,
                "end": 15.067
            },
            {
                "speaker_id": "1",
                "transcription": "대검찰청까지 나서 법리 검토를 한 끝에 불기소하기로 가닥을 잡은 겁니다.",
                "sound_type": [
                    2
