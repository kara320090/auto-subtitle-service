                "start": 15.077,
                "end": 20.537
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 그러나 이 지사의 부인 @이름2 씨는 무혐의로 판단하고 기소하지 않기로 결정했습니다.",
                "sound_type": [
