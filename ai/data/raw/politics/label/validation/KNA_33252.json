        "term": [
            {
                "speaker_id": "1",
                "transcription": "가장 큰 이유는 역시 대북 제재",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.605
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령이 사실상 착공식이 아닌 착수식이라 명명한 이유도 여기에 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.615,
                "end": 8.564
            },
            {
                "speaker_id": "2",
                "transcription": "일단 일을 시작한다는 하나의 착수식이라는 의미에서 그 이렇게 착수식을 할 수 있지 않을까.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.574,
                "end": 16.035
            },
            {
                "speaker_id": "1",
                "transcription": "또 짧은 일정 탓에 철로 북측 구간에 대한 정밀 조사가 어렵고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.045,
                "end": 20.867
            },
            {
                "speaker_id": "1",
                "transcription": "현대화 어느 수준으로 할지 남북이 논의조차 시작하지 못하고 있다는 점도 걸림돌입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.877,
                "end": 27.710
            },
            {
                "speaker_id": "3",
                "transcription": "적어도 어 기본 계획이라는 단계까지 만든 다음에 그다음에 이제 착공을 하게 됩니다. 그러니까 앞으로 어 일단 이 조사 끝나고 나서도 꽤 많은 이러한 그 난관들이 있을 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 27.720,
                "end": 39.166
            }
        ]
    },
    "summary": "문 대통령은 착공식이 아닌 일을 시작한다는 의미에서 착수식이라 명명했고 짧은 일정 때문에 북측의 철로 구간에 대한 정밀 조사가 필요한 상황이다.",
