        "term": [
            {
                "speaker_id": "1",
                "transcription": "야당이 제안한 황교안 대통령 권한대행과의 회동 제안에 국무총리실은 공감한다는 뜻을 내놨습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.091
            },
            {
                "speaker_id": "1",
                "transcription": "총리실은 보도자료를 통해 국정 안정 방안 협의를 위해선 여야정이 함께 참여하는 게 효율적이지만 현재 정치적 상황으로 여의치 않다면 정당별로 회동해 의견을 나누는 방안도 가능하다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.101,
                "end": 22.284
            },
            {
                "speaker_id": "1",
                "transcription": "야당의 제안이 있은 지 이틀만에 나온 총리실의 공식 입장입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.294,
                "end": 27.551
            },
            {
                "speaker_id": "1",
                "transcription": "총리실 관계자는 황 권한대행이 그동안 심사숙고했고 정세균 국회의장과 각계 원로들의 조언을 감안해 이렇게 결정한 것으로 알고 있다고 설명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.561,
                "end": 39.700
            }
        ]
    },
    "summary": "야당의 회동 제안을 한 지 이틀만에 황교안 대통령 권한대행은 이에 공감한다며 정당별로 회동하는 방안을 제안했다.",
