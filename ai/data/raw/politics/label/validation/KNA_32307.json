                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부와 새누리당이 오늘 국회에서 안보 상황 점검을 위한 긴급 협의회를 열었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.320
            },
            {
                "speaker_id": "1",
                "transcription": "국회 정보위 새누리당 간사인 이철우 위원은 국정원이 최근 대남 테러를 위한 영남 결집을 김정은이 지시한 것을 보고 했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.330,
                "end": 15.122
            },
            {
                "speaker_id": "1",
                "transcription": "또 대남 해외 공작 총괄 기구인 정찰 총국이 이를 준비하고 있다고 전했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.132,
                "end": 20.841
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 국정원은 관련 정보를 계속 수집하고 있다는 보고를 받았다고 이 위원은 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.851,
                "end": 27.156
            },
            {
                "speaker_id": "1",
                "transcription": "국정원은 가능한 테러 유형도 보고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.166,
                "end": 30.464
            },
            {
                "speaker_id": "1",
                "transcription": "독극물로 공격을 하거나 특정 인사에 대한 테러 감행 가능성을 제기했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.474,
                "end": 35.842
            },
            {
                "speaker_id": "1",
                "transcription": "또 중곡동으로 유인 후 납치하거나 정치권이나 방북 인사들에 대한 협박 소포 또는 신변을 위협하는 시도가 있을 수 있다고 보고했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.852,
                "end": 45.337
            },
            {
                "speaker_id": "1",
                "transcription": "이 위원은 이밖에도 지하철 등 다중 이용 시설과 정수장 또는 발전소 등 국가 기관 시설도 테러의 대상이 될 수 있다고 국정원이 밝혔다고 말했습니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 45.347,
                "end": 56.414
            },
            {
                "speaker_id": "1",
                "transcription": "이와 함께 정부 또는 언론 등을 상대로 사이버 공격에도 대비해야 한다며 테러 방지법과 사이버 테러 방지법 등 관련법에 조속한 처리가 필요하다고 국정원이 보고했다고 덧붙였습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 56.424,
                "end": 69.016
            },
            {
                "speaker_id": "1",
                "transcription": "한편 외교부는 대북 제재 결의안과 관련해 최근 한중 외교 차관을 통해 중국의 협조를 요청했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 69.026,
                "end": 77.035
            },
            {
                "speaker_id": "1",
                "transcription": "또 중국도 제재 필요성에 공감했다며 이달 말 결의안 통과를 목표로 하고 있다고 보고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 77.045,
                "end": 83.800
            }
        ]
    },
    "summary": "정부와 새누리당이 국회에서 안보 상황 점검을 위한 긴급 협의회를 열었고 국정원은 가능한 테러 유형과 사이버 테러 방지법 등 관련법 등이 필요하다고 보고 했습니다.",
