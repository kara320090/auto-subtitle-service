        "term": [
            {
                "speaker_id": "1",
                "transcription": "사전투표율은 오후에 합산됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.558
            },
            {
                "speaker_id": "1",
                "transcription": "이번 사전투표율은 20.1퍼센트로 지방선거로는 역대 최고였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.568,
                "end": 7.554
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 사전투표 열기가 높았던만큼 60퍼센트대 벽을 넘을 수 있을 것으로 선관위는 내다보고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.564,
                "end": 14.853
            },
            {
                "speaker_id": "1",
                "transcription": "투표율이 60퍼센트를 넘은 적은 1995년에 1회 지방선거 이후로 한번도 없었는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.863,
                "end": 21.622
            },
            {
                "speaker_id": "1",
                "transcription": "2014년 지방선거 투표율은 최종적으로 56.8퍼센트였습니다.",
                "sound_type": [
