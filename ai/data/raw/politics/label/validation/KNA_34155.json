        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "인도네시아를 국빈 방문 중인 문재인 대통령은 한국과 인도네시아 기업인 300여 명이 참석한 비즈니스 포럼에서 신남방 정책 구상을 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.183
            },
            {
                "speaker_id": "1",
                "transcription": "사람과 평화, 상생, 번영, 공동체 이른바 3피를 핵심으로 시장 다변화를 추진하겠다는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.193,
                "end": 17.143
            },
            {
                "speaker_id": "1",
                "transcription": "특히 인도네시아를 중심으로 아세안과의 교류 협력을 한반도 주변 4개국 수준으로 끌어올리겠다고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.153,
                "end": 25.720
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 4차 산업 혁명과 방위, 환경 산업은 물론 자동차 산업 분야 협력을 보다 강화해 세계 시장 개척 동반자가 되자고 제안했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.730,
                "end": 36.309
            },
            {
                "speaker_id": "1",
                "transcription": "이와 관련해 김현철 청와대의 경제 보좌관은 아세안과의 교역 규모를 2020년까지 중국 수준인 2000억 달러로 확대하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.319,
                "end": 47.324
            },
            {
                "speaker_id": "1",
                "transcription": "이른바 3피 전략과 관련해선 다층적으로 인적 교류를 확대하면서 한류와 아세안 음식 등 마음과 마음이 통하는 소프트 파워로 교류하는 게 핵심이라고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.334,
                "end": 59.133
            }
        ]
    },
    "summary": "인도네시아를 중심으로 아세안과 교류 협력을 끌어올리겠다고 했다.",
