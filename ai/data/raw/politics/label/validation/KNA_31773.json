        "term": [
            {
                "speaker_id": "1",
                "transcription": "새누리당은 오늘 의원 총회를 갖고 단독 국회 불가피 쪽으로 의견을 모았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.813
            },
            {
                "speaker_id": "1",
                "transcription": "이완구 원내 대표는 국회 예산안 처리 일정을 감안할 때 이번 주에 국회가 정상화되지 않으면 안 된다며 여러 가지 안을 검토하고 있다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.823,
                "end": 14.704
            },
            {
                "speaker_id": "1",
                "transcription": "새누리당은 우선 26일 본회의를 연다는 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.714,
                "end": 18.064
            },
            {
                "speaker_id": "1",
                "transcription": "정기 국회 개회 이후 상임위로는 처음으로 새누리당 요구에 따라 교육 문화 체육 관광위 전체 회의가 소집됐지만 새정치연합 소속 설훈 위원장이 개의 선언 후 곧바로 정회를 선포해 회의는 진행되지 못했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.074,
                "end": 31.964
            },
            {
                "speaker_id": "1",
                "transcription": "새정치민주연합은 비대위 구성 후 처음으로 회의를 열었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.974,
                "end": 36.166
            }
        ]
    },
    "summary": "새누리당은 오늘 의원 총회를 갖고 단독 국회 불가피 쪽으로 의견을 모았고 원내 대표는 국회 예산안 처리 일정을 감안할 때 이번 주에 국회가 정상화되지 않으면 안 된다며 여러 가지 안을 검토하고 있다고 말했다.",
