        "term": [
            {
                "speaker_id": "1",
                "transcription": "피해를 줄이기 위해 4개 법안을 당론으로 추진하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.103
            },
            {
                "speaker_id": "1",
                "transcription": "농수산물 원산지 표시를 강화하고 방사능 피해도 어업 재해에 포함시켜 어민들에 대한 지원 근거를 마련하는 내용이 담겼습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.113,
                "end": 13.858
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 민주당이 민의의 전당을 괴담의 전당으로 만들었다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.868,
                "end": 19.680
            },
            {
                "speaker_id": "1",
                "transcription": "광우병과 사드 괴담에 이어 이번엔 방사능 괴담이냐고 꼬집었습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.690,
                "end": 25.285
            },
            {
                "speaker_id": "1",
                "transcription": "방사능 모니터링 강화와 피해 지원 확대 등 오염수 방류 피해 대책을 내놨는데 특히 민주당발 가짜 뉴스로 어민들이 피해를 입었다며 약 2000억 원을 추가 투입합니다.",
                "sound_type": [
                    2
                ],
                "start": 25.295,
                "end": 37.865
            },
            {
                "speaker_id": "2",
                "transcription": "지난 몇 달에 걸친 민주당의 오염수 가짜 뉴스 선동 즉 오염된 말의 피해를 본 분들을 돕기 위한 가짜 뉴스 피해자 지원금임을",
                "sound_type": [
                    2
                ],
                "start": 37.875,
                "end": 52.485
