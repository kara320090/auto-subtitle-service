        "term": [
            {
                "speaker_id": "1",
                "transcription": "보수의 본산의 선택에 관심이 쏠렸지만 이변은 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.683
            },
            {
                "speaker_id": "1",
                "transcription": "재선에 도전한 자유한국당 권영진 후보는 50퍼센트가 넘는 득표율로 더불어 민주당 임대윤 후보를 꺾었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.693,
                "end": 13.175
            },
            {
                "speaker_id": "1",
                "transcription": "권 후보는 보수의 새로운 불씨를 지펴준 대구 시민들에게 감사하다고 소감을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.185,
                "end": 19.654
            },
            {
                "speaker_id": "2",
                "transcription": "참 어려운 선거였습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.664,
                "end": 21.567
            },
            {
                "speaker_id": "2",
                "transcription": "민주당과 여권의 무서운 바람이 전국을 불고 대구까지 강타했고 또 우리당은 탄핵과 적폐 세력이라는 그것으로부터 벗어나지 못하는 리더십의 부재가 있었고",
                "sound_type": [
