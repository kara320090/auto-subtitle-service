        "term": [
            {
                "speaker_id": "1",
                "transcription": "아들의 눈물에 손길에 어머니는 치매도 이겨냈습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 0.000,
                "end": 4.180
            },
            {
                "speaker_id": "2",
                "transcription": "그 아까 개별상봉때 그 순간적으로 어머니가 정신이 나시더라구요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.190,
                "end": 10.445
            },
            {
                "speaker_id": "2",
                "transcription": "울면서 여태 왜 여태까지 너는 나를 안 찾아왔냐고.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.455,
                "end": 13.683
            },
            {
                "speaker_id": "1",
                "transcription": "65년 만에 아들을 만나 통곡했던 98살 @이름1 할아버지는 끝내 건강이 악화돼 상봉장에 모습을 드러내지 못했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.693,
                "end": 22.725
            },
            {
                "speaker_id": "3",
                "transcription": "그쪽에서는 네가 아직까지는 장손 역할 해야 돼.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.735,
                "end": 26.505
            },
            {
                "speaker_id": "3",
                "transcription": "알았지 응?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.515,
                "end": 28.844
            },
            {
                "speaker_id": "4",
                "transcription": "형 말 잘 듣고 내가 아버지 잘 모시고.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 28.854,
                "end": 33.633
