        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 특검이 1차로 법무부에 파견을 요청한 검사 10명도 이르면 오늘 투입될 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.482
            },
            {
                "speaker_id": "2",
                "transcription": "파견 검사에 대해서 뭐 특별히 선정한 기준 같은 게 있을까요 선정하시는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.492,
                "end": 11.317
            },
            {
                "speaker_id": "3",
                "transcription": "사명감과 수사 능력이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.327,
                "end": 13.716
            },
            {
                "speaker_id": "1",
                "transcription": "특검보와 파견 검사들은 이번 주부터 검찰 특별 수사 본부에 수사 기록 등을 면밀히 검토하면서 증거 분석과 소환자 분류 등 세부적인 수사 계획을 수립하게 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.726,
                "end": 25.920
            },
            {
                "speaker_id": "1",
                "transcription": "또 나머지 파견 검사 10명의 인선 등이 이번 주 중반쯤 완료돼 특별 검사팀의 진용이 갖춰지면 현직 대통령을 향한 특검 수사가 본격화될 전망입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.930,
                "end": 38.087
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름2입니다.",
                "sound_type": [
