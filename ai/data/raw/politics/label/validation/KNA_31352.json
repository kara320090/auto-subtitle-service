        "term": [
            {
                "speaker_id": "1",
                "transcription": "아까 보신 것처럼 이 잠시 뒤에는 이제 북측 가족끼리 나와서 예 환송을 쭉 나오고 있네요.",
                "sound_type": [
                    2,
