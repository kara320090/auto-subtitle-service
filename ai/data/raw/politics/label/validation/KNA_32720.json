        "term": [
            {
                "speaker_id": "1",
                "transcription": "한동훈 법무부 장관이 출석한 국회 법사위 법무부의 공직자 인사 검증이 다시 한번 도마 위에 올랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.524
            },
            {
                "speaker_id": "2",
                "transcription": "근데 인사 참사 관리단이에요.",
                "sound_type": [
                    2
                ],
                "start": 7.534,
                "end": 9.370
            },
            {
                "speaker_id": "2",
                "transcription": "국민들이 보기에 야 정말 적격이다 이렇게 지금 평가하는 사람이 거의 없을 정도예요.",
                "sound_type": [
                    2
                ],
                "start": 9.380,
                "end": 13.646
            },
            {
                "speaker_id": "1",
                "transcription": "여당은 법무부가 원칙에 따라 검증하고 있다며 한 장관을 옹호했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.656,
                "end": 18.834
            },
            {
                "speaker_id": "3",
                "transcription": "프로토콜에 따라서 인사 검증단을 거쳐서 대통령실에서 검증할 수밖에 없는 구조라고 생각을 하고",
                "sound_type": [
                    2
                ],
                "start": 18.844,
                "end": 26.511
            },
            {
                "speaker_id": "4",
                "transcription": "인사 정보 관리단은 여러 후보가 오는데요.",
                "sound_type": [
                    2
                ],
                "start": 26.521,
                "end": 28.847
            },
            {
                "speaker_id": "4",
                "transcription": "이 후보가 어디 직역을 가는 거라는 것을 알고 하는 것도 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 28.857,
                "end": 32.857
            },
            {
                "speaker_id": "1",
                "transcription": "외통위에선 문재인 정부가 북한과 맺은 구일구 군사 합의가 무력 도발 대응을 방해하고 있다는 지적이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.867,
                "end": 41.574
            }
        ]
    },
    "summary": "한동훈 법무부 장관이 출석한 국회 법사위에서 법무부의 공직자 인사 검증이 도마 위에 올랐는데 야당은 인사 참사 관리단이냐며 비판했고 여당은 법무부가 원칙에 따라 검증하고 있다며 한 장관을 옹호했다.",
