        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰이 홍준표 경남지사의 최측근 나 모 씨에게 오늘 오후에 출석하라고 통보했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.961
            },
            {
                "speaker_id": "1",
                "transcription": "나 씨는 @이름1 전 회장이 홍 지사에게 1억 원을 건넸다고 주장한 지난 2011년 6월 한나라당 대표 경선에 나선 홍 지사의 캠프에서 인사와 회계를 맡았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.971,
                "end": 17.734
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 나 씨 소환을 앞두고 1억 원을 전달한 것으로 알려진 윤 모 전 부사장을 어제까지 사흘 연속으로 불러 조사했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.744,
                "end": 25.779
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 지난 주말 홍 지사의 운전기사도 조사했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.789,
                "end": 29.705
            },
            {
                "speaker_id": "1",
                "transcription": "홍 지사 소환을 앞두고 기초 조사를 보강하려는 행보로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.715,
                "end": 34.373
            },
            {
                "speaker_id": "1",
                "transcription": "홍 지사는 측근 조사가 마무리되는 이번 주말쯤 소환될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 34.383,
                "end": 39.755
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 수사는 대선자금 쪽으로도 확대되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.765,
                "end": 43.475
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 전 회장의 측근이자 회사 자금 관리를 맡았던 한 모 전 부사장은 최근 검찰 조사에서",
                "sound_type": [
                    2
                ],
                "start": 43.485,
                "end": 51.033
            }
        ]
    },
    "summary": "@이름1 리스트를 수사하고 있는 검찰 특별수사팀이 홍준표 경남지사의 캠프에서 인사와 회계를 맡았던 나 씨 등 홍 지사의 최측근을 잇따라 소환 조사하고 있는 가운데 이번 주말쯤 홍 지사를 소환할 것으로 예측된다.",
