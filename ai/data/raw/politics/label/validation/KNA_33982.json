        "term": [
            {
                "speaker_id": "1",
                "transcription": "이를 위해 금융시장과 수출 원자재시장 등을 24시간 주시하고 매일 관계기관 합동 회의를 열기로 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.537
            },
            {
                "speaker_id": "1",
                "transcription": "또 자금이탈 우려가 있는 외국인 투자자는 물론 외신과 신용평가사 등의 정확한 정보를 최대한 빨리 전달할 계획입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.547,
                "end": 16.663
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 코스피는 개인이 매물을 쏟아내면서 40포인트 1.7퍼센트가량 급락한 채 장을 시작했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.673,
                "end": 24.617
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 외국인과 기관이 주식을 사들이면서 하락 폭을 줄였습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.627,
                "end": 29.114
            },
            {
                "speaker_id": "1",
                "transcription": "2퍼센트 넘게 하락 출발했던 코스닥지수도 낙폭을 상당히 줄여 650선을 지켰습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 29.124,
                "end": 36.508
            },
            {
                "speaker_id": "1",
                "transcription": "일본 증시를 비롯한 아시아 증시도 약세를 보이긴 했지만 하락폭은 1퍼센트 안팎을 나타냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.518,
                "end": 43.154
            },
            {
                "speaker_id": "1",
                "transcription": "서울 외환시장에서 원달러환율은 지난주 금요일보다 1퍼센트가량 올랐습니다.",
                "sound_type": [
