        "term": [
            {
                "speaker_id": "1",
                "transcription": "한미 합동 실무단이 실험실을 공동 조사했는데 미국 측의 발표는 사실과 달랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.646
            },
            {
                "speaker_id": "1",
                "transcription": "확인 결과 주한 미군은 지난 2009년부터 최근까지 모두 16차례나 탄저균 표본을 국내에 반입했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.656,
                "end": 14.808
            },
            {
                "speaker_id": "1",
                "transcription": "주한 미군은 탄저균을 들여와 생물학전 장비 성능 시험 등을 하고 규정에 따라 폐기했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.818,
                "end": 21.893
            },
            {
                "speaker_id": "1",
                "transcription": "탄저균과 함께 페스트균 표본도 반입됐는데 정부는 전혀 인지하지 못했던 것으로 드러났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.903,
                "end": 29.222
            },
            {
                "speaker_id": "1",
                "transcription": "주한 미군이 죽은 생물학 검사용 샘플을 국내로 반입할 경우 허가 절차를 거치지 않는다는 주한 미군 지위 협정 즉 SOFA 규정에 따라 정부에 신고하지 않았기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.232,
                "end": 41.533
            }
        ]
    },
    "summary": "주한 미군이 지난 2009년부터 최근까지 모두 16차례 탄저균 표본을 국내에 반입했고 탄저균과 함께 페스트균 표본도 반입했는데 정부는 전혀 인지하지 못했던 것으로 드러났다.",
