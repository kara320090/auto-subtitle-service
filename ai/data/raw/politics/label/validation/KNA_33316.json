        "term": [
            {
                "speaker_id": "1",
                "transcription": "의원이 도시건설위원이었어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.560
            },
            {
                "speaker_id": "1",
                "transcription": "자기도 농고 근처에서 적발돼서 통지를 받았대요.",
                "sound_type": [
                    2
                ],
                "start": 2.570,
                "end": 7.515
            },
            {
                "speaker_id": "2",
                "transcription": "시민단체는 억대 예산을 들여 추진한 사업을 불분명한 이유로 사실상 중단했다가 두 해가 지난 내년에 다시 하겠다는 건 이치에 맞지 않는다고 지적합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.525,
                "end": 18.856
            },
            {
                "speaker_id": "3",
                "transcription": "이러한 그 단속을 중단했다가 선거가 끝나면은 단속을 강화하는 이런 그 눈치 보기식 행정이 계속 번복되고 있거든요.",
                "sound_type": [
                    2,
                    4
                ],
