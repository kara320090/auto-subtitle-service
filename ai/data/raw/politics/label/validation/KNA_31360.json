        "term": [
            {
                "speaker_id": "1",
                "transcription": "계속 그 신청자분들이 사망하시고 계시는데 정말 하루 빨리 상봉 정례화나 하다 못해 생사 확인이라도 라도 돼야 될 필요성을 많이 느끼는 부분입니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 17.268
            },
            {
                "speaker_id": "2",
                "transcription": "저게 이제 환송하는 시간은 어느 정도나 되나요?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 17.278,
                "end": 21.562
            },
            {
                "speaker_id": "2",
                "transcription": "한 15분 안쪽으로 알고 있는데",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 21.572,
                "end": 23.220
            },
            {
                "speaker_id": "1",
                "transcription": "환송하는 시간이 그렇게 길지는 않고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.230,
                "end": 25.506
            },
            {
                "speaker_id": "1",
                "transcription": "바로 30분에 나와서 11시 30분에 나와서 12시부터 점심시간이기 때문에 그렇게 길지는 않습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.516,
                "end": 32.347
            },
            {
                "speaker_id": "1",
                "transcription": "그런데",
                "sound_type": [
                    2
                ],
                "start": 32.357,
                "end": 33.233
            }
        ]
    },
    "summary": "이산가족 상봉 신청자들은 고령화로 사망하고 있기 때문에 하루 빨리 상봉 정례화나 생사 확인이라도 돼야 될 필요성이 느껴지며 환송 시간은 그렇게 길지 않다.",
