        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 군은 이례적인 야간 사격에는 북한이 야간 작전 능력을 과시하려는 의도가 담긴 것으로 보고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.113
            },
            {
                "speaker_id": "2",
                "transcription": "북한의 야간 포사격을 이번에 한 것을 어 위협적인 행동이다라고 판단하고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.123,
                "end": 16.589
            },
            {
                "speaker_id": "1",
                "transcription": "군 당국은 기습적인 도발 행동에 대비해 북한의 움직임을 예의주시하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.599,
                "end": 22.380
            },
            {
                "speaker_id": "1",
                "transcription": "북한이 사격 기간을 오늘 자정까지로 통보한 만큼 추가 사격 가능성이 있다고 보고 대비 태세를 유지하고 있습니다.",
                "sound_type": [
