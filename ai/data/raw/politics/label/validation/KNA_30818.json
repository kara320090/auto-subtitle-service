        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 대해 새누리당 조원진 최고 위원은 비주류 측이 탄핵에 들어가면 지도부는 당초 퇴진을 약속했던 다음 달 21일에도 사퇴할 수 없다며 반발했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.439
            },
            {
                "speaker_id": "1",
                "transcription": "야 3당 대표들은 오늘 오전 국회에서 회동을 갖고 대통령의 조건 없는 하야를 촉구하면서 임기 단축과 관련한 여야 협상은 없다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.449,
                "end": 22.308
            },
            {
                "speaker_id": "1",
                "transcription": "야 3당 대표들은 특히 다음 달 일 탄핵에 최대한 노력하되 안 되면 추가 회동을 통해 대책을 논의할 것이라고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.318,
                "end": 31.510
            },
            {
                "speaker_id": "1",
                "transcription": "더불어민주당 추미애 대표는 박 대통령과 새해를 맞기를 원하지 않는다는 게 민심이라며 헌법상 대통령 퇴진의 유일한 방법은 탄핵뿐이라고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.520,
                "end": 43.063
            },
            {
                "speaker_id": "1",
                "transcription": "국민의당 박지원 원내대표는 탄핵 열차에 모두 동승하자고 촉구했고 정의당 심상정 대표도 대통 꼼수 담화로 탄핵 일정을 늦출 수 없다고 강조했습니다.",
                "sound_type": [
