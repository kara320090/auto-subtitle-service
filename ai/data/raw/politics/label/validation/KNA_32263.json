        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "한중 FTA 비준 동의안이 오늘 오후 국회 본회의에서 통과될 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.647
            },
            {
                "speaker_id": "1",
                "transcription": "여야 원내 지도부는 오늘 새벽까지 이어진 협상에서 오늘 본회의를 열고 한중 FTA 비준 동의안을 처리하기로 잠정 합의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.657,
                "end": 15.059
            },
            {
                "speaker_id": "1",
                "transcription": "이어 여야정 협의체는 오전에 회의를 열고 산업별 피해 보전 합의안 등을 협정했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.069,
                "end": 21.750
            },
            {
                "speaker_id": "1",
                "transcription": "여야는 합의안에서 농어민 피해를 보전하기 위해 앞으로 10년간 매년 1000억 원씩 모두 1조 원의 기금을 조성해 장학 사업과 의료 문화 주거 생활 개선 사업 등에 쓰기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.760,
                "end": 34.597
            },
            {
                "speaker_id": "1",
                "transcription": "또 피해 보존 직불제 비율을 현행 90퍼센트에서 95퍼센트로 인상하고 밭 농업 작물 가운데 한미 FTA 때 적용된 품목이 아닌 작물에 대한 직불금을 인상하는 방안을 논의하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.607,
                "end": 48.680
            },
            {
                "speaker_id": "1",
                "transcription": "수산 직불제 대상에 제주도를 포함 시키는 내용도 합의안에 포함됐습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 48.690,
                "end": 53.867
            },
            {
                "speaker_id": "1",
                "transcription": "국회 외교 통일 위원회는 이같은 합의안 내용을 토대로 오늘 오후 전체 회의를 열어 비준 동의안을 의결할 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 53.877,
                "end": 62.428
            },
            {
                "speaker_id": "1",
                "transcription": "외통위에서 비준 동의안이 처리되면 바로 본회의가 소집돼 통과 절차를 밟게 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.438,
                "end": 68.675
            },
            {
                "speaker_id": "1",
                "transcription": "여야는 내년도 예산안과 관련해서는 누리 과정 예산 지원 규모 등을 놓고 이견을 좁히지 못하고 있어 오늘 예결위 의결은 불투명한 상황입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 68.685,
                "end": 78.712
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 78.722,
                "end": 81.666
            }
        ]
    },
    "summary": "한중 FTA 비준 동의안이 오늘 오후 국회 본회의를 통과할 것으로 보이고 여야는 오늘 처리한다는데 잠정 합의하고 농어민 피해 보전을 위한 기금을 10년간 1조원 조성하기로 하는 등 산업별 피해 보전 합의안 등을 확정했습니다.",
