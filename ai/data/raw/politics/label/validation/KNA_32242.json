                "start": 0.000,
                "end": 6.443
            },
            {
                "speaker_id": "2",
                "transcription": "아무리 닭의 목을 비틀지라도 새벽이 온다는 것입니다.",
                "sound_type": [
                    2,
                    3,
                    4
