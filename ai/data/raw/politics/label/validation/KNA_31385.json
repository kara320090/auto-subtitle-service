                "start": 0.000,
                "end": 2.416
            },
            {
                "speaker_id": "2",
                "transcription": "역사 교과서 국정화와 관련해 오늘도 여야가 공방을 벌였습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.426,
                "end": 8.330
            },
            {
                "speaker_id": "2",
                "transcription": "국회 교무리와 운영위에서 교육부가 구성한 TF에 성격과 자료 공개 등을 놓고 충돌했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.340,
                "end": 14.776
            },
            {
                "speaker_id": "2",
                "transcription": "보도에 @이름2 기잡니다.",
                "sound_type": [
                    2
                ],
                "start": 14.786,
                "end": 16.453
            },
            {
                "speaker_id": "3",
                "transcription": "국회 교문위 소속 여야 의원들은 교육부가 역사 교과서 국정화를 위해 구성한 테스크 포스에 성격과 자료 공개 등을 놓고 공방을 벌였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.463,
                "end": 28.111
            },
            {
                "speaker_id": "3",
                "transcription": "여당 의원들은 과거 노무현 정부 시절 등에도 정식 직제에 없는 팀이 운영됐었다며 해당 팀은 담당 공무원이 부족하고 효율을 구하기 위해 구성한 업무 지원 조직에 불과하다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.121,
                "end": 41.116
            },
            {
                "speaker_id": "3",
                "transcription": "야당 의원들은 역사 교과서 국정화 테스크 포스가 구성된 게 지난 5일인데도 황우여 교육부 총리는 8일 국회에 출석해 결정된 게 없다고 발언했다며 청와대 일일점검 회의 등 해당 팀이 작성한 자료 제출을 요구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.126,
                "end": 56.111
            },
            {
                "speaker_id": "3",
                "transcription": "답변에 나선 황우여 교육부 총리는 야당이 불법이라고 주장하는 해당 조직은 교육부 소속으로 교육 정책 실장에 지시를 받는 역사 교육 지원 팀이라고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.121,
                "end": 66.833
            }
        ]
    },
    "summary": "역사 교과서 국정화와 관련해 여당 의원들은 테스크 포스는 담당 공무원이 부족하고 효율을 구하기 위해 구성한 업무 지원 조직에 불과하다고 밝혔고 야당 의원들은 테스크 포스가 작성한 청와대 일일 점검 회의 등 자료 제출을 요구했으며 황우여 교육부 총리는 야당 의원들에게 테스크 포스는 교육부 소속으로 교육 정책 실장에 지시를 받는 역사 교육 지원 팀이라고 말했다.",
