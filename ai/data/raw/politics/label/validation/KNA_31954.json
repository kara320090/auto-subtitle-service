        "term": [
            {
                "speaker_id": "1",
                "transcription": "각종 민생 법안들도 정치적 이유로 통과되지 않아 경제 살리기에 발목이 잡혀있는데 국회가 시행령 수정까지 요구하게 되면 정부는 무기력해질 수 밖에 없다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.011
            },
            {
                "speaker_id": "2",
                "transcription": "정부의 시행령까지 국회가 번번이 수정을 요구하게 되면 정부의 정책 추진은 악영향을 받을 수 밖에 없고 결국 그 피해는 고스란히 국민들에게 그리고 우리 경제에 돌아가게 될 것입니다.",
                "sound_type": [
                    2,
