        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리측 인원을 태운 특별 열차는 조금 뒤 오후 1시쯤 판문역을 떠나 2시쯤 입경할 예정인데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.094
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 착공식에서는 김현미 국토부 장관과 북측 김윤혁 철도선 부상이 착공사를 했다고 통일부는 전했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.104,
                "end": 13.049
            },
            {
                "speaker_id": "1",
                "transcription": "당초 냉면 발언 논란 이후 @이름1 조국평화통일위원회 위원장이 북한 대표 격으로 처음 나오는 거라 발언 여부가 주목됐는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.059,
                "end": 21.271
            },
            {
                "speaker_id": "1",
                "transcription": "공식 석상의 발언은 아직까지 확인되지 않고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.281,
                "end": 24.909
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 착공식은 친목 서명식과 궤도 체결식, 도로표지판 제막식 등으로 진행됐습니다. 곧바로 실제 공사에 들어가는 착공의 의미보다는 착수식의 의미가 강합니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 24.919,
                "end": 35.836
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 동아시아 철도 공동체 관련 중국과 러시아, 몽골 등 해외 인사 8명도 참석해 앞으로 철도 도로 연결 및 현대화에 대한 협력 의지를 다졌습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 35.846,
                "end": 45.786
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 추후 추가 정밀 조사와 기본 계획 수립, 설계 등을 해나간다는 계획인데요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 45.796,
                "end": 51.104
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 실제 공사는 북한의 비핵화 진정과 국제 사회의 대북 제재 상황에 따라 추진하게 될 것이라고 거듭 강조했습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 51.114,
                "end": 58.599
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 도라산역에서 KBS 뉴스 @이름2입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 58.609,
                "end": 62.800
            }
        ]
    },
    "summary": "통일부는 오늘 착공식에서 착공사를 진행했고 해외 인사들도 참석해 철도 도로 연결과 현대화에 대한 협력 의지도 다졌다고 전했다.",
