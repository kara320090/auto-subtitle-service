        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 새해를 앞두고 특별사면을 단행했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.133
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 정부 출범 이후 첫 특사로 그 대상은 모두 6천 4백여 명입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.143,
                "end": 7.558
            },
            {
                "speaker_id": "1",
                "transcription": "운전면허 취소나 정지 등 행정 제재를 받고 있는 165만여 명에 대한 특별 감면 조치도 함께 이루어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.568,
                "end": 15.352
            },
            {
                "speaker_id": "1",
                "transcription": "이번 특사에선 부패 범죄를 저지른 경제인이나 공직자, 그리고 각종 강력 범죄를 저지른 사람은 사면 대상에서 제외됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.362,
                "end": 24.253
            },
            {
                "speaker_id": "1",
                "transcription": "정치권에선 정몽주 전 의원이 유일하게 사면 대상에 포함됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.263,
                "end": 28.831
            },
            {
                "speaker_id": "1",
                "transcription": "정 전 의원은 2017년 17대 대선을 앞두고 이명박 전 대통령의 BBK 실소유주 의혹을 제기했다가 선거법 위반 혐의로 징역 1년을 선고 받고 만기 출소 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.841,
                "end": 40.124
            },
            {
                "speaker_id": "1",
                "transcription": "용산참사 당시 철거민들도 이번 사면 대상에 포함됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 40.134,
                "end": 44.753
            },
            {
                "speaker_id": "1",
                "transcription": "현재 재판을 받고 있는 1명을 제외한 25명이 사면대상입니다.",
                "sound_type": [
                    2
                ],
                "start": 44.763,
                "end": 49.171
            },
            {
                "speaker_id": "1",
                "transcription": "사회적 갈등 치유와 국민 통합 차원에서 재판이 끝난 도완사건 가운데 대표적인 용산 철거민 사건 관련자들을 특사로 선정했다고 법무부는 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 49.181,
                "end": 59.966
            },
            {
                "speaker_id": "1",
                "transcription": "민중 총궐기 시위를 주도한 혐의로 복역중인 한상균 민주노총 위원장은 이번 사면에서 빠졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.976,
                "end": 66.123
            },
            {
                "speaker_id": "1",
                "transcription": "또 내란 음모 사건으로 복역중인 이석기 전 통합진보당 대표도 제외됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 66.133,
                "end": 71.032
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 일반 서민들의 부담을 덜어주고 정상적인 사회 활동을 할 수 있는 기회를 주려고 했다며 특별사면의 취지를 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 71.042,
                "end": 79.695
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 79.705,
                "end": 82.466
            }
        ]
    },
    "summary": "정부가 새해 앞두고 부패 범죄와 경제인, 공직자와 강력 범죄를 저지른 범죄자를 제외한 이들을 대상으로 특별사면을 단행했다.",
