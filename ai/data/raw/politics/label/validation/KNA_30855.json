        "term": [
            {
                "speaker_id": "1",
                "transcription": "더불어민주당은 오늘부터 탄핵 비상 체제를 선언하고 가결 정족수 확보를 위한 세몰이에 나섭니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.732
            },
            {
                "speaker_id": "1",
                "transcription": "추미애 대표는 지난 주말 230여만 촛불은 새누리당의 내년 4월 퇴진론을 거부하는 것이라며 당차원의 릴레이 연설을 비롯해 야권 합동 의원 총회 등을 통해 탄핵 가결을 위한 혼신의 힘을 다하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.742,
                "end": 22.298
            },
            {
                "speaker_id": "1",
                "transcription": "또 새누리당 의원들을 향해 민심과 양심에 따라 탄핵 대열에 동참해 달라고 거듭 호소하며 대여 압박에 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.308,
                "end": 31.072
            },
            {
                "speaker_id": "1",
                "transcription": "국민의당 박지원 비상 대책 위원장은 박 대통령이 4월 퇴진을 약속하더라도 탄핵해야 한다면서 이미 촛불 민심과 분노가 대통령의 국정 복귀를 용납하지 않을 거라고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.082,
                "end": 44.564
            },
            {
                "speaker_id": "1",
                "transcription": "국민의당은 이어 중앙 위원회를 열고 내년 1월 전당대회 때까지 당을 이끌 새 비상 대책 위원장에 김동철 의원을 인준했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.574,
                "end": 54.218
            },
            {
                "speaker_id": "1",
                "transcription": "비주류 의원들이 탄핵안 표결 동참 입장을 밝힌 새누리당은 오는 4월 퇴진 6월 대선 당론에 대한 박 대통령의 즉각 입장 표명을 촉구하는 등 탄핵 대책 논의에 들어갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 54.228,
                "end": 66.958
            },
            {
                "speaker_id": "1",
                "transcription": "여당 친박계 일각에선 비주류의 탄핵 표결 참여 결정을 비판하면서 탄핵안 표결 시 퇴장하는 방안도 검토하는 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.968,
                "end": 76.666
            }
        ]
    },
    "summary": "더불어민주당은 오늘부터 탄핵 비상 체제를 선언하고 야권 합동 의원 총회 등을 통해 탄핵 가결을 위한 혼신의 힘을 다하겠다고 밝혔으며 새누리당은 비주류 의원들이 탄핵안 표결 동참 입장을 밝히자 친박계 일각에서 비판하면서 탄핵안 표결 시 퇴장하는 방안도 검토하는 것으로 알려졌다.",
