        "term": [
            {
                "speaker_id": "1",
                "transcription": "박근혜 전 대통령에 대한 추가 구속 영장이 발부됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.820
            },
            {
                "speaker_id": "1",
                "transcription": "서울 중앙 지법 형사 합의 22부는 증거를 인멸할 염려가 있어 구속에 사유와 필요성이 인정된다며 박 전 대통령에 대한 영장을 발부했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.830,
                "end": 13.590
            },
            {
                "speaker_id": "1",
                "transcription": "재판부에 구속 기간 연장 결정으로 검찰은 박 전 대통령 측에 재판 고의 지연 시도를 차단하며 남은 재판 일정을 차질 없이 진행하게 될 것으로 예상하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.590,
                "end": 25.684
            },
            {
                "speaker_id": "1",
                "transcription": "애초 박 전 대통령의 구속 만기 시점은 오는 16일이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.694,
                "end": 31.028
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 추가로 영장이 발부되면서 구속 기간은 1심 선거 전까지 최대 6개월 연장됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.038,
                "end": 38.190
            },
            {
                "speaker_id": "1",
                "transcription": "추가 구속 기간은 1심 판결이 나오면 소멸됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.190,
                "end": 42.266
            }
        ]
    },
