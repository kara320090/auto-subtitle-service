        "term": [
            {
                "speaker_id": "1",
                "transcription": "일본군 위안부 피해자들이 모여 사는 나눔의 집에선 위안부 문제 해결을 위한 한일 회담이 내내 화두였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.545
            },
            {
                "speaker_id": "1",
                "transcription": "피해 할머니들은 이번 회담의 결과로 주한 일본대사관 앞 위안부 소녀상이 이전 될 수도 있다는 일본 언론들의 보도를 강하게 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.555,
                "end": 17.029
            },
            {
                "speaker_id": "2",
                "transcription": "누구 마음대로 소녀상을 그렇게 하는 거 아니야.",
                "sound_type": [
                    2
                ],
                "start": 17.039,
                "end": 20.571
            },
            {
                "speaker_id": "2",
                "transcription": "그거는 전 세계에서 다 보는 거야.",
                "sound_type": [
                    2
                ],
                "start": 20.581,
                "end": 22.819
            },
            {
                "speaker_id": "2",
                "transcription": "절대 반대야 저렇게 하는 거 소녀상은 내놓으면 안 돼.",
                "sound_type": [
                    2
                ],
                "start": 22.829,
                "end": 26.966
            }
        ]
    },
    "summary": "위안부 문제 해결을 위한 한일 회담을 앞두고 피해 할머니들은 위안부 소녀상이 이전될 수 있다는 것에 대해 절대 반대 입장을 거듭 강조했다.",
