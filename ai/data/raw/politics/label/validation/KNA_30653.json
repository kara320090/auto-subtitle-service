        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 검찰은 @이름1 씨를 체포하면서 공동 강요 혐의를 적용했는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.590
            },
            {
                "speaker_id": "1",
                "transcription": "이른바 광고사 지분 강탈 의혹과 관련된 혐의입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.600,
                "end": 8.667
            },
            {
                "speaker_id": "1",
                "transcription": "차 씨는 @이름2 전 한국 콘텐츠 진흥원장 등 측근들과 함께 한 광고 회사의 지분을 강탈하려 한 혐의를 받고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.677,
                "end": 16.652
            },
            {
                "speaker_id": "1",
                "transcription": "지난 7일 송 전 원장도 같은 혐의로 검찰에 체포됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.662,
                "end": 20.579
            },
            {
                "speaker_id": "1",
                "transcription": "차 씨는 또 정부의 각종 인사 문제에 개입했다는 의혹도 받고 있는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.589,
                "end": 25.150
            },
            {
                "speaker_id": "1",
                "transcription": "차 씨의 측근인 김종덕 전 문화 체육 관광부 장관과 @이름3 전 청와대 교육 문화 수석 비서관 등이 임명된 데에 차 씨의 영향력이 작용했다는 의혹이 제기된 상태입니다.",
                "sound_type": [
                    2
