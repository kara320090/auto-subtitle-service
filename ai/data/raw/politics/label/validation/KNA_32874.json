                    2
                ],
                "start": 0.000,
                "end": 2.543
            },
            {
                "speaker_id": "2",
                "transcription": "지방선거를 앞두고 서울시장과 경기도 지사의 후보 윤곽이 서서히 드러나고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.553,
                "end": 9.108
            },
            {
                "speaker_id": "2",
                "transcription": "선거 구도는 여야 양자 대결로 재편되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.118,
                "end": 12.774
            },
            {
                "speaker_id": "2",
                "transcription": "@이름2 기자의 보도입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.784,
                "end": 15.034
            },
            {
                "speaker_id": "3",
                "transcription": "새누리당 @이름3 의원이 서울시장 선거 출마를 공식 선언했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.044,
                "end": 21.502
            },
            {
                "speaker_id": "3",
                "transcription": "대권 도전을 노리고 있다는 지적을 의식한 듯 당선되면 시장 임기를 다 채우겠다고 못 박았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.512,
                "end": 28.762
            },
            {
                "speaker_id": "4",
                "transcription": "당선되면 주어진 임기를 지키면서 서울시민의 기쁨과 어려움을 함께 하겠습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 28.772,
                "end": 37.498
            },
            {
                "speaker_id": "3",
                "transcription": "정 의원에 이어 @이름4 전 총리가 오는 14일 귀국해 출마를 선언하면 @이름5 최고위원과 함께 여당의 서울 시장 경선은 3파전으로 진행됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.508,
                "end": 49.564
            },
            {
                "speaker_id": "3",
                "transcription": "민주당인 박원순@이름6 시장의 현직 프리미엄에 맞서 새누리당은 정 의원과 김 전 총리의 이른바 빅매치를 통한 흥행몰이를 기대하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 49.574,
                "end": 59.500
            }
        ]
    },
    "summary": "새누리당 정 의원이 서울시장 선거에 출마하겠다고 선언해 박 현 시장에 대항할 여권 후보들의 경쟁이 본격화되고 있다고 했다.",
