        "term": [
            {
                "speaker_id": "1",
                "transcription": "북한이 자신들의 도발에 응당하는 혹독한 대가를 치르게 할 것이다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.890
            },
            {
                "speaker_id": "2",
                "transcription": "또 북한에 대해 이번 도발 행위에 대한 사과와 책임자 처벌을 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.900,
                "end": 13.725
            },
            {
                "speaker_id": "2",
                "transcription": "군 당국은 UN군사령부 군사정전위원회 특별조사팀도 북한군이 군사분계선을 침범해 목함지뢰를 의도적으로 매설한 것으로 판명됐다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.735,
                "end": 24.738
            },
            {
                "speaker_id": "2",
                "transcription": "이와 관련해 UN군사령부는 지뢰 폭발 사건과 관련해 정전협정을 위반한 것이라고 규탄하며 북한에 장성급 회담을 요청할 것이라고 밝혔습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 24.748,
                "end": 35.045
            },
            {
                "speaker_id": "2",
                "transcription": "장성급 회담 요청 시기는 현재 조율 중이라고 UN사는 덧붙였습니다.",
                "sound_type": [
                    2
                ],
