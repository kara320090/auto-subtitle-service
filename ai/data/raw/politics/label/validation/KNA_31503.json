        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부와 위안부 피해 할머니들이 오늘 오후 한일 위안부 협상 이후 처음으로 만남을 갖습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.570
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 외교부 1차관은 서울 마포의 한국정신대문제대책협의회 쉼터를 방문하고 @이름2 외교부 2차관은 경기도 광주 나눔의 집을 방문할 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.580,
                "end": 16.630
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 피해자들을 만나 위안부 문제 해결의 시급성과 한일관계 개선을 위한 대승적 견지에서 합의했다는 점을 설명하면서 이해를 구할 것으로 전해졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.640,
                "end": 28.021
            },
            {
                "speaker_id": "1",
                "transcription": "또 앞으로 재단 설립을 통해 피해자들의 존엄과 명예회복, 마음의 상처 치유를 위해 정부가 적극적으로 노력하겠다는 점을 강조할 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.031,
                "end": 38.743
            },
            {
                "speaker_id": "1",
                "transcription": "이와 관련해 정부는 일본군 위안부 피해자 지원을 위한 재단 설립 준비에 착수한 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.753,
                "end": 46.333
            }
        ]
    },
    "summary": "정부가 위안부 피해자 지원 재단 설립 준비를 착수한 가운데 외교부 차관은 직접 위안부 피해 할머니들을 만나 협상 결과를 설명하고 재단 설립을 통해 피해자들의 상처를 치유하도록 돕겠다며 할머니들의 이해를 구할 예정이다.",
