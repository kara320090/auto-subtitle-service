        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 그렇습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.651
            },
            {
                "speaker_id": "1",
                "transcription": "어제부터 특검 사무실로 이전이 시작되면서 특검의 수사 준비도 차질 없이 진행되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.661,
                "end": 6.437
            },
            {
                "speaker_id": "1",
                "transcription": "특검 사무실은 물론 특검팀이 기자들을 상대로 수사 과정을 브리핑할 공간도 준비가 끝난 상태입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.447,
                "end": 12.925
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 특검을 비롯해 4명의 특검보도 모두 이곳 특검 사무실로 출근해 본격적인 수사 채비에 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.935,
                "end": 20.231
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 @이름1 특별검사와 특검보 등 100명 안팎의 인력이 이곳에 상주하게 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.241,
                "end": 25.764
            },
            {
                "speaker_id": "1",
                "transcription": "@이름2 씨를 비롯해 안종범 전 수석과 @이름3 전 비서관 광고감독 @이름4 씨 등 구속 기소된 핵심 피의자들은 물론 미르와 K스포츠재단 등에 기금을 낸 대기업 고위층 인사들이 다시 조사를 받을 장소도 바로 이곳 특검 사무실입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.774,
                "end": 40.870
            },
            {
                "speaker_id": "1",
                "transcription": "특검 대변인인 @이름5 특검보는 직접 기자실을 찾아 공식 브리핑도 진행했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.880,
                "end": 46.160
            },
            {
                "speaker_id": "1",
                "transcription": "이 특검보는 제3의 장소에서 수사 기록 검토를 해온 파견검사들도 내일까지 입주를 마치고 수사 기록 검토를 계속할 예정이라고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.170,
                "end": 55.113
            },
            {
                "speaker_id": "1",
                "transcription": "수사팀 인선과 관련해선 특별 수사관 40명 모두를 채우지는 않을 예정이라며 지금까지 20여 명을 확보했고 필요에 따라 전문성을 가진 변호사들을 나중에 보충하겠다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 55.123,
                "end": 66.764
            },
            {
                "speaker_id": "1",
                "transcription": "특검팀은 이번주까지 수사 기록 검토를 마무리하기로 하고 정식 수사 개시 시점을 저울질하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.774,
                "end": 73.099
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 서울 대치동 특검 사무실에서 KBS 뉴스 @이름6입니다.",
                "sound_type": [
                    2
                ],
                "start": 73.109,
                "end": 77.500
            }
        ]
    },
    "summary": "@이름2 게이트를 수사할 @이름1 특별검사팀이 사무실에 모두 출근하고 수사에 필요한 공간 마련도 끝난 만큼 수사 개시가 초읽기에 들어간 상황이다.",
