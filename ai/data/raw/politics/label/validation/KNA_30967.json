        "term": [
            {
                "speaker_id": "1",
                "transcription": "떡 전달이 고소 사건 수사 등 경찰관의 직무와 관련이 있다고 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.681
            },
            {
                "speaker_id": "1",
                "transcription": "다만 과태료는 전달 금품의 최소 2배에서 최고 5배까지 물릴 수 있지만 금액이 비교적 크지 않고 해당 경찰관이 바로 되돌려 준 점 등을 고려해 떡값의 2배인 9만 원으로 결정했습니다.",
                "sound_type": [
                    2,
