                ],
                "start": 0.000,
                "end": 4.816
            },
            {
                "speaker_id": "2",
                "transcription": "일단 좀 어리둥절 하고요 예.",
                "sound_type": [
                    2
                ],
                "start": 4.826,
                "end": 7.129
            },
            {
                "speaker_id": "2",
                "transcription": "놀랍고 그리고 기쁘고 좋았습니다 일단.",
