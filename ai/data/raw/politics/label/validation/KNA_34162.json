        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이명기 전 국가 정보원장이 소환 조사를 받던 중 긴급 체포됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.409
            },
            {
                "speaker_id": "1",
                "transcription": "서울 중앙 지검 특수 3부는 조사 과정 등 제반 상황을 종합적으로 고려해 이 전 원장의 신병을 확보했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.419,
                "end": 12.067
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 늦어도 내일까진 이 전 원장에 대해 구속 영장을 청구할 방침입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.077,
                "end": 16.875
            },
            {
                "speaker_id": "1",
                "transcription": "체포 시한은 48시간으로 모레 새벽까지입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.885,
                "end": 20.325
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 이 전 원장을 상대로 청와대로 보낸 특수 활동비가 매달 5000만 원에서 1억 원으로 늘어난 점을 확인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.335,
                "end": 27.933
            },
            {
                "speaker_id": "1",
                "transcription": "특히 이 전 원장이 대통령 비서 실장이 된 배경에 특수 활동비 상납이 영향을 미쳤는지 집중적으로 조사했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.943,
                "end": 35.606
            },
            {
                "speaker_id": "1",
                "transcription": "이 전 원장은 어제 조사에 앞서 관련 의혹에 대해 머리를 숙였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.616,
                "end": 40.181
            },
            {
                "speaker_id": "2",
                "transcription": "청와대 지원된 문제로 인해서 국민 여러분들께 실망과 심려를 끼쳐드린 데 대해서 아 대단히 송구스럽게 생각을 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.191,
                "end": 52.029
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 조사를 끝낸 @이름1 @이름2 전 국정원장에 대해서는 구속 영장을 청구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.039,
                "end": 57.935
            },
            {
                "speaker_id": "1",
                "transcription": "남 전 원장은 박근혜 정부 초대 국정원을 지냈고 이 전 원장은 마지막 국정원장이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.945,
                "end": 64.331
            },
            {
                "speaker_id": "1",
                "transcription": "이들은 국정원 특수 활동비를 박근혜 전 대통령 등에게 뇌물 등으로 제공한 혐의를 받고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.341,
                "end": 70.192
            },
            {
                "speaker_id": "1",
                "transcription": "남 전 원장은 이와 별개로 지난 2013년 검찰에 국정원 댓글 사건 수사와 재판을 방해하는데 관여한 혐의도 받고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 70.202,
                "end": 78.758
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름3입니다.",
                "sound_type": [
                    2
                ],
                "start": 78.768,
                "end": 81.333
            }
        ]
    },
    "summary": "검찰은 전임 국정원장들을 구속 영장을 청구하며 조사에 착수했다.",
