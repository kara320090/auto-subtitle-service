    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 이곳은 지금 행사 준비로 한창 바쁜 모습입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.305
            },
            {
                "speaker_id": "1",
                "transcription": "행사 순서를 점검하며 마지막 리허설을 진행하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.315,
                "end": 8.564
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 창당 대회는 오후 2시부터 1시간가량 진행되는데요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.574,
                "end": 12.786
            },
            {
                "speaker_id": "1",
                "transcription": "당 강령과 기본 정책 당헌당규 채택에 이어 공동 대표 선출과 수락 연설 순으로 진행됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.796,
                "end": 20.228
            },
            {
                "speaker_id": "1",
                "transcription": "새정치민주연합은 오늘 창당대회 뒤 곧바로 기존 민주당과의 합당 절차를 거쳐 통합 신당으로서 공식 출범합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.238,
                "end": 27.734
            },
            {
                "speaker_id": "1",
                "transcription": "지난 2일 김한길 대표와 안철수 위원장이 전격적으로 신당 창당을 선언한 뒤 24일 만입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 27.744,
                "end": 34.551
            },
            {
                "speaker_id": "1",
                "transcription": "새정치민주연합은 오늘 채택하는 당헌당규에서 내년 3월 전당대회 전까지 1년 동안은 김한길 안철수 공동대표가 동수로 최고위원회를 구성해 당을 운영하기로 했습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 34.561,
                "end": 46.137
            },
            {
                "speaker_id": "1",
                "transcription": "또 강령과 정강정책에서는 보수적인 가치들을 상당 폭 수용하기로 했는데요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 46.147,
                "end": 51.404
            },
            {
                "speaker_id": "1",
                "transcription": "경제 성장과 안보 북한 인권을 강조함으로써 중도층의 지지를 이끌어 내고 이념 시비를 차단하겠다는 취지입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 51.414,
                "end": 59.400
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 창당대회 참석에 앞서 김한길 안철수 공동대표는 국립대전현충원을 찾아 참배하고 천안함 용사 4주기 추모식에도 참석했습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 59.410,
                "end": 69.442
            },
            {
                "speaker_id": "1",
                "transcription": "KBS뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 69.452,
                "end": 71.766
            }
        ]
    },
    "summary": "새정치민주연합은 내년 전당대회 전까지 1년 동안은 김한길 안철수 공동대표가 최고위원회를 구성해 당을 운영하고, 중도층 지지를 확보하고자 보수적인 가치들을 상당 폭 수용한다.",
