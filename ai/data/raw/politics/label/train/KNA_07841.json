        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회 국토교통위원으로 있으면서 가족 소유 건설사를 통해 피감 기관에서 수천억 원대 공사를 수주한 박덕흠 의원",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.513
            },
            {
                "speaker_id": "2",
                "transcription": "공사 수주와 관련하여 외압을 행사하거나 청탁을 한 적이 전혀 없다는",
                "sound_type": [
                    2
                ],
                "start": 8.523,
                "end": 14.065
            },
            {
                "speaker_id": "1",
                "transcription": "예결위원으로 활동하면서 자녀 명의로 이스타홀딩스 주식을 대량 보유한 이상직 전 의원",
                "sound_type": [
                    2
                ],
                "start": 14.075,
                "end": 20.789
            },
            {
                "speaker_id": "3",
                "transcription": "매각 대상 주식 내지 그 매각 대금을 헌납하겠다는 발표를 해도 결국 이상직이 문제라는",
                "sound_type": [
                    2
                ],
                "start": 20.799,
                "end": 28.329
            },
            {
                "speaker_id": "1",
                "transcription": "국회의원 이해 충돌 논란의 중심엔 이렇게 가족 명의 주식이 있었습니다.",
