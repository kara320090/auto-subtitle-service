        "term": [
            {
                "speaker_id": "1",
                "transcription": "반면 야당이 주장한 선지원 후구상권 행사 방식에는 정부 여당이 다시 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.583
            },
            {
                "speaker_id": "2",
                "transcription": "그 정부가 채권을 매입해서 보증금을 반환하는 반환해주는 보증금 직접 주는 효과를 거두는 이런 제도가 시행이 된다 그러면은 형평성 문제를 분명히 제기할 거라고 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 6.593,
                "end": 17.259
            },
            {
                "speaker_id": "3",
                "transcription": "야당이 제시하는 어 방안이 그 피해자들에게 정부가 세금으로 보증금을 대신 줘라 이제 이런 식으로 이해하는 것은 굉장한 왜곡이다.",
                "sound_type": [
                    2
                ],
                "start": 17.269,
                "end": 29.089
            },
            {
                "speaker_id": "1",
                "transcription": "국토위는 법안 소위를 한 번 더 연 다음 추가 논의를 이어가기로 했는데 그만큼 법안 통과도 당초 예정보단 늦어질 것으로 보입니다.",
                "sound_type": [
