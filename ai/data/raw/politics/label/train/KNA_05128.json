                ],
                "start": 0.000,
                "end": 8.543
            },
            {
                "speaker_id": "2",
                "transcription": "그러면 전 정권에 그 지명된 장관 중에 그렇게 훌륭한 사람 봤어요?",
                "sound_type": [
