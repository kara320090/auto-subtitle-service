        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난해 3월 김태현이 스토킹 피해 여성과 어머니 등 세 모녀를 살해한 사건으로 가족들도 보호해야 할 필요성이 제기됐기 때문입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.074
            },
            {
                "speaker_id": "2",
                "transcription": "이 스토킹 피해자의 처벌법에 의한 스토킹 피해자의 범위가 너무 좀 협소하다는 지적도 있었고 저희는 피해자 범죄까지 가지 않더라도 지원하는 거를 목표로 하기 때문에 대상을 확대를 한 거죠.",
                "sound_type": [
                    2
                ],
                "start": 8.084,
                "end": 20.123
            },
            {
                "speaker_id": "1",
                "transcription": "스토킹 피해자에 대한 지원도 대폭 강화됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.133,
                "end": 23.032
            },
            {
                "speaker_id": "1",
                "transcription": "스토킹 피해자와 신고자에 대한 해고 등 불이익 조치를 금지하고 피해자가 학생일 경우 학업을 지속할 수 있도록 전학 등 취학을 지원할 근거가 마련됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.042,
                "end": 33.459
            },
            {
                "speaker_id": "1",
                "transcription": "피해자 등에 대해 불이익을 주거나 스토킹 현장 조사를 방해할 경우",
                "sound_type": [
                    2
