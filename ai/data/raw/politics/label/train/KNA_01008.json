        "term": [
            {
                "speaker_id": "1",
                "transcription": "베트남 음식 샌드위치와 닭백숙의 추억과 함께하셨으면 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.618
            },
            {
                "speaker_id": "2",
                "transcription": "민주당 이재명 고문은 보궐 선거 출마에는 아직 거리를 두는 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.628,
                "end": 10.676
            },
            {
                "speaker_id": "2",
                "transcription": "아직 결심을 굳히진 못한 건데 당내에선 분당보다는 인천 계양 출마를 언급하는 사람들이 많아졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.686,
                "end": 18.461
            },
            {
                "speaker_id": "3",
                "transcription": "출마를 어 해 달라고 하는 그런 인천 지역이나 수도권 또는 전국의 그런 요구들이 있기 때문에 그 부분을 좀 열어 놓고 지도부가 좀 판단을 해 보자 이런",
                "sound_type": [
                    2
                ],
                "start": 18.471,
                "end": 28.891
            },
            {
                "speaker_id": "2",
                "transcription": "이 고문 측 관계자는",
                "sound_type": [
                    2
