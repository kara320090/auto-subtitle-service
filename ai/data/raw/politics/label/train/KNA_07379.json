        "term": [
            {
                "speaker_id": "1",
                "transcription": "지역의 정치를 민주당이 도맡아 하고 있으면서도 결국엔 조정에 실패했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.229
            },
            {
                "speaker_id": "2",
                "transcription": "여당이 된 만큼 막대한 예산 지원도 약속했는데 이 과정에서 말 실수도 있었습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.239,
                "end": 11.159
            },
            {
                "speaker_id": "3",
                "transcription": "대통령을 설득해서 제가 이 지역에 세금 폭탄을 투하하겠습니다 여러분.",
                "sound_type": [
                    2
                ],
                "start": 11.169,
                "end": 16.806
            },
            {
                "speaker_id": "3",
                "transcription": "그러니까 막 세금 폭탄했나요?",
                "sound_type": [
                    2
                ],
                "start": 16.816,
                "end": 18.956
            },
            {
                "speaker_id": "3",
                "transcription": "예산 폭탄을 투하하도록 하겠습니다.",
                "sound_type": [
                    2
