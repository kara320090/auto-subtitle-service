        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 다치더라도 전부 다 5인 미만 사업장을 배제하는 것은 좀 타당하지 않다라고 생각을 하고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.389
            },
            {
                "speaker_id": "2",
                "transcription": "그대로 상임위를 통과했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.399,
                "end": 13.066
            },
            {
                "speaker_id": "3",
                "transcription": "국민 청원 발의자 의견은 들어봐야 될 것 아닙니까?",
                "sound_type": [
