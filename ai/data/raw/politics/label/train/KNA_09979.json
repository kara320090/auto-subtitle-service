        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 사과나 반성도 없는 뻔뻔한 귀가라고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.965
            },
            {
                "speaker_id": "2",
                "transcription": "헌법재판소의 결정을 왜곡한 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.975,
                "end": 8.425
            },
            {
                "speaker_id": "2",
                "transcription": "민주당과 민형배 의원은 국민들에게 먼저 사죄부터 함이 마땅합니다.",
                "sound_type": [
                    2
                ],
                "start": 8.435,
                "end": 15.309
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 복잡한 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.319,
                "end": 17.907
            },
            {
                "speaker_id": "1",
                "transcription": "민 의원을 복당시키지 않으면 누가 당을 위해서 희생하겠냐는 환영도 나왔지만 국민 시선을 의식하지 않았다.",
                "sound_type": [
                    2
                ],
                "start": 17.917,
                "end": 26.015
            },
            {
                "speaker_id": "1",
                "transcription": "당에 부담주는 결정이라는 내부 비판도 쏟아졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.025,
                "end": 30.196
            },
            {
                "speaker_id": "1",
                "transcription": "정의당도 위장 탈당을 고백하는 꼴이라고 논평했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.206,
                "end": 34.501
            }
        ]
    },
    "summary": "국민의힘은 사과나 반성도 없는 뻔뻔한 귀가라고 비판했고 정의당도 위장 탈당을 고백하는 꼴이라고 논평했는데 민주당은 환영의 목소리도 나왔지만 국민 시선을 의식하지 않았고 당에 부담주는 결정이라는 내부 비판도 쏟아졌다고 기자는 보도했다.",
