        "term": [
            {
                "speaker_id": "1",
                "transcription": "휘발유 25퍼센트 경유는 37퍼센트 내린 현재 인하폭을 유지하는 데 무게를 둔 발언으로 풀이됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.294
            },
            {
                "speaker_id": "1",
                "transcription": "기간은 당분간이라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.304,
                "end": 10.522
            },
            {
                "speaker_id": "1",
                "transcription": "유류세 인하 조치는 2021년 11월부터 세 차례 연장됐는데 연장 기간이 짧게는 두 달 길게는 6달까지였습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.532,
                "end": 19.808
            },
            {
                "speaker_id": "1",
                "transcription": "물가 인상의 불씨를 잠재우려면 충분히 길게 인하하면 되겠지만 정부는 세수 부족 문제도 신경 써야 하는 처지입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.818,
                "end": 28.665
            },
            {
                "speaker_id": "1",
                "transcription": "지난해와 비교하면 2월까지 국세가 15조 7000억 원 덜 걷혔기 때문입니다.",
                "sound_type": [
                    2
