        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 소속 박광온 법사위원장은 국회의장이 여야 합의를 원하는 상황에서 분위기를 해치고 싶지 않다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.494
            },
            {
                "speaker_id": "1",
                "transcription": "당 지도부 생각도 마찬가지라며 보류 이유를 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.504,
                "end": 11.919
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 안건조정위 기습 개의에 대비해 의원들을 비상 대기시켰다가 조정위 구성 보류 소식이 전해지자 대기령을 해제하기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.929,
                "end": 21.503
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 협상이 잘 진행될지는 여전히 불투명한 상황입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.513,
                "end": 26.097
            },
            {
                "speaker_id": "1",
                "transcription": "수사 기소 분리란 원칙을 훼손돼선 안 된다는 민주당 입장이 확고하기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 26.107,
                "end": 31.664
            }
        ]
    },
    "summary": "수사 기소 분리란 원칙을 훼손돼선 안 된다는 민주당 입장이 확고하기 때문에 협상이 잘 진행될지는 여전히 불투명한 상황이다.",
