        "term": [
            {
                "speaker_id": "1",
                "transcription": "이준석 대표 성 상납 의혹은 지난 12월 한 유튜브 채널이 제기했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.943
            },
            {
                "speaker_id": "1",
                "transcription": "이 대표가 2013년 대전의 한 호텔에서 IT 업체 대표로부터 성 접대를 받았다는 수사 기록이 있다는 거였습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.953,
                "end": 13.010
            },
            {
                "speaker_id": "1",
                "transcription": "이 대표는 즉각 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.020,
                "end": 15.195
            },
            {
                "speaker_id": "2",
                "transcription": "저는 수사 기관이나 어떤 곳으로도 그런 것에 대해서 연락을 받은 적도 없고 저는 그 내용 자체가 굉장히 생소하기 때문에",
                "sound_type": [
                    2
                ],
                "start": 15.205,
                "end": 21.510
            },
            {
                "speaker_id": "1",
                "transcription": "이후 이 대표 측근인 김철근 정무 실장이 제보자를 만나 7억 원 투자 유치 각서를 써주고 성 접대는 사실이 아니라는 확인서를 받아갔다는 의혹도 제기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.520,
                "end": 32.499
            }
        ]
    },
    "summary": "이준석 대표 성 상납 의혹은 지난 12월 한 유튜브 채널이 제기했으며 이 대표는 즉각 부인했습니다.",
