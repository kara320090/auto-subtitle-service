        "term": [
            {
                "speaker_id": "1",
                "transcription": "미국 도감청 의혹 파문에 처음으로 직접 입장을 밝힌 거로 해석됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.714
            },
            {
                "speaker_id": "1",
                "transcription": "대통령실 관계자는 한미 관계를 형제에 빗대 다툰다고 형제나 가족이 아닌 건 아니라고 발언 의미를 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.724,
                "end": 12.810
            },
            {
                "speaker_id": "1",
                "transcription": "작은 오해나 다툼 이해 충돌은 충분히 극복할 수 있는 관계라는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 12.820,
                "end": 18.529
            },
            {
                "speaker_id": "1",
                "transcription": "도감청 의혹 당사자인 미국도 이런 입장 같이했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.539,
                "end": 22.314
            },
            {
                "speaker_id": "1",
                "transcription": "한국과 아주 좋은 관계이고 미국과 우방국 신뢰는 굳건하다며 충실히 소통 중이라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.324,
                "end": 28.897
            },
            {
                "speaker_id": "1",
                "transcription": "다만 도감청 자료라며 유출된 문건 내용이 사실인지는 양국 정부 설명 온도 차가 있었습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.907,
                "end": 35.735
            }
        ]
    },
    "summary": "도감청 자료라며 유출된 문건 내용이 사실인지는 양국 정부의 설명 온도 차가 있었다.",
