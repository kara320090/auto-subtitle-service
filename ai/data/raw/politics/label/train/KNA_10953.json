        "term": [
            {
                "speaker_id": "1",
                "transcription": "탄소중립녹색성장위원회가 제1차 국가 탄소 중립 녹색성장 기본 계획을 발표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.428
            },
            {
                "speaker_id": "1",
                "transcription": "지난해 시행된 탄소중립 기본법에 따른 정부 차원의 첫 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.438,
                "end": 11.376
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 일단 2030년까지 온실가스 감축 목표는 2018년 대비 40퍼센트 감축이라는 기존 안을 유지하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.386,
                "end": 20.451
            },
            {
                "speaker_id": "1",
                "transcription": "다만 부문별 감축 목표는 조정됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.461,
                "end": 23.826
            },
            {
                "speaker_id": "1",
                "transcription": "산업 부문은 감축 목표를 줄여 기존 안보다 800만 톤 정도 더 배출할 수 있도록 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.836,
                "end": 30.213
            },
            {
                "speaker_id": "1",
                "transcription": "배출 8개 부문 중 감축 비중을 줄인 건 산업 부문이 유일합니다.",
                "sound_type": [
                    2
                ],
                "start": 30.223,
                "end": 34.968
            }
        ]
    },
