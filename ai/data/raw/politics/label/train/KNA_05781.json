        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당이 이상민 행정 안전부 장관 해임 건의안을 국회에 제출했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.448
            },
            {
                "speaker_id": "1",
                "transcription": "이태원 참사 1달이 지났지만 윤석열 정부의 누구도 책임지지 않고 있다며 그동안 시간 끌기 꼬리 자르기로 뭉개고 있다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.458,
                "end": 13.454
            },
            {
                "speaker_id": "2",
                "transcription": "이태원 참사 발생과 대처 과정에서 경찰이나 소방 인력을 미리 배치한다고 해결될 문제가 아니었다는 식으로 수차례 상황을 오판하고",
                "sound_type": [
                    2
                ],
                "start": 13.464,
                "end": 27.300
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 다음 달 2일 본회의에서 해임 건의안을 처리하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.310,
                "end": 32.304
            },
            {
                "speaker_id": "1",
                "transcription": "특히 해임 건의안을 선택한 건 윤 대통령과 이 장관에게 마지막으로 기회를 주는 것이라며 만약 건의안이 가결됐는데도 이 장관이 자진 사퇴를 하지 않거나 윤 대통령이 수용하지 않는다면 다음 주에는 탄핵 소추안을 발의하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.314,
                "end": 49.283
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 강하게 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 49.293,
                "end": 51.576
            },
            {
                "speaker_id": "1",
                "transcription": "여야가 국정 조사에 합의한 상황에서 조사 대상에 포함된 이 장관 해임을 추진하는 건 참사를 정쟁에 활용하는 행태라고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 51.586,
                "end": 61.243
            },
            {
                "speaker_id": "3",
                "transcription": "책임이 있다면 책임을 묻겠다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.253,
                "end": 64.877
            },
            {
                "speaker_id": "3",
                "transcription": "그런데 국정 조사가 시작되기도 전에 미리 파면하라고 요구한다면 국정 조사를 할 이유가 없다 할 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.887,
                "end": 74.353
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 해임 건의안을 민주당 이재명 대표를 구하기 위한 도구로 쓰는 것 아니냐고 꼬집었습니다.",
                "sound_type": [
                    2
                ],
                "start": 74.363,
                "end": 80.979
            },
            {
                "speaker_id": "1",
                "transcription": "한편 국회 예결위 활동 시한이 오늘로 끝나는 가운데 김진표 국회 의장과 여야 원내 대표는 회동을 갖고 내년도 예산안 처리 시한인 다음 달 2일 오후 2시까지 협상 타결을 위해 노력하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 80.989,
                "end": 94.563
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 94.573,
                "end": 96.529
            }
        ]
    },
    "summary": "민주당이 이상민 행정 안전부 장관 해임 건의안을 국회에 제출했다.",
