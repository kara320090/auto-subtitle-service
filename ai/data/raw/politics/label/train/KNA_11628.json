        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부는 강제동원 재단을 통한 판결금 지급 작업에 본격 착수했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.470
            },
            {
                "speaker_id": "1",
                "transcription": "연락이 닿는 피해자 13명 가운데 현재 절반 이상을 만났습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.480,
                "end": 9.261
            },
            {
                "speaker_id": "1",
                "transcription": "정부 해법은 피해자 21만여 명 가운데 소송을 제기한 피해자에게만 적용됩니다.",
                "sound_type": [
                    2
                ],
                "start": 9.271,
                "end": 15.268
            },
            {
                "speaker_id": "1",
                "transcription": "1000여 명 정도로 0.5퍼센트도 안 되는 수치입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.278,
                "end": 18.753
            },
            {
                "speaker_id": "1",
                "transcription": "형평성 논란이 제기되자 강제동원 재단은 모든 피해자에게 보상금을 주겠다며 특별법 제정 준비를 시작했습니다.",
                "sound_type": [
