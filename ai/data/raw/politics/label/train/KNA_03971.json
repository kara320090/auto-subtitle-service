        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난해 광복절이 토요일이었을 때 그다음 월요일을 임시공휴일로 지정했는데 4조 2000억 원의 생산 유발 효과를 거뒀다는 연구 결과도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.042
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 백신 접종이 확대돼 외부 활동이 그나마 자유로워지고 이때 대체공휴일이 늘면 식당 숙박업 같은 코로나 피해 업종에서 소비 진작과 고용 유발 효과를 기대할 수도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.052,
                "end": 23.250
            },
            {
                "speaker_id": "2",
                "transcription": "잘 쉬어야 일도 잘할 수 있고 국내 경기도 좋아집니다.",
