        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "바로 옆 490억 원이 투입된 실내 체육관도 지난해 10억 원의 적자를 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.674
            },
            {
                "speaker_id": "2",
                "transcription": "운동장은 넓고 좋은데 이용하는 사람들은 별로 없었어요.",
                "sound_type": [
                    2
                ],
                "start": 5.684,
                "end": 9.389
            },
            {
                "speaker_id": "2",
                "transcription": "열어놔도 열어놓은 줄 모르는 사람들이 많을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 9.399,
                "end": 13.614
            },
            {
                "speaker_id": "1",
                "transcription": "경북 지역 공공시설 89곳의 건설비용은 약 2조 1500억 원.",
                "sound_type": [
                    2
                ],
                "start": 13.624,
                "end": 18.294
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 이 가운데 95퍼센트 이상이 적자를 기록하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.304,
                "end": 22.632
            },
            {
                "speaker_id": "1",
                "transcription": "더 큰 문제는 적자 규모가 가파르게 늘고 있다는 건데 2016년 60곳에 440억 원에서 2020년 85곳 800억 원으로 5년 새 3백억 넘게 늘었습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.642,
                "end": 34.034
            }
        ]
    },
    "summary": "경북 지역 공공시설 89곳의 95퍼센트 이상이 적자를 기록하고 있다.",
