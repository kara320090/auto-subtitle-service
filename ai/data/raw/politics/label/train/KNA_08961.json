        "term": [
            {
                "speaker_id": "1",
                "transcription": "23일 일하는 날이 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.376
            },
            {
                "speaker_id": "1",
                "transcription": "몇백 원 차이 때문에 못 받는 그런 날이 되는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 2.386,
                "end": 6.069
            },
            {
                "speaker_id": "2",
                "transcription": "20대 A 씨도 청년 임대 주택에 살면서 주거 급여를 받고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.079,
                "end": 11.213
            },
            {
                "speaker_id": "2",
                "transcription": "아버지의 사업 부도 후 가족이 뿔뿔이 흩어졌고 차상위 계층이 됐다 지난해부턴 수급자입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.223,
                "end": 18.226
            },
            {
                "speaker_id": "3",
                "transcription": "겨울에는 10도 아래로 떨어져요 실내 온도가.",
                "sound_type": [
                    2
                ],
                "start": 18.236,
                "end": 21.083
            },
            {
                "speaker_id": "3",
                "transcription": "하루에 한 끼 먹을 때도 있고 세 끼 먹어본 지는 되게 오래 됐어요.",
                "sound_type": [
                    2
                ],
                "start": 21.093,
                "end": 24.832
            },
            {
                "speaker_id": "2",
                "transcription": "수술을 몇 차례 하면서 모아뒀던 돈은 바닥났고 아르바이트 일용직 경험이 전부라 취업 문턱에서 고배를 마시고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.842,
                "end": 33.333
            }
        ]
    },
