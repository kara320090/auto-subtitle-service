        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번 지방 선거에서 유엔 아시아 본부 유치를 공약하거나 언급한 후보도 3명.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.925
            },
            {
                "speaker_id": "1",
                "transcription": "수중 레저 파크 유니버셜 스튜디오도 공약으로 등장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.935,
                "end": 10.684
            },
            {
                "speaker_id": "2",
                "transcription": "그런 것들을 유치한다는 것은 아니고요.",
                "sound_type": [
                    2
                ],
                "start": 10.694,
                "end": 13.990
            },
            {
                "speaker_id": "2",
                "transcription": "비슷한 것들을 유치할 예정이시라고 하시네요.",
                "sound_type": [
                    2
                ],
                "start": 14.000,
                "end": 18.162
            },
            {
                "speaker_id": "1",
                "transcription": "일단 던져보는 낚시성 공약인지 이행 가능성은 있는지 꼼꼼히 살펴보는 게 이제 유권자가 할 일입니다.",
