            {
                "speaker_id": "1",
                "transcription": "@이름1 대법원장이 거짓 해명을 해 권위를 상실했다며 스스로 물러나야 한다고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.549,
                "end": 10.765
            },
            {
                "speaker_id": "2",
                "transcription": "정치적인 고려를 해야 한다니 정말 어처구니가 없습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.775,
                "end": 15.389
            },
            {
                "speaker_id": "2",
                "transcription": "스스로 법복만 걸친 정책꾼임을 정치꾼임을 고백한 것입니다.",
                "sound_type": [
