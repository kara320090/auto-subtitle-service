                    4
                ],
                "start": 15.399,
                "end": 20.626
            },
            {
                "speaker_id": "1",
                "transcription": "일부 의원들은 김 대법원장을 항의 방문해 결단을 요구했습니다.",
                "sound_type": [
                    2,
                    4
