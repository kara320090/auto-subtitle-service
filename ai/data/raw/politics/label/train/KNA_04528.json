        "term": [
            {
                "speaker_id": "1",
                "transcription": "주어진 소명을 다 하겠다는 약속",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.410
            },
            {
                "speaker_id": "2",
                "transcription": "이 후보는 또 주권자들에게 거짓말이나 헛된 약속을 하지 않고 한번 한 약속은 지켜서 오늘보다 내일이 더 기대되는 나라를 만들겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.420,
                "end": 12.401
            },
            {
                "speaker_id": "2",
                "transcription": "이 후보는 내일 오전엔 청와대에서 문재인 대통령을 만나고 저녁엔 정세균 전 총리와 만찬 자리를 가집니다.",
                "sound_type": [
                    2
                ],
                "start": 12.411,
                "end": 20.102
            },
            {
                "speaker_id": "2",
                "transcription": "동시에 민생 행보도 본격화하고 다음 주 출범을 목표로 선대위를 준비할 계획입니다.",
                "sound_type": [
