        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난해 전 국민 재난지원금 규모는 14조 3000억 원 다만 홍 부총리는 지급 대상을 모든 국민으로 할지는 확정 짓지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.610
            },
            {
                "speaker_id": "1",
                "transcription": "코로나 취약 피해 계층 지원이 추경의 중심이 될 것이라고 밝힌 거를 보면 선별 지원에 무게를 싣는 듯한 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.620,
                "end": 17.787
            },
            {
                "speaker_id": "1",
                "transcription": "전 국민 지급을 추진 중인 여당은 정부를 설득하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.797,
                "end": 22.190
            },
            {
                "speaker_id": "2",
                "transcription": "아무래도 당의 의견이 더 많이 반영될 수밖에 없는 상황이 아닌가 싶습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.200,
                "end": 28.161
            }
        ]
    },
    "summary": "재난지원금을 모든 국민한테 줄지 취약 피해 계층한테 줄지 결정하고 있다.",
