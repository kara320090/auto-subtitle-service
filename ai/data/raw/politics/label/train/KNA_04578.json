                "end": 21.667
            },
            {
                "speaker_id": "1",
                "transcription": "국회는 임 전 부장판사의 행위가 헌법과 법률을 위반했는지라도 판단해달라고 주장했지만 헌재는 받아들이지 않았습니다.",
                "sound_type": [
                    2,
