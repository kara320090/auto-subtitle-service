                    2
                ],
                "start": 0.000,
                "end": 13.294
            },
            {
                "speaker_id": "1",
                "transcription": "임 전 부장판사가 지난 2월 말 임기가 끝난 이상 위헌 여부를 심리해도 파면 선고 자체가 불가능해졌다는 겁니다.",
                "sound_type": [
                    2
