        "term": [
            {
                "speaker_id": "1",
                "transcription": "선거대책위 공식 출범 후 첫 지역 방문 일정으로 이재명 후보는 대구를 선택했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.128
            },
            {
                "speaker_id": "2",
                "transcription": "이재명 이재명",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.138,
                "end": 9.784
            },
            {
                "speaker_id": "1",
                "transcription": "서문 시장 상인들을 만나 지역 상권이 갈수록 쇠락한다면서 수도권과 지역 간 불균형을 바로 잡겠다고 말했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.794,
                "end": 18.740
            },
            {
                "speaker_id": "1",
                "transcription": "소상공인 지원 확대와 함께 자신의 대표적인 정책인 지역 화폐 예산도 늘려 보겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.750,
                "end": 26.025
            },
            {
                "speaker_id": "3",
                "transcription": "대구 시민들이 버는 돈은 대구에서 쓸 수 있게 하면 지역 경제가 아무래도 조금 활성화되고 골목상권에 연쇄 소상공인들의 매출이 늘어나면서 그게 결국은 전체적으로 경제도 성장하고",
                "sound_type": [
                    2
                ],
                "start": 26.035,
                "end": 38.018
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보는 경북대에선 지역 청년들이 겪는 복합적 어려움에 대해 공감한다며 불공정을 해소해 성장으로 이끌겠다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.028,
                "end": 47.525
            },
            {
                "speaker_id": "1",
                "transcription": "또 자신은 이념보다는 실용이 우선이라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.535,
                "end": 51.734
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 후보의 오늘 대구 방문은 국민의힘 대선 후보 선출일에 맞춰 윤석열 후보에게 쏠리는 주목도를 분산시키고 민주당의 취약 지역을 적극적으로 공략하겠다는 의지를 보이는 것으로 해석됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 51.744,
                "end": 66.473
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보는 국민의힘 이재명 후보에 대해서는 축하 인사와 함께 국민의 삶과 희망찬 국가를 위한 선의의 경쟁을 하자고 제안했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 66.483,
                "end": 75.781
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
