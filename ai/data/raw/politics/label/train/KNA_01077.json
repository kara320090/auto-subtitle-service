        "term": [
            {
                "speaker_id": "1",
                "transcription": "한덕수 총리 인준에 협조해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.348
            },
            {
                "speaker_id": "1",
                "transcription": "더 이상 갈 길 바쁜 새 정부의 출범을 방해하는 것은 국민들께서 용납하지 않을 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.358,
                "end": 11.108
            },
            {
                "speaker_id": "2",
                "transcription": "윤 대통령은 역시 야당이 반대 의사를 표시했던 김현숙 후보자도 여성 가족부 장관으로 임명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.118,
                "end": 18.429
            },
            {
                "speaker_id": "2",
                "transcription": "다만 정우용 복지부 장관 후보자에 대해선 막판까지 고심을 이어가고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.439,
                "end": 23.940
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 2명의 장관 후보자를 추가 임명하면서",
                "sound_type": [
                    2
