        "term": [
            {
                "speaker_id": "1",
                "transcription": "다음으로 입법 성적이 좋았던 분야는 산업경제.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.925
            },
            {
                "speaker_id": "1",
                "transcription": "제출 법안의 32.6퍼센트가 본회의 문턱을 넘었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.935,
                "end": 7.437
            },
            {
                "speaker_id": "1",
                "transcription": "반면 노동 관련 법안의 본회의 통과율은 23.8퍼센트.",
                "sound_type": [
                    2
                ],
                "start": 7.447,
                "end": 12.024
            },
            {
                "speaker_id": "1",
                "transcription": "공공개혁 분야는 20.4퍼센트로 저조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.034,
                "end": 15.747
            },
            {
                "speaker_id": "1",
                "transcription": "본회의를 통과한 부동산 법안은 시기별로 뚜렷한 특징을 보였습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.757,
                "end": 20.718
            },
            {
                "speaker_id": "1",
                "transcription": "21대 국회 초반에는 임대차 3법 등 집값 상승을 막기 위한 규제 법안이 다수 통과됐지만 대선을 앞두고는 규제 완화 법안 통과가 늘었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.728,
                "end": 31.563
            },
            {
                "speaker_id": "1",
                "transcription": "주로 서민층 주거 복지와 세금 부담 완화 법안들입니다.",
                "sound_type": [
                    2
                ],
                "start": 31.573,
                "end": 35.602
            }
        ]
    },
