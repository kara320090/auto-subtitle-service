        "term": [
            {
                "speaker_id": "1",
                "transcription": "저렴한 가격으로 무주택자의 꿈을 이루어드리는 것이 더 중요하다고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.979
            },
            {
                "speaker_id": "1",
                "transcription": "추가 공급 물량의 대부분이 서울 경기 인천에 집중된 상황 정권 교체론의 중심에 있는 부동산 표심을 대대적인 공급 정책 카드로 다잡아보겠다는 취지로 보입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.989,
                "end": 16.076
            },
            {
                "speaker_id": "1",
                "transcription": "당내에서도 찬반 논란이 일었던 김포공항 이전을 통한 부지 개발은 제외됐습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.086,
                "end": 22.336
            },
            {
                "speaker_id": "1",
                "transcription": "공항은 그대로 두되 주변 부지를 활용하기로 했고 용산 공원 반환 부지 등 공공 택지를 공급하겠다고 공약했습니다.",
                "sound_type": [
                    2,
