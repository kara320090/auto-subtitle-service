        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여야가 진통 끝에 새 예산안과 예산 부수 법안 처리에 전격 합의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.041
            },
            {
                "speaker_id": "1",
                "transcription": "여야는 우선 639조 원 규모의 정부 예산안에서 4조 6000억 원을 감액하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.051,
                "end": 11.917
            },
            {
                "speaker_id": "1",
                "transcription": "최대 쟁점이었던 법인세는 현행 네 개 과세 표준 구간 별로 각 1퍼센트 포인트씩 인하하는 것으로 절충점을 찾았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.927,
                "end": 20.249
            },
            {
                "speaker_id": "1",
                "transcription": "최고 세율을 현행 25퍼센트에서 3퍼센트 포인트 낮추자던 정부안과 민주당이 동의한 1퍼센트 포인트 인하 안에서 조금씩 양보한 안입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.259,
                "end": 30.352
            },
            {
                "speaker_id": "1",
                "transcription": "또 다른 쟁점이었던 행정 안전부 경찰국과 법무부 인사 정보 관리단 예산은 편성을 하되 50퍼센트 감액하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.362,
                "end": 38.864
            },
            {
                "speaker_id": "1",
                "transcription": "다만 두 기관에 대한 민주당의 우려를 해소하기 위해 정부 조직법 개정 시 대안을 마련한다는 단서를 달았습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.874,
                "end": 46.749
            },
            {
                "speaker_id": "1",
                "transcription": "민주당의 요구 사항이었던 지역 사랑 상품권 발행 지원 예산은 3500여억 원 공공 임대 주택 관련 예산은 정부안보다 6600억 원 증액합니다.",
                "sound_type": [
                    2
                ],
                "start": 46.759,
                "end": 57.065
            },
            {
                "speaker_id": "1",
                "transcription": "금융 투자 소득세 시행은 2년 유예됩니다.",
                "sound_type": [
                    2
                ],
                "start": 57.075,
                "end": 59.991
            },
            {
                "speaker_id": "1",
                "transcription": "다만 그때까지 주식 양도 소득세는 현행대로 과세하고 증권 거래세는 단계적으로 인하하기로 합의했습니다.",
                "sound_type": [
                    2
                ],
                "start": 60.001,
                "end": 67.240
            },
            {
                "speaker_id": "1",
                "transcription": "종합 부동산세는 공제 금액을 9억 원으로 하고 세율은 조정 대상 여부와 무관하게 2주택자까지만 기본 세율을 적용하고 3주택 이상은 과세 표준 12억 원 초과부터 누진세를 유지하되 세율은 2퍼센트에서 5퍼센트로 하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 67.250,
                "end": 83.360
            },
            {
                "speaker_id": "1",
                "transcription": "이 밖에도 여야는 화물차 안전 운임제 연장 30인 미만 기업 초과 근로 연장 등 올해 연말로 일몰 조항이 있는 법안들을 오는 28일 본회의에서 처리하기로 합의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 83.370,
                "end": 94.793
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 예산안 합의는 김진표 국회 의장이 제시한 최후통첩 시한을 하루 앞두고 극적으로 이루어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 94.803,
                "end": 101.064
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 내일 처리되더라도 이미 법정 시한을 21일이나 넘겨 2014년 국회 선진화법 이후 최장 지각 기록을 남기게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 101.074,
                "end": 109.772
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 109.782,
                "end": 111.478
            }
        ]
    },
    "summary": "여야가 진통 끝에 새 예산안과 예산 부수 법안 처리에 전격 합의했지만 내일 처리되더라도 이미 법정 시한을 21일이나 넘겨 2014년 국회 선진화법 이후 최장 지각 기록을 남기게 됐습니다.",
