        "term": [
            {
                "speaker_id": "1",
                "transcription": "그냥 편법으로 해줬나 봐요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.219
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 지금은 불가능하대요.",
                "sound_type": [
                    2
                ],
                "start": 1.229,
                "end": 2.702
            },
            {
                "speaker_id": "2",
                "transcription": "오고 나서 왜 그러냐고 여태까지 잘하다가",
                "sound_type": [
                    2
                ],
                "start": 2.712,
                "end": 6.021
            },
            {
                "speaker_id": "3",
                "transcription": "정부는 2016년부터 지자체장 배우자의 사적 활동에 대한 공무원 수행과 의전 지원을 금지하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.031,
                "end": 14.510
            },
            {
                "speaker_id": "3",
                "transcription": "법인 카드에 대해선 관할 근무지와 무관한 지역 공휴일이나 주말 비정상 시간대 사용을 원칙적으로 금지하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.520,
                "end": 23.768
            },
            {
                "speaker_id": "3",
                "transcription": "이 같은 규정을 피하기 위해 카드 바꿔치기 결제가 이뤄진 건지 KBS는 배 씨에게 수차례 연락을 했지만 답을 듣지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.778,
                "end": 33.197
            },
            {
                "speaker_id": "3",
                "transcription": "이 후보 측은 김혜경 씨와 배 씨의 입장문으로 답변을 대신하겠다고 밝혔습니다.",
