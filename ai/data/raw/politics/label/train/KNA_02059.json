        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘의 뉴스 광장은 국무총리 지명 소식으로 시작하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.864
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령 당선인이 새 정부 초대 총리 후보로 한덕수 전 총리를 지목했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.874,
                "end": 10.782
            },
            {
                "speaker_id": "1",
                "transcription": "경제 안보 시대를 대비할 적임자라고 인선 배경을 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.792,
                "end": 15.023
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 조지현 기자입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.033,
                "end": 18.012
            },
            {
                "speaker_id": "2",
                "transcription": "이미 알려졌던 대로 참신함보다는 안정을 택한 인선이었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.022,
                "end": 23.730
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 당선인은 한덕수 총리 후보자와 나란히 기자회견장에 입장해 정파와 무관하게 실력과 전문성을 인정받았다고 한 후보자에 대한 인선 배경을 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.740,
                "end": 36.720
            },
            {
                "speaker_id": "3",
                "transcription": "민관을 아우르는 풍부한 경험을 바탕으로 국정 과제를 수행해나갈 적임자라고 생각합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 36.730,
                "end": 46.546
            }
        ]
    },
    "summary": "윤석열 당선인이 초대 총리 후보로 한덕수를 지목했고, 기자회견장에서 그 이유에 대해 설명하고 있다.",
