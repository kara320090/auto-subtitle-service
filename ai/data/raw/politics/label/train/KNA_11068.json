        "term": [
            {
                "speaker_id": "1",
                "transcription": "영국과 독일 등에선 정당이 의원들의 공약 이행집을 만들어 서점에 배포하거나 유권자들에게 제공합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.785
            },
            {
                "speaker_id": "1",
                "transcription": "국내에서도 지방자치단체장과 교육감은 홈페이지에 공약 이행도를 공개하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.795,
                "end": 12.796
            },
            {
                "speaker_id": "2",
                "transcription": "선거를 통해서 자기에게 대의로 위임해주신 그런 지역 주민들이 늘상 볼 수 있도록 국회 홈페이지를 통해서 뭐 이행 정보를 좀 공개하셔야 되고요.",
                "sound_type": [
                    2
                ],
                "start": 12.806,
                "end": 22.133
            },
            {
                "speaker_id": "1",
                "transcription": "선출직 공직자의 공약 이행도 공개를 의무화하자는 선거법 개정안은 2011년과 2013년 2차례 발의됐지만 별다른 논의 없이 폐기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.143,
