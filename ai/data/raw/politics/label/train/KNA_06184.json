            },
            {
                "speaker_id": "2",
                "transcription": "전면 번호판 부착을 의무화하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.713,
                "end": 9.999
            },
            {
                "speaker_id": "2",
                "transcription": "부착 비용의 일부를 국가가 보조하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.009,
                "end": 13.528
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보도 전면 번호판을 단계적으로 늘리고 운행 기록 장치를 달면 보험료를 깎아주는 안을 제시했습니다.",
                "sound_type": [
