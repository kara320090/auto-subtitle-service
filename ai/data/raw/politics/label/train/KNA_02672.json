        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 야당 의원의 질의에 대한 것이 아니라 사적 대화였다고 해명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.883
            },
            {
                "speaker_id": "2",
                "transcription": "사적으로 어제 일 가지고 얘기를 하다가 그렇게 한 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.893,
                "end": 8.726
            },
            {
                "speaker_id": "3",
                "transcription": "혹시 사적 대화 내용을 말씀하실 수 있습니까?",
                "sound_type": [
                    2
                ],
                "start": 8.726,
                "end": 11.833
            },
            {
                "speaker_id": "2",
                "transcription": "그건 얘기 드릴 수 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.846,
                "end": 13.353
            },
            {
                "speaker_id": "3",
                "transcription": "아이 그런 걸 바로 이야기해야 오해가 풀릴 수 있지요.",
                "sound_type": [
                    2
                ],
                "start": 13.353,
                "end": 16.757
            },
            {
                "speaker_id": "2",
                "transcription": "사적 대화를 여기서 공개할 이유는 없다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 16.766,
                "end": 20.043
            },
            {
                "speaker_id": "1",
                "transcription": "김대기 비서 실장도 당혹감을 감추지 못했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.053,
                "end": 24.352
            },
            {
                "speaker_id": "4",
                "transcription": "기관장으로서 예 사과의 말씀을 드리고 입이 뭐 열 개라도 말이 없고",
                "sound_type": [
                    2
                ],
                "start": 24.362,
                "end": 29.429
            }
        ]
    },
    "summary": "두 사람은 야당 의원의 질의에 대한 것이 아니라 사적 대화였다고 해명했는데 그 내용에 대해서는 밝힐 수 없다는 입장이었고 김대기 비서 실장도 기관장으로서 사과를 하며 당혹감을 감추지 못했다.",
