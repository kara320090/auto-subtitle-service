        "term": [
            {
                "speaker_id": "1",
                "transcription": "야당은 검증단이 아닌 시찰단이 뭘 할 수 있는지를 집중적으로 따졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.355
            },
            {
                "speaker_id": "2",
                "transcription": "보여주는 시설과 자료만 쭉 한번 둘러보고 별거 없네 결국은 오염수를 방류해도 되겠네 그 결론으로 지금 가고자 하는 거 아닌가요?",
                "sound_type": [
                    2
                ],
                "start": 6.365,
                "end": 18.628
            },
            {
                "speaker_id": "1",
                "transcription": "시찰단의 명단조차 정부가 공개하지 않고 있는 점 또 정화된 물의 안전성 문제도 도마 위에 올랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.638,
                "end": 26.155
            },
            {
                "speaker_id": "3",
                "transcription": "깨끗하면 후쿠시마표 오염 생수 이렇게 수출해도 되잖아요 일본이.",
                "sound_type": [
                    2
                ],
                "start": 26.165,
                "end": 31.064
            }
        ]
    },
    "summary": "야당은 시찰단이 뭘 할 수 있는지 집중적으로 따졌다.",
