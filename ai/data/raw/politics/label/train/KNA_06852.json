            },
            {
                "speaker_id": "2",
                "transcription": "정 후보자는 인사 청문회에서 모든 의혹을 해명하겠다며 자진 사퇴 전망에는 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.394,
                "end": 14.087
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 대통령 당선인도 지명 철회 의사가 없음을 거듭 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.097,
                "end": 19.538
            },
            {
                "speaker_id": "3",
                "transcription": "부정의 팩트가 확실히 있어야 하지 않나.",
                "sound_type": [
                    2
                ],
                "start": 19.548,
                "end": 23.389
            },
            {
                "speaker_id": "3",
                "transcription": "지금까지 해명한 바로는 전혀 없기 때문에",
                "sound_type": [
