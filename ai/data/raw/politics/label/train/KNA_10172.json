        "term": [
            {
                "speaker_id": "1",
                "transcription": "아직 공약인 상태지만 분당과 일산 아파트 값은 벌써 들썩이기 시작해 최고가로 실거래되고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.861
            },
            {
                "speaker_id": "2",
                "transcription": "역세권 위주로 이제 호가는 올라갔고 거래가 되면 신고가 형식이고요.",
                "sound_type": [
                    2
                ],
                "start": 6.871,
                "end": 14.991
            },
            {
                "speaker_id": "1",
                "transcription": "지은 지 30년 넘은 아파트는 전국 아파트의 10분의 1가량.",
                "sound_type": [
                    2,
                    4
                ],
