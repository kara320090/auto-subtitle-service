        "term": [
            {
                "speaker_id": "1",
                "transcription": "문명 사회에서는 받아들이기 어려운 방식입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.656
            },
            {
                "speaker_id": "2",
                "transcription": "민주당에선 이 대표를 향해 기본 바탕이 퇴행적이다.",
                "sound_type": [
                    2
                ],
                "start": 2.666,
                "end": 6.602
            },
            {
                "speaker_id": "2",
                "transcription": "장애인과 싸울 시간에 불평등과 싸우라는 비판이 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.612,
                "end": 11.480
            },
            {
                "speaker_id": "3",
                "transcription": "이동할 권리를 보장해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 11.490,
                "end": 14.629
            },
            {
                "speaker_id": "3",
                "transcription": "장애인들이 왜 지하철에서 호소하는지 목소리를 제대로 들어야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 14.639,
                "end": 19.892
            },
            {
                "speaker_id": "1",
                "transcription": "장애인들은 윤석열 당선인과 인수위에 대책을 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.902,
                "end": 24.157
            }
        ]
    },
    "summary": "이준석 대표에 대해 민주당은 장애인들의 목소리를 제대로 들어야 한다며 비판했다.",
