        "term": [
            {
                "speaker_id": "1",
                "transcription": "누구든 네 국민의 아픔에 대해서 훨씬 더 민감해져야 한다고 생각합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.251
            },
            {
                "speaker_id": "2",
                "transcription": "또 종로 출마를 공식화하면서 한국당 황교안 대표와 신사적 경쟁을 펼쳤으면 하는 기대가 있다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.261,
                "end": 15.960
            },
            {
                "speaker_id": "2",
                "transcription": "한국당은 경부선이 출발하는 서울역을 찾았습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.970,
                "end": 19.875
            },
            {
                "speaker_id": "3",
                "transcription": "새해 복 많이 받으세요.",
                "sound_type": [
                    2
                ],
                "start": 19.885,
                "end": 22.344
            },
            {
                "speaker_id": "2",
                "transcription": "똑같이 서울역을 찾은 새로운 보수당.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.354,
                "end": 26.058
            },
            {
                "speaker_id": "2",
                "transcription": "황교안 대표와 유승민 의원이 이른바 보수 통합 열차 앞에서 만날지 관심이 쏠렸지만 불발됐습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.068,
                "end": 33.460
            },
            {
                "speaker_id": "4",
                "transcription": "우리는 대한민국을 살리기 위해서 자유 우파가 함께 다 힘을 모아야 한다 그런 노력 계속할 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.470,
                "end": 42.909
            }
        ]
    },
    "summary": "한국당과 새로운 보수당이 서울역을 찾았다.",
