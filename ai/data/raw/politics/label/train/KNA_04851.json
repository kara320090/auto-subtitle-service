        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 이재명 후보는 이낙연 전 대표와 함께 신 복지 1호 공약을 발표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.784
            },
            {
                "speaker_id": "1",
                "transcription": "만 15살까지 아동 수당을 주는 등 사회 보장 제도를 강화해 OECD 30위 권인 삶의 질을 15위까지 끌어올리겠다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.794,
                "end": 15.659
            },
            {
                "speaker_id": "2",
                "transcription": "국민들이 전 세계적으로 가장 자살자가 많다는 이 참담한 현실을 반드시 바꿔내야 될 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.669,
                "end": 24.193
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 후보는 또 생애 처음 집을 살 때 취득세를 절반으로 깎아주는 기준을 수도권 6억 지방 5억 원 이하로 완화하겠다며 청년들의 부동산 민심에도 호소했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.203,
                "end": 36.707
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 앞으로 제대로 나를 위해 이재명이라는 새 슬로건을 발표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.717,
                "end": 42.347
            },
            {
                "speaker_id": "1",
                "transcription": "2030과 여성 중도층을 향한 슬로건이라고 민주당은 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.357,
                "end": 47.364
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘 윤석열 후보는 대선 후보 선출 뒤 처음으로 대구 경북 지역을 찾아 이곳이 국민의 힘의 뿌리라고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.374,
                "end": 56.468
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 후보와 현 정부를 향해선 같잖다는 표현까지 쓰며 비판 수위를 바짝 높였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.478,
                "end": 62.836
            },
            {
                "speaker_id": "3",
                "transcription": "뭐 나라 말아먹을 일 있습니까?",
                "sound_type": [
                    2
                ],
                "start": 62.846,
                "end": 65.261
            },
            {
                "speaker_id": "3",
                "transcription": "이 무식한 이 3류 바보들을 데려다가 정치를 해서 나라 경제 망쳐 놓고",
                "sound_type": [
                    2
                ],
                "start": 65.271,
                "end": 71.819
            },
            {
                "speaker_id": "1",
                "transcription": "또 공수처가 자신과 배우자 @이름1 씨의 통신 자료를 조회한 데 대해서도 권위주의 독재 시대에나 있던 짓이라고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 71.829,
                "end": 80.880
            }
        ]
    },
    "summary": "민주당 이재명 후보는 신 복지 1호 공약과 새 슬로건을 발표했으며 윤 후보는 이 후보를 향해 비판 수위를 높였다고 하였다.",
