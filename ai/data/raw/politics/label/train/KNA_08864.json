        "term": [
            {
                "speaker_id": "1",
                "transcription": "진실화해위의 선감학원 조사 과정에서 이런 다중 피해자가 최소 8명 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.800
            },
            {
                "speaker_id": "1",
                "transcription": "선감학원을 나와 끌려간 곳이 그 악명높은 삼청교육대 형제복지원 이런 식이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.812,
                "end": 14.210
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 수십 년이 지나도록 정부 차원에서는 한 번도 피해를 공식 인정해주지 않았고 이번에 진실화해위를 통해 처음으로 다중 피해자의 존재가 규명된 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 14.200,
                "end": 26.011
            },
            {
                "speaker_id": "2",
                "transcription": "확인되어진 진실 그리고 조사 결과를 토대로 해서 이들에 대한 적절한 피해 구제 절차로 나가면 되는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 26.021,
                "end": 35.053
            },
            {
                "speaker_id": "2",
                "transcription": "국가가 좀 더 적극적으로 나서야 할 필요가 있다.",
                "sound_type": [
                    2
                ],
