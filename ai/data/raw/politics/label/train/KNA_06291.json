        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난해 4월 배 모 씨와 A 씨가 나눈 텔레그램 대화입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.449
            },
            {
                "speaker_id": "1",
                "transcription": "A 씨가 소고기 안심 사진을 찍어 보내자 배 씨가 가격표 떼고 아이스박스에 넣은 뒤 수내로 이동하라고 지시합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.459,
                "end": 12.942
            },
            {
                "speaker_id": "1",
                "transcription": "성남시 수내동은 이재명 후보 부부의 자택이 있는 곳입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.952,
                "end": 17.421
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 김혜경 씨의 찬거리를 공금으로 산 뒤 집까지 배달해 왔다는 게 제보자 A 씨의 주장입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.431,
                "end": 25.329
            },
            {
                "speaker_id": "1",
                "transcription": "사실인지 확인해 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.339,
                "end": 27.501
            },
            {
                "speaker_id": "1",
                "transcription": "텔레그램 대화가 있던 날",
                "sound_type": [
                    2
                ],
