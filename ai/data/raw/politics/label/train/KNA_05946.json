        "term": [
            {
                "speaker_id": "1",
                "transcription": "월북자가 누군지는 아직까지 확인되지 않은 상태입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.647
            },
            {
                "speaker_id": "1",
                "transcription": "군은 월북자를 민간인으로 추정하고 관계 기관과 추가 확인 작업을 벌이고 있습니다.",
                "sound_type": [
