        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 임시 국무 회의를 열고 대통령 집무실 이전을 위한 360억 원 규모의 예비비 지출 안을 처리했습니다.",
                "sound_type": [
                    2
                ],
