        "term": [
            {
                "speaker_id": "1",
                "transcription": "수원지검은 공수처 견해가 법률상 근거가 없어 대검찰청과 협의해 기소를 결정했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.502
            },
            {
                "speaker_id": "1",
                "transcription": "이에 대해 김진욱 공수처장은 기사를 보고 기소 사실을 알았다며 불편한 기색을 내비쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.512,
                "end": 14.092
            },
            {
                "speaker_id": "1",
                "transcription": "공소권을 둘러싼 공수처와 검찰 간의 힘겨루기가 본격화된 건데 갈등은 더 커질 전망입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.102,
                "end": 21.029
            },
            {
                "speaker_id": "1",
                "transcription": "공수처가 이번 사건처럼 판검사나 고위 경찰 공무원 사건을 검경에 이첩했을 경우 기소 여부는 공수처가 결정하도록 명문화한 사건 사무 규칙을 추진 중이기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.039,
                "end": 33.039
            },
            {
                "speaker_id": "1",
                "transcription": "법조계에서도 의견이 엇갈립니다.",
                "sound_type": [
                    2
                ],
                "start": 33.049,
                "end": 35.168
            }
        ]
    },
    "summary": "공소권을 둘러싼 공수처와 검찰 간의 힘겨루기가 본격화되어 갈등은 더 커질 전망이다.",
