        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 전국 18개 지검과 42개 지청에서 온 평검사 대표들이 이곳 서울중앙지검에서 조금 전인 오후 7시부터 회의를 시작했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.401
            },
            {
                "speaker_id": "1",
                "transcription": "아직 정확한 참석자 규모는 정해지지 않고 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 9.411,
                "end": 12.745
            },
            {
                "speaker_id": "1",
                "transcription": "더 많은 평검사들의 참석을 위해 회의 시간을 일과 이후로 조정한 만큼 예상했던 150명 보다 더 늘어날 수도 있을 걸로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.755,
                "end": 22.216
            },
            {
                "speaker_id": "1",
                "transcription": "이번 평검사 회의는 2003년 참여 정부 당시 인사 방침에 반발한 평검사들이 회의를 소집한 이후 19년 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 22.226,
                "end": 30.823
            },
            {
                "speaker_id": "1",
                "transcription": "그만큼 일선 평검사들이 이번 사안을 심각하게 인식하고 있다는 건데요.",
                "sound_type": [
                    2
                ],
                "start": 30.833,
                "end": 36.292
            },
            {
                "speaker_id": "1",
                "transcription": "평검사들은 회의 시작 전 수사권 폐지 법안 문제점과 대응 방안 등을 논의할 예정이고 안건의 제한을 두지 않고 총의를 모으겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.302,
                "end": 47.367
            },
            {
                "speaker_id": "1",
                "transcription": "내일은 전국 검찰청 부장 검사 대표 50여 명도 이곳 서울중앙지검에 모입니다.",
                "sound_type": [
                    2
                ],
                "start": 47.377,
                "end": 53.359
            },
            {
                "speaker_id": "1",
                "transcription": "어제 문재인 대통령이 김오수 검찰총장과의 면담에서 질서 있는 의견 표명을 언급한 뒤 검찰 지휘부는 민주당 설득에 집중하기로 방향을 정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 53.369,
                "end": 64.147
            },
            {
                "speaker_id": "1",
                "transcription": "이점이 평검사와 부장 검사 회의에 어떤 영향을 미칠 지도 주목됩니다.",
                "sound_type": [
                    2
                ],
                "start": 64.157,
                "end": 69.245
            },
            {
                "speaker_id": "1",
                "transcription": "김 총장은 오늘 취재진에게 특별법 제정 등을 수사권 폐지에 대안으로 제시하기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 69.255,
                "end": 76.033
            },
            {
                "speaker_id": "2",
                "transcription": "검찰 수사 공정성 중립성 확보하는 방안도",
                "sound_type": [
                    2
                ],
                "start": 76.043,
                "end": 81.181
            }
        ]
    },
    "summary": "전국 18개 지검과 42개 지청에서 온 평검사 대표들이 서울중앙지검에서 오후 7시부터 회의를 시작했다.",
