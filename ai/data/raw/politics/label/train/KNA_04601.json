                    2
                ],
                "start": 0.000,
                "end": 8.234
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 마감한 당원 투표율은 최종 63.89퍼센트를 기록해 역대 최고 수준을 보였습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.244,
                "end": 15.456
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보는 경기 북부 시장을 방문해 막판 지지를 호소했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.466,
                "end": 20.169
            },
            {
                "speaker_id": "2",
                "transcription": "당선이 되면 영세 상인들의 피해 규모를 좀 지수화를 시키려고 합니다.",
                "sound_type": [
                    2
                ],
