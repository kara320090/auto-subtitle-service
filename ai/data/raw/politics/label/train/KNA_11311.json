        "term": [
            {
                "speaker_id": "1",
                "transcription": "앞에선 부결을 외치며 뒤로는 가결과 무효표를 조작했다며 총의를 모았다하고 뒤통수를 친것이라는 격한 반응까지 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.480
            },
            {
                "speaker_id": "2",
                "transcription": "거기에서는 뭐 그런 의견이 없다가 이게 표로서 딱 나왔다라는 것은 어떤 의도가 좀 있지 않았냐",
                "sound_type": [
                    2
                ],
                "start": 9.490,
                "end": 16.158
            },
            {
                "speaker_id": "1",
                "transcription": "친 이재명계 중진 의원은 이 대표에게 물러나라는 최후 통첩을 한 것이라며 지금 굴복하면 지지자들이 무너진다고 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.168,
                "end": 25.651
            },
            {
                "speaker_id": "1",
                "transcription": "당 내 소통을 강화하겠다는 당 지도부의 입장에도 그럴 단계는 지났다는 냉소 섞인 반응도 나왔습니다.",
                "sound_type": [
