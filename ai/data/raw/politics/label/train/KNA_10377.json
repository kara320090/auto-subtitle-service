        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 점에 대해서 선관위 내부의 자체 조사가 아니라 철저한 수사가 필요할 것이라고 보고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.207
            },
            {
                "speaker_id": "2",
                "transcription": "첫 의혹이 불거진 이후 선관위는 법과 원칙에 따른 채용이라는 입장이었지만 추가 사례가 잇따르자 오늘은 중앙 선관위원 전원이 참석한 긴급회의를 열었습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.217,
                "end": 16.942
            },
            {
                "speaker_id": "2",
                "transcription": "관련자 수사 의뢰와 사무총장 외부 영입 안 검토 등이 논의된 것으로 알려집니다.",
                "sound_type": [
                    2
                ],
                "start": 16.952,
                "end": 22.513
            },
            {
                "speaker_id": "2",
                "transcription": "노태학 중앙 선관위원장은 처음으로 국민께 송구하다는 입장을 밝혔습니다.",
