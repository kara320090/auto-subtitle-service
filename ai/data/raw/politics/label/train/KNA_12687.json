                ],
                "start": 0.000,
                "end": 10.028
            },
            {
                "speaker_id": "1",
                "transcription": "재선 3선 의원들도 비슷한 취지의 입장문을 준비 중인 것으로 알려졌습니다.",
                "sound_type": [
