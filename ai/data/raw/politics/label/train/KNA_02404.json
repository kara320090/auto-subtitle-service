        "term": [
            {
                "speaker_id": "1",
                "transcription": "인천서 서울까지 가는 10분대 교통 시대를 연다고 했지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.035
            },
            {
                "speaker_id": "1",
                "transcription": "정말 어이없지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 4.045,
                "end": 5.996
            },
            {
                "speaker_id": "1",
                "transcription": "허경영도 놀랄 일일 겁니다.",
                "sound_type": [
                    2
                ],
