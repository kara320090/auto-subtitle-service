        "term": [
            {
                "speaker_id": "1",
                "transcription": "의정부 지방 법원 형사 11부는 공직 선거법과 지방 공무원 법을 위반한 공소 사실이 인정 된다며 조 시장에게 징역 1년 6월과 자격 정지 1년을 선고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 14.457
            },
            {
                "speaker_id": "1",
                "transcription": "재판부는 선거의 공정성과 공무원의 정치 중립을 훼손해 죄질이 좋지 않다며 양형 이유를 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.467,
                "end": 23.435
            },
            {
                "speaker_id": "1",
                "transcription": "더불어민주당 소속인 조 시장은 지난 2020년 4월에 국회의원 선거를 앞두고 자신의 정무 비서인 에이 씨에게 권리 당원 모집을 지시한 혐의로 재판에 넘겨졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.445,
                "end": 35.213
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 조 시장이 남양주 을 지역구에 도전장을 낸 김 모 씨의 경선을 돕기 위해 당원 모집을 지시했다고 기소한 건데 재판부는 이를 인정한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 35.223,
                "end": 48.651
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 정부 출범 후 청와대 인사 비서관을 지냈던 김 씨는 그러나 당시 현역 의원이었던 김한정 의원에게 패배해 후보자가 되지는 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 48.661,
                "end": 60.120
            },
            {
                "speaker_id": "1",
                "transcription": "조 시장은 이권을 목적으로 시장 선거를 도운 사람들이",
                "sound_type": [
                    2
                ],
                "start": 60.130,
                "end": 62.629
            }
        ]
    },
    "summary": "재판부는 조 시장이 공직 선거법과 지방 공무원 법을 위반한 공소 사실이 인정 된다며 조 시장에게 징역 1년 6월과 자격 정지 1년을 선고했다.",
