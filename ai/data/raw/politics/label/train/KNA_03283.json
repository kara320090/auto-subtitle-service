        "term": [
            {
                "speaker_id": "1",
                "transcription": "새 정부의 환경 정책에 발맞춰 공공기관들이 제 역할을 하려면 지난 정부에서 임명한 임원들을 교체해야 했다고 주장한 @이름1 전 환경부 장관.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.596
            },
            {
                "speaker_id": "2",
                "transcription": "내라고 하신 거예요 본인이 먼저 낸 거예요?",
                "sound_type": [
                    2
                ],
                "start": 9.606,
                "end": 12.794
            },
            {
                "speaker_id": "3",
                "transcription": "아 사표를 내시도록 한 거 같은데요.",
                "sound_type": [
                    2
                ],
                "start": 12.804,
                "end": 16.571
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 이 자리가 청와대와 환경부가 점찍은 내정자들로 채워졌다며 권력형 채용 비리로 규정하고 @이름1 전 장관을 기소했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.581,
                "end": 25.252
            },
            {
                "speaker_id": "1",
                "transcription": "서울 중앙 지법은 2년 가까운 심리 끝에 @이름1 전 장관의 직권 남용과 업무 방해 강요 혐의를 대부분 유죄로 보고 징역 2년 6개월을 선고했습니다.",
                "sound_type": [
