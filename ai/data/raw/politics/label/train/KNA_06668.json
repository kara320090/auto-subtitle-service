        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 이제 다 결항이 됐거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.767
            },
            {
                "speaker_id": "1",
                "transcription": "러시아로 오고 갈 수가 없어서 지금 이제 어떻게 귀국하나 하는 생각을 하고 있었는데",
                "sound_type": [
                    2
                ],
                "start": 1.777,
                "end": 8.542
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 이번 특별 수송이 성사되기까지 쉽지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.552,
                "end": 12.525
            },
            {
                "speaker_id": "2",
                "transcription": "코로나19 확산으로 양국 간 여객선 운항이 중단되고 화물만 오가는 상황 연해주 한인회의 요청 뒤에 두 나라 간 운항 협의와 우리 정부 부처 간 협력으로 바닷길이 일시적으로 열렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.535,
                "end": 25.342
            },
            {
                "speaker_id": "3",
                "transcription": "코로나 사태 이후에 이제 그거 카고만 싣는 걸로 돼 있었기 때문에 일단은 안 된다 할지라도 한번 두드려 보자",
                "sound_type": [
                    2
                ],
                "start": 25.352,
                "end": 35.617
            },
            {
                "speaker_id": "2",
                "transcription": "이번 재외 국민 특별 수송은 항공편이 아닌 여객선을 이용한 첫 사례로 기록됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.627,
                "end": 41.574
            }
        ]
    },
    "summary": "두 나라 간 운항 협의와 정부 부처 간 협의로 바닷길이 일시적으로 열렸으며 재외 국민 특별 수송으로 여객선을 이용한 첫 사례로 기록됐다고 하였다.",
