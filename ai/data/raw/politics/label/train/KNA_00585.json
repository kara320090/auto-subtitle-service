        "term": [
            {
                "speaker_id": "1",
                "transcription": "이유가 뭔가요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.562
            },
            {
                "speaker_id": "2",
                "transcription": "네 인수위가 문제 삼은 건 어제 박범계 법무 장관의 기자 간담회였습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.572,
                "end": 8.474
            },
            {
                "speaker_id": "2",
                "transcription": "당선인이 추진하는 법무부 장관의 수사 지휘권 폐지 등에 대해 박 장관이 반대 입장을 밝힌 걸 두고 분노를 금할 수 없다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.484,
                "end": 17.501
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 당선인도 박 장관의 회견 내용은 검찰 중립성을 이루지 못 했다는 잡평 아니냐고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.511,
                "end": 24.145
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 법무부 장관의 수사 지휘가 별 필요 필요가 없다.",
                "sound_type": [
                    2
                ],
                "start": 24.155,
                "end": 28.487
            },
            {
                "speaker_id": "2",
                "transcription": "자율적으로 의견을 조율할 수 있다고 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.497,
                "end": 31.998
            }
        ]
    },
