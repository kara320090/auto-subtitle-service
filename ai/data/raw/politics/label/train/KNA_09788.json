        "term": [
            {
                "speaker_id": "1",
                "transcription": "비례 대표 의석 중 70퍼센트 이상이 사상 초유의 위성 정당 몫이었던 지난 총선 더불어시민당과 미래한국당 쪽으로 비례 의석이 몰릴 것으로 예상이 되고",
                "sound_type": [
