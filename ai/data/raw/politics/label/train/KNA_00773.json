        "term": [
            {
                "speaker_id": "1",
                "transcription": "김인철 전 한국외대 총장이 지명됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.786
            },
            {
                "speaker_id": "1",
                "transcription": "외교부 장관에는 박진 의원 통일부 장관에는 권영세 의원이 각각 발탁되며 외교 통일 라인에 4성급 중진 의원이 포진하게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.796,
                "end": 13.222
            },
            {
                "speaker_id": "1",
                "transcription": "행정안전부 장관 후보에는 이상민 전 국민권익위 부위원장 환경부 장관 후보에는 한화진 한국환경연구원 명예연구원 해양수산부 장관 후보에는 조승환 전 해양과학기술진흥원장 중소벤처기업부 장관 후보에는 이영 의원이 각각 선임됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.232,
                "end": 32.232
