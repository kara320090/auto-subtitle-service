            },
            {
                "speaker_id": "2",
                "transcription": "국민의 당 안철수 후보는 권한과 재정을 지방 정부에 이전하는 연방제형 지방자치와 특성화 대학으로 지방을 살리겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
