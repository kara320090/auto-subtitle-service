                "start": 0.000,
                "end": 7.744
            },
            {
                "speaker_id": "1",
                "transcription": "내일 잇따라 열리는 초재선 중진 모임 그리고 의원 총회가 당지도 체제의 향방의 분수령이 될 것으로 보입니다.",
                "sound_type": [
