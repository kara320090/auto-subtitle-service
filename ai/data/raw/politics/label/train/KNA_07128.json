        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 방향이 맞는 것이기 때문에.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.380
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 단계적 인상이다 일부는 적금 지원금을 줘서 맞추는 걸로 바뀌었습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.390,
                "end": 8.809
            },
            {
                "speaker_id": "2",
                "transcription": "왜 바뀐 건지 설명도 없었는데 인수위 관계자는 재정 여건을 고려한 것이다 공약은 지키는 것이라 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.819,
                "end": 16.342
            },
            {
                "speaker_id": "2",
                "transcription": "소상공인 손실 보상도 마찬가지입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.352,
                "end": 19.582
            },
            {
                "speaker_id": "2",
                "transcription": "업체당 600만 원 일괄 지급 약속에서 차등 지급으로 바뀌었는데 적게 준다는 건 오해다 온전한 보상을 하겠다면서도 구체적 설명은 미루고 있습니다.",
