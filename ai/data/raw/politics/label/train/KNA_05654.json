        "term": [
            {
                "speaker_id": "1",
                "transcription": "도민의 기본권 회복과 예산의 효율적 사용 등을 명분으로 내세웠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.369
            },
            {
                "speaker_id": "2",
                "transcription": "경기도민의 교통 기본권의 회복과 통행료 무료화를 위해서 일산대교의 공익 처분을 추진하기로 결정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.379,
                "end": 15.039
            },
            {
                "speaker_id": "1",
                "transcription": "법원 판단은 달랐습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.049,
                "end": 17.243
            },
            {
                "speaker_id": "1",
                "transcription": "일산대교 주식회사가 낸 행정 소송 1심에서 법원은 사유를 모두 인정할 수 없고 공익 처분은 위법하다고 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.253,
                "end": 25.317
            },
            {
                "speaker_id": "1",
                "transcription": "재판부는 우선 지금 통행료가 이용자의 편익과 비교하면 교통 기본권을 제약할 정도로 비싸지 않다고 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.327,
                "end": 33.066
            }
        ]
    },
    "summary": "도민의 기본권을 위해 일산대교 무료를 주장했고 재판부는 통행료가 비싸지 않다고 공익 처분은 위법하다고 했다.",
