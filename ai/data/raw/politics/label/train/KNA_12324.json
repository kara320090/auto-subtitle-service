        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 얼마가 필요하냐고 묻지 마시고 무조건 주시면 아껴 쓰겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.106
            },
            {
                "speaker_id": "2",
                "transcription": "코로나19 사태로 직격탄을 맞은 경제 현장에선 쓴소리가 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.116,
                "end": 9.785
            },
            {
                "speaker_id": "3",
                "transcription": "현장에서는 신규 대출과 만기 연장이 제대로 이루어지지 않고 있는 실정입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.795,
                "end": 17.377
            },
            {
                "speaker_id": "2",
                "transcription": "문 대통령은 대구 경북에만 맡기지 않겠다 정부가 가용 자원을 모두 동원해 총력 지원하겠다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.387,
                "end": 24.569
            },
            {
                "speaker_id": "2",
                "transcription": "특히 상황이 매우 엄중하기 때문에 특별재난지역 선포만으로는 충분하지 않을 것이라며 그 이상의 지원 방침을 시사했습",
                "sound_type": [
