        "term": [
            {
                "speaker_id": "1",
                "transcription": "수사에서 제일 필요한 게 조직과 인력이거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.999
            },
            {
                "speaker_id": "1",
                "transcription": "그거를 법무부 장관이 직접 다 짜준단 말이죠.",
                "sound_type": [
                    2
                ],
                "start": 2.009,
                "end": 6.422
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 이제 총장을 앉히게 되면 총장으로서는 사실 운신의 폭이 굉장히 좁아지죠.",
                "sound_type": [
                    2
                ],
                "start": 6.432,
                "end": 12.374
            },
            {
                "speaker_id": "2",
                "transcription": "검찰총장의 체계적 인선을 위해 2011년 후보추천위원회 제도가 도입됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.384,
                "end": 18.407
            },
            {
                "speaker_id": "2",
                "transcription": "그 뒤로 공석이 발생하면 늦어도 47일 안에는 후임 추천위가 꾸려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.417,
                "end": 23.688
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 오늘로 김오수 전 총장이 사퇴한 지 47일이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.698,
                "end": 28.328
            }
        ]
    },
    "summary": "검찰 조직을 총괄하는 검찰총장 자리가 47일이 된 상황에서 법무부 인사가 단행됐다.",
