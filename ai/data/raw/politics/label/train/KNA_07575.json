        "term": [
            {
                "speaker_id": "1",
                "transcription": "미공개 소환된 백운규 전 장관의 신분은 피의자입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.352
            },
            {
                "speaker_id": "1",
                "transcription": "산업부 블랙리스트 의혹으로 고발된 인물들 중에서는 가장 윗선입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.362,
                "end": 8.291
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 문재인 정부 초기 산업부가 산하 공공기관장들에게 사표를 내도록 압박했고 백 전 장관이 거기 관여했다고 의심하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.301,
                "end": 17.630
            },
            {
                "speaker_id": "1",
                "transcription": "지난달에는 백 전 장관의 집과 연구실을 압수수색하기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.640,
                "end": 22.574
            },
            {
                "speaker_id": "1",
                "transcription": "당시 확보한 자료와 산업부 직원 공공기관장 등의 진술을 바탕으로 검찰은 이른바 블랙리스트와 관련된 백 전 장관의 지시가 있었는지를 집중 추궁한 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.584,
                "end": 34.234
            }
        ]
    },
