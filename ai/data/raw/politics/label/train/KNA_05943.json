        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 국민 여러분께서 힘을 모아야 한다고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.535
            },
            {
                "speaker_id": "2",
                "transcription": "기도로서 역할을 하겠다며 정치 관련 언급은 피했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.545,
                "end": 6.948
            },
            {
                "speaker_id": "2",
                "transcription": "당분간은 건강 회복에 집중하겠다는 입장도 내비쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.958,
                "end": 11.649
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 다수의 전현직 친이계 의원들이 대거 자리를 함께 했고 내후년 총선을 앞두고 있다는 점에서 보수 진영을 중심으로 일정 역할을 할 가능성도 제기되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.659,
                "end": 23.043
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 대통령도 직접 전화를 걸어왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.053,
                "end": 26.360
            },
            {
                "speaker_id": "2",
                "transcription": "윤 대통령이 먼저 건강 회복을 기원한다고 했고 이 전 대통령은 윤석열 정부의 성공을 위해 기도하겠 다고 화답했다고 참석자들은 전했습니다.",
