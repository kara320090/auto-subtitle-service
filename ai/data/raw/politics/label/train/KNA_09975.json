        "term": [
            {
                "speaker_id": "1",
                "transcription": "동의할 수 없다라는 그게 우리 정부 내에서의 그 방침은 어 일단 확고하다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.629
            },
            {
                "speaker_id": "2",
                "transcription": "특히 공공기관이 전세 피해자의 보증금 반환 채권을 사들여 일부를 돌려준 뒤 경매나 공매를 통해서 회수하자는 선 지원 후 구상에 대해선 이렇게 답했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.639,
                "end": 17.718
            },
            {
                "speaker_id": "1",
                "transcription": "보증금만 우선 돌려주고 뭘 갖고 구상을 하죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.728,
                "end": 21.188
            },
            {
                "speaker_id": "1",
                "transcription": "구상할 물건이 없는데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.198,
                "end": 22.700
            },
            {
                "speaker_id": "1",
                "transcription": "불가능한 구상을 달아놓은 거기 때문에 이거는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.710,
