                    2
                ],
                "start": 10.672,
                "end": 20.509
            },
            {
                "speaker_id": "1",
                "transcription": "지난 총선 패배 책임론 때문에 마음이 많이 상하신 것 같습니다.",
                "sound_type": [
                    2
                ],
