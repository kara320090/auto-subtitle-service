        "term": [
            {
                "speaker_id": "1",
                "transcription": "캠프에서 일했던 이 모 전 비서관이 지난해 11월 국민권익위원회에 부정 채용 의혹을 신고한 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.387
            },
            {
                "speaker_id": "1",
                "transcription": "이번 압수수색에는 당시 인사 담당 공무원의 현 근무지인 정자 3동 사무소도 포함됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.397,
                "end": 14.440
            },
            {
                "speaker_id": "1",
                "transcription": "또 국민 청원을 통해 제기된 공무직 부정 채용 의혹과 관련해서도 서현 도서관에 대한 압수수색이 이뤄졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.450,
                "end": 22.166
            },
            {
                "speaker_id": "1",
                "transcription": "의혹의 핵심은 캠프 관계자 20여 명이 시와 산하 기관 곳곳에 부정 채용됐다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 22.176,
                "end": 29.291
            },
            {
                "speaker_id": "1",
                "transcription": "경찰은 압수수색을 통해 인사 채용 문건에서 평가 점수 조작이 없었는지 등을 살펴볼 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.301,
                "end": 36.336
            }
        ]
    },
    "summary": "캠프에서 일했던 이 모 전 비서관이 국민권익위원회에 부정 채용 의혹을 신고했고 경찰은 압수수색을 통해 인사 채용 문건에서 평가 점 조작이 없었는지 살펴볼 계획이라고 한다.",
