        "term": [
            {
                "speaker_id": "1",
                "transcription": "통일부 산하 공공 기관인 남북 하나 재단.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.093
            },
            {
                "speaker_id": "1",
                "transcription": "탈북민의 정착을 지원하는 곳인데 탈북민 A 씨의 일터이기도 합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.103,
                "end": 8.543
            },
            {
                "speaker_id": "2",
                "transcription": "좋은 평가를 받고 승진도 좀 빨랐고요.",
                "sound_type": [
                    2
                ],
                "start": 8.553,
                "end": 11.644
            },
            {
                "speaker_id": "2",
                "transcription": "다른 탈북민들에 비해서 좀 잘 적응한다고 했나 이러면서",
                "sound_type": [
                    2
                ],
                "start": 11.654,
                "end": 15.045
            },
            {
                "speaker_id": "1",
                "transcription": "재작년 8월 당시 감사 팀장이던 A 씨에게 통일부에서 갑자기 연락이 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.055,
                "end": 21.429
            },
            {
                "speaker_id": "1",
                "transcription": "최근 3년 치 업무 내용 또 감사 팀 운영 계획과 함께 통일부 감사에 어떻게 조치할지 보고하란 지시였습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.439,
                "end": 29.429
            }
        ]
    },
    "summary": "재작년 8월 당시 감사 팀장이던 A 씨에게 통일부에서 갑자기 연락이 와서 최근 3년 치 업무 내용과 감사 팀 운영 계획을 보고하란 지시였다.",
