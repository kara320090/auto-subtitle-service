                    2,
                    5
                ],
                "start": 15.365,
                "end": 21.643
            },
            {
                "speaker_id": "3",
                "transcription": "중국 눈치 보기라는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.653,
                "end": 23.997
            },
            {
                "speaker_id": "3",
                "transcription": "한발 나아가 중국인 입국 금지 법안도 발의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.007,
                "end": 28.073
            },
            {
                "speaker_id": "7",
                "transcription": "즉각적으로 중국인의 입국을 한시적으로 금지하십시오. 한국에 온 우리나라에 온 중국 관광객을 즉각적으로 송환하십시",
                "sound_type": [
                    2
