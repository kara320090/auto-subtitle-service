        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민 안전에는 여야가 따로 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.344
            },
            {
                "speaker_id": "2",
                "transcription": "초당적으로 협조할 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.354,
                "end": 5.643
            },
            {
                "speaker_id": "3",
                "transcription": "하지만 딱 거기까지 병명 호칭부터 달랐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.653,
