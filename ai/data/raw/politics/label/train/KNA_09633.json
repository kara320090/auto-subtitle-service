            },
            {
                "speaker_id": "1",
                "transcription": "처벌 근거와 기준이 모호하다보니 중대재해 1건이 고용노동부 수사를 거쳐 검찰이 기소하기까지 평균 8개월이 걸렸습니다.",
                "sound_type": [
