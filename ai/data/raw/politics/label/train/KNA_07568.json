        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 정부는 성별 지역 등의 다양성 보다도 능력이 제 1 인사 원칙이라고 밝혀왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.856
            },
            {
                "speaker_id": "2",
                "transcription": "다른 거 없이 예 국가와 전체 국민을 위해서 해당 분야를 가장 잘 맡아서 이끌어주실 분이신가에 기준을 두고",
                "sound_type": [
                    2
                ],
                "start": 5.866,
                "end": 20.807
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 몇몇 초대 내각 후보자는 능력보단 대통령과의 사적 인연이 부각되며 뒷말을 낳았습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.817,
                "end": 27.790
            },
            {
                "speaker_id": "1",
                "transcription": "자칭 대통령 40년 지기 정호영 후보자 등 장관 후보자 2명은 아빠 찬스 의혹 속에 낙마했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.800,
                "end": 35.120
            },
            {
                "speaker_id": "1",
                "transcription": "이게 윤 대통령이 내세웠던 공정과 정의냐는 비판도 나왔습니다.",
                "sound_type": [
                    2
