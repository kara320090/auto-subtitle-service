        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "민간 선박이 어로 한계선을 넘은 것은 이번이 처음입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.961
            },
            {
                "speaker_id": "2",
                "transcription": "평화 통일 평화 한반도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.971,
                "end": 7.848
            },
            {
                "speaker_id": "3",
                "transcription": "어 우리가 좀 더 유연하고 창조적으로 어 남북이 평화적인 그 접근을 어 시도해 볼 수 있는 어 곳이기도 하고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.858,
                "end": 16.507
            },
            {
                "speaker_id": "3",
                "transcription": "어 우리 정부는 어 차분하게 어 그런 구 평화의 구상들을 발전시켜 보겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.517,
                "end": 24.234
            },
            {
                "speaker_id": "1",
                "transcription": "조선 시대부터 서해와 서울을 연결하며 물자와 사람이 활발히 오갔던 한강 하구 유역 하지만 남북이 분단되면서 민간의 접근은 차단됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.244,
                "end": 35.084
            },
            {
                "speaker_id": "4",
                "transcription": "민간인들은 못 들어갑니다.",
                "sound_type": [
                    2
                ],
                "start": 35.094,
                "end": 37.282
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 2007년 십사 선언에서 남북이 한강 하구의 공동 이용을 적극 추진하기로 합의했고 2018년 구일구 군사 합의에서는 이 곳을 공동 이용 수역으로 설정했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.292,
                "end": 50.090
            },
            {
                "speaker_id": "1",
                "transcription": "2달 뒤 남북이 공동으로 수로 조사를 실시하고 해도를 발표하기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 50.100,
                "end": 56.085
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이듬해 하노이 북미 회담 결렬 이후 그 이상의 진전은 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 56.095,
                "end": 61.626
            },
            {
                "speaker_id": "1",
                "transcription": "전문가들은 한강 하구가 현재의 교착 국면을 풀 중요한 공간이라고 보고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 61.636,
                "end": 68.041
            },
            {
                "speaker_id": "1",
                "transcription": "구일구 군사 합의에서 이미 공동 이용 수역으로 설정한데다 소유권 분쟁 등의 문제가 없기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 68.051,
                "end": 75.594
            },
            {
                "speaker_id": "5",
                "transcription": "비무장 지대는 이전에 거기 살았던 분들 소유권을 그 무시할 수가 없단 말이죠. 소유권 문제가 발생하지 않는 구역이 강이기 때문에 오히려 강이 훨씬 더 접근이 쉽겠다라고",
                "sound_type": [
                    2
                ],
                "start": 75.604,
                "end": 85.777
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 통신선 복원 이후 첫 협력 사업으로 한강 하구 뱃길이 다시 열리길 기대하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 85.787,
                "end": 92.695
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 92.705,
                "end": 95.128
            }
        ]
    },
    "summary": "한강 하구 유역은 분단이 되면서 민간의 접근이 차단됐지만 2018년 구일구 군사 합의에서 공동 이용 수역으로 설정했지만 하노이 북미 회담 결렬 이후 진전이 없었고 정부는 통신선 복원 이후 첫 협력 사업으로 한강 하구 뱃길이 다시 열리길 기대하고 있다.",
