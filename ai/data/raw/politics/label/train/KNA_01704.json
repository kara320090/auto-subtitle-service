        "term": [
            {
                "speaker_id": "1",
                "transcription": "이재명 게이트란 말을 김만배가 한다고 그러는데",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.228
            },
            {
                "speaker_id": "2",
                "transcription": "정영학 남욱 본 일도 없어요. 무슨 측근에 가까운 사람입니까?",
                "sound_type": [
                    2
                ],
                "start": 3.238,
                "end": 7.239
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 이재명 게이트라고 있다고요? 그 녹취록 중에 내세요.",
                "sound_type": [
                    2
                ],
                "start": 7.249,
                "end": 10.327
            },
            {
                "speaker_id": "2",
                "transcription": "지금 허위 사실이면 후보 사퇴하시겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 10.337,
                "end": 13.537
            },
            {
                "speaker_id": "1",
                "transcription": "아 그만하시죠.",
                "sound_type": [
                    2
                ],
                "start": 13.547,
                "end": 14.695
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 14.705,
                "end": 15.371
            },
            {
                "speaker_id": "1",
                "transcription": "질문은 저거니까 있다가 하세요. 있다가",
                "sound_type": [
                    2
                ],
                "start": 15.381,
                "end": 18.320
            },
            {
                "speaker_id": "3",
                "transcription": "윤석열 후보는 이 후보 배우자 김혜경 씨의 법인 카드 의혹으로 역공했습니다.",
