        "term": [
            {
                "speaker_id": "1",
                "transcription": "정말로 끝난 것이 아니라 여러분들이 현 시대 미래를 보게 될 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.227
            },
            {
                "speaker_id": "1",
                "transcription": "저희에게 기회를 주시면 그 보답을 지하철로 도로로 병원으로 그리고 한 번 다시 돌려드리겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.237,
                "end": 12.941
            },
            {
                "speaker_id": "2",
                "transcription": "오세훈 서울 시장 후보는 이곳 서울 청계 광장을 마지막 유세지로 택했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.951,
                "end": 17.822
            },
            {
                "speaker_id": "2",
                "transcription": "이번 선거에서 구청장과 시구 의회 권력도 함께 교체해야 발목 잡히지 않고 일할 수 있다며 지지를 호소했습니다.",
                "sound_type": [
                    2,
