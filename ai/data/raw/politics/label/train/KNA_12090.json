        "term": [
            {
                "speaker_id": "1",
                "transcription": "더불어민주당과 비례대표용 정당인 더불어시민당 첫 회의 나란히 앉아 더불어 한 집안임을 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.622
            },
            {
                "speaker_id": "2",
                "transcription": "더불어시민당은 민주당의 정신과 뿌리를 공유하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.632,
                "end": 12.877
            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 승리를 끄는 말이고 시민당는 승리를 싣는 수레입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.887,
                "end": 17.422
            },
            {
                "speaker_id": "1",
                "transcription": "미래통합당과 비례대표용 정당 미래한국당도 마찬가지",
                "sound_type": [
                    2
                ],
                "start": 17.432,
                "end": 22.497
            },
            {
                "speaker_id": "1",
                "transcription": "바꿔야 산다 바꿔야 미래가 있다 슬로건에 선거 운동복도 맞췄습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.507,
                "end": 28.119
            },
            {
                "speaker_id": "3",
                "transcription": "미래통합당과 미래한국당",
                "sound_type": [
