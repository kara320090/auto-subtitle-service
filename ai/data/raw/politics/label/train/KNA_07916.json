        "term": [
            {
                "speaker_id": "1",
                "transcription": "민관 협의회 첫 회의는 외교부 1차관 주재로 비공개로 열렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.491
            },
            {
                "speaker_id": "1",
                "transcription": "강제징용 피해자 대리인과 일본 관련 전문가 등 열두 명이 참석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.501,
                "end": 9.907
            },
            {
                "speaker_id": "1",
                "transcription": "외교부 관계자는 충분히 의견을 듣는 자리였으며 오늘 회의에서 구체적인 해법이 논의되지는 않았다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.917,
                "end": 17.645
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 피해자들이 고령이고 일본 기업 자산 현금화라는 무시할 수 없는 상황이 있는 만큼 긴장감과 속도감을 갖고 진행하겠다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.655,
                "end": 27.587
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 다음 달까지 서너차례 더 회의를 진행한 뒤 정부안을 도출할 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 27.597,
                "end": 33.633
            }
        ]
    },
    "summary": "강제징용 피해자 대리인과 일본 관련 전문가 등 열두 명이 참석한 민관 협의회 첫 회의는 외교부 1차관 주재로 비공개로 열렸으며 정부는 다음 달까지 서너차례 더 회의를 진행한 뒤 정부안을 도출할 것으로 보입니다.",
