        "term": [
            {
                "speaker_id": "1",
                "transcription": "청와대와 조율된 것이라고 검찰은 의심하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.261
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 환경부 블랙리스트 사건 재판에서 청와대와 부처 간 연결 고리를 입증했던 검찰은 이번에도 관련 근거 자료들을 확보한 것으로 전해졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.271,
                "end": 13.286
            },
            {
                "speaker_id": "1",
                "transcription": "일각에선 검찰이 조현옥 당시 청와대 인사 수석까지 소환할 거란 전망도 나오고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.296,
                "end": 19.442
            },
            {
                "speaker_id": "1",
                "transcription": "이르면 오늘 밤 결정될 백 전 장관의 구속 여부가 수사의 향방을 가를 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.452,
                "end": 24.954
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 서울 동부 지법에서 전해드렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.964,
                "end": 29.124
            },
            {
                "speaker_id": "2",
                "transcription": "한편 민주당 박상혁 의원은 자신에 대한 검찰 수사에 대해",
                "sound_type": [
                    2
                ],
                "start": 29.134,
                "end": 33.500
            }
        ]
    },
    "summary": "환경부 블랙리스트 사건 재판에서 청와대와 부처 간 연결 고리를 입증했던 검찰이 이번에도 관련 근거 자료들을 확보한 것으로 전해졌고 일각에선 당시 청와대 인사 수석까지 소환할 거란 전망도 나오고 있다며 오늘 밤 결정될 백 전 장관의 구속 여부가 수사의 향방을 가를 것으로 보인다고 기자는 보도했다.",
