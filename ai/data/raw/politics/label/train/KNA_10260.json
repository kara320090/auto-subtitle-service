        "term": [
            {
                "speaker_id": "1",
                "transcription": "유족 명단 관련 위증 의혹까지 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.090
            },
            {
                "speaker_id": "1",
                "transcription": "대통령은 즉각 @이름1 장관을 파면하기 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 3.100,
                "end": 7.888
            },
            {
                "speaker_id": "2",
                "transcription": "앞서 해임 건의안 통과에 이어 탄핵을 추진할 뜻도 보였습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.898,
                "end": 12.970
            },
            {
                "speaker_id": "2",
                "transcription": "진상 규명 후 책임을 묻겠다는 대통령의 말과 정치적 부담까지 고려해 밀어 왔지만 이제 더 이상 기다릴 수 없다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 12.980,
                "end": 21.683
            },
            {
                "speaker_id": "3",
                "transcription": "경찰 수사 끝나고 국정 수사 끝나면 물론 그냥 줬습니다마는 안 된다면 탄핵이라도 되면 할 수밖에 없는 상황으로 갈 것이다.",
                "sound_type": [
                    2
                ],
                "start": 21.693,
                "end": 28.729
            },
            {
                "speaker_id": "2",
                "transcription": "이런 가운데 윤석열 대통령은 어제 국무 회의에서 당분간 개각은 없다는 뜻을 밝힌 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.739,
                "end": 36.291
            },
            {
                "speaker_id": "2",
                "transcription": "연초 개각설엔 장관들이 흔들리지 말고 소신껏 일해 달라는 취지였는데",
