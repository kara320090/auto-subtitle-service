        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰 검찰의 수사는 국민의 뜻이라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.157
            },
            {
                "speaker_id": "2",
                "transcription": "일단 경찰 수사 그리고 송치 받은 후에 신속한 검찰 수사에 의한 진상 규명이 국민들께서 에 더 바라시고 계시지 않나 이렇게 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.167,
                "end": 19.547
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 여론 조사에서는 진행 중인 경찰 수사와 상관없이 국정 조사를 해야 한다는 응답이 43점 1퍼센트였습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.557,
                "end": 27.207
            },
            {
                "speaker_id": "1",
                "transcription": "반면 수사를 지켜본 뒤 결정해야 한다는 33점 3퍼센트로 나타났습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.217,
                "end": 32.941
            },
            {
                "speaker_id": "1",
                "transcription": "국정 조사가 필요 없다는 응답은 19점 5퍼센트였습니다.",
