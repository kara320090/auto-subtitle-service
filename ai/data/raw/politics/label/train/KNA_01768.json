        "term": [
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 강푸름입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.930
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 힘 윤석열 후보가 국민의 당 안철수 후보와의 단일화 협상 과정을 세세히 공개했습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.940,
                "end": 9.839
            },
            {
                "speaker_id": "2",
                "transcription": "협상이 잘 돼왔는데도 안 후보 측이 결렬을 선언했다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 9.849,
                "end": 14.293
            },
            {
                "speaker_id": "2",
                "transcription": "이에 대해선 안 후보는 자신의 제안이 무시당했다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.303,
                "end": 18.598
            },
            {
                "speaker_id": "2",
                "transcription": "양측 책임 공방을 벌이는 모습인데요.",
                "sound_type": [
                    2
                ],
                "start": 18.608,
                "end": 21.399
            },
            {
                "speaker_id": "2",
                "transcription": "이 내용 강병수 기자가 보도합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.409,
                "end": 23.733
            },
            {
                "speaker_id": "3",
                "transcription": "국민의 힘 윤석열 후보는 어제 안철수 후보 측으로부터 단일화 결렬을 최종 통보받았다고 밝혔습니다.",
                "sound_type": [
                    2,
