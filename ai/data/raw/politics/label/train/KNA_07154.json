        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난해 7월 여야는 박병석 국회의장 중재로 원 구성 합의를 도출했습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 0.000,
                "end": 5.730
            },
            {
                "speaker_id": "2",
                "transcription": "교섭단체 의석 수에 따라하되 법제사법위원장은 국민의힘에서 맡는다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.740,
                "end": 13.947
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 민주당이 이 합의를 뒤집고 후반기 상임위원장 배분을 다시 논의하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.957,
                "end": 20.516
            },
            {
                "speaker_id": "1",
                "transcription": "전임 원내지도부가 아직 열리지도 않은 후반기 원 구성을 합의한 건 월권이다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.526,
                "end": 26.310
            },
            {
                "speaker_id": "1",
                "transcription": "사실상 상원 노릇을 했던 법사위 권한을 대폭 줄이기로 했지만 합의를 먼저 파기한 건 국민의힘이라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.310,
                "end": 34.267
            }
        ]
    },
    "summary": "지난해 여야는 법제사법위원장은 국민의힘에서 맡는다는 합의를 도출했지만, 민주당이 이 합의를 뒤집고 다시 논의하겠다고 밝혔다.",
