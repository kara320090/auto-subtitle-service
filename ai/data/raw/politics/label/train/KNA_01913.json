        "term": [
            {
                "speaker_id": "1",
                "transcription": "정가에서는 김경수 전 경남 지사의 동시 사면 가능성도 언급되고 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.434
            },
            {
                "speaker_id": "1",
                "transcription": "안다영 기자가 보도합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.444,
                "end": 7.844
            },
            {
                "speaker_id": "2",
                "transcription": "이명박 전 대통령에 대한 특별 사면이 이루어진다면 5월 8일 부처님 오신 날이 될 거란 관측이 상당합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.854,
                "end": 15.155
            },
            {
                "speaker_id": "2",
                "transcription": "문재인 대통령 퇴임 하루 전이자 새 대통령 취임 직전이라 국민 통합 명분이 되지 않겠냐는 관측입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.165,
                "end": 22.334
            },
            {
                "speaker_id": "2",
                "transcription": "관건은 사면권을 가진 문 대통령의 의중입니다.",
                "sound_type": [
                    2,
                    5
