        "term": [
            {
                "speaker_id": "1",
                "transcription": "지자체 간 공동 협력 모델인 특별 지자체의 성공 여부도 관건입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.641
            },
            {
                "speaker_id": "1",
                "transcription": "이미 첫 특별 지자체인 부울경 특별연합이 설치됐고 경기 남부 충청권 등도 설립을 추진 중인데 제 역할을 하려면 목적부터 명확해야 한다는 지적이 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 4.651,
                "end": 16.457
            },
            {
                "speaker_id": "1",
                "transcription": "지방의회는 인사권 독립과 정책 지원 간 도입 등으로 권한은 커졌지만 1년에 조례 한 건 발의하지 않는 기초 의원이 25퍼센트 가까이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 16.467,
                "end": 26.732
            },
            {
                "speaker_id": "1",
                "transcription": "지난 해 48.7퍼센트까지 떨어진 전국 지자체의 재정자립도도 문젭니다.",
                "sound_type": [
                    2
                ],
                "start": 26.742,
                "end": 32.453
            },
            {
                "speaker_id": "1",
                "transcription": "인건비도 충당 못하는 지자체가 4분의 1을 넘습니다.",
