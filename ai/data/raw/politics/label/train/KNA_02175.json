        "term": [
            {
                "speaker_id": "1",
                "transcription": "이른바 한국형 FBI가 출범하면 완전 폐지하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.166
            },
            {
                "speaker_id": "1",
                "transcription": "중수청은 여야가 구성할 사법개혁특별위원회에서 논의됩니다.",
                "sound_type": [
                    2
                ],
                "start": 4.176,
                "end": 8.891
            },
            {
                "speaker_id": "1",
                "transcription": "특위 구성 후 6개월 내 입법을 완료하고 1년 이내 발족시키는 등 출범 시한도 못 박았습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.901,
                "end": 15.762
            },
            {
                "speaker_id": "1",
                "transcription": "여야가 합의한 만큼 특위 구성엔 시간이 오래 걸리지 않을 전망 1년 6개월 안에는 중수청이 출범할 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.772,
                "end": 24.517
            },
            {
                "speaker_id": "1",
                "transcription": "쟁점이었던 검찰의 보완 수사 건은 남게 됐는데 별건 수사 금지로 이를 제한했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.527,
                "end": 31.124
            },
            {
                "speaker_id": "1",
                "transcription": "여야의 핵심 요구를 사실상 절충한 것으로 평가됩니다.",
                "sound_type": [
                    2
                ],
                "start": 31.134,
                "end": 35.129
            },
            {
                "speaker_id": "2",
                "transcription": "기소권과 수사권이 이번에는 반드시 분리되어야 한다라고 하는 원칙을 강하게 우리가 주장했고",
                "sound_type": [
                    2
                ],
                "start": 35.139,
                "end": 44.142
            },
            {
                "speaker_id": "3",
                "transcription": "검찰이 갖고 있는 보완 수사권은 그대로 유지가 되고 그거는 소멸될 수가 없는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 44.152,
                "end": 49.842
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 특수수사를 맡는 반부패강력부도 5개에서 3개로 줄이기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 49.852,
                "end": 55.573
            },
            {
                "speaker_id": "1",
                "transcription": "역시 검찰 직접 수사에 총량을 줄여간다는 취지입니다.",
                "sound_type": [
                    2
                ],
                "start": 55.583,
                "end": 60.093
            }
        ]
    },
