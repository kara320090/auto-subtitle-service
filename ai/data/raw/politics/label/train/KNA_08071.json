                    2
                ],
                "start": 0.000,
                "end": 6.424
            },
            {
                "speaker_id": "2",
                "transcription": "소득이 적으신 분이 세금을 적게 내기 때문에 당 당연히 그 세수 감면 절대 금액은 적지만은 그 감소 폭은 저소득층일수록 훨씬 더 크다.",
                "sound_type": [
                    2
                ],
                "start": 6.434,
                "end": 18.114
            },
            {
                "speaker_id": "1",
                "transcription": "내는 세금이 적어 혜택도 적다.",
                "sound_type": [
                    2
                ],
                "start": 18.124,
                "end": 20.775
            },
            {
                "speaker_id": "1",
                "transcription": "다른 감면 제도도 많다는 건데 신용 카드 공제나 연금 공제 등 다른 혜택들도 소비와 저축 여력이 있는 사람들 위주 아니냐는 비판은 계속됩니다.",
                "sound_type": [
                    2
