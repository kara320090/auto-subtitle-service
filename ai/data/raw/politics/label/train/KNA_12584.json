        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 정부가 가진 땅의 아파트를 짓기 때문에 토지 보상금이 별도로 필요없어서 주택 공급의 속도를 낼 수 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.713
            },
            {
                "speaker_id": "1",
                "transcription": "토지 보상금이 부동산 시장으로 흘러 들어갈 가능성 역시 낮아서",
                "sound_type": [
                    2
                ],
                "start": 9.723,
                "end": 14.848
            },
            {
                "speaker_id": "2",
                "transcription": "이런 기존의 공급대책 외에 추가로 논의될 수 있는 건 서울 재건축 규제 완화입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.858,
                "end": 20.751
            },
            {
                "speaker_id": "2",
                "transcription": "그린벨트 해제 대신 관련 정비 사업에 속도를 내겠다고 밝힌 서울시는 특정 아파트를 거론할 수는 없지만 재건축 규제 완화를 주택 공급 대책의 하나로 검토하고 있다고 밝혔습니다.",
                "sound_type": [
