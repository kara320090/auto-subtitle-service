        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘에서도 사회 복지 분야 마인드 부족이 아쉽다는 말이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.598
            },
            {
                "speaker_id": "2",
                "transcription": "아쉽게도 여기에 대해서 경력이라든가 그런 걸 봤을 때 확인이 제대로 안 돼요.",
                "sound_type": [
                    2
                ],
                "start": 5.608,
                "end": 11.601
            },
            {
                "speaker_id": "2",
                "transcription": "어디 가서 봉사 활동을 했다든가 민간 민간 복지 단체 활동을 했다든가 뭐 기부금을 냈다든가 이런 부분들이 거의 어 눈에 안 보여서.",
                "sound_type": [
                    2
                ],
                "start": 11.611,
                "end": 22.484
            },
            {
                "speaker_id": "3",
                "transcription": "사회 복지 분야에 큰 관심과 노력 기울이겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.494,
                "end": 25.801
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인과 1년에 두어 번 만났을 뿐 40년 지기는 아니라고 말했습니다.",
                "sound_type": [
                    2
