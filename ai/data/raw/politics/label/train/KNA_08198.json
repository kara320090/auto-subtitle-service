        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령에게 예 보고하고 승인받았다는 것은 사실상 대통령이 국정원의 국내 정치 개입을 허용했다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 8.765
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이렇게 보기 때문에",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.775,
                "end": 10.014
            },
            {
                "speaker_id": "2",
                "transcription": "@소속1은 전직 국정원장들의 직권남용 혐의가 본질이라며 호도하지 말라고 반박했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.024,
                "end": 16.898
            },
            {
                "speaker_id": "3",
                "transcription": "대통령실 기획 지시 운운하며 진실을 호도하고 있다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.908,
                "end": 22.539
            },
            {
                "speaker_id": "3",
                "transcription": "이는 침소봉대를 넘은 허위사실 유포이며 무책임한 정치 공세이다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.549,
                "end": 29.391
            },
            {
                "speaker_id": "2",
                "transcription": "대통령실도 야당의 주장은 사실이 아니라면서도 국정원장의 보고 시점은 정확히 공개하기 어렵다고 밝혔습니다.",
                "sound_type": [
