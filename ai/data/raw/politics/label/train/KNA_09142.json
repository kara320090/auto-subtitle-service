        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘 주최로 열린 국회 토론회.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.409
            },
            {
                "speaker_id": "1",
                "transcription": "MBC가 특정 정파를 위해 오류와 조작 편파 보도를 한다며 발언을 이어갑니다.",
                "sound_type": [
                    2
                ],
                "start": 2.419,
                "end": 7.864
            },
            {
                "speaker_id": "2",
                "transcription": "재탄생되지 않으면 이거 방송으로서의 의미가 없다.",
                "sound_type": [
                    2
                ],
                "start": 7.874,
                "end": 11.572
            },
            {
                "speaker_id": "2",
                "transcription": "사회의 공기가 아니라 사회의 흉기입니다.",
