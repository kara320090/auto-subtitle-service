        "term": [
            {
                "speaker_id": "1",
                "transcription": "개표 초반부터 국민의 힘 김은혜 후보가 앞서 나가고 더불어 민주당 김동현 후보가 뒤를 쫓는 양상이 이어졌는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.920
            },
            {
                "speaker_id": "1",
                "transcription": "표차를 계속 줄여나가던 김동현 후보가 개표 막판에 결국 역전에 성공했고 종료 직전 마침내 긴 승부의 종지부를 찍었습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.930,
                "end": 15.502
            },
            {
                "speaker_id": "1",
                "transcription": "보도에 방준원 기자입니다.",
