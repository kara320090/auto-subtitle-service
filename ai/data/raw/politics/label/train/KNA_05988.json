        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 싫어한다는 분들 말을 안 하니까 알 수가 없잖아요 그죠?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.602
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 정치인들이 그런 함정에 많이 빠지죠.",
                "sound_type": [
                    2
                ],
                "start": 3.612,
                "end": 6.784
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 우호적인 사람만 주변에 모이니까 착각하지 않도록 노력해야죠.",
                "sound_type": [
                    2
                ],
                "start": 6.794,
                "end": 13.556
            },
            {
                "speaker_id": "2",
                "transcription": "서울은 대선의 당락의 핵심 지역인 데다 얼마 전까지 여론 조사에서 윤석열 후보가 우위이던 지역 이 후보는 서울을 필수 고지라고 표현했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.566,
                "end": 24.065
            },
            {
                "speaker_id": "1",
                "transcription": "서울에서 이기지 못하면 전체 선거에서 이기기 쉽지가 않다.",
                "sound_type": [
                    2
                ],
                "start": 24.075,
                "end": 29.499
            },
            {
                "speaker_id": "1",
                "transcription": "상황이 매우 나빴지만 이제는 다시 또 우리 국민들께서 새로운 기대를 조금씩 회복해 주시는 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.509,
