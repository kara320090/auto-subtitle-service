        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 어제 다 말씀을 드렸고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.039
            },
            {
                "speaker_id": "2",
                "transcription": "서두르는 건 지지율에서 밀리는 안 후보 쪽입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.049,
                "end": 5.852
            },
            {
                "speaker_id": "2",
                "transcription": "안 후보가 제안한 여론 조사 방식은 지난 서울시장 보궐 선거 단일화 협상 때 양당이 합의한 방식이라며 통 큰 승부를 해 보자고 압박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.862,
                "end": 16.099
            },
            {
                "speaker_id": "3",
                "transcription": "안철수 후보가 진 방식으로 하자는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 16.109,
                "end": 18.922
            },
            {
                "speaker_id": "3",
                "transcription": "그 방식에 대한 게 지금 역선택 뭐 자꾸 이야기하는데 역선택 방지 조항이 없는 게 국민의힘의 방식이고요.",
                "sound_type": [
                    2
                ],
                "start": 18.932,
                "end": 26.216
            },
            {
                "speaker_id": "2",
                "transcription": "2 3일이라는 구체적인 시한도 제시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.226,
                "end": 29.419
            },
            {
                "speaker_id": "4",
                "transcription": "윤석열 후보의 답변을 기다리고 있는 중입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.429,
                "end": 33.180
            },
            {
                "speaker_id": "4",
                "transcription": "진정성이 있으시다면 저는 그 제안을 수용하실 거라고 그렇게 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 33.190,
                "end": 39.806
            }
        ]
    },
