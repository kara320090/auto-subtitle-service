            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "출근길 윤석열 대통령은 장관을 추가로 임명하겠다는 뜻을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.475
            },
            {
                "speaker_id": "2",
                "transcription": "혹시 오늘 청문보고서가 채택 안 된 장관도 임명하실 계획 있으십니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.485,
                "end": 9.417
            },
            {
                "speaker_id": "3",
                "transcription": "글쎄 오늘 일부만.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.427,
                "end": 13.034
            },
            {
                "speaker_id": "1",
                "transcription": "1 시간 만에 외교부 박진 행정안전부 @이름1 장관이 임명됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.044,
                "end": 18.337
            },
            {
                "speaker_id": "1",
                "transcription": "대통령실 핵심 관계자는 국정 공백이 없는 게 가장 중요하다며 청문보고서 없이 임명한 이유를 설명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.347,
                "end": 26.018
            },
            {
                "speaker_id": "1",
                "transcription": "역시 청문보고서가 채택되지 않은 장관 후보자 3 명의 임명은 아직 고심 중 대통령실 관계자는 서둘러 갈 필요가 있느냐 강대강 국면으로 갈 필요는 없다는 게 대통령실 기류라고 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.028,
                "end": 39.645
            },
            {
                "speaker_id": "1",
                "transcription": "한덕수 총리 후보자 인준 방침을 아직 확정하지 않은 민주당을 굳이 자극하지 않겠다는 계산으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 39.655,
                "end": 47.205
            },
            {
                "speaker_id": "1",
                "transcription": "새 정부 장관이 9 명 밖에 임명되지 않은 상황에서 문재인 정부 장관 2 명이 참석한 가운데 첫 국무회의가 열렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.215,
                "end": 56.013
            },
            {
                "speaker_id": "1",
                "transcription": "당초 15 명 이상이 참석해야 열리는 것으로 알려진 것과 달리 11 명 이상 참석으로 국무회의 개의가 가능하다는 법제처 유권 해석에 따른 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 56.023,
                "end": 66.453
            },
            {
                "speaker_id": "1",
                "transcription": "안건은 59조 4000억 원 규모의 코로나19 손실 보상 추경안 윤 대통령은 방역으로 발생한 국민 손실을 보상하는 건 국가의 의무라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 66.463,
                "end": 77.461
            },
            {
                "speaker_id": "3",
                "transcription": "국민의 재산권 행사를 제한하고 에 손실 보상을 에 제대로 해주지 않는다면 에 진정한 법치국가라고 보기 어렵습니다.",
                "sound_type": [
                    2
                ],
                "start": 77.471,
                "end": 88.388
            }
        ]
    },
    "summary": "윤석열 대통령은 장관을 추가로 임명하겠다는 뜻을 밝혔고 대통령실 관계자는 국정 공백이 없는 게 가장 중요하다며 청문보고서 없이 임명한 이유를 설명했으며 첫 국무회의 안건은 코로나19 손실 보상 추경안으로 윤 대통령은 방역으로 발생한 국민 손실을 보상하는 건 국가의 의무라고 밝혔다고 기자는 보도했다.",
