        "term": [
            {
                "speaker_id": "1",
                "transcription": "여당이 위원장인 국회 법사위를 우회해 특검 법안을 본 회의에 올리려면 민주당 169석에 11석이 더 필요한 상황 6석의 정의당은 특검 논의보단 검찰 수사가 먼저라는 입장을 거듭 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 14.021
            },
            {
                "speaker_id": "1",
                "transcription": "다만 수사가 미진하면 입법부가 나설 수밖에 없다며 여지를 남겼습니다.",
                "sound_type": [
                    2
                ],
