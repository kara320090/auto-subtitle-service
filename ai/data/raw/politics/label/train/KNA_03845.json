        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난해 8월 무릎을 꿇고 사죄했던 김종인 전 비대 위원장에 이어 공식 석상에서 다시 희생자에 대한 사죄를 밝힌 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.280
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 그리고 그 전신 정당까지 해서 두 번째 공식 사과입니다.",
                "sound_type": [
                    2
                ],
                "start": 8.290,
                "end": 13.304
            },
            {
                "speaker_id": "1",
                "transcription": "당 외연 확장을 노린 행보이고 또 김종인 전 위원장 이후에도 당의 입장이 바뀌지 않았다는 점을 내보이려는 행보로 보입니다.",
                "sound_type": [
