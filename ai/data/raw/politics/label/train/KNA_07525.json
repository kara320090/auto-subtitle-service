        "term": [
            {
                "speaker_id": "1",
                "transcription": "사망 신고가 20년이나 늦은데다 입대 당시 주소도 불명확해 그간 가족을 찾지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.908
            },
            {
                "speaker_id": "2",
                "transcription": "그 굉장히 찾으려고 노력을 많이 했어요.",
                "sound_type": [
                    2
                ],
                "start": 6.918,
                "end": 9.289
            },
            {
                "speaker_id": "2",
                "transcription": "나라에서 책임져줘야 할 일인데 엄마가 다 그 무난 고난의 세월을 다 겪고 견뎠잖아요.",
                "sound_type": [
                    2
                ],
                "start": 9.299,
                "end": 15.818
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 김용석 할아버지의 동생에 대한 마지막 기억은 50여년 전 입대하던 모습입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.828,
                "end": 22.204
            },
            {
                "speaker_id": "1",
                "transcription": "사망 시점을 알지 못해 사찰에서 제사만 지내다가 이제서야 위패를 모셨습니다.",
                "sound_type": [
