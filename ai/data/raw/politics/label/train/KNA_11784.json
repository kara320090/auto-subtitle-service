        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "첫 번째 변수는 바뀐 선거젭니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.749
            },
            {
                "speaker_id": "1",
                "transcription": "당장 정의당이 10석 넘게 약진이 점쳐집니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.759,
                "end": 6.602
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 두 거대 정당이 실제로 위성정당을 만든다면 연동형 비례제 취지가 무력화될 수도 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.612,
                "end": 14.323
            },
            {
                "speaker_id": "1",
                "transcription": "한국당은 비례정당을 만들겠다고 여러 차례 공언한 상탭니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.333,
                "end": 19.049
            },
            {
                "speaker_id": "2",
                "transcription": "그것이 다 만들어진다면 사실 그 이 선거제도는 실패로 끝나고 코메디 같은 것이 되고 또 진보 정당의 공간이 늘 10 그렇게 돼 있지만 별로 그렇게 안 들리겠죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.059,
                "end": 29.095
            },
            {
                "speaker_id": "1",
                "transcription": "투표 연령 하향으로 투표가 가능해진 18살 50만 유권자의 표심도 주목됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 29.105,
                "end": 36.001
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째 변수 통합입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.011,
                "end": 38.260
            },
            {
                "speaker_id": "1",
                "transcription": "역대 선거 대부분 뭉치면 이기고 흩어지면 졌습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 38.270,
                "end": 42.742
            },
            {
                "speaker_id": "1",
                "transcription": "지난해 창원 성산 보궐선거 민주 정의 단일 후보가 한국당 후보를 단 504표 차이로 이겼습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 42.752,
                "end": 50.827
            },
            {
                "speaker_id": "1",
                "transcription": "대한 애국 한국 단일 후보였다면 결과 장담할 수 없었을 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 50.837,
                "end": 56.033
            }
        ]
    },
    "summary": "첫 번째 변수는 바뀐 선거제로 두 거대 정당이 실제로 위성정당을 만든다면 연동형 비례제 취지가 무력화될 수도 있고 투표가 가능해진 18살 50만 유권자의 표심도 주목되며 두 번째 변수 통합으로 지난해 창원 성산 보궐선거 민주 정의 단일 후보가 한국당 후보를 단 504표 차이로 이긴 것처럼 역대 선거 대부분 뭉치면 이기고 흩어지면 졌다.",
