                ],
                "start": 0.000,
                "end": 6.889
            },
            {
                "speaker_id": "2",
                "transcription": "여러분의 그 마음을 잃지 않고 얻기 위해 노력하는 그 선거 운동하는 그 마음으로 끝까지 직을 수행하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.899,
                "end": 19.702
            },
            {
                "speaker_id": "1",
                "transcription": "구미 산업 단지에선 기업인들을 만나 규제 완화를 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.712,
                "end": 24.470
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 중앙 정부고 지방 정부고 불필요한 규제를 싹 풀어야 돼 그래야 사업을 하지",
                "sound_type": [
