        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "태풍 권역에 우리 마당이 들어와 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.055
            },
            {
                "speaker_id": "1",
                "transcription": "정당의 정치적 승리를 입에 담을 그런 상황이 아닙니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.055,
                "end": 10.135
            },
            {
                "speaker_id": "2",
                "transcription": "윤 대통령은 어제 대변인을 통해서도 이번 지방 선거 결과는 경제를 살리고 민생을 더 잘 챙기라는 국민의 뜻으로 받아들인다며 민생에 집중하겠다는 뜻을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.135,
                "end": 22.235
            },
            {
                "speaker_id": "2",
                "transcription": "협치를 위해 야당 지도부와 만날 계획에 대해서는 어려움을 헤쳐 나가는데 여야가 따로 있겠느냐고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.245,
                "end": 29.529
            },
            {
                "speaker_id": "2",
                "transcription": "야당 지도부와의 회동 가능성을 내비친 건데 야당 지도부가 전원 사퇴한 상황을 고려하면 시기는 빨라야 이달 말쯤으로 예상됩니다.",
                "sound_type": [
                    2
                ],
                "start": 29.539,
                "end": 39.299
            },
            {
                "speaker_id": "2",
                "transcription": "윤 대통령은 새로 선출된 광역 자치 단체장들과의 만남에 대해서도 단체장들이 취임한 뒤 시도 현안이나 재정 상황 등을 점검하고 만나는 게 의미 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.309,
                "end": 50.714
            },
            {
                "speaker_id": "2",
                "transcription": "일단은 물가와 규제 개혁 등 경제 문제에 집중하고 야당이나 단체장들과의 현안 조율은 서두르지 않겠다는 뜻으로 풀이됩니다.",
                "sound_type": [
                    2
                ],
                "start": 50.724,
                "end": 59.483
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 강병수입니다.",
                "sound_type": [
                    2
                ],
                "start": 59.493,
                "end": 62.067
            },
            {
                "speaker_id": "3",
                "transcription": "선거 참패의 책임을 지고 지도부가 총사퇴한 민주당은 수습책 논의에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 62.077,
                "end": 69.175
            },
            {
                "speaker_id": "3",
                "transcription": "당 쇄신과 새 비대위 구성 방안 등을 놓고 토론이 이어졌는데요.",
                "sound_type": [
                    2
                ],
                "start": 69.185,
                "end": 73.595
            },
            {
                "speaker_id": "3",
                "transcription": "어떤 방안이 나왔는지 손서영 기자가 전합니다.",
                "sound_type": [
                    2
                ],
                "start": 73.605,
                "end": 76.409
            }
        ]
    },
    "summary": "윤 대통령은 이번 지방 선거 결과는 경제를 살리고 민생을 더 잘 챙기라는 국민의 뜻으로 받아들인다고 전했고 선거 참패의 책임을 지고 지도부가 총사퇴한 민주당은 수습책 논의에 나섰습니다.",
