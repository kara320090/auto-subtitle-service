        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 날이 밝을 때까지도 군의 별다른 공지는 없어 주민들은 밤잠을 설쳐야 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.686
            },
            {
                "speaker_id": "2",
                "transcription": "재난 문자도 안 오고 계속 그래가지고 한 새벽 3시까지는 못 잤던 거 같애요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.696,
                "end": 10.451
            },
            {
                "speaker_id": "2",
                "transcription": "아무 소식도 못 듣고 계속 그냥 기사 뜨기를 계속 기다렸어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.461,
                "end": 14.851
            },
            {
                "speaker_id": "1",
                "transcription": "어제 오후 인천 강화도 일대에서도 북한에서 넘어온 미상 흔적에 대응해 공군 전력이 출동했는데 새 떼로 확인됐습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.861,
                "end": 23.378
            },
            {
                "speaker_id": "1",
                "transcription": "북한 무인기의 영공 침범 이후 이틀 연속 오인 소동이 벌어지면서 주민들의 불안감은 쉽게 가시지 않고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
