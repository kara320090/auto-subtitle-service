            },
            {
                "speaker_id": "2",
                "transcription": "윤 후보는 이재명 후보가 밝힌 네거티브 중단 선언에는 네거티브와 검증은 다르다면서도 긍정적으로 본다고 평가했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.312,
                "end": 11.932
            },
            {
                "speaker_id": "1",
                "transcription": "네거티브 당과 또 그 지지 세력들에 의해서 수도 없이 하지 않았습니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.942,
                "end": 20.286
            },
            {
                "speaker_id": "2",
                "transcription": "그러나 국민의 힘 당 차원에서는 네거티브 중단이 아니라 특검부터 수용하라는 반응이 나왔습니다.",
