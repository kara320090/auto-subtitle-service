        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "중앙선거관리위원회가 정당 명에 비례 명칭을 사용할 수 없다고 결정했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.777
            },
            {
                "speaker_id": "1",
                "transcription": "선관위는 신규 당명은 기존 당 이름과 뚜렷이 구별돼야 한다며 결정 이유를 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.787,
                "end": 12.272
            },
            {
                "speaker_id": "1",
                "transcription": "기존 당 이름에 비례 단어만 붙인 당명은 유권자를 혼란하게 해 국민의 정치적 의사를 왜곡할 수 있다는 설명입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.282,
                "end": 20.755
            },
            {
                "speaker_id": "1",
                "transcription": "또 이런 형식의 당명을 허용하면 무분별한 정당 명칭 선정으로 선거 질서가 훼손될 수 있다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.765,
                "end": 28.294
            },
            {
                "speaker_id": "1",
                "transcription": "이번 결정으로 자유한국당의 위성정당인 비례자유한국당은 당명을 바꿔야 창당이 가능합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.304,
                "end": 35.314
            },
            {
                "speaker_id": "1",
                "transcription": "위성정당 창당 작업을 주도한 한국당 원영섭 사무부총장은 명백한 야당 탄압이자 유권자 선택권을 침해하는 것이라며 강력 반발했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.324,
                "end": 45.412
            },
            {
                "speaker_id": "1",
                "transcription": "원 부총장은 친문 성향인 @이름1 선관위 상임위원 임명 때부터 예고됐던 일이라며 415 총선이 공정하게 관리될 수 있겠느냐고 목소리를 높였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.422,
                "end": 56.344
            },
            {
                "speaker_id": "1",
                "transcription": "현재 선관위의 비례 명칭을 넣어 신고한 창당준비위원회는 비례한국당 비례민주당 비례자유한국당 등 3개입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.354,
                "end": 64.927
            },
            {
                "speaker_id": "1",
                "transcription": "비례자유한국당은 현 한국당의 위성정당이 맞지만 나머지 두 정당은 한국당이나 민주당과 관련이 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.937,
                "end": 72.821
            },
            {
                "speaker_id": "2",
                "transcription": "위성정당은 연동형 비례 대표제의 도입 정신과 취지를 어 밑바닥에서부터 흔드는 퇴행적 정치 행위입니다.",
                "sound_type": [
                    2
                ],
                "start": 72.831,
                "end": 81.826
            },
            {
                "speaker_id": "2",
                "transcription": "선관위 스스로 정권의 하수인임을 자인하는 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 81.836,
                "end": 86.574
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 지난 10일 한국당은 선관위를 항의 방문해 비례자유한국당 명칭 사용을 허가해야 한다고 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 86.584,
                "end": 94.240
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 94.250,
                "end": 96.629
            }
        ]
    },
    "summary": "중앙선거관리위원회가 정당 명에 비례 명칭을 사용할 수 없다고 결정했고 자유한국당의 위성정당인 비례자유한국당 선관위에 방문해 명칭 사용을 허가해야 한다고 촉구했다.",
