        "term": [
            {
                "speaker_id": "1",
                "transcription": "국힘대 건희대 국민학교 논문 위조 맛집 이렇게 불러요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.693
            },
            {
                "speaker_id": "1",
                "transcription": "아세요?",
                "sound_type": [
                    2
                ],
                "start": 5.703,
                "end": 6.480
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1 국민대 총장은 논문을 제대로 검증했다는 입장을 거듭 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.490,
                "end": 11.951
            },
            {
                "speaker_id": "3",
                "transcription": "김건희 여사의 박사학위 논문 그 말 많고 탈 많은 이 논문 읽어보셨습니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.961,
                "end": 17.226
            },
            {
                "speaker_id": "4",
                "transcription": "읽어보지 않았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.220,
                "end": 18.557
            },
            {
                "speaker_id": "3",
                "transcription": "윤리 위원장은 누구입니까?",
                "sound_type": [
                    2
                ],
                "start": 18.567,
                "end": 20.541
            },
            {
                "speaker_id": "4",
                "transcription": "윤리 위원장은 여기서 밝힐 수 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.551,
                "end": 22.985
            },
            {
                "speaker_id": "2",
                "transcription": "숙명여대에 대해선 표절 의혹 조사가 차일피일 미뤄지고 있다는 지적이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.995,
                "end": 28.461
            }
        ]
    },
