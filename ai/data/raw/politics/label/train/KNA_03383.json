        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령한테는 언제 기회를 줍니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.619
            },
            {
                "speaker_id": "2",
                "transcription": "순서가 좀 늦게 오시기를",
                "sound_type": [
                    2
                ],
                "start": 3.629,
                "end": 6.484
            },
            {
                "speaker_id": "3",
                "transcription": "현장 방문 이후엔 SNS를 통해 백신 관리와 보관 접종 등의 과정이 모든 국민에게 신뢰를 주기에 충분했다고 평가했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.494,
                "end": 15.102
            },
            {
                "speaker_id": "3",
                "transcription": "또 일상 회복이 멀지 않았다는 희망의 메시지를 전하면서도 방역의 끈을 팽팽하게 당겨 달라는 당부도 곁들였습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.112,
                "end": 22.856
            },
            {
                "speaker_id": "3",
                "transcription": "정세균 국무총리는 백신 접종 시작과 관련해 집단 면역 형성으로 가는 첫 발걸음이 가볍다고 감회를 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.866,
                "end": 31.018
            },
            {
                "speaker_id": "3",
                "transcription": "정부가 목표로 한 11월 집단 면역 형성을 위해 정부 역량을 집중하겠다며 적인적인 접종 동참을 호소했습니다.",
                "sound_type": [
                    2
