        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당은 윤 대통령이 외교 참사의 최종 책임자인데도 1번도 사과하지 않았다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.482
            },
            {
                "speaker_id": "2",
                "transcription": "누군가 말실수의 화살을 화풀이식으로 언론을 향해 겨누고 진실 규명만 주문했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.492,
                "end": 14.230
            },
            {
                "speaker_id": "2",
                "transcription": "이것이 정상적인 국정 운영이며 이성적인 정치 집단입니까?",
                "sound_type": [
                    2
                ],
                "start": 14.220,
                "end": 18.877
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령의 비속어 논란에 말을 아껴오던 이재명 민주당 대표도 직접 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.880,
                "end": 25.395
            },
            {
                "speaker_id": "1",
                "transcription": "국민도 눈과 귀가 있다며 대통령이 사과해야 한다고 했습니다.",
                "sound_type": [
                    2
