        "term": [
            {
                "speaker_id": "1",
                "transcription": "고인이 된 유한기 전 공사 본부장이 이재명 시장과 정진상 정책 실장 뜻이라며 사퇴를 종용했다는 게 황 전 사장 주장입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.540
            },
            {
                "speaker_id": "2",
                "transcription": "아니 당신 말이 왔다 갔다 하거든 정이라고 그랬다가 유라고 그랬다가",
                "sound_type": [
                    2
                ],
                "start": 9.550,
                "end": 13.417
            },
            {
                "speaker_id": "3",
                "transcription": "정도 그러고 유도 그러고 양쪽 다 했다니까요.",
                "sound_type": [
                    2
                ],
                "start": 13.427,
                "end": 15.661
            },
            {
                "speaker_id": "3",
                "transcription": "왜 그렇게",
                "sound_type": [
                    2
                ],
                "start": 15.671,
                "end": 17.253
            },
            {
                "speaker_id": "2",
                "transcription": "알았어 내가 정리할 테니까.",
                "sound_type": [
                    2
                ],
                "start": 17.263,
                "end": 19.112
            },
            {
                "speaker_id": "1",
                "transcription": "정 부실장은 대장동 의혹 수사 초기 유동규 전 본부장과 여러 차례 전화 통화를 나눈 사실이 드러나기도 했습니다.",
                "sound_type": [
