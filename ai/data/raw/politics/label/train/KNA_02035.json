        "term": [
            {
                "speaker_id": "1",
                "transcription": "오히려 보강할 수 있는 개선안을 주셨으면은 좋겠다 하는 그런 의견을 드렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.596
            },
            {
                "speaker_id": "2",
                "transcription": "간담회가 진행되는 동안 여성단체들은 시위를 벌여 압박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.606,
                "end": 10.223
            },
            {
                "speaker_id": "2",
                "transcription": "안 위원장은 여성단체 협의회와도 면담했는데 청소년 가족 복지정책을 맡는 가족부와 부처별로 양성평등 전담부서를 설치하는 방안을 제안받았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.233,
                "end": 21.310
            },
            {
                "speaker_id": "3",
                "transcription": "최종적인 것은 당선인께서 판단하신다 여러분들 우려하시는 부분들을 한번 잘 담아서 몇 개의 대안을 만들어보겠다",
                "sound_type": [
                    2
                ],
                "start": 21.320,
                "end": 31.577
            },
            {
                "speaker_id": "2",
                "transcription": "여가부에 대안으론 인구가족부 가족복지부 등이 거론됩니다.",
                "sound_type": [
                    2
                ],
                "start": 31.587,
                "end": 36.216
            },
            {
                "speaker_id": "3",
                "transcription": "인수위는 다른 정부조직과 함께 여가부 개편 방향을 결정할 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 36.226,
                "end": 41.341
            }
        ]
    },
    "summary": "간담회가 진행되는 동안 여성단체들은 시위를 벌여 압박했고 안 위원장은 여성단체 협의회와의 면담을 통해 양성평등 전담부서를 설치하는 방안을 제안받았고 인수위는 다른 정부조직과 함께개편방향을 결정할 계획이라고 전했다.",
