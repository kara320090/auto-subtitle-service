        "term": [
            {
                "speaker_id": "1",
                "transcription": "신산업 분야 규제 혁신을 먼저 시작하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.168
            },
            {
                "speaker_id": "2",
                "transcription": "심상정 후보는 녹색 산업에서의 일자리 창출이 특징입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.178,
                "end": 8.922
            },
            {
                "speaker_id": "2",
                "transcription": "재생에너지 저장장치 산업 전기차 등 5대 분야에서 150만 개 일자리를 약속했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.932,
                "end": 16.215
            },
            {
                "speaker_id": "3",
                "transcription": "플랫폼 기업을 중심으로 지금 불완전한 노동이 양산되고 있고 또 수도권에 편중된 디지털 혁신과 그린 노믹스는 질적으로 다릅니다.",
                "sound_type": [
                    2
                ],
                "start": 16.225,
                "end": 27.729
            },
            {
                "speaker_id": "2",
                "transcription": "안철수 후보 디스플레이와 2차 전지 등에서 초격차 기술 확보를 제시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.739,
                "end": 33.642
            },
            {
                "speaker_id": "2",
                "transcription": "기술력을 갖춘 기업을 키우면 협력 업체 등의 일자리 창출로 이어진다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 33.652,
                "end": 39.672
            }
        ]
    },
