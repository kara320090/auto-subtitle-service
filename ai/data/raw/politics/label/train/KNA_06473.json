        "term": [
            {
                "speaker_id": "1",
                "transcription": "부산에서 한 표를 행사한 국민의힘 윤석열 후보 정권 교체 여론에 호소했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.712
            },
            {
                "speaker_id": "2",
                "transcription": "글쎄 사전투표는 새로운 희망을 찾기 위해서는 반드시 해야 된다고 저는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.722,
                "end": 14.163
            },
            {
                "speaker_id": "1",
                "transcription": "부인 김건희 씨는 자택 근처에서 따로 투표했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.173,
                "end": 18.438
            },
            {
                "speaker_id": "1",
                "transcription": "심상정 정의당 후보는 가족 전체가 함께 투표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.448,
                "end": 23.125
            },
            {
                "speaker_id": "1",
                "transcription": "초박빙 판세와 야권 후보 단일화 직후라는 시점 그리고 높은 사전 투표율 이 상황을 두고 여야의 계산 복잡합니다.",
                "sound_type": [
                    2
                ],
                "start": 23.135,
                "end": 32.258
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 유권자가 나왔는지가 관건입니다.",
                "sound_type": [
                    2
