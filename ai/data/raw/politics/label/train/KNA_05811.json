        "term": [
            {
                "speaker_id": "1",
                "transcription": "아울러 안전 운임제 품목 확대 논의를 위한 여야 합의 기구 구성도 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.304
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 즉각 반대 입장을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.314,
                "end": 8.319
            },
            {
                "speaker_id": "1",
                "transcription": "운송 거부로 인한 경제 피해만 3조 5000억 원에 달한다.",
                "sound_type": [
                    2
                ],
                "start": 8.329,
                "end": 12.164
            },
            {
                "speaker_id": "1",
                "transcription": "민주 노총이 경제 손실과 사회적 비용에 대한 책임을 져야 한다며 업무에 복귀한 뒤 본격 논의가 가능하다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.174,
                "end": 19.760
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 이미 오래전에 이 어 100번 양보해서 3년을 연장하겠다고 정부안을 냈습니다. 근데 그것을 걷어찬 것이 바로 어 민노총 화물 연대입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.770,
                "end": 31.197
            }
        ]
    },
    "summary": "안전 운임제 품목 확대 논의를 위한 여야 합의 기구 구성도 제안에 대해 국민의힘은 민주 노총이 경제 손실과 사회적 비용에 대한 책임을 져야 한다며 업무에 복귀한 뒤 본격 논의가 가능하다고 강조했으며 정부가 3년을 연장하겠다고 정부안을 냈었지만 걷어찬 건 민노총 화물 연대라고 밝혔습니다.",
