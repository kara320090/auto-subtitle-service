        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 기본적 삶이 보장되도록",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.580
            },
            {
                "speaker_id": "2",
                "transcription": "또 개헌 필요성을 언급하며 다음 총선에서 개헌 국민투표를 함께 치르자고 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.590,
                "end": 9.026
            },
            {
                "speaker_id": "2",
                "transcription": "국정 연속성을 높이기 위해 5년 단임제 대신 4년 중임제를 도입하자고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.036,
                "end": 15.453
            },
            {
                "speaker_id": "2",
                "transcription": "이 대표의 연설에 민주당 의원들은 박수로 화답했습니다.",
                "sound_type": [
                    2,
                    5
