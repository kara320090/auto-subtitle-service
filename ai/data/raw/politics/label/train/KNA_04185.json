        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 우리가 정권 교체 이루는데 꼭 일조해 주시길 부",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.925
            },
            {
                "speaker_id": "2",
                "transcription": "윤 전 총장은 정권 교체를 위해 헌신하겠다고 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.935,
                "end": 8.347
            },
            {
                "speaker_id": "2",
                "transcription": "상견례 뒤 의원실을 일일이 방문하며 윤 전 총장은 입당 인사를 했지만 없는 사람은 부정 식품이라도 선택할 수 있게 해줘야 한다고 한 보름 전 인터뷰가 뒤늦게 논란이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.357,
                "end": 21.402
            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 물론 같은 당 경쟁자인 유승민 전 의원도 인간다운 생활을 보장한 헌법에 위배된다고 비판했는데 윤 전 총장은 왜곡이라고 반박했습니",
                "sound_type": [
                    2
                ],
                "start": 21.412,
                "end": 31.898
