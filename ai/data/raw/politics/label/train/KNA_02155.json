        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "전국 검찰청 평검사 200여 명이 한자리에 모였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.886
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 수사권 폐지 법안에 반대 의견을 밝히기 위해서인데 기습 파괴 인사 방침에 반발했던 2003회의 이후 19년 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.896,
                "end": 13.614
            },
            {
                "speaker_id": "1",
                "transcription": "비공개로 진행된 회의에선 실제 수사를 담당하는 검사로서 법안이 통과 됐을 때 어떤 문제점이 발생하는지가 중점적으로 논의된 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.624,
                "end": 24.012
            },
            {
                "speaker_id": "2",
                "transcription": "형사 사법 실무자로서 그 실무율령의 곤란함을 여러 웃전에 서로 공유하였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.022,
                "end": 31.839
            },
            {
                "speaker_id": "2",
                "transcription": "이에 전국 각지의 검사들의 동의를 받아 금번 전국 평검사 대표 회의를 개최하게 되었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.849,
                "end": 39.015
            },
            {
                "speaker_id": "1",
                "transcription": "또 검찰 수사의 공정성을 확보하는 방안에 대해서도 논의를 이어갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.025,
                "end": 43.641
            },
            {
                "speaker_id": "3",
                "transcription": "검찰 수사의 공정성과 정치적 중립성이라는 문제에 있어서도 제한을 두지 않고 오늘 어 평검사 대표 회의에서 논의가 이루어질 거 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.651,
                "end": 54.490
            },
            {
                "speaker_id": "1",
                "transcription": "법안의 문제점을 겨냥하는 검찰의 움직임도 바빠지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 54.500,
                "end": 59.273
            },
            {
                "speaker_id": "1",
                "transcription": "대검은 법안의 위헌성을 검토하는 전담 조직을 가동했고 국제 검사 협회에 법안에 문제점 검토를 요청하기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.283,
                "end": 67.734
            }
        ]
    },
    "summary": "전국 평검사 회의는 지난 2003년 이후 19년 만에 열리게 됐고 전국 200여 명의 평검사들이 모인 가운데 검찰 수사의 공정성 정치적 중립성에 대해 논의가 이루어질 것이라고 말했다.",
