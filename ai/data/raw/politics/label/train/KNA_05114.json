                ],
                "start": 14.222,
                "end": 17.292
            },
            {
                "speaker_id": "1",
                "transcription": "국회 국토위 소속 강대식 의원은 전국 17개 시 도와 경찰청에 요청해 어린이 보호 구역 불법 주정차 실태 파악에 착수했습니다.",
                "sound_type": [
