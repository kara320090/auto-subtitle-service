        "term": [
            {
                "speaker_id": "1",
                "transcription": "고용노동부는 기업의 안전 보건 예산을 의무적으로 공시하는 방안을 검토 중인 것으로 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.666
            },
            {
                "speaker_id": "1",
                "transcription": "이달 발표 예정인 중대재해 감축 로드맵에 이 방안이 포함될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.676,
                "end": 12.719
            },
            {
                "speaker_id": "1",
                "transcription": "안전 보건 예산이 공개돼 대기업에 대한 투자 결정 요소로까지 반영된다면 대기업이 좀 더 자발적이고 적극적으로 산업 안전에 투자할 것이라는 게 정부의 판단입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.729,
                "end": 24.347
            },
            {
                "speaker_id": "1",
                "transcription": "고용부는 아울러 다른 기업의 사고 사례를 공개해 사고 예방에 활용할 수 있게 하는 방안도 검토 중입니다.",
                "sound_type": [
                    2
                ],
                "start": 24.357,
                "end": 31.398
            }
        ]
    },
