        "term": [
            {
                "speaker_id": "1",
                "transcription": "주요 공약을 이제 뭐 유권자분들한테 따로 설명을 하신다거나 이런 걸",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.052
            },
            {
                "speaker_id": "2",
                "transcription": "그런 거는 뭐 수 수시로 하고 있지.",
                "sound_type": [
                    2
                ],
                "start": 4.062,
                "end": 6.499
            },
            {
                "speaker_id": "2",
                "transcription": "그걸 뭐 특별히 어디 공개하는 것이 아니라",
                "sound_type": [
                    2
                ],
                "start": 6.509,
                "end": 9.133
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 와 메페스토 실천 본부가 공약 이행도 중간 점검을 위해 보낸 질의서에도 58명은 응답하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.143,
                "end": 17.613
            },
            {
                "speaker_id": "3",
                "transcription": "무관심하거나 답변 여부 공개에 따른 불이익을 크게 신경 쓰지 않아서 일 것이고 그 결정을 의원선에서 이뤄질 수 도 있고 보좌관선에서 이뤄질 수",
