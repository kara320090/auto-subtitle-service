                    3
                ],
                "start": 7.096,
                "end": 13.873
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 경제 부총리 후보자가 물가 안정을 가장 중요한 정책 과제로 꼽은 이유입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.883,
                "end": 20.017
            },
            {
                "speaker_id": "2",
                "transcription": "이 서민 생활 물가를 안정시키는 게 굉장히 급선무다 이렇게 생각합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.027,
                "end": 27.522
            },
            {
                "speaker_id": "2",
                "transcription": "이것이 곧 민생 안정의 첫 출발이다 이렇게 생각하기 때문입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.532,
                "end": 32.338
            },
            {
                "speaker_id": "1",
                "transcription": "문제는 소상공인 지원 등을 위해 추진 중인 추경입니다.",
                "sound_type": [
                    2
                ],
                "start": 32.348,
                "end": 36.286
            },
            {
                "speaker_id": "1",
                "transcription": "수십조 원의 돈이 풀리면 물가 상승을 더 부추길 수 있습니다.",
