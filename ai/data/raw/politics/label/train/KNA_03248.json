        "term": [
            {
                "speaker_id": "1",
                "transcription": "토지주가 개발을 제안하면 LH 등 공공부문이 부지를 확보해 사업을 추진하는 방식이 대표적입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.674
            },
            {
                "speaker_id": "2",
                "transcription": "사업참여를 유도하고 충분한 주택을 공급하기 위해 다양한 인센티브를 부여하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.684,
                "end": 13.140
            },
            {
                "speaker_id": "2",
                "transcription": "용적률 층수 규제 완화 등을 통해 도심 핵심 입지는 고밀로 개발하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.150,
                "end": 20.138
            },
            {
                "speaker_id": "1",
                "transcription": "이를 위해 역세권에 용적률을 최대 700퍼센트까지 높이고 늘어난 용적률에 임대 주택비율은 15퍼센트 수준으로 낮추기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.148,
                "end": 29.376
            },
            {
                "speaker_id": "1",
                "transcription": "지자체 인허가 절차도 축소해 사업기간을 5년 내로 단축한다는 게 국토부 설명입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.386,
                "end": 35.498
            },
            {
                "speaker_id": "1",
                "transcription": "LH 등이 주민 동의를 거쳐 직접 정비 사업에 나서는 새로운 방식도 도입됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 35.508,
                "end": 41.510
            },
            {
                "speaker_id": "1",
                "transcription": "이 경우 재건축 조합원 2년 거주 의무를 적용하지 않고 재건축 초과 이익 부담금도 면제하기로 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 41.520,
                "end": 49.182
            }
        ]
    },
    "summary": "용적률 층수 규제 완화 등을 통해 도심 핵심 입지는 고밀로 개발을 하겠다고 말했고 사업기간을 5년 내도 단축한다는 게 국토부의 설명이며 재건축 조합원 2년 거주 의무를 적용하지 않고 재건축 초과 이익 부담금도 면제하기로 발표했다.",
