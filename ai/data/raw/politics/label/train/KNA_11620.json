        "term": [
            {
                "speaker_id": "1",
                "transcription": "전문위원들은 자산 운용에만 전문가가 필요한 게 아니고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.406
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 여러 가지 이 영역의 전문가가 필요하죠.",
                "sound_type": [
                    2
                ],
                "start": 4.416,
                "end": 7.255
            },
            {
                "speaker_id": "2",
                "transcription": "서울대 병원 감사에 임명된 검찰 수사관 출신 인사 교육부장관 보좌관으로 파견된 검사도 입길에 오르내렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.265,
                "end": 14.859
            },
            {
                "speaker_id": "3",
                "transcription": "검찰에서 보관의 기록을 많이 했기 때문에 이 자리가 왔다고 본 거겠죠.",
                "sound_type": [
                    2
                ],
                "start": 14.869,
                "end": 19.873
            },
            {
                "speaker_id": "4",
                "transcription": "법리적 검토를 하러 왔고 거기에 대해서 열심히 할 생각입니다.",
