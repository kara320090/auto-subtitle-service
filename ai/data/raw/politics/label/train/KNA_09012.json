        "term": [
            {
                "speaker_id": "1",
                "transcription": "추궁에 두 수석은 사과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.040
            },
            {
                "speaker_id": "2",
                "transcription": "이 같은 물의를 빚어지게 해 드려서 정말 죄송합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.050,
                "end": 7.341
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 야당 의원의 질의에 대한 것이 아니라 사적 대화였다고 해명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.351,
                "end": 11.733
            },
            {
                "speaker_id": "3",
                "transcription": "사적으로 어제 일 가지고 얘길 하다가 그렇게 한 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.743,
                "end": 16.562
            },
            {
                "speaker_id": "4",
                "transcription": "혹시 사적 대화 내용을 말씀하실 수 있습니까?",
                "sound_type": [
                    2
                ],
                "start": 16.572,
                "end": 19.641
            },
            {
                "speaker_id": "3",
                "transcription": "그건 얘기 드릴 수가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.651,
                "end": 20.831
            },
            {
                "speaker_id": "4",
                "transcription": "아니 그런 걸 바로 이야기해야 오해가 풀릴 수 있지요.",
                "sound_type": [
                    2
                ],
                "start": 20.841,
                "end": 23.456
            }
        ]
    },
    "summary": "두 수석은 물의를 빚은 것에 대해 사과했다.",
