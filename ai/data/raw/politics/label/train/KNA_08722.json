        "term": [
            {
                "speaker_id": "1",
                "transcription": "내년 예산안도 마찬가지입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.443
            },
            {
                "speaker_id": "1",
                "transcription": "그저 돌봄 청년 등을 위한 서비스 개발 및 보급 추진이라는 추상적 계획만 나와 있을 뿐입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.453,
                "end": 9.794
            },
            {
                "speaker_id": "2",
                "transcription": "지금 세부적인 건 있습니까?",
                "sound_type": [
                    2
                ],
                "start": 9.804,
                "end": 11.805
            },
            {
                "speaker_id": "3",
                "transcription": "제가 지금 기억이 나진 않는데 새로운 복지 수요가 확실하고요.",
                "sound_type": [
                    2
                ],
                "start": 11.815,
                "end": 16.584
            },
            {
                "speaker_id": "3",
                "transcription": "이쪽에 좀 더 신경을 써야 된다고",
                "sound_type": [
                    2
                ],
                "start": 16.594,
                "end": 18.945
            },
            {
                "speaker_id": "1",
                "transcription": "복지부는 관련 회의를 올해 두 차례 열었습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.955,
                "end": 22.622
            },
            {
                "speaker_id": "1",
                "transcription": "지난 4월이 마지막이었고 이후로 반년 동안 움직임은 멈춰있었습니다.",
                "sound_type": [
                    2
                ],
