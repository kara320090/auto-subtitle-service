        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 제75주년 제주 사삼 희생자 추념일을 맞아 희생자와 유가족들의 고통과 아픔을 잊지 않고 보듬겠다고 약속했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.244
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 추모식에 직접 참석하는 대신 한덕수 국무총리가 대독한 추모사를 통해 이 같은 뜻을 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.254,
                "end": 16.583
            },
            {
                "speaker_id": "2",
                "transcription": "무고한 사삼 희생자들의 넋을 기리고 그 유가족들의 아픔을 국민과 함께 어루만지는 일은 자유와 인권을 지향하는 자유 민주주의 국가의 당연한 의무입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.593,
                "end": 33.481
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘도 사삼 사건 희생자들에 대한 당 차원의 추모는 한결같다면서 진상 규명과 유가족 명예 회복에 계속 노력하겠다고 약속했습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.491,
                "end": 42.830
            },
            {
                "speaker_id": "3",
                "transcription": "우리 당이 가지고 있는 사삼 사건에 대한 그런 무고한 희생자에 대한 그런 추모의 마음은 예나 지금이나 한결같습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.840,
                "end": 52.391
            },
            {
                "speaker_id": "1",
                "transcription": "더불어민주당은 이재명 대표 등 지도부가 제주에서 현장 최고위원회를 갖고 정부 여당의 극우적인 행태가 사삼 정신을 모독하고 있다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 52.401,
                "end": 63.053
            },
            {
                "speaker_id": "4",
                "transcription": "사삼은 김일성의 지시로 촉발됐다는 망언을 한 여당 지도부 사과 한마디 아직 하지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 63.063,
                "end": 72.368
            },
            {
                "speaker_id": "4",
                "transcription": "사삼의 완전한 해결이라던 대통령의 약속은 부도났습니다.",
                "sound_type": [
                    2
                ],
                "start": 72.378,
                "end": 78.678
            }
        ]
    },
