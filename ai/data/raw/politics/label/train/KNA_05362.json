        "term": [
            {
                "speaker_id": "1",
                "transcription": "악취 민원도 대폭 줄었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.068
            },
            {
                "speaker_id": "1",
                "transcription": "대구 중구는 올해 은행나무 10여 그루에 열매 수거망을 시범 설치 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.078,
                "end": 8.447
            },
            {
                "speaker_id": "1",
                "transcription": "열매가 익어 바닥으로 떨어지는 대신 수거망 안에 고스란히 담기게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 8.457,
                "end": 14.056
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 와 보니께네 깨끗해서 이래 델라 다릴라 카니까 그래 수북히 들어내 옛날엔 저 가 빗자루로 쓸고 익하지만",
                "sound_type": [
                    2
                ],
                "start": 14.066,
                "end": 22.989
            },
            {
                "speaker_id": "1",
                "transcription": "은행 열매 악취 해소를 위한 자치단체들의 아이디어도 점점 진화하고 있습니다.",
