        "term": [
            {
                "speaker_id": "1",
                "transcription": "차명진 후보가 한 매체의 기사였다고 언급했지만 통합당은 곧바로 제명을 검토하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.411
            },
            {
                "speaker_id": "2",
                "transcription": "막말을 하는 사람에 대해서는 이유 여하를 불문하고 즉각적인 조치를",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.421,
                "end": 12.159
            },
            {
                "speaker_id": "1",
                "transcription": "차 후보는 지난해 4월 세월호 5주기 하루 전에도 유가족을 모욕하는 SNS 글을 올려 당원권 3개월 정지 처분을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.169,
                "end": 22.228
            },
            {
                "speaker_id": "1",
                "transcription": "통합당 4.15 총선 후보 공천 과정에서 차 후보는 추가 공모 끝에 경선 기회를 얻었고 경선에 승리해 공천을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.238,
                "end": 31.436
            },
            {
                "speaker_id": "3",
                "transcription": "많은 논의를 거쳐가지고 우리 공관위에서 다수 의견으로 그렇게 결정한 것입니다.",
                "sound_type": [
