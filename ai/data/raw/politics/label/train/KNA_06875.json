                    2
                ],
                "start": 5.239,
                "end": 7.256
            },
            {
                "speaker_id": "3",
                "transcription": "앞서 한 차례 반대 의견을 냈던 인수위는 다시 입법 중단을 촉구했습니다.",
                "sound_type": [
