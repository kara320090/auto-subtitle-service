                    3
                ],
                "start": 3.219,
                "end": 10.208
            },
            {
                "speaker_id": "2",
                "transcription": "전직 대통령에 대한 흑역사가 반복되서는 안 된다는 확신을 가지고 있고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.218,
                "end": 14.927
            },
            {
                "speaker_id": "2",
                "transcription": "예우하고 그에 대한 존중의 뜻을 표하는 것이 마땅하다고 생각합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.937,
                "end": 20.805
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 이재명 대표는 끊임없이 노력해야 역사의 진보도 가능하다면서 시민들의 중요성을 말했습니다.",
