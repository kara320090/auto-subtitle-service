        "term": [
            {
                "speaker_id": "1",
                "transcription": "향후 조사에도 응하지 않겠다는 뜻으로 풀이됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.205
            },
            {
                "speaker_id": "1",
                "transcription": "문 전 대통령은 공식 입장을 내지 않았지만 불편함을 숨기지 않았던 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.215,
                "end": 9.645
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 감사원은 7월 중순부터 특별 조사국 소속 10여 명을 투입해 청와대 국가 안보실과 국정원 국방부와 해경 등 9개 기관을 대상으로 감사를 벌여왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.655,
                "end": 21.869
            },
            {
                "speaker_id": "1",
                "transcription": "해수부 공무원 고 @이름1 씨가 북한군에 피격되기까지 경위와 특히 월북 판단을 내렸던 당시 의사 결정 과정을 조사해 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.879,
                "end": 31.507
            },
            {
                "speaker_id": "1",
                "transcription": "감사 기간은 오는 14일까지로 공제한 바 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.517,
                "end": 35.093
            },
            {
                "speaker_id": "1",
                "transcription": "감사원의 조사 통보 사실에 민주당은 크게 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.103,
                "end": 39.454
            },
            {
                "speaker_id": "1",
                "transcription": "퇴임한 대통령을 욕보이기 위해 감사원을 앞세운 정치 보복에 분노를 금할 수 없다라고 했습니다.",
                "sound_type": [
