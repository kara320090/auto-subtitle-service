                ],
                "start": 0.000,
                "end": 9.455
            },
            {
                "speaker_id": "1",
                "transcription": "경찰 내부에서도 검찰의 직접 수사 범위를 넓힌다면 수사권 조정 취지가 훼손될 수 있다고 우려하는 목소리가 나옵니다.",
                "sound_type": [
