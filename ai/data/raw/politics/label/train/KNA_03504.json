        "term": [
            {
                "speaker_id": "1",
                "transcription": "2019년 허위공문서를 꾸며 @이름1 전 법무부 차관의 출국을 막았다는 혐의를 받는 @이름2 전 대검 과거사 진상조사단 검사.",
                "sound_type": [
                    2,
