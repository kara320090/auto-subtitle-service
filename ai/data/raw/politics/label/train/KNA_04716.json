        "term": [
            {
                "speaker_id": "1",
                "transcription": "소환 조사에 앞서 경기남부경찰청 주변을 맴돌다 취재진을 맞닥뜨린 최영길 전 성남시 의장",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.611
            },
            {
                "speaker_id": "2",
                "transcription": "어디 계셨었어요?",
                "sound_type": [
                    2
                ],
                "start": 7.621,
                "end": 8.823
            },
            {
                "speaker_id": "3",
                "transcription": "집에 있었지 어디에 있어 아 그럼요 아 조금 이따가 합시다.",
                "sound_type": [
                    2
                ],
                "start": 8.833,
                "end": 14.798
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 제기됐던 잠적설도 부인합니다.",
