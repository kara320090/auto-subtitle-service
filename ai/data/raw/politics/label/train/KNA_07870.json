        "term": [
            {
                "speaker_id": "1",
                "transcription": "자기가 받았던 위촉장들의 연도 직함 직위를 같은 것들을 다 빠짐없이 적으라고 했는데 이게 연구와 무슨 상관이 있나",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.993
            },
            {
                "speaker_id": "2",
                "transcription": "이에 박 후보자 측은 교수 연구실은 연구원과 행정 보조원이 함께 쓰는 공간으로 이들을 관리 감독하는 선임 연구원은 따로 있었다며 갑질 의혹은 후보자와 직접 관련이 없다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.003,
                "end": 21.689
            },
            {
                "speaker_id": "2",
                "transcription": "또 후보자의 거취 문제에 윤석열 대통령은 말을 아꼈습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.699,
                "end": 26.394
            },
            {
                "speaker_id": "3",
                "transcription": "국내 문제는 뭐 서울에 돌아가서 저 파악을 해 보고 답변을 하기로 하고",
                "sound_type": [
                    2
                ],
                "start": 26.404,
