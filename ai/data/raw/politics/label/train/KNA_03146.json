        "term": [
            {
                "speaker_id": "1",
                "transcription": "문 대통령이 김진욱 초대 공수처장에게 임명장을 수여했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.880
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령은 가장 중요한 덕목은 역시 중립성과 독립성이라며 정치로부터의 중립 기존 사전 기구로부터의 독립을 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.890,
                "end": 14.623
            },
            {
                "speaker_id": "1",
                "transcription": "이에 김 처장은 인권 친화적 수사 기구가 되는데 초석을 놔 국민의 신뢰를 받는다면 검찰이 지금 잘못된 수사 관행도 변화할 것이라고 말했다고 청와대는 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.633,
                "end": 26.840
            },
            {
                "speaker_id": "1",
                "transcription": "이어 열린 온라인 취임식에서 김 처장은 성역없는 수사와 자기를 돌아보는 성찰을 당부했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.850,
                "end": 34.086
            },
            {
                "speaker_id": "1",
                "transcription": "주권자인 국민 앞에 결코 오만한 권력이 되지 않겠다고도 했습니다.",
