        "term": [
            {
                "speaker_id": "1",
                "transcription": "예정에 없던 기자 회견을 연 안철수 인수 위원장 인수위 기간 중 정부 조직 개편을 추진하지 않겠다고 못 박았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.836
            },
            {
                "speaker_id": "1",
                "transcription": "이유는 경제와 외교 안보 상황 때문이라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.846,
                "end": 12.733
            },
            {
                "speaker_id": "2",
                "transcription": "엄중한 상황을 고려해서 민생 안정과 외교 안보 등 당면 국정 현안에 집중하는 것이 바람직하다고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.743,
                "end": 23.825
            },
            {
                "speaker_id": "1",
                "transcription": "조직 개편은 새 정부가 출범한 뒤 각계각층의 의견을 듣고 차분하고 심도 있게 추진하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.835,
                "end": 31.841
            },
            {
                "speaker_id": "1",
                "transcription": "특히 야당 의견을 존중하겠다고도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.851,
                "end": 35.135
            }
        ]
    },
    "summary": "안철수 인수 위원장은 새 정부가 출범한 뒤 심도 있게 정부 조직 개편안을 추진하겠다고 말했다.",
