        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 대구 서문시장 개장 100주년 기념식에 참석했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.003
            },
            {
                "speaker_id": "1",
                "transcription": "대구 서문시장 방문은 대선 후보 시절을 포함해 여섯 번째입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.013,
                "end": 9.565
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 유세에서 지지와 함성을 생각하면 지금도 힘이 난다며 초심을 강조했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.575,
                "end": 16.058
            },
            {
                "speaker_id": "2",
                "transcription": "다시 여러분을 뵈니 국정의 방향 국정의 목표가 오직 국민이라는 초심을 다시 새기게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 16.068,
                "end": 27.939
            },
            {
                "speaker_id": "1",
                "transcription": "기득권 세력이 아니라 땀 흘리는 국민이 잘살아야 한다며 자유민주주의 시장 경제 법치가 제대로 작동해야 한다고 말했습니다.",
                "sound_type": [
