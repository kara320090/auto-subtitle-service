        "term": [
            {
                "speaker_id": "1",
                "transcription": "웅장한 엔진 소리와 함께 공군 최신예 전투기 F35A의 스텔스기가 줄을 맞춰 활주로에 집결했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.481
            },
            {
                "speaker_id": "1",
                "transcription": "전투기들이 활주로에 밀집 대형으로 있다가 이륙 직전단계까지 지상활주하는 훈련입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.491,
                "end": 12.793
            },
            {
                "speaker_id": "1",
                "transcription": "우리 군이 보유한 F35A 40대 중 28대가 훈련에 참여했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.803,
                "end": 18.266
            },
            {
                "speaker_id": "2",
                "transcription": "14시 35분 부 가디언 알파 출격",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.276,
                "end": 22.807
            },
            {
                "speaker_id": "1",
                "transcription": "이른바 코끼리 행진이라고 불리는 이 훈련은 전투기에 최대 무장을 장착한 뒤 신속하게 출격하는 절차를 숙달하는 것이 핵심입니다.",
                "sound_type": [
                    2,
                    4
                ],
