        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "조 직무대행은 다만 일선 고검장들도 회의에 참여시키겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.422
            },
            {
                "speaker_id": "1",
                "transcription": "공정성 확보와 법리 해석 등을 위해 사건 처리 경험이 많은 고검장들의 의견을 들어보겠다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 5.432,
                "end": 12.552
            },
            {
                "speaker_id": "1",
                "transcription": "박 장관도 이런 제안에 동의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.562,
                "end": 15.527
            },
            {
                "speaker_id": "1",
                "transcription": "수사 지휘의 핵심은 임 연구관 등의 의견을 경청하라는 것이었다며 대검 예규상 고검장의 회의 참여는 문제가 없다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.537,
                "end": 24.698
            },
            {
                "speaker_id": "1",
                "transcription": "대검은 이에 따라 내일 오전 10시 부장 회의를 소집하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.708,
                "end": 29.203
            },
            {
                "speaker_id": "1",
                "transcription": "주말을 끼고 공소시효가 나흘밖에 남지 않은 만큼 사실상 끝장 토론을 벌여 최종 결론을 내놓을 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.213,
                "end": 36.669
            }
        ]
    },
    "summary": "조 직무대행이 공정성 확보와 법리 해석 등을 위해 사건 처리 경험이 많은 고검장들을 회의에 참여시키겠다고 밝혔다고 전했다.",
