        "term": [
            {
                "speaker_id": "1",
                "transcription": "시도 그런 형태로 해서 제가 알기로는 뭐 공채란 제도나 이런 것 없이 필기 시험 없이 채용된 것으로 알고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.073
            },
            {
                "speaker_id": "2",
                "transcription": "정우택 의원도 과거 청와대 직원 채용 때도 공개 채용은 거의 없었다며 민주당이 내로남불 행태를 보이고 있다고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.083,
                "end": 17.196
            },
            {
                "speaker_id": "2",
                "transcription": "반면 민주당은 국기 문란 썩은 내가 진동한다면서 공세 수위를 높였습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.206,
                "end": 22.824
            },
            {
                "speaker_id": "3",
                "transcription": "어느 정권에서도 볼 수 없을 정도로 기준과 원칙도 없는 사적 채용에 아주 정실 인사로 가득 차 있는 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.834,
                "end": 32.023
            },
            {
                "speaker_id": "3",
                "transcription": "대통령실이 정말 썩은 내가 진동한다 이런 이야기가 돌 정도로.",
                "sound_type": [
                    2
                ],
                "start": 32.033,
                "end": 36.619
            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 대통령실에 비슷한 사적 채용 사례가 더 있을 것 같다며 국정 조사를 거듭 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.629,
                "end": 44.031
            },
            {
                "speaker_id": "2",
                "transcription": "또 윤석열 대통령이 지금까지 논란이 된 인사를 정리하고 국민에게 사과하라고 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 44.041,
                "end": 51.258
            },
            {
                "speaker_id": "2",
                "transcription": "kbs뉴스 @이름1입니다.",
