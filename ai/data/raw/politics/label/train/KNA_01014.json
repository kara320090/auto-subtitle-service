        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이재명 상임고문께 지방선거 승리를 위해서 직접 출마해 줄 것을 요청을 했고 그것에 대해서 이재명 후보도 동의를 하셨기 때문에",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.400
            },
            {
                "speaker_id": "2",
                "transcription": "이 고문은 지역구 출마 외에 당 총괄 상임선대위원장으로 이번 선거를 진두지휘할 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.410,
                "end": 21.050
            },
            {
                "speaker_id": "2",
                "transcription": "이에 대해 이준석 국민의힘 대표는 이 고문이 자신에 대한 수사에 방탄을 치려는 것 아니냐고 혹평했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.060,
                "end": 27.641
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 대통령직 인수위원회를 해단하는 안철수 위원장도 보궐선거 출마 의지를 굳혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.651,
                "end": 34.575
            },
            {
                "speaker_id": "3",
                "transcription": "저는 분당갑뿐만 아니라 경기도를 포함한 수도권의 선거 승리를 위해서는 제 몸을 던질 생각입니다.",
                "sound_type": [
                    2
                ],
                "start": 34.585,
                "end": 45.485
            },
            {
                "speaker_id": "2",
                "transcription": "출마 지역를 명시적으로 언급하지는 않았지만 김은혜 전 의원이 경기지사 후보를 떠나면서 공석이 된 경기 분당갑이 유력합니다.",
                "sound_type": [
                    2
                ],
                "start": 45.495,
                "end": 55.229
            },
            {
                "speaker_id": "2",
                "transcription": "분당갑 지역은 IT 기업이 밀집한 판교가 있는 곳인 만큼 안 위원장의 출마설이 꾸준히 제기돼 온 지역입니다.",
                "sound_type": [
                    2
                ],
                "start": 55.239,
                "end": 63.104
            },
            {
                "speaker_id": "2",
                "transcription": "안 위원장의 공천이 확정이 확정되면 국민의힘 당적을 가지고 나서는 첫 선거가 될 전망입니다.",
                "sound_type": [
                    2
                ],
                "start": 63.114,
                "end": 69.402
            },
            {
                "speaker_id": "2",
                "transcription": "반면 민주당은 이 지역의 현 지역 위원장인 김병관 전 의원을 공천하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 69.412,
                "end": 75.805
            },
            {
                "speaker_id": "2",
                "transcription": "지난 대선에서 유력 후보였던 이재명 상임고문과 안철수 인수위원장이 동시에 보궐선거에 뛰어듦에 따라 6.1 지방선거 국면이 요동치게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 75.815,
                "end": 86.178
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 방준원입니다.",
                "sound_type": [
                    2
                ],
                "start": 86.188,
                "end": 88.476
            },
            {
                "speaker_id": "1",
                "transcription": "새 정부 출범이 임박했지만 여전히 내각 구성은 난항을 겪고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 88.486,
                "end": 94.793
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인은 계속해서 한덕수 총리 후보자에 대해 신임한다고 밝히고 있지만",
                "sound_type": [
                    2
                ],
                "start": 94.803,
                "end": 100.133
            }
        ]
    },
    "summary": "이재명 상임고문과 안철수 위원장은 6.1 지방선거 출마 의지를 굳혔다.",
