        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당은 도이치모터스 주가 조작 사건과 김건희 여사의 연루 의혹을 집중 추궁했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.854
            },
            {
                "speaker_id": "1",
                "transcription": "이에 한동훈 법무부 장관은 김 여사가 검찰 서면 조사를 받은 사실을 공식 확인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.864,
                "end": 12.359
            },
            {
                "speaker_id": "2",
                "transcription": "서면 조사를 했었고 출석 요구를 한 바는 없는데 소환을 위한 변호사와의 협의는 있었다.",
                "sound_type": [
                    2
                ],
                "start": 12.369,
                "end": 18.658
            },
            {
                "speaker_id": "1",
                "transcription": "서면 조사 시기는 전 정부 시절이라고만 했는데 이 과정에서 언쟁도 벌어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.668,
                "end": 24.711
            },
            {
                "speaker_id": "3",
                "transcription": "윤석열 검찰총장 시절에 아무도 수사하지 못했어요. 다 일일이",
                "sound_type": [
