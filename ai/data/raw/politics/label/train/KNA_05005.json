        "term": [
            {
                "speaker_id": "1",
                "transcription": "사회적으로 관심이 큰 사건이나 경찰 고위직 관련 사건이 있는데 경찰이 수사를 안 하면 수사를 해라 이런 식으로.",
                "sound_type": [
                    2
