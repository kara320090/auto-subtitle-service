        "term": [
            {
                "speaker_id": "1",
                "transcription": "실제로 @이름1 전 사무부총장이 꾸렸던 조직본부 명단에 김 씨가 서울 지역 본부장으로 이름을 올린 것으로 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.501
            },
            {
                "speaker_id": "2",
                "transcription": "회의에 참석을 안 했다가 끝날 때쯤 한두 번 나타난 거 같은데 보좌관들하고 오고 악수하고",
                "sound_type": [
                    2
                ],
                "start": 8.511,
                "end": 16.156
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 김 씨가 캠프에서 구체적으로 어떤 역할을 맡았는지 집중 조사하고 있습니다.",
                "sound_type": [
                    2
                ],
