        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "전통 시장을 찾은 김건희 여사 이불과 베개 등을 살펴보더니 즉석에서 구매합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.228
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까 이불이 얼마인데요?",
                "sound_type": [
                    2
                ],
                "start": 5.238,
                "end": 7.390
            },
            {
                "speaker_id": "3",
                "transcription": "마진을 크게 못 보고 많이 팔아야 돼요.",
                "sound_type": [
                    2
                ],
                "start": 7.400,
                "end": 10.982
            },
            {
                "speaker_id": "1",
                "transcription": "시장 골목 분식 가게에서 떡볶이도 먹습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.992,
                "end": 14.503
            },
            {
                "speaker_id": "4",
                "transcription": "이런 데서 처음 드시는 거 아니에요?",
                "sound_type": [
                    2
                ],
                "start": 14.513,
                "end": 17.312
            },
            {
                "speaker_id": "2",
                "transcription": "아니요. 많이 먹어요.",
                "sound_type": [
                    2
                ],
                "start": 17.322,
                "end": 19.572
            },
            {
                "speaker_id": "1",
                "transcription": "김 여사가 혼자 대중 앞에 나선 건 사실상 처음 장소도 보수 진영에서 상징적인 대구 서문 시장입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.582,
                "end": 27.028
            },
            {
                "speaker_id": "1",
                "transcription": "아내의 역할에만 충실하겠다던 이른바 조용한 내조 기조가 바뀌고 있다는 해석이 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 27.038,
                "end": 33.339
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령도 언론 인터뷰에서 취임해 보니 배우자도 할 일이 적지 않더라며 어려운 이웃을 배려하는 일 등을 예로 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.349,
                "end": 41.841
            }
        ]
    },
    "summary": "보수 진영에서 상징적인 대구 서문 시장을 찾은 김건희 여사는 아내의 역할에만 충실하겠다던 내조 기조가 바뀌고 있다는 해석이 나온다.",
