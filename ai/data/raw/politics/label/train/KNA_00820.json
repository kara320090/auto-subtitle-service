                "speaker_id": "4",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "무자비한 공정의 잣대는 어디로 사라졌는지 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.737
            },
            {
                "speaker_id": "1",
                "transcription": "그때는 맞고 지금은 틀리다는 것인지",
                "sound_type": [
                    2
                ],
                "start": 4.747,
                "end": 8.700
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 힘은 사퇴론에 선을 그으며 인사 청문회에서 검증하자는 입장을 재확인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.710,
                "end": 14.722
            },
            {
                "speaker_id": "3",
                "transcription": "청문회에서 중대한 결격 사유가 밝혀진다면 그 때 가서 인사의 잘못을 지적해도 늦지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.732,
                "end": 21.636
            },
            {
                "speaker_id": "3",
                "transcription": "비판보다 검증이 우선해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.646,
                "end": 25.177
            },
            {
                "speaker_id": "2",
                "transcription": "지도부의 이런 방침에도 불구하고 당내에선 자진 사퇴를 촉구하는 공개 발언이 처음 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.187,
                "end": 31.739
            },
            {
                "speaker_id": "2",
                "transcription": "김용태 청년 최고 위원은 국민의 일반적 눈높이에서 바라볼 때 쉽게 납득하기 힘든 게 현실이라고 했고 하태경 의원은 법리적 판단이 아니라 정무적 판단이 중요하다며 자진 사퇴하는 게 맞다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.749,
                "end": 46.797
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 임종빈입니다.",
                "sound_type": [
                    2
                ],
                "start": 46.807,
                "end": 49.944
            },
            {
                "speaker_id": "4",
                "transcription": "국민의 힘과 국민의 당이 오늘 합당을 공식 선언하고 합의에 따라 당명은 국민의 힘을 사용하기로 한다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 49.954,
                "end": 57.850
            },
            {
                "speaker_id": "4",
                "transcription": "이 소식을 비롯해서 정호영 장관 후보자와 관련한 인수위의 입장 등을 인수위 취재 기자 연결해서 보내드리겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 57.860,
                "end": 64.881
            },
            {
                "speaker_id": "4",
                "transcription": "자 이유민 기자 어 먼저 오늘 양당의 합당 선언에 어떤 내용들이 있었는지부터 전해주시죠.",
                "sound_type": [
                    2
                ],
                "start": 64.891,
                "end": 71.037
            }
        ]
    },
    "summary": "국민의 힘은 인사 청문회에서 검증하자는 입장인데 이런 방침에도 당내에선 자진 사퇴를 촉구하는 공개 발언이 나왔고 국민의 힘과 국민의 당이 합당을 공식 선언하며 당명은 국민의 힘을 사용하기로 했다.",
