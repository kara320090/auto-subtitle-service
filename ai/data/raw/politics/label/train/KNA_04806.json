        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난 신년 특사의 경우 생계형 형사범 등 3000여 명이 대상이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.722
            },
            {
                "speaker_id": "1",
                "transcription": "이번 특사의 관심은 최근 일부 정치권에서 거론한 이명박 박근혜 전 대통령의 사면 여부입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.732,
                "end": 12.106
            },
            {
                "speaker_id": "1",
                "transcription": "이 전 대통령은 다스 회삿돈 횡령 등으로 징역 17년을 선고받고 복역 중이고 박 전 대통령은 국정 농단 사건 등으로 모두 징역 22년을 선고받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.116,
                "end": 23.710
            },
            {
                "speaker_id": "1",
                "transcription": "두 전직 대통령 모두 고령에 지병을 앓고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.720,
                "end": 28.185
            },
            {
                "speaker_id": "1",
                "transcription": "특히 지난달부터 민간 병원에서 입원 치료를 받고 있는 박 전 대통령은 의료진 판단에 따라 6주 이상 입원을 연장하기도 했습니다.",
                "sound_type": [
