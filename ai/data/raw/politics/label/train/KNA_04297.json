        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 오늘 국무 회의에서 내년도 예산안을 604조 4000억 원으로 확정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.609
            },
            {
                "speaker_id": "1",
                "transcription": "올해 본예산보다 8.3 퍼센트 늘어 난 규모로 사상 처음 600조 원을 넘겼습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.619,
                "end": 12.015
            },
            {
                "speaker_id": "2",
                "transcription": "위기의 극복과 경기 회복 그리고 격차 해소와 미래 대비를 위한 재정 수요도 매우 중요하고 또 귀중한 만큼 금년 예산 총지출 증가율 8.9 퍼센트에 이어 내년에도 8 퍼센트대의 확장 기조를",
                "sound_type": [
                    2
                ],
                "start": 12.025,
                "end": 28.591
            },
            {
                "speaker_id": "1",
                "transcription": "분야별로 보면 소득 격차 해소와 사회 안전망 강화를 위한 보건 복지 고용 분야의 가장 큰 규모의 예산이 배정 됐는데 올해보다 8.5 센트 늘어난 216조 7000억 원이 투입됩니다.",
                "sound_type": [
                    2
                ],
                "start": 28.601,
                "end": 43.427
            },
            {
                "speaker_id": "1",
                "transcription": "각종 사회 급여 지원의 기준이 되는 중위 소득을 역대 가장 큰 폭으로 올리고 전국민 고용 보험을 추진하는데도 예산이 투입됩니다.",
                "sound_type": [
                    2
                ],
                "start": 43.437,
                "end": 53.086
            }
        ]
    },
