        "term": [
            {
                "speaker_id": "1",
                "transcription": "다섯 살 중증 자폐 아동을 키우고 있는 김 모 씨.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.528
            },
            {
                "speaker_id": "1",
                "transcription": "서울의 한 시립 병원에서 전문 치료를 받으려고 1년 가까이 대기해야 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.538,
                "end": 9.900
            },
            {
                "speaker_id": "1",
                "transcription": "가까스로 재활 치료를 받게 됐지만 반년 만에 치료가 중단될까 우려하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.910,
                "end": 16.013
            },
            {
                "speaker_id": "2",
                "transcription": "부모 소집이 갑자기 잡혀서 이제 가봤더니 원장님이 갑자기 가게 되셨다는 거.",
                "sound_type": [
                    2
                ],
                "start": 16.023,
                "end": 21.814
            },
            {
                "speaker_id": "2",
                "transcription": "가슴이 일단 철렁했죠.",
