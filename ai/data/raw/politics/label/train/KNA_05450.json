                ],
                "start": 0.000,
                "end": 11.842
            },
            {
                "speaker_id": "1",
                "transcription": "이른바 가처분 리스크를 상당 부분 덜어낸 만큼 국민의힘은 차기 당 대표 선출을 위한 정당 대회 준비에 돌입할 수 있게 됐습니다.",
                "sound_type": [
                    2,
