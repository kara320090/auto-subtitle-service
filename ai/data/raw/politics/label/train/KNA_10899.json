        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 정권이 결국 역사 정의를 배신한 길을 선택한 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.024
            },
            {
                "speaker_id": "1",
                "transcription": "가히 삼전도 굴욕에 버금가는 외교사 최대 치욕이자 오점이 아닐 수가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.034,
                "end": 14.081
            },
            {
                "speaker_id": "2",
                "transcription": "정의당 역시 정부가 한국의 실리 하나 챙기지 못한 채 전범 기업의 해결사를 자처하고 있다며 의도적 친일 행위라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.091,
                "end": 23.022
            },
            {
                "speaker_id": "3",
                "transcription": "누가 국가의 자존심을 다 내팽개치고 돈 몇 푼 받아오라고 시키기라도 했습니까?",
                "sound_type": [
                    2
                ],
                "start": 23.032,
                "end": 29.144
            },
            {
                "speaker_id": "3",
                "transcription": "일본 정부의 논리를 그대로 따르는 꼴입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.154,
                "end": 32.365
            }
        ]
    },
