        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰 수사권 폐지에 반발하며 지난 4월 사임했던 이복현 전 부장 검사가 두 달 만에 금융 감독원장으로 취임했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.255
            },
            {
                "speaker_id": "1",
                "transcription": "1999년 금감원 설립 이후 검사 출신 원장은 이번이 처음입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.265,
                "end": 13.592
            },
            {
                "speaker_id": "1",
                "transcription": "검사 시절 이 원장은 윤석열 대통령과 함께 금융 범죄를 주로 수사했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.602,
                "end": 19.155
            },
            {
                "speaker_id": "1",
                "transcription": "또 국정원 댓글과 국정 농단 수사 등도 함께 해 윤 대통령의 최측근이라는 평가도 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 19.165,
                "end": 25.652
            },
            {
                "speaker_id": "1",
                "transcription": "이 원장을 제청한 금융 위원회는 경제 범죄 수사 경험을 바탕으로 준법 경영 환경을 조성할 적임자라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.662,
                "end": 33.563
            },
            {
                "speaker_id": "1",
                "transcription": "최근 부활한 증권 범죄 합동 수사단과 함께 옵티머스 펀드 사태 같은 사안을 중점적으로 들여다 볼 거란 전망이 나오는 이유입니다.",
                "sound_type": [
                    2
                ],
                "start": 33.573,
                "end": 42.075
            }
        ]
    },
    "summary": "검찰 수사권 폐지에 반발하며 사임했던 이복현 전 부장 검사가 금융 감독원장으로 취임했고 윤 대통령의 최측근이라는 평가가 있으며 금융 위원회는 경제 범죄 수사 경험을 바탕으로 한 적임자라고 밝혔다.",
