        "term": [
            {
                "speaker_id": "1",
                "transcription": "육군 참모 총장 관저에 와서 둘러봤다는 얘깁니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.500
            },
            {
                "speaker_id": "2",
                "transcription": "네 한남동에 있는 총장 공관을 둘러봤다.",
                "sound_type": [
                    2
                ],
                "start": 3.517,
                "end": 7.290
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 국방부에서도 이걸로 상당히 고심한 걸로 알려져 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.290,
                "end": 12.066
            },
            {
                "speaker_id": "3",
                "transcription": "방송 하루 만에 대통령실이 법적 대응에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.076,
                "end": 16.171
            },
            {
                "speaker_id": "3",
                "transcription": "김 처장은 천공과 일면식도 없다.",
                "sound_type": [
                    2
                ],
                "start": 16.181,
                "end": 18.818
            },
            {
                "speaker_id": "3",
                "transcription": "객관적 근거 없이 무속 프레임을 씌웠다며 김 전 의원과 방송인 김어준 씨를 허위 사실 유포 혐의로 고발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.828,
                "end": 27.065
            },
            {
                "speaker_id": "3",
                "transcription": "육군 역시 사실 무근 거짓 주장으로 군의 명예를 실추시켰다며 유감을 표명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.075,
                "end": 32.866
            }
        ]
    },
    "summary": "방송 하루 만에 대통령실이 법적 대응에 나섰고 육군 역시 사실 무근 거짓 주장으로 군의 명예를 실추시켰다며 유감을 표명했다.",
