        "term": [
            {
                "speaker_id": "1",
                "transcription": "이태원 참사 이후 처음으로 집권 여당 지도부가 국회에서 유족들을 만났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.544
            },
            {
                "speaker_id": "1",
                "transcription": "유족들에게 고개를 숙이는 정진석 국민의힘 비대위원장.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.554,
                "end": 10.185
            },
            {
                "speaker_id": "1",
                "transcription": "2시간 정도 진행된 비공개 만남에서는 유족 10여 명이 참석해 정부의 미숙한 대응에 대한 질타를 쏟아냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.195,
                "end": 18.455
            },
            {
                "speaker_id": "2",
                "transcription": "뭐 대책이 없어서 이렇게 참사가 당했습니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.465,
                "end": 21.841
            },
            {
                "speaker_id": "2",
                "transcription": "있는 것도 작동을 안 했잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.851,
                "end": 24.629
            },
            {
                "speaker_id": "2",
                "transcription": "어 그러니까 이게 정부에서 간접 살인이라고 살인이라고도 저는 보고 있어요 이거",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.639,
                "end": 30.830
            }
        ]
    },
