        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "반년 넘게 지났지만 매장 추정지는 수풀만 무성합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.428
            },
            {
                "speaker_id": "1",
                "transcription": "현재 시굴이 이뤄졌던 장소엔 이렇다 할 출입 통제도 없어 현장 훼손 우려도 제기됩니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 4.438,
                "end": 10.744
            },
            {
                "speaker_id": "1",
                "transcription": "정부와 경기도 모두 손을 놓고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.754,
                "end": 14.100
            },
            {
                "speaker_id": "1",
                "transcription": "행정 안전부는 구체적인 발굴 계획도 아직 내놓지 않았고 경기도는 피해자 지원만 맡고 있다며 발굴에는 뒷짐 지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.110,
                "end": 23.341
            },
            {
                "speaker_id": "2",
                "transcription": "관계 기관과 협의를 해서 지금 처리 방안을 마련하고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 23.351,
                "end": 26.389
            },
            {
                "speaker_id": "2",
                "transcription": "적극적으로",
                "sound_type": [
                    2
                ],
                "start": 26.399,
                "end": 27.720
            },
            {
                "speaker_id": "1",
                "transcription": "피해자들의 속은 타들어 갑니다.",
                "sound_type": [
                    2
                ],
                "start": 27.730,
                "end": 30.176
            },
            {
                "speaker_id": "3",
                "transcription": "어린 유골들이고 땅이 산성도가 높아서 유해 발굴을 빨리하지 않으면은 그 흔적과 유해를 발굴하기가 어렵습니",
                "sound_type": [
                    1,
                    2
                ],
                "start": 30.186,
                "end": 39.906
            }
        ]
    },
    "summary": "행정 안전부는 구체적인 발굴 계획도 아직 내놓지 않았고 경기도는 피해자 지원만 맡고 있다며 발굴에는 뒷짐 지고 있어 피해자들의 속만 타들어 갑니다.",
