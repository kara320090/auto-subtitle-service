        "term": [
            {
                "speaker_id": "1",
                "transcription": "2년 전 절반을 넘었던 영남권은 11.6퍼센트포인트가 줄어 40퍼센트 정도가 됐고 수도권은 5.5퍼센트포인트가 늘어 이에 육박하는 비율이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.112
            },
            {
                "speaker_id": "1",
                "transcription": "나타날 표심이 관심입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.122,
                "end": 13.958
            },
            {
                "speaker_id": "1",
                "transcription": "김 후보는 울산 안 후보는 경기도가 지역구이기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.968,
                "end": 18.652
            },
            {
                "speaker_id": "1",
                "transcription": "김 후보 측은 수도권 당원 대부분은 고향이 영남이라며 자체 조사에서 앞선다고 했고 안 후보 측은 수도권 비율이 높아진 건 고무적이라면서도 영남권은 투표율이 높다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.662,
                "end": 31.606
            },
            {
                "speaker_id": "1",
                "transcription": "연령별로는 60대가 30퍼센트 정도로 가장 많았고 50대는 25퍼센트 정도였습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.616,
                "end": 37.837
            }
        ]
    },
    "summary": "김 후보는 울산 안 후보는 경기도가 지역구이며 수도권 비율이 높아진 것에 대한 의견은 서로 다르다.",
