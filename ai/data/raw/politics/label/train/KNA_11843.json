        "term": [
            {
                "speaker_id": "1",
                "transcription": "울산 지역에서는 내일부터 민간인이 되는 송 부시장의 행보에 관심이 쏠리고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.943
            },
            {
                "speaker_id": "1",
                "transcription": "송 부시장은 수사 상황을 지켜본 뒤 총선 출마를 검토하고 있는 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.953,
                "end": 10.597
            },
            {
                "speaker_id": "1",
                "transcription": "울산 남구청장 재선거가 이뤄질 경우 출마 가능성도 점지고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.607,
                "end": 15.553
            },
            {
                "speaker_id": "1",
                "transcription": "총선 출마 공직자 사퇴 시안을 불과 이틀 앞두고 직권 면직 결정이 내려진 점도 이 같은 관측에 힘을 싣고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.563,
                "end": 23.683
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 송 부시장은 소회나 출마 여부를 묻는 기자들의 질문에 아무 대답을 하지 않고 청사를 떠났습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.693,
