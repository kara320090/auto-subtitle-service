        "term": [
            {
                "speaker_id": "1",
                "transcription": "불편한 질문에는 즉답을 피하기도 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.898
            },
            {
                "speaker_id": "2",
                "transcription": "내부 총질 문자에 대해서는 뭐 설명하실 생각 없으십니까?",
                "sound_type": [
                    2,
