                    2
                ],
                "start": 0.000,
                "end": 12.384
            },
            {
                "speaker_id": "1",
                "transcription": "그로부터 50분 뒤 국정원은 해당 첩보를 토대로 피격 사망 결론을 냅니다.",
                "sound_type": [
                    2
