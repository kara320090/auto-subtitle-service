        "term": [
            {
                "speaker_id": "1",
                "transcription": "문재인 정부의 마지막 국무 회의.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.653
            },
            {
                "speaker_id": "2",
                "transcription": "예 제 20회 국무 회의를 시작하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.663,
                "end": 9.310
            },
            {
                "speaker_id": "1",
                "transcription": "국무 회의는 통상 오전에 진행되지만 이번엔 오후 2시에 열렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.320,
                "end": 15.248
            },
            {
                "speaker_id": "1",
                "transcription": "국회에서 검찰 수사권 축소 법안이 모두 통과돼 정부로 넘어오기를 기다린 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 15.258,
                "end": 21.211
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령은 여야 합의가 파기돼 아쉬움이 있었다면서 권력 기관 개혁은 촛불 정부의 큰 사명이자 국민의 염원 역사적 시대적 소명에 부합하는 정책 방향이라고 평가했습니다.",
                "sound_type": [
                    2
