        "term": [
            {
                "speaker_id": "1",
                "transcription": "원종건 씨 사퇴 하루 만에 결국 당대표가 고개를 숙였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.203
            },
            {
                "speaker_id": "2",
                "transcription": "국민과 당원께 심려를 끼쳐 드린 점을 송구하게 생각을 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.213,
                "end": 10.248
            },
            {
                "speaker_id": "2",
                "transcription": "당에서 좀 더 철저히 조사를 하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.258,
                "end": 14.796
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 앞으로 검증 과정을 보완하겠다고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.806,
                "end": 18.973
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이번 일을 계기로 영입 방식 전반을 손봐야 한다는 목소리가 안팎에서 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 18.983,
                "end": 24.963
            },
            {
                "speaker_id": "1",
                "transcription": "우선 감동적이고 독특한 사연과 이력만을 앞세워 이벤트식 영입을 서두르다 보니 적격 여부에 대한 검증은 뒷전으로 밀리고 있다는 지적입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.973,
                "end": 35.869
            }
        ]
    },
    "summary": "원종건 씨 사퇴 이후 민주당 당 대표가 사과했고 영입 방식 전반을 손봐야 한다는 지적이 나온다.",
