        "term": [
            {
                "speaker_id": "1",
                "transcription": "여당은 물가 대책으로 부동산 정책에 후속 법안을 발의했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.474
            },
            {
                "speaker_id": "1",
                "transcription": "1세대 1주택자에 종합 부동산세 과세 기준을 3억원 늘리고 월세 세액 공제와 전세 대출 상환액의 소득 공제를 각각 늘려 세 부담을 줄이겠다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 4.484,
                "end": 15.417
            },
            {
                "speaker_id": "2",
                "transcription": "정부에서 정책으로 또는 관련되는 내용을 발표를 하고 입법으로 저희들이 처리해야 될 사항은 어 관련된 사항을 입법으로 처리하겠다는 그런 취지로",
                "sound_type": [
                    2
                ],
                "start": 15.427,
                "end": 26.551
            },
            {
                "speaker_id": "1",
                "transcription": "야당은 현장 간담회를 열고 소상공인 챙기기에 나섰습니다.",
