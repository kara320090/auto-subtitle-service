        "term": [
            {
                "speaker_id": "1",
                "transcription": "활동을 시작할 수 있기를 바라고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.440
            },
            {
                "speaker_id": "2",
                "transcription": "신임 원내대표를 뽑는 방식도 바꾸기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.440,
                "end": 7.762
            },
            {
                "speaker_id": "1",
                "transcription": "입후보 절차 없이 과반 득표자가 나올 때까지 투표를 계속해 나가는 이른바 교황 선출 방식으로 지나치게 경쟁하는 걸 막기 위한 조치입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.772,
                "end": 17.460
            },
            {
                "speaker_id": "1",
                "transcription": "당내에서는 이재명 전 후보가 6월 지방선거 때부터 역할을 해야 한다는 의견도 나왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.470,
                "end": 24.026
            },
            {
                "speaker_id": "3",
                "transcription": "역할을 할 수 있으면 하는 게 좋다고 봅니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.036,
                "end": 26.272
            },
            {
                "speaker_id": "3",
                "transcription": "왜냐하면 그 국민적 기대가 있는 것이고 결국은 아직 뭐 나이도 있잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.282,
                "end": 31.085
            },
            {
                "speaker_id": "1",
                "transcription": "김두관 의원은 이재명 전 후보가 비대위원장을 맡아야 한다고 했는데 그는 노영민 전 실장 김현미 전 장관 김수현 전 실장의 출당으로 인적 청산을 시작해야 한다고도 주장하기도 했습니다.",
                "sound_type": [
