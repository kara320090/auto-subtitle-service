        "term": [
            {
                "speaker_id": "1",
                "transcription": "나랏빚 관리 기준이 단순해집니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.181
            },
            {
                "speaker_id": "1",
                "transcription": "종전엔 국내총생산 GDP 대비 국가 채무 비율 그리고 국민연금 등 기금과 정부 예산을 합한 통합재정수지를 같이 반영했지만 앞으로는 정부 예산인 관리 재정 수지 적자가 3퍼센트를 넘는지만 따집니다.",
                "sound_type": [
                    2
                ],
                "start": 2.191,
                "end": 17.497
            },
            {
                "speaker_id": "1",
                "transcription": "기금이 수십조 원의 흑자를 내고 있는 점을 감안하면 기준이 엄격해지는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 17.507,
                "end": 23.072
            },
            {
                "speaker_id": "1",
                "transcription": "법으로 정해 구속력도 높입니다.",
                "sound_type": [
                    2
                ],
                "start": 23.082,
                "end": 25.488
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 되면 3년 뒤 58퍼센트가 넘을 국가 채무 비율이 2027년까지 50퍼센트 중반대로 유지된다는 게 재정 당국의 설명입니다.",
                "sound_type": [
                    2
                ],
                "start": 25.498,
                "end": 36.436
            }
        ]
    },
    "summary": "나랏빚 관리 기준이 단순해지며 엄격해진다.",
