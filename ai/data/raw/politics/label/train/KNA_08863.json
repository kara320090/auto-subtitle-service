        "term": [
            {
                "speaker_id": "1",
                "transcription": "발굴 사업엔 예산과 인력이 필요하고 지역 주민들의 이해 협조도 절실합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.104
            },
            {
                "speaker_id": "1",
                "transcription": "경기도는 중앙 정부가 주도해야 한다는 입장이지만 정부는 사과 권고조차도 수용한 적이 드뭅니다.",
                "sound_type": [
                    2
                ],
                "start": 6.114,
                "end": 13.668
            },
            {
                "speaker_id": "1",
                "transcription": "진실화해위는 대규모 발굴과 사후 조치를 감당할 행정력이 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.678,
                "end": 18.962
            },
            {
                "speaker_id": "2",
                "transcription": "확실히 예 확실히 여기예요.",
                "sound_type": [
                    2
                ],
                "start": 18.972,
                "end": 21.659
            },
            {
                "speaker_id": "2",
                "transcription": "여기가 시신 집합소였어요.",
                "sound_type": [
                    2
                ],
                "start": 21.669,
                "end": 24.298
            },
            {
                "speaker_id": "2",
                "transcription": "볼록볼록 나온 게 다 무덤이잖아요.",
                "sound_type": [
                    2
                ],
                "start": 24.308,
                "end": 26.593
            }
        ]
    },
    "summary": "유해 발굴 사업이 이루어지지 못하고 있다고 전했다.",
