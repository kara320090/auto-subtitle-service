        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 정부 세종 청사에서 추경호 경제부총리 주재로 비상 경제 장관 회의를 열었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.408
            },
            {
                "speaker_id": "1",
                "transcription": "고물가와 경기 침체 고용 절벽의 복합 위기를 헤쳐나가기 위한 정부 역할을 다하기 위해섭니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.418,
                "end": 14.050
            },
            {
                "speaker_id": "1",
                "transcription": "우선 상반기에 직접 일자리 사업으로 모두 94만 명을 채용하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.060,
                "end": 19.550
            },
            {
                "speaker_id": "1",
                "transcription": "직접 일자리 사업은 노인 공공 일자리 등 취약 계층을 위해 정부가 한시적인 일자리를 제공하는 사업입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.560,
                "end": 27.184
            },
            {
                "speaker_id": "1",
                "transcription": "연간 규모가 104만 개인데 그 90퍼센트를 상반기에 만들기로 한 겁니다.",
                "sound_type": [
                    2,
