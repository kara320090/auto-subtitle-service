        "term": [
            {
                "speaker_id": "1",
                "transcription": "시민의 삶과 재생산 권리를 확실히 보장하는 가운데 시민 누구나 아이를 낳고 기르는 과정이 행복해질 수 있도록 돌봄 혁명을 이루는 것이",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.891
            },
            {
                "speaker_id": "2",
                "transcription": "심 후보는 노동계도 만나 소규모 사업장 근로기준법 적용을 약속하며 이번 대선이 노동 없는 대선이다 거대 양당 후보의 빈틈을 공략했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.901,
                "end": 20.449
            },
            {
                "speaker_id": "2",
                "transcription": "지지율 상승세인 국민의 당 안철수 후보는 3강 구도 굳히기에 주력했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.459,
                "end": 26.097
            },
            {
                "speaker_id": "2",
                "transcription": "이재명 윤석열 후보 모두 도덕적 약점이 있다 병사 월급 200만 원 등 포퓰리즘만 하는 후보들을 국민이 심판해 달라 했습니다.",
                "sound_type": [
                    2
