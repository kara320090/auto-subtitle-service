        "term": [
            {
                "speaker_id": "1",
                "transcription": "비례대표 공천 갈등 격화로 전격 사퇴한 한선교 전 미래한국당 대표 떠나면서 이런 말을 남겼습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.556
            },
            {
                "speaker_id": "2",
                "transcription": "적어도 20번 안에 들어가는 명단은 정말 바꾸면 안 돼요.",
                "sound_type": [
                    2
                ],
                "start": 7.566,
                "end": 12.933
            },
            {
                "speaker_id": "2",
                "transcription": "그것까지 바꾼다면은 저는 가만히 있지는 않을 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 12.943,
                "end": 19.643
            },
            {
                "speaker_id": "1",
                "transcription": "한 전 대표와 공병호 공천관리위원장을 밀어내고 통합당 출신이 하루 만에 미래한국당 지도부와 공관위를 꾸렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.653,
                "end": 28.437
            },
            {
                "speaker_id": "1",
                "transcription": "황교안 대표와 가까운 인사들입니다.",
                "sound_type": [
                    2
                ],
                "start": 28.447,
                "end": 31.118
            },
            {
                "speaker_id": "3",
                "transcription": "신속하게 미래한국당의 혼란을 수습하고 체제를 정비하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.128,
                "end": 39.406
            }
        ]
    },
