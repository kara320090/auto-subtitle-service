        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 대해 청와대는 강력한 대응을 예고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.883
            },
            {
                "speaker_id": "1",
                "transcription": "김 위원장의 발언이 사실과 다른 무책임한 발언이고 북풍 공작과도 다를 바 없다는 겁니다.",
                "sound_type": [
                    2
