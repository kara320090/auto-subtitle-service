        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 힘의 두 번째 비대위원장을 수락한 정진석 국회부의장의 일성은 통합형 비대위였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.769
            },
            {
                "speaker_id": "1",
                "transcription": "특히 이준석 전 대표가 임명한 최재영 혁신위원장 영입 의사를 공개적으로 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.779,
                "end": 11.861
            },
            {
                "speaker_id": "2",
                "transcription": "지역 안배도 좀 하고 통합형 인선을 좀 해야 되지 않을까.",
                "sound_type": [
                    2
                ],
                "start": 11.871,
                "end": 17.782
            },
            {
                "speaker_id": "2",
                "transcription": "최재형 의원께는 꼭 참여를 좀 부탁드리고 싶은 생각입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.792,
                "end": 21.215
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 판사 출신 최 의원은 즉각 고사의 뜻을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.225,
                "end": 25.458
            }
        ]
    },
