        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 항소심 판단은 달랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.328
            },
            {
                "speaker_id": "1",
                "transcription": "최 씨가 주 씨와 동업계약을 맺은 적이 없고 요양병원에 자금 집행을 지시할 위치가 아니었다고 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.338,
                "end": 10.451
            },
            {
                "speaker_id": "1",
                "transcription": "최 씨가 자금 회수 뒤 병원 일에 관여한 사실이 없다는 점도 인정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.461,
                "end": 16.206
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 검사가 낸 증거만으로는 범행을 공모했다고 보기 어렵다며 혐의 모두에 대해 무죄를 선고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.216,
                "end": 25.037
            },
            {
                "speaker_id": "1",
                "transcription": "최 씨는 선고 뒤 심경을 묻는 취재진에게 말을 아꼈습니다.",
                "sound_type": [
                    2,
                    5
