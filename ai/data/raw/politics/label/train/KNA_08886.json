        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 정권은 민주당의 과거 현재 미래를 지우려고 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.346
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 사법리스크 현실화에 당내 분위기는 뒤숭숭합니다.",
                "sound_type": [
                    2,
                    4
                ],
