        "term": [
            {
                "speaker_id": "1",
                "transcription": "기획재정부는 전 국민에게 지원금을 줄 경우 3조 6000억 원이 더 필요하고 이는 국채를 발행해서 조달하겠다고 국회에 보고했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 9.874
            },
            {
                "speaker_id": "1",
                "transcription": "또 민주당의 제안대로 지원금의 기부를 위해서 관련 특별법도 제정하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.884,
                "end": 16.906
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 기획재정부 보고를 받은 통합당 소속 김재원 국회 예결특위 위원장은 우선 특별 법안과 새 예산안을 제출하라고 요구했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.916,
                "end": 26.920
            },
            {
                "speaker_id": "2",
                "transcription": "특별법을 빨리 마련해서 곧바로 국회에 정부안으로 제출해서 상임위에서 추경 예산안과 함께 처리할 수 있도록 맞춰주시길 바랍니다.",
                "sound_type": [
