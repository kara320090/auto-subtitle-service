        "term": [
            {
                "speaker_id": "1",
                "transcription": "비명계 반발을 의식한 듯 공천학살은 없을 거라고 했고 진행 중인 의혹 수사와 관련한 사법 리스크 우려는 일축했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.716
            },
            {
                "speaker_id": "2",
                "transcription": "동네 선무당 동네 굿하듯 하고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 8.726,
                "end": 12.121
            },
            {
                "speaker_id": "2",
                "transcription": "책임을 묻는 게 아니라 꾕과리를 치고 온 동네에다 소문을 내는 게 주 목적인 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.131,
                "end": 18.424
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 대세론 속에 비명계 반발은 한층 거세졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.434,
                "end": 22.839
            },
            {
                "speaker_id": "1",
                "transcription": "설훈 의원은 분당론까지 나오고 있다며 이 의원을 겨냥했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.849,
                "end": 27.669
            },
            {
                "speaker_id": "3",
                "transcription": "위기의 경고음을 듣지 못하고 폭주하는 기관차를 세우기 위해 철길에 뛰어들겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.679,
                "end": 36.002
            }
        ]
    },
    "summary": "이재명의 사법리스크 우려는 일축했고 비명계 반발은 거세졌다고 전했다.",
