        "term": [
            {
                "speaker_id": "1",
                "transcription": "바로 이어서 기념촬영이 있겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.956
            },
            {
                "speaker_id": "2",
                "transcription": "서울 동대문구의회 개원식 의원들 가슴엔 꽃이 달렸고 행사장엔 꽃장식들이 놓였습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.966,
                "end": 10.383
            },
            {
                "speaker_id": "2",
                "transcription": "신년회 때도 비슷한 모습이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.393,
                "end": 13.083
            },
            {
                "speaker_id": "2",
                "transcription": "꽃을 구매한 곳은 구의회 내부 문서에 남아있습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.093,
                "end": 17.240
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 위치가 강동구 상일동입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.250,
                "end": 20.611
            },
            {
                "speaker_id": "2",
                "transcription": "구의회로부터 13킬로미터가량 떨어진 곳에서 꽃을 사 왔다는 얘기입니다.",
                "sound_type": [
                    2
                ],
                "start": 20.621,
                "end": 25.825
            }
        ]
    },
    "summary": "서울 동대문구의회 개원식 의원들 가슴엔 꽃이 달렸고 행사장엔 꽃장식들이 놓였있는데 이 꽃들은 모두 구의회로부터 13킬로미터가량 떨어진 강동구에서 사 왔다.",
