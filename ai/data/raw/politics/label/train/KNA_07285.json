        "term": [
            {
                "speaker_id": "1",
                "transcription": "인수위가 민간에 맡기겠다고 했던 원자재 가격과 납품단가의 연동",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.636
            },
            {
                "speaker_id": "2",
                "transcription": "원자재 가격이 폭등하게 됐을 때 어떻게 지원을 할 계획이신지",
                "sound_type": [
                    2
                ],
                "start": 4.646,
                "end": 9.441
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보자는 해묵은 문제인 만큼 자율에 맡겨선 안 된다며 법제화 의지를 나타냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.451,
                "end": 15.473
            },
            {
                "speaker_id": "3",
                "transcription": "최소한 그 납품단가를 연동해야 된다라는 문구가 반드시 계약서에 들어가야 하고 행해야 된다라는 거 정도는 중기부 이름으로 입법화를 추진할 생각입니다.",
                "sound_type": [
