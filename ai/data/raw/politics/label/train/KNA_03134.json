        "term": [
            {
                "speaker_id": "1",
                "transcription": "환경부 블랙리스트 의혹 사건도 쟁점이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.564
            },
            {
                "speaker_id": "2",
                "transcription": "이거 옳지 않죠?",
                "sound_type": [
                    2
                ],
                "start": 3.574,
                "end": 5.377
            },
            {
                "speaker_id": "2",
                "transcription": "이게 정의에 부합합니까?",
                "sound_type": [
                    2
                ],
                "start": 5.387,
                "end": 7.405
            },
            {
                "speaker_id": "3",
                "transcription": "그 당시 사회적 물의를 일으킨 것도 맞고요.",
                "sound_type": [
                    2
                ],
                "start": 7.415,
                "end": 11.264
            },
            {
                "speaker_id": "3",
                "transcription": "법원의 판단을 두고 있는 상황에서 제가 이렇다 저렇다",
