        "term": [
            {
                "speaker_id": "1",
                "transcription": "과거 문 정부에서 따로 지시받으신 내용도 있으셨었나요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.185
            },
            {
                "speaker_id": "2",
                "transcription": "항상 법과 규정을 저희들이 준수하면서 업무를 처리드렸다는 말씀드리고 싶습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.195,
                "end": 9.726
            },
            {
                "speaker_id": "3",
                "transcription": "백 전 장관은 혐의를 부인했지만 검찰은 찍어내기 식 인사가 있었다고 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.736,
                "end": 15.301
            },
            {
                "speaker_id": "3",
                "transcription": "호텔과 식당 등으로 기관장을 한 명씩 불러내 사직 요구를 했단 겁니다.",
