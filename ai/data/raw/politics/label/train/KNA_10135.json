        "term": [
            {
                "speaker_id": "1",
                "transcription": "특히 강원 특별 자치도 지정을 통해 지역 발전의 원동력을 마련하겠다고 강조합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.787
            },
            {
                "speaker_id": "2",
                "transcription": "강원도 특별 자치도를 이끌 특별한 도지사는 일을 잘하는 이광재가 맡아야 강원도가 위대해질 수 있다는",
                "sound_type": [
                    2
                ],
                "start": 5.797,
                "end": 15.511
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 김진태 후보 역시 특별 자치도 지정을 약속하면서 삼성 반도체 공장 원주 유치 한국 은행 본점 춘천 유치 등 발전 공약을 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.521,
                "end": 26.476
            },
            {
                "speaker_id": "1",
                "transcription": "이를 위해 힘 있는 여당 도지사가 필요하다고 강조합니다.",
                "sound_type": [
                    2
                ],
                "start": 26.486,
                "end": 30.551
            },
            {
                "speaker_id": "3",
                "transcription": "강원 도정 민주당에서 12년을 했기 때문에 이번에야말로 반드시 교체해야 한다 제가 한 번 꼭 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.561,
                "end": 39.339
            }
        ]
    },
    "summary": "민주당 이광재 후보는 강원 특별 자치도 지정을 통해 각 지역 발전의 원동력을 마련하겠다고 공약했으며 국민의힘 김진태 후보도 삼성 반도체 공장 원주 유치 등 힘 있는 여당 도지사가 필요하다고 강조했다.",
