        "term": [
            {
                "speaker_id": "1",
                "transcription": "해서 마련한 건 아닙니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.572
            },
            {
                "speaker_id": "2",
                "transcription": "어 그래서는 안 된다고 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 1.582,
                "end": 3.719
            },
            {
                "speaker_id": "2",
                "transcription": "어 이 세출 구조 조정이 필요하다고 저는 느끼고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.729,
                "end": 7.357
            },
            {
                "speaker_id": "3",
                "transcription": "반면 홍남기 부총리는 3차 추경 때 적자 국채 발행이 불가피하다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.367,
                "end": 13.384
            },
            {
                "speaker_id": "4",
                "transcription": "상당 부분은 제가 보기에 어 대부분이 적자 국채로 충당이 불가피한 상황입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.394,
                "end": 20.093
            },
            {
                "speaker_id": "3",
                "transcription": "홍남기 부총리는 다만 재난 지원금 지급 대상을 둘러싼 당정의 엇박자와 관련해 정책 방향이 정해지면 내각은 원팀으로 일한다고 강조했습니다.",
                "sound_type": [
                    2
                ],
