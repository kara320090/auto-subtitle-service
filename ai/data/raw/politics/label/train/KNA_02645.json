        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 진화에 나서면서도 해당 발언에 대해선 사과를 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.084
            },
            {
                "speaker_id": "2",
                "transcription": "거기에 부화뇌동하는 이 정치인의 행태를 갔다가 지적하고 비판한 것으로 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.094,
                "end": 13.175
            },
            {
                "speaker_id": "3",
                "transcription": "국무 위원으로서의품위에 맞지 않는 행동이라고 저도 판단합니다.",
                "sound_type": [
                    2
                ],
                "start": 13.185,
                "end": 17.025
            },
            {
                "speaker_id": "3",
                "transcription": "그 부분에 대해서는 사과를 해 주시기를 부탁드리고요.",
                "sound_type": [
                    2
                ],
                "start": 17.035,
                "end": 20.460
            },
            {
                "speaker_id": "1",
                "transcription": "한 장관은 우원식 내결 위원장의 거듭된 사과 요구도 곧장 거부했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.470,
                "end": 25.935
            },
            {
                "speaker_id": "4",
                "transcription": "매우 이 잘못된 이야기입니다.",
                "sound_type": [
                    2
                ],
                "start": 25.945,
                "end": 28.586
            },
            {
                "speaker_id": "4",
                "transcription": "그 부분에 대해서 사과하실 의사가 있습니까?",
                "sound_type": [
                    2
                ],
                "start": 28.596,
                "end": 31.132
            },
            {
                "speaker_id": "5",
                "transcription": "저는 음해를 받은 당사자로서 할 수 있는 얘기라고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 31.142,
                "end": 35.035
            }
        ]
    },
