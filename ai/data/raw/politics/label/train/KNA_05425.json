        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘부터 감사원 앞에서 릴레이 1인 시위를 이어가는 한편 국회 안 규탄 대회도 가졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.682
            },
            {
                "speaker_id": "2",
                "transcription": "위법적이고 비정상적인 행태이다.",
                "sound_type": [
                    2
                ],
                "start": 6.692,
                "end": 10.749
            },
            {
                "speaker_id": "2",
                "transcription": "감사원을 정권의 하수인으로 전락시킨 당사자는 누구인가.",
                "sound_type": [
                    2
                ],
                "start": 10.759,
                "end": 16.774
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 대통령은 국민 앞에 답하라.",
                "sound_type": [
                    2
                ],
                "start": 16.784,
                "end": 21.036
            },
            {
                "speaker_id": "1",
                "transcription": "한편 감사원은 연이틀 입장문을 내고 사실 관계 파악을 위해 퇴직 공무원에게도 출석과 답변을 요구할 수 있다며 문 전 대통령에 대한 조사 정당성을 거듭 주장했습니다.",
                "sound_type": [
                    2,
                    5
