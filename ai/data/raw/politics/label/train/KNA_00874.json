        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "초유의 사태가 벌어졌다면서요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.970
            },
            {
                "speaker_id": "2",
                "transcription": "예. 검찰 역사상 처음 있는 일입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.980,
                "end": 7.182
            },
            {
                "speaker_id": "2",
                "transcription": "여야가 국회 의장 중재안에 합의했다는 소식이 들려오자 김오수 검찰 총장은 곧바로 사직서를 제출 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.192,
                "end": 14.226
            },
            {
                "speaker_id": "2",
                "transcription": "이 모든 상황에 책임을 지겠다고 밝혔는데요.",
                "sound_type": [
                    2
                ],
                "start": 14.236,
                "end": 17.243
            },
            {
                "speaker_id": "2",
                "transcription": "마지막까지 최선을 다하겠다며 사의를 거둬들인지 어 사퇴한지 사의를 거둬들인지 불과 나흘 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.253,
                "end": 24.454
            },
            {
                "speaker_id": "2",
                "transcription": "뒤이어 박성 박성진 대검 차장과 전국 고검장 6명도 사직서를 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.464,
                "end": 29.663
            },
            {
                "speaker_id": "2",
                "transcription": "검찰 최고 지휘부가 중재안에 항의하며 모두 직을 던진 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 29.673,
                "end": 33.763
            },
            {
                "speaker_id": "2",
                "transcription": "김 총장은 어제 박병석 국회 의장을 만나 검찰 수사의 공정성과 중립성을 확보할 자체 개혁안과 특별을 제안했는데요.",
                "sound_type": [
                    2
                ],
                "start": 33.773,
                "end": 41.653
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 오 오늘 박 의장의 중재안에는 이런 제안이 반영되지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.663,
                "end": 46.980
            }
        ]
    },
    "summary": "김 총장이 국회 의장을 만나 제안했지만 반영되지 않았으며 여야가 중재안에 합의했다는 소식이 들리자 검찰 지휘부가 항의하며 사직서를 냈다고 전했다.",
