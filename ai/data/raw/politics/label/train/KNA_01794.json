                ],
                "start": 0.000,
                "end": 7.212
            },
            {
                "speaker_id": "1",
                "transcription": "이거 대통령 선거가 끝나더라도 특검해가지고 반드시 특검하자는 거 동의해 주시고",
                "sound_type": [
                    2
                ],
                "start": 7.222,
                "end": 12.431
            },
            {
                "speaker_id": "2",
                "transcription": "지금 뭐 대통령 선거가 국민학교 애들 반장선겁니까?",
                "sound_type": [
                    2
                ],
                "start": 12.441,
                "end": 16.149
            },
            {
                "speaker_id": "2",
                "transcription": "쯧 정확하게 수사가 이뤄지지 않고 덮었지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 16.149,
                "end": 19.860
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 특검하자니까요.",
