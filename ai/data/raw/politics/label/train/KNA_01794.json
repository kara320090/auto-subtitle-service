        "term": [
            {
                "speaker_id": "1",
                "transcription": "벌써 몇 번째 울궈먹는 건지 모르겠는 데 에 정말 국민의 삶을 놓고 계속 이러시는 거 이해가 안 됩니다.",
                "sound_type": [
