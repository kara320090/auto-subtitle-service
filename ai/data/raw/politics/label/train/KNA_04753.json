            },
            {
                "speaker_id": "2",
                "transcription": "윤 후보는 이준석 대표의 당무 복귀와 관련해선 무리하게 압박하듯 할 생각은 없었다며 재충전하길 바란다고 했습니다.",
                "sound_type": [
