        "term": [
            {
                "speaker_id": "1",
                "transcription": "그로부터 7개월이 지났지만 아직도 조사 단계에 머물러 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.226
            },
            {
                "speaker_id": "2",
                "transcription": "진도가 법까지 나갈 수 없는 게 어느 정도 정의가 나와야 그니까 가족들 가족의 범위가 어떨지 중고등학교에 뿌렸는데 응답률이 너무 낮아서 기간을 계속 연장했거든요.",
                "sound_type": [
                    2
                ],
                "start": 4.236,
                "end": 15.299
            },
            {
                "speaker_id": "1",
                "transcription": "가족 돌봄 청년들은 사회로부터 철저히 외면받고 있다는 극한의 고립감 속에 하루하루를 버티고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.309,
                "end": 22.732
            },
            {
                "speaker_id": "3",
                "transcription": "방치되고 고립됐다고 전 여기거든요.",
                "sound_type": [
                    2
                ],
                "start": 22.742,
                "end": 25.273
            },
            {
                "speaker_id": "3",
                "transcription": "보호자가 되는 법을 살면서 배운 적이 없잖아요.",
                "sound_type": [
                    2
                ],
                "start": 25.283,
