        "term": [
            {
                "speaker_id": "1",
                "transcription": "1열 비대 위원 쓰러지니까 또 2열 비대 위원 가는 거예요 지금.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.772
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 나 가지고 그럼 뒤로 왜 못 빠지느냐?",
                "sound_type": [
                    2
                ],
                "start": 2.782,
                "end": 5.724
            },
            {
                "speaker_id": "1",
                "transcription": "물러나면 기관총으로 쏜다 이러고 있는 거죠 지금 보면은.",
                "sound_type": [
                    2
                ],
                "start": 5.734,
                "end": 8.504
            },
            {
                "speaker_id": "1",
                "transcription": "그 기관총을 누가 들고 있는지 모르겠지마는",
                "sound_type": [
                    2
                ],
                "start": 8.514,
                "end": 11.231
            },
            {
                "speaker_id": "2",
                "transcription": "이 전 대표 측은 정당은 치외법권 지역이 아니고 헌법과 법률 기반은 심판한다는 게 대법원 판례라며 물러설 뜻이 없음을 강조했습니다.",
                "sound_type": [
