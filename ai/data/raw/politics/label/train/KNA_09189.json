        "term": [
            {
                "speaker_id": "1",
                "transcription": "국토부가 지난 9월 국회에 제출한 자료입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.987
            },
            {
                "speaker_id": "1",
                "transcription": "품목 확대에 화주들이 반대하고 있다 기술적 현실적 적용 가능성을 고려해 신중하게 접근해야 한다는 입장을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.997,
                "end": 11.341
            },
            {
                "speaker_id": "2",
                "transcription": "국토교통부는 공식적으로 합의를 파기합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.351,
                "end": 14.861
            },
            {
                "speaker_id": "2",
                "transcription": "품목 확대가 기술적으로 불가능하다 안전운임 지속 추진 제도 확대는 어렵다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.871,
                "end": 19.903
            },
            {
                "speaker_id": "1",
                "transcription": "화물연대는 당정이 안전운임제의 품목 확대가 불가하다는 입장을 공식화한 것은 책임을 회피하는 것이라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.913,
                "end": 28.382
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 예정대로 모레부터 총파업에 들어가겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.392,
                "end": 32.966
            }
        ]
    },
    "summary": "화물연대는 모레부터 총파업에 돌입할 예정이다.",
