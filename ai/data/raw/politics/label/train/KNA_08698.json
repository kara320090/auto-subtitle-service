        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 알려드린 것임에도 미흡했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.486
            },
            {
                "speaker_id": "2",
                "transcription": "당초 우리 측 사격 계획은 현무 투 한 발과 에이테큼스 한 발이었던 사실도 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.496,
                "end": 8.917
            },
            {
                "speaker_id": "2",
                "transcription": "현무 투 발사 실패로 우리 측도 에이테큼스 두 발을 쐈는데도 사격 성공 사실만 보도자료로 홍보했다고 야당 의원들은 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.927,
                "end": 18.885
            },
            {
                "speaker_id": "3",
                "transcription": "아 이렇게 중대한 상황에 있어서 이렇게 에 보도자료를 냈다라고 하는 것은 은폐하겠다라고하는 의도를 갖고 있다라고",
                "sound_type": [
                    2
                ],
                "start": 18.895,
                "end": 27.415
            },
            {
                "speaker_id": "2",
                "transcription": "여당 의원들은 군사분계선 15킬로미터 인근 무인 표적기 비행을 금지한 919 군사 합의로 고성 사격장을 사용하지 못하게 돼 강릉 도심 주민들이 피해를 봤다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.425,
                "end": 39.343
            },
            {
                "speaker_id": "4",
                "transcription": "왜 미사일을 강릉에서 발사하냔 말이예요.",
                "sound_type": [
                    2
                ],
                "start": 39.353,
                "end": 42.674
            },
            {
                "speaker_id": "5",
                "transcription": "사격을 할 수 있는 여건이 되는 곳을 찾은 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 42.684,
                "end": 46.595
            },
            {
                "speaker_id": "4",
                "transcription": "이거 계속 여기다 놓을 겁니까?",
                "sound_type": [
                    2
                ],
                "start": 46.605,
                "end": 48.335
            },
            {
                "speaker_id": "4",
                "transcription": "북한이 지금 현재 구일구 군사 합의를 다 깼는데?",
                "sound_type": [
                    2
                ],
                "start": 48.345,
                "end": 51.518
            }
        ]
    },
    "summary": "당초 우리 측 사격 계획은 현무 투 한 발과 에이테큼스 한 발이었던 사실도 확인됐는데 야당 의원들은 현무 투 발사 실패로 우리 측도 에이테큼스 두 발을 쐈는데도 사격 성공 사실만 보도자료로 홍보했다고 지적했습니다.",
