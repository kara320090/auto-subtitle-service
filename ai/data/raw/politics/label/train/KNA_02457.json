        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "코로나19로 중단됐던 예비군 소집 훈련이 내일 다시 시작되는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.647
            },
            {
                "speaker_id": "1",
                "transcription": "과학화 훈련 현장을 이세연 기자가 미리 다녀왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.657,
                "end": 9.484
            },
            {
                "speaker_id": "2",
                "transcription": "서울 한남 대교를 그대로 옮긴 가상 현실 적의 총격에 맞서 치열한 전투를 벌입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.494,
                "end": 19.726
            },
            {
                "speaker_id": "3",
                "transcription": "한남 대교를 통한 적 고속 침투가 예상되고 있다.",
                "sound_type": [
                    2
                ],
                "start": 19.736,
                "end": 22.333
            },
            {
                "speaker_id": "3",
                "transcription": "적은 민간인 복장을 한 다수의 인원이므로",
                "sound_type": [
                    2
                ],
                "start": 22.343,
                "end": 25.156
            },
            {
                "speaker_id": "2",
                "transcription": "정확한 사격으로 적을 제압하고 참호에서 총탄을 피하며 실전 능력을 키웁니다.",
                "sound_type": [
                    2
                ],
                "start": 25.166,
                "end": 31.948
            },
            {
                "speaker_id": "2",
                "transcription": "이 모의 사격을 할 때 입는 전투 조끼입니다.",
                "sound_type": [
                    2
                ],
                "start": 31.958,
                "end": 34.976
            },
            {
                "speaker_id": "2",
                "transcription": "가상 현실에서의 피격 부위가 바로 인식되고 아 실제 피격과 비슷한 수준의 반동을 느낄 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.986,
                "end": 42.249
            },
            {
                "speaker_id": "2",
                "transcription": "도심 거리를 본딴 시가지 전투 훈련장에서는 청군과 황군의 모의 전투가 한창입니다.",
                "sound_type": [
                    2
                ],
                "start": 42.259,
                "end": 49.382
            }
        ]
    },
    "summary": "코로나19로 중단됐던 예비군 소집 훈련이 내일 다시 시작되는데 서울 한남대교를 그대로 옮긴 가상 현실로 적의 총격에 맞서 치열한 전투를 벌이며 가상 현실에서의 피격 부위가 바로 인식되고 실제 피격과 비슷한 수준의 반동을 느낄 수 있습니다.",
