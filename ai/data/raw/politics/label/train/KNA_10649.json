        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 자신의 소득 수준은 어느 정도라고 생각하는지 물었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.034
            },
            {
                "speaker_id": "1",
                "transcription": "10점 만점에 4점 초반대.",
                "sound_type": [
                    2
                ],
                "start": 4.044,
                "end": 6.177
            },
            {
                "speaker_id": "1",
                "transcription": "다른 집단보다 낮았고 소득 수준이 몇 점 정도면 만족하겠냐는 질문에도 기대치가 가장 낮았습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.187,
                "end": 13.408
            },
            {
                "speaker_id": "1",
                "transcription": "소속감에 대한 질문에서도 특징이 나타났습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.418,
                "end": 16.489
            },
            {
                "speaker_id": "1",
                "transcription": "가족과 직장에 대한 소속감은 다른 집단과 비슷했지만 국가 종교 친구 등에는 소속감을 덜 느꼈습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.499,
                "end": 24.424
            }
        ]
    },
    "summary": "자신이 생각하는 자신의 소득 수준 점수와 소속감에 대한 질문을 했다.",
