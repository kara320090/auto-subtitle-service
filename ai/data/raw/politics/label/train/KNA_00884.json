        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하십니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.562
            },
            {
                "speaker_id": "1",
                "transcription": "코로나 19 통합 뉴스룸 KBS 7시 뉴스입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.572,
                "end": 3.301
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 수사권을 단계적으로 폐지하는 내용의 여야 합의안이 사흘 만에 백지화될 처지에 놓였습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.311,
                "end": 9.902
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘이 공직자와 선거 범죄 수사권까지 폐지하는 건 신중해야 한다며 재논의를 공식화하자 민주당은 합의 파기라며 법안을 강행 처리 수순에 돌입했는데요.",
                "sound_type": [
                    2
                ],
                "start": 9.912,
                "end": 21.014
            },
            {
                "speaker_id": "1",
                "transcription": "첫 소식으로 임종빈 기자가 보도합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.024,
                "end": 24.069
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 힘이 최고 위원회를 열어 여야가 합의한 검찰 수사권 폐지 중재안을 재논의해야 한다는 결론을 내렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.079,
                "end": 33.535
            },
            {
                "speaker_id": "2",
                "transcription": "중재안은 공직자 범죄와 선거 범죄 수사에 대한 검찰 직접 수사를 포함하지 않아 미흡하다는 이유입니다.",
                "sound_type": [
                    2
                ],
                "start": 33.545,
                "end": 40.900
            },
            {
                "speaker_id": "2",
                "transcription": "이준석 대표는 공청회를 열고 한동훈 법무 장관 후보자 인사 청문회에서 논의를 이어가자고 재차 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.910,
                "end": 48.748
            }
        ]
    },
    "summary": "여야가 합의한 검찰 수사권 폐지 중재안은 공직자 범죄와 선거 범죄 수사에 대한 검찰 직접 수사를 포함하지 않아 미흡하다는 이유에서 검찰 수사권을 단계적으로 폐지하는 내용의 여야 합의안이 사흘 만에 백지화될 처지에 놓였습니다.",
