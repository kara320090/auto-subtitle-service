        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러나 한국당 소속 법사위원장인 삼선 여상규 의원이 오늘 불출마를 선언하며 지도부 책임론을 공개 제기해 당내 갈등 불씨도 커지고 있습니다.",
                "sound_type": [
                    2,
