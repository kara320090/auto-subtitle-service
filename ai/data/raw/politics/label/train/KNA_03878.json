        "term": [
            {
                "speaker_id": "1",
                "transcription": "속칭 김부선이라는 논란 속에 이번엔 노선 결정이 정부 마음대로라는 국토부 담당자 발언이 나왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.945
            },
            {
                "speaker_id": "2",
                "transcription": "깔아줄 의무가 없어요 우리 부에 이거는 우리 부의 자율 재량이에요 법적으로",
                "sound_type": [
                    2
                ],
                "start": 7.955,
                "end": 12.159
            },
            {
                "speaker_id": "3",
                "transcription": "아 자율 재량인가요?",
                "sound_type": [
                    2
                ],
                "start": 12.169,
                "end": 13.401
            },
            {
                "speaker_id": "2",
                "transcription": "예. 공청회도 저희가 립서비스로 해 드린 거예요. 원래 안 해도 되는 데 그냥 립서비스로 해 드린 거예요.",
                "sound_type": [
                    2
                ],
                "start": 13.411,
                "end": 18.200
            },
            {
                "speaker_id": "1",
                "transcription": "노선 결정에 정치적 외압이 작용한다는 취지의 말까지 나옵니다.",
                "sound_type": [
                    2
                ],
