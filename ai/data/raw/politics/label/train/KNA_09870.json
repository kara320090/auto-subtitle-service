        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘 내부에선 과잉 대응이라는 지적이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.509
            },
            {
                "speaker_id": "1",
                "transcription": "무시하면 되는데 당원도 아닌 사람의 말을 키워 준다.",
                "sound_type": [
                    2
                ],
                "start": 3.519,
                "end": 8.056
            },
            {
                "speaker_id": "1",
                "transcription": "당이 대응해 언론의 관심만 받게 한다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 8.066,
                "end": 11.580
            },
            {
                "speaker_id": "1",
                "transcription": "동시에 전 목사에 대해서도 제도권 정치에 개입하려는 안 좋은 행동이다.",
                "sound_type": [
                    2
                ],
                "start": 11.590,
                "end": 17.213
            },
            {
                "speaker_id": "1",
                "transcription": "분열과 갈등을 조장한다는 비판이 제기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.223,
                "end": 20.508
            },
            {
                "speaker_id": "2",
                "transcription": "우리 당원도 아닌 사람이 당의 공천에 감 놔라 배 놔라 하는 작전은 어처구니가 없으면서도 매우 불쾌하기 짝이 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.518,
                "end": 30.430
            }
        ]
    },
