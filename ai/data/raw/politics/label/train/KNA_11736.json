        "term": [
            {
                "speaker_id": "1",
                "transcription": "이동관 특보 아들의 한 학원 동기생으로 2012년 학교 폭력 피해 진술서를 썼던 당사자가 KBS에 보낸 입장문입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.364
            },
            {
                "speaker_id": "1",
                "transcription": "진술서에 과장되거나 왜곡된 부분이 많다.",
                "sound_type": [
                    2
                ],
                "start": 8.374,
                "end": 12.162
            },
            {
                "speaker_id": "1",
                "transcription": "학교 폭력 피해자로 간주되는 게 너무 큰 스트레스라며 피해자로 분류하지 말 것을 요청했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.172,
                "end": 18.768
            },
            {
                "speaker_id": "1",
                "transcription": "당시 이 특보 아들과 화해해 전학을 막아 달라고 선생님들에게 읍소했고 최근에도 만나는 등 교류를 이어가고 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.778,
                "end": 27.927
            },
            {
                "speaker_id": "1",
                "transcription": "다만 자신의 입장은 다른 피해 학생들과 다를 수 있다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.937,
                "end": 32.766
            }
        ]
    },
    "summary": "이 특보 아들의 학교 폭력 피해 진술서를 썼던 당사자는 입장문에서 피해자로 분류하지 말 것을 요청했다.",
