        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 불과 어 몇 개월 만에 정부 입장이 이렇게 바뀌었다는 것은 도저히 이해할 수 없는 입장이고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.828
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 힘 의원들은 3년 연장안을 걷어차고 거리로 나간 건 민주 노총이라며 상황이 달라진 만큼 원점 재검토가 필요하다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.838,
                "end": 16.193
            },
            {
                "speaker_id": "2",
                "transcription": "민주당이 민주 노총에 퇴로를 만들어주려 하수인 노릇을 했다고도 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.203,
                "end": 21.755
            },
            {
                "speaker_id": "3",
                "transcription": "너무나 막대한 그 국가 경제 손실을 저기 낳았습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.765,
                "end": 26.453
            },
            {
                "speaker_id": "3",
                "transcription": "그럼에도 불구하고 아무 일이 없었다는 듯이 그냥 들어와 가지고 3년 연장안을 그냥 통과시킨다 이건 있을 수가 없죠.",
                "sound_type": [
                    2
                ],
