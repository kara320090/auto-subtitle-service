        "term": [
            {
                "speaker_id": "1",
                "transcription": "대검찰청도 입장문을 내고 민주당이 발의한 법안은 명백한 헌법 위반이라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.334
            },
            {
                "speaker_id": "1",
                "transcription": "인신 구속이나 주거지 수색 때 검사의 신청에 의하여 법관이 발부한 영장을 제시해야 한다는 헌법 조문을 그 근거로 들었는데 이 조문이 검사를 수사 주체로 규정한 조문이라는 해석인 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.344,
                "end": 20.639
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘도 압박 수위를 높였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.649,
                "end": 23.677
            },
            {
                "speaker_id": "1",
                "transcription": "검찰과 야당뿐 아니라 민변과 참여 연대 등도 성급한 입법이라고 반대하고 있다면서 이렇게 서두르는 이유가 뭐냐고 따져 물었습니다.",
                "sound_type": [
                    2,
                    5
