        "term": [
            {
                "speaker_id": "1",
                "transcription": "출근길 윤석열 대통령은 일본 해상 자위대가 참여한 한미일 군사 훈련 논란을 사실상 일축했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.211
            },
            {
                "speaker_id": "2",
                "transcription": "핵 위협 앞에서 어떠한 우려가 아 정당화될 수 있겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 7.221,
                "end": 14.415
            },
            {
                "speaker_id": "2",
                "transcription": "현명한 국민들께서 에 잘 판단하실 거로",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.425,
                "end": 19.273
            },
            {
                "speaker_id": "1",
                "transcription": "정치권의 안보 공방은 친북 친일 논쟁으로 치달았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.283,
                "end": 23.928
            },
            {
                "speaker_id": "3",
                "transcription": "지금 우리가 경계해야 할 것은 극단적인 친일이 아니라 극단적인 친북 아닙니까?",
                "sound_type": [
                    2
                ],
                "start": 23.938,
                "end": 29.397
            },
            {
                "speaker_id": "3",
                "transcription": "우리의 주적이 어디인지 정녕 모르신다는 말입니까?",
                "sound_type": [
                    2
                ],
                "start": 29.407,
                "end": 33.326
            },
            {
                "speaker_id": "4",
                "transcription": "시대착오적인 종북 몰이 그리고 색깔론 공세를 펼치고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.336,
