        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인이 내일 대한민국의 20대 대통령으로 취임합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.821
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인은 오늘 밤 자정 군 통수권을 넘겨 받으면서 5년간의 임기를 시작하게 되는데요.",
                "sound_type": [
                    2
                ],
                "start": 4.831,
                "end": 11.066
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 먼저 대통령 집무실이 마련된 용산을 연결해 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.076,
                "end": 15.409
            },
            {
                "speaker_id": "1",
                "transcription": "자 노태현 기자 아 오늘 자정부터 그곳 국방부 청사가 이제 대통령 집무실로 바뀌게 될 텐데 지금 분위기는 어떻습니까?",
                "sound_type": [
                    2
                ],
                "start": 15.419,
                "end": 23.665
            },
            {
                "speaker_id": "2",
                "transcription": "네 저는 지금 대통령 집무실이 마련된 서울 용산 국방부 청사에 들어와 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.675,
                "end": 31.395
            },
            {
                "speaker_id": "2",
                "transcription": "이제 약 5시간 뒤인 오늘 밤 자정부터 윤석열 대통령의 임기가 시작됩니다.",
                "sound_type": [
                    2
                ],
                "start": 31.405,
                "end": 37.153
            },
            {
                "speaker_id": "2",
                "transcription": "동시에 이곳 국방부 청사도 대통령 집무실로 바뀌게 되는데 청사에는 이미 대통령을 상징하는 봉황 휘장도 걸렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.163,
                "end": 46.174
            },
            {
                "speaker_id": "2",
                "transcription": "기존 국방부 인력과 설비는 대부분 이전을 끝냈고 새 대통령을 맞이할 준비도 마친 상태입니다.",
                "sound_type": [
                    2
                ],
                "start": 46.184,
                "end": 53.787
            }
        ]
    },
    "summary": "윤석열 당선인은 오늘 밤 자정부터 대통령으로서 5년간의 임기를 시작하며 국방부 청사가 대통령 집무실로 마련되었다.",
