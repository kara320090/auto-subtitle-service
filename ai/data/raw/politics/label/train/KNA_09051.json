        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회 본회의를 앞두고 여야가 나란히 의원 총회를 열었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.988
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 이재명 살리기라며 거듭 반대했고 민주당은 국민의 명령이라며 참여를 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.998,
                "end": 11.922
            },
            {
                "speaker_id": "2",
                "transcription": "강제력을 동원한 수사 방법으로는 밝힐 수 있고 국정 조사 방식으로는 관계자들을 불러서 강제력이 없기 때문에 정쟁과 호통만 있을 것이라고.",
                "sound_type": [
                    2
                ],
                "start": 11.932,
                "end": 22.740
            },
            {
                "speaker_id": "3",
                "transcription": "국정 조사 청문회는 물론이고 필요하다면 이제는 특검도 본격 추진해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 22.750,
                "end": 28.379
            },
            {
                "speaker_id": "3",
                "transcription": "그것이 국회의 존재 이유고 정치가 필요한 이유입니다.",
                "sound_type": [
                    2
                ],
                "start": 28.389,
                "end": 30.330
            }
        ]
    },
    "summary": "여야가 의원 총회를 열고 국민의힘은 이재명 살리기라며 거듭 반대했고 민주당은 국민의 명령이라며 참여를 촉구했다.",
