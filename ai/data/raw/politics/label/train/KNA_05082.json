        "term": [
            {
                "speaker_id": "1",
                "transcription": "이재명 박용진 강훈식 의원의 삼자대결로 압축된 민주당 당대표 선거 대세론을 앞세운 이재명 후보에 맞서 97그룹에 속하는 박용진 강훈식 후보가 단일화를 통해 1 대 1 구도를 만들지가 변수입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 14.917
            },
            {
                "speaker_id": "1",
                "transcription": "박용진 후보는 단일화는 이룰수록 좋다며 후보 간 회동을 거쳐 실무 협의에 착수하자고 강 후보 측에 제안했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.927,
                "end": 23.397
            },
            {
                "speaker_id": "2",
                "transcription": "당심과 민심을 담는 어떤 방식도 다 수용하겠습니다.",
                "sound_type": [
                    2,
