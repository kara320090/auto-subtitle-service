                ],
                "start": 0.000,
                "end": 3.487
            },
            {
                "speaker_id": "1",
                "transcription": "스스로를 병역의 신이라고 소개하며 공정한 병역 이행을 돕는다고 홍보합니다.",
                "sound_type": [
