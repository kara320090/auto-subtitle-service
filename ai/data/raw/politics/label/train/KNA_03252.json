        "term": [
            {
                "speaker_id": "1",
                "transcription": "사법농단이 시작됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.202
            },
            {
                "speaker_id": "1",
                "transcription": "우리 국회의 직무유기가 사법농단에 일조한 격입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.212,
                "end": 7.738
            },
            {
                "speaker_id": "2",
                "transcription": "표결에 참여한 국민의힘은 1심에서 무죄를 받은 판사를 탄핵하는 건 사법부 길들이기라고 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.748,
                "end": 21.748
            },
            {
                "speaker_id": "3",
                "transcription": "1년 전에는 가만히 있다가 갑자기 지금 추진한 이유가 뭡니까? 재판에 강한 영향을 주고 싶은 마음 없다고 부인하기 어려울 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 21.758,
                "end": 33.666
            }
        ]
    },
    "summary": "국민의힘은 1심에서 무죄를 받은 판사를 탄핵하는 건 사법부 길들이기라고 주장했고 재판에 강한 영향을 주고 싶은 마음이 없다고 부인하기 어려울 거라고 말했다.",
