        "term": [
            {
                "speaker_id": "1",
                "transcription": "후보 등록 날 제주 행을 택한 민주당 이재명 후보.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.484
            },
            {
                "speaker_id": "1",
                "transcription": "사삼 사건 희생자를 참배하면서 보복의 낡은 시대를 넘겠다고 방명록에 적었습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.494,
                "end": 9.793
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보의 전 정권 수사 발언을 염두에 둔 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 9.803,
                "end": 14.311
            },
            {
                "speaker_id": "1",
                "transcription": "이어진 즉석 연설에서도 공한 정치의 나라로 되돌아가자는 거냐고 호소했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.321,
                "end": 19.963
            },
            {
                "speaker_id": "2",
                "transcription": "촛불도 엄단하고 언론사도 마구 폐쇄해 버리고 5년짜리가 감히 검찰에 겁도 없이 달려드느냐.",
                "sound_type": [
                    2
                ],
                "start": 19.973,
                "end": 31.754
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 생각하는 검찰 국가가 된다면 그게 누구의 불행이겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 31.764,
                "end": 38.605
            }
        ]
    },
    "summary": "후보 등록 날 민주당 이재명 후보는 제주 행을 택했다.",
