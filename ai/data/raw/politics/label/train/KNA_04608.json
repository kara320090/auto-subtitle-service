        "term": [
            {
                "speaker_id": "1",
                "transcription": "1989년 지어진 국내 1호 영구 임대 아파트 거주민의 대부분인 노인들은 엘리베이터가 없어 5층까지 걸어서 올라가야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.814
            },
            {
                "speaker_id": "1",
                "transcription": "스프링쿨러 등 안전시설도 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.824,
                "end": 11.505
            },
            {
                "speaker_id": "2",
                "transcription": "연세 있는 자식들이 모시고 살잖아요.",
                "sound_type": [
                    2
                ],
                "start": 11.515,
                "end": 15.330
            },
            {
                "speaker_id": "2",
                "transcription": "그러다 보니까 평수가 안 맞아서 기존 평소보다 좀 넉넉했으면 하는 네다섯 식구 이상 사는 집도 많으니까",
                "sound_type": [
                    2
                ],
                "start": 15.340,
                "end": 24.315
            },
            {
                "speaker_id": "1",
                "transcription": "국내에서 임대 아파트론 처음으로 재건축이 추진됩니다.",
                "sound_type": [
                    2
                ],
                "start": 24.325,
                "end": 28.048
            },
            {
                "speaker_id": "1",
                "transcription": "현재 640세대 규모인데 1510세대 대단지 아파트로 탈바꿈합니다.",
                "sound_type": [
                    2
                ],
                "start": 28.058,
                "end": 33.099
            }
        ]
    },
    "summary": "국내 1호 영구 임대 아파트가 재건축이 추진된다.",
