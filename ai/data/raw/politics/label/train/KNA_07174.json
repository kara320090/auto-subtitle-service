            },
            {
                "speaker_id": "1",
                "transcription": "의혹의 실마리라고 할 수 있는 고발장 작성자를 끝내 찾지 못했기 때문인데 공수처는 그 이유로 연루된 검사들의 증거 인멸이 결정적이었다고 밝혔습니다.",
                "sound_type": [
                    2,
