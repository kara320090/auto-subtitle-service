        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘 소속 김미나 경남 창원 시의원이 SNS에 올린 게시물입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.942
            },
            {
                "speaker_id": "1",
                "transcription": "이태원 참사 유족을 향해 나라 구하다 죽었냐?",
                "sound_type": [
                    2
                ],
                "start": 4.952,
                "end": 8.621
            },
            {
                "speaker_id": "1",
                "transcription": "자식 팔아 한 몫 챙기자는 수작이라는 글을 연이어 올렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.631,
                "end": 12.595
            },
            {
                "speaker_id": "1",
                "transcription": "민주당을 겨냥해선 노란 리본 우려먹고 이제 깜장 리본 달고 얼마나 우려먹을까라고 썼습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.605,
                "end": 19.487
            },
            {
                "speaker_id": "1",
                "transcription": "파문이 커지자 김 의원은 계정을 비공개로 돌리고 공식 사과했지만 그 과정에서 또 다른 논란을 불렀습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.497,
                "end": 27.067
            },
            {
                "speaker_id": "2",
                "transcription": "유가족 여러분들께 고개 숙여 사과드리며 깊이 반성하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.077,
                "end": 32.999
            }
        ]
    },
    "summary": "국민의힘 소속 김미나 경남 창원 시의원이 SNS에 올린 글이 논란이 됐다.",
