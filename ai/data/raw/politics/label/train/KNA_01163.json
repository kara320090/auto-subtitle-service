        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령은 한미 정상 회담을 통해 합의된 확장 억제 실행력과 연합 방위 태세 강화 등 실질적 조치 이행을 지시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.738
            },
            {
                "speaker_id": "1",
                "transcription": "북한의 대륙 간 탄도 미사일 ICBM 발사는 한반도와 동북아의 긴장을 고조시키는 행위라는 정부 명의의 별도 성명도 발표했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.748,
                "end": 18.360
            },
            {
                "speaker_id": "2",
                "transcription": "유엔 안보리 결의를 정면으로 위반한 불법 행위이자 한반도와 국제 사회의 평화를 위협하는 중대한 도발이다.",
                "sound_type": [
                    2
                ],
                "start": 18.370,
                "end": 29.217
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 이를 강력히 규탄한다.",
                "sound_type": [
                    2
                ],
                "start": 29.227,
                "end": 33.804
            },
            {
                "speaker_id": "1",
                "transcription": "국가 안보실은 북한의 이번 미사일 발사가 신형 ICBM 화성 17형 시험과 함께 핵 투발이 가능하도록 단거리 미사일 성능을 개량하려는 의도라고 해석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.814,
                "end": 45.072
            },
            {
                "speaker_id": "1",
                "transcription": "또 지방 선거 등 우리 정치 일정에 개입하고 새 정부 대비 태세를 시험하며 한미 정상 회담 결과에 반발하는 등의 메시지로 보인다고 설명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.082,
                "end": 55.070
            },
            {
                "speaker_id": "1",
                "transcription": "안보실은 미사일 도발에 이은 북한 핵 실험도 임박한 것으로 판단했습니다.",
                "sound_type": [
                    2
                ],
                "start": 55.080,
                "end": 60.192
            },
            {
                "speaker_id": "1",
                "transcription": "북한의 7차 핵 실험 준비 동향을 주시하고 있다면서 핵 기폭 장치 작동 시험을 하고 있는 것으로 보인다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 60.202,
                "end": 67.597
            },
            {
                "speaker_id": "1",
                "transcription": "안보실은 북한이 실패하지 않을 원하는 규모와 성능을 평가하는 마지막 준비 단계에 임박해 있다면서도 하루 이틀 안에 핵 실험을 할 가능성은 낮다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 67.607,
                "end": 78.583
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 강병수입니다.",
                "sound_type": [
                    2
                ],
                "start": 78.593,
                "end": 81.980
            },
            {
                "speaker_id": "3",
                "transcription": "6일 지방 선거가 일주일 앞으로 다가왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 81.990,
                "end": 85.891
            },
            {
                "speaker_id": "3",
                "transcription": "이번 선거에서는 전국 7개 지역에서 국회 의원 보궐 선거도 함께 치러지는데요.",
                "sound_type": [
                    2
                ],
                "start": 85.901,
                "end": 91.530
            },
            {
                "speaker_id": "3",
                "transcription": "KBS는 이 가운데 관심이 높은 인천 계양을과 경기 분당갑 지역에 대한 여론 조사를 실시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 91.525,
                "end": 99.236
            },
            {
                "speaker_id": "3",
                "transcription": "그 결과를 임종빈 기자가 보도합니다.",
                "sound_type": [
                    2
                ],
                "start": 99.246,
                "end": 102.001
            }
        ]
    },
    "summary": "정부의 북한의 UN 안보리 위반과 한반도 평화 위협 행위에 대해 강력히 규탄하고 북한 7차 핵 실험 준비 동향을 주시하고 있다고 밝혔다.",
