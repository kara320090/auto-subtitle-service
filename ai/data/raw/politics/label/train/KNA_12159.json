        "term": [
            {
                "speaker_id": "1",
                "transcription": "다른 정당들은 일제히 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.980
            },
            {
                "speaker_id": "2",
                "transcription": "차명진을 공천한 황교안 대표는 국민께 사죄하고 사퇴해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 2.980,
                "end": 9.046
            },
            {
                "speaker_id": "3",
                "transcription": "그야말로 인간 이하라고 할 수밖에 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.056,
                "end": 13.012
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 통합당 윤리위원회는 세대 비하 논란을 빚은 김대호 후보 제명을 의결했는데 당사자는 반발하고 있습니다.",
                "sound_type": [
                    1,
                    2,
                    4,
                    5
                ],
                "start": 13.022,
                "end": 21.811
            },
            {
                "speaker_id": "1",
                "transcription": "후보 등록이 이미 마감돼 통합당은 해당 지역구에 후보를 내지 못하게 됐습니다.",
                "sound_type": [
