        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부 자문 위원회는 내부 정보를 악용할 우려 때문에 자문 위원 본인뿐 아니라 직계 가족까지 이해 충돌 기업의 주식을 보유할 수 없도록 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.225
            },
            {
                "speaker_id": "2",
                "transcription": "저는 주식을 이쪽 분야는 생각해 본 적이 없어요.",
                "sound_type": [
                    2
                ],
                "start": 9.235,
                "end": 13.678
            },
            {
                "speaker_id": "2",
                "transcription": "바이오라는 것은 굉장히 광범위해서요.",
