        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 공천 배제 뒤 무소속 출마한 민병두 의원 파란색 점퍼를 입고 유세 차량에 오릅니다.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.470
            },
            {
                "speaker_id": "2",
                "transcription": "교육의 상징, 국격의 상징 이 거대한 변화 누가 만들었습니까 여러분.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 6.470,
                "end": 14.192
            },
            {
                "speaker_id": "1",
                "transcription": "역시 통합당 공천에 탈락한 윤상현 의원은 흰색 점퍼를 입고 거리에 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.202,
                "end": 19.709
            },
            {
                "speaker_id": "3",
                "transcription": "열정과 의지는 기호 1번 때보다 8배 그 이상이라는 사실",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.719,
                "end": 26.133
            },
            {
                "speaker_id": "1",
                "transcription": "이들의 무소속 출마로 서울 동대문을과 인천 동구 미추홀을은 3파전 구도가 형성됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.143,
                "end": 32.454
            },
            {
                "speaker_id": "1",
                "transcription": "해당 지역구의 민주당과 통합당 후보들 당연히 속이 타들어 갑니다.",
                "sound_type": [
                    2
                ],
                "start": 32.464,
                "end": 37.474
            },
            {
                "speaker_id": "4",
                "transcription": "1위가 아니면 더불어민주당을 도와주시겠다 약속을 참 지켜주셨으면 좋겠다는 이런 생각",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.484,
                "end": 43.450
            },
            {
                "speaker_id": "5",
                "transcription": "무소속으로 출마한다는 것은 대의도 명분도 없는 일입니다.",
                "sound_type": [
                    2
                ],
                "start": 43.440,
                "end": 48.186
            },
            {
                "speaker_id": "5",
                "transcription": "민주당만 웃을 뿐이고",
                "sound_type": [
                    2
                ],
                "start": 48.196,
                "end": 50.091
            },
            {
                "speaker_id": "1",
                "transcription": "이번 총선 이렇게 무소속 출마하는 현역 의원은 모두 15명입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 50.101,
                "end": 54.947
            },
            {
                "speaker_id": "1",
                "transcription": "수도권을 비롯해 강원, 대구, 경북, 호남까지 일부 지역은 접전 양상입니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 54.957,
                "end": 60.525
            },
            {
                "speaker_id": "1",
                "transcription": "홍준표 전 대표, 김태호 전 지사 등 원외 거물급 인사의 무소속 출마까지 포함하면 20곳 가깝습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 60.535,
                "end": 68.054
            },
            {
                "speaker_id": "1",
                "transcription": "무소속 후보들 선거 뒤엔 복당하겠다는데 당 지도부는 복당 불허 방침입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 68.064,
                "end": 73.718
            },
            {
                "speaker_id": "6",
                "transcription": "뭐 탈당하여 무소속으로 출마할 경우 영구 제명하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 73.728,
                "end": 78.565
            },
            {
                "speaker_id": "7",
                "transcription": "영구 입당 불허 등의 강력한 조치를 취하고",
                "sound_type": [
                    2
                ],
                "start": 78.575,
                "end": 83.393
            },
            {
                "speaker_id": "1",
                "transcription": "지난 20대 총선의 무소속 당선자는 11명이었는데 2명 빼고는 모두 복당했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 83.403,
                "end": 89.600
            },
            {
                "speaker_id": "1",
                "transcription": "접전 지역이 많아 결과 예측이 쉽지 않은 이번 선거 무소속 출마 후보 막판 단일화와 이들의 득표가 이번 총선 판을 흔드는 또 다른 변수가 될 것으로 보입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 89.610,
                "end": 100.707
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 100.717,
                "end": 103.236
            }
        ]
    },
    "summary": "이번 총선 이렇게 무소속 출마하는 현역 의원은 모두 15명으로 홍준표 전 대표, 김태호 전 지사 등 원외 거물급 인사의 무소속 출마까지 포함하면 20곳 가깝고 접전 지역이 많아 결과 예측이 쉽지 않은 이번 선거 무소속 출마 후보에 막판 단일화와 이들의 득표가 이번 총선 판을 흔드는 또 다른 변수가 될 것으로 보인다.",
