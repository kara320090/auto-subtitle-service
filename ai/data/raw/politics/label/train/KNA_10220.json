        "term": [
            {
                "speaker_id": "1",
                "transcription": "논란이 커지자 대통령실은 설명을 좀 더 들어보겠다며 말을 아꼈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.560
            },
            {
                "speaker_id": "1",
                "transcription": "한편 대통령실에선 내부 문건 유출 사건을 놓고 공직 감찰이 진행되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.570,
                "end": 10.893
            },
            {
                "speaker_id": "1",
                "transcription": "시민 단체를 열어 놓아 작업조직 노조 시위를 군사 훈련으로 표현한 시민사회수석실 문건이 지난달 말 보도돼 논란이 일었습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.903,
                "end": 19.897
            },
            {
                "speaker_id": "1",
                "transcription": "당시 대통령실은 내용이 부적절해 파기했다고 밝혔는데 감찰 결과 유출 직원을 찾았고 관리 책임까지 묻는 방안을 검토하는 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.907,
                "end": 31.051
            },
            {
                "speaker_id": "1",
                "transcription": "해당 직원은 어제 사의를 밝힌 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
