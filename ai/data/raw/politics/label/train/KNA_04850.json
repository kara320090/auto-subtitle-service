        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "2012년 육류업자로부터 세무 관련 청탁과 함께 뇌물을 받은 혐의로 경찰 수사 선상에 오른 @이름1 전 용산 세무서장 경찰의 압수 수색 영장은 6번 기각됐고 검찰은 2015년 무혐의로 사건을 마무리했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 15.492
            },
            {
                "speaker_id": "1",
                "transcription": "이 과정에서 윤 전 서장과 친분이 있던 윤석열 국민의 힘 대선 후보가 수사를 무마하고 변호사도 소개했다는 의혹이 제기됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.502,
                "end": 24.752
            },
            {
                "speaker_id": "2",
                "transcription": "@이름2 변호사에게 어 @이름1 용산 전 세무서장에게 연락을 하라고 그렇게 전한 적이 있죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.762,
                "end": 34.811
            },
            {
                "speaker_id": "3",
                "transcription": "그런 사실 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.821,
                "end": 37.195
            },
            {
                "speaker_id": "1",
                "transcription": "이후에도 논란이 이어지면서 윤 후보는 검찰 수사를 받게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.205,
                "end": 42.090
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 오늘 불기소 처분을 내렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.100,
                "end": 45.663
            },
            {
                "speaker_id": "1",
                "transcription": "직권 남용과 변호사 법 위반 혐의는 공소 시효가 지나 공소권이 없다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.673,
                "end": 51.720
            },
            {
                "speaker_id": "1",
                "transcription": "윤 전 서장에게 변호사를 소개하지 않았다며 검찰 총장 후보자 청문회에 허위 답변서를 제출한 혐의는 무혐의로 결론냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.730,
                "end": 60.608
            },
            {
                "speaker_id": "1",
                "transcription": "인사 청문과 관련해 국회에 낸 답변서는 당시 윤 후보가 맡았던 서울 중앙 지검장 직무와 관련된 공문서가 아니라는 이유입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.618,
                "end": 69.671
            },
            {
                "speaker_id": "1",
                "transcription": "검찰이 수사 무마 의혹에 대한 실체적 진실은 판단하지 않은 채 윤 후보 사건을 마무리지은 셈입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 69.681,
                "end": 76.729
            },
            {
                "speaker_id": "1",
                "transcription": "다만 검찰 수사 과정에서 윤 전 서장 수사를 맡았던 경찰관과 검사는 수사 외압이 없었다고 진술한 것으로 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 76.739,
                "end": 85.704
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보와 함께 직권 남용 혐의로 수사를 받은 윤 전 서장의 동생 @이름3 법무 연수원 기획 부장도 불기소 처분을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 85.714,
                "end": 94.647
            },
            {
                "speaker_id": "1",
                "transcription": "윤 전 서장의 뇌물 수수 혐의는 6년 만에 결론이 뒤집어졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 94.657,
                "end": 99.589
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 윤 전 서장이 육류업자 등으로부터 2억여 원의 뇌물을 받았다고 보고 재판에 넘겼습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 99.599,
                "end": 105.694
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름3입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 105.704,
                "end": 107.666
            },
            {
                "speaker_id": "4",
                "transcription": "국민의 힘이 윤석열 후보와 배우자 @이름4 씨의 통신 자료도 고위 공직자 범죄 수사처가 들여다봤다며 @이름5 공수처장의 사퇴를 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 107.676,
                "end": 118.448
            },
            {
                "speaker_id": "4",
                "transcription": "@이름6 국민의 힘 선대위 총괄 상황 본부장은 공수처가 국민의 힘 국회 의원 70여 명과 윤 후보 가족에 대한 불법 사찰을 했다며 이같이 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 118.458,
                "end": 129.193
            },
            {
                "speaker_id": "4",
                "transcription": "@이름7 원내 대표는 @이름5 공수처장은 구속돼야 마땅하다며 모든 법적 조치를 통해 김 처장을 즉각 탄핵시킬 것이라고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 129.203,
                "end": 139.305
            }
        ]
    },
    "summary": "전 용산 세무서장은 육류업자로부터 뇌물을 받은 혐의로 수사 선상에 올랐지만 기각됐으며 이 과정에서 윤 후보가 수사를 무마했다는 의혹은 검찰이 불기소 처분을 내렸다고 하였다.",
