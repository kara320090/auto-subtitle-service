        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 문제들이 해결 안 된 채로 개정안이 성급히 추진될 경우 피해는 국민에게 돌아갈 것이라고 목소리를 높였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.825
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 국회가 가칭 형사 사법 제도 개선 특위를 구성해 전문가와 국민 의견을 충분히 수렴한 뒤 합리적 개선 방안을 마련해 달라고 요구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.835,
                "end": 18.178
            },
            {
                "speaker_id": "1",
                "transcription": "전국의 일선 검찰청에서도 반대의 목소리가 잇따라 불거져 나왔고 서울 중앙 지검 부부장 검사와 평검사 수사관들도 한 목소리를 냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.188,
                "end": 28.112
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 @이름1 법무부 장관은 문제의 본질은 수사의 공정성이라며 검찰이 공정성 있는 수사에 대해서는 왜 일사분란하게 목소리를 내고 대응하지 않는지 의문이라고 말했습니다.",
                "sound_type": [
