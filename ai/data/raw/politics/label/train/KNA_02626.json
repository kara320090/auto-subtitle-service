        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 윤 대통령은 민관합동 국가 안전 시스템 점검 회의를 열 예정입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.897
            },
            {
                "speaker_id": "1",
                "transcription": "국가 애도 기간이 끝난 첫날 민주당은 진상규명의 시간이라며 정부의 책임을 묻겠다고 나섰습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.907,
                "end": 11.619
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령의 공식 사과와 국무총리와 행안부 장관 경실 등을 요구했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.629,
                "end": 17.110
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘을 향해선 국회 국정조사를 수용하라고 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.128,
                "end": 21.470
            },
            {
                "speaker_id": "2",
                "transcription": "애초부터 컨트롤타워가 존재했는지 의문이 들 정도입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.470,
                "end": 26.514
            },
            {
                "speaker_id": "2",
                "transcription": "책임을 져야 할 당사자들은 책임회피에 급급해하는 무책임의 극치입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.524,
                "end": 32.599
            }
        ]
    },
    "summary": "오늘 윤 대통령은 민관합동 국가 안전 시스템 점검 회의를 열 예정이며 국가 애도 기간이 끝난 첫날 민주당은 진상규명의 시간이라며 정부의 책임을 묻겠다고 나서 윤 대통령의 공식 사과와 국무총리와 행안부 장관 경실 등을 요구했고 국민의힘을 향해선 국회 국정조사를 수용하라고 했다.",
