                    2
                ],
                "start": 0.000,
                "end": 12.315
            },
            {
                "speaker_id": "1",
                "transcription": "동작역에서 용산까지 이동하는 구간도 비슷했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.325,
                "end": 16.449
            },
            {
                "speaker_id": "1",
                "transcription": "지난주엔 13분 18초 오늘은 14분 28초가 걸려서 1분가량 늘었습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.459,
                "end": 23.431
            },
            {
                "speaker_id": "1",
                "transcription": "차량 유입량에도 미미한 변화가 있었습니다.",
