        "term": [
            {
                "speaker_id": "1",
                "transcription": "세법상 부모 자식 간의 경우에도 10년 간 5천만 원 넘는 돈이 오가면 증여세를 내야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.013
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 후보자 가족은 증여세를 내지 않다가 장관 후보자로 지명된 이후에야 뒤늦게 납부했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.023,
                "end": 13.071
            },
            {
                "speaker_id": "2",
                "transcription": "신고 안 한 거는 페널티를 그냥 20프로를 줘 버려요.",
                "sound_type": [
                    2
                ],
                "start": 13.081,
                "end": 16.493
            },
            {
                "speaker_id": "2",
                "transcription": "무신고 가산세 한 종류가 붙고 일수에 따라 가지고 적용되는 신고 불성실 가산세라는 게 별도로 붙죠.",
                "sound_type": [
                    2
                ],
