        "term": [
            {
                "speaker_id": "1",
                "transcription": "삼겹살이 1등으로 뽑혔어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.507
            },
            {
                "speaker_id": "1",
                "transcription": "우린 다 삼겹살 먹어야 돼.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.517,
                "end": 2.706
            },
            {
                "speaker_id": "1",
                "transcription": "자 그런데 어 이젠 삼겹살도 먹고 그 옆에서 초밥도 먹고 또 그 옆에선 비빔밥도 먹을 수 있다는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.716,
                "end": 9.903
            },
            {
                "speaker_id": "2",
                "transcription": "중대 선거구제의 장단점에 대한 전문가들의 설명이 이어집니다.",
                "sound_type": [
                    2
                ],
                "start": 9.913,
                "end": 14.677
            },
            {
                "speaker_id": "3",
                "transcription": "한 선거구에서 두 명 세 명을 선출할 때보다 어 네 명 다섯 명 여섯 명 이렇게 더 많은 숫자를 선출할 때 비례성이 높아진다고",
                "sound_type": [
                    2
                ],
                "start": 14.687,
                "end": 23.687
            },
            {
                "speaker_id": "4",
                "transcription": "하나의 선거구에서 이제 서로 다른 정당 소속의 의원들이 막 이게 배출이 된다면은 그 지역구의 여러 가지 발전이라든지 이런 혹은 안 좋은 결과에 대한 책임을 누구에게 물어야 되느냐가",
                "sound_type": [
                    2
                ],
