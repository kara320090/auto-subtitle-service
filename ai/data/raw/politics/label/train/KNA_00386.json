        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘 윤석열 국민의당 안철수 후보가 오늘 오전 국회에서 기자 회견을 열어 공동 선언문을 발표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.235
            },
            {
                "speaker_id": "1",
                "transcription": "정권 교체를 향한 국민의 여망을 담아 국민 통합과 대한민국 미래로 가는 대장정을 시작한다며 후보 단일화를 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.245,
                "end": 16.182
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 더 좋은 대한민국을 만드는 시작으로서의 정권 교체 즉 더 좋은 정권 교체를 위하여 뜻을 모으기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.192,
                "end": 27.400
            },
            {
                "speaker_id": "1",
                "transcription": "두 후보는 공동 선언문에서 이제 원팀이라며 미래 지향적이며 개혁적인 국민 통합 정부를 만들겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.410,
                "end": 36.345
            },
            {
                "speaker_id": "1",
                "transcription": "통합 정부의 키워드로는 미래와 개혁 실용 방역 등을 제시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.355,
                "end": 41.553
            },
            {
                "speaker_id": "1",
                "transcription": "협치와 협업의 원칙 아래 국정을 운영하고 인수위 구성부터 공동 정부 구성까지 함께 협의하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.563,
                "end": 50.391
            },
            {
                "speaker_id": "1",
                "transcription": "또 대선 뒤 즉시 합당도 추진하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.401,
                "end": 53.407
            },
            {
                "speaker_id": "1",
                "transcription": "안철수 후보는 윤석열 후보 지지를 공개 선언했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.417,
                "end": 57.339
            },
            {
                "speaker_id": "3",
                "transcription": "저 윤석열은 안철수 후보의 뜻을 받아",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.349,
                "end": 63.096
            }
        ]
    },
    "summary": "국민의힘 윤석열 후보와 국민의당 안철수 후보는 미래 지향적이며 개혁적인 국민 통합 정부를 만들겠다며 공동 선언문을 발표했다.",
