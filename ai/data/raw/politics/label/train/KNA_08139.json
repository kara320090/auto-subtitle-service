        "term": [
            {
                "speaker_id": "1",
                "transcription": "친 해양 강국 해양 강군에 지역이 되어 대한민국의 국익과 해양 주권을 수호하는 막중한 임무를 수행할 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.416
            },
            {
                "speaker_id": "2",
                "transcription": "8200톤 급으로 기존 이지스함보다 크기는 커졌지만 함정을 보호하는 스텔스 기능은 강화됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.426,
                "end": 17.382
            },
            {
                "speaker_id": "2",
                "transcription": "순수 국내 기술로 개발한 삼단 통합 소나 체계를 탑재해 잠수함 탐지 능력을 향상했고 장거리 대잠 어뢰 등으로 잠수함 공격 능력도 갖췄습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.392,
                "end": 27.864
            },
            {
                "speaker_id": "2",
                "transcription": "같은 성능의 차세대 이지스함은 앞으로 두 척이 더 건조됩니다.",
                "sound_type": [
                    2
                ],
                "start": 27.874,
                "end": 32.508
            },
            {
                "speaker_id": "3",
                "transcription": "우리 군은 제2의 창군 수준에 국방 혁신을 통해 과학 기술 강군으로 도약할 것입니다.",
