        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 힘 지도부는 윤석열 정부가 원 없이 일할 수 있도록 해 달라는 호소에 국민이 신뢰를 보낸 결과라고 평가했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.464
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서도 오만하지 않겠다며 몸을 낮췄습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.474,
                "end": 10.620
            },
            {
                "speaker_id": "2",
                "transcription": "이번에 국민 여러분께서 어 우리 여당에 몰아주신 그런 강한 어 그런 지지는 저희로서는 너무나도 감사하고 또 두려운 성적입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.630,
                "end": 24.547
            },
            {
                "speaker_id": "1",
                "transcription": "이 대표는 더 노력해야 한다며 혁신 위원회를 띄우겠다고 했고 오후엔 광주를 찾아 감사 인사에 나섰습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 24.557,
                "end": 32.042
            },
            {
                "speaker_id": "1",
                "transcription": "민주당을 향해서는 다수당의 독주를 견제하라는 국민의 명령이 내려진 거라며 국회 의장과 법사 위원장 등 후반기 국회 원 구성 압박에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.052,
                "end": 42.096
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령은 경제를 살리고 민생을 더 잘 챙기라는 국민의 뜻으로 받아들인다 앞으로 지방 정부와 손잡고 어려움을 헤쳐 나가겠다는 입장을 대변인을 통해 냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.106,
                "end": 53.450
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 오늘 오전 비공개로 비상 대책 위원회 회의를 소집하고 지도부 총사퇴를 결정했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.460,
                "end": 59.957
            },
            {
                "speaker_id": "1",
                "transcription": "후보와 지지자들에게 죄송하다며 선거 결과에 대한 책임은 지도부가 지겠다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.967,
                "end": 65.573
            },
            {
                "speaker_id": "3",
                "transcription": "민주당의 더 큰 개혁과 과감한 혁신을 위해 회초리를 들어주신 국민 여러분께 감사드립니다",
                "sound_type": [
                    2
                ],
                "start": 65.583,
                "end": 74.874
            }
        ]
    },
    "summary": "국민의 힘 지도부는 윤석열 정부가 원 없이 일할 수 있도록 해 달라는 호소에 국민이 신뢰를 보낸 결과라고 평가했고 민주당은 지도부 총사퇴를 결정했다.",
