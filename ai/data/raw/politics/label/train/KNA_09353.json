            },
            {
                "speaker_id": "2",
                "transcription": "공직 부패 기업 부패와 함께 우리 사회에서 척결해야 될 3대 부패의 하나로서 우리가 여기에 대해서 엄격하게 법 집행을",
                "sound_type": [
