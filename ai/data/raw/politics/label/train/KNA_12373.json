            {
                "speaker_id": "1",
                "transcription": "주요 20 개국 G20 정상들은 내일 화상으로 특별 정상회의를 열어 보건 방역 경제 분야 협력 방안을 논의합니다.",
                "sound_type": [
                    2,
                    5
