        "term": [
            {
                "speaker_id": "1",
                "transcription": "비상대책위원회 출범의 열쇠를 진 서병수 @소속1 전국위 의장이 구체적 일정을 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.516
            },
            {
                "speaker_id": "1",
                "transcription": "우선 모레 상임전국위를 열어 지금 당이 비상 상황인지 판단합니다.",
                "sound_type": [
                    2
                ],
                "start": 6.526,
                "end": 12.220
            },
            {
                "speaker_id": "1",
                "transcription": "비상 상황으로 유권 해석이 나오면 전국위원회를 열어 권성동 대표 직무대행이 비대위원장 임명 권한을 갖도록 당헌을 개정하고 비대위원장도 임명합니다.",
                "sound_type": [
                    2
                ],
                "start": 12.230,
                "end": 23.672
            },
            {
                "speaker_id": "1",
                "transcription": "늦어도 10일까지는 비대위 전환을 마칠 거라 했는데 이럴 경우 이준석 대표는 자동 해임이라는 설명도 있었습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.682,
                "end": 31.878
            },
            {
                "speaker_id": "2",
                "transcription": "전임에 있던 지도부는 해산이 되는 거 아니겠습니까?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 31.888,
                "end": 35.253
            },
            {
                "speaker_id": "2",
                "transcription": "아 그렇기 때문에 자동적으로 어 이준석 대표도 어",
                "sound_type": [
                    2,
                    4
                ],
