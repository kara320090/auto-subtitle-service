        "term": [
            {
                "speaker_id": "1",
                "transcription": "충남 도지사가 간부 회의에서 판매 실적이 저조하다며 주 1회 판매 실적을 보고하라고 지시했다며 입장권 6만 2000장 3억 2600만원 어치에 대한 판매 계획을 세웠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.289
            },
            {
                "speaker_id": "1",
                "transcription": "부서별로 적게는 1000장에서 많게는 5000장까지 배분했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.299,
                "end": 18.625
            },
            {
                "speaker_id": "1",
                "transcription": "이후 계룡시 주간 업무 계획에는 우선 업무가 입장권 판매 실적으로 바뀌었습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.635,
                "end": 25.137
            },
            {
                "speaker_id": "2",
                "transcription": "6만 2000매를 우리가 판매 협조를 요청한 건 사실이고요.",
                "sound_type": [
                    2,
                    5
                ],
