        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 확인해 보니 이재명의 이 자도 안 나왔다는 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.110
            },
            {
                "speaker_id": "1",
                "transcription": "이게 지금 협상의 상대로서 해야 될 이야기입니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.120,
                "end": 7.388
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 지난 4월 천안함 희생자 추모 행사에서 고소 고발 사건은 어떻게 할 거냐고 물어온 건 오히려 이준석 국민의힘 대표라고 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.398,
                "end": 18.006
            },
            {
                "speaker_id": "2",
                "transcription": "오후로 예정됐던 원내대표 회동은 결국 불발됐는데 이를 두고도 여야는 잡화상 물건 흥정하듯 당리당략 주장을 거부한다.",
                "sound_type": [
                    2
                ],
                "start": 18.016,
                "end": 27.351
            },
            {
                "speaker_id": "2",
                "transcription": "거짓 왜곡 주장을 하면 무슨 대화가 가능하겠느냐며 책임 공방을 이어갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.361,
                "end": 32.841
            },
            {
                "speaker_id": "2",
                "transcription": "서해 공무원 피격 사건 등을 두고",
                "sound_type": [
                    2
                ],
                "start": 32.851,
                "end": 35.435
            }
        ]
    },
    "summary": "여야 원내대표 회동에 앞서 여야가 서로 거짓 주장을 한다고 주장하며 책임 공방을 이어가고 있다.",
