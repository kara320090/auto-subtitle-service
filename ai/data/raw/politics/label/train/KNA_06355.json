        "term": [
            {
                "speaker_id": "1",
                "transcription": "법인 카드 사적 유용 의혹과 의전 논란에 엿새 전부터 공개 일정을 중단한 민주당 이재명 후보 부인 김혜경 씨 오늘 오후 기자 회견장에 서서 고개를 숙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.616
            },
            {
                "speaker_id": "2",
                "transcription": "공과 사의 구분을 분명히 해야 했는데 제가 많이 부족했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.626,
                "end": 19.797
            },
            {
                "speaker_id": "2",
                "transcription": "국민 여러분들께 특히 제보자 당사자께 진심으로 사과드립니다.",
                "sound_type": [
                    2
                ],
                "start": 19.807,
                "end": 28.639
            },
            {
                "speaker_id": "1",
                "transcription": "의혹 제기 12일 만입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.649,
                "end": 31.616
            },
            {
                "speaker_id": "1",
                "transcription": "김 씨는 자신의 불찰과 부족함의 결과라며 마땅히 책임을 지겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.626,
                "end": 37.307
            },
            {
                "speaker_id": "2",
                "transcription": "선거 후에라도 제기된 의혹에 대해 성실하게 설명드리고 끝까지 책임을 질 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 37.317,
                "end": 48.482
            },
            {
                "speaker_id": "1",
                "transcription": "김 씨는 기자들의 질문을 일부 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 48.492,
                "end": 51.387
            },
            {
                "speaker_id": "1",
                "transcription": "사적 심부름을 시킨 당사자 배 모 사무관에 대해선 오랜 시간 알고 있던 사이라 했고 제보자에 대해선 배 씨 소개로 한 번 인사한 게 전부라고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 51.397,
                "end": 62.814
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 제보자에 대해 피해자라고 생각한다고 덧붙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 62.824,
                "end": 67.306
            },
            {
                "speaker_id": "2",
                "transcription": "저의 불찰이라고 생각하고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 67.316,
                "end": 69.906
            },
            {
                "speaker_id": "2",
                "transcription": "A 씨는 피해자라고 생각합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 69.916,
                "end": 74.040
            }
        ]
    },
