        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 이재명 후보는 서울에서 총력전에 나섰습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.833
            },
            {
                "speaker_id": "1",
                "transcription": "서울에서 앞서야만 당선될 수 있다고 판단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.843,
                "end": 6.958
            },
            {
                "speaker_id": "1",
                "transcription": "악화된 부동산 민심에서 출발한 정권 교체 심리를 의식해 인물론으로 지지를 호소했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.968,
                "end": 13.600
            },
            {
                "speaker_id": "2",
                "transcription": "부동산 정책은 섬세해야 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.610,
                "end": 16.997
            },
            {
                "speaker_id": "2",
                "transcription": "정책의 세밀함 그리고 정책의 현장성 이재명의 주특기 아닙니까?",
                "sound_type": [
                    2
                ],
                "start": 17.007,
                "end": 23.675
            },
            {
                "speaker_id": "2",
                "transcription": "이재명이 제일 잘하는 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.685,
                "end": 26.160
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보를 겨냥해선 아무런 비전과 정책도 없이 정권 교체만 외친다고 판단했습니다.",
                "sound_type": [
