        "term": [
            {
                "speaker_id": "1",
                "transcription": "어제 경북 울릉군 울릉읍 사동항.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.827
            },
            {
                "speaker_id": "1",
                "transcription": "외국인들이 탄 요트가 항구 안을 배회합니다.",
                "sound_type": [
                    2
                ],
                "start": 2.837,
                "end": 5.964
            },
            {
                "speaker_id": "1",
                "transcription": "가까이 다가가자 식수를 달라고 요청합니다.",
                "sound_type": [
                    2
                ],
                "start": 5.974,
                "end": 9.244
            },
            {
                "speaker_id": "2",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 9.254,
                "end": 10.839
            },
            {
                "speaker_id": "1",
                "transcription": "물을 건네주고 대화를 시도해 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.849,
                "end": 13.410
            },
            {
                "speaker_id": "1",
                "transcription": "어디서 왔냐고 묻자 러시아에서 왔다는 답이 돌아옵니다.",
                "sound_type": [
                    2
                ],
                "start": 13.420,
                "end": 17.370
            },
            {
                "speaker_id": "2",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 17.378,
                "end": 19.810
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 19.820,
                "end": 20.670
            },
            {
                "speaker_id": "2",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 20.680,
                "end": 22.832
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 22.842,
                "end": 23.936
            },
            {
                "speaker_id": "1",
                "transcription": "이 6톤짜리 요트는 지난 1일 강원도 고성군 아야진에서 동쪽으로 13킬로미터 떨어진 해역에서 우리 해경에 발견됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.946,
                "end": 32.830
            },
            {
                "speaker_id": "1",
                "transcription": "20대 후반에서 40대 중반의 러시아 남성 5명이 타고 있었습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.845,
                "end": 38.020
            },
            {
                "speaker_id": "1",
                "transcription": "선박 위치와 항행로 속력 등의 정보를 실시간으로 제공하는 선박 자동 식별장치 AIS 신호는 잡히지 않는 상태였습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.020,
                "end": 47.510
            },
            {
                "speaker_id": "1",
                "transcription": "속초 해경이 작성한 상황 보고섭니다.",
                "sound_type": [
                    2
                ],
                "start": 47.510,
                "end": 50.519
            },
            {
                "speaker_id": "1",
                "transcription": "러시아 블라디보스토크에서 9월 27일 한국 여행 목적으로 출항.",
                "sound_type": [
                    2
                ],
                "start": 50.529,
                "end": 55.162
            },
            {
                "speaker_id": "1",
                "transcription": "30일 속초항으로 입항하려 했으나 입국 금지됐다고 돼 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 55.172,
                "end": 59.923
            },
            {
                "speaker_id": "1",
                "transcription": "해경은 이들이 요청한 3일간의 식량 물과 연료유 각각 100리터를 제공했습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.933,
                "end": 65.639
            },
            {
                "speaker_id": "1",
                "transcription": "다시 돌아가는 데 필요한 물품인 셈입니다.",
                "sound_type": [
                    2
                ],
                "start": 65.649,
                "end": 68.268
            }
        ]
    },
    "summary": "러시아 남성 5명이 요트를 타고 우리 해역으로 들어와 해경에 발견되었다.",
