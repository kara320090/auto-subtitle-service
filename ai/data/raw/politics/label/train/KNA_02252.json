        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기에 대해서 경력이라든가 그런 것들을 봤을 때 확인이 제대로 안 돼요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.560
            },
            {
                "speaker_id": "1",
                "transcription": "어디 가서 봉사 활동을 했다든가 민간 단 민간 복지 단체 활동을 했다든가 뭐 기부금을 냈다든가 이런 부분들이 거의 눈에 안 보여서",
                "sound_type": [
                    2
                ],
                "start": 3.570,
                "end": 14.546
            },
            {
                "speaker_id": "2",
                "transcription": "사회 복지 분야에 더 큰 관심과 노력 기울이겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.556,
                "end": 18.732
            },
            {
                "speaker_id": "3",
                "transcription": "윤석열 당선인과 1년에 두어 번 만났을 뿐 40년 지기는 아니라고 말했습니다.",
                "sound_type": [
