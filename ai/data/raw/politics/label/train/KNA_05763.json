        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 이곳은 평소 같으면 하루 종일 쉴 새 없이 화물 차량이 오가는 곳인데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.805
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 하루 종일 이곳을 오가는 차량은 거의 찾아볼 수 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.815,
                "end": 9.119
            },
            {
                "speaker_id": "1",
                "transcription": "조합원들은 기지 안에 텐트를 치고 철야 대기에 들어갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.129,
                "end": 13.661
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 오전에 진행된 출정식엔 약 1만 명이 참석했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.671,
                "end": 18.196
            },
            {
                "speaker_id": "1",
                "transcription": "화물 연대는 오늘 출정식에서 안전 운임제만이 화물 노동자를 보호할 수 있는 유일한 법 제도라며 계속 시행을 요구했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.206,
                "end": 26.855
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 출정식은 경기 의왕뿐 아니라 부산 신항 전남 광양항 충남 현대제철 등 전국 주요 물류 거점 16곳에서 지역 본부별로 열렸습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.865,
                "end": 37.900
            },
            {
                "speaker_id": "1",
                "transcription": "경찰과의 큰 물리적 충돌은 없었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 37.910,
                "end": 41.097
            },
            {
                "speaker_id": "1",
                "transcription": "국토부는 파업 첫날인 오늘 전국 12개 항만에 컨테이너 반출입양이 평시 대비 40퍼센트 수준으로 떨어졌다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 41.107,
                "end": 50.117
            },
            {
                "speaker_id": "1",
                "transcription": "이와 관련해 원희룡 국토교통부 장관은 오늘 의왕 대륙 컨테이너 기지를 찾아 운송 개시 명령을 내릴 실무적 준비에 착수했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.127,
                "end": 59.526
            }
        ]
    },
    "summary": "화물 연대는 집회를 했고 원희룡 국토교통부 장관은 실무적 준비에 착수했다.",
