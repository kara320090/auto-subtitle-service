        "term": [
            {
                "speaker_id": "1",
                "transcription": "혀 깨물고 죽지 거 뭐하러 그런짓 합니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.102
            },
            {
                "speaker_id": "2",
                "transcription": "신상에 대해서 굉장히 어 폭언에 가까운 말씀을 하신 것은 사과하십시오.",
                "sound_type": [
