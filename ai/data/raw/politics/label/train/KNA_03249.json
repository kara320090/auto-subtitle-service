        "term": [
            {
                "speaker_id": "1",
                "transcription": "이들 사업을 통해 확보되는 주택 공급 물량에 70에서 80퍼센트는 공공분양으로 공급됩니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.413
            },
            {
                "speaker_id": "1",
                "transcription": "청약제도도 소폭 개편해 공공분양에 일반공급은 30퍼센트로 늘리고 일반 공급분에도 추첨제를 도입해 청약 기회를 확대합니다.",
                "sound_type": [
                    2
                ],
                "start": 6.423,
                "end": 15.851
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 대통령이 신년 기자회견에서 언급한 신규 택지와 관련해선 구체적 입지가 발표되진 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.861,
                "end": 23.363
            },
            {
                "speaker_id": "1",
                "transcription": "다만 국토부는 서울 인근과 지방 광역시 중심으로 26만 3000호에 주택 공급이 가능한 신규 공공 택지를 선정할 계획이라고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.373,
                "end": 33.141
            },
            {
                "speaker_id": "1",
                "transcription": "kbs뉴스 이지윤입니다.",
