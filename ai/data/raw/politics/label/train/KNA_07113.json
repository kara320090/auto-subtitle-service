        "term": [
            {
                "speaker_id": "1",
                "transcription": "당연히 이렇게 후보자도 해야 된다고 생각하나요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.919
            },
            {
                "speaker_id": "2",
                "transcription": "제가 그 다른 분하고 뭐 왜 비교가 돼야 되는지 그걸 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.929,
                "end": 11.715
            },
            {
                "speaker_id": "3",
                "transcription": "인수위와 발달 장애인 부모들의 집회 요구 사항을 아는지 묻자 이렇게 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.725,
                "end": 17.759
            },
            {
                "speaker_id": "4",
                "transcription": "무엇을 요구하는지 아시냐고요.",
                "sound_type": [
                    2
                ],
                "start": 17.769,
                "end": 20.142
            },
            {
                "speaker_id": "4",
                "transcription": "장관 후보자시잖아요.",
