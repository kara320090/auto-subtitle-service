        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 윤석열 당선인은 오늘 오후 선거 공약을 국정 과제에 반영하는 기획 위원회 전체 회의를 주재했는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.386
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인은 이 자리에서 유능하고 일 잘하는 정부가 중요하다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.396,
                "end": 11.876
            },
            {
                "speaker_id": "1",
                "transcription": "또 국민의 심부름꾼 머슴으로 일을 잘해야 한다며 정부 업무 인수도 중요하지만 공약을 지키는 것도 매우 중요하다고 덧붙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.886,
                "end": 20.707
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인은 오전엔 서울 광화문에서 열린 한국 보도 사진전 개막식에 참석해 몇 장의 사진이 우리 사회를 바꾸고 역사를 변화 시킨다고 말했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.717,
                "end": 31.475
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 삼청동 인수위 사무실에서 KBS 뉴스 방준원입니다.",
                "sound_type": [
                    2,
