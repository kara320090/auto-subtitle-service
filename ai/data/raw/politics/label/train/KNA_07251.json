        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 주변으로 집회가 많아질 가능성 주민들은 예의주시하고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.115
            },
            {
                "speaker_id": "1",
                "transcription": "이곳은 국방부 신청사 바로 앞입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.125,
                "end": 8.241
            },
            {
                "speaker_id": "1",
                "transcription": "경찰은 여기서부터 반경 100미터 이내의 집회 및 시위를 금지하기로 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.251,
                "end": 13.677
            },
            {
                "speaker_id": "1",
                "transcription": "주민들은 그 풍선 효과로 인근 주택가에서 집회가 잦아질까 봐 걱정하고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.687,
                "end": 20.212
            },
            {
                "speaker_id": "2",
                "transcription": "시끄럽고 스피커로 그냥 고성방가하고 막 이렇게 하니까 어 이 주민들이 이거 못 살겠다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.222,
                "end": 27.620
            },
            {
                "speaker_id": "1",
                "transcription": "대통령 이동 시의 교통 통제를 우려하는 목소리도 적지 않습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.630,
                "end": 32.420
            },
            {
                "speaker_id": "3",
                "transcription": "교통량이라든가 그런 것들이 좀 많이 밀리지는 않을까.",
                "sound_type": [
                    2
                ],
                "start": 32.430,
                "end": 36.503
            }
        ]
    },
    "summary": "새로운 대통령 집무실 인근 지역 주민들의 심정을 인터뷰하고 있다.",
