        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 조 실장은 사직을 관심한 것으로 안다는 이 관계자는 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.087
            },
            {
                "speaker_id": "1",
                "transcription": "또 다른 정보 관계자도 인사 문제에 대해 두 사람 의견이 안 맞았고 결국 조 실장 뜻대로 인사를 못했다고 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.097,
                "end": 12.110
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 전 국정원장 역시 인사 문제로 원장과 충돌한다는 얘기를 들었다고 에스엔에스 적기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.120,
                "end": 19.032
            },
            {
                "speaker_id": "1",
                "transcription": "인사 문제를 제외하고도 조 실장은 김 원장과 잦은 의견 충돌이 있었던 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.042,
                "end": 24.963
            },
            {
                "speaker_id": "1",
                "transcription": "신임 기조 실장은 @이름2 전 서울 동무지검 차장 검사가 유력하게 검토되는 것으로 알려졌습니다.",
