        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 일종의 2차 가해라는 지적에다 한 최고위원도 피해자로 부르는 게 드라이하다는 등 안팎에서 비판이 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.258
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 지도부는 결국 피해자로 호칭을 정리하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.268,
                "end": 12.467
            },
            {
                "speaker_id": "1",
                "transcription": "고소 사실이 알려진 지 일주일여 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.477,
                "end": 15.674
            },
            {
                "speaker_id": "1",
                "transcription": "여성부가 피해자로 본다고 했으니 당도 이를 따르자는 공감대가 이뤄졌다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 15.684,
                "end": 21.712
            },
            {
                "speaker_id": "2",
                "transcription": "피해자 측에서 고소 사실의 일부를 구체적으로 밝히고 있습니다.",
                "sound_type": [
                    2
