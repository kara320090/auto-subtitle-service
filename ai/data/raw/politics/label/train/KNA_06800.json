        "term": [
            {
                "speaker_id": "1",
                "transcription": "친구들과 만날 기회가 줄면서 전체 응답 학생 10명 중 3명 이상이 친구 관계가 나빠졌다고 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.567
            },
            {
                "speaker_id": "2",
                "transcription": "대화가 많이 없었으니까 그만큼 안 맞는 만큼 친해지는데 시간이 좀 많이 걸리기도 하고",
                "sound_type": [
                    2
                ],
                "start": 7.577,
                "end": 14.250
            },
            {
                "speaker_id": "1",
                "transcription": "10명 중 7명 이상이 인터넷과 스마트폰 사용 시간이 늘었는데 특히 초등학생 저학년은 8명 이상이 늘었다고 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.260,
                "end": 23.881
            },
            {
                "speaker_id": "3",
                "transcription": "핸드폰 13시간 14시간 했었어요.",
