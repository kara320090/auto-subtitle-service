        "term": [
            {
                "speaker_id": "1",
                "transcription": "특정 후보의 부탁을 받고 대리 투표를 하신 건 아니요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.661
            },
            {
                "speaker_id": "2",
                "transcription": "쓸데없는 소리 좀 하지 말라고",
                "sound_type": [
                    2
                ],
                "start": 3.671,
                "end": 5.978
            },
            {
                "speaker_id": "1",
                "transcription": "경찰은 인근 마을 이장과 부녀회장들도 대리 신청이나 대리 투표를 한 정황을 확인해 수사를 확대했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.988,
                "end": 14.063
            },
            {
                "speaker_id": "3",
                "transcription": "피해자는 약 30여 명 되고 가족 없이 혼자 이렇게 어 사시는 분들입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.073,
                "end": 20.325
            },
            {
                "speaker_id": "3",
                "transcription": "소도시에서 특히 몇 표 차이 몇백 표 차이로 당선 좌우되니까",
                "sound_type": [
                    2
                ],
                "start": 20.335,
                "end": 26.055
            },
            {
                "speaker_id": "1",
                "transcription": "이번 지방 선거에서 군위 말고도 경북 의성군과 전남 고흥군 등 모두 3곳에서 거소 투표 조작 의혹이 제기돼 수사나 재판이 진행되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.065,
                "end": 36.436
            }
        ]
    },
    "summary": "경찰은 인근 마을 이장과 부녀 회장들도 대리 신청이나 대리 투표를 한 정황을 확인해 수사를 확대했고 다른 지역 3곳에서 거소 투표 조작 의혹이 제기돼 수사나 재판이 진행되고 있다고 전한다.",
