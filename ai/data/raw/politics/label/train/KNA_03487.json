            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 그러면서 국회의원 300명 전원에 대한 조사부터 시작하자고 국민의힘에 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.491,
                "end": 12.989
            },
            {
                "speaker_id": "3",
                "transcription": "국회의원과 배우자 직계 존비속의 부동산 소유 및 거래 현황에 대한 전수 조사를 통해 국민적 불신을 해소하고",
                "sound_type": [
