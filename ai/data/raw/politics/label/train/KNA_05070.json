        "term": [
            {
                "speaker_id": "1",
                "transcription": "후반기 국회 들어 처음 열린 문체위 전체 회의 옛 청와대 본관을 모형으로 제작하겠다는 문체부 계획이 쟁점이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.833
            },
            {
                "speaker_id": "2",
                "transcription": "장관님 조선총독부 관저를 왜 문체부가 나서서 복원합니까?",
                "sound_type": [
                    2
                ],
                "start": 8.843,
                "end": 13.800
            },
            {
                "speaker_id": "3",
                "transcription": "43 년간 우리 대통령들이 사용했던 청 구 본관의 대통령 집무 공간을 보여주는 겁니다.",
                "sound_type": [
                    2,
                    4
