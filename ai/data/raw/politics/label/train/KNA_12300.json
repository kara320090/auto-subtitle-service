        "term": [
            {
                "speaker_id": "1",
                "transcription": "더 힘들고 외로울 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.375
            },
            {
                "speaker_id": "1",
                "transcription": "기성의 관성과 질서로는 우리에게 주어진 난관을 깨고 나갈 수가 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.385,
                "end": 9.366
            },
            {
                "speaker_id": "2",
                "transcription": "손 대표는 아쉽다면서도 대화와 타협 없는 정치는 고립될 수밖에 없다며 쓴소리를 남겼습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.376,
                "end": 16.240
            },
            {
                "speaker_id": "2",
                "transcription": "안철수계 비례대표 의원들은 신당 창당 수순이라며 출당을 요구하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.250,
                "end": 22.163
            },
            {
                "speaker_id": "2",
                "transcription": "반면 호남계 중진들은 신당행은 없다며 손 대표 퇴진에 노력하겠다 당 수습이 먼저라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.173,
                "end": 29.314
            },
            {
                "speaker_id": "2",
                "transcription": "바른미래당 공동창업자 유승민 의원은 정치 발전을 위해 잘해달라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.324,
                "end": 34.467
            }
        ]
    },
    "summary": "안철수 의원이 탈당하면서 안철수계 비례대표 의원들은 출당을 요구하겠다고 밝혔고 호남계 중진들은 당 수습이 먼저라고 밝혔다.",
