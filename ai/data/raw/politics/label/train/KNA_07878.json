        "term": [
            {
                "speaker_id": "1",
                "transcription": "이유를 대한민국이 제공을 해 해 놓고 저희한테 나중에 그 책임을 소송비용까지 저희한테 넘긴다는 건 정말 치졸한 일이죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.043
            },
            {
                "speaker_id": "2",
                "transcription": "2018년 한 정신병원에 강제 입원 된 김 모씨는 2주 동안 손발이 묶이는 등의 인권 침해를 수차례 당했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.053,
                "end": 18.622
            },
            {
                "speaker_id": "2",
                "transcription": "국가인권위가 나서서 변호사단체에 구제 요청까지 했는데 법원은 5000만 원의 손해배상 청구액 가운데 330만 원만 인정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.632,
                "end": 28.431
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 인정 비율에 따라 병원 측 소송 비용의 95퍼센트는 김 씨가 부담하라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.441,
                "end": 35.471
            },
            {
                "speaker_id": "2",
                "transcription": "재판에 이기고도 수백만 원을 오히려 물어주게 될 판입니다.",
                "sound_type": [
                    2
                ],
                "start": 35.481,
                "end": 39.993
            },
            {
                "speaker_id": "3",
                "transcription": "피고 쪽에 지급해야 될 돈이 많은 그런 좀 비상식적인 상황이 되는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 40.003,
                "end": 45.309
            },
            {
                "speaker_id": "3",
                "transcription": "근데 사실 이 상황에서 원고가 잘못한 건 없잖아요.",
                "sound_type": [
                    2
                ],
                "start": 45.319,
                "end": 49.082
            }
        ]
    },
    "summary": "정신병원에 강제 입원 된 김 모씨는 2주 동안 손발이 묶이는 등의 인권 침해를 수차례 당했고 국가인권위가 나서서 변호사단체에 구제 요청까지 했는데 법원은 5000만 원의 손해배상 청구액 가운데 330만 원만 인정으며 병원 측 소송 비용의 95퍼센트는 김 씨가 부담하라고 했습니다.",
