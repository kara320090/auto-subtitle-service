        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 서울 중앙 지검장으로 있을 때 함께 일했던 특수통 심봉수 신은석 검사 등 10명이 검사장으로 승진했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.034
            },
            {
                "speaker_id": "1",
                "transcription": "노정연 청원 지검장이 첫 여성 고검장에 올랐고 한직으로 알려진 법무 연수원에는 전 정부 성향으로 평가받아온 검사장들이 보내졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.044,
                "end": 19.101
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 인사는 법무부 장관이 검찰총장 의견을 듣고 내도록 돼있습니다.",
