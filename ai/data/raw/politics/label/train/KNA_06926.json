        "term": [
            {
                "speaker_id": "1",
                "transcription": "원만한 합의를 통해서 상생과 협력의 정치를 열었다는 점에 있어서 저는 큰 의의를 어 부여하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.084
            },
            {
                "speaker_id": "2",
                "transcription": "검찰 수사권 폐지 법안에 3차례나 반대 입장을 밝혔던 인수위도 국회 결정을 존중한다는 입장을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.094,
                "end": 16.342
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 일부 강경파 의원들은 의장이 권한을 남용했다 헌법 파괴적인 중재 과정이라며 불만을 드러내기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.352,
                "end": 24.590
            },
            {
                "speaker_id": "2",
                "transcription": "진통 끝에 합의된 검찰 수사권 폐지 법안은 이달 말 국회 본회의를 거쳐 다음 달 3일 문재인 정부 마지막 국무 회의에서 의결될 것으로 보입니다.",
                "sound_type": [
