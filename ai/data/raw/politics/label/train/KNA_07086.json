        "term": [
            {
                "speaker_id": "1",
                "transcription": "원희룡 국토교통부 장관 후보자도 재건축 재개발 같은 도심 내 정비 사업에 속도를 내야 한다고 거들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.137
            },
            {
                "speaker_id": "1",
                "transcription": "또 다주택자 양도세 중과를 1년 유예하는 방안을 서두르겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.147,
                "end": 12.880
            },
            {
                "speaker_id": "1",
                "transcription": "공급을 늘려 집 값을 안정시키기 위해서라는 설명입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.890,
                "end": 16.910
            },
            {
                "speaker_id": "2",
                "transcription": "기존 매물들이 나올 수 있도록 하기 위해서 양도세 중과를 1년 유예한다든지 당장 공급에 플러스 효과를 줄 수 있는 정책들은 저희들이 하루 빨리 시장에 투입을 하도록 하겠습니다.",
