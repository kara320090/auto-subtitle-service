        "term": [
            {
                "speaker_id": "1",
                "transcription": "당시 농지 관련법 규정대로라면 정 후보자는 농지를 살 수 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.051
            },
            {
                "speaker_id": "1",
                "transcription": "농지와 매입자 주소지 거리를 4킬로미터 이내로 제한하는 이른바 통작 거리 규제 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.061,
                "end": 12.037
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 정 후보자는 농지를 매입했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.047,
                "end": 15.303
            },
            {
                "speaker_id": "1",
                "transcription": "위장 전입을 통해섭니다.",
                "sound_type": [
                    2
                ],
                "start": 15.313,
                "end": 17.551
            },
            {
                "speaker_id": "1",
                "transcription": "농지 매입 한 달 전 정 후보자는 시골로 주소지를 옮겼습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.561,
                "end": 22.388
            },
            {
                "speaker_id": "1",
                "transcription": "해당 농지에서 100여 미터 떨어진 곳입니다.",
                "sound_type": [
                    2
                ],
                "start": 22.398,
                "end": 25.513
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 복지부 장관 후보자는 어 1987년 어 이곳에 있었던 것으로 보이는 삼촌의 집에 주소를 옮기고 어 농지를 취득했습니다.",
                "sound_type": [
                    2
