        "term": [
            {
                "speaker_id": "1",
                "transcription": "매주 타는 민생 버스 네 번째론 전북을 찾았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.492
            },
            {
                "speaker_id": "2",
                "transcription": "국민들이 동의하지 않는 상태에서는 어떤 일도 하지 않을 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 3.502,
                "end": 10.045
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘 윤석열 후보는 울산에서 나흘째 잠행 중인 이준석 대표와 만찬 회동을 갖습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.055,
                "end": 16.870
            },
            {
                "speaker_id": "1",
                "transcription": "복귀를 기다리겠다 했었지만 설득하고 화합하란 주문 당 안팎에서 이어지자 이 대표가 있는 울산으로 향했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.880,
                "end": 24.632
            },
            {
                "speaker_id": "1",
                "transcription": "이 대표에게 늘 감탄했다 추켜세우며 윤 후보 측 핵심 관계자가 했다는 이 대표 관련 모욕적 발언은 오해라고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.642,
                "end": 33.026
            },
            {
                "speaker_id": "3",
                "transcription": "저도 좀 당황스럽고 그런 거를 오해라고 할 수도 있겠습니다마는 저는 이준석 대표에 대해서 오해를 한 사실이 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.036,
                "end": 39.773
            }
        ]
    },
