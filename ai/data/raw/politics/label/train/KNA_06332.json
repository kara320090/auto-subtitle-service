        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금대로면 청년층의 부담이 커지는 만큼 국민연금 보험요율을 올려야 한다는 해법을 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.695
            },
            {
                "speaker_id": "2",
                "transcription": "더 이상 보험요율 인상을 미룰 수 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.705,
                "end": 9.809
            },
            {
                "speaker_id": "2",
                "transcription": "미래 세대의 부담을 줄여주기 위해서는 국민연금 재정에 대한 우리 세대의 책임을 높여야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 9.819,
                "end": 16.516
            },
            {
                "speaker_id": "1",
                "transcription": "심 후보는 불안정 취업자의 보장성을 강화하고 기초 연금도 40만 원으로 인상하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.526,
                "end": 23.610
            },
            {
                "speaker_id": "1",
                "transcription": "공무원 연금 등 특수 직역 연금은 국민연금으로 통합하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.620,
                "end": 29.294
            },
            {
                "speaker_id": "1",
                "transcription": "심 후보는 정치 개혁 토론회를 찾아선 행정부 법안 제출권은 폐지해야 한다며 의회 중심제를 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.304,
