        "term": [
            {
                "speaker_id": "1",
                "transcription": "한마디도 못 하고 거꾸로 나한테 니는 지방자치단체장이나 잘해라.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.489
            },
            {
                "speaker_id": "1",
                "transcription": "그따위 말이나 하고 이러니까 이게 당이 제대로 기강이 서겠어요?",
                "sound_type": [
                    2
                ],
                "start": 5.499,
                "end": 11.906
            },
            {
                "speaker_id": "2",
                "transcription": "해촉 배경에 대해 오늘 김기현 대표는 이렇게 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.916,
                "end": 16.220
            },
            {
                "speaker_id": "3",
                "transcription": "상임 고문의 경우에 현직 정치인으로 활동하거나 현직 지자체장으로 활동하거나 이런 분은 안 계신 것이 그동안의 관례였기 때문에",
                "sound_type": [
                    2
                ],
                "start": 16.230,
                "end": 27.731
            },
            {
                "speaker_id": "2",
                "transcription": "홍 시장은 즉각 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.741,
                "end": 30.277
            },
            {
                "speaker_id": "2",
                "transcription": "엉뚱한 데 화풀이라며 욕설 목사를 고문으로 위촉하라고 했습니다.",
                "sound_type": [
