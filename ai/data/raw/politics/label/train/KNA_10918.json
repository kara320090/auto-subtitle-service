        "term": [
            {
                "speaker_id": "1",
                "transcription": "우선 300조 원 규모 민간 투자를 바탕으로 수도권에 세계 최대 규모에 신규 첨단 시스템 반도체 클러스터를 구축하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.385
            },
            {
                "speaker_id": "2",
                "transcription": "기존 메모리 반도체 제조단지 150개 이상에 국내외 소부장 기업 판교 미수와 연계해서 반도체 메가클러스터를 세계 최대 규모로 키워나가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.395,
                "end": 25.110
            },
            {
                "speaker_id": "1",
                "transcription": "지방 14곳엔 국가 첨단산업단지가 새로 조성됩니다.",
                "sound_type": [
                    2
                ],
                "start": 25.120,
                "end": 29.807
            },
            {
                "speaker_id": "1",
                "transcription": "각 지역이 비교 위에 있는 분야를 키울 수 있도록 토지 이용 주제를 풀고 산업단지를 조성하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.817,
                "end": 37.264
            },
            {
                "speaker_id": "2",
                "transcription": "첨단산업에 발전은 전체 경제 성장과도 직결되지만",
                "sound_type": [
                    2
