        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 힘 김종인 총괄선대위원장이 오늘 아침 선대위를 전면 개편하겠다고 선언했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.547
            },
            {
                "speaker_id": "2",
                "transcription": "국민들의 정서에 주로 따르는 측면에서 우리 이 국민의 이 선대위가 하여튼 최선의 노력을 갖다 경주한다는 것을",
                "sound_type": [
                    2
                ],
                "start": 5.557,
                "end": 19.714
            },
            {
                "speaker_id": "1",
                "transcription": "계속되는 당내 갈등 후보를 둘러싼 논란 이런 악재들이 고스란히 반영된 지지율 하락세에 극약 처방을 내놓은 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 19.724,
                "end": 27.709
            },
            {
                "speaker_id": "1",
                "transcription": "같은 시간 외부 행사장에 있던 윤석열 후보와 사전에 상의하지 않은 깜짝 발표였습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.719,
                "end": 34.120
            },
            {
                "speaker_id": "3",
                "transcription": "선대위를 개편하시는 이유가 뭔가요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.130,
                "end": 36.102
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보는 이후 공개 일정을 모두 취소했습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.112,
                "end": 41.966
            },
            {
                "speaker_id": "1",
                "transcription": "선대위에선 사의 표명이 도미노처럼 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.976,
                "end": 45.426
            },
            {
                "speaker_id": "1",
                "transcription": "김병준 상임선대위원장과 이수정 공동선대위원장 등이 모두 물러나겠다고 했고 김기현 원내 대표 등 원내 지도부도 의원총회에서 일괄 사퇴 의사를 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 45.436,
                "end": 57.012
            },
            {
                "speaker_id": "4",
                "transcription": "남탓 할 일이 아니고 바로 내 잘못이다 내 탓이다라고 저는 생각하고 원내 대표인 저부터 쇄신에 앞장서겠다는 마음을 먹었습니다.",
                "sound_type": [
                    2
                ],
                "start": 57.022,
                "end": 68.268
            }
        ]
    },
    "summary": "국민의 힘 김종인 총괄선대위원장이 선대위를 전면 개편하겠다고 선언했는데 같은 시간 외부 행사장에 있던 윤석열 후보와 사전에 상의하지 않은 깜짝 발표였습니다.",
