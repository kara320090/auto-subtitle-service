        "term": [
            {
                "speaker_id": "1",
                "transcription": "책임을 져야 할 당사자들은 책임 회피에 급급해야 하는 무책임의 극치입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.603
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 경찰 수사가 먼저라며 정부 책임론 차단에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.613,
                "end": 10.480
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령이 모든 노력을 혼신의 힘을 다하고 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.490,
                "end": 14.694
            },
            {
                "speaker_id": "1",
                "transcription": "국정 조사를 요구하는 민주당을 향해선 재난을 정치화하고 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.704,
                "end": 19.935
            },
            {
                "speaker_id": "2",
                "transcription": "국정 조사나 특검은 경찰의 수사가 미진하거나 국민적 의혹이 남아 있다면 그때 가서 논의하는 것이 순서입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.945,
                "end": 30.830
            }
        ]
    },
