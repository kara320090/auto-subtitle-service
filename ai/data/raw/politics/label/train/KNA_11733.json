        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 전당대회 돈봉투 의혹으로 검찰의 구속영장이 청구된 무소속 윤관석 이성만 의원 오늘 두 의원에 대한 체포동의안이 본회의 표결에 붙여집니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.109
            },
            {
                "speaker_id": "1",
                "transcription": "재적 의원 과반 출석에 출석 의원 과반이 찬성하면 통과되는데 167석으로 과반인 민주당의 선택에 결과가 달렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.119,
                "end": 18.845
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 당론을 정하지 않고 의원 개개인에 맡기겠다는 입장입니다.",
                "sound_type": [
                    2
                ],
                "start": 18.855,
                "end": 23.695
            },
            {
                "speaker_id": "2",
                "transcription": "두 의원께서는 이미 탈당을 하셨고요.",
                "sound_type": [
                    2
                ],
                "start": 23.705,
                "end": 27.847
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 관련해서는 의원들이 자율적으로 투표할 것으로 알고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.857,
                "end": 32.374
            },
            {
                "speaker_id": "1",
                "transcription": "당내 분위기는 엇갈립니다.",
                "sound_type": [
                    2
                ],
                "start": 32.384,
                "end": 34.680
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 한 의원은 증거 인멸과 도주 우려가 없음에도 검찰이 영장을 무조건 청구한다며 검찰의 모욕 주기식 수사에 대한 반감이 표에 반영될 거라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.690,
                "end": 45.378
            }
        ]
    },
    "summary": "돈봉투 의혹으로 구속 영장이 청구된 윤관석 이성만 의원에 대한 체포동의안이 본회의 표결에 붙여지며 민주당은 개개인에게 맡기겠다는 입장이다.",
