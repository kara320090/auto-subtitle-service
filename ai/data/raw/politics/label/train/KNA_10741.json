        "term": [
            {
                "speaker_id": "1",
                "transcription": "이재명 대표 주변 사람들이 왜 세상을 떴습니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.371
            },
            {
                "speaker_id": "1",
                "transcription": "왜 그들을 모른다고 양심을 속였습니까?",
                "sound_type": [
                    2
                ],
                "start": 3.381,
                "end": 7.598
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 언제까지 검찰을 탓할 것이냐며 최소한의 양심이 있다면 한 점 의혹 없이 밝혀지도록 수사에 협조하라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.608,
                "end": 16.707
            },
            {
                "speaker_id": "2",
                "transcription": "반면 쌍방울과의 인연은 내의를 사입은 것뿐이라며 관련성을 부인해 온 이 대표는 추가 입장을 밝히지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.717,
                "end": 24.107
            },
            {
                "speaker_id": "3",
                "transcription": "@이름1 회장이 지금 이 시점에 귀국한 이유가 뭐라고 생각하십니까?",
                "sound_type": [
                    2
                ],
                "start": 24.117,
                "end": 28.461
            }
        ]
    },
    "summary": "국민의 힘은 한 점 의혹 없이 밝혀지도록 수사에 협조하라고 했고 이 대표는 추가 입장을 밝히지 않았습니다.",
