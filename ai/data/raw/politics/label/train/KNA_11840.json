        "term": [
            {
                "speaker_id": "1",
                "transcription": "공정한 선거 관리는 기대하기 난망이다라는 우려가 벌써부터 나오고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.721
            },
            {
                "speaker_id": "2",
                "transcription": "한국당과 세 보수당은 혁신통합추진위원회 첫 회의에 참석했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.731,
                "end": 11.066
            },
            {
                "speaker_id": "2",
                "transcription": "신당 창당에 대한 의견을 교환하며 거리 좁히기에 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.076,
                "end": 15.344
            },
            {
                "speaker_id": "3",
                "transcription": "오늘부터 집약적인 논의를 통해 통합 신당을 우리가 만든다면 어떤 기준과 원칙들을 가지고 만들어야 할 것이고 또 이런 기준들에 동의하는 세력들을 어떻게 규합할 것인가",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.354,
                "end": 29.203
            },
            {
                "speaker_id": "2",
                "transcription": "귀국을 앞둔 안철수 전 의원은 정치공학적 통합 논의에 참여할 생각이 없다며 보수 대통합 참여에 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.213,
