        "term": [
            {
                "speaker_id": "1",
                "transcription": "김문수 위원장의 거친 언사로 파행을 거듭하던 국회 환노위는 이 발언으로 결국 파국을 맞았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.470
            },
            {
                "speaker_id": "2",
                "transcription": "문재인 대통령이 @이름1 선생을 좀 어 @이름1 선생을 가장 존경하는 사상가라면 확실하게 김일성 주의자입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.470,
                "end": 14.824
            },
            {
                "speaker_id": "3",
                "transcription": "당장은 김문수 위원장에 대해서는 퇴장 조치를 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.834,
                "end": 19.949
            },
            {
                "speaker_id": "1",
                "transcription": "퇴장 조치에 반발한 여당 의원들이 함께 회의장을 떠나면서 국감은 결국 반쪽으로 끝났습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.959,
                "end": 26.292
            },
            {
                "speaker_id": "1",
                "transcription": "김 위원장은 그러나 오늘도 자신의 주장을 꺾지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.302,
                "end": 30.326
            },
            {
                "speaker_id": "1",
                "transcription": "이번엔 방송 진행자와 설전을 벌였습니다.",
