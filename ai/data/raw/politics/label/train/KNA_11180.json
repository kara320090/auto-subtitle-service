        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰이 김남국 의원의 위믹스 코인 투자 의혹과 관련해 가상화폐 거래소를 압수수색했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.201
            },
            {
                "speaker_id": "1",
                "transcription": "김 의원이 민주당을 탈당한 지 하루 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.211,
                "end": 9.262
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 오늘 거래소 업비트와 빗썸 등에서 김남국 의원의 계좌 정보를 압수한 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.272,
                "end": 16.059
            },
            {
                "speaker_id": "1",
                "transcription": "압수수색 영장에 적용한 건 정치자금법 위반과 조세 포탈 범죄수익은닉 혐의 등입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.069,
                "end": 22.869
            },
            {
                "speaker_id": "2",
                "transcription": "저희 본사를 뭐 김남국 의원 관련 건으로 왔다까지 확인했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.879,
                "end": 27.220
            },
            {
                "speaker_id": "1",
                "transcription": "김 의원은 지난해 1월에서 2월에 걸쳐 빗썸 지갑에서 게임 관련 코인인 위믹스 85만 개를 다른 거래소인 업비트 지갑으로 이체했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.220,
                "end": 37.102
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 이와 관련해 금융정보분석원에서 비정상적 거래라는 통보를 받고 지난해 10월과 11월 두 차례 김 의원 계좌에 대한 압수수색 영장을 청구했지만 기각됐었습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.112,
                "end": 48.681
            }
        ]
    },
    "summary": "검찰은 이와 관련해 금융정보분석원에서 비정상적 거래라는 통보를 받고 지난해 10월과 11월 두 차례 김 의원 계좌에 대한 압수수색 영장을 청구했지만 기각됐었다.",
