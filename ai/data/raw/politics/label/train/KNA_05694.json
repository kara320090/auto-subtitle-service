        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 전 성남 도시 개발 공사 본부장을 통해 1억 4000만 원의 뇌물을 받은 혐의입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.537
            },
            {
                "speaker_id": "1",
                "transcription": "압수수색 직전 유 전 본부장에게 휴대전화를 버리라며 증거 인멸을 지시했다는 혐의도 함께 받습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.547,
                "end": 12.597
            },
            {
                "speaker_id": "1",
                "transcription": "이 밖에도 검찰은 대장동 사업 배당금 가운데 428억 원 상당의 지분을 정 실장과 유 전 본부장 그리고 @이름2 민주 연구원 부원장이 함께 소유했다고 보고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.607,
                "end": 23.921
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 이런 유착 관계가 2013년 위례 신도시 개발 때부터 계속 이어져 왔다고 판단해 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.931,
                "end": 30.795
            },
            {
                "speaker_id": "2",
                "transcription": "이재명 대표의 두 측근이죠.",
                "sound_type": [
                    2
                ],
                "start": 30.805,
                "end": 33.424
            },
            {
                "speaker_id": "2",
                "transcription": "@이름2 부원장 기소에 이어서 @이름3 실장까지 겨냥이 되면서 민주당의 반응은 어떤가요?",
                "sound_type": [
                    2
                ],
                "start": 33.434,
                "end": 39.406
            }
        ]
    },
    "summary": "뇌물을 받은 혐의와 이런 유착 관계는 위례 신도시 개발 때부터 이어져 왔다고 판단했다.",
