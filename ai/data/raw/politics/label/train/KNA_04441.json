        "term": [
            {
                "speaker_id": "1",
                "transcription": "노른자위 땅으로 꼽히는 경기도 성남시 백현지구입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.962
            },
            {
                "speaker_id": "1",
                "transcription": "지하 4층 지상 21층 규모로 호텔 건설이 한창입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.972,
                "end": 8.099
            },
            {
                "speaker_id": "1",
                "transcription": "이 호텔 사업권을 따낸 업체는 부동산 개발 업체 A사로 성남시와 시유지 30년 대부 계약을 2015년 체결했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.109,
                "end": 17.439
            },
            {
                "speaker_id": "1",
                "transcription": "수의 계약이었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.449,
                "end": 19.756
            },
            {
                "speaker_id": "1",
                "transcription": "지방계약법과 시행령을 보면 지자체가 수의계약을 하더라도 전자조달시스템을 통해 사업자를 공개 모집해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 19.766,
                "end": 28.193
            },
            {
                "speaker_id": "1",
                "transcription": "견적서도 2곳 이상으로부터 받아야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 28.203,
                "end": 31.248
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 성남시는 사업자 공개 모집도 안하고 A사의 사업 제안서만 받아 계약했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.258,
                "end": 37.804
            }
        ]
    },
    "summary": "성남시는 백헌지구 개발에 사업자 공개 모집도 안하고 A사의 사업 제안서만 받아 계약했다.",
