        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰의 중 정치적 중립성과 독립성이라는 부분이 잘 지켜져 왔다고 생각하십니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.921
            },
            {
                "speaker_id": "2",
                "transcription": "저는 전혀 그렇게 생각하지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.931,
                "end": 7.022
            },
            {
                "speaker_id": "3",
                "transcription": "경찰국 신설 대신 기존 국가 경찰 위원회를 강화하자는 야당 요구에도 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.032,
                "end": 13.962
            },
            {
                "speaker_id": "4",
                "transcription": "국가 경찰 위원회는 대통령령이니까 얼마든지 민주적 통제와 관련한 부분들을 강화하는 것이 가능하다는 얘기입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.972,
                "end": 22.574
            },
            {
                "speaker_id": "2",
                "transcription": "국가 경찰 위원회의 심의 의결한 내용은 아무런 기속력이 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.584,
                "end": 28.161
            }
        ]
    },
    "summary": "경찰의 정치적 중립성과 독립성이라는 부분이 잘 지켜져 왔다고 생각하냐는 의원의 질문에 저렇게 생각하지 않다고 답했고 경찰국 신설 대신 기존 국가 경찰 위원회를 강화하자는 야당 요구에도 선을 그었다고 기자는 보도했다.",
