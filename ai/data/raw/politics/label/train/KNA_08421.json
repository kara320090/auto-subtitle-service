        "term": [
            {
                "speaker_id": "1",
                "transcription": "서울시 의회 시정 질문 시간 민주당 이상훈 시의원이 신당역 사건을 다른 측면에서 보겠다며 이렇게 말합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.714
            },
            {
                "speaker_id": "2",
                "transcription": "이게 동료 직원이 이런 가해를 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.724,
                "end": 13.684
            },
            {
                "speaker_id": "2",
                "transcription": "보면 스토킹이라든지 불법 촬영이라든지 이런 것을 한 거죠.",
                "sound_type": [
                    2
                ],
                "start": 13.694,
                "end": 17.354
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까 미루어 봤을 때 좋아하는 친구인데 그걸 안 받아 주고 하니까 여러 가지 이제 폭력적인 이제 대응를 남자 직원이 한 것 같은데요.",
                "sound_type": [
                    2
                ],
                "start": 17.364,
                "end": 24.625
            },
            {
                "speaker_id": "1",
                "transcription": "살인 피의자 전 씨를 31살의 서울의 청년이라고 소개하며 이런 말도 합니다.",
                "sound_type": [
