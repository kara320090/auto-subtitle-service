                    2
                ],
                "start": 0.000,
                "end": 6.227
            },
            {
                "speaker_id": "1",
                "transcription": "조선 총독 관저로 쓰인 초대 본관부터 지금까지 청와대의 변천사를 선보이는 전시도 구상 중입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.237,
                "end": 14.095
            },
            {
                "speaker_id": "1",
                "transcription": "다만 영빈관을 최고급 미술관으로 만들겠다던 계획은 어려워졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.105,
                "end": 19.225
            },
            {
                "speaker_id": "1",
                "transcription": "지난해 12월부터 이삼 일에 하루꼴로 대통령실 행사에 청와대가 쓰이고 있기 때문입니다.",
                "sound_type": [
                    2
