        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰은 기획 보복 수사를 당장 멈추기 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.414
            },
            {
                "speaker_id": "2",
                "transcription": "이에 대해 한동훈 장관은 구체적 수사에 대해 지휘하지는 않는다고 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.424,
                "end": 10.330
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서도 전 정부 관련 수사를 중대 범죄 수사라고 규정하며 정치 보복 주장에 국민들이 동의하지 않을 거라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.340,
                "end": 18.890
            },
            {
                "speaker_id": "3",
                "transcription": "검찰과 경찰은",
