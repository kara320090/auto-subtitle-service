        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런 의사 없습니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.075
            },
            {
                "speaker_id": "2",
                "transcription": "저는 다 옳았다고 생각하지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.085,
                "end": 3.040
            },
            {
                "speaker_id": "2",
                "transcription": "송구스럽게 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.050,
                "end": 4.720
            },
            {
                "speaker_id": "3",
                "transcription": "반면 여당은 문재인 정부 때 증가한 사교육비와 교육 격차 등을 거론하며 이 후보자를 거들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.730,
                "end": 12.303
            },
            {
                "speaker_id": "4",
                "transcription": "가장 또 두드러지는 교육 분야에 있어서 문제라고 하면 학력 격차일 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.313,
                "end": 17.841
            },
            {
                "speaker_id": "3",
                "transcription": "이 후보자가 이사장을 지냈던 아시아 교육 협회에 사교육 업체가 공동 출자금과 고액의 기부금을 낸 데 대해 이해 충돌 가능성도 제기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.851,
