        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자진해서 좀 탈당해 줬으면 하는 의원분들 주위에 많을 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.130
            },
            {
                "speaker_id": "1",
                "transcription": "지금 만큼 선당후사가 필요한 때가 언제입니까?",
                "sound_type": [
                    2
                ],
                "start": 4.140,
                "end": 7.256
            },
            {
                "speaker_id": "2",
                "transcription": "앞서 당내 인사도 정 의원을 찾아가 탈당을 권유했는데 정 의원이 이를 공개하면서 당은 더욱 소란스러워졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.266,
                "end": 16.292
            },
            {
                "speaker_id": "2",
                "transcription": "정 의원은 자신을 찾아온 사람을 이핵관 이재명 핵심 관계자라고 표현하면서 당내에서 지속해서 괴롭힌다 하지만 탈당할 계획은 전혀 없다고 못 박았습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.302,
                "end": 28.086
            },
            {
                "speaker_id": "3",
                "transcription": "제가 내용을 잘 모르는 부분이어서요.",
                "sound_type": [
                    2
                ],
                "start": 28.096,
                "end": 31.345
            },
            {
                "speaker_id": "3",
                "transcription": "자꾸 뭐 구체적으로 말씀드리기가 좀 그렇습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.355,
                "end": 34.324
            },
            {
                "speaker_id": "2",
                "transcription": "당내에선 이핵관 표현은 봉이 김선달만큼 적절치 않았다.",
                "sound_type": [
                    2
                ],
                "start": 34.334,
                "end": 39.269
            },
            {
                "speaker_id": "2",
                "transcription": "호미로 막을 일을 포크레인으로 막는데 정청래 의원이 불을 질렀다는 반응들이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.279,
                "end": 45.445
            }
        ]
    },
