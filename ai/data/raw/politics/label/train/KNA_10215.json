        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 장난치거나 또 농담하거나 심지어 사진 찍고 이런 일도 좀 안 해주셨으면 좋겠고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.218
            },
            {
                "speaker_id": "2",
                "transcription": "중진 의원들이 발언을 이어가자 인근 주민이 항의하는 등 공사는 초반부터 순탄치 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.228,
                "end": 14.074
            },
            {
                "speaker_id": "3",
                "transcription": "지금 닫아 놓고 뭐하시는 거냐고요.",
                "sound_type": [
                    2
                ],
                "start": 14.084,
                "end": 16.750
            },
            {
                "speaker_id": "3",
                "transcription": "여기 지금 사람 시장에 납품하는 사람들 다 지나가는 길이에요.",
                "sound_type": [
                    2
                ],
                "start": 16.760,
                "end": 21.613
            },
            {
                "speaker_id": "3",
                "transcription": "지금 뭐하시는 거냐고요 지금 전부 다 더구 9시부터.",
                "sound_type": [
                    2
                ],
                "start": 21.623,
                "end": 25.536
            },
            {
                "speaker_id": "2",
                "transcription": "더 크게 문제가 된 건 김성원 의원의 이 발언이었습니다.",
                "sound_type": [
                    2
                ],
