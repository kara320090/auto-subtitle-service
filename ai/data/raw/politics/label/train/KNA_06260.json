        "term": [
            {
                "speaker_id": "1",
                "transcription": "자료 없이 정정당당하게 준비를 열심히 해 와서 그 준비된 바를 보여드리면서 토론하자는 거 단 하나였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.354
            },
            {
                "speaker_id": "2",
                "transcription": "검사가 범죄인을 취조를 할 때 자료 없이 취조를 합니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.364,
                "end": 13.061
            },
            {
                "speaker_id": "2",
                "transcription": "범인이 아니라고 하면 무슨 근거로 추궁을 합니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.071,
                "end": 16.061
            },
            {
                "speaker_id": "3",
                "transcription": "민주당은 또 다른 쟁점이었던 토론 주자에 대해 이재명 후보가 자유 토론을 수용하겠다고 물러섰으니 윤석열 후보가 양보할 차례라고 압박 중입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.071,
                "end": 27.504
            },
            {
                "speaker_id": "3",
                "transcription": "국민의 힘은 오늘 밤 12시를 협상 시한으로 정하며 민주당의 입장 변화를 요구했습니다.",
                "sound_type": [
                    2
                ],
