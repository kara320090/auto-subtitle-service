        "term": [
            {
                "speaker_id": "1",
                "transcription": "저희가 이제 협의를 하고 있거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.637
            },
            {
                "speaker_id": "2",
                "transcription": "이에 따라 공수처는 수원지검에 보낸 이첩 관련 공문에서 수사완료 뒤 공수처가 기소 여부를 판단할 수 있게 송치해 줄 것을 통보했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.647,
                "end": 13.344
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 검찰은 강력 반발하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.354,
                "end": 16.367
            },
            {
                "speaker_id": "2",
                "transcription": "수사팀장인 이정섭 수원지검 형사 3부장은 검찰 내부망에 올린 글에서 사건을 이첩받은 기관은 자체 권한으로 사건을 처리한다며 수사는 물론 기소권도 검찰에 있다고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.377,
                "end": 29.513
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 공수처가 수사 완료 뒤 송치를 주장하는 건 법적 근거 없는 수사 지휘권 행사와 다름없다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.523,
                "end": 37.871
            }
        ]
    },
    "summary": "공수처는 수원지검에 보낸 이첩 관련 공문에서 수사완료 뒤 공수처가 기소 여부를 판단할 수 있게 송치해 줄 것을 통보했고 공수처가 수사 완료 뒤 송치를 주장하는 건 법적 근거 없는 수사 지휘권 행사와 다름없다고 비판했다.",
