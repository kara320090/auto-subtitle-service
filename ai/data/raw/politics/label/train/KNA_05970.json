        "term": [
            {
                "speaker_id": "1",
                "transcription": "선대위 쇄신안 발표를 위해 이틀 만에 등장한 윤석열 후보 첫마디는 반성이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.272
            },
            {
                "speaker_id": "2",
                "transcription": "많은 국민들께서 과연 정권 교체가 가능한 것인지 걱정하고 계십니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.282,
                "end": 13.284
            },
            {
                "speaker_id": "2",
                "transcription": "다 모두 오롯이 후보인 제 책임입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.294,
                "end": 18.327
            },
            {
                "speaker_id": "1",
                "transcription": "자신이 선대위와 당을 잘 이끌지 못했다.",
                "sound_type": [
                    2
                ],
                "start": 18.337,
                "end": 21.944
            },
            {
                "speaker_id": "1",
                "transcription": "또 가족 문제를 거론하며 거듭 고개를 숙였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.954,
                "end": 25.229
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 선거 운동을 잘못해 왔다며 몸집을 스스로 불려 온 선대위의 해산을 선언했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.239,
                "end": 32.188
            },
            {
                "speaker_id": "2",
                "transcription": "매머드라 불렸고 민심을 제대로 파악하지 못한 지금까지 선거 캠페인의 잘못된 부분을 인정하고 다시 바로 잡겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.198,
                "end": 45.245
            }
        ]
    },
    "summary": "윤석열 후보는 그동안 선거 운동을 잘못해 왔다며 몸집을 스스로 불려 온 선대위의 해산을 선언했습니다.",
