        "term": [
            {
                "speaker_id": "1",
                "transcription": "사회적 신분과 사회적 영향력이 강합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.283
            },
            {
                "speaker_id": "1",
                "transcription": "이 2가지가 결합이 돼서 학교장이 위법한 미이행 조치를 했다라고 판단할 수밖에 없는데",
                "sound_type": [
                    2
                ],
                "start": 3.293,
                "end": 9.847
            },
            {
                "speaker_id": "2",
                "transcription": "이 과정에서 부적절한 답변이 나오기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.857,
                "end": 12.481
            },
            {
                "speaker_id": "3",
                "transcription": "경향 신문을 보는 학생한테는 빨갱이라고 놀리고 조선 일보를 보는 학생한테는 적폐라고 놀렸어요.",
                "sound_type": [
                    2
                ],
                "start": 12.491,
                "end": 19.902
            },
            {
                "speaker_id": "4",
                "transcription": "아이들의 자유니까 그것에 대해서 제가 문제의식을 갖고 있지는 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.912,
                "end": 23.650
            },
            {
                "speaker_id": "3",
                "transcription": "저게 폭력이에요 아니에요?",
                "sound_type": [
                    2
                ],
                "start": 23.660,
                "end": 25.077
            },
            {
                "speaker_id": "4",
                "transcription": "너무나 일상적으로 사용되는 언어라고",
                "sound_type": [
                    2
                ],
                "start": 25.087,
                "end": 27.201
            },
            {
                "speaker_id": "2",
                "transcription": "학교 폭력 관리 책임을 두고 언성이 높아지기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.211,
                "end": 31.740
            },
            {
                "speaker_id": "5",
                "transcription": "학교 폭력으로 인해서 관리받고 있는 아이들이 얼마나 있는지는 확인을 하셔야지 교장 아닙니까?",
                "sound_type": [
                    2
                ],
                "start": 31.750,
                "end": 39.039
            }
        ]
    },
    "summary": "이 과정에서 부적절한 답변이 나오기도 했고 학교 폭력 관리 책임을 두고 언성이 높아지기도 했습니다.",
