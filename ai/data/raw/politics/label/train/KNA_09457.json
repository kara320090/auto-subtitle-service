        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 통제 실패가 피해를 더 키웠다는 질타가 쏟아졌는데 경찰 지휘부는 사고를 너무 늦게 인지했다는 답변만 반복했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.920
            },
            {
                "speaker_id": "2",
                "transcription": "구급차 빨리 여러 대 지원 요청한다.",
                "sound_type": [
                    2
                ],
                "start": 7.936,
                "end": 10.910
            },
            {
                "speaker_id": "2",
                "transcription": "압사 관리 우선 조치하라.",
                "sound_type": [
                    2
                ],
                "start": 10.910,
                "end": 12.912
            },
            {
                "speaker_id": "2",
                "transcription": "앞서 신고 접수되는데 이런 얘기 들었습니까 못 들었습니까?",
                "sound_type": [
                    2
                ],
                "start": 12.922,
                "end": 16.077
            },
            {
                "speaker_id": "3",
                "transcription": "일단 그냥 흘러가는 무전 정도로 생각을 했던 거고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.087,
                "end": 19.198
            },
            {
                "speaker_id": "4",
                "transcription": "100건이 넘는 똑같은 거의 비슷한 압사 위험을 경고하는 그리고 비명소리가 섞 섞인 이런 112 신고가 접수가 됐습니다.",
                "sound_type": [
                    2,
