        "term": [
            {
                "speaker_id": "1",
                "transcription": "결국 개회는 20분 지연됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.510
            },
            {
                "speaker_id": "1",
                "transcription": "검찰청법 가결 후.",
                "sound_type": [
                    2
                ],
                "start": 2.520,
                "end": 4.821
            },
            {
                "speaker_id": "2",
                "transcription": "가결되었음을 선포합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.831,
                "end": 9.240
            },
            {
                "speaker_id": "1",
                "transcription": "한쪽에선 박수 한쪽에선 야유가 쏟아졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.250,
                "end": 12.288
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 무소속인 의장이 민주당만을 비호했다며 비난했고.",
                "sound_type": [
                    2
                ],
                "start": 12.298,
                "end": 18.096
            },
            {
                "speaker_id": "3",
                "transcription": "당신의 그 앙증맞은 몸을 저희 국민의힘 의원 위로 밟고 지내가기 위해서 앞줄에 앉아 있는 여성들 의장님 당신이 얘기하는 민주주의가 이런 겁니까.",
                "sound_type": [
                    2
                ],
                "start": 18.106,
