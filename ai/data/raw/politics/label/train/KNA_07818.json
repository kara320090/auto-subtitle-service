        "term": [
            {
                "speaker_id": "1",
                "transcription": "반면 민주당은 윤석열 정부의 경찰 길들이기에 김 청장이 결국 사의를 표명했다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.211
            },
            {
                "speaker_id": "2",
                "transcription": "경찰을 행안부 치하에 두고 직접 통제에 나서겠다고 하는 대국민 선전 포고를 강행한 셈입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.221,
                "end": 15.811
            },
            {
                "speaker_id": "1",
                "transcription": "나아가 경찰법과 정부조직법에 입법 취지를 훼손하는 등 법률에 위배된다며 오히려 이상민 행안부 장관의 탄핵 추진을 거론했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.821,
                "end": 26.222
            },
            {
                "speaker_id": "3",
                "transcription": "시행령 통치라는 반법률적 방식으로 경찰국 신설을 추진하는 것은 명백히 장관 탄핵의 사유가 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 26.232,
                "end": 36.736
            }
        ]
    },
    "summary": "반면 민주당은 이상민 장관의 탄핵 사유라고 한다.",
