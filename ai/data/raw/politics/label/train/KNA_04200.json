        "term": [
            {
                "speaker_id": "1",
                "transcription": "대한민국을 위하여 나를 던질 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.157
            },
            {
                "speaker_id": "1",
                "transcription": "저의 선택은 대한민국이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.167,
                "end": 9.540
            },
            {
                "speaker_id": "2",
                "transcription": "최 전 원장은 특히 문재인 정권이 권력의 단맛에 취해 있고 국민을 분열 시키고 시장 경제를 훼손하고 있다고 강도 높게 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.550,
                "end": 19.504
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 법과 원칙이 살아 있고 마음껏 일할 수 있는 기회가 있는 나라 열심히 일하면 잘살 수 있는 나라를 만들겠다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.514,
                "end": 28.773
            },
            {
                "speaker_id": "2",
                "transcription": "다른 국민의 힘 대선 후보들은 오늘 오전 서울 동자동 쪽방촌을 방문해 삼계탕과 얼음물을 전달하는 등 봉사 활동을 벌였습니다.",
                "sound_type": [
