        "term": [
            {
                "speaker_id": "1",
                "transcription": "공수처 설립과 검경 수사권 조정에 차질 없는 시행을 당부했던 문 대통령",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.936
            },
            {
                "speaker_id": "2",
                "transcription": "총리께서도 직접 챙겨주시기를 부탁드리겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.946,
                "end": 9.923
            },
            {
                "speaker_id": "1",
                "transcription": "열흘 만에 후속 조치를 직접 보고받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.933,
                "end": 13.415
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령은 과거 검찰은 잘못을 스스로 고쳐내지 못해 공수처는 매우 의미가 크다.",
                "sound_type": [
                    2
                ],
                "start": 13.425,
                "end": 19.432
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 개혁은 무엇보다 중요하다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.442,
                "end": 22.795
            },
            {
                "speaker_id": "1",
                "transcription": "정 총리는 공수처 설립 준비단을 총리 소속으로 설치하겠다면서 검경 수사권 조정 추진단도 설치한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.805,
                "end": 31.197
            }
        ]
    },
    "summary": "공수처 설립과 검경 수사권 조정에 차질 없는 시행을 당부했던 문 대통령은 공수처는 매우 의미가 크며 검찰 개혁은 무엇보다 중요하다고 강조했고 열흘 만에 후속 조치를 직접 보고받았으며 정 총리는 공수처 설립 준비단을 총리 소속으로 설치하겠다면서 검경 수사권 조정 추진단도 설치한다고 밝혔다.",
