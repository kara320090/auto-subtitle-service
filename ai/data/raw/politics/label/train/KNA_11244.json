        "term": [
            {
                "speaker_id": "1",
                "transcription": "지역 본부장 10여 명 가운데 서 모 씨와 유 모 씨 등 일부는 참고인 조사를 받은 후 최근 피의자 신분으로 전환된 걸로 KBS 취재 결과 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.772
            },
            {
                "speaker_id": "2",
                "transcription": "저는 그런 돈 받을 위치에 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.782,
                "end": 13.009
            },
            {
                "speaker_id": "3",
                "transcription": "돈을 전달한 위치에 있으셨나요?",
                "sound_type": [
                    2
                ],
                "start": 13.019,
                "end": 14.807
            },
            {
                "speaker_id": "2",
                "transcription": "아닙니다 그런 위치가 아닙니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.817,
                "end": 15.835
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 특히 지역 본부장들이 일주일에 한 차례씩 참석한 조직 본부 회의에 주목하고 있습니다.",
                "sound_type": [
                    2
