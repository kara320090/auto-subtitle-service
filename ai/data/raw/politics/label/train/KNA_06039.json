                "transcription": "이 시간까지 한 개도 못 팔고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 4.881,
                "end": 7.686
            },
            {
                "speaker_id": "2",
                "transcription": "제가 작년 1년 매출이요.",
                "sound_type": [
                    2
                ],
                "start": 7.696,
                "end": 9.144
            },
            {
