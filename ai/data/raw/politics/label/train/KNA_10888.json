                ],
                "start": 2.700,
                "end": 7.619
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 땐 안전한 장소에 정차하고 정해진 시간 안에 다시 불어야 합니다.",
                "sound_type": [
