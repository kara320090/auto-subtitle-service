                "end": 9.183
            },
            {
                "speaker_id": "3",
                "transcription": "가해자 조사가 2주 후인 3월 17일 날 있었어요.",
                "sound_type": [
                    2
                ],
                "start": 9.193,
                "end": 13.682
            },
            {
                "speaker_id": "3",
                "transcription": "이 사이에 뭐가 있었겠습니까?",
