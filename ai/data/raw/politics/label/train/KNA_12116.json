        "term": [
            {
                "speaker_id": "1",
                "transcription": "소상공인 자영업자 대출 상담이 한창입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.650
            },
            {
                "speaker_id": "1",
                "transcription": "열흘 새 1만 7000여 건, 신청 금액은 1800억 원이 넘었습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.660,
                "end": 8.588
            },
            {
                "speaker_id": "1",
                "transcription": "대출 적채는 좀처럼 풀리지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.598,
                "end": 11.876
            },
            {
                "speaker_id": "1",
                "transcription": "매주 월요일 열리는 청와대 참모 회의를 취소하고 문 대통령이 직접 금융 기관장들을 만났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.886,
                "end": 19.600
            },
            {
                "speaker_id": "1",
                "transcription": "민간과 정책 금융 기관장들을 한자리에서 만난 건 이번이 처음입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.610,
                "end": 25.117
            },
            {
                "speaker_id": "1",
                "transcription": "문 대통령은 금융은 방역 현장의 의료진과 같다며 금융의 역할이 가장 중요한 때라고 말했습니다.",
