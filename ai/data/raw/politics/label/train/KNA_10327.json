                    2
                ],
                "start": 0.000,
                "end": 9.313
            },
            {
                "speaker_id": "2",
                "transcription": "예 파행하십시오. 파행하시고 원하는 대로 하세요.",
                "sound_type": [
                    2
                ],
                "start": 9.323,
                "end": 12.986
            },
            {
                "speaker_id": "3",
                "transcription": "예 그 정도로 하시",
                "sound_type": [
                    2
                ],
                "start": 12.996,
                "end": 14.213
            },
            {
                "speaker_id": "4",
                "transcription": "이러는 사이 많은 의원들이 해외로 떠났거나 떠날 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.223,
                "end": 18.574
            },
            {
                "speaker_id": "4",
                "transcription": "국회에 보고된 해외 출장 의원은 51명 민주당 31명 국민의힘 18명 등입니다.",
