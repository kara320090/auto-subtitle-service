            },
            {
                "speaker_id": "2",
                "transcription": "존경하는 남해 군민 여러분 AI 윤석열입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.655,
                "end": 11.686
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 정부는 여러분 과 함께 살기 좋은 남해군 희망찬 대한민국을 만들괐습니다.",
                "sound_type": [
