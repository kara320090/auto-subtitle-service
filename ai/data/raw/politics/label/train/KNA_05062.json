        "term": [
            {
                "speaker_id": "1",
                "transcription": "접 전화가 온 거죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.000
            },
            {
                "speaker_id": "1",
                "transcription": "국회가 새로 회기가 시작되니까 그 이전에 정리를 해줘야 된다.",
                "sound_type": [
                    2
                ],
                "start": 1.010,
                "end": 5.410
            },
            {
                "speaker_id": "2",
                "transcription": "과기부 산하의 12 개 공공기관에서도 문재인 정부 출범 후 전 정권에서 임명된 기관장들이 임기를 못 채우고 물러난 일이 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.420,
                "end": 14.714
            },
            {
                "speaker_id": "2",
                "transcription": "특히 한국 과학기술 기획평가원은 당시 원장이 사임 요구를 거절하자 과기부의 감사가 시작됐다는 의혹도 제기된 바 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.724,
                "end": 22.773
            },
            {
                "speaker_id": "2",
                "transcription": "환경부와 산업부에 이어 또 다른 부처들에 대한 강제수사가 시작되면서 문재인 정부의 공공기관장 사퇴 의혹에 대한 수사가 전방위로 확대될 수 있다는 관측도 나옵니다.",
                "sound_type": [
