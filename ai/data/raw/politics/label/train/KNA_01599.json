        "term": [
            {
                "speaker_id": "1",
                "transcription": "미국과 재처리 기술 협상을 한다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.892
            },
            {
                "speaker_id": "1",
                "transcription": "각각 이렇게 밝히지만 현실적 대안이냐에는 의문이 남습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.902,
                "end": 6.420
            },
            {
                "speaker_id": "2",
                "transcription": "새로 원전을 건설해서 임시 저장고를 새로 건설하는 전 원전 밑에 넣겠다.",
                "sound_type": [
                    2
                ],
                "start": 6.431,
                "end": 11.840
            },
            {
                "speaker_id": "2",
                "transcription": "이런 것으로 보여서 사실 폐기물 문제에 대한 대안이 없기 때문에",
                "sound_type": [
                    2
                ],
                "start": 11.830,
                "end": 16.138
