        "term": [
            {
                "speaker_id": "1",
                "transcription": "문재인 대통령은 이명박 전 대통령 사면 반대 청원에 아직은 원론적으로 답할 수밖에 없다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.079
            },
            {
                "speaker_id": "1",
                "transcription": "사법 정의와 국민 공감대를 잘 살펴서 판단하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.089,
                "end": 13.475
            },
            {
                "speaker_id": "2",
                "transcription": "반성 없는 태도 부패 범죄에 대한 관용 없는 처벌의 필요성을 이유로 반대하는 의견이 많지만 찬성 의견도 많다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.485,
                "end": 22.564
            },
            {
                "speaker_id": "2",
                "transcription": "반면에 국민 화합과 통합을 위해 사면에 찬성하는 의견도 많습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.574,
                "end": 28.433
            },
            {
                "speaker_id": "2",
                "transcription": "사면 기준만 언급했던 나흘 전 기자 간담회보다 진전된 발언으로 읽힙니다.",
                "sound_type": [
                    2
                ],
                "start": 28.443,
                "end": 34.837
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 청와대는 찬반 의견이 모두 있다는 점을 알리는 중립적 메시지라며 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.847,
                "end": 40.707
            }
        ]
    },
    "summary": "문재인 대통령은 이명박 전 대통령 사면 반대 청원에 찬반 의견이 모두 있다고 밝혔다.",
