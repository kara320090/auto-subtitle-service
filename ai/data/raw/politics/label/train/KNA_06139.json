        "term": [
            {
                "speaker_id": "1",
                "transcription": "우선 사람은 지상 차량은 지하 원칙 하에 지하철 1 2 4 호선과 경부고속도로 일부 구간을 지하화하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.254
            },
            {
                "speaker_id": "1",
                "transcription": "또 서울 서남부권을 지식산업지구로 만들어 강남과 강북 격차를 줄이겠다고 했고 여의도는 금융 허브로 마곡 양재 창동 등을 창업 허브로 만들겠다고 공약했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.264,
                "end": 22.799
            },
            {
                "speaker_id": "1",
                "transcription": "부동산 공급 문제에는 며칠 내로 내놓겠다고 언급했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.809,
                "end": 26.773
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게까지 하나 싶을 정도의 대규모라는 게 이 후보 표현입니다.",
                "sound_type": [
