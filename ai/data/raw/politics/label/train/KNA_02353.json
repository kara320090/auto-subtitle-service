        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령의 제안으로 광주행 특별 열차를 함께 탄 여당 의원들 윤 대통령과 일일이 인사를 나눴습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.723
            },
            {
                "speaker_id": "2",
                "transcription": "앉으세요. 앉으세요. 앉아요.",
                "sound_type": [
                    2
                ],
                "start": 7.733,
                "end": 10.660
            },
            {
                "speaker_id": "1",
                "transcription": "박수로 화답하며 화기애애한 분위기를 연출하기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.670,
                "end": 13.853
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 이른바 호남 동행 의원들과 식사를 함께하며 통합을 강조했고 국무 위원들에겐 격려를 건넸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.863,
                "end": 24.732
            },
            {
                "speaker_id": "1",
                "transcription": "기념식에는 사실상 국민의힘 의원 전원이 참석했는데 보수 정당으로선 이례적인 일입니다.",
                "sound_type": [
                    2
                ],
                "start": 24.742,
                "end": 31.502
            },
            {
                "speaker_id": "1",
                "transcription": "국민 통합 행보를 가시적으로 보여주면서 호남 민심을 고리로 중도층에도 다가가겠단 의도로 풀이됩니다.",
                "sound_type": [
