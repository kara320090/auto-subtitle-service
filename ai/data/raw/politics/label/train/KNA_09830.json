        "term": [
            {
                "speaker_id": "1",
                "transcription": "앞서 대통령실 이전과 도감청을 연계해 비판했던 야당은 주권 문제로 공세를 이어가고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.637
            },
            {
                "speaker_id": "2",
                "transcription": "대등한 주권 국가로서 당당하게 진상 규명을 요구하고 미국 정부의 공식 사과를 받아야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 6.647,
                "end": 15.853
            },
            {
                "speaker_id": "1",
                "transcription": "반면 외교 문제를 정쟁화하지 말라 맞받았던 여당은 문제를 더 키우지 않겠단 기류입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.863,
                "end": 22.793
            },
            {
                "speaker_id": "3",
                "transcription": "악의적인 것은 아니라고 또 말씀을 하셨었어요.",
                "sound_type": [
                    2
                ],
                "start": 22.803,
                "end": 26.016
            },
            {
                "speaker_id": "4",
                "transcription": "근데 그렇게 듣고 제가 답변드릴 수 있는 얘기는 아니잖아요.",
                "sound_type": [
                    2
                ],
                "start": 26.026,
                "end": 28.299
            },
            {
                "speaker_id": "4",
                "transcription": "제가 내용을 파악해 본다 이 말씀드리도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.309,
                "end": 30.989
            },
            {
                "speaker_id": "1",
                "transcription": "대통령실은 물밑에선 보안 점검과 대책 회의 등 수습에 고심하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.999,
                "end": 36.169
            }
        ]
    },
    "summary": "대통령실은 물밑에선 보안 점검과 대책 회의 등 수습에 고심하고 있다.",
