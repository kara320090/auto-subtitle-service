        "term": [
            {
                "speaker_id": "1",
                "transcription": "불법 자금은 1원 본 일도 쓴 일도 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.260
            },
            {
                "speaker_id": "2",
                "transcription": "의원들은 사상 유례없는 정치 쿠데타다 권력의 친위대로 전락한 고삐 풀린 정치 검찰의 방종이라며 비판을 쏟아냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.270,
                "end": 15.208
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 압수수색을 물리력으로 저지한 민주당을 강하게 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.218,
                "end": 19.924
            },
            {
                "speaker_id": "3",
                "transcription": "공무 집행을 의도적으로 방해하는 또 다른 범법 행위일 뿐입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.934,
                "end": 24.835
            },
            {
                "speaker_id": "3",
                "transcription": "이것은 법치주의와 자유 민주주의에 대한 정면 도전입니다.",
