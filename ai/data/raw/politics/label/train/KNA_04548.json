        "term": [
            {
                "speaker_id": "1",
                "transcription": "공수처는 지난 23일 손 검사에 대해 전격적으로 사전 구속 영장을 청구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.674
            },
            {
                "speaker_id": "1",
                "transcription": "피의자 직접 조사 없이 바로 구속 영장을 청구한 건 이례적인 일입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.684,
                "end": 11.160
            },
            {
                "speaker_id": "1",
                "transcription": "공수처는 손 검사가 수사에 비협조적 태도를 보였다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.170,
                "end": 16.058
            },
            {
                "speaker_id": "1",
                "transcription": "지난 4일부터 소환 일정을 조율했지만 변호인 선임 등을 이유로 출석 일자를 계속 미뤘다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 16.068,
                "end": 23.131
            },
            {
                "speaker_id": "1",
                "transcription": "공수처는 지난 20일 손 검사 체포 영장을 청구했지만 법원은 기각했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.141,
                "end": 28.819
            },
            {
                "speaker_id": "1",
                "transcription": "이후 손 검사가 출석을 약속한 22일 또다시 불출석했고 공수처는 구속 영장을 청구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.829,
                "end": 35.668
            }
        ]
