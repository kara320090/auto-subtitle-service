        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "법사 위원장과의 면담에 앞서 기자들을 먼저 만났고 거듭 수사권 폐지 법안 반대 입장을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.607
            },
            {
                "speaker_id": "2",
                "transcription": "결국 그 검사 썩이는 강릉 폐지 법안의 핵심은 검찰을 없애자는 것으로 저는 이해합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.617,
                "end": 14.367
            },
            {
                "speaker_id": "2",
                "transcription": "그러면 그 업무 부담은 경찰과 법원으로 다 넘어가게 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.377,
                "end": 19.441
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 수사에 문제가 있다면 특별법 제정이나 특위 구성에 얼마든지 따르겠다며 뿔을 고치려다 소를 죽이는 교각살우의 잘못은 없었으면 좋겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.451,
                "end": 31.333
            },
            {
                "speaker_id": "1",
                "transcription": "박광원 법사 위원장에게는 검찰 입장을 정리한 편지를 전달하기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.343,
                "end": 36.512
            },
            {
                "speaker_id": "2",
                "transcription": "신비한 편지.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.522,
                "end": 37.653
            },
            {
                "speaker_id": "3",
                "transcription": "아 예.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.663,
                "end": 39.146
            },
            {
                "speaker_id": "1",
                "transcription": "중요한 권력형 범죄 수사를 발표할 때나 언론 앞에 섰던 대검의 반부패 강력 부장도 이례적으로 기자 간담회를 자청했습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.156,
                "end": 48.977
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 수사권이 폐지되면 현재 진행 중인 대장동 사건과 산업부 블랙리스트 등 주요 수사가 중단될 거라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 48.987,
                "end": 58.131
            },
            {
                "speaker_id": "1",
                "transcription": "간부급들의 항의성 사직도 계속되고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.141,
                "end": 62.100
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 김수현 창원지검 통영지청장이 가세했고 철저한 무기력함을 느낀다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.105,
                "end": 68.360
            },
            {
                "speaker_id": "1",
                "transcription": "저항으로 사직을 택했다는 그를 내부망에 올렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 68.360,
                "end": 72.625
            },
            {
                "speaker_id": "1",
                "transcription": "오는 19일에는 전국 평검사들도 모입니다.",
                "sound_type": [
                    2
                ],
                "start": 72.635,
                "end": 76.274
            },
            {
                "speaker_id": "1",
                "transcription": "150여 명이 대검찰청에서 수사권 폐지 대응책을 논의한다는데 이른바 검란으로 확산될지 이 날이 중대 분수령이 될 전망입니다.",
                "sound_type": [
                    2
                ],
                "start": 76.284,
                "end": 86.820
            }
        ]
    },
    "summary": "김오수 검찰청장이 법사 위원장과의 면담을 통해 검찰 수사권 폐지 법안에 반대하는 검찰 입장을 전달하고 대검의 반부패 강력 부장도 반대 입장을 표명하며 전국 평검사 150여 명이 수사권 폐지 대응책을 논의하고 있다고 보도했다.",
