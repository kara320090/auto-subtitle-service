        "term": [
            {
                "speaker_id": "1",
                "transcription": "이와 함께 비명계 의원 30여 명은 의원 총회에서 당 쇄신을 촉구했던 청년 정치인들을 향한 강성 지지층들의 공격 중단을 결의하자고 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.711
            },
            {
                "speaker_id": "2",
                "transcription": "지금 당의 여러 단합을 해치고 있다고 보는데 이런 문제에 대해서는 이게 단호하게 대처해야 한다.",
                "sound_type": [
                    2
                ],
                "start": 10.721,
                "end": 17.257
            },
            {
                "speaker_id": "2",
                "transcription": "이런 이야기들을 계속해왔지만 실질적인 어떤 조치들이 제대로 이루어지지 않고",
                "sound_type": [
                    2
                ],
                "start": 17.267,
                "end": 23.830
            },
            {
                "speaker_id": "1",
                "transcription": "이처럼 당내 계파 갈등이 수면 위로 드러난 가운데 새로 꾸려질 당 혁신 기구는 또 다른 외관입니다.",
                "sound_type": [
