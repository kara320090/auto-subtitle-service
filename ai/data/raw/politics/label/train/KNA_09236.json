                ],
                "start": 11.555,
                "end": 18.531
            },
            {
                "speaker_id": "2",
                "transcription": "연달아 두 차례 본회의가 소집돼야 하는 건데 김진표 국회의장은 일단 내일과 모레 예정대로 본회의를 열겠다는 입장인 것으로 알려졌습니다.",
                "sound_type": [
