        "term": [
            {
                "speaker_id": "1",
                "transcription": "오세훈 서울시장이 이틀 연속 기획재정부를 향해 지하철 무임승차에 따른 손실분 지원을 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.233
            },
            {
                "speaker_id": "1",
                "transcription": "매년 1조 원대 적자인 서울 지하철에 무임승차 비율이 30퍼센트 정도라며 정부가 결정한 무임승차의 부담을 지자체가 지는 것은 모순이라고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.243,
                "end": 18.997
            },
            {
                "speaker_id": "1",
                "transcription": "난방비뿐 아니라 교통비도 민생이라며 기재부가 나서주면 인상 폭을 조정할 수도 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.007,
                "end": 27.002
            },
            {
                "speaker_id": "2",
                "transcription": "올해 중에라도 지원을 하겠다 이렇게 입장을 선회해 준다면 그에 걸맞은 만큼",
                "sound_type": [
                    2
                ],
                "start": 27.012,
                "end": 33.400
            }
        ]
    },
    "summary": "지하철 요금 인상에 대해 서울시는 무임승차로 생기는 손실을 정부가 메꿔줘야 한다고 주장했다.",
