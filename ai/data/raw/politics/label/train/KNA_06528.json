        "term": [
            {
                "speaker_id": "1",
                "transcription": "2001년 1월 김대중 정부 당시 탄생한 여성부는 여성의 지위 향상을 역할로 내세웠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.160
            },
            {
                "speaker_id": "2",
                "transcription": "여성들이 이제 21세기에 남성과 똑같이 그야말로 남녀평등으로 나갈 수 있는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.170,
                "end": 16.076
            },
            {
                "speaker_id": "1",
                "transcription": "21년간 이 역할은 한 번도 바뀌지 않았지만 정권이 바뀔 때마다 보육과 가족 청소년 관련 업무는 포함됐다 제외됐다를 반복했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.086,
                "end": 27.189
            },
            {
                "speaker_id": "1",
                "transcription": "지금의 여성가족부는 2010년 청소년과 가족 업무를 다시 받아오면서 완성됐습니다.",
                "sound_type": [
