        "term": [
            {
                "speaker_id": "1",
                "transcription": "육이오 전쟁 당시 낙동강 방어선 전투 관련 전시물을 모은 칠곡의 호국 평화 기념관.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.035
            },
            {
                "speaker_id": "1",
                "transcription": "23만여 제곱미터 면적에 540억 원을 투입했지만 한 해 평균 10억 원대의 적자를 내고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.045,
                "end": 13.300
            },
            {
                "speaker_id": "2",
                "transcription": "무료 관람객이 많잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.310,
                "end": 15.190
            },
            {
                "speaker_id": "2",
                "transcription": "고엽제 뭐 참전 용사 다 무료지 경로 다 무료지.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.200,
                "end": 19.494
            },
            {
                "speaker_id": "2",
                "transcription": "돈 들어갈 일들은 있지 돈 받을 일은 없거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.504,
                "end": 23.033
            },
            {
                "speaker_id": "1",
                "transcription": "2009년 265억 원을 들여 만든 경산 시민 운동장은 코로나19 사태 속에 지난해 단지 470명만이 이용했",
                "sound_type": [
                    2
                ],
                "start": 23.043,
                "end": 30.964
            }
        ]
    },
    "summary": "공공 시설물들을 이용하는 관람객이 적어 적자가 심각하다.",
