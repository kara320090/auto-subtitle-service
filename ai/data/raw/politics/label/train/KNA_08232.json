        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "장관 사퇴까지 초래한 정책 실패에 대한 사과 요구도 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.085
            },
            {
                "speaker_id": "2",
                "transcription": "자 공식적으로 아 지금은 차관이자 장관 직무 대행입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.095,
                "end": 9.042
            },
            {
                "speaker_id": "2",
                "transcription": "사과 하겠습니까 안 하겠습니까 공식적으로.",
                "sound_type": [
                    2
                ],
                "start": 9.052,
                "end": 11.144
            },
            {
                "speaker_id": "3",
                "transcription": "예 송구스럽단 말씀 드립 예 사과드립니다.",
                "sound_type": [
                    2
                ],
                "start": 11.154,
                "end": 13.817
            },
            {
                "speaker_id": "1",
                "transcription": "또 설익은 학제 개편안 발표에 책임 소재를 따져 묻는 여야 질의가 잇따랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.827,
                "end": 20.000
            },
            {
                "speaker_id": "4",
                "transcription": "아이디어 차원의 그 정책을 대통령 업무 보고에 내놓고 그 인한 좀 이렇게 분란과 갈등 혼란을 좀 초래했다 이런.",
                "sound_type": [
                    2
                ],
                "start": 20.010,
                "end": 28.632
            },
            {
                "speaker_id": "5",
                "transcription": "업무 보고 준비할 때 누가 그거 제안을 했냐고 묻잖아요 지금.",
                "sound_type": [
                    2
                ],
                "start": 28.642,
                "end": 31.412
            },
            {
                "speaker_id": "3",
                "transcription": "어떤 아이디어를 그 누구 개인의 이름으로 제안하진 않습니다 그러니까.",
                "sound_type": [
                    2
                ],
                "start": 31.422,
                "end": 36.569
            }
        ]
    },
    "summary": "또 설익은 학제 개편안 발표에 책임 소재를 따져 묻는 여야 질의가 잇따랐다.",
