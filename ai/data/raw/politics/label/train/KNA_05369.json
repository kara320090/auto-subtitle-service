        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령실은 야당을 지목한 것은 아니라며 야당에 소명할 기회가 있을 것이라고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.178
            },
            {
                "speaker_id": "1",
                "transcription": "언론 보도가 잘못됐다는 언급에 대통령실 출입 영상 기자단이 취재 과정에서 어떠한 짜깁기나 왜곡도 없었다며 정당한 취재와 보도에 대한 더 이상의 왜곡을 멈추라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.188,
                "end": 19.102
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 정치권 일각에서 나왔던 유감 표명 대신 전면 돌파를 선언한 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.112,
                "end": 25.652
            },
            {
                "speaker_id": "1",
                "transcription": "외교 참사라는 야권의 공세에 대응 수위를 끌어올렸다는 해석이 나옵니다.",
                "sound_type": [
                    2,
