                ],
                "start": 4.625,
                "end": 11.426
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 사면 심사위에서는 두 전직 대통령에 대한 논의는 없었던 것으로 전해졌습니다.",
                "sound_type": [
                    2
