        "term": [
            {
                "speaker_id": "1",
                "transcription": "김남국 의원이 투자했던 위믹스 코인 발행사를 찾은 국민의힘 의원들.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.086
            },
            {
                "speaker_id": "1",
                "transcription": "김 의원에게 코인을 공짜로 주고 입법 로비를 벌인 건 아닌지 집중 추궁했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.096,
                "end": 11.589
            },
            {
                "speaker_id": "2",
                "transcription": "합법화를 위해서 국회의원들을 만난 적이 있습니까?",
                "sound_type": [
                    2
                ],
                "start": 11.599,
                "end": 15.634
            },
            {
                "speaker_id": "3",
                "transcription": "제가 직접 만난 적은 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.644,
                "end": 18.453
            },
            {
                "speaker_id": "3",
                "transcription": "정확히 뭐 만난 적이 있을 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.463,
                "end": 20.989
            },
            {
                "speaker_id": "3",
                "transcription": "근데 뭐 누가 누굴 만나고 하는 것들의 보고를 제가 정확히 받은 적은.",
                "sound_type": [
                    2
                ],
                "start": 20.999,
                "end": 24.290
            }
        ]
    },
    "summary": "국민의힘 의원들이 김남국 의원이 투자했던 위믹스 코인 발행사를 찾아 입법 로비를 벌인 건 아닌지 추궁했다.",
