                "end": 6.799
            },
            {
                "speaker_id": "1",
                "transcription": "1조니 5000억이니 하는 이런 얘기들이 막 나오는데 그건 좀 근거가 없고요.",
                "sound_type": [
                    2,
                    5
                ],
