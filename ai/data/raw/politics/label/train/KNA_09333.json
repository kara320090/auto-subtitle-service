        "term": [
            {
                "speaker_id": "1",
                "transcription": "경고 등의 징계는 과반 의원 출석에 과반의 찬성이 있어야 가능합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.559
            },
            {
                "speaker_id": "1",
                "transcription": "제명은 전체 시의원 마흔다섯 명 가운데 서른 명 의원 3분의 2 이상이 동의해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.569,
                "end": 10.906
            },
            {
                "speaker_id": "1",
                "transcription": "김 의원을 뺀 국민의 힘 소속 의원은 스물여섯 명으로 모두 징계 요구서에 서명하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.916,
                "end": 17.526
            },
            {
                "speaker_id": "2",
                "transcription": "아예 서명을 안 했다는 거는 눈치 보기나 아예 서명 가치도 없다든지 그렇겠죠.",
                "sound_type": [
                    2
                ],
                "start": 17.536,
                "end": 23.043
            },
            {
                "speaker_id": "1",
                "transcription": "경남 김해에서는 김 의원을 응원하는 글을 올렸던 이미애 김해시 의원에 대해 징계나 사과를 요구하는 시민 단체의 목소리가 나오고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.053,
                "end": 32.532
            }
        ]
    },
