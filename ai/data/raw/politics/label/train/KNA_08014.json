        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런 부분들까지도 저는 생각을 하고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.784
            },
            {
                "speaker_id": "2",
                "transcription": "공정 위원장 제안을 받았을 때도 이 부분이 마음에 걸렸다고도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.794,
                "end": 7.627
            },
            {
                "speaker_id": "1",
                "transcription": "이 위원장을 제의 받았을 때 받았을 때도 가장 마음에 걸리는 부분이었고요 처음부터 말씀을 드렸고 어 이 문제 때문에 어려울 것 같다는 말씀도 많이 드렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.637,
                "end": 20.836
            },
            {
                "speaker_id": "2",
                "transcription": "송 후보자는 지난 8일 인사 청문 자료를 국회에 제출하는 등 인사 청문회를 준비해 왔던 걸로 전해집니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.846,
                "end": 27.993
            },
            {
                "speaker_id": "2",
                "transcription": "그러나 인사 청문회가 열리면 당시 사건이 다시 쟁점화할 것에 큰 부담을 느껴 자진 사퇴를 결심한 걸로 보입니다.",
                "sound_type": [
