        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 선대위 관계자는 이번 사안을 윤석열 대 심상정으로 놔두는 게 낫다며 언급 자체를 피하는 게 낫다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.061
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 후보는 여가부를 성평등 가족부로 바꾸고 일부 기능을 조정하자 제안했는데 젠더 이슈에 대해서는 일단 원론적 입장입니다.",
                "sound_type": [
                    2
                ],
                "start": 8.071,
                "end": 17.253
            },
            {
                "speaker_id": "2",
                "transcription": "또 뭘 말하는지는 최소한 알아야 되지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 17.263,
                "end": 20.456
            },
            {
                "speaker_id": "2",
                "transcription": "나의 길을 막아 버리자.",
                "sound_type": [
                    2
                ],
                "start": 20.466,
                "end": 22.610
            },
            {
                "speaker_id": "2",
                "transcription": "근처에 가지도 말자.",
                "sound_type": [
                    2
                ],
                "start": 22.620,
                "end": 24.019
            },
            {
                "speaker_id": "2",
                "transcription": "접근도 하지 말자.",
                "sound_type": [
                    2
                ],
                "start": 24.029,
                "end": 24.933
            },
            {
                "speaker_id": "2",
                "transcription": "이게 이거는 적절한 태도는 아닌 것 같아.",
                "sound_type": [
                    2
                ],
                "start": 24.943,
