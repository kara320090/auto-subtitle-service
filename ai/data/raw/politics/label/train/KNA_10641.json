        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 북한이 앞으로도 핵과 미사일 위협을 고도화하면서 다양한 수단으로 지속적으로 도발할 거라고 예상했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.385
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 일전을 불사한다는 결기로 적의 어떤 도발도 확실하게 응징해야 한다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.395,
                "end": 15.859
            },
            {
                "speaker_id": "1",
                "transcription": "대통령의 지시 이후 이종섭 국방 장관은 각군 작전 사령관과 긴급 지휘관 회의를 열었습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.869,
                "end": 23.511
            },
            {
                "speaker_id": "1",
                "transcription": "이 장관은 북한이 도발하면 자위권 차원에서 단호하고 강력하게 응징할 것을 주문했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.521,
                "end": 29.971
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 국방부는 강력한 대북 경고 입장문도 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.981,
                "end": 33.566
            }
        ]
    },
    "summary": "윤 대통령은 북한이 앞으로도 핵과 미사일 위협을 고도화하면서 다양한 수단으로 지속적으로 도발할 거라고 예상하면서 적의 어떤 도발도 확실하게 응징해야 한다고 강조했다.",
