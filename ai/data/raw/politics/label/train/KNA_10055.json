        "term": [
            {
                "speaker_id": "1",
                "transcription": "신원 조회가 실패하자 그대로 묻었다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.764
            },
            {
                "speaker_id": "2",
                "transcription": "지문 채취인 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 2.774,
                "end": 4.490
            },
            {
                "speaker_id": "2",
                "transcription": "부패가 돼서 조회가 안 된다고 다시 덮어라.",
                "sound_type": [
                    2
                ],
                "start": 4.480,
                "end": 8.439
            },
            {
                "speaker_id": "1",
                "transcription": "이번 증언은 518 당시 해남 군부대에 매장된 시신이 있었다는 또 다른 증언과도 일치합니다.",
                "sound_type": [
                    2
                ],
                "start": 8.449,
                "end": 16.029
            },
            {
                "speaker_id": "3",
                "transcription": "시신 3구를 매장한 것은 확실하다고 하더라고요.",
                "sound_type": [
                    2
                ],
                "start": 16.039,
                "end": 19.379
            },
            {
                "speaker_id": "3",
                "transcription": "해남에서 그때 군청의 위생 담당이 확인해준 거예요.",
                "sound_type": [
                    2
                ],
                "start": 19.389,
                "end": 25.612
            },
            {
                "speaker_id": "1",
                "transcription": "1980년 5월 해남에서는 518에 호응한 시위가 일어나며 사망자가 발생했는데 피해 규모는 지금도 명확하지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.622,
                "end": 33.833
            }
        ]
    },
