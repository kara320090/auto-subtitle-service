        "term": [
            {
                "speaker_id": "1",
                "transcription": "중고등학생에게도 사용을 권장하지 않는 지식 글의 사이트를 이용하는 거는 도무지 묵과할 수 없는 것이며.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.595
            },
            {
                "speaker_id": "2",
                "transcription": "사죄에 대한 정의는 점집 홈페이지에서 옮겨온 거 같다는 조사 결과도 덧붙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.605,
                "end": 13.708
            },
            {
                "speaker_id": "2",
                "transcription": "전체적으로 박사 학위 논문 860개 문장 가운데 220개 문장이 베껴 쓴 거라고 검증단은 결론 내렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.718,
                "end": 21.459
            },
            {
                "speaker_id": "2",
                "transcription": "학술지에 게재된 이른바 유지 논문 등 3편도 신문 기사 블로그 다른 논문 등을 표절한 거라고 분석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.469,
                "end": 30.035
            },
            {
                "speaker_id": "3",
                "transcription": "타인의 논문을 거의 통째로 베낀 상태입니다.",
