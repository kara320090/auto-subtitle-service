        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "더 이상 지켜보기 어렵다면 저도 결단할 때 결단하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.805
            },
            {
                "speaker_id": "2",
                "transcription": "추미애 장관이 말했던 결단은 하루 만에 수사 지휘권 발동으로 현실화 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.815,
                "end": 10.458
            },
            {
                "speaker_id": "2",
                "transcription": "이례적으로 공문까지 공개했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.468,
                "end": 13.011
            },
            {
                "speaker_id": "2",
                "transcription": "검찰총장을 수신자로 지정한 공문에서 추 장관은 내일로 예정된 검헌 유착 사건에 대한 전문 수사 자문단 심의 절차를 중단할 것을 지휘했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.021,
                "end": 23.518
            },
            {
                "speaker_id": "2",
                "transcription": "또 검찰 총장 최측근인 현재 검사장이 수사 대상인 만큼 수사팀이 독립적으로 수사한 뒤 결과만 윤 총장에게 보고 하라는 지시도 함께 내렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.528,
                "end": 33.844
            },
            {
                "speaker_id": "2",
                "transcription": "수사 자문단 소집 과정에서 충분한 의견 수렴 절차를 거치지 않았고 검찰 수사 심리도 예정돼 있어 두 결론이 일치하지 않을 경우 혼란이 예상된다는 점 등을 이유로 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.854,
                "end": 45.570
            },
            {
                "speaker_id": "2",
                "transcription": "수사가 한창 진행 중인 상황에서 기소 여부 등을 판단하는 수사 자문단 소집은 부적절하다.",
                "sound_type": [
                    2
                ],
                "start": 45.580,
                "end": 51.856
            },
            {
                "speaker_id": "2",
                "transcription": "특인 검사 수준의 수사 독립성을 보장해 달라는 중앙지검 수사팀의 의견을 추 장관이 대부분 수용한 모양새입니다.",
                "sound_type": [
                    2
                ],
                "start": 51.866,
                "end": 59.700
            },
            {
                "speaker_id": "2",
                "transcription": "추 장관은 이 같은 지휘의 근거로 법무부 장관은 구체적 사건에 대하여는 검찰총장만을 지휘 감독한다는 검찰청법 제8조 규정을 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.710,
                "end": 70.236
            }
        ]
    },
    "summary": "추 장관은 검찰총장을 수신자로 지정한 공문에서 내일로 예정된 검헌 유착 사건에 대한 전문 수사 자문단 심의 절차를 중단할 것을 지휘했고 수사의 독립성을 보장하라는 지시도 지휘했다.",
