            },
            {
                "speaker_id": "1",
                "transcription": "이 과정에서 백 전 장관과 조현옥 당시 청와대 인사 수석이 함께 움직였고 그 밖에도 과기부 통일부에서도 비슷한 일이 있었다고 검찰은 결론 내렸습니다.",
                "sound_type": [
