        "term": [
            {
                "speaker_id": "1",
                "transcription": "갈등들을 발견하고 그 다음에 그 갈등들을 처리하는 지저분한 일을 하는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.340
            },
            {
                "speaker_id": "1",
                "transcription": "근데 어떻게 보면 우리가 화장실이 냄새가 난다고 화장실을 줄이거나 없앨 수는 없잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.350,
                "end": 11.461
            },
            {
                "speaker_id": "2",
                "transcription": "국회를 화장실에 비유해 주셨는데요.",
                "sound_type": [
                    2
                ],
                "start": 11.471,
                "end": 13.931
            },
            {
                "speaker_id": "2",
                "transcription": "국회의원들이 뜨끔할 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.941,
                "end": 16.693
            },
            {
                "speaker_id": "3",
                "transcription": "500명의 시민참여단은 2주 동안 11시간 넘게 선거제 개편을 논의한 뒤 오늘 저녁 투표를 진행했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.703,
                "end": 23.899
            },
            {
                "speaker_id": "3",
                "transcription": "우선 응답자의 84퍼센트는 지금의 선거제도를 바꿔야 한다고 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.909,
                "end": 29.320
            },
            {
                "speaker_id": "3",
                "transcription": "국회의원 숫자는 현재의 300명보다 줄여야 한다는 의견이 많았는데 늘리거나 지금처럼 유지하자는 답변과 큰 차이는 없었습니다.",
