        "term": [
            {
                "speaker_id": "1",
                "transcription": "세종시로 소유권이 이전된 세종 예술의 전당 출입구 부근 화강암 바닥이 물을 먹어 진한 색으로 변했습니다",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.968
            },
            {
                "speaker_id": "1",
                "transcription": "누수 부위는 계속해서 커지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.978,
                "end": 11.173
            },
            {
                "speaker_id": "2",
                "transcription": "안전사고가 염려가 돼서 그 부분이 저희가 지금 가장 주의 깊게 지금 보고 있고",
                "sound_type": [
                    2
                ],
                "start": 11.183,
                "end": 18.067
            },
            {
                "speaker_id": "1",
                "transcription": "준공 8년밖에 안 된 국립 세종 도서관엔 정밀 안전 진단에서 D 등급 판정을 받아 1년 넘게 휴관에 들어가는 등 세종시의 공공건물의 안전성에 우려가 커지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.077,
                "end": 30.453
            },
            {
                "speaker_id": "3",
                "transcription": "세종시 초기에 지어진 국가 기관 시설들에 대해서도 마찬가지로 안전 진단이",
                "sound_type": [
