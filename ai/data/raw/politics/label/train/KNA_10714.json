        "term": [
            {
                "speaker_id": "1",
                "transcription": "중국의 보복성 조치에 우리 정부는 즉각 유감을 표명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.977
            },
            {
                "speaker_id": "1",
                "transcription": "외교부 당국자는 이번 중국 조치를 유감스럽게 생각한다며 중국 측에 우리 입장을 분명하게 전달했다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.987,
                "end": 11.609
            },
            {
                "speaker_id": "1",
                "transcription": "외교부는 중국발 입국자를 대상으로 한 우리 조치가 과학적이고 객관적 근거에 입각했다는 점을 여러 차례 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.619,
                "end": 19.706
            },
            {
                "speaker_id": "2",
                "transcription": "중국에 대해서는 우리 정부의 입장을 충분히 설명을 했고 또한 외교 채널을 채널을 통해서도 앞으로 계속 소통해 나갈 것입니다.",
                "sound_type": [
