        "term": [
            {
                "speaker_id": "1",
                "transcription": "전모를 밝히지 않고서 또 다른 부정부패를 막을 수 있겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.090
            },
            {
                "speaker_id": "1",
                "transcription": "또 다른 이권 개입을 막을 수 있겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 4.100,
                "end": 6.317
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이 문제를 그냥 가볍게 넘어갈 수 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.327,
                "end": 9.123
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 민주당의 국정 조사 요구가 금도를 넘어선 생떼라고 일축했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.133,
                "end": 14.836
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 문재인 정부 청와대 관련 의혹부터 국정 조사를 해야 한다고 맞받았습니다.",
                "sound_type": [
