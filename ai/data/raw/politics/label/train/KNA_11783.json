        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 국민들 모두가 작년보다는 좀 더 행복한 한 해 될 것 같습니까?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.762
            },
            {
                "speaker_id": "2",
                "transcription": "예",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.772,
                "end": 6.468
            },
            {
                "speaker_id": "1",
                "transcription": "예 그렇게 만들어야죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.478,
                "end": 8.296
            },
            {
                "speaker_id": "2",
                "transcription": "예",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.306,
                "end": 8.672
            },
            {
                "speaker_id": "1",
                "transcription": "예 정부가 좀 더 서 노력하고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.682,
                "end": 11.142
            },
            {
                "speaker_id": "3",
                "transcription": "3년째 이어지고 있는 청와대의 신년 산행 올해는 처음 역사 해설가도 동행했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.152,
                "end": 17.321
            },
            {
                "speaker_id": "4",
                "transcription": "역사학자들이 추정할 때는 520년 즈음에 고구려군이 여기 와서 머물렀던 걸로 보여지구요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.331,
                "end": 24.282
            },
            {
                "speaker_id": "3",
                "transcription": "문 대통령은 산행이 끝난 뒤 의인들을 청와대로 초청해 함께 떡국을 먹었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.292,
                "end": 30.252
            },
            {
                "speaker_id": "3",
                "transcription": "이 자리에서 문 대통령은 소방관 처우 개선과 응급 의료체계 보완을 약속했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 30.262,
                "end": 36.091
            },
            {
                "speaker_id": "3",
                "transcription": "문 대통령은 SNS로 한 신년 인사에서 올해는 국민께 보답하는 한 해라면서 확실한 성과로 꽃을 피우고 열매를 맺도록 하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.101,
                "end": 46.290
            },
            {
                "speaker_id": "3",
                "transcription": "한편 문 대통령은 추미애 법무부 장관 후보자의 청문보고서 송부 기한이 오늘로 끝남에 따라 추 후보자를 내일 법무부 장관에 임명할 것으로 보입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 46.300,
