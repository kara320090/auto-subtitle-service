        "term": [
            {
                "speaker_id": "1",
                "transcription": "이재명 경기 지사가 모든 경기도 도민에게 25만 원씩 재난 지원금을 지급하겠다고 발표했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.694
            },
            {
                "speaker_id": "1",
                "transcription": "당초 지급 대상에서 제외됐던 소득 상위 12퍼센트에게는 경기도 차원에서 지원금을 주겠다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.704,
                "end": 14.126
            },
            {
                "speaker_id": "2",
                "transcription": "함께 고통 받으면서 정부의 방역 조치에 적극 협력하고 무거운 짐을 나누어졌던 모든 국민들이 고르게 보상받아야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 14.136,
                "end": 24.267
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 지사는 정부 정책을 보완하는 것이 지방 자치의 본질이라고 주장했지만 경쟁 중인 당내 다른 후보들은 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.278,
                "end": 33.277
            },
            {
                "speaker_id": "3",
                "transcription": "전 국민이 에 국회의 결정을 받아들이고 있었을 텐데 거기에 형평성이 에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.287,
                "end": 43.009
            }
        ]
    },
