        "term": [
            {
                "speaker_id": "1",
                "transcription": "앞으로 일자리 창출 분야로 네 후보 다 디지털 전환과 미래 에너지 분야를 꼽았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.805
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 이재명 후보 135조 원 대대적 투자를 약속했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.815,
                "end": 10.622
            },
            {
                "speaker_id": "1",
                "transcription": "디지털 인프라 조성 초연결 신산업 육성 탄소 중립 신기술 개발 등으로 분야를 특정했고 목표 일자리 개수 300만 개를 제시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.632,
                "end": 21.144
            },
            {
                "speaker_id": "2",
                "transcription": "디지털 비대면 탈탄소 경제로 급속하게 전환하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.154,
                "end": 26.438
            },
            {
                "speaker_id": "2",
                "transcription": "일자리 대전환의 기회로 만들어야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 26.448,
                "end": 30.452
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보는 융합 산업 분야 디지털 전환에 지원하되 그 대상은 미래 경쟁력 있는 중소기업에 집중하겠다고 방향을 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.462,
                "end": 40.392
            },
            {
                "speaker_id": "1",
                "transcription": "양질의 일자리는 대부분 민간이 만든다며 민간 주도에 방점을 뒀습니다.",
                "sound_type": [
                    2
                ],
                "start": 40.402,
                "end": 45.876
            },
            {
                "speaker_id": "3",
                "transcription": "일자리 창출을 저해하는 모든 규제을 혁파하고",
                "sound_type": [
                    2
                ],
                "start": 45.886,
                "end": 50.216
            }
        ]
    },
    "summary": "앞으로 일자리 창출 분야로 네 후보 다 디지털 전환과 미래 에너지 분야를 꼽았으며 이재명 후보는 135조 원의 대대적 투자를 약속했고 윤석열 후보는 미래 경쟁력 있는 중소기업에 집중하겠다고 방향을 내놨습니다.",
