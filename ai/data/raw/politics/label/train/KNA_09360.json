        "term": [
            {
                "speaker_id": "1",
                "transcription": "투자자들의 관심이 쏠렸던 금융 투자 소득세는 시행을 2년 미루되 이 기간 주식 양도세는 지금처럼 과세하고 거래세는 점차 낮추기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.522
            },
            {
                "speaker_id": "1",
                "transcription": "다만 정부가 높이려던 대주주 기준은 현재의 10억 원을 유지합니다.",
                "sound_type": [
                    2
                ],
                "start": 10.532,
                "end": 15.357
            },
            {
                "speaker_id": "1",
                "transcription": "종합부동산세는 과세 기준을 공시가격 9억 원으로 올리고 1가구 1주택자의 경우 12억 원까지는 종부세를 물리지 않기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.367,
                "end": 25.361
            },
            {
                "speaker_id": "1",
                "transcription": "또 2주택자들도 종부세를 매길 때 기본세율을 적용합니다.",
                "sound_type": [
                    2
                ],
                "start": 25.371,
                "end": 30.330
            },
            {
                "speaker_id": "1",
                "transcription": "정부 여당이 추진한 가업상속공제 확대는 중견기업 매출액의 기준을 5000억 원으로 1000억 원 높였습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.340,
                "end": 37.996
            },
            {
                "speaker_id": "2",
                "transcription": "여야가 논의했던 대부분의 세목을 감세를 했는데요.",
                "sound_type": [
                    2
                ],
                "start": 38.006,
                "end": 41.200
            },
            {
                "speaker_id": "2",
                "transcription": "결과적으로 세수가 감소되는 것은 확실하고요.",
                "sound_type": [
                    2
                ],
                "start": 41.200,
                "end": 44.706
            },
            {
                "speaker_id": "2",
                "transcription": "재정 여력이 그만큼 악화될 수밖에 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 44.716,
                "end": 47.587
            },
            {
                "speaker_id": "1",
                "transcription": "국회는 국가채무와 국채 발행 규모는 정부안을 유지하기로 했습니다.",
                "sound_type": [
                    1,
