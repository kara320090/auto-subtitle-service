        "term": [
            {
                "speaker_id": "1",
                "transcription": "미국 인플레 감축법 반도체법 등은 우리 요구가 이미 어느 정도 반영됐다고 대통령실은 판단하고 있어 주요하게 다뤄지진 않을 전망입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.430
            },
            {
                "speaker_id": "1",
                "transcription": "안보와 경제 모두에서 미국과 협력 수준을 높이는 게 핵심인 셈 미국의 중국 러시아 견제 노선에 적극 동참하는 걸로 비치는 건 부담인 만큼 수위 조절 등의 관리가 관건입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.440,
                "end": 23.036
            },
            {
                "speaker_id": "1",
                "transcription": "도감청 의혹 파문이나 우크라이나 지원 문제 등은 논의되겠지만 공개하진 않을 거라는 게 한미 전문가들 전망입",
                "sound_type": [
