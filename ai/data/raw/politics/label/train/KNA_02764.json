        "term": [
            {
                "speaker_id": "1",
                "transcription": "비슷한 시각 윤핵관 장제원 의원도 주 원내대표에게 원내지도부를 준 것이 지금은 걱정이 된다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.502
            },
            {
                "speaker_id": "1",
                "transcription": "마음이 부글부글하다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.512,
                "end": 9.068
            },
            {
                "speaker_id": "1",
                "transcription": "이태원 참사 국면에서 야당에 밀려선 안 된다는 강경론이 분출된 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 9.078,
                "end": 15.017
            },
            {
                "speaker_id": "2",
                "transcription": "내부에 그런 의견이 있는 것은 사실이고요.",
                "sound_type": [
                    2
                ],
                "start": 15.027,
                "end": 17.123
            },
            {
                "speaker_id": "2",
                "transcription": "장제원 의원이 없는 걸 뭐 그런 분위기가 없는 걸 있다고 말씀하신 건 아닌 것 같다로",
                "sound_type": [
                    2
