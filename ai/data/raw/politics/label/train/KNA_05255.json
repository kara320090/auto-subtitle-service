        "term": [
            {
                "speaker_id": "1",
                "transcription": "전담 인력의 활동 내역에 대한 자료를 갖는 거는 저희가 법적으로 보장되어 있지가 않아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.749
            },
            {
                "speaker_id": "1",
                "transcription": "역할을 제대로 좀 할 수 있지 않을까.",
                "sound_type": [
                    2
                ],
                "start": 5.759,
                "end": 8.964
            },
            {
                "speaker_id": "2",
                "transcription": "사망 등 중대한 환자 안전사고가 나면 관리, 감독 기관이 병원을 점검할 수 있는 내용도 담겼습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.974,
                "end": 15.981
            },
            {
                "speaker_id": "3",
                "transcription": "어떤 업무를 해야 된다는 명확한 규정을 두고요.",
                "sound_type": [
                    2
                ],
                "start": 15.991,
                "end": 19.541
            },
            {
                "speaker_id": "3",
                "transcription": "환자 안전 전담 인력이 어떻게 지금 실행하고 있는지를 수시 점검하는 시스템을 마련해서.",
                "sound_type": [
                    2
                ],
                "start": 19.551,
                "end": 27.095
            },
            {
                "speaker_id": "2",
                "transcription": "이번 개정안은 조만간 국회에 발의될 예정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.105,
                "end": 31.149
            },
            {
                "speaker_id": "2",
