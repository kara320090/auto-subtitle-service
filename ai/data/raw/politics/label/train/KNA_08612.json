                "end": 5.761
            },
            {
                "speaker_id": "1",
                "transcription": "이후 면접을 거쳐 후보자는 2명으로 압축됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.771,
                "end": 9.659
            },
            {
                "speaker_id": "1",
                "transcription": "1순위는 예비역 장성 A 씨였습니다.",
