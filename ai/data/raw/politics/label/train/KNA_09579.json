        "term": [
            {
                "speaker_id": "1",
                "transcription": "58.5퍼센트가 지금의 소선구제 유지가 더 낫다고 응답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.014
            },
            {
                "speaker_id": "1",
                "transcription": "중대선거구제로 바꾸는 게 좋다는 의견은 30퍼센트였습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.024,
                "end": 9.306
            },
            {
                "speaker_id": "1",
                "transcription": "성별이나 나이 지역과 이념 성향에 상관 없이 소선거구제 유지 의견이 더 많았습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.316,
                "end": 15.706
            },
            {
                "speaker_id": "1",
                "transcription": "노동 시간 유연화 등을 통한 윤석열 정부 노동 개혁에 대해선 노동계의 잘못된 관행 해결을 위한 것이라는 의견이 48.7퍼센트로 나타났습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.716,
                "end": 25.971
            },
            {
                "speaker_id": "1",
                "transcription": "노동계를 적대시하고 갈등을 일으키는 일방적 추진이라는 응답은 39퍼센트였습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.981,
                "end": 32.309
            },
            {
                "speaker_id": "1",
                "transcription": "직업군 별로 생산직과 자영업자 층에선 긍정적 의견이 많았고 사무직 노동자들은 부정적 의견이 더 많았습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.319,
                "end": 40.373
            }
        ]
    },
    "summary": "성별이나 나이 지역과 상관없이 소선거구제 유지 의견이 더 많았고 노동 시간 유연화 등을 통한 윤석열 정부 노동 개혁에 대해선 노동계의 잘못된 관행 해결을 위한 것이라는 의견이 48.7퍼센트로 나타났다.",
