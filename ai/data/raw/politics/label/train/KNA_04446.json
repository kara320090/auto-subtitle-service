        "term": [
            {
                "speaker_id": "1",
                "transcription": "김의 장은 거듭 사과하며 고개를 숙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.678
            },
            {
                "speaker_id": "2",
                "transcription": "모빌리티는 여러 여러 가지 로사회적문제를 일으켜서 정말 죄송하고 송구스럽다는 말씀을 드리고요.",
                "sound_type": [
                    2
                ],
                "start": 2.688,
                "end": 9.349
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 골목상권을 침해하지 않겠다고 도 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.359,
                "end": 13.598
            },
            {
                "speaker_id": "2",
                "transcription": "골목 상권은 저희는 절대로 침해하지 침해한 사업은 진출하지 않을 거고요.",
                "sound_type": [
                    2
                ],
                "start": 13.608,
                "end": 18.497
            },
            {
                "speaker_id": "2",
                "transcription": "만약에 그 부분이 좀 관여돼 있다면 반드시 철수하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.507,
                "end": 21.831
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 그런 침해가 아니라 우리가 골목 상권을 도와줄 수 있는 방법을 적극적으로 좀 찾겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.841,
                "end": 28.153
            },
            {
                "speaker_id": "1",
                "transcription": "김 의장은 금산분리 위반 논란이 빚어진 개인 회사 케이큐브 홀딩스를 사회적 책임을 다하는 회사로 서둘러 전환하겠다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.163,
                "end": 37.437
            }
        ]
    },
