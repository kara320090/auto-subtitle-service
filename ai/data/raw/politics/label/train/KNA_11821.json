        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어제 본회의 회의장 반이 비었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.932
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 인사에 반발한 자유 한국당 불참 속 투표가 시작됩니다.",
                "sound_type": [
                    2
                ],
                "start": 2.942,
                "end": 7.812
            },
            {
                "speaker_id": "2",
                "transcription": "투표를 마치겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.822,
                "end": 9.858
            },
            {
                "speaker_id": "2",
                "transcription": "가결되었음을 선포합니다.",
                "sound_type": [
                    2
                ],
                "start": 9.868,
                "end": 11.571
            },
            {
                "speaker_id": "2",
                "transcription": "가결되었음을 선포합니다.",
                "sound_type": [
                    2
                ],
                "start": 11.581,
                "end": 13.469
            },
            {
                "speaker_id": "1",
                "transcription": "속전속결 법안 198건 표결에 163분 걸렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.479,
                "end": 21.975
            },
            {
                "speaker_id": "1",
                "transcription": "49초에 한 건씩 처리한 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.985,
                "end": 24.988
            },
            {
                "speaker_id": "1",
                "transcription": "기초 연금 지급 대상자를 소득 하위 20퍼센트에서 40퍼센트로 늘리는 기초 연금법 또 소상공인 지원을 체계화하는 소상공인 기본법 등이 빛을 보게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.998,
                "end": 36.897
            },
            {
                "speaker_id": "1",
                "transcription": "진통도 있었습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.907,
                "end": 38.558
            },
            {
                "speaker_id": "1",
                "transcription": "청년 기본법 대표 발의자 신보라 의원이 단상에 오르자 의원 여럿이 자리를 뜨고 야유가 터져 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 38.568,
                "end": 46.302
            },
            {
                "speaker_id": "3",
                "transcription": "자유 한국당 모든 의원님들의 청년에 대한 열망이 담겨있는 법안이기도 합니다.",
                "sound_type": [
                    2
                ],
                "start": 46.312,
                "end": 52.204
            },
            {
                "speaker_id": "4",
                "transcription": "그럼 들어와서 해.",
                "sound_type": [
                    2
                ],
                "start": 52.214,
                "end": 53.943
            },
            {
                "speaker_id": "1",
                "transcription": "한국당 의원 122명이 서명한 이 법안은 다른 당 의원들의 찬성표로 통과됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 53.953,
                "end": 60.506
            },
            {
                "speaker_id": "1",
                "transcription": "개인 정보 활용을 활성화하는 데이터 3법에도 반대 의견이 잇따랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 60.516,
                "end": 65.625
            },
            {
                "speaker_id": "5",
                "transcription": "기업의 이윤 앞에 무릎 꿇는 국회가 아니라 개인 정보의 소중함을 다시금 인식시키는 국회가 됩시다.",
                "sound_type": [
                    2
                ],
                "start": 65.635,
                "end": 73.059
            },
            {
                "speaker_id": "1",
                "transcription": "검경 수사권 조정안도 상정됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 73.069,
                "end": 76.442
            },
            {
                "speaker_id": "2",
                "transcription": "형사소송법 일부 개정 법률안을 상정합니다.",
                "sound_type": [
                    2
                ],
                "start": 76.452,
                "end": 80.180
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 다음 주 오는 13일 본회의에서 표결하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 80.190,
                "end": 85.277
            },
            {
                "speaker_id": "1",
                "transcription": "같은 날 정세균 국무총리 후보자 인준안도 함께 표결할 예정이어서 여야의 마찰은 계속될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 85.287,
                "end": 92.830
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 92.840,
                "end": 95.095
            }
        ]
    },
    "summary": "검찰 인사에 반발한 자유 한국당 불참 속에 본회의 투표가 시작됐고 법안 198건 표결에 163분이 걸렸으며 여러 민생 법안과 국무총리 후보자 인준안 등으로 여야의 마찰은 계속될 것으로 보인다.",
