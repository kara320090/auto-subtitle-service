        "term": [
            {
                "speaker_id": "1",
                "transcription": "노태우 전 대통령 때 시작된 예산안 국회 시정연설에서 야당은 종종 정부 여당에 불만을 표하곤 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.454
            },
            {
                "speaker_id": "1",
                "transcription": "여당인 국민의힘도 야당 시절 총리 시정연설에 불참하거나 대통령 연설에 시위를 벌이기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.464,
                "end": 15.068
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 대통령 연설 불참은 민주당이 처음 현재 정국 난맥상을 보여주는 건데 윤 대통령은 에둘러 비판하면서도 구체적 해법은 밝히지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.078,
                "end": 26.283
            },
            {
                "speaker_id": "2",
                "transcription": "야당이란 말은 안 썼지만 국회의 협력이 필요하고 협조가 중요하다는 것을 계속 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.293,
                "end": 33.666
            }
        ]
    },
    "summary": "윤석열 대통령은 야당이 국회 시정연설에 불참한 것에 대해 국회의 협력과 협조를 강조했다.",
