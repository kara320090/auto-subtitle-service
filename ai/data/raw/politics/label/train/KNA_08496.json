        "term": [
            {
                "speaker_id": "1",
                "transcription": "코로나 19 유행 뒤 전문의 세 명 가운데 두 명이 병원을 옮기면서 남은 한 명이 2년 넘게 수많은 환자를 전담하던 상황.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.550
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 서울시는 마지막 남은 전문의마저 자리를 옮기려 하고 보호자들의 항의가 빗발치자 채용 공고를 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.560,
                "end": 17.086
            },
            {
                "speaker_id": "2",
                "transcription": "워낙 공공하고 민간하고 이 대우 차이가 너무 많이 나니까 오시지 못한 부분이 있었던 부분이에요.",
                "sound_type": [
                    2
                ],
                "start": 17.096,
                "end": 23.710
            },
            {
                "speaker_id": "2",
                "transcription": "계속 구하고 있는 부분이고요.",
