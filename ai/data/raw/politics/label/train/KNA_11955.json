        "term": [
            {
                "speaker_id": "1",
                "transcription": "어떤 제한도 두지 말고 예상을 뛰어넘는 정책적 상상력을 발휘해달라고 주문했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.978
            },
            {
                "speaker_id": "1",
                "transcription": "구체적으로는 중소기업과 소상공인 금융 지원, 임대료 부담 완화 조치를 언급했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.988,
                "end": 12.034
            },
            {
                "speaker_id": "1",
                "transcription": "또 기업 인센티브 확대와 소비 쿠폰 같은 소비 진작책도 마련해 달라고 당부했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.044,
                "end": 18.435
            },
            {
                "speaker_id": "1",
                "transcription": "소비 쿠폰은 지난 2009년에도 취약 계층 공공근로 사업에서 급여액 일부로 지급된 적이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.445,
                "end": 25.445
            },
            {
                "speaker_id": "2",
                "transcription": "전례가 있다 없다를 따지지 말고 생각할 수 있는 대책들을 책상 위에 모두 꺼내 놓고 가능한 모든 수단을 동원해야 할 것입니다.",
                "sound_type": [
                    2
                ],
