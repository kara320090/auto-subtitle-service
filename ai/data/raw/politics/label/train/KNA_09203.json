                ],
                "start": 0.000,
                "end": 13.153
            },
            {
                "speaker_id": "1",
                "transcription": "이어 이 대표의 명예를 훼손하려는 악의적인 수사라고 검찰을 비판했습니다.",
                "sound_type": [
