            },
            {
                "speaker_id": "2",
                "transcription": "민주당 지도부는 이 후보의 결의를 존중한다면서도 원팀으로 대선을 치르기 위해 모두 함께하는 것이 중요하다며 사퇴를 만류하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.940,
                "end": 12.789
            },
            {
                "speaker_id": "2",
                "transcription": "이낙연 후보 의원직 사퇴에 별다른 반응을 보이지 않고 있는 이재명 후보는 고발사주 의혹을 받고 있는 윤석열 전 총장에 화력을 집중했습니다.",
                "sound_type": [
