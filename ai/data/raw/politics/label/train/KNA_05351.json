        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령실의 해명에 민주당은 강력 반발했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.277
            },
            {
                "speaker_id": "1",
                "transcription": "해명과 변명이 처참하다.",
                "sound_type": [
                    2
                ],
                "start": 3.287,
                "end": 5.697
            },
            {
                "speaker_id": "1",
                "transcription": "대한민국 국민 5000만 명을 난청있는 사람으로 만들었다며 비판을 쏟아냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.707,
                "end": 11.812
            },
            {
                "speaker_id": "2",
                "transcription": "저도 1번 100번 이상 들은 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.822,
                "end": 13.930
            },
            {
                "speaker_id": "2",
                "transcription": "굴욕과 빈손 외교도 모자라 욕설 파문으로 국격을 깎아내리더니 급기야 거짓 해명으로 국민을 분노케 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.940,
                "end": 25.546
            },
            {
                "speaker_id": "1",
                "transcription": "발언 대상이 우리 국회였다는 대통령실 해명에 대해서도 국민의 대표 기관인 민주당 국회의원 169명이 정녕 엑스 엑스 들이냐라고 꼬집었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.556,
                "end": 36.441
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 윤 대통령이 국제적 망신을 자처한데 대해 국민께 직접 사과하라고 촉구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.451,
                "end": 42.990
            },
            {
                "speaker_id": "1",
                "transcription": "개별 의원들도 일제히 SNS를 통해 저질 매국노 등 날선 반응을 쏟아냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 43.000,
                "end": 49.211
            },
            {
                "speaker_id": "1",
                "transcription": "반면 국민의힘은 대통령실 해명에 발을 맞추며 사태 수습에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 49.221,
                "end": 54.061
            },
            {
                "speaker_id": "1",
                "transcription": "정진석 비대 위원장은 KBS 라디오와의 인터뷰에서 대통령실의 해명을 믿을 수 밖에 없다며 우리 국익 전체에 도움이 될 지 조금 숨 고르기를 해야 할 필요가 있다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 54.071,
                "end": 66.541
            },
            {
                "speaker_id": "1",
                "transcription": "주호영 원내대표는 현재 정확한 정보가 없다면서도 비속어가 우리 국회를 향했다는 것에 대해선 일단 유감을 표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 66.551,
                "end": 75.229
            },
            {
                "speaker_id": "3",
                "transcription": "비판하더라도 예를 들면 귀국 후에 비판을 한다든지 만약에 그 용어가 우리 국회를 우리 야당을 의미하는 것이라 했다고 하더라도 오 많이 유감스러운 일이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 75.239,
                "end": 88.855
            }
        ]
    },
