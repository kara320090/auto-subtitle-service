        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 저서에 명성황후를 민비로 표현해 비판받기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.929
            },
            {
                "speaker_id": "1",
                "transcription": "한 말씀 해주시면 논란에 대해서 뭐",
                "sound_type": [
                    2
                ],
                "start": 3.939,
                "end": 7.610
            },
            {
                "speaker_id": "2",
                "transcription": "잘 풀어야 할 겁니다 앞으로.",
                "sound_type": [
                    2
                ],
                "start": 7.620,
                "end": 9.982
            },
            {
                "speaker_id": "1",
                "transcription": "여야 추천 상임위원이 정치적 성향이 뚜렷해 정쟁의 장으로 전락하는 것 아니냐는 우려도 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 9.992,
                "end": 17.131
            },
            {
                "speaker_id": "3",
                "transcription": "내가 누구의 추천을 받았느냐가 중요한 게 아니고 우리 교육을 위해서 중요한 게 무엇이냐라는 판단에 입각해서 행동하고 발언하고 일을 진행해 나가겠다는 게",
                "sound_type": [
                    2
                ],
                "start": 17.141,
                "end": 28.750
            },
            {
                "speaker_id": "1",
                "transcription": "교육계에선 정치권 위원 추천을 줄이고 교육 전문성을 강화하기 위한 보완책이 필요하다고 지적합니다.",
                "sound_type": [
                    2
                ],
                "start": 28.760,
                "end": 35.702
            }
        ]
    },
    "summary": "국가교육위원회가 여야 추천 상임위원의 정치적 성향으로 인해 정쟁의 장으로 전락하는 것 아니냐는 우려가 나오는 가운데 교육계에선 정치권 위원 추천을 줄이고 교육 전문성을 강화가 필요하다고 지적했다.",
