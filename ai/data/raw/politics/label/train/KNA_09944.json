        "term": [
            {
                "speaker_id": "1",
                "transcription": "돈 봉투 의혹이 불거진 지 10일 만에 귀국한 송 전 대표 국민과 당원에게 송구스럽다면서도 돈 봉투에 대해 몰랐느냐는 질문엔 즉답을 피했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.639
            },
            {
                "speaker_id": "2",
                "transcription": "이제 도착했으니까 상황을 좀 파악하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.649,
                "end": 14.609
            },
            {
                "speaker_id": "2",
                "transcription": "제가 모르는 사안들이 많기 때문에",
                "sound_type": [
                    2
                ],
                "start": 14.619,
                "end": 16.707
            },
            {
                "speaker_id": "1",
                "transcription": "다만 책임 있게 문제를 해결하겠다 검찰 수사에 당당히 대응하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.717,
                "end": 22.040
            },
            {
                "speaker_id": "2",
                "transcription": "오늘이라도 저를 소환하면 적극 응하겠다는 말씀을 드리겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.050,
                "end": 28.195
            },
            {
                "speaker_id": "2",
                "transcription": "어떤 일이 당하더라도 절대 회피하지 않고",
                "sound_type": [
                    2
                ],
                "start": 28.205,
                "end": 31.097
