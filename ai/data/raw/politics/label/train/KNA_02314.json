                ],
                "start": 0.000,
                "end": 4.470
            },
            {
                "speaker_id": "2",
                "transcription": "성차별 문제가 있다고 하는데 여성 가족부를 폐지하자고 얘기하시는 겁니까?",
                "sound_type": [
