        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령은 대통령실 용산 이전의 핵심 이유로 소통 강화를 꼽았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.402
            },
            {
                "speaker_id": "2",
                "transcription": "집무실의 1층에 프레스센터를 설치해서 수시로 언론과 소통하는 대통령이 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.412,
                "end": 14.135
            },
            {
                "speaker_id": "1",
                "transcription": "취임 다음 날부터 소통은 시작됐습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 14.145,
                "end": 17.309
            },
            {
                "speaker_id": "1",
                "transcription": "출근길 문답이라는 전례 없던 방식을 선보인 겁니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 17.319,
                "end": 21.022
            },
            {
                "speaker_id": "3",
                "transcription": "처음으로 출퇴근하시는 대통령이신데 좀 소감이 어떠신가요?",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 21.032,
                "end": 25.171
            },
            {
                "speaker_id": "2",
                "transcription": "글쎄 뭐 특별한 소감 없습니다 일해야죠.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 25.181,
                "end": 28.145
            },
            {
                "speaker_id": "1",
                "transcription": "그 자체가 파격으로 평가됐고 각종 여론조사에서 긍정 평가 요인으로 꼽혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.155,
                "end": 33.915
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 정제되지 않은 표현은 실언 논란으로 이어졌고 때로는 정국에 파장을 일으켰습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.925,
                "end": 39.695
            },
            {
                "speaker_id": "2",
                "transcription": "전 정권에 그 지명된 장관 중에 이렇게 훌륭한 사람 봤어요?",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 39.705,
                "end": 44.817
            },
            {
                "speaker_id": "2",
                "transcription": "또 다른 질문.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 44.827,
                "end": 45.812
            }
        ]
    },
    "summary": "윤석열 대통령은 소통 강화를 목표로 대통령실을 용산으로 이전해, 출근길 문답을 실시하였다.",
