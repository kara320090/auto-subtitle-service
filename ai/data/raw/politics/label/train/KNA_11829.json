        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 검찰 총장을 신뢰하냐는 질문에 문 대통령은 검찰 개혁으로 답했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.610
            },
            {
                "speaker_id": "1",
                "transcription": "공수처법 등 제도적 개혁은 끝났지만 검찰 권력은 여전히 막강하다.",
                "sound_type": [
                    2
                ],
                "start": 5.620,
                "end": 10.545
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 검찰 개혁은 여전히 중요하다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.555,
                "end": 13.909
            },
            {
                "speaker_id": "1",
                "transcription": "그 예로 피의사실 공표와 선택적 수사 문제를 들기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.919,
                "end": 18.411
            },
            {
                "speaker_id": "2",
                "transcription": "검찰이 어떤 조직 문화라든지 수사 관행 이런 부분을 고쳐나가는 이제까지 어 윤석열이 앞서 준다 앞장서 준다면 에 국민들로부터 훨씬 더 많은 어 신뢰를",
                "sound_type": [
                    2
                ],
                "start": 18.421,
                "end": 31.457
            },
            {
                "speaker_id": "1",
                "transcription": "최근 검찰 인사 논란은 법무부 손을 들어주면서도 이 1건으로 윤 총장을 평가하고 싶지는 않다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.467,
                "end": 38.826
            },
            {
                "speaker_id": "1",
                "transcription": "조국 전 장관 평가해달란 질문엔 이렇게 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.836,
                "end": 42.650
            },
            {
                "speaker_id": "2",
                "transcription": "지금까지 겪었던 어 어떤 고초",
                "sound_type": [
                    2
                ],
                "start": 42.660,
                "end": 47.013
            }
        ]
    },
    "summary": "문 대통령은 윤석열 검찰 총장을 신뢰하냐는 질문에 최근 검찰 인사 논란은 법무부 손을 들어주면서도 이 1건으로 윤 총장을 평가하고 싶지는 않다고 말했다.",
