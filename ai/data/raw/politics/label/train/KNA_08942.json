        "term": [
            {
                "speaker_id": "1",
                "transcription": "그동안 개별 기업들끼리 뭐 과당 경쟁하던 경우도 있었는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.720
            },
            {
                "speaker_id": "1",
                "transcription": "이제 민간 기업들과 정부가 함께 한팀으로 수주전을 펼치겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.730,
                "end": 12.114
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 이런 대책들이 당장 눈앞에 있는 고물가 고환율 고금리로 인한 위기에 대처하긴 부족해 보인다는 평가도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.124,
                "end": 20.126
            },
            {
                "speaker_id": "2",
                "transcription": "특히 반도체는 당장 내년이 걱정입니다.",
                "sound_type": [
                    2
                ],
                "start": 20.136,
                "end": 23.346
            },
            {
                "speaker_id": "3",
                "transcription": "반도체 팹을 지어야 되는데 거기에 들어가는 인프라 구축이 뭐 한 7년씩 걸려요.",
                "sound_type": [
                    2
                ],
                "start": 23.356,
                "end": 30.113
            },
            {
                "speaker_id": "3",
                "transcription": "그래서 지금 타이밍 상 빠르지도 않다",
                "sound_type": [
                    2
                ],
                "start": 30.123,
                "end": 32.532
            }
        ]
    },
    "summary": "정부의 대책이 당장 눈앞에 있는 위기를 대처하긴 부족해 보인다는 평가가 있다고 말했고 특히 반도체 시장이 걱정이라고 했다.",
