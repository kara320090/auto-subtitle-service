        "term": [
            {
                "speaker_id": "1",
                "transcription": "보험료가 월 3만 6000원 정도가 인하가 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.793
            },
            {
                "speaker_id": "1",
                "transcription": "32프로에 해당하는 275만 세대는 보험료가 현재와 똑같습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.803,
                "end": 9.142
            },
            {
                "speaker_id": "2",
                "transcription": "직장 가입자 대부분은 건보료 부담에 변화가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.152,
                "end": 12.953
            },
            {
                "speaker_id": "2",
                "transcription": "다만 급여 이외의 소득이 연 2000만 원을 넘는 직장 가입자의 2퍼센트는 건보료가 5만 1000원 오를 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.963,
                "end": 20.759
            },
            {
                "speaker_id": "2",
                "transcription": "건보료를 하나도 내지 않는 피부양자 자격 요건은 강화됩니다.",
                "sound_type": [
                    2
                ],
                "start": 20.769,
                "end": 25.125
            }
        ]
    },
    "summary": "직장 가입자 대부분은 건보료 부담에 변화가 없지만 급여 이외의 소득이 연 2000만 원을 넘는 직장 가입자의 2퍼센트는 오를 것으로 보이고 피부양자 자격 요건이 강화될 것이라고 전했다.",
