            },
            {
                "speaker_id": "2",
                "transcription": "자신에 대한 수사를 정적 제거라고 규정지은 건데 경찰이 1년 만에 무혐의 결론을 뒤집은 것에 대해서도 불만을 감추지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.938,
                "end": 20.402
            },
            {
                "speaker_id": "3",
                "transcription": "결과가 뒤집혔는데 이 점을 어떻게 보실까요.",
