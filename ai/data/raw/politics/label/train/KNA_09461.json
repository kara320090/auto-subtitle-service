        "term": [
            {
                "speaker_id": "1",
                "transcription": "그날 음주하셨어요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.160
            },
            {
                "speaker_id": "1",
                "transcription": "그날 저녁에 음주하셨냐구요.",
                "sound_type": [
                    2
                ],
                "start": 4.160,
                "end": 6.610
            },
            {
                "speaker_id": "2",
                "transcription": "주말 저녁이면 저도 음주할 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.610,
                "end": 8.822
            },
            {
                "speaker_id": "2",
                "transcription": "네 그것까지 밝혀드려야 되나요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.832,
                "end": 12.462
            },
            {
                "speaker_id": "2",
                "transcription": "음주했다고 말씀드렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.472,
                "end": 14.348
            },
            {
                "speaker_id": "3",
                "transcription": "경찰청이 있는 서울을 벗어난 기록을 경찰 내부 시스템에 입력하지 않았다는 의혹에 대해서도 마지못해 시인했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.358,
                "end": 22.338
            },
            {
                "speaker_id": "1",
                "transcription": "윤희근 증인 입력해왔습니까 안 했습니까?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.348,
                "end": 25.596
            },
            {
                "speaker_id": "2",
                "transcription": "어 의원님 아시는 바와 같이 저는 전국이 관할 범윕니다.",
                "sound_type": [
                    2
                ],
                "start": 25.606,
                "end": 29.300
            },
            {
                "speaker_id": "1",
                "transcription": "아이까 입력을 했어요 안 했어요?",
                "sound_type": [
                    2
                ],
                "start": 29.310,
                "end": 31.138
            },
            {
                "speaker_id": "2",
                "transcription": "안 했습니다.",
                "sound_type": [
