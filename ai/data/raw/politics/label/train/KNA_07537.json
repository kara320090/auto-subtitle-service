        "term": [
            {
                "speaker_id": "1",
                "transcription": "당의 공식 기구에서 컷 오프를 했고 그런데 갑자기 그게 그냥 어느 단위인지도 모르게 뒤집어졌어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.087
            },
            {
                "speaker_id": "2",
                "transcription": "이재명계 의원들 반격에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.097,
                "end": 10.100
            },
            {
                "speaker_id": "2",
                "transcription": "이재명 책임론은 차기 당권 도전을 막으려는 또 다른 계파주의란 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 10.110,
                "end": 15.336
            },
            {
                "speaker_id": "3",
                "transcription": "특정인을 출마하지 마라라고 주장하는 것은 이거 역시도 계파적 관점이고 계파적 이해 관계가 깔려 있는 것이고",
                "sound_type": [
                    2
                ],
                "start": 15.346,
                "end": 23.145
            },
            {
                "speaker_id": "2",
                "transcription": "논란 속에 이 의원은 내일 국회에 첫 출근합니다.",
                "sound_type": [
                    2
                ],
                "start": 23.155,
                "end": 26.545
            },
            {
                "speaker_id": "2",
                "transcription": "비대위 구성을 논의할 의원 총회에는 참석하지 않기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.555,
                "end": 30.430
            }
        ]
    },
    "summary": "이재명계 의원들은 책임론이 차기 당권 도전을 막으려는 또 다른 계파주의라고 비판했고 이재명 의원은 비대위 구성을 논의할 의원 총회에 참석하지 않기로 했다.",
