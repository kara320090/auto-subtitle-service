        "term": [
            {
                "speaker_id": "1",
                "transcription": "대장급으로 주는 그런 모욕적인 인사를 지금 하고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.087
            },
            {
                "speaker_id": "1",
                "transcription": "우리 경찰 역사상 이런 일은 한 번도 없었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.097,
                "end": 6.372
            },
            {
                "speaker_id": "2",
                "transcription": "경위 이하로도 특별한 사유 없이는 6개월 만에 인사 이동을 안 한다.",
                "sound_type": [
                    2
                ],
                "start": 6.382,
                "end": 11.842
            },
            {
                "speaker_id": "2",
                "transcription": "물갈이 보복성 인사다.",
                "sound_type": [
                    2
                ],
                "start": 11.852,
                "end": 14.067
            },
            {
                "speaker_id": "2",
                "transcription": "경찰 내부망도 들끓었고 일부 지역 직장 협의회에서도 비판 성명이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.077,
                "end": 19.881
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1 경찰청장은 종합적인 세평을 고려한 인사였다고 반박하면서도 회의 참석 이력이 평가에 근거가 되었는지에 대해선 명확한 답을 하지 않았습니다.",
                "sound_type": [
