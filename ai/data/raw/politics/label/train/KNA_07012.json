        "term": [
            {
                "speaker_id": "1",
                "transcription": "당시는 정부 대출 규제가 본격화되던 시기",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.959
            },
            {
                "speaker_id": "2",
                "transcription": "신 DTI가 내일부터 시행됩니다.",
                "sound_type": [
                    2
                ],
                "start": 2.969,
                "end": 6.402
            },
            {
                "speaker_id": "1",
                "transcription": "KBS는 이 씨가 정부에 신고한 자금 조달 계획서를 입수했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.412,
                "end": 11.834
            },
            {
                "speaker_id": "1",
                "transcription": "필요한 돈 2억 4000만 원을 충당한 내역을 보면 1억 8000만 원을 사인에게 빌렸고 은행 대출이 1500만 원 자신의 현금과 예금으로 4500만 원을 보탰다고 신고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.844,
                "end": 26.256
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 아파트 매입 두 달 전 이종섭 당시 합참차장이 신고한 장녀 예금은 1423만 원 뿐이었습니다.",
                "sound_type": [
                    2
