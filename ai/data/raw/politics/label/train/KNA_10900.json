                "start": 0.000,
                "end": 8.923
            },
            {
                "speaker_id": "1",
                "transcription": "동맹이지만 서로 우선 순위가 다를 수도 있다며 미국의 속내를 듣겠다고도 했습니다.",
                "sound_type": [
                    2
