        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 사회의 불평등 문제는 어떻게 받아들이고 있을까요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.835
            },
            {
                "speaker_id": "1",
                "transcription": "자유 경쟁과 평등 무엇이 더 중요하냐고 물었습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.845,
                "end": 8.546
            },
            {
                "speaker_id": "1",
                "transcription": "평등을 우선해야 한다는 답이 자유 경쟁보다 5퍼센트 포인트 다소 많았습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.556,
                "end": 15.008
            },
            {
                "speaker_id": "1",
                "transcription": "기득권과 불로소득에 대해선 반감이 높았습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.018,
                "end": 19.016
            },
            {
                "speaker_id": "1",
                "transcription": "기득권층이 지배하는 세상은 바꿔야 한다는 답이 75퍼센트였고 부모의 유산으로 잘 사는 것은 바람직하지 않다는 답은 64퍼센트였습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.026,
                "end": 28.828
            }
        ]
    },
    "summary": "자유 경쟁과 평등에 대해 묻고 기득권과 불로소득에 대해 물었다.",
