                    2
                ],
                "start": 0.000,
                "end": 5.706
            },
            {
                "speaker_id": "1",
                "transcription": "이들에게 그러면 단일 후보를 누구로 할지 조사했더니 윤석열 후보를 원한다는 답변이 안철수 후보보다 2배 이상이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.716,
                "end": 14.709
            },
            {
                "speaker_id": "1",
                "transcription": "단일화를 전제로 한 가상 대결에서는 윤석열 후보로 단일화가 됐을 경우 이재명 후보를 10퍼센트 포인트 이상 앞섰습니다.",
                "sound_type": [
