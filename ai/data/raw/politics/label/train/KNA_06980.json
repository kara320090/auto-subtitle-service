                ],
                "start": 0.000,
                "end": 9.026
            },
            {
                "speaker_id": "1",
                "transcription": "풀브라이트 장학금은 지원 금액이 커 미국 대학원 진학을 원하는 학생들에게 인기가 많습니다.",
                "sound_type": [
                    2
