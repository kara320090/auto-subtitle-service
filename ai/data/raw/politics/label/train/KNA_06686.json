                ],
                "start": 0.000,
                "end": 6.214
            },
            {
                "speaker_id": "2",
                "transcription": "마음이 그냥 시원하고 엄청나게 울었어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.224,
                "end": 9.683
            },
            {
                "speaker_id": "2",
                "transcription": "아 영이 하늘나라 가서도 이 마음을 풀렸구나 얼마나 기뻤을까",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.693,
                "end": 15.887
            },
            {
                "speaker_id": "1",
                "transcription": "4.3의 완전한 해결을 외침에 그치지 않고 약속을 지키는 것이 희생자들의 눈물을 닦아줄 수 있는 유일한 방법입니다.",
