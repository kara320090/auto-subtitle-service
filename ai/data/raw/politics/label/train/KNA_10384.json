        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 금융사인데 비용으로 발생하기 때문에요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.755
            },
            {
                "speaker_id": "1",
                "transcription": "그는 소비자한테 증가될 우려가",
                "sound_type": [
                    2
                ],
                "start": 1.765,
                "end": 6.154
            },
            {
                "speaker_id": "2",
                "transcription": "다만 한 금융사가 취급할 수 있는 한도를 연간 4000억 원으로 제한하는 만큼 특정 상품에 몰린다면 대출이 금방 소진될 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.164,
                "end": 14.816
            },
            {
                "speaker_id": "2",
                "transcription": "비대면 금융 범죄 가능성도 점검할 부분입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.826,
                "end": 17.940
            },
            {
                "speaker_id": "2",
                "transcription": "금융 당국은 서비스 개시 후 생기는 문제들을 보완해 올 연말 주택담보 대출로도 범위를 확대한다는 계획입니다.",
