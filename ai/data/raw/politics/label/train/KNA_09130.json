        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰과 군은 입법취지에 공감한다면서도 지휘 감독권엔 반대했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.341
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 경찰은 대통령 경호법 등 법률에서 경호처에 타 기관에 대한 지휘감독권한을 부여하지 않고 있다며 헌법에 배치될 수 있다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.351,
                "end": 15.703
            },
            {
                "speaker_id": "2",
                "transcription": "저희 쪽에 의견 조회가 왔고 저희는 그 적절치 않다는 의견을 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.713,
                "end": 20.910
            },
            {
                "speaker_id": "1",
                "transcription": "국방부도 국군 조직법 상 경호처장은 국군에 대한 지휘감독권한이 없다며 현장 지휘를 할 수 있다로 문구수정을 제한했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.920,
                "end": 29.996
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 시행령 개정만으로 경호처장이 군경지휘권을 갖는 건 반 헌법적이라며 반발하고 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.006,
                "end": 37.170
            }
        ]
    },
    "summary": "대통령 경호법 등 법률에서 경호처에 타 기관에 대한 지휘감독권한을 부여하지 않고 있다며 헌법에 배치될 수 있다고 지적했고 민주당은 시행령 개정만으로 경호처장이 군경지휘권을 갖는 건 한 헌법적이라고 반발했다.",
