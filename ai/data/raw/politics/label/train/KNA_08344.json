        "term": [
            {
                "speaker_id": "1",
                "transcription": "경기도 법인 카드와 관련해 김혜경 씨가 받고 있는 혐의는 배임과 공직선거법 위반 두 가지입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.687
            },
            {
                "speaker_id": "1",
                "transcription": "이 가운데 선거법 공소 시효를 이틀 남겨 두고 검찰은 오늘 김 씨를 소환 조사했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.697,
                "end": 12.549
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 경찰이 같은 혐의로 김 씨를 소환한 지 2주 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.559,
                "end": 16.728
            },
            {
                "speaker_id": "2",
                "transcription": "배 씨에게 법인 카드 사적 사용 지시하셨습니까?",
