        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 비례대표 의원을 더 늘리자는 의견이 70퍼센트로 나타났습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.639
            },
            {
                "speaker_id": "1",
                "transcription": "관심이 쏠린 선거구 개편과 관련해선 지금처럼 한 선거구에서 1명의 의원을 뽑는 소선거구제를 유지하자는 응답이 절반을 넘겼습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.649,
                "end": 14.283
            },
            {
                "speaker_id": "2",
                "transcription": "여야가 협상으로 최종안을 만드는 데 좋은 길잡이가 될 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.293,
                "end": 19.119
            },
            {
                "speaker_id": "2",
                "transcription": "이 선거제 개편은 금년 상반기 전엔 마무리돼야 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.129,
                "end": 23.791
            },
            {
                "speaker_id": "1",
                "transcription": "국회는 이번 공론화 조사 결과를 선거법 개정안 논의에 활용할 계획입니다.",
                "sound_type": [
