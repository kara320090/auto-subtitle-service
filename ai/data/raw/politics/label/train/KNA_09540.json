        "term": [
            {
                "speaker_id": "1",
                "transcription": "반면 국민의힘은 이상민 장관 등에 책임을 묻는 건 정치적 주장일 뿐이라며 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.806
            },
            {
                "speaker_id": "1",
                "transcription": "특수본 수사 결과 법적 책임이 없다고 결론이 났다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.816,
                "end": 11.465
            },
            {
                "speaker_id": "2",
                "transcription": "용산 어 구청장 등 몇 사람만 어 그 문제가 있다 책임이 있다라고 해서 그 부분에 걸맞은 수준에서 그 보고서 채택이 이뤄지는 것이 마땅한 것 아닌가",
                "sound_type": [
                    2
                ],
                "start": 11.475,
                "end": 25.147
            },
            {
                "speaker_id": "1",
                "transcription": "야당의 독립된 진상 조사 기구와 특검 요구 주장에 대해서도 여당은 국정 조사가 실패했다는 것을 자인하는 꼴이라며 미온적인 입장입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.157,
                "end": 35.296
            },
            {
                "speaker_id": "1",
                "transcription": "자칫 국정원 댓글 의혹 사건처럼 보고서 채택 없이 국정 조사 특위가 종료될 가능성마저 제기되고 있는데 여야는 내일 마지막 전체 회의를 열고 최종 담판에 들어갑니다.",
                "sound_type": [
