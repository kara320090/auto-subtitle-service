        "term": [
            {
                "speaker_id": "1",
                "transcription": "좋아하실 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.335
            },
            {
                "speaker_id": "2",
                "transcription": "이번 판결로 과거 북한으로 납북된 뒤 반공법으로 처벌을 받은 어부들의 재심 청구가 더 활발해질 전망입니다.",
                "sound_type": [
                    2
                ],
                "start": 1.345,
                "end": 8.804
            },
            {
                "speaker_id": "3",
                "transcription": "납북 귀환 어부 피해자들이 재심을 통해서 무죄 받은 경우가 전국적으로 딱 6케이스 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.814,
                "end": 15.033
            },
            {
                "speaker_id": "3",
                "transcription": "그러니까 실제로는 납북되었다가 귀환되었던 분들이 어 구제되는 경우들은 거의 없는 실정이라고 보면 되는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 15.043,
                "end": 22.493
            },
            {
                "speaker_id": "2",
                "transcription": "고인의 자녀들은 앞으로 국가배상과 형사보상 절차도 밟을 예정입니다.",
                "sound_type": [
                    2
