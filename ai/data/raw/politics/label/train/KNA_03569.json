        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민께서 바라시는 정권 교체의 교두보를 함께 놓아가겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.900
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 협상 과정에서 드러난 갈등이 화학적 결합까지 이어질지는 더 지켜볼 대목입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.910,
                "end": 12.204
            },
            {
                "speaker_id": "3",
                "transcription": "그동안에 야권의 흥행을 위해서 여러 가지로 노력을 많이 해 주신 데 대해서 대단히 감사하게 생각",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.214,
                "end": 20.402
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 오 후보의 내곡동 땅 의혹에 대한 민주당의 공세가 본격화될 것으로 보고 적극 반박에 나서는 한편 LH 사태 등 현 정부의 부동산 정책을 집중 파고든다는 전략입니다.",
                "sound_type": [
