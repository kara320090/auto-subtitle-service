        "term": [
            {
                "speaker_id": "1",
                "transcription": "엘에이치 사태 이후 더 커진 정권 심판 여론에 제1야당 후보로 표심이 결집했다는 분석이 국민의힘에서 나옵니다.",
                "sound_type": [
