        "term": [
            {
                "speaker_id": "1",
                "transcription": "솔직히 비 좀 왔으면 좋겠다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.899
            },
            {
                "speaker_id": "1",
                "transcription": "사진 잘 나오게.",
                "sound_type": [
                    2
                ],
                "start": 1.909,
                "end": 3.882
            },
            {
                "speaker_id": "2",
                "transcription": "같이 있던 이미자 의원은 팔을 때리며 급히 제지했고 권성동 원내 대표는 말이 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.892,
                "end": 12.089
            },
            {
                "speaker_id": "2",
                "transcription": "결국 보여주기식 행사 아니었느냐는 비판에 김 의원은 엄중한 시기에 경솔하고 사려 깊지 못했다며 상처 받은 수해민과 국민께 진심으로 죄송하다고 사과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.099,
                "end": 24.928
            },
            {
                "speaker_id": "2",
                "transcription": "주 비대 위원장은 엄중 경고했다고 밝혔지만 해명 과정에서 또 다른 논란을 빚기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.938,
                "end": 31.054
            },
            {
                "speaker_id": "3",
                "transcription": "김 의원이 장난기가 좀 있어요 평소에도.",
                "sound_type": [
                    2
                ],
                "start": 31.064,
                "end": 34.643
            },
            {
                "speaker_id": "3",
                "transcription": "여러분들 노는 거는 우리가 다 지켜보 여러분들 나온 거 우리가 마",
                "sound_type": [
                    2
                ],
                "start": 34.653,
