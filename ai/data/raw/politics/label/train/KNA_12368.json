        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "본래 선거법의 취지를 살리기 위한 어떠한 희생도 마다하지 않겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.845
            },
            {
                "speaker_id": "2",
                "transcription": "비례 정당을 만들어 사실상 대리전을 벌이는 모양새인데 제일이당의 비례 정당 선거운동 가능할까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.855,
                "end": 12.353
            },
            {
                "speaker_id": "2",
                "transcription": "선관위에 따르면 현행 선거법상 후보자나 선거사무장 등이 다른 정당이나 후보자를 위한 선거운동을 할 수 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.363,
                "end": 20.527
            },
            {
                "speaker_id": "2",
                "transcription": "다만 총선에 출마하지 않는 정당 대표 선대위원장 등은 가능합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.537,
                "end": 25.804
            },
            {
                "speaker_id": "2",
                "transcription": "불출마하는 민주당 이해찬 대표는 비례 정당 선거운동을 할 수 있지만 출마하는 민주당 이낙연 선대위원장 통합당 황교안 대표는 비례 정당 선거운동을 할 수 없는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 25.814,
                "end": 38.389
            },
            {
                "speaker_id": "2",
                "transcription": "선관위는 또 비례 정당에게 선거 경비를 빌려줄 수 있다는 해석도 내놓았는데 정치 자금 대부업 허용이란 비판이 나왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 38.399,
                "end": 47.276
            },
            {
                "speaker_id": "3",
                "transcription": "선관위는 지금이라도 그간의 졸속행정을 반성하고 국민의 기본권을 심각하게 침해하는 위장 정당들의 불법 행태에 대해 엄정하게 대응하기 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 47.286,
                "end": 57.860
            },
            {
                "speaker_id": "2",
                "transcription": "비례 후보를 안 낸 정당은 신문 TV 인터넷 광고를 낼 수 없고 중앙선거 방송토론위 주관 토론회 참여도 불가능합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.870,
                "end": 66.748
            },
            {
                "speaker_id": "2",
                "transcription": "반면 선거 연대 차원에서 홈페이지나 문자 메시지를 통한 비례 정당 투표 독려 행위는 허용됩니다.",
                "sound_type": [
                    2
                ],
                "start": 66.758,
                "end": 73.406
            }
        ]
    },
    "summary": "선관위에 따르면 후보자나 선거사무장이 다른 정당이나 후보자를 위한 선거운동을 할 수 없고 총선에 출마하지 않는 정당 대표 선대위원장은 가능하며 비례 정당에게 선거 경비를 빌려줄 수 있다는 해석에는 정치 자금 대부업 허용이란 비판이 나왔다고 기자는 보도했다.",
