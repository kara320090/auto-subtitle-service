            },
            {
                "speaker_id": "2",
                "transcription": "본인이 너무나 공포에 사로잡혀 있는 것이 아닌가.",
                "sound_type": [
                    2
                ],
                "start": 7.560,
                "end": 11.712
            },
            {
                "speaker_id": "2",
                "transcription": "어 저는 그렇게 생각합니다.",
