                "start": 4.735,
                "end": 8.917
            },
            {
                "speaker_id": "1",
                "transcription": "전 씨는 혼자 걷기 힘든 듯 경호원의 부축을 받으며 차에서 내렸습니다.",
                "sound_type": [
