        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 사실상 그런 카드라고 보고 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.327
            },
            {
                "speaker_id": "1",
                "transcription": "협치를 위한 카드로 의미가 전혀 없다.",
                "sound_type": [
                    2
                ],
                "start": 3.337,
                "end": 6.426
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘 역시 민주당이 한덕수 총리 임명 동의안에 당론 가결로 협조한 만큼 이에 화답해야 한다는 견해가 확산하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.436,
                "end": 15.678
            },
            {
                "speaker_id": "2",
                "transcription": "권성동 국민의힘 원내대표는 당내 중진 등의 의견을 청취한 결과 반대 의견이 많았다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.688,
                "end": 23.243
            },
            {
                "speaker_id": "3",
                "transcription": "장관으로 임명하는 것은 어 곤란하지 않냐 거기에 대해서는 반대하는 의견이 많았다는 점만 말씀드리겠습니다.",
                "sound_type": [
                    2,
                    5
