        "term": [
            {
                "speaker_id": "1",
                "transcription": "반면 국민의힘은 언론 통제가 아니라고 엄호했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.349
            },
            {
                "speaker_id": "2",
                "transcription": "언론인에게도 어 책임 의식이 있어야 되는 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.359,
                "end": 9.501
            },
            {
                "speaker_id": "2",
                "transcription": "그 책임을 다하지 못할 때 그거는 다른 언론에게 피해를 줄 수 있고 국민들에게 피해를 줄 수 있는 것이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.511,
                "end": 17.753
            },
            {
                "speaker_id": "2",
                "transcription": "다만 일각에선 자유라는 헌법 가치를 대통령 스스로 훼손하는 결정이다.",
                "sound_type": [
                    2
                ],
                "start": 17.763,
                "end": 22.637
            },
            {
                "speaker_id": "2",
                "transcription": "도를 넘어 감정싸움으로 가고 있다는 우려 섞인 목소리가 나왔습니다.",
                "sound_type": [
