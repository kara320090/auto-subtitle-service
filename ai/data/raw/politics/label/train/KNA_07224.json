        "term": [
            {
                "speaker_id": "1",
                "transcription": "흰머리가 검은 머리가 흰머리 나도록 살았는데.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.907
            },
            {
                "speaker_id": "2",
                "transcription": "단골이었던 청와대 사람들과의 이별도 아쉬움으로 남습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.917,
                "end": 7.721
            },
            {
                "speaker_id": "3",
                "transcription": "하시는 말씀이 아유 오늘은 여기서 마지막 점심이네요 하면서 가셨더라고요 그러니까 좀 서운하죠 저희.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.731,
                "end": 14.824
            },
            {
                "speaker_id": "2",
                "transcription": "바로 옆에 살면서도 가보지 못했던 금단의 공간에 대해 기대를 드러내는 목소리도 많습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.834,
                "end": 20.875
            },
            {
                "speaker_id": "4",
                "transcription": "청와대의 그 신비성이 참 사람들이 엄청 궁금해할 것 같아요 그래서 나부터도 진짜",
                "sound_type": [
                    2
                ],
                "start": 20.885,
                "end": 27.293
            }
        ]
    },
    "summary": "청와대 인근 상인들이 청와대에 대해 이야기하고 있다.",
