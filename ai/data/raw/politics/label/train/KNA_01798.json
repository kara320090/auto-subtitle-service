        "term": [
            {
                "speaker_id": "1",
                "transcription": "제 눈에는 견적이 나옵니다 그냥",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.083
            },
            {
                "speaker_id": "2",
                "transcription": "윤 후보는 사전 투표 유엔 기념 공원을 참배하고 지지세가 강한 대구 경북 등 영남 지역을 잇따라 방문합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.093,
                "end": 11.799
            },
            {
                "speaker_id": "2",
                "transcription": "정의당 심상정 후보는 남편과 함께 사전 투표를 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.809,
                "end": 15.797
            },
            {
                "speaker_id": "3",
                "transcription": "덜 나쁜 대통령한테 주시겠습니까 아니면 내 삶을 바꾸는 미래에 투자하시겠습니까 여러분",
                "sound_type": [
                    2
                ],
                "start": 15.807,
                "end": 23.360
            },
            {
                "speaker_id": "2",
                "transcription": "심 후보는 경남 창원과 대구 대전을 차례로 방문해 기득권 정치 대신 다당제에 투표를 달라고 강조할 전망입니다.",
                "sound_type": [
