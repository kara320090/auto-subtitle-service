        "term": [
            {
                "speaker_id": "1",
                "transcription": "방공 식별 구역은 영공 침범을 막고 대응하기 위해 정하는 임의의 선으로 합참은 영공 침범은 없었다고 말했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 8.772
            },
            {
                "speaker_id": "1",
                "transcription": "중국 측은 카디즈 진입 후에 우리 측과의 핫라인을 통해 훈련 상황이라고 통보했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.782,
                "end": 14.385
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 공군 간에 아직 핫라인이 구축되지 않은 러시아는 상황을 통보하지 않았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.395,
                "end": 20.306
            },
            {
                "speaker_id": "1",
                "transcription": "합참은 이번 상황을 두 나라의 연합 훈련으로 일단 판단했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.316,
                "end": 25.047
            },
            {
                "speaker_id": "1",
                "transcription": "우리 군은 중국과 러시아 군용기가 진입하기 이전부터 F15K와 KF16 전투기를 투입해 우발상황에 대비했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.057,
                "end": 33.466
            }
        ]
    },
    "summary": "합참은 이번 상황을 두 나라의 연합 훈련으로 일단 판단했다.",
