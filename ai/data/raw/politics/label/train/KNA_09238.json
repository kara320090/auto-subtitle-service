        "term": [
            {
                "speaker_id": "1",
                "transcription": "국비를 확보하려면 국가철도망 계획 등에 포함돼야 하는데 경제성 문제로 상당수가 실패했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.040
            },
            {
                "speaker_id": "2",
                "transcription": "경제성 확보는 어떻게 뭐",
                "sound_type": [
                    2
                ],
                "start": 7.050,
                "end": 9.318
            },
            {
                "speaker_id": "3",
                "transcription": "관련 시 16개 시구에서 모여서",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.328,
                "end": 11.959
            },
            {
