        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 총장 거취 문제엔 함구하자던 민주당 지도부.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.948
            },
            {
                "speaker_id": "1",
                "transcription": "이번 사태의 본질은 검찰의 제 식구 감싸기라며 윤 총장의 행위를 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.958,
                "end": 9.605
            },
            {
                "speaker_id": "1",
                "transcription": "그런 만큼 자문단 소집 중단과 수사팀 독립성 보장을 요구한 추 장관의 지휘권은 적법하다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.615,
                "end": 17.843
            },
            {
                "speaker_id": "2",
                "transcription": "검찰 내부 비위 혐의와 관련된 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.853,
                "end": 21.677
            },
            {
                "speaker_id": "2",
                "transcription": "수사 지휘 권한은 선출되지 않는 검찰 권력이 원칙과 상식에서 벗어날 때 민주적으로 통제하기 위한 합법적 수단입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.687,
                "end": 32.351
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 추 장관 해임을 요구한 통합당을 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.361,
                "end": 36.417
            },
            {
                "speaker_id": "1",
                "transcription": "국회 복귀 선언하고 처음한 게 탄핵 추진이라며 여전히 민생을 외면하고 정쟁에만 몰두하고 있다고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.427,
                "end": 44.404
            },
            {
                "speaker_id": "3",
                "transcription": "미래통합당이 법무부 장관을 비난하며 탄핵소추 운운하는 것은 결국 공수처 출범을 저지하려는 것과 함께 검찰 개혁의 발목을 잡으려는 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 44.414,
                "end": 56.306
            },
            {
                "speaker_id": "1",
                "transcription": "통합당은 추 장관의 지휘권 발동이 윤석열 찍어내기라고 비난했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.316,
                "end": 61.648
            },
            {
                "speaker_id": "4",
                "transcription": "거의 무슨 어 깡패같은 그런 짓이죠.",
                "sound_type": [
                    2
                ],
                "start": 61.658,
                "end": 64.384
            },
            {
                "speaker_id": "4",
                "transcription": "단체적으로 때로 압력을 가하고 모욕을 주고 수모를 가해서 쫓아내려고 하는 것을 다 보고 있지 않습니까 우리가.",
                "sound_type": [
                    2
                ],
                "start": 64.394,
                "end": 72.572
            }
        ]
    },
    "summary": "민주당은 이번 사태의 본질은 검찰의 제 식구 감싸기라며 윤 총장의 행위를 비판했고 추 장관 해임을 요구한 통합당을 비판했으나 통합당은 추 장관의 지휘권 발동이 윤석열 찍어내기라고 비난했다.",
