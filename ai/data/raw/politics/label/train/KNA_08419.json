        "term": [
            {
                "speaker_id": "1",
                "transcription": "일동 묵념",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.162
            },
            {
                "speaker_id": "2",
                "transcription": "추모로 시작된 국회 상임위에선 정부의 안일한 대처를 질타했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.172,
                "end": 7.610
            },
            {
                "speaker_id": "3",
                "transcription": "장관께선 다녀오시지도 않으시고 이제 가시겠다고 하고 제일 먼저 가서 봤어야 되는 거 아닌가요?",
                "sound_type": [
                    2
                ],
                "start": 7.620,
                "end": 14.451
            },
            {
                "speaker_id": "2",
                "transcription": "김현숙 여가부 장관은 범죄 통보도 못 받는 등 권한이 제한돼 있다고 했다가 여당으로부터도 지적을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.461,
                "end": 22.402
            },
            {
                "speaker_id": "4",
                "transcription": "그동안 그럼 여가부는 이런 시스템도 안 만들고 뭐 했습니까?",
                "sound_type": [
                    2
                ],
                "start": 22.412,
                "end": 26.122
            },
            {
                "speaker_id": "5",
                "transcription": "통보 시스템은 있는데 통보를 하지 않았을 때에 대한 제재 조치가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.132,
                "end": 30.460
            },
            {
                "speaker_id": "4",
                "transcription": "그동안은 뭐 했냐고요?",
                "sound_type": [
                    2
                ],
                "start": 30.470,
                "end": 31.907
            },
            {
                "speaker_id": "4",
                "transcription": "그동안 장관님이 취임한 지 얼마 안 됐다 치지만 그동안에 그럼 여가부는 뭐 했냐고",
                "sound_type": [
                    2
                ],
                "start": 31.917,
                "end": 37.037
            }
        ]
    },
