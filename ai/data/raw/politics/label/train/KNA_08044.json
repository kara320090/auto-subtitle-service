        "term": [
            {
                "speaker_id": "1",
                "transcription": "오찬회동으로 불화설를 일축한 지 사흘 만",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.947
            },
            {
                "speaker_id": "1",
                "transcription": "대통령 당선인 비서실장이던 장제원 의원이 권선동 대표 대행을 공개 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.957,
                "end": 9.776
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령의 지인 아들 우 모 씨의 9급 행정요원 채용과 관련해 권 대행이 압력을 넣었다 최저임금을 받고 서울에서 어떻게 사냐라고 한 것을 두고 말이 무척 거칠다 삼가야 한다라고 직격한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 9.786,
                "end": 23.753
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 어떠한 압력도 받은 적이 없고 추천만 받았을 뿐이라며 문제가 없다는 점을 거듭 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.763,
                "end": 31.883
            },
            {
                "speaker_id": "1",
                "transcription": "사적 채용 논란이 채용 청탁 의혹으로까지 번지는 걸 서둘러 진화하려한 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 31.893,
                "end": 37.303
            }
        ]
    },
    "summary": "장 의원은 사적채용논란으로 권 대표대행을 공개 비판했다고 전했다.",
