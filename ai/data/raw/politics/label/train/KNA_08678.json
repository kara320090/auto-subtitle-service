        "term": [
            {
                "speaker_id": "1",
                "transcription": "게다가 지금 소득에서 40만 원 늘어나는 것만으론 부족하단 목소리가 여전합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.692
            },
            {
                "speaker_id": "2",
                "transcription": "고령화가 되면서",
                "sound_type": [
                    2
                ],
                "start": 5.702,
                "end": 7.161
            },
            {
                "speaker_id": "3",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 7.171,
                "end": 7.983
            },
            {
                "speaker_id": "2",
                "transcription": "우리가 그 체력이 못 받쳐줘요.",
                "sound_type": [
                    2
                ],
                "start": 7.993,
                "end": 9.575
            },
            {
                "speaker_id": "2",
                "transcription": "돈이 돼야지 젊은이들도 오지 않겠습니까?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.585,
                "end": 11.524
            },
            {
                "speaker_id": "2",
                "transcription": "버스 기사 정도 그 수입이 좀 돼야 돼요.",
                "sound_type": [
                    2
                ],
                "start": 11.534,
                "end": 14.549
            },
            {
                "speaker_id": "1",
                "transcription": "특히 요금 인상은 택시 회사 배만 불릴 것이라는 우려도 큽니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.559,
                "end": 19.521
            },
            {
                "speaker_id": "4",
                "transcription": "회사가 다 가져가죠.",
                "sound_type": [
                    2
                ],
                "start": 19.531,
                "end": 20.708
            },
            {
                "speaker_id": "4",
                "transcription": "택시 기사들의 처우를 개선하지 않는 한 간 사람은 다시 되돌아오지 않아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.718,
                "end": 26.248
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 이번 대책이 충분한 공급 확대로 이어지지 않으면 타다나 우버 같은 플랫폼 서비스 도입을 앞당길 방침입니다.",
                "sound_type": [
