        "term": [
            {
                "speaker_id": "1",
                "transcription": "정치인이 사조직을 이용하여 인터넷 여론 조작 행위를 관여하여 선거 운동에 관여한 책임에 대한 단죄이며",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.532
            },
            {
                "speaker_id": "2",
                "transcription": "김 지사는 자신이 감내해야 할 몫은 감당하겠다면서도 진실이 바뀔 순 없다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.542,
                "end": 16.643
            },
            {
                "speaker_id": "3",
                "transcription": "무엇이 진실인지 그 최종적인 판단은 국민들의 몫으로 남겨 드려야 될 거 같습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.653,
                "end": 26.493
            },
            {
                "speaker_id": "2",
                "transcription": "확정 판결에 따라 김 지사는 지사직을 잃고 조만간 수감될 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 26.503,
                "end": 31.884
            },
            {
                "speaker_id": "2",
                "transcription": "형기를 마친 뒤에는 5년간 피선거권이 박탈됩니다.",
