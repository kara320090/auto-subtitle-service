        "term": [
            {
                "speaker_id": "1",
                "transcription": "이태원 참사 현장 인근에 차려진 시민 분향소 지난주 유족들이 마련한 이곳에 한덕수 국무총리가 찾아갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.045
            },
            {
                "speaker_id": "1",
                "transcription": "공개된 공식 일정에는 없는 방문이었고 유족들에게도 따로 예고가 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.055,
                "end": 13.853
            },
            {
                "speaker_id": "1",
                "transcription": "유가족은 조문을 막아섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.863,
                "end": 16.263
            },
            {
                "speaker_id": "2",
                "transcription": "정부의 공식적인 사과를 가지고 오십시오.",
                "sound_type": [
                    2
                ],
                "start": 16.273,
                "end": 19.331
            },
            {
                "speaker_id": "2",
                "transcription": "저희는 정부의 공식적인 사과 아니면 받지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.341,
                "end": 23.571
            },
            {
                "speaker_id": "1",
                "transcription": "사과 요구 등에 한 총리는 별다른 답을 하지 않다가 가벼운 목례를 남기고 금세 발길을 돌렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.581,
                "end": 30.597
            }
        ]
    },
    "summary": "유족들이 마련한 시민분향소에 한덕수 국무총리가 예고 없이 찾았다가 유족들이 정부의 공식 사과가 우선이라며 조문을 거절해 발길을 돌렸다.",
