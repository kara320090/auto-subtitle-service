        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령 후배 장관 1명 지키겠다고 집권 여당 전체가 국민의 준엄한 명령을 거부하며",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.851
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 국정 조사 대상인 장관을 해임하자는 건 정치 공세를 위한 거라고 맞받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.861,
                "end": 13.187
            },
            {
                "speaker_id": "3",
                "transcription": "행안부 장관을 국정 조사 대상으로 넣어놓았습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.197,
                "end": 17.388
            },
            {
                "speaker_id": "3",
                "transcription": "민주당의 해임 건의안 행사와 국정 조사가 서로 모순되는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 17.398,
                "end": 22.434
            },
            {
                "speaker_id": "2",
                "transcription": "여권에선 국정 조사 보이콧 주장까지 나오지만 이를 거론하긴 부담스럽다는 게 현재 대통령실 기류입니다.",
