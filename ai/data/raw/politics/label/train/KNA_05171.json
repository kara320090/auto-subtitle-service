        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민 안전에는 국가가 무한 책임을 져야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.764
            },
            {
                "speaker_id": "1",
                "transcription": "정부에 당부드립니다.",
                "sound_type": [
                    2
                ],
                "start": 3.774,
                "end": 5.795
            },
            {
                "speaker_id": "1",
                "transcription": "가용 예산과 행정력을 총동원하여 피해 복구에 집중해 주십시오.",
                "sound_type": [
                    2
                ],
                "start": 5.805,
                "end": 11.225
            },
            {
                "speaker_id": "2",
                "transcription": "당정은 복구 계획이 수립되기 전 긴급 지원에도 나서기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.235,
                "end": 16.290
            },
            {
                "speaker_id": "2",
                "transcription": "수해 피해 가계에 긴급 생활 안정 자금을 지원하고 침수 차량의 경우 자차 보험금을 우선 지급하는 등 신속한 손해 보상에 나서기로 했습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.300,
                "end": 26.630
            },
            {
                "speaker_id": "2",
                "transcription": "피해가 컸던 서울 강남 등 저지대에 대규모 빗물 저류 시설을 설치하는 등 수해 예방책도 병행하기로 했습니다.",
                "sound_type": [
                    1,
