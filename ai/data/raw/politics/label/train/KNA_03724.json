        "term": [
            {
                "speaker_id": "1",
                "transcription": "그것이 대표적으로 부동산 정책이었고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.820
            },
            {
                "speaker_id": "1",
                "transcription": "필요하다면 저는 수정하고 집권 여당답게 야당과 소통하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.820,
                "end": 8.611
            },
            {
                "speaker_id": "2",
                "transcription": "두 후보 가운데 윤호중 의원이 현재로서는 좀 더 많은 의원들의 지지를 받고 있는 것으로 알려져 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.620,
                "end": 15.858
            },
            {
                "speaker_id": "2",
                "transcription": "다만 윤 의원도 당내 주류 세력의 일원으로서 선거 참패의 책임을 피할 수 없다는 지적도 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.868,
                "end": 23.193
            },
            {
                "speaker_id": "2",
                "transcription": "민주당 원내 대표는 오는 16일 의원 174명의 비밀 투표로 선출될 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 23.203,
                "end": 28.948
            },
            {
                "speaker_id": "2",
                "transcription": "투표 결과를 보면 민주당 의원들이 원하는 쇄신의 방향과 위중을 알 수 있을 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.958,
                "end": 34.968
            }
        ]
    },
    "summary": "민주당 원내 대표는 오는 16일 의원 174명의 비밀 투표로 선출될 예정이고 그 투표 결과를 보면 민주당 의원들이 원하는 쇄신의 방향과 위중을 알 수 있을 것이다.",
