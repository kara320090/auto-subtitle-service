        "term": [
            {
                "speaker_id": "1",
                "transcription": "안 위원장은 코로나19가 유행한 지난 2년간에 손실을 100퍼센트 보상할 수 있을 거라고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.795
            },
            {
                "speaker_id": "1",
                "transcription": "다만 구체적인 지원금 액수는 추경 발표 때 공개하겠다는 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.805,
                "end": 12.056
            },
            {
                "speaker_id": "1",
                "transcription": "인수위는 코로나19로 입은 손실이 약 54조 원으로 추계됐는데 업체 규모와 피해 정도를 고려해 지원금을 차등 지급하겠다고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.066,
                "end": 21.680
            },
            {
                "speaker_id": "1",
                "transcription": "여행업 등 기존 손실보상 대상에서 빠졌던 업종도 지원 대상에 포함시킨다는 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.690,
                "end": 27.808
            },
            {
                "speaker_id": "1",
                "transcription": "인수위는 현금지원뿐 아니라 비은행권에서 대출를 받은 소상공인에 대출을 대환하고 특례자금을 지원하겠다고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.818,
                "end": 36.152
            },
            {
                "speaker_id": "1",
                "transcription": "이와 함께 소상공인에게 소득세와 부가세 납부 기한을 최장 3개월 연장해 주겠다는 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 36.162,
                "end": 42.895
            },
            {
                "speaker_id": "2",
                "transcription": "아 그리고 지금 국회에서는 검찰 수사권 축소 법안 논란이 뜨거운데 이와 관련해서 장지원 당선인 비서실장이 선관위 강하게 비판했다면서요",
                "sound_type": [
                    2
                ],
                "start": 42.905,
                "end": 53.253
            }
        ]
    },
    "summary": "안 위원장은 코로나19가 유행한 지난 2년간에 손실을 100퍼센트 보상을 강조했으며 소상공인에게 소득세와 부가세 납부 기한을 최장 3개월 연장해 주겠다는 계획이다.",
