        "term": [
            {
                "speaker_id": "1",
                "transcription": "김기현 국민의힘 대표가 진행자였던 안철수 의원을 만나 원팀 행보에 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.097
            },
            {
                "speaker_id": "2",
                "transcription": "우리가 하나로 화합해서 어 내년 총선을 위해서 같이 힘을 합치자는 말씀을 주셔서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.107,
                "end": 11.504
            },
            {
                "speaker_id": "3",
                "transcription": "예 그렇습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.514,
                "end": 12.403
            },
            {
                "speaker_id": "2",
                "transcription": "아주 큰 격려가 되었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.413,
                "end": 15.450
            },
            {
                "speaker_id": "3",
                "transcription": "다시 한 번 더 당선도 축하드리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.460,
                "end": 19.132
            },
            {
                "speaker_id": "1",
                "transcription": "다만 김 대표에 과학기술 특위 위원장직 제안에 안 의원은 재충천 시간이 필요하다며 고사했습니다.",
                "sound_type": [
