        "term": [
            {
                "speaker_id": "1",
                "transcription": "강승규 시민 사회 수석과 김은혜 홍보 수석이 대통령실 국감 도중 필담을 나눈 것이 언론사 카메라에 포착됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.224
            },
            {
                "speaker_id": "1",
                "transcription": "강 수석의 노트에 적힌 웃기고 있네라는 문구였는데 김은혜 수석이 곧바로 이 문구를 볼펜으로 지웠습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.234,
                "end": 15.453
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 강득구 의원이 이태원 참사와 관련한 대통령실의 대응에 대해 질의하던 도중 벌어진 일입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.463,
                "end": 22.604
            },
            {
                "speaker_id": "1",
                "transcription": "메모가 공개되자 국감장은 발칵 뒤집어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.614,
                "end": 26.750
            },
            {
                "speaker_id": "2",
                "transcription": "이건 진짜 국회 모독입니다.",
                "sound_type": [
                    2
                ],
                "start": 26.760,
                "end": 29.340
            },
            {
                "speaker_id": "2",
                "transcription": "그동안 이 엑스엑스들이라고 대통령이 얘길 해서 저희가 사과 한 마디 못 받고 여기까지 온 국회입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.350,
                "end": 36.269
            }
        ]
    },
    "summary": "강승규 시민 사회 수석과 김은혜 홍보 수석이 민주당 의원이 이태원 참사와 관련한 대통령실의 대응에 대해 질의하던 도중 웃기고 있네라는 필담을 나눠 국감장이 뒤집어졌다.",
