        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당은 즉각 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.788
            },
            {
                "speaker_id": "1",
                "transcription": "송영길 대표는 이준석 대표의 결단을 뒷받침해 달라며 국민의힘을 압박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.798,
                "end": 7.355
            },
            {
                "speaker_id": "1",
                "transcription": "이 대표를 향한 민주당 지도부의 질책도 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.365,
                "end": 11.347
            },
            {
                "speaker_id": "2",
                "transcription": "아 이준석 대표는 100분 만에 말 뒤집는 100분 대표.",
                "sound_type": [
                    2
                ],
                "start": 11.357,
                "end": 16.386
            },
            {
                "speaker_id": "2",
                "transcription": "어 회수를 건너며 귤 맛을 잃어버리는 탱자 대표가 되려는 것입니까.",
                "sound_type": [
                    2
                ],
                "start": 16.396,
                "end": 22.940
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 오늘 오후 비공개 최고 위원 회의를 열어 전 국민에게 재난 지원금을 지급하는 방안을 당론으로 정했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.950,
                "end": 30.830
            }
        ]
    },
