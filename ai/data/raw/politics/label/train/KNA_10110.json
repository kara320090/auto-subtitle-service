        "term": [
            {
                "speaker_id": "1",
                "transcription": "아름다운 퇴장을 준비해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.786
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 곧바로 반발에 부딪혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.796,
                "end": 5.577
            },
            {
                "speaker_id": "3",
                "transcription": "지도부 일방 또는 개인의 독단적 지시에 의해서 처리되는 수준의 정당은 이미 아니다",
                "sound_type": [
                    2
                ],
                "start": 5.587,
                "end": 11.698
            },
            {
                "speaker_id": "2",
                "transcription": "이어진 비공개 회의에선 고성도 터져 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.708,
                "end": 15.200
            },
            {
                "speaker_id": "2",
                "transcription": "윤호중 공동 비대 위원은 이게 지도부냐며 회의 도중 퇴장했고 다른 참석자들도 지도부와 상의하고 발언하라고 했는데 박 위원장은 그럼 나를 왜 뽑아 여기 앉혔나라며 항의한 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.210,
                "end": 29.300
            },
            {
                "speaker_id": "2",
                "transcription": "당 대변인까지 나서 박 위원장 개인 의견일 뿐이라고 했지만 박 위원장은 거듭 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.310,
                "end": 35.836
            },
            {
                "speaker_id": "1",
                "transcription": "다양한 의견이 있는 게 민주주의라고 생각을 하고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 35.846,
                "end": 39.305
            }
        ]
    },
    "summary": "윤호중 공동 비대 위원은 지도부 일방적이고 독단적 지시에 의해서 처리되는 수준의 정당은 이미 아니라며 회의 도중 퇴장했고 박 위원장은 반박하며 다양한 의견이 있는 게 민주주의라고 생각한다고 말했다.",
