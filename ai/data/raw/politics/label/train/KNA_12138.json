        "term": [
            {
                "speaker_id": "1",
                "transcription": "통합당 김종인 선대 위원장은 수도권과 강원도를 하루에 오가며 정부 심판론을 부각했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.641
            },
            {
                "speaker_id": "2",
                "transcription": "진짜 경제 코로나가 도래할 것 같으면 이 정부는 진짜 무기력해질 수밖에 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.651,
                "end": 13.967
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 견제도 거세졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.977,
                "end": 17.245
            },
            {
                "speaker_id": "3",
                "transcription": "이 후보의 말을 들어보면 손에 잡히지 않고 이리 빠지고 저리 빠지는 기름 바른 공 같습니다.",
                "sound_type": [
