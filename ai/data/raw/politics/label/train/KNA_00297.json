        "term": [
            {
                "speaker_id": "1",
                "transcription": "한편 국민의힘 윤석열 후보는 이재명 후보와는 반대로 서울에서 시작해 부산으로 이동하며 유세를 이어 갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.075
            },
            {
                "speaker_id": "1",
                "transcription": "유세 현장마다 현 정권의 무능과 부패를 강조하면서 이번 대선에서 정권을 심판해 달라고 호소했는데요.",
                "sound_type": [
                    2
                ],
                "start": 7.085,
                "end": 15.148
            },
            {
                "speaker_id": "1",
                "transcription": "역시 취재기자 연결해서 소식 전해 듣겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.158,
                "end": 17.509
            },
            {
                "speaker_id": "1",
                "transcription": "자 박준원 기자 지금 부산이죠?",
                "sound_type": [
                    2
                ],
                "start": 17.519,
                "end": 20.179
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보 연설은 마쳤습니까?",
                "sound_type": [
                    2
                ],
                "start": 20.189,
                "end": 22.389
            }
        ]
    },
