        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 지난달 22일 자로 이미 모든 기한은 지나갔고 그 사이 있었던 움직임이라곤 국민대와 교육부가 두 차례씩 서면을 주고받은 게 전부입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 10.725
            },
            {
                "speaker_id": "1",
                "transcription": "심리는 한 번도 안 열렸습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.735,
                "end": 13.264
            },
            {
                "speaker_id": "1",
                "transcription": "당사자들 누구도 급할 게 없어 보이는 분위기입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.274,
                "end": 17.079
            },
            {
                "speaker_id": "1",
                "transcription": "행정 심판위는 90일 내 결정은 훈시 규정일 뿐이라고 설명했고 교육부는 결론이 늦어지는 이유를 알지 못한다고 밝혔습니다.",
                "sound_type": [
                    2,
