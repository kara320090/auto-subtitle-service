        "term": [
            {
                "speaker_id": "1",
                "transcription": "김건희 여사가 1999년 숙명여대에 제출한 석사 논문.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.266
            },
            {
                "speaker_id": "1",
                "transcription": "스위스 화가 파울 클레의 작품 특성을 연구한 내용인데 다른 논문 8편을 베끼고 짜깁기 했다는 의혹을 받고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.276,
                "end": 12.417
            },
            {
                "speaker_id": "1",
                "transcription": "본론의 한 쪽을 보면 2년 앞서 발표된 다른 논문을 통째로 옮겨 쓴 듯 합니다.",
                "sound_type": [
                    2
                ],
                "start": 12.427,
                "end": 18.296
            },
            {
                "speaker_id": "1",
                "transcription": "그나마 참고 문항 표시는 돼 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.306,
                "end": 20.910
            },
            {
                "speaker_id": "1",
                "transcription": "인용 표기 없이 다른 논문 4개를 그대로 베낀듯한 대목도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.920,
                "end": 26.611
            },
            {
                "speaker_id": "1",
                "transcription": "이런 단순 일치도만 따졌을 때 표절률 48.1퍼센트.",
                "sound_type": [
                    2
                ],
                "start": 26.621,
                "end": 31.257
            },
            {
                "speaker_id": "1",
                "transcription": "거기 잡히지 않는 의심스런 대목들이 더 있습니다.",
