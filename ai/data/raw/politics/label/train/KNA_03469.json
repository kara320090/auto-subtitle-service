        "term": [
            {
                "speaker_id": "1",
                "transcription": "불미스러운 일이 발생한 데 대하여 진심으로 통감하고 깊은 사과의 말씀을 드립니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.619
            },
            {
                "speaker_id": "2",
                "transcription": "정책 신뢰를 되찾기 위해 장관 직을 걸겠다고도 했는데",
                "sound_type": [
                    2
                ],
                "start": 7.629,
                "end": 11.794
            },
            {
                "speaker_id": "3",
                "transcription": "장관직을 걸고 그 각오로 해야 한다고 생각을 하는데",
                "sound_type": [
                    2
                ],
                "start": 11.804,
                "end": 15.628
            },
            {
                "speaker_id": "1",
                "transcription": "정말 다시 태어나는 그 분골쇄신의 정신으로 제가 저 장관직을 걸고 강력하게 추진하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.638,
                "end": 23.712
            },
            {
                "speaker_id": "2",
                "transcription": "사퇴 요구가 나온단 주장엔 즉답을 피했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.722,
                "end": 27.310
            },
            {
                "speaker_id": "4",
                "transcription": "투기에 둔감한 어 국토부 장관에게 무얼 더 기대하겠느냐.",
                "sound_type": [
                    2
