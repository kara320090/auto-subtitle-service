                    2
                ],
                "start": 0.000,
                "end": 5.582
            },
            {
                "speaker_id": "1",
                "transcription": "유류세 인하를 체감하기 어렵다는 목소리가 많다며 업계에 협조를 요청했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.592,
                "end": 11.168
            },
            {
                "speaker_id": "2",
                "transcription": "주유소 협회를 중심으로 해서 자영 주유소 가격 인하를 계도할 것을 산자부와 관련 부처에 요구하였습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.178,
                "end": 22.079
            },
            {
                "speaker_id": "1",
                "transcription": "또 직영 알뜰 자영 상관없이 동시에 가격을 인하하는 방안 직접 인하 폭만큼을 소비자에게 환급하는 방안 등도 검토하겠다고 밝혔습니다.",
                "sound_type": [
