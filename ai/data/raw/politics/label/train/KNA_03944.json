        "term": [
            {
                "speaker_id": "1",
                "transcription": "이럴 경우 전국적으로 44만 호.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.154
            },
            {
                "speaker_id": "1",
                "transcription": "호 당 평균 18만 원 정도의 세금이 줄어들게 된다고 민주당은 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.164,
                "end": 7.707
            },
            {
                "speaker_id": "1",
                "transcription": "서민이나 실수요자에 대한 금융 지원도 강화됩니다.",
                "sound_type": [
                    2
                ],
                "start": 7.717,
                "end": 11.606
            },
            {
                "speaker_id": "1",
                "transcription": "무주택 세대주나 생애 최초 주택 구입자의 경우 LTV 주택 담보 인정 비율을 최대 20퍼센트포인트 올려주기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.616,
                "end": 20.605
            },
            {
                "speaker_id": "1",
                "transcription": "다만 과도한 대출을 막기 위해 최고 9억 원 이하 주택 구입에만 적용하고 대출 한도도 최대 4억 원으로 제한합니다.",
                "sound_type": [
                    2,
                    5
