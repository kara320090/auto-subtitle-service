            },
            {
                "speaker_id": "1",
                "transcription": "대신 서울 용산구에 8년 전부터 아파트를 보유 중입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.470,
                "end": 13.781
            },
            {
                "speaker_id": "1",
                "transcription": "이곳에 거주중이라던 자녀를 결혼했는데 아내가 산다고 했습니다.",
                "sound_type": [
