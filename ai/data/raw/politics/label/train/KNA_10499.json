        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 참모들과 정책 현안을 논의하면서 고금리와 돈 잔치를 언급했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.392
            },
            {
                "speaker_id": "1",
                "transcription": "은행 고금리로 국민 고통이 크다면서 은행의 돈 잔치로 국민들에 위화감이 생기지 않도록 하라고 지시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.402,
                "end": 14.463
            },
            {
                "speaker_id": "1",
                "transcription": "급격한 기준금리 인상으로 은행들은 역대 최대 실적을 거뒀습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.473,
                "end": 19.689
            },
            {
                "speaker_id": "1",
                "transcription": "지난해 4대 금융지주의 이자 이익은 재작년보다 5조 원 가까이 늘었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.699,
                "end": 25.494
            },
            {
                "speaker_id": "1",
                "transcription": "이런 실적 덕분에 은행들이 희망 퇴직금으로 수억 원씩을 지급한다는 보도도 잇따랐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.504,
                "end": 31.731
            }
        ]
    },
    "summary": "급격한 기준금리 인상으로 은행들은 역대 최대 실적을 거둬 지난해 이자 이익은 재작년보다 5조 원 가까이 늘었고 이런 실적 덕분에 은행들이 희망 퇴직금으로 수억 원씩 지급한다는 보도도 잇따랐다.",
