            },
            {
                "speaker_id": "1",
                "transcription": "그 중 하나가 건강보험 두 사람 다 직장 생활을 할 땐 문제가 없었지만 소 씨가 다니던 회사를 그만두었을 때 비로소 문제가 불거졌습니다.",
                "sound_type": [
