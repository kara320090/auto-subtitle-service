        "term": [
            {
                "speaker_id": "1",
                "transcription": "어린이집 보육 교사였던 이 40대 여성 가장은 지난해 2월 갑자기 일자리를 잃은 뒤 아직도 취업하지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.324
            },
            {
                "speaker_id": "2",
                "transcription": "많이 막막하죠. 그러니까 앞으로 뭘 할지 고민도 많이 했었고",
                "sound_type": [
                    2
                ],
                "start": 8.334,
                "end": 12.574
            },
            {
                "speaker_id": "1",
                "transcription": "방문 판매업을 하는 이 50대 가장도 코로나19 이후 소득이 급감했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.584,
                "end": 18.459
            },
            {
                "speaker_id": "1",
                "transcription": "생계가 막막해지면서 최대 6개월까지 한 달에 약 50만 원을 받을 수 있는 정부의 긴급 복지 대상자가 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.469,
                "end": 27.539
            },
            {
                "speaker_id": "3",
                "transcription": "200에서 250 정도 코로나 이후로는 한 달에 12만 원",
                "sound_type": [
                    2
                ],
                "start": 27.549,
                "end": 33.166
            }
        ]
    },
    "summary": "어린이집 보육 교사였던 여성은 실직 후 취업하지 못 하고 있으며 방문 판매업을 하는 50대 가장도 코로나19 이후 소득이 급감해 생계가 막막해지면서 정부의 긴급 복지 대상자가 됐다고 전한다.",
