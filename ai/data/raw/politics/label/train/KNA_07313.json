        "term": [
            {
                "speaker_id": "1",
                "transcription": "교통난 해법으로 GTX 조기 착공 등 교통망 확충에 큰 틀에서 동의한다면서도 상대 후보의 실현 의지 등을 따지며 진실 공방까지 벌였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.754
            },
            {
                "speaker_id": "2",
                "transcription": "국정 과제에서 이 GTX D E가 다 빠져버렸어요.",
                "sound_type": [
                    2
                ],
                "start": 9.764,
                "end": 14.285
            },
            {
                "speaker_id": "2",
                "transcription": "어 대선 공약에서도 얘기를 했고 그 부분이 국정 과제에서 빠졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.295,
                "end": 18.149
            },
            {
                "speaker_id": "2",
                "transcription": "공약 파기 같은 생각이 드는데요.",
