                ],
                "start": 18.159,
                "end": 20.390
            },
            {
                "speaker_id": "3",
                "transcription": "이 부분에 대해서 이미 인수위와 대통령실에서 밝힌 바가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.400,
                "end": 24.872
            },
            {
                "speaker_id": "3",
                "transcription": "D E는 보다",
