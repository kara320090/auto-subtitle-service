        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령실이 진화에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.151
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 음주 운전 전력에 대해 옹호하거나 문제 없다고 생각할 리 없다라며 여러 가지 면에서 국민의 이해를 구하는 일환으로 말한 것이라고 해명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.161,
                "end": 13.587
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 이준석 대표는 도대체 누가 추천했는지 모르겠다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.597,
                "end": 18.910
            },
            {
                "speaker_id": "2",
                "transcription": "뭐 누군진 모르겠지마는 혹시라도 본인께서 그런 부분을 잘 파악하지 못하고 대통령에게 누가 되는 추천을 했다면은 그 분의 의사를 확인해 보는 게 중요할 것 같다.",
                "sound_type": [
                    2
                ],
                "start": 18.920,
                "end": 29.967
            },
            {
                "speaker_id": "1",
                "transcription": "음주 운전 전력 등을 검증할 국회 청문회는 원 구성 협상이 늦어지면서 아직 일정조차 잡지 못하고 있습니다.",
                "sound_type": [
                    2
                ],
