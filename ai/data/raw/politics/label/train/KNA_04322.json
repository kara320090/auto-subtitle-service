        "term": [
            {
                "speaker_id": "1",
                "transcription": "초반부터 승기를 잡고 결국 결선 투표 없이 단일 후보로 확정되는 게 목표입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.236
            },
            {
                "speaker_id": "2",
                "transcription": "결과에 연연한다고 결과가 바뀌는 건 아니고 그냥 제가 할 수 있는 우리가 할 수 있는 최선을 성심을 다해서 하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.246,
                "end": 13.943
            },
            {
                "speaker_id": "1",
                "transcription": "이낙연 후보 측은 첫 개표 지역에서 반전을 기대하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.953,
                "end": 18.610
            },
            {
                "speaker_id": "1",
                "transcription": "내부적으론 1등과 별 차이 없는 2등을 현실적 목표로 언급해 왔지만 오늘은 충청에서 이길 수 있다는 기대도 내비쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.620,
                "end": 28.524
            },
            {
                "speaker_id": "3",
                "transcription": "밑바닥 민심은 이낙연을 원한다는 것을 확인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.534,
                "end": 32.399
            }
        ]
    },
    "summary": "이재명 후보는 결선 투표 없이 단일 후보로 확정되는 것이 목표이고, 이낙연 후보는 1등과 별 차이 없는 2등을 현실적 목표로 언급해 왔지만 충청에서 이길 수 있다는 기대도 내비쳤다.",
