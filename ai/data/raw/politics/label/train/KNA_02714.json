        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령실 용산 이전으로 경호 경비 인력이 과다하게 소유된 점이 참사의 근본 배경 중 하나라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.079
            },
            {
                "speaker_id": "2",
                "transcription": "진실은 거짓말로 은폐되고 있고 증거는 조금씩 폐기되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.089,
                "end": 14.570
            },
            {
                "speaker_id": "2",
                "transcription": "바로 국정 조사가 필요로 하는 이유입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.580,
                "end": 18.479
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘은 강제력이 없는 국정 조사는 수사에 지장을 주고 정쟁만 일으킨다며 거부 의사를 분명히 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.489,
