        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰 수사의 독립성 중립성이 지켜지도록 힘을 모아 달라 임기 2년을 마친 남구준 국가 수사 본부장이 퇴임사에서 당부한 말입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.387
            },
            {
                "speaker_id": "1",
                "transcription": "작금의 경찰 조직을 흔들리는 꽃에 현재 상황을 썰물에 비유하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.397,
                "end": 16.360
            },
            {
                "speaker_id": "2",
                "transcription": "이 순간은 힘들다고 느끼시겠지만 썰물이 있으면 반드시 밀물의 때가 옵니다.",
                "sound_type": [
                    2
                ],
                "start": 16.360,
                "end": 21.500
            },
            {
                "speaker_id": "2",
                "transcription": "흔들리지 않고 피는 꽃이 어디 있겠습니까.",
