        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당는 정부가 서민 민생 예산을 대폭 깎고 영빈관 신축 예산을 숨겨놨다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.131
            },
            {
                "speaker_id": "2",
                "transcription": "영빈관 짓는 예산 878억 알고 계셨냐고 묻습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.141,
                "end": 11.381
            },
            {
                "speaker_id": "2",
                "transcription": "몰랐습니까.",
                "sound_type": [
                    2
                ],
                "start": 11.391,
                "end": 12.605
            },
            {
                "speaker_id": "3",
                "transcription": "저는 몰랐고 신문을 보고 알았습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.615,
                "end": 15.409
            },
            {
                "speaker_id": "3",
                "transcription": "보고를 받으시고 즉각 이거는 저 철회를 하는 게 좋겠다.",
                "sound_type": [
                    2
                ],
                "start": 15.419,
                "end": 18.428
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 영빈관 없는 나라 보지 못했다며 엄호에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.438,
                "end": 23.749
            },
            {
                "speaker_id": "4",
                "transcription": "영빈관은 우리 국격에 맞게 필요한거 아닙니까.",
                "sound_type": [
                    2
                ],
                "start": 23.759,
                "end": 27.819
            },
            {
                "speaker_id": "3",
                "transcription": "품격 있는 그런 국가의 건물을 하나 짓자 이래서 아마 예산 신청한 것으로",
                "sound_type": [
                    2
                ],
                "start": 27.829,
                "end": 34.467
            }
        ]
    },
