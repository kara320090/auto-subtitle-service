    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "50대 이상",
                "gender": "남성"
            },
            {
                "speaker_id": "2",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 우한솔 기자 우리 군도 오늘 즉각 대응한 걸로 아는데 소식 전해 주시죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.550
            },
            {
                "speaker_id": "2",
                "transcription": "네 북한이 ICBM을 발사한 것으로 파악된 뒤 우리 군 당국도 즉각 대응에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.600,
                "end": 12.342
            },
            {
                "speaker_id": "2",
                "transcription": "앞서 군 당국은 오후 2시 34분쯤 북한의미사일을 포착했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.352,
                "end": 16.976
            },
            {
                "speaker_id": "2",
                "transcription": "이후 약 1시간 50분쯤 지난 오후 4시 25분부터 동해상으로 지상과 해상 공중에서 합동으로 미사일을 발사했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.986,
                "end": 26.419
            },
            {
                "speaker_id": "2",
                "transcription": "우선 사거리 300킬로미터의 현무 투 지대지 미사일을 한 발 발사했고 전술 지대지 미사일인 에이태킴스 한 발 또 해성 투 함대지 미사일을 한 발 발사했고 공대지 합동 정밀 직격탄 두 발을 발사했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.429,
                "end": 42.165
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 즉각적인 대응 능력과 의지를 보여주는 한편 언제든 미사일 발사를 원점과 지휘 시설 등을 정밀 타격하는 능력와 태세를 갖추고 있는 것을 확인했다고 군 당국은 평가했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 42.175,
                "end": 54.737
            },
            {
                "speaker_id": "2",
                "transcription": "또 원인철 합참 의장은 폴 라캐머라 연합 사령관과 북한의 ICBM 발사 직후 화상 회의를 통해 상황을 공유하고 한미 연합 방위 태세를 굳건히 할 것을 확인했다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 54.747,
                "end": 66.954
            },
            {
                "speaker_id": "2",
                "transcription": "이와 관련해 다음 달 예정된 한미 연합 훈련에서 야외 기동 훈련을 할 가능성도 높아졌습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 66.964,
                "end": 73.254
            },
            {
                "speaker_id": "2",
                "transcription": "한미 양국은 다음 달 중순부터 위기 관리 참모 훈련과 연합 지휘소 연습을 실시할 계획인데요.",
                "sound_type": [
                    2
                ],
                "start": 73.264,
                "end": 79.581
            },
            {
                "speaker_id": "2",
                "transcription": "우선은 컴퓨터 시뮬레이션을 활용한 지휘소 연습을 할 계획이지만 북한이 레드 라인을 넘는 도발을 하면 전략 폭격기 등 전략 자산 출동과 함께 야외 실기동 훈련을 실시하는 방안도 검토한 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 79.591,
                "end": 92.957
            },
            {
                "speaker_id": "2",
                "transcription": "구체적인 연습 참여 규모와 방식은 아직 유동적이긴 하지만 이번에 북한이 ICBM을 발사하면서 야외 기동 훈련을 할 가능성이 높아진 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 92.967,
                "end": 102.112
            },
            {
                "speaker_id": "2",
                "transcription": "군 당국은 북한이 ICBM 발사를 강행한 것은 우리 군과 한미 동맹에 대한 심각한 도전이라면서 북한 군의 추가 발사에 대비해 감시와 경계를 격상한 가운데 한미 간 긴밀하게 공조하고 있다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 102.122,
                "end": 114.782
            },
            {
                "speaker_id": "2",
                "transcription": "지금까지 국방부에서 KBS 뉴스 우한솔입니다.",
                "sound_type": [
                    2
                ],
                "start": 114.792,
                "end": 118.218
            }
        ]
    },
    "summary": "북한이 ICBM을 발사해 원인철 합참 의장과 폴 라캐머라 연합 사령관이 화상 회의를 통해 상황을 공유하고 한미 양국은 다음 달 중순부터 위기 관리 참모 훈련과 연합 지휘소 연습을 실시할 계획이다.",
