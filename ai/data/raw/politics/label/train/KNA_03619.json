        "term": [
            {
                "speaker_id": "1",
                "transcription": "2016년 프랑스 파리 공항 공단은 김해 신공항이 동남권 관문 공항에 최적 입지라는 조사 결과를 내놨습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.605
            },
            {
                "speaker_id": "1",
                "transcription": "국토부도 이 결과에 맞춰 공항 기본 계획을 만들었고 지금까지 40억 원의 예산이 투입됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.615,
                "end": 14.565
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 지난달 가덕도 신공항 특별법이 통과된 데 이어 오늘 열린 국무회의에서 이 계획은 전면 폐기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.575,
                "end": 22.473
            },
            {
                "speaker_id": "2",
                "transcription": "그동안 진행했던 김해 신공항 건설과 관련된 모든 업무는 이제 일제히 중단할 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 22.483,
                "end": 30.230
            }
        ]
    },
    "summary": "김해 신공항 건설과 관련된 모든 업무는 중단할 계획이다.",
