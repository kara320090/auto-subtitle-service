        "term": [
            {
                "speaker_id": "1",
                "transcription": "내부자 정보를 이용한 투기라는 심각한 범죄를 타인에게 씌울 때는 구체적인 근거가 있어야 한다는 상식조차 내다 버린 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.753
            },
            {
                "speaker_id": "2",
                "transcription": "윤 의원은 스스로 공수처에 수사를 의뢰하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.763,
                "end": 14.026
            },
            {
                "speaker_id": "2",
                "transcription": "조사 결과 어떤 혐의도 나오지 않는다면 음해를 작당한 여당 의원들 모두 의원직을 사퇴하라고 요구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.036,
                "end": 20.346
            },
            {
                "speaker_id": "2",
                "transcription": "특히 민주당 이재명 후보와 방송인 @이름1 씨를 향해서도 공적인 영역을 떠나라고 날을 세웠습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.356,
                "end": 27.069
            },
            {
                "speaker_id": "2",
                "transcription": "다만 아버지의 농지 구입이 투기 의혹으로 비춰질 수 있다는 점은 인정하고 땅은 되는대로 판 뒤 이익은 전부 사회에 환원하겠다는 아버지의 편지를 공개했습니다.",
                "sound_type": [
                    2
                ],
