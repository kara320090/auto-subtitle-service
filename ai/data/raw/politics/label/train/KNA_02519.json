        "term": [
            {
                "speaker_id": "1",
                "transcription": "안전 운임제 연장에 대해선 유보적 입장을 보였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.824
            },
            {
                "speaker_id": "1",
                "transcription": "물가 부담으로도 이어질 수 있기 때문에 국민적 합의가 필요하다는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.834,
                "end": 8.658
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 공을 국회로 넘겼습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.668,
                "end": 11.470
            },
            {
                "speaker_id": "2",
                "transcription": "12월에 기한이 끝나는 안전 운임제를 어떻게 연장할 것인지 이 문제가 국회에서 결론이 나야 이 부분이 조정이 될 수 있기 때문에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.480,
                "end": 24.440
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 법 개정 당사자인 여야는 머리를 맞대는 대신 네 탓 공방을 이어갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.450,
                "end": 30.296
            }
        ]
    },
    "summary": "안전 운임제 연장에 관해 국회에게 공을 넘겼고 법 개정 당사자인 여야는 네 탓 공방을 이어가고 있다.",
