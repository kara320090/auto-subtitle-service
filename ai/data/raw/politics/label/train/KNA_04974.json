        "term": [
            {
                "speaker_id": "1",
                "transcription": "의견을 좁히고 있는 과정이고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.514
            },
            {
                "speaker_id": "1",
                "transcription": "이번 주 내로 가급적 원구성 협상을 마무리할 계획이라는 것을 밝혀드립니다.",
                "sound_type": [
                    2
                ],
                "start": 2.524,
                "end": 11.086
            },
            {
                "speaker_id": "2",
                "transcription": "국회 원구성 문제를 마무리하기 위해서 지속적으로 협의의 시간을 가졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.096,
                "end": 17.414
            },
            {
                "speaker_id": "2",
                "transcription": "계속 이견을 좁혀가는 과정이다 이렇게 봐주시면 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.424,
                "end": 21.716
            },
            {
                "speaker_id": "3",
                "transcription": "상임위 구성을 놓고 오늘 하루 두 차례나 진행된 양당 원내 수석 회동도 별 소득이 없었습니다.",
                "sound_type": [
