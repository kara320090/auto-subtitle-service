        "term": [
            {
                "speaker_id": "1",
                "transcription": "공직자 중 차관급 이상 공무원과 국회의원 지방의원 정무직 공무원 공공기관 임원 등은 고위공직자로 분류돼 가족의 채용 등에 있어 더 강한 규제를 받습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.201
            },
            {
                "speaker_id": "1",
                "transcription": "제3자가 미공개 정보를 얻어 부당한 이득을 취할 경우에도 처벌 대상이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 11.211,
                "end": 16.895
            },
            {
                "speaker_id": "1",
                "transcription": "이 법에 빠진 국회의원의 사적 이해관계 사전신고와 이 가운데 본인에 관한 사항을 공개하게 한 국회법 개정안도 국회 운영위를 통과했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.905,
                "end": 27.350
            },
            {
                "speaker_id": "1",
                "transcription": "이해관계가 겹치는 상임위 배정과 안건 심사를 제한하는 내용도 포함됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.360,
                "end": 32.632
            }
        ]
    },
    "summary": "공직자 중 차관급 이상 공무원과 국회의원 공공기관 임원 등은 고위공직자로 분류돼더 강한 규제를 받는다고 하였으며 국회법 개정안도 통과했고 상임위 배정과 안건 심사를 제한하는 내용도 포함됐다고 기자는 보도하였다.",
