        "term": [
            {
                "speaker_id": "1",
                "transcription": "청와대나 권력의 압력이나 흔들기가 있다면 어떻게 하실 거예요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.588
            },
            {
                "speaker_id": "2",
                "transcription": "공수처가 수사 이첩권을 이용해 검찰이 진행 중인 수사를 무마시키는 것 아니냐는 의심에 목소리도 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.598,
                "end": 11.855
            },
            {
                "speaker_id": "3",
                "transcription": "검찰이 하고 있는 울산 시장 하명수사 월성 원전 폐쇄 사건 등을 공수처가 가져가서 입맛대로 깔아뭉개기 하는 거 아니겠느냐",
                "sound_type": [
                    2
                ],
                "start": 11.865,
                "end": 22.343
            },
            {
                "speaker_id": "4",
                "transcription": "공수처가 여당 편도 아니고 야당 편도 아니고 우리는 국민 편만 들겠다 이런 자세로 일하면 저는 정치적 중립성은 지켜지리라고 생각하고요.",
                "sound_type": [
                    2
