        "term": [
            {
                "speaker_id": "1",
                "transcription": "이종섭 국방부 장관 후보자 인사 청문회에서는 대통령 집무실 이전에 따른 안보 공백 우려를 두고 질의가 집중됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.704
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 국방부와 합동 참모 본부 등 군 시설의 연쇄 이동으로 안보에 심각한 공백이 우려된다며 대책을 따졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.714,
                "end": 17.304
            },
            {
                "speaker_id": "2",
                "transcription": "지금의 국방부를 이렇게 서둘러 이전하고 다섯 곳으로 쪼개고 대단한 군사 공백과 안보 공백 통신 공백 망 공백 이런 부분이 생겨날 위험성이 대단히 크다.",
                "sound_type": [
                    2
