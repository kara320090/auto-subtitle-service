        "term": [
            {
                "speaker_id": "1",
                "transcription": "경제가 안 보이고 안보가 경제인 시대에 살고 있다",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.496
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 확대 정상회담장에서 꺼낸 첫 마디입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.506,
                "end": 7.880
            },
            {
                "speaker_id": "1",
                "transcription": "국제 안보 질서 변화에 따른 공급망 교란이 국민의 생활과 직결돼 있다는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.890,
                "end": 13.920
            },
            {
                "speaker_id": "1",
                "transcription": "요소수 사태와 최근의 반도체 수급란을 언급하며 경제 안보가 군사 안보와 동일선상에서 다뤄져야 한다고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.930,
                "end": 22.760
            },
            {
                "speaker_id": "2",
                "transcription": "새로운 현실에 맞게 한미동맹도 한층 진화해 나가야 합니다.",
                "sound_type": [
                    2
