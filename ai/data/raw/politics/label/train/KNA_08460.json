        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 문재인 정부가 북한이라는 특정한 교우에 대해서만 집착해왔다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.502
            },
            {
                "speaker_id": "1",
                "transcription": "동맹인 미국에 더해 일본까지 포함한 안보 협력에 대해선 북핵 미사일에 대응해 동북아 안보를 지키는 데 필요한 일이라면 피할 이유가 없다고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.512,
                "end": 15.707
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령의 인터뷰가 보도된 오늘 공교롭게 문 전 대통령의 대북 관련 메시지도 공개됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.717,
                "end": 21.970
            },
            {
                "speaker_id": "1",
                "transcription": "내일 국회에서 열리는 구일구 군사 합의 4주년 기념 토론회에 보낸 서면 축사에서 대화가 없으면 평화도 없다 모든 대화의 출발점은 신뢰라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.980,
                "end": 32.422
            },
            {
                "speaker_id": "1",
                "transcription": "문 전 대통령은 특히 정부가 바뀌어도 남북 간 합의는 마땅히 존중하고 이행해야 할 약속이라고 강조했습니다.",
                "sound_type": [
                    2
