        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 전 쌍방울그룹 회장이 북한에 보낸 것으로 알려진 돈은 당초 500만 달러였습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.693
            },
            {
                "speaker_id": "1",
                "transcription": "2019년도에 이뤄진 이 송금의 목적은 대북 경협 사업을 위한 것이었다고 김 전 회장은 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.703,
                "end": 13.059
            },
            {
                "speaker_id": "2",
                "transcription": "대북 송금으로 개인 돈으로 하셨다고 하셨는데",
                "sound_type": [
                    2
                ],
                "start": 13.069,
                "end": 16.048
            },
            {
                "speaker_id": "3",
                "transcription": "검찰 조사에 성실히 임하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.058,
                "end": 18.275
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 구속 뒤 조사 과정에서 진술 기조가 바뀌었습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.285,
                "end": 22.440
            },
            {
                "speaker_id": "1",
                "transcription": "북한에 보낸 돈은 총 800만 달러고 목적도 경기도의 대북 사업과 관련된 것이었단 주장입니다.",
                "sound_type": [
                    2
                ],
