        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번에는 단 이틀로 속도를 내는 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.022
            },
            {
                "speaker_id": "1",
                "transcription": "국무회의까지 일사천리로 통과할 경우 당장 다음 달부터 인사 정보 관리단은 본격 업무가 가능합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.032,
                "end": 10.142
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 되면 청문회 과정에서 후보자가 낙마해 공석이 된 교육부와 복지부 장관 차기 후보자 그리고 신임 경찰청장 후보자의 검증까지 이곳에서 맡을 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.152,
                "end": 21.224
            },
            {
                "speaker_id": "1",
                "transcription": "다만 이 기구가 법무부 장관 직할로 운영되면서",
                "sound_type": [
                    2
                ],
                "start": 21.234,
                "end": 24.791
            }
        ]
    },
    "summary": "인사 정보 관리단 시행에 속도를 내고 있는데 국무회의까지 통과할 경우 다음 달부터 업무가 가능해 공석으로 남아있는 교육부 복지부 장관 그리고 신임 경찰청장 후보자 검증까지 이곳에서 맡을 수 있다.",
