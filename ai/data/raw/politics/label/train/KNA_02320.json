        "term": [
            {
                "speaker_id": "1",
                "transcription": "소상공인분들을 위해서 제가 버팀목 대출이라는 것을 고안을 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.328
            },
            {
                "speaker_id": "1",
                "transcription": "이자가 없고 그리고 담보를 낼 필요가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.338,
                "end": 7.870
            },
            {
                "speaker_id": "2",
                "transcription": "자영업자와 소상공인에 대한 신용 대사면을 추진하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.880,
                "end": 12.126
            },
            {
                "speaker_id": "2",
                "transcription": "어 정부의 정책 집합 금지 명령이나 또는 영업 제한에 아 따랐기 때문에 피해를 보신 분들은",
                "sound_type": [
                    2
                ],
                "start": 12.136,
                "end": 19.892
            },
            {
                "speaker_id": "3",
                "transcription": "2시간가량 진행된 이번 토론회의 전체 영상은 KBS 뉴스의 인터넷 홈페이지와 유튜브 채널로 다시 볼 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.902,
                "end": 26.760
            }
        ]
    },
    "summary": "소상공인을 위한 이자와 담보가 없는 버팀목 대출을 고안했고 정부 정책에 따른 피해를 보신 분들에 대한 신용 대사면을 추진하겠다고 했으며 전체 영상은 홈페이지와 유튜브로 다시 볼 수 있다고 전했다.",
