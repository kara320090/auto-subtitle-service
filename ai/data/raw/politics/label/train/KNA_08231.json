        "term": [
            {
                "speaker_id": "1",
                "transcription": "박순애 장관 사퇴 하루 만에 열린 국회 교육 위원회.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.271
            },
            {
                "speaker_id": "1",
                "transcription": "유기홍 교육 위원장은 장관 대신 참석한 교육부 차관에게 만 5세 입학에 대한 분명한 입장을 밝히라고 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.281,
                "end": 10.765
            },
            {
                "speaker_id": "2",
                "transcription": "그 정책은 사실상 폐기한다 이렇게 봐도 되는 겁니까.",
                "sound_type": [
                    2
                ],
                "start": 10.775,
                "end": 15.863
            },
            {
                "speaker_id": "1",
                "transcription": "장상윤 차관은 당장 폐기한다고 말하기 어렵다면서도 사실상 철회 입장을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.873,
                "end": 22.875
            },
            {
                "speaker_id": "3",
                "transcription": "현실적으로 추진하기 어려워졌다고 으 판단을 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.885,
                "end": 27.427
            }
        ]
    },
