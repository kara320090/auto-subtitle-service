        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 이행 가능성을 묻자 현실적인 어려움을 털어놓습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.432
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까 보건복지부에서는 의과 대학 의사 충원제를 가지고 있더라고요.",
                "sound_type": [
                    2
                ],
                "start": 4.442,
                "end": 10.574
            },
            {
                "speaker_id": "2",
                "transcription": "국가하고 의사의 의정 협의체가 있는데 협의가 잘 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 10.584,
                "end": 15.631
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 전남 지역 숙원 사업인 전남권 의대는 20년 넘게 공약으로 남아 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.641,
                "end": 22.279
            },
            {
                "speaker_id": "3",
                "transcription": "의사 단체와 이 공공 의대와 어떻게 협업을 할 것인지 사유화 과정이 빠졌기 때문에 충원 가능성이 있을까 이런 부분에는 많은 분들이 의문을 제기하고 있는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 22.289,
                "end": 33.500
            }
        ]
    },
    "summary": "후보들의 의대 설립 관련 이행 가능성에는 현실적인 어려움을 털어놓았는데 실제로 전남 지역 숙원 사업인 전남권 의대는 20년 넘게 공약으로 남아 있다고 보도했다.",
