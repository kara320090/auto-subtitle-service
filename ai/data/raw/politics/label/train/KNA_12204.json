                "start": 18.187,
                "end": 26.255
            },
            {
                "speaker_id": "1",
                "transcription": "정의당은 1당과 2당이 결정돼 있는 상황에서 여당이 의석 한 석을 더 갖는 것이 무슨 의미냐며 지지를 호소했습니다.",
                "sound_type": [
                    2,
                    5
