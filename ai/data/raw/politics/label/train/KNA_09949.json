            },
            {
                "speaker_id": "1",
                "transcription": "전문가 감정 결과 현장에 조명이 설치되지 않았고 장 의원이 근거로 댄 외신이나 사진 전문가 분석은 실체가 없다는 겁니다.",
                "sound_type": [
