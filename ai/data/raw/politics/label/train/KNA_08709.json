                    2
                ],
                "start": 0.000,
                "end": 7.647
            },
            {
                "speaker_id": "2",
                "transcription": "그건 그 생각이 아니셨습니까? 진짜?",
                "sound_type": [
                    2
                ],
                "start": 7.657,
                "end": 9.806
            },
            {
                "speaker_id": "2",
                "transcription": "그럼 왜 이거 하셨습니까? 누굴 지키겠다는 생각 아니셨습니까?",
                "sound_type": [
