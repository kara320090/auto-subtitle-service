        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰 인사는 법무부 장관이 검찰총장 의견을 듣고 내도록 돼있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.869
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 총장은 공석이고 후보자 윤곽도 안 나온 상태 이런 가운데 인사가 진행되자 총장 건너뛰기 논란이 따라붙습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.879,
                "end": 13.746
            },
            {
                "speaker_id": "1",
                "transcription": "법무부는 총장 인선까지 기다리기엔 시급한 현안이 많고 총장 직무대리인 대검 차장의 의견을 들어 인사를 냈다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.756,
                "end": 23.027
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 검찰 내부에선 이른바 식물 총장 우려 속에 차기 총장 하려는 사람을 찾기 어렵다는 말까지 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 23.037,
                "end": 30.397
            }
        ]
    },
    "summary": "검찰 인사가 단행됐으나 총장 건너뛰기 인사 식물 총장 등의 말들이 나오고 있다.",
