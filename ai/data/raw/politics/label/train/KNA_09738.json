        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 양곡 관리법 거부권 행사 여진은 장외에서도 이어졌는데 민주당 안민석 의원의 발언이 논란을 일으켰습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.954
            },
            {
                "speaker_id": "2",
                "transcription": "총선에서 국힘이 지게 되면은 윤석열 대통령과 김근희 여사가 무탈하겠습니까 아마 감옥갈 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 7.964,
                "end": 16.711
            },
            {
                "speaker_id": "3",
                "transcription": "도 넘은 막말이며 이 정도면 협박에 가깝습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.721,
                "end": 21.136
            },
            {
                "speaker_id": "3",
                "transcription": "김민석 의원의 막말은 동료 의원들조차 부끄럽게 만들고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.146,
                "end": 28.116
            },
            {
                "speaker_id": "1",
                "transcription": "한일 외교 등 현안에 대한 여야 대치는 4월 국회 내내 계속될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 28.126,
