        "term": [
            {
                "speaker_id": "1",
                "transcription": "여야 협상 과정에 진통을 예고하는 대목입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.399
            },
            {
                "speaker_id": "2",
                "transcription": "아직도 뭐 산 넘어 산입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.409,
                "end": 6.109
            },
            {
                "speaker_id": "2",
                "transcription": "일몰법 여러 문제도 있고 법안들에 관해서도 생각이 많이 다르기 때문에",
                "sound_type": [
                    2
                ],
                "start": 6.119,
                "end": 10.318
            },
            {
                "speaker_id": "3",
                "transcription": "여야가 합의를 해서 28일에 처리하자.",
                "sound_type": [
                    2
                ],
                "start": 10.328,
                "end": 14.300
            },
            {
                "speaker_id": "3",
                "transcription": "이런 취지입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.293,
                "end": 15.012
            },
            {
                "speaker_id": "3",
                "transcription": "그니까 내용에 대해서는 저희가 더 아 따져 봐야 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 15.022,
                "end": 18.119
            },
            {
                "speaker_id": "1",
                "transcription": "다만 건강 보험 재정 국고 지원제는 기한을 두고는 엇갈리지만 연장 필요성엔 입장차가 좁혀진 상황입니다.",
                "sound_type": [
                    2
                ],
                "start": 18.126,
                "end": 25.658
            }
        ]
    },
    "summary": "여야 협상 과정에 진통이 예고되며 건강 보험 재정 국고 지원제는 기한을 두고는 엇갈리지만 연장 필요성엔 입장차가 좁혀진 상황이라고 전한다.",
