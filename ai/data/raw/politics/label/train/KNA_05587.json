        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 경찰청 특별수사본부가 이곳 서울경찰청에 대해 압수수색을 시작한 건 오늘 오후 2시부터입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.770
            },
            {
                "speaker_id": "1",
                "transcription": "압수수색은 시작한 지 4시간 50분이 지난 오후 6시 50분쯤 끝이 났습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.780,
                "end": 12.787
            },
            {
                "speaker_id": "1",
                "transcription": "압수수색 대상은 서울경찰청 112 치안종합상황실입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.797,
                "end": 17.107
            },
            {
                "speaker_id": "1",
                "transcription": "이태원 참사 당일 신고와 대응 상황 기록을 확보하기 위해서입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.117,
                "end": 22.013
            },
            {
                "speaker_id": "1",
                "transcription": "당초 특수본은 이곳뿐 아니라 용산경찰서와 구청 소방서 서울소방재난본부 종합방재센터 서울교통공사 다산콜센터 이태원 역 등 8개 기관을 압수수색했다고 밝혔는데요.",
                "sound_type": [
                    2
                ],
                "start": 22.023,
                "end": 35.318
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이태원역에 대한 압수수색 영장은 오늘 집행하지 못한 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.328,
                "end": 40.284
            },
            {
                "speaker_id": "1",
                "transcription": "이들 기관 혐의는 모두 업무상 과실치사입니다.",
                "sound_type": [
                    2
                ],
                "start": 40.294,
                "end": 44.174
            },
            {
                "speaker_id": "1",
                "transcription": "용산경찰서의 경우 사고 발생 4시간 전부터 압사 관련 신고를 받고도 제대로 조치를 취하지 않은 경위를 들여다 보고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 44.184,
                "end": 52.682
            },
            {
                "speaker_id": "1",
                "transcription": "이임재 용산경찰서장과 112 상황실장을 대상으로도 조사와 함께 압수수색이 이뤄졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 52.692,
                "end": 59.590
            },
            {
                "speaker_id": "1",
                "transcription": "이 서장은 사고 발생 1시간 21분이 지난 11시 36분에야 @이름1 서울경찰청장에게 늑장보고를 한 사실이 드러나기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.600,
                "end": 69.754
            },
            {
                "speaker_id": "1",
                "transcription": "이 서장은 오늘 오후 대기발령 조치됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 69.764,
                "end": 72.706
            },
            {
                "speaker_id": "1",
                "transcription": "특수본은 용산구청 구청장실 등을 압수수색해 축제 관련 회의록과 예산 문건 등을 확보했습니다.",
                "sound_type": [
                    2
                ],
                "start": 72.716,
                "end": 80.126
            },
            {
                "speaker_id": "1",
                "transcription": "각 기관의 안전 대책 준비에 과실이나 부주의가 없었는지 사고 직후 조치가 적절했는지 등을 중점적으로 확인할 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 80.136,
                "end": 89.522
            }
        ]
    },
    "summary": "이태원 참사 사고 원인과 책임 소재를 밝히기 위해 경찰이 관련 기관에 대한 강제 수사에 착수하여 대규모 압수수색에 나섰다.",
