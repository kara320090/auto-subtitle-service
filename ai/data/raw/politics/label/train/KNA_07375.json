        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령의 제안으로 광주행 특별 열차를 함께 탄 여당 의원들 윤 대통령과 일일이 인사를 나눴습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.864
            },
            {
                "speaker_id": "2",
                "transcription": "아 아이 앉으세요 앉으세요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.874,
                "end": 9.642
            },
            {
                "speaker_id": "1",
                "transcription": "박수로 화답하며 화기애애한 분위기를 연출하기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.652,
                "end": 16.858
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 이른바 호남 동행 의원들과 식사를 함께하며 통합을 강조했고 국무위원들에겐 격려를 건넸습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.868,
                "end": 24.932
            },
            {
                "speaker_id": "1",
                "transcription": "기념식에는 사실상 국민의힘 의원 전원이 참석했는데 보수정당으로선 이례적인 일입니다.",
                "sound_type": [
                    2
                ],
                "start": 24.942,
                "end": 31.860
            },
            {
                "speaker_id": "1",
                "transcription": "국민 통합 행보를 가시적으로 보여주면서 호남 민심을 고리로 중도층에도 다가가겠단 의도로 풀이됩니다.",
                "sound_type": [
                    2
                ],
                "start": 31.870,
                "end": 38.304
            }
        ]
    },
    "summary": "윤석열 대통령의 제안으로 광주행 특별 열차를 함께 탄 여당 의원들과 윤 대통령은 일일이 인사를 나눴고 기념식에는 국민의힘 의원 전원이 참석했는데 보수정당으로선 이례적인 일이라며 호남 민심과 중도층에도 다가가겠단 의도로 풀이된다고 기자는 보도했다.",
