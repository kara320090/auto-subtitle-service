        "term": [
            {
                "speaker_id": "1",
                "transcription": "주가 조작과는 무관하다며 민주당이 거짓 의혹을 꾸며내고 있다고 맞받았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.429
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 대장동 의혹 수사 과정에서 숨진 김문기 전 성남 도시개발공사 개발처장의 아들과 함께 기자회견을 열고 이재명 후보를 겨냥했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.439,
                "end": 16.256
            },
            {
                "speaker_id": "2",
                "transcription": "유동규 본부장과 함께 골프까지 같이 친 아버지를 이재명 대선후보는 기억하지 못하고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.266,
                "end": 23.963
            },
            {
                "speaker_id": "2",
                "transcription": "왜 어째서 아버지를 모른다고 기억이 안 난다고 거짓말을 하는 건지 궁금합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.973,
                "end": 29.513
            },
            {
                "speaker_id": "1",
                "transcription": "고인의 아들은 아버지가 충성을 다해 봉사했는데도 이 후보가 아버지의 죽음에 어떤 애도의 뜻도 비치지 않았다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.523,
                "end": 38.901
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 이 후보가 성남시장 시절 김 전 처장과 함께 찍은 사진을 추가 공개하고 대장동 의혹의 몸통은 이재명 후보라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.911,
                "end": 48.591
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 강푸른입니다.",
                "sound_type": [
                    2
                ],
                "start": 48.601,
                "end": 51.060
            },
            {
                "speaker_id": "3",
                "transcription": "1박2일 충청 유세에 나선 민주당 이재명 후보는 국토 균형발전을 통해 함께 잘 사는 나라를 만들겠다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 51.070,
                "end": 60.060
            }
        ]
    },
    "summary": "국민의힘은 대장동 의혹 수사 과정에서 숨진 김문기 전 성남 도시개발공사 개발처장의 아들과 함께 기자회견을 열고 이 후보가 성남시장 시절 김 전 처장과 함께 찍은 사진을 추가 공개하며 대장동 의혹의 몸통은 이재명 후보라고 주장했다.",
