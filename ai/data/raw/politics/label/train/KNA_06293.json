        "term": [
            {
                "speaker_id": "1",
                "transcription": "사모님이 내일 초밥 올려 달라 그랬어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.895
            },
            {
                "speaker_id": "1",
                "transcription": "그거 점심때 올릴까? 어떻게 할까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.905,
                "end": 4.310
            },
            {
                "speaker_id": "2",
                "transcription": "초밥집 가서 그거 결제를 카드 갖다 하고 결제하고 나서 올리겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.320,
                "end": 9.758
            },
            {
                "speaker_id": "3",
                "transcription": "지난해 11월까지 두 사람의 9개월 치 통화 녹음에는 이렇게 카드를 바꿔 결제하는 내용이 10차례 넘게 등장합니다.",
                "sound_type": [
                    2
