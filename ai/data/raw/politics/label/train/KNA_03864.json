                    2
                ],
                "start": 0.000,
                "end": 6.685
            },
            {
                "speaker_id": "1",
                "transcription": "국회에서의 여야 협상에는 진전이 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.695,
                "end": 9.971
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 김부겸 총리 후보자의 인준 안이라도 먼저 처리하자며 사전 절차로 인사 청문 특위를 소집했지만 국민의 힘은 응하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.981,
                "end": 19.518
            },
            {
                "speaker_id": "2",
                "transcription": "대통령을 보좌하면서 국정 전반을 총괄해야 될 국무총리의 자기가 어느 때보다도 중요할 때입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.528,
                "end": 27.343
            },
            {
                "speaker_id": "3",
                "transcription": "국민적 분노가 확인되었음에도 불구하고 협치를 포기하고 또 다시 인사 독주를 강행하면서 힘으로 밀어붙이려 하고 있습니다.",
