        "term": [
            {
                "speaker_id": "1",
                "transcription": "수사팀은 의혹을 확인하기 위해서 이 지검장에게 지난주 주말과 이번 주 초 두 차례에 걸쳐 출석 요구서를 보냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.121
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 지검장은 시일이 촉박하다는 등에 이유로 출석 요구를 거절한 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.131,
                "end": 14.656
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 이 지검장은 수사를 중단하도록 압박했다는 보도 내용은 전혀 사실이 아니며 통상적인 지휘였다고 관련 의혹을 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.666,
                "end": 24.533
            },
            {
                "speaker_id": "1",
                "transcription": "이번 의혹과 관련해 수사팀은 현재까지 당시 반부패부에 있던 @이름1 수원지검장 등 관련자들을 참고인 신분으로 조사했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.543,
                "end": 34.064
            },
            {
                "speaker_id": "1",
                "transcription": "당시 반부패부와 관련한 남은 조사 대상자는 이 지검장 뿐인 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.074,
                "end": 39.956
            },
            {
                "speaker_id": "1",
                "transcription": "이 지검장이 관련 의혹을 부인하고 출석 거부 의사를 밝히면서 수사팀은 이 지검장에 대한 수사 일정을 다시 조율하거나 강제 수사 가능성도 열어두고 있습니다. KBS 뉴스 @이름2입니다.",
                "sound_type": [
                    2
                ],
                "start": 39.966,
                "end": 54.154
            }
        ]
    },
