        "term": [
            {
                "speaker_id": "1",
                "transcription": "여야 할 것 없이 쏟아낸 부동산 세금 완화 공약.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.838
            },
            {
                "speaker_id": "1",
                "transcription": "지역 균형 발전 재원으로 쓰이는 종부세 완화도 지방 선거 공약입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.848,
                "end": 8.914
            },
            {
                "speaker_id": "2",
                "transcription": "종부세 1가구 폐지 종부세 2가구도 6억에서 11억까지 완화시키겠다는 게",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.924,
                "end": 16.226
            },
            {
                "speaker_id": "2",
                "transcription": "지방세인 재산세 감면 공약은 완화하겠다부터 일정 범위는 면제하겠다까지 다양합니다.",
                "sound_type": [
                    2
                ],
                "start": 16.236,
                "end": 23.201
            },
            {
                "speaker_id": "3",
                "transcription": "도지사에 당선되는 즉시 납부를 유예하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.211,
                "end": 27.144
            },
            {
                "speaker_id": "3",
                "transcription": "그리고 조례 개정에 착수하도록 하겠습니다.",
                "sound_type": [
                    2
