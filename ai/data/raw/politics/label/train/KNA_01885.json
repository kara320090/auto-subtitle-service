            },
            {
                "speaker_id": "2",
                "transcription": "특히 이 텔레그램 대화방에서의 성착취 실태를 폭로한 이른바 N번방 사건에 주역 박지현 씨를 공동위원장으로 발탁했습니다.",
                "sound_type": [
                    2
