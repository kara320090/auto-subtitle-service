                ],
                "start": 18.060,
                "end": 20.759
            },
            {
                "speaker_id": "3",
                "transcription": "대선 전날 2030 여성들에게 민주당 이재명 후보에 대한 지지를 호소했던 박지현 선대위 여성위원회 부위원장",
                "sound_type": [
