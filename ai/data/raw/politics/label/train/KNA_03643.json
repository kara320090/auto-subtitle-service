        "term": [
            {
                "speaker_id": "1",
                "transcription": "더불어민주당은 개혁의 설계자로서 스스로에게 더 엄격하고 단호해지도록",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.176
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘 오세훈 후보는 서울 강북권 유세에 집중했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.186,
                "end": 9.542
            },
            {
                "speaker_id": "2",
                "transcription": "복합 쇼핑몰 등 지역 건설 공약을 강조하며 정권 심판을 거듭 호소했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.552,
                "end": 15.773
            },
            {
                "speaker_id": "3",
                "transcription": "민주당이 뼛속 깊이 반성할 수 있도록 그래서 앞으로는 1년동안이나마 진심으로 여러분 앞에 사죄할 수 있도록",
                "sound_type": [
