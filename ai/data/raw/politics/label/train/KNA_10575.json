        "term": [
            {
                "speaker_id": "1",
                "transcription": "다만 재판부는 현행법 상 혼인은 남녀의 애정을 바탕으로 한 결합으로 해석하고 있다면서 동성 결합을 사실혼으로 인정할 순 없다고 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.427
            },
            {
                "speaker_id": "1",
                "transcription": "소 씨와 김 씨는 그래도 사법부가 성소수자 커플의 권리를 인정한 첫 사례라고 환영했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.437,
                "end": 17.244
            },
            {
                "speaker_id": "2",
                "transcription": "그동안 어떤 불평등에 놓여 있었는지가 사법부의 판단을 통해 세상에 더 알려지게 되는 것 같아서",
                "sound_type": [
                    2
                ],
                "start": 17.254,
                "end": 26.407
            },
            {
                "speaker_id": "3",
                "transcription": "이 소송으로 얻어낸 권리는 혼인이 얻어낼 수 있는 1000가지의 권리 중에 단 1가지일 뿐입니다.",
                "sound_type": [
                    2
                ],
                "start": 26.417,
                "end": 33.800
            }
        ]
    },
    "summary": "재판부는 동성 사이의 사실혼 관계는 인정할 수 없다고 선을 그은 가운데 소 씨와 김 씨는 사법부가 성소수자 커플의 권리를 인정한 첫 사례라고 환영했다.",
