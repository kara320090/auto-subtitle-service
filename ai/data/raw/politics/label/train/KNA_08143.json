        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 연장선상에서 내일 곧바로 전익수 법무실장이 소환됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.721
            },
            {
                "speaker_id": "1",
                "transcription": "전 실장은 피의자 신분입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.731,
                "end": 7.983
            },
            {
                "speaker_id": "1",
                "transcription": "가해자에 대한 불구속 수사를 지휘하고 국방부 압수수색에 미리 대비했다는 수사 무마 의혹도 받고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.993,
                "end": 16.176
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 특검이 소환했던 하위 관련자들은 구속영장이 잇따라 기각됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.186,
                "end": 22.247
            },
            {
                "speaker_id": "1",
                "transcription": "따라서 이번 장성급 인사들에 소환조사가 특검 수사에 변곡점이 될 전망입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.257,
                "end": 28.190
            },
            {
