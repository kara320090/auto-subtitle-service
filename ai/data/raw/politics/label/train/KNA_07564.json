        "term": [
            {
                "speaker_id": "1",
                "transcription": "세 번째는 미등기 임원이라는 점입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.742
            },
            {
                "speaker_id": "1",
                "transcription": "취업이라고 보기는 어렵지 않느냐.",
                "sound_type": [
                    2
                ],
                "start": 2.752,
                "end": 4.969
            },
            {
                "speaker_id": "2",
                "transcription": "배임으로 유죄를 선고 받았던 박찬구 금호석유화학 회장도 집행유예 기간에 대표이사로 취임해 취업 제한 규정 위반 의혹이 제기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.979,
                "end": 15.445
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 그 건에 대해서도 경찰은 수사 중지 결정을 내렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.455,
                "end": 19.759
            },
            {
                "speaker_id": "3",
                "transcription": "해를 끼쳤던 그 회사에서 일을 못하도록 하는 거는 어떻게 보면은 지당한 그런 어 벌인데 사문화가 되는 거고 어 뭐 결국은 있으나 마나한 조항이 돼 버린다고",
                "sound_type": [
