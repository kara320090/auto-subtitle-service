        "term": [
            {
                "speaker_id": "1",
                "transcription": "자격이 되는데도 기초생활보장 수급자 신청은커녕 어르신 70퍼센트가 받고 있는 기초연금까지 거절하기도 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.265
            },
            {
                "speaker_id": "2",
                "transcription": "필요하신 분을 주시면은 아직 제가 필요하지 않아서 더 나이 든 다음에 제가 꽉 막히면 뭐하니까 그때 가서 이제 더 나이 들어서 해도 되는 거니까요.",
                "sound_type": [
                    2
                ],
                "start": 8.275,
                "end": 22.581
            },
            {
                "speaker_id": "1",
                "transcription": "이처럼 자격이 충분한데도 신청을 하지 않아 복지 혜택을 못 받는 사람은 48만 명으로 추산됩니다.",
                "sound_type": [
                    2
                ],
                "start": 22.591,
                "end": 29.867
            },
            {
                "speaker_id": "1",
                "transcription": "이유를 조사해보니 신청해도 떨어질 것 같아서가 가장 많고 필요 없어서와 제도를 몰라서가 뒤를 이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.877,
                "end": 38.019
            },
            {
                "speaker_id": "1",
                "transcription": "스스로 해결하려고라는 답도 11퍼센트 과정이 번거로워서도 10퍼센트나 됐습니다.",
                "sound_type": [
                    2
                ],
