        "term": [
            {
                "speaker_id": "1",
                "transcription": "우선 안전에 우려가 있는 현장을 바로 신고할 수 있는 핫라인을 만들기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.006
            },
            {
                "speaker_id": "1",
                "transcription": "기존의 온라인으로 하던 안전점검 청구제를 확대하는 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.016,
                "end": 9.399
            },
            {
                "speaker_id": "1",
                "transcription": "예방을 위해 점검을 요청할 수 있고 긴급 상황일 경우는 경찰이나 소방에 신고해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 9.409,
                "end": 15.673
            },
            {
                "speaker_id": "1",
                "transcription": "정보통신기술 활용 방안도 추진됩니다.",
                "sound_type": [
                    2
                ],
                "start": 15.683,
                "end": 18.391
            },
            {
                "speaker_id": "1",
                "transcription": "붕괴 위험 축대 등에 사물 인터넷기기를 설치해 진동 등을 실시간 점검하는 방식입니다.",
                "sound_type": [
