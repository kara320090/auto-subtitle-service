        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 정부의 인수위원장은 예측이 나오던 대로 단일화 상대였던 안철수 국민의당 대표였습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.825
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인이 직접 밝힌 인선 이유 가치와 철학을 공유하고 있다는 것이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.835,
                "end": 12.429
            },
            {
                "speaker_id": "2",
                "transcription": "저와 국정운영 가치와 철학을 공유하고 안 대표도 인수위원회를 이끌 의지가 있고 저 역시도 적임자라 판단했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.439,
                "end": 26.006
            },
            {
                "speaker_id": "1",
                "transcription": "인수위 부위원장은 대선 과정에서 당 선대본부장을 맡았던 권영세 의원이 선거 공약 반영을 위해 만든 기획위원회 위원장은 원희룡 전 제주지사가 맡게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.016,
                "end": 37.327
            },
            {
                "speaker_id": "1",
                "transcription": "인수위는 기존에 밝혔던 대로 7개 분과 1개 위원회 두 개 특위로 구성되는데 코로나19 대응 특위를 안철수 인수위원장이 겸임하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.337,
                "end": 47.554
            },
            {
                "speaker_id": "2",
                "transcription": "코로나 문제는 우리 인수위원장께서 방역과 의료 이런 분야에 이제 나름 전문가시고 그래서 제가 이 부분을 부탁을 드렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.564,
                "end": 59.170
            },
            {
                "speaker_id": "1",
                "transcription": "인수위원 인선을 거의 마무리한 가운데 인수위는 21일 출범을 목표로 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.180,
                "end": 64.925
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인과 안철수 인수위원장은 내일 만나 인수위 운영 방향을 조율합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.935,
                "end": 70.720
            },
            {
                "speaker_id": "1",
                "transcription": "국민의당은 국민 통합정부의 첫 단추라고 의미를 부여했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 70.720,
                "end": 74.953
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
