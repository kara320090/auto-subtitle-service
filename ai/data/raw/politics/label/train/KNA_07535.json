            },
            {
                "speaker_id": "1",
                "transcription": "핵심은 이번에도 법사 위원장입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.189,
                "end": 10.545
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘은 다수당인 민주당이 국회의장을 맡을 거면 작년 합의대로 법사 위원장을 국민의 힘이 맡아야 한다고 요구합니다.",
                "sound_type": [
