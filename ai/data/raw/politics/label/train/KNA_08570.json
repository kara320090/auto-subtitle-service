        "term": [
            {
                "speaker_id": "1",
                "transcription": "1970에서 80년대 국가가 노조원들을 불법 체포하고 구금한 청계피복노조 사건 역시 경찰은 사과 권고를 정상 추진했다고 적어 놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.259
            },
            {
                "speaker_id": "1",
                "transcription": "피해자는 처음 듣는 말입니다.",
                "sound_type": [
                    2
                ],
                "start": 10.269,
                "end": 12.568
            },
            {
                "speaker_id": "2",
                "transcription": "국가가 제대로 사과를 한번 해줄까라고 기대를 했는데 그렇지 않았잖아요.",
                "sound_type": [
                    2
                ],
                "start": 12.578,
                "end": 17.862
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 아 우리는 여전히 그런 취급을 받고 살고 있구나 그렇게 생각을 하죠.",
                "sound_type": [
                    2
                ],
                "start": 17.872,
                "end": 24.084
            },
            {
                "speaker_id": "1",
                "transcription": "경찰은 정상 추진이라는 말이 권고를 이행 중이란 뜻이라면서 지금까지 최선을 다해왔다고 입장을 전했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.094,
                "end": 32.091
            },
            {
                "speaker_id": "3",
                "transcription": "당사자들만 힘들어 하는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 32.101,
                "end": 34.134
            }
        ]
    },
    "summary": "1970에서 80년대 국가가 노조원들을 불법 체포하고 구금한 청계피복노조 사건에 대해서 피해자들은 정부의 제대로 된 사과를 받지 못하고 힘들어 하고 있다.",
