        "term": [
            {
                "speaker_id": "1",
                "transcription": "안철수 대통령직 인수위원장은 오늘 인수위 사무실 앞에서 기자들과 만나 가능하면 이번 주말이라도 현판식을 하려고 한다고 밝혔는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.016
            },
            {
                "speaker_id": "1",
                "transcription": "현재 인수위 7개 분과 중에 경제2 과학 기술 교육 사회 복지 문화 세 분과에 대한 인선이 남았습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.026,
                "end": 16.209
            },
            {
                "speaker_id": "1",
                "transcription": "세 분과에 대한 인선이 마무리되는 대로 인수위는 출범할 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.219,
                "end": 20.565
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인은 또 오늘 정책특보에 박근혜 정부에서 경제 수석을 지낸 강석훈 성신여대 교수 고용 복지 수석을 역임한 김현숙 숭실대 교수를 임명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.575,
                "end": 32.358
            },
            {
                "speaker_id": "2",
                "transcription": "그나저나 오늘 대통령과의 오찬이 무산되면서 윤 당선인이 어떤 일정을 보냈는지도 궁금하군요.",
                "sound_type": [
                    2
                ],
                "start": 32.368,
                "end": 38.405
