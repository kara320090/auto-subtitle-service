        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 때문에 전학 조치 처분을 받았고 소송 끝에 2019년이 돼서야 전학을 갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.746
            },
            {
                "speaker_id": "1",
                "transcription": "정 변호사는 아들의 학교 폭력 전력에 앞서 검사 출신이라는 이유로도 국가 수사 본부장 임명 직후부터 논란이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.756,
                "end": 13.623
            },
            {
                "speaker_id": "1",
                "transcription": "경찰 수사권 독립의 상징과도 같은 조직의 수장에 검사 출신이 임명돼 일선 경찰의 반발을 부른 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.623,
                "end": 21.271
            },
            {
                "speaker_id": "2",
                "transcription": "검찰 출신 임명에 반발의 목소리가 있는데 우려는 따로 없으신 건가요?",
                "sound_type": [
                    2
                ],
                "start": 21.281,
                "end": 25.686
            },
            {
                "speaker_id": "3",
                "transcription": "지금 그거 물어볼 상황 아니죠.",
                "sound_type": [
                    2
                ],
                "start": 25.696,
                "end": 27.260
            }
        ]
    },
    "summary": "정 변호사는 검사 출신이라는 이유로 임명 직후부터 논란이 됐다.",
