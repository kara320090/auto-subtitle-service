        "term": [
            {
                "speaker_id": "1",
                "transcription": "그린벨트를 푸느냐 마느냐 어떻게 푸느냐 일정 차를 늘리게 하는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.658
            },
            {
                "speaker_id": "2",
                "transcription": "그린벨트를 손대지 않고 다른 방법이 있다면 다른 방법을 쓰는 것이 좋다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.668,
                "end": 11.996
            },
            {
                "speaker_id": "3",
                "transcription": "역시 후보 등록을 마친 김부겸 전 의원은 강원도에서 선거 일정을 시작했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.006,
                "end": 18.081
            },
            {
                "speaker_id": "3",
                "transcription": "이번 전당 대회는 대선 후보 뽑는 자리가 아니다.",
                "sound_type": [
                    2
                ],
                "start": 18.091,
                "end": 21.389
            },
            {
                "speaker_id": "3",
                "transcription": "대선 나간다며 중간에 그만두면 곤란하다며 이 의원을 견제했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.399,
                "end": 25.892
            }
        ]
    },
    "summary": "이낙연 의원은 그린벨트에 관한 소견을 밝혔고 김부겸 의원은 강원도에서 선거 일정을 시작했다.",
