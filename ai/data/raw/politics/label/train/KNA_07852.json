        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 힘은 날치기 개원이라며 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.881
            },
            {
                "speaker_id": "1",
                "transcription": "여야 합의 없이 본 회의를 여는 건 국회법 위반이라고도 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.891,
                "end": 7.489
            },
            {
                "speaker_id": "1",
                "transcription": "민주당이 요구하는 사개특위는 검수완박 뒤처리를 하는 것이라며 수용 불가라고 못 박았습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.499,
                "end": 14.098
            },
            {
                "speaker_id": "2",
                "transcription": "다시 또 어 입법 폭주족에 근육 자랑을 또 하고 싶다 아 이렇게 가는 것은 대단히 부적절한 음 행위이다 이렇게 보고",
                "sound_type": [
                    2
