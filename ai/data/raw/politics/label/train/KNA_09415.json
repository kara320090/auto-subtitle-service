        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "반면 노 의원은 정치 검사들이 증거를 조작했다며 억울하다고 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.800
            },
            {
                "speaker_id": "2",
                "transcription": "내 조사 과정에서 묻지도 제시하지도 확인하지도 않았습니까.",
                "sound_type": [
                    2
                ],
                "start": 4.810,
                "end": 10.109
            },
            {
                "speaker_id": "2",
                "transcription": "아무것도 물어보지 않고 갑자기 녹취가 있다.",
                "sound_type": [
                    2
                ],
                "start": 10.119,
                "end": 14.268
            },
            {
                "speaker_id": "2",
                "transcription": "뭐가 있다.",
                "sound_type": [
                    2
                ],
                "start": 14.278,
                "end": 15.165
            },
            {
                "speaker_id": "2",
                "transcription": "이거는 방어권을 완전히 무시하는 거 아닙니까?",
                "sound_type": [
                    2
                ],
                "start": 15.175,
                "end": 17.801
            },
            {
                "speaker_id": "1",
                "transcription": "정의당은 찬성 당론을 민주당과 국민의힘은 자유 투표를 정한 뒤 나섰는데 결과는 찬성 101표 반대 161표로 부결이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.811,
                "end": 28.353
            },
            {
                "speaker_id": "1",
                "transcription": "21대 국회 4차례 체포동의안 중 첫 부결 사롑니다.",
                "sound_type": [
                    2
                ],
                "start": 28.363,
                "end": 32.944
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘과 정의당은 방탄 국회 제 식구 감싸기라고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.954,
                "end": 37.763
            },
            {
                "speaker_id": "3",
                "transcription": "노웅래 민주당 의원 체포동의안 부결은 이재명 방탄의 예행연습으로밖에 볼 수 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.773,
                "end": 46.179
            }
        ]
    },
    "summary": "정의당은 찬성 당론을 민주당과 국민의힘은 자유 투표를 정한 뒤 나섰는데 결과는 찬성 101표 반대 161표로 부결이며 21대 국회 4차례 체포동의안 중 첫 부결 사례인데 국민의힘과 정의당은 방탄 국회 제 식구 감싸기라고 비판했다.",
