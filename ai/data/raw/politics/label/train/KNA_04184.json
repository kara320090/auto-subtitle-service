        "term": [
            {
                "speaker_id": "1",
                "transcription": "사림의 선비 정신 그리고 개혁 정신 불의에 저항하는 저항 정신을 잊지 않으려고 어 진정으로 노력합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.214
            },
            {
                "speaker_id": "2",
                "transcription": "이재명 후보는 특히 일을 못 해도 보수 정당에 반복해서 표를 주면 존중이나 배려를 받지 못한다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.224,
                "end": 16.125
            },
            {
                "speaker_id": "2",
                "transcription": "이낙연 후보는 이재명 후보의 관할 지역인 경기 북부를 찾아 경기 북도로 분리하자고 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.135,
                "end": 22.884
            },
            {
                "speaker_id": "2",
                "transcription": "정세균 후보는 당 차원의 대선 후보 검증단 설치를 거듭 주장했고 충남을 찾은 김두관 후보는 충청권 메가시티 구축에 힘을 보태겠다고 약속했습니다.",
                "sound_type": [
