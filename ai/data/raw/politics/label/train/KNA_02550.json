        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰청장으로서 해야 할 역할과 책무를 다하겠다고만 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.698
            },
            {
                "speaker_id": "1",
                "transcription": "일선 경찰들의 반응은 날로 격화되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.708,
                "end": 8.233
            },
            {
                "speaker_id": "1",
                "transcription": "일부 경찰서 등에는 근조 현수막까지 걸렸고 정부청사 앞에서는 1인 시위도 시작됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.243,
                "end": 15.111
            },
            {
                "speaker_id": "2",
                "transcription": "내무부 치안본부에 있던 과거의 오욕을 안았던 경찰 모습으로 되는 게 아닌가.",
                "sound_type": [
                    2
                ],
                "start": 15.121,
                "end": 22.347
            },
            {
                "speaker_id": "2",
                "transcription": "권력이나 외압에 굴하지 않는 수사를 해야 되는데 대놓고 가져가겠다는 거라 우려가 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 22.357,
                "end": 28.479
            },
            {
                "speaker_id": "1",
                "transcription": "행안부 자문위는 오는 21일 권고안을 발표합니다.",
                "sound_type": [
                    2
                ],
                "start": 28.489,
                "end": 31.998
            }
        ]
    },
    "summary": "일선 경찰들의 권력과 외압에 의한 수사를 경계하는 목소리가 심화되는 가운데 행안부 자문위는 오는 21일 권고안을 발표하기로 하였다.",
