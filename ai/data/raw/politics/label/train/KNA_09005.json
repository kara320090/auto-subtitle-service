        "term": [
            {
                "speaker_id": "1",
                "transcription": "관련 부처가 시행령 개정 협의 중에 있을 뿐 무산된 것은 아니라며 반환한 것은 전적으로 문 전 대통령 측 판단일 뿐이라고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.832
            },
            {
                "speaker_id": "1",
                "transcription": "여야 설전도 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.842,
                "end": 11.171
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 권성동 의원은 퇴임 후 키우는 강아지 사육비까지 혈세로 충당해야겠냐며 좀스럽고 민망한 일이라고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.181,
                "end": 19.847
            },
            {
                "speaker_id": "1",
                "transcription": "이에 민주당 윤건영 의원은 겉으론 호탕하게 데려가 키우라 해놓고 속으로 태클을 건다.",
                "sound_type": [
                    2
                ],
                "start": 19.857,
                "end": 25.929
            },
            {
                "speaker_id": "1",
                "transcription": "좀스럽고 민망한 일을 하는 건 정부와 여당이라고 맞받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.939,
                "end": 29.829
            }
        ]
    },
    "summary": "풍산개 반환에 대해 여야의 설전이 이어졌다.",
