        "term": [
            {
                "speaker_id": "1",
                "transcription": "끝자락에 굉장히 조그맣게 써놨어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.726
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 그런 부분들을 가리고 싶은 거 아니냐 만약에 특정인을 염두에 두고 그 자격 조건을 그렇게 확대를 안 해주면 이런 분들이 와가지고 시험을 못 보죠.",
                "sound_type": [
                    2
                ],
                "start": 1.736,
                "end": 11.635
            },
            {
                "speaker_id": "2",
                "transcription": "응시 자격 확대에 대해 국방부는 인사기획관실 아래 국방정책 관련 부서가 일부 포함된 점을 고려했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.645,
                "end": 20.811
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 우수한 인재를 더 지원받기 위해서였다고 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.821,
                "end": 25.492
            }
        ]
    },
    "summary": "국방부는 우수한 인재를 더 지원받기 위해 응시 자격을 확대했다고 밝혔다.",
