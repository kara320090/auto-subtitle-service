        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 해서는 과연 서울이나 경기도라든지 수도권도 존재할 수 있겠는가?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.762
            },
            {
                "speaker_id": "2",
                "transcription": "서울시는 일방적인 대책 발표라며 날 선 반응을 보였습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.772,
                "end": 10.427
            },
            {
                "speaker_id": "2",
                "transcription": "이미 2년 전 전용 차로 설치를 논의했지만 국토부가 이후 추가 협의를 진행하지 않았다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 10.437,
                "end": 16.714
            },
            {
                "speaker_id": "2",
                "transcription": "서울시는 전용 차로에 일반 차량이 진입할 수밖에 없는 구조여서 효율성이 떨어지는 우려가 여전하지만 일단 설치 논의는 시작하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.724,
                "end": 26.799
            },
            {
                "speaker_id": "2",
                "transcription": "또 김포 골드 라인의 승객 동선을 관리하는 서울시 인력을 투입하고 수륙 양용 버스 도입도 검토하기로 했습니다.",
                "sound_type": [
                    2
                ],
