        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쏟아지는 취재진 질문에 굳게 입을 다문 추미애 법무부 장관",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.949
            },
            {
                "speaker_id": "2",
                "transcription": "정권을 수사한 사람에 대한 보복 인사라는 얘기까지 나오고 있는데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.959,
                "end": 9.880
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 고위급 인사에서 절차를 어겼다는 한국당 지적에 작심한 듯 입을 열었습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.890,
                "end": 15.939
            },
            {
                "speaker_id": "3",
                "transcription": "명백히 검찰청법 34조에 위반되는 사람인 거죠.",
                "sound_type": [
                    2
                ],
                "start": 15.949,
                "end": 19.962
            },
            {
                "speaker_id": "3",
                "transcription": "그렇게 생각 안 하십니까?",
                "sound_type": [
                    2
                ],
                "start": 19.972,
                "end": 21.459
            },
            {
                "speaker_id": "4",
                "transcription": "제가 위반한 것이 아니고요.",
                "sound_type": [
                    2
                ],
                "start": 21.469,
                "end": 23.690
            },
            {
                "speaker_id": "4",
                "transcription": "검찰 총장이 저의 명을 거역한 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.700,
                "end": 28.635
            },
            {
                "speaker_id": "1",
                "transcription": "추미애 장관은 @이름1 검찰 총장이 제3의 장소로 인사안을 가져오라고 무리하게 요구했다며 자신은 장관 집무실에서 상의하자고 여러 차례 제안했다고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.645,
                "end": 39.851
            },
            {
                "speaker_id": "4",
                "transcription": "검찰 총장의 의견을 듣겠다 해서 저는 상당히 배려를 해서 직접 오시라고",
                "sound_type": [
                    2
                ],
                "start": 39.861,
                "end": 47.969
            },
            {
                "speaker_id": "1",
                "transcription": "자유 한국당에선 정권 입맛에 맞춘 인사라는 비판이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.979,
                "end": 52.223
            },
            {
                "speaker_id": "5",
                "transcription": "정의가 살아 숨쉬겠다 할 국민들이 과연 얼마나 있겠냐.",
                "sound_type": [
                    2
                ],
                "start": 52.233,
                "end": 55.785
            },
            {
                "speaker_id": "1",
                "transcription": "당 지도부도 검찰 대학살, 망나니 정권 같은 거친 표현을 쏟아냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 55.795,
                "end": 61.554
            },
            {
                "speaker_id": "6",
                "transcription": "사화에 가까운 숙청입니다.",
                "sound_type": [
                    2
                ],
                "start": 61.564,
                "end": 65.100
            },
            {
                "speaker_id": "6",
                "transcription": "친문 유일 체제 완성을 위한 검찰 무력화입니다.",
                "sound_type": [
                    2
                ],
                "start": 65.110,
                "end": 70.933
            },
            {
                "speaker_id": "1",
                "transcription": "한국당은 추 장관 탄핵 소추안을 제출하겠다면서 공수처 폐지와 함께 총선 1호 공약으로 검찰의 인사 독립을 내세웠습니다.",
                "sound_type": [
                    2
                ],
                "start": 70.943,
                "end": 80.176
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 합법적 인사에 트집을 잡고 있다며 대통령 인사권에 도전한 @이름1 총장이 오만방자하다고 논평했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 80.186,
                "end": 88.368
            },
            {
                "speaker_id": "7",
                "transcription": "검사의 인사권은 우리 국민을 대신해서 어 대통령에게 100퍼센트 있다는 점을 확인해드립니다.",
                "sound_type": [
                    2
                ],
                "start": 88.378,
                "end": 97.003
            },
            {
                "speaker_id": "1",
                "transcription": "바른 미래당은 이번 검찰 인사가 정권에 독이 될 것이라 비판했고 정의당은 검찰의 표적 과잉 수사에 대한 문책성 인사라고 평가했습니다.",
                "sound_type": [
                    2
                ],
                "start": 97.013,
                "end": 106.673
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름2입니다.",
                "sound_type": [
                    2
                ],
                "start": 106.683,
                "end": 109.142
            }
        ]
    },
    "summary": "자유 한국당은 정권 입맛에 맞춘 인사라 비판했고 민주당은 합법적 인사에 트집을 잡는다 했으며 바른 미래당은 정권에 독이 되는 인사라 비판했고 정의당은 검찰의 수사에 대한 문책성 인사라고 평가했다.",
