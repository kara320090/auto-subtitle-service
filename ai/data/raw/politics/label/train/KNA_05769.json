        "term": [
            {
                "speaker_id": "1",
                "transcription": "거짓에 협업한 민주당도 같은 입장이 아닌지 묻지 않을 수 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.249
            },
            {
                "speaker_id": "1",
                "transcription": "장관은 모든 직을 걸었는데 이제 무엇으로 책임질 것입니까?",
                "sound_type": [
                    2
                ],
                "start": 6.259,
                "end": 12.183
            },
            {
                "speaker_id": "2",
                "transcription": "한 장관은 김 의원의 끝까지 법적 책임을 묻겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.193,
                "end": 17.160
            },
            {
                "speaker_id": "3",
                "transcription": "저한테 사과하는 것이 모양 빠져서 싫으시면 국민들께라도 사과하시기 바랍니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.170,
                "end": 23.380
            },
            {
                "speaker_id": "3",
                "transcription": "그분은 입만 열면 거짓말하면서도 지금까지 단 한 번도 책임을 지지 않았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.390,
                "end": 28.805
            },
            {
                "speaker_id": "2",
                "transcription": "김 의원은 자신을 향한 사퇴 요구에 추가로 입장을 내놓지 않았습니다.",
                "sound_type": [
