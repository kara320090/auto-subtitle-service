        "term": [
            {
                "speaker_id": "1",
                "transcription": "권력형 범죄에 대해서 그리고 갖은 경제 범죄에 대해서 어떻게 했습니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.532
            },
            {
                "speaker_id": "1",
                "transcription": "수사기관들을 무력화시켰습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.542,
                "end": 7.806
            },
            {
                "speaker_id": "1",
                "transcription": "남부지검 증권범죄합동수사단 없앴습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.816,
                "end": 11.088
            },
            {
                "speaker_id": "2",
                "transcription": "한 후보자는 정치 검사라는 지적에 강하게 반박했고.",
                "sound_type": [
                    2
                ],
                "start": 11.098,
                "end": 15.347
            },
            {
                "speaker_id": "3",
                "transcription": "@이름1 수사 그냥 한번 눈감았으면 계속 꽃길이었을 텐데요.",
                "sound_type": [
                    2
                ],
                "start": 15.357,
                "end": 18.937
            },
            {
                "speaker_id": "3",
                "transcription": "그런데 제가 그 선택을 해서 이렇게 탄압받았는데요 언제 정치 검사의 정의가 바뀌었는지 저는 되묻고 싶습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.947,
                "end": 25.614
            },
            {
                "speaker_id": "2",
                "transcription": "딸의 스펙쌓기 의혹에 대해선 전체적으로 송구하다고 했지만 청문보고서 채택은 결국 보류됐습니다.",
                "sound_type": [
                    2
