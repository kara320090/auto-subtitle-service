        "term": [
            {
                "speaker_id": "1",
                "transcription": "같은 시각 국회 문화체육관광위원회 소속 위원들이 주최한 토론회에서는 해당 법안 처리에 대한 우려가 제기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.041
            },
            {
                "speaker_id": "1",
                "transcription": "망 사용료 계약을 의무화 하면 국내 콘텐츠 업계가 넷플릭스나 미국 정부로부터 불이익을 받을 수 있단 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 7.051,
                "end": 14.341
            },
            {
                "speaker_id": "2",
                "transcription": "한국에 대한 정책을 소극적 혹은 우회적으로 가져갈 수 밖에 없을 테고 피해는 결국 한국 컨텐츠 크리에이터들에게 돌아올 가능성이 높다고 생각을 하고요.",
                "sound_type": [
                    2
                ],
                "start": 14.351,
                "end": 24.207
            },
            {
                "speaker_id": "1",
                "transcription": "여야의 대치로 2달째 파행을 이어오던 국회 과방위는 오늘 여당 측 간사 선임으로 정상화된 상황.",
                "sound_type": [
                    2
                ],
                "start": 24.217,
                "end": 30.855
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 망 사용료 법안을 두고 상반된 목소리가 나오면서 법안 처리는 순조롭지 않을 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 30.865,
                "end": 38.013
            },
