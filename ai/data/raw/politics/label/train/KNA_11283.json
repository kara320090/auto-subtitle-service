        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회법 상 체포동의안의 경우 한글 또는 한자로 가 또는 부를 분명히 써야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.633
            },
            {
                "speaker_id": "1",
                "transcription": "만약 표기가 불명확하면 무효표가 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 5.643,
                "end": 9.144
            },
            {
                "speaker_id": "1",
                "transcription": "점이나 동그라미 같은 기호나 한자를 잘못 적을 경우 이름이나 기권 등을 적어도 무효 처리됩니다.",
                "sound_type": [
                    2
                ],
                "start": 9.154,
                "end": 16.057
            },
            {
                "speaker_id": "1",
                "transcription": "본인의 인증 표시로 사용할 수 있기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.067,
                "end": 19.310
            },
            {
                "speaker_id": "1",
                "transcription": "개표 중단 때까지 알려진 결과는 찬성 139대 반대 137.",
                "sound_type": [
                    2
                ],
                "start": 19.320,
                "end": 24.312
            },
            {
                "speaker_id": "1",
                "transcription": "불과 두 표 차이였습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.322,
                "end": 26.195
            },
            {
                "speaker_id": "1",
                "transcription": "두 표를 모두 반대표로 처리하면 가부 동수가 되고 한 표라도 무효로 처리하면 찬성표가 많아지게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 26.205,
                "end": 33.700
            }
        ]
    },
    "summary": "국회법 상 체포동의안의 경우 한글 또는 한자로 가 또는 부를 분명히 써야 하는데 개표 중단 때까지 알려진 결과는 찬성 139대 반대 137표로 두 표를 모두 반대표로 처리하면 가부 동수가 되고 한 표라도 무효로 처리하면 찬성표가 많아지게 됩니다.",
