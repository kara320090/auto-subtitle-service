                ],
                "start": 8.543,
                "end": 10.650
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 이번 EU 의결을 참고해 다음 달 우리나라 친환경 분류 체계를 확정할 방침입니다.",
                "sound_type": [
                    2
