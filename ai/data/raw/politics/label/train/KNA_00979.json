        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰 수사권 축소 법안이 오늘 오후 국무 회의에서 의결됐는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.237
            },
            {
                "speaker_id": "1",
                "transcription": "이로써 그동안 여야 간 극한의 충돌이 빚어졌던 검찰 수사권 축소 법안 입법 절차가 모두 마무리됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.247,
                "end": 11.459
            },
            {
                "speaker_id": "1",
                "transcription": "이번 개정안은 4개월 후부터 시행될 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.469,
                "end": 15.069
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 첫 소식으로 신선민 기자가 보도합니다.",
                "sound_type": [
                    2
                ],
                "start": 15.079,
                "end": 17.911
            },
            {
                "speaker_id": "2",
                "transcription": "검찰 수사권 축소 법안인 검찰청법과 형사 소송법 개정안이 국무 회의에서 모두 의결됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.921,
                "end": 26.234
            },
            {
                "speaker_id": "2",
                "transcription": "문재인 대통령은 국무 회의를 주재하면서 검찰 수사가 국민의 신뢰를 얻기에 충분치 않다는 평가가 있었다며 국회가 수사와 기소의 분리에",
                "sound_type": [
                    2
                ],
                "start": 26.244,
                "end": 36.202
