        "term": [
            {
                "speaker_id": "1",
                "transcription": "전당 대회에서 선출된 당 대표를 쫓아내는 것은 편법과 꼼수로 정적을 제거하는 우리 정치사에 없던 새로운 정치 공작 기법을 시전하는 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.332
            },
            {
                "speaker_id": "2",
                "transcription": "당 지도부는 비대위 성격과 기간 등에 대한 의견 수렴을 진행 중인데 비대 위원장 후보로 주호영 정우택 정진석 등 최다선 의원들과 김황식 전 국무총리 등이 거론됩니다.",
                "sound_type": [
                    2
                ],
                "start": 13.342,
                "end": 25.581
            },
            {
                "speaker_id": "3",
                "transcription": "비대 위원장 후보 좀 줄이셨는지 한 말씀만 부탁드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 25.591,
                "end": 28.772
            },
            {
                "speaker_id": "4",
                "transcription": "아직 의견을 수렴하고 있는 중이어서 아직 결정하지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.782,
                "end": 32.799
            }
        ]
    },
