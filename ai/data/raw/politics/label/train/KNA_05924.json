        "term": [
            {
                "speaker_id": "1",
                "transcription": "사실상 전용차가 두 대씩인 셈입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.704
            },
            {
                "speaker_id": "1",
                "transcription": "전용차가 대부분 승용차이다 보니 눈길이나 산길에 적합한 차량도 필요하다는 이유에서입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.714,
                "end": 9.679
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 의전 차량이 없는 속초와 태백시 등은 예산이 부족한 데다 다른 공용차를 충분히 이용할 수 있다고 설명합니다.",
                "sound_type": [
                    2
                ],
                "start": 9.689,
                "end": 17.668
            },
            {
                "speaker_id": "2",
                "transcription": "직원들이 출장을 가거나 할 때 사용하는 공용차가 있어서 배차를 받으셔 가지고 그냥 사용합니다 예산 문제도 있고요.",
                "sound_type": [
