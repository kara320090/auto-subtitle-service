        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 박 전 대통령에 대한 사면 결정에 대해 참여연대와 경실련 민주노총 등 시민 노동 단체들은 일제히 비판 성명을 냈습니다.",
                "sound_type": [
