        "term": [
            {
                "speaker_id": "1",
                "transcription": "CJ 계열 예능 채널 tvn에서 4년 가까이 방송 중인 인기 프로그램 유 퀴즈 온 더 블럭",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.660
            },
            {
                "speaker_id": "2",
                "transcription": "예 굉장히 삼엄하고 유퀴즈에서 단 한 번도 있지 않았던 그런 또 분위기가",
                "sound_type": [
                    2
                ],
                "start": 6.670,
                "end": 12.802
            },
            {
                "speaker_id": "1",
                "transcription": "이번 주에는 윤석열 대통령 당선인이 출연했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.812,
                "end": 16.598
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 이렇게 토크를 지금 해도 되는 건지 지금",
                "sound_type": [
                    2
                ],
                "start": 16.608,
                "end": 19.226
            },
            {
