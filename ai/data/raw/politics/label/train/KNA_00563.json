        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤 당선인 측은 즉각 협의하거나 추천한 적이 없다고 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.494
            },
            {
                "speaker_id": "1",
                "transcription": "지금 인수위 앞에 취재 기자가 나가 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 4.504,
                "end": 6.986
            },
            {
                "speaker_id": "1",
                "transcription": "연결해 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.996,
                "end": 8.255
            },
            {
                "speaker_id": "1",
                "transcription": "자 이화진 기자 그러니까 윤 당선인 측의 설명은 청와대의 설명과는 전혀 다른 거죠?",
                "sound_type": [
                    2
                ],
                "start": 8.265,
                "end": 14.394
            },
            {
                "speaker_id": "2",
                "transcription": "네 윤석열 당선인 측 설명은 이렇습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.404,
                "end": 19.106
            },
            {
                "speaker_id": "2",
                "transcription": "통상 추천이라고 하면 청와대가 당선인에게 추천해 달라고 요청을 먼저 하고 그러면 당선인이 적당한 인사를 물색해서 다시 청와대에 전달하는 식이어야 하는데 그런 절차가 없었다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 19.116,
                "end": 33.146
            },
            {
                "speaker_id": "2",
                "transcription": "장재원 당선인 비서실장은 청와대에서 이창용 국장이 한은 총재로 어떻냐고 물어봤고 그래서 좋은 분이네요라고 답한 게 전부라고 설명했는데요.",
                "sound_type": [
                    2
                ],
                "start": 33.156,
                "end": 44.161
            },
            {
                "speaker_id": "2",
                "transcription": "장재원 실장의 입장 들어 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 44.171,
                "end": 47.614
            }
        ]
    },
    "summary": "윤 당선인 측은 청와대의 입장과 달리 서로 협의를 하거나 이 후보를 추천한 적이 없다고 하였다.",
