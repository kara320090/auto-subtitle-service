        "term": [
            {
                "speaker_id": "1",
                "transcription": "유가족들하고 첫 어 우리 국조특위의 간담회에서도 어 전면 불참한 분들이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.443
            },
            {
                "speaker_id": "1",
                "transcription": "막고 싶었던 그 속내가 계속 드러난 것 아니겠습니까.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.453,
                "end": 11.278
            },
            {
                "speaker_id": "2",
                "transcription": "여당이 불참하더라도 국정 조사를 예정대로 진행하겠다는 뜻도 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.288,
                "end": 16.129
            },
            {
                "speaker_id": "3",
                "transcription": "진상 조사를 통한 책임 소재와 규명과 재발 방지 야말로 국민의 미래 안전을 보장하기 위한 국회의 책임이고",
                "sound_type": [
                    2
                ],
                "start": 16.139,
                "end": 27.101
            },
            {
                "speaker_id": "2",
                "transcription": "이런 가운데 국정 조사 실제 활동 기간은 점점 줄어들고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.111,
                "end": 31.201
            },
            {
                "speaker_id": "2",
                "transcription": "당초 합의했던 45일 기간 중 절반 가까이 지나고 있는데 여야는 아직 청문회 등 본조사 일정을 협의하지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.211,
                "end": 40.273
            }
        ]
    },
    "summary": "이태원 참사의 국정 조사는 당초 합의했던 45일 기간 중 절반 가까이 지나고 있는데 여야는 아직 청문회 등 본조사 일정을 협의하지 못했다.",
