        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 사실상 마지막 순서로 이 대표를 부른 건데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.135
            },
            {
                "speaker_id": "1",
                "transcription": "이제 남은 건 구속 영장 청구 여부 그리고 기소 여부가 되겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.190,
                "end": 7.601
            },
            {
                "speaker_id": "1",
                "transcription": "다만 성남 FC 사건 말고도 수사가 진행 중인 여러 사건들이 더 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.611,
                "end": 12.929
            },
            {
                "speaker_id": "1",
                "transcription": "가장 대표적인 게 서울 중앙 지검에서 수사 중인 백장동 개발 사업 특혜 의혹인데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.939,
                "end": 18.434
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 @이름1 @이름2 두 최측근이 구속된 가운데 이 사건 수사도 이제 사실상 이 대표만 남겨 놓고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.444,
                "end": 26.534
            },
            {
                "speaker_id": "1",
                "transcription": "또 수원 지검에서는 쌍방울 그룹이 이재명 대표의 변호사 비를 대납했단 의혹도 수사하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.544,
                "end": 33.110
            },
            {
                "speaker_id": "1",
                "transcription": "쌍방울과 관련해서는 역시 이 대표 측근으로 볼 수 있는 @이름3 전 경기도 평화 부지사도 뇌물 혐의로 구속된 상태입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.120,
                "end": 41.461
            },
            {
                "speaker_id": "1",
                "transcription": "그 밖에도 성남 백현동 개발 사업에 대해서도 경찰이 특혜 의혹을 수사 중입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.471,
                "end": 46.739
            },
            {
                "speaker_id": "1",
                "transcription": "한편 이 대표 장남의 성매매 혐의에 대해선 경찰이 지난해 10월 불송치 결정을 했는데 최근 수건 수원 지검의 재수사 요청으로 다시 수사가 시작된 걸로 확인됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.749,
                "end": 58.572
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 성남 지청에서 전해드렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.582,
                "end": 61.795
            }
        ]
    },
    "summary": "이 대표는 성남 FC 사건 백장동과 백현동 개발 사업 특혜 의혹 그리고 쌍방울 그룹 변호사 비 대납 의혹으로 수사를 받고 있다.",
