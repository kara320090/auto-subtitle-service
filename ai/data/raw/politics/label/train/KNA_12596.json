        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회의원을 모욕하시는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.084
            },
            {
                "speaker_id": "1",
                "transcription": "지금 아니요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.094,
                "end": 3.162
            },
            {
                "speaker_id": "1",
                "transcription": "제 말과 겹쳐하지 마시고 별도로 말씀하세요.",
                "sound_type": [
                    2
                ],
                "start": 3.172,
                "end": 7.057
            },
            {
                "speaker_id": "2",
                "transcription": "기초적인 사실 관계조차 틀린 질문도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.067,
                "end": 10.632
            },
            {
                "speaker_id": "3",
                "transcription": "우리 아이들이 한겨울에 내의 좀 입겠다는데 이 예산을 깎았어요.",
                "sound_type": [
                    2
                ],
                "start": 10.642,
                "end": 15.429
            },
            {
                "speaker_id": "4",
                "transcription": "좀 더 나은 이런 구매 방법을 통해서 가격이 인하됐기 때문에 그런 숫자들이 나왔다.",
                "sound_type": [
                    2
                ],
                "start": 15.439,
                "end": 23.544
            },
            {
                "speaker_id": "2",
                "transcription": "한덕수 총리는 언론 보도가 안 된 사안을 신문에서 봤다고 답하거나 직접 보고를 받았다는 내용은 틀리게 답변해 질타를 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.554,
                "end": 31.765
            }
        ]
    },
    "summary": "기초적인 사실 관계조차 틀린 질문도 있고 한덕수 총리는 언론 보도가 안 된 사안을 신문에서 봤다고 답하거나 틀리게 답변해 질타를 받았다.",
