        "term": [
            {
                "speaker_id": "1",
                "transcription": "나는 대한민국의 장교로서 국가와 국민을 위하여",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.273
            },
            {
                "speaker_id": "2",
                "transcription": "학군 사관후보생 3300여 명이 어제 소위로 임관했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.283,
                "end": 8.797
            },
            {
                "speaker_id": "2",
                "transcription": "우리 군 초급 간부의 70%는 학군 사관 출신입니다.",
                "sound_type": [
                    2
                ],
                "start": 8.807,
                "end": 12.811
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 개인 사정 등을 이유로 중도 포기하는 후보생이 늘고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.821,
                "end": 17.860
            },
            {
                "speaker_id": "2",
                "transcription": "육군의 경우 최근 3년 사이 3배 가까이 증가했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.870,
                "end": 21.875
            },
            {
                "speaker_id": "2",
                "transcription": "이들은 병사로 입대하게 되는데 이등병이 아닌 상병이나 병장으로 군 생활을 시작하고 복무 기간도 일반 병사보다 최장 3개월 짧습니다.",
