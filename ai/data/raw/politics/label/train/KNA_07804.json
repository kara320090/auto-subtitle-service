        "term": [
            {
                "speaker_id": "1",
                "transcription": "선택을 더 미루지는 마십시오.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.008
            },
            {
                "speaker_id": "2",
                "transcription": "이에 대한 김 후보자 해명도 검증해 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.018,
                "end": 6.173
            },
            {
                "speaker_id": "2",
                "transcription": "후보자 측은 국회 사무처에 사전 신고하고 검토를 받아 홍보성 문구를 수정해 실시했다며 규정 위반이 아니라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.183,
                "end": 14.804
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 사무처는 공식적인 사전 신고나 검토 제도 자체가 존재하지 않는다.",
                "sound_type": [
                    2
                ],
                "start": 14.814,
                "end": 20.331
            },
            {
                "speaker_id": "2",
                "transcription": "의원실에서 구두로 물어볼 수는 있겠지만 구체적인 자료는 없다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.341,
                "end": 25.558
            }
        ]
    },
    "summary": "김 후보자는 해명을 했지만 구체적인 자료는 없다고 밝혔다.",
