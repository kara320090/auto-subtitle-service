                "start": 9.358,
                "end": 16.948
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1 여가부 장관 후보자는 성인지 예산이 국방 예산만큼 늘었다고 했다가 가짜 뉴스 논란에 휩싸였고 @이름2 산자부 장관 후보자는 출산 기피 부담금 도입을 주장한 칼럼을 썼습니다.",
                "sound_type": [
