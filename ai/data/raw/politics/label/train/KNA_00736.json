        "term": [
            {
                "speaker_id": "1",
                "transcription": "인수위는 윤 당선인의 공약을 현실화하는 데 속도를 내고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": -0.11,
                "end": 3.900
            },
            {
                "speaker_id": "1",
                "transcription": "인수위는 기획 위원회 내에 인구 정책 TM TF가 마련될 것이라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.910,
                "end": 9.374
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인이 폐지를 공약했던 여성 가족부의 대안을 마련하는 데 역할을 할 것이라고 인수위는 설명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.384,
                "end": 16.752
            },
            {
                "speaker_id": "1",
                "transcription": "한편 안철수 위원장은 현대 기아차 기술 연구소에서 정의선 회장을 만났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.762,
                "end": 22.419
            },
            {
                "speaker_id": "1",
                "transcription": "이 자리에서 안 위원장은 미래 모빌리티가 반도체를 이을 전략 사업이라고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.429,
                "end": 28.999
            },
            {
                "speaker_id": "2",
                "transcription": "자 그리고 한덕수 국무총리 후보자는 자신의 재산과 관련한 각종 논란에 대해서 출근길에 입장을 밝혔죠.",
                "sound_type": [
                    2
                ],
                "start": 29.009,
                "end": 35.468
            }
        ]
    },
    "summary": "윤 당선인은 공약을 현실화 하는 데 속도를 내고 있는 한편 안철수 위원장은 미래 모빌리티가 반도체를 이을 전략 사업이라고 말한다.",
