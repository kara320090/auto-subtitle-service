        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거는 안보 공백을 반드시 초래할 수밖에 없다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.335
            },
            {
                "speaker_id": "2",
                "transcription": "반면 국민의힘 정치 공세라고 정면 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.345,
                "end": 7.430
            },
            {
                "speaker_id": "3",
                "transcription": "우리가 안보에 문제가 있다고 한다면 어느 대통령 당선자가 이 안보에 공백이 생기는데 이야기를 하겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 7.440,
                "end": 14.453
            },
            {
                "speaker_id": "2",
                "transcription": "보고에 나선 국방부는 우선 국방부 이전과 관련해 인수위가 처음 접촉해 온 게 발표 엿새 전이라고 밝혔습니다.",
                "sound_type": [
