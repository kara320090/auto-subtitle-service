        "term": [
            {
                "speaker_id": "1",
                "transcription": "코로나19 3차 대확산으로 2달 넘게 문을 닫았던 이 볼링장 2차는 물론 3차 지원금도 받지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.360
            },
            {
                "speaker_id": "1",
                "transcription": "직원 수가 4명 이하여야 한다는 기준에 맞지 않았기 때문입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.370,
                "end": 11.539
            },
            {
                "speaker_id": "2",
                "transcription": "무조건 규모가 크고 매출이 크다고 수익을 많이 가져가는 아니거든요.",
                "sound_type": [
                    2
                ],
                "start": 11.549,
                "end": 16.149
            },
            {
                "speaker_id": "2",
                "transcription": "오히려 더 비용이 크기 때문에 더 어려움이 큰 거고",
                "sound_type": [
                    2
                ],
                "start": 16.159,
                "end": 19.010
            },
            {
                "speaker_id": "1",
                "transcription": "이번 4차 지원금은 기존 소상공인 지원의 사각지대를 없애는 게 핵심입니다.",
                "sound_type": [
                    2,
