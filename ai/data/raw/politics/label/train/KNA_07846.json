        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 때문에 배상이나 개선 명령처럼 강제 조치가 가능한 노동 위원회도 나이 차별 문제 등을 다루게 하자는 목소리가 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.470
            },
            {
                "speaker_id": "2",
                "transcription": "굉장히 신속하게 그다음에 법적 구속력이 있는 구제의 조치가 나가기 때문에 차별 피해자 입장에서는 어 굉장히 효과적인 제도라고 볼 수가 있고",
                "sound_type": [
                    2
                ],
                "start": 7.480,
                "end": 21.568
            },
            {
                "speaker_id": "1",
                "transcription": "반면 인권위의 역할이 계속돼야 한단 의견도 만만치 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.578,
                "end": 26.029
            },
            {
                "speaker_id": "1",
                "transcription": "논란이 계속되는 가운데 관련 법안은 1년 넘게 국회에 계류 중입니다.",
                "sound_type": [
