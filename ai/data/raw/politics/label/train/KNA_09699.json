        "term": [
            {
                "speaker_id": "1",
                "transcription": "대선 패배 뒤 열린 지난해 전당대회를 앞두고 이재명의 민주당으로는 안 된다고 직격했던 비 이재명계 의원들 이 대표를 향한 전방위 수사가 한창인 지금 활동을 재개했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 12.091
            },
            {
                "speaker_id": "1",
                "transcription": "20여 명이 모였는데 당 안팎의 시선을 의식한 듯 비명 모임은 아니라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.101,
                "end": 18.210
            },
            {
                "speaker_id": "2",
                "transcription": "민주당의 길 토론회는 비명 모임이 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 18.220,
                "end": 22.054
            },
            {
                "speaker_id": "2",
                "transcription": "이건 비전 모임이에요 비전.",
                "sound_type": [
                    2
                ],
                "start": 22.064,
                "end": 24.100
            },
            {
                "speaker_id": "2",
                "transcription": "딱 1글자 틀린데요.",
                "sound_type": [
                    2
