        "term": [
            {
                "speaker_id": "1",
                "transcription": "이태원 참사 전 두 차례 현장을 둘러봤다고 했지만 그냥 귀가하는 게 CCTV에 찍혀 거짓 해명이 드러난 박희영 용산 구청장",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.670
            },
            {
                "speaker_id": "2",
                "transcription": "섣부른 해명으로 큰 혼란을 드렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.680,
                "end": 12.161
            },
            {
                "speaker_id": "2",
                "transcription": "진상조사에 성실히 임하겠습니다.",
