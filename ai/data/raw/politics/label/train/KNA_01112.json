        "term": [
            {
                "speaker_id": "1",
                "transcription": "인천은 특히 민주당 이재명 상임 고문이 뛰어든 계양을 국회 의원 보궐 선거도 있는 만큼 여야 모두 선거전 초반 기선 제압으로 수도권 승리를 이끌겠다는 포석으로 풀이됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.731
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 정권 출범 초반 국정 안정을 반면 민주당은 윤석열 정부의 독주 견제를 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.741,
                "end": 18.279
            },
            {
                "speaker_id": "2",
                "transcription": "여당으로써의 책임을 다하기 위해서입니다.",
                "sound_type": [
                    2
                ],
                "start": 18.289,
                "end": 21.701
            },
            {
                "speaker_id": "2",
                "transcription": "예산이 필요한 것들은 저희가 예산을 바로 반영할 수 있도록 하고 바로 입법 추진해가지고 성과를 낼 수 있도록 하겠습니다.",
                "sound_type": [
