        "term": [
            {
                "speaker_id": "1",
                "transcription": "동료 의원에 대한 예의와 존중은 국감 시작부터 실종됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.607
            },
            {
                "speaker_id": "2",
                "transcription": "왜 여기 본인 이야기만 하고 말아요.",
                "sound_type": [
                    2
                ],
                "start": 4.617,
                "end": 7.177
            },
            {
                "speaker_id": "2",
                "transcription": "의사 진행 발언 받았잖아요.",
                "sound_type": [
                    2
                ],
                "start": 7.187,
                "end": 9.812
            },
            {
                "speaker_id": "3",
                "transcription": "버르장머리가 없잖아. 지금",
                "sound_type": [
                    2
                ],
                "start": 9.822,
                "end": 11.581
            },
            {
                "speaker_id": "2",
                "transcription": "누구한테 버르장머리라 그래요. 지금",
                "sound_type": [
                    2
                ],
                "start": 11.591,
                "end": 13.342
            },
            {
                "speaker_id": "3",
                "transcription": "좀 가만히 계세요.",
