        "term": [
            {
                "speaker_id": "1",
                "transcription": "경고 방송과 경고 사격을 한 건 무의미했다는 비판도 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.910
            },
            {
                "speaker_id": "2",
                "transcription": "왜 경고 방송합니까.",
                "sound_type": [
                    2
                ],
                "start": 3.920,
                "end": 5.539
            },
            {
                "speaker_id": "2",
                "transcription": "하늘에 떠있는 무인기가 그 방송 내용을 듣습니까?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.549,
                "end": 8.554
            },
            {
                "speaker_id": "2",
                "transcription": "휴전선을 넘어와는 적기에 대해서는 무인기든 유인기든 격추해야죠.",
                "sound_type": [
                    2
                ],
                "start": 8.564,
                "end": 14.366
            },
            {
                "speaker_id": "1",
                "transcription": "군의 대응 미흡 원인을 두고는 책임 공방이 격해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.376,
                "end": 18.858
            },
            {
                "speaker_id": "3",
                "transcription": "5년 동안 우리 국민을 보호한 사드에 대해서는 그렇게 정상운영 못 하도록 방해를 하고 북한 무인기에 대해서는 모르쇠로 하다가 그나마 그에 대응하는 우리 손발을 묶었다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.868,
                "end": 32.553
            },
            {
                "speaker_id": "3",
                "transcription": "그 성적표가 배달된 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 32.563,
                "end": 34.691
            },
            {
                "speaker_id": "4",
                "transcription": "대통령은 토 그 통수권잔데",
                "sound_type": [
                    2,
                    4
                ],
                "start": 34.701,
                "end": 37.504
            }
        ]
    },
