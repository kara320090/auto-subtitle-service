        "term": [
            {
                "speaker_id": "1",
                "transcription": "그거는 진짜 인생에 제일 큰 중요한 문제인데 그거를 그냥 강제로 어쨌든 떠안게 된 거잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.989
            },
            {
                "speaker_id": "2",
                "transcription": "원하면 전월세 형태로 살던 집에 계속 머물 수 있지만 사기를 당한 집에 살기를 꺼려하는 피해자들을 위한 지원은 빚을 더 내는 것뿐입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.999,
                "end": 16.634
            },
            {
                "speaker_id": "3",
                "transcription": "임차인 피해자들이 사실 뭐 돈이 어디 있습니까?",
                "sound_type": [
                    2
                ],
                "start": 16.644,
                "end": 19.331
            },
            {
                "speaker_id": "3",
                "transcription": "또 뭐 추가 대출을 받고 해야 되는 거고 그러면 그 자체의 부담도 상당한 거고",
                "sound_type": [
                    2
                ],
                "start": 19.341,
                "end": 24.983
            },
            {
                "speaker_id": "2",
                "transcription": "피해자들은 빠른 지원보다는 제대로 된 지원이 필요하다며 정부 여당에 거듭 면담을 촉구했습니다.",
