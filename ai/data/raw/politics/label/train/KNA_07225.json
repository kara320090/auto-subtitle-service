        "term": [
            {
                "speaker_id": "1",
                "transcription": "최고 먼저 한 번 가보고 싶은 심정이에요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.389
            },
            {
                "speaker_id": "2",
                "transcription": "내일부터는 이제 그동안에 못 봤던 곳들도 많이 다 보실 수 있으니까 더 인기가 있을 것 같고.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.399,
                "end": 8.344
            },
            {
                "speaker_id": "3",
                "transcription": "통제가 풀리고 관람객이 몰리면서 상권이 더 살아날 것을 기대하는 분위기도 없지 않습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.354,
                "end": 14.690
            },
            {
                "speaker_id": "4",
                "transcription": "상인들한테는 활성화가 되는 그런 좋은 점이 있지 않을까 생각하고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.700,
                "end": 20.183
            },
            {
                "speaker_id": "5",
                "transcription": "기대도 높고 뭐 매물도 거둬들이거나 고요함이 좋아서 또 있는 분들도 있는데 그거 어떻게 되실지는.",
                "sound_type": [
                    2
                ],
                "start": 20.193,
                "end": 27.314
            },
            {
                "speaker_id": "3",
                "transcription": "서울특별시 종로구 @주소1.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.324,
                "end": 29.621
            },
            {
                "speaker_id": "3",
                "transcription": "이 주소는 그대로지만 이제 모든 것이 바뀝니다.",
                "sound_type": [
