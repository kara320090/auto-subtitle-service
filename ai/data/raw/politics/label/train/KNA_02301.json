        "term": [
            {
                "speaker_id": "1",
                "transcription": "박 전 대통령 뒤에는 수감 중인 이명박 전 대통령을 대신해 김윤옥 여사와 아들 이시형 씨가 자리했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.332
            },
            {
                "speaker_id": "1",
                "transcription": "전직 대통령의 유족들도 취임식에 참석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.342,
                "end": 11.339
            },
            {
                "speaker_id": "1",
                "transcription": "고 김대중 전 대통령의 차남 김홍업 전 의원 고 김영삼 전 대통령의 차남 김현철 김영삼 민주 센터 상임이사가 참석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.349,
                "end": 21.545
            },
            {
                "speaker_id": "1",
                "transcription": "지난해 세상을 떠난 노태우 전 대통령의 자녀 노소영 관장과 노재헌 변호사도 윤 대통령과 인사를 나눴습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.555,
                "end": 30.058
            },
            {
                "speaker_id": "1",
                "transcription": "고 노무현 전 대통령의 부인 권양숙 여사는 건강상 이유로 참석하지 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
