        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민들이 대선에서 심판을 선택했지만 민주당은 다수 당으로 국정 감시를 통해 얼마든지 일할 수 있다 기회를 달라 호소했습니다.",
                "sound_type": [
                    2,
