        "term": [
            {
                "speaker_id": "1",
                "transcription": "현재 정부에서 망가진 부분들을 어 제대로 복원하는 것이 굉장히 필요합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.240
            },
            {
                "speaker_id": "1",
                "transcription": "부동산 시장 정상화하는 일들 그리고 탈원전으로 무너진 산업 생태계를 복원하는 일.",
                "sound_type": [
                    2
                ],
                "start": 6.250,
                "end": 14.181
            },
            {
                "speaker_id": "2",
                "transcription": "현 정부 내내 갈등을 빚었던 법무부 장관의 수사 지휘권을 폐지하고 검찰과 경찰도 공수처와 함께 고위 공직자의 부패 범죄를 수사할 수 있도록 하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.191,
                "end": 26.600
            },
            {
                "speaker_id": "2",
                "transcription": "문재인 정부의 소득 주도 성장을 비판하며 정부 대신 민간 중심의 경제 정책도 추진하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.610,
                "end": 33.497
            },
            {
                "speaker_id": "2",
                "transcription": "여성가족부 폐지와 고고도미사일 방어 체계 사드의 추가 배치는 국정 과제에서 빠졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.507,
                "end": 39.506
            }
        ]
    },
    "summary": "인수위는 법무부 장관의 수사 지휘권을 폐지하고 정부 대신 민간 중심의 경제 정책도 추진하겠다고 했다.",
