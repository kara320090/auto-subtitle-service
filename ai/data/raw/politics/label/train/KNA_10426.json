            },
            {
                "speaker_id": "1",
                "transcription": "부동산 법안이 접수부터 처리까지 평균 146일 걸린데 반해 노동과 사회안전 분야는 각각 172일 190일이 걸렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.771,
                "end": 12.771
            },
            {
                "speaker_id": "2",
                "transcription": "언론도 많이 차고 해야 되는데 그럴 일이 많지 않으니까 대중적인 의제로 소비가 굉장히 쉬운 건 아니니까",
                "sound_type": [
                    2,
                    5
