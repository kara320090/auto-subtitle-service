        "term": [
            {
                "speaker_id": "1",
                "transcription": "처리되지 못한 거는 사실입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.982
            },
            {
                "speaker_id": "2",
                "transcription": "핼러윈 전 용산서가 기동대 파견을 요청했는지 여부를 두곤 경찰끼리 진실 공방을 벌이기도 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.992,
                "end": 8.760
            },
            {
                "speaker_id": "3",
                "transcription": "기동대를 파견 요청받은 바가 없다라고 분명히 말씀을 하셨죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.770,
                "end": 13.459
            },
            {
                "speaker_id": "4",
                "transcription": "예 기동대 요청받은 겨기대 외에는 없습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.469,
                "end": 16.716
            },
            {
                "speaker_id": "5",
                "transcription": "경찰기동대 파견 요청한 적 없습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.726,
                "end": 18.877
            },
            {
                "speaker_id": "6",
                "transcription": "부하직원하고 이런 말 하기 참 좀 좀스러운데 전 분명히 지시한 적이 있습니다.",
                "sound_type": [
