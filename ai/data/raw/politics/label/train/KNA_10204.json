        "term": [
            {
                "speaker_id": "1",
                "transcription": "이어선 경찰 지구대를 방문했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.206
            },
            {
                "speaker_id": "2",
                "transcription": "예 저희가 일이 엄청 많았는거 제가 알고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 2.216,
                "end": 6.886
            },
            {
                "speaker_id": "2",
                "transcription": "아이 서로 고생이 많습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.896,
                "end": 8.955
            },
            {
                "speaker_id": "1",
                "transcription": "행안부 경찰부 설치에 반발하는 경찰 내부를 다독이는 행보로 풀이됩니다.",
                "sound_type": [
                    2
                ],
                "start": 8.965,
                "end": 14.349
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 문자 노출 논란에 대해서는 오늘도 말이 없었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.359,
                "end": 17.929
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘 권성동 대표 직무 대행과 문자를 주고받은 윤 대통령 입에 이목이 집중됐지만 직접 입장을 밝히지 않고 있는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 17.939,
                "end": 25.682
            },
            {
                "speaker_id": "1",
                "transcription": "사흘 연속 외부 일정이 이어지면서 출근길 문답도 이루어지지 않고 있습니다.",
