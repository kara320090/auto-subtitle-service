        "term": [
            {
                "speaker_id": "1",
                "transcription": "소득 내역을 살펴보니 2017년 12월부터 최근까지 김앤장 법률 사무소에서 고문으로 일하며 총 20억 원가량을 받았는데 월 평균 3800만 원에 해당합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.919
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 한 후보자의 재산 증식 과정에서 문제가 없었는지 돋보기 검증에 나서겠다고 예고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.929,
                "end": 19.107
            },
            {
                "speaker_id": "2",
                "transcription": "지금 어 적격하다 아니다라는 것을 판단하는 것은 이른 시기인 것이고요.",
                "sound_type": [
                    2
                ],
                "start": 19.117,
                "end": 25.100
            },
            {
                "speaker_id": "2",
                "transcription": "그것을 판단할 수 있게끔 하기 위해서라도 아주 철저하게 어 검증을 할 수밖에 없다.",
                "sound_type": [
                    2
                ],
                "start": 25.110,
                "end": 30.832
            },
            {
                "speaker_id": "1",
                "transcription": "다른 국무 위원 후보자와 달리 총리 후보자 인준은 반드시 국회 표결을 거쳐야 해 과반 의석을 차지하는 민주당의 동의가 필수적입니다.",
                "sound_type": [
                    2
                ],
                "start": 30.842,
                "end": 40.407
            }
        ]
    },
    "summary": "민주당은 한 후보자의 재산 증식에 문제가 없었는지 검증에 나서겠다고 예고했으며 총리 후보자 인준은 과반 의석을 차지하는 민주당의 동의가 필수적이라고 말했다.",
