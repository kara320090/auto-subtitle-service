                "end": 9.602
            },
            {
                "speaker_id": "2",
                "transcription": "공영방송을 아예 없애는 게 아닌 한 그 부족한 재원을 국가가 마련해야 하는데 어떻게 마련할 겁니까.",
                "sound_type": [
                    2
                ],
                "start": 9.612,
                "end": 16.481
            },
            {
                "speaker_id": "2",
                "transcription": "대안이 있습니까.",
