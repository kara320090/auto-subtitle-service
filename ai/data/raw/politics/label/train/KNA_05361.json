        "term": [
            {
                "speaker_id": "1",
                "transcription": "곧이어 공공 근로자들이 떨어진 열매를 쓸어 마대 자루에 담습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.461
            },
            {
                "speaker_id": "1",
                "transcription": "은행 열매가 익어 떨어지기 전에 자치단체가 서둘러 채취에 나선겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.471,
                "end": 10.678
            },
            {
                "speaker_id": "2",
                "transcription": "옛날에는 많이 떨어졌는데 다 밟고 다녀요.",
                "sound_type": [
                    2
                ],
                "start": 10.688,
                "end": 13.543
            },
            {
                "speaker_id": "2",
                "transcription": "그러면 냄새가 엄청 많이 나지.",
                "sound_type": [
                    2
                ],
                "start": 13.553,
                "end": 15.459
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 지금은 털어가니까 많이 안 나고 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 15.469,
                "end": 19.239
            },
            {
                "speaker_id": "1",
                "transcription": "3년 전부터 대구에 도입된 진동 수확기.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.249,
                "end": 23.218
            },
            {
                "speaker_id": "1",
                "transcription": "덕분에 몇 달씩 걸리던 은행 열매 처리 작업이 단 일주일로 줄었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.228,
                "end": 28.361
            }
        ]
    },
    "summary": "진동 수확기 덕분에 몇 달씩 걸리던 은행 열매 처리 작업이 단 일주일로 줄었다.",
