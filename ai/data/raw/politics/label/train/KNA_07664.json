        "term": [
            {
                "speaker_id": "1",
                "transcription": "안규백 의원은 최근 성인 80퍼센트 가량이 안락사에 찬성한다고 응답할 정도로 존엄한 죽음에 대한 관심이 커져 삶에 대한 자기 결정권을 위해 법안을 발의했다고 설명했습니다.",
                "sound_type": [
