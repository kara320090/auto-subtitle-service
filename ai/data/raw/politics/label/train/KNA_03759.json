                ],
                "start": 0.000,
                "end": 6.625
            },
            {
                "speaker_id": "1",
                "transcription": "이후 김 전 차관에 대한 2013년과 2014년 검찰 수사가 봐주기 수사였다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.635,
                "end": 13.766
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 검찰의 권한남용을 막기 위해 공수처 설치가 필요하다고도 했습니다.",
                "sound_type": [
                    2,
                    5
