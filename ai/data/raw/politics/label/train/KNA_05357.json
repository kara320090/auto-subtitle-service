        "term": [
            {
                "speaker_id": "1",
                "transcription": "당시 피부양자는 연소득 3400만원 이하인 경우에만 등록이 가능했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.940
            },
            {
                "speaker_id": "1",
                "transcription": "조 후보자가 EBRD로부터 받은 연봉은 은행 설립 협정에 따라 회원국 간 소득세가 면제되는데 이 조항을 이용해 건보료 면제 혜택을 본 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 4.950,
                "end": 15.200
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 건보 정책을 총괄할 복지부 장관 후보자로서 실소득이 억 대라면 피부양자 자격 상실 신고를 해 지역 가입자로 전환했어야 하는 것 아니냐는 지적이 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 15.210,
                "end": 26.383
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 신뢰와 공감대를 바탕으로 건강보험 그리고 연금 개혁 같은 사회 개혁을 추진해야 하는 적임자로서는 적절하지 않습니다.",
                "sound_type": [
