        "term": [
            {
                "speaker_id": "1",
                "transcription": "좀 더 세밀하게 이제 살펴봐야 된다 싶고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.187
            },
            {
                "speaker_id": "2",
                "transcription": "윤 당선인이 업무 보고에 참석한 건 처음입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.197,
                "end": 7.604
            },
            {
                "speaker_id": "2",
                "transcription": "인수위는 주택 공급 계획을 서둘러 구체화하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.614,
                "end": 11.705
            },
            {
                "speaker_id": "2",
                "transcription": "당선인의 확고한 입장으로 폐지 수순에 들어간 여성가족부 업무 보고는 다른 부처보다 훨씬 짧은 단 46분 만에 끝났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.715,
                "end": 20.984
            },
            {
                "speaker_id": "2",
                "transcription": "인수위는 여가부 업무를 다른 부처로 분산시키거나 대체할 다른 정부 조직을 만드는 방안 등을 놓고 검토에 들어갔습니다.",
                "sound_type": [
