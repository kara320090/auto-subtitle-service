        "term": [
            {
                "speaker_id": "1",
                "transcription": "책임 정치라고 내세웠지만 국회의원 1자리보다는 대선의 1표가 아쉬운 상황에 공천 자체가 미칠 악영향을 우려한 판단으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.083
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 지난해 서울 부산 시장 보궐 선거에 무리수를 둬가며 공천했다가 역풍을 맞았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.093,
                "end": 15.864
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 국민의 힘을 향해선 윤희숙 곽상도 전 의원이 사퇴한 서초와 대구 공천을 포기하라고 압박했고 국민의 힘은 대구 중남구에만 무공천을 결정했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.874,
                "end": 27.643
            },
            {
                "speaker_id": "2",
                "transcription": "공당으로서 무한한 책임감을 느끼며 책임 정치 실현의 차원에서 내려진 결정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.653,
                "end": 35.668
            }
        ]
    },
