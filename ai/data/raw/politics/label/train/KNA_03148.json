        "term": [
            {
                "speaker_id": "1",
                "transcription": "이를 위해 처장과 차장 여야 추천 위원 두 명씩 등 모두 일곱 명으로 인사위를 구성해야 하는데 공수 처장 때처럼 정당 추천이 늦어질 수도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.273
            },
            {
                "speaker_id": "2",
                "transcription": "야당 두 명이 배정돼 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.283,
                "end": 12.471
            },
            {
                "speaker_id": "2",
                "transcription": "야당 추천이 늦어질 경우 다섯 명으로 인사 위원회 강행하실 겁니까?",
                "sound_type": [
                    2
                ],
                "start": 12.481,
                "end": 16.283
            },
            {
                "speaker_id": "3",
                "transcription": "협조를 해 주실 거라고 생각하고요.",
                "sound_type": [
                    2
                ],
                "start": 16.293,
                "end": 17.969
            },
            {
                "speaker_id": "2",
                "transcription": "아니",
                "sound_type": [
                    2
                ],
                "start": 17.979,
                "end": 18.266
            },
            {
                "speaker_id": "3",
                "transcription": "그렇다면 저희가 강화 강행할 그럴 이유도 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.276,
                "end": 22.074
            },
            {
                "speaker_id": "1",
                "transcription": "중복되는 사건의 경우 공수처가 이첩권을 갖고 있기 때문에 1호 사건이 무엇이 되느냐가 벌써부터 관심입니다.",
                "sound_type": [
                    2
                ],
                "start": 22.084,
                "end": 30.385
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 이종근입니다.",
                "sound_type": [
