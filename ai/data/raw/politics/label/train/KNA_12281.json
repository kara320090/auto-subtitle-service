                    2,
                    4
                ],
                "start": 10.319,
                "end": 14.888
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 민주당 공동 선대위원장을 수락한 이낙연 총리는 대신 사과했습니다.",
