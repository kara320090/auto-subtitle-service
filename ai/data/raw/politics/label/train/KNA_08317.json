        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "사과도 나한테 하고.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.020
            },
            {
                "speaker_id": "2",
                "transcription": "지난 30년간 일본과 싸워온 @이름1 할머니는 직접 쓴 편지를 준비했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.030,
                "end": 8.388
            },
            {
                "speaker_id": "3",
                "transcription": "@이름2 장관님께 광주 사는 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.398,
                "end": 15.613
            },
            {
                "speaker_id": "2",
                "transcription": "사죄받기 전에는 죽어도 죽지 못하겠다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.623,
                "end": 19.048
            },
            {
                "speaker_id": "2",
                "transcription": "대법원에서 승소했다고 기뻐했는데 우리 정부는 말 한마디 못 하고 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.058,
                "end": 24.475
            },
            {
                "speaker_id": "2",
                "transcription": "양할머니의 편지를 읽은 박 장관은 강제 동원 문제를 해결하기 위해 노력하겠다고 약속했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.485,
                "end": 31.500
            },
            {
                "speaker_id": "4",
                "transcription": "과거 역사 이걸 즉시하고 올바른 역사관에 입각해서 이 문제를 풀어서 앞으로 미래 지향적으로 가자 이런 이야기를 하려고 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.510,
                "end": 41.932
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 박 장관은 한일 간 외교적 노력을 계속하고 있다는 의견서를 대법원에 제출한 것에 대해선 법령에 따른 것이라며 철회할 의사가 없다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.942,
                "end": 53.239
            },
            {
                "speaker_id": "2",
                "transcription": "이어 법원 결정에 영향을 주려거나 관여하려는 것이 아니라고 덧붙였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.249,
                "end": 58.754
            },
            {
                "speaker_id": "2",
                "transcription": "피해자 지원 시민단체는 오늘 장관의 방문에 대해 한마디 사과도 없이 피해자들과 만났다며 매우 유감이라 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 58.764,
                "end": 67.658
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름3입니다.",
                "sound_type": [
                    2
                ],
                "start": 67.668,
                "end": 70.136
            }
        ]
    },
    "summary": "장관은 피해자를 만나 올바른 역사관에 입각하여 문제를 풀겠다고 하였으나 대법원에 제출한 의견서는 철회할 의사가 없다고 밝혔다.",
