        "term": [
            {
                "speaker_id": "1",
                "transcription": "만재 배수량이 11만 톤인 미국의 핵추 항공모함 로널드 레이건함입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.419
            },
            {
                "speaker_id": "1",
                "transcription": "F18 등 항공기 80여 대를 탑재하고 승조원이 5000명이나 돼 웬만한 국가의 전체 공군력과 버금가는 전력을 자랑합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.429,
                "end": 13.804
            },
            {
                "speaker_id": "1",
                "transcription": "이 로널드 레이건함이 이지스 구축함 순양함과 함께 항모강습단을 구성해 오는 23일 부산 작전 기지에 들어옵니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.814,
                "end": 23.084
            },
            {
                "speaker_id": "1",
                "transcription": "북한이 6차 핵실험을 감행한 직후인 2017년 10월 이후 5년만에 입항입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.094,
                "end": 28.906
            },
            {
                "speaker_id": "1",
                "transcription": "지난 5월 한미 정상회담과 7월 국방장관 회담에서 미국 전략 재산을 시기적절하고 조율된 방식으로 전기한다고 합의한 데 따른 조치입니다.",
                "sound_type": [
