        "term": [
            {
                "speaker_id": "1",
                "transcription": "당시 국방부 훈령은 휴가 중 관용차 사적 사용을 금지했지만 출발과 복귀 시엔 사용할 수 있다는 단서를 달았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.906
            },
            {
                "speaker_id": "1",
                "transcription": "이 훈령을 적용하면 사적 사용 의혹 기간은 닷새로 줄지만 훈령의 취지는 비상 상황에 대비한 예외를 둔 것일 뿐이라는 지적이 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 7.916,
                "end": 17.599
            },
            {
                "speaker_id": "2",
                "transcription": "굉장히 제한된 상황에서 그러니까 불가피하게 사용되는 것이잖아요.",
                "sound_type": [
                    2
                ],
                "start": 17.609,
                "end": 23.270
            },
            {
                "speaker_id": "2",
                "transcription": "근데 그게 마치 자신들이 누릴 수 있는 권리인 것마냥 그렇게 사용해서는 안 되는 거죠.",
                "sound_type": [
