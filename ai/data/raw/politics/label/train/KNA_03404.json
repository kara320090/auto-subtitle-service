        "term": [
            {
                "speaker_id": "1",
                "transcription": "전기료도 절반까지 깎아줘 자영업자 현금 지원이 3차 때보다 최대 4배 정도 늘 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.727
            },
            {
                "speaker_id": "2",
                "transcription": "1인 1 사업장만 된다 해가지고 너무 억울하다 해야 될까?",
                "sound_type": [
                    2
                ],
                "start": 6.737,
                "end": 11.469
            },
            {
                "speaker_id": "2",
                "transcription": "그나마 뭐 부담이 줄어드니까 안 받는 것보다 훨씬 낫죠.",
                "sound_type": [
                    2
                ],
                "start": 11.479,
                "end": 16.284
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 지원을 못 받았던 사람들도 이번엔 대거 포함됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.294,
                "end": 20.742
            },
            {
                "speaker_id": "1",
                "transcription": "소득 파악이 어려워 빠졌던 노점상 같은 생계 곤란 계층에도 50만 원씩 지급되고 부모 실직이나 폐업으로 어려운 대학생에게는 장학금 250만 원을 줍니다.",
                "sound_type": [
                    2
                ],
                "start": 20.752,
                "end": 32.232
            }
        ]
    },
    "summary": "그동안 지원을 못 받았던 사람들도 이번엔 대거 포함됐고 전기료도 절반까지 깎아줘 자영업자 현금 지원이 3차 때보다 최대 4배 정도 늘 것으로 보입니다.",
