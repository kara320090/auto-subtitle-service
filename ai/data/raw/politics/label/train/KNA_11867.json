        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당은 투명한 공천이 선거 승리의 지름길이라고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.117
            },
            {
                "speaker_id": "2",
                "transcription": "모든 예비 후보가 이의를 제기할 수 없는 공천을 하도록 그렇게 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.127,
                "end": 9.995
            },
            {
                "speaker_id": "1",
                "transcription": "전략 공천 지역 15곳도 일찌감치 확정 지었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.005,
                "end": 14.157
            },
            {
                "speaker_id": "1",
                "transcription": "현역 위원이 불출마하는 13곳과 지역 위원장 공석인 2곳이 대상입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.167,
                "end": 19.421
            },
            {
                "speaker_id": "1",
                "transcription": "필요하다면 경선도 할 방침인데 구체적인 지역은 더 논의하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.431,
                "end": 24.674
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 모레 열 번째 영입 인사를 발표하고 다음 주부터 후보자 공고를 내는 등 본격적인 심사에 착수합니다.",
                "sound_type": [
                    2,
