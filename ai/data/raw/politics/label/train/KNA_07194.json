        "term": [
            {
                "speaker_id": "1",
                "transcription": "서울 송파구 의원 26명이 최근 4년간 발의한 조례안은 64건 구의원 1명이 한 해에 조례 1건도 발의를 안 한 셈입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.073
            },
            {
                "speaker_id": "1",
                "transcription": "경실련이 2018년 당선된 기초의원 입법 실적을 조사한 결과 4분의 1이 1년에 1건의 조례안도 발의하지 않았고 임기 내에 1건도 발의하지 않은 의원도 184명이나 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.083,
                "end": 23.780
            },
            {
                "speaker_id": "1",
                "transcription": "전국적으로 보면 경북 영천시와 경주시 경남 진주시 전남 보성군 서울 송파구와 용산구 의회 등의 입법 실적이 저조했습니다.",
                "sound_type": [
                    2
                ],
