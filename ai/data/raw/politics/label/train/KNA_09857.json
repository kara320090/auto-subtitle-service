        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다른 사람이 낙찰을 받으면 문제는 더 커집니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.932
            },
            {
                "speaker_id": "1",
                "transcription": "전세 보증금으로 빌린 금융 기관 빚을 모두 갚아야 하기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.942,
                "end": 7.206
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 보증 기관이 대출을 먼저 갚도록 만든 뒤 피해자들이 이를 나눠 갚도록 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.216,
                "end": 13.128
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 이자 부담을 덜 금융 상품도 내놨지만 적용 시점은 다음 달부터입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.138,
                "end": 18.510
            },
            {
                "speaker_id": "1",
                "transcription": "그 전에 경매 절차가 끝난다면 이런 지원을 받을 수 없다는 뜻입니다.",
                "sound_type": [
                    2
                ],
                "start": 18.520,
                "end": 23.397
            },
            {
                "speaker_id": "1",
                "transcription": "더구나 근린 생활 시설로 분류된 원룸의 전세 사기 피해자들은 지원 대상에서 아예 빠져 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.407,
                "end": 29.796
            }
        ]
    },
    "summary": "근린 생활 시설로 분류된 원룸의 전세 사기 피해자들은 지원 대상에서 아예 빠져 있다.",
