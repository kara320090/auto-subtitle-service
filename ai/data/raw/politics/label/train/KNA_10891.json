            },
            {
                "speaker_id": "1",
                "transcription": "책임을 두고 내 탓 공방을 벌였습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.113,
                "end": 9.420
            },
            {
                "speaker_id": "2",
                "transcription": "국회법엔은 1일이 공휴일인 경우에는 다음날부터 하게 돼 있습니다마는 소집을 해놓고 자신들도 헛되게 보냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.430,
                "end": 19.474
            },
            {
                "speaker_id": "3",
                "transcription": "임시회의 의사 일정은 아직 정해지지 않아서 공백 상태입니다.",
                "sound_type": [
                    2
                ],
