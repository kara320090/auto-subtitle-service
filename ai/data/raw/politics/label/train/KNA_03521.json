        "term": [
            {
                "speaker_id": "1",
                "transcription": "기권한 의원들은 취재진을 피하기 급급합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.511
            },
            {
                "speaker_id": "2",
                "transcription": "기권하신 이유가 뭡니까 의원님?",
                "sound_type": [
                    2
                ],
                "start": 3.521,
                "end": 6.082
            },
            {
                "speaker_id": "2",
                "transcription": "반대표 던진 거보다 더 비겁하단 생각 안 하셨어요?",
                "sound_type": [
                    2
                ],
                "start": 6.092,
                "end": 9.454
            },
            {
                "speaker_id": "2",
                "transcription": "의원님이 잘못 없다고 생각하신 거예요?",
                "sound_type": [
                    2
                ],
                "start": 9.464,
                "end": 12.453
            },
            {
                "speaker_id": "1",
                "transcription": "정읍지역 시민단체는 시의회가 해당 의원에게 면죄부를 줬다며 회의에 참석하지 않았거나 기권한 의원들을 내년 지방선거에서 심판하겠다고 강조했습니다.",
                "sound_type": [
                    2,
