        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난 6일 개통한 새 복지 정보 시스템에서 오류가 발생해 인적 정보 등이 제대로 입력되지 않았기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.772
            },
            {
                "speaker_id": "2",
                "transcription": "원래 20일 날 지급이 정상인데 그게 안 되서 시스템 상에 추가 반영이 되서 27일 경에 지급되는 걸로",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.782,
                "end": 14.492
            },
            {
                "speaker_id": "1",
                "transcription": "이 시스템을 통한 복지 급여 수급자는 1300만 명이 넘습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.502,
                "end": 19.077
            },
            {
                "speaker_id": "1",
                "transcription": "매달 20일엔 생계 급여 등 30종이 25일엔 기초 연금과 아동 수당 등 7종이 지급됩니다.",
                "sound_type": [
                    2
                ],
                "start": 19.087,
                "end": 26.496
            },
            {
                "speaker_id": "1",
                "transcription": "이 달 25일은 휴일이라 오늘 지급되야 할 급여가 지난 20일 지급 때와 같이 시스템 오류로 곳곳에서 지급되지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.506,
                "end": 34.833
            },
            {
                "speaker_id": "3",
                "transcription": "조사 정보를 다시 하긴 할 건데 원래 지급 되셔야 될 분들이 안 되시는 분들이 계시긴 하세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.843,
                "end": 41.474
            }
        ]
    },
