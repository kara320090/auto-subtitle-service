        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난달 @이름1 행정 안전부 장관은 경찰 치안 전방 승진자 6명을 면담합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.706
            },
            {
                "speaker_id": "1",
                "transcription": "이례적인 이 움직임은 사실상의 경찰청장 후보 면접으로 해석되고 행안부 장관도 굳이 선을 긋지 않았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.716,
                "end": 13.914
            },
            {
                "speaker_id": "2",
                "transcription": "추가적으로 봐야 되겠죠. 왜냐하면 이제 자질도 달라야 되고 어 대상도 좀 달 다르기 때문에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.924,
                "end": 21.373
            },
            {
                "speaker_id": "1",
                "transcription": "정부가 경찰 조직을 통제 감시하는 방안도 논의됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.383,
                "end": 25.986
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 장관 지시로 구성된 행안부 내 경찰 제도 개선 자문 위원회에서 입니다.",
                "sound_type": [
                    2
                ],
                "start": 25.996,
                "end": 31.285
            },
            {
                "speaker_id": "1",
                "transcription": "핵심은 장관의 경찰 고위 인사권",
                "sound_type": [
                    2
                ],
                "start": 31.295,
                "end": 34.300
            }
        ]
