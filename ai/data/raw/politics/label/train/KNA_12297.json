        "term": [
            {
                "speaker_id": "1",
                "transcription": "기소된 당사자들의 반발도 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.679
            },
            {
                "speaker_id": "1",
                "transcription": "황운하 전 울산경찰청장은 출석 의사를 밝혀왔지만 기소됐다며 터무니 없는 결정 헌법상 기본권조차 무시하는 발상이라고 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.689,
                "end": 12.802
            },
            {
                "speaker_id": "1",
                "transcription": "송병기 전 울산부시장 측 변호인은 시장 비위를 제보한 사실 청와대 행정관을 만나 공공 병원에 대한 상식적인 이야기를 나눈 사실 등만으로 범죄가 성립할 수는 없다며 법정에서 이를 다툴 것이라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.812,
                "end": 27.715
            },
            {
                "speaker_id": "1",
                "transcription": "반면 청와대는 오늘 기소와 관련해 별도의 입장을 내지 않았습니다.",
                "sound_type": [
                    2
                ],
