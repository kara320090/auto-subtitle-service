        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 저녁 7시부터 시작한 윤리위가 지금까지 이어지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.662
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 윤리위에는 위원 아홉 명 중 여덟 명이 참석했는데요.",
                "sound_type": [
                    2
                ],
                "start": 3.672,
                "end": 7.122
            },
            {
                "speaker_id": "1",
                "transcription": "당사자인 이준석 대표는 현재까진 출석하지 않는 걸로 되어있습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.132,
                "end": 10.816
            },
            {
                "speaker_id": "1",
                "transcription": "직접 들어보시죠.",
                "sound_type": [
                    2
                ],
                "start": 10.826,
                "end": 12.876
            },
            {
                "speaker_id": "2",
                "transcription": "윤리위 출석 거절 당하셨다는데 그게 맞나요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.886,
                "end": 18.065
            },
            {
                "speaker_id": "3",
                "transcription": "저는 뭐 출석 의사를 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.075,
                "end": 20.062
            },
            {
                "speaker_id": "3",
                "transcription": "그리고 오늘 그 현장에 있을 겁니다 저는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.072,
                "end": 22.795
            },
            {
                "speaker_id": "3",
                "transcription": "제 방에서 있을 겁니다 계속",
                "sound_type": [
                    2,
                    5
                ],
