        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당은 자정이 지난 시각 전체 회의를 속개해 오늘 새벽 0시 11분쯤 검찰청법 개정안과 형사 소송법 개정안을 민주당 단독 기립 표결로 통과시켰습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 12.473
            },
            {
                "speaker_id": "1",
                "transcription": "상정에서 의결까지 채 10분도 걸리지 않았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.483,
                "end": 15.699
            },
            {
                "speaker_id": "2",
                "transcription": "뭐하죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.709,
                "end": 17.599
            },
            {
                "speaker_id": "2",
                "transcription": "11분이 찬성하셨으므로 통과했음을 선포합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.609,
                "end": 22.897
            },
            {
                "speaker_id": "1",
                "transcription": "법사위 통과로 검찰 직접 수사권은 부패와 경제 범죄만 남게 됐습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.907,
                "end": 30.031
            },
            {
                "speaker_id": "1",
                "transcription": "다만 정의당의 제안을 받아들여 선거 범죄 수사 건은 합의문과는 달리 올해 연말까지 검찰에 남기도록 했습니다.",
                "sound_type": [
