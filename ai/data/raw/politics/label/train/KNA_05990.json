        "term": [
            {
                "speaker_id": "1",
                "transcription": "이른 아침 출근길 인사를 마친 국민의 힘 윤석열 후보가 승객들로 빼곡한 열차에 탔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.728
            },
            {
                "speaker_id": "1",
                "transcription": "시민과 소통을 늘리라는 취지로 이준석 대표가 연습 문제로 표현했던 일정을 받아들인 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.738,
                "end": 12.224
            },
            {
                "speaker_id": "2",
                "transcription": "젊은 세대들이 많이 가는 지역인데 다들 출퇴근하는데 굉장히 힘들겠다 하는 생각을 했었죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.234,
                "end": 18.754
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보의 지옥철 체험은 수도권 광역 교통망 공약 발표로 이어졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.764,
                "end": 24.015
            },
            {
                "speaker_id": "1",
                "transcription": "17조 6000억여 원을 투입해 1기 수도권광역급행철도 노선을 연장하고 2기 광역급행철도 세 개 노선을 추가하는 게 핵심입니다.",
                "sound_type": [
                    2
                ],
                "start": 24.025,
                "end": 32.632
            }
        ]
    },
    "summary": "윤 후보의 지옥철 체험은 수도권 광역 교통망 공약 발표로 이어졌고 1기 수도권광역급행철도 노선을 연장하고 2기 광역급행철도 세 개 노선을 추가하는 게 핵심입니다.",
