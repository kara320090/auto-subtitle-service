        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리나라는 현재 핵폐기물을 원전 부지에 임시로 저장하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.421
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이미 포화 상태.",
                "sound_type": [
                    2
                ],
                "start": 4.431,
                "end": 6.166
            },
            {
                "speaker_id": "1",
                "transcription": "당장 9년 뒤 한빛 원전을 시작으로 더는 폐기물을 묻을 장소가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.176,
                "end": 11.892
            },
            {
                "speaker_id": "1",
                "transcription": "새로운 부지를 찾아 고준위 방폐장을 건립해야 하는데 부지 선정조차 첫 발을 떼지 못하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.902,
                "end": 18.628
            },
            {
                "speaker_id": "1",
                "transcription": "정부 계획대로 순조롭게 진행되더라도 부지 선정에서 중간 저장 시설 영구 처분 시설을 확보하기까지 모두 37년이 걸립니다.",
                "sound_type": [
                    2
                ],
                "start": 18.638,
                "end": 27.794
            }
        ]
    },
    "summary": "우리나라의 핵폐기물 저장은 이미 포화 상태로 새로운 부지를 찾아 고준위 방폐장을 건립해야 하는데 부지 선정조차 첫 발을 떼지 못하고 있다.",
