        "term": [
            {
                "speaker_id": "1",
                "transcription": "시의원은 12명인데 지난 4년 동안 발의된 조례안은 11건입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.891
            },
            {
                "speaker_id": "1",
                "transcription": "1명이 4년간 1건도 채 안 낸 셈입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.901,
                "end": 8.662
            },
            {
                "speaker_id": "1",
                "transcription": "절반 가까운 5명은 조례안을 1건도 발의하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.672,
                "end": 12.921
            },
            {
                "speaker_id": "2",
                "transcription": "정책 보좌관도 있는 것도 아니고 해서 혼자 하기가.",
                "sound_type": [
                    2
                ],
                "start": 12.931,
                "end": 16.847
            },
            {
                "speaker_id": "3",
                "transcription": "이 시골에는 실질적으로 조례를 발의하고 그 그런 내용을 갖고 잘 다루지를 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.857,
                "end": 24.360
            },
            {
                "speaker_id": "1",
                "transcription": "대도시라고 해서 상황이 다른 것도 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 24.370,
                "end": 27.127
            }
        ]
    },
    "summary": "시의원 1명이 4년간 1건의 조례도 발의하지 않는 경우가 많았고, 이는 대도시라고 해도 마찬가지였다.",
