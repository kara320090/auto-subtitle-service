        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 김 후보자가 법무부 차관 재직 당시 라임 옵티머스 수사와 관련해 보고를 받았을 텐데 이 퇴직 뒤에 관련 사건을 네 건 수임한 건 문제가 있다는 주장입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.600
            },
            {
                "speaker_id": "1",
                "transcription": "김 후보자는 사기 피의자에 대해선 변론한 적도 관여한 적도 없다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.610,
                "end": 15.506
            },
            {
                "speaker_id": "1",
                "transcription": "변호한 대상이 누구인지는 밝힐 수 없다고 했는데 이 국회에 제출된 자료에는 김 후보자가 펀드를 판매한 NH 투자 증권 대표 등의 변호를 맡은 것으로 나타났습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.516,
                "end": 26.367
            },
            {
                "speaker_id": "1",
                "transcription": "이 로펌에서 많게는 월 2900만 원의 자문료를 받은 일도 지적됐는데요.",
                "sound_type": [
                    2
                ],
                "start": 26.377,
                "end": 31.342
            },
            {
                "speaker_id": "1",
                "transcription": "이 김 후보자는 국민 눈높이에선 적지 않은 금액이어서 무겁게 받아들인다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.352,
                "end": 37.270
            }
        ]
    },
    "summary": "재직 당시 수사한 사건과 관련 사건을 퇴직 뒤에 수임한 것을 지적하자 후보자는 그에 대해 변론한 적 없고 변호한 대상이 누구인지 밝힐 수 없다고 했으며 많은 자문료를 받은 것은 무겁게 받아들인다고 했다.",
