        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 이번 개정안은 폭력이나 파괴로 인한 손해는 손해 배상을 허용하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.251
            },
            {
                "speaker_id": "1",
                "transcription": "다만 합법 파업의 범위를 확대했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.261,
                "end": 8.484
            },
            {
                "speaker_id": "1",
                "transcription": "현재는 근로 조건 향상을 목적으로 한 파업만 합법입니다.",
                "sound_type": [
                    2
                ],
                "start": 8.494,
                "end": 12.810
            },
            {
                "speaker_id": "1",
                "transcription": "정리 해고 반대 파업도 불법입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.820,
                "end": 15.315
            },
            {
                "speaker_id": "1",
                "transcription": "개정안은 사회 경제적 지위 향상으로 범위를 넓혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.325,
                "end": 19.773
            },
            {
                "speaker_id": "1",
                "transcription": "이는 국제 노동 기구 ILO가 우리 정부에 권고해 온 내용이기도 합니다.",
