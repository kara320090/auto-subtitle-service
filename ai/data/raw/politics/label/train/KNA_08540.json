        "term": [
            {
                "speaker_id": "1",
                "transcription": "그로부터 12년 피해자들은 그 사과를 받았을까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.217
            },
            {
                "speaker_id": "1",
                "transcription": "국가가 사과하라고 돼 있는데 사과받으신 적 있으세요?",
                "sound_type": [
                    2
                ],
                "start": 4.227,
                "end": 9.277
            },
            {
                "speaker_id": "2",
                "transcription": "없죠.",
                "sound_type": [
                    2
                ],
                "start": 9.287,
                "end": 10.167
            },
            {
                "speaker_id": "2",
                "transcription": "인정서 하나만 달랑 우편물로 날아오면 그걸로 끝이었어요.",
                "sound_type": [
                    2
                ],
                "start": 10.177,
                "end": 14.942
            },
            {
                "speaker_id": "3",
                "transcription": "사과 서한 같은 이런 건 전혀 없었어요.",
                "sound_type": [
                    2
                ],
                "start": 14.952,
                "end": 16.952
            },
            {
                "speaker_id": "3",
                "transcription": "이 소포 진실화해위원회에서 온 게 이게 다예요.",
                "sound_type": [
                    2
                ],
                "start": 16.962,
                "end": 21.254
            }
        ]
    },
    "summary": "진실화해위원회가 피해자에게 국가가 사과하라고 판결했으나 사과는 제대로 이루어지지 않았다.",
