        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러니까 이제 누군가가 아프면 내가 이걸 어디서 어떻게 지원을 받아야 되는지를 알 수가 없어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.316
            },
            {
                "speaker_id": "1",
                "transcription": "지금도 뭐 가족 돌봄 청년을 위한 사이트가 존재하는 게 아니잖아요.",
                "sound_type": [
                    2
                ],
                "start": 6.326,
                "end": 11.374
            },
            {
                "speaker_id": "2",
                "transcription": "본인이 일하러 나갔을 때 누군가가 내 부모님을 돌봐줄 수 있는 그래서 그러한 그 사회적으로 그러한 시스템이 좀 잘 작동할 수 있었으면 좋겠다 사회에 건강한 한 구성이 될 수 있는 그런 것들을 우리 같이 좀",
                "sound_type": [
                    2
                ],
                "start": 11.384,
                "end": 30.210
            },
            {
                "speaker_id": "3",
                "transcription": "국회 입법 조사처가 추정한 우리나라 가족 돌봄 청년의 수는 30만 명에 이릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.220,
                "end": 35.751
            },
            {
                "speaker_id": "3",
                "transcription": "그들의 문제는 더 이상 개인 사정이 아닌 우리 사회의 문제입니다.",
                "sound_type": [
