                    2
                ],
                "start": 0.000,
                "end": 10.203
            },
            {
                "speaker_id": "1",
                "transcription": "또 올해부터는 24개월 미만 아동의 입원 진료비 본인 부담률을 현재의 5퍼센트에서 0퍼센트로 낮춥니다.",
                "sound_type": [
                    2
