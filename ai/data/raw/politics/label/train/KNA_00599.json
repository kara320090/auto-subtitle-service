                    2
                ],
                "start": 2.794,
                "end": 5.344
            },
            {
                "speaker_id": "2",
                "transcription": "웅장한 엔진 소리와 함께 우리 군 최강의 전투기 F35A 스텔스기가 줄을 맞춰 활주로에 집결했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.354,
                "end": 13.450
            },
            {
                "speaker_id": "2",
                "transcription": "전투기 28대가 활주로에 밀집 대형으로 있다가 이륙 직전 단계까지 지상 활주하는 훈련입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.463,
                "end": 19.690
            },
            {
                "speaker_id": "3",
                "transcription": "14시 35분 부 가디언 알파 출격",
                "sound_type": [
                    2
                ],
                "start": 19.690,
                "end": 24.197
            },
            {
                "speaker_id": "4",
                "transcription": "14시 35분 부 가디언 알파 출격",
                "sound_type": [
                    2
                ],
                "start": 24.207,
                "end": 29.300
            },
            {
                "speaker_id": "2",
                "transcription": "서욱 국방부 장관이 현장 지휘하고 군 대비 태세도 점검했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.300,
                "end": 33.511
            },
            {
                "speaker_id": "5",
                "transcription": "적에게는 공포를 국민에게는 안심과 신뢰를 주는 강력한 억제력을 통해 한반도의 평화 정착의 핵심 역할을 수행하게 될 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 33.521,
                "end": 44.056
            },
            {
