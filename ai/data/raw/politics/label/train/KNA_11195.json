                    2
                ],
                "start": 0.000,
                "end": 9.420
            },
            {
                "speaker_id": "2",
                "transcription": "만남을 거부하면 문에 와서 문을 두드리고 하는 게 사실상 압박 아닌가요.",
                "sound_type": [
