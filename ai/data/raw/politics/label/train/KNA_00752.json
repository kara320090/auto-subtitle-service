        "term": [
            {
                "speaker_id": "1",
                "transcription": "이유민 기자가 보도합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.947
            },
            {
                "speaker_id": "2",
                "transcription": "검찰의 수사 기능을 완전히 없애는 이른바 검수원박 법안에 대응하기 위해 열린 전국 지검장 회의 6시간 반 동안 이어진 회의에서 전국 18개 지검장들은 수사권 폐지 법안에 대해 분명한 반대 입장을모았습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.957,
                "end": 18.994
            },
            {
                "speaker_id": "3",
                "transcription": "검찰의 수사 기능을 전면 폐지하게 되면 사법 정의와 인권 보장을 침몰하는 검찰의 존재의 의의가 사라지게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 19.004,
                "end": 26.414
            },
            {
                "speaker_id": "2",
                "transcription": "지검장들은 구체적 대안 없이 수사권 폐지 법안이 성급히 추진된다면 그로 인한 피해는 국민에게 돌아갈 것이라고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.424,
                "end": 35.485
            },
            {
                "speaker_id": "2",
                "transcription": "또 집단 반발로 비춰 죄송한 부분이 있지만 입법 과정의 절차적인 문제와 내용에 대해 국회와 국민에게 알릴 시점이 됐다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.495,
                "end": 46.212
            }
        ]
    },
