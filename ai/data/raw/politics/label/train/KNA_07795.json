                ],
                "start": 0.000,
                "end": 6.789
            },
            {
                "speaker_id": "1",
                "transcription": "수시로 가레를 뽑아 내야 하고 소독도 해야 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.799,
                "end": 10.480
            },
            {
                "speaker_id": "1",
                "transcription": "돌보는 일이 만만치 않다 보니 활동 지원사 구하기는 쉽지 않습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.490,
                "end": 15.704
            },
            {
                "speaker_id": "2",
                "transcription": "쉬운 분 케어나 이런 어려운 분 케어나 그거는 똑같기 때문에 다 쉬운 일하려고 그러죠.",
                "sound_type": [
