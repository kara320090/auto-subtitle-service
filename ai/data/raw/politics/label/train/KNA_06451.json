        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 벌써 몇 번째 우려먹는 건지 모르겠는데 정말 국민의 삶을 놓고 계속 이러시는 거 이해가 안 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.712
            },
            {
                "speaker_id": "1",
                "transcription": "이거 대통령 선거가 끝나더라도 특검해 가지고 반드시 특검하자는 거 동의해 주시고",
                "sound_type": [
                    2
                ],
                "start": 7.722,
                "end": 12.999
            },
            {
                "speaker_id": "2",
                "transcription": "지금 뭐 대통령 선거가 국민학교 애들 반장 선거입니까?",
                "sound_type": [
                    2
                ],
                "start": 13.009,
                "end": 16.570
            },
            {
                "speaker_id": "2",
                "transcription": "정확하게 수사가 이루어지지 않고 덮었지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 16.580,
                "end": 20.468
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 특검하자니까요.",
                "sound_type": [
                    2
                ],
                "start": 20.478,
                "end": 21.632
            },
            {
                "speaker_id": "3",
                "transcription": "윤 후보는 또 이재명 후보의 조카 살인 사건 변호 문제를 제기했고 이 후보는 윤 후보 부인의 주가 조작 의혹을 문제 삼았습니다.",
