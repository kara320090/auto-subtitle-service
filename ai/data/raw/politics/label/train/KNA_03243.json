        "term": [
            {
                "speaker_id": "1",
                "transcription": "많이 예상이 됐던 형태네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.693
            },
            {
                "speaker_id": "1",
                "transcription": "1명의 그 경쟁 주자로서 열심히 뛸 뿐이다.",
                "sound_type": [
                    2
                ],
                "start": 1.703,
                "end": 5.917
            },
            {
                "speaker_id": "2",
                "transcription": "야권의 단일화 과정이 국민들에게 희망을 주는 단일화 과정이 되었으면 좋겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.927,
                "end": 11.406
            },
            {
                "speaker_id": "2",
                "transcription": "정말 잘 된 일입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.416,
                "end": 13.366
            },
            {
                "speaker_id": "3",
                "transcription": "여권에선 우려와 경계가 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.376,
                "end": 16.795
            },
            {
                "speaker_id": "3",
                "transcription": "박영선 전 장관은 품이 넓은 민주당이 금 전 의원을 보듬어야 한다고 한 반면 우상호 의원은 반문재인 연대에 참여해 대통령을 흔드는 후보를 끌어안을 수는 없다는 입장을 내놨습니다.",
                "sound_type": [
                    2
