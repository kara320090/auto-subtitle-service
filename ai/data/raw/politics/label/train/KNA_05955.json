                ],
                "start": 6.091,
                "end": 14.780
            },
            {
                "speaker_id": "1",
                "transcription": "이념 성향으로 봤을 때 스스로를 중도로 밝힌 층에서는 10퍼센트를 넘기기도 했습니다.",
                "sound_type": [
