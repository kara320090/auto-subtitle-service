        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령은 일단 말을 아꼈습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 3.353
            },
            {
                "speaker_id": "2",
                "transcription": "이준석 대표 징계된 당내 갈등이 좀 심한 상황인데요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.364,
                "end": 7.180
            },
            {
                "speaker_id": "3",
                "transcription": "당무에 대해서는 대통령이 언급할 사안이 아니고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.180,
                "end": 11.526
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 당 내홍은 갈수록 깊어지고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.526,
                "end": 14.836
            },
            {
                "speaker_id": "1",
                "transcription": "이번엔 윤핵관 핵심으로 꼽히는 장제원 의원이 직접 등판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.846,
                "end": 18.985
            }
        ]
    },
    "summary": "이준석 대표와 관계된 당내 내부 갈등에 대해 윤석열 대통령은 일단 말을 아꼈고 당 내홍은 갈수록 깊어지고 있다.",
