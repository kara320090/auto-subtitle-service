        "term": [
            {
                "speaker_id": "1",
                "transcription": "취재진이 기다리고 있는 외무성 정문 앞에 시찰단을 태운 대형 버스가 멈춰섭니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.892
            },
            {
                "speaker_id": "1",
                "transcription": "시찰 일정을 묻기 위해 취재진이 접근했지만 버스는 정차와 이동을 반복하며 취재진을 피합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.902,
                "end": 12.430
            },
            {
                "speaker_id": "1",
                "transcription": "저 버스 맞지 저거? 오케이 오케이.",
                "sound_type": [
                    2
                ],
                "start": 12.440,
                "end": 16.606
            },
            {
                "speaker_id": "1",
                "transcription": "외무성 울타리 바깥을 5분 이상 돌더니 결국 일정을 시작합니다.",
                "sound_type": [
                    2
                ],
                "start": 16.616,
                "end": 21.673
            },
            {
                "speaker_id": "1",
                "transcription": "네 방금 기자들과 한바탕 추격전을 벌인 뒤 후쿠시마 시찰단을 태운 버스가 외무성 안으로 들어갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.683,
                "end": 28.561
            }
        ]
    },
    "summary": "시찰단을 태운 대형 버스가 정차와 이동을 반복하며 취재진을 피했다.",
