        "term": [
            {
                "speaker_id": "1",
                "transcription": "음주 운전을 했던 박 후보자를 감싼 것 아니냐 비판이 제기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.481
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 교사의 음주 운전은 곧바로 해임될 수 있는 중징계 사안이라며 지명 철회와 사과를 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.491,
                "end": 13.355
            },
            {
                "speaker_id": "2",
                "transcription": "음주 운전 같은 중대 범죄도 사람에 따라 다르게 판단하십니까.",
                "sound_type": [
                    2
                ],
                "start": 13.365,
                "end": 17.202
            },
            {
                "speaker_id": "2",
                "transcription": "국민 정서와는 너무도 동떨어진 인식을 어디서부터 바로 잡아야 할지 암담합니다.",
                "sound_type": [
                    2
                ],
                "start": 17.212,
                "end": 23.224
            },
            {
                "speaker_id": "1",
                "transcription": "정의당도 대한민국 법전에 처벌할 수 없는 음주 운전과 도덕적 음주 운전의 정의를 새겨야 할 판이라며 내로남불이라고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.234,
                "end": 33.066
            }
        ]
    },
