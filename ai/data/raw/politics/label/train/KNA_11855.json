        "term": [
            {
                "speaker_id": "1",
                "transcription": "더욱 겸손하고 낮은 자세로 임할 것이며 좋은 후보 좋은 정책으로 준비되고 원동력 있는 정당의 모습을 보여드리겠습니다.",
                "sound_type": [
