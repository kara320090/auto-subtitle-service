        "term": [
            {
                "speaker_id": "1",
                "transcription": "청문회 전 서면답변을 통해 여성가족부 폐지에 동의한다고 밝힌 @이름1 후보자.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.324
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 젠더 갈등과 권력형 성범죄에 대한 여가부의 대처가 부족했다며 폐지 입장을 재확인했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.334,
                "end": 12.535
            },
            {
                "speaker_id": "2",
                "transcription": "젠더 갈등을 풀어나가는 데 실질적인 역할을 할 수 있는 부처로 탈바꿈할 필요가 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.545,
                "end": 19.056
            },
            {
                "speaker_id": "1",
                "transcription": "야당인 민주당은 인사청문회 자체가 모순이라며 장관은 대통령의 하수인이 아니라고 비판했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.066,
                "end": 25.776
            },
            {
                "speaker_id": "3",
                "transcription": "아니 여가부 장관을 하겠다는 사람이 여가부 폐지에 동의한다는 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.786,
                "end": 30.531
            },
            {
                "speaker_id": "4",
                "transcription": "아 성차별 문제가 있다고 하는데 여성가족부를 폐지하자고 이야기하시는 겁니까?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 30.541,
                "end": 35.268
            },
            {
                "speaker_id": "1",
                "transcription": "김 후보자는 여가부 폐지가 여성정책 폐기는 아니라고 강조했고 국민의힘은 여당가족부 폐지라고 거들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.278,
                "end": 43.283
            },
            {
                "speaker_id": "2",
                "transcription": "다양한 방식으로 저희가 그 양성평등도 실현해 갈 수 있다고 생각합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 43.293,
                "end": 48.493
            },
            {
                "speaker_id": "5",
                "transcription": "피해자를 피해호소인이라고 부르고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 48.503,
                "end": 51.084
            }
        ]
    },
    "summary": "여성가족부 장관 후보자 @이름1의 여성가족부 폐지 동의에 대해 많은 여성 의원들이 비판하고 있다.",
