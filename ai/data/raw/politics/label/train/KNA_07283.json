        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회 입성 전까지 벤처기업가였던 @이름1 후보자 상업사들의 비상장주식 23억여 원을 국회의원이 된 이후에도 보유했던 사실이 논란이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.471
            },
            {
                "speaker_id": "2",
                "transcription": "상임위를 바꿔가면서까지 그 주식을 보유할만한 그런 이유가 있었어요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.481,
                "end": 15.118
            },
            {
                "speaker_id": "3",
                "transcription": "코로나로 인해서 상황이 굉장히 안 좋았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.128,
                "end": 18.216
            },
            {
                "speaker_id": "3",
                "transcription": "그래서 당분간 보유하는 것으로 회의를 통해 가지고 진행이 됐고요.",
                "sound_type": [
                    2
                ],
                "start": 18.226,
                "end": 23.451
            },
            {
                "speaker_id": "3",
                "transcription": "매각 내지는 백지 신탁을 진행할 예정입니다.",
                "sound_type": [
