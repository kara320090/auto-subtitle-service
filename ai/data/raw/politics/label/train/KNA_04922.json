        "term": [
            {
                "speaker_id": "1",
                "transcription": "국가 부채가 5년 사이 400조 원 넘게 늘어난 만큼 적자 폭부터 줄여 나가기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.768
            },
            {
                "speaker_id": "1",
                "transcription": "관리 재정 수지를 코로나19가 발생하기 전 수준로 돌려 국내 총 생산 대비 마이너스 3퍼센트 이내로 개선할 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.778,
                "end": 13.778
            },
            {
                "speaker_id": "1",
                "transcription": "이를 통해 현재 50퍼센트 수준인 국가 채무 비율을 5년 뒤 50퍼센트 대 중반 정도로 관리하는 게 목표입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.788,
                "end": 21.519
            },
            {
                "speaker_id": "1",
                "transcription": "지난 5년간 채무 비율이 14 포인트 정도 증가했는데 이 증가폭을 3분의 1 수준으로 줄이겠다는 겁니 다.",
                "sound_type": [
                    2
                ],
                "start": 21.529,
                "end": 29.333
            },
            {
                "speaker_id": "1",
                "transcription": "또 이런 내용이 담긴 재정 준칙을 법으로 제정해 구속력을 확보할 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.343,
                "end": 35.258
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 재정건전성을 높이기 위해 대대적인 사업 구조 조정도 착수했습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.268,
                "end": 40.518
            },
            {
                "speaker_id": "1",
                "transcription": "공무원 정원과 보수도 엄격하게 관리하고 꼭 필요하지 않은 공공 기관 자산과 정부의 미활용 국유 재산도 팔아 재정 부담을 줄일 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 40.528,
                "end": 49.983
            }
        ]
    },
