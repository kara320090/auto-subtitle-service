        "term": [
            {
                "speaker_id": "1",
                "transcription": "구속 영장 심사를 통해 양측이 투명하게 소명하는 기회가 될 것이라고 공수처는 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.729
            },
            {
                "speaker_id": "1",
                "transcription": "손 검사 측은 구속 영장 청구에 대해 입장문을 내고 공수처가 피의자 조사 등 최소 절차도 준수하지 않았다면서 유감을 표명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.739,
                "end": 15.128
            },
            {
                "speaker_id": "1",
                "transcription": "또 공수처가 국민의 힘 대선 경선 일정을 거론하며 정치적 의도로 무리하게 출석을 종용했다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.138,
                "end": 22.894
            },
            {
                "speaker_id": "1",
                "transcription": "손 검사의 구속 여부는 이르면 오늘 중 결정될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 22.904,
                "end": 27.218
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 이정은입니다.",
