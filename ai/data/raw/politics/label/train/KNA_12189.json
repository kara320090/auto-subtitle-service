        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금은 고통의 시작일지 모릅니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.561
            },
            {
                "speaker_id": "1",
                "transcription": "특단의 대책을 실기하지 않고 세워야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.571,
                "end": 8.589
            },
            {
                "speaker_id": "2",
                "transcription": "IMF 때 경험을 되풀이하지 않아야 한다며 직접 방향도 제시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.599,
                "end": 14.043
            },
            {
                "speaker_id": "2",
                "transcription": "가장 주안점을 둘 건 기업들이 고용을 유지하도록 만드는 것이라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.053,
                "end": 19.860
            },
            {
                "speaker_id": "2",
                "transcription": "지난 2월 기업에 주는 고용 유지 지원금 기준을 완화하고 금액도 확대한 상태 이를 포함한 추가 대책을 지시한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 19.870,
                "end": 28.710
            },
            {
                "speaker_id": "1",
                "transcription": "고용 유지에 쓰는 돈은 헛돈이 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 28.720,
                "end": 32.182
            },
            {
                "speaker_id": "1",
                "transcription": "일자리를 잃을 경우 지출해야 할 복지 비용을 감안하면 오히려 비용을 줄이고 미래를 대비하는 생산적 투자입니다.",
                "sound_type": [
