        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "모두 제 불찰이고 부족함의 결과입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.873
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 더 조심하고 더 경계하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.883,
                "end": 10.815
            },
            {
                "speaker_id": "1",
                "transcription": "거듭 죄송합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.825,
                "end": 12.605
            },
            {
                "speaker_id": "2",
                "transcription": "김 씨는 제보자 당사자에게도 사과드린다고 했고 공직자의 배우자로서 공사 구분을 분명히 해야 했는데 많이 부족했다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.615,
                "end": 23.504
            },
            {
                "speaker_id": "2",
                "transcription": "다만 의혹에 대한 사실 관계를 묻는 질문에는 수사와 감사가 진행되고 있다며 구체적인 답을 내놓지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.514,
                "end": 32.313
            },
            {
                "speaker_id": "1",
                "transcription": "실체적인 진실이 밝혀질 때까지 최선을 다해서 협조를 하고 그리고 거기에 따라서 결과가 나오면 본분에 책임이 있다면 책임을 질 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 32.323,
                "end": 46.520
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 사과는 일주일 전 서면 사과 이후에도 의혹 폭로와 논란이 계속되자 국면 전환을 위해 정면돌파를 시도한 것으로 해석됩니다.",
                "sound_type": [
                    2
                ],
                "start": 46.530,
                "end": 57.142
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 선대위 회의를 처음 주재한 이낙연 총괄 선대위원장도 진솔하게 인정하고 겸허하게 사과하는 게 필요하다고 김 씨의 사과를 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 57.152,
                "end": 69.014
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 장시간 치밀한 계획하에 지속돼 온 범죄 행위에 대한 동문서답식 사과라고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 69.024,
                "end": 77.685
            },
            {
                "speaker_id": "2",
                "transcription": "의혹을 제기한 제보자는 입장문을 통해 김 씨가 법인 카드 유용은 어디까지 인정하는지 그 많은 음식은 누가 먹었는지 등 꼭 답해야 하는 질문엔 답하지 않았다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 77.695,
                "end": 91.000
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 강나루입니다.",
                "sound_type": [
                    2
                ],
                "start": 91.010,
                "end": 94.222
            },
            {
                "speaker_id": "3",
                "transcription": "국민의힘 윤석열 후보가 언론 인터뷰에서 집권하면 전 정권에 대한 적폐 청산 수사를 하겠다고 밝히자 민주당이 정치 보복 선언이라며 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 94.232,
                "end": 105.386
            },
            {
                "speaker_id": "3",
                "transcription": "윤석열 후보는 내가 하면 정당한 적폐 처리고 남이 하면 보복이라는 프레임은 맞지 않다고 맞받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 105.396,
                "end": 112.913
            },
            {
                "speaker_id": "3",
                "transcription": "보도에 손서연 기자입니다.",
                "sound_type": [
                    2
                ],
                "start": 112.923,
                "end": 114.647
            }
        ]
    },
    "summary": "김혜경 씨가 국면 전환을 위해 국민에게 사과했고 윤석열 후보는 언론 인터뷰에서 집권하면 적폐 청산 수사를 하겠다고 밝혔다.",
