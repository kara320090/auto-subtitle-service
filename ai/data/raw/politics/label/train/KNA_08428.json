        "term": [
            {
                "speaker_id": "1",
                "transcription": "수재민 1만 명한테 1만 가구에 약 1000만 원 가까이 줄 수 있는 돈 아닙니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.899
            },
            {
                "speaker_id": "2",
                "transcription": "반면 국민의힘 정진석 비대 위원장은 기본 설계도도 안 나왔는데 무조건 X 표만 들고 나온 건 졸속 판단이라 했고 대통령실도 용산 시대에 걸맞은 영빈관 필요성에 많은 국민이 공감할 거라며 국익과 국격을 위해 불가피한 측면이 있다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.909,
                "end": 24.374
            },
            {
                "speaker_id": "3",
                "transcription": "영빈관은 나중에 그 용산 공원이 다 우리한테 반환이 되면 그쪽에다가 하나 그 저 워싱턴에 있는 블레어 하우스 같은 거를 건립하는 방안도 있고요.",
                "sound_type": [
                    2
                ],
                "start": 24.384,
                "end": 35.001
            }
        ]
    },
