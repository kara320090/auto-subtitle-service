        "term": [
            {
                "speaker_id": "1",
                "transcription": "승조원 약 5000명이 탄 미국의 핵 추진 항공 모함 로널드 레이건함이 부산 작전 기지에 들어왔습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 6.699
            },
            {
                "speaker_id": "1",
                "transcription": "순양함과 이지스 구축함 등이 항모 강습단을 구성해 같이 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.709,
                "end": 11.795
            },
            {
                "speaker_id": "1",
                "transcription": "2017년 이후 5년만에 연합 훈련을 위해 한국을 찾았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.805,
                "end": 16.647
            },
            {
                "speaker_id": "2",
                "transcription": "감사합니다. 안녕하세요.",
