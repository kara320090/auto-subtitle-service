        "term": [
            {
                "speaker_id": "1",
                "transcription": "@소속1은 1차 예비 경선을 통과한 8명의 후보가 첫 토론회를 가졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.922
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보에게 질문이 집중됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.932,
                "end": 8.060
            },
            {
                "speaker_id": "2",
                "transcription": "나는 25년 정치해도 이렇게 흠이 많은 후보를 대선 앞두고 본 일이 없어요.",
                "sound_type": [
                    2
                ],
                "start": 8.070,
                "end": 15.161
            },
            {
                "speaker_id": "3",
                "transcription": "제가 법을 지키면서 공격을 당했는데",
                "sound_type": [
                    2
                ],
                "start": 15.171,
                "end": 18.294
            },
            {
                "speaker_id": "2",
                "transcription": "됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.304,
                "end": 18.761
            },
            {
                "speaker_id": "3",
                "transcription": "그거를 자꾸 의혹이라고 막 지금까지 뭐 나온 게 없잖습니까?",
                "sound_type": [
                    2
                ],
                "start": 18.771,
                "end": 22.302
            },
            {
                "speaker_id": "1",
                "transcription": "특히 홍준표 후보는 윤석열 후보가 검찰 수사를 통해 보수를 궤멸시켰다고 비판했고 윤 후보는 보수 궤멸은 검찰 수사 탓이 아니라고 맞받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.312,
                "end": 32.799
            }
        ]
    },
