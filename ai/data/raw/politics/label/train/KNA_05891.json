        "term": [
            {
                "speaker_id": "1",
                "transcription": "북한 무인기가 일곱 시간 동안 서울 상공까지 접근했는데도 국가 안보 회의는 열리지 않았고 대피 문자도 없었다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.140
            },
            {
                "speaker_id": "1",
                "transcription": "삭감된 예산은 사업 추진 과정에 따른 거였다며 여당은 물론 방사청도 동의한 거라고 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.150,
                "end": 15.694
            },
            {
                "speaker_id": "2",
                "transcription": "책임 면피와 남 탓만 하려 하지 말고 본인이 국군 통수권자이고 행정부의 수장임을 명심하길 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 15.704,
                "end": 25.462
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 정부의 국정 철학은 전 정권 탓 국회 탓입니까?",
                "sound_type": [
                    2
                ],
                "start": 25.472,
                "end": 31.729
            },
            {
                "speaker_id": "1",
                "transcription": "국회는 내일 국방위 긴급 회의를 열어 군의 대응 책임을 추궁하기로 했습니다.",
