        "term": [
            {
                "speaker_id": "1",
                "transcription": "7월 임시 국회 소집을 요구한 더불어민주당 작년 합의대로 법사 위원장을 내놨으니 4월 합의대로 사개특위 구성에 협조하라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.527
            },
            {
                "speaker_id": "1",
                "transcription": "본 회의에서 의장을 단독 선출해도 국민이 이해할 거라며 압박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.537,
                "end": 14.575
            },
            {
                "speaker_id": "2",
                "transcription": "민심의 분노에 조금도 아랑곳 않은 오만함 그 자체입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.585,
                "end": 19.016
            },
            {
                "speaker_id": "2",
                "transcription": "한마디로 집권 여당이 최근 보여준 모습은 민생 뺑소니입니다.",
                "sound_type": [
