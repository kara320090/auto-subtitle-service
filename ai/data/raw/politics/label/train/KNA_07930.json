        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 전당 대회 준비위는 본경선에 나갈 후보를 추리는 예비 경선을 당심 70퍼센트 국민 여론 30퍼센트로 실시하기로 어제 의결했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.105
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 한나절 만에 이 결정이 비대위에서 뒤집혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.115,
                "end": 14.394
            },
            {
                "speaker_id": "1",
                "transcription": "비대위가 당심 100퍼센트로만 예비 경선을 치르기로 한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 14.404,
                "end": 18.996
            },
            {
                "speaker_id": "1",
                "transcription": "이에 안규백 전대 준비 위원장이 사퇴 의사를 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.006,
                "end": 23.170
            },
            {
                "speaker_id": "2",
                "transcription": "저희들로서는 이 내용이 관철이 될 걸로 생각했는데 전혀 안 되고 다른 안이 나왔기 때문에 상당히 당황했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.180,
                "end": 31.097
            }
        ]
    },
