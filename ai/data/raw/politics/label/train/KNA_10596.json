        "term": [
            {
                "speaker_id": "1",
                "transcription": "땅 주변으로 길은 있지만 포장된 도로가 아니라 자동차로의 접근은 쉽지 않고 주변엔 개발되지 않은 채 임야 그대로 방치돼 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.544
            },
            {
                "speaker_id": "1",
                "transcription": "인근 부동산에선 시세를 추정하지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.554,
                "end": 13.537
            },
            {
                "speaker_id": "2",
                "transcription": "도로 없죠 돌지하에 도로는 안 싣습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.547,
                "end": 16.556
            },
            {
                "speaker_id": "2",
                "transcription": "그러기 때문에 개발을 할 수가 없는 땅입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.566,
                "end": 19.366
            },
            {
                "speaker_id": "2",
                "transcription": "거래가 안 됩니다 저거는 그리고 살 사람이 없어요.",
                "sound_type": [
                    2
                ],
                "start": 19.376,
                "end": 22.182
            },
            {
                "speaker_id": "1",
                "transcription": "현재 울산시가 도로 개설 계획을 검토 중인데 울산이 지역구인 김 후보가 영향력을 행사하지 않았냐는 게 경쟁 후보들의 주장입니다.",
                "sound_type": [
