        "term": [
            {
                "speaker_id": "1",
                "transcription": "조 씨는 오늘 국민의힘 의원 6명도 명예 훼손 등 혐의로 추가 고소했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.067
            },
            {
                "speaker_id": "1",
                "transcription": "김기현 외 5인의 국회의원들과 어 추가로 이제 윤석열, 김웅은 공직선거법 위반과 어 무고로도 추가로 고소를 할 계획입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.077,
                "end": 14.911
            },
            {
                "speaker_id": "1",
                "transcription": "공수처는 조 씨를 다시 불러 휴대전화 포렌식 작업을 하고, 검찰 수사 자료 등을 분석 한 뒤 이르면 다음 주부터 관계자를 소환하는 등 수사에 속도를 더할 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.921,
                "end": 26.402
            },
            {
                "speaker_id": "1",
                "transcription": "제보에 연루돼 있다며 박지원 국가정보원장을 윤 전 총장 측이 고발한 사건은 오늘 2차 고발인 조사가 진행됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.412,
                "end": 34.778
            },
            {
                "speaker_id": "1",
                "transcription": "윤 전 총장 측은 공수처가 해당 사건을 조속히 입건해 수사해야 한다고 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.788,
