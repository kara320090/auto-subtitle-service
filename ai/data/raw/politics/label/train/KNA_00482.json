        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "청년의 창의와 아이디어가 넘치는 전통시장 어 세계의 관광객들을 불러 모을 수 있는 문화적인 명소로 거듭날 수 있도록 힘쓰겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.802
            },
            {
                "speaker_id": "2",
                "transcription": "네 그런가 하면 안철수 인수위원장도 오늘 첫 기자회견을 가졌던데 어떤 부분을 강조했습니까?",
                "sound_type": [
                    2
                ],
                "start": 8.812,
                "end": 15.052
            },
            {
                "speaker_id": "1",
                "transcription": "네 안철수 위원장은 인수위는 점령군이 아니라며 겸손과 소통 책임의 원칙을 갖고 운영해 나가겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.062,
                "end": 22.479
            },
            {
                "speaker_id": "1",
                "transcription": "안 위원장과 윤 당선인이 공약이 엇갈리는 부분에 대한 기자들의 질문도 있었는데요.",
                "sound_type": [
                    2
                ],
                "start": 22.489,
                "end": 27.259
            },
            {
                "speaker_id": "1",
                "transcription": "안 위원장은 현 문재인 정부가 공약을 거의 다 주요 정책으로 하면서 여러가지 부작용이 나왔다고 말해 이 공약을 정책으로 구체화 하는 과정에서 변화가 있을 수 있음을 시사했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.269,
                "end": 38.486
            },
            {
                "speaker_id": "1",
                "transcription": "안철수 위원장은 발표한 공약 가운데 해법을 찾아보고 가능한 선택지에 대해서 준비한 다음 윤 당선인의 의사에 따라 방향을 잡겠다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.496,
                "end": 47.583
            },
            {
                "speaker_id": "1",
                "transcription": "일각에서 제기되는 자신의 국무총리 임명 가능성에는 아 안 위원장은 지금 한 눈 팔 여유가 없다는 말로 대답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.593,
                "end": 54.373
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 KBS 뉴스 박민철입니다.",
                "sound_type": [
                    2
                ],
                "start": 54.383,
                "end": 56.906
            },
            {
                "speaker_id": "2",
                "transcription": "어 더불어민주당 윤호중 비상대책위원장이 오늘 국회에서 열린 당소속 국회상임위원장 간사단 연석 회의에서",
                "sound_type": [
                    2
                ],
                "start": 56.916,
                "end": 65.932
            }
        ]
    },
    "summary": "안철수 인수위원장이 첫 기자회견을 통해 겸손과 소통 책임의 원칙을 갖고 운영해 나가겠다고 했습니다.",
