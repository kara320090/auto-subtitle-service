        "term": [
            {
                "speaker_id": "1",
                "transcription": "민간 차원에서 이산 가족 교류 사업을 추진하는 남북 이산 가족 협회가 지난 10일 통일부에 방북 신청서를 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.794
            },
            {
                "speaker_id": "1",
                "transcription": "협회는 지난해 3월 북측에 이산 가족 상봉 사업을 추진하자고 제안했는데 북측이 11월에 초청장을 보내왔다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.804,
                "end": 16.842
            },
            {
                "speaker_id": "2",
                "transcription": "작년 11월 일날 받았지만은 분위기가 상당히 안좋은 때 아닙니까. 그래서 제가 분위기를 좀 탐색하면서 보류를 했어요 보류. 더 이상 뭐 그걸 제가 지체할 수가 없고.",
                "sound_type": [
                    2
                ],
                "start": 16.852,
                "end": 28.009
            },
            {
                "speaker_id": "1",
                "transcription": "협회는 초청장을 보낸 곳이 북한 통일 전선부 산하 단체라며 구체적인 기관명은 밝히지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.019,
