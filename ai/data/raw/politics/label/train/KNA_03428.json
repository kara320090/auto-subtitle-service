        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 부총리는 속도를 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.467
            },
            {
                "speaker_id": "1",
                "transcription": "당장 국토부와 LH는 다음 주 내로 조사를 끝내겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.477,
                "end": 7.421
            },
            {
                "speaker_id": "1",
                "transcription": "국민들에게 큰 심려를 끼치고 있는 만큼 최대한 빨리 전수 조사를 마치겠단 취지입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.431,
                "end": 13.683
            },
            {
                "speaker_id": "1",
                "transcription": "또 합동 조사단과는 별개로 국민 권익 위원회를 통해 공직자 투기 행위에 대한 제보와 신고를 받기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.693,
                "end": 21.791
            },
            {
                "speaker_id": "1",
                "transcription": "이 권익위 신고는 지역을 한정하지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.801,
                "end": 24.727
            },
            {
                "speaker_id": "1",
                "transcription": "투기 관련 제보라면 어디에서 발생했는지 가리지 않고 받아서 위반 사실이 확인되면 엄정 조치하겠단 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 24.737,
                "end": 32.363
            },
            {
                "speaker_id": "1",
                "transcription": "관련 대국민 사과도 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.373,
                "end": 34.539
            },
            {
                "speaker_id": "1",
                "transcription": "@이름2 국토부 장관은 주무 부처 장관이자 직전 LH 경영자로서 책임을 통감한다고 사과했고 이에 앞서 LH는 비상 대책 회의 뒤 이번 사안의 엄중함을 깊이 인식하고 있다며 재발이 없어야 한다는 내용의 사과문을 발표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.549,
                "end": 51.127
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 제도 개선도 신속히 추진합니다.",
                "sound_type": [
                    2
                ],
                "start": 51.137,
                "end": 54.054
            }
        ]
    },
