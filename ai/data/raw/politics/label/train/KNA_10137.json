        "term": [
            {
                "speaker_id": "1",
                "transcription": "이름이 오른 기업들은 난색입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.380
            },
            {
                "speaker_id": "2",
                "transcription": "아무래도 좀 후보님 공약이시니까 예 충분히 저기 한 거 대접 못 하게",
                "sound_type": [
                    2
                ],
                "start": 2.390,
                "end": 9.954
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 기업 유치를 공약으로 내건 시도 지사 후보는 21명.",
                "sound_type": [
                    2
                ],
                "start": 9.964,
                "end": 14.453
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 기업 이전에 필요한 인력 확보나 물류망 구축 대책 등을 제시한 후보는 찾기 힘듭니다.",
                "sound_type": [
                    2
                ],
                "start": 14.463,
                "end": 20.730
            },
            {
                "speaker_id": "1",
                "transcription": "선거 때마다 등장하는 단골 공약중엔 의과 대학도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.740,
                "end": 25.103
            },
            {
                "speaker_id": "1",
                "transcription": "이번엔 시도 지사 후보 55명 중 15명이 의대 설립을 약속했습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.113,
                "end": 30.630
            }
        ]
    },
    "summary": "기업 유치를 공약으로 내건 시도 지사 후보는 많지만 기업 이전에 필요한 인력 확보나 물류망 구축 대책 등을 제시한 후보는 찾기 힘들다며 이번 선거에도 의대 설립을 약속하는 후보도 있다고 전했다.",
