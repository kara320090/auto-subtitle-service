                ],
                "start": 1.675,
                "end": 9.218
            },
            {
                "speaker_id": "3",
                "transcription": "지원 정책이 있다는 것을 그런 사실 자체를 모르는 경우도 많다.",
                "sound_type": [
                    2
                ],
                "start": 9.228,
                "end": 14.518
            },
            {
                "speaker_id": "3",
                "transcription": "그래서 찾아가는 지원 서비스 시스템을 잘 구축해 달라.",
                "sound_type": [
                    2
                ],
                "start": 14.528,
                "end": 19.396
            },
            {
                "speaker_id": "3",
                "transcription": "이렇게 당부를 했습니다.",
                "sound_type": [
