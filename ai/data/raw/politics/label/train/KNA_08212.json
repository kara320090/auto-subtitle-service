        "term": [
            {
                "speaker_id": "1",
                "transcription": "비대위 성격과 활동기간 등을 놓고 의견수렴이 진행 중인데 비대위원장으론 5선에 주호영 정우택 등 최다선 의원들과 김황식 전 국무총리가 거론됩니다.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 0.000,
                "end": 11.464
            },
            {
                "speaker_id": "2",
                "transcription": "비대위원장 후보 좀 줄이셨는지 한 말씀만 부탁드릴게요.",
                "sound_type": [
                    1,
                    2,
                    4
