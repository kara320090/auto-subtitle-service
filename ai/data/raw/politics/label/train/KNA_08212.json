                "end": 14.957
            },
            {
                "speaker_id": "3",
                "transcription": "아직 의견을 수렴하고 있는 중이어서",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 14.967,
                "end": 17.115
            },
            {
