        "term": [
            {
                "speaker_id": "1",
                "transcription": "고도 제한에 묶여서 발전이 지체되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.430
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 제가 들어가면 확실하게 해결해 드리겠다고 약속드릴 수 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.439,
                "end": 9.740
            },
            {
                "speaker_id": "2",
                "transcription": "박영선 후보의 지역구였던 구로구를 찾아 주택 공급 실패를 강조하며 박 후보를 겨냥했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.740,
                "end": 16.122
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 대안으로 민간 주도 재개발을 제시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.129,
                "end": 19.703
            },
            {
                "speaker_id": "1",
                "transcription": "재건축 재개발 사업을 그냥",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.713,
                "end": 21.921
