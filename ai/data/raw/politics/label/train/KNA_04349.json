        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 후보는 자신의 피의자 입건 소식에 입건하라고 맞받았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.771
            },
            {
                "speaker_id": "2",
                "transcription": "공수처에서 후보님을 피의자 신분으로 입건했다고 하는데 한 말씀 부탁드립니다.",
                "sound_type": [
                    2
                ],
                "start": 5.781,
                "end": 10.619
            },
            {
                "speaker_id": "3",
                "transcription": "아니 입건하십시오.",
                "sound_type": [
                    2
                ],
                "start": 10.629,
                "end": 12.973
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보는 앞서 김웅 의원식 압수수색 뉴스에는 보여주기식 망신주기식이라고 직접 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.983,
                "end": 20.365
            },
            {
                "speaker_id": "1",
                "transcription": "결국 윤석열 후보를 흠집 내려는 것이다 정치 개입이 노골화되고 있다고 윤 후보 대표는 공수처를 겨냥했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.375,
                "end": 29.157
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 당 차원에서도 공수처 이름을 아예 정권 고위처로 바꾸는 게 어떻겠느냐고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.167,
                "end": 35.501
            },
            {
                "speaker_id": "4",
                "transcription": "공수처를 앞세운 문재인 정권의 만행을 국민들은 똑똑히 지켜보았고 이는 역사에 반드시 기록될 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 35.511,
                "end": 43.743
            }
        ]
    },
    "summary": "윤 후보는 김웅 의원식 압수수색 뉴스에는 보여주기식이라고 말하며 공수처를 겨냥해 정치 개입이 노골화되고 있다고 비판했다.",
