        "term": [
            {
                "speaker_id": "1",
                "transcription": "침수 대책 회의를 주재한 윤석열 대통령 집중 호우로 국민이 많은 피해를 입었고 소중한 생명을 잃었다며 취임 뒤 처음으로 직접 사과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.261
            },
            {
                "speaker_id": "2",
                "transcription": "다시 한번 희생자의 명복을 빌며 어 불편을 겪은 국민들께 정부를 대표해서 에 죄송한 마음입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.271,
                "end": 18.389
            },
            {
                "speaker_id": "1",
                "transcription": "AI 인공지능을 활용한 홍수 예방 시스템을 구축하고 빗물을 임시로 담는 지하 저류조와 빗물을 하천으로 보내는 지하 방수 터널도 적극 추진하라고 지시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.399,
                "end": 30.527
            },
            {
                "speaker_id": "1",
                "transcription": "중대본을 찾아선 국민 안전에 대한 국가의 무한 책임을 강조했습니다.",
                "sound_type": [
                    2
