        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부 방역 정책 책임을 민주당이 져야 한다던 윤석열 후보 정작 질문은 심상정 후보에게 하자 두 후보의 신경전 시작됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.119
            },
            {
                "speaker_id": "2",
                "transcription": "저한테 다 물어 놓고 답은 기회를 안 주고 저기다 물어봐요.",
                "sound_type": [
                    2
                ],
                "start": 9.129,
                "end": 12.472
            },
            {
                "speaker_id": "3",
                "transcription": "보는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 12.482,
                "end": 13.207
            },
            {
                "speaker_id": "3",
                "transcription": "또 얘기해 봐야 또 뭐 본인 얘기만 할 게 뻔해서",
                "sound_type": [
                    2
                ],
                "start": 13.217,
                "end": 17.146
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보가 준비해 온 판넬을 꺼내 화천대유 대주주 김만배 씨의 녹취록을 제시하자 신경전은 더욱 거세졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.156,
                "end": 24.858
            }
        ]
    },
    "summary": "정부 방역 정책 책임을 민주당이 져야 한다던 윤석열 후보 정작 질문은 심상정 후보에게 하자 두 후보의 신경전 시작되었으며 이 후보가 준비해 온 판넬을 꺼내 화천대유 대주주 김만배 씨의 녹취록을 제시하자 신경전은 더욱 거세졌습니다.",
