        "term": [
            {
                "speaker_id": "1",
                "transcription": "9년 전 의혹을 놓고 진실 공방이 이어져 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.267
            },
            {
                "speaker_id": "2",
                "transcription": "2013년 7월 11일 8월 15일 2차례 성 접대를 받은 것이 확인됩니다.",
                "sound_type": [
                    2
                ],
                "start": 3.277,
                "end": 9.265
            },
            {
                "speaker_id": "3",
                "transcription": "전혀 문제가 안 되는 상황이기 때문에 수사 기관에서도 어떻게 할 수 없는 상황인 것이고",
                "sound_type": [
                    2
                ],
                "start": 9.275,
                "end": 13.273
            },
            {
                "speaker_id": "1",
                "transcription": "이 의혹은 지난해 12월 유튜브 채널에서 처음 제기됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.283,
                "end": 17.922
            },
            {
                "speaker_id": "1",
                "transcription": "이준석 전 대표는 허위 주장으로 명예 훼손을 당했다며 해당 채널을 고소했습니다.",
                "sound_type": [
