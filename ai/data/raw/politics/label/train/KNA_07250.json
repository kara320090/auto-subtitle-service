        "term": [
            {
                "speaker_id": "1",
                "transcription": "개발 호재로 받아들이는 분위기도 엿보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.876
            },
            {
                "speaker_id": "2",
                "transcription": "집주인 분들께서 조금 매물을 다시 많이 거둬들이셨어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.886,
                "end": 7.687
            },
            {
                "speaker_id": "2",
                "transcription": "대통령이 용산에 이제 들어온다는 그 기대심리 때문에 아무래도 뭐 주위의 뭐 좀 개발도 더 빨라질 것이고.",
                "sound_type": [
                    2
                ],
                "start": 7.697,
                "end": 16.068
            },
            {
                "speaker_id": "1",
                "transcription": "인근 학교 학부모들은 치안에 대한 기대가 생겼습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.078,
                "end": 20.118
            },
            {
                "speaker_id": "3",
                "transcription": "편의시설 이런게 많이 확충되고 어 또 치안이 좀 더 강화돼서 안전해지지 않을까 싶은 마음에 기대감이 큽니다.",
                "sound_type": [
                    2,
