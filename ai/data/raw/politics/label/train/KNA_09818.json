        "term": [
            {
                "speaker_id": "1",
                "transcription": "김재원 최고위원의 오일팔 관련 실언을 비롯한 잇단 논란에도 국민의힘을 향해 거침없이 발언해 온 사랑제일교회 전광훈 목사",
                "sound_type": [
