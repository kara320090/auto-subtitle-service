        "term": [
            {
                "speaker_id": "1",
                "transcription": "새 정부의 복지 정책 중 가장 눈에 띄는 건 현금성 지원입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.277
            },
            {
                "speaker_id": "1",
                "transcription": "출생율을 높이기 위해 생후 11개월까지 유아에게 부모 급여를 주겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.287,
                "end": 10.790
            },
            {
                "speaker_id": "1",
                "transcription": "올해 30만 원으로 시작해 내년 70만 원 내후년엔 100만 원으로 인상하겠다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 10.800,
                "end": 17.159
            },
            {
                "speaker_id": "1",
                "transcription": "현재 30만 원인 노인 기초 연금은 단계적으로 40만 원까지 인상하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.169,
                "end": 22.871
            },
            {
                "speaker_id": "2",
                "transcription": "아동 노인 장애인 분들에게는 현금 복지를 제공을 해서 더 촘촘하고 두텁게 그 분들을 도와드리는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 22.881,
                "end": 32.065
            }
        ]
    },
    "summary": "새 정부는 아동 노인 장애인에게 현금성 지원을 확장하겠다고 밝혔다.",
