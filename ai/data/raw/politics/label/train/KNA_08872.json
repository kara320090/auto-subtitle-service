        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 특검을 그럼 받아라라고 하는 얘기를 벌써 이미 오래전에 했구요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.885
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 지금 당장이라도 오늘이라도 어 부산 저축은행을 포함해서",
                "sound_type": [
                    2
                ],
                "start": 5.895,
                "end": 11.863
            },
            {
                "speaker_id": "2",
                "transcription": "양 당을 대표하는 후보들이 합의한 듯 보였지만 여야는 특검형식이나 수사범위 등 제대로 된 수사없이 장외설전만 벌였습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.873,
                "end": 21.050
            },
            {
                "speaker_id": "3",
                "transcription": "동의하십니까?",
                "sound_type": [
                    2
                ],
                "start": 21.060,
                "end": 22.413
            },
            {
                "speaker_id": "1",
                "transcription": "응 지금까지 다수당으로써 수사도 다 회피하고",
                "sound_type": [
