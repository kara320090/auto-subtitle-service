        "term": [
            {
                "speaker_id": "1",
                "transcription": "인사 청문회 때 이 모 교수를 한 장관 딸의 이모로 착각해 질문을 던졌던 김남국 의원과는 인사 검증 관련 규칙이 있는지 등을 두고 재차 충돌했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.776
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 전문성이 없어가지고 인사 검증하실 수 있겠어요 내규가 있어야죠.",
                "sound_type": [
                    2
                ],
                "start": 11.786,
                "end": 16.361
            },
            {
                "speaker_id": "3",
                "transcription": "지난 5년간 이래왔는데요.",
                "sound_type": [
                    2
                ],
                "start": 16.371,
                "end": 17.955
            },
            {
                "speaker_id": "2",
                "transcription": "여기가 무슨 동네에 구멍 구멍 가게도 아니고",
                "sound_type": [
                    2
                ],
                "start": 17.965,
                "end": 21.083
            },
            {
                "speaker_id": "3",
                "transcription": "지난 그럼 5년간 구멍가게처럼 해왔다는 말씀이신 거예요.",
                "sound_type": [
                    2
                ],
