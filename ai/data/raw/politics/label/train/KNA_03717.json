        "term": [
            {
                "speaker_id": "1",
                "transcription": "필요한 모든 조치를 다 하겠다면서 정부는 피해 방지를 위한 구체적인 조치를 일본에 강력하게 요구하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
