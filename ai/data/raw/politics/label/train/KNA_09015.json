        "term": [
            {
                "speaker_id": "1",
                "transcription": "정치 장사를 하는 건 잘못된 거라고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.372
            },
            {
                "speaker_id": "2",
                "transcription": "참사 당일 이태원에 마약 단속 형사 50명이 배치됐던 것과 관련한 인터뷰 내용에 반발한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 3.382,
                "end": 9.994
            },
            {
                "speaker_id": "3",
                "transcription": "엉뚱한 데 정신이 팔려 있다 저는 그런 걱정이 들어요.",
                "sound_type": [
                    2
                ],
                "start": 10.004,
                "end": 15.090
            },
            {
                "speaker_id": "3",
                "transcription": "저희 마약과의 전쟁 이런 것도 의도를 순수하게 안 봅니다 그냥.",
                "sound_type": [
                    2
                ],
                "start": 15.100,
                "end": 19.212
            },
            {
                "speaker_id": "2",
                "transcription": "민주당 의원들은 국회 모독이라 반발했고 여당에서도 사과 권고가 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.222,
                "end": 25.158
            }
        ]
    },
    "summary": "참사 당일 이태원에 마약 단속 형사 50명이 배치됐던 것과 관련한 인터뷰 내용에 민주당 의원들은 국회 모독이라 반발했고 여당에서도 사과 권고가 나왔다.",
