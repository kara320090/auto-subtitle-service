                ],
                "start": 0.000,
                "end": 8.479
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 권성동 대표 직무대행과의 이른바 내부 총질 문자 논란 이후 공교롭게도 사흘 연속 출근길 문답이 생략된 겁니다.",
                "sound_type": [
