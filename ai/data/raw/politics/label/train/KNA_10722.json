            },
            {
                "speaker_id": "1",
                "transcription": "그러나 지금은 미국 핵 자산 운용을 한미가 공동으로 계획하고 실행하는 게 현실적으로 가능한 선택지라고 밝혔습니다.",
                "sound_type": [
                    2
