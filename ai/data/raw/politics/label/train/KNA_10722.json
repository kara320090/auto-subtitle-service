                "start": 4.989,
                "end": 13.077
            },
            {
                "speaker_id": "1",
                "transcription": "미국 핵 자산의 한미 협력 강화를 강조한 건데 그럼에도 자체 핵무장 발언에 이목이 쏠렸습니다.",
                "sound_type": [
