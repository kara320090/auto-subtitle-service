        "term": [
            {
                "speaker_id": "1",
                "transcription": "이태원 참사 희생자 49재 즈음에 마련된 시민 분향소를 이상민 행정 안전부 장관이 1달여 만에 처음 찾아 조문했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.080
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 막 열어보지 마시고요. 미리 연락도 안 주시고 지금 뭐하는 거예요?",
                "sound_type": [
                    2
                ],
                "start": 8.090,
                "end": 12.649
            },
            {
                "speaker_id": "3",
                "transcription": "여기 가족은 안 계신가요?",
                "sound_type": [
                    2
                ],
                "start": 12.659,
                "end": 15.229
            },
            {
                "speaker_id": "1",
                "transcription": "이 장관은 유가족을 만나 고개를 숙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.239,
                "end": 18.299
            },
            {
                "speaker_id": "3",
                "transcription": "한결같이 다 예쁘고",
                "sound_type": [
                    2
                ],
                "start": 18.309,
