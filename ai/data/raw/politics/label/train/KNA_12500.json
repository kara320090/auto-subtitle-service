            },
            {
                "speaker_id": "2",
                "transcription": "이 후보자는 다음 단계로 북한과의 인도적 교류와 협력을 지체 없이 할 수 있는 과정을 만들겠다고 강조했습니다.",
                "sound_type": [
                    2,
