        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 대해 한 전임 인권 위원은 인권위는 보다 구조적인 문제를 짚어주고 직접적인 개별 피해 구제는 법원을 통하는 게 바람직하다고 생각한다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.954
            },
            {
                "speaker_id": "1",
                "transcription": "내용도 내용이지만 문제는 강제성입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.964,
                "end": 13.670
            },
            {
                "speaker_id": "1",
                "transcription": "인권위 권고는 말 그대로 권고일 뿐 따르지 않아도 아무런 불이익이 없습니다.",
                "sound_type": [
