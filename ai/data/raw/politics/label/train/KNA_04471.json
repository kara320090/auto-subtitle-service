        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "열렬하게 지지해 준 거에 대해서 감사하고 나머지 그 3차도 최선을 다하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.214
            },
            {
                "speaker_id": "2",
                "transcription": "전국적으로 이공삼공의 압도적인 지지를 받으면서 판이 지금 바뀐 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 7.224,
                "end": 13.617
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열이 판에서 홍준표 판으로 바뀐 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 13.627,
                "end": 16.811
            },
            {
                "speaker_id": "3",
                "transcription": "유승민 원희룡 후보는 민주당 이재명 후보를 상대로 이길 수 있는 후보를 뽑아 달라고 호소했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.821,
                "end": 23.435
            },
            {
                "speaker_id": "3",
                "transcription": "최종 경선에 진출한 4명의 후보는 앞으로 1 대 1 맞수 토론과 권역별 수회 토론회를 포함해 모두 10차례 TV 토론을 거치면서 자질과 능력을 검증받습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.445,
                "end": 33.960
            },
            {
                "speaker_id": "3",
                "transcription": "이후 다음 달 5일 결과가 발표되는 최종 경선에선 당원 투표의 비중이 50퍼센트로 높아집니다.",
                "sound_type": [
                    2
                ],
                "start": 33.970,
                "end": 40.365
            },
            {
                "speaker_id": "3",
                "transcription": "당원 비중이 커진 데다 오늘 발표될 2차 경선에서도 당원들의 투표율이 기존 당내 선거 때보다 높았던 것으로 확인된 만큼 50만여 명에 달하는 당원들을 설득하기 위한 경쟁은 더 치열해질 전망입니다.",
                "sound_type": [
                    2
                ],
                "start": 40.375,
                "end": 52.465
            },
            {
                "speaker_id": "3",
                "transcription": "나머지 50퍼센트를 차지하는 국민 여론 조사에서 민주당 후보에 맞서 대선 경쟁력을 높이기로 한 만큼 조사 문항이 어떻게 구상될 지도 변수가 될 것으로 보입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 52.475,
                "end": 62.530
            },
