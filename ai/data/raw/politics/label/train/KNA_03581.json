                ],
                "start": 0.000,
                "end": 10.185
            },
            {
                "speaker_id": "2",
                "transcription": "이낙연 상임 선대 위원장은 연설이 오 후보 실체를 드러낸다며 한번 봐달라고도 했습니다.",
                "sound_type": [
