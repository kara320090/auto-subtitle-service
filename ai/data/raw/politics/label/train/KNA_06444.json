        "term": [
            {
                "speaker_id": "1",
                "transcription": "공보물이 집으로 왔는데 혹시 받아 보신 분?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.359
            },
            {
                "speaker_id": "2",
                "transcription": "네. 받았어요.",
                "sound_type": [
                    2
                ],
                "start": 2.369,
                "end": 2.909
            },
            {
                "speaker_id": "1",
                "transcription": "네. 받았구나.",
                "sound_type": [
                    2
                ],
                "start": 2.919,
                "end": 4.119
            },
            {
                "speaker_id": "1",
                "transcription": "후보자의 공약을 완벽히 이해했다.",
                "sound_type": [
                    2
                ],
                "start": 4.129,
                "end": 7.231
            },
            {
                "speaker_id": "3",
                "transcription": "공약은 어떤 것이고 투표는 어떻게 해야 하는지 교육을 받고 있는 발달 장애인들 한자어 투성이의 공보물은 발달 장애를 가진 유권자들에게 일단 쉽지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.241,
                "end": 22.220
            },
            {
                "speaker_id": "4",
                "transcription": "한자가 이렇게 막 어려운 공약들이 있고 어떻게 해야 될지 몰라 가지고 그냥 읽기만 하고 포기한 적 있었어요.",
                "sound_type": [
