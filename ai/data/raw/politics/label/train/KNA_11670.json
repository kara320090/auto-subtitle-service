        "term": [
            {
                "speaker_id": "1",
                "transcription": "관계 부처와 여당도 현장의 목소리를",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.998
            },
            {
                "speaker_id": "2",
                "transcription": "윤 대통령은 곧바로 양곡법 개정안 재의 요구를 재가해 거부권을 행사할 걸로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.008,
                "end": 10.132
            },
            {
                "speaker_id": "2",
                "transcription": "지난 2016년 이후 7년 만의 대통령 거부권 행사이자 헌정 사상 67번째 거부권입니다.",
                "sound_type": [
                    2
                ],
                "start": 10.142,
                "end": 17.729
            },
            {
                "speaker_id": "2",
                "transcription": "거부권이 행사된 양곡법 개정안은 국회가 재적 의원 과반수 출석과 출석 의원 3분의 2 이상 찬성으로 재의결할 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.739,
                "end": 26.713
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 여당이 법안에 반대해 재의결은 어려운 만큼 이번 법안은 폐기할 걸로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 26.723,
                "end": 33.269
            },
            {
                "speaker_id": "2",
                "transcription": "양곡법 처리를 주도했던 민주당은 비슷한 내용의 법을 다시 추진할 걸로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.279,
                "end": 38.902
            },
