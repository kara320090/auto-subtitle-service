        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "일국의 대통령이 오는데 팻말이 뭐예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.360
            },
            {
                "speaker_id": "1",
                "transcription": "사과하세요 사과.",
                "sound_type": [
                    2
                ],
                "start": 2.371,
                "end": 4.786
            },
            {
                "speaker_id": "2",
                "transcription": "연설이 끝난 뒤엔 줄을 서서 윤 대통령과 악수를 나눴습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.786,
                "end": 9.246
            },
            {
                "speaker_id": "2",
                "transcription": "특히 2선으로 물러나겠다고 했던 장제원 의원은 윤 대통령과 귓속말을 나누기도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.256,
                "end": 15.679
            },
            {
                "speaker_id": "2",
                "transcription": "시정연설 전 환담에선 정의당 이은주 비대위원장이 그동안 사과를 요구해 온 윤 대통령 비속어 논란과 관련해 다시 사과를 요구했는데 윤 대통령은 사과할 일은 하지 않았다고 말했다고 주호영 원내대표가 전했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.689,
                "end": 31.202
            },
            {
                "speaker_id": "2",
                "transcription": "한편 윤석열 대통령과 국민의힘 비대위원들은 박정희 전 대통령 서거일을 하루 앞두고 서울 국립현충원 묘역을 참배했습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 31.212,
                "end": 40.905
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 방준원입니다.",
                "sound_type": [
                    2
                ],
                "start": 40.915,
                "end": 42.976
            }
        ]
    },
