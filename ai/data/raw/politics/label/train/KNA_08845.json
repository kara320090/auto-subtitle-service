        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰이 최근 위례 신도시 개발과 관련해서도 유 전 본부장을 추가 기소했지만 그 사건은 기존 재판에 병합되지 않았고 따라서 구속도 연장되지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.989
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 절차 상으로는 출소 자체에 문제가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.999,
                "end": 13.316
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 민주당에선 @이름1 부원장 등을 겨냥한 수사에 적극 협조한 대가가 아니냐는 의혹을 제기하고 있습니다.",
                "sound_type": [
                    2
