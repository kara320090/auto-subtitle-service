                ],
                "start": 0.000,
                "end": 8.291
            },
            {
                "speaker_id": "1",
                "transcription": "음주 운전 처벌을 강화하는 이른바 윤창호법도 국민 청원이 시작이었습니다.",
                "sound_type": [
                    2,
