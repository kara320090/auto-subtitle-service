        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤 전 총장에서부터 @이름1 검사 김웅 의원으로 고발 사주가 이어진다는 의혹도 전혀 실체가 없다고 주장했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.820
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 김기현 원내대표도 단 한 톨도 문제될게 없다고 판단한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.830,
                "end": 13.527
            },
            {
                "speaker_id": "2",
                "transcription": "고발사주란 용어자체가 틀렸고요.",
                "sound_type": [
                    2
                ],
                "start": 13.537,
                "end": 16.040
            },
            {
                "speaker_id": "2",
                "transcription": "공익제보 형태가 아닌가 저희들은 그렇게 판단하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.050,
                "end": 19.958
            },
            {
                "speaker_id": "1",
                "transcription": "다만 당 내부에서는 특정 후보에 대한 의혹을 어디까지 방어해야 할지에 대한 고민도 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.968,
                "end": 26.270
            },
            {
                "speaker_id": "1",
                "transcription": "고발장 전달자로 지목된 국민의힘 김웅 의원은 내일 기자 회견을 열고 입장을 밝힙니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 26.280,
                "end": 32.281
