        "term": [
            {
                "speaker_id": "1",
                "transcription": "경제 정책 밑그림을 그릴 경제1분과는 박근혜 정부에서 중용됐던 최상목 전 기재부 차관이 이끌고 정무사법행정분과에는 국민의힘 소속 이용호 유상범 의원이 참여합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 12.444
            },
            {
                "speaker_id": "1",
                "transcription": "각 분과에 관료와 학자 등 전문가 기용도 도드라지는데 차기 정부에서 역할을 맡을 예비 내각이라는 평가도 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 12.454,
                "end": 20.922
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인은 울진 동해 산불 피해 현장을 다시 찾아 신속한 지원을 약속했습니다.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 20.932,
                "end": 27.067
            },
            {
                "speaker_id": "2",
                "transcription": "규모도 조금 올려서 주택 복구하시는 데 지장 없도록 저희가 최선을 다하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
