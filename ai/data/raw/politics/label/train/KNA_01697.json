        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열은 원래 죄가 많은 사람이야.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.559
            },
            {
                "speaker_id": "1",
                "transcription": "내가 가진 카드면 윤석열은 죽어.",
                "sound_type": [
                    2
                ],
                "start": 2.569,
                "end": 5.881
            },
            {
                "speaker_id": "1",
                "transcription": "이거 들어보셨죠 녹취록에 있는 거 김만배의 녹취록입니다 검찰 녹취록",
                "sound_type": [
                    2
                ],
                "start": 5.891,
                "end": 11.328
            },
            {
                "speaker_id": "2",
                "transcription": "그 사람들은 뭐 우리 이재명 후보하고 훨씬 가까운 측근이고 저는 뭐 10년 동안 본 적도 없고 제가 듣기로는 그 녹취록 끝부분을 가면 이재명 게이트라는 말을 김만배가 한다 그러는데",
                "sound_type": [
                    2
                ],
                "start": 11.338,
                "end": 26.307
            },
            {
                "speaker_id": "1",
                "transcription": "정영학 남욱 본 일도 없어요 무슨 측근에 가까운 사람입니까?",
                "sound_type": [
                    2
                ],
                "start": 26.317,
                "end": 30.430
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이재명 게이트라고 있다고요 그 녹취록 중에 내세요 지금 허위 사실이면 후보 사퇴하시겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 30.440,
                "end": 36.629
            },
            {
                "speaker_id": "2",
                "transcription": "아 그만하십시오.",
                "sound_type": [
                    2
                ],
                "start": 36.639,
                "end": 37.789
            },
            {
                "speaker_id": "2",
                "transcription": "네 질문 저거니까 이따가 하세요 네.",
                "sound_type": [
                    2
                ],
                "start": 37.799,
                "end": 41.316
            },
            {
                "speaker_id": "3",
                "transcription": "윤석열 후보는 이 후보 배우자 김혜경 씨의 법인카드 의혹으로 역공했습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.326,
                "end": 46.579
            }
        ]
    },
    "summary": "두 후보자가 김만배의 녹취록에 대해 이야기를 했고 윤석열 후보는 이 후보 배우자 김혜경 씨의 법인카드 의혹으로 역공했습니다.",
