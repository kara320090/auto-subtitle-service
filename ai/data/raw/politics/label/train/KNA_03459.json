                    5
                ],
                "start": 9.163,
                "end": 14.379
            },
            {
                "speaker_id": "1",
                "transcription": "검찰에 대해서는 공정성에 대한 신뢰가 나아지지 않고 있다며 스스로 개혁에 앞장서 달라고 주문했습니다.",
                "sound_type": [
                    2
