            {
                "speaker_id": "2",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "전국 고등 검찰청장이 오늘 대검찰청에서 긴급 회의를 열었는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.052
            },
            {
                "speaker_id": "1",
                "transcription": "대검찰청에 나가 있는 취재기자 연결해 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 4.062,
                "end": 6.873
            },
            {
                "speaker_id": "1",
                "transcription": "자 박진수 기자 오늘 아침부터 전국 고검장들이 모여 회의를 했는데 결과가 나왔나요?",
                "sound_type": [
                    2
                ],
                "start": 6.883,
                "end": 14.473
            },
            {
                "speaker_id": "2",
                "transcription": "아직 회의 결과를 내놓지는 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.483,
                "end": 18.211
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 오전 아홉시 반쯤 시작한 고검장 회의는 여섯 시간 반 만인 오후 네시쯤 끝났습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.221,
                "end": 24.508
            },
            {
                "speaker_id": "2",
                "transcription": "전국 고검장 여섯 명 전원이 참석했는데요.",
                "sound_type": [
                    2
                ],
                "start": 24.518,
                "end": 28.081
            },
            {
                "speaker_id": "2",
                "transcription": "수사권 폐지 법안에 어떻게 대응할지 등을 긴밀하게 논의한 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.091,
                "end": 33.449
            },
            {
                "speaker_id": "2",
                "transcription": "여환섭 대전 고검장은 회의에 참석하면서 문제점이 너무 많아 실무상 운영이 어려울 정도라며 민주당을 향해 냉정한 이성을 되찾길 바란다고 목소리를 높였습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.459,
                "end": 44.550
            },
            {
                "speaker_id": "2",
                "transcription": "조종태 광주 고검장도 범죄자는 두 발 뻗고 자겠지만 피해자는 눈물과 한숨으로 잠 못 이루게 될 것이라며 법안을 발의한 분들이 이런 세상을 바라진 않을 것이라고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 44.560,
                "end": 56.835
            },
            {
                "speaker_id": "2",
                "transcription": "지금은 대검찰청에 모여 문재인 대통령과 김오수 검찰총장의 면담 결과를 기다리고 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 56.845,
                "end": 62.759
            },
            {
                "speaker_id": "2",
                "transcription": "면담 결과를 보고 회의 결과 발표 여부를 결정한다는 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 62.769,
                "end": 67.284
            },
            {
                "speaker_id": "2",
                "transcription": "오후 네시쯤 문 대통령 면담을 위해 대검찰청을 출발한 김 총장은 면담을 마치고 조금 전인 일곱시쯤 이곳으로 돌아왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 67.294,
                "end": 76.609
            }
        ]
    },
    "summary": "전국 고등 검찰청장이 대검찰청에서 긴급 회의를 열었고 수사권 폐지 법안에 어떻게 대응할지를 긴밀하게 논의했으며 대통령 면담 결과를 보고 회의 결과 발표 여부를 결정한다고 했다.",
