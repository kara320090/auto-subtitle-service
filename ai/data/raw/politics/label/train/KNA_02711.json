        "term": [
            {
                "speaker_id": "1",
                "transcription": "사적인 거",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.212
            },
            {
                "speaker_id": "2",
                "transcription": "김대기 비서 실장의 목소리라는 야당의 의혹 제기를 김 실장은 정면 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.222,
                "end": 8.675
            },
            {
                "speaker_id": "3",
                "transcription": "어저께 보여드린 영상 사실관계 확인하셨나요?",
                "sound_type": [
                    2
                ],
                "start": 8.685,
                "end": 11.933
            },
            {
                "speaker_id": "4",
                "transcription": "사적 사적 그거요?",
                "sound_type": [
                    2
                ],
                "start": 11.943,
                "end": 14.192
            },
            {
                "speaker_id": "4",
                "transcription": "제가 한 거 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 14.202,
                "end": 15.984
            },
            {
                "speaker_id": "2",
                "transcription": "김실장은 잠깐의 일탈이었을 뿐 국회 모욕이 아니라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.994,
                "end": 20.257
            },
            {
                "speaker_id": "5",
                "transcription": "밖에서 사담을 했다고 해도 문제가 되는 겁니다 실장님 아시지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 20.267,
                "end": 23.948
            },
            {
                "speaker_id": "4",
                "transcription": "저도 사과하고 다 사과 그 하고 그다음에 퇴장까지 하지 않았습니까 그러면 더 이상 뭘 하란 말입니까?",
                "sound_type": [
                    2
                ],
                "start": 23.958,
                "end": 31.431
            }
        ]
    },
