        "term": [
            {
                "speaker_id": "1",
                "transcription": "최근 공직자 윤리위가 이 장관이 공직자 윤리법을 위반한 것으로 판단한 걸로 KBS 취재 결과 확인됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.438
            },
            {
                "speaker_id": "1",
                "transcription": "공직자 윤리위는 이 장관에 대해 과태료 부과 대상자로 법원에 통보했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.448,
                "end": 13.310
            },
            {
                "speaker_id": "1",
                "transcription": "공직자 윤리법상 공직 유관 단체의 상근 임원은 퇴직 후 민간에 취업하려면 공직자 윤리위에서 업무 관련성이 없다는 확인을 받아야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 13.320,
                "end": 23.490
            },
            {
                "speaker_id": "1",
                "transcription": "업무 관련성이 있을 경우 생길 수 있는 이해충돌을 막기 위한 취지입니다.",
                "sound_type": [
                    2
                ],
                "start": 23.500,
                "end": 28.665
            },
            {
                "speaker_id": "1",
                "transcription": "결국 이 장관이 이를 위반했단 판단으로 1000만 원 이하의 과태료 부과 대상이 된 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 28.675,
                "end": 34.701
            }
        ]
    },
    "summary": "최근 공직자 윤리위는 공직 유관 단체의 상근 임원은 퇴직 후 민간에 취업하려면 공직자 윤리위에서 업무 관련성이 없다는 확인을 받아야 하는데 이 장관이 이를 위반했단 판단으로 1000만원 이하의 과태료 부과 대상자로 법원에 통보했다.",
