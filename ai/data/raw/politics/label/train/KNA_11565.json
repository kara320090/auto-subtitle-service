        "term": [
            {
                "speaker_id": "1",
                "transcription": "당장 정치권에선 전직 장관과 의원 등 윤석열 대통령 캠프 출신 인사들이 최종 후보군에서 모두 탈락했기 때문이란 해석이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.540
            },
            {
                "speaker_id": "1",
                "transcription": "여당 의원들은 손사래를 치며 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.550,
                "end": 12.963
            },
            {
                "speaker_id": "2",
                "transcription": "만약에 우리가 인사에 개입했었으면 이 자리에 있을 이유가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.973,
                "end": 17.006
            },
            {
                "speaker_id": "3",
                "transcription": "그건 마음대로 안 되시니까",
                "sound_type": [
                    2
                ],
                "start": 17.016,
                "end": 18.428
            },
            {
                "speaker_id": "2",
                "transcription": "아 그거는 다르다고 보는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 18.438,
                "end": 21.515
            },
            {
                "speaker_id": "4",
                "transcription": "전혀 그렇지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.525,
