        "term": [
            {
                "speaker_id": "1",
                "transcription": "누구를 겨냥한 거냐 분분했는데 홍 의원이 윤 후보에게 내민 카드가 알려지며 홍준표 저격이라는 해석이 나왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.633
            },
            {
                "speaker_id": "1",
                "transcription": "국정 운영 능력 담보 조치와 처가 비리 엄단 선언 말고도 국회의원 보궐 선거에서 서울 종로의 최재영 전 감사원장 대구 중랑구 이진훈 등 특정인 공천을 제안했다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.643,
                "end": 18.438
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보 측에서는 내부 총질하더니 전략 공천해 주면 도와주겠다는 게 말이 되느냐 어이없다는 반응까지 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.448,
                "end": 25.509
            },
            {
                "speaker_id": "1",
                "transcription": "이에 맞서 홍 의원도 불편한 심기를 감추지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.519,
                "end": 29.337
            },
            {
                "speaker_id": "2",
                "transcription": "어떻게 후보하고 이야기하는 내용으로",
                "sound_type": [
                    2
                ],
                "start": 29.347,
                "end": 32.532
            }
        ]
    },
