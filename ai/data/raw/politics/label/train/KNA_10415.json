        "term": [
            {
                "speaker_id": "1",
                "transcription": "2년 뒤 대법원에서 또 징역 2년 6개월 실형이 확정됐고 이 부회장은 나왔던 곳으로 다시 들어가야 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.294
            },
            {
                "speaker_id": "1",
                "transcription": "그로부터 7개월.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.304,
                "end": 9.270
            },
            {
                "speaker_id": "2",
                "transcription": "가석방을 요구하는 국민들도 많습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.280,
                "end": 13.757
            },
            {
                "speaker_id": "2",
                "transcription": "국익을 위한 선택으로 받아드리며 국민들께서도 이해해 주시기를 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 13.767,
                "end": 20.485
            },
            {
                "speaker_id": "1",
                "transcription": "정부의 가석방으로 수감 생활은 사실상 막을 내립니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.495,
                "end": 25.053
            },
            {
                "speaker_id": "3",
                "transcription": "정말 죄송합니다.",
