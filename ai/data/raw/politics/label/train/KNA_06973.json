        "term": [
            {
                "speaker_id": "1",
                "transcription": "한덕수 국무총리 후보자 인사청문회는 이틀 연속 파행이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.405
            },
            {
                "speaker_id": "1",
                "transcription": "질의응답은 물론 후보자 선서도 없이 30분 만에 끝났습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.415,
                "end": 9.074
            },
            {
                "speaker_id": "1",
                "transcription": "민주당과 정의당은 한 후보자의 자료 제출 부실 문제를 거듭 따졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.084,
                "end": 13.959
            },
            {
                "speaker_id": "2",
                "transcription": "이게 정말 의미 없는 자료입니까?",
                "sound_type": [
                    2
                ],
                "start": 13.969,
                "end": 16.142
            },
            {
                "speaker_id": "2",
                "transcription": "이게 무리한 요구입니까?",
                "sound_type": [
                    2
                ],
                "start": 16.152,
                "end": 19.058
            },
            {
                "speaker_id": "1",
                "transcription": "한 후보자 인사청문준비단이 요청받은 자료는 1090여 건 자료 제출률은 약 80퍼센트입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.068,
                "end": 26.059
            }
        ]
    },
    "summary": "한덕수 국무총리 후보자 인사청문회는 이틀 연속 파행이었고 민주당과 정의당은 자료 제출 부실 문제를 거듭 따졌다.",
