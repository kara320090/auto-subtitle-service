        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 3년이 지난 지금 다시 확인해봤더니 훈장은 여전히 유지되고 있었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.409
            },
            {
                "speaker_id": "2",
                "transcription": "들이 그거 조작해서 상을 그걸 받는다는 거는 그건 말이 안되잖아요 그래서 그거 받은 상은 취소시키거나 박탈해야지 마땅한 거 아니겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 5.419,
                "end": 18.142
            },
            {
                "speaker_id": "1",
                "transcription": "약속한 조치를 왜 이행하지 않았냐는 질의에 행안부는 상훈를 추천했던 국정원에서 취소요청을 안해서 라고 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.152,
                "end": 26.978
            },
            {
                "speaker_id": "1",
                "transcription": "이에 국정원은 취소권한이 있는 행안부가 독자적으로 할 수 있다고 또 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.988,
                "end": 32.532
            }
        ]
    },
    "summary": "지금 다시 확인해봤더니 훈장은 여전히 유지되고 있었고 행안부는 국정원에서 취소요청을 안해서 라고 답했으나 국정원은 취소권한이 있는 행안부가 독자적으로 할 수 있다고 반박했다.",
