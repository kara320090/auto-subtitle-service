        "term": [
            {
                "speaker_id": "1",
                "transcription": "내부에서는 여론을 굉장히 엄하고 진중하게 보고 있다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.827
            },
            {
                "speaker_id": "1",
                "transcription": "당내 조사단에서 빠르게 논의가 이뤄져야 한다는 목소리가 나오고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.837,
                "end": 8.880
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 결국 다음 주 자체 진상 조사에 돌입하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.890,
                "end": 13.415
            },
            {
                "speaker_id": "2",
                "transcription": "주말 지나고 다음 주 되면은 그 당의 여러 가지 기구가 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 13.425,
                "end": 19.214
            },
            {
                "speaker_id": "2",
                "transcription": "적당한 기구를 통해서 진실 규명이 있을 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 19.224,
                "end": 23.499
            },
            {
                "speaker_id": "1",
                "transcription": "민주당이 자체 진상 규명에 나서기로 한 건 총선을 불과 1년 앞두고 의혹을 둘러싼 사법 리스크가 당 전반으로 번지는 걸 차단하기 위한 것으로 보입니다.",
