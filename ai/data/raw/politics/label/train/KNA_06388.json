        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘 선거 대책 본부는 김건희 씨의 주가 조작 관여 의혹을 강하게 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.648
            },
            {
                "speaker_id": "1",
                "transcription": "2010년 5월 이후 이 모 씨에게 계좌를 회수했고 남은 주식을 김 씨가 전화 주문을 통해 수년에 걸쳐 매매했다며 뭐가 문제냐고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.658,
                "end": 15.990
            },
            {
                "speaker_id": "1",
                "transcription": "사나흘에 한 번 꼴로 전화 주문을 해서는 주가를 조작할 수 없다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.000,
                "end": 22.054
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 KBS가 확인한 검찰 수사 기록을 보면 그 기간 김 씨 계좌의 거래는 검찰이 주가 조작 혐의로 기소한 피고인들 명의 계좌와의 거래가 발견됩니다.",
                "sound_type": [
                    2
                ],
                "start": 22.064,
                "end": 31.817
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 해당 거래를 통정 거래로 분류했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.827,
                "end": 35.435
            }
        ]
    },
