        "term": [
            {
                "speaker_id": "1",
                "transcription": "육군본부라고 했던가 뭐 뭐라고 하면서 어 혹시 그 보안사에서 무슨 사건을 겪은 적이 있느냐?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.292
            },
            {
                "speaker_id": "2",
                "transcription": "갑작스러운 전화는 다짜고짜 아픈 상처부터 헤집었습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.302,
                "end": 16.417
            },
            {
                "speaker_id": "2",
                "transcription": "왜 그러냐고 묻자 군은 사과하려는 전화라고 얼버무렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.427,
                "end": 21.276
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래서 어떻게 하란 말이냐 그랬더니만 그냥 끊었어요.",
                "sound_type": [
                    2
                ],
                "start": 21.286,
                "end": 25.178
            },
            {
                "speaker_id": "1",
                "transcription": "사과도 아니고 이 또 이것들이 또 무슨 조사를 하고 협박을 하나 그래 생각했죠.",
                "sound_type": [
                    2
                ],
                "start": 25.188,
                "end": 31.064
            }
        ]
    },
    "summary": "육군본부라며 온 전화에서 보안사에서 무슨 사건을 겪은 적이 있느냐며 다짜고자 묻던 군은 사과하려는 전화라며 말을 얼버무렸다.",
