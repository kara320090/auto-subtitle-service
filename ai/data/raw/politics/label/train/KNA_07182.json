        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 후보자에게 아파트를 판 사람은 28년생 정 모 씹니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.664
            },
            {
                "speaker_id": "1",
                "transcription": "정 씨를 기억하는 사람들은 정 씨가 당시 주택조합을 운영하고 관리했다고 말합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.674,
                "end": 11.025
            },
            {
                "speaker_id": "2",
                "transcription": "이 사람은 지역 조합장이지 지역 조합장은 이제 본인의 지역을 모집을 하는 거지.",
                "sound_type": [
                    2
                ],
                "start": 11.035,
                "end": 16.339
            },
            {
                "speaker_id": "2",
                "transcription": "땅 갖고 있던 사람은 1928년생이면 돌아가셨다고 봐야지.",
                "sound_type": [
                    2
                ],
                "start": 16.349,
                "end": 20.381
            },
            {
                "speaker_id": "1",
                "transcription": "신반포 청구아파트 건설사업은 여러 지역주택조합이 함께 추진했는데 정 씨가 이 중 한 곳의 조합장이었다는 겁니다.",
                "sound_type": [
                    2
