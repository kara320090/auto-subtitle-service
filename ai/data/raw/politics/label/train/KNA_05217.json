        "term": [
            {
                "speaker_id": "1",
                "transcription": "일련의 의혹들과 관련해서 박지원 전 원장은 자신이 이끌던 국정원으로부터 서욱 전 장관과 서훈 전 실장은 공무원 유족으로부터 각각 고발을 당했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.637
            },
            {
                "speaker_id": "1",
                "transcription": "이후 한 달여 만에 검찰이 본격적인 강제 수사에 나선 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 10.647,
                "end": 14.801
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 압수 수색은 세 사람의 자택 뿐 아니라 국가 안보실 국방부 해경 관계자 사무실 등 10여 곳에서 벌어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.811,
                "end": 22.976
            },
            {
                "speaker_id": "1",
                "transcription": "압수물 분석이 끝나면 다음 순서는 박 전 원장 등에 대한 소환이 될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
