        "term": [
            {
                "speaker_id": "1",
                "transcription": "쌍방울 그룹과의 인연 이재명 대표는 이렇게 잘라 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.308
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1라는 분의 얼굴도 본 적이 없거든요. 내가 인연이라면 내의 내의 사 입은 거",
                "sound_type": [
                    2
                ],
                "start": 4.318,
                "end": 10.190
            },
            {
                "speaker_id": "1",
                "transcription": "체포된 김 전 회장도 비슷한 입장이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.200,
                "end": 13.706
            },
            {
                "speaker_id": "3",
                "transcription": "이재명 씨는 전화나 뭐 이거 한 게 없는데",
                "sound_type": [
                    2
                ],
                "start": 13.716,
                "end": 16.693
            },
            {
                "speaker_id": "4",
                "transcription": "전화는 한 번 하신 적 있지 않으",
                "sound_type": [
                    2
                ],
                "start": 16.703,
                "end": 17.908
            },
            {
                "speaker_id": "3",
                "transcription": "없습니다. 전혀 없고요. 전화번호도 알지도 못하고.",
                "sound_type": [
                    2
                ],
                "start": 17.918,
                "end": 20.887
            }
        ]
    },
    "summary": "쌍방울 그룹과의 인연은 내의 사 입은 것밖에 없다며 잘라 말했고 체포된 김 전 회장도 비슷한 입장이다.",
