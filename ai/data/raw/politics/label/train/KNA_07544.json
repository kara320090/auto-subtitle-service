        "term": [
            {
                "speaker_id": "1",
                "transcription": "공정위원장 하마평이 도는 강수진 교수는 성남 지청 근무 시절 윤 대통령과 카풀을 했던 인연이 화제가 되기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.652
            },
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 현 정부 고위 공직자 인사 검증을 맡을 법무부 인사 정보 관리 단장에는 검찰이 아닌 인사 혁신처 공무원 출신이 임명됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.662,
                "end": 16.338
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 권력 비대화에 대한 우려의 시선을 어느 정도 의식했다는 해석도 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 16.348,
                "end": 21.891
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 출범한 인사 정보 관리단엔 전직 검사 네 명이 배치됐습니다.",
                "sound_type": [
