        "term": [
            {
                "speaker_id": "1",
                "transcription": "아직 40대인데다 고시 기수로 형 김오수 검찰 총장보다 7기수나 낮기 때문이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.800
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 한동훈 후보자는 이런 생각 일축했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.870,
                "end": 10.665
            },
            {
                "speaker_id": "2",
                "transcription": "제가 지금 거의 50이 됐고 그리고 공직 생활에서 이 분야에서만 20년 넘게 근무를 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.675,
                "end": 17.871
            },
            {
                "speaker_id": "2",
                "transcription": "이런 정도 경력을 가진 사람이 나이나 경력 때문에 장관직을 수행하지 못할 만한 나라는 아니라고 생각하고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.881,
                "end": 24.272
            },
            {
                "speaker_id": "1",
                "transcription": "외교부와 통일부 장관엔 실세 중진으로 불리는 4선의 박진 권영세 의원이 나란히 포진했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.282,
                "end": 31.822
            },
            {
                "speaker_id": "1",
                "transcription": "현역 의원 입각을 최소화한다는 인선 방침보다는 엄중한 안보 상황에 중량감 있는 정치인을 발탁했다는 평가입니다.",
                "sound_type": [
                    2
                ],
                "start": 31.832,
                "end": 41.224
            },
            {
                "speaker_id": "1",
                "transcription": "사회부총리 겸 교육부 장관엔 김인철 전 한국외대 총장이 지명됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.234,
                "end": 46.851
            },
            {
                "speaker_id": "1",
                "transcription": "행정안전부엔 이상민 전 권익위 부위원장 환경부엔 한화진 환경 연구원 명예 연구 위원 해수부엔 조승환 전 해양과학기술진흥원장 중소벤처 기업부 장관 후보자에는 이영 의원이 각각 선임됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 46.861,
                "end": 63.229
            }
        ]
    },
    "summary": "장관 후보들을 발표한 결과 현역 의원 입각을 최소화한다는 인선 방침보다는 엄중한 안보 상황에 중량감 있는 정치인을 발탁했다는 평가이다.",
