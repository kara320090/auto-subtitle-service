            },
            {
                "speaker_id": "2",
                "transcription": "도청과 관련해서 미국에서 4월 8일 날 뉴욕 타임즈에서 보 보도가 있었습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.821,
                "end": 12.081
            },
            {
                "speaker_id": "2",
                "transcription": "이게 사실입니까?",
