        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "김경수 경남도지사는 갑작스런 선고 연기에 최선을 다하겠다는 입장만 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.381
            },
            {
                "speaker_id": "2",
                "transcription": "선고를 연기하신 이유는 제가 알기는 어려운데 지금까지 해왔던 것처럼 끝까지 최선을 다할 생각입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.391,
                "end": 14.817
            },
            {
                "speaker_id": "1",
                "transcription": "지난해 12월 24일에 이어 두 번째 선고 연기인데 재판부 직권으로 추가 심리를 결정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.827,
                "end": 21.711
            },
            {
                "speaker_id": "1",
                "transcription": "재판부는 다만 지금까지 심리 결과 드루킹의 댓글조작 프로그램인 킹크랩 시연을 김 지사가 본 게 맞다는 잠정 결론을 내렸다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.721,
                "end": 30.730
            },
            {
                "speaker_id": "1",
                "transcription": "1심 실형 판단의 주된 근거를 항소심 재판부도 인정한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 30.740,
                "end": 35.500
            },
            {
                "speaker_id": "1",
                "transcription": "재판부는 앞으로 김 지사와 드루킹의 공범 관계를 꼼꼼히 더 따져보겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.510,
                "end": 41.505
            },
            {
                "speaker_id": "1",
                "transcription": "특검과 변호인단 양측에는 다음 재판까지 8가지 사항의 설명을 요청했습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.515,
                "end": 46.980
            },
            {
                "speaker_id": "1",
                "transcription": "킹크랩 시연 뒤 김 지사가 허락의 의미로 고개를 끄덕였다는 드루킹 주장의 신빙성 또 김 지사와 드루킹이 당시 어떤 관계였는지.",
                "sound_type": [
                    2
                ],
                "start": 46.990,
                "end": 56.370
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 둘 사이 댓글 조작 대상으로 보이는 특정 기사를 주고받으면서 드루킹이 처리했습니다 등의 문자를 보냈을 때 김 지사가 문제 삼지 않은 이유 등을 설명하라는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 56.380,
                "end": 66.568
            },
            {
                "speaker_id": "3",
                "transcription": "다소 의외의 오늘 석명 준비 명령 아니었나 생각이 듭니다.",
                "sound_type": [
                    2
                ],
                "start": 66.578,
                "end": 73.893
            },
            {
                "speaker_id": "3",
                "transcription": "증거 수집하는 절차나 시간도 꽤 소요될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 73.903,
                "end": 79.067
            },
            {
                "speaker_id": "1",
                "transcription": "김경수 경남도지사는 지난해 1월 1심 실형 선고로 법정 구속된 뒤 항소심에서 보석으로 풀려났습니다.",
                "sound_type": [
                    2
                ],
                "start": 79.077,
                "end": 86.314
            },
            {
                "speaker_id": "1",
                "transcription": "재판부 결정으로 2심 선고가 적어도 석 달은 늦춰질 것으로 보이는데 여권 핵심 정치인인 김경수 도지사의 항소심 결과는 총선 전에는 나오지 않을 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 86.324,
                "end": 97.032
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 97.042,
                "end": 99.799
            }
        ]
    },
    "summary": "김경수 경남도지사는 갑작스러운 선고 연기에 최선을 다하겠다는 입장만 밝혔고 항소심 결과는 총선 전에는 나오지 않을 것으로 보인다.",
