        "term": [
            {
                "speaker_id": "1",
                "transcription": "전 씨가 광주 법정에 선 건 지난해 11월.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.036
            },
            {
                "speaker_id": "1",
                "transcription": "1심 선고공판 이후 9개월만.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.046,
                "end": 5.743
            },
            {
                "speaker_id": "1",
                "transcription": "항소심 재판이 시작된 뒤로는 처음입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.753,
                "end": 8.910
            },
            {
                "speaker_id": "1",
                "transcription": "전 씨는 헬기 사격이 있었다며 징역 8개월 집행유예 2년을 선고한 1심 판결에 곧장 항소했지만 정작 5월부터 시작된 항소심 재판에는 두 차례 연속 출석을 거부했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.920,
                "end": 22.033
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 항소심 재판부가 불이익을 주겠다고 경고하자 입장을 바꿨습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.043,
                "end": 27.293
            },
            {
                "speaker_id": "1",
                "transcription": "오후 2시부터 30여 분간 진행된 재판에서 전 씨는 20분쯤 지나자 호흡곤란 등 건강상의 이유로 퇴정 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.303,
                "end": 35.910
            },
            {
                "speaker_id": "1",
                "transcription": "재판부는 전 씨 측이 신청한 헬기 조종사 9명 가운데 4명 만을 증인으로 채택했습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.910,
                "end": 42.155
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 증인들은 고령인데다 1심에서 이미 증언을 마쳤다는 이유에섭니다.",
                "sound_type": [
                    2
                ],
                "start": 42.165,
                "end": 47.147
            }
        ]
    },
    "summary": "전 씨는 1심 판결에 곧장 항소했지만 정작 5월부터 시작된 항소심 재판에는 두 차례 연속 출석을 거부했다가 항소심 재판부가 경고하자 입장을 바꿨다.",
