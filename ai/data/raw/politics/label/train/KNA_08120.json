            },
            {
                "speaker_id": "1",
                "transcription": "이 가운데 대기업은 두 곳 뿐입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.139,
                "end": 6.496
            },
            {
                "speaker_id": "1",
                "transcription": "같은 기간 해외에 2만 여 개의 기업이 설립 신고된 것을 감안하면 적은 수치입니다.",
                "sound_type": [
