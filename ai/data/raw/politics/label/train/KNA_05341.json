        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 민주당은 동맹국 모독 발언이다 국제적 망신이라며 윤 대통령의 사과와 외교 라인 교체를 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.323
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 정부의 빈손 외교 비굴 외교에 이어 윤석열 대통령의 막말 사고 외교로 대한민국의 국격까지 크게 실추되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.333,
                "end": 19.806
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 내에서 도 부끄러움은 정녕 국민의 몫이냐.",
                "sound_type": [
                    2
                ],
                "start": 19.816,
                "end": 24.581
            },
            {
                "speaker_id": "1",
                "transcription": "대통령은 정신을 차리라는 지적부터 과도한 비난과 폄훼는 자기 얼굴에 침 뱉는 격이라는 갑론을박이 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.591,
                "end": 33.166
            }
        ]
    },
