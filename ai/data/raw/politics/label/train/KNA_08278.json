        "term": [
            {
                "speaker_id": "1",
                "transcription": "임기 5년 동안 국정 운영에 대한 긍정 전망은 지난 5월 취임 당시 KBS 여론 조사와 비교해 크게 하락했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.800
            },
            {
                "speaker_id": "1",
                "transcription": "못할 것이란 응답이 59퍼센트로 이전 조사와 비교해 17퍼센트포인트 넘게 늘었고 잘할 것이란 전망은 37퍼센트에 그치면서 석 달 전과 상반된 결과가 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.810,
                "end": 20.720
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 중점 추진해야 할 정책 과제를 물었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.720,
                "end": 24.575
            },
            {
                "speaker_id": "1",
                "transcription": "성장과 일자리 창출 물가와 집값 안정 순으로 조사됐고 양극화 해소와 사회 안전망 강화가 뒤를 이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.580,
                "end": 33.368
            },
            {
                "speaker_id": "1",
                "transcription": "경제와 민생을 우선순위로 꼽은 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 33.378,
                "end": 36.002
            }
