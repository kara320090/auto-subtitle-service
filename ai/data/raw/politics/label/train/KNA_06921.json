                    2
                ],
                "start": 0.000,
                "end": 10.712
            },
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 김부겸 국무총리도 지난해 10월 코로나 방역과 관련해 출연 요청을 했지만 정치인은 곤란하다는 답이 돌아왔다고 총리실은 전했습니다.",
                "sound_type": [
                    2
