        "term": [
            {
                "speaker_id": "1",
                "transcription": "이재명 후보와 심상정 후보 기금을 마련하겠다고 했지만 구체적 재원 규모는 밝히지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.493
            },
            {
                "speaker_id": "1",
                "transcription": "에너지 약자 복지 제공을 약속한 윤석열 후보 약자가 누구인지 어떤 복지를 어떻게 제공하겠다는 건지 언급이 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.503,
                "end": 15.465
            },
            {
                "speaker_id": "1",
                "transcription": "안철수 후보의 사회적 안전망 강화도 구체성이 부족합니다.",
                "sound_type": [
                    2
                ],
                "start": 15.475,
                "end": 19.771
            },
            {
                "speaker_id": "2",
                "transcription": "직업이 전환돼야 되는 데는 비용 이런 것들을 계산을 하셔서 그것을 근거로 해서 이 정도의 비용이 들기 때문에 앞으로 에너지 전환 부분에서는 이러이러한 정책들이 있을 것입니다라는 정도가 뭐가 나와 줘야 되지 않나?",
                "sound_type": [
                    2
                ],
                "start": 19.781,
                "end": 35.681
            },
            {
                "speaker_id": "1",
                "transcription": "네 후보 모두 일자리 재훈련과 재교육을 강조하는데",
                "sound_type": [
                    2
                ],
                "start": 35.691,
                "end": 39.739
