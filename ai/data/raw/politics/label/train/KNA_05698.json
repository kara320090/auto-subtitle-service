        "term": [
            {
                "speaker_id": "1",
                "transcription": "인터넷 커뮤니티 등에 확산되고 있는 한 고등학교 사진입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.176
            },
            {
                "speaker_id": "1",
                "transcription": "학생 30여 명이 학교 현관 앞에 엎드린 채 단체로 벌을 받고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.186,
                "end": 9.643
            },
            {
                "speaker_id": "1",
                "transcription": "지난주 급식 봉사를 제대로 하지 않았다며 한 교사가 1 2학년 학급 임원들에게 엎드려뻗쳐 체벌을 가한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 9.653,
                "end": 18.414
            },
            {
                "speaker_id": "1",
                "transcription": "이를 본 한 학생이 사진과 함께 국민 신문고에 고발했고 학교 측은 지침에 따라 해당 교사를 아동 학대 의심으로 자치단체에 신고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.424,
                "end": 28.892
            },
            {
                "speaker_id": "1",
                "transcription": "체벌을 두고 의견은 엇갈립니다.",
                "sound_type": [
                    2
                ],
                "start": 28.902,
                "end": 31.331
            }
        ]
    },
    "summary": "단체로 체벌을 받는 모습을 보고 의견이 엇갈린다.",
