        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 경찰 현장 책임자들에 대한 강제 수사 필요성을 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.200
            },
            {
                "speaker_id": "2",
                "transcription": "과실 치사를 넘어 참사 방조 구경꾼 살인 방조 세월호 선장보다 더하면 더 했지 덜하지 않은 사람이다.",
                "sound_type": [
                    2
                ],
                "start": 5.210,
                "end": 13.700
            },
            {
                "speaker_id": "2",
                "transcription": "휴대폰 압수 수색했습니까?",
                "sound_type": [
                    2
                ],
                "start": 13.710,
                "end": 16.140
            },
            {
                "speaker_id": "3",
                "transcription": "예 그렇게 진행되는 걸로 알고요.",
                "sound_type": [
                    2
                ],
                "start": 16.150,
                "end": 17.892
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 경찰이 마약 단속에 집중하느라 예방을 소홀히 한 것 아니냐고 따졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.902,
                "end": 24.395
            },
            {
                "speaker_id": "4",
                "transcription": "질서 유지가 아닌 다른 쪽의 생각이 있었을 거다.",
                "sound_type": [
                    2
                ],
                "start": 24.405,
                "end": 27.375
            },
            {
                "speaker_id": "4",
                "transcription": "서울 청장이 마약 단속에 생각이 있었습니까?",
                "sound_type": [
                    2
                ],
                "start": 27.385,
                "end": 30.492
            },
            {
                "speaker_id": "4",
                "transcription": "그래서 놓친 거 아니에요.",
                "sound_type": [
                    2
                ],
                "start": 30.502,
                "end": 31.889
            },
            {
                "speaker_id": "5",
                "transcription": "마약 쪽에 상당한 정도 비중을 듣던 거는 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.899,
                "end": 36.736
            }
        ]
    },
