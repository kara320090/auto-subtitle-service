        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 다음 주 뉴욕 유엔 총회에서 한미 한일 정상회담을 갖는다고 대통령실이 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.412
            },
            {
                "speaker_id": "1",
                "transcription": "지난 6월 나토 정상회의 때 한미일 3국 정상이 함께 모였지만 이번엔 각각 단독 정상회담을 갖는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.422,
                "end": 13.706
            },
            {
                "speaker_id": "1",
                "transcription": "우리 시간으론 21일이나 22일로 예상됩니다.",
                "sound_type": [
                    2
                ],
                "start": 13.716,
                "end": 17.652
            },
            {
                "speaker_id": "1",
                "transcription": "정상회담 일정이 유동적이긴 하지만 현재로서는 한미 정상회담 그리고 한일 정상회담을 하기로 합의해 놓고 시간을 조율 중에 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.662,
                "end": 29.058
            },
            {
                "speaker_id": "1",
                "transcription": "특히 한일 정상회담은 2019년 12월 문재인 전 대통령과 고 아베 전 총리가 만난 이후 2년 9개월만입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.068,
                "end": 37.382
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 취임 이후 처음 일본 정상과 마주하는 건데 대통령 실은 서로 이번에 만나는 것이 좋겠다고 흔쾌히 합의됐다고 회담 성사 배경을 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.392,
                "end": 48.248
            }
        ]
    },
    "summary": "지난 6월 나토 정상회의 때 한미일 3국 정상이 함께 모였지만 이번엔 각각 단독 정상회담을 한다.",
