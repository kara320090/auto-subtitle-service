        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 힘이 국민의 지지와 신뢰를 받기 위한 자체 노력의 일환입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.079
            },
            {
                "speaker_id": "2",
                "transcription": "두 최고 위원은 말을 아꼈습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.089,
                "end": 9.570
            },
            {
                "speaker_id": "3",
                "transcription": "뭐 윤리 위원회에서 소명 요구를 하면 그때 어 뭐 자세히 에 소명하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.580,
                "end": 16.370
            },
            {
                "speaker_id": "4",
                "transcription": "윤리위의 활동 상황에 대해서 제가 언급하는 거는 대단히 부적절하다.",
                "sound_type": [
                    2
                ],
                "start": 16.380,
                "end": 21.733
            },
            {
                "speaker_id": "2",
                "transcription": "김재원 최고 위원은 자진 사퇴 가능성엔 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.743,
                "end": 25.667
            },
            {
                "speaker_id": "5",
                "transcription": "혹시 최고 위원 자진 사퇴 의향도 좀 있으실까요?",
                "sound_type": [
                    2
                ],
                "start": 25.677,
                "end": 29.189
            },
            {
                "speaker_id": "3",
                "transcription": "뭐 그것은 아직까지 생각해 보지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.199,
                "end": 32.031
            }
        ]
    },
    "summary": "두 최고 위원은 말을 아끼는 모습을 보였고 김재원 최고 위원은 자진 사퇴 가능성엔 선을 그었다.",
