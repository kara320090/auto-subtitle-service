        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 윤 당선인의 이런 설명과는 달리 안 위원장이 오늘 뚜렷한 입장 표명도 없이 공식 일정을 모두 취소하면서 지금 이런저런 얘기들이 나오고 있는 상황이죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.023
            },
            {
                "speaker_id": "2",
                "transcription": "예 안철수 위원장은 서울 소방본부에 소방 정책 현장 방문 등 오늘 예정됐던 일정을 모두 취소했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.033,
                "end": 18.704
            },
            {
                "speaker_id": "2",
                "transcription": "안 위원장은 어제도 윤 당선인과 이준석 국민의힘 대표 인수위 관계자들이 함께 하는 도시락 만찬에도 참석하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.714,
                "end": 27.665
            },
            {
                "speaker_id": "2",
                "transcription": "선거 기간 약속했던 공동 정부 보상은 사실상 어려워졌다는 분석이 나오는 상황에서 안 위원장이 인선에 대한 불편한 심기를 드러낸 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.675,
                "end": 38.235
            },
            {
                "speaker_id": "2",
                "transcription": "앞서 안 위원장의 측근인 이태규 의원이 인수위원직을 사퇴했고 실무 협상이 끝나고 타결이 임박했다고 알려졌던 국민의힘과 국민의당의 합당까지 보류되는 등 마찰음이 이어지는 상황입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.245,
                "end": 51.995
            },
            {
                "speaker_id": "2",
                "transcription": "이에 대해 안 위원장 측 관계자는 지금 상황을 돌아보고 판단하는 시간이 필요한 것 같다고 설명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.005,
                "end": 59.061
            },
            {
                "speaker_id": "2",
                "transcription": "반면 배현진 당선인 대변인은 안 위원장이 끝까지 책임을 다해줄 것으로 기대한다며 확대 해석을 경계했습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.071,
                "end": 67.992
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 다음 달 일본에서 열릴 예정인 미국 일본 호주 인도의 4개국 안보 협의체 쿼드 정상회의에 윤 당선인이 참석 의사를 타진했다는 일본 언론 보도가 있었는데요.",
                "sound_type": [
                    2
                ],
                "start": 68.002,
                "end": 79.027
            },
            {
                "speaker_id": "1",
                "transcription": "이거 확인이 된 건가요?",
                "sound_type": [
                    2
                ],
                "start": 79.037,
                "end": 81.214
            }
        ]
    },
    "summary": "안철수 위원장이 소방 정책 현장 방문 등 예정됐던 일정을 모두 취소하며 인선에 대한 발표한 심기를 드러냈으며 다음 달 일본에서 열릴 4개국 쿼드 정상회의에 윤 당선인의 참석 의사에 대한 일본 언론 보도 진위 여부를 앵커가 기자에게 묻는다.",
