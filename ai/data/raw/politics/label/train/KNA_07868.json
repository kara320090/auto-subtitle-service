        "term": [
            {
                "speaker_id": "1",
                "transcription": "김승희 후보자가 선관위에 검찰 수사 의뢰 사흘 만에 입장을 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.277
            },
            {
                "speaker_id": "1",
                "transcription": "고의로 정치 자금을 사적 용도로 사용한 바 없다.",
                "sound_type": [
                    2
                ],
                "start": 4.287,
                "end": 7.858
            },
            {
                "speaker_id": "1",
                "transcription": "회계 실무자의 착오로 자신은 몰랐던 일이라고 해명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.868,
                "end": 11.739
            },
            {
                "speaker_id": "1",
                "transcription": "장관직에 대한 강한 의지를 드러낸 것으로 풀이되는데 야당은 강력 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.749,
                "end": 17.717
            },
            {
                "speaker_id": "2",
                "transcription": "정식 수사를 받게 된 초유의 사태입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.727,
                "end": 21.133
            },
            {
                "speaker_id": "2",
                "transcription": "김 후보자는 어수한 틈을 노려 요행을 바라지 말고 스스로 결단해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.143,
                "end": 25.992
            }
        ]
    },
