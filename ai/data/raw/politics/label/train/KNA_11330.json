        "term": [
            {
                "speaker_id": "1",
                "transcription": "풍력터빈 제조 세계 1위 업체인 덴마크 베스타스가 3억 달러 규모 한국 투자를 신고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.238
            },
            {
                "speaker_id": "1",
                "transcription": "한국에 터빈 부품 공장을 지을 계획인데 한국이 글로벌 기업 투자 거점으로 인정받고 있다는 걸 보여주는 거라고 대통령실은 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.248,
                "end": 16.052
            },
            {
                "speaker_id": "1",
                "transcription": "다보스포럼에 참석한 세계 주요 인사들에게 한국을 알리고 2030 부산세계박람회 유치를 위한 한국의 밤 행사도 열렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.062,
                "end": 25.395
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령은 오늘 다보스포럼 특별연설 나서 공급망 강화와 청정에너지 전환 등을 위한 협력과 연대를 제안할 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 25.405,
                "end": 33.685
            },
            {
                "speaker_id": "1",
                "transcription": "이후 취리히공대 방문 등으로 이번 순방 일정을 마무리합니다.",
                "sound_type": [
                    2
                ],
                "start": 33.695,
                "end": 38.041
            },
            {
                "speaker_id": "1",
                "transcription": "스위스 취리히에서 KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 38.051,
                "end": 41.474
            }
        ]
    },
    "summary": "다보스 포럼에 참석하여 한국의 밤 행사를 여는 등 순방일정을 안내했다.",
