        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 이해찬 대표도 초당적 협력을 이야기했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.289
            },
            {
                "speaker_id": "2",
                "transcription": "재난을 극복으로 연 예산을 뒷받침한 이례 여야가 함께 나서야 할 거라고 생각을 합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.299,
                "end": 10.241
            },
            {
                "speaker_id": "1",
                "transcription": "통합당 황교안 대표는 재정지원은 돕겠다면서도 원인은 정확히 따져봐야 한다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.251,
                "end": 16.203
            },
            {
                "speaker_id": "1",
                "transcription": "애초부터 중국발 입국금지를 하지 못한 정부에 책임이 크다며 대통령 사과를 촉구했고 박능후 강경화 장관에 경질로 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.213,
                "end": 25.100
            },
            {
                "speaker_id": "3",
                "transcription": "전쟁 중에 장수를 바꾸는 것은 바람직 하지 않다는 그런 생각에서 그동안 참고 또 참았습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.110,
                "end": 33.322
            },
            {
                "speaker_id": "3",
                "transcription": "그런데 이제 그 수준을 넘었습니다.",
