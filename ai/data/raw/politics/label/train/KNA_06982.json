        "term": [
            {
                "speaker_id": "1",
                "transcription": "석과교수라고 하는 게 없더라고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.732
            },
            {
                "speaker_id": "2",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 1.742,
                "end": 2.289
            },
            {
                "speaker_id": "1",
                "transcription": "강의 스케줄이 뭐 잘 안 맞으니까 그래서 그만하겠다 그랬어요.",
                "sound_type": [
                    2
                ],
                "start": 2.299,
                "end": 5.219
            },
            {
                "speaker_id": "3",
                "transcription": "강의가 아닌 학교 연구 활동에 도움을 주고자 임용됐다는 게 후보자 측 해명입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.229,
                "end": 11.632
            },
            {
                "speaker_id": "3",
                "transcription": "그렇다면 어떤 연구를 했을까?",
                "sound_type": [
                    2
                ],
                "start": 11.642,
                "end": 14.383
            },
            {
                "speaker_id": "3",
                "transcription": "후보자 측은 동서독 통일 과정에 대한 깊이 있는 연구를 진행했다며 당시 연구 주제와 내용들은 개인 블로그에서 확인할 수 있다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
