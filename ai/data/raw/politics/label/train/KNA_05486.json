        "term": [
            {
                "speaker_id": "1",
                "transcription": "문재인은 총살감이다. 이런 발언도 하셨어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.540
            },
            {
                "speaker_id": "2",
                "transcription": "문재인 대통령 그 심도 심하게 벌을 받을 수밖에 없다.",
                "sound_type": [
                    2
                ],
                "start": 2.540,
                "end": 6.914
            },
            {
                "speaker_id": "2",
                "transcription": "저는 그런 생각을 가지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.920,
                "end": 8.490
            },
            {
                "speaker_id": "1",
                "transcription": "차관 사퇴 요구에 대해서도 답변 거부하시겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 8.490,
                "end": 11.230
            },
            {
                "speaker_id": "2",
                "transcription": "어제 다 했지 않습니까? 저 국감서 했는데 뭘 또 왜 반복을 계속합니까?",
                "sound_type": [
                    2
                ],
                "start": 11.230,
                "end": 15.924
            },
            {
                "speaker_id": "3",
                "transcription": "민주당은 격앙된 반응을 보였습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.930,
                "end": 18.661
            },
            {
                "speaker_id": "3",
                "transcription": "경사노 위원장의 막말 극우 유튜버를 앉혀도 되는 거냐.",
                "sound_type": [
                    2
                ],
                "start": 18.671,
                "end": 22.522
            },
            {
                "speaker_id": "3",
                "transcription": "국감장에 이어 역사에서도 퇴장할 순서라며 김 위원장 자진 사퇴와 국회 모욕죄 등 고발 조치를 예고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.532,
                "end": 29.929
            }
        ]
    },
