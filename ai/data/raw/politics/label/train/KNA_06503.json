        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인은 오늘 오전 서울 통의동에 마련된 당선인 집무실로 출근했습니다.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.365
            },
            {
                "speaker_id": "1",
                "transcription": "첫 일정으로 안철수 인수위원장 권영세 부위원장 등과 만나 이번 주 안에 인수위 구성을 마무리해달라고 주문했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.375,
                "end": 14.005
            },
            {
                "speaker_id": "2",
                "transcription": "신속하게 정부 업무를 인수해서 국정 과제를 수립하고 국가 안보와 국민의 민생에 한 치의 빈틈도 생기지 않도록",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.015,
                "end": 26.099
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인은 또 모든 국정 업무는 궁극적으로 국민 통합을 위한 것이고 지역 공약을 신속하게 국정 과제에 반영하겠다며 각각 조직을 이끌 김한길 김병준 위원장을 임명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.109,
                "end": 39.951
            },
            {
                "speaker_id": "2",
                "transcription": "정부에 대한 신뢰가 형성되고 또한 어느 지역에 사느냐와 관계없이 국민들이 기회의 불이익을 받지 않도록 해야 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.961,
                "end": 51.964
            },
            {
                "speaker_id": "1",
                "transcription": "인수위의 전체적인 운영을 기획하고 국정철학 등을 논의할 기획조정분과 인수위원으로는 국민의힘 추경호 안철수 위원장의 측근인 국민의당 이태규 의원 최종학 서울대 경영대 교수가 결정됐습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 51.974,
                "end": 66.466
            }
        ]
    },
    "summary": "인수위의 전체적인 운영을 기획하고 국정철학 등을 논의할 기획조정분과 인수위원으로는 국민의힘 추경호 안철수 위원장의 측근인 국민의당 이태규 의원 최종학 서울대 경영대 교수가 결정됐다.",
