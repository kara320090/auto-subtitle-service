        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 따라 선관위는 지난해 소쿠리 투표 논란에 이어 다시 한번 감사원의 감사를 거부하게 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.486
            },
            {
                "speaker_id": "1",
                "transcription": "아울러 선관위는 특별 감사 결과에 따라 @이름1 사무총장과 @이름2 사무차장 등 현직 고위 간부 4명을 오늘 경찰청에 수사 의뢰하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.496,
                "end": 16.517
            },
            {
                "speaker_id": "1",
                "transcription": "또 부적정하게 업무를 처리한 선관위 공무원 4명에 대해 다음 주 중에 징계를 의결하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.527,
                "end": 22.841
            },
            {
                "speaker_id": "1",
                "transcription": "전 현직 선관위 직원 직원을 대상으로 배우자와 4촌 이내 친족까지 범위를 넓힌 가족 채용 전수 조사는 이번 달 중에 마무리하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.851,
                "end": 32.014
            },
            {
                "speaker_id": "1",
                "transcription": "한편 여당은 오늘 오전 선관위 결정에 앞서 상황이 이 지경까지 왔는데도 감사 기관을 취사 선택하 하겠다는 거냐며 선관위를 재차 압박했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.024,
                "end": 41.672
            },
            {
                "speaker_id": "1",
                "transcription": "당초 합동 조사를 하겠다는 외부 기관이 권익위만을 뜻한 거라면 눈 가리고 아웅 식 대국민 거짓말을 한 것이고 그게 아니라면 치부가 드러날까 태도를 바꾼 것이라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.682,
                "end": 53.060
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 야당과 세부 계획을 꼼꼼히 협의해 국회 차원에서 선관위 국정 조사를 조속히 실시하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 53.070,
                "end": 60.749
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 국회에서 KBS 뉴스 @이름3입니다.",
                "sound_type": [
                    2
                ],
                "start": 60.759,
                "end": 63.329
            }
        ]
    },
