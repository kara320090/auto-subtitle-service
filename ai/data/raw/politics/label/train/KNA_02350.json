        "term": [
            {
                "speaker_id": "1",
                "transcription": "전과 기록 7회로 무투표 당선자 가운데 가장 많습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.081
            },
            {
                "speaker_id": "1",
                "transcription": "음주 운전과 무면허 뺑소니 등으로 여섯 차례 벌금형을 선고받았고 횡령으로 징역 1년 6개월에 집행 유예 2년형을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.091,
                "end": 12.758
            },
            {
                "speaker_id": "2",
                "transcription": "개인적으로 이득을 취한 부분은 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.768,
                "end": 15.307
            },
            {
                "speaker_id": "2",
                "transcription": "과거에 있었던 모든 일들에 대해서는 크게 반성하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.317,
                "end": 18.383
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 지방 선거 당규입니다.",
                "sound_type": [
                    2
                ],
                "start": 18.393,
                "end": 20.982
            },
            {
                "speaker_id": "1",
                "transcription": "횡령으로 집행 유예 이상의 형이 확정되면 공천 대상에서 배제한다고 돼 있지만 박 후보는 심사를 통과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.992,
                "end": 28.864
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 17년 전 범죄인 점을 참작해 공천 관리위 의결로 예외를 인정했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.874,
                "end": 35.902
            }
        ]
    },
    "summary": "횡령으로 집행 유예 이상의 형이 확정되면 공천 대상에서 배제한다고 돼 있지만 박 후보는 심사를 통과했다.",
