        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "수풀 사이로 봉분 수십 개가 솟아 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.773
            },
            {
                "speaker_id": "1",
                "transcription": "자그마한 크기들 어린이들이 묻힌 곳으로 추정되는 묘비명조차 없는 무덤들입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.783,
                "end": 10.037
            },
            {
                "speaker_id": "2",
                "transcription": "쌍둥이기 때문에 좀 특이하니까 그 당시 원생들이 많이 기억을 했어요.",
                "sound_type": [
                    2
                ],
                "start": 10.047,
                "end": 16.222
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 이제 죽어서 묻힐 때 묻은 사람들이 나타났어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.232,
                "end": 20.849
            },
            {
                "speaker_id": "2",
                "transcription": "자기 쌍둥이는 묻은 기억이 있대.",
                "sound_type": [
                    2
                ],
                "start": 20.859,
                "end": 23.483
            },
            {
                "speaker_id": "1",
                "transcription": "선감학원이 폐쇄된 지 40년 진실화해위원회는 그제부터 유해 시굴 작업에 들어갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.493,
                "end": 30.574
            },
            {
                "speaker_id": "1",
                "transcription": "실체는 금세 드러났습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.584,
                "end": 32.931
            },
            {
                "speaker_id": "1",
                "transcription": "하루 만에 14개 넘는 치아와 여러 개의 단추가 발견됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.941,
                "end": 37.645
            },
            {
                "speaker_id": "1",
                "transcription": "모두 10대 피해자들의 것으로 추정됩니다.",
                "sound_type": [
                    2
                ],
                "start": 37.655,
                "end": 40.774
            }
        ]
    },
    "summary": "선감학원 시신이 묻혔다는 증언이 이어진 장소에서 조사가 시작됐는데 하루 만에 10대 피해자의 것으로 추정되는 치아가 발견됐다.",
