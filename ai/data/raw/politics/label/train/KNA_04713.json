        "term": [
            {
                "speaker_id": "1",
                "transcription": "이성윤 서울 고검장의 공소장이 본인이 받아보기도 전에 언론에 유출됐다는 의혹 시민단체 고발로 수사에 나선 고위공직자범죄수사처가 대검찰청을 압수수색 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 12.260
            },
            {
                "speaker_id": "1",
                "transcription": "공제 4호로 입건한 지 6개월만입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.270,
                "end": 15.730
            },
            {
                "speaker_id": "2",
                "transcription": "어떤 걸 중점적으로 좀 보실 거예요?",
                "sound_type": [
