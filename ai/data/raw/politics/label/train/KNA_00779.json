        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령직 인수위원회도 검찰 수사권 폐지는 헌법 파괴 행위라며 즉각 입법 추진을 중단하라고 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.712
            },
            {
                "speaker_id": "1",
                "transcription": "인수위는 또 코로나19 100일 로드맵 추진 방향에 소상공인 손실 보상을 추가하기로 했는데요.",
                "sound_type": [
                    2
                ],
                "start": 7.722,
                "end": 13.333
            },
            {
                "speaker_id": "1",
                "transcription": "자세한 소식을 인수위 연결해서 알아보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.343,
                "end": 16.236
            },
            {
                "speaker_id": "1",
                "transcription": "자 박민철 기자 검찰 수사권 폐지에 대해서 지금 검찰과 야당의 반발이 만만치 않은데 인수위도 여기에 가세한 거군요.",
                "sound_type": [
                    2
                ],
                "start": 16.246,
                "end": 24.294
            },
            {
                "speaker_id": "2",
                "transcription": "네 인수위 정무 사법 행정 분과 유상범 인수 위원이 기자회견에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.304,
                "end": 31.814
            },
            {
                "speaker_id": "2",
                "transcription": "검찰 수사권 완전 폐지는 검사에게 영장 신청권을 부여한 헌법의 취지에 정면에 정면으로 반하는 것으로 헌법 파괴 행위나 다름없다고 강하게 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.824,
                "end": 43.088
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 검찰 수사권 완전 박탈 이른바 검수완박 추진을 즉각 중단하라고 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 43.098,
                "end": 50.063
            },
            {
                "speaker_id": "2",
                "transcription": "유 의원은 또 검찰 수사권 완전 폐지는 국민 보호와는 아무런 관련이 없고 특정 인물 부패 세력을 수호하기 위해 국가의 수사 기능을 무력화하는 것이라고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 50.073,
                "end": 61.186
            },
            {
                "speaker_id": "2",
                "transcription": "대선으로 확인된 민의에 불복하는 것이라고도 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 61.196,
                "end": 64.870
            },
            {
                "speaker_id": "2",
                "transcription": "배현진 당선인 대변인은 검찰 수사권 폐지 추진에 대한 윤 당선인의 입장을 묻자 당선인은 민생 문제에 전념하겠다며 국회의 일은 국회에서 해결하는 게 맞는 것 같다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 64.880,
                "end": 78.011
            }
        ]
    },
    "summary": "대통령직 인수위원회가 검찰 수사권 폐지는 헌법 파괴 행위라며 입법 추진 중단을 요구하면서 이는 국민이 아니라 특정 인물 부패 세력을 수호하기 위해 국가의 수사 기능을 무력화하는 것이라 강하게 비판했고, 윤 당선인 대변인은 국회의 일은 국회에서 해결하는 게 맞다고 전했다.",
