        "term": [
            {
                "speaker_id": "1",
                "transcription": "세월호 참사에서 생존한 단원고 학생 @이름1 씨는 어느덧 26살의 응급 구조사가 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.533
            },
            {
                "speaker_id": "1",
                "transcription": "친구들을 그리며 써 내려간 편지를 읽자 곳곳에서 눈물이 터져 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 6.543,
                "end": 12.280
            },
            {
                "speaker_id": "2",
                "transcription": "병원에서 일하면서 단 한 번도 슬프지 않은 죽음은 없더라.",
                "sound_type": [
                    2
                ],
                "start": 12.290,
                "end": 16.804
            },
            {
                "speaker_id": "2",
                "transcription": "내 꿈에도 나와서 잘하고 있다고 인사 한번 해 주고 가.",
                "sound_type": [
                    2
                ],
                "start": 16.814,
                "end": 21.107
            },
            {
                "speaker_id": "1",
                "transcription": "김부겸 국무총리는 추도사에서 정부를 대표해 사과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.117,
                "end": 25.665
            },
            {
                "speaker_id": "3",
                "transcription": "대한민국 정부가 우리 국민의 생명을 지키지 못했습니다.",
                "sound_type": [
                    2
