        "term": [
            {
                "speaker_id": "1",
                "transcription": "당장 코로나19 국난 극복을 위한 경제 전면전을 선언하고 오늘이라도 야당을 만나 이달 중 재난지원금이 지급되도록 노력하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.570
            },
            {
                "speaker_id": "2",
                "transcription": "여야가 뜻을 모아 긴급 재난지원금 지급 방안에 통 크게 합의할 수 있도록 긴밀히 협의하고 또 준비하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.580,
                "end": 20.480
            },
            {
                "speaker_id": "1",
                "transcription": "정부 중간 평가 성격인 총선에서 승리하고 청와대 출신까지 대거 입성하면서 민주당 내 이른바 친문 영향력이 더 세질 거란 관측도 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.490,
                "end": 31.721
            },
            {
                "speaker_id": "1",
                "transcription": "당장 오는 8월 전당대회에서 이번 선거를 지휘한 @이름1 위원장의 당권 도전 여부도 관심입니다.",
                "sound_type": [
