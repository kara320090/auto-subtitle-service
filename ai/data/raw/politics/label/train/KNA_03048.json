        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러면서 미국과 영국 등 우리보다 확진자가 훨씬 많은 나라와 단순 비교를 할 수 없다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.288
            },
            {
                "speaker_id": "2",
                "transcription": "효과성과 안전성을 따져서 그리고 가격이나 여러가지 조건을 따져서 백신 계약을 하는 게 정상입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.298,
                "end": 16.011
            },
            {
                "speaker_id": "3",
                "transcription": "그러면 다른 나라는 다 비정상입니까?",
                "sound_type": [
                    2
                ],
                "start": 16.021,
                "end": 18.643
            },
            {
                "speaker_id": "2",
                "transcription": "그거야 모르죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.653,
                "end": 19.412
            },
            {
                "speaker_id": "3",
                "transcription": "허허허.",
                "sound_type": [
                    2
                ],
                "start": 19.422,
                "end": 20.226
            },
            {
                "speaker_id": "2",
                "transcription": "그건 그 나라에 가서 알아보셔야지.",
                "sound_type": [
                    2
                ],
                "start": 20.236,
                "end": 22.149
            },
            {
                "speaker_id": "1",
                "transcription": "정 총리는 평소 모습과는 달리 이번엔 여러 차례 목소리를 높여 질의를 적극 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.159,
                "end": 28.101
            },
            {
                "speaker_id": "4",
                "transcription": "대통령께서 13차례나 지시를 했다라고 담당자들한테 떠넘기는 걸로 있는데.",
                "sound_type": [
                    2
                ],
                "start": 28.111,
                "end": 34.695
            },
            {
                "speaker_id": "2",
                "transcription": "뭘 떠넘깁니까?",
                "sound_type": [
                    2
                ],
                "start": 34.705,
                "end": 35.891
            },
            {
                "speaker_id": "2",
                "transcription": "떠넘기기는",
