            },
            {
                "speaker_id": "1",
                "transcription": "공수처는 손 검사 등 소환 대상자들이 납득하기 어려운 사유로 출석을 계속 미루는 등 비협조적 태도를 보였다고 영장 청구 사유를 설명했습니다.",
                "sound_type": [
                    2
