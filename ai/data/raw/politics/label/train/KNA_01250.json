        "term": [
            {
                "speaker_id": "1",
                "transcription": "경합이었던 세종 대전까지 국민의 힘 후보가 당선되면서 국민의 힘은 광역 자치 단체장 17곳 가운데 12곳을 차지했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.664
            },
            {
                "speaker_id": "1",
                "transcription": "4년 전 선거 결과를 완전히 뒤집은 셈입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.674,
                "end": 13.803
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 대통령과 협조를 잘 해서 지역 발전에 일임을 해라.",
                "sound_type": [
                    2
                ],
                "start": 13.813,
                "end": 19.426
            },
            {
                "speaker_id": "3",
                "transcription": "아 289표 차이로 김동현 후보가 1위로 올라섭니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.436,
                "end": 23.702
            },
            {
                "speaker_id": "1",
                "transcription": "격전지 경기에서 김동현 후보가 접전 끝에 당선을 확정 지으면서 민주당은 호남권과 제주 등 다섯 곳을 차지했습니다.",
