        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 반도체의 고속도로 공약도 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.696
            },
            {
                "speaker_id": "2",
                "transcription": "고양시장 선거에서도 4년 전 설욕을 예고했던 국민의 힘 후보가 현역 시장의 재선 도전을 꺾었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.706,
                "end": 10.682
            },
            {
                "speaker_id": "2",
                "transcription": "이동환 후보는 52.1퍼센트의 득표율로 더불어 민주당 이재준 후보를 3만 5000표 정도 차이로 제쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.692,
                "end": 18.667
            },
            {
                "speaker_id": "3",
                "transcription": "대규모 반도체 기업 유치하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.677,
                "end": 21.965
            },
            {
                "speaker_id": "3",
                "transcription": "고양 시민들이",
                "sound_type": [
                    2
                ],
                "start": 21.975,
