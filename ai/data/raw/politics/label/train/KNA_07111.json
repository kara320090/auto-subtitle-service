        "term": [
            {
                "speaker_id": "1",
                "transcription": "정호영 보건 복지부 장관 후보자는 안타깝고 송구스럽다면서도 자녀의 경북대 의대 편입학이 아빠 찬스가 아니었다고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.277
            },
            {
                "speaker_id": "2",
                "transcription": "아빠 찬스를 절대로 쓸 수 없는 구조라는 것을 아마 확인하실 수 있을 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 10.287,
                "end": 16.346
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 저는 아빠 찬스에 대해서는 좀 강력하게 제가 반대를 하고 싶습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.356,
                "end": 20.437
            },
            {
                "speaker_id": "3",
                "transcription": "14만 의사들한테 부끄럽거나 죄송한 마음은 없으신가요?",
                "sound_type": [
                    2
                ],
                "start": 20.447,
                "end": 24.117
            },
            {
                "speaker_id": "2",
                "transcription": "네 제가 떳떳하다고 생각했기 때문에 이 자리까지 왔습니다.",
                "sound_type": [
                    2
                ],
