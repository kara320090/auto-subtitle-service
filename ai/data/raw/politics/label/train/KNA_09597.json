                    2
                ],
                "start": 0.000,
                "end": 8.230
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 공군이 무인기 작전 태세 두루미를 발령한 건 이로부터 약 1시간 반이 지난 뒤였습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.240,
                "end": 15.613
            },
            {
                "speaker_id": "2",
                "transcription": "발령 시간이 아주 늦었습니다.",
