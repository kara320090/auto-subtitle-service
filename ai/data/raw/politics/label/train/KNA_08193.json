        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰이 대장동 초기 개발사업을 주도했던 @이름1 전 씨세븐 대표를 참고인 신분으로 소환했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.510
            },
            {
                "speaker_id": "1",
                "transcription": "지난해 11월 대장동 전담 수사팀에서 조사를 받은 뒤 8개월 만에 다시 검찰에 출석한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.520,
                "end": 13.017
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 그 수사가 잘못된 점 뭐라고 생각하시는지?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.027,
                "end": 17.271
            },
            {
                "speaker_id": "2",
                "transcription": "끝나고 얘기해도 되는 거죠?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.281,
                "end": 19.388
            },
            {
                "speaker_id": "1",
                "transcription": "씨세븐은 2009년부터 민간 주도의 대장동 개발을 시작한 시행사로 의혹의 핵심 인물인 @이름2 변호사와 @이름3 회계사가 이 회사에서 각각 법률과 회계 자문을 맡았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.398,
                "end": 30.526
            },
            {
                "speaker_id": "2",
                "transcription": "@이름3은 이 사업의 전문가였고요.",
                "sound_type": [
                    2
                ],
                "start": 30.536,
                "end": 33.349
            },
            {
                "speaker_id": "2",
                "transcription": "@이름2은 주변인들을 이용해서 우리 사업이 정상적으로 갈 수 있게 자기가 만들겠다라고 해서",
                "sound_type": [
                    2,
                    4
                ],
                "start": 33.359,
                "end": 39.706
            }
        ]
    },
    "summary": "검찰이 대장동 초기 개발사업을 주도했던 @이름1 전 씨세븐 대표를 참고인 신분으로 소환했는데 지난해 11월 대장동 전담 수사팀에서 조사를 받은 뒤 8개월 만에 다시 검찰에 출석한 것이다.",
