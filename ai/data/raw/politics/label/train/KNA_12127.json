        "term": [
            {
                "speaker_id": "1",
                "transcription": "4월 중에 재난 지원금을 지급하겠다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.391
            },
            {
                "speaker_id": "1",
                "transcription": "이번엔 민주당이 여야 회동을 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.401,
                "end": 5.399
            },
            {
                "speaker_id": "2",
                "transcription": "4월 중에 지급을 마칠 수 있도록 임시 국회를 총선이 끝나는 즉시 소집해서",
                "sound_type": [
                    2
                ],
                "start": 5.409,
                "end": 12.920
            },
            {
                "speaker_id": "1",
                "transcription": "긴급 재정 경제 명령권 발동도 대통령에게 건의해 보겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.930,
                "end": 18.199
            },
            {
                "speaker_id": "1",
                "transcription": "중대한 위기 상황에서 국회를 열 수 없을 때 대통령이 재정 경제상의 처분을 할 수 있도록 한 권한인데 통합당이 주장했던 내용입니다.",
                "sound_type": [
                    2
                ],
                "start": 18.209,
                "end": 27.416
            },
            {
                "speaker_id": "3",
                "transcription": "긴급 명령권을 더해 가지고서 하면은 정당의 예산을 가져가 투입을 할 수가 있습니",
                "sound_type": [
                    2
                ],
                "start": 27.426,
                "end": 32.999
            }
        ]
    },
    "summary": "이번엔 민주당이 여야 회동을 제안해 긴급 재정 경제 명령권 발동도 대통령에게 건의해 보겠다고 했다.",
