        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "4명이 출사표를 던진 정의당 대선 경선.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.317
            },
            {
                "speaker_id": "1",
                "transcription": "지난 19대 대선에서 심상정 후보가 6퍼센트를 얻었지만 이번 대선에선 양당 대결 속에 흥행을 일으키지 못하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.327,
                "end": 11.662
            },
            {
                "speaker_id": "1",
                "transcription": "당 대표를 지낸 심상정, 이정미 후보는 거대양당 기득권 사이 대안이 되겠다고 거듭 호소했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.672,
                "end": 18.798
            },
            {
                "speaker_id": "2",
                "transcription": "거대양당 어 대선 테이블에는 화천대유와 고발 사주밖에 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.808,
                "end": 24.173
            },
            {
                "speaker_id": "2",
                "transcription": "부동산 투기 확실하게 잡을 수 있는 후보 저 심상정입니다.",
                "sound_type": [
                    2
                ],
                "start": 24.183,
                "end": 28.036
            },
            {
                "speaker_id": "3",
                "transcription": "기후위기, 불평등 그리고 모든 차별을 해소해 달라는 이 시대 정신에 양당 기득권 체제가 이제까지 해결해 주지 못했던 문제들을 정의당이 해결할 수 있다.",
                "sound_type": [
                    2
                ],
                "start": 28.046,
                "end": 38.114
            },
            {
                "speaker_id": "1",
                "transcription": "경기도당 위원장 황순식 후보와 당 부대표를 지낸 김윤기 후보.",
                "sound_type": [
                    2
                ],
                "start": 38.124,
                "end": 42.875
            },
            {
                "speaker_id": "1",
                "transcription": "70년대생인 이 둘은 세대 교체와 변화를 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.885,
                "end": 47.188
            },
            {
                "speaker_id": "4",
                "transcription": "신뢰 회복을 위해서는 우리가 확실히 변한다는 것을 보여주어야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 47.198,
                "end": 52.146
            },
            {
                "speaker_id": "4",
                "transcription": "그것은 대표 선수를 교체하는 것부터 시작이 될 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 52.156,
                "end": 56.024
            },
            {
                "speaker_id": "5",
                "transcription": "기득권과 맞서 싸워겠다는 매운 맛 정의당이 언제 이렇게 순한 맛이 되어버렸습니까?",
                "sound_type": [
                    2
                ],
                "start": 56.034,
                "end": 62.150
            },
            {
                "speaker_id": "5",
                "transcription": "정의당부터 변해야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 62.160,
                "end": 63.797
            }
        ]
    },
    "summary": "정의당 대선 경선에서 4명이 출사표를 던졌고 당 대표를 지낸 심상정, 이정미 후보는 거대양당 기득권 사이 대안이 되겠다고 거듭 호소했고 경기도당 위원장 황순식 후보와 당 부대표를 지낸 김윤기 후보는 세대 교체와 변화를 강조했습니다.",
