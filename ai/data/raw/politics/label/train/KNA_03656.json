        "term": [
            {
                "speaker_id": "1",
                "transcription": "공소권 유보부 이첩 이런 것들이 현행 형사소송법에 존재하지 않는 절차고 저 공수처법에도 존재하지 않는 것이에요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.070
            },
            {
                "speaker_id": "2",
                "transcription": "검찰이 자기들이 기소권까지도 행사하겠다 이거는 법을 어기는 발상이죠.",
                "sound_type": [
                    2
                ],
                "start": 8.070,
                "end": 12.031
            },
            {
                "speaker_id": "2",
                "transcription": "자기들은 이미 검찰은 고위공직자에 대해서는 수사권도 없고 기소권도 없어요.",
                "sound_type": [
                    2
                ],
