        "term": [
            {
                "speaker_id": "1",
                "transcription": "그동안 정부는 일본 측과 여러 차례 협의를 거치며 의견 차를 좁혀 왔다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.103
            },
            {
                "speaker_id": "1",
                "transcription": "때문에 이 자리에서 정부 검토안이 구체적으로 공개될 거로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.113,
                "end": 10.045
            },
            {
                "speaker_id": "1",
                "transcription": "외교부는 한일 천부권 협정의 혜택을 본 한국 기업을 포함해 양국 기업이 기금을 만들고 전범 기업 대신 강제 동원 피해자 지원 재단이 이 기금으로 피해자들에게 배상금을 지급하는 방식을 검토해 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.055,
                "end": 24.201
            },
            {
                "speaker_id": "1",
                "transcription": "강제 동원 재단도 이를 위한 사전 준비로 재단 정권을 개정하고 포스코와는 40억 원 규모의 기금 출현을 논의하고 있습니",
                "sound_type": [
