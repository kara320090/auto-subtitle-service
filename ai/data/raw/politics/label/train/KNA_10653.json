        "term": [
            {
                "speaker_id": "1",
                "transcription": "2주 뒤로 다가온 설 명절을 맞아 국민의힘과 정부 민간이 민생 안정 대책을 내놨습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.867
            },
            {
                "speaker_id": "1",
                "transcription": "당정은 먼저 설 연휴 성수품의 물가 안정을 위해 역대 최대 규모로 성수품을 공급하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.877,
                "end": 14.866
            },
            {
                "speaker_id": "1",
                "transcription": "또 농 축 수산물 할인 쿠폰과 유통 업체 할인 노력을 통해 국민들의 장바구니 부담을 최소화하도록 하겠다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.876,
                "end": 23.218
            },
            {
                "speaker_id": "1",
                "transcription": "특히 온누리 상품권은 예산이 5000억 원이 늘어 4조 원 규모로 발행되며 모바일 카드형도 신설됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.228,
                "end": 31.159
            },
            {
                "speaker_id": "1",
                "transcription": "협의회에 참석한 대형 마트 측 관계자도 설 성수품을 30퍼센트에서 최대 50퍼센트까지 할인하겠다는 의사를 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.169,
                "end": 40.644
            },
            {
                "speaker_id": "2",
                "transcription": "정부가 추진하고 계시는 여러 정책들을 적극 협조할 것이고",
                "sound_type": [
                    2
                ],
                "start": 40.654,
                "end": 44.411
            }
        ]
    },
