                    2
                ],
                "start": 2.196,
                "end": 3.421
            },
            {
                "speaker_id": "1",
                "transcription": "정부의 대책이 없었던 거지",
                "sound_type": [
                    2
                ],
                "start": 3.431,
                "end": 5.552
            },
            {
                "speaker_id": "2",
                "transcription": "잘하셨다고 이제 평가도 받지만 그것도 좀 늦었다 이런 또 시장에서의 솔직한 평가도 있다는 점",
                "sound_type": [
