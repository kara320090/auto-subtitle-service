        "term": [
            {
                "speaker_id": "1",
                "transcription": "외교부가 고용한 대미 자문회사 이른바 로비 업체 명단입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.280
            },
            {
                "speaker_id": "1",
                "transcription": "올해 5개의 미국 회사와 계약을 맺고 23억 원이 넘는 예산을 편성했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.290,
                "end": 9.823
            },
            {
                "speaker_id": "1",
                "transcription": "미 의회 관련 사항 법안이나 제도에 대한 자문을 받는 계약입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.833,
                "end": 14.737
            },
            {
                "speaker_id": "1",
                "transcription": "그런데도 정작 인플레이션 감축법에 대한 동향 보고는 제대로 받지 못했던 것으로 드러났습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.747,
                "end": 20.954
            }
        ]
    },
    "summary": "우리 정부가 수십억 원을 들여 미국 로비업체들까지 고용해 놓고도 인플레이션 감축법에 대한 동향 보고는 제대로 받지 못했던 것으로 드러났다.",
