        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "절대로 못 마십니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.560
            },
            {
                "speaker_id": "2",
                "transcription": "반면 국민의힘은 윤석열 대통령이 김대중 대통령의 정신을 이어받아 어려운 결단을 내린 것이라며 추켜세웠습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.570,
                "end": 10.084
            },
            {
                "speaker_id": "3",
                "transcription": "한일 관계에 있어서 김대중 정신이고 김대중식 결단이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.094,
                "end": 15.206
            },
            {
                "speaker_id": "3",
                "transcription": "저는 이러한 결단을 이어 나간 게 윤석열 대통령이다.",
                "sound_type": [
                    2
                ],
                "start": 15.216,
                "end": 18.994
            },
            {
                "speaker_id": "2",
                "transcription": "독도와 위안부 합의 등 논란 대부분은 사실이 아니라며 적극 방어했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.004,
                "end": 24.265
            },
            {
                "speaker_id": "3",
                "transcription": "이번 정상회담에서 독도 문제가 거론되었나요?",
                "sound_type": [
                    2
                ],
                "start": 24.275,
                "end": 27.772
            },
            {
                "speaker_id": "1",
                "transcription": "안 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.782,
                "end": 29.169
            },
            {
                "speaker_id": "3",
                "transcription": "독도에 디귿 자도 나오지 않았죠?",
                "sound_type": [
                    2
                ],
                "start": 29.179,
                "end": 31.150
            },
            {
                "speaker_id": "1",
                "transcription": "안 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.160,
                "end": 32.049
            },
            {
                "speaker_id": "3",
                "transcription": "한일 위안부 합의에 대해서는 얘기가 나왔죠?",
                "sound_type": [
                    2
                ],
                "start": 32.059,
                "end": 36.023
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 그게 의제로써 논의된 바는 전혀 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.033,
                "end": 39.939
            }
        ]
    },
    "summary": "국민의힘은 김대중 정신을 이어받았다며 추켜 세웠고 독도와 위안부 합의 등 논란 대부분이 사실이 아니라고 방어했다.",
