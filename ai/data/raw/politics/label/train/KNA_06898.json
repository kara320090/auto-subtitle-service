        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 서울에서는 전 당 대표를 탈락시키겠다고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.379
            },
            {
                "speaker_id": "1",
                "transcription": "이게 무슨 고무줄 잣대입니까.",
                "sound_type": [
                    2
                ],
                "start": 3.389,
                "end": 6.370
            },
            {
                "speaker_id": "2",
                "transcription": "이른바 정세균계로 공천 배제를 결정한 이원욱 당 전략 공천 위원장은 혁신 공천을 흔들지 말라고 맞섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.380,
                "end": 14.902
            },
            {
                "speaker_id": "3",
                "transcription": "노영민은 되고 송영길은 탈락이냐.",
                "sound_type": [
                    2
                ],
                "start": 14.912,
                "end": 17.097
            },
            {
                "speaker_id": "3",
                "transcription": "이건 그 공정하지 않다라고 말씀하시는 거는 저희로서는 참으로 받아들이기가 어렵고",
                "sound_type": [
                    2
                ],
                "start": 17.107,
                "end": 21.574
            },
            {
                "speaker_id": "2",
                "transcription": "당내에선 박영선 전 장관의 전략 공천 가능성도 거론되는 가운데 민주당은 오늘 밤 회의를 열어 공천 배제 문제에 대한 결론을 내기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.584,
                "end": 31.916
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름1입니다.",
