        "term": [
            {
                "speaker_id": "1",
                "transcription": "마지막까지 중환자실로 가지 않고 다인실에서 있을 수는 없기 때문에 결국은 1인실 가야 되는데 큰 비용이 들지요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.456
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 대부분의 병원이 1인실도 자리가 있는 경우가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.466,
                "end": 9.784
            },
            {
                "speaker_id": "1",
                "transcription": "결국에는 마지막 임종 직전에 옮겨지는 곳이 바로 처치실입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.794,
                "end": 15.197
            },
            {
                "speaker_id": "1",
                "transcription": "처치실이라는 것은 간호사실 옆에 물품을 쌓아 놓는 공간이거든요.",
                "sound_type": [
                    2
                ],
                "start": 15.207,
                "end": 19.087
            },
            {
                "speaker_id": "1",
                "transcription": "병원에서 임종이 이렇게 이루어집니",
                "sound_type": [
                    2
