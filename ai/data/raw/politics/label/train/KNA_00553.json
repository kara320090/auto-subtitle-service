        "term": [
            {
                "speaker_id": "1",
                "transcription": "인수위는 코로나19 방역 체계 개편 구상도 발표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.135
            },
            {
                "speaker_id": "1",
                "transcription": "안철수 인수 위원장은 현 정부 방역 전 정책을 정치 방역이라고 규정하면서 과학 방역으로 전환하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.145,
                "end": 12.505
            },
            {
                "speaker_id": "1",
                "transcription": "재택 치료의 대면 진료로 전환 고위험군 최우선 검사 등 방역 관련 7개 권고사항을 현 정부에 전달하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.515,
                "end": 21.835
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 삼청동 인수위 사무실에서 KBS 뉴스 김성수입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.845,
                "end": 26.618
            },
            {
                "speaker_id": "2",
                "transcription": "코로나19 소식입니다.",
                "sound_type": [
                    2
                ],
                "start": 26.628,
                "end": 28.789
            },
            {
                "speaker_id": "2",
                "transcription": "국내 누적 확진자 수가 오늘로 천만 명을 넘었습니다.",
