        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 많은 분들이 저희 퇴근을 축하해주니 저는 정말 행복합니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 7.205
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 제 아내와 전임 대통령으로서 정말 복이 좋구나라는 소리를 들을 수 있도록 잘 살아보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 7.215,
                "end": 22.025
            },
            {
                "speaker_id": "2",
                "transcription": "문 대통령은 국립 현충원과 효창공원 독립유공자 묘역 참배로 임기 마지막 날 일정을 시작했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.035,
                "end": 29.587
            },
            {
                "speaker_id": "2",
                "transcription": "이어 퇴임 연설을 했는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.597,
                "end": 31.661
            },
            {
                "speaker_id": "2",
                "transcription": "지난 5년 여러 위기를 헤쳐오면서 그 과정을 위대한 국민들과 함께 해 영광스럽다고 했습니다.",
                "sound_type": [
                    2
