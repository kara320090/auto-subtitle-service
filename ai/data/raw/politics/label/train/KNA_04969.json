        "term": [
            {
                "speaker_id": "1",
                "transcription": "반인간 인도적 범죄 행위로까지 규정하시는 건 좀 과도한 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.998
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 그분이 16명을 죽인 건 그러면 인도적인 건가요?",
                "sound_type": [
                    2
                ],
                "start": 5.008,
                "end": 8.254
            },
            {
                "speaker_id": "2",
                "transcription": "이들의 범죄 사실은 당시 감청 정보와 당사자 진술 등을 바탕으로 5개 합동 심문조의 일치된 의견이었다고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.264,
                "end": 17.300
            },
            {
                "speaker_id": "2",
                "transcription": "살인 등 중대 범죄자는 보호 대상자로 결정하지 않을 수 있다는 북한 이탈 주민법 조항도 고려했다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.310,
                "end": 25.492
            }
        ]
    },
    "summary": "북한 이탈 주민의 범죄 사실은 당시 합동 심문조의 일치된 의견었고 중대 범죄자는 보호 대상자로 결정하지 않을 수 있다는 북한 이탈주민법 조항도 고려했다고 했다.",
