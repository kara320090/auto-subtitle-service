        "term": [
            {
                "speaker_id": "1",
                "transcription": "하물며 논문의 경우를 몰래 따간다면 그리고 자기 것으로 만들었다면은 이걸 도둑질이라고 평가하는 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.592
            },
            {
                "speaker_id": "2",
                "transcription": "국민대 교수들의 공개 반발도 확산되고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.602,
                "end": 12.133
            },
            {
                "speaker_id": "3",
                "transcription": "일반적인 기준 또는 국민들의 눈높이를 봤을 때 어 좀 납득하기 어려운 결정이다.",
                "sound_type": [
                    2
                ],
                "start": 12.143,
                "end": 18.094
            },
            {
                "speaker_id": "4",
                "transcription": "@이름1 씨 논문을 표절이 아니다라고 얘기하는 것이 과연 공정한가.",
                "sound_type": [
                    2
                ],
                "start": 18.104,
                "end": 24.287
            },
            {
                "speaker_id": "2",
                "transcription": "급기야 국민대 교수회는 오는 12일 총회까지 열기로 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.297,
                "end": 28.551
            },
            {
                "speaker_id": "2",
                "transcription": "국회 교육위 소속 민주당 의원들은 국민대를 방문해 논문을 재검토한 위원회의 회의록 등을 공개하라고 요구했지만 국민대는 거부했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.561,
                "end": 37.971
            }
        ]
    },
    "summary": "김 여사의 논문에 대해 국민대 교수들의 공개 반발이 확산되고 국회 교육위 소속 민주당 의원들은 국민대를 방문해 논문을 재검토한 위원회의 회의록 등을 공개하라고 요구했지만 국민대는 거부했다.",
