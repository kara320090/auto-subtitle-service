        "term": [
            {
                "speaker_id": "1",
                "transcription": "민심의 역풍을 불러올 뿐입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.783
            },
            {
                "speaker_id": "2",
                "transcription": "민주당은 일단 정우영 원희룡 후보자에 대해 고발 방침까지 밝히며 강경한 자세를 유지하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.793,
                "end": 10.566
            },
            {
                "speaker_id": "3",
                "transcription": "인사권자인 대통령의 독선과 전횡을 민주당이 막을 방도는 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.576,
                "end": 17.117
            },
            {
                "speaker_id": "3",
                "transcription": "하지만 명백한 불법 혐의의 후보자들에게는 법적 책임을 물어야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 17.127,
                "end": 23.930
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 청문회 정국이 장기화되며 새 정부 발목 잡기로 비치는 점은 부담이기 때문에 여론의 추이를 살피고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.940,
                "end": 31.498
            }
        ]
    },
    "summary": "민주당이 윤석열 내각 후보자에 대한 고발 방침을 밝히며 강경한 자세를 취하고 있으나 청문회 정국이 장기화되며 새 정부 발목 잡기라는 여론에 부담을 느끼고 있다는 소식이다.",
