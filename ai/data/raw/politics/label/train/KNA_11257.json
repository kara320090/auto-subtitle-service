        "term": [
            {
                "speaker_id": "1",
                "transcription": "친윤계 의원들을 향해 윤핵관이라며 비판해온 안철수 후보 SNS에 글을 올렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.687
            },
            {
                "speaker_id": "1",
                "transcription": "대통령실 고위 관계자라는 익명을 통해 윤심이 있다 없다는 기사가 나오지 않도록 해달라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.697,
                "end": 12.092
            },
            {
                "speaker_id": "1",
                "transcription": "지금 상황을 대통령실의 선거 개입으로 규정하며 정당민주주의 근본을 훼손한다고 직격탄을 날렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.102,
                "end": 18.689
            },
            {
                "speaker_id": "1",
                "transcription": "안철수는 윤심 아니라는 보도 등을 겨냥한 발언입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.699,
                "end": 23.000
            },
            {
                "speaker_id": "1",
                "transcription": "대통령실은 공개 경고에 나섰습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.010,
                "end": 25.669
            },
            {
                "speaker_id": "1",
                "transcription": "예고 없이 국회를 찾은 이진복 정무수석은 대통령실 개입 주장은 굉장히 잘못된 것이라고 했습니다.",
                "sound_type": [
                    2,
