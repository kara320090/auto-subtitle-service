        "term": [
            {
                "speaker_id": "1",
                "transcription": "국가는 우리 국민을 지키지 못했고 정부는 고인을 월북자로 몰아 고인과 유족들의 명예를 땅에 떨어뜨렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.803
            },
            {
                "speaker_id": "2",
                "transcription": "대통령의 역할에 대해 국민들께 사실 관계를 답하는 것은 의무이자 도리입니다.",
                "sound_type": [
