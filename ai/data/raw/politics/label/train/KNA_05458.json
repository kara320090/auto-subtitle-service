        "term": [
            {
                "speaker_id": "1",
                "transcription": "국가 보훈처는 국가 보훈부로 격상하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.377
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 종합적 체계적 보훈 정책을 추진하고 국가 보훈 체계 위상을 강화하기 위함이라고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.387,
                "end": 10.564
            },
            {
                "speaker_id": "1",
                "transcription": "외교부 장관 소속으로 재외 동포청도 신설됩니다.",
                "sound_type": [
                    2
                ],
                "start": 10.574,
                "end": 14.594
            },
            {
                "speaker_id": "1",
                "transcription": "재외 동포 대상 지원 정책 기능을 강화하고 관계 부처 협업을 통한 영사와 법무 병무 등 원스톱 민원 서비스를 제공하게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 14.604,
                "end": 23.824
            },
            {
                "speaker_id": "1",
                "transcription": "정부안 대로 개편되면 현 18부 4처 18청 6위원회는 18부 3처 19청 6위원회로 바뀌고 국무 위원 수는 여가부가 1명 줄지만 보훈부가 1명 늘어 18명이 유지됩니다.",
                "sound_type": [
