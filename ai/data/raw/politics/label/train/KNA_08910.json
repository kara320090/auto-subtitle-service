                    2
                ],
                "start": 25.421,
                "end": 29.677
            },
            {
                "speaker_id": "1",
                "transcription": "CCTV가 없는 상황에서 사고 원인을 추정할 수 있는 단서가 될 수 있다고 보고 있습니다.",
