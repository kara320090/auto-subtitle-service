        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령실은 한국 정부에 대한 미 정보 기관에 도감청 정황과 관련해 미국 측과 필요한 협의를 할 예정이라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.536
            },
            {
                "speaker_id": "1",
                "transcription": "미국 정부의 항의나 진상 파악을 위한 설명 요청 계획이 있느냐는 질문에는 과거 전례와 다른 나라의 사례를 검토하겠다고만 답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.546,
                "end": 16.024
            },
            {
                "speaker_id": "1",
                "transcription": "지난해 11월 우리 정부가 미군에 포탄을 제공하기로 한 것과 관련해 결국 미국을 통해 우회적으로 우크라이나의 살상 무기를 지원하는 게 아니냐는 논란이 이른 바 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.034,
                "end": 26.129
            },
            {
                "speaker_id": "1",
                "transcription": "동맹국에 대한 도감청 정황이 모두 사실이라면 국제 사회에서 미국에 대한 신뢰도 하락은 불가피합니다.",
                "sound_type": [
                    2
                ],
                "start": 26.139,
                "end": 32.915
            },
            {
                "speaker_id": "1",
                "transcription": "외교 관계에도 타격을 줄 거라는 관측이 제기되는 가운데 윤석열 대통령은 이달 하순 미국을 국빈 방문합니다.",
                "sound_type": [
                    2
                ],
