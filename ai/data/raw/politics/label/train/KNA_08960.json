        "term": [
            {
                "speaker_id": "1",
                "transcription": "침대와 책상만으로 가득 차 버린 고시원 29살 @이름1 씨의 집입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.810
            },
            {
                "speaker_id": "1",
                "transcription": "집안 사정 때문에 17살부터 혼자 살며 생계 꾸려오다 지난해 기초 생활 수급자가 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.820,
                "end": 12.597
            },
            {
                "speaker_id": "2",
                "transcription": "코피가 심하게 터져서 응급실에 갔는데 입원까지 하게 되었던 거죠.",
                "sound_type": [
                    2
                ],
                "start": 12.607,
                "end": 17.939
            },
            {
                "speaker_id": "2",
                "transcription": "그 신용 대출을 갚고자 이제 마이너스 통장을 처음 만들게 되었죠.",
                "sound_type": [
                    2
                ],
                "start": 17.949,
                "end": 22.491
            },
            {
                "speaker_id": "2",
                "transcription": "지금은 한 2800 700 그 정도 남아 있는 걸로",
                "sound_type": [
                    2
                ],
                "start": 22.501,
                "end": 26.233
            },
            {
                "speaker_id": "1",
                "transcription": "나라에서 주는 주거 급여 20여만 원로 월세를 내는데 자활 근로 일수가 하루라도 늘어 소득이 올라가면 주거 급여를 받을 수 없습니다.",
                "sound_type": [
                    2
                ],
