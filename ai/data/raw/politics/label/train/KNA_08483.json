        "term": [
            {
                "speaker_id": "1",
                "transcription": "해도 해도 끝이 없는 거잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.354
            },
            {
                "speaker_id": "1",
                "transcription": "이런 부분들을 국회와 상의도 없이 그리고 국민들의 여론 수렴 과정 없이 했다라는 건 심각하게 문제가 아닐 수 없다.",
                "sound_type": [
                    2
                ],
                "start": 1.364,
                "end": 12.527
            },
            {
                "speaker_id": "2",
                "transcription": "경호처는 입장을 밝히지 않았고 대통령실만 해명을 내놓았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.537,
                "end": 17.221
            },
            {
                "speaker_id": "2",
                "transcription": "해당 예산은 벽면 수리나 전구 교체 등 노후 시설 보수 관리를 위한 살림살이용 예산이라며 용산 이전이나 추가 리모델링과 무관하다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.231,
                "end": 27.906
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 운영비를 더한 예산을 과거와 비교하면 이전 정부가 더 많을 때도 있었다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.916,
                "end": 34.300
            }
        ]
    },
    "summary": "국회와의 상의 그리고 국민 여론 수렴 과정 없이 했다는 것은 심각한 문제라고 했고 대통령실은 용산 이전이나 추가 리모델링과 무관하며 과거와 비교해 이전 정부가 더 많을 때도 있었다고 해명했다.",
