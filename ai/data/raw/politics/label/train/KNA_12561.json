        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 지사 대법원 선고는 대부분 방송사들이 생중계했고 시청률 합계는 12퍼센트를 넘었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.086
            },
            {
                "speaker_id": "1",
                "transcription": "그만큼 관심이 많았단 얘기입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.096,
                "end": 8.509
            },
            {
                "speaker_id": "1",
                "transcription": "차기 대선주자 선호도에서도 2자릿 수 상승세를 보이고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.519,
                "end": 12.791
            },
            {
                "speaker_id": "1",
                "transcription": "특히 재난지원금 지급 주장 등 코로나 대응 정국에서 더욱 주목을 끌었는데 최근엔 부동산 문제 등 전국적 이슈에도 목소리를 내고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.801,
                "end": 22.465
            },
            {
                "speaker_id": "2",
                "transcription": "성공하면 전국으로 확대할 수 있도록 토지 보유에 따른 세금으로 기본소득을 지급하는 사업을 해보도록 하겠습니다.",
                "sound_type": [
