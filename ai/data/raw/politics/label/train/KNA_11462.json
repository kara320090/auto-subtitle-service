        "term": [
            {
                "speaker_id": "1",
                "transcription": "이른바 민주당 전당대회 돈봉투 의혹과 관련해 무소속 이성만 의원이 검찰에 출석했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.227
            },
            {
                "speaker_id": "1",
                "transcription": "지난달 12일 돈 봉투 관련 압수수색 이후 1달 넘게 지나 이뤄진 소환으로 현역 국회의원을 부른 건 이번이 처음입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.237,
                "end": 14.660
            },
            {
                "speaker_id": "1",
                "transcription": "이 의원은 자신에 대한 혐의를 전면 부인했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.670,
                "end": 18.162
            },
            {
                "speaker_id": "1",
                "transcription": "혐의에 대해선 전부 다 인정하지 않는 입장이신 거죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.172,
                "end": 21.786
            },
            {
                "speaker_id": "2",
                "transcription": "예 저는 돈 준 사실이 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.796,
                "end": 24.150
            },
            {
                "speaker_id": "2",
                "transcription": "예 전달한 사실이 없어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.160,
                "end": 25.925
            }
        ]
    },
    "summary": "민주당 전당대회 돈 봉투 의혹을 수사 중인 검찰이 현역 국회의원으로는 처음으로 이성만 의원을 소환했고 이 의원은 혐의를 전면 부인했다.",
