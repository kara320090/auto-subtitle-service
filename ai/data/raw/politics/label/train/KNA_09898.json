        "term": [
            {
                "speaker_id": "1",
                "transcription": "무겁게 느끼고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.002
            },
            {
                "speaker_id": "1",
                "transcription": "그 점에 대해서 너무나 죄송하게 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 1.012,
                "end": 3.577
            },
            {
                "speaker_id": "2",
                "transcription": "한발 늦은 대책 일단 내일부터 비극이 이어진 인천 미추홀구의 전세 사기 피해 주택 2400여 세대에 대한 경매 절차가 미뤄집니다.",
                "sound_type": [
                    2
                ],
                "start": 3.587,
                "end": 13.101
            },
            {
                "speaker_id": "2",
                "transcription": "추가 지원책을 마련할 때까지 시간을 벌겠다는 취지입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.111,
                "end": 17.205
            },
            {
                "speaker_id": "2",
                "transcription": "다만 다른 방안에 대해선 협의가 더 필요하다는 입장입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.215,
                "end": 21.493
            },
            {
                "speaker_id": "2",
                "transcription": "피해자들이 경매에서 우선 낙찰받을 권리는 다른 입찰자의 재산권을 침해할 수 있어 추가 검토가 필요하고 법안도 개정해야 한다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 21.503,
                "end": 30.697
            }
        ]
    },
