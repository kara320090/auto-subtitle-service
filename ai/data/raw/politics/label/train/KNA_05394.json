        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 기본적 삶이 보장되도록",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.497
            },
            {
                "speaker_id": "2",
                "transcription": "또 개헌 필요성을 언급하며 다음 총선에서 개헌 국민 투표를 함께 치르자고 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.507,
                "end": 9.017
            },
            {
                "speaker_id": "2",
                "transcription": "국정 연속성을 높이기 위해 5년 단임제 대신 4년 중임제를 도입하자고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.027,
                "end": 15.386
            },
            {
                "speaker_id": "2",
                "transcription": "이 대표의 연설에 민주당 의원들은 박수로 화답했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.396,
                "end": 20.366
            },
            {
                "speaker_id": "2",
                "transcription": "반면 국민의힘 의원들은 항의하거나 냉담한 태도를 보였습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.376,
                "end": 25.291
            }
        ]
    },
    "summary": "이 대표는 다음 총선에서 개헌 국민 투표 그리고 4년 중임제 도입을 제안하였고 민주당 의원들은 박수로 화답했으나 국민의힘 의원들은 항의하거나 냉담한 태도를 보였다.",
