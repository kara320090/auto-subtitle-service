        "term": [
            {
                "speaker_id": "1",
                "transcription": "병원 유치 공약 이행률은 12퍼센트 각종 유치 공약 중 최저 수준입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.045
            },
            {
                "speaker_id": "2",
                "transcription": "이게 정부랑 협상 과정에서 약간 뭐 뭐 속도 조절이라고 해야 될까요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.055,
                "end": 10.832
            },
            {
                "speaker_id": "3",
                "transcription": "비용 지출보다도 뭐 100배는 더 어렵죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.842,
                "end": 13.290
            },
            {
                "speaker_id": "3",
                "transcription": "뭐 밑 빠진 독에 물 붓기가 되는 수밖에 없죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.300,
                "end": 15.864
            },
            {
                "speaker_id": "1",
                "transcription": "예산을 확보했다는 재정공약은 2400여 건 그러나 뜯어볼 필요가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.874,
                "end": 21.677
            },
            {
                "speaker_id": "1",
                "transcription": "전주 아중호수에 관광단지를 조성하겠다는 공약 1억 원 넘게 확보해 연구용역에 들어갔다고 했지만 아직 기본 구상을 만드는 수준입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.687,
                "end": 32.038
            },
            {
                "speaker_id": "4",
                "transcription": "여 어떻게 할 것인지에 대한 큰 구상이죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 32.048,
                "end": 35.895
            },
            {
                "speaker_id": "4",
                "transcription": "그 기본 구상 가지고 진짜 경제성으로 있는지 없는지 또 나와야 되는 거니까",
                "sound_type": [
                    2,
                    4
                ],
                "start": 35.905,
                "end": 40.874
            }
        ]
    },
