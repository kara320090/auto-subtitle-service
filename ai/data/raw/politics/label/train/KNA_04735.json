        "term": [
            {
                "speaker_id": "1",
                "transcription": "완성을 넘어서서 책임을 져야 될 때가 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.484
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 우리가 미래로 나아가고 경제가 성장하고 성장한 질서가 유지되는 그런 사회 공정 사회로 가야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 2.494,
                "end": 11.090
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1 위원장은 일하는 정당과 지도자가 필요하다며 합류 배경을 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.100,
                "end": 17.146
            },
            {
                "speaker_id": "2",
                "transcription": "이틀째 충청권을 방문 중인 윤석열 후보는 청주 공항을 찾아 중북권 거점 공항으로서의 역할을 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.156,
                "end": 25.271
            },
            {
                "speaker_id": "2",
                "transcription": "이어 우수 강소기업 등을 찾아 지역 산업 발전에 관한 입장을 밝히고 청년 창업자와 청년 예술인 등은 만났습니다.",
                "sound_type": [
