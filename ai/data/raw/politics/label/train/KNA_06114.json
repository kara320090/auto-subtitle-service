        "term": [
            {
                "speaker_id": "1",
                "transcription": "과거 진행된 공공기관 이전에 대한 엇갈린 평가는 넘어야 할 산입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.408
            },
            {
                "speaker_id": "1",
                "transcription": "공공기관을 옮겨만든 10개 혁신도시 목표 인구를 채우지 못했고 가족과 함께 이주한 공공기관 직원은 67퍼센트 수준입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.418,
                "end": 15.540
            },
            {
                "speaker_id": "1",
                "transcription": "인구가 늘었다지만 수도권이 아닌 주변에서 대부분 흡수됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.550,
                "end": 20.775
            },
            {
                "speaker_id": "2",
                "transcription": "마치 도시 건설 게임을 하듯이 아무것도 없는 지역에 아파트 짓고 공공기관 짓고 해서 사람들을 내려보내고 그랬었는데 과연 그 기획이 얼마나 성공했는가에 대해서도 좀 비판적으로 성찰을 해봐야 될 필요가 있고",
                "sound_type": [
                    2
