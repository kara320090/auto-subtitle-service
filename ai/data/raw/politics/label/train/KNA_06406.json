        "term": [
            {
                "speaker_id": "1",
                "transcription": "물론 어선을 파괴하는 게 더 심각하겠죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.166
            },
            {
                "speaker_id": "2",
                "transcription": "역량 중심으로 진영 관계없이 쓰는 국민 내각 또는 통합 정부 연합 정부 이런 것들이 꼭 필요하다.",
                "sound_type": [
                    2
                ],
                "start": 3.176,
                "end": 10.890
            },
            {
                "speaker_id": "1",
                "transcription": "그거 제가 제일 먼저 한 이야기입니다.",
                "sound_type": [
                    2
                ],
                "start": 10.900,
                "end": 13.402
            },
            {
                "speaker_id": "3",
                "transcription": "두 후보의 배우자 의혹을 지적한 심상정 후보는 차별 금지법과 공공 기관 노동 이사제 등을 집중 제기하며 차별화를 시도했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.412,
                "end": 22.813
            },
            {
                "speaker_id": "4",
                "transcription": "차별 금지법을 적극적으로 추진하겠다 이렇게 이야기를 했는데요.",
                "sound_type": [
                    2
                ],
                "start": 22.823,
                "end": 26.577
            },
            {
                "speaker_id": "4",
                "transcription": "어떡하실 겁니까?",
