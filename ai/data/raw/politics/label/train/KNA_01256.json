        "term": [
            {
                "speaker_id": "1",
                "transcription": "내일 의원 총회를 열고 비상 지도 체제를 꾸린 후 새 지도부를 구성하기로 했는데 초선 의원들은 오늘이라도 바로 의총을 열어야 한다고 촉구했습니다.",
                "sound_type": [
                    2,
