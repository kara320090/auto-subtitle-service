        "term": [
            {
                "speaker_id": "1",
                "transcription": "경제 위기를 극복하는 계기가 되기를 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.997
            },
            {
                "speaker_id": "2",
                "transcription": "당초 유력시 됐던 이명박 전 대통령과 김경수 전 경남 지사는 제외됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.007,
                "end": 9.713
            },
            {
                "speaker_id": "2",
                "transcription": "대통령실 고위 관계자는 이 전 대통령 등에 대한 국민 여론이 나쁜 점 등을 고려했다고 설명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.723,
                "end": 15.653
            },
            {
                "speaker_id": "2",
                "transcription": "낮은 국정 지지율도 부담으로 작용한 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.663,
                "end": 19.634
            },
            {
                "speaker_id": "2",
                "transcription": "이런 상황을 고려해 찬반이 엇갈리는 정치인을 사면에서 배제하고 대신 경제 위기 극복이라는 메시지를 강조한 것으로 풀이됩니다.",
                "sound_type": [
