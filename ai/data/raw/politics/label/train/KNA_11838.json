        "term": [
            {
                "speaker_id": "1",
                "transcription": "총선 준비에 한 발 앞선 민주당.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.218
            },
            {
                "speaker_id": "1",
                "transcription": "연동형 비례제 도입으로 어려운 선거가 됐다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.228,
                "end": 6.084
            },
            {
                "speaker_id": "2",
                "transcription": "비례대표에는 저희가 한 10석 가까이 말하자면 양보를 한 셈입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.094,
                "end": 11.993
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 지역구에서 그 이상을 더 많이 확보를 해야 되기 때문에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.003,
                "end": 16.274
            },
            {
                "speaker_id": "1",
                "transcription": "현역 의원에 대한 당 내 평가를 이미 마친 민주당은 외부 인사가 절반 이상 포함된 공천관리위원회를 구성해 오늘 첫 회의를 열었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.284,
                "end": 24.368
            },
            {
                "speaker_id": "3",
                "transcription": "다양성이라고 하는 부분이 그래도 가장 중요한",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.378,
                "end": 27.660
            }
        ]
    },
    "summary": "민주당은 연동형 비례제 도입으로 어려운 선거가 됐다고 했고 외부 인사가 절반 이상 포함된 공천관리위원회를 구성해 오늘 첫 회의를 열었다.",
