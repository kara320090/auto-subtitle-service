        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 정부에 법치 물란 행위의 진상을 낱낱이 규명해 재발 방지 대책을 마련해 나가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.059
            },
            {
                "speaker_id": "2",
                "transcription": "반면 국민의힘은 이재명 대표 수사는 정적이 아닌 도적을 제거하기 위한 수사라고 일축했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.069,
                "end": 13.858
            },
            {
                "speaker_id": "2",
                "transcription": "이 대표의 거듭된 영수 회담 제안이 방탄용 아니냐는 의혹도 제기했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.868,
                "end": 19.375
            },
            {
                "speaker_id": "3",
                "transcription": "도를 황금으로 바꿔준 신의 손 이재명 대표님.",
                "sound_type": [
                    2
                ],
                "start": 19.385,
                "end": 23.128
            },
            {
                "speaker_id": "3",
                "transcription": "당신의 그 대담성을 부인하는 양심이 무섭습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.138,
                "end": 27.527
            }
        ]
    },
