        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 전 검찰 총장을 키웠다는 책임론도 제기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.323
            },
            {
                "speaker_id": "2",
                "transcription": "늠름한 장군으로 갔는데 돌아올 때는 패잔병으로 돌아온 거 아닙니까?",
                "sound_type": [
                    2
                ],
                "start": 4.333,
                "end": 8.571
            },
            {
                "speaker_id": "3",
                "transcription": "징계 청구 해놓고 낱낱이 해부하지 않았다면 이 지금처럼 장모 구속도 있을 수가 없었고요.",
                "sound_type": [
                    2
                ],
                "start": 8.581,
                "end": 16.262
            },
            {
                "speaker_id": "4",
                "transcription": "우리는",
                "sound_type": [
                    2
                ],
                "start": 16.272,
                "end": 17.189
            },
            {
                "speaker_id": "5",
                "transcription": "원팀",
                "sound_type": [
                    2
                ],
                "start": 17.199,
                "end": 18.284
            },
            {
                "speaker_id": "1",
                "transcription": "토론에 앞서 민주당은 협약식을 열고 미래지향적 경선을 다짐했지만 달라진 점은 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.294,
                "end": 25.715
            },
            {
                "speaker_id": "1",
                "transcription": "야권에선 국민의힘 최재형 전 감사원장이 계파 갈등의 폐해를 언급하며 윤석열 예비 후보에게 공개 회동을 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.725,
                "end": 35.678
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보 측은 당장 응할 문제는 아니라며 응답하지 않았습니다.",
                "sound_type": [
                    2
                ],
