        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 피해 의원에 대한 보호조치를 제대로 하지 않은 책임을 물어 정읍시의회를 국가인권위원회에 제소하기로 했습니다.",
                "sound_type": [
