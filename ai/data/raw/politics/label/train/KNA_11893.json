        "term": [
            {
                "speaker_id": "1",
                "transcription": "가이드라인을 함께 만들어 갈 생각입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.544
            },
            {
                "speaker_id": "2",
                "transcription": "당정청도 긴급 대응에 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.554,
                "end": 5.242
            },
            {
                "speaker_id": "2",
                "transcription": "3조 4000억 원 규모의 예비비를 투입해 방역과 검역 특히 소상공인 등 피해 기업을 지원하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.252,
                "end": 12.817
            },
            {
                "speaker_id": "2",
                "transcription": "피해 기업에 대해선 세금 납부 기한을 연장하고 세무조사도 유예해주는 방안을 추진하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.827,
                "end": 19.120
            },
            {
                "speaker_id": "2",
                "transcription": "당정청은 중국 후베이성 외 지역으로 입국 금지를 확대하는 방안에 대해서도 가능성을 열어뒀습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.130,
                "end": 26.072
            },
            {
                "speaker_id": "3",
                "transcription": "후베이성뿐 아니라 주변 지역의 상황도 면밀히 확인하면서 양국 간 협력 하에 필요한 조치를 취해 나갈 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.082,
                "end": 35.068
            }
        ]
    },
    "summary": "당정청은 3조 4000억 원 규모의 예비비를 투입해 방역과 검역 특히 소상공인 등 피해 기업을 지원하기로 했고 중국 후베이성 외 지역으로 입국 금지를 확대하는 방안에 대해서도 가능성을 열어뒀다.",
