        "term": [
            {
                "speaker_id": "1",
                "transcription": "비대위 체제로 가거나 임시 전당 대회를 열어 새 지도부를 뽑자는 목소리도 있었지만 혼란을 최소화하자는데 의견이 모인 걸로 풀이됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.505
            },
            {
                "speaker_id": "2",
                "transcription": "비대위 구성이라든가 아 또 임시 전당 대회 개최 등을 주장한 의원님들이 있었습니다 만은 그 야말로 소수의 목소리에 그쳤다는 말씀을 드리겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.515,
                "end": 22.792
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 대표의 당원권이 정지되는 6개월 동안 직무 대행 체제가 이어질지 미지수입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.802,
                "end": 28.690
            },
            {
                "speaker_id": "1",
                "transcription": "권성동 당 대표 직무 대행으로 정치 상황 변화에 따라 대행 체제가 얼마나 갈지 예측하기 쉽지 않다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.700,
                "end": 36.495
            },
            {
                "speaker_id": "1",
                "transcription": "이런 가운데 이 대표는 공개 행보 없이 나흘째 잠행을 이어갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.505,
                "end": 41.238
            },
            {
                "speaker_id": "3",
                "transcription": "어 이준석 대표가 사퇴 할 뜻은 전혀 없는 것을 제가 알고 있고 이제 어제 확인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.248,
                "end": 46.182
            },
            {
                "speaker_id": "1",
                "transcription": "공헌했던 윤리위 재심 정부나 가처분 신청 등 대응 방안과 관련해 조만간 입장을 낼 거라는 관측도 나옵니다 KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.192,
                "end": 56.189
            }
        ]
    },
