                    2
                ],
                "start": 5.084,
                "end": 9.194
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 정작 질문지에는 자신이 대표 발의한 법안이나 자유한국당 바른정당 통합 여부에 대한 의견을 물었습니다.",
                "sound_type": [
                    2
