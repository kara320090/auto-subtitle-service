        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 얘기하고 있는데 그거 맞는 얘기입니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.987
            },
            {
                "speaker_id": "2",
                "transcription": "지금 단계에서는 어 뭐 어떤 근거도 없는 이야기라 이렇게 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.997,
                "end": 12.656
            },
            {
                "speaker_id": "3",
                "transcription": "진영 행안부 장관은 총선 연기론에 대해서는 여야 공감대가 우선이라며 검토한 바 없다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.666,
                "end": 19.694
            },
            {
                "speaker_id": "3",
                "transcription": "앞서 당정은 방역 체계 보강과 중소 상공인 피해 지원 등을 위해 2015년 메르스 사태 당시 편성됐던 6조 2000억 원을 웃도는 추경 예산안을 마련하기로 했습니다.",
                "sound_type": [
