        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 한 거짓말은 아니지 않",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.729
            },
            {
                "speaker_id": "2",
                "transcription": "아니 그러니까 내가 안 했다는 말로 또 넘어가잖아요.",
                "sound_type": [
                    2
                ],
                "start": 1.739,
                "end": 4.819
            },
            {
                "speaker_id": "1",
                "transcription": "저는 사실 11시 회의 그런 자체도 보도 자료도 내용을 모릅니다.",
                "sound_type": [
                    2
                ],
                "start": 4.829,
                "end": 10.091
            },
            {
                "speaker_id": "2",
                "transcription": "허 참 용산구 아주 큰일 났어. 예?",
                "sound_type": [
                    2
                ],
                "start": 10.101,
                "end": 12.631
            },
            {
                "speaker_id": "2",
                "transcription": "책임자가 저런 말을 할 저렇게 어떻게 태연하게 할 수가 있어요?",
                "sound_type": [
                    2
                ],
                "start": 12.641,
                "end": 17.169
            },
            {
                "speaker_id": "2",
                "transcription": "예?",
                "sound_type": [
                    2
                ],
                "start": 17.179,
                "end": 18.477
            },
            {
                "speaker_id": "3",
                "transcription": "박 구청장은 수사를 앞두고 휴대 전화를 교체한 데 대해 증거 인멸 의도가 없었다고 거듭 부인했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.487,
                "end": 25.959
