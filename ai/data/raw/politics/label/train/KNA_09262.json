        "term": [
            {
                "speaker_id": "1",
                "transcription": "김만배 기자하고 조금 다툰 적이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.433
            },
            {
                "speaker_id": "1",
                "transcription": "얼마 안 있다가 이제 정진상 실장한테 전화가 왔어요.",
                "sound_type": [
                    2
                ],
                "start": 3.443,
                "end": 6.937
            },
            {
                "speaker_id": "1",
                "transcription": "나보고 잘하라 그러더라고요.",
                "sound_type": [
                    2
                ],
                "start": 6.947,
                "end": 8.926
            },
            {
                "speaker_id": "1",
                "transcription": "그 왜 잘해야 되느냐 그랬더니 생각보다 세다.",
                "sound_type": [
                    2
                ],
                "start": 8.936,
                "end": 12.781
            },
            {
                "speaker_id": "1",
                "transcription": "이거 네가 잘해야지 그러더라고요.",
                "sound_type": [
                    2
                ],
                "start": 12.791,
                "end": 15.135
            },
            {
                "speaker_id": "2",
                "transcription": "유 전 본부장은 법조 기자 출신인 김만배 씨가 이 대표의 사법 리스크 관리를 위해 필요했던 인물이라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.145,
                "end": 23.404
            },
            {
                "speaker_id": "2",
                "transcription": "그러나 이 또한 재판에서 밝힐 부분이라며 구체적 언급은 피했습니다.",
                "sound_type": [
                    2
