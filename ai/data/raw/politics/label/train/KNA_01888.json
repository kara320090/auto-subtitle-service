        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인도 어 거기에 대해서 부정적인 자세를 취하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.996
            },
            {
                "speaker_id": "1",
                "transcription": "진상규명을 위해 어떤 조치라도 해야한다 이렇게 말했는데요.",
                "sound_type": [
                    2
                ],
                "start": 4.006,
                "end": 7.699
            },
            {
                "speaker_id": "1",
                "transcription": "다만 양측이 이 대장동 특검을 통해 겨냥하는 바가 서로 다르기 때문에 국회에서 특검합의가 잘 나올지에 대해서는 예단이 어렵습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.709,
                "end": 15.765
            },
            {
                "speaker_id": "1",
                "transcription": "보도에 강병수 기자입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.775,
                "end": 18.273
            },
            {
                "speaker_id": "2",
                "transcription": "대장동 의혹을 다룰 특검 도입에 대한 의견을 묻는 질문에 윤석열 당선인 이렇게 답변했습니다.",
                "sound_type": [
