            },
            {
                "speaker_id": "2",
                "transcription": "어떻게 지금 재원을 만들었는지 그 부분을 저희들이 알고 뭐 임해야 될 거 아니겠습니까?",
                "sound_type": [
                    2
                ],
                "start": 6.334,
                "end": 13.745
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 그런 부분들 어 정확하게 좀 해나가겠습니다.",
