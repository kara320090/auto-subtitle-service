        "term": [
            {
                "speaker_id": "1",
                "transcription": "12월 2일부터 일회용 컵 보증금제가 시작됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.236
            },
            {
                "speaker_id": "1",
                "transcription": "시행 지역은 전국이 아니라 제주와 세종 두 곳입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.246,
                "end": 7.187
            },
            {
                "speaker_id": "1",
                "transcription": "적용 대상은 매장 수가 100개 이상인 커피 제빵 패스트푸드 아이스크림 음료 판매점입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.197,
                "end": 14.542
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 제주와 세종 지역의 해당 매장에서는 일회용 컵을 사용할 경우 보증금 300원을 내야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 14.552,
                "end": 21.743
            },
            {
                "speaker_id": "1",
                "transcription": "컵을 다시 반납하면 보증금을 돌려받을 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.753,
                "end": 25.193
            },
            {
                "speaker_id": "1",
                "transcription": "반납 장소는 판매처와 상관없이 같은 브랜드 매장에만 반납할 수 있도록 바꿨습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.203,
                "end": 31.064
            }
        ]
    },
