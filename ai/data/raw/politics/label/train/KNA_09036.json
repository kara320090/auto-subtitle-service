                ],
                "start": 7.469,
                "end": 12.462
            },
            {
                "speaker_id": "1",
                "transcription": "유동규 전 성남도시개발공사 본부장을 통해 대장동 사업자들로부터 1억 4천만 원의 뒷돈을 받았다는 혐의입니다.",
                "sound_type": [
                    2
