        "term": [
            {
                "speaker_id": "1",
                "transcription": "도리어 다시 집권하겠다고 나서고 있으니 저는 참으로 어이가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.465
            },
            {
                "speaker_id": "2",
                "transcription": "정부 정책의 가장 큰 실책으로는 부동산 정책을 꼽았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.475,
                "end": 9.744
            },
            {
                "speaker_id": "2",
                "transcription": "능력과 책임 개념은 없는 3무에 세금과 규제 감시 폭탄의 3탄 불만 불신 불안만 남은 3불이었다며 즉시 폐기하라고 요구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.754,
                "end": 19.963
            },
            {
                "speaker_id": "2",
                "transcription": "대신 실거주 1주택자에는 양도세와 보유세 인하를 추진하고 재산세 특례 기준과 양도세 비과세 기준은 12억 원으로 올리겠다고 국민의힘 대안을 제시했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.973,
                "end": 30.934
            },
            {
                "speaker_id": "2",
                "transcription": "또 민주당이 추진하는 언론중재법 개정안이 통과되면 최대 수혜자는 문재인 대통령이 되고 권력 비리 의혹 사건들은 철저히 감춰질 것이라고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.944,
                "end": 40.567
            },
            {
                "speaker_id": "1",
                "transcription": "저희 국민의힘 언론재갈법 끝까지 막아낼 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 40.577,
                "end": 45.032
            },
            {
                "speaker_id": "1",
                "transcription": "언론의 자유 국민들의 알 권리 반드시 지켜나갈 것입",
                "sound_type": [
                    2
                ],
                "start": 45.042,
                "end": 49.716
            }
        ]
    },
    "summary": "정부 정책의 가장 큰 실책으로는 부동산 정책을 꼽았고 실거주 1주택자에는 양도세와 보유세 인하를 추진 재산세 특례 기준과 양도세 비과세 기준은 12억 원으로 올리겠다고 대안을 제시했으며 언론재갈법 끝까지 막아낼 것이라고 국민의힘 측은 밝혔다.",
