        "term": [
            {
                "speaker_id": "1",
                "transcription": "수도권에서의 빅 매치 성사 여부에도 관심이 쏠리고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.719
            },
            {
                "speaker_id": "1",
                "transcription": "손서영 기자입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.729,
                "end": 5.911
            },
            {
                "speaker_id": "2",
                "transcription": "안철수 인수위원장의 보궐 선거 출마가 가시화되는 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.921,
                "end": 11.559
            },
            {
                "speaker_id": "2",
                "transcription": "경기지사 선거에 나선 김은혜 의원 지역구였던 경기 분당 갑에 출마하는 걸로 생각을 정리 중인 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.569,
                "end": 19.660
            },
            {
                "speaker_id": "2",
                "transcription": "이르면 이번 주 중에 입장을 밝힐 거란 관측도 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 19.670,
                "end": 24.012
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 지역 민심이 우호적이라고 판단하고 있는데 민주당 이재명 고문을 향한 도발적인 발언도 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.022,
                "end": 31.745
            },
            {
                "speaker_id": "3",
                "transcription": "본인의 최대 치적 대장동이 포함된 분당 갑 지역구에서 초밥과 소고기",
                "sound_type": [
                    2
                ],
                "start": 31.755,
                "end": 38.972
            }
        ]
    },
    "summary": "안철수 인수위원장이 경기 분당 갑 지역구 보궐 선거 출마 입장을 이번 주에 밝힐 거란 관측도 나오는데 국민의힘은 지역 민심이 우호적이라고 판단하고 있고 민주당 이재명 고문을 향한 도발적인 발언도 했다.",
