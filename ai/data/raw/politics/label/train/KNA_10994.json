        "term": [
            {
                "speaker_id": "1",
                "transcription": "이른바 아빠 찬스 의혹 등으로 사퇴한 @이름1 후보자에 이어 지명됐지만 박 장관은 임명 전부터 음주운전 전력과 논문 표절 조교 갑질 의혹 등이 제기됐습니다.",
                "sound_type": [
                    2,
