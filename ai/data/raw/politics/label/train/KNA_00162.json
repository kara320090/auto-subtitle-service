        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 정권이 추진하는 불종적인 대북 정책으로 평화를 얻기는커녕 우리 안보가 충분히 채 위협받고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.597
            },
            {
                "speaker_id": "2",
                "transcription": "윤 후보는 말로 외치는 평화가 아닌 힘을 통한 평화를 구축하겠다며 모든 수단을 강구하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.607,
                "end": 18.416
            },
            {
                "speaker_id": "2",
                "transcription": "동시에 북한이 비핵화에 나서면 평화 협정을 준비하고 전폭적으로 협력하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.426,
                "end": 25.159
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 후보는 홍준표 의원 유승민 전 의원이 구술했다는 내용에 배우자 김건희 씨 통화 녹음 파일에 대해선 상처받은 분들에게 늘 죄송하게 생각한다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.169,
                "end": 36.752
            },
            {
                "speaker_id": "2",
                "transcription": "정의당 심상정 후보는 고시원 청년들을 만나 반지하 옥탑방 고시원에서 벗어날 수 있게 주거 급여를 확대하겠다고 약속했고 국민의 당 안철수 후보는 한국석유공사 울산 석유비축기지를 찾아 원전과 신재생 에너지가 함께 가야 한다는 에너지 믹스 정책 구상을 발표했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.762,
                "end": 56.651
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 방준원입니다.",
                "sound_type": [
                    2
                ],
                "start": 56.661,
                "end": 59.634
            },
            {
                "speaker_id": "3",
                "transcription": "이재명 더불어민주당 대선 후보와 윤석열 국민의힘 대선 후보 간 양자 TV 토론 방송을 중지해 달라며 안철수 국민의 당 대선 후보가 지상파 3사를 상대로 낸 방송 금지 가처분 신청 사건의 결론이 늦어도 26일에는 내려질 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 59.644,
                "end": 77.478
            },
            {
                "speaker_id": "4",
                "transcription": "서울 서부 지법 민사 합의 21부는 오늘 이 사건의 심문기일을 열어 안 후보 측과 방송 3사의 의견을 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 77.488,
                "end": 85.657
            },
            {
                "speaker_id": "4",
                "transcription": "재판부는 복잡하고 어려운 사안은 아니지만 판단의 여지가 많고 고려할 부분이 많다고 생각한다며 늦어도 26일까지 결정을 내리겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 85.667,
                "end": 96.629
            }
        ]
    },
    "summary": "윤석열 후보는 평화를 심상정 후보는 주거 급여 확대를 안철수 후보는 에너지 믹스 정책을 구상하고 있으며 추가로 안 후보는 지상파 3사를 상대로 방송 금지를 신청했고 26일 전에는 결과가 나올 것으로 보인다.",
