        "term": [
            {
                "speaker_id": "1",
                "transcription": "인적이 드문 새벽 인천공항.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.039
            },
            {
                "speaker_id": "1",
                "transcription": "한 여성이 전동 카트를 몰고 면세 구역 여기저기를 돌아다닙니다.",
                "sound_type": [
                    2
                ],
                "start": 2.049,
                "end": 6.670
            },
            {
                "speaker_id": "1",
                "transcription": "잠시 내려 영업이 끝난 카페도 둘러봅니다.",
                "sound_type": [
                    2
                ],
                "start": 6.680,
                "end": 10.592
            },
            {
                "speaker_id": "1",
                "transcription": "마치 공항직원인 양 카트를 몰고 다닌 이 여성의 정체.",
                "sound_type": [
                    2
                ],
                "start": 10.602,
                "end": 14.978
            },
            {
                "speaker_id": "1",
                "transcription": "입국이 거부돼 돌아가야 할 외국인입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.988,
                "end": 18.206
            },
            {
                "speaker_id": "1",
                "transcription": "카트를 세우고 송환 대기 장소로 돌아갔다가 이내 다시 걸어나오지만 제지하는 사람은 없습니다.",
                "sound_type": [
