        "term": [
            {
                "speaker_id": "1",
                "transcription": "의원 총회에서 의견을 모았기 때문에 상임 전국 위원회와 전국 위원회를 통해서 어 당헌 당규를 해석하고 그 다음에 비대 위원장을 어 선출하고 추인하고 하는 그런 절차를 밟을 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 12.269
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 비대위 전환이 순조로울지는 여전히 미지수입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.279,
                "end": 16.226
            },
            {
                "speaker_id": "2",
                "transcription": "앞서 최고 위원들이 잇따라 사퇴 의사를 밝히면서 오늘 오전 예정됐던 최고 위원회는 열리지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.236,
                "end": 22.864
            },
            {
                "speaker_id": "2",
                "transcription": "김용태 정미경 최고 위원은 당헌 당규상 근거가 없다며 비대위 전환에 명시적으로 반대의 뜻을 밝히기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.874,
                "end": 30.798
            },
            {
                "speaker_id": "2",
                "transcription": "홍준표 대구 시장은 한발 더 나아가 지도부가 총사퇴하고 원내 대표를 새로 뽑아 이준석 대표 체제의 공백을 메꿔나가는 게 정도라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.808,
                "end": 40.496
            },
            {
                "speaker_id": "2",
                "transcription": "이 같은 사퇴 요구에 권 원내 대표는 별다른 입장을 내놓지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 40.506,
                "end": 45.264
            },
            {
                "speaker_id": "2",
                "transcription": "이런 가운데 이준석 대표는 고민이 많을 땐 당원 가입을 하면 된다는 글을 SNS에 올리며 또 다시 당원 가입을 독려했습니다.",
                "sound_type": [
                    2
                ],
                "start": 45.274,
