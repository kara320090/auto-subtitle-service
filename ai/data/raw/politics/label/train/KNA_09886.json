        "term": [
            {
                "speaker_id": "1",
                "transcription": "배 아픈 건 좀 어떠세요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.976
            },
            {
                "speaker_id": "1",
                "transcription": "은근히 아파요?",
                "sound_type": [
                    2
                ],
                "start": 0.986,
                "end": 2.668
            },
            {
                "speaker_id": "2",
                "transcription": "이런 가정 호스피스 의료 지원 혜택은 연간 800명 남짓 한 해 임종한 사람의 약 0.2퍼센트에게만 주어집니다.",
                "sound_type": [
                    2
                ],
                "start": 2.678,
                "end": 11.813
            },
            {
                "speaker_id": "2",
                "transcription": "강 씨는 여기에 간병이 가능한 아내가 있어 익숙하고 편안한 집에서 임종을 기다릴 수 있게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.823,
                "end": 18.323
            },
            {
                "speaker_id": "3",
                "transcription": "이동 변기에다 다 보고 다 그냥 집에서는 뭐든지 편안하니까 마음도 편한 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 18.333,
                "end": 24.488
            },
            {
                "speaker_id": "3",
                "transcription": "일주일에 두 번 선생님 오시니까 그때 기다리고 엄청 기다려요.",
                "sound_type": [
                    2
                ],
                "start": 24.498,
                "end": 28.329
            },
            {
                "speaker_id": "2",
                "transcription": "우리나라 65세 이상 성인의 임종 선호 장소 1위는 집이지만 현실은 정반대입니다.",
                "sound_type": [
                    2
                ],
                "start": 28.339,
                "end": 34.768
            }
        ]
    },
    "summary": "우리나라 65세 이상 성인의 임종 선호 장소 1위는 집이지만 현실은 정반대이다.",
