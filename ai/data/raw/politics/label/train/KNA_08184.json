        "term": [
            {
                "speaker_id": "1",
                "transcription": "소수의 의견을 가로막는 방식이 아니라 다수의 의견을 모으는 방식 동시에 소수의 의견을 존중하는 방식으로 어 민주주의가 개진되고 또 정당이 운영되는 것이 매우 옳다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.447
            },
            {
                "speaker_id": "2",
                "transcription": "자유로운 소통을 강조한 것이다 이렇게 좀 이해해 주시면 좋겠고요.",
                "sound_type": [
                    2
                ],
                "start": 10.457,
                "end": 14.647
            },
            {
                "speaker_id": "3",
                "transcription": "이 후보가 인천 계양 을 보궐 선거에 자신을 공천하도록 박지현 전 비대위원장에게 요구했다는 이른바 셀프 공천 의혹을 놓고도 공방이 오갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.657,
                "end": 25.347
            },
            {
                "speaker_id": "4",
                "transcription": "당이 불러서 내가 계양 을에 어쩔 수 없이 나갔다.",
                "sound_type": [
                    2
                ],
                "start": 25.357,
                "end": 28.009
            },
            {
                "speaker_id": "4",
                "transcription": "나도 어려운 거 결전을 한 거다라고 얘기를 했는데 뜻밖으로 이게 정치적 이중 플레이였구나.",
                "sound_type": [
                    2
                ],
                "start": 28.019,
                "end": 33.581
            },
            {
                "speaker_id": "2",
                "transcription": "제가 공천권을 가진 사람이 아니기 때문에 그걸 셀프 공천이라고 할 수는 없는 것이구요.",
                "sound_type": [
                    2
                ],
                "start": 33.591,
                "end": 39.123
            },
            {
                "speaker_id": "2",
                "transcription": "어 저도 의견을 낸 건 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.133,
                "end": 40.840
            }
        ]
    },
    "summary": "이 후보가 인천 계양 을 보궐 선거에 자신을 공천하도록 박지현 전 비대위원장에게 요구했다는 이른바 셀프 공천 의혹을 놓고도 공방이 오갔다.",
