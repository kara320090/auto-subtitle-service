        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰이 신호를 통제하고 잠시 뒤 대통령 차량이 지나갑니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 0.000,
                "end": 4.723
            },
            {
                "speaker_id": "1",
                "transcription": "집무실이 옮겨온 용산은 이제 이런 일상을 받아들여야 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.733,
                "end": 9.118
            },
            {
                "speaker_id": "1",
                "transcription": "주민들에게는 이 변화가 어떻게 다가올까?",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 9.128,
                "end": 12.452
            },
            {
                "speaker_id": "1",
                "transcription": "우선 상인들은 반기는 분위기입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 12.462,
                "end": 15.261
            },
            {
                "speaker_id": "2",
                "transcription": "그래도 대통령이 사시는 동네니까 지방 사람들이 많이 보지 오지 않을까 기대는 하고 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.271,
                "end": 21.154
            },
            {
                "speaker_id": "1",
                "transcription": "대통령이 이 가게에 올 거라고 기대하시는게 있을까요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.164,
                "end": 24.517
            },
            {
                "speaker_id": "3",
                "transcription": "어 아마도 오시지 않겠어요 오시면 좋죠.",
                "sound_type": [
                    2
                ],
                "start": 24.527,
                "end": 27.660
            }
        ]
    },
    "summary": "새로운 대통령 집무실 인근 지역 주민들의 심정을 인터뷰하고 있다.",
