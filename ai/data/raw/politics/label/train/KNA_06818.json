        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난해 말 행정 안전부와 진실 화해 위원회가 올해 정부 예산안에 골령골 유전자 감식 사업비 6억여 원을 책정해 제출했고 국회 행정 안전 위원회에서 18억 원으로 증액됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.465
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 예산 결산 위원회에서 전액 삭감됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.475,
                "end": 15.514
            },
            {
                "speaker_id": "2",
                "transcription": "유해를 발굴하고 나서 어 가족의 품에 돌려드려야 된다는 것은 저는 당연한 국가의 의무라고 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 15.524,
                "end": 22.160
            },
            {
                "speaker_id": "2",
                "transcription": "그걸 할 수 있는 기회를 다 놓쳐 버리게 되는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 22.170,
