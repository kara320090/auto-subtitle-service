                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "새 정부의 과제로 꼽았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.016
            },
            {
                "speaker_id": "1",
                "transcription": "청와대의 권한을 분산하는 책임총리제에 대해서도 의지를 드러냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.026,
                "end": 7.148
            },
            {
                "speaker_id": "1",
                "transcription": "주요 부처 장관 후보자 인선도 속도를 낼 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.158,
                "end": 10.481
            },
            {
                "speaker_id": "1",
                "transcription": "이어서 강나루 기자입니다.",
                "sound_type": [
                    2
                ],
                "start": 10.491,
                "end": 13.793
            },
            {
                "speaker_id": "2",
                "transcription": "소감을 밝히는 자리에서 한덕수 후보자는 자신이 생각하는 새 정부의 4대 과제를 제시했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.803,
                "end": 20.899
            },
            {
                "speaker_id": "2",
                "transcription": "국익 외교와 강한 국방 재정 건전성 확보 국제수지 흑자 유지 그리고 높은 국가 생산력 유지를 꼽았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.909,
                "end": 29.788
            },
            {
                "speaker_id": "2",
                "transcription": "15년 전 총리직을 수행한 한 후보자는 책임총리제에 대한 분명한 입장도 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 29.798,
                "end": 36.462
            },
            {
                "speaker_id": "2",
                "transcription": "청와대에 집중된 권한을 내각으로 분산시킬 필요가 있다는 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 36.472,
                "end": 41.196
            },
            {
                "speaker_id": "3",
                "transcription": "이것이 결국은 에 행정부 전체의 운영에 훨씬 더 효율적이겠다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 41.206,
                "end": 47.409
            },
            {
                "speaker_id": "3",
                "transcription": "그 부분에 대해서는 당연히 예 동의하는.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 47.419,
                "end": 50.668
            },
            {
                "speaker_id": "2",
                "transcription": "한 후보자는 탈원전 정책 폐기에 동의하고 부동산 공급 확대에는 단기적 가격 상승을 고려해 방법론에서 신중해야 한다고 하는 등 주요 현안에 대해 에두르지 않고 입장을 내놨습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 50.678,
                "end": 64.112
            },
            {
                "speaker_id": "2",
                "transcription": "일자리와 교육 주택 의료 연금을 국민 행복에 직결되는 문제로 밝히고 협치와 통합도 여러 번 강조했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 64.122,
                "end": 73.070
            },
            {
                "speaker_id": "3",
                "transcription": "방법론으로써의 협치 통합 이것도 굉장히 중요한 이 정책 성공의 요소가 될 거다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 73.080,
                "end": 80.887
            },
            {
                "speaker_id": "2",
                "transcription": "한 후보자는 지난 주말 윤 당선인과 샌드위치 회동을 하며 주요 장관 후보자에 대한 인선도 논의했습니다.",
                "sound_type": [
                    2
                ],
                "start": 80.897,
                "end": 88.088
            }
        ]
    },
    "summary": "한덕수 국무총리 후보자가 소감 및 자신의 입장을 밝히고 있다.",
