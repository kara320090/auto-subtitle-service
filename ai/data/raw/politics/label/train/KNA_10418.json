        "term": [
            {
                "speaker_id": "1",
                "transcription": "1998년부터 1번 2010년부터 내리 3번 총 4번의 임기를 채운 유덕렬 전 서울 동대문구청장.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.007
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 퇴임식 분위기는 좋지 않았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.017,
                "end": 11.911
            },
            {
                "speaker_id": "2",
                "transcription": "분통이 터지고 기가 막혀서 에 잠을 못 이룰 때가 한두 번이 아니었는데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.921,
                "end": 19.203
            },
            {
                "speaker_id": "1",
                "transcription": "수사는 지난해 8월 본격화됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.213,
                "end": 22.470
            },
            {
                "speaker_id": "1",
                "transcription": "경찰은 유 전 구청장이 직원들 승진을 미끼로 뒷돈을 받았다는 혐의를 잡았습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.480,
                "end": 29.062
            },
            {
                "speaker_id": "1",
                "transcription": "최소 3명 이상의 직원들이 승진 대가로 돈을 건넸다는 취지의 진술을 한 것으로 전해졌습니다.",
                "sound_type": [
