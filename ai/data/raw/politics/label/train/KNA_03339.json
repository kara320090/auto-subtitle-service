            },
            {
                "speaker_id": "2",
                "transcription": "이어진 코로나 일구 대응 논의",
                "sound_type": [
                    2
                ],
                "start": 7.075,
                "end": 9.821
            },
            {
                "speaker_id": "1",
                "transcription": "4차 재난지원금은 최대한 넓고 두텁게 지원돼야 할 것이라고 봅니다.",
