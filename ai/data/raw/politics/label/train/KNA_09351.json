        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 협상 타결에 필요한 정부의 동의가 이뤄지지 않자 김 의장이 강행 처리 의지까지 내비치는 강수를 둔 것으로 풀이됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.332
            },
            {
                "speaker_id": "1",
                "transcription": "예산안 동의의 열쇠를 쥔 대통령실을 향한 압박인 셈입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.342,
                "end": 13.243
            },
            {
                "speaker_id": "1",
                "transcription": "국회의장실 관계자는 이번 주말까지는 예산안을 처리하겠다는 의장의 의지가 확고하다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.253,
                "end": 20.224
            },
            {
                "speaker_id": "1",
                "transcription": "정치권에선 의장의 최후통첩이 교착 상태에 빠진 예산안 협상의 전기가 될 수 있다는 기대도 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.234,
                "end": 27.482
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 끝내 합의에 이르지 못하고 예산안이 강행 처리된다면 여야 충돌이 더욱 격화할 거란 우려도 제기됩니다.",
                "sound_type": [
                    2
                ],
                "start": 27.492,
