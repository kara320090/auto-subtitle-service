                    4
                ],
                "start": 0.000,
                "end": 9.584
            },
            {
                "speaker_id": "1",
                "transcription": "대법원도 이 같은 2심 판단이 맞다며 검찰과 우 전 수석의 상고를 모두 기각하고 징역 1년을 확정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.594,
                "end": 17.533
            },
            {
                "speaker_id": "1",
                "transcription": "우 전 수석은 1심 과정에서 1년 넘게 구속됐기 때문에 형 확정에도 수감되진 않습니다.",
                "sound_type": [
                    2
