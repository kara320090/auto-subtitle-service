        "term": [
            {
                "speaker_id": "1",
                "transcription": "우 전 수석의 지시로 @이름1 전 국정원 국익정보국장이 직권을 남용했다며 우 전 수석을 추 전 국장의 공동범으로 판단한 겁니다.",
                "sound_type": [
