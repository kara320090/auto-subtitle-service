        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당은 대통령의 양곡법 거부권 행사가 식량 주권 포기 선언이라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.560
            },
            {
                "speaker_id": "1",
                "transcription": "전임 정부 탓 말고 쌀값 폭락을 막을 실질적 대안을 제시하라며 오는 13일 재투표 추진을 공식화했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.570,
                "end": 14.263
            },
            {
                "speaker_id": "2",
                "transcription": "재투표에서도 부결된다면 민생과 민의를 모두 저버린 무책임한 집권당을 향한 국민의 평가가 뒤따를 것임을 명심하기 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 14.273,
                "end": 24.123
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘은 이번 거부권 행사가 농민과 농업을 위해서도 국가 재정을 위해서도 불가피한 일이었다고 맞받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.133,
                "end": 32.332
            }
        ]
    },
