        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 어제저녁부터 오늘 새벽까지 9시간 동안 이곳 서울 중앙 지검에서 전국 부장 검사 회의가 열렸는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.030
            },
            {
                "speaker_id": "1",
                "transcription": "이 자리에서 검찰 지휘부의 책임 있는 자세를 요구하는 의견이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.030,
                "end": 11.962
            },
            {
                "speaker_id": "1",
                "transcription": "검찰 지휘부를 향해 직을 걸고 법안 통과를 막으라 사법 시스템이 위기에 놓인 상황에서 지휘부가 총사퇴로 결기를 보이라는 목소리가 함께 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.969,
                "end": 23.062
            },
            {
                "speaker_id": "1",
                "transcription": "부장 검사들은 민주당이 추진하는 법안은 범죄방치법이고 국민의 기본권이 박탈된다고 성토했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.072,
                "end": 30.544
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 민주당이 숙의 절차를 전혀 거치지 않고 안건 조정 제도를 비정상적으로 무력화하고 있다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.554,
                "end": 38.968
            },
            {
                "speaker_id": "1",
                "transcription": "다만 검찰 수사의 공정성과 정치적 중립성에 대한 자성의 목소리도 나왔는데요.",
                "sound_type": [
                    2
                ],
                "start": 38.978,
                "end": 45.025
            },
            {
                "speaker_id": "1",
                "transcription": "수사 개시와 종결까지 국민의 철저한 감시를 받는 방안을 대검에 건의하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 45.035,
                "end": 51.770
            },
            {
                "speaker_id": "1",
                "transcription": "김오수 총장도 박병석 국회의장과 만나 수사권 폐지 대신 검찰의 공정성을 확보하는 특별법 제정을 제안했습니다.",
                "sound_type": [
                    2
                ],
                "start": 51.780,
                "end": 61.027
            }
        ]
    },
    "summary": "서울 중앙 지검에서 열린 전국 부장 검사 회의에서 부장 검사들은 민주당이 추진하는 법안은 국민의 기본권이 박탈된다고 성토했고 검찰 수사의 공정성과 정치적 중립성에 대한 자성의 목소리도 나왔다.",
