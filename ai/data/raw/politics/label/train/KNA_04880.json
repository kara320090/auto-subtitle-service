        "term": [
            {
                "speaker_id": "1",
                "transcription": "단체장 중심이 아니라 의회 중심이기도 하고 지역 주민 중심이어다 이어야 된다라고 생각을 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.626
            },
            {
                "speaker_id": "1",
                "transcription": "그들의 수요를 적절하게 반영하느냐",
                "sound_type": [
                    2
                ],
                "start": 7.636,
                "end": 11.280
            },
            {
                "speaker_id": "2",
                "transcription": "지자체 간 공동 협력 모델인 특별 지자체의 성공 여부도 관건입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.280,
                "end": 16.398
            },
            {
                "speaker_id": "2",
                "transcription": "이미 첫 특별 지자체인 부울경 특별 연합이 설치됐고 경기 남부 충청권 등도 설립을 추진 중인데 제 역할을 하려면 목적부터 명확해야 한다는 지적이 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 16.408,
                "end": 28.196
            },
            {
                "speaker_id": "2",
                "transcription": "지방 의회는 인사권 독립과 정책 지원관 도입 등으로 권한은 커졌지만 1년에 조례 한 건 발의하지 않는 기초 의원이 25퍼센트 가까이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 28.206,
                "end": 38.071
            }
        ]
    },
    "summary": "지자체 간 공동 협력 모델인 특별 지자체의 성공 여부도 관건이며 제 역할을 하려면 목적부터 명확해야 한다는 지적이 나오는데 지방 의회는 권한은 커졌지만 1년에 조례 한 건 발의하지 않는 기초 의원이 25퍼센트 가까이 된다고 전한다.",
