        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 윤리위는 조금 전인 7시부터 시작했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.992
            },
            {
                "speaker_id": "1",
                "transcription": "지난 4월 이준석 대표에 대한 징계 절차를 개시한 지 2달만인데요.",
                "sound_type": [
                    2
                ],
                "start": 3.002,
                "end": 6.943
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 윤리위에 올라온 안건 중 이 대표 관련 심의는 가장 마지막에 이뤄질 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.953,
                "end": 11.861
            },
            {
                "speaker_id": "1",
                "transcription": "쟁점은 이 대표의 측근인 김철근 당 대표 정무실장이 성 상납 의혹 제보자에게 7억 원의 투자 각서를 써주는데 여기에 이 대표가 연루됐는지 여부입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.871,
                "end": 21.206
            },
            {
                "speaker_id": "1",
                "transcription": "윤리위는 잠시 후 당사자인 김철근 실장을 출석시켜 사실 관계를 확인할 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.216,
                "end": 26.201
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 당규상 징계는 제명과 탈당 권유 당원권 정지",
                "sound_type": [
                    2
                ],
                "start": 26.211,
                "end": 30.230
            }
        ]
    },
    "summary": "김철근 당 대표 정무실장이 성 상납 의혹 제보자에게 7억 원의 투자 각서를 써준 혐의와 관련하여 이준석 대표가 연루됐는지 윤리위 징계 심의가 이루어지고 있다.",
