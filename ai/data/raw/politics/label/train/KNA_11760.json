        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령은 불법 집회에 대한 엄정한 법 집행을 강조해 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.857
            },
            {
                "speaker_id": "2",
                "transcription": "우리 정부는 그 어떤 불법 행위도 이를 방치 외면하거나 용납하지 않을 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.867,
                "end": 13.040
            },
            {
                "speaker_id": "1",
                "transcription": "정부 여당은 집시법 개정을 예고했고 야당과 노동계는 반발해 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.050,
                "end": 18.698
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 의견이 엇갈리는 현안을 대통령실이 국민 제안 토론 세 번째 주제로 잡았습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.708,
                "end": 24.605
            },
            {
                "speaker_id": "1",
                "transcription": "집회시위 요건과 제재 강화 방안에 대해서입니다.",
