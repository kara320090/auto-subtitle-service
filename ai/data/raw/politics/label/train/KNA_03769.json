        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰이 보완 수사에 나섰지만 사건 발생 5개월이 넘도록 결론을 못 내고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.126
            },
            {
                "speaker_id": "1",
                "transcription": "교사 엄중 처벌 촉구한다 촉구한다 촉구한다.",
                "sound_type": [
                    2
                ],
                "start": 5.136,
                "end": 10.754
            },
            {
                "speaker_id": "1",
                "transcription": "결국 피해 아동의 학부모들이 다시 경찰서 앞에 모여 신속한 수사와 엄중한 처벌을 요구했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.764,
                "end": 17.195
            },
            {
                "speaker_id": "1",
                "transcription": "교육 당국이 A씨의 교사 지위만 해제했을 뿐 관련 서류 부족을 이유로 징계 위원회도 열지 않아 A씨가 월급도 일부 받고 있다고 주장했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.205,
                "end": 26.606
            },
            {
                "speaker_id": "2",
                "transcription": "일을 하지 않고 있음에도 불구하고 국민의 세금으로 나라에서 돈을 주고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.616,
                "end": 32.603
            },
            {
                "speaker_id": "2",
                "transcription": "가해자는 그 돈으로 정관 변호사를 선임하여 피해자 가족과 싸울 준비",
                "sound_type": [
                    2
                ],
                "start": 32.613,
                "end": 38.605
            }
        ]
    },
    "summary": "피해 아동의 학부모들이 해당 교사의 엄중 처벌을 촉구하고 있다.",
