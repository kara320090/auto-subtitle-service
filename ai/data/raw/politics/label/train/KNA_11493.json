        "term": [
            {
                "speaker_id": "1",
                "transcription": "왜 돈 들여가지고 바다로 버립니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.891
            },
            {
                "speaker_id": "2",
                "transcription": "여당은 이런 주장은 국민 공포를 조장하는 정치 선동이라고 맞섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.901,
                "end": 7.413
            },
            {
                "speaker_id": "3",
                "transcription": "너무 우리가 정치 선동하고 공포를 자극한다.",
                "sound_type": [
                    2
                ],
                "start": 7.423,
                "end": 11.300
            },
            {
                "speaker_id": "3",
                "transcription": "중대한 사정 반경은 솔직히 정권이 바뀌었다는 거밖에 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.310,
                "end": 16.137
            },
            {
                "speaker_id": "4",
                "transcription": "국제 원자력 기구 검증 프로그램을 통해서 이미 세 차례나 채취를 했어요.",
                "sound_type": [
                    2
                ],
                "start": 16.147,
                "end": 19.334
            },
            {
                "speaker_id": "4",
                "transcription": "팩트에 정반대되는 이런 거짓 선동을 민주당이 지금 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.344,
                "end": 23.760
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 시찰단은 들러리가 아니라며 전문가들이 현장에서 직접 보고 점검할 것이라고 강조했습니다.",
                "sound_type": [
                    2
