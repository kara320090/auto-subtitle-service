        "term": [
            {
                "speaker_id": "1",
                "transcription": "국토 최북단 강원도 고성 통일 전망대를 찾은 민주당 이재명 후보 북한과 관광이나 스포츠처럼 비정치 분야부터 교류하겠다며 2008년 중단된 금강산 관광 재개를 공약했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 15.311
            },
            {
                "speaker_id": "2",
                "transcription": "개별 관광은 대북 제재와 관련이 없고 또 남북 간에도 금강산 관광을 재개하기로 합의였기 때문에",
                "sound_type": [
                    2
                ],
                "start": 15.321,
                "end": 25.684
            },
            {
                "speaker_id": "1",
                "transcription": "북한 원산 금강산과 강원 고성 강릉을 아우르는 동해 관광특구 조성 비무장지대 생태 건강 구상도 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.694,
                "end": 35.078
            },
            {
                "speaker_id": "1",
                "transcription": "강원도는 평화를 지키는 게 경제를 살리는 것이라고 강조한 이 후보는 통일에 대한 견해도 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.088,
                "end": 42.600
            },
            {
                "speaker_id": "2",
                "transcription": "공동 번영에 중점을 두고 통일이나 다름없는 상태가 되도록 목표를 단기적으로 설정하는 게",
                "sound_type": [
                    2
                ],
                "start": 42.610,
                "end": 50.083
            }
        ]
    },
    "summary": "이 후보는 2008년 중단된 금강산 관광 재개를 공약했고 동해 관광특구 조성 비무장지대 생태 건강 구상도 내놨습니다.",
