                ],
                "start": 0.000,
                "end": 14.767
            },
            {
                "speaker_id": "1",
                "transcription": "시민단체의 고발로 수사에 착수한 검찰은 조 의원을 공직선거법상 허위 사실 공표 혐의로 기소하고 벌금 150만 원을 구형했습니다.",
                "sound_type": [
