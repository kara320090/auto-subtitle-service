        "term": [
            {
                "speaker_id": "1",
                "transcription": "전쟁 없는 한반도가 시작되었습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.784
            },
            {
                "speaker_id": "2",
                "transcription": "적대의 역사를 끝장내기 위한 군사 분야 합의서를 채택하였으며",
                "sound_type": [
                    2
                ],
                "start": 2.794,
                "end": 7.435
            },
            {
                "speaker_id": "3",
                "transcription": "한반도 군사적 긴장 상태를 완화하기 위해 남북 상호 간 적대행위를 하지 말자는 게 골자였습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.445,
                "end": 14.094
            },
            {
                "speaker_id": "3",
                "transcription": "특히 군사분계선 기준으로 일정 거리 안에서는 포 사격이나 야외 기동 훈련 비행이나 무인기 이륙 등을 금지했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.104,
                "end": 22.978
            },
            {
                "speaker_id": "3",
                "transcription": "하지만 이듬해 11월 북한은 서부전선 최전방 창림도에서 해안포 사격을 하면서 처음으로 합의를 위반했고 2020년 1월엔 우리 군 감시초소를 향해 총격을 감행했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.988,
                "end": 35.335
            }
        ]
    },
    "summary": "한반도 군사적 긴장 상태를 완화하기 위해 남북 상호 간 군사분계선 기준으로 일정 거리 안에서는 포 사격이나 야외 기동 훈련 비행이나 무인기 이륙 등을 금지했지만 이듬해 11월 북한은 해안포 사격을 하면서 처음으로 합의를 위반했고 2020년 1월엔 우리 군 감시초소를 향해 총격을 감행했다.",
