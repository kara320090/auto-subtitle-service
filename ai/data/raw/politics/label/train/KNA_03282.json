        "term": [
            {
                "speaker_id": "1",
                "transcription": "2017년 본회의 기간 중 병가를 내고 스페인 가족 여행을 다녀온 데 대해선 거듭 사과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.940
            },
            {
                "speaker_id": "2",
                "transcription": "여행 좋아하시나 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 6.950,
                "end": 9.117
            },
            {
                "speaker_id": "2",
                "transcription": "네 그래도 그 본회의에 불참하시고 가면 안 되겠죠?",
                "sound_type": [
                    2
                ],
                "start": 9.127,
                "end": 13.357
            },
            {
                "speaker_id": "3",
                "transcription": "그때 나간 뒤에 이제 본회의가 여야 합의돼서 잡혔고요.",
                "sound_type": [
                    2
                ],
                "start": 13.367,
                "end": 18.010
            },
            {
                "speaker_id": "3",
                "transcription": "결과적으론 매우 부적절한 처사였습니다.",
