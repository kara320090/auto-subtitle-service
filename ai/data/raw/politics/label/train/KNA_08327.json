        "term": [
            {
                "speaker_id": "1",
                "transcription": "이건 바로 다수 연구자의 학문적 업적을 탈취한 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.427
            },
            {
                "speaker_id": "2",
                "transcription": "검증단은 결과적으로 모든 논문이 표절에 집합체이고 대필마저도 의심된다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.437,
                "end": 11.875
            },
            {
                "speaker_id": "3",
                "transcription": "용기 있는 학자는 우리나라에 없다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 11.885,
                "end": 15.599
            },
            {
                "speaker_id": "3",
                "transcription": "그래서 이거는 누군가가 대필했을지 않을까 하는 의혹까지 생긴다는 말씀입니다.",
                "sound_type": [
