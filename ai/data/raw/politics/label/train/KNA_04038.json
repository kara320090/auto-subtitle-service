        "term": [
            {
                "speaker_id": "1",
                "transcription": "대부분 다 바뀐다고 보면 된다라고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.788
            },
            {
                "speaker_id": "2",
                "transcription": "그렇습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.798,
                "end": 2.238
            },
            {
                "speaker_id": "2",
                "transcription": "90프로는 훨 넘을 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.248,
                "end": 4.476
            },
            {
                "speaker_id": "3",
                "transcription": "입법 예고된 검찰 직제 개편안과 연동해 일선 지검 차장과 부장급을 대거 승진 전보 시킨다는 계획입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.486,
                "end": 13.171
            },
            {
                "speaker_id": "3",
                "transcription": "김학의 전 차관 관련 사건이나 월성 원전 사건과 같은 이른바 권력 수사를 맡은 수사팀에도 변화가 불가피해 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.181,
                "end": 21.825
            },
            {
                "speaker_id": "3",
                "transcription": "박 장관은 이들 수사팀의 교체 여부에 대해선 내용을 밝힐 시점이 아닌 것 같다고 말을 아꼈습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 21.835,
                "end": 28.965
            },
            {
                "speaker_id": "3",
                "transcription": "그러나 검찰 일각에서는 수사가 채 마무리되지 않은 상황에서 대규모 인사를 예고한 것 자체가 수사팀에 대한 압력이라고 반발하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.975,
                "end": 38.238
            }
        ]
    },
    "summary": "검찰 일각에서는 수사가 채 마무리되지 않은 상황에서 대규모 인사를 예고한 것 자체가 수사팀에 대한 압력이라고 반발하고 있다.",
