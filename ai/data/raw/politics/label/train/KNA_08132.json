        "term": [
            {
                "speaker_id": "1",
                "transcription": "국회 법제 사법 위원회에 처음 출석한 한동훈 법무부 장관.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.326
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 전 정권 임명 공공 기관장에 대한 여권의 사퇴 압박이 직권 남용죄 아니냐고 포문을 열었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.336,
                "end": 11.726
            },
            {
                "speaker_id": "2",
                "transcription": "권익 위원장에게 사퇴 압박 들어온게 훨씬 더 명백해 보이는데 장관님 견해는 어떻습니까.",
                "sound_type": [
                    2
                ],
                "start": 11.736,
                "end": 19.799
            },
            {
                "speaker_id": "1",
                "transcription": "한 장관은 그러나 업무 관계가 있는게 아니라며 정무적 의견 개진 일 뿐 이라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.809,
                "end": 26.759
            },
            {
                "speaker_id": "3",
                "transcription": "적어도 직권 남용에 여지가 있는 구도는 아예 처음부터는 아니죠.",
                "sound_type": [
                    2
                ],
                "start": 26.769,
                "end": 30.864
            }
        ]
    },
