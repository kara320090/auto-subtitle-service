        "term": [
            {
                "speaker_id": "1",
                "transcription": "다만 이재명 대표와 @이름1 전 회장의 직접적인 연결 고리는 드러난 게 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.588
            },
            {
                "speaker_id": "2",
                "transcription": "저는 @이름1라는 분 얼굴도 본 적이 없거든요.",
                "sound_type": [
                    2
                ],
                "start": 4.598,
                "end": 8.173
            },
            {
                "speaker_id": "2",
                "transcription": "근데 그분이 왜 제 변호사비를 내며 그 봤던 사람은 대체 누구냐 그러면 그 사람 잡아가든지 정말 황당무계해요.",
                "sound_type": [
                    2
                ],
                "start": 8.183,
                "end": 17.811
            },
            {
                "speaker_id": "1",
                "transcription": "결국 광건은 전환 사채에서 파생된 돈의 흐름을 객관적으로 확인하는 일인데 자금 관리를 총괄했던 쌍방울 재경 본부장 김 모 씨가 태국 구치소에 갇힌 채로 국내 송환을 거부한 점이 변수입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.821,
                "end": 31.485
            },
            {
                "speaker_id": "1",
                "transcription": "김 씨는 @이름1 전 회장의 매제이기도 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 31.495,
                "end": 34.950
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 외교 채널을 이용해 김 씨의 자진 지국을 최대한 설득하고 있는 것으로 알려졌습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 34.960,
                "end": 40.346
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름2입니다.",
