        "term": [
            {
                "speaker_id": "1",
                "transcription": "안철수 인수위원장은 과학적 추계를 기반으로 이런 숫자를 계산했다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.107
            },
            {
                "speaker_id": "2",
                "transcription": "왜 손실 규모를 정확하게 계산을 하지 않았는지 저도 잘 이해 안 갑니다.",
                "sound_type": [
                    2
                ],
                "start": 5.117,
                "end": 13.354
            },
            {
                "speaker_id": "2",
                "transcription": "이게 제일 기본 중의 기본 아닙니까?",
                "sound_type": [
                    2
                ],
                "start": 13.364,
                "end": 16.345
            },
            {
                "speaker_id": "1",
                "transcription": "영업이익 감소분 중 방역 조치로 직접 발생한 손실 비율인 보정률을 100퍼센트로 올리고 분기별 50만 원인 지급 하한액도 올리기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.355,
                "end": 26.479
            },
            {
                "speaker_id": "1",
                "transcription": "금융과 세제 지원안도 제시했습니다.",
                "sound_type": [
                    2
