        "term": [
            {
                "speaker_id": "1",
                "transcription": "에너지 약자의 안락한 생활 보장을 위해 제공하려는 필수 전기 복지도 만들어낼 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.283
            },
            {
                "speaker_id": "2",
                "transcription": "심상정 후보는 정의로운 전환 기본법 제정과 노동자 재고용 직업 훈련을",
                "sound_type": [
                    2
                ],
                "start": 8.293,
                "end": 14.117
            },
            {
                "speaker_id": "3",
                "transcription": "새로운 직업을 얻을 때까지 재교육을 제공하고 또 그 기간에 실업 급여를 지급해 주고 또 양질의 일자리가 연결될 수 있을 때까지 국가가 책임져야 된다고 보고요.",
                "sound_type": [
                    2
                ],
                "start": 14.127,
                "end": 26.622
            },
            {
                "speaker_id": "2",
                "transcription": "안철수 후보는 사회 안전망 강화 지역 대학 재교육을 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.632,
                "end": 31.759
            },
            {
                "speaker_id": "4",
                "transcription": "국가가 각 국민들이 대처할 수 있게 해 줘야 되잖아요.",
                "sound_type": [
                    2
                ],
                "start": 31.769,
                "end": 36.301
            },
            {
                "speaker_id": "4",
                "transcription": "저는 그것 중의 하나가 평생 교육이라고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 36.311,
                "end": 40.271
            },
            {
                "speaker_id": "4",
                "transcription": "전체 연령대로 전 국민으로 늘리는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 40.281,
                "end": 43.313
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 이 공약들 모호한 부분이 상당합니다.",
                "sound_type": [
                    2
                ],
                "start": 43.323,
                "end": 46.780
            }
        ]
    },
    "summary": "대통령 후보들이 내세운 공약에는 모호한 부분이 상당하다.",
