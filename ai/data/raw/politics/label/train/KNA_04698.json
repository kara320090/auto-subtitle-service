        "term": [
            {
                "speaker_id": "1",
                "transcription": "선거대책위의 직을 내려놓고 현장으로 달려가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.568
            },
            {
                "speaker_id": "2",
                "transcription": "세 사람 모두 당내 경선 때부터 핵심 역할을 해온 다선 의원들입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.578,
                "end": 10.412
            },
            {
                "speaker_id": "2",
                "transcription": "이들이 물러나면서 선대위 개편 작업은 더 속도를 낼 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 10.422,
                "end": 15.749
            },
            {
                "speaker_id": "2",
                "transcription": "3선 이상 의원들이 물러나고 초재선과 외부 인사로 선대위를 재편하는 방안이 거론되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.759,
                "end": 23.091
            },
            {
                "speaker_id": "2",
                "transcription": "이재명 후보는 당의 조직과 살림을 책임지는 사무총장의 최측근인 재선에 김영진 의원을 임명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.101,
                "end": 31.303
            },
            {
                "speaker_id": "2",
                "transcription": "당 장악력을 높이기 위한 인선입니다.",
                "sound_type": [
                    2
                ],
