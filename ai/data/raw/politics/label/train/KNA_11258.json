        "term": [
            {
                "speaker_id": "1",
                "transcription": "대통령실의 참모들을 간신배로 몬 것은 정말 굉장히 부당 부당한 이야깁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.855
            },
            {
                "speaker_id": "1",
                "transcription": "대통령께서 간신인지 아닌지 구분도 못 하고 국정을 운영하고 계시겠습니까?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.865,
                "end": 12.319
            },
            {
                "speaker_id": "2",
                "transcription": "안 후보의 윤안연대 발언도 정말 잘못된 거라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.329,
                "end": 16.171
            },
            {
                "speaker_id": "2",
                "transcription": "대통령과 당 후보가 어떻게 동격이냐며 대통령 리더십을 흔드는 것이라고 직격한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 16.181,
                "end": 21.602
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 이런 내용을 대통령도 잘 알고 있다며 윤심이 반영됐음을 공개했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.612,
                "end": 27.335
            },
            {
                "speaker_id": "2",
                "transcription": "또 다른 고위 관계자도 브리핑에서 윤핵관 비판은 대통령을 욕하는 거라며 대통령을 전당대회에 끌어들이는 것은 매우 부적절하다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.345,
                "end": 36.316
            },
            {
                "speaker_id": "2",
                "transcription": "사실상 대통령의 공개 경고에 안 후보는 한발 물러섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.326,
                "end": 39.973
            }
        ]
    },
    "summary": "안 후보의 윤안연대 발언도 정말 잘못된 거라고 하면서 이런 내용을 대통령도 잘 알고 있다며 윤심이 반영됐음을 공개했고 또 다른 고위 관계자도 브리핑에서 윤핵관 비판은 대통령을 욕하는 거라며 대통령을 전당대회에 끌어들이는 것은 매우 부적절하다고 하는 등 사실상 대통령의 공개 경고에 안 후보는 한발 물러섰다.",
