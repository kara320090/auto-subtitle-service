        "term": [
            {
                "speaker_id": "1",
                "transcription": "불요불급한 그 세출을 줄여나가면서",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.403
            },
            {
                "speaker_id": "2",
                "transcription": "환경 분야 공약도 함께 밝힌 윤 후보는 석탄 등 화석연료 발전 비중을 낮춰 미세먼지를 임기 내 30퍼센트 이상 줄이겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.413,
                "end": 14.307
            },
            {
                "speaker_id": "2",
                "transcription": "또 학교와 요양병원 등에 공기정화기를 교체하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.317,
                "end": 19.466
            },
            {
                "speaker_id": "1",
                "transcription": "미세먼지를 제거할 수 있는 장치들을 다 필수 장치로써 전부 해놓고 이제 살아야 되는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.476,
                "end": 27.447
            },
            {
                "speaker_id": "2",
                "transcription": "윤 후보는 고농도 초미세먼지 경고를 현재 12시간 전에서 2일 전으로 앞당겨 발령하겠다고도 공약했습니다.",
                "sound_type": [
