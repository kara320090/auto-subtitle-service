        "term": [
            {
                "speaker_id": "1",
                "transcription": "진실은 거짓말로 은폐되고 있고 증거는 조금씩 폐기되고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.129
            },
            {
                "speaker_id": "1",
                "transcription": "바로 국정 조사가 필요로 하는 이유입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.139,
                "end": 9.998
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 강제력이 없는 국정 조사는 수사에 지장을 주고 정쟁만 일으킨다면 응하지 않겠다고 거듭 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.008,
                "end": 18.676
            },
            {
                "speaker_id": "3",
                "transcription": "지금은 수사가 착착 진행되고 있기 때문에 지금 국정 조사를 하자고 하는 것은 오히려 정치적인 의도가 있는 것이다.",
                "sound_type": [
                    2
                ],
                "start": 18.686,
                "end": 26.593
            },
            {
                "speaker_id": "2",
                "transcription": "대통령실도 슬픔을 정치에 활용해서는 안 된다.",
                "sound_type": [
                    2
                ],
                "start": 26.603,
                "end": 30.113
            },
            {
                "speaker_id": "2",
                "transcription": "사고 원인은 국민께서 잘 판단할 거라며 부정적인 입장을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.123,
                "end": 35.068
            }
        ]
    },
