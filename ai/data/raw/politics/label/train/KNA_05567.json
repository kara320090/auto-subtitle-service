                ],
                "start": 0.000,
                "end": 7.531
            },
            {
                "speaker_id": "2",
                "transcription": "지금은 추궁의 시간이 아닌 추모의 시간입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.541,
                "end": 13.145
            },
            {
                "speaker_id": "2",
                "transcription": "슬픔을 나누고 기도해야 할 시간입니다.",
