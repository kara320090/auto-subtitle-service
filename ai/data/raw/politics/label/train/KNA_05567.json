        "term": [
            {
                "speaker_id": "1",
                "transcription": "서울광장 합동분향소를 찾은 국민의힘 지도부 사고 원인을 분석하고 사회 안전망을 재점검하겠다고 했습니다.",
                "sound_type": [
                    2,
