        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "추도식 주제는 나는 깨어 있는 강물이다로 정치 대립을 해소하고 소통과 통합의 민주주의를 향해 나아가자는 의미를 담았다고 노무현 재단은 설명했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.516
            },
            {
                "speaker_id": "2",
                "transcription": "아직 우리 가슴 속에 남아있는 그의 못 다 이룬 꿈이 이 자리에 함께한 시민 여러분의 힘으로 완성되길 진정으로 고대합니다.",
                "sound_type": [
                    2
                ],
                "start": 10.526,
                "end": 21.598
            },
            {
                "speaker_id": "1",
                "transcription": "민주당에선 이재명 총괄 선대 위원장과 윤호중 박지현 공동 비상 대책 위원장 등 당 지도부가 대거 참석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.608,
                "end": 30.100
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘에선 이준석 대표와 권성동 원내대표 등이 참석했고 이은주 원내대표 등 정의당 의원들도 함께했습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.110,
                "end": 37.948
            },
            {
                "speaker_id": "1",
                "transcription": "정부에선 노무현 정부 마지막 총리이자 윤석열 정부 첫 총리인 한덕수 국무총리와 김대기 대통령실 비서실장 등이 참석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.958,
                "end": 47.663
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령은 한 총리를 통해 권양숙 여사에게 위로의 뜻을 전한 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.673,
                "end": 53.441
            },
            {
                "speaker_id": "3",
                "transcription": "총리 통해서 어떤 메세지를 좀",
                "sound_type": [
                    2
                ],
                "start": 53.451,
                "end": 55.975
            },
            {
                "speaker_id": "4",
                "transcription": "글쎄 뭐 한국 정치에 참 안타깝고 비극적인 일이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 55.975,
                "end": 61.442
            },
            {
                "speaker_id": "1",
                "transcription": "5년 전 성공한 대통령이 되어 다시 찾겠다고 약속했던 문재인 전 대통령은 일찌감치 봉화마을에 도착해 노 전 대통령 사저 등을 둘러봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 61.452,
                "end": 71.145
            },
            {
                "speaker_id": "1",
                "transcription": "이후 권양숙 여사 민주당 지도부와 함께 오찬을 갖기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 71.155,
                "end": 75.899
            },
            {
                "speaker_id": "1",
                "transcription": "추도식 뒤에는 유가족들과 노 전 대통령 묘역에 헌화와 참배를 한 뒤 소셜 미디어에 약속을 지켰다 그리운 세월이었다는 글을 올렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 75.909,
                "end": 86.536
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 임종빈입니다.",
                "sound_type": [
                    2
                ],
                "start": 86.546,
                "end": 89.003
            },
            {
                "speaker_id": "5",
                "transcription": "지난주 한덕수 총리 임명 동의안이 국회를 통과한 이후 정호영 보건 복지부 장관 후보자의 거취 문제에 정치권의 관심이 쏠리고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 89.013,
                "end": 99.326
            },
            {
                "speaker_id": "5",
                "transcription": "국민의힘은 당내에서도 반대 의견이 많다며 사실상 자진 사퇴를 촉구했는데 윤석열 대통령은 시간이 조금 더 필요하다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 99.336,
                "end": 108.437
            },
            {
                "speaker_id": "5",
                "transcription": "한승연 기자입니다.",
                "sound_type": [
                    2
                ],
                "start": 108.447,
                "end": 110.310
            }
        ]
    },
    "summary": "추도식 주제는 정치 대립을 해소하고 소통과 통합의 민주주의를 향해 나아가자는 의미를 담았다고 노무현 재단은 설명했습니다.",
