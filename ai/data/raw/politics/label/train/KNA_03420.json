        "term": [
            {
                "speaker_id": "1",
                "transcription": "차기 대권 주자로서 존재감을 부각시키려는 의도에 더해 작년 추윤 갈등을 잘 조율하지 못했던 비판을 의식한 걸로도 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.388
            },
            {
                "speaker_id": "2",
                "transcription": "하시는 걸 보면 그 정치인 같애요.",
                "sound_type": [
                    2
                ],
                "start": 8.398,
                "end": 12.435
            },
            {
                "speaker_id": "2",
                "transcription": "국회하고 얘길하는 게 옳지 이게 에 이 저 행정가의 태도인가 어 이게 저 저는 적절치 않다고 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 12.445,
                "end": 21.113
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 본격적인 윤 총장 엄호에 나섰습니다.",
