        "term": [
            {
                "speaker_id": "1",
                "transcription": "다만 국회 외통 위원장 출신 윤상현 의원은 불법 도감청 여부 확인이 우선인데도 정부가 성급한 대응을 한다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.281
            },
            {
                "speaker_id": "2",
                "transcription": "만약에 이게 진짜라면은 당이 사과 재발 장지 대책을 요구해야죠 주종 관계의 동맹이 아니라 대등한 동맹으로 가야 된다.",
                "sound_type": [
                    2
                ],
                "start": 9.291,
                "end": 17.005
            },
            {
                "speaker_id": "3",
                "transcription": "이번 건도 그 사실 확인을 엄중하게 해서",
                "sound_type": [
                    2
                ],
                "start": 17.015,
                "end": 20.038
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까 사실 관계를",
                "sound_type": [
                    2
                ],
                "start": 20.048,
                "end": 21.162
            },
            {
                "speaker_id": "3",
                "transcription": "결과에 따라서 합당한 조치를 취할 필요가 있다.",
                "sound_type": [
                    2
                ],
                "start": 21.172,
                "end": 24.864
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 외교부 장관은 납득할 만한 미국 측 해명이 있었느냐는 질문에는 파악한 건 없다고 답했습니다.",
                "sound_type": [
