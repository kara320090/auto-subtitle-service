        "term": [
            {
                "speaker_id": "1",
                "transcription": "질병청이 올해 코로나19 유전자 분석 업체와 맺은 계약 내역입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.441
            },
            {
                "speaker_id": "1",
                "transcription": "해당 업체의 경우 질병청의 분석 의뢰가 지난 1월에 100건 5월에 2450건에 머물렀는데 백 청장과의 관계가 언급된 전자 공시가 나온 직후 1만 5000건으로 직전보다 6배 넘게 늘었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.451,
                "end": 19.430
            },
            {
                "speaker_id": "2",
                "transcription": "제 친누이는 2대 질병 청장 임무를 맡은 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.440,
                "end": 24.276
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 하는 순간 이미 @이름1 청장님은 국민의 신뢰를 잃었어요.",
                "sound_type": [
                    2
                ],
                "start": 24.286,
                "end": 30.159
            },
            {
                "speaker_id": "3",
                "transcription": "의원님 말씀 잘 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.169,
                "end": 33.364
            },
            {
                "speaker_id": "3",
                "transcription": "어떤 우려를 가지고 계시는지 알겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.374,
                "end": 35.189
            },
            {
                "speaker_id": "2",
                "transcription": "우려가 아니라 그만두라는 이야기예요.",
