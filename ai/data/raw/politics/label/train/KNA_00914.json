        "term": [
            {
                "speaker_id": "1",
                "transcription": "아직까지 공식 입장은 나오지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.784
            },
            {
                "speaker_id": "1",
                "transcription": "국민 투표 실시에 따른 정치적 파장과 실익 등을 면밀히 검토해 결정할 거 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.794,
                "end": 7.808
            },
            {
                "speaker_id": "1",
                "transcription": "이 다만 선관위에선 현행 규정으로는 투표인 명부 작성이 불가능 해 국민 투표 실시가 불가능하다고 유권 해석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.818,
                "end": 15.311
            },
            {
                "speaker_id": "1",
                "transcription": "이 점은 변수가 될 전망입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.321,
                "end": 17.410
            },
            {
                "speaker_id": "1",
                "transcription": "앞서 윤 당선인은 아침 출근길에 어 검찰청법 형소법 개정안 관련 질문을 받자 당에서 알아서 할 것이라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.420,
                "end": 25.532
            },
            {
                "speaker_id": "1",
                "transcription": "국회에서 논의가 이어지는 상황을 고려해 말을 아낀 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 25.542,
                "end": 29.536
            },
            {
                "speaker_id": "1",
                "transcription": "새 정부 종합 방역 대책 발표에 나선",
                "sound_type": [
                    2
                ],
                "start": 29.546,
                "end": 31.998
            }
        ]
    },
