        "term": [
            {
                "speaker_id": "1",
                "transcription": "위기를 극복하는 위기 극복의 총사령관이 되겠습니다 여러분.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.248
            },
            {
                "speaker_id": "2",
                "transcription": "자신을 지지하지 않는 민주당 지지층 마음을 얻기 위해서는 이낙연 전 대표에 총괄 선대 위원장을 맡기기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.258,
                "end": 13.344
            },
            {
                "speaker_id": "2",
                "transcription": "또 한국 노총의 지지 선언도 이끌어냈는데 이 후보는 노동 존중 사회로 보답하겠다고 화답했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.354,
                "end": 19.400
            },
            {
                "speaker_id": "2",
                "transcription": "과학 기술 분야 공약을 밝힌 국민의힘 윤석열 후보 대통령 직속 과학 기술 위원회를 만들고 감염병 탄소 중립 같은 난제에 연구 개발비를 우선 드리겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.410,
                "end": 30.376
            },
            {
                "speaker_id": "3",
                "transcription": "우리는 이제 추격자에서 선도자가 돼야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 30.386,
                "end": 34.601
            }
        ]
    },
