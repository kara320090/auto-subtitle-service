        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 아이들의 더 나은 미래를 기원합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.857
            },
            {
                "speaker_id": "2",
                "transcription": "박 장관은 지난달 29일 대통령 업무 보고에서 만 5세 초등학교 입학 학제 개편안을 보고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.867,
                "end": 11.608
            },
            {
                "speaker_id": "2",
                "transcription": "교육의 국가 책임을 강화하겠다는 취지였지만 학부모 단체와 교육계는 유아기 발달을 고려하지 않았고 사전 협의도 없었다며 정책 철회를 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.618,
                "end": 21.430
            },
            {
                "speaker_id": "2",
                "transcription": "박 장관은 또 외고 폐지 방침을 밝혔다가 학부모 등이 강하게 반발하면서 교육계와 정치권에서 사퇴해야 한다는 주장이 나오기 시작했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.440,
                "end": 30.843
            },
            {
                "speaker_id": "2",
                "transcription": "박 장관은 김인철 교육부 장관 후보자 낙마 뒤 5월 27일 장관 후보자로 지명됐고 만취 운전과 교수 재직 당시 갑질 의혹 등으로 논란이 많았지만 국회 인사 청문회 없이 지난달 4일 임명됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.853,
                "end": 44.548
            },
            {
                "speaker_id": "2",
                "transcription": "결국 박 장관은 도덕성 논란과 정책 혼란 등의 이유로 취임 34일 만에 물러나게 됐고 윤석열 정부 장관 첫 낙마 사례가 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.558,
                "end": 54.028
            },
            {
                "speaker_id": "2",
                "transcription": "전교조와 교총 등 교육 단체들은 한 목소리로 정부가 이번 사태를 무겁게 봐야 한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 54.038,
                "end": 60.515
            },
            {
                "speaker_id": "2",
                "transcription": "또 만 5세 초등 입학 학제 개편안과 외고 폐지 등 논란이 된 정책을 즉시 폐지해야 한다고 촉구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.525,
                "end": 67.052
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름1입니다.",
