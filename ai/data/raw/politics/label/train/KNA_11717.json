        "term": [
            {
                "speaker_id": "1",
                "transcription": "2015년 기준 6살에서 21살까지의 학 인구는 892만 명 2021년 770만 명 올해 725만 명으로 꾸준히 감소 추세입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 12.198
            },
            {
                "speaker_id": "1",
                "transcription": "학령 인구 감소가 현실화되면서 정부와 여당이 교원의 수 역시 줄이겠단 방침을 공식화했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.208,
                "end": 19.954
            },
            {
                "speaker_id": "2",
                "transcription": "교원 수급 계획도 학령 인구 감소에 따라서 교원을 적정 규모로 조정함과 동시에 디지털 인재 양성 등 교육 개혁 추진",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.964,
                "end": 29.592
            },
            {
                "speaker_id": "1",
                "transcription": "우선 2024년부터 단계적으로 교사 신규 채용 규모를 조정합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.602,
                "end": 34.947
            },
            {
                "speaker_id": "1",
                "transcription": "이에 맞춰 교대와 사범대 등 관련 대학과 학과의 입학 정원 역시 줄여나간다는 계획입니다.",
                "sound_type": [
                    2,
                    5
                ],
