        "term": [
            {
                "speaker_id": "1",
                "transcription": "감사원은 이 씨 실종에서 발견까지 38시간 동안 인근 해역에서 군 당국이 확인한 배는 중국 어선뿐이라는 점도 확인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.169
            },
            {
                "speaker_id": "1",
                "transcription": "결국 이 씨가 중국 어선에 1차 구조돼 구명조끼를 입고 응급 처치를 받은 뒤 다시 표류했을 가능성이 있다는 게 감사원의 판단입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.179,
                "end": 18.511
            },
            {
                "speaker_id": "1",
                "transcription": "감사원이 이런 내용 등을 토대로 관련자 20명을 수사 의뢰한 데 대해 민주당은 격앙된 반응을 보였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.521,
                "end": 26.129
            },
            {
                "speaker_id": "1",
                "transcription": "검찰이 수사 중인 사안을 감사원이 기습적으로 수사 의뢰했다며 정치 쇼 짜 맞추기라고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.139,
                "end": 33.166
            }
        ]
    },
