        "term": [
            {
                "speaker_id": "1",
                "transcription": "국가보훈처는 국가보훈부로 격상하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.604
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 종합적 체계적 보훈정책을 추진하고 국가보훈 체계 위상을 강화하기 위함이라고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.614,
                "end": 10.548
            },
            {
                "speaker_id": "1",
                "transcription": "외교부 장관 소속으로 재외동포청도 신설됩니다.",
                "sound_type": [
                    2
                ],
                "start": 10.558,
                "end": 14.436
            },
            {
                "speaker_id": "1",
                "transcription": "재외동포대상 지원 정책 기능을 강화하고 관계 부처 협업을 통한 영사와 법무 병무 등 원스톱 민원 서비스를 제공하게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 14.446,
                "end": 23.684
            },
            {
                "speaker_id": "1",
                "transcription": "정부 조직 개편안은 신속한 추진을 위해 국민의힘 의원 입법으로 개정안이 발의될 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 23.694,
                "end": 30.078
            },
            {
                "speaker_id": "1",
                "transcription": "정부 조직 개편안에 대해 더불어민주당은 국가보훈부 승격과 재외동포청 신설에는 찬성 입장입니다.",
                "sound_type": [
                    2
                ],
                "start": 30.088,
                "end": 36.970
            }
        ]
    },
    "summary": "국가보훈처는 국가보훈부로 격상하기로 했고 외교부 장관 소속으로 재외동포청도 신설되는데 정부 조직 개편안은 신속한 추진을 위해 국민의힘 의원 입법으로 개정안이 발의될 예정입니다.",
