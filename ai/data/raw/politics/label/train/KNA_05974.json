        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "무슨 상황이니 쿠데타니 내가 무슨 목적을 위해서 쿠데타를 하겠어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.238
            },
            {
                "speaker_id": "1",
                "transcription": "그 정도의 소위 정치적 판단 능력이면 더 이상 나하고 뜻을 같이 할 수가 없어.",
                "sound_type": [
                    2
                ],
                "start": 4.248,
                "end": 9.885
            },
            {
                "speaker_id": "2",
                "transcription": "일단 윤 후보의 회견 이후 줄줄이 예정됐던 당내 모임들은 유보 또는 취소됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.895,
                "end": 16.404
            },
            {
                "speaker_id": "2",
                "transcription": "당내 상황을 지켜보자는 길입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.414,
                "end": 19.112
            },
            {
                "speaker_id": "2",
                "transcription": "김 전 위원장과 공동 전선에 형성해 온 이준석 대표 역시 우선은 달라진 선대위를 지켜보겠다는 입장입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.122,
                "end": 26.811
            },
            {
                "speaker_id": "3",
                "transcription": "개편의 방향성은 큰 틀에서 봤을 때는 제가 주장해 왔던 것과 닿아 있는 부분이 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.821,
                "end": 35.687
            },
            {
                "speaker_id": "2",
                "transcription": "그러나 불편한 관계 자체가 정리된 건 아니라 숙제는 남아 있는 셈입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.697,
                "end": 40.501
            },
            {
                "speaker_id": "2",
                "transcription": "선대위 개편 논의의 시작이 윤 후보 지지율 하락 추세와 실언 등도 있었던 만큼 윤 후보가 스스로 변화된 모습을 보일지도 관건입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.511,
                "end": 50.127
            },
            {
                "speaker_id": "4",
                "transcription": "제가 하고 싶은 말이 아니라 국민들께서 듣고 싶어 하는 그 말씀을 드리겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 50.137,
                "end": 59.444
            },
            {
                "speaker_id": "4",
                "transcription": "제게 시간을 좀 내주십시오.",
                "sound_type": [
                    2
                ],
                "start": 59.454,
                "end": 63.463
            }
        ]
    },
    "summary": "윤 후보의 회견 이후 줄줄이 예정됐던 당내 모임들은 유보 또는 취소됐고 김 전 위원장과 공동 전선에 형성해 온 이준석 대표 역시 우선은 달라진 선대위를 지켜보겠다는 입장입니다.",
