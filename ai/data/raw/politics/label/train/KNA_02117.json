        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 견제 없는 그런 권력을 어 이 향유해 왔다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.611
            },
            {
                "speaker_id": "1",
                "transcription": "이제 어 이 개혁해야 될 때가 되지 않았나.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.621,
                "end": 9.022
            },
            {
                "speaker_id": "2",
                "transcription": "일단 4월 국회에서 검찰의 수사권과 기소권을 완전히 분리하는 법안을 처리하고 장기적으론 국가 수사 기능을 전담하는 별도 수사 기구 이른바 한국형 FBI를 만들겠단 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 9.032,
                "end": 22.555
            },
            {
                "speaker_id": "2",
                "transcription": "4시간 넘는 토론 끝에 당론 채택됐지만 본회의 처리까진 불투명합니다.",
                "sound_type": [
                    2
                ],
                "start": 22.565,
                "end": 28.144
            },
            {
                "speaker_id": "2",
                "transcription": "우선 당내 반대 의견이 여전히 적지 않은데 어제 의총에서도 속도 조절론이 지도부에서부터 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.154,
                "end": 35.522
            },
            {
                "speaker_id": "3",
                "transcription": "2개의 길이 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.532,
                "end": 37.239
            },
            {
                "speaker_id": "3",
                "transcription": "하나는 검수완박은 질서 있게 철수하고 민생 법안에 집중하는 길입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.249,
                "end": 43.318
            },
            {
                "speaker_id": "2",
                "transcription": "의총에선 별도 찬반 의사를 묻는 절차 없이 당론을 추인했지만 실제 표결 때는 반대표가 나올 수 있는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 43.328,
                "end": 51.481
            },
            {
                "speaker_id": "2",
                "transcription": "야당과 검찰의 강한 반발도 부담입니다.",
                "sound_type": [
                    2
                ],
                "start": 51.491,
                "end": 54.733
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 의총 결과가 나온 직후부터 강경대응을 예고했습니다.",
                "sound_type": [
                    2
                ],
                "start": 54.743,
                "end": 59.533
            },
            {
                "speaker_id": "4",
                "transcription": "만약 민주당이 4월 국회에서 강행 처리를 하려고 한다면은 우리는 필리버스터 등 모든 수단을 동원해서 저지할 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.543,
                "end": 69.402
            }
        ]
    },
    "summary": "4월 국회에서 검찰의 수사권과 기소권을 분리하고 별도 수사 기구를 만들겠단 당론은 채택됐지만 본회의 처리까진 불투명하며 국민의힘은 의총 결과가 나온 직후부터 필리버스터 등 모든 수단을 동원해 저지할 것이라며 강경대응을 예고했다.",
