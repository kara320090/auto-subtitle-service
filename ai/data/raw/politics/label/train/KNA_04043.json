        "term": [
            {
                "speaker_id": "1",
                "transcription": "이달 초 홍남기 부총리는 재난 지원금 지급을 위한 1차 추경을 공식화하면서 선별 지원에 무게를 실었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.141
            },
            {
                "speaker_id": "2",
                "transcription": "이번 추경 검토는 하반기 내수 대책 및 고용 대책 그리고 소상공인 등 코로나 위기에 따른 취약 및 피해 계층 지원 대책 등이 그 중심이 될 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.151,
                "end": 19.592
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 이번 5차 재난 지원금에서도 선별 지급안을 마련했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.602,
                "end": 24.426
            },
            {
                "speaker_id": "1",
                "transcription": "소득이 높은 상위 30퍼센트는 빼고 나머지 70퍼센트 국민에게만 재난 지원금을 주는 방안입니다.",
                "sound_type": [
