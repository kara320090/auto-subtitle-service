        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러나 재단 이사회는 잘못은 했지만 해임은 과하다며 약식 구두 표결로 부결했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.616
            },
            {
                "speaker_id": "2",
                "transcription": "노사 발전 재단 운영과 관련해서 감사한 결과에 대해서는 송구하게 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 6.626,
                "end": 12.026
            },
            {
                "speaker_id": "2",
                "transcription": "감사 결과에 대해서는 후속 조치나 처분이 종결된 상태입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.036,
                "end": 16.127
            },
            {
                "speaker_id": "2",
                "transcription": "필요하다면 자세한 사항들은 청문회 등을 통해서 설명하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.137,
                "end": 21.626
            },
            {
                "speaker_id": "1",
                "transcription": "고용부 감사 결과 비위가 드러난 산하 기관 임원이 고용부 장관 후보자가 된 건 이번이 처음입니다.",
                "sound_type": [
