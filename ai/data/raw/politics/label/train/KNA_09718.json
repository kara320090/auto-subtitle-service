                "start": 0.000,
                "end": 5.576
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 국민의힘은 대표와 원내대표가 모두 불참한 가운데 일부 지도부만 참석했습니다.",
                "sound_type": [
