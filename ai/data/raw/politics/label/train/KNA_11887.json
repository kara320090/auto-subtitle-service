        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 이인영 원내대표는 국회의 총력 대응을 주문했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.245
            },
            {
                "speaker_id": "2",
                "transcription": "신종 코로나 바이러스 종식을 위한 어 국회 비상 행동을 제안합니다.",
                "sound_type": [
                    2
                ],
                "start": 4.255,
                "end": 10.575
            },
            {
                "speaker_id": "2",
                "transcription": "앞으로 2주가 신종 코로나 바이러스 확산과 어 관련해서 중대 고비라고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 10.585,
                "end": 17.578
            },
            {
                "speaker_id": "1",
                "transcription": "검역 인력 보강과 관련해 상임위에서 조처를 취하는 등 분야별 후속 대책을 마련하자는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 17.588,
                "end": 24.526
            },
            {
                "speaker_id": "1",
                "transcription": "또 감염 분야 등의 필수 인력을 국가 차원에서 양성하는 내용의 공공 의대법도 필요하다면 당장 통과시킬 수 있어야 한다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.536,
                "end": 34.255
            },
            {
                "speaker_id": "1",
                "transcription": "한국당 황교안 대표가 정부가 중국에 마스크 300만 개를 가져다줘 국민이 분개한다고 한 발언에 대해선 이번 일은 한중 민간 기업과 유학생이 추진한 일이라며 유감스럽다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.265,
                "end": 47.123
            },
            {
                "speaker_id": "1",
                "transcription": "자유한국당 심재철 원내대표는 문재인 대통령의 갈팡질팡이 일상이 됐다며 정부 대응을 강하게 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.133,
                "end": 55.425
            },
            {
                "speaker_id": "1",
                "transcription": "특히 입국 금지 조치를 중국 후베이성 방문자로 한정한 데 대해선 어처구니가 없다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 55.435,
                "end": 62.297
            },
            {
                "speaker_id": "3",
                "transcription": "중국 전역이 오염됐는데도 후베이성만 지금 제한을 하고 있는 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 62.307,
                "end": 69.803
            }
        ]
    },
    "summary": "민주당 이인영 원내대표는 분야별 후속 대책을 마련하자고 했고 또 감염 분야 등의 필수 인력을 국가 차원에서 양성하는 내용의 공공 의대법도 필요하다면 당장 통과시킬 수 있어야 한다고 말했다.",
