        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부는 주한 일본 대사도 불러 강력히 항의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.320
            },
            {
                "speaker_id": "1",
                "transcription": "일본은 그동안 오염수 방출 방식과 기간 총량 등을 묻는 우리 정부의 요청에 답을 해 오지 않았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.320,
                "end": 10.206
            },
            {
                "speaker_id": "2",
                "transcription": "우리나라에 대해서는 이행 당사국으로서 충분한 협의를 하고 의견을 수렴한 것으로 생각하지는 않습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.216,
                "end": 19.700
            },
            {
                "speaker_id": "1",
                "transcription": "다만 강한 유감을 전하는 것 말고는 마땅한 대응 카드가 없는 게 정부로서는 고민입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.710,
                "end": 25.734
            },
            {
                "speaker_id": "1",
                "transcription": "주한 일본 대사는 한국 국민들의 걱정을 잘 알고 있다며 주변국의 환경에 영향을 주지 않도록 책임지고 대처하겠다라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.744,
                "end": 33.493
            },
            {
                "speaker_id": "1",
