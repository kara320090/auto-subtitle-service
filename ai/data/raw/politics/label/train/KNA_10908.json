        "term": [
            {
                "speaker_id": "1",
                "transcription": "경쟁 후보들도 비판에 가세했는데 소문은 김 후보에게 향했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.212
            },
            {
                "speaker_id": "2",
                "transcription": "그런 문제들이 생긴 것이 또 저는 김기현 후보에게 책임이 있다고 봐요.",
                "sound_type": [
                    2
                ],
                "start": 5.222,
                "end": 9.935
            },
            {
                "speaker_id": "2",
                "transcription": "사람들을 막 여기저기서 끌어 모으다 보니까 이런 부작용도.",
                "sound_type": [
                    2
                ],
                "start": 9.945,
                "end": 13.597
            },
            {
                "speaker_id": "3",
                "transcription": "전 이건 김기현 후보도 굉장히 큰 문제이고 대통령실의 행위도 이거는 범죄기 때문에 선을 완전히 넘었다.",
                "sound_type": [
                    2
                ],
                "start": 13.607,
                "end": 21.674
            },
            {
                "speaker_id": "1",
                "transcription": "김기현 후보는 사실 관계 파악이 우선이라면서도 불법은 아니라고 받아쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.684,
                "end": 27.594
            }
        ]
    },
    "summary": "경쟁 후보들은 문제의 책임이 김기현 후보에게 있다며 비판했고 김기현 후보는 사실 관계 파악이 우선이라면서도 불법은 아니라고 말했다.",
