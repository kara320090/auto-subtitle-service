        "term": [
            {
                "speaker_id": "1",
                "transcription": "상정된 위원 후보 7명 중 이재봉 울산대 교육학과 교수에 대한 선출안만 부결됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.316
            },
            {
                "speaker_id": "1",
                "transcription": "민주당이 다수 반대표를 던진 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 6.326,
                "end": 9.216
            },
            {
                "speaker_id": "1",
                "transcription": "이 교수를 추천한 국민의 힘은 거세게 항의하자 집단 퇴장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.226,
                "end": 13.977
            },
            {
                "speaker_id": "1",
                "transcription": "여야가 각각 추천하는 위원회 인사에 선출한 부결은 이례적입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.987,
                "end": 19.299
            },
            {
                "speaker_id": "2",
                "transcription": "집단적으로 이건 신의 측의 위반입니다.",
                "sound_type": [
                    2
                ],
                "start": 19.309,
                "end": 22.602
            },
            {
                "speaker_id": "2",
                "transcription": "묵시적인 관행과 합의를 깨뜨리고.",
                "sound_type": [
                    2
                ],
                "start": 22.612,
                "end": 26.211
            },
            {
                "speaker_id": "1",
                "transcription": "이 교수는 류석준 전 연세대 교수가 위안부 매춘 발언으로 기소됐을 때 검찰 비판 성명에 이름을 올렸고 문재인 정권이 종북 종중 4대 매국 세력이란 칼럼을 쓰기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.221,
                "end": 39.072
            }
        ]
    },
    "summary": "이재봉 교수에 대한 선출안만 부결되어 국민의 힘은 거세게 항의했다.",
