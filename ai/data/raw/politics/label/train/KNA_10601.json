        "term": [
            {
                "speaker_id": "1",
                "transcription": "이태원 참사의 책임을 회피하기 위한 경찰 내부의 조직적인 움직임이 있었다고 볼 수 있는 대목입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.766
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 이태원 참사를 기회 삼아 경찰청의 안전 관리 본부를 신설하는 방안도 논의한 것으로 파악됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.776,
                "end": 14.086
            },
            {
                "speaker_id": "1",
                "transcription": "참사와 관련한 보고서를 숨긴 정황도 추가로 드러났습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.096,
                "end": 18.609
            },
            {
                "speaker_id": "1",
                "transcription": "국회의 자료 제출 요구에 보고서는 한 건만 있다며 나머지 정보 보고서 3건을 은폐한 것으로 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.619,
                "end": 25.879
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 경찰은 이태원 참사와 관련해 용산 경찰서에서 작성된 정보 보고서 한 건만 국회에 제출했습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.889,
                "end": 33.099
            }
        ]
    },
    "summary": "이태원 참사의 책임을 회피하기 위한 움직임과 보고서를 숨긴 정황 은폐한 것이 확인됐다.",
