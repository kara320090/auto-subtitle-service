        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘 비공개회의에서 안철수 경계령을 내리며 당내 입단속에 나섰던 김종인 비대위원장",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.947
            },
            {
                "speaker_id": "1",
                "transcription": "연일 단일화를 주장하는 안 대표를 향해 작심 발언을 쏟아 냈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.957,
                "end": 12.108
            },
            {
                "speaker_id": "1",
                "transcription": "본인으로 단일화해 달라는 요구는 안 된다.",
                "sound_type": [
                    2
                ],
                "start": 12.118,
                "end": 15.073
            },
            {
                "speaker_id": "1",
                "transcription": "안 대표가 유일한 야권 단일 후보라는 생각은 정치 상식에 맞지 않는다.",
                "sound_type": [
                    2
                ],
                "start": 15.083,
                "end": 20.221
            },
            {
                "speaker_id": "1",
                "transcription": "안 대표의 현재 지지율은 의미가 없다고 잘라 말했습니다.",
                "sound_type": [
                    2
                ],
