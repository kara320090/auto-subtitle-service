        "term": [
            {
                "speaker_id": "1",
                "transcription": "강제 동원 피해 배상 방안을 논의하기 위한 공개 토론회 외교부는 전범 기업이 아닌 제삼자인 재단을 통해 배상금을 지급하는 방안을 공식화했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.552
            },
            {
                "speaker_id": "2",
                "transcription": "피고인 일본 기업 대신 제삼자가 변제 가능하다는 점이 검토되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.562,
                "end": 15.700
            },
            {
                "speaker_id": "2",
                "transcription": "바꿔 말하면 우리 피해자 분들이 판결금을 제삼자로부터 받는 것에도 문제가 없다는 이야기입니다.",
                "sound_type": [
