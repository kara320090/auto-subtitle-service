                ],
                "start": 0.000,
                "end": 5.014
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게까지 지금 계속 쇼를 이렇게 이러하면 선수끼리 진정성이 없지.",
                "sound_type": [
