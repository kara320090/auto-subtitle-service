                    2
                ],
                "start": 0.000,
                "end": 12.014
            },
            {
                "speaker_id": "2",
                "transcription": "국민 안전 책임 장관이 할 말이냐.",
                "sound_type": [
                    2
                ],
                "start": 12.024,
                "end": 14.695
            },
            {
                "speaker_id": "2",
                "transcription": "질타가 이어지자 예측이나 선동을 해선 안 된다는 취지였다고 해명했다가 결국 뒤늦게 국민들께서 염려하실 수도 있는 발언을 해 유감이라고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.705,
                "end": 25.609
            },
            {
                "speaker_id": "2",
                "transcription": "염려하실 수도 있는 발언 깨끗이 사과한 게 아니라는 비판이 또다시 일었다가 오늘 다시 사과한 겁니다.",
                "sound_type": [
                    2
