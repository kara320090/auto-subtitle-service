        "term": [
            {
                "speaker_id": "1",
                "transcription": "과거 총리 청문회와 비교하면 요청 자료가 서너 배나 많았다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.558
            },
            {
                "speaker_id": "1",
                "transcription": "특히 수십 년 전 자료에 대한 요구도 있었다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.568,
                "end": 8.034
            },
            {
                "speaker_id": "2",
                "transcription": "겨울에 산딸기를 구해 오라는 것처럼 답변 불가한 자료 제출 요구도 많습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.044,
                "end": 13.967
            },
            {
                "speaker_id": "1",
                "transcription": "전체 청문 위원 중 과반이 불참한 가운데 청문회는 오전 오후 합쳐 1시간도 채우지 못하고 끝났습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.977,
                "end": 21.219
            },
            {
                "speaker_id": "1",
                "transcription": "한 후보자 선서는 물론 질의 답변이 한 차례도 이뤄지지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.229,
                "end": 26.161
            },
            {
                "speaker_id": "3",
                "transcription": "감사님들끼리 계속 협의를 하시는 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.171,
                "end": 29.048
            },
            {
                "speaker_id": "3",
                "transcription": "감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 29.058,
                "end": 29.929
            }
        ]
    },
    "summary": "과거 총리 청문회와 비교하면 요청 자료가 서너 배가 많았고 청문 위원 과반이 불참한 가운데 한 후보자 선서는 물론 질의 답변도 이루어지지 않았다.",
