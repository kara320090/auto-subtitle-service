        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "올해 마지막 날 민주당 이재명 후보가 찾은 곳은 코로나 거점 병원이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.921
            },
            {
                "speaker_id": "1",
                "transcription": "코로나 치료를 전담하게 된 민간 병원인데 공공 영역이 일을 대신하는 만큼 손실이 발생하지 않도록 보상 체계를 마련해야 한다고 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.931,
                "end": 15.447
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보는 모든 지역에 공공 병원을 충분히 마련하겠다는 공약도 내놨습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.457,
                "end": 21.024
            },
            {
                "speaker_id": "2",
                "transcription": "공공 병상 비중은 여전히 10퍼센트에 불과합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.034,
                "end": 24.055
            },
            {
                "speaker_id": "2",
                "transcription": "대다수 공공 병원은 300병상 이하의 소규모 병원이고 공공 의료 인력도 턱없이 부족한 실정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.065,
                "end": 32.312
            },
            {
                "speaker_id": "1",
                "transcription": "코로나 장기화에 따른 소상공인 자영업자 피해에 대비해 가능하면 빨리 대규모 추경을 편성하자고도 제안했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.322,
                "end": 40.786
            },
            {
                "speaker_id": "1",
                "transcription": "국민의 힘 윤석열 후보는 충북 단양의 구인사를 찾아 불교계에 표심을 호소하며 사흘 간의 대구 경북 충북 방문 일정을 마쳤습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.796,
                "end": 51.126
            },
            {
                "speaker_id": "1",
                "transcription": "박근혜 전 대통령이 옥중 서신을 엮은 책에서 과거 수사 과정에 부당함을 주장한 데 대해선 수사는 공직자 신분으로 법을 집행한 거다 이제 본인은 정치인으로 국민 통합을 생각해야 한다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.136,
                "end": 65.935
            },
            {
                "speaker_id": "3",
                "transcription": "정치인으로서 국가를 위해서 다 크게 기여하신 분들에 대한 그 평가 이런 것들을 저는 지금 생각해야 되는 입장이고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 65.945,
                "end": 76.980
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보는 내년 정권 교체를 현실로 만들고 새 정부가 변화를 이뤄내 국민의 삶을 바꾸겠다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 76.990,
                "end": 85.136
            },
            {
                "speaker_id": "1",
                "transcription": "정의당 심상정 후보는 미혼모 협회와의 간담회에서 결혼하지 않아도 함께 살면 가족 구성원으로 인정하는 법을 만들겠다 했고 서울 수유 시장을 찾은 국민의 당 안철수 후보는 단일화에 대해 제가 정권 교체에 더 좋은 대한민국을 만들겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 85.146,
                "end": 102.540
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 102.550,
                "end": 104.504
            }
        ]
    },
    "summary": "이 후보는 코로나 거점 병원을 윤 후보는 단양의 구인사를 찾아 대선 공약을 발표했으며 심상정 후보는 미혼모 협회 안철수 후보는 서울 수유 시장에서 각각 유세를 하였다.",
