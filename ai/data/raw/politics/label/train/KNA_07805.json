        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 처음 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.910
            },
            {
                "speaker_id": "1",
                "transcription": "수정 제안도 없이 바로 걷어차는 거는 저는 저도 원내대표 출신인데요.",
                "sound_type": [
                    2
                ],
                "start": 0.920,
                "end": 5.178
            },
            {
                "speaker_id": "1",
                "transcription": "저는 사실 조금 어이가 좀 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.188,
                "end": 8.793
            },
            {
                "speaker_id": "2",
                "transcription": "민주당 협상안은 법제 사법 위원장을 내줄 테니 검찰 수사 기소권 분리 후속 조치인 사법 개혁 특별 위원회 구성에 참여하라는 요구입니다.",
                "sound_type": [
                    2
                ],
                "start": 8.803,
                "end": 17.656
            },
            {
                "speaker_id": "2",
                "transcription": "반면 국민의힘은 검찰 수사권 완전 박탈 이른바 검수완박 마무리에 협조할 수 없다는 입장입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.666,
                "end": 24.794
            },
            {
                "speaker_id": "2",
                "transcription": "권성동 원내대표는 헌재에 권한쟁의심판까지 제기했는데 그 부산물인 사개특위를 어떻게 받느냐면서 민주당이 생떼를 쓰는 거라고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.804,
                "end": 34.223
            },
            {
                "speaker_id": "2",
                "transcription": "기존 여야 합의대로 후반기 법사 위원장을 국민의힘이 맡고 다른 문제는 국회 개헌 후 논의하자는 주장입니다.",
                "sound_type": [
                    2
                ],
                "start": 34.233,
                "end": 41.141
            }
        ]
    },
    "summary": "국민의힘은 민주당이 생떼를 쓰는 거라고 하며 국회 개헌 후 논의하자는 주장이다.",
