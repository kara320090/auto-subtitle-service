        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부가 자녀 출산과 양육을 지원하기 위해 올해부터 부모 급여를 줍니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.969
            },
            {
                "speaker_id": "1",
                "transcription": "생후 24개월 미만까지 자녀를 둔 부모가 대상인데 첫 돌까지는 70만 원 만 1살 아기 부모에게는 35만 원이 지급됩니다.",
                "sound_type": [
                    2
                ],
                "start": 5.979,
                "end": 16.038
            },
            {
                "speaker_id": "2",
                "transcription": "옷이나 유모차나 좀 필요한 물건들이 되게 많아가지고요.",
                "sound_type": [
                    2
                ],
                "start": 16.048,
                "end": 19.791
            },
            {
                "speaker_id": "2",
                "transcription": "그것들을 좀 사고 하다 보면 지출이 평소보다는 좀 많이 생기는 거 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.801,
                "end": 24.491
            },
            {
                "speaker_id": "1",
                "transcription": "맞벌이 가정 등을 방문해 식사 챙겨주기 등을 해주는 아이 돌봄 서비스 시간도 늘어납니다.",
                "sound_type": [
                    2
                ],
                "start": 24.501,
