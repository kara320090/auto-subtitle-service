        "term": [
            {
                "speaker_id": "1",
                "transcription": "모임의 성격을 두고 친윤계 의원 사이 이견도 노출됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.697
            },
            {
                "speaker_id": "1",
                "transcription": "권선동 원내 대표는 자칫 계파 이야기가 붉어지고 윤석열 정부 성공에도 방해가 될 수 있다 자신이 앞장서서 막겠다고 공개적으로 제동을 걸었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.707,
                "end": 14.842
            },
            {
                "speaker_id": "2",
                "transcription": "과거에 제가 박근혜 정부 때나 이명박 정부 때도 이런 모임들이 있었는데 이게 당의 분열로 이어져서 그 다음에 정권 연장 실패로 이어진 예가 많고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.852,
                "end": 24.854
            },
            {
                "speaker_id": "1",
                "transcription": "이에 장제원 의원은 이해할 수 없다며 직접 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.864,
                "end": 29.021
            },
            {
                "speaker_id": "1",
                "transcription": "누구나 참여할 수 있는 공개 모임인데도 당 분열 딱지를 붙였다며 사조직 지적은 수용할 수 있다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.031,
                "end": 36.703
            }
        ]
    },
