        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 @이름1 금융 위원장에게 임명장을 수여했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.538
            },
            {
                "speaker_id": "1",
                "transcription": "국회 공전으로 인사 청문회가 기안 내에 열리지 못하자 임명을 강행한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 4.548,
                "end": 10.287
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 이번 정부에서 인사 청문회 없이 임명된 고위 공직자는 네 명으로 늘었습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.297,
                "end": 16.423
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 국회 패싱은 국민 패싱이라며 강하게 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.433,
                "end": 21.072
            },
            {
                "speaker_id": "2",
                "transcription": "금융 불안 상황을 이용한 벼랑 끝 전술로 금융 수장 임명을 강행하는 것은 청문회 제도에 존립 근거 자체를 허무는 국정 독주입니다.",
                "sound_type": [
                    2
