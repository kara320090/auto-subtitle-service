                    5
                ],
                "start": 9.392,
                "end": 15.131
            },
            {
                "speaker_id": "1",
                "transcription": "친문계 고민정 의원이 2위를 지켰지만 친명계로 분류되는 정청래 장경태 서영교 박찬대 의원 4명이 당선권인 5위 안에 들어갔습니다.",
                "sound_type": [
                    2,
