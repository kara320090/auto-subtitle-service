        "term": [
            {
                "speaker_id": "1",
                "transcription": "21대 지역구 국회의원들의 선거 공약 만 1000여 건.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.620
            },
            {
                "speaker_id": "1",
                "transcription": "1표를 호소하며 유권자들에게 목청껏 알린 약속입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.630,
                "end": 7.718
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 공약을 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.728,
                "end": 10.419
            },
            {
                "speaker_id": "3",
                "transcription": "제대로 실현하려면 그 짐을 지워주십시오.",
                "sound_type": [
                    2
                ],
                "start": 10.429,
                "end": 14.312
            },
            {
                "speaker_id": "1",
                "transcription": "2년 6개월이 지난 현재 지역구 의원 252명의 홈페이지와 SNS 등에 공약이 공개돼 있는지 전수 조사했습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.322,
                "end": 23.160
            },
            {
                "speaker_id": "1",
                "transcription": "공약을 아예 공개하지 않은 의원은 55명.",
