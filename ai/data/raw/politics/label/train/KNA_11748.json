                "start": 0.000,
                "end": 10.627
            },
            {
                "speaker_id": "2",
                "transcription": "중단하라 중단하라.",
                "sound_type": [
                    2
                ],
                "start": 10.637,
                "end": 12.354
            },
            {
                "speaker_id": "1",
                "transcription": "언론 노조는 졸속 추진을 멈추라며 강력 반발했습니다.",
                "sound_type": [
