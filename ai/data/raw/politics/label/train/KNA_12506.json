        "term": [
            {
                "speaker_id": "1",
                "transcription": "십일육 대책 및 육일칠 대책에 추가 대책을 포함하는 방안도 검토할 것이며 최대한 신속하게 개정안을 발의해 7월 국회 내에 처리하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.718
            },
            {
                "speaker_id": "2",
                "transcription": "통합당은 긴급 간담회에서 정부의 부동산 정책이 일관성이 없어 부동산 투기 현상이 나타났다고 진단했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.728,
                "end": 21.715
            },
            {
                "speaker_id": "2",
                "transcription": "현 정부가 추진 중인 세금과 대출 규제는 실수요 말세 정책뿐이라는 지적도 나왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.725,
                "end": 28.091
            },
            {
                "speaker_id": "2",
                "transcription": "수요를 억제하는 정책 대신 공급 확대에 방점을 찍도록 법을 바꿔야 한다는 얘기가 오갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.101,
                "end": 35.094
            },
            {
                "speaker_id": "2",
                "transcription": "용적률을 올리고 재개발과 재건축 조건을 완화해 주택 공급을 늘리자는 제안도 제시됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.104,
                "end": 41.708
            },
            {
                "speaker_id": "3",
                "transcription": "국민들이 신뢰하고 예측할 수 있는 부동산 정 정책을 추진하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.718,
                "end": 48.642
            },
            {
                "speaker_id": "3",
                "transcription": "지속적인 공급 확대를 통해서 시장에서의 가격 안정화를 추진하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 48.652,
                "end": 56.589
            }
        ]
    },
    "summary": "통합당은 긴급 간담회에서 정부의 부동산 정책이 일관성이 없어 부동산 투기 현상이 나타났고 수요 억제 대신 공급 확대에 방점을 찍고 용적률을 올려 재개발과 재건축 조건을 완화해 주택 공급을 늘리자는 제안이 제시했으며 지속적인 공급 확대를 통해 시장에서의 가격 안정화를 추진하겠다고 했다.",
