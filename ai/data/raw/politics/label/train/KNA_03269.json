        "term": [
            {
                "speaker_id": "1",
                "transcription": "법적인 절차들이 기본적으로 다 지켜져야 되니까 그걸 어느 정도 간소화를 해줄 거냐 이런 문제에 대해서는 좀 구체적으로 나와야 되지 않을까 싶습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 9.990
            },
            {
                "speaker_id": "2",
                "transcription": "이를 위해선 법안 정비 등 정부와 자치단체 간 긴밀한 협력이 필수조건입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.990,
                "end": 16.240
            },
            {
                "speaker_id": "3",
                "transcription": "기존에 소유자들이 있는 상태에서 사업 모델을 만들어 내는 거기 때문에 국회도 적극적으로 도와줘야 될 거고 서울시 협업이 중요하기 때문에",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.250,
                "end": 26.534
            },
            {
                "speaker_id": "2",
                "transcription": "여기에 기한 내 공급 물량 달성에만 급급할 경우 오히려 부작용을 낳을 수도 있습니다.",
                "sound_type": [
                    2,
