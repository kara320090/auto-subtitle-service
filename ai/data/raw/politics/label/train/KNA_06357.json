        "term": [
            {
                "speaker_id": "1",
                "transcription": "수사와 감사를 이유로 김혜경 씨는 구체적 사실 관계를 묻는 취재진 질문에 세세히 답변하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.191
            },
            {
                "speaker_id": "2",
                "transcription": "법인 카드 유용 부분을 포함해서 인정하시는 사실 관계가 어디까지인지",
                "sound_type": [
                    2
                ],
                "start": 7.201,
                "end": 13.018
            },
            {
                "speaker_id": "3",
                "transcription": "수사와 감사가 진행되고 있다고 들었습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.028,
                "end": 17.197
            },
            {
                "speaker_id": "3",
                "transcription": "실체적인 진실이 밝혀질 때까지 최선을 다해서 협조를 하고 응분의 책임이 있다면 책임을 질 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.207,
                "end": 27.344
            },
            {
                "speaker_id": "1",
                "transcription": "그간 녹취록 등을 통해 드러난 약 대리 처방 의혹 법인 카드로 음식 구매 등의 의혹에서 김 씨 자신이 지시를 했거나 인식을 했는지 등에 대해 거론하지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.354,
                "end": 38.817
            },
            {
                "speaker_id": "1",
                "transcription": "때로 여러 도움을 받았다.",
                "sound_type": [
                    2
                ],
                "start": 38.827,
                "end": 41.329
            },
            {
                "speaker_id": "1",
                "transcription": "공사 구분을 했어야 했다 등의 포괄적 표현만 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 41.339,
                "end": 45.245
            }
        ]
    },
