            },
            {
                "speaker_id": "2",
                "age": "50대 이상",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인은 집무실 이전을 단순한 공간 이전이 아니라고 표현했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.672
            },
            {
                "speaker_id": "2",
                "transcription": "공간이 그 업무와 일을 좌우한다는 말이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.682,
                "end": 11.127
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 조감도를 설명하며 공간을 어떻게 배치해 소통을 하겠다는 것인지 대략적으로 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.137,
                "end": 18.569
            },
            {
                "speaker_id": "1",
                "transcription": "우선은 대통령과 비서진들이 한 건물에서 일하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.579,
                "end": 23.493
            },
            {
                "speaker_id": "1",
                "transcription": "대통령 집무실과 참모진들의 사무실 민관 위원회 기자 회견장 등을 한 건물에 함께 두겠다는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.503,
                "end": 30.904
            },
            {
                "speaker_id": "2",
                "transcription": "물리적 공간의 문제보다 더 중요한 것은 소통의 의지라는 점을 잘 알고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.914,
                "end": 37.736
            },
            {
                "speaker_id": "2",
                "transcription": "1층에 프레스 센타를 설치해서 수시로 언론과 소통하는 대통령이 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.746,
                "end": 45.888
            },
            {
                "speaker_id": "1",
                "transcription": "국방부 청사로의 이전 역시 국민과 단절은 마찬가지 아니냐는 비판을 의식한 듯 국민과 어떻게 접점을 만들겠다는 건지 계획도 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 45.898,
                "end": 56.370
            },
            {
                "speaker_id": "1",
                "transcription": "집무실 건물 주변에서 용산 공원까지 이어진 구간에 낮은 담 정도만 둬서 시민들이 청사를 쉽게 볼 수 있게 하겠다는 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 56.380,
                "end": 65.453
            },
            {
                "speaker_id": "2",
                "transcription": "최소한의 범위 내에만 에 저희가 백악관 같이 낮은 펜스를 설치하고",
                "sound_type": [
                    2
                ],
                "start": 65.463,
                "end": 71.756
            },
            {
                "speaker_id": "1",
                "transcription": "이런 계획을 위해 당선인 측은 용산 공원 조성에 속도를 더 낼 것이라고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 71.766,
                "end": 77.789
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인 관저는 집무실에서 3분에서 5분 정도 거리의 한남동 육군 참모총장 공관을 우선 사용하다 집무실 인근에 새로 짓는 방안도 검토하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 77.799,
                "end": 88.562
            },
            {
                "speaker_id": "1",
                "transcription": "당선인 측은 용산 집무실 설치로 용산이나 남산 일대에 추가적인 방공포대를 설치할 필요가 없고 고도 제한도 그대로 유지된다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 88.572,
                "end": 99.227
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 방준원입니다.",
                "sound_type": [
                    2
                ],
                "start": 99.237,
                "end": 101.334
            }
        ]
    },
    "summary": "윤 당선인은 물리적 공간의 문제보다 더 중요한 것은 소통의 의지라며 조감도를 설명하며 소통을 위한 공간 배치를 대략적으로 밝혔다.",
