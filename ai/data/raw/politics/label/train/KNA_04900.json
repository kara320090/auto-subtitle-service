        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 당의 의견들을 최대한 수렴해서 합리적인 결정이 내려질 수 있도록 그렇게 노력하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.700
            },
            {
                "speaker_id": "2",
                "transcription": "입당 6개월이 안 돼 출마가 무산된 @이름1 전 비대위원장은 4월 비대위 찬반 표결로 피선거권이 생겼다고 주장하며 출마 강행 의사를 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.700,
                "end": 16.114
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 지도부는 인준 표결과 당 대표 출마 자격은 다르다는 입장입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.124,
                "end": 21.292
            },
            {
                "speaker_id": "2",
                "transcription": "민주당 지도부는 반대 의견을 반영해 전대 규칙을 일부 수정한 뒤 오늘 당무위에서 최종 확정할 예정입니다.",
                "sound_type": [
