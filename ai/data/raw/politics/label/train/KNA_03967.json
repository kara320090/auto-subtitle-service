        "term": [
            {
                "speaker_id": "1",
                "transcription": "그동안 줄곧 부인하던 5차 재난지원금 지급 준비를 이제 시작하겠다고 언급한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.354
            },
            {
                "speaker_id": "1",
                "transcription": "대신 나라 빚을 더 내지 않고 올해 더 거친 세금을 활용할 뜻을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.364,
                "end": 11.562
            },
            {
                "speaker_id": "1",
                "transcription": "1분기까지 거친 국세 수입은 88조 5000억 원 1년 전보다 20조 원 가까이 많습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.572,
                "end": 18.330
            },
            {
                "speaker_id": "2",
                "transcription": "올해 경기 회복으로 인해서 세수가 또 늘어나는 그런 거를 예측하지 못한 거죠.",
                "sound_type": [
                    2
                ],
                "start": 18.340,
                "end": 23.897
            },
            {
                "speaker_id": "2",
                "transcription": "정부 추계보다 적어도 20조 이상 세수가 들어온다고 봐도 무방한 거죠.",
                "sound_type": [
                    2
