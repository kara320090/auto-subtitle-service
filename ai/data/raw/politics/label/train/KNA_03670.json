        "term": [
            {
                "speaker_id": "1",
                "transcription": "공수처가 만들려는 사건 사무 규칙의 핵심은 검경의 판검사나 고위직 경찰 사건을 이첩하더라도 수사가 끝난 뒤 기소 여부는 공수처가 사건을 다시 이첩받아 결정하겠단 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.873
            },
            {
                "speaker_id": "1",
                "transcription": "공수처는 이 같은 규칙 초안을 검경에 보냈는데 지난달 대검찰청이 공식적인 반대 입장을 공수처에 전한 것으로 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.883,
                "end": 20.875
            },
            {
                "speaker_id": "1",
                "transcription": "대검은 사건 이첩을 규정한 공수처법 24조를 근거로 든 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
