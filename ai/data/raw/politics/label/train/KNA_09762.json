        "term": [
            {
                "speaker_id": "1",
                "transcription": "밝히고자 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.378
            },
            {
                "speaker_id": "1",
                "transcription": "이 재산은 정부가 국민의 뜻에 따라 처리해 주시기를 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 1.388,
                "end": 8.273
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 추징금 납부를 미루다 2021년 11월 사망했고 922억 원은 미납으로 남았습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.283,
                "end": 15.972
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 이 가운데 55억 원 추가로 환수할 수 있는 길이 열렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.982,
                "end": 20.944
            },
            {
                "speaker_id": "2",
                "transcription": "전 씨 일가가 신탁사에 맡긴 경기도 오산 땅을 공매한 대금을 국가가 압류한 것을 두고 신탁사가 낸 소송에서 법원이 압류가 가능하다는 판단을 내린 겁니다.",
