        "term": [
            {
                "speaker_id": "1",
                "transcription": "영하 10도까지 떨어진 한파에도 난로와 전기장판에 의지해 겨울을 지내는 70대 어르신 지자체 공무원은 매일 찾아와 긴급 주거 지원을 받으라고 권합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.702
            },
            {
                "speaker_id": "2",
                "transcription": "1주일 만이라도 여관방 얻어드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 11.712,
                "end": 14.609
            },
            {
                "speaker_id": "3",
                "transcription": "아니 괜찮아요.",
                "sound_type": [
                    2
                ],
                "start": 14.619,
                "end": 15.884
            },
            {
                "speaker_id": "3",
                "transcription": "아 여기 따뜻해요.",
                "sound_type": [
                    2
                ],
                "start": 15.894,
                "end": 17.375
            },
            {
                "speaker_id": "2",
                "transcription": "아니 다리 나을 동안만이라도 아니면 겨울 추운 거 좀 가실 때까지만이라도",
                "sound_type": [
                    2
                ],
                "start": 17.385,
                "end": 22.459
            },
            {
                "speaker_id": "1",
                "transcription": "거절하는 이유는 이렇습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.469,
                "end": 24.670
            },
            {
                "speaker_id": "3",
                "transcription": "자존심 때문에 그렇지.",
                "sound_type": [
                    2
                ],
                "start": 24.680,
                "end": 27.082
            },
            {
                "speaker_id": "3",
                "transcription": "자존심만 없으면 뭐 시청 올라가서 달라고 하면 되지.",
                "sound_type": [
                    2
                ],
                "start": 27.092,
                "end": 31.452
            },
            {
                "speaker_id": "3",
                "transcription": "못하겠더라고요 그런 말.",
                "sound_type": [
                    2
                ],
                "start": 31.462,
                "end": 33.033
            }
        ]
    },
    "summary": "한파에도 난로와 전기장판에 의지해 겨울을 지내는 70대 어르신은 자존심 때문에 지자체의 도움을 거절한다.",
