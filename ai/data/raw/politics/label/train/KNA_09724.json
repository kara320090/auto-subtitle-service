        "term": [
            {
                "speaker_id": "1",
                "transcription": "전 시민들이나 도민들한테 굉장히 공분을 살 수밖에 없는",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.560
            },
            {
                "speaker_id": "2",
                "transcription": "김진태 강원도 지사는 1시간 연가를 낸 거라고 해명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.570,
                "end": 7.625
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 정작 연가 신청은 사흘 뒤에서야 이루어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.635,
                "end": 11.465
            },
            {
                "speaker_id": "2",
                "transcription": "김 지사는 입장문을 통해 이유 여하를 불문하고 부적절한 행동이었다고 사과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.475,
                "end": 16.982
            },
            {
                "speaker_id": "3",
                "transcription": "일정도 있으시고 조만간에 직접 뭐 카메라 앞에서 밝히실 기회가 있으실 겁니다 그건 당연한 거고요.",
                "sound_type": [
                    2
                ],
                "start": 16.992,
                "end": 23.021
            },
            {
                "speaker_id": "2",
                "transcription": "김영환 충북 도지사도 비슷한 일로 논란의 중심에 섰습니다.",
                "sound_type": [
                    2
