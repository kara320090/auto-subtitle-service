            },
            {
                "speaker_id": "1",
                "transcription": "화주로부터 일감은 따오지 않고 화물차주들에게 2000에서 3000만 원씩 받으며 번호판만 빌려주던 관행을 깨겠다는 겁니다.",
                "sound_type": [
                    2,
