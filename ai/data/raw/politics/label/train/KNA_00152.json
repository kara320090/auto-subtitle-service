        "term": [
            {
                "speaker_id": "1",
                "transcription": "위기의 나라를 바로 잡을 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.762
            },
            {
                "speaker_id": "2",
                "transcription": "또 중부권 동서 횡단 철도 건설과 대전을 4차 산업 특별 도시로 육성하는 등 지역 맞춤형 공약도 잇따라 발표했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.772,
                "end": 10.655
            },
            {
                "speaker_id": "2",
                "transcription": "정의당 심상정 후보는 공개 일정 없이 선거 전략과 공약을 내부적으로 논의했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.665,
                "end": 16.425
            },
            {
                "speaker_id": "2",
                "transcription": "국민의당 안철수 후보는 삼성전자 반도체 공장을 방문해 반도체 인력 부족에 대한 고충을 듣고 특수 학교를 만들어서라도 반도체 인력을 확충하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.435,
                "end": 26.416
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 박민철입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.426,
                "end": 29.042
            },
            {
                "speaker_id": "3",
                "transcription": "임기 문제로 논란이 된 조해주 중앙 선관위 상임위원이 이틀만인 오늘 다시 사직서를 제출했고 문재인 대통령이 결국 사의를 수용했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.052,
                "end": 39.858
            },
            {
                "speaker_id": "3",
                "transcription": "야당 뿐 아니라 선관위 직원들이 반발한 것도 영향을 미친 것으로 보입니다.",
