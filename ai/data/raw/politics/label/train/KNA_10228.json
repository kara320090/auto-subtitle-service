        "term": [
            {
                "speaker_id": "1",
                "transcription": "가결되었음을 선포합니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 0.000,
                "end": 3.826
            },
            {
                "speaker_id": "2",
                "transcription": "지난 4월 고성과 야유 몸싸움 끝에 통과된 검찰청법 개정안.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 3.836,
                "end": 8.812
            },
            {
                "speaker_id": "2",
                "transcription": "검찰의 직접 수사 범위를 6개에서 2개로 줄이는 내용을 담았는데 다음 달부터 시행 예정입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.822,
                "end": 15.958
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 오늘 법무부가 검찰의 직접 수사 범위를 새롭게 정하는 시행령 개정안을 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.968,
                "end": 22.347
            },
            {
                "speaker_id": "2",
                "transcription": "직원 남용이나 기부 행위 등 공직자 범죄 선거 범죄 일부를 부패 범죄 범주로 집어넣고 마약 유통과 기업형 조폭은 경제 범죄로 재분류한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 22.357,
                "end": 34.644
            },
            {
                "speaker_id": "3",
                "transcription": "국민권익위 홈페이지를 보시면 아시겠지만 직권 남용은 대표적인 구조적 부패 행위로 홈페이지에 명시하고 있습니다.",
                "sound_type": [
                    2
