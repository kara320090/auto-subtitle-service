        "term": [
            {
                "speaker_id": "1",
                "transcription": "경제에 관해서 정확히 어떤 일을 할 거고 어떻게 해서 경제를 살릴 건지.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 5.528
            },
            {
                "speaker_id": "2",
                "transcription": "헌법 제10조 누구나 행복하게 살 권리는 가장 기본적이지만 가장 절실한 소망입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.538,
                "end": 12.060
            },
            {
                "speaker_id": "3",
                "transcription": "국민 모두가 평등하게 행복할 수 있는 차별을 느낀다라고 느끼지 않는 느끼는 국민이 많이 줄어들었으면.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.070,
                "end": 19.997
            },
            {
                "speaker_id": "4",
                "transcription": "저는 사람이 키워드가 됐으면 좋겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.007,
                "end": 23.783
            },
            {
                "speaker_id": "4",
                "transcription": "사람이 사람다운 권리를 누릴 수 있는 사회.",
                "sound_type": [
                    2
                ],
                "start": 23.793,
                "end": 27.616
            },
            {
                "speaker_id": "2",
                "transcription": "대통령의 첫 대국민 약속이기도 한 취임사.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.626,
                "end": 31.069
            },
            {
                "speaker_id": "2",
                "transcription": "국민들은 희망을 엿볼 수 있기를 기대합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 31.079,
                "end": 34.067
            }
        ]
    },
    "summary": "대통령 취임사에 바라는 점을 국민들이 말하고 있다.",
