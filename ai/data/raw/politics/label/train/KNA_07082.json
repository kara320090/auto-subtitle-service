        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부 출범 준비는 팽개친 채 팔도를 유람하면서 지방 선거 출마자들과 사진 찍고 밥 먹는 데 시간을 허비하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.915
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 김동연 경기 지사 후보는 탄핵까지 거론하며 노골적 선거 개입을 중단하라고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.925,
                "end": 16.487
            },
            {
                "speaker_id": "1",
                "transcription": "윤 당선인 측은 민생을 살피고 당선 감사 인사를 하는 건 당연한 일이라고 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.497,
                "end": 24.202
            },
            {
                "speaker_id": "1",
                "transcription": "그걸 가지고 왈가왈부하는 거는 윤석열 대통령에 대한 기대 국민들의 어떤 기대 그런 게 겁나는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 24.212,
                "end": 31.269
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 과거 선거를 앞두고 문재인 대통령도 지역 방문을 했었다며 역공을 폈습니다.",
                "sound_type": [
                    2
