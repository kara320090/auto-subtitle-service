                ],
                "start": 0.000,
                "end": 5.973
            },
            {
                "speaker_id": "1",
                "transcription": "한 장관의 사과와 퇴장도 요구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.983,
                "end": 9.302
            },
            {
                "speaker_id": "2",
                "transcription": "동료 의원을 정치적 음모론자라고 바 이렇게 평가하는 국무 위원의 발언은 경악스럽습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.312,
                "end": 18.713
            },
            {
                "speaker_id": "3",
                "transcription": "명백하게 국회를 모욕한 것으로도 볼 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.723,
                "end": 22.674
            },
            {
                "speaker_id": "3",
                "transcription": "위원장께서 강력하게 경고해 주셔야 될 것 같고요.",
