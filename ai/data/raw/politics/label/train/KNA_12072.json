                    5
                ],
                "start": 5.606,
                "end": 19.349
            },
            {
                "speaker_id": "1",
                "transcription": "영세 소상공인에 대해선 별도로 긴급 소액자금을 3조 원까지 전액 보증해 줄 계획입니다.",
                "sound_type": [
