        "term": [
            {
                "speaker_id": "1",
                "transcription": "중대 재해 처벌법 의결을 앞둔 국회 법사위 앞.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.353
            },
            {
                "speaker_id": "2",
                "transcription": "살려내라 살려내라 살려내라.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.363,
                "end": 6.835
            },
            {
                "speaker_id": "1",
                "transcription": "산재 유족들과 단식 농성을 해왔던 정의당은 5인 미만 사업장 제외와 50인 미만 사업장의 3년 유예 법안에 거세게 항의했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.845,
                "end": 16.137
            },
            {
                "speaker_id": "1",
                "transcription": "최근 3년 간 전체 재해자 3명 중 1명이 5인 미만 사업장에서 발생했기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.147,
                "end": 22.101
            },
            {
                "speaker_id": "3",
                "transcription": "5인 미만 사업장에서 가장 많은 사망 산재 일어나고 명확하게 구멍이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 22.111,
                "end": 27.380
            },
            {
                "speaker_id": "1",
                "transcription": "심사를 주도한 민주당 내에서도 반대 의견이 나왔지만",
                "sound_type": [
                    2
                ],
                "start": 27.390,
                "end": 31.670
            },
            {
                "speaker_id": "4",
                "transcription": "열악한 현실이라든지 이런 것들을 정말 뭐 감안한다",
