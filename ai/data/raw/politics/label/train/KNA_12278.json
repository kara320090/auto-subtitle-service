        "term": [
            {
                "speaker_id": "1",
                "transcription": "여느 부부처럼 대형 마트를 찾은 문 대통령 부부.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.339
            },
            {
                "speaker_id": "1",
                "transcription": "카트를 직접 밀며 설맞이 장보기에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.349,
                "end": 6.825
            },
            {
                "speaker_id": "1",
                "transcription": "차례상에 올릴 딸기와 사과 단감을 고르고.",
                "sound_type": [
                    2
                ],
                "start": 6.835,
                "end": 10.769
            },
            {
                "speaker_id": "2",
                "transcription": "당신도 하나 골라보세요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.779,
                "end": 12.333
            },
            {
                "speaker_id": "1",
                "transcription": "각종 야채와 나물 돼지고기 등도 구입했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.343,
                "end": 16.373
            },
            {
                "speaker_id": "1",
                "transcription": "물건을 직접 고르며 가격도 확인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.383,
                "end": 19.601
            },
            {
                "speaker_id": "1",
                "transcription": "마트 직원들과는 인사를 나누고 사진도 찍었습니다.",
