        "term": [
            {
                "speaker_id": "1",
                "transcription": "인수위 외교안보 분야 간사는 이명박 정부에서 일한 김성한 전 차관이 임명됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.590
            },
            {
                "speaker_id": "1",
                "transcription": "당선인의 외교 과외를 맡아 외교부 장관으로 거론돼온 인사로 한미동맹을 외교안보의 중심축으로 강조합니다.",
                "sound_type": [
                    2
                ],
                "start": 5.600,
                "end": 13.412
            },
            {
                "speaker_id": "1",
                "transcription": "인수위에 합류한 김태효 전 기획관은 이명박 정부의 대외 정책을 주도해 외교안보 실세로 불렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.422,
                "end": 20.040
            },
            {
                "speaker_id": "1",
                "transcription": "대북 강경론자로 분류되는데 이명박 정부 당시 군 댓글 조작 혐의로 현재 재판을 받고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.050,
                "end": 26.826
            }
        ]
    },
    "summary": "인수위 외교안보 분야 간사는 이명박 정부에서 일한 김성한 전 차관이 임명되었고 인수위에 합류한 김태효 전 기획관은 이명박 정부의 대외 정책을 주도해 외교안보 실세로 불렸다고 기자는 보도하였다.",
