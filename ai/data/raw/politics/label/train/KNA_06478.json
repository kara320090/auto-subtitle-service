        "term": [
            {
                "speaker_id": "1",
                "transcription": "선거 전에 꺼내서 유리할 것 없는 의제를 피하려는 의도 아니냐는 평가를 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.984
            },
            {
                "speaker_id": "2",
                "transcription": "방향성은 부담을 지금보다 더 높이거나 아니면 받는 수준을 낮추는 수밖에 없는데 그런 어떤 논의 자체가 득표 대선에서 표를 얻는 데 전혀 도움이 된다고 생각 안 하니까 어느 순간부터 연금 개혁에 대한 이슈들은 수면 아래로 이제 들어가고요.",
                "sound_type": [
                    2
                ],
                "start": 5.994,
                "end": 24.894
            },
            {
                "speaker_id": "1",
                "transcription": "반면 심상정 후보는 보험료율 인상을 공약했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.904,
                "end": 30.102
            },
            {
                "speaker_id": "3",
                "transcription": "더 이상 보험료율 인상을 미룰 수 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.112,
                "end": 32.975
            },
            {
                "speaker_id": "3",
                "transcription": "미래 세대의 부담을 줄여주기 위해서는 국민연금 재정에 대한 우리 세대의 책임을 높여야 합니다.",
                "sound_type": [
                    2,
