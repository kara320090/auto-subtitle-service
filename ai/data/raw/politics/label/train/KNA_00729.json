        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당의 내홍은 격화되는 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.404
            },
            {
                "speaker_id": "1",
                "transcription": "손서영 기자의 보도입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.414,
                "end": 3.946
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 힘에 이어 민주당도 오늘 광역 단체장 후보 공모를 마쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.956,
                "end": 10.635
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 힘은 내일부터 민주당은 다음주 면접을 시작합니다.",
                "sound_type": [
                    2
                ],
                "start": 10.645,
                "end": 15.171
            },
            {
                "speaker_id": "2",
                "transcription": "최대 격전지는 경기돕니다.",
                "sound_type": [
                    2
                ],
                "start": 15.181,
                "end": 17.168
            },
            {
                "speaker_id": "2",
                "transcription": "민주당에선 안민석 조성식 의원 염태영 전 시장이 후보 등록을 마쳤고 합당이 완료되는 대로 새로운 물결 김동연 대표도 뛰어듭니다.",
                "sound_type": [
