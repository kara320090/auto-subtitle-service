            },
            {
                "speaker_id": "1",
                "transcription": "누가 의뢰했고 누가 입회했는지가 모두 기록돼 있을 거라며 서류가 나오면 모든 해명이 끝날 거라고 말했습니다.",
                "sound_type": [
