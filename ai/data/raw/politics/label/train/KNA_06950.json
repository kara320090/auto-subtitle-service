                ],
                "start": 5.184,
                "end": 15.579
            },
            {
                "speaker_id": "2",
                "transcription": "정의당 배진규 원내대표는 당선인의 오더 정치로 인한 극한 대결의 책임은 온전히 당선인과 국민의 몫이라고 경고했습니다.",
                "sound_type": [
