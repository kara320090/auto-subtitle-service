        "term": [
            {
                "speaker_id": "1",
                "transcription": "안철수 대표 탈당 후에 혹시 만나는 거에 대해서는 생각해보신 적 있나요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.253
            },
            {
                "speaker_id": "2",
                "transcription": "네 뭐 생각해본 적 없습니다마는 정치인들이 뭐 만날 수도 있고 그런 거.",
                "sound_type": [
                    2
                ],
                "start": 4.263,
                "end": 10.384
            },
            {
                "speaker_id": "3",
                "transcription": "중도 보수 통합을 추진하는 혁신통합추진위와 자유한국당은 안 전 의원을 향해 보수 통합의 문이 열려 있다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.394,
                "end": 18.771
            },
            {
                "speaker_id": "4",
                "transcription": "헌법 질서와 시장 경제를 존중하는 가치가 같다면 그러면 다 같이 뜻을 모으는 것이 필요한 때다.",
                "sound_type": [
                    2
                ],
                "start": 18.781,
                "end": 27.423
            },
            {
                "speaker_id": "3",
                "transcription": "위기 때마다 탈당과 신당 창당으로 정치적 승부수를 던졌던 안 전 의원.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.433,
                "end": 33.055
            },
            {
                "speaker_id": "3",
                "transcription": "새정치민주연합과 국민의당 바른미래당에 이은 네 번째 창당일지 야권 통합일지 다음 수에 관심이 쏠립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.065,
                "end": 41.452
            },
