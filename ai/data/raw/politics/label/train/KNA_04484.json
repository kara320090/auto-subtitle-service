        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러나 2018년 계획 변경 과정에서 북측 구간 지중화 방안이 다시 빠집니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.233
            },
            {
                "speaker_id": "1",
                "transcription": "가장 큰 쟁점은 공사 비용 성남시는 업체 측 견해를 수용해 막대한 돈이 든다고 추정했지만 주민 민원으로 지난 2019년 뒤늦게 한전에 비용 산정을 요청한 결과 당초 예상 비용의 4분의 1 정도면 된다는 답변을 받습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.243,
                "end": 21.150
            },
            {
                "speaker_id": "2",
                "transcription": "1600억 정도로 일단은 지금 어 개략적인 공사비가 나와 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.158,
                "end": 25.940
            },
            {
                "speaker_id": "3",
                "transcription": "확인하셨죠 얼마 드는지?",
                "sound_type": [
                    2
                ],
                "start": 25.950,
                "end": 27.446
            },
            {
                "speaker_id": "2",
                "transcription": "한전에서는 400억이라 그랬습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.450,
                "end": 30.303
            },
            {
                "speaker_id": "3",
                "transcription": "근데 금액이 왜 이렇게 차이 나요?",
                "sound_type": [
                    2
                ],
