        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번에는 후보별 현금지원 정책에 대한 선호를 알아봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.083
            },
            {
                "speaker_id": "1",
                "transcription": "후보 이름을 밝히지 않고 정책을 제시한 뒤 도움이 될 것으로 보는지를 물었습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.093,
                "end": 10.726
            },
            {
                "speaker_id": "1",
                "transcription": "도움이 될 것이라는 응답은 윤석열 안철수 이재명 심상정 후보 공약으로 응답률이 높았습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.736,
                "end": 19.119
            },
            {
                "speaker_id": "1",
                "transcription": "실현 가능성이 없다고 본다는 응답도 이재명 안철수 후보 공약의 경우 50퍼센트 가까이 그리고 심 후보 공약의 경우 70퍼센트 가까이 됐습니다.",
                "sound_type": [
