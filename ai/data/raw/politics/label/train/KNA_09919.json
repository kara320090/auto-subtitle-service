        "term": [
            {
                "speaker_id": "1",
                "transcription": "최우선적으로 어 매입 대상에서 지정을 하도록",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.525
            },
            {
                "speaker_id": "2",
                "transcription": "기존에 세워둔 임대 주택 공급 계획을 처음부터 다시 설계해야 할 엘에이치도 당혹해하는 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.535,
                "end": 12.287
            },
            {
                "speaker_id": "2",
                "transcription": "이미 수익성이 떨어지는 매입 임대 사업에 5조 원을 넘게 써야 하는데 추가 물량까지 떠안을 경우 수익 구조가 더 악화될 수 있다는 우려도 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 12.297,
                "end": 23.097
            },
            {
                "speaker_id": "2",
                "transcription": "이와 관련해 엘에이치 관계자는 국토부 중심으로 의사 결정이 이뤄져 되늦게 파악했다며 이제부터 실무 협의를 진행하겠다고 말했습니다.",
                "sound_type": [
                    2
