        "term": [
            {
                "speaker_id": "1",
                "transcription": "가결을 위해선 출석 의원 과반의 찬성 149표가 필요했지만 딱 열 표가 모자랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.638
            },
            {
                "speaker_id": "1",
                "transcription": "여유롭게 부결될 걸로 예상했던 민주당은 당연한 결과라면서도 당혹감을 감추지 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.648,
                "end": 13.590
            },
            {
                "speaker_id": "2",
                "transcription": "당 내 다양한 의견이 있다는 것도 확인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.600,
                "end": 16.110
            },
            {
                "speaker_id": "2",
                "transcription": "향후에 당을 좀 더 많은 의견 수렴 통해서 크게 하나로 묶는 그런 또 계기로서",
                "sound_type": [
                    2
                ],
                "start": 16.120,
                "end": 21.903
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 찬성표가 반대표보다 더 많이 나왔다면서 사실상 가결에 준하는 결과라고 자평했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.913,
                "end": 29.347
            },
            {
                "speaker_id": "3",
                "transcription": "민심이 고스란히 반영된 결과라고 생각합니다.",
                "sound_type": [
                    2
