        "term": [
            {
                "speaker_id": "1",
                "transcription": "건가요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.598
            },
            {
                "speaker_id": "2",
                "transcription": "준비를 조금 더 잘 갖춰서 하는 게 좋을 거 같아서",
                "sound_type": [
                    2
                ],
                "start": 0.608,
                "end": 4.544
            },
            {
                "speaker_id": "3",
                "transcription": "하지만 보도 자료 내용에서 보듯 사전 준비에 들어갔을 시간과 노력을 감안하면 쉽게 이해가 되지 않는 설명입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.554,
                "end": 12.411
            },
            {
                "speaker_id": "3",
                "transcription": "편의 시설 역시 검토했어야 하기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.421,
                "end": 15.635
            },
            {
                "speaker_id": "3",
                "transcription": "그래서 해당 지역 오염과 관련해 반발이 일자 개방을 철회한 것 아니냐는 지적이 제기됩니다.",
                "sound_type": [
                    2
                ],
                "start": 15.645,
                "end": 21.755
            }
        ]
    },
    "summary": "개방 철회에 대해 준비 부족이라고 설명했지만 해당 지역 오염과 관련한 반발 때문이 아니냐는 지적이 제기되고 있다.",
