        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "가결되었음을 선포합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.205
            },
            {
                "speaker_id": "2",
                "transcription": "이상민 행정안전부 장관에 대한 해임 건의 안이 본회의에서 가결됐습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 4.215,
                "end": 10.017
            },
            {
                "speaker_id": "2",
                "transcription": "여당이 집단 퇴장한 가운데 민주당과 정의당 등 의원 182명이 찬성표를 던졌습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.027,
                "end": 16.775
            },
            {
                "speaker_id": "2",
                "transcription": "더불어 민주당은 158명의 생명을 앗아간 이태원 참사의 정치적 도의적 책임을 묻지 않을 수 없다고 강조했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.785,
                "end": 25.199
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 윤석열 대통령에게도 해임 건의안 수용을 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.209,
                "end": 29.951
            },
            {
                "speaker_id": "3",
                "transcription": "엄중함을 어 감안했을 때 대통령께서 또 다시 어 국회의 헌법이 보장한 이 그 권한을 책무를 어 거부하지는 못할 것이다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.961,
                "end": 40.739
            },
            {
                "speaker_id": "3",
                "transcription": "거부해선 안 될 것이다라고 어 말씀을 드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.749,
                "end": 44.012
            },
            {
                "speaker_id": "2",
                "transcription": "국민의힘은 정부 여당에 발목을 잡는 대선 불복이다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 44.022,
                "end": 48.387
            },
            {
                "speaker_id": "2",
                "transcription": "이재명 대표 수사에 쏠린 관심을 돌리기 위한 책략이라며 강하게 비판했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 48.397,
                "end": 54.005
            },
            {
                "speaker_id": "4",
                "transcription": "살면서 살면서 이런 거대 야당의 횡포는 처음 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 54.015,
                "end": 59.170
            },
            {
                "speaker_id": "4",
                "transcription": "저는 이런 민주당과 함께 의사당에 몸 담고 있는 것에 모멸감을 느낍니다.",
                "sound_type": [
                    2
                ],
                "start": 59.180,
                "end": 63.530
            }
        ]
    },
    "summary": "더불어 민주당은 158명의 생명을 앗아간 이태원 참사의 정치적 도의적 책임을 묻지 않을 수 없다고 강조했다.",
