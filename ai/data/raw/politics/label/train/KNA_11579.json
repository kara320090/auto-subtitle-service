        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거를 내가 당신한테 줄 테니 당신이 장 실장한테 빌려 주는 것이고 이렇게 말해라.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.460
            },
            {
                "speaker_id": "2",
                "transcription": "수사망을 피하던 장 씨는 지난해 10월 결국 구속됐습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.470,
                "end": 12.521
            },
            {
                "speaker_id": "2",
                "transcription": "유 전 구청장은 의혹들을 전면 부인했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.531,
                "end": 16.028
            },
            {
                "speaker_id": "2",
                "transcription": "금융기관에 영장 확보를 부탁한 적이 없고 비서실장에게 수사 회피를 주문한 적도 없다는 입장을 KBS에 전해왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.038,
                "end": 24.462
            },
            {
                "speaker_id": "2",
                "transcription": "검찰은 그러나 수사방해가 악의적이었다고 보고 구속 영장을 청구했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.472,
                "end": 30.779
            },
            {
                "speaker_id": "2",
                "transcription": "발부 여부는 이르면 모레 결정됩니다.",
                "sound_type": [
