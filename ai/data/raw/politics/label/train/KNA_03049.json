        "term": [
            {
                "speaker_id": "1",
                "transcription": "국가 원수에 대해서 그렇게 하는 게 아니에요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.163
            },
            {
                "speaker_id": "1",
                "transcription": "아니 품위를 지켜셔야죠.",
                "sound_type": [
                    2
                ],
                "start": 2.173,
                "end": 5.404
            },
            {
                "speaker_id": "2",
                "transcription": "추미애 법무부 장관이 출석한 법사위에선 동부 구치소 집단 감염이 쟁점이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.414,
                "end": 12.181
            },
            {
                "speaker_id": "2",
                "transcription": "제 때 전수 조사를 하지 않는 등 초기 대응이 허술했다는 지적에 추 장관은 일단 사과했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.191,
                "end": 18.388
            },
            {
                "speaker_id": "3",
                "transcription": "정무직 공직자는 뭐 사실은 무한 책임을 지는 것이죠.",
                "sound_type": [
                    2
                ],
                "start": 18.398,
                "end": 23.455
            },
            {
                "speaker_id": "3",
                "transcription": "뭐 그런 의미에서라면 어 송구하다는 말씀을 거듭 드리고요.",
                "sound_type": [
                    2
