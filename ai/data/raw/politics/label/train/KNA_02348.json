                ],
                "start": 0.000,
                "end": 9.099
            },
            {
                "speaker_id": "1",
                "transcription": "지난 2일 성남 시청을 압수수색하고 보름 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.109,
                "end": 13.053
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 어떤 자료들 확보하셨나요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.063,
                "end": 14.875
            },
            {
                "speaker_id": "3",
                "transcription": "성남시청 압수수색에서 뭔가 나왔나요?",
