        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘 윤석열 후보는 아내 김건희 씨 사과는 김 씨가 결정했다며 판단은 국민들의 몫이라며 선대위 정비에 들어갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.692
            },
            {
                "speaker_id": "1",
                "transcription": "20일 만에 선대위 회의에 직접 참석해 누구도 제 3자적 논평가나 평론가가 돼서는 곤란하다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.702,
                "end": 17.211
            },
            {
                "speaker_id": "1",
                "transcription": "오후에 대장동 현장을 찾은 윤 후보는 이 후보가 의혹의 몸통이자 설계자라며 국면 전환에 나섰습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.221,
                "end": 25.279
            },
            {
                "speaker_id": "2",
                "transcription": "떳떳하면 왜 못합니까?",
                "sound_type": [
                    2
                ],
                "start": 25.289,
                "end": 26.858
            },
            {
                "speaker_id": "2",
                "transcription": "저는 뭐 고발 사주든 부산 저축은행이든 다 가져가서 하라고 그랬습니다.",
                "sound_type": [
                    2
                ],
