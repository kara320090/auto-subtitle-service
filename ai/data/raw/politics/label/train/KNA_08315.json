        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 해당 규정을 제가 본 적은 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.472
            },
            {
                "speaker_id": "2",
                "transcription": "없었다?",
                "sound_type": [
                    2
                ],
                "start": 3.482,
                "end": 3.869
            },
            {
                "speaker_id": "1",
                "transcription": "처음 예 어제 처음 그 예 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.879,
                "end": 6.954
            },
            {
                "speaker_id": "3",
                "transcription": "야당은 학교에 내야 할 비용도 내지 않았다고 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.964,
                "end": 11.327
            },
            {
                "speaker_id": "4",
                "transcription": "최대 30프로 그러면 상당한 액수입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.337,
                "end": 15.239
            },
            {
                "speaker_id": "4",
                "transcription": "그러니까 단순히 문제가 아니라 이게 업무상 횡령이나 범죄가 돼버리는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 15.249,
                "end": 20.949
            },
            {
                "speaker_id": "3",
                "transcription": "후보자의 위장 전입 문제와 관련해서는 여당 의원까지 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.959,
                "end": 25.408
            },
            {
                "speaker_id": "5",
                "transcription": "집주인이 은행 담보 대출받겠다며 주소를 옮겨달라고 해서 일시적으로 주소 옮겼다.",
                "sound_type": [
                    2
                ],
                "start": 25.418,
                "end": 31.839
            },
            {
                "speaker_id": "5",
                "transcription": "은행을 속이는 행위에 후보자님께서도 같이 적극적으로 가담한 것이다.",
                "sound_type": [
                    2
                ],
                "start": 31.849,
                "end": 36.958
            },
            {
                "speaker_id": "1",
                "transcription": "그때 부적절한 처신이었다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 36.968,
                "end": 39.572
            }
        ]
    },
    "summary": "학교에 내야 할 비용을 내지 않은 것에 야당이 비판하고 후보자 위장 전입 문제와 관련해서 여당이 나섰다.",
