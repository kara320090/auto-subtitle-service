        "term": [
            {
                "speaker_id": "1",
                "transcription": "긴급 재난 지원금 지급 결정 일주일 만에 민주당은 전면 수정을 예고했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.078
            },
            {
                "speaker_id": "1",
                "transcription": "소득 하위 70퍼센트 대상을 국민 전부로 늘리자고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.088,
                "end": 10.914
            },
            {
                "speaker_id": "2",
                "transcription": "기업과 관계없이 소득과 관계없이 계층과 관계없이 모든 국민을 국가가 보호하고 있다는 것을 한 번쯤은 제대로 보여주는 것이",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.924,
                "end": 23.848
            },
            {
                "speaker_id": "1",
                "transcription": "당초 재원을 4조 원가량 늘리면 가능하다는 건데 어제 통합당 황교안 대표의 전 국민 지급 제안이 나오자 기다렸다는 듯 발표했습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.858,
                "end": 33.335
            },
            {
                "speaker_id": "1",
                "transcription": "통합당은 1인당 50만 원씩 주는 건 포퓰리즘이 아닌 긴급 조치라고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.345,
                "end": 39.434
            },
            {
                "speaker_id": "1",
                "transcription": "건강 보험료 기준은 맞벌이 부부 등에 불리하다며 예산 조정으로 전 국민에 줄 돈을 마련하자는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 39.444,
                "end": 47.039
            },
            {
                "speaker_id": "1",
                "transcription": "대통령 긴급 명령으로 일주일 만의 지급도 가능하다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.049,
                "end": 51.917
            },
            {
                "speaker_id": "3",
                "transcription": "100만 원씩을 준다고 얘기를 해 놓고",
                "sound_type": [
                    2
                ],
                "start": 51.927,
                "end": 55.588
            }
        ]
    },
