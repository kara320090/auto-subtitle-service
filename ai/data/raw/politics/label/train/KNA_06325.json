        "term": [
            {
                "speaker_id": "1",
                "transcription": "박 의장은 한복은 우리의 대표적인 고유문화임을 의심할 사람은 아무도 없다며 이런 논란을 불식시키기 위한 한 중 간 소통을 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.857
            },
            {
                "speaker_id": "2",
                "transcription": "한족을 제해 놓으면 55개 민족이 소수민족이고요.",
                "sound_type": [
                    2
                ],
                "start": 8.867,
                "end": 14.095
            },
            {
                "speaker_id": "2",
                "transcription": "그러한 관점에서 상호 문화에 대한 이해와 존중이 필요하다.",
                "sound_type": [
                    2
                ],
                "start": 14.105,
                "end": 20.308
            },
            {
                "speaker_id": "2",
                "transcription": "하는 말씀을 드리고요.",
                "sound_type": [
                    2
                ],
                "start": 20.318,
                "end": 21.599
            },
            {
                "speaker_id": "1",
                "transcription": "외교부도 한국 고유문화에 대한 존중 필요성을 중국 측에 지속적으로 전달하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.609,
                "end": 28.361
            }
        ]
    },
