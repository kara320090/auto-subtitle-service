        "term": [
            {
                "speaker_id": "1",
                "transcription": "정부와 지자체는 이렇게 교통 여건이 열악한 산업 단지 청년 노동자들에게 매달 5만 원씩을 지원합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.528
            },
            {
                "speaker_id": "1",
                "transcription": "조 씨도 2년간 수령해 왔는데 지난달 중단 통보를 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.538,
                "end": 12.570
            },
            {
                "speaker_id": "1",
                "transcription": "관할 지자체 예산이 조기 소진됐기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.580,
                "end": 16.204
            },
            {
                "speaker_id": "2",
                "transcription": "고용 현황이나 상태에 따라서 지원받는 사람들이 더 많아졌다거나 하는 경우는 있을 수도 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 16.214,
                "end": 23.985
            },
            {
                "speaker_id": "3",
                "transcription": "부담을 덜 해주는 금액인데 이제 그게 없어진 거니까 이거마저 끊긴다고 생각하니까 조금 많이 어려워질 것 같다고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.995,
                "end": 33.138
            },
            {
                "speaker_id": "1",
                "transcription": "전국 스물일곱 개 시 군에서 이런 문제가 발생했습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.148,
                "end": 36.995
            },
            {
                "speaker_id": "1",
                "transcription": "올해 15만여 명이 이 혜택을 받아왔는데 지난 8월부터 약 3만 9000명이 지원을 받지 못하게 됐습니다.",
                "sound_type": [
                    2,
