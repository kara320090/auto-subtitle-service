        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인은 집무실 이전 계획을 발표하며 이렇게 말했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.050
            },
            {
                "speaker_id": "2",
                "transcription": "공간이 그 업무와 일을 좌우한다는 말이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.060,
                "end": 9.687
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 뜻을 제대로 받들고 국민을 위해서 일하는 것이 대통령의 권위보다 더욱 중요합니다.",
                "sound_type": [
                    2
                ],
                "start": 9.697,
                "end": 19.031
            },
            {
                "speaker_id": "1",
                "transcription": "구중궁궐 같은 청와대의 공간적 구조가 이른바 제왕적 대통령의 폐단을 낳았다고 본 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.041,
                "end": 26.313
            },
            {
                "speaker_id": "1",
                "transcription": "광화문 집무실도 계획했지만 경호 등 문제로 접었고 용산에 새 집무실을 꾸렸습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.323,
                "end": 32.402
            },
            {
                "speaker_id": "1",
                "transcription": "주변 미군기지 부지도 공원으로 만들어 시민과의 접촉을 늘린다는 복안입니다.",
                "sound_type": [
                    2,
                    4
                ],
