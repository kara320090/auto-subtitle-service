        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰에 부실 대응에 대한 행안부 장관의 책임을 묻자 @이름1 장관은 자신이 경찰을 지휘할 근거가 없다고 줄곧 답변했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.068
            },
            {
                "speaker_id": "2",
                "transcription": "행안부는 경찰청을 지휘 감독합니까 안 합니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.078,
                "end": 13.021
            },
            {
                "speaker_id": "3",
                "transcription": "지휘 감독 권한이 지금은 없습니다 현재.",
                "sound_type": [
                    2
                ],
                "start": 13.031,
                "end": 16.676
            },
            {
                "speaker_id": "2",
                "transcription": "지휘 감독 권한이 없어요?",
                "sound_type": [
                    2
                ],
                "start": 16.686,
                "end": 18.398
            },
            {
                "speaker_id": "3",
                "transcription": "네 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.408,
                "end": 19.456
            },
            {
                "speaker_id": "1",
                "transcription": "경찰로부터 치안 관련 보고를 받은 적도 없다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.466,
                "end": 23.528
            },
            {
                "speaker_id": "4",
                "transcription": "지금까지 치안에 대해서 상세하게 보고받거나 지시한 적이 없었죠 지금까지는.",
                "sound_type": [
                    2
                ],
                "start": 23.538,
                "end": 31.786
            },
            {
                "speaker_id": "3",
                "transcription": "네 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.796,
                "end": 33.158
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 지난 8월 출범한 행안부 내 경찰국은 인사와 경찰 지원을 위한 조직이고 치안과는 무관하다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.168,
                "end": 41.608
            }
        ]
    },
    "summary": "행안부 장관은 경찰 치안 보고와 무관하다고 말했다.",
