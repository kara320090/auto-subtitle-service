        "term": [
            {
                "speaker_id": "1",
                "transcription": "1956년 북한 황해도 19살 @이름1 씨 집에 총 든 군인 3명이 들이닥쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.560
            },
            {
                "speaker_id": "1",
                "transcription": "그들은 북한 군인이 아닌 대한민국 군인이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.570,
                "end": 10.316
            },
            {
                "speaker_id": "1",
                "transcription": "김 씨는 영문도 모르고 납치돼 그 길로 남녘 땅에 끌려왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.326,
                "end": 15.089
            },
            {
                "speaker_id": "2",
                "transcription": "동생들하고 조그마한 방에서 자고 있었는데 군이 밤에 군인들이 총 들고 들어와서 나만 그냥 끌고 나온 것이지 뭐.",
                "sound_type": [
                    2
                ],
                "start": 15.099,
