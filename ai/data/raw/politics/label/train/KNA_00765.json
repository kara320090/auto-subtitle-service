        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 이번엔 내각 소식으로 가보죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.786
            },
            {
                "speaker_id": "1",
                "transcription": "내일 2차 내각 인선 발표가 있을 것으로 보이는데 안철수 인수 위원장이 오늘 내각과 관련된 입장을 밝혔다고요.",
                "sound_type": [
                    2
                ],
                "start": 1.796,
                "end": 10.610
            },
            {
                "speaker_id": "2",
                "transcription": "네 안철수 인수 위원장은 오늘 기자들과 만나 내각 인선 과정에서 자신이 전문성 있는 분야에 대해 조언하고 싶었지만 그런 과정이 없었다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.620,
                "end": 22.403
            },
            {
                "speaker_id": "2",
                "transcription": "안 위원장은 새 정부 청사진을 함께 제대로 그려가기 위해 인수 위원장을 맡았다는 말도 덧붙였는데요.",
                "sound_type": [
                    2
                ],
                "start": 22.413,
                "end": 29.329
            },
            {
                "speaker_id": "2",
                "transcription": "지난 10일 발표된 1차 내각 인선에 대한 불만을 간접적으로 나타낸 것 아니냐는 해석이 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 29.339,
                "end": 35.882
            },
            {
                "speaker_id": "2",
                "transcription": "장재원 당선인 비서 실장은 공동 정부를 두고 파열음이 나는 것 아니냐는 물음에 파열음은 없다며 잘 진행될 것이라고 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.892,
                "end": 44.656
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 당선인은 이르면 내일 후속 내각을 발표할 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 44.666,
                "end": 48.964
            },
            {
                "speaker_id": "2",
                "transcription": "교육부 행안부 통일부 외교부 등이 대상인데 안철수 위원장 측 인사들이 얼마나 이름을 올릴지가 주목됩니다.",
                "sound_type": [
                    2
                ],
                "start": 48.974,
                "end": 56.761
            },
            {
                "speaker_id": "2",
                "transcription": "지금까지 삼청동 인수위에서 KBS 뉴스 방준원입니다.",
                "sound_type": [
                    2
                ],
                "start": 56.771,
                "end": 61.261
            }
        ]
    },
    "summary": "안철수 인수 위원장은 기자들을 만나 내각과 관련된 입장을 밝혔는데 새 정부 청사진을 그리기 위해 인수 위원장을 맡았다는 말도 덧붙였다.",
