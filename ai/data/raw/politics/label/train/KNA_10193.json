        "term": [
            {
                "speaker_id": "1",
                "transcription": "유세 마지막 날 국민의힘 이준석 대표는 제주로 날아갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.268
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 이재명 후보의 김포 공항 이전 공약을 제주 완박으로 규정했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.278,
                "end": 9.558
            },
            {
                "speaker_id": "2",
                "transcription": "공항이 멀어지는데도 제주도 관광에 대한 수요가 그대로 유지된다는 것은 수요와 공급의 기본 논리도 모르는 그런 무식한 발상입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.568,
                "end": 18.672
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 나만 살겠다는 팀킬.",
                "sound_type": [
                    2
                ],
                "start": 18.682,
                "end": 21.168
            },
            {
                "speaker_id": "1",
                "transcription": "국책 사업에 대한 원칙도 기준도 없다며 공세를 이어갔습니다.",
                "sound_type": [
                    2
                ],
