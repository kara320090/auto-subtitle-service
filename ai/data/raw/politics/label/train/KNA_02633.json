        "term": [
            {
                "speaker_id": "1",
                "transcription": "경찰을 향한 강한 질책도 뒤따랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.916
            },
            {
                "speaker_id": "1",
                "transcription": "현장에 경찰이 있었는데 왜 4시간 동안 물끄러미 쳐다만 봤냐 대통령이 아니라 한 사람의 시민으로서 도저히 이해가 안 된다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.926,
                "end": 12.126
            },
            {
                "speaker_id": "1",
                "transcription": "윤희근 경찰 청장과 경찰 사무를 관장하는 이상민 행안부 장관을 앞에 두고 한 말입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.136,
                "end": 18.318
            },
            {
                "speaker_id": "2",
                "transcription": "이태원 이 참사가 제도가 미비해서 생긴 겁니까?",
                "sound_type": [
                    2
                ],
                "start": 18.328,
                "end": 24.278
            },
            {
                "speaker_id": "2",
                "transcription": "저는 이건 납득이 안 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 24.288,
                "end": 27.193
            }
        ]
    },
