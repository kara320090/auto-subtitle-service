        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 힘은 야당에 국익 자해 참사가 본질이라며 퇴장 요구는 월권이라고 맞섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.299
            },
            {
                "speaker_id": "2",
                "transcription": "사실을 왜곡하고 자꾸 국민들을 그 그 선동하고 정치 공세로 나가지 마세요.",
                "sound_type": [
                    2
                ],
                "start": 6.309,
                "end": 13.184
            },
            {
                "speaker_id": "2",
                "transcription": "국정감사를 이렇게 난잡으로 만들 거예요?",
                "sound_type": [
                    2
                ],
                "start": 13.194,
                "end": 16.358
            },
            {
                "speaker_id": "1",
                "transcription": "30여 분 공방 끝에 정회했는데 속개된 오후 회의 땐 윤석열 대통령 발언 영상에 상영 여부가 쟁점이 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.368,
                "end": 25.119
            },
            {
                "speaker_id": "3",
                "transcription": "사전에 영상을 봐서 아무 이상이 없으면 저희도 동의하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.129,
                "end": 28.864
            },
            {
                "speaker_id": "3",
                "transcription": "그러나 매우 부적절한 영상이면 저는 간사로서 동의하기가 어렵습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.874,
                "end": 34.000
            }
        ]
    },
