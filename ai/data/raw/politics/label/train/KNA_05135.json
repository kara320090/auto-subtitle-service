        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1 법무부 감찰 담당관이 윤석열 검찰 총장에 대한 압박용으로 그 통신 사실 확인 자료를 불법으로 어 입수를 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.418
            },
            {
                "speaker_id": "2",
                "transcription": "검찰은 지난해 6월 이 사건을 불기소 처분했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.428,
                "end": 17.002
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 1년이 지나 서울 고검이 재기 수사 명령을 내렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.012,
                "end": 20.865
            },
            {
                "speaker_id": "2",
                "transcription": "이에 따라 검찰은 오늘 법무부 감찰 담당관실과 서울 중앙 지검 기록 관리과 등을 압수 수색하면서 본격적인 강제 수사에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.875,
                "end": 29.923
            },
            {
                "speaker_id": "2",
                "transcription": "검찰은 2020년 당시 윤석열 총장 징계를 부당 청구했다는 혐의로 시민 단체가 추미애 전 법무 장관을 고발한 사건도 같은 수사팀에 배당했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.933,
                "end": 40.254
            },
            {
                "speaker_id": "2",
                "transcription": "당시 내려진 정직 2개월 징계를 취소해달라는 윤 대통령의 소송은 2심이 진행 중입니다.",
                "sound_type": [
                    2
                ],
                "start": 40.264,
                "end": 46.143
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름1입니다.",
