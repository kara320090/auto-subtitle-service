        "term": [
            {
                "speaker_id": "1",
                "transcription": "아무 소리 못 했어 나는.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.473
            },
            {
                "speaker_id": "2",
                "transcription": "우리 군 첩보 부대가 수행한 일종의 납치 공작이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.483,
                "end": 6.136
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1 씨는 신문을 받고 풀려난 뒤 어쩔 수 없이 국내에 정착했지만 북녘의 가족과 생이별한 아픔을 평생 안고 살아야 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.146,
                "end": 15.109
            },
            {
                "speaker_id": "2",
                "transcription": "그렇게 반세기가 지나고 2012년의 어느 날 총리실 소속이라는 사람들이 찾아오더니 다짜고짜 56년 전 그 일을 캐물었습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.119,
                "end": 25.329
            },
            {
                "speaker_id": "1",
                "transcription": "그 부대의 어떤 사람들이 갔다 놨냐?",
                "sound_type": [
                    2
                ],
                "start": 25.339,
                "end": 27.894
            }
        ]
    },
    "summary": "@이름1 씨는 우리 군의 납치 공작으로 신문을 받고 풀려난 뒤 어쩔 수 없이 국내에 정착했지만 북녘의 가족과 생이별한 아픔을 평생 안고 살아 왔는데 56년이 지난 어느 날 총리실 소속이라는 사람들이 찾아와 그때 일을 캐물었다.",
