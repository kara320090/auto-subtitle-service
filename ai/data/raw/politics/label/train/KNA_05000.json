        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 감찰 이런 조직이 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.883
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 이것은 그냥 사실상 제 직속으로 그렇게 운영할 생각입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.893,
                "end": 8.384
            },
            {
                "speaker_id": "2",
                "transcription": "경찰청장 등 소속 청장에 대한 지위 규칙도 제정합니다.",
                "sound_type": [
                    2
                ],
                "start": 8.394,
                "end": 13.443
            },
            {
                "speaker_id": "2",
                "transcription": "소속 청에 중요 정책 사항에 대해 행안부 장관의 승인을 받도록 했고 예산 중요 사항 등도 보고하도록 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.453,
                "end": 20.986
            },
            {
                "speaker_id": "2",
                "transcription": "다만 수사에 대한 내용은 들어가지 않았습니다.",
                "sound_type": [
                    2
