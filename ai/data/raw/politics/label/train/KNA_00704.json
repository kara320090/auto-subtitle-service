        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 청와대가 내일 임시 국무 회의를 열어 새 정부가 추진하는 대통령 집무실 이전 공약과 관련한 예비비를 처리할 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.142
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 빨리 처리하라는 문재인 대통령의 요청에 따른 건데요.",
                "sound_type": [
                    2
                ],
                "start": 8.152,
                "end": 11.931
            },
            {
                "speaker_id": "1",
                "transcription": "다만 예비비의 규모는 당초 당선인 측에서 요구한 496억 원 중 일부 내역을 제외한 360억 원 정도가 될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.941,
                "end": 20.721
            },
            {
                "speaker_id": "1",
                "transcription": "계현우 기자의 보도입니다.",
                "sound_type": [
                    2
                ],
                "start": 20.731,
                "end": 23.244
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 내일 임시 국무 회의를 열고 윤석열 당선인의 집무실 이전을 위한 예비비를 심의 의결하기로 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.254,
                "end": 32.668
            },
            {
                "speaker_id": "2",
                "transcription": "청와대는 오늘 오전 문재인 대통령이 이 같이 지시했다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
