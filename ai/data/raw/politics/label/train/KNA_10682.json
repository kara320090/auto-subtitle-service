        "term": [
            {
                "speaker_id": "1",
                "transcription": "그날 저녁에 음주하셨냐고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.754
            },
            {
                "speaker_id": "2",
                "transcription": "주말 저녁이면 저도 음주 할 수 있습니다 네.",
                "sound_type": [
                    2
                ],
                "start": 1.764,
                "end": 4.431
            },
            {
                "speaker_id": "2",
                "transcription": "그것까지 밝혀드려야 되나요?",
                "sound_type": [
                    2
                ],
                "start": 4.441,
                "end": 7.470
            },
            {
                "speaker_id": "2",
                "transcription": "음주했다고 말씀드렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.480,
                "end": 9.435
            },
            {
                "speaker_id": "3",
                "transcription": "경찰청이 있는 서울을 벗어난 기록을 경찰 내부 시스템에 입력하지 않았다는 의혹에 대해서도 마지못해 시인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.445,
                "end": 17.616
            },
            {
                "speaker_id": "1",
                "transcription": "윤희근 증인 입력해 봤습니까 안 했습니까?",
                "sound_type": [
                    2
                ],
                "start": 17.626,
                "end": 20.912
            },
            {
                "speaker_id": "2",
                "transcription": "의원님 아시는 바와 같이 저는 전국이 관할 범위입니다.",
                "sound_type": [
                    2
                ],
                "start": 20.922,
                "end": 24.485
            },
            {
                "speaker_id": "1",
                "transcription": "아 그러니까 입력을 했어요 안 했어요?",
                "sound_type": [
                    2
                ],
                "start": 24.495,
                "end": 26.319
            },
            {
                "speaker_id": "2",
                "transcription": "안 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.329,
                "end": 27.504
            },
            {
                "speaker_id": "3",
                "transcription": "답변을 지켜보던 한 유족은 윤 청장에게 항의하다 청경에게 제지를 받기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.514,
                "end": 33.166
            }
        ]
    },
    "summary": "경찰청이 있는 서울을 벗어난 기록을 경찰 내부 시스템에 입력하지 않았다는 의혹에 대해서도 마지못해 시인했고 윤 청장의 답변을 지켜보던 한 유족은 윤 청장에게 항의하다 청경에게 제지를 받기도 했다.",
