        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 정권이 바뀌더라도 대신 변제한 걸 일본에 청구하는 구상권 행사도 걱정하지 않아도 된다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.016
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 한일 모두의 이익을 위한 결단임을 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.026,
                "end": 11.411
            },
            {
                "speaker_id": "1",
                "transcription": "일본 여론에 직접 우리 측 요구인 이른바 성의 있는 호응을 당부한 셈인데 해당 성과로 이어질지는 미지수입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.421,
                "end": 19.811
            },
            {
                "speaker_id": "1",
                "transcription": "대통령실 관계자는 오래 경색된 한일 관계 때문에 정상 공동 선언은 없을 거라며 양국 정상의 기자 회견이 예정돼 있다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.821,
                "end": 29.651
            },
            {
                "speaker_id": "1",
                "transcription": "이번 교류가 새로운 출발이라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.661,
                "end": 32.465
            }
        ]
    },
