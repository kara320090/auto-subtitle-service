        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 감사나 수사가 성력이 있어야 되나요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.039
            },
            {
                "speaker_id": "2",
                "transcription": "성력이 없어야죠.",
                "sound_type": [
                    2
                ],
                "start": 3.049,
                "end": 4.277
            },
            {
                "speaker_id": "2",
                "transcription": "근데 왜 그렇게 편파적으로 합니까?",
                "sound_type": [
                    2
                ],
                "start": 4.287,
                "end": 5.958
            },
            {
                "speaker_id": "1",
                "transcription": "감사와 수사의 결과를 지켜봅시다.",
                "sound_type": [
                    2
                ],
                "start": 5.968,
                "end": 8.391
            },
            {
                "speaker_id": "2",
                "transcription": "아니 과정도 대단히 중요한 것이죠.",
                "sound_type": [
                    2
                ],
                "start": 8.401,
                "end": 11.100
            },
            {
                "speaker_id": "1",
                "transcription": "과정이 문제가 문제가 뭔데",
                "sound_type": [
                    2
                ],
                "start": 11.110,
                "end": 13.328
            },
            {
                "speaker_id": "3",
                "transcription": "감사원은 이틀째 해명 자료를 내고 전직 공무원에게도 출석과 답변을 요구할 수 있고 조사 절차를 건너뛴 게 아니라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.338,
                "end": 22.597
            },
            {
                "speaker_id": "3",
                "transcription": "윤석열 대통령은 감사원이 독립적으로 운영된다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.607,
                "end": 27.223
            },
            {
                "speaker_id": "4",
                "transcription": "일반 원칙 아니겠습니까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.233,
                "end": 29.348
            },
            {
                "speaker_id": "4",
                "transcription": "설마 감사원은 헌법 기관이고 어 대통령에 실과 독립적으로 운영되는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.358,
                "end": 36.002
            }
        ]
    },
    "summary": "감사원은 이틀째 해명 자료를 냈고 전직 공무원에게도 출석과 답변을 요구할 수 있으며 조사 절차를 건너뛴 게 아니라고 말했다.",
