        "term": [
            {
                "speaker_id": "1",
                "transcription": "대책 없이 오르는 물가도 물가지만 정부가 어떤 대책도 내놓지 못하는 것에 분통을 터트리는 국민이 많았습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.147
            },
            {
                "speaker_id": "2",
                "transcription": "그러면서 취약계층을 위한 재난 예비비 편성 30조 원 수준의 추경 등을 대응책으로 제시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.157,
                "end": 18.370
            },
            {
                "speaker_id": "2",
                "transcription": "이어서 간담회를 연 국민의힘은 난방비를 정쟁화한다며 반박에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.380,
                "end": 24.820
            },
            {
                "speaker_id": "2",
                "transcription": "문재인 정부 때 가스값이 두세 배 올랐는데 요금은 13퍼센트만 올려서 현 정부가 부담을 떠안게 됐다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.830,
                "end": 33.237
            },
            {
                "speaker_id": "2",
                "transcription": "탈원전 정책에도 책임이 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.247,
                "end": 36.642
            },
            {
                "speaker_id": "3",
                "transcription": "에너지 정책에 있어서 탈원전을 한다면서 정말로",
                "sound_type": [
                    2
                ],
                "start": 36.652,
                "end": 42.075
            }
        ]
    },
