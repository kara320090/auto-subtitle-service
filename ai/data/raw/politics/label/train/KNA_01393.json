        "term": [
            {
                "speaker_id": "1",
                "transcription": "백운규 전 장관의 구속 여부가 이르면 오늘 밤 결정될 예정인데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.192
            },
            {
                "speaker_id": "1",
                "transcription": "그 결과에 따라 문재인 정부 청와대 윗선으로 수사가 확대될지의 여부도 가늠이 될 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.202,
                "end": 10.340
            },
            {
                "speaker_id": "1",
                "transcription": "아 지금 서울 동부지법에 취재 기자 나가 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 10.350,
                "end": 12.880
            },
            {
                "speaker_id": "1",
                "transcription": "연결합니다.",
                "sound_type": [
                    2
                ],
                "start": 12.890,
                "end": 13.629
            },
            {
                "speaker_id": "1",
                "transcription": "자 현여슬 기자 구속영장 심사 결과가 아직은 나오지 않은 거죠?",
                "sound_type": [
                    2
                ],
                "start": 13.639,
                "end": 18.125
            },
            {
                "speaker_id": "2",
                "transcription": "네 법원이 백운규 전 장관 심문 마친 지 6 시간이 다 돼 가는데 아직 결과는 나오지 않았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 18.135,
                "end": 27.460
            }
        ]
    },
    "summary": "앵커는 백운규 전 장관의 구속 여부가 오늘 밤 결정될 예정이며 결과에 따라 문재인 정부 청와대 윗선으로 수사가 확대될지의 여부도 가늠이 될 것으로 보인다며 구속영장 심사 결과가 아직 나오지 않았냐는 질문에 기자는 법원이 심문을 마친 지 6 시간이 다 돼 가지만 아직 결과는 나오지 않았다고 답하였다.",
