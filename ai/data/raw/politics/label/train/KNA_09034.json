        "term": [
            {
                "speaker_id": "1",
                "transcription": "사적인 것.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.920
            },
            {
                "speaker_id": "2",
                "transcription": "김대기 비서 실장의 목소리라는 야당의 의혹 제기를 김 실장은 정면 부인했습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.930,
                "end": 7.413
            },
            {
                "speaker_id": "3",
                "transcription": "어저께 보여드린 영상 사실 관계 확인하셨나요?",
                "sound_type": [
                    2
                ],
                "start": 7.423,
                "end": 10.812
            },
            {
                "speaker_id": "4",
                "transcription": "사적 사적.",
                "sound_type": [
                    2
                ],
                "start": 10.822,
                "end": 13.347
            },
            {
                "speaker_id": "4",
                "transcription": "제가 한 거 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 13.357,
                "end": 15.113
            },
            {
                "speaker_id": "2",
                "transcription": "김 실장은 잠깐의 일탈이었을 뿐 국회 모욕이 아니라고도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.123,
                "end": 18.893
            },
            {
                "speaker_id": "5",
                "transcription": "밖에서 사담을 했다고 해도 문제가 되는 겁니다 실장님.",
                "sound_type": [
                    2
                ],
                "start": 18.903,
                "end": 21.802
            },
            {
                "speaker_id": "5",
                "transcription": "아시지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 21.812,
                "end": 23.096
            },
            {
                "speaker_id": "4",
                "transcription": "저도 사과하고 다 사과하고 그 다음에 퇴장까지 하지 않았습니까.",
                "sound_type": [
                    2
                ],
                "start": 23.106,
                "end": 28.549
            },
            {
                "speaker_id": "4",
                "transcription": "그럼 더 이상 뭘 하란 말입니까.",
                "sound_type": [
                    2
                ],
                "start": 28.559,
                "end": 30.282
            },
            {
                "speaker_id": "1",
                "transcription": "대통령 순방 준비로 국회에 불출석했던 김 수석은 국회가 아닌 대통령실에서 거듭 고개를 숙였습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.292,
                "end": 36.770
            }
        ]
    },
    "summary": "사적인 것이라고 말하는 목소리가 김대기 비서 실장의 목소리라는 야당의 의혹 제기를 김 실장은 정면 부인했고 두 수석이 국회 모욕을 한 게 아니라고 밝혔다.",
