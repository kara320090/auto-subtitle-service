        "term": [
            {
                "speaker_id": "1",
                "transcription": "대선 직후 자신이 대표였던 자유의 새벽당을 탈당하고 4월부터 정모 실장으로 활동해 왔다고 복수의 여권 관계자들이 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.284
            },
            {
                "speaker_id": "1",
                "transcription": "자유의 새벽당은 반중 친미와 자국민 우선 주의 시장 우선주의 등을 공약으로 내세워 일각에서 극우 성향 정당이라는 평가를 받아 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.294,
                "end": 18.992
            },
            {
                "speaker_id": "1",
                "transcription": "지난 대선 당시 강 행정관은 윤석열 캠프 외곽에서 청년 자문 그룹으로 활동했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.002,
                "end": 24.607
            },
            {
                "speaker_id": "1",
                "transcription": "멸공을 외치며 멸치와 콩을 사는 모습을 올렸던 멸콩기에 또 여가부패지와 주적은 북한 같은 한 줄 메시지 공약을 개발하는데 기여한 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.617,
                "end": 34.834
            }
        ]
    },
