            },
            {
                "speaker_id": "1",
                "transcription": "약 4년에 장기간에 걸쳐 국민 간식인 아이스크림을 가격상승을 소량 다양한 형태의 담합을 적발하여 시정하였다는 데에 의의가 있습니다.",
                "sound_type": [
                    2
