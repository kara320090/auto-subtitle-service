        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 민주당으로 공식 복귀한 이낙연 전 총리.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.545
            },
            {
                "speaker_id": "2",
                "transcription": "감개가 무량합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.555,
                "end": 5.810
            },
            {
                "speaker_id": "2",
                "transcription": "어 지사와 총리로 일하면서 떨어져 있던 당에 6년 만에 돌아왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.820,
                "end": 12.664
            },
            {
                "speaker_id": "1",
                "transcription": "종로 이사는 사실이지만 출마는 당에서 결정해줘야 한다고 말했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.674,
                "end": 17.473
            },
            {
                "speaker_id": "1",
                "transcription": "이 전 총리는 이해찬 대표와 함께 공동선대위원장을 맡을 것으로 관측됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.483,
                "end": 23.626
            },
            {
                "speaker_id": "1",
                "transcription": "민주당에 총선 1호 공약도 발표됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.636,
                "end": 27.261
            },
            {
                "speaker_id": "1",
                "transcription": "2022년까지 공공 와이파이 5만 3000개소를 구축하겠다는 계획인데 생활 밀착형 공약으로 데이터 사용량이 많은 청년층을 공략하는 의도도 풀이됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.271,
                "end": 39.068
            },
            {
                "speaker_id": "3",
                "transcription": "취약계층의 정보 격차를 해소하고 삶의 질을 획기적으로 개선 시키도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.078,
                "end": 47.576
            },
            {
                "speaker_id": "1",
                "transcription": "한국당은 당초 발표했던 공수처 폐지 대신 경제 공약을 1호 공약으로 발표하며 정권 심판을 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.586,
                "end": 55.431
            },
            {
                "speaker_id": "1",
                "transcription": "문재인 정부 들어 경제가 역주행하고 있다며 재정건전화법 발휘 원전 살리기 근로기준법 개정 등을 내세웠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 55.441,
                "end": 64.762
            },
            {
                "speaker_id": "4",
                "transcription": "포퓰리즘 난발 등으로 경제 현장은 도탄에 빠졌고 절망으로 아우성하게 되었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.772,
                "end": 72.135
            },
            {
                "speaker_id": "4",
                "transcription": "위대한 대한민국 경제가 붕괴하고 있는 것입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 72.145,
                "end": 76.709
            }
        ]
    },
    "summary": "민주당은 이낙연 전 총리가 복귀했고 총선 1호 공약으로 와이파이 증설 공약을 내세웠으며 한국당은 당초 발표했던 공수처 폐지 대신 경제 공약을 1호 공약으로 발표하며 정권 심판을 강조했다.",
