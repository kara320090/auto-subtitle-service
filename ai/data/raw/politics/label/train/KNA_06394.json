        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 공익 환수를 설계했고 국민의힘은 배임을 설계한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.428
            },
            {
                "speaker_id": "1",
                "transcription": "그쪽이 부정부패를 설계한 거죠.",
                "sound_type": [
                    2
                ],
                "start": 4.438,
                "end": 6.375
            },
            {
                "speaker_id": "1",
                "transcription": "제가 답변해야 됩니까?",
                "sound_type": [
                    2
                ],
                "start": 6.385,
                "end": 7.802
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보님이 답변해야 됩니까?",
                "sound_type": [
                    2
                ],
                "start": 7.812,
                "end": 9.220
            },
            {
                "speaker_id": "2",
                "transcription": "윤 후보로부터 집중적인 대장동 관련 질의를 받은 이 후보 배우자 의혹을 꺼냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.230,
                "end": 15.701
            },
            {
                "speaker_id": "1",
                "transcription": "도이치 모터스 이거 지금 주가 조작에 연루돼 있다는 말이 많은데 5월 달 이후로는 뭐 거래하지 않았다 그랬는데 그후에 거래를 수없이 했다는 수십억 수십 차례 거래가 있다는 얘기도 있지 않습니까?",
                "sound_type": [
                    2
                ],
                "start": 15.711,
                "end": 27.632
            },
            {
                "speaker_id": "3",
                "transcription": "그 대장동 그 게이트에 비해서 그 작은 사건임에도 불구하고 훨씬 더 검찰에서 연인원을 더 많이 투입해서 했고 아직까지 뭐 무슨 문제점이 드러난 적은 없습니다.",
                "sound_type": [
                    2
