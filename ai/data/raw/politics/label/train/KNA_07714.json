        "term": [
            {
                "speaker_id": "1",
                "transcription": "회계 보고서에 적힌 주소지 한 아파트입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.360
            },
            {
                "speaker_id": "1",
                "transcription": "담당자에게 어떤 업체인지 무슨 일을 했는지 묻자 이렇게 얘기합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.370,
                "end": 8.477
            },
            {
                "speaker_id": "2",
                "transcription": "설문 조사인가 하려고 했다가 하루 만에 저도 폐업을 했어요.",
                "sound_type": [
                    2
                ],
                "start": 8.487,
                "end": 12.168
            },
            {
                "speaker_id": "1",
                "transcription": "민생당에서 입금을 했다고 그렇게 제출을 하셔 가지고.",
                "sound_type": [
                    2
                ],
                "start": 12.178,
                "end": 15.572
            },
            {
                "speaker_id": "2",
                "transcription": "돈 받은 게 1원도 없어요. 하려고 했다가 바로 지웠다니까",
                "sound_type": [
                    2
                ],
                "start": 15.582,
                "end": 19.170
            },
            {
                "speaker_id": "1",
                "transcription": "용역은 조기 축구회에서 만난 친구가 제안했다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.180,
                "end": 23.196
            },
            {
                "speaker_id": "2",
                "transcription": "친구가 같이해 볼래라고 제의를 해서 해 보자고 했다가 잘 아는 분야가 아니니까 그냥 못 하겠다.",
                "sound_type": [
                    2
                ],
                "start": 23.206,
                "end": 30.930
            }
        ]
    },
    "summary": "회계 보고서에 적힌 주소지 한 아파트로 담당자에게 어떤 업체인지 무슨 일을 했는지 물었고 용역은 조기 축구회에서 만난 친구가 제안했다고 했습니다.",
