        "term": [
            {
                "speaker_id": "1",
                "transcription": "시행령으로 설립한 경찰국을 인정하기 힘들다며 전액 삭감 조치한 민주당과 윤 정부 발목 잡기라고 맞선 국민의힘이 정면 충돌했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.185
            },
            {
                "speaker_id": "2",
                "transcription": "처음부터 경찰국을 신설할 때 법적으로 불비하다고 얘기했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.195,
                "end": 15.063
            },
            {
                "speaker_id": "2",
                "transcription": "우리는 법적으로 논리적으로 인정을 못합니다.",
                "sound_type": [
                    2
                ],
                "start": 15.073,
                "end": 19.247
            },
            {
                "speaker_id": "3",
                "transcription": "예산 폭군을 저지른 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.257,
                "end": 20.739
            },
            {
                "speaker_id": "3",
                "transcription": "국정 발목 잡기죠.",
