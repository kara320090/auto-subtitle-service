        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "한미일 3국 외교 장관들이 유엔 총회가 열리고 있는 미국 뉴욕에서 만났습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.848
            },
            {
                "speaker_id": "1",
                "transcription": "지난 7월 주요 20개국 외교 장관 회의가 열린 인도네시아 발리에서 회담을 가진 이후 약 2달 만입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.858,
                "end": 11.409
            },
            {
                "speaker_id": "1",
                "transcription": "블링컨 미국 국무부 장관은 한국과 미국 일본이 각각 맺는 양자 관계만큼 3국간 협력도 중요하다고 언급했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.419,
                "end": 19.540
            },
            {
                "speaker_id": "2",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 19.550,
                "end": 29.183
            },
            {
                "speaker_id": "1",
                "transcription": "주요 의제는 북한의 7차 핵실험 움직임 등 북핵 문제에 대한 공동 대응 방안이었다고 우리 정부는 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.193,
                "end": 36.468
            },
            {
                "speaker_id": "3",
                "transcription": "북한의 그 최근에 그러한 그 어 핵무기 사용 어 위협 관련해서도 한미일 간에 아주 긴밀한 공조를 통해서 우리 아주 단호한 에 그러한 대응을 위한 준비가 필요하다 어 이런 이야기들을 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.478,
                "end": 53.100
            },
            {
                "speaker_id": "1",
                "transcription": "전 날 있었던 한일 정상 간 회동에 대해서는 여러 가지로 의미 있었고 한일 관계 개선을 위해 좋은 계기가 됐다는 평가가 있다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 53.110,
                "end": 62.646
            },
            {
                "speaker_id": "1",
                "transcription": "어제 윤석열 대통령과 만난 기시다 일본 총리는 별도 회견을 가졌는데 한일 관계를 건전한 관계로 되돌리고 일본 정부의 일관된 입장에 기초해 한국과 소통하겠다고 발언했습니다.",
                "sound_type": [
                    2
                ],
                "start": 62.656,
                "end": 74.841
            },
            {
                "speaker_id": "1",
                "transcription": "강제 징용 배상 문제에 대해 현재로선 일본 측 입장을 바꿀 생각이 없고 한국이 먼저 해결에 나서야 한다는 기존 입장을 유지할 거란 뜻으로 해석됩니다.",
                "sound_type": [
                    2
                ],
                "start": 74.851,
                "end": 84.717
            }
        ]
    },
