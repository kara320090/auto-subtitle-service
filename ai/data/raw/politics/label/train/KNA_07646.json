        "term": [
            {
                "speaker_id": "1",
                "transcription": "경제 전쟁의 대장정이 시작되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.465
            },
            {
                "speaker_id": "1",
                "transcription": "새 정부는 이 전쟁에서 반드시 이겨내야 합니다.",
                "sound_type": [
