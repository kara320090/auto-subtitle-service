        "term": [
            {
                "speaker_id": "1",
                "transcription": "늑장 대응이 감염병 사태를 키웠다는 비판에 정부 대응에 한계를 인정하는 답변도 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.015
            },
            {
                "speaker_id": "2",
                "transcription": "전문가들의 의견을 무시한 정치적인 판단 때문에 이런 비참한 상황이 초래됐다고 보고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.025,
                "end": 12.451
            },
            {
                "speaker_id": "3",
                "transcription": "방역에 한계가 있었다는 것을 인정하고 국민 여러분께 다시 한번 송구스럽다는 말씀을 드리고",
                "sound_type": [
                    2
                ],
                "start": 12.461,
                "end": 20.489
            },
            {
                "speaker_id": "1",
                "transcription": "중국발 입국 금지 조치에 대해선 실효성이 없다는 답이 돌아왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.499,
                "end": 24.987
            },
            {
                "speaker_id": "4",
                "transcription": "중국을 꼭 방문해야 하는 우리 국민들의 입장에서 봤을 때도 아 부정적인 효과가 있을 거라고 생각이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 24.997,
                "end": 31.982
            },
            {
                "speaker_id": "1",
                "transcription": "코로나19 확산 원인을 중국에서 들어온 한국인이라 했던 복지 장관의 발언에 대해선 정부 내 평가가 달랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.992,
                "end": 39.189
            },
            {
                "speaker_id": "5",
                "transcription": "중국에서 들어온 한국인이 코로나 확산의 최고 원인이다.",
                "sound_type": [
                    2
                ],
                "start": 39.199,
                "end": 42.709
            }
        ]
    },
    "summary": "늑장 대응이 감염병 사태를 키웠다는 비판에 정부 대응에 한계를 인정하는 답변이 나왔고 중국발 입국 금지 조치에 대해선 실효성이 없다는 답이 돌아왔다.",
