        "term": [
            {
                "speaker_id": "1",
                "transcription": "지난 4월 공수처가 이른바 1호 사건으로 입건한 조희연 서울시 교육감의 해직 교사 특별 채용 의혹.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.141
            },
            {
                "speaker_id": "1",
                "transcription": "넉 달 여의 수사 끝에 공수처는 조 교육감을 재판에 넘겨야 한다고 결론 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.151,
                "end": 12.298
            },
            {
                "speaker_id": "1",
                "transcription": "자신의 선거 캠프에서 활동한 인사 등 해직 교사 5명을 특별 채용하면서 직권을 남용한 혐의가 인정된다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 12.308,
                "end": 20.832
            },
            {
                "speaker_id": "1",
                "transcription": "공수처는 조 교육감이 특채에 반대하는 구 교육감과 국장 과장 등을 배제하고 관련 서류를 단독 결재해 이들의 결재권 행사를 방해했다고 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.842,
                "end": 31.580
            },
            {
                "speaker_id": "1",
                "transcription": "또 당시 비서실장이던 한 모 씨에게 채용 업무에 관한 권한이 없었는데도 담당 공무원들이 한 씨의 지시를 받도록 했다고 판단했습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.590,
                "end": 41.074
            }
        ]
    },
    "summary": "공수처가 조희연 서울시 교육감을 자신의 선거 캠프에서 활동한 인사 등 해직 교사 5명을 특별 채용하면서 직권을 남용한 혐의로 재판에 넘기기로 결정했다.",
