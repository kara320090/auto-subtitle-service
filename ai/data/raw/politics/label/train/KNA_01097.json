        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 오늘 오일팔 기념식에 참석해 자유와 인권의 가치를 강조하며 5월 정신이 국민 통합의 주춧돌이라고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.145
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 기념식에 함께한 새 정부 장관들과 여야 의원들은 다 같이 임을 위한 행진곡을 제창하기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.155,
                "end": 16.403
            },
            {
                "speaker_id": "1",
                "transcription": "이유민 기자의 보도입니다.",
