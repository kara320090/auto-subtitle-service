        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 야당에선 법무부 장관 직속 인사 정보 관리단이 이 같은 취지와는 거리가 있다며 우려의 목소리를 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.635
            },
            {
                "speaker_id": "1",
                "transcription": "법무부 장관에게 인사 검증 수사 지휘 권한이 집중돼 있다 보니 공직 후보자의 신상 세평 정보가 그대로 검찰 수사 단서로 활용될 가능성이 높다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 7.645,
                "end": 18.708
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 검찰 공화국을 향한 노골적인 계획이라며 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.718,
                "end": 23.296
            },
            {
                "speaker_id": "2",
                "transcription": "법무부 장관은 사실상 총리 이상의 권한을 가지게 되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.306,
                "end": 28.594
            },
            {
                "speaker_id": "2",
                "transcription": "정말 소통령 한동훈이라고 불러도 이상하지 않습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.604,
                "end": 32.465
            }
        ]
    },
    "summary": "야당에선 법무부 장관에게 인사 검증 수사 지휘 권한이 집중되어 검찰 수사 단서로 활용될 가능성이 높다며 검찰 공화국을 향한 노골적 계획이라고 반발했다는 소식이다.",
