        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "반면 윤석열 안철수 후보는 원자력 필요성을 강조합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.500
            },
            {
                "speaker_id": "1",
                "transcription": "윤 후보는 탈원전 폐지를 밝히고 차세대 기술 원전 개발도 추진하겠다고 강조합니다.",
                "sound_type": [
                    2
                ],
                "start": 3.510,
                "end": 9.219
            },
            {
                "speaker_id": "1",
                "transcription": "원전 없는 탄소 중립은 허구라는 안 후보는 현 정부가 단계적 폐쇄를 정한 원전 11기를 재점검해 안전하면 연장 사용하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.229,
                "end": 18.693
            },
            {
                "speaker_id": "1",
                "transcription": "원자력 비중이 높아지면 사용 후 핵연료 처리가 관건입니다.",
                "sound_type": [
                    2
                ],
                "start": 18.703,
                "end": 22.437
            },
            {
                "speaker_id": "1",
                "transcription": "원전 부지에 임시 보관한다.",
                "sound_type": [
                    2
                ],
                "start": 22.447,
                "end": 24.788
            },
            {
                "speaker_id": "1",
                "transcription": "미국과 재처리 기술 협상을 한다.",
                "sound_type": [
                    2
                ],
                "start": 24.798,
                "end": 26.807
            },
            {
                "speaker_id": "1",
                "transcription": "각각 이렇게 밝히지만 현실적 대안이냐에는 의문이 남습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.817,
                "end": 30.997
            }
        ]
    },
