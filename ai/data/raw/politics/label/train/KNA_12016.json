                ],
                "start": 0.000,
                "end": 9.293
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 문 대통령은 하지만 아직 낙관은 금물이라며 낙관론도 경계했습니다.",
                "sound_type": [
