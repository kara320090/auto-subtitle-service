        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 검찰 내부 분위기는 어떻습니까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.301
            },
            {
                "speaker_id": "2",
                "transcription": "대검찰청은 중재안에 단호히 반대한다는 공식 입장을 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.311,
                "end": 10.602
            },
            {
                "speaker_id": "2",
                "transcription": "기존 민주당 법안에서 시행 시기만 늦췄을 뿐이라는 의견을 밝혔는데요.",
                "sound_type": [
                    2
                ],
                "start": 10.612,
                "end": 15.045
            },
            {
                "speaker_id": "2",
                "transcription": "유관 기관이 모여 제대로 논의 1번을 못하는 등 심각한 절차상 문제가 있다고 지적했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.055,
                "end": 21.104
            },
            {
                "speaker_id": "2",
                "transcription": "일선 검사들도 야합 역사적 퇴행 폭거라는 반응까지 내놓으며 반발하는 분위기입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.114,
                "end": 27.390
            },
            {
                "speaker_id": "2",
                "transcription": "경찰 수사를 어떻게 통제할 것인지는 언급조차 되지 않았다 검 경찰 수사 대상에 검찰 수사 대상에 선거 범죄가 빠진 건 정치권의 이해 관계 때문이라는 반응이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.400,
                "end": 38.815
            },
            {
                "speaker_id": "2",
                "transcription": "검찰은 끝까지 법안의 문제점을 알리며 국민과 국회를 설득하겠다고 밝혔고 헌법 재판소에서 위헌 여부를 다투는 것을 포함해 법안 저지를 위한 움직임을 이어갈 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 38.825,
                "end": 49.170
            },
            {
                "speaker_id": "2",
                "transcription": "지금까지 대검찰청에서 KBS 뉴스 박진수입니다.",
                "sound_type": [
                    2
                ],
                "start": 49.180,
                "end": 52.719
            }
        ]
    },
    "summary": "검찰 내부는 중재안에 반대하며 끝까지 법안 저지를 위한 움직임을 이어갈 것으로 보인다고 전했다.",
