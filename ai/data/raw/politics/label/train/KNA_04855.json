        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당 이재명 후보는 집권에 대비한 예비 내각을 생각하고 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.876
            },
            {
                "speaker_id": "1",
                "transcription": "통합 정부 실용 내각이 될 거라며 진영을 가리지 않고 사람을 쓰겠다고 했는데 연대 가능성도 내비쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.886,
                "end": 13.333
            },
            {
                "speaker_id": "2",
                "transcription": "가능하면 선거 과정에서 어 그런 연합을 해낼 수 있다면 훨씬 더 낫지 않을까 그런 기대는 하고 있죠.",
                "sound_type": [
                    2
                ],
                "start": 13.343,
                "end": 21.294
            },
            {
                "speaker_id": "1",
                "transcription": "부동산 정책과 관련해선 공급을 강조하며 일부 그린벨트 해제 가능성을 언급했고 북한에 대해서도 할말은 하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.304,
                "end": 30.665
            },
            {
                "speaker_id": "1",
                "transcription": "서해 5도 경비단을 찾은 이 후보는 중국 어선 불법 조업과 관련해 무관용 강경 조치가 필요하다고 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.675,
                "end": 39.378
            },
            {
                "speaker_id": "1",
                "transcription": "이틀째 대구 경북을 방문 중인 국민의 힘 윤석열 후보는 정권 교체 필요성을 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.388,
                "end": 46.267
            },
            {
                "speaker_id": "3",
                "transcription": "정권 교체하지 않으면 아마 이제 자기들이 20년 50년을 계속 해 먹는다고 했으니까 아마 우리 당도 뿌리를 뽑아 버릴 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 46.277,
                "end": 56.289
            }
        ]
    },
    "summary": "이재명 후보는 집권을 대비한 예비 내각을 생각하고 있다며 연대 가능성을 내비쳤고 중국 어선 관련해서는 무관용 강경 조치가 필요하다고 강조했으며 윤 후보는 정권 교체의 필요성 강조했다.",
