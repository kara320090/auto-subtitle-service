        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 국방부 기대와 달리 최종 면접자 7명 중 정책 경력자는 A씨 1명 밖에 없었던 것으로 파악됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.163
            },
            {
                "speaker_id": "2",
                "transcription": "A씨는 가장 높은 점수를 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.173,
                "end": 11.065
            },
            {
                "speaker_id": "2",
                "transcription": "응시를 한 사람들한테 제가 두어 명 정도한테 내가 얘기를 들었어요.",
                "sound_type": [
                    2
                ],
                "start": 11.075,
                "end": 16.301
            },
            {
                "speaker_id": "2",
                "transcription": "7명 중에 1명 밖에 안 왔으니까 인사 근무를 안 하신 분은",
                "sound_type": [
                    2
                ],
                "start": 16.311,
                "end": 20.648
            },
            {
                "speaker_id": "1",
                "transcription": "이종섭 국방부 장관이 자격 요건 변경 방침을 보고 받고 결정한 시점과 경위도 불투명합니다.",
                "sound_type": [
                    2,
