        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이재명 민주당 대선 후보가 전국민 재난지원금을 고집하지 않겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.613
            },
            {
                "speaker_id": "2",
                "transcription": "저의 주장 때문에 에 그 선별적인 또는 뭐 제외된 업종에 대한 어 또는 추가의 지원이 에 지연되지 않도록 저의 주장을 접고",
                "sound_type": [
                    2
                ],
                "start": 5.623,
                "end": 19.296
            },
            {
                "speaker_id": "1",
                "transcription": "이 후보는 현장은 다급한데 정치의 속도는 너무 느리다면서 전국민 재난지원금 합의가 어렵다면 소상공인 자영업자 피해에 대해서라도 시급히 지원에 나서야 한다고 촉구했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.306,
                "end": 32.358
            },
            {
                "speaker_id": "1",
                "transcription": "야당과 정부의 반대 속에 전국민 재난지원금 방안을 꺼내든지 20일 만에 사실상 주장을 철회한 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 32.368,
                "end": 40.784
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 후보는 당 선대위가 기민하지 못하다는 평가도 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 40.794,
                "end": 45.603
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 열린민주당과의 합당 논의를 공식화 했는데 중도 확장에 앞서 우선 진영을 결집시키려는 차원으로 해석됩니다.",
                "sound_type": [
                    2
                ],
                "start": 45.613,
                "end": 55.021
            }
        ]
    },
    "summary": "이재명 후보는 전국민 재난지원금 방안을 꺼내든지 20일 만에 야당과 정부의 반대 속에 사실상 주장을 철회했습니다.",
