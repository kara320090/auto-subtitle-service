        "term": [
            {
                "speaker_id": "1",
                "transcription": "배상금 수령과 별개로 일본의 직접 사죄가 필요하다는 데는 한 목소리를 냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.382
            },
            {
                "speaker_id": "1",
                "transcription": "강제동원 배상 대신 한국 유학생에게 장학금을 주겠다는 구상도 비판했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.392,
                "end": 11.228
            },
            {
                "speaker_id": "2",
                "transcription": "그만큼 저기 부려먹고 그랬으면 사과 정도는 해야 원칙 아니냐 이거예요.",
                "sound_type": [
                    2
                ],
                "start": 11.238,
                "end": 17.184
            },
            {
                "speaker_id": "2",
                "transcription": "피해도 안 본 사람들한테 장학금을 준다는 게 우스운 얘기 아니에요?",
                "sound_type": [
                    2
                ],
                "start": 17.194,
                "end": 21.028
            },
            {
                "speaker_id": "1",
                "transcription": "일본의 배상과 직접 사과 어느 것도 얻어내지 못한 한국 정부 피해자들은 반쪽짜리 배상금을 받거나 다시 긴 싸움을 벌여야 할 처지가 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.038,
