        "term": [
            {
                "speaker_id": "1",
                "transcription": "한일 간 최대 현안인 일제 강제 동원 문제와 관련해서도 정부가 저자세 외교에 너무 조급한 태도를 보이고 있다며 속도 조절론이 제기됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.725
            },
            {
                "speaker_id": "1",
                "transcription": "또 피해자 동의 없이 제3자가 배상금을 지급하는 이른바 병존적 채무 인수가 검토되고 있는 점에 대해선 국민의 공감을 얻는 것이 먼저라는 지적도 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.735,
                "end": 23.839
            },
            {
                "speaker_id": "2",
                "transcription": "또다시 2015년의 파동이 우려된단 말씀을 드리고요.",
                "sound_type": [
                    2
                ],
                "start": 23.849,
                "end": 29.675
            },
            {
                "speaker_id": "2",
                "transcription": "국민의 공감대 없이는 처리될 수가 없어요.",
