        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령이 대선 때 다른 사람들 앞에서 나를 가르켜 욕을 했다 이준석 대표는 이를 일종의 공격 지령이었다고 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.630
            },
            {
                "speaker_id": "2",
                "transcription": "그걸 듣고 나서 아 대통령이 이준석을 별로 안 좋아하는구나 그러니까 쟤 때려도 되겠다면서 그다음에 인 제 소위 윤핵관과 윤핵관 후보님들 절 때리기 위해 들어오는 약간 지령 비슷한 역할을 한 거거든요.",
                "sound_type": [
                    2
                ],
                "start": 8.640,
                "end": 19.237
            },
            {
                "speaker_id": "1",
                "transcription": "비대위 효력 정지 가처분 신청을 법원이 받아들인다면 윤핵관 측이 창당 등 정계 개편을 노릴 수 있다고까지 했습니다.",
                "sound_type": [
