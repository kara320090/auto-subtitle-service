        "term": [
            {
                "speaker_id": "1",
                "transcription": "새해 예산안 처리 법정 시한을 하루 앞둔 어제 국회의장과 여야 원내대표가 연 이틀째 얼굴을 맞댔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.087
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 이상민 장관 해임 건의안을 보고 할 수 있도록 본회의를 열어달라고 촉구했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.097,
                "end": 13.010
            },
            {
                "speaker_id": "2",
                "transcription": "여야 아 지도부 차원에서 합의를 했고 의장께서도 어 공지를 한 어 사항입니다.",
                "sound_type": [
                    2,
