        "term": [
            {
                "speaker_id": "1",
                "transcription": "검찰이 오늘 압수수색을 벌인 곳은 노웅래 민주당 위원회 자택과 국회의원실 서울 마포구에 지협구 사무실 등이었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.935
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 2020년 노 의원이 사업가 박 모 씨 등으로부터 청탁과 함께 6000만 원의 정치 자금을 받은 것으로 의심하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.945,
                "end": 17.907
            },
            {
                "speaker_id": "1",
                "transcription": "박 씨가 폐선로 부지를 이용해 태양광 사업을 추진하는 과정에서 사업 편의를 봐달라며 거액을 전달했다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 17.917,
                "end": 26.144
            },
            {
                "speaker_id": "1",
                "transcription": "이 과정에서 국토교통부 장관을 만나게 해달라는 청탁도 오간 것으로 검찰은 보고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.154,
                "end": 32.665
            }
        ]
    },
    "summary": "노웅래 의원 압수수색을 벌였고 청탁도 오간 것으로 검찰은 보고 있다.",
