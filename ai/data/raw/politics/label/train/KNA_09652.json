        "term": [
            {
                "speaker_id": "1",
                "transcription": "기소를 합리화하기 위해 자신의 진술을 비틀 것인 만큼 방어권을 행사하겠단 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.022
            },
            {
                "speaker_id": "2",
                "transcription": "검찰의 주장이 얼마나 허황된지 객관적 진실이 무엇인지 충분히 알 수 있을 것입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.032,
                "end": 15.392
            },
            {
                "speaker_id": "2",
                "transcription": "순리와 진실의 힘을 믿습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.402,
                "end": 21.121
            },
            {
                "speaker_id": "1",
                "transcription": "모두 33쪽 분량 진술서에서 5쪽은 공권력을 향한 질타로 채웠습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.131,
                "end": 26.754
            },
            {
                "speaker_id": "1",
                "transcription": "검사 취임 선서를 인용하며 검찰은 정치가 아닌 수사를 해야 한다고 훈계했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.764,
                "end": 32.365
            }
        ]
    },
    "summary": "이재명 대표는 진술서에서 공권력에 대해 비난하며 검찰이 정치가 아닌 수사를 해야 한다고 훈계했다.",
