        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "민생에는 여야가 없기 때문에 힘을 합쳐야 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.486
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 그 출발은 국회를 존중하고 또 소통하는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.496,
                "end": 7.827
            },
            {
                "speaker_id": "2",
                "transcription": "비공개 회동에서 박 원내대표를 식사 자리에 모시겠다는 윤 당선인의 말이 전해졌는데 박 원내대표는 당선인과 현직 대통령의 격의 없는 소통이 중요하다고 두 사람의 회동이 늦어지는 책임을 언급했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.837,
                "end": 22.917
            },
            {
                "speaker_id": "2",
                "transcription": "박 원내대표는 민주당의 지도부 회의에 처음 참석해선 강하고 유능한 야당을 강조했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.927,
                "end": 29.301
            },
            {
                "speaker_id": "2",
                "transcription": "새 정부가 잘하는 일에는 협력하겠다고 했지만 그 협력의 폭은 윤석열 당선인에게 달려 있다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.311,
                "end": 36.841
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘 정권의 잘못은 국민의 편에서 따끔하게 지적하되 잘한 일에 대해서는 제대로 평가해 주고 필요한 일은 협조하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.851,
                "end": 46.485
            },
            {
                "speaker_id": "2",
                "transcription": "박 원내대표는 여야 협상을 담당할 원내 운영 수석으로는 부동산 세제 완화에 앞장서 반대하는 등 강경 개혁 성향으로 분류되는 진성준 의원을 임명했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.495,
                "end": 57.959
            },
            {
                "speaker_id": "2",
                "transcription": "박 원내대표는 박원순 전 서울시장 장례식 때 공동집행위원장을 맡아 2차 가해를 입혔다는 지적에 대해서는 사람 된 도리였지만 피해 호소인이란 말을 쓴 건 잘못이었다고 인정했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.969,
                "end": 71.379
            },
            {
