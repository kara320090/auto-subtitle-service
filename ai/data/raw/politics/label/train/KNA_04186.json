        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 건강과 직결되지 않는 거라면 좀 기준을 너무 높이 해 가지고 단속을 하고 또 거기에다 형사 처벌까지 나가는 것은 그거는 좀 검찰권의 그 과도한 그 좀 남용이 아니냐",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 15.442
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 국민의 힘에는 김대중 대통령 시절 청와대 국정 상황 실장을 지낸 장성민 전 의원이 입당했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.452,
                "end": 22.856
            },
            {
                "speaker_id": "2",
                "transcription": "장 전 의원은 정권 교체라는 호랑이를 잡기 위해 국민의 힘에 들어왔다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.866,
                "end": 29.066
            },
            {
                "speaker_id": "2",
                "transcription": "민주당에서는 경기 지사인 이재명 후보가 경기도에선 도민 100퍼센트에게 재난 지원금을 주겠다고 해 다른 후보들이 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.076,
                "end": 38.384
            },
            {
                "speaker_id": "3",
                "transcription": "중앙 정부 정책과 지방 정부의 정책은 다른 게 정상이다라는 말씀을 먼저 드리",
                "sound_type": [
                    2
                ],
                "start": 38.394,
