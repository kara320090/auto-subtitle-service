            },
            {
                "speaker_id": "1",
                "transcription": "칩4 예비 회의는 다음 달 초 열릴 예정입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.124,
                "end": 10.775
            },
            {
                "speaker_id": "1",
                "transcription": "칩4의 공식 명칭부터 참여 수준 세부 의제 등이 논의될 것으로 보입니다.",
                "sound_type": [
