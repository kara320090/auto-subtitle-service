                ],
                "start": 10.785,
                "end": 16.023
            },
            {
                "speaker_id": "1",
                "transcription": "정부 관계자는 예비 회의 참가가 정식 가입을 뜻하는 건 아니라고 선을 그었습니다.",
                "sound_type": [
