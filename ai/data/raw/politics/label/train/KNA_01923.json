        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인 측은 기존의 청와대를 쓸 가능성은 제로라고 표현했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.621
            },
            {
                "speaker_id": "2",
                "transcription": "청와대 밖으로 나오겠다고 한 것은 국민 속으로 들어가고 소통이 중요하다는 오랜 의지 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.631,
                "end": 13.827
            },
            {
                "speaker_id": "1",
                "transcription": "의지는 분명한데 그러면 어디로 옮길지는 결정이 쉽지 않습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.837,
                "end": 18.437
            },
            {
                "speaker_id": "1",
                "transcription": "1차 검토했던 정부 서울 청사 대신 경호와 보안 지하 벙커 활용 등의 이점이 분명한 용산의 국방부 건물이 유력하게 검토되고는 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.447,
                "end": 27.669
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 윤 당선인이 강조해 온 국민들과 접촉이 어렵고 광화문의 공무원들과도 떨어져 있어 그럴 거면 구중궁궐이라던 청와대와 다를 게 뭐냐는 반론이 제기됩니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 27.679,
                "end": 37.438
            },
            {
                "speaker_id": "3",
                "transcription": "군 보안 시설에다 경호 시설이 추가로 들어서면은 시민들의 접근이 매우 어려워져요.",
                "sound_type": [
                    2
                ],
                "start": 37.448,
                "end": 44.740
            },
            {
                "speaker_id": "3",
                "transcription": "소통을 원활하게 하겠다는 기본 취지에서 더 멀어지지 않을까 그런 우려가 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 44.740,
                "end": 50.090
            },
            {
                "speaker_id": "1",
                "transcription": "또 용산에 집무실을 만들면 한남동의 장관 공관 중 하나를 관저로 사용할 가능성이 높은데 대통령의 출퇴근에 따른 시민 불편도 걸림돌입니다.",
                "sound_type": [
                    2
                ],
                "start": 50.100,
                "end": 59.099
            },
            {
                "speaker_id": "1",
                "transcription": "신호 통제가 이뤄지면 이태원 삼각지 일대 교통 정체는 더 심해질 수밖에 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 59.109,
                "end": 64.363
            },
            {
                "speaker_id": "1",
                "transcription": "광화문 대통령이라는 상징성이 반토막 나는 것도 부담입니다.",
                "sound_type": [
                    2
                ],
                "start": 64.373,
                "end": 68.277
            },
            {
                "speaker_id": "4",
                "transcription": "굉장히 그게 복잡해요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 68.287,
                "end": 71.173
            },
            {
                "speaker_id": "4",
                "transcription": "경호 문제도 그렇고 보안 문제도 그렇고 안보 문제도 그렇고 그게 간단한 문제가 아니에요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 71.183,
                "end": 77.796
            },
            {
                "speaker_id": "4",
                "transcription": "그러면 복수로 우리가 고민을 해 봐야 되는 거 아니냐.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 77.806,
                "end": 80.974
            },
            {
                "speaker_id": "1",
                "transcription": "당선인 측은 5월 10일 취임 첫날을 새 집무실에서 맞이하는 걸 목표로 결정을 서두를 계획이지만 거론되는 대안마다 단점도 만만치 않아 고심이 깊어지고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 80.984,
                "end": 91.253
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 박민철입니다.",
                "sound_type": [
                    2
                ],
                "start": 91.263,
                "end": 93.752
            },
            {
                "speaker_id": "5",
                "transcription": "문재인 정부의 마지막 검찰 수장을 맡고 있는 권오수 검찰총장은 자진 사퇴하지 않겠다는 뜻을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 93.762,
                "end": 100.874
            },
            {
                "speaker_id": "5",
                "transcription": "검찰 안팎에서 자꾸 미리 물러나라는 얘기가 나오자 법과 원칙에 따라 본연의 임무를 충실히 수행하겠다는 말로 선을 딱 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 100.884,
                "end": 109.762
            },
            {
                "speaker_id": "5",
                "transcription": "김민철 기자입니다.",
                "sound_type": [
                    2
                ],
                "start": 109.772,
                "end": 111.478
            }
        ]
    },
    "summary": "윤석열 당선인 측은 기존의 청와대를 쓸 가능성은 제로라고 표현했고 청와대 밖으로 나오겠다고 한 것은 국민 속으로 들어가고 소통이 중요하다는 오랜 의지 때문이라고 하는데 어디로 옮길지는 결정이 쉽지 않고 국방부 건물이 유력하게 검토되고 있지만 구중궁궐이라던 청와대와 다를 게 없고 대통령의 출퇴근에 따른 시민 불편도 걸림돌이며 광화문 대통령이라는 상징성이 반 토막 나는 것도 부담이라는 반론들이 제기되고 있으며 당선인 측은 5월 10일 취임 첫날을 새 집무실에서 맞이하는 걸 목표로 결정을 서두를 계획이라고 한 한편 문재인 정부의 마지막 검찰 수장을 맡고 있는 권오수 검찰 총장은 자진 사퇴하지 않겠다는 뜻을 밝혔고 찰 안팎에서 자꾸 미리 물러나라는 얘기가 나오자 법과 원칙에 따라 본연의 임무를 충실히 수행하겠다는 말로 선을 그었다.",
