        "term": [
            {
                "speaker_id": "1",
                "transcription": "심상정 안철수 후보 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.574
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 후보께서 뭘 그렇게 두려워 하시는지 4자 토론 회피하지 마시고 토론장에 당당하게 나오시고요.",
                "sound_type": [
                    2
                ],
                "start": 2.584,
                "end": 10.059
            },
            {
                "speaker_id": "3",
                "transcription": "저와 토론하는 게 무섭나 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 10.069,
                "end": 12.450
            },
            {
                "speaker_id": "3",
                "transcription": "무시한다는 거는 정말 민주주의에서 리더로서의 자격이 있는지",
                "sound_type": [
                    2
                ],
                "start": 12.460,
                "end": 18.832
            },
            {
                "speaker_id": "1",
                "transcription": "민주당 이재명 후보는 형식에 구애받지 않겠다는 입장을 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.842,
                "end": 23.223
            }
        ]
    },
    "summary": "윤 후보의 토론 거부에 심상정과 안철수 후보는 반발했고 이재명 후보는 형식에 구애받지 않겠다는 입장을 내놨습니다.",
