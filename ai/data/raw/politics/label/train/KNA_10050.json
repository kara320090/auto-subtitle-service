        "term": [
            {
                "speaker_id": "1",
                "transcription": "80년 5월 26일 광주 전남도청 앞 운구 행렬 속 유독 눈에 띄는 어린아이 기억 속의 옷 차림 그대로였습이다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.177
            },
            {
                "speaker_id": "2",
                "transcription": "진짜 우리 창현이 맞아.",
                "sound_type": [
                    2
                ],
                "start": 9.187,
                "end": 12.375
            },
            {
                "speaker_id": "2",
                "transcription": "이거 보니까 금방 살아서 엄마하고 올 것 같애.",
                "sound_type": [
                    2
                ],
                "start": 12.385,
                "end": 16.012
            },
            {
                "speaker_id": "2",
                "transcription": "창현이 좀 찾아줘요.",
                "sound_type": [
                    2
                ],
                "start": 16.022,
                "end": 17.567
            },
            {
                "speaker_id": "1",
                "transcription": "사진을 촬영한 사람은 프랑스 종군 기자인 페트릭 쇼벨.",
                "sound_type": [
                    2
                ],
                "start": 17.577,
                "end": 23.025
            },
            {
                "speaker_id": "1",
                "transcription": "1980년 5월 26일과 27일 광주에서 3대의 사진기로 당시의 긴박한 상황을 담았습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.035,
                "end": 30.430
            }
        ]
    },
    "summary": "실종 당시 아이의 사진을 찍은 사람은 프랑스 종군 기자인 페트릭 쇼벨이다.",
