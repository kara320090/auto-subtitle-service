        "term": [
            {
                "speaker_id": "1",
                "transcription": "드루킹 댓글 조작 사건으로 징역 2년이 확정됐던 김경수 전 경남 도지사도 사면 대상이 됐습니다.",
                "sound_type": [
                    2,
