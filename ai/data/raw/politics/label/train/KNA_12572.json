        "term": [
            {
                "speaker_id": "1",
                "transcription": "서울시와의 협의를 전제로 그린벨트 해제를 주택공급 우선순위로 두고 있다는 점을 공식화한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.716
            },
            {
                "speaker_id": "1",
                "transcription": "우선 거론되는 곳은 과거 보금자리 주택을 개발하고 남은 서초구 내곡동과 강남구 세곡동 등입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.726,
                "end": 14.047
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 핵심 당사자인 서울시는 그린벨트 해제는 협의 대상이 아니라고 반대의 뜻을 재차 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.057,
                "end": 21.563
            },
            {
                "speaker_id": "2",
                "transcription": "20년 이상 그린벨트에 대해서는 일관된 입장이기 때문에 그게 뭐 바뀌고 그런다는 건 저는 아니라고 보거든요.",
                "sound_type": [
                    2
                ],
                "start": 21.573,
                "end": 29.699
            },
            {
                "speaker_id": "1",
                "transcription": "서울시가 반대해도 정부가 공공택지로 지정하면 해당 지역은 그린벨트에서 자동 해제됩니다.",
                "sound_type": [
                    2
                ],
                "start": 29.709,
                "end": 36.469
            }
        ]
    },
    "summary": "정부가 그린벨트 해제 쪽으로 입장을 정리했지만 서울시는 여전히 불가하다는 입장을 바꾸지 않고 있다.",
