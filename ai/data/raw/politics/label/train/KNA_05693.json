        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 오늘 오전 9시 반쯤 시작된 조사가 9시간 넘게 이어지고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.987
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 정무조정실장이 소환된 건 검찰이 자택과 사무실을 압수수색한 지 엿새 만인데요.",
                "sound_type": [
                    2
                ],
                "start": 4.997,
                "end": 11.111
            },
            {
                "speaker_id": "1",
                "transcription": "정 실장은 취재진의 눈을 피해 비공개로 출석했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.121,
                "end": 15.514
            },
            {
                "speaker_id": "1",
                "transcription": "정 실장은 혐의를 부인하는 진술을 이어가는 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.524,
                "end": 19.396
            },
            {
                "speaker_id": "1",
                "transcription": "검찰이 압수수색 영장에 이재명 대표와 정 실장을 정치적 공동체라고 적시한 만큼 이 대표의 관련성도 함께 조사하고 있는 것으로 알려졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.406,
                "end": 29.211
            },
            {
                "speaker_id": "1",
                "transcription": "검찰은 조사를 마치는 대로 구속영장 청구 여부를 결정할 방침입니다.",
                "sound_type": [
                    2
                ],
                "start": 29.221,
                "end": 34.216
            },
            {
                "speaker_id": "2",
                "transcription": "정 실장이 받는 혐의 구체적으로 어떤 내용들인가요?",
                "sound_type": [
                    2
                ],
                "start": 34.226,
                "end": 38.304
            }
        ]
    },
    "summary": "정 실장은 비공개로 출석했고 조사를 마치는 대로 구속영장 청구 여부를 결정할 예정이다.",
