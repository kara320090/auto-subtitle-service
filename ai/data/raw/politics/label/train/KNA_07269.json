        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 정부가 추경 편성을 공식화하자 민주당도 곧바로 협조의 뜻을 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.055
            },
            {
                "speaker_id": "2",
                "transcription": "코로나로 인한 국민 피해를 보상할 마지막 기회입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.065,
                "end": 10.627
            },
            {
                "speaker_id": "2",
                "transcription": "정부안에 부족한 사업들을 제시하고 보완해 가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.637,
                "end": 14.836
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 추가 국채 발행이 없을 거란 소식에 격한 반응이 나왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.846,
                "end": 19.848
            },
            {
                "speaker_id": "1",
                "transcription": "33조 원 이상의 2차 추경 예산을 마련하는데 국채를 발행하지 않는다면 그만큼 초과 세수를 쓴다는 뜻인데 1년 예산의 10퍼센트에 해당하는 세금 추계 오류가 발생한 건 심각한 문제라는 겁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.858,
                "end": 33.800
            }
        ]
    },
    "summary": "윤석열 정부는 추경 편성을 공식화하기로 했고, 민주당도 협조의 뜻을 밝혔다.",
