        "term": [
            {
                "speaker_id": "1",
                "transcription": "안건 심사하시다가 또 바로 나가셨어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.644
            },
            {
                "speaker_id": "1",
                "transcription": "상정하시자마자 나갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.654,
                "end": 4.463
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 어떻게 이게 날치기가 됩니까.",
                "sound_type": [
                    2
                ],
                "start": 4.473,
                "end": 6.493
            },
            {
                "speaker_id": "2",
                "transcription": "결국 국민의힘 의원들이 집단 퇴장한 뒤 야권 단독으로 상임위 문턱을 넘었습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.503,
                "end": 12.332
            },
            {
                "speaker_id": "3",
                "transcription": "반대하시는 의원님 손을 들어주시기 바랍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.342,
                "end": 15.157
            },
            {
                "speaker_id": "3",
                "transcription": "의사진행 발언은 충분하게 했고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.167,
                "end": 17.893
            },
            {
                "speaker_id": "4",
                "transcription": "심판받을 겁니다 위원장님 예?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.903,
                "end": 20.116
            },
            {
                "speaker_id": "2",
                "transcription": "개정안은 하청과 특수고용 노동자들도 원청 기업을 상대로 교섭을 할 수 있게 돼 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.126,
                "end": 26.559
            }
        ]
    },
    "summary": "법안에 반대하는 국민의힘 의원들은 단체로 퇴장했고 야권 단독으로 처리된 개정안에서는 하청과 특수고용 노동자들도 원청 기업을 상대로 교섭을 할 수 있게 된다.",
