        "term": [
            {
                "speaker_id": "1",
                "transcription": "자신을 향한 잇단 수사에 그동안 언급을 피했던 이재명 대표 오늘 공식 석상에서 사실상 처음 관련 발언을 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.193
            },
            {
                "speaker_id": "2",
                "transcription": "정부도 야당 탄압 또 정적 제거 이런 데 너무 그 국가 역량을 소모하지는 마시고",
                "sound_type": [
                    2
                ],
                "start": 8.203,
                "end": 17.926
            },
            {
                "speaker_id": "1",
                "transcription": "자신에 대한 수사를 정적 제거라고 규정 지은 건데 경찰이 1년 만에 무혐의 결론을 뒤집은 것에 대해서도 불만을 감추지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.936,
                "end": 27.818
            },
            {
                "speaker_id": "3",
                "transcription": "결과가 뒤집혔는데 그 점은 어떻게 보실까요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.828,
                "end": 30.557
            },
            {
                "speaker_id": "2",
                "transcription": "경찰에 물어보시죠 왜 뒤집었나",
