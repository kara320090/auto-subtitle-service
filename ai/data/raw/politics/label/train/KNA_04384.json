        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의 힘 대통령 후보 적합도에서는 홍준표 30.2 윤석열 21.8퍼센트로 홍 후보가 윤 후보를 제치고 1위로 올라섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.523
            },
            {
                "speaker_id": "1",
                "transcription": "두 후보 간 격차는 8.4퍼센트 포인트로 오차 범위 밖입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.533,
                "end": 14.084
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 여야 주요 후보들 간의 양자 대결을 가정해 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.094,
                "end": 18.544
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 후보와 윤석열 후보가 맞설 경우 이 후보가 오차 범위 밖에서 앞섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.554,
                "end": 24.339
            },
            {
                "speaker_id": "1",
                "transcription": "이재명 후보는 홍준표 후보와의 가상 대결에서도 우위를 보였습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.349,
                "end": 29.070
            },
            {
                "speaker_id": "1",
                "transcription": "이낙연 후보와 윤석열 후보의 가상 대결에선 차이가 거의 없었고 이낙연 후보가 홍준표 후보와 맞붙을 경우에도 두 후보 지지율은 오차 범위 이내였습니다.",
                "sound_type": [
                    2
