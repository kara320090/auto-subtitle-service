    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "50대 이상",
                "gender": "남성"
            },
            {
                "speaker_id": "2",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 한편 국민의 힘 윤석열 후보는 대전 유세를 마치고 현재 오늘 유세의 종착지인 서울로 이동 중인 것으로 전해졌는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.494
            },
            {
                "speaker_id": "1",
                "transcription": "계속해서 윤 후보를 취재 중인 기자를 연결해 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.504,
                "end": 10.940
            },
            {
                "speaker_id": "1",
                "transcription": "자 강병수 기자 지금 있는 곳이 어딘가요?",
                "sound_type": [
                    2
                ],
                "start": 10.952,
                "end": 13.780
            },
            {
                "speaker_id": "1",
                "transcription": "아직 대전입니까?",
                "sound_type": [
                    2
                ],
                "start": 13.780,
                "end": 16.520
            },
            {
                "speaker_id": "2",
                "transcription": "네 저는 지금 대전 유성구에 나와 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.530,
                "end": 19.820
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 후보는 조금 전 이곳에서 유세를 마치고 지금은 오늘 유세의 종착지인 서울로 향하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.930,
                "end": 26.450
            },
            {
                "speaker_id": "2",
                "transcription": "윤 후보는 오늘 제주에서 시작해 부산 대구 대전 등 경부선 거점 도시를 차례로 찾아 한 표를 호소했는데요.",
                "sound_type": [
                    2
                ],
                "start": 26.450,
                "end": 34.034
            },
            {
                "speaker_id": "2",
                "transcription": "특히 정권 교체를 강조하는데 중점을 뒀습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.044,
                "end": 37.630
            },
            {
                "speaker_id": "2",
                "transcription": "자신은 여의도의 문법도 셈법도 모르지만 국민이 불러서 이 자리에까지 서게 됐다며 민주당을 향해 시대착오적인 운동권 이념에 빠져 국민보다는 정파 이익만 따진다는 메시지를 내놓았습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 37.620,
                "end": 50.850
            },
            {
                "speaker_id": "2",
                "transcription": "이곳 대전에서도 자신은 충청의 아들이라는 점을 내세우며 이재명 후보를 향해 부패의 몸통이라고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.850,
                "end": 58.442
            },
            {
                "speaker_id": "2",
                "transcription": "또 이번 선거에서 심판을 준다면 민주당도 살릴 수 있다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 58.452,
                "end": 62.380
            },
            {
                "speaker_id": "2",
                "transcription": "민주당의 상식 있는 사람들과 함께 협치의 정치를 해 나가겠다고 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 62.370,
                "end": 67.611
            },
            {
                "speaker_id": "2",
                "transcription": "윤 후보는 이제 서울로 이동해 시청 광장에서 오늘의 마지막 유세를 이어갑니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 67.620,
                "end": 72.590
            },
            {
                "speaker_id": "2",
                "transcription": "이후 마지막으로 건대 입구와 강남을 찾아 마지막까지 한 표를 호소할 예정입니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 72.590,
                "end": 78.484
            },
            {
                "speaker_id": "2",
                "transcription": "지금까지 대전에서 KBS 뉴스 강병수입니다.",
                "sound_type": [
                    2
                ],
                "start": 78.490,
                "end": 82.048
            }
        ]
    },
    "summary": "윤 후보는 경부선 거점 도시를 차례로 찾아 한 표를 호소하며 정권 교체를 강조했고 민주당의 상식 있는 사람들과 함께 협치의 정치를 하겠다고도 했으며 윤 후보는 이제 서울로 이동해 시청 광장부터 마지막으로 건대 입구와 강남을 찾아 마지막까지 한 표를 호소할 예정이다.",
