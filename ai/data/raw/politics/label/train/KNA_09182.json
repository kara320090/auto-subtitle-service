                "end": 6.044
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령도 국무회의에서 국익을 강조했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.054,
                "end": 9.881
            },
            {
                "speaker_id": "2",
                "transcription": "국익 앞에 여야가 없습니다.",
