        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "강경화 외교부 장관과 폼페이오 미국 국무 장관이 현지 시간 내일 미국 샌프란시스코에서 한미 외교 장관 회담을 갖습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.058
            },
            {
                "speaker_id": "1",
                "transcription": "한미 외교 장관 회담은 지난해 3월 미국에서 열린 이후 9개월 만입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.068,
                "end": 13.413
            },
            {
                "speaker_id": "1",
                "transcription": "미국과 이란의 갈등이 이어지는 상황에서 미국이 주도하는 호르무주 해 호위 연합체 동참이 먼저 회의 테이블에 오를 것으로 전망됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.423,
                "end": 22.824
            },
            {
                "speaker_id": "1",
                "transcription": "미국의 동참 압박이 예상되지만 청해부대 독자 파견 등 다양한 방안을 검토 중인 정부는 일단 미국 생각을 직접 들어보겠다는 입장입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.834,
                "end": 33.136
            },
            {
                "speaker_id": "2",
                "transcription": "우리가 검토하는 내용 또 미치게 지금의 에 생각 좀 들어보고 어 정부의 결정은 결정하는 대로 또 이번에 가서 나눈 얘기가 참고가 되겠죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.146,
                "end": 46.145
            },
            {
                "speaker_id": "1",
                "transcription": "중단된 북미 대화 재계 방안과 방위비 분담금 협상 등도 다뤄질 전망입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.155,
                "end": 51.695
            },
            {
                "speaker_id": "1",
                "transcription": "한미일 외교부 장관 회담과 한일 외교 장관 회담도 열릴 예정이어서 한반도 정세와 한일 관계 현안도 논의될 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.705,
                "end": 60.495
            },
            {
                "speaker_id": "1",
                "transcription": "이와 별도로 현지 시간 내일부터 이틀동안 미국 워싱턴에서는 방위비 분담금 협상이 진행됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.505,
                "end": 67.424
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 방위비 분담 협상 대사는 그동안 5차례 협상에서 일정한 진전이 있었다며 조속한 협상 타결을 위해 노력하겠다고 밝혔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 67.434,
                "end": 76.538
            },
            {
                "speaker_id": "3",
                "transcription": "협정의 공백을 최소화하면서 한미 동맹과 연합 방위 태세 에 강화에 기여할 수 있도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 76.548,
                "end": 85.541
            },
            {
                "speaker_id": "1",
                "transcription": "협상팀은 기존 협정의 틀을 유지하면서 무기 구매 등 직 간접적으로 한미 동맹에 기여한 부분에 대한 정당한 평가를 요구할 방침입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 85.551,
                "end": 94.952
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 94.962,
                "end": 97.597
            }
        ]
    },
    "summary": "강경화 외교부 장관과 폼페이오 미국 국무 장관이 현지 시간 내일 미국 샌프란시스코에서 한미 외교 장관 회담을 갖고 현지 시간 내일부터 이틀동안 미국 워싱턴에서는 방위비 분담금 협상이 진행된다.",
