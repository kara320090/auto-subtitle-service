        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "더불어민주당이 소속 의원 169명 명의로 박진 외교부 장관 해임 건의안을 당론 발의했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.779
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령의 순방 외교가 성과 없이 외교적 참사로 끝난 데 대해 주무부처 장관으로서 책임을 져야 한다는 취지입니다.",
                "sound_type": [
                    2
                ],
                "start": 6.789,
                "end": 15.169
            },
            {
                "speaker_id": "2",
                "transcription": "박진 외교부 장관과 대통령실 외교 안보 책임 라인에 제대로 된 책임을 묻지 않는다면 그간 대한민국이 쌓아 올린 외교 성과는 모래성처럼 쓰러질 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 15.179,
                "end": 27.384
            },
            {
                "speaker_id": "1",
                "transcription": "민주당은 모레 본회의에서 건의안을 표결 처리한다는 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 27.394,
                "end": 31.873
            },
            {
                "speaker_id": "1",
                "transcription": "국무 위원 해임 건의안은 재적 3분의 1 이상 발의하고 과반 찬성이 있으면 가결됩니다.",
                "sound_type": [
                    2
                ],
                "start": 31.883,
                "end": 38.030
            },
            {
                "speaker_id": "1",
                "transcription": "169석을 가진 민주당 단독 처리가 가능하지만 국회를 통과해도 대통령이 거부권을 행사할 수 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.040,
                "end": 45.519
            },
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 국익을 훼손한 주최는 민주당이라며 해임 건의안 제출은 국정 방해용 발목 꺾기에 불과하다고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.529,
                "end": 54.095
            },
            {
                "speaker_id": "1",
                "transcription": "민주당에는 건의안 철회를 요구하면서 국회 의장 면담 등을 통해 본회의 상정 저지에도 나설 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 54.105,
                "end": 61.108
            },
            {
                "speaker_id": "3",
                "transcription": "아 국회에서 절대다수 의석을 차지한 민주당은 걸핏하면 국무 위원들에 대한 탄핵 해임을 조자룡 헌 칼 쓰듯 꺼내고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 61.118,
                "end": 70.860
            },
            {
                "speaker_id": "3",
                "transcription": "발목 잡기를 넘어선 협박에 가까운 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 70.870,
                "end": 75.208
            }
        ]
    },
    "summary": "더불어민주당이 소속 의원들의 명의로 박진 외교부 장관 해임 건의안을 당론 발의했으며 본회의에서 자적 3분의 1 이상이 발의하고 과반 찬성이 있으면 가결되는데 이는 국회를 통과해도 대통령이 거부권을 행사할 수 있다.",
