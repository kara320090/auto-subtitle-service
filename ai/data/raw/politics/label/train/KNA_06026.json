        "term": [
            {
                "speaker_id": "1",
                "transcription": "후보들이 공약한 만큼의 물량이 과연 가능한가?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.323
            },
            {
                "speaker_id": "1",
                "transcription": "현실은 의문을 갖게 하는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 3.333,
                "end": 5.455
            },
            {
                "speaker_id": "2",
                "transcription": "적정 부지 확보가 가장 어려운 거고요.",
                "sound_type": [
                    2
                ],
                "start": 5.465,
                "end": 8.454
            },
            {
                "speaker_id": "2",
                "transcription": "그 부지 확보를 하더라도 실제 공급하는 단계에서 비용에 대한 부분 이 부분이 사실은 계속 근본으 남는",
