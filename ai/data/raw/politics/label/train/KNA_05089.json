        "term": [
            {
                "speaker_id": "1",
                "transcription": "취약계층 대다수는 1인 가구.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.341
            },
            {
                "speaker_id": "1",
                "transcription": "이들의 생계 급여는 4만 원 올라 한 달에 62만 원입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.351,
                "end": 6.259
            },
            {
                "speaker_id": "1",
                "transcription": "4인 가구는 162만 원을 받는데 이마저도 가구별 버는 월 소득을 뺀 뒤 차액을 지원합니다.",
                "sound_type": [
                    2
                ],
                "start": 6.269,
                "end": 13.457
            },
            {
                "speaker_id": "1",
                "transcription": "소득 인정액을 따질 때는 월급뿐 아니라 재산까지 소득으로 환산하기 때문에 사실상 가족 누구도 일하지 않아야 생계 급여를 받을 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.467,
                "end": 22.233
            },
            {
                "speaker_id": "2",
                "transcription": "현재 물가 상승률 그리고 코로나 이후에 생계의 위협을 겪고 있는 취약계층.",
                "sound_type": [
                    2
                ],
                "start": 22.243,
                "end": 28.678
            },
            {
                "speaker_id": "2",
                "transcription": "이분들의 일상성을 유지하는 데 충분하냐라고 한다면 그것은 전혀 그렇지 않다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 28.688,
                "end": 35.665
            },
            {
                "speaker_id": "1",
                "transcription": "기초생활 수급 심사에서 탈락한 뒤 지난 4월 사망 한 달 만에 발견된 서울 창신동 모자.",
                "sound_type": [
                    2
                ],
                "start": 35.675,
                "end": 41.630
            },
            {
                "speaker_id": "1",
                "transcription": "비극이 되풀이되지 않으려면 복지 기준선을 결정할 때 좀 더 꼼꼼하게 들여다봐야 합니다.",
                "sound_type": [
                    2
                ],
                "start": 41.640,
                "end": 47.224
            },
            {
