        "term": [
            {
                "speaker_id": "1",
                "transcription": "공정 거래 위원회가 운영하는 소셜 미디어 인스타그램의 계정입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.091
            },
            {
                "speaker_id": "1",
                "transcription": "공정위는 지난 4월 이 계정을 구독하고 글을 올리면 추첨을 통해 경품을 주는 행사를 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.101,
                "end": 10.599
            },
            {
                "speaker_id": "1",
                "transcription": "당첨자들에겐 이름과 전화번호를 전송하라고 안내했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.609,
                "end": 14.918
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이는 개인 정보 보호법 위반입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.928,
                "end": 18.388
            },
            {
                "speaker_id": "1",
                "transcription": "개인 정보를 수집하려면 수집 목적과 항목 보유 기간 동의 거부권 등을 알려야 합니다.",
                "sound_type": [
                    2
