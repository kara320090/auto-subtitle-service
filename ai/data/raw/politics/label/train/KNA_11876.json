        "term": [
            {
                "speaker_id": "1",
                "transcription": "아직 영향이 제한적이지만 신종 코로나 바이러스가 조기에 종식되지 않으면 경기 하방 압력으로 작용할 것이다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.185
            },
            {
                "speaker_id": "1",
                "transcription": "홍남기 경제부총리가 처음으로 부정적인 영향에 대한 우려를 언급했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.195,
                "end": 12.356
            },
            {
                "speaker_id": "1",
                "transcription": "아직은 영향이 제한적이라는 단서를 달긴 했지만 중국 경제 성장이 둔화될 가능성이 높고 우리도 영향을 피해갈 수 없기 때문입니다.",
                "sound_type": [
                    2
                ],
                "start": 12.366,
                "end": 22.123
            },
            {
                "speaker_id": "1",
                "transcription": "과거 사스 발병 때에도 우리 관광객과 수출이 줄고 내수가 위축됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.133,
                "end": 27.997
            },
            {
                "speaker_id": "1",
                "transcription": "사스 때보다 중국에 대한 우리 경제의 의존도가 높아졌기 때문에 중국의 경기 둔화는 악재라고 홍 부총리는 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.007,
                "end": 36.302
            }
        ]
    },
    "summary": "홍남기 경제부총리는 신종 코로나 바이러스가 조기에 종식되지 않으면 경기 하방 압력으로 작용할 것이라며 처음으로 부정적인 영향에 대한 우려를 언급했다.",
