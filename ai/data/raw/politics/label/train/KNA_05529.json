        "term": [
            {
                "speaker_id": "1",
                "transcription": "거짓말로 해코지해도 되는 면허증이라도 가진 것처럼 행동하는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.402
            },
            {
                "speaker_id": "1",
                "transcription": "책임을 안 지니까 자기는 그래도 되는 줄 알고",
                "sound_type": [
                    2
                ],
                "start": 5.412,
                "end": 9.139
            },
            {
                "speaker_id": "2",
                "transcription": "술자리 주선자로 지목된 인물도 회견을 자청해 억울함을 주장했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.149,
                "end": 14.535
            },
            {
                "speaker_id": "3",
                "transcription": "저는 한동훈이라는 사람을 1000미터 만 미터 안에서도 본 적이 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.545,
                "end": 18.755
            },
            {
                "speaker_id": "3",
                "transcription": "장관께서도 뭐 장관직을 걸고 저는 하늘을 걸고라도 맹세합니다.",
                "sound_type": [
                    2,
