        "term": [
            {
                "speaker_id": "1",
                "transcription": "사법 시스템을 악용하는 아이들에게는 보호 처분이라는 문이 아니라 형사 처벌이라는 문을 열어 두자.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.309
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 우리 소년법에서는 그렇게 열어 두더라도 여러 가지의 보호 장치가 있어요.",
                "sound_type": [
