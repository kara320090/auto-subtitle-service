        "term": [
            {
                "speaker_id": "1",
                "transcription": "국민의힘은 경찰 수사가 먼저라며 정부 책임론 차단에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.356
            },
            {
                "speaker_id": "1",
                "transcription": "윤 대통령이 모든 노력을 혼신의 힘을 다하고 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.366,
                "end": 9.647
            },
            {
                "speaker_id": "1",
                "transcription": "국정조사를 요구하는 민주당을 향해선 재난을 정치화하고 있다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.657,
                "end": 14.698
            },
            {
                "speaker_id": "2",
                "transcription": "국정조사나 특검은 경찰의 수사가 미진하거나 국민적 의혹이 남아있다면 그때 가서 논의하는 것이 순서입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.708,
                "end": 25.790
            },
            {
                "speaker_id": "1",
                "transcription": "국회는 오늘 이상민 행안부 장관과 윤희근 경찰청장 오세훈 서울시장과 박희영 용산구청장 등을 불러 이태원 참사 현안 질의를 열 예정입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.800,
                "end": 36.536
            }
        ]
    },
    "summary": "국민의힘은 경찰 수사가 먼저라며 정부 책임론 차단에 나섰으며 국정조사를 요구하는 민주당을 향해선 재난을 정치화하고 있다고 했고 국회는 오늘 이상민 행안부 장관과 윤희근 경찰청장 오세훈 서울시장과 박희영 용산구청장 등을 불러 이태원 참사 현안 질의를 열 예정이다.",
