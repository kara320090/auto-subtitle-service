        "term": [
            {
                "speaker_id": "1",
                "transcription": "또한 누가 이렇게까지 노골적으로 표적 감사를 주문한 것인지.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.022
            },
            {
                "speaker_id": "2",
                "transcription": "논란은 국회로도 이어졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.032,
                "end": 6.938
            },
            {
                "speaker_id": "2",
                "transcription": "야당의 공세에 국민의 임은 어느 정권이든 부정과 부패가 발견됐다면 감사는 당연하다고 반박했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.948,
                "end": 14.393
            },
            {
                "speaker_id": "2",
                "transcription": "이 과정에서 최재희 감사원장의 이런 발언이 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.403,
                "end": 18.768
            },
            {
                "speaker_id": "3",
                "transcription": "감사원은 대통령이 국정 운영을 지원한 기관입니까 아닙니까.",
                "sound_type": [
                    2
                ],
