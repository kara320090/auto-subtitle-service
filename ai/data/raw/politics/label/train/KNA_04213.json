        "term": [
            {
                "speaker_id": "1",
                "transcription": "하 하는 방향으로 안을 마련토록 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.220
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 후보들 간 물밑 신경전은 계속됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.230,
                "end": 8.360
            },
            {
                "speaker_id": "2",
                "transcription": "이낙연 후보는 이재명 후보를 향해 경기지사직 유지는 양심의 문제라고 했고 김두관 후보는 이재명 후보가 경선 승리하면 원팀을 장담 못 한다는 이낙연 캠프 측 발언을 당이 조치해야 한다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.370,
                "end": 23.273
            },
            {
                "speaker_id": "2",
                "transcription": "이런 가운데 추미애 후보는 대선 승리를 위해 열린민주당과 통합해야 한다고 했고 이재명 후보는 적극 환영했습니다.",
