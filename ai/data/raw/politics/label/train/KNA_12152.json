        "term": [
            {
                "speaker_id": "1",
                "transcription": "불요불급한 목적의 외국인 입국 제한을 확대하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.889
            },
            {
                "speaker_id": "2",
                "transcription": "한국을 방문하는 외국인에 대한 특별입국절차 2주 간 격리 의무화에 이은 세 번째 조치입니다.",
                "sound_type": [
                    2
                ],
                "start": 5.899,
                "end": 12.485
            },
            {
                "speaker_id": "2",
                "transcription": "비자 발급을 통한 입국은 계속 열려있어 개방성 기조는 계속 유지하되 외국으로부터의 코로나19 유입을 최소화하기 위한 방안이라고 정부는 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.495,
                "end": 22.169
            },
            {
                "speaker_id": "3",
                "transcription": "부처들의 의견들을 좀 더 모으고 지혜가 필요한 대목들이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.179,
                "end": 27.773
            },
            {
                "speaker_id": "3",
                "transcription": "또 국민 여러분꼐서도 어떻게 생각하시는지에 대해서도 좀 더 귀 기울여서 살펴보고",
                "sound_type": [
