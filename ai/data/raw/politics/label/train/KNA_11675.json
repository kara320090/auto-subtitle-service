        "term": [
            {
                "speaker_id": "1",
                "transcription": "국토교통부가 수서 고속철 SRT 노선을 추가합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.099
            },
            {
                "speaker_id": "1",
                "transcription": "경전선과 전라선 동해선으로 오는 9월 개통이 목표입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.109,
                "end": 8.765
            },
            {
                "speaker_id": "1",
                "transcription": "이에 따라 경북 포항 경남 창원 전남 여수 등에서도 서울 수서역을 오갈 수 있게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 8.775,
                "end": 15.801
            },
            {
                "speaker_id": "1",
                "transcription": "3개 노선에선 하루 4번씩 운행이 예정돼 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.811,
                "end": 19.951
            },
            {
                "speaker_id": "1",
                "transcription": "선로 용량과 차량 지역 형평성을 고려해 이같이 결정했다고 국토부는 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.961,
                "end": 26.332
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 SRT는 경부선과 호남선만 운행해 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.342,
                "end": 30.772
            },
            {
                "speaker_id": "1",
                "transcription": "이 때문에 경남 창원과 경북 포항 전남 여수 등 남부 지역에서는 동대구역이나 익산역에서 환승하거나 서울역에 도착해 강남 지역까지 다른 교통수단을 이용해야 했다고 국토부는 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.782,
                "end": 44.244
            }
        ]
