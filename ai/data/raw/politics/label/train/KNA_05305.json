        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 대통령은 신당역 역무원 스토킹 살인사건 보도가 우리 국민들에게 큰 충격을 주고 있다고 말했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.585
            },
            {
                "speaker_id": "1",
                "transcription": "지난해부터 시행 중인 스토킹 처벌법이 피해자 보호에는 미흡했다는 지적이 많았다며 올해 순방길에 오르기 전 제도 보완을 지시하겠다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.595,
                "end": 16.683
            },
            {
                "speaker_id": "2",
                "transcription": "법무부로 하여금 에 이 제도를 더 보완해서 이렇게 범죄가 발 붙일 수 없게 피해자 보호에 만전을 기하도록 이렇게 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.693,
                "end": 29.202
            },
            {
                "speaker_id": "1",
                "transcription": "이에 법무부는 피해자가 원하지 않으면 처벌을 할 수 없도록 한 현행 반의사불벌조항 폐지를 추진하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.212,
                "end": 36.651
            },
            {
                "speaker_id": "1",
                "transcription": "국회에는 추모 공간이 설치됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.661,
                "end": 39.222
            },
            {
                "speaker_id": "1",
                "transcription": "추모 묵념으로 시작된 여성가족위원회 전체 회의에서 여야는 한 목소리로 정부를 질타했습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.232,
                "end": 46.497
            },
            {
                "speaker_id": "3",
                "transcription": "장관께선 다녀오지도 않으시고 이제 가시겠다고 하고 제일 먼저 가서 갔어야 되는 게 아닌가요.",
                "sound_type": [
                    2
                ],
                "start": 46.507,
                "end": 53.493
            },
            {
                "speaker_id": "4",
                "transcription": "저는 여가부가 폐지 위험에 놓인 이유가 바로 그런 거라고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 53.503,
                "end": 58.461
            },
            {
                "speaker_id": "4",
                "transcription": "다른 기관에서 통보하기 전까지는 모르고",
                "sound_type": [
                    2
                ],
                "start": 58.471,
                "end": 61.261
            },
            {
                "speaker_id": "5",
                "transcription": "여성가족부 장관에게 책무는 굉장히 많지만 할 수 있는 권한은 굉장히 제한된 부분 이런 거에 대해 서 제가 굉장히 뼈저리게 느끼고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 61.271,
                "end": 69.037
            },
            {
                "speaker_id": "1",
                "transcription": "지난 4월 발의된 스토킹 피해자 보호 법안도 뒤늦게 심사가 이뤄졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 69.047,
                "end": 74.151
            },
            {
                "speaker_id": "1",
                "transcription": "스토킹 범죄 예방과 피해자 보호를 국가의 책무로 규정하고 실태 조사와 예방 교육을 실시한다는 내용을 담았습니다.",
                "sound_type": [
                    2
                ],
                "start": 74.161,
                "end": 83.021
            },
            {
                "speaker_id": "1",
                "transcription": "또 피해자가 직장 등에서 불이익을 당하지 않도록 하고 지원 시설도 설치하도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 83.031,
                "end": 88.644
            },
            {
                "speaker_id": "1",
                "transcription": "국회는 정부안과 국회 발의안을 병합 심사해 제정안를 도출할 것으로 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 88.654,
                "end": 94.472
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름입니다.",
                "sound_type": [
                    2
                ],
                "start": 94.482,
                "end": 96.796
            }
        ]
    },
    "summary": "지난 4월 발의된 스토킹 피해자 보호 법안도 뒤늦게 심사가 이뤄졌다.",
