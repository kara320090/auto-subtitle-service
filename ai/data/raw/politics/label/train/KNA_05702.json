                ],
                "start": 0.000,
                "end": 7.805
            },
            {
                "speaker_id": "1",
                "transcription": "특수본 측은 앞서 행안부 재난 안전 상황 실장과 서울시 공무원 등을 참고인 조사한 것도 장관의 책임 여부를 가리는 일과 맞닿아 있다고 설명했습니다.",
                "sound_type": [
