                "start": 7.815,
                "end": 17.697
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 용산경찰서 경비과장과 112 상황실 직원 용산소방서 용산구청 직원 등이 조사를 받았습니다.",
                "sound_type": [
                    2
                ],
