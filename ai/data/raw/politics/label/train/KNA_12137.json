        "term": [
            {
                "speaker_id": "1",
                "transcription": "4년 전 강남 3구 8석 중 3석을 확보했지만 여전히 호락호락하지 않은 지역 종부세에 대해선 정부 방침과 결이 다른 발언도 나왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.954
            },
            {
                "speaker_id": "2",
                "transcription": "종부세 재건축과 관련해서 민원들을 조화를 이루고 적절한 균형을 취할 수 있는 그런 지혜를 발휘해 보겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.964,
                "end": 21.219
            },
            {
                "speaker_id": "1",
                "transcription": "통합당을 향한 공세는 더 강도 높아졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.229,
                "end": 25.237
            },
            {
                "speaker_id": "3",
                "transcription": "소설 돈키호테가 생각이 납니다.",
                "sound_type": [
                    2
                ],
                "start": 25.247,
                "end": 27.706
            },
            {
                "speaker_id": "3",
                "transcription": "황교안 애마를 타고 박형준 시종을 앞에 데리고",
                "sound_type": [
                    2
                ],
                "start": 27.716,
                "end": 34.456
            },
            {
                "speaker_id": "1",
                "transcription": "임종석 전 대통령 비서실장은 전남을 찾아 호남 지지세 굳히기에 나섰습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.466,
                "end": 40.407
            }
        ]
    },
