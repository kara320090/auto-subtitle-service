        "term": [
            {
                "speaker_id": "1",
                "transcription": "현 청와대가 용산 집무실 이전 계획에 제동을 걸자 국민의힘 즉각 반발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.452
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인의 측근인 권성동 의원은 대선 불복이라고 표현했습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.462,
                "end": 10.819
            },
            {
                "speaker_id": "1",
                "transcription": "민주당이 새 정부의 힘을 빼려 하고 있고 청와대기 부화뇌동한다까지 주장했습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.829,
                "end": 16.684
            },
            {
                "speaker_id": "1",
                "transcription": "이명박 전 대통령 취임 첫해 광우병 촛불 시위에 빗댄 지적도 나왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.694,
                "end": 22.420
            },
            {
                "speaker_id": "1",
                "transcription": "민주당이 집무실 이전에 1조 원이 든다고 주장한 건 근거 없는 선동이라는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 22.430,
                "end": 28.084
            },
            {
                "speaker_id": "2",
                "transcription": "몽니를 부리는 것은 가짜뉴스로 국민을 기만했던 광우병 소동의 추억을 되살리려는 어리석은 행동입니다.",
                "sound_type": [
                    2
                ],
                "start": 28.094,
                "end": 37.170
            }
        ]
    },
