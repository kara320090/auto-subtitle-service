        "term": [
            {
                "speaker_id": "1",
                "transcription": "시민 참여단의 날카로운 질문도 쏟아졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.052
            },
            {
                "speaker_id": "2",
                "transcription": "제가 스페인에서 살다 왔는데 스페인도 중대 선거구제를 하고 있었어요.",
                "sound_type": [
                    2
                ],
                "start": 3.062,
                "end": 8.939
            },
            {
                "speaker_id": "2",
                "transcription": "사실상 양당제를 유지하고 있고",
                "sound_type": [
                    2
                ],
                "start": 8.949,
                "end": 11.696
            },
            {
                "speaker_id": "3",
                "transcription": "스튜디오가 술렁거렸거든요.",
                "sound_type": [
                    2
                ],
                "start": 11.706,
                "end": 13.296
            },
            {
                "speaker_id": "3",
                "transcription": "교수님들이 엄청 지금 당황하고 계세요.",
                "sound_type": [
                    2
                ],
                "start": 13.306,
                "end": 15.870
            },
            {
                "speaker_id": "4",
                "transcription": "제도를 어떻게 설계하느냐에 따라서 이 중대 선거구제의 효과가 양당제를 어 줄이는 데 도움이 될 것인지 아닌지 좀 달려있",
                "sound_type": [
                    2
                ],
                "start": 15.880,
                "end": 25.300
            },
            {
                "speaker_id": "1",
                "transcription": "시민 참여단은 일주일 뒤인 오는 13일엔 비례 대표 국회 의원 선출 방식 등을 집중 논의할 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 25.310,
                "end": 32.543
            },
            {
                "speaker_id": "1",
                "transcription": "이후 500명의 시민이 원하는 선거 제도 개편 방향을 발표합니다.",
                "sound_type": [
                    2
                ],
                "start": 32.553,
