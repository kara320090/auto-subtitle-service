        "term": [
            {
                "speaker_id": "1",
                "transcription": "피해 학생과 가해 학생이 분리도 안되고 오히려 피해 학생이 치유할 수 있는 기회도 상실하고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.687
            },
            {
                "speaker_id": "2",
                "transcription": "정 변호사 아들이 학폭 전력에도 서울 유명 국립대에 진학한 일도 쟁점이 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.697,
                "end": 12.069
            },
            {
                "speaker_id": "3",
                "transcription": "정시에는 대학마다 학생부 반영 여부를 좀 자율적으로 결정하도록 돼있고 어떻게 하면 실효적으로 적용이 될 수 있을지 고민을 해보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.079,
                "end": 22.227
            },
            {
                "speaker_id": "2",
                "transcription": "윤석열 대통령도 교육부에 학폭 근절 대책을 조속히 보고할 것을 지시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.237,
                "end": 27.657
            },
            {
                "speaker_id": "4",
                "transcription": "교육 현장에도 학생 학부모 교사",
                "sound_type": [
