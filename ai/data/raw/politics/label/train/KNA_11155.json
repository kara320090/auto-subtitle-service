        "term": [
            {
                "speaker_id": "1",
                "transcription": "올해 초 활동을 마친 대통령 직속 청와대 관리 활용 자문단은 미술품 전시보다는 보존과 관리에 방점을 찍었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.915
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 정부는 청와대를 사적이나 국가 등록 문화재로 정하는 방안은 고려하지 않고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.925,
                "end": 16.100
            },
            {
                "speaker_id": "2",
                "transcription": "그걸 얘기하는 분들은 이용을 활용을 제한하겠다는 접근이거든요.",
                "sound_type": [
                    2
                ],
                "start": 16.110,
                "end": 21.316
            },
            {
                "speaker_id": "2",
                "transcription": "한마디로 그냥 함부로 손대지 마.",
                "sound_type": [
                    2
                ],
                "start": 21.326,
                "end": 23.157
            },
            {
                "speaker_id": "2",
                "transcription": "이 말 이 말로만 들리거든요.",
                "sound_type": [
                    2
                ],
                "start": 23.167,
                "end": 25.526
            },
            {
                "speaker_id": "1",
                "transcription": "청와대 곳곳에선 고려와 조선 시대 기왓장 등 유물이 발견되기도 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.536,
                "end": 31.101
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 정밀 지표 조사를 실시하는 등 청와대 관리를 강화하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.111,
                "end": 36.364
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
