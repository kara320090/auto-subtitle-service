        "term": [
            {
                "speaker_id": "1",
                "transcription": "인근 부동산 관계자는 당시 입주권을 여러 개 확보해 거래한 조합장도 있었다고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.516
            },
            {
                "speaker_id": "2",
                "transcription": "옛날에 두 개를 받는다 했잖아.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.526,
                "end": 9.253
            },
            {
                "speaker_id": "2",
                "transcription": "조합장은 두 개를 못 하거든 하나는 다른 걸 해놓은.",
                "sound_type": [
                    2
                ],
                "start": 9.263,
                "end": 12.948
            },
            {
                "speaker_id": "1",
                "transcription": "조합원당 하나의 입주권이 정상인데 여러 개를 거래했다는 건 이른바 불법 딱지 거래 의심 사례로 볼 수 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.958,
                "end": 21.201
            },
            {
                "speaker_id": "1",
                "transcription": "취재진이 당시 조합원 앞으로 근저당을 설정한 뒤 전매 금지가 풀릴 즈음 아파트 소유권이 바뀐 사례를 추려봤더니 전체 347세대 중 11건이 확인됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.211,
                "end": 33.533
            }
        ]
    },
    "summary": "당시 전매 금지가 풀릴 즈음 아파트 소유권이 바뀐 사례를 확인한 결과, 전체 347세대 중 11건이 확인되었다.",
