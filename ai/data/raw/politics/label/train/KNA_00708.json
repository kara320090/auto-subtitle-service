        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그리고 인사 청문회를 앞두고 있는 한덕수 총리 후보자 소식도 좀 살펴보면 한 후보자가 내정 직전까지 김앤장 법률 사무소 고문으로 일하면서 고액의 연봉을 받은 사실이 지금 논란이 되고 있다면서요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.476
            },
            {
                "speaker_id": "2",
                "transcription": "한덕수 후보자 2017년 말부터 김앤장에서 고문으로 재직하면서 매년 수억 원대의 연봉을 받아서 논란이 되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.486,
                "end": 23.675
            },
            {
                "speaker_id": "2",
                "transcription": "이에 당선인 측은 한 후보자의 고문료가 국민 눈높이에 맞지 않는 부분은 이미 인지하고 있다 이렇게 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.685,
                "end": 31.546
            },
            {
                "speaker_id": "2",
                "transcription": "다만 현재 난국을 타개할 수 있는 적임자로 판단해 내정했다 말했는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.556,
                "end": 37.086
            },
            {
                "speaker_id": "2",
                "transcription": "한 후보자는 오늘 출근길에서 국회 청문회 심의를 기다리고 있는 상황이라며 언론과 국회에 검증 질의 과정에서 숨김없이 모두 설명할 거라고 답했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.096,
                "end": 48.913
            },
            {
                "speaker_id": "2",
                "transcription": "이에 민주당은 법률가도 아닌 전직 고위 관료가 김앤장에서 어떤 역할을 맡았는지 국민은 의아해한다며 공정과 상식의 기준에 맞는지 들여다보겠다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.923,
                "end": 60.781
            },
            {
                "speaker_id": "2",
                "transcription": "반면 국민의힘은 민주당이 문재인 정부의 인사 검증 7대 기준을 검증의 잣대로 삼겠다고 한데 대해서 문재인 정권에서 1차례도 지켜지지 않은 기준이라고 비판했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.791,
                "end": 73.772
            },
            {
                "speaker_id": "2",
                "transcription": "윤 당 윤 당선인 측은 총리 후보자 외 새 정부 내각 인선도 서두르고 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 73.782,
                "end": 79.574
            },
            {
                "speaker_id": "2",
                "transcription": "현재 정부 조직법에 따라 각 부처 장관 인사를 복수로 검토하고 있다고 밝혔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 79.584,
                "end": 85.712
            },
            {
                "speaker_id": "2",
                "transcription": "내각 중 법무장관과 행정안전부 장관은 임기 시작 뒤에 곧바로 지방 선거가 있는 만큼 현역 의원을 지명하는 것이 시빗거리가 될 수 있다는 우려도 있다고 당선인 측은 밝혔습니다.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 85.722,
                "end": 99.766
            }
        ]
    },
    "summary": "법률가도 아닌 한덕수 후보자가 김앤장에서 고문으로 재직한 것이 논란이 되고 있으며 민주당은 전직 고위 관료가 김앤장에서 어떤 역할을 맡았는지 공정과 상식의 기준에서 보겠다고 했고 현재 육 당선인 측은 총리 후보자 외 새 정부 내각 인선을 서두르고 있다.",
