                    2
                ],
                "start": 0.000,
                "end": 9.546
            },
            {
                "speaker_id": "2",
                "transcription": "품에 맞지 않는 행동이라고 저도 판단합니다.",
                "sound_type": [
                    2
                ],
                "start": 9.556,
                "end": 12.195
            },
            {
                "speaker_id": "2",
                "transcription": "사과를 해주시기를 부탁 드리고요.",
                "sound_type": [
                    2
                ],
                "start": 12.205,
                "end": 14.317
            },
            {
                "speaker_id": "3",
                "transcription": "하지만 한 장관은 사과할 사람은 따로 있다며 오늘도 물러서지 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.327,
                "end": 19.828
            },
            {
                "speaker_id": "3",
                "transcription": "저는 같잖은 수를 퍼뜨린 사람 내에서 반드시 끝까지 책임을 묻는 풍토가 정착되어야 한다고 생각.",
                "sound_type": [
