        "term": [
            {
                "speaker_id": "1",
                "transcription": "청와대 이 문화예술 공간은 그 대통령님의 비전과 철학을 바탕으로 출발했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.639
            },
            {
                "speaker_id": "2",
                "transcription": "청와대 관리 책임자인 문화재청장이 전날 부처 간 논의와 준비가 부족했다고 말한 데 대해선 여당에서 질타가 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.649,
                "end": 20.685
            },
            {
                "speaker_id": "3",
                "transcription": "문화재청장님 소통이 잘 안 되고 계십니까?",
                "sound_type": [
                    2
                ],
                "start": 20.695,
                "end": 23.544
            },
            {
                "speaker_id": "4",
                "transcription": "아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 23.554,
                "end": 24.171
            },
            {
                "speaker_id": "3",
                "transcription": "그렇지 않죠?",
                "sound_type": [
                    2
                ],
                "start": 24.181,
                "end": 25.551
            },
            {
                "speaker_id": "3",
                "transcription": "이런 것들로 국민이 우려하게 만드시지 마십시오.",
                "sound_type": [
                    2
                ],
                "start": 25.561,
                "end": 29.089
            },
            {
                "speaker_id": "3",
                "transcription": "왜 부처 내에서 다른 목소리가 나옵니까?",
                "sound_type": [
                    2
                ],
                "start": 29.099,
                "end": 31.590
            },
            {
                "speaker_id": "2",
                "transcription": "한편 박 장관은 옛 청와대 본관을 모형 대신 사진으로 제작하는 방안도 검토하고 있다며 오해가 없도록 하겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.600,
                "end": 40.729
            },
            {
                "speaker_id": "2",
                "transcription": "KBS 뉴스 @이름1입니다.",
                "sound_type": [
