        "term": [
            {
                "speaker_id": "1",
                "transcription": "국립 현충원 참배에 이어 첫 국무회의를 주재한 정세균 총리.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.245
            },
            {
                "speaker_id": "1",
                "transcription": "내각을 향한 첫 주문은 경제 활성화와 민생 안정이었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.255,
                "end": 9.238
            },
            {
                "speaker_id": "1",
                "transcription": "과감한 규제 혁파로 기업하기 좋은 환경을 만들자고 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.248,
                "end": 13.978
            },
            {
                "speaker_id": "1",
                "transcription": "일하는 방식을 바꿔달라 국민과의 소통에 힘써달라고도 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.988,
                "end": 19.061
            },
            {
                "speaker_id": "2",
                "transcription": "저부터 정책 현장을 찾아 국민들의 목소리를 경청하고 국회와 노동계 경제계 등 각계각층의 대표들을 자주 모셔서 고견을 듣겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.071,
                "end": 33.307
            },
            {
                "speaker_id": "1",
                "transcription": "이후 국회를 찾은 정 총리.",
                "sound_type": [
                    2
                ],
                "start": 33.317,
                "end": 35.475
            },
            {
                "speaker_id": "1",
                "transcription": "역시 화두는 협치였습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.485,
                "end": 37.545
            },
            {
                "speaker_id": "2",
                "transcription": "협치를 하지 않고는 한 발짝도 앞으로 나아갈 수 없는 상황이어서 이게 쉬운 과제는 아니지만 다시 한 번 도전해야 되는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.555,
                "end": 49.648
            },
            {
                "speaker_id": "1",
                "transcription": "각 당 지도부도 일제히 협치를 주문했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.658,
                "end": 53.455
            },
            {
                "speaker_id": "3",
                "transcription": "갈등과 분열이 많았던",
                "sound_type": [
                    2
                ],
                "start": 53.465,
                "end": 56.723
            }
        ]
