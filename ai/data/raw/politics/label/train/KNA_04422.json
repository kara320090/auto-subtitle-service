                ],
                "start": 6.144,
                "end": 19.459
            },
            {
                "speaker_id": "1",
                "transcription": "최근 국제 유가 상승으로 인한 국내 기름값 추이도 면밀히 살펴 볼 계획입니다.",
                "sound_type": [
