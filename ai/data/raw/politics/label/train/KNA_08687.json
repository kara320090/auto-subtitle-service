        "term": [
            {
                "speaker_id": "1",
                "transcription": "정치적 의도와 타인의 명예를 훼손한 작품의 속해 있어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.838
            },
            {
                "speaker_id": "2",
                "transcription": "이게 자유의 표현이 문제입니까 아니면은 이 공모전에 계획안에 결격 사항에 대한 게 문제입니까?",
                "sound_type": [
                    2
                ],
                "start": 3.848,
                "end": 11.267
            },
            {
                "speaker_id": "3",
                "transcription": "대통령도 정치 풍자는 당연한 권리라고 했어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.277,
                "end": 14.754
            },
            {
                "speaker_id": "3",
                "transcription": "이 사건은 헌법상 표현의 자유와 관련 있는",
                "sound_type": [
                    2
                ],
                "start": 14.764,
                "end": 19.106
            },
            {
                "speaker_id": "4",
                "transcription": "@이름1 장관은 공모전 주최 측이 사전에 승인받은 내용을 어긴 게 잘못이라며 예술인의 정치 성향을 따져 차별한 블랙리스트 사건과는 성격이 다르다고 했습니다.",
