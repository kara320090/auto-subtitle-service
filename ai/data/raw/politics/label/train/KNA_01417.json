        "term": [
            {
                "speaker_id": "1",
                "transcription": "기업의 혁신 역량 확충으로 경제가 성장하면 일자리가 많아질 테고 따라서 경제 전체에 혜택이 퍼질 거라는 기댑니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.433
            },
            {
                "speaker_id": "2",
                "transcription": "정부는 가능한 정책 수단을 총동원하여 경제 체질 개선을 통한 성장잠재력 재고에도 총력을 기울여 나가겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.443,
                "end": 18.335
            },
            {
                "speaker_id": "1",
                "transcription": "민생안정을 위한 부동산 정책의 큰 그림도 내놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.345,
                "end": 22.040
            },
            {
                "speaker_id": "1",
                "transcription": "우선 세제개편에 초점을 맞춰 부동산 보유세 부담을 낮추기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.040,
                "end": 27.141
            },
            {
                "speaker_id": "1",
                "transcription": "재산세와 종부세 모두 공정시장가의 하향이나 한시적 특별 공제 도입을 통해서 2020년 수준으로 낮추겠다고 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.151,
                "end": 36.756
            },
            {
                "speaker_id": "1",
                "transcription": "복잡한 금융규제도 청년과 생애 최초 주택구매자를 중심으로 LTV DSR 규제를 풀어주는 방식으로 완화하겠다고 했습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 36.766,
                "end": 46.095
            },
            {
                "speaker_id": "1",
                "transcription": "분양가 상한제 개편이나 대규모 공급계획도 이달 안에 발표합니다.",
                "sound_type": [
                    2
                ],
                "start": 46.105,
                "end": 50.594
            },
            {
                "speaker_id": "1",
                "transcription": "과도한 세 부담을 완화하고 공급을 늘리면서 시장 기능을 정상화시키면 안정이 찾아올 거란 기댑니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 50.604,
                "end": 58.749
            },
            {
                "speaker_id": "1",
                "transcription": "정부는 또 현재 최대 화두인 물가안정을 위해서도 생계비 안정과 유통구조 고도화 등에 총력을 다하겠다고 덧붙였습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 58.759,
                "end": 67.897
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 서영민입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 67.907,
                "end": 70.671
            },
            {
                "speaker_id": "3",
                "transcription": "한전이 오늘 3분기 전기요금 인상안을 정부에 제출했습니다.",
                "sound_type": [
                    2
                ],
                "start": 70.681,
                "end": 75.575
            }
        ]
    },
    "summary": "정부는 민생안정을 위한 부동산 정책의 큰 그림을 내놨고 또 현재 최대 화두인 물가안정을 위해서도 생계비 안정과 유통구조 고도화 등에 총력을 다하겠다고 덧붙였다.",
