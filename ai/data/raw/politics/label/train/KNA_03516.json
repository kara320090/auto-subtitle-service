        "term": [
            {
                "speaker_id": "1",
                "transcription": "조사 대상과 시기 등을 놓고 앞으로 치열한 수싸움이 예상됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.789
            },
            {
                "speaker_id": "2",
                "transcription": "어떻게든 시간을 끌고 상황을 모면하려 잔꾀 부리고 꼼수 부리지 마십시오.",
                "sound_type": [
                    2
                ],
                "start": 4.799,
                "end": 12.341
            },
            {
                "speaker_id": "3",
                "transcription": "국민의 어떤 이 허탈과 분노를 오로지 선거에만 이용하려고 하지 않았 않 않는가 하는.",
                "sound_type": [
                    2
                ],
                "start": 12.351,
                "end": 19.060
            },
            {
                "speaker_id": "1",
                "transcription": "한편 오늘 논의 예정이었던 한국토지주택공사법 등 LH 대책 법안들은 국토위 소위가 파행되면서 발이 묶였습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.070,
                "end": 28.260
            },
            {
                "speaker_id": "1",
                "transcription": "KBS 뉴스 이중근입니다.",
