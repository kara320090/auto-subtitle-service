        "term": [
            {
                "speaker_id": "1",
                "transcription": "기소권과 수사권이 이번에는 반드시 분리돼야 한다 라고 하는 그 원칙을 어 강하게 우리가 주장했고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.401
            },
            {
                "speaker_id": "2",
                "transcription": "검찰이 갖고 있는 보완 수사권은 그대로 유지가 되고 그거는 손을 댈 수가 없는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 8.411,
                "end": 13.939
            },
            {
                "speaker_id": "3",
                "transcription": "여기에 특수 수사를 맡는 반부패 강력부도 다섯 개에서 세 개로 줄이기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.949,
                "end": 20.086
            },
            {
                "speaker_id": "3",
                "transcription": "역시 검찰 직접 수사의 총량을 줄여간다는 취지입니다.",
                "sound_type": [
                    2
                ],
                "start": 20.096,
                "end": 23.890
