        "term": [
            {
                "speaker_id": "1",
                "transcription": "다만 이들을 당장 경질하라는 요구에는 선을 그었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.446
            },
            {
                "speaker_id": "2",
                "transcription": "진상 규명이 철저하게 이루어지도록 하고 그 결과에 따 책임있는 사람에 대해서는 엄정히 그 책임을 묻도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.456,
                "end": 17.474
            },
            {
                "speaker_id": "1",
                "transcription": "우선 경질을 하기보단 진상 규명이 먼저라는 기존의 입장을 거듭 밝힌 건데 거세지는 문책 여론에 정치적 부담은 커질 수도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.484,
                "end": 26.384
            },
            {
                "speaker_id": "1",
                "transcription": "한편 윤 대통령 부부는 이번 주 중 한남동 관저에 정식 입주할 것으로 전해졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.394,
                "end": 32.178
            },
            {
                "speaker_id": "1",
                "transcription": "대통령 경호 차장의 휴대 전화 메시지가 국회에서 노출되면서 알려진 건데 정작 대통령실은 보안 사항이라며 공식 확인을 해주지 않았습니다.",
                "sound_type": [
                    2
                ],
