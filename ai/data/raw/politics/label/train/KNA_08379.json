        "term": [
            {
                "speaker_id": "1",
                "transcription": "비대위를 구성하는 것이 오히려 더 안정적이지 않느냐라는 의견도 없지 않았지만 언제 내려질지 모르기 때문에 마냥 공백 상태로 갈 수가 없겠다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.071
            },
            {
                "speaker_id": "2",
                "transcription": "인선은 거의 마무리 단계로 알려졌는데 이르면 내일 발표할 것으로 보입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.081,
                "end": 15.685
            },
            {
                "speaker_id": "2",
                "transcription": "정진석 위원장은 KBS와의 통화에서 지역 안배와 통합에 중점을 뒀다고 설명했습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.695,
                "end": 21.827
            },
            {
                "speaker_id": "2",
                "transcription": "규모는 9명에서 10명 정도 원내외 인사를 두루 포함시킬 계획입니다.",
                "sound_type": [
                    2
                ],
                "start": 21.837,
                "end": 26.823
            },
            {
                "speaker_id": "2",
                "transcription": "지난 법원 가처분 결정을 고려해 주호영 비대위 위원들은 제외하기로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.833,
                "end": 32.565
            }
        ]
    },
