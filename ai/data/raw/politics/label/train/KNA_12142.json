        "term": [
            {
                "speaker_id": "1",
                "transcription": "건강하십시오.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.135
            },
            {
                "speaker_id": "2",
                "transcription": "손을 잡는 대신 주먹 악수를 택하기는 했지만 역시 장갑은 끼지 않았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.145,
                "end": 7.353
            },
            {
                "speaker_id": "2",
                "transcription": "시민들과 이야기를 나누다가 뒤늦게 다시 마스크를 쓰는 모습이 포착되기도 하고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.363,
                "end": 13.035
            },
            {
                "speaker_id": "3",
                "transcription": "반갑습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.045,
                "end": 14.804
            },
            {
                "speaker_id": "3",
                "transcription": "반갑습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.814,
                "end": 16.294
            },
            {
                "speaker_id": "2",
                "transcription": "마스크를 내린 채 시민들에게 다가가기도 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.304,
                "end": 20.103
            },
            {
                "speaker_id": "2",
                "transcription": "어린이 앞에서도 예외가 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.113,
                "end": 22.433
            },
            {
                "speaker_id": "2",
                "transcription": "각 당이 코로나19에 대응해 사람들을 끌어모으는 공연 율동을 자제하는 대신 조용한 유세를 독려하고 있지만 구체적인 사회적 거리 유지 지침은 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.443,
                "end": 33.020
            },
            {
                "speaker_id": "4",
                "transcription": "응원을 하다 보면 마스크 벗고 하시는 분들도 계시더라고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 33.010,
                "end": 37.000
            },
            {
                "speaker_id": "4",
                "transcription": "그러면은 아무래도 더 감염의 위험이 더 크다고 생각해요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 37.000,
                "end": 40.607
            }
        ]
    },
