        "term": [
            {
                "speaker_id": "1",
                "transcription": "당 지도부는 말을 아꼈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.734
            },
            {
                "speaker_id": "2",
                "transcription": "자세한 발언 내용이나 발언 경위 또 전후 사정 등을 지금 파악 중에 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.744,
                "end": 10.477
            },
            {
                "speaker_id": "1",
                "transcription": "논란은 국회 대정부 질문으로도 번졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.487,
                "end": 14.717
            },
            {
                "speaker_id": "3",
                "transcription": "미국 국회는 이 땡땡으로 미국 대통령은 쪽팔려 한 방으로 보내버리셨습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.727,
                "end": 21.579
            },
            {
                "speaker_id": "3",
                "transcription": "총리 어떻게 생각하십니까.",
                "sound_type": [
                    2
                ],
                "start": 21.589,
                "end": 23.347
            },
            {
                "speaker_id": "4",
                "transcription": "아 미국 대통령께 저런 말씀을 드리셨습니까 대통령께서.",
                "sound_type": [
                    2
                ],
                "start": 23.357,
                "end": 27.654
            },
            {
                "speaker_id": "4",
                "transcription": "앞에서 바이든 대통령한테 말씀하셨",
                "sound_type": [
                    2
                ],
                "start": 27.664,
                "end": 30.617
            },
            {
                "speaker_id": "3",
                "transcription": "국민들이 보고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.627,
                "end": 33.133
            }
        ]
    },
