        "term": [
            {
                "speaker_id": "1",
                "transcription": "민주당은 MBC 전용기 배제가 언론 탄압에 단초라며 2000년 남북정상회담 때 사례를 꺼냈습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.013
            },
            {
                "speaker_id": "1",
                "transcription": "당시 북한이 조선일보와 KBS의 입북을 부러워한다고 했지만 김대중 대통령은 양보 없이 이들을 전용기에 태워 보냈다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 8.023,
                "end": 16.973
            },
            {
                "speaker_id": "2",
                "transcription": "취재기자 선별까지 양보하면서 정상회담을 할 필요는 없다.",
                "sound_type": [
                    2
