        "term": [
            {
                "speaker_id": "1",
                "transcription": "윤석열 당선인은 비서실장을 보내 축하 난을 전했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.995
            },
            {
                "speaker_id": "1",
                "transcription": "덕담 속 뼈 있는 말이 오갔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.005,
                "end": 6.845
            },
            {
                "speaker_id": "2",
                "transcription": "아주 좋은 걸로 예 이거 저기 제가 직접 가서 선택을 해서 예 가져왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.855,
                "end": 13.420
            },
            {
                "speaker_id": "2",
                "transcription": "진심을 담아서 축하드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.430,
                "end": 15.340
            },
            {
                "speaker_id": "3",
                "transcription": "인수위는 여야 없기 때문에 힘을 어 합쳐야 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.350,
                "end": 19.581
            },
            {
                "speaker_id": "3",
                "transcription": "그런데 그 출발은 국회를 존중하고 또 소통하는 점이라",
