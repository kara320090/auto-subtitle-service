        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 @이름1 서울경찰청장은 시각이 좀 달랐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.850
            },
            {
                "speaker_id": "1",
                "transcription": "수사가 너무 느리다며 공개 질책을 한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 3.860,
                "end": 7.515
            },
            {
                "speaker_id": "1",
                "transcription": "이준석 대표 사건은 왜 압수수색도 소환조사도 안 하냐.",
                "sound_type": [
                    2
                ],
                "start": 7.525,
                "end": 11.687
            },
            {
                "speaker_id": "1",
                "transcription": "법리 검토는 똑바로 했냐.",
                "sound_type": [
                    2
                ],
                "start": 11.697,
                "end": 13.872
            },
            {
                "speaker_id": "1",
                "transcription": "이런 취지로 수사 책임자를 질책한 것으로 전해졌습니다.",
