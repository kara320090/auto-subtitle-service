        "term": [
            {
                "speaker_id": "1",
                "transcription": "대한민국을 밝히는 길을 향해 뚜벅뚜벅 걸어 나갈 것이라고 대선 도전 의사를 명확히 했습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 6.471
            },
            {
                "speaker_id": "1",
                "transcription": "윤석열 전 검찰 총장의 대안으로 거론되는 데 대해서도 최 전 원장은 자기 자신 자체로 평가받고 싶다고 강조했습니다.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 6.481,
                "end": 14.887
            },
            {
                "speaker_id": "2",
                "transcription": "또 어떤 사람이 잘못된 것이 저의 이익이 되는 그런 방식으로 살아오진 않았고 정치도 역시 그런 생각으로 해 나갈 겁니다.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 14.897,
                "end": 24.924
            },
            {
                "speaker_id": "1",
                "transcription": "윤 전 총장은 선관위의 대선 예비 후보로 등록하면서 공정과 상식이 바로 선 대한민국을 국민과 함께 만들겠다고 밝혔습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.934,
                "end": 33.494
            },
            {
                "speaker_id": "1",
                "transcription": "유승민 전 의원도 등록 뒤 정권을 교체하고 시대의 문제를 해결하는 유능한 대통령이 되겠다고 강조했습니다.",
                "sound_type": [
