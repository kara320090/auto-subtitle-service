        "term": [
            {
                "speaker_id": "1",
                "transcription": "어으 단풍이 이쁘게 물들었네요. 뭐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.528
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 우리 가족이 단풍놀이 하러 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.528,
                "end": 5.103
            },
            {
                "speaker_id": "1",
                "transcription": "어디로 나왔지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.113,
                "end": 5.988
            },
            {
                "speaker_id": "2",
                "transcription": "여기 뭐라고 얘기 해야 돼?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.998,
                "end": 7.980
            },
            {
                "speaker_id": "1",
                "transcription": "여기 집 앞에 와 단풍이 완전 이뻐 단풍이 완전 이뻐 잘 물들었어 여보 여기 내가 이름 붙였어 여기",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.990,
                "end": 19.327
            },
            {
                "speaker_id": "2",
                "transcription": "뭐라고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.337,
                "end": 20.511
            },
            {
                "speaker_id": "1",
                "transcription": "별내 센트럴 파크라고 바람 죽이지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.521,
                "end": 23.336
            },
            {
                "speaker_id": "2",
                "transcription": "어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.346,
                "end": 23.804
            },
            {
                "speaker_id": "1",
                "transcription": "별내를 가로 지르는 가운데 있는 공원 길이야 이 길이 이제 쫙 원래 별내역으로 이어지는 건데 가운데 별내역 앞에 공사가 중단돼 가지고",
                "sound_type": [
                    2,
                    3
                ],
