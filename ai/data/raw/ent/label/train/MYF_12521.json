        "term": [
            {
                "speaker_id": "1",
                "transcription": "문제는 오늘 비 예보가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.838
            },
            {
                "speaker_id": "1",
                "transcription": "빨리 세팅해 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.848,
                "end": 7.909
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하세요 형님들?",
                "sound_type": [
                    2
                ],
                "start": 7.919,
                "end": 9.129
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 인사드립니다.",
                "sound_type": [
                    2
                ],
                "start": 9.139,
                "end": 10.961
            },
            {
                "speaker_id": "1",
                "transcription": "저는 오늘 전남 영암에 미암수로에 나와 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.971,
                "end": 15.016
            },
            {
                "speaker_id": "1",
                "transcription": "최근 굉장히 핫한 소식들 많이 들으셨을 거라고 생각이 되고요.",
                "sound_type": [
                    2
                ],
                "start": 15.026,
                "end": 19.970
            },
            {
                "speaker_id": "1",
                "transcription": "포인트로 한번 이동했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.980,
                "end": 21.475
            },
            {
                "speaker_id": "1",
                "transcription": "지금 캐미를 넣는 중이고 비가 오기 시작했습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.485,
                "end": 25.086
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 캐미 넣는 중간에 이렇게 인사를 드리게 됐고요.",
                "sound_type": [
                    2
                ],
                "start": 25.096,
                "end": 28.988
            },
            {
                "speaker_id": "1",
                "transcription": "한 대씩 캐미 넣어가면서 글루텐 달아서 써 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.998,
                "end": 33.132
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 미끼는 옥수수 글루텐, 지렁이 전부 다 써 볼 거고요.",
                "sound_type": [
                    2
                ],
                "start": 33.142,
                "end": 36.536
            },
            {
                "speaker_id": "1",
                "transcription": "대편성은 총 10대",
                "sound_type": [
                    2
                ],
                "start": 36.546,
                "end": 38.788
            }
        ]
    },
    "summary": "한 남성이 전남 영암에 미암수로에 나와있는데 캐미를 넣는 중에 비가 오기 시작했다고 하며 한 대씩 캐미를 넣어가면서 글루텐 달아서 써 보겠다고 하는데 미끼는 옥수수 글루텐, 지렁이를 써 보겠다고 하며 대편성은 총 10대라고 한다.",
