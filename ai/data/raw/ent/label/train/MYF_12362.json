        "term": [
            {
                "speaker_id": "1",
                "transcription": "조사님들 정말 많이 계셨습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.252
            },
            {
                "speaker_id": "1",
                "transcription": "낚시하기 정말 좋은 계절입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.262,
                "end": 4.264
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이곳 같은 경우는 차를 대고 포인트까지 거리가 멀지 않아서 캠낚도 많이 하시는 그런 포인트입니다.",
                "sound_type": [
                    2
                ],
                "start": 4.274,
                "end": 11.406
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이곳에서 멋진 붕어 만나볼 수 있도록 파이팅 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.416,
                "end": 16.610
            },
            {
                "speaker_id": "1",
                "transcription": "지금 시작합니다.",
                "sound_type": [
                    2
                ],
                "start": 16.620,
                "end": 18.506
            },
            {
                "speaker_id": "1",
                "transcription": "바람 때문에 캐스팅이 굉장히 어려운 그런 상황입니다.",
                "sound_type": [
                    2
                ],
                "start": 18.516,
                "end": 25.951
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 보기에는 바닥이 맹탕 같아 보이는데 안에는 삭은 수초들도 굉장히 많고 깨끗하진 않습니다 바닥이.",
                "sound_type": [
                    2
                ],
                "start": 25.961,
                "end": 32.907
            }
        ]
    },
    "summary": "한 남성이 캠낚도 많이 하는 낚시 포인트에 가서 붕어를 낚으려고 하고 있다.",
