            },
            {
                "speaker_id": "1",
                "transcription": "그걸 가지고 계신 분이 아니실까 그래서 너무 잘 맡기 때문에 오히려 머리 아플 수도 있고 그리고 오이 같은 거는 또 수분이 많잖아요.",
                "sound_type": [
