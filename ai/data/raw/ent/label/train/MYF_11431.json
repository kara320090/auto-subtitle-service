        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "세수도 안 하고 클렌징워터로 닦고 오늘 드라이 샴푸도 처음 써봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.822
            },
            {
                "speaker_id": "1",
                "transcription": "근데 교수님께 그거 뭐 좀 질문한다고 찾아갔다가 같이 점심 먹자고 하셨는데 저희가 마스크 쓰고 다니잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.832,
                "end": 11.062
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 얼굴을 처음 보여드린 거야 이 그지꼴을.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.072,
                "end": 14.264
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도도 아니죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.274,
                "end": 15.392
            },
            {
                "speaker_id": "1",
                "transcription": "더 거지꼴이죠 씻지도 않았는데 막 피부도 안 좋고 머리도 떡져가지구.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.402,
                "end": 20.031
            },
            {
                "speaker_id": "1",
                "transcription": "제가 드라이 샴푸 처음 써보다 보니까 정수리만 하고 이렇게 밑에를 안 했거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.041,
                "end": 24.755
            },
            {
                "speaker_id": "1",
                "transcription": "난 지성인인데 집에 와서 할 꺼 하다가 방금 헬스장 갔다 와서 씻었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.765,
                "end": 29.641
            },
            {
                "speaker_id": "1",
                "transcription": "헬스장 갈 때도 원래 샤워하고 갈까 했는데 너무 귀찮아서 그냥 갔어요 향수 뿌리고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.651,
                "end": 35.480
            }
        ]
    },
    "summary": "한 여성이 교수님께 질문하러 갔다가 점심 먹게 되었는데 처음 얼굴을 보여드렸는데 거지꼴이었다고 말하며 머리도 떡지고 피부도 안 좋았다고 설명하며 처음 드라이 샴푸도 써봐서 지성인인데 정수리만 하고 밑에는 안 했다고 말한다.",
