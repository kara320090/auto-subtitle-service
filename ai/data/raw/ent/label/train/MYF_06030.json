        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 100프로가 아닌 70프로만 받아들이고 나머지 30프로의 다른 가능성을 열어두자고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.837
            },
            {
                "speaker_id": "1",
                "transcription": "좀 내가 우유부단하게 보일 수 있어 하지만 우리는 정답을 내면 사람은 아니야.",
                "sound_type": [
                    2
                ],
                "start": 6.847,
                "end": 13.060
            },
            {
                "speaker_id": "1",
                "transcription": "계속 계속 탐구하고 물음을 던지는 칼끝에 서 있어야 할 예술가야.",
                "sound_type": [
                    2
                ],
                "start": 13.070,
                "end": 18.210
            },
            {
                "speaker_id": "1",
                "transcription": "내 이야기가 많이 지루했지?",
                "sound_type": [
                    2
                ],
                "start": 18.220,
                "end": 20.927
            },
            {
                "speaker_id": "1",
                "transcription": "가만히 들어보면 궤변 같기도 할 것 같아 판단은 친구들한테 맡길게.",
                "sound_type": [
                    2
                ],
                "start": 20.937,
                "end": 26.933
            },
            {
                "speaker_id": "1",
                "transcription": "자 그럼 내 그림 강의는 여기서 끝낼게.",
                "sound_type": [
                    2
                ],
                "start": 26.943,
                "end": 30.742
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 썩 조짐은 좋지 않지만 다음 강의에서 또 만났으면 좋겠다.",
                "sound_type": [
                    2
                ],
                "start": 30.752,
                "end": 36.142
            },
            {
                "speaker_id": "1",
                "transcription": "행복한 하루 보내고 내 강의 들어줘서 고마워. 안녕",
                "sound_type": [
                    2
                ],
                "start": 36.142,
                "end": 40.533
            }
        ]
    },
    "summary": "화자가 우리는 정답을 내면 사람이 아니고 계속 탐구하고 물음을 던지는 예술가라고 말한다.",
