        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분 탑승을 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.775
            },
            {
                "speaker_id": "1",
                "transcription": "안쪽에서는 여러분이 너무 재밌어 할 거 같아서 일단 차주를 같이 모셨어요.",
                "sound_type": [
                    2
                ],
                "start": 1.785,
                "end": 6.216
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2
                ],
                "start": 6.226,
                "end": 7.254
            },
            {
                "speaker_id": "2",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2
                ],
                "start": 7.264,
                "end": 8.045
            },
            {
                "speaker_id": "1",
                "transcription": "누구세요?",
                "sound_type": [
                    2
                ],
                "start": 8.055,
                "end": 8.847
            },
            {
                "speaker_id": "2",
                "transcription": "어 대구에서 살고 있는 스물 아홉 살입니다.",
                "sound_type": [
                    2
                ],
                "start": 8.857,
                "end": 11.629
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 오늘 촬영을 위해서 지금 대구에서 올라오신 건가요?",
                "sound_type": [
