                    2
                ],
                "start": 14.919,
                "end": 16.033
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 진짜 우리 튜닝 끝판왕 콘텐츠는 구독자분들이 만들어주시는 콘텐츠예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.043,
                "end": 22.844
            },
            {
                "speaker_id": "1",
                "transcription": "너무 너무 고맙습니다.",
