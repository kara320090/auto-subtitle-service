        "term": [
            {
                "speaker_id": "1",
                "transcription": "먹을 만큼 먹었어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.777
            },
            {
                "speaker_id": "1",
                "transcription": "이제 가서 쉬어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.787,
                "end": 9.000
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 가서 화장실 준비해 올게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.000,
                "end": 11.962
            },
            {
                "speaker_id": "1",
                "transcription": "에구에구 간지러워 그 부분이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.962,
                "end": 18.000
            },
            {
                "speaker_id": "1",
                "transcription": "먹었으니까 운동을 하세요 운동을",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.000,
                "end": 21.035
            },
            {
                "speaker_id": "1",
                "transcription": "운동하려고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.035,
                "end": 22.320
            },
            {
                "speaker_id": "1",
                "transcription": "좀 쉬지 누룽지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.320,
                "end": 25.640
            },
            {
                "speaker_id": "1",
                "transcription": "에너자이저에요 에너자이저",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.650,
                "end": 28.517
            },
            {
                "speaker_id": "1",
                "transcription": "발바닥에 있던 까만 부분은 털이 뭉친 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.517,
                "end": 32.275
            },
            {
                "speaker_id": "1",
                "transcription": "발바닥에 껌이 좀 붙어있어서 선생님이 살살 제거해 주셨는데 발바닥 씻을 때마다 한 번씩",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.285,
                "end": 40.440
            }
        ]
    },
    "summary": "한 여자가 고양이 발바닥에 검정 부분은 털이 뭉친 거고 껌도 붙어 있어서 병원에서 제거했다고 말한다.",
