                    2
                ],
                "start": 9.820,
                "end": 13.798
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 향수 읽어 주는 여자 @이름1였습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.808,
                "end": 17.306
            },
            {
                "speaker_id": "1",
                "transcription": "여러분의 좋아요와 구독은 그리고 알림설정 아 향수를 만드는데도 도움이 되고요.",
                "sound_type": [
                    2
                ],
                "start": 17.316,
                "end": 25.046
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 만드는 데 큰 도움이 됩니다.",
