                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.679
            },
            {
                "speaker_id": "2",
                "transcription": "아우 @이름1 니 애기 낳았구나.",
                "sound_type": [
                    2
                ],
                "start": 0.689,
                "end": 2.285
            },
            {
                "speaker_id": "1",
                "transcription": "애기가 요렇게 예쁜데 왜 애기를 놔두고 갔어?",
                "sound_type": [
                    2
                ],
                "start": 2.295,
                "end": 5.502
            },
            {
                "speaker_id": "2",
                "transcription": "음 아유",
                "sound_type": [
                    2
                ],
                "start": 5.512,
                "end": 8.905
            },
            {
                "speaker_id": "1",
                "transcription": "아유 이 애기도 같이 거두면 아기는 얼마나 좋겠니?",
                "sound_type": [
                    2
                ],
                "start": 8.915,
                "end": 12.091
            },
            {
                "speaker_id": "1",
                "transcription": "아이구 녀석",
                "sound_type": [
                    2
                ],
                "start": 12.101,
                "end": 14.657
            },
            {
                "speaker_id": "2",
                "transcription": "아유 귀여워.",
                "sound_type": [
                    2
                ],
                "start": 14.667,
                "end": 16.569
            },
            {
                "speaker_id": "3",
                "transcription": "왔다 갔다 하면서 이제 사람들이 사료도 주고 간식도 주고 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 16.579,
                "end": 22.309
            },
            {
                "speaker_id": "1",
                "transcription": "저도 저희 집에 고양이가 14마리가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 22.319,
                "end": 25.248
            },
            {
                "speaker_id": "1",
                "transcription": "사연을 아시겠죠?",
                "sound_type": [
                    2
                ],
                "start": 25.258,
                "end": 27.633
            },
            {
                "speaker_id": "1",
                "transcription": "저희 아파트 고양이 다 거뒀어요.",
                "sound_type": [
                    2
                ],
                "start": 27.643,
                "end": 29.827
            },
            {
                "speaker_id": "1",
                "transcription": "길고양이도 돌보고 있고 그런데 요런 애기들이 잘 버려져서 아유 가니?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.837,
                "end": 35.694
            },
            {
                "speaker_id": "1",
                "transcription": "아이구구 간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.704,
                "end": 37.881
            },
            {
                "speaker_id": "1",
                "transcription": "아가 가야겠다 엄마랑 가자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.891,
                "end": 42.840
            }
        ]
    },
    "summary": "엄마 고양이가 젖을 먹이는 동안 집에 아파트에서 거둔 고양이가 14마리나 된다고 말하고 있는데 엄마 고양이가 떠나버려 아기 고양이를 데리고 가려고 하고 있다.",
