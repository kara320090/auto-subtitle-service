                ],
                "start": 0.000,
                "end": 3.855
            },
            {
                "speaker_id": "1",
                "transcription": "마음에 드는 게 좀 있으셨나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.865,
                "end": 5.767
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이전에 혼자 살던 집은 그렇게 예쁘게 꾸미질 못 했었거든요.",
                "sound_type": [
                    2,
                    3
                ],
