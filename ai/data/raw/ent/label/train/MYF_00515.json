        "term": [
            {
                "speaker_id": "1",
                "transcription": "작은 그릇은 잘 못 먹더라고요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.032
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아예 이렇게 큰 그릇에 방울이 거를 떠줬어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.042,
                "end": 5.540
            },
            {
                "speaker_id": "1",
                "transcription": "그랬더니 방울이가 이렇게 열심히 잘 먹네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.550,
                "end": 8.527
            },
            {
                "speaker_id": "1",
                "transcription": "방울이가 먹는 걸 보고 이제 우리 이 소리도 이렇게 먹일 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.537,
                "end": 20.201
            },
            {
                "speaker_id": "1",
                "transcription": "우리 방울이 잘 먹네.",
