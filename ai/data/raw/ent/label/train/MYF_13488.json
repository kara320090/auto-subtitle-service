        "term": [
            {
                "speaker_id": "1",
                "transcription": "시루야 아이고 어떡해. 엄마가 태워줄 수도 없고 이 장난감은 어 청소하는 장난감이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.130
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 부엌 청소하러 가야 돼. 부엌까지 따라올 거야 어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.140,
                "end": 12.457
            },
            {
                "speaker_id": "1",
                "transcription": "부엌은 안 되는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.467,
                "end": 14.153
            },
            {
                "speaker_id": "1",
                "transcription": "우리 띠루 아이고 시루가 앞장서서 빨리 안 오냐고 그러네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.163,
                "end": 18.715
            },
            {
                "speaker_id": "1",
                "transcription": "시루야. 엄마 지나가게 좀 다리 좀 시루야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.725,
                "end": 23.758
            },
            {
                "speaker_id": "1",
                "transcription": "우리 시.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.768,
                "end": 26.893
            }
        ]
    },
    "summary": "엄마가 부엌을 청소하러 가는데 시루가 앞장서서 간다.",
