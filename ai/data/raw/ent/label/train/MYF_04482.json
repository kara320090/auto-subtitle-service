        "term": [
            {
                "speaker_id": "1",
                "transcription": "@이름1도 그런 얘기를 했어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.948
            },
            {
                "speaker_id": "1",
                "transcription": "향수는 코로 완성하는 것이 아니라고 강조해서 말씀해 주셨어요.",
                "sound_type": [
                    2
                ],
                "start": 1.958,
                "end": 6.231
            },
            {
                "speaker_id": "1",
                "transcription": "향은 머리가 만들어 내는 거지 코가 만들어 내는 것이 아니라고 코에는 생각이 없다고 그렇게 얘기해 주셔가지고 정말 빵빵 터졌었어요.",
                "sound_type": [
                    2
                ],
                "start": 6.241,
                "end": 14.542
            },
            {
                "speaker_id": "1",
                "transcription": "그 본인의 모교인 ISIPCA에서 향수 수업을 진행하고 계셨거든요.",
                "sound_type": [
                    2
                ],
                "start": 14.552,
                "end": 18.942
            },
            {
                "speaker_id": "1",
                "transcription": "그때는 그때 저보고 한국에 언제 돌아가냐 ISIPCA 수업을 청강시켜주겠다.",
                "sound_type": [
                    2
                ],
                "start": 18.952,
                "end": 23.078
            },
            {
                "speaker_id": "1",
                "transcription": "이제 그러셨는데 하필 그 수업하시는 날짜가 제가 그 귀국하는 비행 편 다음 날이었어요.",
                "sound_type": [
                    2
                ],
                "start": 23.088,
                "end": 30.452
            },
            {
                "speaker_id": "1",
                "transcription": "아쉽게도 제가 청강하러 가지는 못했었답니다.",
                "sound_type": [
                    2
                ],
                "start": 30.462,
                "end": 33.086
            },
            {
                "speaker_id": "1",
                "transcription": "아 너무 안타까워요.",
                "sound_type": [
                    2
