        "term": [
            {
                "speaker_id": "1",
                "transcription": "서예용 깔판에서는 아주 유물이라고 할 수 있는 깔판인데 뭐, 그런 것 하나 있으면 좋고, 때로는 먹 갈 시간이 없는 사람을 위한 먹물, 예, 이런 먹물로도 나오죠, 요즘은.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.550
            },
            {
                "speaker_id": "1",
                "transcription": "참 편리해졌어요.",
                "sound_type": [
                    2
                ],
                "start": 13.550,
                "end": 15.140
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이런 먹물은 뭐, 거의 썩지도 않아요.",
                "sound_type": [
                    2
                ],
                "start": 15.140,
                "end": 18.980
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 물 섞어 쓰면 됩니다, 바로.",
                "sound_type": [
                    2
                ],
                "start": 18.980,
                "end": 21.120
            },
            {
                "speaker_id": "1",
                "transcription": "시간 없는 현대인들을 위해서 참 괜찮죠.",
                "sound_type": [
                    2
                ],
                "start": 21.120,
                "end": 27.120
            },
            {
                "speaker_id": "1",
                "transcription": "오징어 먹물로는 글씨 못씁니다.",
                "sound_type": [
                    2
