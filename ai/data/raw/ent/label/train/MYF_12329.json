        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니면 이런 옷들에도 뿌리고 나서 이렇게 로션처럼 발라주면 훨씬 더 효과가 극대화 된다고 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 10.198
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 제품을 구매하실 분들은 참고해 주시고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.208,
                "end": 13.531
            },
            {
                "speaker_id": "1",
                "transcription": "지속 시간은 대략 세 시간에서 네 시간 정도",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.541,
                "end": 17.006
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우에는 한 번 뿌리고 나서 모기가 안 덤벼들면 그냥 놔두고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.016,
                "end": 22.398
            },
            {
                "speaker_id": "1",
                "transcription": "다시 좀 덤비는 것 같다 그러면 추가로 더 뿌려주는 방식으로 그렇게 사용을 하고 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.408,
                "end": 28.857
            },
            {
                "speaker_id": "1",
                "transcription": "또 휴대하기도 굉장히 편해서 동남아 등 해외 여행 가실 때도 챙겨가시면 많은 도움이 되실 거라고 생각을 합니다.",
                "sound_type": [
                    2,
