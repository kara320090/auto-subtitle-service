                ],
                "start": 0.000,
                "end": 13.004
            },
            {
                "speaker_id": "1",
                "transcription": "2번째 향수는 오 드 메르베이입니다.",
                "sound_type": [
                    2
                ],
                "start": 13.014,
                "end": 15.890
            },
            {
                "speaker_id": "1",
                "transcription": "2004년에 출시된 오 드 메르베이 같은 경우는요.",
