                "end": 5.838
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러면 개복을 시작하도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.848,
                "end": 14.636
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 이거 어떻게 여는 거야?",
