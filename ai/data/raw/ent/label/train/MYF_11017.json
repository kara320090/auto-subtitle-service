        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "@계정1님 1인용 객실이 따로 있나요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.929
            },
            {
                "speaker_id": "1",
                "transcription": "아님 2인실을 혼자 쓰는가요?",
                "sound_type": [
                    2
                ],
                "start": 1.939,
                "end": 3.481
            },
            {
                "speaker_id": "1",
                "transcription": "1인실이 있는 크루즈도 있고 2인실을 1인이 쓰는 경우도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.491,
                "end": 7.903
            },
            {
                "speaker_id": "1",
                "transcription": "네 그리고 1인과 2인의 크루즈 비용은 큰 차이가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.913,
                "end": 11.340
            },
            {
                "speaker_id": "1",
                "transcription": "크루즈는 이제 가족이나 커플 여행이 좋긴 한데 최근 트렌드를 반영하기 위해서 1인실을 늘리는 크루즈 선사도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.350,
                "end": 21.959
            },
            {
                "speaker_id": "1",
                "transcription": "@계정2님 저는 지금 두바이에 살고 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 21.969,
                "end": 24.896
            },
            {
                "speaker_id": "1",
                "transcription": "영상에 나오는 크루즈터미널과 멀지 않은 곳에 있어요.",
                "sound_type": [
                    2
                ],
                "start": 24.906,
                "end": 27.600
            },
            {
                "speaker_id": "1",
                "transcription": "로멕님께서 좋은 정보 주셔서 조만간 위에 보여주신 크루즈를 가족들과 시도해 보려고요.",
                "sound_type": [
                    2
                ],
                "start": 27.610,
                "end": 32.070
            },
            {
                "speaker_id": "1",
                "transcription": "좋은 정보 정말 감사드립니다.",
                "sound_type": [
                    2
                ],
                "start": 32.080,
                "end": 34.300
            },
            {
                "speaker_id": "1",
                "transcription": "아 두바이에 사시는군요.",
                "sound_type": [
                    2
                ],
                "start": 34.310,
                "end": 35.772
            },
            {
                "speaker_id": "1",
                "transcription": "중동지역에도 정기적으로 운항하는 크루즈가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 35.782,
                "end": 38.489
            },
            {
                "speaker_id": "1",
                "transcription": "마음만 먹으시면 편하게 이용하실 수 있을 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 38.499,
                "end": 42.388
            }
        ]
    },
    "summary": "화자가 두바이에서 운항하고 있는 크루즈에 대해서 설명하고 있다.",
