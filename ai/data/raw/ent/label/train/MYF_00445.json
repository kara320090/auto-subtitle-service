        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 제 남동생이 120키로가 넘잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.174
            },
            {
                "speaker_id": "1",
                "transcription": "어 키도 186이잖아요.",
                "sound_type": [
                    2
                ],
                "start": 3.184,
                "end": 4.886
            },
            {
                "speaker_id": "1",
                "transcription": "남동생이 맞는 조끼가 없어갖고 겨울 내내 잠바 한 개 들고 댕기거든요.",
                "sound_type": [
                    2
                ],
                "start": 4.896,
                "end": 9.657
            },
            {
                "speaker_id": "1",
                "transcription": "그 잠바도 내 솔직히 말할게.",
                "sound_type": [
                    2
                ],
                "start": 9.667,
                "end": 11.412
            },
            {
                "speaker_id": "1",
                "transcription": "어 전저러전전전전 남친이 헬스하는 친구여서 덩치가 이만했어요.",
                "sound_type": [
                    2
                ],
                "start": 11.422,
                "end": 16.664
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 친구가",
