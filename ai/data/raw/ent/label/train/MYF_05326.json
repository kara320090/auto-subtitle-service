                    2
                ],
                "start": 2.613,
                "end": 7.624
            },
            {
                "speaker_id": "1",
                "transcription": "그게 코끝을 완전히 박하사탕을 먹은 느낌.",
                "sound_type": [
                    2
                ],
                "start": 7.634,
                "end": 12.269
            },
            {
