                "transcription": "진짜 맛있어요.",
                "sound_type": [
                    2
                ],
                "start": 12.279,
                "end": 13.588
            },
            {
                "speaker_id": "1",
                "transcription": "이게 미나리가 거의 살리는 거고 다시 튀김으로.",
