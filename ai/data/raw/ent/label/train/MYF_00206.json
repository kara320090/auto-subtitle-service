        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오랜만에 노래를 한번 해볼까 니가 왜 거기서 나와 정말 뒤는 난 난리 났네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.032
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 그랜저 에이치지 리어 범퍼를 이식을 하구요.",
                "sound_type": [
                    2
                ],
                "start": 6.042,
                "end": 10.205
            },
            {
                "speaker_id": "1",
                "transcription": "야 리벳을 이렇게 박은 다음에 도색을 다 넣었나 봐요.",
                "sound_type": [
                    2
                ],
                "start": 10.215,
                "end": 13.742
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 가까이에서 보면 상당히 독특합니다.",
                "sound_type": [
                    2
                ],
                "start": 13.752,
                "end": 16.473
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 제이티에스엠 리어 스펀지 댐에다가 리어 디퓨저까지 해서 뒷모습 아 그리고 레드로 요렇게 포인트를 줬구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.483,
                "end": 24.012
            },
            {
                "speaker_id": "1",
                "transcription": "아 상당히 디테일이 많네 뒤쪽에 그리고 요 리어 디퓨저 같은 경우에는 이게 원래 디퓨저를 왜 달아 놓냐 하면 바람에 결을 이렇게 나눈대요.",
                "sound_type": [
                    2
                ],
                "start": 24.022,
                "end": 32.890
            },
            {
                "speaker_id": "1",
                "transcription": "상당히 촘촘하게 바람결을 나누겠네 어 야 이거 뒤가 더 더 튀네요.",
                "sound_type": [
                    2
                ],
                "start": 32.900,
                "end": 38.266
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 니가 네 거기서 나오는 여기서 안 끝나",
                "sound_type": [
                    2
                ],
                "start": 38.276,
                "end": 41.408
            }
        ]
    },
    "summary": "차량 뒷편은 그랜저 에이치지 리어 범퍼를 이식후 도색을 하고 제이티에스엠 리어 스펀지 댐에 리어 디퓨저로 디테일을 살렸다고 한다.",
