        "term": [
            {
                "speaker_id": "1",
                "transcription": "정말",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.890
            },
            {
                "speaker_id": "2",
                "transcription": "산뜻하면서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.900,
                "end": 4.063
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 누군가의 키친에서 막 네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.073,
                "end": 7.964
            },
            {
                "speaker_id": "2",
                "transcription": "좀 특성들이 전 딱 있는 것 같아서 그게 되게 재밌다고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.974,
                "end": 12.861
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.871,
                "end": 13.921
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 아무래도 저희 라이브러리가 이번에 예전에 갤러리의 개념과는 다르게 예전에 출시됐던 제품들부터 시작해서 뭔가 러쉬 향수들을 한눈에 진짜 다 볼 수 있다 보니까 딱 그 개성들이 딱 보이고 갈리는 것 같아서 그게 되게 재밌다고 느꼈던 부분 중에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.931,
                "end": 31.580
            },
            {
                "speaker_id": "1",
                "transcription": "근데 우아할 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.590,
                "end": 32.692
            },
            {
                "speaker_id": "2",
                "transcription": "저도 느낀 게 원래 저희 향이 왜 그런지 모르겠지만 호불호가 딱 뚜렷하고 저희 향이 좀 어렵다고 느끼시는 분들이 꽤 있으셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.702,
                "end": 42.067
            },
            {
                "speaker_id": "2",
                "transcription": "저희 심지어 러쉬를 되게 좋아하시는 분들도 아 저는 보디 제품들은 되게 많은데 향수는 사실 제 취향이 없더라고요라는 얘기나 아니면 좀 어렵더라고요라고 말하시는 분들이 되게 많았는데 전 지금 좀 기대가 되는 부분이 이제 원래 @이름1이랑 @이름2이 원래 저희 조향을 많이 맡아서 하셨다면 이제 @이름3님의 역할이 지금부터 딱 보일 것 같은, @이름1이 이제 지금 그만둔 상태기 때문에 @이름3님이 하시기 시작하면 어떻게 될지 저는 그게 되게 기대가 되는 부분 중 하나예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.077,
                "end": 72.778
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 @이름3님 향을 좀 더 만나보고 싶어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.788,
                "end": 75.516
            },
            {
                "speaker_id": "2",
                "transcription": "왜냐면 @이름2의 향은 확실히 정물화 같은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.526,
                "end": 79.408
            },
            {
                "speaker_id": "3",
                "transcription": "약간 고전 미술 보는 그런 기분 일랑일랑 뭐 재스민 이렇게 명확하게 등장을 해서 조금 더 새로운 이런 향들 한 번 더 만나보고 싶어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.418,
                "end": 89.746
            },
            {
                "speaker_id": "2",
                "transcription": "그러면 향들이 이제 다 @이름3님의 작품이라고 제가 알고 있는데 보시면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.756,
                "end": 94.527
            }
        ]
    },
    "summary": "@이름3이 조향을 맡아서 기대가 되고, 작품을 더 만나보고 싶어 하는 손님에게 제품을 소개하고 있다.",
