        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 단풍이 아름답게 들었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.487
            },
            {
                "speaker_id": "1",
                "transcription": "가자. 오늘은 쿠키와 아차산.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.497,
                "end": 8.879
            },
            {
                "speaker_id": "1",
                "transcription": "나 오늘 쿠키랑 커플티 입었어. 쿠키랑 커플티.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.889,
                "end": 13.543
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 이거 점프 점프 옳지. 내려가 볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.553,
                "end": 20.633
            },
            {
                "speaker_id": "1",
                "transcription": "이쪽으로 올라가 볼까? 쿠키 점프 점프.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.643,
                "end": 30.972
            },
            {
                "speaker_id": "1",
                "transcription": "자기야 단풍이 조금씩 들고 있어 이렇게 보면은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.982,
                "end": 38.659
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키가 너무 좋아한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.669,
                "end": 73.373
            },
            {
                "speaker_id": "2",
                "transcription": "쿠키야. 아이구 이뻐. 오 엄청 빨라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.383,
                "end": 80.253
            },
            {
                "speaker_id": "1",
                "transcription": "다시 올라 갈까? 쿠키 가자. 가자. 안돼 안돼. 형아 힘들어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.263,
                "end": 97.406
            },
            {
                "speaker_id": "2",
                "transcription": "형아 힘들대. 가자 이제.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.416,
                "end": 100.466
            }
        ]
    },
    "summary": "강아지 쿠키와 단풍이 든 아차산에 산책을 갔다.",
