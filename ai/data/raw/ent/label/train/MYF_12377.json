        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "재밌게 낚시할 수 있겠다 생각했는데 의외로 작은 씨알의 붕어들만 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.363
            },
            {
                "speaker_id": "1",
                "transcription": "어제 저기 정면 수초를 넘겼던 저 대에서 월척급 붕어를 한 마리 걸기는 했는데 다 와서 들어 올리려다가 빠졌거든요.",
                "sound_type": [
                    2
                ],
                "start": 6.373,
                "end": 15.599
            },
            {
                "speaker_id": "1",
                "transcription": "그게 너무 아쉽네요.",
                "sound_type": [
                    2
                ],
                "start": 15.609,
                "end": 17.707
            },
            {
                "speaker_id": "1",
                "transcription": "저수지는 배수를 하고 점점 더워지면서 낚시하기가 쉽지 않아지는데요.",
                "sound_type": [
                    2
                ],
                "start": 17.717,
                "end": 23.234
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 저는 더 파이팅 해서 좋은 붕어 보여드릴 수 있도록 노력하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.244,
                "end": 28.286
            },
            {
                "speaker_id": "1",
                "transcription": "항상 낚시라는 게 아쉬움을 좀 남기는 것 같은데 그 아쉬움이 있어야 다음에 기대를 갖고 또 다른 곳으로 갈 수 있을 테니까요.",
                "sound_type": [
                    2
                ],
                "start": 28.296,
                "end": 37.018
            },
            {
                "speaker_id": "1",
                "transcription": "저는 여기서 마무리하고 다음에 더 좋은 곳에서 멋진 붕어와 함께 인사드리도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.028,
                "end": 42.158
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 시청해 주셔서 감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 42.168,
                "end": 45.336
            }
        ]
    },
    "summary": "한 남성이 큰 고기를 잡지는 못했지만 아쉬움을 뒤로하고 다음에 큰 고기를 잡을 수 있기를 소망하고 낚시를 마무리하고 있다.",
