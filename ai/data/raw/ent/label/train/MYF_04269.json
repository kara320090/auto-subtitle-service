                "end": 5.599
            },
            {
                "speaker_id": "1",
                "transcription": "이 책의 표지는요.",
                "sound_type": [
                    2
                ],
                "start": 5.609,
                "end": 7.606
            },
            {
                "speaker_id": "1",
                "transcription": "그 박지현 일러스트레이터가 작업을 했는데요.",
                "sound_type": [
                    2
                ],
                "start": 7.616,
                "end": 10.346
            },
            {
                "speaker_id": "1",
                "transcription": "데빌 웨얼즈 프라다 악마는 프라다를 입는다 그 소설의 그 표지를 그리셨던 일러스트레이터세요.",
                "sound_type": [
                    2
                ],
                "start": 10.356,
                "end": 17.217
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 작가님에 또 그림이 들어가 있어 가지고 그걸 보는 재미도 쏠쏠하답니다.",
                "sound_type": [
                    2
                ],
                "start": 17.227,
                "end": 23.300
            }
        ]
    },
    "summary": "이 책은 우영미 카툰 리스트의 그림으로 되어있는 만화책이고 표지는 악마는 프라다를 입는다 소설의 표지를 그린 박지현 일러스트레이터가 작업을 했습니다.",
