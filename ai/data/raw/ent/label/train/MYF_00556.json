        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "언니처럼 좀 주무세요 언니한테 또 가는 거야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.890
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 이제 가지 언니 깨우러 가는 거야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.900,
                "end": 8.507
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 아이고 등산도 좋아하고 엄청 활발하는 친구들이죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.517,
                "end": 21.586
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 꾹꾹이 방울이 꾹꾹이 방울이가 등산 곰돌이한테 등산.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.596,
                "end": 30.264
            },
            {
                "speaker_id": "1",
                "transcription": "솔이는 벽으로 등산 벽으로 등반.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.274,
                "end": 39.240
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 아이고 아이고 또 언니한테 또 말릴 수 없는 두 자매와 태평한 한 자매 세 자매의 아침입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.240,
                "end": 55.610
            }
        ]
    },
    "summary": "등산도 좋아하고 엄청 활발한 친구들이여서 방울이는 곰돌이한테 등산하고 솔이는 벽을 등반한다며 총 세 자매의 아침이라고 말한다.",
