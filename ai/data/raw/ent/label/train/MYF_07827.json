        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 우리 쑥이 오늘 쑥이가 처음으로 쥐돌이에 관심을 나타내네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.278
            },
            {
                "speaker_id": "1",
                "transcription": "누구세요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.288,
                "end": 9.157
            },
            {
                "speaker_id": "1",
                "transcription": "하당 하당이 잘 잤어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.167,
                "end": 14.606
            },
            {
                "speaker_id": "1",
                "transcription": "하당이 인사했어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.616,
                "end": 16.538
            },
            {
                "speaker_id": "1",
                "transcription": "우리 쑥이 장난감에 처음 어 스스로 관심을 나타내는 것 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.548,
                "end": 25.282
            },
            {
                "speaker_id": "1",
                "transcription": "소리가 나는 장난감이야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.292,
                "end": 28.082
            },
            {
                "speaker_id": "1",
                "transcription": "새로운 어 찍찍이를 하나 꺼내 줄게 엄마가 이따가.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.092,
                "end": 33.853
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 니가 관심을 가지는구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.863,
                "end": 37.097
            },
            {
                "speaker_id": "1",
                "transcription": "그래 쑥아 지니야 유채도 좋아하는 거야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.107,
                "end": 43.016
            },
            {
                "speaker_id": "1",
                "transcription": "역시 달래 아기들은 똑같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.026,
                "end": 46.583
            },
            {
                "speaker_id": "1",
                "transcription": "어머 여기는 누구야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.593,
                "end": 48.662
            },
            {
                "speaker_id": "1",
                "transcription": "우리 까망이 까망이 잘 잤어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.672,
                "end": 51.674
            },
            {
                "speaker_id": "1",
                "transcription": "어잇 어잇 쑥아",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.684,
                "end": 55.121
            }
        ]
    },
    "summary": "오늘 고양이 쑥이가 처음으로 쥐돌이에 관심을 나타낸다고 여자가 말하고 있다.",
