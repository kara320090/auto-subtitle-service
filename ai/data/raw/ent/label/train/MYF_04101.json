        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 향수는 향을 맡자마자 우와 이거는 남자다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.080
            },
            {
                "speaker_id": "1",
                "transcription": "전통적인 근육질의 남성적인 역할을 가지고 있는 그런 남자, 남자에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.100,
                "end": 10.070
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 이거는 남자에요.",
                "sound_type": [
                    2
                ],
                "start": 10.080,
                "end": 11.501
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 ISTJ 남성 분들이 이 향을 딱 입으시면 그냥 마음이 편하실 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.511,
                "end": 17.250
            },
            {
                "speaker_id": "1",
                "transcription": "아 나는 남자의 향수를 입었다.",
                "sound_type": [
                    2
                ],
                "start": 17.254,
                "end": 19.220
            },
            {
                "speaker_id": "1",
                "transcription": "남자다.",
                "sound_type": [
                    2
                ],
                "start": 19.230,
                "end": 20.200
