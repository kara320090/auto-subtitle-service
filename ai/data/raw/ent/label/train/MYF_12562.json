        "term": [
            {
                "speaker_id": "1",
                "transcription": "단점으로 이야기하다 보면 일단은 우리가 가장 중요시 하는 가격이 세다는 거.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.282
            },
            {
                "speaker_id": "1",
                "transcription": "채비 손실이 왔을 때는 아깝잖아요.",
                "sound_type": [
                    2
                ],
                "start": 4.292,
                "end": 6.965
            },
            {
                "speaker_id": "1",
                "transcription": "그 부분이 있는데 지금 처음에 얼레 채비 접하신 분들 보면.",
                "sound_type": [
                    2
                ],
                "start": 6.975,
                "end": 11.977
            },
            {
                "speaker_id": "1",
                "transcription": "얼레와 반얼레 차이를 굉장히 어려워하는데 편납을 잘라서 넣고 빼고 이게 힘들다.",
                "sound_type": [
                    2
                ],
                "start": 11.987,
                "end": 17.048
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 에어봉돌로 사용하시니 현장에서 바로 현장마다 또 부력에 변화가 생기는데.",
                "sound_type": [
                    2
                ],
                "start": 17.058,
                "end": 22.188
            }
        ]
    },
    "summary": "에어봉돌의 단점은 가격이 세다는 것이고 ,장점은 편납을 잘라서 넣고 빼고 하지 않아도 된다는 점이다.",
