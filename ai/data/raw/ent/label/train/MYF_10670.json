        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 23년 11월 아 여름철에 가는구나. 예",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.793
            },
            {
                "speaker_id": "1",
                "transcription": "다 여름철에 가네요. 그렇죠?",
                "sound_type": [
                    2
                ],
                "start": 4.803,
                "end": 6.590
            },
            {
                "speaker_id": "1",
                "transcription": "겨울에 가면 그니까 우리로 치면 여름에 가면 얼어 죽겠죠. 거긴 겨울이니까",
                "sound_type": [
                    2
                ],
                "start": 6.600,
                "end": 11.924
            },
            {
                "speaker_id": "1",
                "transcription": "코스가 아마 부에노스아이레스 떠나서 가는 건지 뭔지 모르겠지만 아 이것도 되게 혹한 일정이긴 합니다.",
                "sound_type": [
                    2
                ],
                "start": 11.934,
                "end": 22.932
            },
            {
                "speaker_id": "1",
                "transcription": "근데 무지 추울 거예요.",
                "sound_type": [
                    2
                ],
                "start": 22.942,
                "end": 26.012
            },
            {
                "speaker_id": "1",
                "transcription": "그죠? 부에노스아이레스 출발서 스탠리 저기가 포클랜드 영국과 아르헨티나 전쟁이 있었던 곳 스탠리를 지나서 엘리펀트 아일랜드 예 남극 딱 예",
                "sound_type": [
                    2
                ],
                "start": 26.022,
                "end": 39.198
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 북극으로 치면 제가 갔던 스발바르를 찍고 오는 거랑 비슷한 거죠.",
                "sound_type": [
                    2
                ],
                "start": 39.208,
                "end": 43.710
            }
        ]
    },
    "summary": "남극은 23년 11월 여름철에 가며 부에노스아이레스에서 출발해 엘리펀트 아일랜드를 다녀오는 일정이다.",
