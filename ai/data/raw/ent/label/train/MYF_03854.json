        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 홈페이지에 가서 찾아봐도 안 나와가지고 그래서 최근에 제가 이제 발견한 제품이 윤작이에요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.102
            },
            {
                "speaker_id": "1",
                "transcription": "이 집도 정말 화장품을 잘 만들더라고요.",
                "sound_type": [
                    2
                ],
                "start": 7.112,
                "end": 10.195
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 윤작 그 자외선 차단제가 약간 그 컬러감이 살짝 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 10.205,
                "end": 15.667
            },
            {
                "speaker_id": "1",
                "transcription": "제가 오늘 바른 게 이 윤작이거든요.",
                "sound_type": [
                    2
                ],
                "start": 15.677,
                "end": 18.241
            },
            {
                "speaker_id": "1",
                "transcription": "컬러감이 살짝 있어서 근데 이게 피부 안색을 그냥 약간의 그래도 균일하게 만들어주는 효과는 있지만 근데 뭐 피부 커버 단점을 커버하거나 이런 기능을 하거나 이런 건 아니고요.",
                "sound_type": [
                    2
                ],
                "start": 18.251,
                "end": 30.672
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 살짝의 컬러가 존재를 해서 조금은 그냥 균일한 피부 톤을 이제 만들어주는 그런 그 자외선 차단제고요.",
                "sound_type": [
                    2
                ],
                "start": 30.682,
                "end": 38.711
            },
            {
                "speaker_id": "1",
                "transcription": "제가 오늘 아침에 일어나서 세안하고 스킨, 에센스, 크림 바르고 그다음에 이제 바르는 게 바로 이 이 윤작 선크림입니다.",
                "sound_type": [
                    2
                ],
                "start": 38.721,
                "end": 47.077
            },
            {
                "speaker_id": "1",
                "transcription": "어 이 제품 정말 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 47.087,
                "end": 48.686
            },
            {
                "speaker_id": "1",
                "transcription": "막 일어나거나 그런 것도 없고 자극적이지도 않고 정말 산뜻하고 가볍고 아주 얇게 근데 잘 발리는 네 그런 제품이에요.",
                "sound_type": [
                    2
                ],
                "start": 48.696,
                "end": 58.041
            },
            {
                "speaker_id": "1",
                "transcription": "이거랑 이제 한율 순수 그리고 이제 시슬리의 선크림들 이제 중요한 게 바로 보습 관리인데요.",
                "sound_type": [
                    2
                ],
                "start": 58.051,
                "end": 65.148
            },
            {
                "speaker_id": "1",
                "transcription": "사실 그 피부에 가장 필요하고 중요한 게 바로 이 보습이라고 생각을 하거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 65.158,
                "end": 74.466
            }
        ]
    },
    "summary": "윤작 자외선 차단제는 컬러감이 살짝 있지만 피부 단점을 커버하는 기능보다는 피부 안색을 균일하게 만들어주는 효과가 있는 제품으로 자극적이지 않고 산뜻하고 얇게 잘 발리는 제품이다.",
