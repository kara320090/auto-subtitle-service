        "term": [
            {
                "speaker_id": "1",
                "transcription": "막내가 하는 수 없이 첫째가 가자는 곳으로 가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.459
            },
            {
                "speaker_id": "1",
                "transcription": "역시 첫째의 카리스마가 뿜뿜이네요 아하하하",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.469,
                "end": 8.389
            },
            {
                "speaker_id": "1",
                "transcription": "첫째야 중간에 가서 놀아 우리 첫째 얼굴이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.399,
                "end": 12.789
            },
            {
                "speaker_id": "1",
                "transcription": "첫째와 막내입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.799,
                "end": 14.745
            },
            {
                "speaker_id": "1",
                "transcription": "첫째와 막내 어유 얼굴 좀 크게 담자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.755,
                "end": 18.395
            },
            {
                "speaker_id": "1",
                "transcription": "어이고 우리 막둥이 엄마 목소리가 들려요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.405,
                "end": 22.097
            },
            {
                "speaker_id": "1",
                "transcription": "둘째 제일 뒤에 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.107,
                "end": 24.800
            },
            {
                "speaker_id": "1",
                "transcription": "서로 그로밍해 주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.810,
                "end": 26.902
            },
            {
                "speaker_id": "1",
                "transcription": "핥아주고 뽀뽀해 주고 아이고 아이고 사이도 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.912,
                "end": 32.494
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 금방 올게 너희들 보니까 시간 가는 줄 모르겠다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.504,
                "end": 38.240
            }
        ]
    },
    "summary": "막내가 첫째의 지시에 따라 갈 수밖에 없는 상황이라면서 서로 그로밍해주고 사이가 좋아서 보고 있으면 시간 가는 줄 모르겠다며 금방 다녀오겠다고 말한다.",
