        "term": [
            {
                "speaker_id": "1",
                "transcription": "참이는 또 어디 가는 것이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.622
            },
            {
                "speaker_id": "1",
                "transcription": "아이구 아이구 아이구 아이구 바쁘다 바빠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.632,
                "end": 4.494
            },
            {
                "speaker_id": "1",
                "transcription": "아침에 참이 바빠 어 여기 노아가 있구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.504,
                "end": 7.879
            },
            {
                "speaker_id": "1",
                "transcription": "노아도 바쁘고 참이도 바쁘고 아이고 참아 어디 가는 거야 베란다 가는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.889,
                "end": 14.742
            },
            {
                "speaker_id": "1",
                "transcription": "아하 뒤에 달래가 있구나 어떡하니 둘이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.752,
                "end": 19.185
            },
            {
                "speaker_id": "1",
                "transcription": "어떡할까요 둘이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.195,
                "end": 23.037
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 문 열어 줄까 참이 나가고 싶어?",
