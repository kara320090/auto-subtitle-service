        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "설마 설마 했는데 지뢰가 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.597
            },
            {
                "speaker_id": "1",
                "transcription": "내 쓰레기만 가져가도 낚시꾼 욕 먹을 일 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.607,
                "end": 9.293
            },
            {
                "speaker_id": "1",
                "transcription": "자 형님들 대편성 모두 마쳤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.303,
                "end": 48.672
            },
            {
                "speaker_id": "1",
                "transcription": "아까 그 곳 소류지에서 대를 후다닥 접고 이곳에 와서 다시 대편성을 했는데요.8",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.682,
                "end": 53.736
            },
            {
                "speaker_id": "1",
                "transcription": "와보니까 쓰레기가 좀 있어서 쓰레기 줍고 시작했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.746,
                "end": 58.036
            },
            {
                "speaker_id": "1",
                "transcription": "아 수심은 지금 대략 70에서 80 그리고 제일 깊은 곳이 대략 1미터 정도 나오고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 58.046,
                "end": 64.669
            },
            {
                "speaker_id": "1",
                "transcription": "미끼는 글루텐 써볼 예정입니다.",
                "sound_type": [
                    2
                ],
                "start": 64.679,
                "end": 66.810
            },
            {
                "speaker_id": "1",
                "transcription": "따로 블루길이나 잡어들이 덤비지는 않네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.820,
                "end": 69.125
            },
            {
                "speaker_id": "1",
                "transcription": "자 좋은 붕어 만나볼 수 있도록.",
                "sound_type": [
                    2
                ],
                "start": 69.135,
                "end": 70.904
            }
        ]
    },
    "summary": "남자는 다시 대편성을 했는데 쓰레기가 있어서 쓰레기를 줍고 시작했다고 하며 제일 깊은 곳 수심이 1미터 정도이고 미끼는 글루텐을 써볼 예정이라고 한다.",
