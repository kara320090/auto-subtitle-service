        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러면은 한번 객실 쪽으로 가 볼게요. 저희 객실로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.717
            },
            {
                "speaker_id": "1",
                "transcription": "저희는 좀 저렴한 객실로 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.727,
                "end": 6.907
            },
            {
                "speaker_id": "1",
                "transcription": "디럭스 배드인데 아마 저희같이 주머니가 가벼운 서민들은 대부분 디럭스 배드로 할 것 같아서 디럭스 배드 방을 한번 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.917,
                "end": 17.213
            },
            {
                "speaker_id": "1",
                "transcription": "가보겠습니다 6동입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.223,
                "end": 18.770
            },
            {
                "speaker_id": "1",
                "transcription": "아까 전에 이야기했던 스타벅스 옆쪽으로 가면은 어 6동이 이어져 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.780,
                "end": 23.838
            },
            {
                "speaker_id": "1",
                "transcription": "여기 프런트가 5동에 있으니까 프런트를 기준으로 가면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.848,
                "end": 29.028
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이게 5동이 아까 말씀드린 대로 정 가운데 있어서 4, 3, 2, 1은 저쪽으로",
                "sound_type": [
