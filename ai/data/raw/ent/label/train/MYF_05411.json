        "term": [
            {
                "speaker_id": "1",
                "transcription": "나 코가 왜 이렇게 아프지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.184
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 잘 때 갑자기 코 아픈게 너무 심해져가지고 아파서 깬 코가 아파서 깼었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.194,
                "end": 7.673
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 그러고 지금 일어나고 난 다음에 후각이랑 미각이 사라진 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.666,
                "end": 13.021
            },
            {
                "speaker_id": "1",
                "transcription": "후각이랑 미각이 없으니까 입맛도 없어지는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.031,
                "end": 15.520
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 씹는 식감은 느껴지니까 또",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.530,
                "end": 18.766
            }
        ]
    },
    "summary": "여자가 자다가 코가 아파서 깼는데 일어난 후에 후각이랑 미각이 사라지고 입맛도 없다고 말하고 있다.",
