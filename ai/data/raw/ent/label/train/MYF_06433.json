        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "토실토실한 계란찜도 요렇게 젓가락으로 슥 잘라내서 한 입 맛을 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.229
            },
            {
                "speaker_id": "1",
                "transcription": "음 일반적인 엄마가 해주는 그런 계란찜의 맛입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.239,
                "end": 9.024
            },
            {
                "speaker_id": "1",
                "transcription": "특별할 건 없지만 그래도 맛이 좋았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.034,
                "end": 11.910
            },
            {
                "speaker_id": "1",
                "transcription": "청포묵도 한 입 캬 청포묵도 입에서 슥 사라지고 참기름이 아주 고소하고 맛이 좋았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.920,
                "end": 19.319
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 소고기뭇국과 솥 밥이 나왔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.329,
                "end": 23.096
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 임연수구이와 전갱이구이도 이렇게 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.106,
                "end": 25.907
            },
            {
                "speaker_id": "1",
                "transcription": "오른쪽이 임연수구이고 왼쪽이 전갱이구이입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.917,
                "end": 30.400
            }
        ]
    },
    "summary": "화자가 계란찜은 엄마의 맛이고 청포묵은 입에서 슥 사라지면서 참기름이 고소했으며 소고기뭇국과 솥 밥이 나오고 임연수와 전갱이구이가 나왔다고 했다.",
