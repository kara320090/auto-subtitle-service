        "term": [
            {
                "speaker_id": "1",
                "transcription": "제 영상으로 못 찍어서 사진으로 찍어 보았는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.110
            },
            {
                "speaker_id": "1",
                "transcription": "목이 이만큼 더 늘어나요.",
                "sound_type": [
                    2
                ],
                "start": 3.110,
                "end": 4.640
            },
            {
                "speaker_id": "1",
                "transcription": "한 1뼘 조금 더 되는 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 4.640,
                "end": 8.039
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 홀더를 옆으로 눕히면 핸드폰을 세로로 꽂을 수도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.039,
                "end": 13.320
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 실내든 야외에서든 엄청 잘 쓸 수 있는 것 같은 삼각대라서 추천합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.320,
                "end": 19.876
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 리뷰 영상 재밌게 보셨나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.880,
                "end": 22.200
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로도 여러 가지를 리뷰 할 예정이니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.200,
                "end": 24.959
            },
            {
                "speaker_id": "1",
                "transcription": "재밌게 보셨으면 구독과 좋아요 눌러 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.960,
                "end": 27.790
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다",
                "sound_type": [
                    2,
                    3
                ],
