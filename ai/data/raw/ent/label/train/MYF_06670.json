        "term": [
            {
                "speaker_id": "1",
                "transcription": "제 입맛에는 양념이 제일 맛있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.600
            },
            {
                "speaker_id": "1",
                "transcription": "매콤하고 새콤달콤하고 아주 맛이 좋았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.610,
                "end": 6.895
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 갈빗살을 먹었으니 냉면 국물도 호로록",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.905,
                "end": 14.415
            },
            {
                "speaker_id": "1",
                "transcription": "아 다시 봐도 침 고이고 저 냉면 정말 맛있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.425,
                "end": 18.207
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에도 쌈무와 함께 맛있게 즐겨봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.217,
                "end": 22.749
            },
            {
                "speaker_id": "1",
                "transcription": "냉면은 취향에 따라 식초와 겨자를 잔뜩 넣고",
