        "term": [
            {
                "speaker_id": "1",
                "transcription": "추천드리도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.280
            },
            {
                "speaker_id": "1",
                "transcription": "시간 되실 때 한번 시향해 보시고 결과도 알려주시면 너무 고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 1.280,
                "end": 6.700
            },
            {
                "speaker_id": "1",
                "transcription": "어 이렇게 또 추천을 드릴 수 있어서 너무 기쁘고요.",
                "sound_type": [
                    2
                ],
                "start": 6.710,
                "end": 10.500
            },
            {
                "speaker_id": "1",
                "transcription": "어 제가 꾸준히 추천드리도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 10.500,
                "end": 13.170
            },
            {
                "speaker_id": "1",
                "transcription": "작년에 설문 그 응답해 주신 분들도 다시 한번 너무너무 고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.160,
                "end": 17.450
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 향기로운 하루 보내시고요.",
                "sound_type": [
                    2
                ],
                "start": 17.460,
                "end": 21.550
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 도움이 됐다면 구독과 좋아요 부탁드릴게요.",
