        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 어 향수 추천을 이렇게 드리면서 저도 많이 또 배워가게 되거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.802
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜로 이러이러한 걸 좋아하시는 분들은 또 이런 거 있으시구나 뭐 라든지 그러기 때문에 어 지난 작년에 12월에 향수 설문지 긴 설문지 응답해 주신 분들 다시 한번 감사 인사를 드리고요.",
                "sound_type": [
                    2
                ],
                "start": 6.812,
                "end": 23.010
            },
            {
                "speaker_id": "1",
                "transcription": "제가 계속 영상은 찍어서 올리도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.020,
                "end": 26.385
            },
            {
                "speaker_id": "1",
                "transcription": "네 영상에 도움이 되셨다면 구독과 좋아요 그리고 알림 설정 네 댓글도 어 감사하게 받도록 하겠습니 다.",
                "sound_type": [
                    2
                ],
                "start": 26.395,
                "end": 35.394
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 또 저는 향수 추천 영상으로 찾아 뵙도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 35.404,
                "end": 39.222
            },
            {
                "speaker_id": "1",
                "transcription": "고맙습니다 오늘도 향기로운 하루",
                "sound_type": [
                    2
                ],
                "start": 39.232,
                "end": 41.467
