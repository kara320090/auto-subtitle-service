        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 우리 @이름1가 4번 손수레를 했거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.795
            },
            {
                "speaker_id": "1",
                "transcription": "자 정답은 1번 화물자동차",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.805,
                "end": 6.310
            },
            {
                "speaker_id": "1",
                "transcription": "자 아 큰일 났네.",
                "sound_type": [
                    2
                ],
                "start": 6.320,
                "end": 9.911
            },
            {
                "speaker_id": "1",
                "transcription": "45번도 틀렸어.",
                "sound_type": [
                    2
                ],
                "start": 9.921,
                "end": 11.774
            },
            {
                "speaker_id": "1",
                "transcription": "자 다음 규제 표지에 대한 설명으로 맞는 것은, 여러분 맞혀보세요.",
                "sound_type": [
                    2
                ],
                "start": 11.784,
                "end": 16.230
            },
            {
                "speaker_id": "1",
                "transcription": "1번 최저 속도 제한 표지",
                "sound_type": [
                    2
                ],
                "start": 16.240,
                "end": 19.002
            },
            {
                "speaker_id": "1",
                "transcription": "2번 최고 속도 제한 표지",
                "sound_type": [
                    2
                ],
                "start": 19.012,
                "end": 21.644
            },
            {
                "speaker_id": "1",
                "transcription": "3번 차간 거리 확보 표지",
                "sound_type": [
                    2
                ],
                "start": 21.654,
                "end": 24.306
            },
            {
                "speaker_id": "1",
                "transcription": "4번 안전 속도 유지 표지",
                "sound_type": [
                    2
                ],
                "start": 24.316,
                "end": 26.913
            },
            {
                "speaker_id": "1",
                "transcription": "자 봐 봐.",
                "sound_type": [
                    2
                ],
                "start": 26.923,
                "end": 27.975
            },
            {
                "speaker_id": "1",
                "transcription": "30 밑에 언더바가 있잖아.",
                "sound_type": [
                    2
                ],
                "start": 27.985,
                "end": 30.036
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이게 30부턴 거야.",
                "sound_type": [
                    2
                ],
                "start": 30.046,
                "end": 33.221
            },
            {
                "speaker_id": "2",
                "transcription": "아",
                "sound_type": [
                    2
                ],
                "start": 33.231,
                "end": 34.810
            },
            {
                "speaker_id": "1",
                "transcription": "30부턴 거야, 우리 고속도로 다니다 보면 30 언더바 뭐 100 언더바, 110 언더바 이런 거 보일 거야.",
                "sound_type": [
                    2
                ],
                "start": 34.820,
                "end": 41.054
            },
            {
                "speaker_id": "1",
                "transcription": "근데 만약에 위에 있는 언더가 아니라 업바가 있어.",
                "sound_type": [
                    2
                ],
                "start": 41.064,
                "end": 45.289
            },
            {
                "speaker_id": "1",
                "transcription": "100 위에 모자를 이렇게 쓰고 있어, 그럼 뭐야?",
                "sound_type": [
                    2
                ],
                "start": 45.299,
                "end": 47.597
            },
            {
                "speaker_id": "2",
                "transcription": "최고 속도 제한",
                "sound_type": [
                    2
                ],
                "start": 47.607,
                "end": 48.616
            },
            {
                "speaker_id": "1",
                "transcription": "100 이하, 그렇지.",
                "sound_type": [
                    2
                ],
                "start": 48.626,
                "end": 49.943
            },
            {
                "speaker_id": "1",
                "transcription": "30 밑에 언더 바가 있어, 뭐 30 부턴 거야.",
                "sound_type": [
                    2
                ],
                "start": 49.953,
                "end": 53.999
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 얘는 정답은 1번인 거지, 최저 속도.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 54.009,
                "end": 57.365
            },
            {
                "speaker_id": "1",
                "transcription": "자 46번은 1번",
                "sound_type": [
                    2
                ],
                "start": 57.375,
                "end": 59.263
            },
            {
                "speaker_id": "1",
                "transcription": "아 몇 개 틀렸어.",
                "sound_type": [
                    2
                ],
                "start": 59.273,
                "end": 61.012
            },
            {
                "speaker_id": "1",
                "transcription": "하나, 둘, 셋, 세 문제 틀렸으므로 탈락",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.022,
                "end": 64.635
            },
            {
                "speaker_id": "1",
                "transcription": "야 너 어떡해, 화요일에 시험이라고.",
                "sound_type": [
                    2
                ],
                "start": 64.645,
                "end": 68.766
            }
        ]
    },
    "summary": "@이름1은 손수레를 했지만 정답은 1번 화물자동차이고, 45번 다음 규제 표지에 대한 설명으로 맞는 것에 대한 문제를 보자면 30밑에 언더바가 있는데 이거는 30부터라는 얘기이고, 고속도로를 다녀보면 위에 업바로 100 위에 표시되어 있는 것은 최고 속도 제한이므로 45번에 대한 정답은 1번 최저 속도인 것이고, 화요일일에 시험인데 세 문제 틀려서 탈락이면 어떡할 거냐고 걱정한다.",
