        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "보니까 현지인 분들이 많이 낚시를 했던 곳 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.746
            },
            {
                "speaker_id": "1",
                "transcription": "작업도 잘돼 있고 쓰레기도 많고 물색 굉장히 좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.756,
                "end": 8.364
            },
            {
                "speaker_id": "1",
                "transcription": "앞에 부들이 병풍처럼 쫙 둘러 있어서 분위기도 좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.374,
                "end": 15.118
            },
            {
                "speaker_id": "1",
                "transcription": "이 부들밭 반대편이 본류고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.128,
                "end": 17.994
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 여기서 한번 낚시 진행해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.004,
                "end": 22.228
            },
            {
                "speaker_id": "1",
                "transcription": "짧은 대 갖고 오면 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.238,
                "end": 25.759
            }
        ]
    },
    "summary": "현지인 분이 낚시를 많이 하던 이곳은 물색도 좋고 작업도 잘돼 있지만 쓰레기가 많다며 근데 부들이 병풍처럼 둘러 있어서 분위기가 좋고 부들밭 반대편이 본류라면서 짧은 대로 낚시해보겠다고 말한다.",
