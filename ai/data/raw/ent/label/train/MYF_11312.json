        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "직접적으로 넣고 이렇게 해서도 주전자나 후라이팬 같은 거 이렇게 놓고 바로 조리를 할 수 있는 또 조리킷이 이렇게 있다는 거 괜찮은 것 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 11.434
            },
            {
                "speaker_id": "1",
                "transcription": "물론 실내에서 쓸 때는 이렇게 쓰시면 안 되겠죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.444,
                "end": 13.722
            },
            {
                "speaker_id": "1",
                "transcription": "근데 우리가 실외에서 바깥에서 사용할 때는 이렇게 사용하셔도 된다는 거.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.732,
                "end": 18.200
            },
            {
                "speaker_id": "1",
                "transcription": "이게 지금 내열 유리가 900도씨까지 버틴 내열 유리잖아요?",
                "sound_type": [
                    2
                ],
                "start": 18.210,
                "end": 21.860
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 옆에 지금 여기 구멍이 위아래로 있기 때문에 여기서 에어커튼이 형성이 돼가지고 그을음도 훨씬 더 덜하다고 그래요.",
                "sound_type": [
                    2
                ],
                "start": 21.870,
                "end": 29.009
            },
            {
                "speaker_id": "1",
                "transcription": "근데 우리가 화목 난로를 사용할 때 보면 항상 이 위 겉에를 토치로 살짝 이렇게 그을려 주면 훨씬 더 그을음을 방지할 수 있는 그런 건 있으니까 그런 걸 사용하시면 될 것 같고요.",
                "sound_type": [
                    2
                ],
                "start": 29.019,
                "end": 39.420
            },
            {
                "speaker_id": "1",
                "transcription": "지금 현재 이 높이가 요 위에 조리킷까지 해가지고 얹었을 때는 약 35센티 정도 되는 높이예요.",
                "sound_type": [
                    2
                ],
                "start": 39.430,
                "end": 44.673
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 다리를 접었을 때는 약 20 한 2, 3센티 정도 되는 그런 사이즈이기 때문에 전용 가방을 보여드렸다시피 여기다가 쏙 넣으면 되기 때문에 굉장히 심플한 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 44.683,
                "end": 55.086
            },
            {
                "speaker_id": "1",
                "transcription": "근데 만약에 저 같은 경우는 이제 오늘 텐트 안에서 이걸 설치를 해보려고 그랬는데 연통이 기본 연통밖에 없어가지고 그렇게 못할 것 같고 오늘은 밖에서 있다가 나가서 장작이 얼마나 잘 타는지 한번 테스트해보고 거기다가 이제 이 위에다가 뭐 마시멜로라도 좀 구워 먹을까?",
                "sound_type": [
                    2
                ],
                "start": 55.096,
                "end": 71.948
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 그렇게 사용할 생각입니다.",
                "sound_type": [
                    2
                ],
                "start": 71.958,
                "end": 73.894
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 길이가 지금 한 40센티 정도 돼요.",
                "sound_type": [
                    2
                ],
                "start": 73.904,
                "end": 76.352
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 우리가 일반적으로 사용하는 모든 장작 같은 게 다 들어갈 수 있는 그런 사이즈입니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 76.362,
                "end": 81.553
            },
            {
                "speaker_id": "1",
                "transcription": "장작 넣기도 굉장히 물론 이거 열 때는 조금 뜨거우니까 조심하셔야 될 것 같고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 81.563,
                "end": 89.456
            }
        ]
    },
    "summary": "남자는 미니 화목 난로 제품이 조리할 때와 그을음 방지 등을 직접 살펴보며 리뷰해주고 있습니다.",
