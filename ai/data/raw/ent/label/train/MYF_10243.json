        "term": [
            {
                "speaker_id": "1",
                "transcription": "심들은 정말",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.624
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 괜히 막 눈물 나고 슬프네 막 이러시더라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.634,
                "end": 5.478
            },
            {
                "speaker_id": "1",
                "transcription": "아 또 음악도 그런 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.488,
                "end": 8.931
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그게 맞는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.941,
                "end": 10.804
            },
            {
                "speaker_id": "1",
                "transcription": "정말 인생이 짧고 꽃처럼 한순간 그냥 폈다가 지는 거니까 펴 있는 동안 향기롭게 살아야겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.814,
                "end": 23.893
            },
            {
                "speaker_id": "1",
                "transcription": "팀랩 전시 와서 인생을 논하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.903,
                "end": 26.428
            },
            {
                "speaker_id": "2",
                "transcription": "그니까 그래서 또 그런 시각으로 볼 생각을 못 했는데 더 연륜 있으신 분들이 보니까 더 아 저렇게도 생각할 수 있구나 하고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.438,
                "end": 35.043
            },
            {
                "speaker_id": "1",
                "transcription": "그렇네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.053,
                "end": 37.300
            }
        ]
    },
    "summary": "나는 이 작품을 보면서 인생도 꽃처럼 한순간에 피고 지는 것 같았고 피어 있는 동안 향기롭게 살아야겠다고 생각했다.",
