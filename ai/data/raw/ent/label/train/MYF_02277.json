        "term": [
            {
                "speaker_id": "1",
                "transcription": "네, 아 제가 그거를 안 여쭤서 봤나 봐요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.318
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기 있다.",
                "sound_type": [
                    2
                ],
                "start": 3.328,
                "end": 4.196
            },
            {
                "speaker_id": "1",
                "transcription": "네, 30대 여성분이시거든요.",
                "sound_type": [
                    2
                ],
                "start": 4.206,
                "end": 6.724
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여성분이셔서 어 전통적으로 아쿠아 또 우디, 워낙 남자, 남성들의 향수로 인기 받았던 인기 많았던 그 향수여서 그 농도 차이를 좀 알면 좋을 것 같애서요.",
                "sound_type": [
                    2
                ],
                "start": 6.734,
                "end": 21.432
            },
            {
                "speaker_id": "1",
                "transcription": "그거를 한번 알기 위해서 이 향수를 추천을 드려 볼게요.",
                "sound_type": [
                    2
                ],
                "start": 21.442,
                "end": 25.977
            },
            {
                "speaker_id": "1",
                "transcription": "전형적인 옛스러운 남성들의 향수, 우리가 뭐 시프레 계열 뭐 이런 식으로 표현했던 그런 향수들 보다는 좀 더 누그러져 있고 그렇지만 아쿠아의 느낌과 함께",
                "sound_type": [
                    2
