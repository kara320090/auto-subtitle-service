        "term": [
            {
                "speaker_id": "1",
                "transcription": "아고 쪼맣다 쪼매.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.179
            },
            {
                "speaker_id": "1",
                "transcription": "으차 으 5치 6치 될 거 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.189,
                "end": 12.073
            },
            {
                "speaker_id": "1",
                "transcription": "아 사이즈가 변함이 없네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.083,
                "end": 15.035
            },
            {
                "speaker_id": "1",
                "transcription": "심심할 만하면 입질이 계속 와서 뭐 좋긴 한데 사이즈들이 너무 작습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.045,
                "end": 23.028
            },
            {
                "speaker_id": "1",
                "transcription": "지금 시간이 새벽 3시입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.038,
                "end": 25.350
            },
            {
                "speaker_id": "1",
                "transcription": "어 씨알이 커질 기미가 안 보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.340,
                "end": 28.148
            },
            {
                "speaker_id": "1",
                "transcription": "아 이제 월척 하나만 나오면 참 좋을 거 같은데 뭐 그것도 그렇기는 한데 어 참게들이 계속 찌를 가만 놔두지를 않네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.158,
                "end": 38.315
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 참게들이 밤새도록 괴롭히고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.325,
                "end": 44.711
            }
        ]
    },
    "summary": "작은 붕어는 6치 정도 될 거 같고 심심할 만하면 입질이 와서 좋지만 씨알이 커질 기미가 안 보인다며 그리고 참게들이 찌를 가만 놔두질 않아서 밤새도록 괴롭힌다고 전한다.",
