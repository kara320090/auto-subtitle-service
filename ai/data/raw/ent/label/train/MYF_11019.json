        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "@계정1님 좋은 정보에 감사드립니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.826
            },
            {
                "speaker_id": "1",
                "transcription": "싱가포르에서 로마까지 가는 데 비자가 필요한 나라는 어딘가요?",
                "sound_type": [
                    2
                ],
                "start": 1.836,
                "end": 4.731
            },
            {
                "speaker_id": "1",
                "transcription": "싱가포르부터 로마까지 항상 귀향지가 같지는 않을 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 4.741,
                "end": 9.780
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이제 작년에 갔던 곳을 바탕으로 말씀드리면 스리랑카 비자가 필요했구요.",
                "sound_type": [
                    2
                ],
                "start": 9.776,
                "end": 16.832
            },
            {
                "speaker_id": "1",
                "transcription": "인도가 필요했습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.836,
                "end": 18.113
            },
            {
                "speaker_id": "1",
                "transcription": "스리랑카는 온라인에서 ETA를 신청했었구요.",
                "sound_type": [
                    2
                ],
                "start": 18.120,
                "end": 21.036
            },
            {
                "speaker_id": "1",
                "transcription": "인도는 직접 비자 한남동에 있는 비자센터에 가서 발급을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.046,
                "end": 25.733
            },
            {
                "speaker_id": "1",
                "transcription": "참고로 제가 이제 인도에서 3번의 기항을 했는데 세 번이라 제가 복수비자가 필요할 줄 알았어요.",
                "sound_type": [
                    2
                ],
                "start": 25.743,
                "end": 34.900
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 가보니까 크루즈 비자라는 게 또 있더라구요.",
                "sound_type": [
                    2
                ],
                "start": 34.900,
                "end": 38.040
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그거 신청했는데 저랑 같이 갔던 동행은 그냥 일반 관광객 비자를 끊었어요.",
                "sound_type": [
                    2
                ],
                "start": 38.040,
                "end": 44.597
            },
            {
                "speaker_id": "1",
                "transcription": "그걸로도 충분히 여행이 가능했으니까 그 점 참고하시기 바랍니다.",
                "sound_type": [
                    2
                ],
                "start": 44.607,
                "end": 48.818
            },
            {
                "speaker_id": "1",
                "transcription": "@계정2님 이번에도 너무 재밌게 잘 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 48.828,
                "end": 51.791
            },
            {
                "speaker_id": "1",
                "transcription": "객실 사진이나 영상 사진 좀 보여주세요.",
                "sound_type": [
                    2
                ],
                "start": 51.801,
                "end": 53.990
            },
            {
                "speaker_id": "1",
                "transcription": "제작해서 올렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 54.000,
                "end": 55.752
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 55.762,
                "end": 57.668
            }
        ]
    },
    "summary": "싱가포르에서 로마까지 갈 때 비자가 필요한 나라는 스리랑카와 인도가 필요했다고 설명한다.",
