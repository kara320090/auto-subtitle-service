        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 향이 존재하거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.774
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그 피오니의 그 향이란 게 도대체 무엇일까 제 말이 궁금하신 분이시라면은 꼭 한번 시향을 해보시기 바랄게요.",
                "sound_type": [
                    2
                ],
                "start": 1.784,
                "end": 9.588
            },
            {
                "speaker_id": "1",
                "transcription": "조 말론의 잉글리시 페어 앤 프리지아 존 키즈의 그 시에서 영감을 얻은 그런 향이에요.",
                "sound_type": [
                    2
                ],
                "start": 9.598,
                "end": 15.992
            },
            {
                "speaker_id": "1",
                "transcription": "가을에 만나기 좋은 프루티한 향을 여러분이 만날 수 있는 향이에요.",
                "sound_type": [
                    2
                ],
                "start": 16.002,
                "end": 20.745
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로 조 말론의 이런 프루티한 애들 블랙베리 앤 베이나 이런 잉글리시 페어의 프리지어 같이",
                "sound_type": [
                    2
                ],
                "start": 20.755,
                "end": 27.300
            }
        ]
    },
    "summary": "조 말론의 잉글리시 페어 앤 프리지아는 가을에 만나기 좋은 프루티한 향이다.",
