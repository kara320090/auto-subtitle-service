        "term": [
            {
                "speaker_id": "1",
                "transcription": "요렇게 넣으면 끝나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.067
            },
            {
                "speaker_id": "2",
                "transcription": "진짜 간단하게 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.077,
                "end": 2.035
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 간단하지 요즘 밀키트가 이렇게 잘 나와 그리고 한 팩 뜯은 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.045,
                "end": 6.172
            },
            {
                "speaker_id": "1",
                "transcription": "건더기 진짜 장난 아니죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.182,
                "end": 8.146
            },
            {
                "speaker_id": "2",
                "transcription": "냄새가 아닌데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.159,
                "end": 9.533
            },
            {
                "speaker_id": "1",
                "transcription": "밥을 한 숟 한 젓가락만 딱 먹을게 너무 배고파.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.533,
                "end": 12.418
            },
            {
                "speaker_id": "1",
                "transcription": "음 젓가락에 국물이 살짝 묻어있거든.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.426,
                "end": 18.946
            },
            {
                "speaker_id": "1",
                "transcription": "그래 갖고 지금 밥 한 숟가락이 딱 먹고 싶었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.956,
                "end": 22.266
            }
        ]
    },
    "summary": "밀키트가 이렇게 잘 나오며 건더기도 장난 아니고 젓가락에 국물이 살짝 묻어있었는데 그래서 밥을 먹고 싶었다고 말한다.",
