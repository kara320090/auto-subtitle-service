                ],
                "start": 0.000,
                "end": 2.869
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 제가 제이 에디션 에디터님인 @이름2 대표님과 이야기를 나눠보도록 합니다.",
                "sound_type": [
