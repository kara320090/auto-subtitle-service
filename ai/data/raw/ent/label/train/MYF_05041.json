                ],
                "start": 0.000,
                "end": 3.034
            },
            {
                "speaker_id": "2",
                "transcription": "그다음은 스푼으로 담아 드시면 되세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.044,
                "end": 6.131
            },
            {
                "speaker_id": "1",
                "transcription": "네네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.141,
                "end": 8.318
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 플레이 스콘은 방금 나온 거라서 따뜻할 때 먹어야 맛있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.328,
                "end": 12.736
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.746,
                "end": 14.594
            },
            {
                "speaker_id": "2",
                "transcription": "그 다음에는 해쉬브라운 머스켓 해쉬브라운 튀긴거라서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.604,
                "end": 25.259
            },
            {
                "speaker_id": "3",
                "transcription": "알자스 지역에서 생산된 화이트 와인이고요.",
                "sound_type": [
                    2
                ],
                "start": 25.269,
                "end": 28.267
            },
            {
                "speaker_id": "3",
                "transcription": "알베르만 생산자의 와인 공갈닥스 뮤질링크 주년생된 제품이고요.",
                "sound_type": [
                    2
                ],
                "start": 28.277,
                "end": 36.206
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다. 아 알자스 지역에 유기농",
                "sound_type": [
                    2
                ],
                "start": 36.216,
                "end": 42.174
            },
            {
                "speaker_id": "3",
                "transcription": "독일이랑 굉장히 근접해 있는 국경을 거스르는 지역에 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 42.184,
                "end": 46.900
            }
        ]
    },
    "summary": "독일이랑 굉장히 근접해 있는 알자스라는 지역에서 생산된 와인을 마신다.",
