        "term": [
            {
                "speaker_id": "1",
                "transcription": "순둥이야 아이고 예뻐라 우리 참이 아이고 참이 예뻐라 우리 참이 순둥이야 우리 순둥이.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 19.774
            },
            {
                "speaker_id": "1",
                "transcription": "알았어 알았어 엄마 해줄게 엄마 해줄게 아이고 그래 엄마 쓰다듬어 줄게.",
                "sound_type": [
                    2
                ],
                "start": 19.784,
                "end": 25.970
            },
            {
                "speaker_id": "1",
                "transcription": "낸내 해 엄마 쓰다듬어 줄게 낸내 해 아이고 예뻐라 우리 참이.",
                "sound_type": [
                    2
                ],
                "start": 25.980,
                "end": 43.826
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 여기 있어 엄마 여기 있어 걱정 마 어디 안 가 여기 있어 있어 참이 여기 있어 걱정마 낸내 해 엄마 아무 데도 안 가 참이 옆에 있어.",
                "sound_type": [
                    2
                ],
                "start": 43.836,
                "end": 58.172
            },
            {
                "speaker_id": "1",
                "transcription": "손으로 이렇게 쓸어줘야 낸내코코 하고요.",
                "sound_type": [
                    2
                ],
                "start": 58.182,
                "end": 66.355
            },
            {
                "speaker_id": "1",
                "transcription": "어이고 예뻐 예뻐 그렇지 그렇지.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.365,
                "end": 91.547
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 예뻐라 참이 이렇게 예쁘지 우리 참이는 예뻐 참이 예뻐 아이고 예뻐라 엄마가 일어섰어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.557,
                "end": 109.854
            },
            {
                "speaker_id": "1",
                "transcription": "참이 낸내 해 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 109.864,
                "end": 111.911
            }
        ]
    },
    "summary": "여성은 참이를 쓰다듬으며 재우고 있다.",
