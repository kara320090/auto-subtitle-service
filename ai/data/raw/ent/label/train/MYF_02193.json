        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 향수도 마찬가지예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.406
            },
            {
                "speaker_id": "1",
                "transcription": "향수도 많이 경험을 해 보시면 돼요.",
                "sound_type": [
                    2
                ],
                "start": 1.416,
                "end": 4.862
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 근데 너무 선입견으로 아 저건 그냥 무작정 싫어 아니면 나는 그냥 저거는 아닌 것 같애.",
                "sound_type": [
                    2
                ],
                "start": 4.872,
                "end": 10.405
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 물론 그게 또 맞을 때가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 10.415,
                "end": 12.978
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 12.988,
                "end": 13.757
            },
            {
                "speaker_id": "1",
                "transcription": "맞을 때가 있는데 그치만 그래도 그날그날 뭐 나의 기분이나 그리고 나와 함께 하는 사람들 이렇게 사람들마다 또 우리가 늘 같진 않잖아요.",
                "sound_type": [
                    2
                ],
                "start": 13.767,
                "end": 24.282
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 한번은 어 나는 평소에는 저런 건 별로였지만 한번 시도해 볼까 하는 마음으로 시도해 보시면 어떨까?",
                "sound_type": [
                    2
                ],
                "start": 24.292,
                "end": 33.090
            },
            {
                "speaker_id": "1",
                "transcription": "다양한 향수를 많이 많이 경험을 해 보시면 좋겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.100,
                "end": 38.500
            },
            {
                "speaker_id": "1",
                "transcription": "네 다양한 옷을 많이 입어보면서 나에게 맞는 옷을 찾을 수 있듯이 또 사람도 마찬가지잖아요.",
                "sound_type": [
                    2
                ],
                "start": 38.510,
                "end": 45.966
            },
            {
                "speaker_id": "1",
                "transcription": "나에게 맞는 사람들을 알려면 또 많은 사람들을 그래도 뭐 물론 무 그 모든 사람들 하고 다 친구가 되고 뭐 다 사귀고 막 이러기에는 어렵더라도 그래도 많이 인제 이렇게 보다 보면은 우리가 알 수 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 45.976,
                "end": 59.223
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뭐 책도 많이 보고",
                "sound_type": [
                    2
                ],
                "start": 59.233,
                "end": 61.294
            }
        ]
    },
    "summary": "선입견으로 싫어하기보다는 나의 기분이나 함께 하는 사람들에 따라 다양한 향수를 많이 경험해 보면 좋고 다양한 옷을 입어보고 나에게 맞는 옷을 찾을 수 있듯이 나에게 맞는 사람들을 알기 위해 많은 사람들을 보다 보면 알 수 있다.",
