                "end": 4.155
            },
            {
                "speaker_id": "1",
                "transcription": "근데 밑반찬이 잘 나오네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.165,
                "end": 7.661
            },
            {
                "speaker_id": "1",
                "transcription": "그 너무 급하게 들어와 가지고 말은 맛집이라고 해서 한번 와봤습니다.",
