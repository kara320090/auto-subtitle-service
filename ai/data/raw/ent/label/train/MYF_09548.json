                "start": 15.163,
                "end": 27.080
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 눌러주려면은 더 강한 애로 눌러주거나 이제 이래야 되는데 그러면 오히려 반작용이 나죠.",
                "sound_type": [
