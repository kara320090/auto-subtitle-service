                ],
                "start": 0.000,
                "end": 15.153
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 존재감이 뚜렷한 이런 그 남자 스킨 향 뭐 아빠 그런 냄새 뭐 이런 거 우리가 딱 들으면 귀에 귀가 아니라 이제 머리에 떠오르는 그 향이 있잖아요.",
                "sound_type": [
                    2
