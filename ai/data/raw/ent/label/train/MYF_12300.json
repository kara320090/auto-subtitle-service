        "term": [
            {
                "speaker_id": "1",
                "transcription": "표현을 많이 하시죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.243
            },
            {
                "speaker_id": "1",
                "transcription": "주말을 맞아서 위천강 예쁜 포인트로 나와봤는데요.",
                "sound_type": [
                    2
                ],
                "start": 1.253,
                "end": 5.781
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이곳 같은 경우에는 어 인기 낚시 유튜버죠 @계정2님 소개로 와 보게 되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.791,
                "end": 13.119
            },
            {
                "speaker_id": "1",
                "transcription": "이제 막 대 편성 전부 다 완료하고 미끼는 옥수수를 달아 놨습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.129,
                "end": 18.531
            },
            {
                "speaker_id": "1",
                "transcription": "잡어들이 굉장히 많고 블루길도 굉장히 많아서 글루텐은 이따가 밤에 한 번 써봐야 될 것 같고요.",
                "sound_type": [
                    2
                ],
                "start": 18.541,
                "end": 25.194
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 이곳에서 멋진 붕어 만나 볼 수 있도록 화이팅 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.204,
                "end": 30.070
            },
            {
                "speaker_id": "1",
                "transcription": "지금 시작합니다.",
                "sound_type": [
                    2
                ],
                "start": 30.080,
                "end": 31.487
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 올해 들어서 처음으로 폭염 특보가 내려진 날인데요.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 31.497,
                "end": 36.411
            },
            {
                "speaker_id": "1",
