                    2
                ],
                "start": 5.056,
                "end": 7.867
            },
            {
                "speaker_id": "1",
                "transcription": "이거 부스터 보이시나요?",
                "sound_type": [
                    2
                ],
                "start": 7.877,
                "end": 11.843
            },
            {
                "speaker_id": "1",
                "transcription": "여기 부스터라고 지금 나오는데 요거는 제가 있는 거니까 패스 그리고 요거는 어 성원숭이네.",
                "sound_type": [
                    2
                ],
                "start": 11.853,
                "end": 22.983
            },
            {
                "speaker_id": "1",
                "transcription": "오 요건 없는 거니까 지금 뜯을 거고",
                "sound_type": [
                    2
                ],
                "start": 22.993,
                "end": 27.074
            },
            {
                "speaker_id": "2",
                "transcription": "어 오 이브이인데 빈칸에 있는 거라서 패스 어 거북왕이네 거북 있는 거 패스",
