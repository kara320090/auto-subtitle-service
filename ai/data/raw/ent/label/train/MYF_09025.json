        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 한번 써 보시면 좋을 것 같고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.925
            },
            {
                "speaker_id": "1",
                "transcription": "이제는 너무나 유명한 채비죠.",
                "sound_type": [
                    2
                ],
                "start": 1.935,
                "end": 3.779
            },
            {
                "speaker_id": "1",
                "transcription": "얼레 채비, 얼레 찌 그리고 라이어 글루텐입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.789,
                "end": 7.850
            },
            {
                "speaker_id": "1",
                "transcription": "좋은 상품 협찬해 주신 우리 협찬사에 다시 한번 감사 말씀드리며 상품은 좌대에 한 분, 낚싯대 다섯 분 그리고 이 얼레 찌와 글루텐을 묶어서 총 열 분께 보내 드리도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.860,
                "end": 26.089
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 당첨자분이 열여섯 분이 되겠죠.",
                "sound_type": [
                    2
                ],
                "start": 26.099,
                "end": 29.750
            },
            {
                "speaker_id": "1",
                "transcription": "자 지금 이 영상 보시는 대로 바로 댓글 남겨 주시고 저는 다음에 더 좋은 영상으로 찾아뵙도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.760,
                "end": 37.679
            },
            {
                "speaker_id": "1",
                "transcription": "다시 한번 우리 구독자, 시청자 형님들께 감사 말씀드리며 항상 좋은 붕어 보여 드릴 수 있도록 노력하는 @이름1이 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.689,
                "end": 49.483
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 49.493,
                "end": 50.812
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 여기까지.",
                "sound_type": [
                    2
                ],
                "start": 50.822,
                "end": 54.601
            }
        ]
    },
