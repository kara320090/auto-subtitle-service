        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 뭔가 이런 기분 알아요 여러분",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.666
            },
            {
                "speaker_id": "1",
                "transcription": "이 드라마가 되게 재밌어.",
                "sound_type": [
                    2
                ],
