        "term": [
            {
                "speaker_id": "1",
                "transcription": "마라케시도 있고 뭐 테싯도 있고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.334
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요.",
                "sound_type": [
                    2
                ],
                "start": 2.344,
                "end": 2.642
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 또 새로 나온 것도 있더라고요.",
                "sound_type": [
                    2
                ],
                "start": 2.652,
                "end": 4.429
            },
            {
                "speaker_id": "1",
                "transcription": "제가 지금 2통째 쓰고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 4.439,
                "end": 6.564
            },
            {
                "speaker_id": "1",
                "transcription": "있어서",
                "sound_type": [
                    2
                ],
                "start": 6.574,
                "end": 7.209
            },
            {
                "speaker_id": "2",
                "transcription": "이 휠이 그 조양사 분이 바나베 피용인데 본초학 하고 식물학을 굉장히 잘 정통하신 또 분이세요.",
                "sound_type": [
                    2
                ],
                "start": 7.219,
                "end": 15.006
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 이 바나베 피용은 또 로얄 살루트라는 위스키 브랜드의 거기에서 그 향 향 디렉터로 또 계시거든요.",
                "sound_type": [
                    2
                ],
                "start": 15.016,
                "end": 24.396
            },
            {
                "speaker_id": "2",
                "transcription": "그분 자체의 특징이 이런 향을 어 식물에 기반되는 자연의 그런 느낌을 굉장히 잘 표현을 하세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.406,
                "end": 32.977
            },
            {
                "speaker_id": "1",
                "transcription": "맞아요.",
                "sound_type": [
                    2
                ],
                "start": 32.987,
                "end": 33.352
            },
            {
                "speaker_id": "1",
                "transcription": "자연에 있는 느낌이 확 나요.",
                "sound_type": [
                    2
                ],
                "start": 33.362,
                "end": 35.045
            },
            {
                "speaker_id": "2",
                "transcription": "정말로 자연에 있는 듯한 느낌이 나서 사실 이런 절간이면 늘 가고 싶을 것 같은데요.",
                "sound_type": [
                    2
                ],
                "start": 35.055,
                "end": 40.755
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이거를 아침 출근 때 매번 뿌리는 이유가 저는 전철을 되게 오래 타고 다녀요.",
                "sound_type": [
                    2
                ],
                "start": 40.765,
                "end": 46.900
            }
        ]
    },
    "summary": "이솝의 휠은 자연에 있는 느낌을 주는 향이라고 이야기합니다.",
