        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "피스타치오 같은 경우에는 이렇게 들고 다니기가 너무 편해가지고",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.438
            },
            {
                "speaker_id": "1",
                "transcription": "또 껍질에 쌓여져 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 3.448,
                "end": 5.206
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그냥 정말 이렇게 뭐 으스러지거나 이러지 않으니까 조금 해가지고 들고 다니기도 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 5.216,
                "end": 11.647
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 입이 심심하다 이럴 때 책 쓰다가 좀 집중이 안 되고",
                "sound_type": [
                    2
                ],
                "start": 11.657,
                "end": 16.067
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 그래도 씹는 즐거움이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 16.077,
                "end": 18.387
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그런 거를 좀 즐기고 싶을 때 저는 피스타치오 껍질을 엽니다.",
                "sound_type": [
                    2
                ],
                "start": 18.397,
                "end": 23.298
            },
            {
                "speaker_id": "1",
                "transcription": "저의 스트레스 해소 방식 중의 하나가 인제 음식을 활용하는 게 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 23.308,
                "end": 27.350
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 요리를 하거나 이런 건 아니고요.",
                "sound_type": [
                    2
                ],
                "start": 27.360,
                "end": 29.513
            },
            {
                "speaker_id": "1",
                "transcription": "인제 피스타치오를 하나 집어서 이렇게 껍질을 딱",
                "sound_type": [
                    2
                ],
                "start": 29.523,
                "end": 34.080
            }
        ]
    },
    "summary": "피스타치오 같은 경우에는 이렇게 들고 다니기가 너무 편해가지고 또 껍질에 쌓여져 있어서 그냥 으스러지거나 이러지 않으니까 조금 해가지고 들고 다니기도 하는데 씹는 즐거움이 있어서 그런 거를 즐기고 싶을 때 피스타치오 껍질을 연다고 한다.",
