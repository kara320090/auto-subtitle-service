        "term": [
            {
                "speaker_id": "1",
                "transcription": "사실 파는 살까 말까 고민 진짜 많이 했거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.897
            },
            {
                "speaker_id": "1",
                "transcription": "파를 굳이 꼭 사야 되나 하다가 그래도 또 파가 하는 역할이 있는 거니까 파도 샀고 진간장 간장을 다 썼더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.907,
                "end": 12.510
            },
            {
                "speaker_id": "1",
                "transcription": "두부 아니 밥만 먹으면 너무 탄수화물 과섭취일 수도 있으니까 단백질도 섭취할 겸 탄수화물 섭취도 줄일 겸 코크 아니 근데 콜라를 먹어야 되는 게 제가 사실 맥주 1잔 하려고 했는데 이따가 당근 마켓 거래를 하러 가야 돼서 운전을 해야 된다 말이죠.",
                "sound_type": [
                    2
                ],
                "start": 12.520,
                "end": 33.888
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 술을 못 먹어서 이렇게 제로 콜라도 하나 샀고 다진 마늘 다진 마늘은 무조건 필수적으로 필요한 존재인 것 같아서 원래는 그냥 마늘을 사서 내가 다지려고 했는데 마늘 상태가 별로 안 좋기도 했고 너무 비싼 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.898,
                "end": 51.513
            },
            {
                "speaker_id": "1",
                "transcription": "그 뭐 이만큼 들어 있는데 막 삼사오천 원 하는 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.523,
                "end": 54.685
            },
            {
                "speaker_id": "1",
                "transcription": "그래 가지고 그냥 다진 마늘이 더 음 합리적인 것 같아서 샀고 삼겹살로 샀어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 54.695,
                "end": 61.186
            },
            {
                "speaker_id": "1",
                "transcription": "두루치기할 때 넣는 고기가 무슨 종류의 고기인지 생각해 보니까 모르겠는 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.196,
                "end": 67.522
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 오겹살이랑 삼겹살 중 고민을 했는데 오겹살에 비계가 진짜 너무 많은 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 67.532,
                "end": 74.334
            },
            {
                "speaker_id": "1",
                "transcription": "그래 가지고 그냥 고기 조금 더 많이 있는 삼겹살로 1번 샀습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 74.344,
                "end": 79.742
            },
            {
                "speaker_id": "1",
                "transcription": "우선 손은 씻었고 제가 만들 줄 모르기 때문에 영상을 1번 참고를 해 볼게요.",
                "sound_type": [
                    2
                ],
                "start": 79.752,
                "end": 85.994
            },
            {
                "speaker_id": "1",
                "transcription": "다행히도 양파는 집에 있었다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 86.004,
                "end": 91.800
            }
        ]
    },
    "summary": "파, 진간장, 단백질 섭취를 위한 두부, 맥주 대신 콜라, 다진 마늘, 오겹살 대신 삼겹살을 샀고 요리하기 전 영상을 참고하도록 하겠다.",
