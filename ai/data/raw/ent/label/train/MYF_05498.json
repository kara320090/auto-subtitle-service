    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "댓글이 너무 길어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.102
            },
            {
                "speaker_id": "1",
                "transcription": "이제부터는 조금 댓글을 제가 요약을 해봤거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.112,
                "end": 3.579
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 먼저 @계정1 님이 구독자 3000명 돌파를 축하해 주시면서 육아 휴직 후에 복직한 와이프에게 안나루이사 제품을 선물하고 싶으시다라고 말씀을 해주셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.589,
                "end": 14.360
            },
            {
                "speaker_id": "1",
                "transcription": "회사에 빌런이 있으셨대요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.370,
                "end": 16.469
            },
            {
                "speaker_id": "1",
                "transcription": "물리쳤는지는 모르겠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.479,
                "end": 17.791
            },
            {
                "speaker_id": "1",
                "transcription": "회사에 잘 적응해서 육아 휴직 후 복직에 성공하셨다 이런 댓글을 달아주셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.801,
                "end": 22.727
            },
            {
                "speaker_id": "1",
                "transcription": "참 저도 이제 회사 생활 15년 차인데 회사 생활 힘들다 공감이 됐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.737,
                "end": 28.072
            },
            {
                "speaker_id": "1",
                "transcription": "우리 구독자님들한테 좀 드리고 싶은 얘기는 어딜 가든 빌런은 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.082,
                "end": 32.663
            },
            {
                "speaker_id": "1",
                "transcription": "사람은 혼자 살 수 없는 사회적 동물이기 때문에 내가 회사에 안 나가면 가정에서 빌런이 생긴다 무시하는 게 최고야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.673,
                "end": 40.146
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 그런 사람들은 걸러지게 되어있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.156,
                "end": 42.141
            },
            {
                "speaker_id": "1",
                "transcription": "나한테만 빌런이 아니고 뭔가 일희일비하고 뭐 내 일을 할 걸 못한다든가 그 그런 거를 안 했으면 좋겠그래서 회사 생활은 딱 기본만 잘 지키면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.151,
                "end": 49.897
            },
            {
                "speaker_id": "1",
                "transcription": "일단 인사 잘하고 내 할 거 제대로 하고 또 시간 잘 지키고 고마워할 때 고마워하고 미안해할 때 미안해하고 다른 사람들 힘들다고 할 때 위로까지 하면 그 사람은 진짜 괜찮은 사람이고 이것까지 할 필요도 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.907,
                "end": 58.695
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 회사 생활은 무난하게 할 수 있지 않을까 휘둘릴 필요가 전혀 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.705,
                "end": 63.600
            }
        ]
    },
    "summary": "발화자는 회사 생활 15년 차인데 회사 생활 힘들다는 말에 공감이 되었다고 회사 생활을 어떻게 하면 되는지에 대해서 이야기하고 있다.",
