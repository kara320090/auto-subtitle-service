        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 되게 유명한 일화가 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.662
            },
            {
                "speaker_id": "1",
                "transcription": "장 폴 겔랑의 그 책에 나오는 일화인데 그게 이제 이 책에도 등장을 해요.",
                "sound_type": [
                    2
                ],
                "start": 1.672,
                "end": 6.704
            },
            {
                "speaker_id": "1",
                "transcription": "그 원료 중에 하나가 너무 부족해 가지고 어 어떻게 할까?",
                "sound_type": [
                    2
                ],
                "start": 6.714,
                "end": 10.324
            },
            {
                "speaker_id": "1",
                "transcription": "했는데 장 폴 겔랑이 그 원료를 이제 합성으로 정확하게 이제 만들어내 가지고 그래 이번에 이번 대에 조향은 네가 하면 되겠다.",
                "sound_type": [
                    2
                ],
                "start": 10.334,
                "end": 20.822
            },
            {
                "speaker_id": "1",
                "transcription": "장 폴 겔랑에 쓴 책에 나와 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 20.832,
                "end": 23.022
            },
            {
                "speaker_id": "1",
                "transcription": "사실 그 겔랑 집안은 그 대에서는 딱 한 사람만 경영에 참여를 하게끔 만들어요.",
                "sound_type": [
                    2
                ],
                "start": 23.032,
                "end": 29.490
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 그게 이제 조향을 할 수 있는 사람이고 그래서 나머지 사람들은 절대 경영에 참여를 못 시켜요.",
                "sound_type": [
                    2
                ],
                "start": 29.500,
                "end": 36.333
            }
        ]
    },
    "summary": "장 폴 겔랑의 일화인데 부족한 원료를 합성으로 정확하게 만들어내서 조향과 경영에 참여하게 되었고 그 대에서는 한 사람만 경영에 참여할 수 있어서 이외에 사람들은 경영에 참여하지 못 한다고 합니다.",
