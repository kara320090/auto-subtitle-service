                    2
                ],
                "start": 4.148,
                "end": 15.792
            },
            {
                "speaker_id": "1",
                "transcription": "똑같은 사람이 없듯이 그 사람들을 표현하는 향수 역시 수없이 많겠죠.",
                "sound_type": [
                    2
                ],
                "start": 15.802,
                "end": 22.040
            },
            {
                "speaker_id": "1",
                "transcription": "프랑스 이탈리아 미국 독일 캐나다 등을 넘어 한국에서도 많은 니치 향수 브랜드들이 등장하고 또 만날 수 있기를 바래봅니다.",
                "sound_type": [
