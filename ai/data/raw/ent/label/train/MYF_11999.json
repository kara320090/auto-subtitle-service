                ],
                "start": 4.576,
                "end": 19.271
            },
            {
                "speaker_id": "1",
                "transcription": "그 복숭아 향이 왜 복숭아 그 표면에 그런 잔털처럼 이렇게 이렇게 막 등장하는 그 고런 터치들이 이렇게 살짝살짝 존재를 하거든요.",
                "sound_type": [
