        "term": [
            {
                "speaker_id": "1",
                "transcription": "좋아요 구독하기 네 꼭 부탁드리겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.340
            },
            {
                "speaker_id": "1",
                "transcription": "어 해도 해도 익숙하지가 않은 열심히 제가 또 노력을 해서 익숙하게 말씀드리도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 4.357,
                "end": 11.760
            },
            {
                "speaker_id": "1",
                "transcription": "좋아요 구독 눌러주세요.",
                "sound_type": [
                    2
                ],
                "start": 11.760,
                "end": 14.210
            },
            {
                "speaker_id": "1",
                "transcription": "네 그러면 오늘 향수 추천은 여기까지 하도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 14.210,
                "end": 19.181
            },
            {
                "speaker_id": "1",
                "transcription": "네 정말 고맙고 또 건강하시고 향기로운 하루 보내시길 바랄게요.",
                "sound_type": [
                    2
                ],
                "start": 19.190,
                "end": 23.840
            },
            {
                "speaker_id": "1",
                "transcription": "들어가겠습니다.",
                "sound_type": [
