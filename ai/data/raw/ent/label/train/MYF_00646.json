                ],
                "start": 0.000,
                "end": 0.651
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 본인이 원치 않을 때 이렇게 사람들이 마구 만지고 이러는 거는 엄청 싫어하는 친구들도 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.661,
                "end": 10.040
            },
            {
                "speaker_id": "1",
                "transcription": "뜨라 언젠가는 엄마한테 꼭 안겨.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.040,
                "end": 14.986
            },
            {
                "speaker_id": "1",
                "transcription": "고마워 우리 뚜리.",
