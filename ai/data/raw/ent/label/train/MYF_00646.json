                    2,
                    3
                ],
                "start": 14.996,
                "end": 18.488
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 쑥이를 안아봤어요 무릎에 아이 행복해라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.498,
                "end": 23.637
            },
            {
                "speaker_id": "1",
                "transcription": "아이 행복해라 아이 행복해라 아이 행복해라 쑥이 꼬리도 아이 행복해라.",
                "sound_type": [
