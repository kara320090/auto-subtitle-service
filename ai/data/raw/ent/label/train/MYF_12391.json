        "term": [
            {
                "speaker_id": "1",
                "transcription": "낚시만 나오면 시간 참 잘 갑니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.044
            },
            {
                "speaker_id": "1",
                "transcription": "우리 사모님이 싸준 도시락 먹고 낚시 이어가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.054,
                "end": 6.402
            },
            {
                "speaker_id": "1",
                "transcription": "잡어들이 너무 붙어서 힘든 낚시 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.412,
                "end": 10.297
            },
            {
                "speaker_id": "1",
                "transcription": "먹고 파이팅 해보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.307,
                "end": 11.899
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 메뉴는 볶음밥이네요.",
                "sound_type": [
                    2
                ],
                "start": 11.909,
                "end": 23.776
            },
            {
                "speaker_id": "1",
                "transcription": "뭐냐.",
                "sound_type": [
                    2
                ],
                "start": 23.786,
                "end": 26.850
            },
            {
                "speaker_id": "1",
                "transcription": "계속 지저분한 입질이 이어지고 있는데 범인은 이 살치였습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.859,
                "end": 33.760
            },
            {
                "speaker_id": "1",
                "transcription": "어쩐지 찌를 굉장히 경박스럽게 놀리더라고요.",
                "sound_type": [
                    2
                ],
                "start": 33.770,
                "end": 37.709
            },
            {
                "speaker_id": "1",
                "transcription": "꽁치입니다 꽁치.",
                "sound_type": [
                    2
                ],
                "start": 37.719,
                "end": 39.780
            },
            {
                "speaker_id": "1",
                "transcription": "한 대를 접고 60대를 한번 넣어볼까 합니다.",
                "sound_type": [
                    2
                ],
                "start": 39.790,
                "end": 42.714
            },
            {
                "speaker_id": "1",
                "transcription": "변화를 줘야 될 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.724,
                "end": 44.048
            },
            {
                "speaker_id": "1",
                "transcription": "입질이 없으면 이것저것 해보는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 44.058,
                "end": 46.796
            }
        ]
    },
    "summary": "한 남성이 도시락을 먹으며 낚시를 하는데 입질이 없어 낚싯대를 바꾸려고 하고 있다.",
