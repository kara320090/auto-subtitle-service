        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고 저희 향수들 히어리즈 코리아에 네, 저희 이 전시 동안만 제가 그린 그림을 스티커인데 그 그림을 저희가 어 저희 향수들이 입고 있을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 14.829
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 편하게 시향을 하시고 네, 세종대왕, 신사임당, 이순신, 허난설헌 그리고 저희 향수와 함께 퍼퓸들 바디로션 세종대왕, 신사임당도 만나실 수 있고요.",
                "sound_type": [
