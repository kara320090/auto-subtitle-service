        "term": [
            {
                "speaker_id": "1",
                "transcription": "붕업니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.826
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 보내주겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.836,
                "end": 3.967
            },
            {
                "speaker_id": "1",
                "transcription": "가라.",
                "sound_type": [
                    1,
                    2,
                    4,
                    5
                ],
                "start": 3.977,
                "end": 10.004
            },
            {
                "speaker_id": "1",
                "transcription": "예정에도 없던 짬 낚시 왔습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.014,
                "end": 13.282
            },
            {
                "speaker_id": "1",
                "transcription": "우리 형님들 긴급 호출을 받고 와 봤는데 이쪽에서 지금 고기들이 꽤 나온다고 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.292,
                "end": 19.464
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이 밑으로 내려가서 이 다리 아래서 해 보려고 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.474,
                "end": 23.477
            },
            {
                "speaker_id": "1",
                "transcription": "아 파라솔도 필요 없고 그냥 짧은 대로 한 번 해 보겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.487,
                "end": 27.777
            },
            {
                "speaker_id": "1",
                "transcription": "자 라이어 글루텐 말아놨고요.",
                "sound_type": [
                    2
                ],
                "start": 27.787,
                "end": 29.832
            },
            {
                "speaker_id": "1",
                "transcription": "어 물색 아주 좋습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.842,
                "end": 31.274
            },
            {
                "speaker_id": "1",
                "transcription": "대편성 시작 해보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.284,
                "end": 32.965
            },
            {
                "speaker_id": "1",
                "transcription": "위에 다리가 있어서 긴 대는 못 씁니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 32.975,
                "end": 35.936
            },
            {
                "speaker_id": "1",
                "transcription": "아주 짧은 대 위주로 편성하겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 35.946,
                "end": 42.657
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하세요 형님들 @계정1 인사드립니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 42.667,
                "end": 45.796
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 남도의 어느 수로로 나와 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 45.806,
                "end": 49.446
            },
            {
                "speaker_id": "1",
                "transcription": "제가 위치한 포인트는 다리 바로 아래인데요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 49.456,
                "end": 52.059
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 파라솔 없이도 그늘이 지고 시원하게 낚시를 할 수 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 52.069,
                "end": 56.890
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이곳에서 멋진 붕어 만나볼 수 있도록 파이팅 하겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 56.900,
                "end": 61.495
            },
            {
                "speaker_id": "1",
                "transcription": "지금 시작합니다.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 61.505,
                "end": 64.230
            }
        ]
    },
    "summary": "40대 남성이 잡은 붕어를 놓아주고 예정에 없던 짬 낚시를 가게 되었으며 자신이 방문한 낚시 장소에 대해 소개한다.",
