        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 벽엔 뭘 할 거냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.543
            },
            {
                "speaker_id": "1",
                "transcription": "차쟁이 성지의 필수 스티커를 붙이는 공간이 필요하잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.553,
                "end": 6.070
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 스티커를 붙이도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.080,
                "end": 9.076
            },
            {
                "speaker_id": "1",
                "transcription": "물론 1번 스티커는 제가 붙일 거예요, 뿅.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.086,
                "end": 12.084
            },
            {
                "speaker_id": "1",
                "transcription": "아, 안 뜯어져.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.094,
                "end": 20.965
            },
            {
                "speaker_id": "1",
                "transcription": "아, 여러분 초창기 스티커의 가장 큰 문제점은 이게 어, 재작년 스티커였던 것 같은데 어, 스티커를 붙이기가 되게 힘들다는 거였어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.975,
                "end": 32.202
            },
            {
                "speaker_id": "1",
                "transcription": "됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.212,
                "end": 33.160
            },
            {
                "speaker_id": "1",
                "transcription": "난이도가 되게 높았어요, 스티커를 붙이는 데 있어서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.170,
                "end": 38.800
            }
        ]
    },
    "summary": "한쪽 벽은 차쟁이 성지의 필수 스티커를 붙이는 공간이다.",
