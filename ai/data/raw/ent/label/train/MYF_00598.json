                    2,
                    3,
                    5
                ],
                "start": 12.899,
                "end": 17.597
            },
            {
                "speaker_id": "1",
                "transcription": "꼬리가 조금 굽었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.607,
                "end": 19.474
            },
            {
                "speaker_id": "1",
                "transcription": "하하하하 자 아기들의 아침은 이렇게 시작됩니다.",
                "sound_type": [
                    2,
