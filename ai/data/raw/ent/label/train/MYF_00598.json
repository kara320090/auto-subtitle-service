        "term": [
            {
                "speaker_id": "1",
                "transcription": "밥도 잘 먹고 순수한 친구고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.039
            },
            {
                "speaker_id": "1",
                "transcription": "요 친구는요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.049,
                "end": 3.926
            },
            {
                "speaker_id": "1",
                "transcription": "둘째 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.936,
                "end": 5.834
            },
            {
                "speaker_id": "1",
                "transcription": "꼬리는 둘 다 안 굽었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.844,
                "end": 9.713
            },
            {
                "speaker_id": "1",
                "transcription": "요 뒤에 있는 요 친구는 막내고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.723,
                "end": 12.889
            },
            {
                "speaker_id": "1",
                "transcription": "어 성질이 쪼금 제일 어 엄마를 많이 찾고요.",
