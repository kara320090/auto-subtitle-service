                "speaker_id": "2",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다니고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.696
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 프리랜서 에디터로 글도 쓰고 가끔 비주얼 디렉팅도 하고 그렇게 지내고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.706,
                "end": 6.055
            },
            {
                "speaker_id": "2",
                "transcription": "향수에 관심 많으신 분들이나 향수 또 공부하시는 분들이면 한 번쯤은 봤을 그 책이거든요 씨센트.",
                "sound_type": [
                    2
                ],
                "start": 6.065,
                "end": 13.192
            },
            {
                "speaker_id": "2",
                "transcription": "향수 컬렉션도 많이 가지고 계시고 해서 사실은 정말 궁금했었어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.202,
                "end": 17.485
            },
            {
                "speaker_id": "2",
                "transcription": "기자님 향수 컬렉션이",
                "sound_type": [
                    2
                ],
                "start": 17.495,
                "end": 19.147
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜요.",
                "sound_type": [
                    2
                ],
                "start": 19.157,
                "end": 20.005
            },
            {
                "speaker_id": "2",
                "transcription": "그래가지고 제가 쫄랐어요.",
                "sound_type": [
                    2
                ],
                "start": 20.015,
                "end": 21.289
            },
            {
                "speaker_id": "2",
                "transcription": "쫄랐어요.",
                "sound_type": [
                    2
                ],
                "start": 21.299,
                "end": 22.192
            },
            {
                "speaker_id": "1",
                "transcription": "네, 그분이 일단 멋있어 가지고 저는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.202,
                "end": 24.945
            },
            {
                "speaker_id": "2",
                "transcription": "네 네.",
                "sound_type": [
                    2
                ],
                "start": 24.955,
                "end": 26.009
            },
            {
                "speaker_id": "1",
                "transcription": "네, 그분",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.019,
                "end": 27.180
            },
            {
                "speaker_id": "2",
                "transcription": "네, 그분 상속자 네, 그분",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.190,
                "end": 29.455
            },
            {
                "speaker_id": "1",
                "transcription": "그분이 지금은 오피셜 계정을 인스 인스타그램 계정을 누군가 관리해 주는 거 같은데 그분이 예전에 처음에 자기 개인 계정처럼 운영을 했었거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.465,
                "end": 36.806
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 이제 막 라이프 스타일 막 동경이 되면서 너무 멋있는 거예요. 게다가 케이스가 되게 남다른 또 자기의 철학을 가지고 만든 거잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.816,
                "end": 48.117
            },
            {
                "speaker_id": "2",
                "transcription": "남다르시죠.",
                "sound_type": [
                    2
                ],
                "start": 48.127,
                "end": 48.859
            },
            {
                "speaker_id": "1",
                "transcription": "가 버리지 말고 이걸 클러치로 쓰라고",
                "sound_type": [
                    2
                ],
                "start": 48.869,
                "end": 50.980
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요.",
                "sound_type": [
                    2
                ],
                "start": 50.990,
                "end": 51.670
            },
            {
                "speaker_id": "1",
                "transcription": "만들어 주셨는데 사실 여기 넣을 수 있는 게 없어요.",
                "sound_type": [
                    2
                ],
                "start": 51.680,
                "end": 54.095
            },
            {
                "speaker_id": "1",
                "transcription": "그래서",
                "sound_type": [
                    2
                ],
                "start": 54.105,
                "end": 56.290
            },
            {
                "speaker_id": "2",
                "transcription": "향수만 넣어놓고 다니라고",
                "sound_type": [
                    2
                ],
                "start": 56.300,
                "end": 57.841
            },
            {
                "speaker_id": "1",
                "transcription": "들고 다닌 적은 없지만 여하튼 되게 소장욕을 느꼈고 향 자체도 저는 뭐 너무 좋아하는 향 위주여서",
                "sound_type": [
                    2
                ],
                "start": 57.851,
                "end": 65.166
            }
        ]
    },
    "summary": "프리랜서 에디터로 일하고 있는 기자님이 소장욕을 느낀 향수의 케이스는 버리지 말고 클러치로 쓰라는 철학을 가진 분이 만든 거다.",
