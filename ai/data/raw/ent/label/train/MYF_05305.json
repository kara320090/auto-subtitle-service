        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이거 여름에 대박 나겠는데요?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 2.011
            },
            {
                "speaker_id": "1",
                "transcription": "와 자 이 맥주가 특허를 받은 거래요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 2.021,
                "end": 6.451
            },
            {
                "speaker_id": "1",
                "transcription": "이게 또 그 급랭의 정도에 따라서 단계가 있다고 합니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.461,
                "end": 9.517
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래서 이 위에 이 아이스가 맥주를 아주 시원하게 만들어주는",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.527,
                "end": 14.418
            },
            {
                "speaker_id": "1",
                "transcription": "그 우리가 맥주 먹다가 뭐 이야기하고 뭐 잠깐 화장실 갔다 오거나 맥주가 되게 밍밍해지고 김빠지는데 그런 것들을 완전히 원천 차단하는",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.428,
                "end": 22.618
            },
            {
                "speaker_id": "1",
                "transcription": "에 그래서 이제 급랭 맥주고 맥주의 생명은 사실 차가움 아니겠어요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.628,
                "end": 27.805
            },
            {
                "speaker_id": "1",
                "transcription": "네 청량감과 그래서 그 두 가지를 제대로 보존할 수 있다고 하니까 일단은 제가 한번 먹어보겠습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.815,
                "end": 33.321
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 먹기 전에 반 건조 오징어",
                "sound_type": [
                    2,
                    4
                ],
                "start": 33.331,
                "end": 35.502
            }
        ]
    },
