        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 쫄깃하고 정말 맛있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.920
            },
            {
                "speaker_id": "1",
                "transcription": "정말 지금 들으셨죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.926,
                "end": 3.866
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 맛있다는 말이 바로 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.866,
                "end": 5.783
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 이 집의 하이라이트 메뉴 된장찌개 이 된장찌개가 진짜 별미인데요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.786,
                "end": 11.062
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 먹어도 너무 맛있고 밥이랑 함께 먹어도 아주 맛이 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.072,
                "end": 15.172
            },
            {
                "speaker_id": "1",
                "transcription": "소고기가 잔뜩 들어가 있고 두부도 큼직하게 들어가 있고 된장 맛이 정말 예술입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.182,
                "end": 20.883
            },
            {
                "speaker_id": "1",
                "transcription": "된장찌개 먹으러라도 다시 한번 찾고 싶은 집입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.893,
                "end": 24.617
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 깻잎에다가 한 쌈 싸서 맛있게 먹어봅니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.627,
                "end": 29.233
            }
        ]
    },
    "summary": "하이라이트 메뉴 된장찌개는 밥이랑 함께 먹어도 맛이 좋고 예술이라고 한다.",
