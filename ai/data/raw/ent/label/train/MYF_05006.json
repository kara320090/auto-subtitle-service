        "term": [
            {
                "speaker_id": "1",
                "transcription": "음 그런 것도 중요하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.104
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 이거는 로즈 잼 같은 경우에는 이미 저희가 사실 이것도 바닐라리랑 되게 비슷한데 바닐라리라는 향도 저희 러쉬 중에서 되게 오랫동안 계속 같이 하는 향 중에 하난데 그 향이 예전에 왜 바닐라 마운틴이라고 해서 정말 예전에 나왔던 베쓰밤이 있었는데 되게 인기가 많았다고 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.114,
                "end": 22.898
            },
            {
                "speaker_id": "2",
                "transcription": "정말 인기가 많았어서 그 제품에서 향수로 넘어온, 보통 이제 반대 경우들이 많은데 그렇게 된 경우고 요즘 마찬가지로 로즈 아르간 보디 컨디셔너라고 해서 @이름1님이 이제 개발하신 그 되게 또 인기많은 보디 컨디셔너가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.908,
                "end": 38.688
            },
            {
                "speaker_id": "2",
                "transcription": "거기에서 되게 좀 인기가 많아지면서 샤워 젤이 한정으로 나왔었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.698,
                "end": 43.030
            },
            {
                "speaker_id": "2",
                "transcription": "이제 그 뭐지 크리스마스 샤워 젤로 로즈 잼이라는 샤워 젤이 나왔는데 또 그게 또 너무 인기가 많아 지면서 저희가 아예 이제 온 고잉 제품으로 자리를 잡았거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.040,
                "end": 51.751
            },
            {
                "speaker_id": "2",
                "transcription": "그 같은 향으로 이제 향수가 나온",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.761,
                "end": 54.748
            },
            {
                "speaker_id": "1",
                "transcription": "어 기대돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.758,
                "end": 55.719
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 이거는 다마스크 장미가 굉장히 많이 들어가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.729,
                "end": 58.744
            },
            {
                "speaker_id": "2",
                "transcription": "좀 달큼한 느낌의 장미 계열인데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.754,
                "end": 62.929
            }
        ]
    },
