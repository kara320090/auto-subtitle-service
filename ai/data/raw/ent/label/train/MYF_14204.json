                "start": 0.000,
                "end": 1.637
            },
            {
                "speaker_id": "1",
                "transcription": "스티커에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.647,
                "end": 3.198
            },
            {
                "speaker_id": "1",
                "transcription": "스티커 부착하는 것이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.208,
                "end": 4.811
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러면 이거 하고 이 비닐하고 이것은 무엇인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.821,
                "end": 8.939
            },
            {
                "speaker_id": "1",
                "transcription": "그것은 여기 앞에 보시면 이렇게 요렇게 은박이 되어 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.949,
                "end": 15.584
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 부분을 칼로 절개를 하시고 이 부분에 이 비닐 이렇게 접착제로 다 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.594,
                "end": 25.355
            },
            {
                "speaker_id": "1",
                "transcription": "비닐을 안쪽에서 안쪽에서 요렇게 안쪽에서 붙이셔서",
