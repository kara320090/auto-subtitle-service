                    2
                ],
                "start": 7.113,
                "end": 7.188
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 살면서 그들과 나의 공통점이 무언가를 찾으면서 그렇게 이걸 시작했대요.",
                "sound_type": [
                    2
                ],
