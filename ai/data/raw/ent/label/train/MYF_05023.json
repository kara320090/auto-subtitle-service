                "sound_type": [
                    2
                ],
                "start": 5.034,
                "end": 5.917
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 이방인으로",
                "sound_type": [
                    2
                ],
                "start": 5.927,
                "end": 7.103
            },
            {
                "speaker_id": "2",
