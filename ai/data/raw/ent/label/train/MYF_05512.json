    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 보통 주말을 쉬는 직장인들은 주말이 정말 기다려지고 정말 소중한 시간이거든.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.915
            },
            {
                "speaker_id": "1",
                "transcription": "그런 시간에 나 같은 경우만 봐도 내가 젤 소중하다고 생각하는 사람을 만나거든?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.925,
                "end": 12.594
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 남자친구라던가 가족이라던가 아니면 진짜 친한 친구라던가 만나면은 이제 편하고 재밌고 즐거운 사람들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.604,
                "end": 19.380
            },
            {
                "speaker_id": "1",
                "transcription": "평일날 저녁에 계속 약속을 잡는다 그런 거는 나한테 시간을 할애하고 싶지 않아서 평일 저녁에 약속을 잡는 경우일 수가 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.390,
                "end": 30.375
            },
            {
                "speaker_id": "1",
                "transcription": "근데 음 단 예외인 경우는 뭐 평일 저녁에도 보자 그러고 주말에도 보자 그러고 그런 사람은 제외겠지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.385,
                "end": 36.612
            },
            {
                "speaker_id": "1",
                "transcription": "근데 유독 막 금요일 저 금요일 저녁이라던가 토요일 날 바쁘대 약속 있대 수요일, 목요일 막 이럴 때 보자는 남자애들이 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.622,
                "end": 45.808
            },
            {
                "speaker_id": "1",
                "transcription": "그런 애들은 나를 진지하게 생각하지 않는 경우일 수가 있지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.818,
                "end": 49.589
            },
            {
                "speaker_id": "1",
                "transcription": "내가 퍼스트가 아니고 뭐 세컨드 뭐 이 정도가 될 수 있지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.599,
                "end": 52.830
            },
            {
                "speaker_id": "1",
                "transcription": "나를 간 보는 남자일 수도 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.840,
                "end": 54.978
            },
            {
                "speaker_id": "1",
                "transcription": "막 자기가 평일날 집에 가서 할 게 없는 거야 그러니까 어차피 밥은 먹어야 되겠고 그리고 뭐 술 좋아하면 술 도 좀 땡기고 근데 혼자 먹기는 좀 심심하니까 썸녀를 부르는 거지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.988,
                "end": 64.804
            },
            {
                "speaker_id": "1",
                "transcription": "어 나에 대한 배려가 없는 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.814,
                "end": 66.950
            },
            {
                "speaker_id": "1",
                "transcription": "근데 더 억울한 건 뭔지 알아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.960,
                "end": 69.164
            },
            {
                "speaker_id": "1",
                "transcription": "그 남자 애들이 그렇게 잘생긴 것도 아니야 그렇게 잘난 것도 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.174,
                "end": 72.368
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 나를 간만 보다가 어 그런 애 그렇게 어정쩡한 애들이 소개팅을 또 엄청 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.378,
                "end": 79.504
            },
            {
                "speaker_id": "1",
                "transcription": "또 소개팅을 해가지고 만난 여자애들을 또 여러 여러 다리를 걸쳐서 만나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.514,
                "end": 85.096
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 자기가 되게 잘 나고 인기가 많은 줄 알아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.106,
                "end": 87.822
            },
            {
                "speaker_id": "1",
                "transcription": "그런 애들한테 당하면 진짜 빡치는 거지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.832,
                "end": 90.543
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 세 번째는 주말마다 잠수 타는 애들이야.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 90.553,
                "end": 96.533
            }
        ]
    },
    "summary": "썸 타는 중에 이 사람이 정말 나를 좋아하는지 아니면 진지하지 않게 그냥 시간 보내려고 만나는지 확인하는 방법에 대해 설명하고 있다.",
