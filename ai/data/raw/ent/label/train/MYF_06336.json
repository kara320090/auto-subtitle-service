        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐야 이게 위치가 왜 이래?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.450
            },
            {
                "speaker_id": "1",
                "transcription": "눈 위치가 정상적인 게 없어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.450,
                "end": 4.840
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 좀 낫다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.840,
                "end": 6.130
            },
            {
                "speaker_id": "1",
                "transcription": "고슴도치로 만들었네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.130,
                "end": 7.540
            },
            {
                "speaker_id": "1",
                "transcription": "정성스럽다 정성스러워.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.540,
                "end": 9.760
            },
            {
                "speaker_id": "1",
                "transcription": "약간 찐빵 같은 느낌인가?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.760,
                "end": 13.600
            },
            {
                "speaker_id": "1",
                "transcription": "음 밑에가 바삭바삭해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.600,
                "end": 18.310
            },
            {
                "speaker_id": "1",
                "transcription": "약간 안에서 홍콩의 맛이 나.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.310,
                "end": 21.640
            },
            {
                "speaker_id": "1",
                "transcription": "안 찍은 거 같은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.640,
                "end": 22.690
            },
            {
                "speaker_id": "1",
                "transcription": "이게 총 4개가 나오는데 지금 2개 먹고 2개 남았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.690,
                "end": 26.560
            },
            {
                "speaker_id": "1",
                "transcription": "비싼 딤섬 찢어서 국물이 나오면 그걸 마셔?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.560,
                "end": 29.950
            },
            {
                "speaker_id": "2",
                "transcription": "응.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.950,
                "end": 32.950
            },
            {
                "speaker_id": "1",
                "transcription": "오 와우 와 캬 이 국물이 끝내줍니다. 여러분",
                "sound_type": [
                    2,
                    3,
                    5
