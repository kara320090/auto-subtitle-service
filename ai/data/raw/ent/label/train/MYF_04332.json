        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 이런 연구실의 느낌으로 정말 처음에 이게 오픈 되었을 때",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.505
            },
            {
                "speaker_id": "1",
                "transcription": "막 라벨을 이렇게 붙이고 막 이런 영상도 보이고 막 이래가지고",
                "sound_type": [
                    2
                ],
                "start": 4.515,
                "end": 8.286
            },
            {
                "speaker_id": "1",
                "transcription": "향수를 정말 좋아하는 사람들 또 향수랑 그렇게 친숙하지 않았던 사람들도 너무나 신선했던",
                "sound_type": [
                    2
                ],
                "start": 8.296,
                "end": 13.889
            },
            {
                "speaker_id": "1",
                "transcription": "그걸 봤던 그 저의 그 느낌도 여전히 기억이 나요 우와 이렇게 했던 와 이럴 수 있구나",
                "sound_type": [
                    2
