        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "나물이하고 싸우지 않고 밥 먹는 거야?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 4.412
            },
            {
                "speaker_id": "1",
                "transcription": "널 뭐라 부르지 새로운 친구 이쁜이 밥 먹어라.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 4.422,
                "end": 25.514
            },
            {
                "speaker_id": "1",
                "transcription": "이름을 지어야겠네.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 25.524,
                "end": 28.519
            },
            {
                "speaker_id": "1",
                "transcription": "너는 색깔이 노라니까 율무라고 하자.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 28.529,
                "end": 35.744
            },
            {
                "speaker_id": "1",
                "transcription": "율무 많이 먹어 율무. 내일 또 보자.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 35.754,
                "end": 47.400
            },
            {
                "speaker_id": "1",
                "transcription": "어디있다 이제 왔어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.410,
                "end": 53.619
            },
            {
                "speaker_id": "1",
                "transcription": "봄아 니 친구 왔더라 율무. 봄이 밥 먹으러 가.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.629,
                "end": 58.158
            }
        ]
    },
    "summary": "여성은 새로 온 고양이의 이름을 지어주고 고양이들에게 밥을 먹으라고 한다.",
