        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 직원이 요거를 걸어 버리네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.132
            },
            {
                "speaker_id": "1",
                "transcription": "연료를 집어 넣는데요.",
                "sound_type": [
                    2
                ],
                "start": 2.142,
                "end": 4.424
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 가지도 못하게 하고 당연히 담배 피면 안 되죠 연료 집어 넣을 때는.",
                "sound_type": [
                    2
                ],
                "start": 4.434,
                "end": 10.097
            },
            {
                "speaker_id": "1",
                "transcription": "그때는 저기도 폐쇄를 했거든요.",
                "sound_type": [
                    2
                ],
                "start": 10.107,
                "end": 12.510
            },
            {
                "speaker_id": "1",
                "transcription": "우리 출발할 때 바르셀로나도 근데 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.520,
                "end": 16.320
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 오늘은 아이 3500보밖에 안 걸었는데.",
                "sound_type": [
                    2
                ],
                "start": 16.330,
                "end": 23.366
            }
        ]
    },
    "summary": "한 남자가 직원이 연료를 집어 넣기 위해 길을 폐쇄해서 걷기 운동을 종료한다.",
