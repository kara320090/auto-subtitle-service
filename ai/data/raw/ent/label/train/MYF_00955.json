                    2
                ],
                "start": 5.810,
                "end": 7.180
            },
            {
                "speaker_id": "1",
                "transcription": "먹물은 이런 싼 것들 뭐, 몇천 원이면 한참 씁니다.",
                "sound_type": [
                    2
                ],
                "start": 7.180,
