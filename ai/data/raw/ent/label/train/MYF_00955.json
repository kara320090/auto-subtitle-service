        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇다고 이게 최고란 뜻은 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.150
            },
            {
                "speaker_id": "1",
                "transcription": "저한테 그냥 작품 할 때도 썼으니까 그랬다는 뜻이고.",
                "sound_type": [
                    2
                ],
                "start": 2.180,
                "end": 5.806
            },
            {
                "speaker_id": "1",
                "transcription": "자, 먹물 볼까요?",
