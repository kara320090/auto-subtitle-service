        "term": [
            {
                "speaker_id": "1",
                "transcription": "장미들을 만나고 싶으시다면은요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.833
            },
            {
                "speaker_id": "1",
                "transcription": "세르주 루텐의 라 필레 드 베를린 그리고 구딸의 로즈 폼퐁입니다.",
                "sound_type": [
                    2
                ],
                "start": 1.843,
                "end": 6.628
            },
            {
                "speaker_id": "1",
                "transcription": "장미 향수는 선물하기 좋은 향수이기도 해요. 5월은 뭐 장미의 달이기도 하고 그리고 장미 향 자체가 사람의 기분을 좋게 만들어주는 그런 효과도 가지고 있다고도 하니까요.",
                "sound_type": [
                    2
                ],
                "start": 6.638,
                "end": 19.966
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저는 한국에서 장미 향수 많은 사랑을 받지 않을까 이런 생각을 했는데 현실적으로 제가 들은 바에 따르면은 브랜드에서 공유해주실 때 장미 향수 매출 순위가 아주 높지 않더라고요.",
                "sound_type": [
                    2
                ],
                "start": 19.976,
                "end": 32.296
            },
            {
                "speaker_id": "1",
                "transcription": "향이라는 건 경험과 시간이 좀 필요하거든요.",
                "sound_type": [
                    2
                ],
                "start": 32.306,
                "end": 35.794
            },
            {
                "speaker_id": "1",
                "transcription": "장미 향을 좋아하지 않는 다고 해서 그게 뭐 잘못되거나 이런 건 절대 아니에요. 다만",
                "sound_type": [
                    2
                ],
                "start": 35.804,
                "end": 41.533
            }
        ]
    },
    "summary": "장미 향수는 선물하기 좋은 향수이기도 해고 5월은 장미의 달이기도 하며 장미 향 자체가 사람 기분을 좋게 만들어주는 그런 효과도 가지고 있다.",
