        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 이후에 프로를 구매하는 게 쉽지가 않더라고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.798
            },
            {
                "speaker_id": "1",
                "transcription": "그러는 와중에 아 내가 프로까지 필요 할까라는 생각이 들었어요.",
                "sound_type": [
                    2
                ],
                "start": 2.808,
                "end": 7.909
            },
            {
                "speaker_id": "1",
                "transcription": "저는 하루 대부분을 거의 아이패드를 사용하고 폰은 정말 잘 안 쓰는 편이거든요.",
                "sound_type": [
                    2
                ],
                "start": 7.919,
                "end": 13.316
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 제가 유튜브 촬영을 종종 폰으로 하다 보니까 카메라를 생각해서 프로를 사야겠다 생각을 했었는데",
                "sound_type": [
                    2
                ],
                "start": 13.326,
                "end": 19.652
            },
            {
                "speaker_id": "1",
                "transcription": "이미 아이폰 폴틴 일반 모델도 가벼운 영상 촬영하기에는 충분히 좋은 카메라를 가지고 있다는 생각이 들어서 아이폰을 폴틴 일반 모델로 구매를 하게 되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.662,
                "end": 29.400
            }
        ]
    },
    "summary": "아이폰 폴틴 일반 모델도 가벼운 영상 촬영에 충분히 좋은 카메라를 가지고 있다는 생각이 들어서 여자는 일반 모델로 구매를 했다.",
