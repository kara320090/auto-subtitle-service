        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 유아식기나 젖병 세척도 캡슐 하나로 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.307
            },
            {
                "speaker_id": "1",
                "transcription": "메탄올, 비소, 중금속, 형광증백제가 같은 유해 물질도 걱정 없으니까 안심하고 사용할 수 있구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.317,
                "end": 15.085
            },
            {
                "speaker_id": "1",
                "transcription": "국내산 제품으로 가성비까지 착하다는 점 이것도 매우 마음에 드는 장점이었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.095,
                "end": 22.320
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 수용성 캡슐 세제는 물과 습기에 약하기 때문에 가능한 물에 젖은 손으로 만지지 말고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.330,
                "end": 30.797
            },
            {
                "speaker_id": "1",
                "transcription": "패키지 지퍼를 꾹 닫아서 보관해야 한다는 점은 기억하셔야 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.807,
                "end": 36.424
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 패키지 자체가 단단하게 밀봉해서 예쁘게 세워둘 수 있는 디자인이니까 요 감각적인 패키지 그대로 주방에 두고 사용하시면 좋겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.434,
                "end": 50.183
            }
        ]
    },
    "summary": "유아식기나 젖병 세척도 캡슐 하나로 가능하고 메탄올, 비소, 중금속, 형광증백제 걱정 없이 사용할 수 있고 국내산 제품으로 가성비도 착하지만 수용성으로 물과습기에 약해서 젖은 손으로 만지지 말고 지퍼를 닫고 보관해야 한다는 점은 기억해야 한다고 말한다.",
