        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "바닐라 향의 뭐 그냥 정석과 같은 향이에요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.145
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 엠버 바닐라는 또 한국에서도 많은 분들이 좋아하는 향이신데 이 향수 좋아하시는 분들 파티 즐기시나요?",
                "sound_type": [
                    2
                ],
                "start": 3.155,
                "end": 12.906
            },
            {
                "speaker_id": "1",
                "transcription": "너무너무 궁금합니다.",
                "sound_type": [
                    2
                ],
                "start": 12.916,
                "end": 14.226
            },
            {
                "speaker_id": "1",
                "transcription": "샌달우드의 향을 좋아하시는 분들 샌달우드 같은 경우에는요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.236,
                "end": 18.950
            },
            {
                "speaker_id": "1",
                "transcription": "고급스러운 향수라고 흔히들 얘기하는 그런 향수 브랜드들과 니치 향수들 베이스 노트에 많이 들어가 있는 향료 중에 하나예요.",
                "sound_type": [
                    2
                ],
                "start": 18.960,
                "end": 27.627
            },
            {
                "speaker_id": "1",
                "transcription": "샌달우드의 향이 지배적인 그런 향을 좋아하는 분들은요.",
                "sound_type": [
                    2
                ],
                "start": 27.637,
                "end": 32.103
            },
            {
                "speaker_id": "1",
                "transcription": "완벽주의자에 가까운 분들이라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 32.113,
                "end": 35.072
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 자기 스스로에게도 높은 기준과 높은 기대를 가지고 있는 분들이고 그 기대에 맞춰서 살려고 하다 보니 사회적으로도 성취를 많이 이루시는 분들이라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 35.082,
                "end": 46.556
            },
            {
                "speaker_id": "1",
                "transcription": "다만 이런 분들이 스스로에게 높은 기대와 이 바를 놓았잖아요.",
                "sound_type": [
                    2
                ],
                "start": 46.566,
                "end": 52.429
            },
            {
                "speaker_id": "1",
                "transcription": "그거를 타인한테 놓고 그거를 요구하면은 이게 이제 좀 강압적이고 이런 사람이 될 수도 있죠.",
                "sound_type": [
                    2
                ],
                "start": 52.439,
                "end": 59.769
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 이제 자신 스스로에게는 이렇게 높은 기준을 두었기 때문에 이분들 같은 경우에는 그걸 위해서 굉장히 노력을 하시는 분들이세요.",
                "sound_type": [
                    2
                ],
                "start": 59.779,
                "end": 67.530
            },
            {
                "speaker_id": "1",
                "transcription": "다만 뭔가 사회적인 기준에 맞춰서 그런 거를 막 따라가려고 하거나 이제 이러시면은 엄청나게 마음의 고생을 하시게 되시는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 67.540,
                "end": 75.413
            },
            {
                "speaker_id": "1",
                "transcription": "너무나 세상이 그런 세속적인 네 그런 기준에 꼭 자신을 맞추려고 할 필요 없고 그렇지 않았다고 해서 사람들이 사람들 생각보다 그 관심 없거든요.",
                "sound_type": [
                    2
                ],
                "start": 75.423,
                "end": 86.157
            },
            {
                "speaker_id": "1",
                "transcription": "다른 사람들이 너를 이렇게 막 판단하려고 하고 그런 식으로 막 뭔가 하려고 하거나 별로 그렇지 않을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 86.167,
                "end": 92.556
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 조금 마음을 내려놓을 필요가 있다라는 얘기를 하더라고요.",
                "sound_type": [
                    2
                ],
                "start": 92.566,
                "end": 96.561
            },
            {
                "speaker_id": "1",
                "transcription": "샌달우드 하면은 이제 빼놓을 수 없는 게 딥티크의 탐다오 향수예요.",
                "sound_type": [
                    2
                ],
                "start": 96.571,
                "end": 101.804
            },
            {
                "speaker_id": "1",
                "transcription": "탐다오 같은 경우에는 저는 개인적으로 탐다오의 향은 뭐랄까.",
                "sound_type": [
                    2
                ],
                "start": 101.814,
                "end": 107.166
            },
            {
                "speaker_id": "1",
                "transcription": "굉장히 숲 속에서",
                "sound_type": [
                    2,
                    5
                ],
                "start": 107.176,
                "end": 110.966
            }
        ]
    },
