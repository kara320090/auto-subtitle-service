        "term": [
            {
                "speaker_id": "1",
                "transcription": "2부의 1편 그 남은 거 조금 듣고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.079
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 좀 눈을 많이 쓴 거 같애서 이제 쉬도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 4.089,
                "end": 8.351
            },
            {
                "speaker_id": "1",
                "transcription": "어 지금 인제 이제 저의 취침 시간인 9시 보통 저는 인제 한 9시 반 늦으면 10시 정도에 요즘에는 자고 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 8.361,
                "end": 18.715
            },
            {
                "speaker_id": "1",
                "transcription": "어 모두들 굿 나잇 하시고요.",
                "sound_type": [
                    2
                ],
                "start": 18.725,
                "end": 21.430
            },
            {
                "speaker_id": "1",
                "transcription": "네 오늘도 향기로운 하루이셨길 바랄게요.",
                "sound_type": [
                    2
                ],
                "start": 21.440,
                "end": 25.213
            },
            {
                "speaker_id": "1",
                "transcription": "굿 나잇.",
                "sound_type": [
                    2
                ],
                "start": 25.223,
                "end": 26.426
            },
            {
                "speaker_id": "1",
                "transcription": "일상이 늘 향기로운 순간들로 가득 차길 바랄게요.",
                "sound_type": [
