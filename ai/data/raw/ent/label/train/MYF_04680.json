        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 다섯가지 향수들이 조금씩 어떻게 서로가 다른 지를 한 번 말씀을 드려봤는데 그 각각의 향수를 상상하시는데 조금 도움이 되셨으면은 하는 마음으로 만들어 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 12.012
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 향수 읽어주는 여자 @이름1였습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.022,
                "end": 15.840
            },
            {
                "speaker_id": "1",
                "transcription": "여러분의 좋아요와 구독은 영상을 만드는 데 큰 힘이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 15.850,
                "end": 19.467
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 제가 처음으로 마이크를 가지고 한 번 해봤거든요.",
                "sound_type": [
                    2
                ],
                "start": 19.477,
                "end": 24.098
            },
            {
                "speaker_id": "1",
                "transcription": "예 어떻게 느끼셨는지 또 알려주세요.",
                "sound_type": [
                    2
                ],
                "start": 24.108,
                "end": 27.617
            },
            {
                "speaker_id": "1",
                "transcription": "여러분의 댓글 덕분에 제가 영상을 만들 때 오디오가 조금 문제가 된다는 사실을 알게 되었거든요.",
                "sound_type": [
                    2
                ],
                "start": 27.627,
                "end": 34.749
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 댓글로 알려주셔서 너무 고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.759,
                "end": 37.533
