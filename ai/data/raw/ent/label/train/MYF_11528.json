        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "품 50미리 요렇게 들어 있으니까 참고하시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.210
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 각각의 제품들 얘기하기 앞서서 일단은 공통점에 대한 얘기를 좀 해볼게요.",
                "sound_type": [
                    2
                ],
                "start": 3.220,
                "end": 7.819
            },
            {
                "speaker_id": "1",
                "transcription": "일단 제품들 전부 다 점도가 깔끔하고 지속력이 높아서 쉽게 마르지 않고 오랫동안 유지가 되는 이 점이 특징이고",
                "sound_type": [
                    2
                ],
                "start": 7.829,
                "end": 14.682
            },
            {
                "speaker_id": "1",
                "transcription": "EWG 그린 등급과 글리세린 무첨가라 안심하고 사용할 수 있다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 14.692,
                "end": 18.499
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 전반적으로 다 순한 제품이기 때문에 편하게 쓸 수 있고 또 여성의 Y존과 유사한 약산성이 되어 있어서 안전하게 사용이 가능하다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 18.509,
                "end": 25.335
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 수용성이다 보니까 끈적이지 않고 깔끔하게 떨어지는 제품인데 보여드리도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 25.345,
                "end": 29.382
            },
            {
                "speaker_id": "1",
                "transcription": "짠 제품은 요런 식으로 보시면은 투명한 형태에 젤 타입이에요.",
                "sound_type": [
                    2
                ],
                "start": 29.392,
                "end": 33.639
            },
            {
                "speaker_id": "1",
                "transcription": "바르면은 요렇게 촉촉하게 발라지는 건데 끈적이지 않고 촉촉하게 잘 발라져 가지고 굉장히 기분 좋게 사용하실 수 있는 제품이라는 거 참고하시면 좋을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 33.649,
                "end": 41.865
            },
            {
                "speaker_id": "1",
                "transcription": "자 아까 발랐던 제품을 그냥 물로만 닦아볼게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.875,
                "end": 45.055
            },
            {
                "speaker_id": "1",
                "transcription": "물로 닦아내면은",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.065,
                "end": 48.833
            }
        ]
