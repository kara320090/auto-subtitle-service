                ],
                "start": 16.056,
                "end": 17.697
            },
            {
                "speaker_id": "1",
                "transcription": "너무 만족스러운데",
                "sound_type": [
                    2
                ],
                "start": 17.707,
                "end": 19.443
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게까지 부드럽게 손떨방이 된다고 야간에?",
                "sound_type": [
                    2
                ],
                "start": 19.453,
                "end": 22.838
            },
            {
                "speaker_id": "1",
                "transcription": "지금 걷고 있거든요.",
