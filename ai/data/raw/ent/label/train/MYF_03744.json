        "term": [
            {
                "speaker_id": "1",
                "transcription": "샌달 우드나 인제 이런 친구들이 이렇게 뭐랄까 장미 옆에서 장미의 명령을 기다리고 있다고 나 할까 요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.161
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 장미는 그 정말 독보적으로 존재하고 있는 그런 장미예요.",
                "sound_type": [
                    2
                ],
                "start": 8.171,
                "end": 13.908
            },
            {
                "speaker_id": "1",
                "transcription": "장미는 장미인데 결코 다른 꽃들을 받쳐 줄려는 물론 장미가 꽃의 여왕이다 이렇게 표현을 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 13.918,
                "end": 22.638
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뭐 여왕도 리더도 다양한 형태의 리더들이 계시잖아요.",
                "sound_type": [
                    2
                ],
                "start": 22.648,
                "end": 26.966
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 직원들을 이렇게 독려하거나 직원들을 뒤에서 밀어주거나 인제 이런 분도 계실 텐 데 이 장미 보스 님은 굉장히 카리스마가 넘치세요.",
                "sound_type": [
                    2
                ],
                "start": 26.976,
                "end": 38.633
            }
        ]
    },
    "summary": "독보적인 장미 향에 대해 자세히 표현해 주고 있다.",
