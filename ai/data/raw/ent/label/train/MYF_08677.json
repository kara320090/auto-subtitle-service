                    2,
                    3
                ],
                "start": 20.201,
                "end": 25.052
            },
            {
                "speaker_id": "1",
                "transcription": "일을 했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.062,
                "end": 27.762
