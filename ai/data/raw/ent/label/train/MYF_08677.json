        "term": [
            {
                "speaker_id": "1",
                "transcription": "누가 나타날까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.746
            },
            {
                "speaker_id": "1",
                "transcription": "우와 노아가 나타났군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.756,
                "end": 5.091
            },
            {
                "speaker_id": "1",
                "transcription": "노아는 꼬미를 좋아하는 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.101,
                "end": 10.560
            },
            {
                "speaker_id": "1",
                "transcription": "노아는 수줍음이 많아서 지켜보고만 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.570,
                "end": 16.574
            },
            {
                "speaker_id": "1",
                "transcription": "꼬미가 하는 걸 지켜보고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.584,
                "end": 20.191
            },
            {
                "speaker_id": "1",
                "transcription": "꼼아 너도 노아가 온 걸 알아?",
