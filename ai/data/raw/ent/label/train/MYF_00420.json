        "term": [
            {
                "speaker_id": "1",
                "transcription": "실패의 이유를 알았어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.226
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이렇게 옆에서 이렇게 딱 갖다 댔잖아요.",
                "sound_type": [
                    2
                ],
                "start": 4.236,
                "end": 6.487
            },
            {
                "speaker_id": "1",
                "transcription": "이럼 안 돼, 이럼 안 돼.",
                "sound_type": [
                    2
                ],
                "start": 6.497,
                "end": 7.721
            },
            {
                "speaker_id": "1",
                "transcription": "정확히 어떻게 해야 되냐면 차하고 수직으로해서 요렇게 딱 오케이",
                "sound_type": [
                    2
                ],
                "start": 7.731,
                "end": 12.412
            },
            {
                "speaker_id": "1",
                "transcription": "자 그렇게 하면 요렇게 도어핸들 나오는 거 보이죠?",
                "sound_type": [
                    2
                ],
                "start": 12.422,
                "end": 14.826
            },
            {
                "speaker_id": "1",
                "transcription": "이 도어핸들 요것도 튜닝입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.836,
                "end": 17.313
            },
            {
                "speaker_id": "1",
                "transcription": "무려 120만 원",
