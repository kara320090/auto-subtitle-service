    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 저는 이렇게 리본 묶어가지고 트윌리 매치하는 거는 별로 안 좋아해 가지고 반지를 사용을 하는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.018
            },
            {
                "speaker_id": "1",
                "transcription": "이럴 때 안나루이사 제품을 활용해 주면 딱 좋더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.028,
                "end": 9.082
            },
            {
                "speaker_id": "1",
                "transcription": "링을 스카프 링처럼 활용하는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.092,
                "end": 11.516
            },
            {
                "speaker_id": "1",
                "transcription": "껴가지고 이렇게 리본이 보이지 않게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.526,
                "end": 20.486
            },
            {
                "speaker_id": "1",
                "transcription": "퀼팅 무늬가 되어있어서 스카프 링으로 활용해도 너무 예뻐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.496,
                "end": 23.854
            },
            {
                "speaker_id": "1",
                "transcription": "어 이어서 제가 댓글을 읽어보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.864,
                "end": 26.352
            },
            {
                "speaker_id": "1",
                "transcription": "에 @계정1 님.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.362,
                "end": 27.258
            },
            {
                "speaker_id": "1",
                "transcription": "@계정2 항상 좋은 제품 리뷰 너무너무 잘 보고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.268,
                "end": 31.221
            },
            {
                "speaker_id": "1",
                "transcription": "처음 가브리엘 백팩 영상을 찾다가 입문하게 되었는데 인기 많고 센스 있는 @계정2의 리뷰들 너무너무 도움이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.231,
                "end": 38.237
            },
            {
                "speaker_id": "1",
                "transcription": "전 악세서리가 별로 없는 편인데 30대 중반이 되는 요즘 부쩍 악세서리에 관심이 많이 가네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.247,
                "end": 44.024
            },
            {
                "speaker_id": "1",
                "transcription": "브랜드들은 너무 가격이 높아서 합리적으로 사용할 수 있는 악세서리 너무 이용해보고 싶어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.034,
                "end": 48.971
            },
            {
                "speaker_id": "1",
                "transcription": "특히 목걸이랑 반지 너무 예뻐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.981,
                "end": 51.153
            },
            {
                "speaker_id": "1",
                "transcription": "안나루이사 하트 @계정2 하트 이렇게 예쁘게 댓글을 달아주셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.163,
                "end": 55.519
            },
            {
                "speaker_id": "1",
                "transcription": "어 @계정1 님께서 음 가브리엘 백팩 영상으로 입문하셨다고 하는데 저는 진짜 운이 좋게 매장에 딱 하나 남은 그 구석진 곳에 있는 가방을 보고 구매를 했었던 거였거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.529,
                "end": 66.828
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 굳이 프리미엄 붙여서까지는 가브리엘 백팩을 사라고 권해드리고 싶지는 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.838,
                "end": 71.922
            },
            {
                "speaker_id": "1",
                "transcription": "샤넬백들은 일단 다 가지고 있으면 언제든 활용할 수 있기는 한데 최근에는 부쩍 호보백 스타일이 전 예뻐 보이는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.932,
                "end": 78.814
            },
            {
                "speaker_id": "1",
                "transcription": "일단 목걸이랑 반지랑 마음에 드신다고 하셨는데 일단은 목걸이는 뒤에 댓글을 막 이만큼 다신 분들이 너무 많아가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.824,
                "end": 85.952
            },
            {
                "speaker_id": "1",
                "transcription": "제가 @계정1 님께는 스카프 링으로도 활용 가능한 코코크러쉬를 오마주한 제타 반지를 선물로 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.962,
                "end": 94.000
            }
        ]
    },
    "summary": "발화자는 스카프 활용을 어떻게 하는지 알려주고 댓글을 읽다가 구독자에게 반지 선물을 주고 있다.",
