        "term": [
            {
                "speaker_id": "1",
                "transcription": "솔아 방울이는 어디 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.007
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 저기 보이세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.017,
                "end": 4.974
            },
            {
                "speaker_id": "1",
                "transcription": "방울이는 저기 터널에 이렇게 방울아 까꿍 방울이 귀 보이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.984,
                "end": 15.151
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 까꿍 어유 어유 잠아 터널 안에 들어 갔어요 방울이 터널에서 나와요 우리 방울이 이리 엄마 엄마 여기 있어 방울아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.161,
                "end": 28.847
            },
            {
                "speaker_id": "1",
                "transcription": "방울아 엄마 어디 어이고 우리 방울이 방울이 어이구 우리 방울이 또 다른 터널로 이제 방울이 터널 좋아해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.857,
                "end": 42.140
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 우리 방울이 또 터널에 들어가는 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.150,
                "end": 46.209
            },
            {
                "speaker_id": "1",
                "transcription": "들어 가서 자거라 이제 애기들이 낮잠 자는 시간인 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.219,
                "end": 52.080
            }
        ]
    },
    "summary": "방울이가 터널을 좋아하여 안에 들어가 있어서 귀밖에 안 보이고 이제 아이들 낮잠 시간이라고 말한다.",
