        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐랄까 진짜 인간 파이가 되는 그런 기분의 네 향수가 될 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.842
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그것도 한번 시도해 보시면 어떨까 생각을 해 보게 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.852,
                "end": 10.339
            },
            {
                "speaker_id": "1",
                "transcription": "또 이렇게 덕분에 이렇게 곰팡이에 대한 그 향수도 한번 생각을 해 보게 되어서 네 고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.349,
                "end": 18.773
            },
            {
                "speaker_id": "1",
                "transcription": "어 영상이 도움이 되셨기를 바라고요.",
                "sound_type": [
                    2
                ],
                "start": 18.783,
                "end": 22.309
            },
            {
                "speaker_id": "1",
                "transcription": "네 개인 맞춤 향수 추천은 계속 하도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 22.319,
                "end": 26.786
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 지금까지 향수 읽어주는 여자 하니날다였습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.796,
                "end": 30.860
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 도움이 되셨다면 구독과 좋아요 부탁드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 30.870,
                "end": 34.744
            },
            {
                "speaker_id": "1",
                "transcription": "고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.754,
                "end": 36.366
            }
        ]
    },
    "summary": "인간 파이가 되는 향수라서 시도해 보면 좋을 것 같고 곰팡이에 대한 향수도 생각을 해 보게 되어서 고맙고 개인 맞춤 향수 추천은 계속 하겠다.",
