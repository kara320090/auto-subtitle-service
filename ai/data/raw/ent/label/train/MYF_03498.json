        "term": [
            {
                "speaker_id": "1",
                "transcription": "강해지니까 그럼 이건 또 새로운 경험이 돼버리는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.340
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 늘 새로운 김밥을 먹는거죠 늘.",
                "sound_type": [
                    2
                ],
                "start": 3.350,
                "end": 5.545
            },
            {
                "speaker_id": "1",
                "transcription": "늘 그러면서 이걸 좋아할지 안 좋아할지가 늘 새롭게 그거를 경험할 때마다 다른 거예요.",
                "sound_type": [
                    2
                ],
                "start": 5.555,
                "end": 12.446
            },
            {
                "speaker_id": "1",
                "transcription": "네, 그래서 그 인터뷰에서 제가 그 겔랑에 지금 마스터 조향사이신 그 띠에리 님께서 하신 말씀 중에.",
                "sound_type": [
