    },
    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            },
            {
                "speaker_id": "2",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 약간 좀 시트러스도 약간 있기는 한데 우디 한 형이 완전 그때도 도심 속에 있다 보니까 어 자연으로 가야 돼 나는 자연이야 이런 느낌이 많이 나서 아 이건 사야겠다하고 가격표를 보니까",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 12.804
            },
            {
                "speaker_id": "2",
                "transcription": "가격이 착하지가 않을 텐데요.",
                "sound_type": [
                    2
                ],
                "start": 12.814,
                "end": 15.278
            },
            {
                "speaker_id": "1",
                "transcription": "너무너무 못됐더라고요.",
                "sound_type": [
                    2
                ],
                "start": 15.288,
                "end": 16.970
            },
            {
                "speaker_id": "1",
                "transcription": "그래서",
                "sound_type": [
                    2
                ],
                "start": 16.980,
                "end": 18.001
            },
            {
                "speaker_id": "2",
                "transcription": "굉장히 심혈을 기울여가지고 만들어 낸 향수로 제가 들었거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.011,
                "end": 23.559
            },
            {
                "speaker_id": "2",
                "transcription": "왜냐하면 아무래도 이게 뭐 베르가못이나 이런 시트러스 한 향의 성분이 조금 더 많이 함유가 되어 있을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 23.569,
                "end": 30.833
            },
            {
                "speaker_id": "2",
                "transcription": "이제 우디 한 향이 다른 시트러스 향보다 뭐 조금 들어갔다 그러면은 지속 시간이 조금 짧아질 수가 있겠죠.",
                "sound_type": [
                    2
                ],
                "start": 30.843,
                "end": 37.877
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 함유량이 뭐 많지는 않아서 조금 더 그래서 더 신선하고 프레시하고 상큼 상큼한 더 느낌이 가고 대신에 어쨌든 오렌지나 이런 베르가못이나 이런 상큼 상큼한 이제 시트러스 한 애들이 더 기분 좋게 만들어 주기 때문에 그것 때문에 이 향이 더 매력적일 거예요.",
                "sound_type": [
                    2
                ],
                "start": 37.887,
                "end": 56.525
            },
            {
                "speaker_id": "2",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 56.535,
                "end": 56.694
            },
            {
                "speaker_id": "1",
                "transcription": "나 그날을 겪을 때는 아침에 항상 이거를 뿌립니다.",
                "sound_type": [
                    2
                ],
                "start": 56.704,
                "end": 60.858
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 말씀해 주셨다시피 상큼한 느낌이 있어서 기분이 좀 다운될 때 그래서 그날에 좀 많이 뿌리는 거 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 60.868,
                "end": 68.679
            },
            {
                "speaker_id": "2",
                "transcription": "왜냐하면 정말 시트러스 한 느낌이 이게 크게 존재를 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 68.689,
                "end": 73.521
            },
            {
                "speaker_id": "1",
                "transcription": "시트러스는 짧다라고",
                "sound_type": [
                    2
                ],
                "start": 73.531,
                "end": 75.547
            },
            {
                "speaker_id": "2",
                "transcription": "시트러스는 짧다.",
                "sound_type": [
                    2
                ],
                "start": 75.557,
                "end": 77.216
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 본질적으로 시트러스라는 계열을 크게 좋아하지는 않으시는 분이신데 그런데 그나마 여기에서 시트러스함을 느끼고 시트러스 한 애들은 사람의 기분을 끌어올려 주는 게 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 77.226,
                "end": 88.821
            },
            {
                "speaker_id": "2",
                "transcription": "그래 기본적으로 나무가 많은 곳에서 만나는 오렌지 1박스 이런 거를 네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 88.831,
                "end": 95.138
            },
            {
                "speaker_id": "1",
                "transcription": "너무 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 95.148,
                "end": 95.714
            },
            {
                "speaker_id": "1",
                "transcription": "어 상상을 눈 감고 상상을 하는 거 같은데",
                "sound_type": [
                    2
                ],
                "start": 95.724,
                "end": 98.657
            },
            {
                "speaker_id": "2",
                "transcription": "딥티크의 세계로",
                "sound_type": [
                    2,
                    5
                ],
                "start": 98.667,
                "end": 99.797
            },
            {
                "speaker_id": "1",
                "transcription": "꽤 오래 걸렸거든요.",
                "sound_type": [
                    2
                ],
                "start": 99.807,
                "end": 101.690
            },
            {
                "speaker_id": "1",
                "transcription": "저는 한 6년 7년 걸린 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 101.700,
                "end": 104.012
            },
            {
                "speaker_id": "1",
                "transcription": "딥티크는 어 저 주변 사람들이 되게 많이 쓰기는 해서 사실 쓰기 싫었어요.",
                "sound_type": [
                    2
                ],
                "start": 104.022,
                "end": 109.411
            },
            {
                "speaker_id": "2",
                "transcription": "2000년대 초반만 해도 한국에서 딥티크 입으시는 분들이 진짜 많지가 않으셨는데 이제 좀 십몇 년이 이제 흘러나니까 뭔가 딥티크는 그냥 당연하게 한 번쯤 거쳐가는 향수 브랜드가 돼 버린 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 109.421,
                "end": 123.751
            },
            {
                "speaker_id": "1",
                "transcription": "공병이라도 항상 있는 그런 향수지 않을까요?",
                "sound_type": [
                    2
                ],
                "start": 123.761,
                "end": 127.193
            },
            {
                "speaker_id": "1",
                "transcription": "공병 자체도 병 자체도 너무 예뻐요 이거는.",
                "sound_type": [
                    2
                ],
                "start": 127.203,
                "end": 129.860
            },
            {
                "speaker_id": "2",
                "transcription": "네 여기 뭐 오벌 디자인으로 1961년에 프랑스 파리에 생 제르망 34번가에서 론칭을 하신",
                "sound_type": [
                    2
                ],
                "start": 129.870,
                "end": 138.797
            },
            {
                "speaker_id": "1",
                "transcription": "예 제가 제라늄이라는 이 식물을 알게 된 게 제가 모기에 되게 잘 물려요.",
                "sound_type": [
                    2
                ],
                "start": 138.807,
                "end": 145.070
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 제라늄이 모기 퇴치에 아주 좋다고 하더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 145.080,
                "end": 149.003
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 어떻게 하다가 딥티크의 제라늄 뭐가 있다라고 해서 갔는데 너무 또 우디 우디 한 향이더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 149.013,
                "end": 156.952
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 구매하게 된 템입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 156.962,
                "end": 159.602
            },
            {
                "speaker_id": "2",
                "transcription": "제라늄 오도라타는 뭐 클래식이죠.",
                "sound_type": [
                    2
                ],
                "start": 159.612,
                "end": 161.824
            },
            {
                "speaker_id": "1",
                "transcription": "그런가요?",
                "sound_type": [
                    2
                ],
                "start": 161.834,
                "end": 162.546
            },
            {
                "speaker_id": "2",
                "transcription": "사람들의 기분을 많이 좋게 만들어 주고 제라늄 같은 경우에는 이제 그 또 이러면 이제 굳 시청 시간이 줄어드나?",
                "sound_type": [
                    2
                ],
                "start": 162.556,
                "end": 170.366
            },
            {
                "speaker_id": "2",
                "transcription": "제라늄은 분자 향 분자가 장미랑 굉장히 비슷해요.",
                "sound_type": [
                    2
                ],
                "start": 170.376,
                "end": 175.164
            },
            {
                "speaker_id": "2",
                "transcription": "몇 분들이 장미랑 혼동을 많이 하시거든요.",
                "sound_type": [
                    2
                ],
                "start": 175.174,
                "end": 177.855
            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 장미 향이 나는 것 같네요.",
                "sound_type": [
                    2
                ],
                "start": 177.865,
                "end": 179.316
            },
            {
                "speaker_id": "2",
                "transcription": "네 그리고 기본적으로 장미는 사람을 기분 좋게 만들어 주기 때문에 많은 분들에게 이제 기분 좋은 아이템 중에 하나죠.",
                "sound_type": [
                    2
                ],
                "start": 179.326,
                "end": 186.148
            },
            {
                "speaker_id": "2",
                "transcription": "아 그분 그분 뭘 좀 아는 남자분이시네.",
                "sound_type": [
                    2
                ],
                "start": 186.158,
                "end": 189.156
            },
            {
                "speaker_id": "1",
                "transcription": "좀 많이 색달랐고 그래서 아 이 냄새가 어디서 익숙한데 그분 이런 룩이랑 이런 향기가 너무 잘 어우러져 이거 같은 경우에는 제가 뿌리니까 또 느낌이 많이 또 다르더라고요.",
                "sound_type": [
                    2
                ],
                "start": 189.166,
                "end": 200.896
            },
            {
                "speaker_id": "1",
                "transcription": "제가 선호하는 향은 아니라서 지금 이만큼",
                "sound_type": [
                    2
                ],
                "start": 200.906,
                "end": 203.600
            }
        ]
    },
    "summary": "딥티크의 향수를 접하게 된 계기를 설명합니다.",
