        "term": [
            {
                "speaker_id": "1",
                "transcription": "프린트 용지보다 아름다운 것은 그 번짐의 아름다움이죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.770
            },
            {
                "speaker_id": "1",
                "transcription": "이 동양 예술의 착한 아름다움, 이 번짐, 얼마나 낫습니까, 이것이?",
                "sound_type": [
                    2
                ],
                "start": 5.788,
                "end": 12.490
            },
            {
                "speaker_id": "1",
                "transcription": "유화나 그런 데서는 도저히 찾아볼 수 없는 그런 아름다움이죠.",
                "sound_type": [
                    2
                ],
                "start": 12.490,
                "end": 18.986
            },
            {
                "speaker_id": "1",
                "transcription": "우리의 어떤 혼과 혼이 교감하는 듯한 그런 맛이 이런 좋은 화선지에서 나오는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 18.996,
                "end": 25.800
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 좋은 화선지는 그런 교감하는 빛깔이 너무나 아름답고",
                "sound_type": [
                    2
                ],
                "start": 25.800,
                "end": 29.680
            }
        ]
    },
    "summary": "화선지의 번짐은 유화 같은 데서는 찾아볼 수 없는 아름다움이고 혼과 혼이 교감하는 듯한 그런 맛은 좋은 화선지에서 나온다.",
