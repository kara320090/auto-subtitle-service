        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 이 정도 접시들만 사용하는 편이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.333
            },
            {
                "speaker_id": "1",
                "transcription": "이건 이건에 새로 지원받은 셰프윈 브랜드에 기물들입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.343,
                "end": 6.499
            },
            {
                "speaker_id": "1",
                "transcription": "깔끔한 스테인리스 냄비와 팬으로 더 다양한 요리를 시도할 수 있게 됐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.509,
                "end": 11.295
            },
            {
                "speaker_id": "1",
                "transcription": "인덕션에 딱 맞는 크기에 예쁜 팬이라서 기분이 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.305,
                "end": 16.274
            },
            {
                "speaker_id": "1",
                "transcription": "이 냄비와 뚜껑을 사용하면 쉽게 찜 요리도 만들 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.284,
                "end": 20.610
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로가 기대되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.620,
                "end": 22.515
            },
            {
                "speaker_id": "1",
                "transcription": "다음은 각종 조리용 주방도구들입니다.",
                "sound_type": [
                    2,
