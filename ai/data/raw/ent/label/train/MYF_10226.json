        "term": [
            {
                "speaker_id": "1",
                "transcription": "너무 무겁지 않구요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.591
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 너무 이렇게 드러내거나 이러진 않거든요.",
                "sound_type": [
                    2
                ],
                "start": 1.601,
                "end": 4.789
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이거를 막 9번씩 막 피부에다가 뿌리고 막 이러면은 그러면 그 누가 봐도 이제 알죠.",
                "sound_type": [
                    2
                ],
                "start": 4.799,
                "end": 11.337
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이제 이 향수를 이렇게 피부에다가 1번만 분사를 하시면은 아주 살랑살랑 딱 기분 좋은 봄바람처럼 여러분들을 기분 좋고 산뜻하게 만들어 줄 수 있는 그런 향수라고 저는 생각해요.",
                "sound_type": [
                    2
                ],
                "start": 11.347,
                "end": 24.292
            },
            {
                "speaker_id": "1",
                "transcription": "주변분들도 그렇게 느끼시고요.",
                "sound_type": [
                    2
                ],
                "start": 24.302,
                "end": 26.372
            },
            {
                "speaker_id": "1",
                "transcription": "말씀드린 이 향수들은요. 지속력이 아주 길거나 하진 않아요.",
                "sound_type": [
                    2
                ],
                "start": 26.382,
                "end": 30.700
