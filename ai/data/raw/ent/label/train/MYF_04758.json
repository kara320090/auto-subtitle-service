        "term": [
            {
                "speaker_id": "1",
                "transcription": "보통 장미를 많이 말씀하실 때 불가리향 터키쉬 많이 말씀하시지만 그냥 저만의 장미를 좀",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.366
            },
            {
                "speaker_id": "2",
                "transcription": "다른 곳에 가셔서 만날 수 있는 장미가 아니에요.",
                "sound_type": [
                    2
                ],
                "start": 6.376,
                "end": 9.813
            },
            {
                "speaker_id": "2",
                "transcription": "저는 계속 지금 맛있다 얘기하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 9.823,
                "end": 11.784
            },
            {
                "speaker_id": "2",
                "transcription": "지금 되게 맛있는 장미 지금 만나는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 11.794,
                "end": 14.553
            },
            {
                "speaker_id": "1",
                "transcription": "김활식 제 이름이 김활이거든요? 그래서 김활식 네블 김활식 이제 뭐 뭐 뭐 김활식 장미",
                "sound_type": [
                    2
                ],
                "start": 14.563,
                "end": 23.543
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 표현해 주시는 게 되게 기분이 좋더라고요.",
                "sound_type": [
                    2
                ],
                "start": 23.553,
                "end": 26.593
            },
            {
                "speaker_id": "2",
                "transcription": "그럼요.",
                "sound_type": [
                    2
                ],
                "start": 26.603,
                "end": 27.267
            },
            {
                "speaker_id": "1",
                "transcription": "여기에서도 나의 어떤 스타일을 느끼는 분들이 계시는구나라고",
                "sound_type": [
                    2
                ],
                "start": 27.277,
                "end": 31.781
            },
            {
                "speaker_id": "2",
                "transcription": "셀라로사를 만났을 때 아 이 분은 굉장히 꽃의 매끄러운 표면감이나 이런",
                "sound_type": [
                    2
                ],
                "start": 31.791,
                "end": 38.766
            }
        ]
    },
    "summary": "김활식 향기다라고 표현해 주는 것이 뿌듯하다.",
