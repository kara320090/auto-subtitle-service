            },
            {
                "speaker_id": "1",
                "transcription": "엄마 쑥이야 엄마 쑥이 엄마 쑥이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.637,
                "end": 5.895
            },
            {
                "speaker_id": "1",
                "transcription": "아우 이동장에 처음 들어갈 때는 음 사실 어디로 가나 하는 마음이 있었던 것 같아요 쑥이가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.905,
                "end": 15.049
            },
            {
                "speaker_id": "1",
                "transcription": "우리 쑥이지니",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.059,
                "end": 16.824
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이제 병원 갔다 와서는 맘이 좀 편해진 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.834,
                "end": 22.282
            },
            {
                "speaker_id": "1",
                "transcription": "병원에서도 너무 얌전해서 놀랬어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.292,
                "end": 26.656
            },
            {
                "speaker_id": "1",
                "transcription": "아마 조금",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.666,
                "end": 29.590
            },
            {
                "speaker_id": "1",
                "transcription": "어 이제 물도 먹네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.590,
                "end": 31.131
            }
        ]
    },
    "summary": "한 여자가 병원에 갈 때는 고양이가 어디로 가나 싶은 맘이 있었던 것 같은데 병원 다녀와서는 맘이 편해진 것 같다고 말을 한다.",
