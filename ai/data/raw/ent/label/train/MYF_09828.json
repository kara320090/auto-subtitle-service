                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 부위별로 좀 유분기가 다 다르세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.935
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이거를 제가 추천 드리는 거는 고개를 숙여서 하시고서는 그런데 목이 아프신 분들이 있잖아.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.945,
                "end": 10.590
            },
            {
                "speaker_id": "1",
                "transcription": "이제 그럴 때는 내가 잘 손이 잘 안 가는 부분은 조금 신경 써서 가게끔 잘 문질러 주셔야 되죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.600,
                "end": 16.925
            },
            {
                "speaker_id": "2",
                "transcription": "알겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.935,
                "end": 18.200
            },
            {
                "speaker_id": "1",
                "transcription": "일주일 정도만 하시면 확실히 좋아지세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.200,
                "end": 20.903
            },
            {
                "speaker_id": "1",
                "transcription": "내가 잘하고 있다라는 걸 언제 아냐면 같은 샴푸랑 같은 양으로 썼을 때 어떤 날은 어 조금만 해도 거품이 잘 나네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.913,
                "end": 31.196
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 평소에 잘 하고 계신 거 그런데 어떤 날에는 아 왜 오늘따라 왜 이렇게 샴푸가 많이 들어가 그거는 내가 한 1, 2주 동안 샴푸를 대충 하신 그렇게 생각하시면 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.206,
                "end": 42.769
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 고객님들 되게 많이 바뀌신 분들이 되게 많아요 남자분들 특히",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.779,
                "end": 48.510
            },
            {
                "speaker_id": "1",
                "transcription": "비듬 막 떨어지시는 분들 샴푸 습관 바꾸세요라고 하시면 금방 좋아지시더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.510,
                "end": 53.567
            },
            {
                "speaker_id": "2",
                "transcription": "샴푸 습관이 진짜 중요한 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.577,
                "end": 56.081
            },
            {
                "speaker_id": "2",
                "transcription": "저를 지금 제가 정말 느끼고 있는 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.091,
                "end": 58.610
            },
            {
                "speaker_id": "2",
                "transcription": "저 어쨌든 책 쓴다고 그러니까 모든 집중이 거기 있으니까 빨리 샴푸도 끝내고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.600,
                "end": 64.352
            },
            {
                "speaker_id": "1",
                "transcription": "묶으면 되니까 머리를",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.362,
                "end": 66.040
            },
            {
                "speaker_id": "2",
                "transcription": "예 그냥 묶고 그렇게 했는데 진짜 너무 찰지는 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.030,
                "end": 70.860
            },
            {
                "speaker_id": "1",
                "transcription": "사실은 1순위는 얼굴이고 2순위는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 70.870,
                "end": 74.021
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 74.031,
                "end": 74.699
            },
            {
                "speaker_id": "1",
                "transcription": "의상이고 3은 머리는 달려있는 거라서",
                "sound_type": [
                    2,
                    5
                ],
                "start": 74.709,
                "end": 78.149
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 78.159,
                "end": 78.974
            },
            {
                "speaker_id": "1",
                "transcription": "다 그래요 다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 78.984,
                "end": 80.384
            },
            {
                "speaker_id": "2",
                "transcription": "어 그렇구나 샴푸 중요합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 80.394,
                "end": 83.159
            },
            {
                "speaker_id": "1",
                "transcription": "이 되면 얼굴 헤어 라인에 아 그니까 페이스 라인에 여드름 같은 게 생기실 수 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 83.169,
                "end": 90.110
            },
            {
                "speaker_id": "1",
                "transcription": "예 어 샴푸를 똑바로 하지 않고 제품으로만 많이 처리를 하시려고 하면은 그런 것들이 피부에 닿으면서 여기도 마찬가지가 되는 거죠 이런 데가.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 90.110,
                "end": 99.618
            },
            {
                "speaker_id": "2",
                "transcription": "어 맞아요 맞아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 99.628,
                "end": 101.140
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 저기 뭐야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 101.150,
                "end": 102.488
            },
            {
                "speaker_id": "2",
                "transcription": "모발에 너무 맞아요 맞아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 102.498,
                "end": 104.390
            },
            {
                "speaker_id": "1",
                "transcription": "목이라던가 도돌도돌하게 올라오면은 그거는 바르시는 제품이랑 그다음에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 104.390,
                "end": 108.966
            }
        ]
    },
    "summary": "발화자는 샴푸하는 방법에 대해 직원과 대화하고 있습니다.",
