                "end": 15.431
            },
            {
                "speaker_id": "1",
                "transcription": "2019년 9월에 유튜브 시작을 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.441,
                "end": 18.060
            },
            {
                "speaker_id": "1",
                "transcription": "브이로그 채널이었어요, 그때는.",
