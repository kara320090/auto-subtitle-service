        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 아까 그곳을 지나서 어 다른 포인트로 가다가 우연히 들른 수로입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.708
            },
            {
                "speaker_id": "1",
                "transcription": "아 물색 너무 좋은데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.718,
                "end": 8.195
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 1번도 해본 적이 없는데 오늘 여기서 한번 진행해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.205,
                "end": 17.890
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 글루텐만 사용해서 낚시 진행할 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.900,
                "end": 21.910
            },
            {
                "speaker_id": "1",
                "transcription": "아 스피드 글루텐.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.915,
                "end": 23.740
            },
            {
                "speaker_id": "1",
                "transcription": "바람이 변수네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.800,
                "end": 24.910
            },
            {
                "speaker_id": "1",
                "transcription": "어 물색은 진짜 좋은데 아 오늘 하루종일 예보에는 바람이 부는 걸로 되어 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.970,
                "end": 32.856
            },
            {
                "speaker_id": "1",
                "transcription": "짐빵 거리가 멀어서 오늘은 좌대는 못 펴고 간단한 세팅으로 낚시 시작하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.866,
                "end": 44.144
            }
        ]
    },
    "summary": "남자는 우연히 들른 수로가 물색이 좋아 1번도 해본 적이 없는 이곳에서 글루텐만 사용하여 낚시해보겠다며 예보에는 하루종일 바람이 부는 걸로 되어 있어서 변수고 짐빵 거리가 멀어서 간단한 세팅으로 하겠다고 말한다.",
