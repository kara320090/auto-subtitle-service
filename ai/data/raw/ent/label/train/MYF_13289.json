        "term": [
            {
                "speaker_id": "1",
                "transcription": "어유 좋은 엄마 아빠가 나타나야 될텐데 우리집에",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.481
            },
            {
                "speaker_id": "2",
                "transcription": "따뜻한 물수건으로 최대한 좀 닦아주시고요.",
                "sound_type": [
                    2
                ],
                "start": 3.491,
                "end": 5.727
            },
            {
                "speaker_id": "1",
                "transcription": "예",
                "sound_type": [
                    2
                ],
                "start": 5.737,
                "end": 6.129
            },
            {
                "speaker_id": "2",
                "transcription": "그 저기",
                "sound_type": [
                    2
                ],
                "start": 6.139,
                "end": 7.549
            },
            {
                "speaker_id": "1",
                "transcription": "드라이기로 따뜻하게 말려주고 예",
                "sound_type": [
                    2
                ],
                "start": 7.559,
                "end": 11.185
            },
            {
                "speaker_id": "2",
                "transcription": "거기서 그냥 몇번 돌리시면서 거기서 밥하고 물 넣어주시면",
                "sound_type": [
                    2
                ],
                "start": 11.195,
                "end": 16.513
            },
            {
                "speaker_id": "1",
                "transcription": "맞아요. 선생님",
                "sound_type": [
                    2
                ],
                "start": 16.523,
                "end": 17.453
            },
            {
                "speaker_id": "2",
                "transcription": "예",
                "sound_type": [
                    2
                ],
                "start": 17.463,
                "end": 17.881
            },
            {
                "speaker_id": "1",
                "transcription": "거기 한 38도 하니까 딱 적당한 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 17.891,
                "end": 20.678
            },
            {
                "speaker_id": "2",
                "transcription": "그렇게 해서 한 두세 사이클 돌려보면 어느 정도 천천히 오를 거거든요.",
                "sound_type": [
                    2
                ],
                "start": 20.688,
                "end": 25.979
            },
            {
                "speaker_id": "2",
                "transcription": "그럼 기운도 좀 나면 거기 물하고 밥도 먹고 그러면 많이 좋아질 거예요. 물론 너무 오래 두면 좀 문제 있는데 그래도 물 넣어주시니까",
                "sound_type": [
                    2
                ],
                "start": 25.989,
                "end": 37.113
            },
            {
                "speaker_id": "1",
                "transcription": "그래 맞아 그렇게 하자 에이구 일단은",
                "sound_type": [
                    2
