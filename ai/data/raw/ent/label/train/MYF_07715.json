        "term": [
            {
                "speaker_id": "1",
                "transcription": "소리 나는 게 이거야 참아 참이도 관심이 가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.303
            },
            {
                "speaker_id": "2",
                "transcription": "이건 뭐예요 엄마?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.313,
                "end": 4.839
            },
            {
                "speaker_id": "2",
                "transcription": "이거 이거 이상한 거 반짝반짝해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.849,
                "end": 10.044
            },
            {
                "speaker_id": "1",
                "transcription": "오 이상해 소리는 나는데 맛있진 않고 어 참아",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 10.054,
                "end": 18.496
            },
            {
                "speaker_id": "3",
                "transcription": "거기다 왜 올려",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.506,
                "end": 19.663
            },
            {
                "speaker_id": "1",
                "transcription": "참아 야 우리 참이는 너무나 포스가 참아 엄마 네가 무섭다 응?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.673,
                "end": 28.395
            },
            {
                "speaker_id": "1",
                "transcription": "쑥이하고 완전 패턴이 달라 안 돼 안 돼",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.405,
                "end": 31.883
            },
            {
                "speaker_id": "1",
                "transcription": "그거는 떨어뜨리는 장난감이 아니야 참아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.893,
                "end": 34.650
            },
            {
                "speaker_id": "1",
                "transcription": "참이로부터 보호해야 되겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.660,
                "end": 39.798
            },
            {
                "speaker_id": "1",
                "transcription": "어이구 참참이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.808,
                "end": 44.010
            }
        ]
    },
    "summary": "화자는 오르골을 건드리다가 떨어뜨리는 고양이에게 보호해야겠다고 이야기한다.",
