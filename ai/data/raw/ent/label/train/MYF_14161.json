                    3
                ],
                "start": 0.000,
                "end": 4.407
            },
            {
                "speaker_id": "1",
                "transcription": "요기 팔 보시면 안 보이나 지금 쑥이 지니",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.407,
                "end": 8.494
            },
            {
                "speaker_id": "1",
                "transcription": "팔 그 라인 잡은 거 안 보여?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.504,
                "end": 10.932
            },
            {
                "speaker_id": "1",
                "transcription": "팔에 왼쪽 팔에 털을 좀 깎아가지고요 라인을 잡고 혈액검사를 했어요.",
