        "term": [
            {
                "speaker_id": "1",
                "transcription": "트레이드 한 어떠한 임금을 지불한다든지 그런 기업 철학을 본다고 하셨고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.009
            },
            {
                "speaker_id": "1",
                "transcription": "또 하나 더는 사용하고 있는 원료가 진짜 사람한테 안전한지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.019,
                "end": 9.824
            },
            {
                "speaker_id": "1",
                "transcription": "그런 것도 보고 또 하나 더는 동물 실험 하지 않는 거 크게는 이런 것들 보고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.834,
                "end": 14.799
            },
            {
                "speaker_id": "1",
                "transcription": "카히나 기빙이라고 그 대표가 모로코 여행을 가서 거기에 있는 베르베르 여성들을 만나게 됐는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.809,
                "end": 23.302
            },
            {
                "speaker_id": "1",
                "transcription": "그녀들이 굉장히 좋은 아르간 열매를 채집하고 까고 다듬는 일을 하는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.312,
                "end": 30.170
            },
            {
                "speaker_id": "1",
                "transcription": "너무나 저렴한 임금을 받고 있는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.180,
                "end": 33.200
            }
        ]
    },
    "summary": "기업 철학을 보고 사용하고 있는 원료가 사람에게 안전 한 지, 동물 실험 하지 않는 것들 주로 보고 카히나 기빙의 대표가 모로코 여행에서 베르베르 여성들을 만났는데 저렴한 임금을 받고 있었다.",
