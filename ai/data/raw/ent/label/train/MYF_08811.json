        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "올 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 0.542
            },
            {
                "speaker_id": "1",
                "transcription": "아이 주원이 마음씨도 착하네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.552,
                "end": 4.346
            },
            {
                "speaker_id": "2",
                "transcription": "예찌 보세요 예찌.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.356,
                "end": 11.060
            },
            {
                "speaker_id": "2",
                "transcription": "비키네 어머",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.070,
                "end": 12.852
            },
            {
                "speaker_id": "1",
                "transcription": "절대 안 뺏겨요 어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.862,
                "end": 14.557
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 원영이가 없잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.567,
                "end": 18.044
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 같이 먹어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.054,
                "end": 19.244
            },
            {
                "speaker_id": "2",
                "transcription": "그 순간만.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.254,
                "end": 23.698
            },
            {
                "speaker_id": "1",
                "transcription": "어 로우가 철이 없어 예예예 그 누가 누나 뭐 형이 있는지 다 자기 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.708,
                "end": 32.536
            },
            {
                "speaker_id": "2",
                "transcription": "형이니까 이렇게 뒷모습 보니까 형이네 형",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.546,
                "end": 37.944
            },
            {
                "speaker_id": "2",
                "transcription": "앉아있는 어 사이즈가 크네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.954,
                "end": 45.934
            },
            {
                "speaker_id": "1",
                "transcription": "올해는 다소 달라질 줄 알았다고 줄 때까지 기다려.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.944,
                "end": 50.800
            },
            {
                "speaker_id": "1",
                "transcription": "얼마나 이게 자존심이 어머 눈빛만 봐도 어머 샤샤 소리가",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.810,
                "end": 68.186
            },
            {
                "speaker_id": "2",
                "transcription": "왜 다른 친구들이 안 나오지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.196,
                "end": 70.338
            },
            {
                "speaker_id": "1",
                "transcription": "먹고 싶을 텐데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.348,
                "end": 77.467
            },
            {
                "speaker_id": "2",
                "transcription": "오랜만에 주원이가 토프한테 던져줬어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.477,
                "end": 89.522
            }
        ]
    },
    "summary": "주원이가 먹이를 주자 노아는 누나든 형이 있든지 다 자기 거라고 한다.",
