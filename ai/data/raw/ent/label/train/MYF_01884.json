            },
            {
                "speaker_id": "1",
                "transcription": "지방시의 이레지스터블이라는 향수가 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 1.961,
                "end": 5.675
            },
            {
                "speaker_id": "1",
                "transcription": "이 향수가 흔하진 않아요.",
                "sound_type": [
                    2
                ],
                "start": 5.685,
                "end": 8.341
            },
            {
                "speaker_id": "1",
                "transcription": "흔하진 않은데 그치만 조금 꽃의 그런 플로럴한 느낌들이 너무 강하게 등장하지는 않아서 그런데 그렇게 흔하지는 않지만 그렇지만 또 어디선가 만나본 것 같은 익숙한 느낌을 선사를 해주거든요.",
                "sound_type": [
                    2
                ],
                "start": 8.351,
                "end": 26.116
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 몽글몽글 부드럽게 잔잔하게 은은하게 이렇게 피부에는 계속 남아주기 때문에 이 향수가 어떨까 그 생각을 딱 이거 보자마자 제가 하게 됐습니다.",
                "sound_type": [
