        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "딱 컴팩트하게 이게 딱 들어가 무게도 이렇게 무겁지 않아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.848
            },
            {
                "speaker_id": "1",
                "transcription": "사이즈도 딱 손바닥만한 요런 사이즈라 그렇게 부담없이 갖고 다닐 수 있는 고런 정도의 사이즈입니다.",
                "sound_type": [
                    2
                ],
                "start": 2.858,
                "end": 10.028
            },
            {
                "speaker_id": "1",
                "transcription": "요것도 굉장히 가성비 있는 가격이에요.",
                "sound_type": [
                    2
                ],
                "start": 10.038,
                "end": 12.513
            },
            {
                "speaker_id": "1",
                "transcription": "관심 있으신 분들은 더보기 란에 구매 링크 한번 확인하시면 좋을 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 12.523,
                "end": 16.774
            },
            {
                "speaker_id": "1",
                "transcription": "괜찮습니다 예 저도 차에다 항상 싣고 다녀야 되겠어요 이거",
                "sound_type": [
                    2
                ],
                "start": 16.784,
                "end": 20.915
            },
            {
                "speaker_id": "1",
                "transcription": "아 전에부터 이런 거 하나 있어서 살까 말까 맨날 생존 키트 살까 말까 고민했었는데 요게 딱 이렇게 생겼네요.",
                "sound_type": [
                    2
                ],
                "start": 20.925,
                "end": 26.882
            },
            {
                "speaker_id": "1",
                "transcription": "잘 쓰도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
