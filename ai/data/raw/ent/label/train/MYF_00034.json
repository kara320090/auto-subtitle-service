        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러면 제가 어 정말 군인들은 여군들은 결혼을 쫌 일찍하는 편입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.028
            },
            {
                "speaker_id": "1",
                "transcription": "그 이유가 어 군에 들어오면 사실 좋은 혜택들이 많이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 7.038,
                "end": 11.584
            },
            {
                "speaker_id": "1",
                "transcription": "특히 결혼을 하게 되면 어 독신자 숙소에 살았다가 바로 인제 군인 아파트나 관사를 제공 받게 돼요.",
                "sound_type": [
                    2
                ],
                "start": 11.594,
                "end": 18.248
            },
            {
                "speaker_id": "1",
                "transcription": "이게 어떻게 보면 가장 내 삶에 안정적으로 어 보금자리를 마련해주는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 18.258,
                "end": 23.876
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니까 빨리 자리를 잡아서 나는 결혼을 해서 안정적으로 군 생활을 하고 싶어라는 그런 것도 있고 또 여군 분들은 어 이쁘든 이쁘지 않든 남자들이 많은 집단에 가잖아요.",
                "sound_type": [
                    2
                ],
                "start": 23.886,
                "end": 36.123
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니까 많은 썸씽이나 그리고 우리 총각들이 많이 이렇게 대시를 해오는 경우가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.133,
                "end": 41.989
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니까 밖에 보다 확률이 높겠죠.",
                "sound_type": [
                    2
                ],
                "start": 41.999,
                "end": 45.293
            },
            {
                "speaker_id": "1",
                "transcription": "많은 남자들을 만나니까 그렇게 결혼할 확률이 빨라지다 보니까 결혼을 일찍하는 경우인데요.",
                "sound_type": [
                    2
                ],
                "start": 45.303,
                "end": 51.016
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니 결혼을 하면 당연히 아이가 생기죠.",
                "sound_type": [
                    2
                ],
                "start": 51.026,
                "end": 54.503
            },
            {
                "speaker_id": "1",
                "transcription": "아이가 생기면 당연히 양육을 해야 되고요.",
                "sound_type": [
                    2
                ],
                "start": 54.513,
                "end": 57.385
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니까 이렇게 결혼 생활을 하면서 군 생활을 하는데 쫌 많은 시행착오들이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 57.395,
                "end": 64.157
            },
            {
                "speaker_id": "1",
                "transcription": "저의 경험으로 얘기하면 저는 지금 아이가 셋이지만 사실 3번의 임신을 한 게 아니고요.",
                "sound_type": [
                    2
                ],
                "start": 64.167,
                "end": 69.553
            },
            {
                "speaker_id": "1",
                "transcription": "4번의 임신을 했어요.",
                "sound_type": [
                    2
                ],
                "start": 69.563,
                "end": 71.024
            },
            {
                "speaker_id": "1",
                "transcription": "첫째를 낳고 정말 아무것도 모른 상태에서 정신 없이 육아 케어하면서 군 생활을 하면서 다시 둘째를 가지니까 어 제 몸이 버티지 못하고 유산을 해버린 거죠.",
                "sound_type": [
                    2
                ],
                "start": 71.034,
                "end": 83.447
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 나서 다시 둘째를 갖고 낳고 셋째를 낳고 처음이 힘들지 사실 둘째 셋째는 어 금방인데 사실 우리 여군 분들 중에 다자녀가 많아요.",
                "sound_type": [
                    2
                ],
                "start": 83.457,
                "end": 93.930
            },
            {
                "speaker_id": "1",
                "transcription": "저는 여군 분들 중에 5명까지 낳으신 분을 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 93.940,
                "end": 97.916
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 어 자기가 능력껏 하면 되는데 첫째 때가 가장 힘들고 딜레마를 많이 겪어요.",
                "sound_type": [
                    2
                ],
                "start": 97.926,
                "end": 104.420
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면",
                "sound_type": [
                    2
                ],
                "start": 104.430,
                "end": 105.440
            }
        ]
    },
    "summary": "여군들은 결혼을 일찍하는 편인데 그 이유가 결혼을 하면 아파트나 관사를 제공 받게 되고 아무래도 남자가 많은 집단이다 보니 바깥보다는 확률이 높다고 얘기한다.",
