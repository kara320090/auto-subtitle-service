        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 이러고 조수석에서도 약간 미어캣 돼갖고 요렇게 해갖고 이렇게 꺼낸단 말이야 그런데 여기에는 안에 등이 없어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.859
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 수납장에도 LED를 넣고요.",
                "sound_type": [
                    2
                ],
                "start": 6.860,
                "end": 9.235
            },
            {
                "speaker_id": "1",
                "transcription": "도어 포켓에도 LED가 들어갑니다.",
                "sound_type": [
                    2
                ],
                "start": 9.235,
                "end": 12.010
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 도어가 딱 열었을 때 완전 멋져지겠죠.",
                "sound_type": [
                    2
                ],
                "start": 12.010,
                "end": 15.835
            },
            {
                "speaker_id": "1",
                "transcription": "어후 야 네 차 뭐야 약간 이렇게 되는 거지.",
                "sound_type": [
                    2
                ],
                "start": 15.835,
                "end": 18.000
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스피커에도 들어가고요. 풋등에",
                "sound_type": [
                    2
                ],
                "start": 18.000,
                "end": 21.266
            }
        ]
    },
    "summary": "수납장과 도어 포켓, 스피터에 LED 등을 설치할 것이다.",
