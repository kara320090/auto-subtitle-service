        "term": [
            {
                "speaker_id": "1",
                "transcription": "시슬리는 명망 높은 그 귀족 집안인 도르나노 가문에서 만들어내는 화장품이고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.331
            },
            {
                "speaker_id": "1",
                "transcription": "1963년에 위베르 도르나로가 폴란드 공주의 딸하고 이제 결혼을 해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.341,
                "end": 14.422
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 두 사람이 만들어낸 브랜드가 시슬리입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.432,
                "end": 17.822
            },
            {
                "speaker_id": "1",
                "transcription": "시슬리는 그 옛날부터요.",
                "sound_type": [
                    2
                ],
                "start": 17.832,
                "end": 19.709
            },
            {
                "speaker_id": "1",
                "transcription": "천연 식물 추출액을 가지고 화장품을 만들었거든요.",
                "sound_type": [
                    2
                ],
                "start": 19.719,
                "end": 23.533
            }
        ]
    },
    "summary": "1963년에 위베르 도르나로가 폴란드 공주의 딸하고 결혼을 해서 만들어낸 브랜드가 시슬리이고 옛날부터 천연 식물 추출액으로 화장품을 만들어냈습니다.",
