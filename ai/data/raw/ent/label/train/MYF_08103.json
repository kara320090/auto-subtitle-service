        "term": [
            {
                "speaker_id": "1",
                "transcription": "시루 뭐 하지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.447
            },
            {
                "speaker_id": "1",
                "transcription": "달래가 시루가 뭐하는지 궁금한 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.457,
                "end": 4.273
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 보면 달래도 시루에게 관심은 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.283,
                "end": 8.600
            },
            {
                "speaker_id": "1",
                "transcription": "엄마처럼 혹시나 시루가 다칠까 봐 달래는 늘 시루 옆에서 지켜보고 있답니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.610,
                "end": 18.652
            },
            {
                "speaker_id": "1",
                "transcription": "근데 우리 시루가 그걸 알까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.662,
                "end": 21.739
            },
            {
                "speaker_id": "1",
                "transcription": "저희들 눈에는 보이는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.749,
                "end": 24.732
            },
            {
                "speaker_id": "1",
                "transcription": "그쵸.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.742,
                "end": 25.683
            },
            {
                "speaker_id": "1",
                "transcription": "달래 고마워",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.693,
                "end": 31.552
            },
            {
                "speaker_id": "1",
                "transcription": "달래 고마워 우리 달래 고마워",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.562,
                "end": 37.301
            },
            {
                "speaker_id": "1",
                "transcription": "고맙다 달래야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.311,
                "end": 39.573
            },
            {
                "speaker_id": "1",
                "transcription": "시루와 우리 달래가 모자지간이 될 수 있을까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.583,
                "end": 48.948
            }
        ]
    },
    "summary": "달래도 시루어게 관심이 없는 것은 아니다.",
