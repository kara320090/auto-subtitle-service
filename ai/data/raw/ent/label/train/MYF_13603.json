        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 뭔가 고양이 친구들에게는 새롭게 보이는 것이 더 재밌어 보이나 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.989
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 굿똥 화장실을 가지고 이렇게 다묘 가정에 어 집에서는 거실에 또 지금은 약간 날씨가 쌀쌀하니까 베란다를 많이 활용하지 못할 때에는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.999,
                "end": 19.526
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 실내를 사용해서 2층 화장실로 사용해 보는 것도 좀 어 좋은 방법 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.536,
                "end": 27.874
            },
            {
                "speaker_id": "1",
                "transcription": "노랑이도 왔어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.884,
                "end": 29.268
            },
            {
                "speaker_id": "1",
                "transcription": "노랑아 얘들아 거기 모여서 뭐하는 거니 너희들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.278,
                "end": 33.964
            },
            {
                "speaker_id": "1",
                "transcription": "정말 화장실도 함께 가는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.974,
                "end": 40.106
            }
        ]
    },
    "summary": "베란다 화장실을 활용하지 못할 때는 실내에 2층 화장실을 사용하는 것이 좋다고 한다.",
