    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러고 나서 미국에서 1953년에 에스티로더의 유스 듀라는 향수가 출시가 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.722
            },
            {
                "speaker_id": "1",
                "transcription": "정말 많은 사람들에게 사랑을 받게 되는 향수이죠.",
                "sound_type": [
                    2
                ],
                "start": 5.732,
                "end": 9.197
            },
            {
                "speaker_id": "1",
                "transcription": "샤넬과 디올과 같은 패션 하우스와 에스티로더와 같은 코스메틱 회사들의 향수들이 사람들에게 큰 사랑을 받게 되어요.",
                "sound_type": [
                    2
                ],
                "start": 9.207,
                "end": 17.844
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 향수만을 만드는 향수 회사가 생겨나기 시작을 했다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 17.854,
                "end": 24.077
            },
            {
                "speaker_id": "1",
                "transcription": "1976년에 오픈한 회사가 바로 라티잔 퍼퓸의 화학자이자 조향사인 라티쟌 파퓨메가 설립한 회사예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.087,
                "end": 33.052
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 전체적인 향수 시장에서 화학자이자 조향사가 처음으로 만들어 낸 브랜드다 보니 라티잔 파퓨메를 리치 퍼퓸으로 이야기할 때 가장 첫 번째로 이야기를 하게 되어요.",
                "sound_type": [
                    2
                ],
                "start": 33.062,
                "end": 45.576
            },
            {
                "speaker_id": "1",
                "transcription": "딥티크 같은 경우에는 1976년보다 더 먼저인 1961년에 프랑스 파리의 생 제르망에서 시작을 하게 되죠.",
                "sound_type": [
                    2
                ],
                "start": 45.586,
                "end": 53.700
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 1963년에 오베핀이라는 향초를 만들고 1968년에 최초의 향수가 출시가 되고요.",
                "sound_type": [
                    2
                ],
                "start": 53.710,
                "end": 60.174
            },
            {
                "speaker_id": "1",
                "transcription": "처음에 시작이 디자이너들과 함께 만들어 낸 편집샵이었어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.184,
                "end": 65.168
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아무래도 조향사가 향수만 먼저 생각하고서 만들어 낸 라티잔 파퓨메를 조금 더 먼저 이야기를 하게 되어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 65.178,
                "end": 73.551
            },
            {
                "speaker_id": "1",
                "transcription": "1980년에 아닉 구딸이라는 브랜드가 오픈합니다.",
                "sound_type": [
                    2
                ],
                "start": 73.561,
                "end": 77.570
            },
            {
                "speaker_id": "1",
                "transcription": "피아니스트이자 모델이었던 아닉 구딸이 이제 오픈한 브랜드이고요.",
                "sound_type": [
                    2
                ],
                "start": 77.580,
                "end": 82.081
            },
            {
                "speaker_id": "1",
                "transcription": "현재는 구딸이라는 이름으로 바뀌었어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 82.091,
                "end": 85.384
            },
            {
                "speaker_id": "1",
                "transcription": "패키지도 변경이 되었고요.",
                "sound_type": [
                    2
                ],
                "start": 85.394,
                "end": 87.194
            },
            {
                "speaker_id": "1",
                "transcription": "조향은 아니 구딸의 딸인 까밀 구딸이 계속 진행을 하고 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 87.204,
                "end": 91.712
            },
            {
                "speaker_id": "1",
                "transcription": "1989년에는요.",
                "sound_type": [
                    2
                ],
                "start": 91.722,
                "end": 93.909
            },
            {
                "speaker_id": "1",
                "transcription": "피에르 겔랑의 손녀딸인 패트리샤 드 겔랑 나중에 이제 니콜라이 집안에 시집을 가서 페트리샤 드 니콜라이가 되는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 93.919,
                "end": 102.748
            },
            {
                "speaker_id": "1",
                "transcription": "1989년에 그녀가 니콜라이라는 이름으로 니치 향수를 만들게 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 102.758,
                "end": 108.652
            },
            {
                "speaker_id": "1",
                "transcription": "여자 조향사로서 처음으로 만들어 내는 조향사가 만든 니치 퍼퓨머리가 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 108.662,
                "end": 114.773
            },
            {
                "speaker_id": "1",
                "transcription": "책 퍼퓸스 레어의 저자이면서요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 114.783,
                "end": 117.766
            },
            {
                "speaker_id": "1",
                "transcription": "전 세계적으로 가장 많은 향에 대한 기록을 보관하고 있는 오스모 테크의 관장이기도 한 니콜라이 여사님은 이렇게 말씀을 또 하셨어요.",
                "sound_type": [
                    2
                ],
                "start": 117.776,
                "end": 127.497
            },
            {
                "speaker_id": "1",
                "transcription": "1980년대 후반에 향수에 있어서 창조 정신이 결여되어 있다는 것을 느꼈습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 127.507,
                "end": 133.889
            },
            {
                "speaker_id": "1",
                "transcription": "이러한 향수 업계의 등장은 니치 퍼퓨머리는 커다란 돌풍을 일으켰고 제가 그 돌풍에 선구자 중 한 사람이라는 것이 참으로 자랑스럽습니다.",
                "sound_type": [
                    2
                ],
                "start": 133.899,
                "end": 144.271
            },
            {
                "speaker_id": "1",
                "transcription": "온좋게 한국에 오셨을 때 잠깐 만나서 수다를 떨 시간이 있었거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 144.281,
                "end": 149.364
            },
            {
                "speaker_id": "1",
                "transcription": "참으로 기품이 있으시고요.",
                "sound_type": [
                    2
                ],
                "start": 149.374,
                "end": 151.105
            },
            {
                "speaker_id": "1",
                "transcription": "매너 좋으시고 케이프 네롤리를 이제 설명하실 때 너무나 천진난만하게 이야기를 해주셔서 여전히 기억이 납니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 151.115,
                "end": 159.702
            },
            {
                "speaker_id": "1",
                "transcription": "직접 명감이 되었던 그 지역의 사진도 보여 주시고요.",
                "sound_type": [
                    2
                ],
                "start": 159.712,
                "end": 163.145
            },
            {
                "speaker_id": "1",
                "transcription": "여전히 왕성한 창작 활동동을 하고 계세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 163.155,
                "end": 165.841
            },
            {
                "speaker_id": "1",
                "transcription": "라티잔 파퓨메, 구딸, 딥티크 그리고 니콜라이 이렇게 패션 하우스나 코스메틱에서 향수를 이렇게 뭔가 사이드 메뉴처럼 내놓은 것이 아니라 향수만을 생각하면서 향수 자체를 만들어 내는 브랜드가 생겨 나기 시작을 한 거죠.",
                "sound_type": [
                    2
                ],
                "start": 165.851,
                "end": 184.061
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 거대한 시장에서 봤을 때는 하나의 틈새라고 보기 때문에 틈새, 니치 향수라고 부르기 시작했습니다.",
                "sound_type": [
                    2
                ],
                "start": 184.071,
                "end": 192.815
            },
            {
                "speaker_id": "1",
                "transcription": "사실 시장에서 기존의 니치 향수라고 불렀던 이러한 브랜드들이 차지하는 비중이 점점 커지기 시작을 해요.",
                "sound_type": [
                    2
                ],
                "start": 192.825,
                "end": 201.002
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 향수의 권위자의 지금 현재 시대의 향수의 권위자인 프레데릭 말이 이런 말도 했었거든요.",
                "sound_type": [
                    2
                ],
                "start": 201.012,
                "end": 207.827
            },
            {
                "speaker_id": "1",
                "transcription": "사실 니치 향수로 시작을 했지만",
                "sound_type": [
                    2
                ],
                "start": 207.837,
                "end": 210.666
            }
        ]
    },
    "summary": "패션 하우스나 코스메틱에서 향수만을 생각하면서 향수 자체를 만들어 내는 브랜드가 생겨 나기 시작을 하고 거대한 시장에서 봤을 때 하나의 틈새라고 보기 때문에 틈새, 니치 향수라고 부르기 시작했다고 설명합니다.",
