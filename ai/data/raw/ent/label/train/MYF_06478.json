        "term": [
            {
                "speaker_id": "1",
                "transcription": "고추 장아찌까지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.448
            },
            {
                "speaker_id": "1",
                "transcription": "자 크게 싸서 한 입",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.458,
                "end": 10.143
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기 있는 웬만한 걸 다 넣었더니 너무 맛있어서 바로 따봉이 나와주는 맛이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.153,
                "end": 14.573
            },
            {
                "speaker_id": "1",
                "transcription": "오 이건 뭐죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.583,
                "end": 16.145
            },
            {
                "speaker_id": "1",
                "transcription": "명란젓도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.155,
                "end": 17.565
            },
            {
                "speaker_id": "1",
                "transcription": "정말 밑반찬 하나하나 맛만 봐도 즐거운 그런 식사 시간이 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.575,
                "end": 22.150
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 생삼겹 맙도 보기 위해서 생삼겹도 주문했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.160,
                "end": 26.054
            },
            {
                "speaker_id": "1",
                "transcription": "어 사장님께서 친절하게 설명해 주고 계신데 내용을 요약하자면 정말 퀄리티 좋은 삼겹살을 사 와서 그거를 직접 숙성을 시키고 또 그것을 직접 냉동을 시켜서 판다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.064,
                "end": 36.592
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 생삼겹과 냉삼겹이 같은 고기라는 점이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.602,
                "end": 40.523
            },
            {
                "speaker_id": "1",
                "transcription": "둘 다 퀄리티가 아주 좋은 신선한 고기라는 점을 사장님께서 설명해 주셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.533,
                "end": 44.420
            },
            {
                "speaker_id": "1",
                "transcription": "묵은지도 올리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.430,
                "end": 49.604
            },
            {
                "speaker_id": "1",
                "transcription": "잘 익은 삼겹살을 한 입",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.614,
                "end": 52.933
            }
        ]
    },
    "summary": "화자가 사장님의 설명을 듣고 요약했는데 퀄리티가 좋은 삼겹살을 사 와서 직접 숙성시켜 만든 생삼겹과 그것을 직접 냉동시켜 만든 고기가 냉삼겹이기 때문에 둘 다 퀄리티가 아주 좋은 신선한 고기라 했다.",
