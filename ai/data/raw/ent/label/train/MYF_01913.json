        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 영향력이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.646
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 뭔가 내공이 있을 것 같다?",
                "sound_type": [
                    2
                ],
                "start": 2.656,
                "end": 5.873
            },
            {
                "speaker_id": "1",
                "transcription": "근데 한눈에 봐서 막 이렇게 너무 막 유명하거나 막 이런 게 아니라 그런 게 아니라 정말 그, 네.",
                "sound_type": [
                    2
                ],
                "start": 5.883,
                "end": 15.037
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 마스터 조향사님처럼 그 한 분야에서 최고시기 때문에 우리가 그 분야에 관심 있는 사람들은 이분을 알아보잖아요.",
                "sound_type": [
                    2
                ],
                "start": 15.047,
                "end": 25.802
            },
            {
                "speaker_id": "1",
                "transcription": "그런 사람한테서 날 것 같은 향이에요.",
                "sound_type": [
                    2
                ],
                "start": 25.812,
                "end": 28.864
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 뭐 전 국민이 다 아는 그런 연예인이나 유명한 사람이 아니라 딱 그 분야에서 뭔가 정말 뚝심 있게 무언가를 꾸준히 성취해 내시고 그리고 성취해 나가실, 이루어 나가실 그런",
                "sound_type": [
                    2
                ],
                "start": 28.874,
                "end": 44.433
            }
        ]
    },
    "summary": "전 국민이 다 아는 연예인이 아니라 한 분야에서 뚝심 있게 파고드는 사람에게서 날 것 같은 향이다.",
