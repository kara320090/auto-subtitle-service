                    2
                ],
                "start": 8.513,
                "end": 20.641
            },
            {
                "speaker_id": "1",
                "transcription": "다시 한번 지금까지 함께해 주시는 그리고 앞으로도 함께해 주실 모든 분들께 너무나 감사드리고요.",
                "sound_type": [
