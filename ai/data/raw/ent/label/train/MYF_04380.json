                ],
                "start": 0.000,
                "end": 1.833
            },
            {
                "speaker_id": "2",
                "transcription": "그럼요 이거 좋네요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.843,
                "end": 3.051
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 또 재미있는 게 제가 4번, 2번, 9번을 좋아한다고 했잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.061,
                "end": 9.600
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이것들을 레이어링을 해서 한 번씩 쓰는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.610,
                "end": 14.939
            },
            {
                "speaker_id": "1",
                "transcription": "4번 한 줄",
                "sound_type": [
