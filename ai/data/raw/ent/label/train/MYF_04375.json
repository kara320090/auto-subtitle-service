        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 이렇게 또 설명을 들으면서 이 향을 맡으면 진짜 뭔가 티가 생각이 나요 오렌지 향 티가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.719
            },
            {
                "speaker_id": "2",
                "transcription": "어우 좋아요 네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.729,
                "end": 10.864
            },
            {
                "speaker_id": "1",
                "transcription": "카시스 유일하게 넘버가 없더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.874,
                "end": 15.445
            },
            {
                "speaker_id": "1",
                "transcription": "왜 넘버가 없는지는 전화 한 번 해볼까 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.455,
                "end": 19.712
            },
            {
                "speaker_id": "2",
                "transcription": "카시스를 또 좋아하는 분들이 계세요 카시스만 소장하시는 분들이 계시거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.722,
                "end": 25.122
            },
            {
                "speaker_id": "1",
                "transcription": "카시스가 뭔가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.132,
                "end": 25.538
            },
            {
                "speaker_id": "2",
                "transcription": "카시스는 이제 블랙커런트 베리류에 이제 과일이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.548,
                "end": 30.085
            },
            {
                "speaker_id": "1",
                "transcription": "저는 개인적으로는 크게 제 스타일은 아니라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.095,
                "end": 33.900
            }
        ]
    },
    "summary": "제품 중 유일하게 번호가 없는 카시스는 블랙커런트 베리류의 과일이다.",
