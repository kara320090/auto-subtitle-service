        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 쉽겟에서 산 그 모기 기피 그거 구충제 있잖아요 그건 지금 차 안에다가 켜 놨어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.741
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뭐 저걸 켜 가지고 뭐 모기가 원래 오늘 모기는 없어 파리가 좀 돌아다녀서 그렇지",
                "sound_type": [
                    2
                ],
                "start": 5.751,
                "end": 12.244
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 뭐 얼마나 큰 효과가 있는진 정확하게 모르겠어요.",
                "sound_type": [
                    2
                ],
                "start": 12.254,
                "end": 15.601
            },
            {
                "speaker_id": "1",
                "transcription": "그거 펴 가지고 뭐 덜 들어오는 건지 원래 날씨가 시원해서 덜 들어오는 건지",
                "sound_type": [
                    2
                ],
                "start": 15.611,
                "end": 20.022
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 그냥 차 안에다가 펴 왔어요 차 안에다가 차 안에 모기 조금이라도 덜 들어오라고",
                "sound_type": [
                    2
                ],
                "start": 20.032,
                "end": 24.655
            },
            {
                "speaker_id": "1",
                "transcription": "좀 이따 방충망도 쳐야 할 것 같아",
                "sound_type": [
                    2
                ],
                "start": 24.665,
                "end": 27.139
            },
            {
                "speaker_id": "1",
                "transcription": "차 트렁크 방충망은 쳐 놨습니다 일단",
                "sound_type": [
                    2
                ],
                "start": 27.149,
                "end": 30.158
            },
            {
                "speaker_id": "1",
                "transcription": "어 귀신 같아",
                "sound_type": [
                    2
                ],
                "start": 30.168,
                "end": 31.998
            }
        ]
    },
