        "term": [
            {
                "speaker_id": "1",
                "transcription": "무슨 일이 있었나요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 0.876
            },
            {
                "speaker_id": "1",
                "transcription": "저는 잘 기억이 안 나는데.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.886,
                "end": 2.316
            },
            {
                "speaker_id": "2",
                "transcription": "조수석에 앉아 있던 분의 말씀에 의하면 주차도 하지 않고 그냥 차를 파킹해놓고 그냥 가버렸다는 소문이 있는데 무슨 일이 있었던 겁니까?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.326,
                "end": 9.596
            },
            {
                "speaker_id": "1",
                "transcription": "일단 저는 좀 많이 급했기 때문에 예.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.606,
                "end": 13.621
            },
            {
                "speaker_id": "2",
                "transcription": "급한 일은 급한 일은 어떤 일이 어떤 일이었습니까?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.631,
                "end": 18.218
            },
            {
                "speaker_id": "1",
                "transcription": "어 일단 좀 밥맛 떨어지니까 그 얘기는 좀 뒤로 접어두도록 하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 18.228,
                "end": 24.094
            },
            {
                "speaker_id": "2",
                "transcription": "그 일이 혹시 한 글자인가요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 24.104,
                "end": 27.482
            },
            {
                "speaker_id": "1",
                "transcription": "한 글자도 되고 두 글자도 됩니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 27.492,
                "end": 32.615
            },
            {
                "speaker_id": "1",
                "transcription": "야 이씨 잔인한 새끼",
