                    5
                ],
                "start": 6.404,
                "end": 20.916
            },
            {
                "speaker_id": "1",
                "transcription": "요 어떤 제품이냐 반다이 캠핑아시죠 여러분들 많이들 보셨을 거예요.",
                "sound_type": [
                    2,
