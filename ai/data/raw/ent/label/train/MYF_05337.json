        "term": [
            {
                "speaker_id": "1",
                "transcription": "어쨌든 못 들은 건 내 잘못이고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.968
            },
            {
                "speaker_id": "2",
                "transcription": "이게 쌓였나 보다 미국 갔다 온.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.978,
                "end": 4.511
            },
            {
                "speaker_id": "1",
                "transcription": "미친 새끼 아니야 이러면서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.521,
                "end": 6.018
            },
            {
                "speaker_id": "1",
                "transcription": "캐스터랑 이제 방송국을 비하하는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.028,
                "end": 7.992
            },
            {
                "speaker_id": "1",
                "transcription": "심려를 끼쳐드린 방송국한테 미안한 거지 이거는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.002,
                "end": 10.628
            },
            {
                "speaker_id": "1",
                "transcription": "방송국은 위원님 무슨 일이세요 무슨 이유인지 알았어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.638,
                "end": 14.070
            },
            {
                "speaker_id": "1",
                "transcription": "그러는데 내가 무슨 변명을 하겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.080,
                "end": 15.772
            },
            {
                "speaker_id": "2",
                "transcription": "그렇지 말하기 힘드니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.782,
                "end": 18.731
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 끝나고 나서 이제",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.741,
                "end": 20.653
            }
        ]
    },
    "summary": "한 남성이 캐스터와 방송국을 비하한 누군가에 대해 말하고 있다.",
