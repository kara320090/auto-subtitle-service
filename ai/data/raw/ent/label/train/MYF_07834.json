                "end": 1.149
            },
            {
                "speaker_id": "1",
                "transcription": "음 아이 좋은 냄새가 나는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.159,
                "end": 4.303
            },
            {
                "speaker_id": "1",
                "transcription": "왜 엄마는 안 주는 거지 그지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.313,
                "end": 6.499
            },
            {
                "speaker_id": "1",
                "transcription": "이 속에 있어.",
