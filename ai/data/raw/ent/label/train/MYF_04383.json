        "term": [
            {
                "speaker_id": "1",
                "transcription": "인기가 너무 많아서 스프레이로 너무 예쁘지 않습니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.399
            },
            {
                "speaker_id": "2",
                "transcription": "예쁩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.409,
                "end": 5.643
            },
            {
                "speaker_id": "2",
                "transcription": "음 역시 저도 이런 바틀로 만들고 싶어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.653,
                "end": 9.564
            },
            {
                "speaker_id": "2",
                "transcription": "이거 보면 단가만 보여서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.574,
                "end": 13.071
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 그것을 좀 더 라이트 하게 즐길 수 있게 이렇게 15미리리터도 나오거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.081,
                "end": 19.108
            },
            {
                "speaker_id": "2",
                "transcription": "아 그렇군요 중요하죠 네 그러면 지금까지 메종 루이 마리에 대해서 알아봤답니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.118,
                "end": 26.220
            },
            {
                "speaker_id": "2",
                "transcription": "여러분의 좋아요와 구독, 댓글, 알림 설정",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.230,
                "end": 30.080
            },
            {
                "speaker_id": "1",
                "transcription": "부탁드려요.",
                "sound_type": [
                    2
                ],
                "start": 30.090,
                "end": 32.145
            },
            {
                "speaker_id": "2",
                "transcription": "고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.155,
                "end": 33.780
            },
            {
                "speaker_id": "2",
                "transcription": "어 언니 고마워요.",
                "sound_type": [
                    2,
