        "term": [
            {
                "speaker_id": "1",
                "transcription": "개인적으로 저는 튜베로즈 향을 또 소장하기도 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.688
            },
            {
                "speaker_id": "1",
                "transcription": "튜베로즈가 주인공인 향수들을 가지고 한 번 또 영상을 만들어 보도록 할게요.",
                "sound_type": [
