        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와 우와 이게 어디 가냐?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.221
            },
            {
                "speaker_id": "1",
                "transcription": "이야 우와 우와 우와 대박이다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.231,
                "end": 22.111
            },
            {
                "speaker_id": "1",
                "transcription": "우와 우와 우와 우와 하 우와 너 뭐냐?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.121,
                "end": 36.673
            },
            {
                "speaker_id": "1",
                "transcription": "우와 잉어 같다.",
