                ],
                "start": 92.843,
                "end": 95.348
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 피아노 줄 소리 핑핑나는 거 잘 녹음이 됐나 모르겠네요.",
                "sound_type": [
