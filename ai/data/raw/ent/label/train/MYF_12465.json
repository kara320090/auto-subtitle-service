                    2,
                    5
                ],
                "start": 56.991,
                "end": 73.333
            },
            {
                "speaker_id": "1",
                "transcription": "초강 몬스터 44칸입니다.",
                "sound_type": [
                    2
                ],
                "start": 73.343,
                "end": 75.290
            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 저 앞에 찌가 캐미가 확 사라졌어요.",
                "sound_type": [
                    2
                ],
                "start": 75.300,
                "end": 78.431
            },
            {
                "speaker_id": "1",
                "transcription": "범인은 이 녀석입니다.",
                "sound_type": [
                    2
                ],
                "start": 78.441,
                "end": 79.812
            },
            {
                "speaker_id": "1",
                "transcription": "초강 몬스터 낚싯대의 힘 죽입니다.",
                "sound_type": [
                    2
                ],
                "start": 79.822,
                "end": 82.498
            },
            {
                "speaker_id": "1",
                "transcription": "50 살짝 안 되네요?",
                "sound_type": [
                    2
                ],
                "start": 82.508,
                "end": 85.824
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 녀석이 찌를 쭉 끌고 갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 85.834,
                "end": 88.996
            },
            {
                "speaker_id": "1",
                "transcription": "덕분에 손맛 봤습니다.",
