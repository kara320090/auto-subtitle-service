        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "된장찌개에 호박이랑 무랑 오만 걸 다 넣은 된장찌개와 된장국과 된장찌개의 그 사이 있는 느낌 그러니까 그런 풍성함 뭐랄까 그런 길을 찾아내는 듯한 그런 게",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 15.577
            },
            {
                "speaker_id": "2",
                "transcription": "한 번 만나보고 싶다 왠지 나랑 잘 통할 것 같다.",
                "sound_type": [
                    2
                ],
                "start": 15.587,
                "end": 18.067
            },
            {
                "speaker_id": "2",
                "transcription": "또 얘도 마찬가지로 저희 마에에 숙소가 있었는데 지나가는 길에 너무 예쁜 향수 매장이 있는데 항상 문이 닫혀 있는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 18.077,
                "end": 26.753
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 너무 호기심이 났죠 그래서 로드카 시스라고 있어 가지고 카시스를 한 번 맡으면 그런 호기심이 들어서 찾아가게 되었죠.",
                "sound_type": [
                    2
                ],
                "start": 26.763,
                "end": 35.888
            },
            {
                "speaker_id": "2",
                "transcription": "거의 마지막날 극적으로 문을 연걸 봤습니다. 제가",
                "sound_type": [
                    2
                ],
                "start": 35.898,
                "end": 40.348
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 얼른 들어가서",
                "sound_type": [
                    2
                ],
                "start": 40.358,
                "end": 41.688
            },
            {
                "speaker_id": "1",
                "transcription": "지극히 프렌치적인 느낌",
                "sound_type": [
                    2
                ],
                "start": 41.698,
                "end": 43.304
            },
            {
                "speaker_id": "2",
                "transcription": "그렇죠 여기는 대를 이어 향을 만드는 그냥 가내수공업이라고 해야 되나 크게는 안 하는 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 43.314,
                "end": 50.379
            },
            {
                "speaker_id": "2",
                "transcription": "근데 원래는 파리 아니고 마르세유가 그런 도시에서 되게 꾸준하게 오래 몇 세기에 걸쳐서 이어서 향을 만들던 분들이고",
                "sound_type": [
                    2
                ],
                "start": 50.389,
                "end": 59.329
            },
            {
                "speaker_id": "2",
                "transcription": "근데 이제 아드님이 파리에 매장을 내고 싶다 해서 파리에 와있는 그런 브랜드더라고요.",
                "sound_type": [
                    2
                ],
                "start": 59.339,
                "end": 64.803
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 사실은 제가 향수를 샀는데 얘가 여기가 부자재가 굉장히 다들 부실해서 그냥 이렇게 열리고 막 떨어지고 뭐 난리가 아니더라고요.",
                "sound_type": [
                    2
                ],
                "start": 64.813,
                "end": 76.633
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 어느 날 불 꺼진 제 방에서 얘가 굴러 떨어져서 깨져 있어요.",
                "sound_type": [
                    2
                ],
                "start": 76.643,
                "end": 81.329
            },
            {
                "speaker_id": "2",
                "transcription": "산산조각이 나서 향이 없어졌어요.",
                "sound_type": [
                    2
                ],
                "start": 81.339,
                "end": 84.321
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이런",
                "sound_type": [
                    2
                ],
                "start": 84.331,
                "end": 85.009
            },
            {
                "speaker_id": "2",
                "transcription": "얜 향을 맡아볼 수가 없고 이거 제가 얘는 향수였고 이거는 베개에 뿌리는",
                "sound_type": [
                    2
                ],
                "start": 85.019,
                "end": 91.545
            },
            {
                "speaker_id": "1",
                "transcription": "아 필로우 스프레이.",
                "sound_type": [
                    2
                ],
                "start": 91.555,
                "end": 93.305
            },
            {
                "speaker_id": "2",
                "transcription": "이게, 제가 좋아하는 생강향이 들어간 진저향이 들어간 아이고 뭔가 되게 편안해지더라고요.",
                "sound_type": [
                    2
                ],
                "start": 93.315,
                "end": 99.857
            },
            {
                "speaker_id": "2",
                "transcription": "근데 또 타이틀은 쥬땜므 아 라 폴리 막",
                "sound_type": [
                    2
                ],
                "start": 99.867,
                "end": 104.566
            }
        ]
    },
    "summary": "가내수공업 느낌의 몇 세기에 걸친 향수를 만드는 가게에서 향수를 샀다.",
