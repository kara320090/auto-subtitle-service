        "term": [
            {
                "speaker_id": "1",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.715
            },
            {
                "speaker_id": "1",
                "transcription": "우리 친구들 많이 왔구나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.725,
                "end": 7.790
            },
            {
                "speaker_id": "1",
                "transcription": "유채 유채 잠깐만 오늘은 우리 친구들에게 간식을 이제까지 달걀을 삶아서 노른자를 주었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.800,
                "end": 16.930
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 1번 구워서 구운 달걀의 노른자를 줄까 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.940,
                "end": 21.413
            },
            {
                "speaker_id": "1",
                "transcription": "얘들아 노아도 나왔어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.423,
                "end": 24.009
            },
            {
                "speaker_id": "1",
                "transcription": "하영이 노랑이 까망이 까망아 구운 달걀노른자 맛있겠어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.019,
                "end": 31.212
            },
            {
                "speaker_id": "1",
                "transcription": "노랑이가 조금만 기다려줘.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.222,
                "end": 33.492
            },
            {
                "speaker_id": "1",
                "transcription": "우리 유채도 유채 관심이 많아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.502,
                "end": 37.612
            },
            {
                "speaker_id": "1",
                "transcription": "유채하고 어이고 노랑이하고 다 잘 먹어줄까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.622,
                "end": 42.642
            }
        ]
    },
    "summary": "여성이 이제까지 고양이들에게 삶은 달걀의 노른자를 주었지만 오늘은 구운 달걀의 노른자를 주려고 하고 있다.",
