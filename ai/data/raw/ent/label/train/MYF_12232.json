        "term": [
            {
                "speaker_id": "1",
                "transcription": "역병의 시기가 끝나고 그래서 우리가 여행을 갈 수 있을 때 그때 네 발리나 싱가포르에서 프랑지파니를 만나면 아 이 꽃이 이런 향수에도 많이 적용이 되었었지 이런 생각을 한번 해보시면 좋을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 14.000
            },
            {
                "speaker_id": "1",
                "transcription": "프랑지파니는요.",
                "sound_type": [
                    2
                ],
                "start": 14.010,
                "end": 15.390
            },
            {
                "speaker_id": "1",
                "transcription": "프랑지파니 후작이 계셨어요.",
                "sound_type": [
                    2
                ],
                "start": 15.390,
                "end": 17.600
            },
            {
                "speaker_id": "1",
                "transcription": "네 그 후작이 자기의 글러브 네 장갑 장갑은 아시겠지만 고대부터 권력의 상징이거든요.",
                "sound_type": [
                    2
                ],
                "start": 17.600,
                "end": 25.750
            },
            {
                "speaker_id": "1",
                "transcription": "그 장갑에다가 스위트 아몬드의 향을 이렇게 입히면서 등장하셨거든요.",
                "sound_type": [
                    2
                ],
                "start": 25.760,
                "end": 31.350
            },
            {
                "speaker_id": "1",
                "transcription": "프랑지파니라는 꽃이 유럽에 소개가 되었을 때 프랑지파니 후작의 그 장갑에서 그 후작에게서 나던 스위트 아몬드 아몬드와 같은 꽃향이라고 했잖아요.",
                "sound_type": [
                    2
                ],
                "start": 31.350,
                "end": 41.380
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 이제 사실 아몬드보다는 좀 더 달달한 느낌이 강하죠.",
                "sound_type": [
                    2
                ],
                "start": 41.390,
                "end": 44.820
            },
            {
                "speaker_id": "1",
                "transcription": "이 꽃향이 프랑지파니의 그 향과 좀 비슷하네 해서 프랑지파니가 되었다는 이야기가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 44.820,
                "end": 53.000
            }
        ]
    },
    "summary": "프랑지파니 향수는 프랑지파니라는 후작이 있었는데 권력의 상징인 장갑에 스위트 아몬드 향을 입히면서 등장을 했는데 유럽에서 이 프랑지파니 꽃이 소개가 되었을 때 후작의 장갑에서 나던 향과 비슷해서 이름이 프랑지파니로 붙게 되었다.",
