        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "재밌다고 다가 아니잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.631
            },
            {
                "speaker_id": "1",
                "transcription": "머리가 아프단 말이지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.641,
                "end": 2.875
            },
            {
                "speaker_id": "1",
                "transcription": "제가 욕실템을 다 놓고 와가지구 입술 각질을 원래 제가 때밀이로 밀거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.885,
                "end": 7.457
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그게 없어서 바세린을 엄청 많이 듬뿍 바르고 있겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.467,
                "end": 11.542
            },
            {
                "speaker_id": "1",
                "transcription": "슬밋의 핸드워시, 핸드크림입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.552,
                "end": 14.179
            },
            {
                "speaker_id": "1",
                "transcription": "솔 소울 서울 향이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.189,
                "end": 16.117
            },
            {
                "speaker_id": "1",
                "transcription": "욕실이나 주방 등 비치해 두어서 손 씻을 때마다 부담 없이 펌핑하여 편리하게 사용할 수 있는 제품입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.127,
                "end": 22.218
            },
            {
                "speaker_id": "1",
                "transcription": "감각적인 디자인과 향으로 센스 있는 선물로 추천드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.228,
                "end": 25.209
            },
            {
                "speaker_id": "1",
                "transcription": "핸드크림을 진짜 안 발라요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.219,
                "end": 27.390
            },
            {
                "speaker_id": "1",
                "transcription": "선물을 받아도 그걸 주변에 나눠주거나 썩혀먹고 버리든지 그랬는데 어느 날 제 손을 봤는데 거스럼이 엄청 일어나고 여기가 살짝 갈라지는 아 관리해야겠구나 싶어서 핸드워시로 손을 한 번 닦고 그다음에 핸드크림 진짜 듬뿍 손톱까지 엄청 열심히 바른 다음에 자는 편이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.400,
                "end": 43.936
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해두면은 손이 이제 닦아도 조금 부들부들함이 남아있어서 맨날 맨날 이렇게 하다 보니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.946,
                "end": 50.320
            }
        ]
    },
    "summary": "슬밋의 핸드워시, 핸드크림은 솔 소울 서울 향이고 감각적인 디자인과 향으로 센스 있는 선물로 추천드립니다.",
