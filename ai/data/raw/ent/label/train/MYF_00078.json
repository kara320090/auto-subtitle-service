        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.755
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 TV입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.765,
                "end": 1.905
            },
            {
                "speaker_id": "1",
                "transcription": "네 오늘은 제 의상과 맞춰서 야외에서 오늘은 어 촬영을 하는데요.",
                "sound_type": [
                    2
                ],
                "start": 1.915,
                "end": 7.418
            },
            {
                "speaker_id": "1",
                "transcription": "어 오늘은 여러분들에게 해줄 말이 어 육군 소령으로 진급하면 달라지는 것들에 대해서 알려드릴려고 해요.",
                "sound_type": [
                    2
                ],
                "start": 7.428,
                "end": 16.956
            },
            {
                "speaker_id": "1",
                "transcription": "이 영상은 아마 현역 어 여군 후배들 분들한테도 해당되고 일반 이제 군 후배들 그리고 이제 앞으로 이제 영관 장교 뭐 대령 장군까지 진급하려고 하는 지망생들 분에게도 어떻게 보면 도움되는 얘기입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.966,
                "end": 33.096
            },
            {
                "speaker_id": "1",
                "transcription": "어 먼저 진급하면 달라지는 3가지 위주로 말씀드릴려고 하는데요.",
                "sound_type": [
                    2
                ],
                "start": 33.106,
                "end": 38.873
            },
            {
                "speaker_id": "1",
                "transcription": "어 첫째는 우선은 영관 장교가 되면은 각 대대에서 생활을 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 38.883,
                "end": 45.240
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 영관 장교가 몇 명 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 45.250,
                "end": 47.655
            },
            {
                "speaker_id": "1",
                "transcription": "그만큼 위간 장교 그리고 인제 용사들과 같이 생활을 하는데 그만큼 높은 지위에 있다는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 47.665,
                "end": 54.635
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 결론적으로 저희한테 어 태클 거는 사람이 많이 없다는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 54.645,
                "end": 59.771
            },
            {
                "speaker_id": "1",
                "transcription": "사실 군 생활도 인간관계예요.",
                "sound_type": [
                    2
                ],
                "start": 59.781,
                "end": 62.306
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 주변에 이제 후배라는 것 이유만으로 후임이라는 이유만으로 되게 많은 조언이나 격려를 듣는데 그게 보면 나한테 어 스트레스가 되는 경우가 많아요.",
                "sound_type": [
                    2
                ],
                "start": 62.316,
                "end": 74.501
            },
            {
                "speaker_id": "1",
                "transcription": "나는 그냥 어떤 행동을 그낭 한 건데 선배가 봤을 때는 그게 어 마음에 들지 않거나 아니면 자기랑 쫌 다르다고 해서 이제 조언을 하는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 74.511,
                "end": 84.523
            },
            {
                "speaker_id": "1",
                "transcription": "야 그거는 이거 아닌 거 같은데 이렇게 하는 거 어때라고 하는 한마디가 나에게는 왜 내가 하는 일에 대해서 마음에 들어하지 않는 거지 왜 다른 방법을 하라는 거지 나는 이렇게 하고 싶은데라는 그런 생각을 갖게 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 84.533,
                "end": 97.068
            },
            {
                "speaker_id": "1",
                "transcription": "군대는 계급 사회고 조직 사회다 보니까 어 그 선배에 말을 따라야 하는 게 맞는데 내가 하고 싶은 대로 지휘하거나 내가 원하는 방향으로 이렇게 나가고 싶은데 그게 계급이 낮으면 사실 이렇게 펼치기가 쉽지 않은 거죠.",
                "sound_type": [
                    2
                ],
                "start": 97.078,
                "end": 112.337
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제 영관 장교가 되면은 음 육군항공에서는 헬기 중대장이 되는 거고 일반 병과에서는 어떻게 보면은 대장까지 나갑니다.",
                "sound_type": [
                    2
                ],
                "start": 112.347,
                "end": 120.607
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 신교 대장도 있고 뭐 대대장으로 나가는 대대도 있죠.",
                "sound_type": [
                    2
                ],
                "start": 120.617,
                "end": 125.106
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 보면은 결국 그 대대를 지휘하는 장이 되잖아요.",
                "sound_type": [
                    2
                ],
                "start": 125.116,
                "end": 129.058
            },
            {
                "speaker_id": "1",
                "transcription": "지휘관 그렇기 때문에 누구나가 함부로 이렇게 태클을 걸거나 조언을 할 수가 없어요 왜냐면.",
                "sound_type": [
                    2
                ],
                "start": 129.068,
                "end": 136.168
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 쌓아왔던 그 경력과 경험을 충분히 존중해서 그들의 지휘권을 어 인정해주는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 136.178,
                "end": 146.043
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 지휘를 하는데 이렇게 조언을 했다 아님 잘못 이렇게 되면은 사실 그 지휘권은 인제 월권했다라고 하는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 146.053,
                "end": 154.798
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 그 지휘관이 어 권한이 있는데 그거를 침해한 거죠.",
                "sound_type": [
                    2
                ],
                "start": 154.808,
                "end": 159.027
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 영관 장교가 되면은 어 주변에 어 이런 뭐라고 이렇게 태클 거는 사람들이 작아진다는 거 그거 하나만으로도 엄청편해져요.",
                "sound_type": [
                    2
                ],
                "start": 159.037,
                "end": 170.098
            },
            {
                "speaker_id": "1",
                "transcription": "저도 영관 장교가 되면서 너무 좋은 거예요.",
                "sound_type": [
                    2
                ],
                "start": 170.108,
                "end": 174.573
            },
            {
                "speaker_id": "1",
                "transcription": "뭐지 예전에는 내가 무슨 일만 하면은 맨날 딴지 걸고 뭐라고 하는 사람이 이렇게 많았는데 영관 장교가 되고 나니까 그냥 어 잘한다 열심히 그렇게 하는 거다 뭐 이런 얘기밖에 안 하더라고요.",
                "sound_type": [
                    2
                ],
                "start": 174.583,
                "end": 188.318
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 진짜 잘해서 그러는 건지 아님 진짜 영관 장교에 지위라 직책을 인정을 해주는 건지 모르겠지만 여러분들도 돼 보시면 압니다.",
                "sound_type": [
                    2
                ],
                "start": 188.328,
                "end": 196.092
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 다 높은 자리로 올라갈라고 하는 거 같애요.",
                "sound_type": [
                    2
                ],
                "start": 196.102,
                "end": 200.276
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 일반 회사에서도 말단 사원이면 어떻게든 우리 예전에 드라마 장그래 씨도 그런 것처럼 괜히 농담하고 뭐 시비 걸고 해도 음 그 직원이고 귀여우니까 그렇게 하는 건데",
                "sound_type": [
                    2
                ],
                "start": 200.286,
                "end": 215.797
            },
            {
                "speaker_id": "1",
                "transcription": "군에서도 후배니까 귀엽다고 한 말 도와주고 싶어서 한 말인데 상대방한테는 상처가 되죠.",
                "sound_type": [
                    2
                ],
                "start": 215.807,
                "end": 221.829
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 상대방에 진심을 잘 모르고 하는 행동이 많기 때문에 그렇기 때문에 이 높이 올라갈수록 편해진다는 거는 확실합니다.",
                "sound_type": [
                    2
                ],
                "start": 221.839,
                "end": 230.946
            },
            {
                "speaker_id": "1",
                "transcription": "몸이 편해진다는 거 보다는 이제 정신적으로 나에게 뭐라고 하는 사람이 많이 없기 때문에 편해진다는 거고 어 두 번째는 여러분들이 가장 궁금하실 거 같은데 봉급이죠.",
                "sound_type": [
                    2
                ],
                "start": 230.956,
                "end": 241.999
            },
            {
                "speaker_id": "1",
                "transcription": "어 위간 장교하고 영관 장교하고는 급여 차이가 어 납니다.",
                "sound_type": [
                    2
                ],
                "start": 242.009,
                "end": 247.056
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 막 몇백만 원 이렇게 오르는 거는 아니죠.",
                "sound_type": [
                    2
                ],
                "start": 247.066,
                "end": 250.732
            },
            {
                "speaker_id": "1",
                "transcription": "사실 군인 월급은 나라에 세금을 어 받고 그 나라를 지키는 사명감으로 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 250.742,
                "end": 258.330
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 장군님들도 1000만 원 안 될 거 같은데요.",
                "sound_type": [
                    2
                ],
                "start": 258.340,
                "end": 262.566
            },
            {
                "speaker_id": "1",
                "transcription": "한 달에 받는 돈이 그렇기 때문에 영관 장교가 그래도 위간 장교에 그 월급보다는 쪼금 나아진다는 거 뭐 위간 장교들이 호봉에 따라서 이제 월급이 정해지잖아요.",
                "sound_type": [
                    2
                ],
                "start": 262.566,
                "end": 276.165
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 내가 중위에서 대위되면은 뭐 10만 원 올랐다면 인제 위간 장교에서 영관 장교를 하면은 한 50만 원 정도 이상은 오르는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 276.175,
                "end": 285.196
            },
            {
                "speaker_id": "1",
                "transcription": "그만큼 그 영관 장교로서의 대우를 이제 급여로도 해주는 거고요.",
                "sound_type": [
                    2
                ],
                "start": 285.206,
                "end": 289.540
            },
            {
                "speaker_id": "1",
                "transcription": "특히 저 같은 경우는 육군항공이었잖아요.",
                "sound_type": [
                    2
                ],
                "start": 289.550,
                "end": 292.120
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 육군항공은 일반 병과로 다르게 어 항공 수당이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 292.130,
                "end": 297.434
            },
            {
                "speaker_id": "1",
                "transcription": "항공 수당도 위간 장교 수당과 영관 장교 사당이 다르기 때문에 항공 수당도 쪼금 더 오르는 경우 그렇기 때문에 영관 장교가 되고 나서는 아 이래서 다 진급하고 싶어 하는구나.",
                "sound_type": [
                    2
                ],
                "start": 297.444,
                "end": 310.692
            },
            {
                "speaker_id": "1",
                "transcription": "이제 급여로써 또 보상을 받으니까 또 직책으로 직위로서도 보상을 받지만 급여로써 보상을 받기 때문에 어 내가 10년 생 군 생활을 해서 그 노고를 또 월급으로 이렇게 또 보상을 해주는 구나라고 느끼는데 뭐 일반 비즈니스 하시는 분이나 사업하시는 분한테는 사실 이 군인 월급 하고는 비교 조차가 안 돼요.",
                "sound_type": [
                    2
                ],
                "start": 310.702,
                "end": 334.184
            },
            {
                "speaker_id": "1",
                "transcription": "사실 비교할 게 아니죠.",
                "sound_type": [
                    2
                ],
                "start": 334.194,
                "end": 335.712
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 군인은 연금이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 335.722,
                "end": 338.072
            },
            {
                "speaker_id": "1",
                "transcription": "일반 회사나 사업가들은 어 그런 연금이나 이런 보장되는 게 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 338.082,
                "end": 342.854
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 군인은 그만큼 나라에 어 충성을 하고 그만큼 열심히 어 오랜 시간을 바쳐서 했기 때문에 연금이라는 그 보장이 있기 때문에 급여가 어 밖에 보다는 크진 않다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 342.864,
                "end": 356.236
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지만 군에 있을 때는 어떻게 보면은 어 큰 거죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 356.246,
                "end": 360.320
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 제가 쏘위 때 첫 월급이 100만 원 정도였어요.",
                "sound_type": [
                    2
                ],
                "start": 360.330,
                "end": 365.161
            },
            {
                "speaker_id": "1",
                "transcription": "사실 저희 아버지도 20년 군 생활하시고 나오셨잖아요.",
                "sound_type": [
                    2
                ],
                "start": 365.171,
                "end": 368.678
            },
            {
                "speaker_id": "1",
                "transcription": "아버지가 쏘위였을 때 월급이 7만 원인가 그랬대요.",
                "sound_type": [
                    2
                ],
                "start": 368.688,
                "end": 372.787
            },
            {
                "speaker_id": "1",
                "transcription": "그때 당시가 77년도 정도였거든요.",
                "sound_type": [
                    2
                ],
                "start": 372.797,
                "end": 376.180
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 비교했을 때 우리 쏘위 분들 100만 원이면 엄청 많이 오른 거죠.",
                "sound_type": [
                    2
                ],
                "start": 376.190,
                "end": 381.560
            },
            {
                "speaker_id": "1",
                "transcription": "물가 상승률이 맞춰서 오른 거긴 한데 이렇게 쏘위 100만 원으로 시작해서 영관 장교가 돼서 500만 원 뭐 보너스 받을 수 600만 원까지 받는다는 거는 엄청난 거죠.",
                "sound_type": [
                    2
                ],
                "start": 381.570,
                "end": 392.350
            },
            {
                "speaker_id": "1",
                "transcription": "그 안에 시간이 10년이라는 그 기간이 걸리지만 그래도 쪼금씩 올라서 인제 보상을 해준다는 거 그랬는데 제가 이제 쏘위 때 100만 원을 받고 처음 했던 게 이제 부모님 용돈 드리고 원래 첫 월급 타면 이제 속옷 사드린다고 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 392.360,
                "end": 408.283
            },
