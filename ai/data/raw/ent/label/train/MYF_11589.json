                    2
                ],
                "start": 0.000,
                "end": 7.209
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 여러 가지 얘기를 했는데 어 포켓몬 씰 모으고 싶으신 분도 계실 거고 이제 시작하시려는 분도 계실 텐데 어 제가 추천드린 방법은 총 세 가지예요.",
                "sound_type": [
                    2
                ],
                "start": 7.219,
                "end": 16.114
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째는 빵을 사세요.",
                "sound_type": [
                    2
                ],
                "start": 16.124,
                "end": 18.135
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게든 빵을 사세요.",
                "sound_type": [
                    2
                ],
                "start": 18.145,
                "end": 19.308
            },
            {
