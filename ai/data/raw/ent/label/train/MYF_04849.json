                    2
                ],
                "start": 6.945,
                "end": 8.250
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 향기 나는 가죽 장갑으로 유명했던 그라스란 지역이 어떻게 향수 산업으로 본격적으로 뛰어들게 되냐면요.",
                "sound_type": [
                    2
