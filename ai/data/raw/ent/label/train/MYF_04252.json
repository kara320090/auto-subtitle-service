        "term": [
            {
                "speaker_id": "1",
                "transcription": "이럴 수 있단 말이야?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.183
            },
            {
                "speaker_id": "1",
                "transcription": "이런 생각을 많이 하실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 1.193,
                "end": 3.005
            },
            {
                "speaker_id": "1",
                "transcription": "인삼이 들어가는 데 그게 한국산 인삼을 꼭꼭 사용을 하시거든요.",
                "sound_type": [
                    2
                ],
                "start": 3.015,
                "end": 7.059
            },
            {
                "speaker_id": "1",
                "transcription": "그 인삼이 들어가 있는 그 특유의 그 향이 뇌가 기억을 한다고 할까요?",
                "sound_type": [
                    2
                ],
                "start": 7.069,
                "end": 13.459
            },
            {
                "speaker_id": "1",
                "transcription": "네, 그래서 정말 이렇게 딱 보면은 그 특유의 그 향이 나는 데 워낙 시슬리가 만들어온 브랜드의 세계가 고급스러운 세계를 이제 만들어 놓다 보니까 그 향을 딱 만나면 고급 진 느낌이 들게 되더라고요.",
                "sound_type": [
                    2
                ],
