        "term": [
            {
                "speaker_id": "1",
                "transcription": "하면 친구들에게 편안한 마음으로 이동장에 들어 갈 수 있도록 도움을 줄 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.752
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 케이지 안에 그 친구가 특별히 좋아하는 장난감을 넣어두는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.762,
                "end": 16.593
            },
            {
                "speaker_id": "1",
                "transcription": "저희 @이름1는 스펀지로 된 공을 엄청 좋아해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.603,
                "end": 21.239
            },
            {
                "speaker_id": "1",
                "transcription": "어 그 중에서도 저 분홍공을 엄청 좋아해요 어 어 @이름1이 왔네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.249,
                "end": 25.886
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1가 케이지 안에 발을 넣어서 공을 꺼내죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.896,
                "end": 30.681
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1는 케이지를 굉장히 싫어해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.691,
                "end": 33.559
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 케이지 안에 간식이 들어있거나 저렇게 자신이 좋아하는 장난감이 들어있을 때는 어어 @이름1 케이지가 내 거야 내 거야 하는 것 같죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.569,
                "end": 44.162
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 고양이가 몸을 이렇게 문지르는 건 내 거라는 표시래요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.172,
                "end": 49.509
            },
            {
                "speaker_id": "1",
                "transcription": "케이지 안에 있는 공을 꺼낼까요 과연 지켜볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.519,
                "end": 55.288
            }
        ]
    },
    "summary": "화자가 이번엔 @이름1이 좋아하는 장난감을 넣어두었는데 @이름1은 케이지를 좋아하지 않는데 자기가 좋아하는 공이 있어서 내 거라는 표시까지 하는 걸 말해주고 있다.",
