        "term": [
            {
                "speaker_id": "1",
                "transcription": "참참아 그러지 말고 잘 생각해봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.655
            },
            {
                "speaker_id": "1",
                "transcription": "너 혹시 하양이 밥 먹는데 어제처럼 엉덩이를 두손으로 딱 때린 거 아니야 혹시?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.665,
                "end": 9.782
            },
            {
                "speaker_id": "1",
                "transcription": "에이 챙피하게 어제 이야기는 왜 해요 엄마?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.792,
                "end": 14.684
            },
            {
                "speaker_id": "1",
                "transcription": "참참이 엉덩이 이렇게 깨문 거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.694,
                "end": 17.804
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 손 깨무는 거처럼 참참이 우리 하양이 궁둥이를 이렇게 깨물었어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.814,
                "end": 24.357
