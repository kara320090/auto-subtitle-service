        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "분유도 안 빨고 그러더니 그랬어? 이제는 엄청 잘 먹죠? 이 친구는 보면 다른 친구들에 비해서 털이 좀 길어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 12.835
            },
            {
                "speaker_id": "1",
                "transcription": "복실복실 그래서 그 나무가 소나무라고 생각한다면 솔잎 같은 느낌이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.845,
                "end": 20.487
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 솔이라고 부르기로 했이요. 우리 솔이 막둥이 둘째 방울이 첫째 가지랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.497,
                "end": 30.386
            },
            {
                "speaker_id": "1",
                "transcription": "가지야 가지 우리 가지 우리 방울 우리 방울 우리 솔이 방울이하고 솔이 붙어있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.396,
                "end": 47.368
            },
            {
                "speaker_id": "1",
                "transcription": "방울아 넌 방울이야 어휴 방울이처럼 생겼죠? 또랑또랑한 우리 방울이 솔아잠와? 솔이는 잠이 와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.378,
                "end": 60.135
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 가지가 찾아왔네요. 너희들 잘 쉬고 있는 거니? 확인차 오셨어요? 우리 가지 헤헤",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.145,
                "end": 72.783
            },
            {
                "speaker_id": "1",
                "transcription": "이제 우리 친구들 소독하고 따뜻하게 해 논 케이지에 데려가야겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.793,
                "end": 78.080
            }
        ]
    },
    "summary": "솔이는 털이 복실복실하고 그 나무가 소나무라고 생각한다면 솔잎 같은 느낌라서 솔이라고 부르고 둘째 방울이 첫째 가지이다.",
