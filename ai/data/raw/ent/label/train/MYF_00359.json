        "term": [
            {
                "speaker_id": "1",
                "transcription": "정말 인터뷰 자신 있다 하시는 분들도 편안하게 신청해 주시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.782
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 영상은 여기서 마무리하려고 해요.",
                "sound_type": [
                    2
                ],
                "start": 4.792,
                "end": 7.510
            },
            {
                "speaker_id": "1",
                "transcription": "왜 여기서 마무리하냐고요?",
                "sound_type": [
                    2
                ],
                "start": 7.520,
                "end": 9.499
            },
            {
                "speaker_id": "1",
                "transcription": "점심을 한 세 번 먹은 것 같은데 엄마가 저녁 먹으래요.",
                "sound_type": [
                    2
                ],
                "start": 9.509,
                "end": 13.624
            },
            {
                "speaker_id": "1",
                "transcription": "저는 저녁 먹으러 갈게요.",
                "sound_type": [
                    2
                ],
                "start": 13.634,
                "end": 16.220
            },
            {
                "speaker_id": "1",
                "transcription": "부추 좀 뜯어가야 해서 퇴근하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.230,
                "end": 19.868
            },
            {
                "speaker_id": "1",
                "transcription": "부추 뜯으러 갑니다.",
