        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 시간이 3시 50분이 되어 갑니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.115
            },
            {
                "speaker_id": "1",
                "transcription": "위 쪽에 계시던 많은 조사님들 다 철수하셨고 남은 시간이 얼마 없는 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.125,
                "end": 8.515
            },
            {
                "speaker_id": "1",
                "transcription": "아 입질이 많이 없네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.525,
                "end": 11.269
            },
            {
                "speaker_id": "1",
                "transcription": "날씨는 굉장히 좋은데 입질받기가 굉장히 어렵습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.279,
                "end": 14.493
            },
            {
                "speaker_id": "1",
                "transcription": "아쉽네요.",
                "sound_type": [
                    2
                ],
                "start": 14.503,
                "end": 15.383
            },
            {
                "speaker_id": "1",
                "transcription": "하하하 이제 조금 있으면 날도 많이 풀릴 거고 얼음낚시의 기회는 별로 없을 텐데 오늘 1마리만 더 보고 가고 싶습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.393,
                "end": 30.677
            },
            {
                "speaker_id": "1",
                "transcription": "자 남은 시간 바짝 한 번 쪼아보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
