        "term": [
            {
                "speaker_id": "1",
                "transcription": "저수지 물칸까지 와봤는데 저 아래구간보다 물칸이 왠지 끌리네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.455
            },
            {
                "speaker_id": "1",
                "transcription": "끌릴 때는 끌리는 대로 해야죠.",
                "sound_type": [
                    2
                ],
                "start": 6.465,
                "end": 8.440
            },
            {
                "speaker_id": "1",
                "transcription": "짐빵 굉장히 먼데 한번 갖고 와보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.450,
                "end": 11.658
            },
            {
                "speaker_id": "1",
                "transcription": "한 번에 오려고 짐을 최소화했습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.668,
                "end": 13.953
            },
            {
                "speaker_id": "1",
                "transcription": "힘드네.",
                "sound_type": [
                    2
                ],
                "start": 13.963,
                "end": 15.151
            },
            {
                "speaker_id": "1",
                "transcription": "대략 거리가 300미터가량 되는 것 같은데 한 번에 오려니까 너무 힘드네요.",
                "sound_type": [
                    2
                ],
                "start": 15.161,
                "end": 20.762
            },
            {
                "speaker_id": "1",
                "transcription": "파라솔도 사치입니다.",
                "sound_type": [
                    2
                ],
                "start": 20.772,
                "end": 21.945
            },
            {
                "speaker_id": "1",
                "transcription": "안 갖고 왔고요.",
                "sound_type": [
                    2
                ],
                "start": 21.955,
                "end": 24.470
            },
            {
                "speaker_id": "1",
                "transcription": "이제 얼른 짐 내리고 세팅해 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.480,
                "end": 27.191
            },
            {
                "speaker_id": "1",
                "transcription": "열심히 하는 붕어 잡는 곰 힘내라고 구독과 좋아요 한 번씩 부탁드립니다.",
                "sound_type": [
                    2
                ],
                "start": 27.201,
                "end": 32.051
            },
            {
                "speaker_id": "1",
                "transcription": "출발해 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 32.061,
                "end": 33.210
            },
            {
                "speaker_id": "1",
                "transcription": "가보자.",
                "sound_type": [
                    2
                ],
                "start": 33.220,
                "end": 34.072
            },
            {
                "speaker_id": "1",
                "transcription": "발을 헛디디면 바로 이거는 너무 미끄럽다.",
                "sound_type": [
                    2
                ],
                "start": 34.082,
                "end": 40.707
            }
        ]
    },
    "summary": "한 남성이 차로부터 멀리 있는 곳에서 낚시를 하려고 짐을 힘들게 옮기고 있다.",
