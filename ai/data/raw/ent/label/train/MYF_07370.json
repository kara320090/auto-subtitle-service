        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 하는 방법도 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.027
            },
            {
                "speaker_id": "1",
                "transcription": "세재 없이 꼭 이렇게 닦아 보세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.027,
                "end": 4.352
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 헹굴 때도 이렇게 수돗물을 샤워로 해서 이렇게 하면은 엄청 튀거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.355,
                "end": 12.560
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 튀잖아요 지금요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.562,
                "end": 15.087
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 딱 일자로 나오게 끔 하면은 물이 전혀 안 튀어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.087,
                "end": 19.572
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 또 꿀 팁이거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.575,
                "end": 21.350
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 하면 탁 튀고 이렇게 하면 안 튀잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.352,
                "end": 24.450
            },
            {
                "speaker_id": "1",
                "transcription": "아따 오늘 좋은 거 많이 가르쳐 줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.452,
                "end": 27.555
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 닦으면은 깨끗하죠.",
                "sound_type": [
                    2
                ],
                "start": 27.557,
                "end": 30.166
            }
        ]
    },
