            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.821
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 TV입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.831,
                "end": 2.040
            },
            {
                "speaker_id": "1",
                "transcription": "네 오늘은 어 아까 이어서 2편을 말씀드릴 건데요.",
                "sound_type": [
                    2
                ],
                "start": 2.050,
                "end": 6.591
            },
            {
                "speaker_id": "1",
                "transcription": "제가 어 항공 장교로 병과한 이유에 대해서 알려드릴려고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 6.601,
                "end": 12.707
            },
            {
                "speaker_id": "1",
                "transcription": "저는 사실 육군 쏘위로 임관할 때 보병으로 임관을 했어요.",
                "sound_type": [
                    2
                ],
                "start": 12.717,
                "end": 17.468
            },
            {
                "speaker_id": "1",
                "transcription": "저희 아버지가 보병 출신이었고 군 생활 20년 하고 전역을 하셨거든요.",
                "sound_type": [
                    2
                ],
                "start": 17.478,
                "end": 22.732
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저도 당연히 육군에서는 이제 보병이 최고인 줄 알고 보병에 입대를 했죠.",
                "sound_type": [
                    2
                ],
                "start": 22.742,
                "end": 29.306
            },
            {
                "speaker_id": "1",
                "transcription": "사실 다른 병과는 지원할 때 아 이러한 병과가 있구나라는 걸 아는데 여러분들도 지원서를 쓰다 보면은 희망 병과를 쓰는 란이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 29.316,
                "end": 38.775
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 1지망 2지망을 쓰게 되는데 보통은 자기 학과에 맞춰서 작성을 합니다.",
                "sound_type": [
                    2
                ],
                "start": 38.785,
                "end": 44.376
            },
            {
                "speaker_id": "1",
                "transcription": "저같은 경우에는 창원 대학교 철학과를 졸업했기 때문에 제가 희망할 수 있는 병과는 보병이 1지망 무조건이고 2지망은 뭐 정훈까지는 가능했었는데 결국은 저희 아버지가 보병이었기 때문에 저도 보병이 전부인 줄 알고 입대를 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 44.386,
                "end": 60.647
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 군 생활을 열심히 하다가 어 아까 1편에서 말한 것처럼 장기 복무가 있는 거를 이제 그때 안 거죠.",
                "sound_type": [
                    2
                ],
                "start": 60.657,
                "end": 67.931
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 장기 복무인 줄 알았다면 내 제가 쏘위 1년 차 2년 차부터 그거에 대해 준비를 했을 건데 당연히 보병으로 입대했으니까 나는 음 참모 총장이 될 사람이니까 끝까지 갈 수 있겠지라고만 생각을 했죠.",
                "sound_type": [
                    2
                ],
                "start": 67.941,
                "end": 80.146
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이제 제 시대 때는 여군 보병을 많이 없앤다는 추세에서 저의 기수를 40명을 뽑았었는데 실제로 그다음부터는 뭐 10명을 뽑고 이제 앞으로 장기를 시키지 않겠다라고 해서 단 어 3명만 장기를 시킨대요 40명 중에.",
                "sound_type": [
                    2
                ],
                "start": 80.156,
                "end": 97.023
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 사실 40명 중에 3명이면 나머지 인원들은 무조건 다 단기자로 전역을 해야 되잖아요.",
                "sound_type": [
                    2
                ],
                "start": 97.033,
                "end": 105.051
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 의무적으로 이제 전과를 하게 하는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 105.061,
                "end": 108.409
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 정보 통신이나 희망하는 병과로 전과를 하게 되니까 어 실제로 장기 복무를 보병으로서 들어가는 사람은 10명 중에 이제 3명 정도를 선발을 하게 됐죠.",
                "sound_type": [
                    2
                ],
                "start": 108.419,
                "end": 119.504
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저 같은 경우는 보병 외에는 다른 병과로 전과하고 싶은 생각이 없어서 계속 보병으로 있어서 인제 복 장기 복무 심사에 들어갔는데 어 그 장기 복무는 보병들 내 출신들에서 같은 병과로만 경쟁을 하는 것이 아니라 전투병과로 묶어서 공병이나 이런 통신이나 이런 같이 병과별로 들어가더라고요.",
                "sound_type": [
                    2
                ],
                "start": 119.514,
                "end": 141.190
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니까 보병으로서는 내가 우수하더라도 타 병과하고는 또 차이가 있기 때문에 이것도 내가 나만 잘한다고 해서 되는 것은 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 141.200,
                "end": 150.479
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니까 제가 장기가 안 됐어요.",
                "sound_type": [
                    2
                ],
                "start": 150.489,
                "end": 152.545
            },
            {
                "speaker_id": "1",
                "transcription": "3명이 보병을 장기 시켜주는데 저는 4번째더라고요.",
                "sound_type": [
                    2
                ],
                "start": 152.555,
                "end": 157.042
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 정말 저는 군 생활이 전부라고 생각하고 계속 군 생활하고 있으니까 제가 안 되니까 어떻게 되겠어요?",
                "sound_type": [
                    2
                ],
                "start": 157.052,
                "end": 165.028
            },
            {
                "speaker_id": "1",
                "transcription": "하늘이 무너지는 것처럼 느꼈겠죠.",
                "sound_type": [
                    2
                ],
                "start": 165.038,
                "end": 167.252
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래서 군에서도 나를 필요로 하지 않구나라는 생각에 어 우선 전역을 해서 그러면 내가 어떤 일을 해야 될까 하면서 이제 사회 생활을 준비를 하기 시작했는데 저희 같이 근무하는 대대장님께서 어 장기가 되고 싶으면 이 길말고도 항공 병과로 전과를 하면 장기가 된다라는 말을 그때 처음 들었어요.",
                "sound_type": [
                    2
                ],
                "start": 167.262,
                "end": 188.057
            },
            {
                "speaker_id": "1",
                "transcription": "정말 그래서 제가 유튜브를 촬영하는 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 188.067,
                "end": 190.817
            },
            {
                "speaker_id": "1",
                "transcription": "정말 그 들어가봐야 내가 겪어봐야 알게 되는 일을 미리 만약에 안다면 여러분들은 준비를 할 수 있겠죠.",
                "sound_type": [
                    2
                ],
                "start": 190.827,
                "end": 198.399
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 많은 분들이 어 겪어 왔고 또 여군 분들이 많이 생기면서 그렇게 정보를 접할 기회가 많잖아요.",
                "sound_type": [
                    2
                ],
                "start": 198.409,
                "end": 206.683
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 예전보다는 낫지만 저 같은 경우에도 어 육군 항공으로 가서도 헬기 조종사로 제가 여자로서는 16번째니까 정말 소수였어요.",
                "sound_type": [
                    2
                ],
                "start": 206.693,
                "end": 216.421
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 결국 제가 겪는 일이 결국은 제가 아는 게 단 거죠.",
                "sound_type": [
                    2
                ],
                "start": 216.431,
                "end": 221.772
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들도 만약에 저와 같은 경우가 있다면 이렇게 당황스럽게 바로 이렇게 바꾸는 것이 아니라 미리 알고 준비하면은 조금은 낫지 않을까 싶습니다.",
                "sound_type": [
                    2
                ],
                "start": 221.782,
                "end": 232.454
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 대대장님의 말씀으로 제가 어 그러면 제가 항공 병과로 가겠습니다라고 했는데 그당시에도 처음 알았죠.",
                "sound_type": [
                    2
                ],
                "start": 232.464,
                "end": 239.601
            },
            {
                "speaker_id": "1",
                "transcription": "항공 병과가 육군에 있다라는 거는 생각도 못했었거든요.",
                "sound_type": [
                    2
                ],
                "start": 239.611,
                "end": 242.999
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 어 신교대 소대장을 하면서 전임자가 항공 병과로 전과를 했다는 소식은 들었고 그리고 제가 중위 때 35특공대대에 근무를 했었는데 그때 인제 분기에 1번씩 헬기 레펠을 하면서 이제 헬기가 와서 그 헬기를 탑승을 하고 인제 헬기 레펠을 하는데 저는 공군에서 오는 줄 알았어요.",
                "sound_type": [
                    2
                ],
                "start": 243.009,
                "end": 262.428
            },
            {
                "speaker_id": "1",
                "transcription": "정말 이렇게 무지하네요.",
                "sound_type": [
                    2
                ],
                "start": 262.438,
                "end": 264.333
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저는 아 공군에서 헬기가 지원이 되는구나 했는데 그게 다 육군 항공 헬기였던 거예요.",
                "sound_type": [
                    2
                ],
                "start": 264.343,
                "end": 270.009
            },
            {
                "speaker_id": "1",
                "transcription": "어 그래서 인제 육군 항공 병과로 전과를 하려고 보다 보니까 이제 내가 이때까지 겪었던 것들이 다 아 육군 항공에서 운영이 됐구나라는 걸 알게 되었고 육군 항공 병과로 전과하기 위해서는 어 시험과 체력 검정과 면접을 보는데 이것은 충분히 준비하면 갈 수 있어요.",
                "sound_type": [
                    2
                ],
                "start": 270.019,
                "end": 288.095
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우에는 이제 급작스럽게 알게 됐기에 2주 정도 정말 열심히 공부를 해서 인제 시험을 보고 면접을 보고 이제 합격을 해서 갔는데 그당시만 해도 몇 번이나 내가 원하면 지원을 해서 전과가 가능했는데 지금은 기수에 1번만 어 여러분들이 딱 1번만 지원할 수 있기 때문에 그건 잘 알아보시고 제대로 준비하시고 가셔야 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 288.105,
                "end": 310.280
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저 같은 경우에는 이제 운이 좋게 갔는데 제가 급작스럽게 알게 됐다고 했잖아요.",
                "sound_type": [
                    2
                ],
                "start": 310.290,
                "end": 315.650
            },
            {
                "speaker_id": "1",
                "transcription": "인제 거의 3년 차에 지원을 하게 된 거예요.",
                "sound_type": [
                    2
                ],
                "start": 315.660,
                "end": 318.236
            },
            {
                "speaker_id": "1",
                "transcription": "보통은 육군 항공은 1년 차나 2년 차에 지원을 해서 좀 여유 있게 가거든요.",
                "sound_type": [
                    2
                ],
                "start": 318.246,
                "end": 322.359
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 정말 늦게 늦게 입교를 하면서 항공 학교 과정에서 8개월 동안 교육을 받으면서 제가 인제 의무 복무가 끝나서 이제 전역이 된 거죠.",
                "sound_type": [
                    2
                ],
                "start": 322.369,
                "end": 332.394
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 육군 항공 교육 기간에 다시 재임관 명령을 내서 다시 인제 군 생활을 하게 된 이런 아이러니한 일도 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 332.404,
                "end": 341.005
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 어 저 저는 정말 특수한 상황이고 이제 육군 항공 병과로 전과를 하면은 이제 무조건 장기가 된다는 거는 알아두시면 되고 장기가 되면은 어 대위 소령 중령 진급은 되는데 이제 진급에 여러분들 만일 중령 진급이 안 되면 인제 의무 복무가 아니더라도 나이 정년에 맞춰서 전역을 해야 되기 때문에 우선 장기 복무는 어 20년 이상을 할 수 있다는 거 여러분들이 알아두시면 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 341.015,
                "end": 369.096
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 어떻게 해서 항공병과로 전과하게 됐는지 알려드렸고요.",
                "sound_type": [
                    2
                ],
                "start": 369.106,
                "end": 373.823
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 이 영상이 도움이 되셨다면 구독과 좋아요 눌러주세요.",
                "sound_type": [
                    2
                ],
                "start": 373.833,
                "end": 378.078
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이 좋은 경치를 여러분들과 함께 공유하면서 다음에 또 만나도록하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 378.088,
                "end": 384.334
            },
            {
                "speaker_id": "1",
                "transcription": "안녕.",
                "sound_type": [
                    2
                ],
                "start": 384.344,
                "end": 385.858
            },
            {
                "speaker_id": "1",
                "transcription": "어 우리 아이들도 있네요.",
                "sound_type": [
                    2
                ],
                "start": 385.868,
                "end": 387.549
            },
            {
                "speaker_id": "1",
                "transcription": "우열이 아이들도 인사 얘들아 안녕",
                "sound_type": [
                    2
                ],
                "start": 387.559,
                "end": 390.757
            }
        ]
    },
    "summary": "보병으로 입대해 열심히 군 생활했는데 장기 복무인 줄 알았으나 알고 봤더니 40명 중에서 3명만 장기로 할 수 있는 거였고 나중에 대대장님께서 말하기를 항공 병과로 전과하면 장기 복무할 수 있다고 해서 열심히 공부해 운 좋게 들어가서 항공 장교를 병과했다고 말한다.",
