        "term": [
            {
                "speaker_id": "1",
                "transcription": "사실 시간이 많은데 돈이 없으면 그것도 또 아주 곤란하겠죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.565
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 마지막 4번째인 관계를 한번 볼게요.",
                "sound_type": [
                    2
                ],
                "start": 4.575,
                "end": 7.995
            },
            {
                "speaker_id": "1",
                "transcription": "우리 관계가 만약에 소홀해진다.",
                "sound_type": [
                    2
                ],
                "start": 8.005,
                "end": 10.702
            },
            {
                "speaker_id": "1",
                "transcription": "특히 자녀와의 관계가 소원해진다 하면 어떡해요?",
                "sound_type": [
                    2
                ],
                "start": 10.712,
                "end": 13.352
            },
            {
                "speaker_id": "1",
                "transcription": "그 관계를 회복하기 위해서 돈을 쓰거나 우리 시간을 쓰면서 그 관계를 회복할려고 노력을 하죠.",
                "sound_type": [
                    2
                ],
                "start": 13.362,
                "end": 19.457
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 어떤 것들도 1가지씩 빠지면 사실 삐끗하기 때문에 이 4가지가 사실 균형 있게 잘 돼야지 우리는 행복한 생활을 할 수 있다라고 볼 수가 있죠.",
                "sound_type": [
