        "term": [
            {
                "speaker_id": "1",
                "transcription": "땅꽂이가 의미가 없을 정도로 폭폭 박혀버립니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.644
            },
            {
                "speaker_id": "1",
                "transcription": "도라이피싱 물뜨개로 이런 곳에서 쓰기 좋습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.654,
                "end": 14.551
            },
            {
                "speaker_id": "1",
                "transcription": "담양의 어느 물가에 나와 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.561,
                "end": 17.707
            },
            {
                "speaker_id": "1",
                "transcription": "최근에 비가 좀 내렸고 오늘도 비가 왔다 그쳤다 반복하는 상황입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.717,
                "end": 24.987
            },
            {
                "speaker_id": "1",
                "transcription": "지금 막 7대 대편성 마쳤습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.997,
                "end": 27.416
            },
            {
                "speaker_id": "1",
                "transcription": "제일 짧은 대는 정면에 28칸 제일 긴 대는 맞은편 뗏장 쪽에 던져 놓은 60칸.",
                "sound_type": [
                    2
                ],
                "start": 27.426,
                "end": 33.956
            },
            {
                "speaker_id": "1",
                "transcription": "지금 대편성 하면서는 옥수수를 전부 다 끼워 놓았고 이제 글루텐도 넣어보려고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 33.966,
                "end": 39.400
            },
            {
                "speaker_id": "1",
                "transcription": "날씨가 많이 흐려서 고기들 활성도가 어떨지 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.410,
                "end": 43.183
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 이곳에서 멋진 붕어 만나볼 수 있도록 파이팅 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 43.193,
                "end": 48.163
            },
            {
                "speaker_id": "1",
                "transcription": "지금 시작합니다.",
                "sound_type": [
                    2
                ],
                "start": 48.173,
                "end": 50.034
            },
            {
                "speaker_id": "1",
                "transcription": "초저부력 얼레 1.68그램 찌입니다.",
                "sound_type": [
                    2
                ],
                "start": 50.044,
                "end": 53.294
            },
            {
                "speaker_id": "1",
                "transcription": "짧은 대에 몇 개 쓰고 있는데 감도가 아주 예민합니다.",
