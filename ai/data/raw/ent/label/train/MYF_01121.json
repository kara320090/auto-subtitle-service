            },
            {
                "speaker_id": "1",
                "transcription": "입을 때마다 추억들이 기억나고 단종되었다는 소식을 듣고 아 단종이 되었군요.",
                "sound_type": [
                    2
                ],
                "start": 6.333,
                "end": 13.710
            },
            {
                "speaker_id": "1",
                "transcription": "차마 다 비우지 못하고 조금 남겨놨어요.",
