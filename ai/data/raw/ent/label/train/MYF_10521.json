        "term": [
            {
                "speaker_id": "1",
                "transcription": "어찌 됐든 저는 7년을 썼기 때문에 뽕을 뽑을 만큼 사용을 했었던 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.158
            },
            {
                "speaker_id": "1",
                "transcription": "오래돼서 조금 느려진 부분이 있긴 했는데 저는 크게 불편한 거 없이 끝까지 잘 썼어요.",
                "sound_type": [
                    2
                ],
                "start": 4.168,
                "end": 9.210
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 나서 제가 작년 10월쯤 아이패드 프로를 구매했었죠.",
                "sound_type": [
                    2
                ],
                "start": 9.220,
                "end": 12.695
            },
            {
                "speaker_id": "1",
                "transcription": "에어 1은 애플 펜슬이랑 스플릿뷰 지원이 안 되는 기종이에요.",
                "sound_type": [
                    2
                ],
                "start": 12.705,
                "end": 16.565
            },
            {
                "speaker_id": "1",
                "transcription": "작년부터 공부를 시작하다 보니까 애플 펜슬로 노트 정리도 하고 싶고 또 스플릿뷰도 공부할 때 유용하게 사용할 수 있을 거 같고",
                "sound_type": [
                    2
