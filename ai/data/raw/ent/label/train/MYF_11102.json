            },
            {
                "speaker_id": "1",
                "transcription": "저라는 사람을 드러내려면 좀 뭔가 제 이름 이런 걸 딴 게 낫지 않을까 해서 @계정1로 결정을 해서 채널명과 제 활동명을 바꾸게 되었습니다.",
                "sound_type": [
                    2,
