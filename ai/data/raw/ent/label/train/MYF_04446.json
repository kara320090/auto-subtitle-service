        "term": [
            {
                "speaker_id": "1",
                "transcription": "네, 아주 작지만 너무너무 다양한 세계가 존재하는 그런 기분이거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.142
            },
            {
                "speaker_id": "1",
                "transcription": "딥디크 같은 경우에 이런 세상이 한 겹 두 겹 세 겹 이렇게 느껴지고 그 율동감도 느껴진다고 하면 바이레도는 굉장히 차분하게 일정하게 흘러가는 그렇게 저는 느끼는 편이에요.",
                "sound_type": [
                    2
                ],
                "start": 5.152,
                "end": 20.329
            },
            {
                "speaker_id": "1",
                "transcription": "1920년대 후반에 프랑스 파리가 아프리카 영향을 굉장히 많이 받는다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 20.339,
                "end": 25.627
            },
            {
                "speaker_id": "1",
                "transcription": "아프리카 음악 춤 이런 것들에",
                "sound_type": [
                    2
                ],
                "start": 25.637,
                "end": 27.766
            }
        ]
    },
    "summary": "딥디크는 율동감이 느껴진다면 바이레도는 차분한 느낌이다.",
