        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 시간이 오전 7시가 조금 넘었습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 4.676
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이곳 횡성 소류지에서의 하룻밤 낚시 여기서 마무리하도록 하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 4.686,
                "end": 11.100
            },
            {
                "speaker_id": "1",
                "transcription": "어제 저녁부터 꽤 많은 마릿수의 붕어를 만났는데 씨알은 여덟 치가 최고였습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 11.107,
                "end": 18.490
            },
            {
                "speaker_id": "1",
                "transcription": "어 근데 씨알은 둘째치고 개체수가 많은 데에 비해서 붕어들이 먹을 게 없나 봅니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 18.490,
                "end": 24.317
            },
            {
                "speaker_id": "1",
                "transcription": "누치처럼 생기거나 조기처럼 생기거나 저하고는 반대로 삐쩍 곯아 있습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 24.327,
                "end": 29.920
            },
            {
                "speaker_id": "1",
                "transcription": "자 좀 아쉽긴 하지만 오늘 낚시는 여기서 마무리하고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 29.930,
                "end": 33.365
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 좋은 곳에서 멋진 붕어와 함께 찾아 뵙도록 하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 33.375,
                "end": 38.350
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 시청해주셔서 감사합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 38.360,
                "end": 41.733
            },
            {
                "speaker_id": "1",
                "transcription": "아 찌가 계속 오르락내리락 하네.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 41.743,
                "end": 43.882
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 여기까지 찌 그렇지 우와 하하하 야",
                "sound_type": [
                    1,
                    2
                ],
                "start": 43.892,
                "end": 57.290
            }
        ]
    },
    "summary": "횡성 소류지에서의 하룻밤 낚시 여기서 마무리하며 개체수가 많은 데 비해 붕어들이 먹을 게 없어 대체로 삐쩍 곯아 있다.",
