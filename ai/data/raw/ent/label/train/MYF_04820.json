                "speaker_id": "2",
                "age": "40대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 더 아름다운 것도 있지만 그래서 쉽게 상상하기가 어려워요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.281
            },
            {
                "speaker_id": "1",
                "transcription": "제가 맨날 뭐 샌드 우드랑 시드 우드가 합쳐져서요 거기에 뭐 재스민과 뭐 이렇게 해도 그 각각의 향료 단일 노트를 알지 않는 이상은 쉽게 상상하기가 어렵거든요.",
                "sound_type": [
                    2
                ],
                "start": 3.291,
                "end": 14.863
            },
            {
                "speaker_id": "2",
                "transcription": "왜냐하면 기자들이 제일 해독하기 어려운 보도 자료가 향수 보도 자료예요.",
                "sound_type": [
                    2
                ],
                "start": 14.873,
                "end": 20.051
            },
            {
                "speaker_id": "2",
                "transcription": "무슨 말인지 잘 모르고 있는",
                "sound_type": [
                    2
                ],
                "start": 20.061,
                "end": 22.686
            },
            {
                "speaker_id": "1",
                "transcription": "제가 만약 파리지앵이고 한국 음식을 한 번도 안 먹어본 사람인데 비빔밥에 대한 보도 자료를 받았는데 뭐 숙주나물, 뭐 냉이 뭐 이런 것들이 합쳐져서 고춧가루 아 고추장이라는 소스와 버무려져서 거기에 참기름까지 더해졌다.",
                "sound_type": [
                    2
                ],
                "start": 22.696,
                "end": 38.506
            },
            {
                "speaker_id": "1",
                "transcription": "전혀 상상이 안 되죠.",
                "sound_type": [
                    2
                ],
                "start": 38.516,
                "end": 40.071
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 삶의 이야기와 그리고 직업과 이런 스토리가 있으신 분들이 그들한테 영감을 준 향수나 그들의 일상에 있는 향수 이야기를 하면은 좀 더 사람들이 쉽게 상상하지 않을까.",
                "sound_type": [
                    2
                ],
                "start": 40.081,
                "end": 52.970
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이런 자리를 만들어 봤답니다.",
                "sound_type": [
                    2
                ],
                "start": 52.980,
                "end": 55.205
            },
            {
                "speaker_id": "1",
                "transcription": "네 지금까지 봐주셔서 감사하고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 55.215,
                "end": 57.537
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 나와주셔서 너무 고맙습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.547,
                "end": 59.941
            },
            {
                "speaker_id": "2",
                "transcription": "언제든지 와인과 함께 등장하고 싶어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.951,
                "end": 62.912
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 와인과 함께 네.",
                "sound_type": [
                    2
                ],
                "start": 62.922,
                "end": 64.466
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 향수 읽어주는 여자 하니날다였습니다.",
                "sound_type": [
                    2
                ],
                "start": 64.476,
                "end": 67.346
            },
            {
                "speaker_id": "1",
                "transcription": "여러분의 좋아요와 구독은 영상에 만드는 데 힘이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 67.356,
                "end": 71.771
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 남 부장님 네.",
                "sound_type": [
                    2
                ],
                "start": 71.781,
                "end": 73.493
            },
            {
                "speaker_id": "2",
                "transcription": "저도 얼마 전에 그 남 부장의 드레스업이라는 유튜브 채널을 시작했어요.",
                "sound_type": [
                    2
                ],
                "start": 73.503,
                "end": 81.223
            },
            {
                "speaker_id": "2",
                "transcription": "저의 어떤 개인 기록에 보관 창고이기도 하지만 젊은 친구들하고 소통하고 싶어서 오픈하기도 했으니까 정말 40대 후반 50대 초반의 언니가 어떤 재미로 삶을 사는지 궁금하시다면 한번 놀러 오세요.",
                "sound_type": [
                    2
                ],
                "start": 81.233,
                "end": 97.169
            },
            {
                "speaker_id": "1",
                "transcription": "네 아래 링크 넣어 놨으니까요 한번 놀러 가세요.",
                "sound_type": [
                    2
                ],
                "start": 97.179,
                "end": 100.807
            },
            {
                "speaker_id": "1",
                "transcription": "네 고맙습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 100.817,
                "end": 103.800
            }
        ]
    },
    "summary": "삶의 이야기와 직업과 스토리가 있으신 분들이 그들한테 영감을 준 향수나 그들의 일상에 있는 향수 이야기를 하면 사람들이 쉽게 상상하지 않을까 해서 이런 자리를 만들었다고 이야기합니다.",
