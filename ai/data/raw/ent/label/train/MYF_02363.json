        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "통, 네, 넣어 가지구요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.104
            },
            {
                "speaker_id": "1",
                "transcription": "피스타치오 매일 49알을 이렇게 챙겨 가지고 그냥 먹기도 하지만 커피에 넣어서도 먹고 있답니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.114,
                "end": 10.561
            },
            {
                "speaker_id": "1",
                "transcription": "매일 마시는 커피가 좀 더 색다르게 다가오거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.571,
                "end": 14.319
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 피스타치오와 커피가 합쳐져서 만들어 내는 입안 가득하게 채우는 커피의 향과 또 이 피스타치오 특유의 약간 바스락바스락거리는 그 향을 조금이라도 느낄려고 좀 노력을 하다 보니까 그 순간에 집중을 해서 뭐랄까, 명상을 하는 효과를 좀 갖는 게 아닌가?",
                "sound_type": [
                    2
                ],
                "start": 14.329,
                "end": 37.767
            },
            {
                "speaker_id": "1",
                "transcription": "어 요런 생각이 좀 들 때도 있어요.",
                "sound_type": [
                    2
                ],
                "start": 37.777,
                "end": 39.768
            },
            {
                "speaker_id": "1",
                "transcription": "소중한 나를 위해서 완전 단백질을 공급해 줘야지 그리고 커피와 함께 해야지.",
                "sound_type": [
                    2
                ],
                "start": 39.778,
                "end": 45.491
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 나를 좀 더 차분하게 너무 일케 분주하게 지나가던 빠르게 이렇게 휙휙 지나가던 시간에 약간의 딱 쉼표를 찍어 줘서 저는 이 순간을 가지는 게 너무 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 45.501,
                "end": 58.186
            },
            {
                "speaker_id": "1",
                "transcription": "네, 제가 다른 요리들은 거의 하지 않아도 제가 꼭 만들어서 먹는 빵이 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.196,
                "end": 65.334
            },
            {
                "speaker_id": "1",
                "transcription": "건강빵으로 덕분에 제가 코로나 살로 찐 7키로를 뺐잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 65.344,
                "end": 71.016
            },
            {
                "speaker_id": "1",
                "transcription": "네, 그리고 인스타 보시면 아시겠지만 저",
                "sound_type": [
                    2
                ],
                "start": 71.026,
                "end": 74.500
            }
        ]
    },
    "summary": "피스타치오 매일 49알을 챙겨서 그냥 먹기도 하고 커피에 넣어서도 먹고 있는데 입안 가득하게 채우는 커피의 향과 피스타치오 특유의 바스락바스락거리는 그 향을 느끼려고 노력을 하다 보니까 그 순간에 집중해서 명상을 하는 효과를 갖는 게 아닌가 하는 생각이 들 때도 있습니다.",
