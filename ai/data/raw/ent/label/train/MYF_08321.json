        "term": [
            {
                "speaker_id": "1",
                "transcription": "강약 그리고 또 온풍, 음이온 등의 버튼이 있지요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.763
            },
            {
                "speaker_id": "1",
                "transcription": "뜨거운 바람이 나오는 이렇게 하면 따뜻한 바람이 한 번 더 하면 약한 바람과 음이온 바람이 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.773,
                "end": 29.934
            },
            {
                "speaker_id": "1",
                "transcription": "어느 정도의 강한 바람이냐면 앉아 있으면 따뜻한 정도의 느낌입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.944,
                "end": 39.658
            },
            {
                "speaker_id": "1",
                "transcription": "유채야 이리 와 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.668,
                "end": 42.504
            },
            {
                "speaker_id": "1",
                "transcription": "우리 유채 드라이기 어때?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.514,
                "end": 45.813
            },
            {
                "speaker_id": "1",
                "transcription": "유채 어때? 유채가 가만히 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.823,
                "end": 52.396
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 켄넬 바람을 쏘여 주면 켄넬 안에서 자연스럽게 털을 말릴 수가 있습니다.",
                "sound_type": [
                    2,
