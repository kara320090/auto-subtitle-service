        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와. 이야 힘 잘 쓴다. 이 오 이야 야 사이즈 괜찮은데. 야야야 와 발갱이다. 하하하하.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 47.064
            },
            {
                "speaker_id": "1",
                "transcription": "제일 좌측에서 찌를 쭉 올려서 챘는데 힘을 엄청나게 쓰는 발갱이네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 47.074,
                "end": 53.790
            },
            {
                "speaker_id": "1",
                "transcription": "꼬리가 주황색이죠. 이녀석 바로 보내주겠습니다. 어우 비린내. 잉어야 잉어.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 53.800,
                "end": 59.949
            },
            {
                "speaker_id": "2",
                "transcription": "우와 어 뭐야 꼬리가 왜 주황색이야.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 59.959,
                "end": 62.752
            },
            {
                "speaker_id": "2",
                "transcription": "어 잉어 새끼는 꼬리가 주황색이야. 그래서 발갛잖아. 어 그래서 발갱이라고 해.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 62.762,
                "end": 68.430
            },
            {
                "speaker_id": "2",
                "transcription": "아빠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 68.440,
                "end": 69.393
            },
            {
                "speaker_id": "2",
                "transcription": "응.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 69.403,
                "end": 69.729
            },
            {
                "speaker_id": "2",
                "transcription": "잉어 아기?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 69.739,
                "end": 71.738
            },
            {
                "speaker_id": "1",
                "transcription": "응 잉어 새끼.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 71.748,
                "end": 73.654
            },
            {
                "speaker_id": "2",
                "transcription": "잉어 아기가 왜 이렇게 커.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 73.664,
                "end": 74.733
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 원래 커. 야식 먹고 왔는데 야 앉자마자 발갱이가 입질해 버립니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 74.743,
                "end": 82.707
            }
        ]
    },
    "summary": "힘을 엄청나게 쓰는 발갱이가 잡혔다.",
