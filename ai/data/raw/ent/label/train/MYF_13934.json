        "term": [
            {
                "speaker_id": "1",
                "transcription": "어이구 어이구 좋아. 아이고 좋아.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 2.595
            },
            {
                "speaker_id": "1",
                "transcription": "여보 꾹꾹이 할 거 같애.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.605,
                "end": 6.261
            },
            {
                "speaker_id": "1",
                "transcription": "아빠 다리에다 꾹꾹이 할 거 같애 참참이.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 6.271,
                "end": 8.676
            },
            {
                "speaker_id": "1",
                "transcription": "참참아 아빠 다리에 꾹꾹이 할거야?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.686,
                "end": 12.635
            },
            {
                "speaker_id": "1",
                "transcription": "꾹꾹이 자센데?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 12.645,
                "end": 14.390
            },
            {
                "speaker_id": "1",
                "transcription": "참참이가 꾹꾹이도 잘하거든요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.400,
                "end": 17.728
            },
            {
                "speaker_id": "1",
                "transcription": "우리 참참 참참이 이제 우리 집에서 살아야겠다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 17.738,
                "end": 23.590
            },
            {
                "speaker_id": "1",
                "transcription": "안되겠다.",
