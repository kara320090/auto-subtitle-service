        "term": [
            {
                "speaker_id": "1",
                "transcription": "딥디크 색은 뭐 워낙 없으니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 41.748
            },
            {
                "speaker_id": "1",
                "transcription": "딥디크 향초 모으시는 분들 많죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.758,
                "end": 51.034
            },
            {
                "speaker_id": "1",
                "transcription": "저도 한때 모으다가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.044,
                "end": 70.769
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 그냥 보기만 해도 너무 멋있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.779,
                "end": 76.429
            },
            {
                "speaker_id": "1",
                "transcription": "제가 가봤던 홍콩 파리 그리고 뉴욕에 있는 딥디크 매장 통틀어서 여기가 가장 아름다운 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.439,
                "end": 91.028
            },
            {
                "speaker_id": "1",
                "transcription": "딥디크의 시장인 파리의 생제르맹이 있는 거는 이제 워낙 역사를 가지고 있으니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.038,
                "end": 100.877
            },
            {
                "speaker_id": "1",
                "transcription": "그치만 여기는 그냥 딥디크 자체를 보여주는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.887,
                "end": 106.412
            },
            {
                "speaker_id": "1",
                "transcription": "너무 아름답네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 106.422,
                "end": 109.766
            }
        ]
    },
