            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "낚시터와 기사식당은 제육이 진리죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.490
            },
            {
                "speaker_id": "1",
                "transcription": "밥을 먹고 와서 잠깐 쉬며 힐링합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.500,
                "end": 20.414
            },
            {
                "speaker_id": "1",
                "transcription": "붕어들도 밥을 줘야겠죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.424,
                "end": 35.044
            },
            {
                "speaker_id": "1",
                "transcription": "해가 저물어 갑니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.054,
                "end": 40.555
            },
            {
                "speaker_id": "1",
                "transcription": "역시 딴짓하고 있으니 바로 입질이 오네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.565,
                "end": 46.217
            },
            {
                "speaker_id": "1",
                "transcription": "와 힘을 꽤 씁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.227,
                "end": 51.070
            },
            {
                "speaker_id": "1",
                "transcription": "어 어 형님들의 소중한 시간을 위해 2배속 갑니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.080,
                "end": 68.303
            },
            {
                "speaker_id": "1",
                "transcription": "오 얼핏봐도 허리급이네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 68.313,
                "end": 73.415
            },
            {
                "speaker_id": "1",
                "transcription": "노지에서 이런 게 나와야 되는데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 73.425,
                "end": 84.733
            },
            {
                "speaker_id": "1",
                "transcription": "팔이 너무 아파서 왼팔로 낚시대를 쥡니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 84.743,
                "end": 98.124
            },
            {
                "speaker_id": "1",
                "transcription": "나올 생각을 안 하는 녀석",
                "sound_type": [
                    2,
                    5
                ],
                "start": 98.134,
                "end": 102.469
            }
        ]
    },
    "summary": "남자는 낚시터와 기사식당은 제육이 진리라면서 밥 먹고 힐링하는 사이 해가 저물어 갔는데 딴짓하고 있으니까 바로 입질이 왔다며 얼핏 봐도 허리급으로 보이는 게 힘을 꽤 써서 왼팔로 낚시대를 쥐었지만 나올 생각을 안 한다고 말한다.",
