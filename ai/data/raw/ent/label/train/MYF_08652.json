                "start": 0.000,
                "end": 1.292
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 바깥 고양이들 거구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.302,
                "end": 3.420
            },
            {
                "speaker_id": "1",
                "transcription": "우리 고양이 먹을 거는 이렇게 준비했는데 한번 먹여 볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.430,
                "end": 8.350
            },
            {
                "speaker_id": "1",
                "transcription": "가자 노랑.",
