                    2,
                    3
                ],
                "start": 8.360,
                "end": 9.671
            },
            {
                "speaker_id": "1",
                "transcription": "노랑 가자 어서 와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.681,
                "end": 12.579
            },
            {
                "speaker_id": "1",
                "transcription": "어서 와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.589,
                "end": 13.625
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 가지고 갈 건데? 노랑이 내려오세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.635,
                "end": 16.703
            },
            {
                "speaker_id": "1",
                "transcription": "내려오세요 노랑. 어서오세요 노랑.",
