                    2
                ],
                "start": 1.108,
                "end": 10.857
            },
            {
                "speaker_id": "1",
                "transcription": "제가 핸드폰으로 찍었어서 그런지 뭐 상대적으로 조금 더 무겁게 느껴질 순 있는데 그래도 뭐 많이 부담이 되는 정도는 아니에요.",
                "sound_type": [
                    2
