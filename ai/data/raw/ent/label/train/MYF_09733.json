        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기에서 좀 더 향수에 관련된 이야기들을 이제 말씀을 드리자고 하면 이 책에서도 얘기를 해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.220
            },
            {
                "speaker_id": "1",
                "transcription": "뭐라고 얘기를 하냐 잠시만요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.220,
                "end": 10.590
            },
            {
                "speaker_id": "1",
                "transcription": "제가 표시를 해 놨는데 금세 사라졌네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.590,
                "end": 17.340
            },
            {
                "speaker_id": "1",
                "transcription": "네 여기에서 얘기하는 게 바로 냄새 사냥이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.340,
                "end": 22.020
            },
            {
                "speaker_id": "1",
                "transcription": "이냥저냥 걸으며 주변의 냄새를 맡아 봅시다라고 얘기를 하거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.020,
                "end": 27.133
