            },
            {
                "speaker_id": "1",
                "transcription": "오 이 장비 너무 좋죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.294,
                "end": 4.700
            },
            {
                "speaker_id": "1",
                "transcription": "집에서 수동으로 뽑았는데 저도 이거 하나 사야 되겠습니다.",
