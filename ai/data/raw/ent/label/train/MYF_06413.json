                    2,
                    3
                ],
                "start": 5.902,
                "end": 8.903
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 한화 리조트에 짐을 풀고 요즘 속초에서 핫 하다는 카페 깃에 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.913,
                "end": 13.565
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 이렇게 저게 설악산 울산바위인가요? 바로 밑에 위치한",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.575,
                "end": 18.877
            },
            {
