                "transcription": "잘 보이는 위치에 있는 카페입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.887,
                "end": 22.153
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 아 들어가자 카페 들어가자 고 고 고 갑시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.163,
                "end": 26.787
            },
            {
                "speaker_id": "1",
                "transcription": "안개 너무 멋있네요. 이게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.797,
                "end": 28.643
            },
            {
                "speaker_id": "1",
                "transcription": "커피 먹고 싶데 엄마가 커피 먹으러 갑시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.653,
                "end": 31.807
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 여기 어때요?",
