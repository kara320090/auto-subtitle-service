        "term": [
            {
                "speaker_id": "1",
                "transcription": "농장에서 체험을 할 수 있다고 해서 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.315
            },
            {
                "speaker_id": "1",
                "transcription": "제가 알러지가 많다 보니까 혹시 몰라서 저는 계속 마스크를 쓰고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 3.325,
                "end": 9.731
            },
            {
                "speaker_id": "1",
                "transcription": "아마 향수에서 많이 들으셨을 버베나 이게 버베나거든요.",
                "sound_type": [
                    2
                ],
                "start": 9.741,
                "end": 14.557
            },
            {
                "speaker_id": "1",
                "transcription": "버베나를 오늘 저는 잘라가도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.567,
                "end": 17.294
            },
            {
                "speaker_id": "1",
                "transcription": "이거 제가 직접 네 밭에서 농장에서 가져온 버베나거든요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.304,
                "end": 23.953
            },
            {
                "speaker_id": "1",
                "transcription": "버베나와 향수에서 많이들 들어 보셨을 텐데 이렇게 생겼답니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.963,
                "end": 28.497
            },
            {
                "speaker_id": "1",
                "transcription": "다만 유기농이다 보니까 곤충님들과 이렇게 만나게 되더라고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 28.507,
                "end": 34.392
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아",
                "sound_type": [
                    2,
                    4
                ],
                "start": 34.402,
                "end": 36.866
            }
