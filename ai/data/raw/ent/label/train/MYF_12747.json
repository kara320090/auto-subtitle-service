        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "되는 붕어입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.640
            },
            {
                "speaker_id": "1",
                "transcription": "아 붕어 참 예쁘네요.",
                "sound_type": [
                    2
                ],
                "start": 1.650,
                "end": 10.460
            },
            {
                "speaker_id": "1",
                "transcription": "사진 보내드릴게 형님.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.460,
                "end": 14.456
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.466,
                "end": 16.022
            },
            {
                "speaker_id": "1",
                "transcription": "우와 야 느닷없이 찌 몸통을 찍어버립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.032,
                "end": 26.102
            },
            {
                "speaker_id": "1",
                "transcription": "아주 예쁜 토종 붕어 이 녀석은 5치 되겠네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.112,
                "end": 31.676
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 방생하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 31.686,
                "end": 33.534
            },
            {
                "speaker_id": "1",
                "transcription": "고맙다 야 너는 진짜 찌올림 예술이었다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.544,
                "end": 38.284
            },
            {
                "speaker_id": "1",
                "transcription": "최고다 최고.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.294,
                "end": 40.170
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 저녁은 간단하게 전투식량입니다.",
                "sound_type": [
                    2
                ],
                "start": 40.170,
                "end": 44.166
            },
            {
                "speaker_id": "1",
                "transcription": "우리 아들 래미가 제일 좋아하는 떡국.",
                "sound_type": [
                    2
                ],
                "start": 44.176,
                "end": 47.192
            },
            {
                "speaker_id": "1",
                "transcription": "자 먹고 저녁 낚시 이어가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 47.202,
                "end": 50.717
            }
        ]
    },
    "summary": "예쁜 토종 붕어가 느닷없이 찌 몸통을 찍어버렸고 찌올림이 예술이었지만 5치라서 방생하겠다며 저녁은 간단하게 전투식량인데 아들이 제일 좋아하는 떡국이라고 말한다.",
