        "term": [
            {
                "speaker_id": "1",
                "transcription": "잔 잔 무겁지 않습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 6.916
            },
            {
                "speaker_id": "1",
                "transcription": "그 퀄리티가 굉장히 좋네요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.926,
                "end": 8.970
            },
            {
                "speaker_id": "1",
                "transcription": "테이블이 테이블이 퀄리티가 굉장히 좋네.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.980,
                "end": 12.034
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 하게 되면 이제 완전히 앉을 수 있는 높이 60센티가 나와요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 12.044,
                "end": 20.938
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 이거를 이제 테이블을 차에다가 놓긴 놓을 건데 어디에 놓을지 그거를 이제 가서 시뮬레이션을 해봐야 될 것 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.948,
                "end": 30.893
            },
            {
                "speaker_id": "1",
                "transcription": "근데 일단은 사이즈나 요 상판 마감 부분이나 이런 거 굉장히 좋네요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 30.903,
                "end": 36.061
            },
            {
                "speaker_id": "1",
                "transcription": "마음에 들었다 어 좋다.",
                "sound_type": [
                    2
                ],
                "start": 36.071,
                "end": 38.555
            },
            {
                "speaker_id": "1",
                "transcription": "펼칠 때는 쉽고 무게도 아주 가벼워요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 38.565,
                "end": 44.377
            }
        ]
    },
    "summary": "남자는 테이블 다리를 펼치며 아주 가볍고 퀄리티가 좋다고 마음에 들어 하고 있습니다.",
