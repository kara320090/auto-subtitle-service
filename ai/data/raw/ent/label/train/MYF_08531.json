        "term": [
            {
                "speaker_id": "1",
                "transcription": "노랑이 너무 집중했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.710,
                "end": 4.120
            },
            {
                "speaker_id": "1",
                "transcription": "노랑아 다른 친구들도 한번 가지고 놀게 할까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.120,
                "end": 9.544
            },
            {
                "speaker_id": "1",
                "transcription": "응? 단단은 어디서?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.544,
                "end": 13.450
            },
            {
                "speaker_id": "1",
                "transcription": "어 괜찮아. 방에서 밴타가 공놀이 하는 소린 가부다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.450,
                "end": 18.029
            },
            {
                "speaker_id": "1",
                "transcription": "아이구 우리 노랑이 신났어. 어떻게. 유채하고 꼬미도 하고 싶고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.030,
                "end": 23.473
            },
            {
                "speaker_id": "1",
                "transcription": "노아도 왔는데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.483,
                "end": 26.160
            },
            {
                "speaker_id": "1",
                "transcription": "우리 노아도 하고 싶은데 그지 노아야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.150,
                "end": 29.760
            },
            {
                "speaker_id": "1",
                "transcription": "노랑이 형.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.759,
                "end": 31.831
            }
        ]
    },
    "summary": "한 여성이 고양이 한 마리만 고양이 장난감 스윙볼을 가지고 노는 모습에 다른 고양이들의 반응을 설명해 주고 있다.",
