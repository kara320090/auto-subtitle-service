                    2
                ],
                "start": 0.000,
                "end": 7.850
            },
            {
                "speaker_id": "1",
                "transcription": "저랑 너무 비슷한 분들이 계시는 거 아닌가요?",
                "sound_type": [
                    2
                ],
                "start": 7.860,
                "end": 10.735
            },
            {
                "speaker_id": "1",
                "transcription": "제가 운동하는 것 좀 많이 올려야 할 텐데 네 거의 보신 일이 없으실 테지만",
                "sound_type": [
                    2
                ],
                "start": 10.745,
                "end": 16.916
            },
            {
                "speaker_id": "1",
                "transcription": "가장 좋아하는 향이 페퍼민트시네요.",
                "sound_type": [
                    2
