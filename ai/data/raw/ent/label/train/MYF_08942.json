        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 거의 다 도착했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.834
            },
            {
                "speaker_id": "1",
                "transcription": "집에서 9시에 나왔는데 12시 40분이 넘었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.844,
                "end": 8.044
            },
            {
                "speaker_id": "1",
                "transcription": "어 정면에 제방이 보이고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.054,
                "end": 10.687
            },
            {
                "speaker_id": "1",
                "transcription": "이 하류권부터 상류로 조금씩 올라가 보면서 포인트 괜찮은 곳 잡도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.697,
                "end": 17.922
            },
            {
                "speaker_id": "1",
                "transcription": "뗏장 포인트인데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.932,
                "end": 19.151
            },
            {
                "speaker_id": "1",
                "transcription": "정면에 삭은 수초도 보이고 포인트는 좋아 보이는데 아주 농축된 녹조가 망설이게 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.161,
                "end": 28.061
            },
            {
                "speaker_id": "1",
                "transcription": "조금만 더 올라가 보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.071,
                "end": 30.823
            },
            {
                "speaker_id": "1",
                "transcription": "상류권인데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.833,
                "end": 32.073
            },
            {
                "speaker_id": "1",
                "transcription": "이곳도 녹조가 있긴 한데 못할 정도는 아니고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.083,
                "end": 35.979
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 이렇게 하면 될 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.989,
                "end": 39.898
            },
            {
                "speaker_id": "1",
                "transcription": "수심 먼저 찍어 보고 세팅하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.908,
                "end": 43.343
            }
        ]
    },
