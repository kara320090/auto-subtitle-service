        "term": [
            {
                "speaker_id": "1",
                "transcription": "우금 낚시터 약 2년 만에 와보네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.610
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 오면 기본 2자릿수 하는 곳이죠.",
                "sound_type": [
                    2
                ],
                "start": 4.623,
                "end": 46.430
            },
            {
                "speaker_id": "1",
                "transcription": "바늘도 예쁘게 다시 묶어줍니다.",
                "sound_type": [
                    2
                ],
                "start": 46.430,
                "end": 54.796
            },
            {
                "speaker_id": "2",
                "transcription": "고양이가 뒤에 와 있어서 삼촌 뒤에 고양이 딱 와가지고 챙기라고 야옹 주세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 54.806,
                "end": 75.430
            },
            {
                "speaker_id": "2",
                "transcription": "잘 되세요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 75.430,
                "end": 76.860
            },
            {
                "speaker_id": "1",
                "transcription": "이제 첫밥",
                "sound_type": [
                    2,
                    5
                ],
                "start": 76.877,
                "end": 82.380
            },
            {
                "speaker_id": "2",
                "transcription": "지금 수온이 갑자기 올라가서 고기 뜬 거 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 82.380,
                "end": 87.708
            },
            {
                "speaker_id": "2",
                "transcription": "한 3시 4시 4시 다 이제 가라앉을 많이 잡으세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 87.710,
                "end": 94.348
            },
            {
                "speaker_id": "1",
                "transcription": "고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 94.358,
                "end": 100.590
            },
            {
                "speaker_id": "1",
                "transcription": "정말 고기들이 다들 떠있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 100.600,
                "end": 107.954
            },
            {
                "speaker_id": "1",
                "transcription": "떡밥을 더 단단히 해서 바닥까지 가서 천천히 풀리게 집어하였습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 107.964,
                "end": 114.514
            }
        ]
    },
    "summary": "우금 낚시터는 2년 만에 왔지만 기본 2자릿수 하는 곳이라며 현재 수온이 갑자기 올라가서 고기가 다 떴는데 3시에서 4시 때 다 가라앉을 거라는 소식을 듣고는 떡밥을 단단히 한 후 바닥까지 가서 풀리게 집어했다고 말한다.",
