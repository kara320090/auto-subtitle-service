    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "포장이 진짜 잘돼있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.680
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 무거운데? 아구",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.680,
                "end": 7.242
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 들어있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.242,
                "end": 8.960
            },
            {
                "speaker_id": "1",
                "transcription": "이거 반찬으로 먹으려고 꼬막무침 샀어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.960,
                "end": 14.597
            },
            {
                "speaker_id": "1",
                "transcription": "벌교 양념 꼬막무침",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.600,
                "end": 17.087
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이거는 감자 채전인데 제가 살고 있는 이 텍사스에는 하루 종일 비가 왔거든요",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.087,
                "end": 23.992
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 오늘 같은 날 딱 전에 막걸리 한잔하면은 크 너무 좋을 것 같죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.995,
                "end": 29.360
            },
            {
                "speaker_id": "1",
                "transcription": "짜잔.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.360,
                "end": 30.982
            },
            {
                "speaker_id": "1",
                "transcription": "쭈꾸미",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.985,
                "end": 31.487
            },
            {
                "speaker_id": "1",
                "transcription": "야채 막 넣고 그냥 밥에 쓱쓱 비벼 먹어도 참 맛있잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.487,
                "end": 36.117
            },
            {
                "speaker_id": "1",
                "transcription": "간단하게 식사 한 끼 식사할 수 있을 것 같아서 한 번 주문해 봤습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.117,
                "end": 40.612
            },
            {
                "speaker_id": "1",
                "transcription": "좀 안주를 많이 샀어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.612,
                "end": 42.507
            },
            {
                "speaker_id": "1",
                "transcription": "데리야키 닭꼬치랑 막창 볶음",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.510,
                "end": 45.520
            },
            {
                "speaker_id": "1",
                "transcription": "에어프라이어에 간단하게 돌려도 괜찮고 그냥 뭐 프라이팬에 살짝 볶아서 먹어도 맛있잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.522,
                "end": 51.497
            },
            {
                "speaker_id": "1",
                "transcription": "맥주랑 뭐 한잔 할 때 가볍게 저녁에 그냥 밥 먹기 싫은 날 있잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.507,
                "end": 56.720
            },
            {
                "speaker_id": "1",
                "transcription": "그런 날이나 안주로 먹으려고 샀습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.722,
                "end": 59.155
            },
            {
                "speaker_id": "1",
                "transcription": "대박 이거 들깨 칼국수 이거 먹고 싶었어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.155,
                "end": 63.537
            },
            {
                "speaker_id": "1",
                "transcription": "우와 묵직하니 뭔가 되게 알차게 들어 있는 거 같은데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 63.537,
                "end": 67.845
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 생겼습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 67.845,
                "end": 69.687
            },
            {
                "speaker_id": "1",
                "transcription": "저도 사실 몰랐는데 그 칼국수가 대전에 향토 음식이라고 하더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 69.690,
                "end": 76.013
            },
            {
                "speaker_id": "1",
                "transcription": "제랑 남편이 이제 대전 출신이거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 76.023,
                "end": 78.305
            },
            {
                "speaker_id": "1",
                "transcription": "대전에 대한 이제 남다른 애착이 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 78.305,
                "end": 80.755
            },
            {
                "speaker_id": "1",
                "transcription": "근데 들깨 칼국수가 대전에 향토 음식이라는 거는 이번에 처음 알았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 80.757,
                "end": 85.157
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 같은 비 오는 날씨에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 85.157,
                "end": 89.766
            }
        ]
    },
    "summary": "한 여자가 배송 온 것을 풀면서 꼬막무침, 감자 채전, 닭꼬치랑 막창 그리고 들깨 칼국수를 샀는데 칼국수가 대전의 향토음식이라는 것을 처음 알았다고 이야기하고 있다.",
