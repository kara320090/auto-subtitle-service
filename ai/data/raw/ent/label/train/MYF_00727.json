        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요. 형님들 붕어 잡는 곰 인사드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.727
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 전남 담양의 어느 천으로 나와 봤습니다. 어 비가 오네요.",
                "sound_type": [
                    2
                ],
                "start": 2.737,
                "end": 8.657
            },
            {
                "speaker_id": "1",
                "transcription": "늦은 시간에 도착을 해서 몇 군데에 돌아봤는데 아무래도 금요일 저녁이다 보니 저수지에는 자리가 없더라고요. 지금 자리한 포인트는 마름 포인트입니다.",
                "sound_type": [
                    2
                ],
                "start": 8.667,
                "end": 18.078
            },
            {
                "speaker_id": "1",
                "transcription": "마름이 예쁘게 덮고 있는데 대편성은 초강 몬스터 20칸부터 60칸까지 7대 편성했고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 18.088,
                "end": 25.714
            },
            {
                "speaker_id": "1",
                "transcription": "멘트하는 도중에 비가 와서 카메라에 우선을 좀 쉬어야겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 25.724,
                "end": 29.484
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이곳에서 멋진 붕어 만나볼 수 있도록 화이팅하겠습니다. 우측에 다른 조사님 계셔서 멘트는 조용조용히 하는 점 많이 부탁드리고요.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 29.494,
                "end": 39.289
            }
        ]
    },
    "summary": "저수지엔 자리 없어서 마름 포인트에 자리를 했다.",
