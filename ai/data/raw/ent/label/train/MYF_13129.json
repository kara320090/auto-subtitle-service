        "term": [
            {
                "speaker_id": "1",
                "transcription": "방울아 잘 잤어 우리 방울이?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.521
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 우리 방울이 아이고 그루밍 하는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.531,
                "end": 12.691
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 예뻐라 우리 방울이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.701,
                "end": 15.522
            },
            {
                "speaker_id": "1",
                "transcription": "그루밍 자세 아이들이 이렇게 털로 된 재질을 좀 좋아하는 것 같아서요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.532,
                "end": 24.007
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이렇게 몽실몽실한 양털 재질로 깔아를 봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.017,
                "end": 28.365
            },
            {
                "speaker_id": "1",
                "transcription": "우리 방울이 얼굴 한번 볼까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.375,
                "end": 31.520
            }
        ]
    },
    "summary": "방울이는 그루밍 자세를 하고 있고 아이들이 털로 된 재질을 좋아하는 것 같아서 깔아줬다.",
