        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고는 제가 이제 말씀 드리는 게",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.199
            },
            {
                "speaker_id": "1",
                "transcription": "물론 제가 댓글이 아니라 실제로 뭐 컨설팅을 해서 뵙거나 그랬다면은,",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.209,
                "end": 6.923
            },
            {
                "speaker_id": "1",
                "transcription": "제가 왜 그 향수가 좋으세요? 그 향수 중에 어떤 루트가 좋아서 그러셨을까요?",
                "sound_type": [
                    2
                ],
                "start": 6.933,
                "end": 12.660
            },
            {
                "speaker_id": "1",
                "transcription": "이제 이런 것들을 루트 확인을 하면서 제가 여쭤 볼 수가 있었을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 12.670,
                "end": 18.100
            }
        ]
    },
    "summary": "전문가 컨설팅으로 비슷한 향수 찾는 방법을 설명하고 있다.",
