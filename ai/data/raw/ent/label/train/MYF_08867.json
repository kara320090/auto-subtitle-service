        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "정말 아쉽지만 지금 접는 게 맞을 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.312
            },
            {
                "speaker_id": "1",
                "transcription": "점점 강수량이 계속 많아져서 하루 종일 비와 눈이 오기 때문에 그치는 걸 기다리는 건 의미가 없을 것 같고 자 이제 대는 다 접었고 오늘 만났던 붕어들 보내주고 철수하도록 하겠습니다.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 3.322,
                "end": 16.553
            },
            {
                "speaker_id": "1",
                "transcription": "한 번에 바로 그냥 보내줄게요.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 16.563,
                "end": 24.830
            },
            {
                "speaker_id": "1",
                "transcription": "잘 가라.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 24.840,
                "end": 26.399
            },
            {
                "speaker_id": "1",
                "transcription": "제가 생각했던 엔딩은 이게 아니었는데 갑자기 내리는 비 때문에 급하게 철수를 하게 됐습니다.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 26.409,
                "end": 33.121
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 이곳 전북 김제 수로에서의 하룻밤은 아니죠.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 33.131,
                "end": 37.114
            },
            {
                "speaker_id": "1",
                "transcription": "지금 새벽인데 오늘 낚시 여기서 마무리하고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 37.124,
                "end": 41.164
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 좋은 곳에서 찾아뵙도록 하겠습니다.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 41.174,
                "end": 44.553
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 시청해 주셔서 감사합니다.",
                "sound_type": [
                    1,
