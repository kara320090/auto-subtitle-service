        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "별로 그렇게 효과적이지 못해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.813
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이제 담요를 한 장 넣어주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.823,
                "end": 5.061
            },
            {
                "speaker_id": "1",
                "transcription": "핫팩만 넣어두면 너무 뜨거워서 고양이들이 도망을 가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.071,
                "end": 9.634
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 담요 밑에 핫팩을 요렇게 넣어주면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.644,
                "end": 12.973
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 담요가 뜨끈뜨끈해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.983,
                "end": 15.756
            },
            {
                "speaker_id": "1",
                "transcription": "저희는 캠핑 다니면서도 많이 사용했거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.766,
                "end": 18.860
            },
            {
                "speaker_id": "1",
                "transcription": "침낭 안에 요 핫팩 한 개만 넣고 자도 밤새 침낭 속이 따듯하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.870,
                "end": 23.871
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러면 핫팩과 담요를 한 번 깔아서 오늘 하루는 저희 고양이 친구들에게 길고양이 겨울집 사용을 어떻게 하는지 잘 하는지 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.881,
                "end": 37.024
            },
            {
                "speaker_id": "1",
                "transcription": "얘들아 엄마가 해줄게 유채야 또 비닐을 좋아해 자 넣어보자 얘들아 이제 담요를 깔았고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.034,
                "end": 47.174
            },
            {
                "speaker_id": "1",
                "transcription": "그 밑에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.184,
                "end": 49.549
            }
        ]
    },
    "summary": "핫팩만 넣어두면 너무 뜨거워서 고양이들이 도망을 가기 때문에 담요 밑에 핫팩을 넣어주면 담요가 뜨끈뜨끈하다고 한다.",
