        "term": [
            {
                "speaker_id": "1",
                "transcription": "얼른 텐트 세팅해 놓고 낚싯대 피러 달려갑니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.232
            },
            {
                "speaker_id": "1",
                "transcription": "강계라 수심부터 찍어봅니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.242,
                "end": 19.675
            },
            {
                "speaker_id": "1",
                "transcription": "육십에서 일 점 팔 미터 권까지 다양합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.685,
                "end": 31.240
            },
            {
                "speaker_id": "1",
                "transcription": "아들래미가 새우망을 담궈봅니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 31.250,
                "end": 44.011
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 미끼는 지렁이와 옥수수입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 44.021,
                "end": 50.824
            },
            {
                "speaker_id": "1",
                "transcription": "유속이 있어서 찌를 무겁게 내렸습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 50.834,
                "end": 64.526
            },
            {
                "speaker_id": "1",
                "transcription": "역시 고기는 빠질 수 없죠.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 64.536,
                "end": 72.028
            },
            {
                "speaker_id": "1",
                "transcription": "이른 저녁을 먹습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 72.038,
                "end": 96.036
            },
            {
                "speaker_id": "1",
                "transcription": "아들래미와 물가에 앉아있는 이 시간 더 없이 행복합니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 96.046,
                "end": 108.277
            },
            {
                "speaker_id": "1",
                "transcription": "최고의 시간입니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 108.287,
                "end": 114.514
            }
        ]
    },
    "summary": "강계라 수심부터 찍고 아들이 새우망을 담구고 오늘 미끼는 지렁이와 옥수수이며 유속이 있어서 찌를 무겁게 내렸고 이른 저녁 고기를 먹고 아들과 물가에 앉아있는 시간이 행복하고 최고의 시간이다.",
