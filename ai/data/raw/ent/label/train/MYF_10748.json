        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 뭐 탬파는 모항지죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.434
            },
            {
                "speaker_id": "1",
                "transcription": "예 모항지이기도 하지만 그래서 뭐 여기서 어 크루즈를 승선하거나 하선하면 여기서 뭐 최소 1박 정도는 하겠죠.",
                "sound_type": [
                    2
                ],
                "start": 4.444,
                "end": 14.605
            },
            {
                "speaker_id": "1",
                "transcription": "음 그 정도로 볼 것들이 있고 되게 깔끔하고 이쁜 도시일 것 같다는 생각이 들어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.615,
                "end": 21.496
            },
            {
                "speaker_id": "1",
                "transcription": "일단 해가 떠 봐야 되겠지만 말이죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.506,
                "end": 25.671
            },
            {
                "speaker_id": "1",
                "transcription": "제가 봤을 때는 그리고 느낌이 되게 좋네요.",
