        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "조그만 녀석들이 계속 덤비네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.802
            },
            {
                "speaker_id": "1",
                "transcription": "반가운 붕어들이지만 씨알은 많이 아쉽습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.812,
                "end": 8.406
            },
            {
                "speaker_id": "1",
                "transcription": "첫 수로 세 치 정도 되는 붕어 나오고 두 번째 다섯 치 붕어 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 8.416,
                "end": 13.459
            },
            {
                "speaker_id": "1",
                "transcription": "제가 봤을 땐 월척보다 더 잡기 힘든 잔바리 붕어일 것 같은데 야 그런 녀석들이 나오네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.469,
                "end": 20.362
            },
            {
                "speaker_id": "1",
                "transcription": "좀 기다리면 좋은 씨알의 녀석 볼 수 있을 거라고 생각합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.372,
                "end": 23.966
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 다행인 건 아예 붕어가 움직이지 않는 것보다는 그래도 저런 녀석들이라도 움직인다라는 게 희망을 갖게 하네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 23.976,
                "end": 34.643
            },
            {
                "speaker_id": "1",
                "transcription": "자 화이팅 해보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 34.653,
                "end": 36.578
            }
        ]
    },
    "summary": "한 남성이 세 치, 다섯 치 되는 작은 붕어들이 계속 잡히는데 월척보다 더 잡기 힘든 것 같은 잔바리 붕어들이 나온다고 하며 그래도 다행인 것은 아예 붕어가 움직이지 않는 게 아니라서 조금만 기다리면 좋은 씨알의 물고기를 볼 수 있을 거라고 말한다.",
