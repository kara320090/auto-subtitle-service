                    2
                ],
                "start": 7.621,
                "end": 11.674
            },
            {
                "speaker_id": "1",
                "transcription": "아닙니다. 초대해주셔서 고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.684,
                "end": 15.735
            },
            {
                "speaker_id": "3",
                "transcription": "아니 비가 그치는 듯 하더니 조금조금씩 오는 것 같네요.",
                "sound_type": [
                    2,
                    3
