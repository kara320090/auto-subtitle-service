            },
            {
                "speaker_id": "1",
                "transcription": "아 여기서부터 향이 나네요.",
                "sound_type": [
                    2
                ],
                "start": 5.031,
                "end": 7.007
            },
            {
                "speaker_id": "2",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2
                ],
                "start": 7.017,
                "end": 7.611
            },
            {
                "speaker_id": "3",
                "transcription": "저희 또 먼 길 오시느라 고생 많으셨습니다.",
