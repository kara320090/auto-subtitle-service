        "term": [
            {
                "speaker_id": "1",
                "transcription": "유채는 틱톡으로 놀고 있고 누나 이렇게 하는 거야",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.019
            },
            {
                "speaker_id": "1",
                "transcription": "누나 이것 봐 내가 가르쳐 줄게 어서 와 봐",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.029,
                "end": 7.988
            },
            {
                "speaker_id": "1",
                "transcription": "쑥이는 잘 보고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.998,
                "end": 13.598
            },
            {
                "speaker_id": "1",
                "transcription": "와 불이 나오는 공도 있네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.608,
                "end": 17.239
            },
            {
                "speaker_id": "1",
                "transcription": "번쩍번쩍 불이 나오는데요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.249,
                "end": 21.230
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 유채랑 쑥이지니랑 너무 예쁘다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.240,
                "end": 27.190
            },
            {
                "speaker_id": "1",
                "transcription": "유채야 진짜 넌 너무 착해",
