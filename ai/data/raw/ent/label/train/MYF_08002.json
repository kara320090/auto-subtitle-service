        "term": [
            {
                "speaker_id": "1",
                "transcription": "이리 와 쑥이 쑥이 엄마한테 와",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.016
            },
            {
                "speaker_id": "1",
                "transcription": "하나도 안 아파요. 쑥이 엄마한테 와",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.026,
                "end": 6.620
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 누가 저기 있나 보면은 나와가지고 한번씩 솜방망이 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.630,
                "end": 14.532
            },
            {
                "speaker_id": "1",
                "transcription": "쑥이 어디 있지 쑥아 안 보여 쑥이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.542,
                "end": 18.723
            },
            {
                "speaker_id": "1",
                "transcription": "쑥이 발 보이시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.733,
                "end": 21.130
            },
            {
                "speaker_id": "1",
                "transcription": "쑥아 쑥아 음 아이고 얼굴 보이네 쑥이 귀여워요.",
                "sound_type": [
                    2,
                    3,
                    5
