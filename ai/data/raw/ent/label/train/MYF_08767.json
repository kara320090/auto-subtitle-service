        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 달래가며 빗겨주세요 @이름1이 너무 의젓해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.504
            },
            {
                "speaker_id": "1",
                "transcription": "자 @이름1이 이쪽 겨드랑이도 한번 빗어볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.514,
                "end": 9.910
            },
            {
                "speaker_id": "1",
                "transcription": "착착착 우리 @이름1이 꼬리도 한번 보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.920,
                "end": 15.298
            },
            {
                "speaker_id": "1",
                "transcription": "꼬리도 꼬리털 끝까지 이렇게 빗겨줘야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.308,
                "end": 19.302
            },
            {
                "speaker_id": "1",
                "transcription": "자 @이름1이 이제 바닥에 앉아서 서있을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.312,
                "end": 22.370
            },
            {
                "speaker_id": "1",
                "transcription": "어차 의젓하게 내려와서 얌전히 앉아보세요 @이름1이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.381,
                "end": 26.620
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 착해라 우리 @이름1이 자 모여서 털이 이만큼 빠지죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.620,
                "end": 32.502
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 빗는 것을 가능하면 하루에 한번은 꼭 하고 하루에 23번을 하면 @이름1의 털이 윤기가 하고 이렇게 예뻐지겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.512,
                "end": 45.819
            },
            {
                "speaker_id": "1",
                "transcription": "고양이들은 반드시 숨어있는 털을 빠져있는 털들을 제거해줘야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.829,
                "end": 52.782
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지 않으면 @이름1의 피부가 상할 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.792,
                "end": 57.255
            },
            {
                "speaker_id": "1",
                "transcription": "잘했어 @이름1 칭찬하자 우리 @이름1 잘했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.265,
                "end": 67.333
            }
        ]
    },
    "summary": "화자가 @이름1의 꼬리까지 빗으면서 고양이들의 숨어있는 털들과 빠져있는 털들을 반드시 하루에 한번은 꼭 하고 23번은 해줘야 털에 윤기가 나고 피부가 상하지 않는다고 한다.",
