        "term": [
            {
                "speaker_id": "1",
                "transcription": "인정하는데 그래도 제가 삼성 매니아거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.458
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 삼성을 한번 쏴보고 싶어서 한번 구매했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.468,
                "end": 4.632
            },
            {
                "speaker_id": "1",
                "transcription": "제가 한번 오픈 박스를 하고 바로 나가서 영상을 찍어 올게요.",
                "sound_type": [
                    2
                ],
                "start": 4.642,
                "end": 7.872
            },
            {
                "speaker_id": "1",
                "transcription": "오픈 박스 이후에 나오는 영상은 제가 자막으로 표시해 드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 7.882,
                "end": 10.893
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 한번 박스를 까 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.903,
                "end": 12.799
            },
            {
                "speaker_id": "1",
                "transcription": "자 자 2군데만 돼 있네요.",
