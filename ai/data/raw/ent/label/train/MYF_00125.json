        "term": [
            {
                "speaker_id": "1",
                "transcription": "드드",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.601
            },
            {
                "speaker_id": "2",
                "transcription": "누나 먹을 것 가지고 장난치면 엄마한테 혼난다.",
                "sound_type": [
                    2
                ],
                "start": 0.611,
                "end": 4.257
            },
            {
                "speaker_id": "1",
                "transcription": "야 근데 이거 너무 재미있지 않냐?",
                "sound_type": [
                    2
                ],
                "start": 4.267,
                "end": 5.688
            },
            {
                "speaker_id": "1",
                "transcription": "야 망 좀 봐봐 이거 좀만 더 해 보게.",
                "sound_type": [
                    2
                ],
                "start": 5.698,
                "end": 7.558
            },
            {
                "speaker_id": "1",
                "transcription": "아 일단 무 박살 아하하하",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.568,
                "end": 13.539
            },
            {
                "speaker_id": "3",
                "transcription": "아니 이 귀한 무를 갖다 그냥 이놈의 기지배 @이름 1 야 @이름 1 야",
                "sound_type": [
                    2
                ],
                "start": 13.549,
                "end": 20.519
            },
            {
                "speaker_id": "2",
                "transcription": "자아 먹을 것 가지고 장난친 자의 최후가 저렇습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.529,
                "end": 23.346
            },
            {
                "speaker_id": "2",
                "transcription": "네 밭에 물 줘야죠.",
                "sound_type": [
                    2
                ],
                "start": 23.356,
                "end": 25.303
            },
            {
                "speaker_id": "2",
                "transcription": "아이 누나 한 곳을 찐득하게 주라고.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 25.313,
                "end": 31.424
            },
            {
                "speaker_id": "1",
                "transcription": "한 곳을 찐득하게?",
                "sound_type": [
                    2
                ],
                "start": 31.434,
                "end": 32.758
            },
            {
                "speaker_id": "1",
                "transcription": "아 얘는 물 너무 많이 먹는 거 아니야?",
                "sound_type": [
                    2
                ],
                "start": 32.768,
                "end": 35.662
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 고추밭 끝났어.",
                "sound_type": [
                    2
                ],
                "start": 35.672,
                "end": 39.569
            },
            {
                "speaker_id": "2",
                "transcription": "자 가지밭 추가하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.579,
                "end": 41.741
            },
            {
                "speaker_id": "1",
                "transcription": "아 쉬 전우들이여 이동하라 가지밭으로.",
                "sound_type": [
                    2
                ],
                "start": 41.751,
                "end": 52.666
            },
            {
                "speaker_id": "1",
                "transcription": "후 비다 시원해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.676,
                "end": 69.836
            }
        ]
    },
    "summary": "여성이 텃밭에 서서 물을 주고 있다.",
