        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 프레드릭 말의 신테틱 정글 그리고 어 이런 티 향",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.197
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래서 르라보의 떼마차 추천을 드려봤답니다.",
                "sound_type": [
                    2
                ],
                "start": 5.207,
                "end": 8.976
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 도움이 되셨다면 구독과 좋아요 부탁드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 8.986,
                "end": 13.244
            },
            {
                "speaker_id": "1",
                "transcription": "느려도 네 어 답변 주셨던 분들",
                "sound_type": [
                    2
                ],
                "start": 13.254,
                "end": 16.902
            },
            {
                "speaker_id": "1",
                "transcription": "이 답변은 댓글로 요즘 또 남겨주시더라고요.",
                "sound_type": [
                    2
                ],
                "start": 16.912,
                "end": 20.176
            },
            {
                "speaker_id": "1",
                "transcription": "네 이거는 그 질문이 굉장히 길었던 설문지를 네 12월달에 제가 올렸었고 그 설문지 응답을 이렇게 해주신 분들 대상으로 지금 해드리고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 20.186,
                "end": 32.040
            },
            {
                "speaker_id": "1",
                "transcription": "그거 끝나는 대로",
                "sound_type": [
                    2
                ],
                "start": 32.050,
                "end": 33.688
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아직도 굉장히 그 좀 많이 남아 계셔서",
                "sound_type": [
                    2
                ],
                "start": 33.698,
                "end": 36.966
            }
        ]
    },
