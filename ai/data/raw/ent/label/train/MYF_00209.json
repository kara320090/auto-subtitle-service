        "term": [
            {
                "speaker_id": "1",
                "transcription": "하이브리드라 아 그렇지 그리고 저쪽에는 소나타 터보용 2.0 T 소나타 어 터보형 스포츠 네 여러분 항상 말씀드리지만 엠블럼은 뭐다 갬성이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 16.033
            },
            {
                "speaker_id": "1",
                "transcription": "우리 차주가 일찍 결혼해 가지고요 얼마나 힘들고 고생했겠어요.",
                "sound_type": [
                    2
                ],
                "start": 16.043,
                "end": 20.758
            },
            {
                "speaker_id": "1",
                "transcription": "차주에 갬성 충전용 차로 인정해 주시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 20.768,
                "end": 24.696
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 요즘에 우리나라 젊은이들 결혼하기도 힘들고 결혼도 많이 안 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 24.706,
                "end": 29.405
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 애국자예요 나 진짜 존중합니다.",
                "sound_type": [
                    2
                ],
                "start": 29.415,
                "end": 31.443
            },
            {
                "speaker_id": "1",
                "transcription": "혹시 애기도 있어?",
                "sound_type": [
                    2
                ],
                "start": 31.453,
                "end": 33.033
            }
        ]
    },
    "summary": "차주의 엠블럼 감성을 인정해줘야 한다고 얘기하고 얘국자로 존중한다고 한다.",
