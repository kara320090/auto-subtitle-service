        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.411
            },
            {
                "speaker_id": "1",
                "transcription": "까리한 TV 카일입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.421,
                "end": 1.563
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 공동구매라는 걸 많이 들어보셨을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 1.573,
                "end": 4.198
            },
            {
                "speaker_id": "1",
                "transcription": "인스타, 유튜브, 블로그 같은 이런 SNS를 통해 가지고 좋은 제품들을 소개하고 뭐 특별히 가격 핫딜가로 이렇게 소개하면서 판매를 하는 공동구매라고 많이 얘기를 하는데",
                "sound_type": [
                    2
                ],
                "start": 4.208,
                "end": 14.563
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 한두 번쯤은 공동구매를 통해 가지고 물건 사보신 분들도 많이 계실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 14.573,
                "end": 18.555
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우도 그런 식으로 공동구매를 종종 하기도 하고 육아를 하면서 좋은 그런 장난감이나 아니면 좋은 제품들이 있으면은 종종 구매를 하기도 하는데",
                "sound_type": [
                    2
                ],
                "start": 18.565,
                "end": 27.055
            },
            {
                "speaker_id": "1",
                "transcription": "구매만 하기에는 뭔가 아쉽잖아요.",
                "sound_type": [
                    2
                ],
                "start": 27.065,
                "end": 29.649
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 나도 한번 잘 팔 수 있지 않을까라는 생각에 좀 도전을 해 보고 싶으신 분들이 계실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 29.659,
                "end": 34.670
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우도 좀 관심이 있는 분야라서 도전을 해 보고 싶기는 하는데 이 업체 컨텍부터 해 가지고 물건을 제가 대신 팔아주는 거니까",
                "sound_type": [
                    2
                ],
                "start": 34.680,
                "end": 41.788
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 거기에 대한 수수료라든지 아니면 저도 뭔가 베네핏이 있어야 되는 거다 보니까 그런 것들을 조율하는 게 만만한 일은 아니더라고요.",
                "sound_type": [
                    2
                ],
                "start": 41.798,
                "end": 49.296
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니까 뭐 중도가 포기하기도 하고 이제 관심 있었던 분들도 쉽지 않다라는 걸 현실을 깨닫게 되는 경우도 많이 있는데",
                "sound_type": [
                    2
                ],
                "start": 49.306,
                "end": 56.771
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 공동구매에 관심이 있으셔서 한번 내가 물건을 팔아보고 싶다.",
                "sound_type": [
                    2
                ],
                "start": 56.781,
                "end": 60.929
            },
            {
                "speaker_id": "1",
                "transcription": "나도 인플루언서들처럼 좀 잘할 자신이 있다 이런 분들이 누구나 쉽게 접근할 수 있는 플랫폼이 있어서 한번 소개를 하려고 해요.",
                "sound_type": [
                    2
                ],
                "start": 60.939,
                "end": 67.348
            },
            {
