        "term": [
            {
                "speaker_id": "1",
                "transcription": "화장실이 이제 좁아 더 큰 거 줘야겠는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.708
            },
            {
                "speaker_id": "1",
                "transcription": "우리 방울이 집중했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.718,
                "end": 7.972
            },
            {
                "speaker_id": "1",
                "transcription": "자네도 화장실에 온 거야 아저씨가 여기 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.982,
                "end": 14.781
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 화장실로 들어가면 가보면 안 돼 방울이가 화장실 어떻게 쓰나 볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.791,
                "end": 20.343
            },
            {
                "speaker_id": "1",
                "transcription": "알았어 우리 소리 소리 엄마한테와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.353,
                "end": 33.172
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 응가 하는 거 보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.182,
                "end": 36.221
            },
            {
                "speaker_id": "1",
                "transcription": "방울씨 응가 했어요 한번 볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.231,
                "end": 39.164
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 모래 덮을려고 어 방울이 응가 쫌 했네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.174,
                "end": 46.435
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 응가 좀 했구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.445,
                "end": 49.534
            },
            {
                "speaker_id": "1",
                "transcription": "근데 모래를 아무리 좀 손 좀 씻자 어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.544,
                "end": 54.440
            }
        ]
    },
    "summary": "방울이가 모래 화장실로 들어와 응가를 한다.",
