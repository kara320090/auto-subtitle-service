        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 제 첫 영상에 다 댓글이 달린 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.207
            },
            {
                "speaker_id": "1",
                "transcription": "첫 영상이 크루즈여행 비용인데 이게 내렸다가 다시 제작을 할까 생각을 해봤는데 저에게는 상징성 있는 첫 영상입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.217,
                "end": 13.656
            },
            {
                "speaker_id": "1",
                "transcription": "아무리 완성도가 떨어지고 지적성이 많더라도 초심을 잃지 않기 위해서 아직까지 남겨두고 있구요.",
                "sound_type": [
                    2
                ],
                "start": 13.666,
                "end": 19.699
            },
            {
                "speaker_id": "1",
                "transcription": "또 이 영상이 17만 뷰가 넘었더라구요.",
                "sound_type": [
                    2
                ],
                "start": 19.709,
                "end": 23.503
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 놔두고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.513,
                "end": 24.675
            },
            {
