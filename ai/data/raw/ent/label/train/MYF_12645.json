                    1,
                    2
                ],
                "start": 11.654,
                "end": 14.205
            },
            {
                "speaker_id": "1",
                "transcription": "가라.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.215,
                "end": 16.477
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 이곳 소류지에서의 탐사 낚시 여기서 마무리하도록 하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.487,
                "end": 22.327
            },
            {
                "speaker_id": "1",
                "transcription": "어 아침 일찍 와서 붕어들 많이 만났고요.",
                "sound_type": [
                    2
                ],
                "start": 22.337,
                "end": 25.133
            },
            {
                "speaker_id": "1",
                "transcription": "소류지 붕어들 정말 예뻤습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.143,
                "end": 27.265
            },
            {
                "speaker_id": "1",
                "transcription": "채식도 괜찮았고 어 전반적으로 영양 상태도 아주 좋더라고요.",
                "sound_type": [
                    2
                ],
                "start": 27.275,
                "end": 31.492
            },
            {
                "speaker_id": "1",
                "transcription": "아까 잠깐 동네 주민분께서 오셔서 이런저런 얘기를 하고 가셨는데 글쎄요.",
                "sound_type": [
                    2
                ],
                "start": 31.502,
                "end": 36.807
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이곳 소류지는 다시는",
