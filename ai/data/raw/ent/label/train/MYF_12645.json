                    3
                ],
                "start": 2.113,
                "end": 5.041
            },
            {
                "speaker_id": "1",
                "transcription": "아 찌를 살금살금 옆으로 가져가는 거 채서 나왔습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 5.051,
                "end": 11.644
            },
            {
                "speaker_id": "1",
                "transcription": "어 붕어가 아주 예쁩니다.",
