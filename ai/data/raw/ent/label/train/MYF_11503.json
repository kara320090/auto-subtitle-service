        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다음번에는 이제 저희 아이도 좀 깨어있을 때 한 번 사와 보려고 해요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.331
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 음료수도 뭐 주스 되고 어 우유도 되나?",
                "sound_type": [
                    2
                ],
                "start": 3.341,
                "end": 7.974
            },
            {
                "speaker_id": "1",
                "transcription": "우유는 저도 정확히 기억이 안 나네요.",
                "sound_type": [
                    2
                ],
                "start": 7.984,
                "end": 9.628
            },
            {
                "speaker_id": "1",
                "transcription": "하여튼 주스는 확실히 있었어요.",
                "sound_type": [
                    2
                ],
                "start": 9.638,
                "end": 11.402
            },
            {
                "speaker_id": "1",
                "transcription": "주스나 물 이렇게는 바꿀 수 있다 보니까 아이들한테는 탄산음료는 아직은 좀 일러서 어 아이한테 주실 때는 음료수를 바꿀 수 있다는 거 하나 알아두시면 좋고",
                "sound_type": [
                    2
                ],
                "start": 11.412,
                "end": 20.115
            },
            {
                "speaker_id": "1",
                "transcription": "어 총 네 가지에요.",
                "sound_type": [
                    2
                ],
                "start": 20.125,
                "end": 21.551
            },
            {
                "speaker_id": "1",
                "transcription": "메인 메뉴가 햄버거, 치즈버거, 불고기버거, 맥너겟 이렇게 네 가지가 있기 때문에 저처럼 네 개 세트를 한꺼번에 구매하실 거라고 한다면은",
                "sound_type": [
                    2
                ],
                "start": 21.561,
                "end": 29.107
            },
            {
                "speaker_id": "1",
                "transcription": "하나는 치즈버거 하나는 불고기버거 하나는 맥너겟 다른 하나는 솔직히 햄버거는 조금 아까운데 치즈버거나 불고기버거 중에 하나 더 해서 메인 세트는 이렇게 정하기로 하고",
                "sound_type": [
                    2
                ],
                "start": 29.117,
                "end": 37.496
            },
            {
                "speaker_id": "1",
                "transcription": "프렌치프라이 스몰이 되거나 아니면 스트링치즈로 바꿀 수 있어요.",
                "sound_type": [
                    2
                ],
                "start": 37.506,
                "end": 40.966
            }
        ]
    },
