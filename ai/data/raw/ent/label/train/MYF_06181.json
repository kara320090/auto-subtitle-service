        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와 예쁘다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.991
            },
            {
                "speaker_id": "1",
                "transcription": "방송에도 나왔었대요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.001,
                "end": 3.294
            },
            {
                "speaker_id": "1",
                "transcription": "보면 비닐을 이제 살살 뜯어보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.304,
                "end": 5.331
            },
            {
                "speaker_id": "1",
                "transcription": "어우 상당해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.341,
                "end": 6.428
            },
            {
                "speaker_id": "1",
                "transcription": "무게감이 자 살살 뜯어야 한단다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.438,
                "end": 13.273
            },
            {
                "speaker_id": "1",
                "transcription": "비닐 속에 붙어있던 빅토르 휘고 형님 나오셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.283,
                "end": 26.188
            },
            {
                "speaker_id": "1",
                "transcription": "어 띠지는 일단 떼고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.198,
                "end": 29.198
            },
            {
                "speaker_id": "1",
                "transcription": "띠지가 사실 이게 참 계륵 같은 게 띠지예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.208,
                "end": 32.927
            },
            {
                "speaker_id": "1",
                "transcription": "막상 중고 서점에 팔려고 보면 또 띠지는 받지도 않더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.937,
                "end": 36.511
            },
            {
                "speaker_id": "1",
                "transcription": "근데 또 없으면서 섭섭하고 잘 빠집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.521,
                "end": 39.869
            },
            {
                "speaker_id": "1",
                "transcription": "쏙 빠지고",
