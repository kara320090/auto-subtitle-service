            },
            {
                "speaker_id": "1",
                "transcription": "레이 밴은 사랑입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.157,
                "end": 11.647
            },
            {
                "speaker_id": "1",
                "transcription": "이제 세차를 마무리하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.657,
                "end": 14.045
            },
            {
                "speaker_id": "1",
                "transcription": "오늘의 아이템을 정리해드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.055,
                "end": 16.784
            },
            {
                "speaker_id": "1",
                "transcription": "프리워시에는 요거 빨간 통 바인더 중성 프리워시고요.",
                "sound_type": [
                    2,
                    3
