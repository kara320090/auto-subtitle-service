        "term": [
            {
                "speaker_id": "1",
                "transcription": "어우 우리 차주 분 땡 잡은 거라구.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.752
            },
            {
                "speaker_id": "1",
                "transcription": "자 우리 차주 분은 직접 했구요.",
                "sound_type": [
                    2
                ],
                "start": 1.762,
                "end": 4.096
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 요 위쪽같은 경우에는 트렁크 커버 요것도 4만 원 주고 튜닝을 한 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 4.106,
                "end": 9.274
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거는 트렁크 커버는 앞에도 했구요, 뒤에도 했어요.",
                "sound_type": [
                    2
                ],
                "start": 9.284,
                "end": 12.650
            },
            {
                "speaker_id": "1",
                "transcription": "뒤는 6만 원 들었대요.",
                "sound_type": [
                    2
                ],
                "start": 12.660,
                "end": 13.607
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 뒤는 더 크니까.",
                "sound_type": [
                    2
                ],
                "start": 13.617,
                "end": 15.223
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 했고 요 뭐야 잠깐만",
                "sound_type": [
                    2
                ],
                "start": 15.233,
                "end": 17.966
            }
        ]
    },
    "summary": "우리 차주 분 땡 잡은 거고 직접 했는데 위쪽 트렁크 커버는 4만 원, 뒤쪽은 6만 원 들었는데 뒤에는 더 크니까 이거 뭐야 잠깐만",
