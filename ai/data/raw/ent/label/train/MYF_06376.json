        "term": [
            {
                "speaker_id": "1",
                "transcription": "밥 지을 때 좀 섞어 가지고 이렇게 먹으면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.940
            },
            {
                "speaker_id": "1",
                "transcription": "여기 뒷면에 보시게 되면은 요런 식으로 되어 있고 자 현미로 도정한 쌀이라고 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.940,
                "end": 8.890
            },
            {
                "speaker_id": "1",
                "transcription": "수증기로 찌고 말려서 현미로 도정한 쌀 올벼 쌀 같은 경우에는 생식, 선식, 밥쌀용으로 사용이 가능하다고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.890,
                "end": 16.350
            },
            {
                "speaker_id": "1",
                "transcription": "생식도 가능하다고 하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.350,
                "end": 18.920
            },
            {
                "speaker_id": "1",
                "transcription": "생식으로 드실 때는 살짝 물을 뿌려 냉장 보관하시면은 더 부드럽고 맛있다고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.920,
                "end": 24.810
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 되어 있고 웅치 벼쌀을 뜯어 가지고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.810,
                "end": 29.500
            }
        ]
    },
    "summary": "웅치 올벼 쌀은 수증기로 찌고 말려서 현미로 도정했기 때문에 생식, 선식, 밥쌀용으로 사용할 수 있고 생식으로 드실 때는 물을 뿌려서 냉장 보관하면 부드럽고 맛있다.",
