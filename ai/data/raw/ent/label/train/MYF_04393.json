        "term": [
            {
                "speaker_id": "1",
                "transcription": "크리스틴 라이제리 조향을 했는데 바닷가에서 만나는 걸을 때 그런 이제 소금이 이제 둥둥 떠다니는 뭔가 소금내가 나는 그런 바닷가, 그 바닷가에서 또 나무가 함께 있을 때 그럴 때 만나는 굉장히 부드러운 그 느낌의 향이 표현된 향수이거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 18.539
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 어떠한 한 가지 향의 계열로 딱 정의하기가 어려워요.",
                "sound_type": [
                    2
                ],
                "start": 18.549,
                "end": 22.179
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 바다를 얘기하지만 사실 이거는 아쿠아 틱 하다고 표현하는 그 아쿠아의 향은 많이 가지고 있지 않아요.",
                "sound_type": [
                    2
                ],
                "start": 22.189,
                "end": 29.363
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그런 향을 좋아하지 않으시는 그런 분들에게는 굉장히 편안하게",
                "sound_type": [
                    2
                ],
                "start": 29.373,
                "end": 35.333
            }
        ]
    },
    "summary": "크리스틴 라이제리는 바닷가에서 나무가 함께 있을 때 만나는 부드러운 느낌의 항수다.",
