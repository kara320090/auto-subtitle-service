                "end": 10.818
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 달달한 양념치킨 맛인데 과하지 않고 답니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.828,
                "end": 15.712
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 단 맛이 과하지가 않고 겉을 또 바삭하게 튀겨서 너무 맛있습니다.",
                "sound_type": [
                    2,
