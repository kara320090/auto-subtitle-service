        "term": [
            {
                "speaker_id": "1",
                "transcription": "단점 분사 형태 특성상 등 같이 손이 안 닿는 부위에는 뿌리기가 어려울 수 있습니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.587
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 약간의 어 요가 비슷한 동작을 해야 된다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.597,
                "end": 13.412
            },
            {
                "speaker_id": "1",
                "transcription": "물론 앞쪽이나 팔 다리에 뿌릴 때는 전혀 이상이 없고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.422,
                "end": 17.244
            },
            {
                "speaker_id": "1",
                "transcription": "등에 혼자 뿌리기는 좀 어렵다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.254,
                "end": 19.568
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 두 번째 지금 이 제품은 용량이 50미리리터 용량이고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.578,
                "end": 25.144
            },
            {
                "speaker_id": "1",
                "transcription": "지금 저 같은 경우에는 이 제품을 머리끝부터 발끝까지 1박2일 낚시에서 계속 뿌려가면서 사용하는 기준으로",
                "sound_type": [
                    2,
