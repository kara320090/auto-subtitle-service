        "term": [
            {
                "speaker_id": "1",
                "transcription": "어이구 가면서도 봄이를 쳐다보고 참아 괜찮아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.421
            },
            {
                "speaker_id": "1",
                "transcription": "가자 참이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.431,
                "end": 6.723
            },
            {
                "speaker_id": "1",
                "transcription": "참아 봄이한테 친구들 거기 화장실 따라 다니지 마 알았어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.733,
                "end": 12.681
            },
            {
                "speaker_id": "1",
                "transcription": "어 봄이 나와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.691,
                "end": 16.087
            },
            {
                "speaker_id": "1",
                "transcription": "봄아 안 돼 화장실에 그렇게 앉아 있으면 안 돼 일어나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.097,
                "end": 20.176
            },
            {
                "speaker_id": "1",
                "transcription": "일어나 봄아 괜찮아 참이 갔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.186,
                "end": 23.505
            },
            {
                "speaker_id": "1",
                "transcription": "어이고 엄마 안아줄게 어이 그렇지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.515,
                "end": 26.322
            },
            {
                "speaker_id": "1",
                "transcription": "참아 참이도 이렇게 비켜 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.332,
                "end": 29.580
            },
            {
                "speaker_id": "1",
                "transcription": "참아 어 참이 이렇게 비켜줘.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.590,
                "end": 32.909
            },
            {
                "speaker_id": "1",
                "transcription": "어 참이 엄마랑 가자 참이 엄마랑 가자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.919,
                "end": 36.803
            }
        ]
    },
    "summary": "여성은 참이에게 화장실을 따라 다니지 말라고 타이르고 있다.",
