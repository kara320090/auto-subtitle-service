                "end": 7.050
            },
            {
                "speaker_id": "1",
                "transcription": "우유와 코코넛과 카라멜이 이렇게 진짜 달달 매끈한 연유를 입안에 한가득 머금음, 그러나 우리는 연유를 먹지 않았다는 거",
                "sound_type": [
                    2
                ],
                "start": 7.060,
                "end": 18.538
            },
            {
