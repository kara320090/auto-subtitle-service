        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "친구야 친구 데려온 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.424
            },
            {
                "speaker_id": "1",
                "transcription": "봄이가 아이구 우리 나물이 배고팠어 어서 먹어.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 3.434,
                "end": 7.623
            },
            {
                "speaker_id": "1",
                "transcription": "나물이는 닭 가슴살 되게 좋아하는구나.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 7.633,
                "end": 11.614
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 저거를 어떻게 먹지 저거를 그렇게 해서 먹는구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.624,
                "end": 19.258
            },
            {
                "speaker_id": "1",
                "transcription": "나물아 너무 예뻐 너 어떻게 몸은 카오스고 얼굴은 삼색이냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.268,
                "end": 27.403
            },
            {
                "speaker_id": "1",
                "transcription": "우리 나물이 나물이 많이 먹어라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.413,
                "end": 33.606
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 7동 갔다 올게 친구랑 먹고 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.616,
                "end": 37.267
            },
            {
                "speaker_id": "1",
                "transcription": "싸우지 말고 알았지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.277,
                "end": 41.809
            },
            {
                "speaker_id": "1",
                "transcription": "나물이 하고 다 같이 있었어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.819,
                "end": 45.879
            }
        ]
    },
    "summary": "여성은 고양이가 밥 먹는 모습을 보며 싸우지 말고 친구들이랑 같이 먹으라고 한다.",
