        "term": [
            {
                "speaker_id": "1",
                "transcription": "@계정1님 계약 들어놓은 게 있어서 보게 되었는데 차분함을 떠나 말씀을 조금만 더 빨리 해 주시면 집중에 도움이 되겠네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.771
            },
            {
                "speaker_id": "1",
                "transcription": "정보는 많이 올려주시면 감사하겠구요.",
                "sound_type": [
                    2
                ],
                "start": 5.781,
                "end": 7.970
            },
            {
                "speaker_id": "1",
                "transcription": "네 지금 말이 많이 빨라졌죠 예전에 비해서. 네.",
                "sound_type": [
                    2
                ],
                "start": 7.980,
                "end": 11.832
            },
            {
                "speaker_id": "1",
                "transcription": "정보는 최대한 많이 올리도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.842,
                "end": 13.884
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 13.891,
                "end": 14.900
            },
            {
                "speaker_id": "1",
                "transcription": "@계정2님 크루즈 여행하시면서 여친 사귀어 보시죠.",
                "sound_type": [
                    2
                ],
                "start": 14.900,
                "end": 18.632
            },
            {
                "speaker_id": "1",
                "transcription": "이 생각이 없진 않았는데 네 이게 뭐 생각대로 되진 않더라구요.",
                "sound_type": [
                    2
                ],
                "start": 18.636,
                "end": 23.740
            },
            {
                "speaker_id": "1",
                "transcription": "여자 혼자 오신 분들도 거의 없고 여자 두 분이서 오신 경우도 거의 없더라구요.",
                "sound_type": [
                    2
                ],
                "start": 23.744,
                "end": 28.488
            },
            {
                "speaker_id": "1",
                "transcription": "네 마음은 먹고 있었는데 생각대로 되지도 않았습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.492,
                "end": 33.103
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 가게 되면 또 시도해 보겠습니다.",
                "sound_type": [
