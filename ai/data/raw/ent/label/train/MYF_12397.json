        "term": [
            {
                "speaker_id": "1",
                "transcription": "낚시를 하고 있는데 안개도 굉장히 많이 끼고 입질도 없었습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.255
            },
            {
                "speaker_id": "1",
                "transcription": "지금 해가 나면서 여기저기서 산발적으로 입질이 들어오기 시작하는데요.",
                "sound_type": [
                    2
                ],
                "start": 4.265,
                "end": 10.200
            },
            {
                "speaker_id": "1",
                "transcription": "바로 앞에 블루길 시체가 있네요.",
                "sound_type": [
                    2
                ],
                "start": 10.210,
                "end": 13.408
            },
            {
                "speaker_id": "1",
                "transcription": "블루길은 있는 것 같고 배스도 아마 있을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 13.418,
                "end": 16.168
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이곳 같은 경우에는 붕어가 한번 나오면 씨알이 굉장히 좋은 녀석이 나온다고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 16.178,
                "end": 20.790
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 방금 나오다 떨어진 붕어는",
                "sound_type": [
                    2
                ],
                "start": 20.800,
                "end": 22.897
            }
        ]
    },
    "summary": "한 남성이 블루길과 배스와 씨알이 큰 붕어가 있는 곳에서 낚시를 하고 있다.",
