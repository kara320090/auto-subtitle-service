    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러니까 쓰고 빨리 제대로 헹구는 신속함과 꼼꼼함이 필요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.149
            },
            {
                "speaker_id": "1",
                "transcription": "알칼리 제품도 마찬가지로요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.159,
                "end": 8.950
            },
            {
                "speaker_id": "1",
                "transcription": "빨리 헹궈야 하는데 대신에 기름이나 찌든 오염 물질을 제거하는데 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 8.960,
                "end": 15.551
            },
            {
                "speaker_id": "1",
                "transcription": "엔진룸이나 타이어에도 알칼리 제품 많이 쓰구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.561,
                "end": 19.364
            },
            {
                "speaker_id": "1",
                "transcription": "특히 산성 알칼리 요런 제품은 전문 샵에서 많이 씁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.374,
                "end": 24.519
            },
            {
                "speaker_id": "1",
                "transcription": "그분들은 숙련됐잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.529,
                "end": 26.855
            },
            {
                "speaker_id": "1",
                "transcription": "손이 빠르잖아요 눈보다 빠른 손 슈슈 샤샤샤샥 아하 하지만 저는 고독한 셀프 세차녀.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.865,
                "end": 35.038
            },
            {
                "speaker_id": "1",
                "transcription": "숙련자가 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.048,
                "end": 37.131
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 중성 제품이 부담 없고 쉽고 편하더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.141,
                "end": 42.362
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 장갑 끼기 귀찮아서라도 중성 제품을 쓰기도 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.372,
                "end": 48.396
            },
            {
                "speaker_id": "1",
                "transcription": "이 분무기 쓰고 있으면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.406,
                "end": 50.962
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 내가 되게 세차 잘하는 짬밥 많이 먹은 느낌 들어서 어 주변을 보기 으쓱해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.972,
                "end": 59.359
            }
        ]
    },
    "summary": "쓰고 나서 빨리 헹구는 신속함과 꼼꼼함이 필요하고 알칼리 제품도 마찬가지지만 기름이나 찌든 오염 물질 제거하기 좋지만 숙련된 전문샵에 많이 쓰고 본인은 숙련자가 아니라며 중성 제품이 부담 없이 편하다고 말한다.",
