        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 압력이 없어질 때까지 나오거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.648
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 들고 스스스슥 뿌리면 되니까 편합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.658,
                "end": 7.592
            },
            {
                "speaker_id": "1",
                "transcription": "프리워시는 정말 세차의 꽃이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.602,
                "end": 11.047
            },
            {
                "speaker_id": "1",
                "transcription": "꼭 해보시라고 권하고 싶습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.057,
                "end": 13.967
            },
            {
                "speaker_id": "1",
                "transcription": "제 기준으로 레이 1대 뿌리는데 물 1리터면 딱이더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.977,
                "end": 18.838
            },
            {
                "speaker_id": "1",
                "transcription": "레이보다 큰 차량이면 양을 쪼금 더 늘리세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.848,
                "end": 23.402
            },
            {
                "speaker_id": "1",
                "transcription": "중형 이상의 세단은 1.5리터쯤 들지 않을까 생각을 해봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.412,
                "end": 28.627
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 잠시 때가 불기를 기다려 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.637,
                "end": 34.868
            }
        ]
    },
    "summary": "압력이 없어질 때까지 나오니 편하고 프리워시는 세차의 꽃이니 해보라고 하며 본인 차 기준 물 1리터면 딱 맞으니 큰 차량이면 양을 늘리라고 말한다.",
