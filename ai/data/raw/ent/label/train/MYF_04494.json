        "term": [
            {
                "speaker_id": "1",
                "transcription": "프레시, 플로럴, 오리엔탈, 우디 여러분이 평상시에 들으셨던 머시 튜러스 워털이 이게 바로 프레시 계열에 들어가는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.081
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 여러분이 향수를 구매하러 가셨을 때 그리고 저도 그렇게 설명하지 않거든요.",
                "sound_type": [
                    2
                ],
                "start": 8.091,
                "end": 13.251
            },
            {
                "speaker_id": "1",
                "transcription": "이 향은 프레시 계열에 시츄어스한 향이에요.",
                "sound_type": [
                    2
                ],
                "start": 13.261,
                "end": 17.197
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이렇게 설명은 하지 않죠.",
                "sound_type": [
                    2
                ],
                "start": 17.207,
                "end": 18.966
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 너무 복잡하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 18.976,
                "end": 20.786
            },
            {
                "speaker_id": "1",
                "transcription": "마이크 에드 워드에 따르면은 프레시 계열은요 또 세 가지로 나뉘어요.",
                "sound_type": [
                    2
                ],
                "start": 20.796,
                "end": 25.400
            }
        ]
    },
    "summary": "향수를 구매 하러 갔을 때 복잡하게 설명하지 않는다 그리고 프레시 계열은 세 가지로 나뉜다고 한다.",
