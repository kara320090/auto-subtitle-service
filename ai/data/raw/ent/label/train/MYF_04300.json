        "term": [
            {
                "speaker_id": "1",
                "transcription": "갖고 싶다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.372
            },
            {
                "speaker_id": "1",
                "transcription": "이제 이런 이야기를 하는 데 그냥 내가 만들어서 내가 입는 향이에요.",
                "sound_type": [
                    2
                ],
                "start": 0.382,
                "end": 3.802
            },
            {
                "speaker_id": "1",
                "transcription": "이제 이런 이야기를 했는데 그레이스 켈리와 굉장히 친하셨다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 3.812,
                "end": 7.676
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그레이스 켈리한테 이제 그향을 선물을 해줬는데 가면무도회에서 이렇게 얼굴 가리고 이제 가면무도회에 갔는데 그 향으로 어 그레이스 켈리?",
                "sound_type": [
                    2
                ],
                "start": 7.686,
                "end": 16.797
            },
            {
                "speaker_id": "1",
                "transcription": "에스티로더?",
                "sound_type": [
                    2
                ],
                "start": 16.807,
                "end": 17.899
            },
            {
                "speaker_id": "1",
                "transcription": "이제 두 분이서 이렇게 알아봤다는 뭐 그런 일화도 있어요.",
                "sound_type": [
                    2
                ],
                "start": 17.909,
                "end": 21.071
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로 에스티로더의 향 라인도 굉장히 기분을 좋게 해주는 아주 상큼하고 기분 좋은 플로럴 한 이런 향들이 많이 존재하거든요.",
                "sound_type": [
                    2
                ],
                "start": 21.081,
                "end": 30.333
            },
            {
                "speaker_id": "1",
                "transcription": "제가 또 에스티로더의 향도 리뷰를 하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.343,
                "end": 34.200
            }
        ]
    },
    "summary": "에스티 로더가 그레이스 켈리와 친해서 향을 선물을 해줬는데 가면무도회에서 향으로 서로를 알아봤다는 일화도 있고 에스티로더의 향은 상큼하고 기분 좋은 플로럴 한 향들이 많이 존재하므로 다음에 에스티로더의 향도 리뷰를 하도록 하겠습니다.",
