        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 스냅 비용은 들어가지 않았고 대신에 본식 DVD는 따로 업체를 구했었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.538
            },
            {
                "speaker_id": "1",
                "transcription": "본식 DVD는 35만 원이 들었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.548,
                "end": 7.202
            },
            {
                "speaker_id": "1",
                "transcription": "1인 2 카메라",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.212,
                "end": 8.734
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이것도 되게 저렴하게 한 거더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.744,
                "end": 11.259
            },
            {
                "speaker_id": "1",
                "transcription": "나는 저렴하게 하려고 한 게 아니었는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.269,
                "end": 13.560
            },
            {
                "speaker_id": "1",
                "transcription": "나는 그냥 마음에 드는 걸 골랐는데 그렇게 비싼 게 아니었던 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.570,
                "end": 18.570
            },
            {
                "speaker_id": "1",
                "transcription": "제가 찾아보니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.580,
                "end": 19.858
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 부케랑 코사지 제 부케는 14만 원이었고 그리고 코사지 그 양가 부모님들과 사회자 가슴에 꽂는 꽃이요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.868,
                "end": 29.107
            },
            {
                "speaker_id": "1",
                "transcription": "그거를 조금 업그레이드 해 가지고 5000원씩 추가 비용이 붙어서 부캐랑 코사지는 총 16만 5000원이 들었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.117,
                "end": 36.895
            },
            {
                "speaker_id": "1",
                "transcription": "부캐가 가격대 별로 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.905,
                "end": 38.974
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 10만 원대 20만 원대 30만 원대 이렇게 있는데 저는 딱히 부캐에 그렇게 막 큰 비용을 들이고 싶진 않더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.984,
                "end": 47.040
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그냥 10만 원대에서 예쁜 걸로 골랐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.050,
                "end": 50.467
            }
        ]
    },
    "summary": "발화자는 본식 DVD에 35만 원 그리고 부케와 코사지에 16만 5000원이 들었다고 합니다.",
