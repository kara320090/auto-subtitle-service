        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "요즘에 풀 할부를 당긴다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.588
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 인생 난이도를",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.598,
                "end": 5.234
            },
            {
                "speaker_id": "1",
                "transcription": "구독자 차량 고민 10번째 영상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.244,
                "end": 7.041
            },
            {
                "speaker_id": "1",
                "transcription": "일단 유튜브 닉네임 성미니 님 보내주셔서 감사드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.051,
                "end": 10.303
            },
            {
                "speaker_id": "1",
                "transcription": "나이는 23살 실수령액이 평균 190 플러스 알파.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.313,
                "end": 14.278
            },
            {
                "speaker_id": "1",
                "transcription": "프리랜서라서 매달 달라요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.288,
                "end": 15.795
            },
            {
                "speaker_id": "1",
                "transcription": "프리랜서분들은 다 아시겠지만 매달 수입이 다르죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.805,
                "end": 18.822
            },
            {
                "speaker_id": "1",
                "transcription": "고정비는 100입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.832,
                "end": 20.137
            },
            {
                "speaker_id": "1",
                "transcription": "고정비가 좀 세긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.147,
                "end": 21.687
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 좀 특이하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.697,
                "end": 22.986
            },
            {
                "speaker_id": "1",
                "transcription": "대학교를 다니면서 일도 같이 하고 돈도 벌고 있고 이 정도면 훌륭한 분이지 뭐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.996,
                "end": 27.594
            }
        ]
    },
