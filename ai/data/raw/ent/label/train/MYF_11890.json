        "term": [
            {
                "speaker_id": "1",
                "transcription": "노트의 구성에 따라서도 오드 퍼퓸이어도 지속력이 짧을 수 있다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.808
            },
            {
                "speaker_id": "1",
                "transcription": "그거를 알아주면 될 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 5.818,
                "end": 8.185
            },
            {
                "speaker_id": "1",
                "transcription": "물론 정말 향을 좋아하시는 분들은 추적을 다 하시니까 정말 여덟 시간 지나도 그 향의 잔재들을 다 느끼세요.",
                "sound_type": [
                    2
                ],
                "start": 8.195,
                "end": 14.987
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 분명히 존재는 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 14.985,
                "end": 16.593
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 느끼실 수 있어요.",
                "sound_type": [
                    2
                ],
                "start": 16.603,
                "end": 17.724
            },
            {
                "speaker_id": "1",
                "transcription": "그게 오드 퍼퓸의 매력이긴 한데 근데 이제 지속력을 좋아하시면서 플로럴 꽃에서 근데 이제 머리 아프게 하는 그런 그 짙은 플로럴들 좀 배제를 하다가 보니 제가 봤을 때",
                "sound_type": [
                    2
                ],
                "start": 17.734,
                "end": 32.435
            }
        ]
    },
    "summary": "40대 여성이 오드 퍼퓸이라도 향을 좋아하는 사람들은 그 잔향까지 다 맡기 때문에 매력이 있다고 설명하고 있다.",
