        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요 여러분 새 학기 적응은 잘하고 계신가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.700
            },
            {
                "speaker_id": "1",
                "transcription": "설레고 새로우면서도 또 마음 한켠에는 두려운 마음도 있을 것 같은데 잘 적응할 수 있기를 제가 응원하고 있겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.135,
                "end": 12.997
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이 영상은 저의 가벼운 근황을 알리기 위한 영상인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.500,
                "end": 18.125
            },
            {
                "speaker_id": "1",
                "transcription": "제가 약 2주 정도를 호주를 갔다 왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.532,
                "end": 21.440
            },
            {
                "speaker_id": "1",
                "transcription": "항상 좀 바빴는데 이번 여행을 통해서 많이 충전을 할 수 있었어서 정말 좋은 여행이었어요.",
                "sound_type": [
