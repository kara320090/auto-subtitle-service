        "term": [
            {
                "speaker_id": "1",
                "transcription": "참고로 제 블로그는 이제 1년 정도 운영을 했는데 1년 좀 넘었죠?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.919
            },
            {
                "speaker_id": "1",
                "transcription": "어 하루 방문자 수가 300명, 500명 네 이웃 수는 한 1400명? 1500명 좀 안되고요.",
                "sound_type": [
                    2
                ],
                "start": 3.929,
                "end": 10.798
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 그저 그런 블로그입니다.",
                "sound_type": [
                    2
                ],
                "start": 10.808,
                "end": 12.854
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뭐 블로그 올려도 그렇게 초반에는 음 조회수가 많이 올라가진 않았고요.",
                "sound_type": [
                    2
                ],
                "start": 12.864,
                "end": 20.176
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 유튜브도 당연히 그럴 거다라고 생각 했어요.",
                "sound_type": [
                    2
                ],
                "start": 20.186,
                "end": 23.108
            },
            {
                "speaker_id": "1",
                "transcription": "그래서",
