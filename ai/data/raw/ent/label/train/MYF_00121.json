        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "준비를 해왔지.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.976
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 어 고민을 해봤어요.",
                "sound_type": [
                    2
                ],
                "start": 0.986,
                "end": 3.713
            },
            {
                "speaker_id": "1",
                "transcription": "500만 원 주고 산 @이름 1 벌써 얘한테 수리비와 유지비로 500이 뭐야 차 값의 한 2배 들었거든요?",
                "sound_type": [
                    2
                ],
                "start": 3.723,
                "end": 11.647
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 더 이상 돈을 쓸 수는 없다.",
                "sound_type": [
                    2
                ],
                "start": 11.657,
                "end": 14.057
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 어떻게 할 것이냐?",
                "sound_type": [
                    2
                ],
                "start": 14.067,
                "end": 15.487
            },
            {
                "speaker_id": "1",
                "transcription": "선풍기를 달려고요.",
                "sound_type": [
                    2
                ],
                "start": 15.497,
                "end": 17.924
            },
            {
                "speaker_id": "1",
                "transcription": "아니 에어컨이 고장 나면 선풍기 틀면 되지 뭐라고 예전 우리 할머니께서 말씀하셨지.",
                "sound_type": [
                    2
                ],
                "start": 17.934,
                "end": 23.015
            },
            {
                "speaker_id": "1",
                "transcription": "정말 할머니 말은 하나도 틀린 게 없어.",
                "sound_type": [
                    2
                ],
                "start": 23.025,
                "end": 25.376
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 어디다 달아야 잘 달았다고 소문이 나지?",
                "sound_type": [
                    2
                ],
                "start": 25.386,
                "end": 29.246
            },
            {
                "speaker_id": "1",
                "transcription": "어이 얻다 달아야 전방을 해치지 않으 어 여기다.",
                "sound_type": [
                    2
                ],
                "start": 29.256,
                "end": 34.423
            },
            {
                "speaker_id": "1",
                "transcription": "여기 어때요 여러분?",
                "sound_type": [
                    2
                ],
                "start": 34.433,
                "end": 36.536
            }
        ]
    },
    "summary": "여성이 자동차 내부 전면에 선풍기를 설치하고 있다.",
