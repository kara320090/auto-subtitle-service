        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 첫사랑 맥주 같은 경우에 그 그레이트 프루트 시트러스한 탑 노트가 진짜 펑펑펑펑 이렇게 튀어오르거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.159
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아 맥주도 이렇게 향기롭게 정말 즐겁게 나올 수 있구나.",
                "sound_type": [
                    2
                ],
                "start": 8.169,
                "end": 13.805
            },
            {
                "speaker_id": "1",
                "transcription": "어 위드팬 님, 좋은 정보 감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 13.815,
                "end": 17.410
            },
            {
                "speaker_id": "1",
                "transcription": "네, 고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.420,
                "end": 18.611
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 님, 술 자주 하시나요?",
