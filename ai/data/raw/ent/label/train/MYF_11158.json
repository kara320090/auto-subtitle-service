        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "역시나 안 닫히죠 그냥?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.000
            },
            {
                "speaker_id": "1",
                "transcription": "살짝해서 문 닫히기 직전에 예 살짝만 눌러주면 바로 닫혀요 전혀 지장은 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.000,
                "end": 17.430
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 우리가 캠핑에 차박을 다니면서도 이거 절대 뜰 일이 없다는 거죠 한마디로.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.440,
                "end": 22.567
            },
            {
                "speaker_id": "1",
                "transcription": "이거 붙여 놓고 가져가면 내리기만 하면 돼요 얼마나 편해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.577,
                "end": 25.601
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 편하게 잘 만들었네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.611,
                "end": 27.261
            },
            {
                "speaker_id": "1",
                "transcription": "아 저도 이제 목요일날 이것 저것 써봤는데 다 하나같이 좀 잘 떨어지는 게 문제였어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.271,
                "end": 32.999
            },
            {
                "speaker_id": "1",
                "transcription": "끼워놓고 총간창만 빠지는 게 가장 큰 문제였는데 이거는 그럴 일이 아예 없다는 거 너무 좋네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.009,
                "end": 39.303
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 한 가지 아쉬운 점은 스킨이 없잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.313,
                "end": 42.270
            },
            {
                "speaker_id": "1",
                "transcription": "밤에 잘 때는 별도의 스킨이 또 한 겹 더 있으면은 바로 그냥 그 스킨만 내려주면 되는데 요거 같은 경우는 고게 없는 게 하나 좀 아쉽긴 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.280,
                "end": 51.024
            },
            {
                "speaker_id": "1",
                "transcription": "추후에 또 업그레이드될 수 있을지 모르겠지만 그 일단 뭐 저는 이제 커튼이 있으니까 요 뒤 안 쪽에 다가 커튼을 하나 달아놓고 밤에 잘 때는 뭐 커튼을 치면은 큰 문제가 없을 것 같은데 그 스킨까지 어떻게 딱 달려가지고 같이 있었으면 훨씬 더 좋았을 것 같은 그런 생각은 들기는 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.034,
                "end": 67.475
            },
            {
                "speaker_id": "1",
                "transcription": "예 아무튼 이 우레탄창하고 모기장 자체는 정말 퀄리티 좋고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.485,
                "end": 73.506
            }
        ]
    },
    "summary": "모기장과 우레탄창을 붙여 놓고 가지고 다니면서 내리기만 하면 되니 엄청 편하다며 이것저것 써본 결과 다른 것들은 하나같이 잘 떨어졌고 이 모기장과 우레탄창은 그럴 일이 없어서 좋지만 아쉬운 점은 별도의 스킨이 없어 아쉽다고 한다.",
