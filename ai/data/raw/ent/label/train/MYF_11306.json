                    2,
                    3
                ],
                "start": 23.988,
                "end": 26.385
            },
            {
                "speaker_id": "1",
                "transcription": "좀 미니미니하게 제가 좀 준비를 해야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.395,
                "end": 30.032
            },
            {
                "speaker_id": "1",
                "transcription": "곧 아시게 되시겠지만 아무튼 그런 게 있습니다.",
