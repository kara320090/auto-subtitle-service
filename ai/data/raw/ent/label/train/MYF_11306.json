        "term": [
            {
                "speaker_id": "1",
                "transcription": "거꾸로 넣어야 되는데 이렇게 하면?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.509
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 이거를 뒤집어놔야겠는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.519,
                "end": 4.972
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 놔야 되지 않을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.982,
                "end": 8.392
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해놔야 안 들어가네.",
                "sound_type": [
