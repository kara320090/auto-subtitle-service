        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.726
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.736,
                "end": 1.697
            },
            {
                "speaker_id": "1",
                "transcription": "저희 가족은 요즘에 그린 요거트를 집에서 만들어 먹고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 1.707,
                "end": 5.297
            },
            {
                "speaker_id": "1",
                "transcription": "사실 그린 요거트 사 먹으면 너무 비싸잖아요.",
                "sound_type": [
                    2
                ],
                "start": 5.297,
                "end": 8.101
            },
            {
                "speaker_id": "1",
                "transcription": "근데 집에서 먹으면 훨씬 저렴하게 만들 수 있고 만드는 방법도 굉장히 간단하더라요.",
                "sound_type": [
                    2
                ],
                "start": 8.111,
                "end": 13.116
            },
            {
                "speaker_id": "1",
                "transcription": "요게 집에서 만든 그릭요거트예요.",
                "sound_type": [
                    2
                ],
                "start": 13.126,
                "end": 15.389
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 꾸덕꾸덕하게 잘 됐죠?",
                "sound_type": [
                    2
                ],
                "start": 15.399,
                "end": 17.650
            },
            {
                "speaker_id": "1",
                "transcription": "준비물은 요 유청 분리기 저희 집은 여 서울 우유 플레인 요거트를 쓰고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 17.660,
                "end": 23.588
            },
            {
                "speaker_id": "1",
                "transcription": "사실 면 보를 이용해서 유청을 분리하시는 분들도 많은데 그렇게 하면 좀 위생적으로 안 좋다고 하더라고요.",
                "sound_type": [
                    2
                ],
                "start": 23.598,
                "end": 29.914
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 어차피 거의 매일 해 먹다 싶으니까 저희는 그냥 유청 분리기를 샀습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.924,
                "end": 34.434
            },
            {
                "speaker_id": "1",
                "transcription": "저희는 처음에 쿠팡에서 클래파 유청 분리기를 구매했었어요.",
                "sound_type": [
                    2
                ],
                "start": 34.444,
                "end": 37.872
            },
            {
                "speaker_id": "1",
                "transcription": "클래파 유청 분리기는 따로 요거트 볼이랑 요거트 스푼도 줘서 좀 구성이 더 알차더라고요.",
                "sound_type": [
                    2
                ],
                "start": 37.882,
                "end": 43.518
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 요 베어 그릭스로 다시 구매한 이유는 요 스프링 때문인데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.528,
                "end": 47.354
            },
            {
                "speaker_id": "1",
                "transcription": "스프링을 이용해서 유청을 더 많이 빼낼 수 있어서 더 꾸덕한 요거트를 만들 수 있다고 하더라고요.",
                "sound_type": [
                    2
                ],
                "start": 47.364,
                "end": 52.565
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 베어 그릭스로 새롭게 구매해 봤는데 사용 방법은 엄청 간단해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.575,
                "end": 56.919
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 필터망이 또 서울 우유 플레인 요거트를 그냥 여기 담아 주기만 하면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.929,
                "end": 63.533
            }
        ]
    },
    "summary": "여자는 매일 그릭 요거트를 해 먹기 때문에 쿠팡에서 클래파 유청 분리기가 구성이 더 알차서 구매했는데 스프링을 이용해서 더 꾸덕한 요거트를 만들 수 있다고 하여 베어 그릭스 유청 분리기를 구매했다.",
