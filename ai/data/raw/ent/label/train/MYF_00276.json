        "term": [
            {
                "speaker_id": "1",
                "transcription": "금요일과 토요일에는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.941
            },
            {
                "speaker_id": "1",
                "transcription": "어, 밤 넘어서 새벽까지 심야 영업을 할 예정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.951,
                "end": 8.055
            },
            {
                "speaker_id": "1",
                "transcription": "라면도 심야 영업할 때는 판매를 할 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.065,
                "end": 12.130
            },
            {
                "speaker_id": "1",
                "transcription": "어, 토요일 금요일에 늦게까지 노시는 분들 심야 영업한다는 거 기억해 주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.140,
                "end": 18.300
            },
            {
                "speaker_id": "1",
                "transcription": "어, 저는 이제 좀 바빠요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.310,
                "end": 20.135
            },
            {
                "speaker_id": "1",
                "transcription": "이게 어, 어, 인테리어만 하면 되는 줄 알았는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.145,
                "end": 24.938
            },
            {
                "speaker_id": "1",
                "transcription": "메뉴도 정해야 되잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.948,
                "end": 27.100
            },
            {
                "speaker_id": "1",
                "transcription": "메뉴 고르러 가시죠, 뿅.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.110,
                "end": 29.859
            },
