                    2,
                    3
                ],
                "start": 2.690,
                "end": 3.437
            },
            {
                "speaker_id": "1",
                "transcription": "그래 개지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.447,
                "end": 4.165
            },
            {
                "speaker_id": "1",
                "transcription": "우리 아들 말고 개들 아들도 물론 사랑하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.175,
                "end": 6.664
            },
            {
                "speaker_id": "1",
                "transcription": "우리 개들이 가서 빨리 산책시켜줘야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.674,
                "end": 9.120
            },
            {
                "speaker_id": "1",
                "transcription": "우리 아들 하고 또 행복한 시간 보내야지.",
                "sound_type": [
