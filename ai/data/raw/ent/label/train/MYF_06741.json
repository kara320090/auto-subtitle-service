                "start": 0.000,
                "end": 0.625
            },
            {
                "speaker_id": "1",
                "transcription": "내가 세상에서 가장 사랑하는 존재가 누구야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.635,
                "end": 2.680
            },
            {
                "speaker_id": "2",
                "transcription": "쿠키 우리 개들",
