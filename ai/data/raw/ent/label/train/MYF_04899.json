        "term": [
            {
                "speaker_id": "1",
                "transcription": "향이 이렇게 여름인데 살랑살랑 저한테 오는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.246
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 눈을 뜨고 이렇게 딱 봤더니 남자분이세요.",
                "sound_type": [
                    2
                ],
                "start": 4.256,
                "end": 8.634
            },
            {
                "speaker_id": "1",
                "transcription": "향이 너무 좋으시다.",
