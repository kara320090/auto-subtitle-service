                    2
                ],
                "start": 29.080,
                "end": 32.519
            },
            {
                "speaker_id": "1",
                "transcription": "마음껏 입고 다니세요.",
                "sound_type": [
                    2
                ],
                "start": 32.529,
                "end": 34.607
            },
            {
                "speaker_id": "1",
                "transcription": "이런 질문은 한국만이 아니라 미국에서도 등장을 해, 재스민 오렌지 블라썸 로즈 이런 꽃들은요.",
                "sound_type": [
                    2
                ],
                "start": 34.617,
                "end": 41.250
            },
            {
                "speaker_id": "1",
                "transcription": "향수에서 오랫동안 사랑받았던 원료들 이예요.",
                "sound_type": [
                    2
                ],
                "start": 41.260,
                "end": 44.938
            },
            {
                "speaker_id": "1",
                "transcription": "우리가 알고 있는 유명한 프랑스의 왕들이나 이런 사람들은 그런 향이 들어 간 향수를 많이 입었다는 거거든요.",
                "sound_type": [
                    2
                ],
                "start": 44.948,
                "end": 52.385
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 남자들이 꽃 향을 입는 거는 안 된다 뭐 이런 거는 사실은 아주 긴 시간 동안은 그런 일이 별로 없었고요.",
                "sound_type": [
                    2
                ],
                "start": 52.395,
                "end": 61.552
            },
            {
                "speaker_id": "1",
                "transcription": "20세기에 와서 그나마 대중화가 된 케이스거든요.",
                "sound_type": [
                    2
                ],
                "start": 61.562,
                "end": 66.210
            },
            {
                "speaker_id": "1",
                "transcription": "사실 그전까지만 해도요.",
                "sound_type": [
                    2
                ],
                "start": 66.220,
                "end": 68.288
            },
            {
                "speaker_id": "1",
                "transcription": "향수는 정말 뭐 왕가에서 전속 조향사가 계신다든지 뭐 이런 아니면 귀족들이 가는 조향사가 있어서 정말 모든 향을 다 맡아보고 그 향에 대해서 내가 좋은 향을 만나고 선택하고 이렇게 구매 과정이 이루어지다가 제조 산업이 이제 시작이 되고 하면서 향수가 병안에 그냥 담겨져 가지고 그래서 그냥 판매가 되어버리고 종류도 엄청나게 이제 많아지고 그리고 이제 대중들의 입장에서도 어, 향수를 사러 갔는데 뭘 사야 될지 이제 모르겠고 그런 수많은 수요를 1 대 1로 맞춤을 할 수는 없고 그러다 보니 향수를 남자 향수 여자 향수 이렇게 나누기 시작을 해요.",
                "sound_type": [
                    2
                ],
                "start": 68.298,
                "end": 110.774
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 그러면 좀 간편하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 110.784,
                "end": 113.067
            },
            {
                "speaker_id": "1",
                "transcription": "미국의 백화점에 1층에 향수 종류만 뭐 2000가지 정도가 있다 라고 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 113.077,
                "end": 117.970
            },
            {
                "speaker_id": "1",
                "transcription": "기본적으로 향수는 남자 여자 따로 없어요.",
                "sound_type": [
                    2
                ],
                "start": 117.980,
                "end": 121.074
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 향이 내가 좋으면 내가 좋으면 그게 내 향수인 거예요.",
                "sound_type": [
                    2
                ],
                "start": 121.084,
                "end": 125.812
            },
            {
                "speaker_id": "1",
                "transcription": "레더, 패출리, 토바코, 뭐 머스크 막 이런 것들이 진하고 묵직하게 들어가 있는 그 향수 그냥 뿌리면 뭐 나 남자야 막 이렇게 얘기하는 것 같은 아주 전통적인 그런 남자의 향수들, 들어가 있는 게 남자들 이 입어야 하는 향수야 이런 게 좀 더 선입견이 생겼고 그런 남자분들 자라는 시기에는 여자분들은 특히나 인제 우릴 기분 좋게 만들어 주는 꽃 향 로즈 재스민 오렌지 블라썸 가드니아 뭐 이런 꽃들 이 주제가 되어서 활동한 향수들을 많이 입은 거예요.",
                "sound_type": [
                    2
                ],
                "start": 125.822,
                "end": 161.555
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니까 엄마의 화장대에서 그런 향이 났고 그런 향은 인제 엄마 아니면 여자친구 그거는 여자가 입는 거야 이런 생각들이 인제 많이 지배적인 하지만 최근에는 정말 성별을 이렇게 구별지어서 소통하지 않는 니치 향수 브랜드 들도, 소비자분들도 좀 더 내가 좋아하는 향을 만나서 내가 좋아하는 향을 사서 내가 뿌리겠다 입겠다 이런 분들이 좀 늘어나다 보니까요.",
                "sound_type": [
                    2
                ],
                "start": 161.565,
                "end": 193.612
            },
            {
                "speaker_id": "1",
                "transcription": "그런 경계가 좀 많이 무너졌어요.",
                "sound_type": [
                    2
                ],
                "start": 193.622,
                "end": 196.099
            },
            {
                "speaker_id": "1",
                "transcription": "저의 남사친 중에 한 명이 아티스트인데 그는 조 말론의 레드 로즈라는 로즈 향이 아주 상큼상큼 발랄하게 등장하는 그 향수를 입어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 196.109,
                "end": 210.261
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뭐 운 좋게 저희가 어떤 뭐 패션 브랜드나 이런 그 향수를 입고 등장하는 남자애가 어, 걔밖에 없다 보니 정말로 향수로 그의 등장을 네, 어디선가 갑자기 장미 향이 이렇게 바람을 타고 저한테 싹 오면 아, 도착했구나 제가 그렇게 알게 되거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 210.271,
                "end": 231.931
            },
            {
                "speaker_id": "1",
                "transcription": "저는 인제 대중교통을 이용하는데요.",
