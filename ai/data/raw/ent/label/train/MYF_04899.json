                    2,
                    5
                ],
                "start": 8.644,
                "end": 14.288
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하세요? 향수읽어주는 여자 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 14.298,
                "end": 18.294
            },
            {
                "speaker_id": "1",
                "transcription": "이런 질문들을 제가 블로그와 인스타그램 그리고 유튜브 댓글을 통해서도 받았는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.304,
                "end": 24.517
            },
            {
                "speaker_id": "1",
                "transcription": "저의 대답부터 말씀드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 24.527,
                "end": 26.295
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 입으셔도 되세요.",
