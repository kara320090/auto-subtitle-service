                    2
                ],
                "start": 234.646,
                "end": 239.390
            },
            {
                "speaker_id": "1",
                "transcription": "앉아서 당연히 저는 눈 감고 이렇게 네, 멍을 때리고 있었는데요.",
                "sound_type": [
                    2
                ],
                "start": 239.400,
                "end": 244.031
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제 옆에 있던 사람이 바뀌는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 244.041,
                "end": 247.421
            },
            {
                "speaker_id": "1",
                "transcription": "바뀌면서 등장하는 그 매끄러운 꽃의 향이 튜베로즈 향이 이렇게 여름인데 살랑살랑 저한테 오는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 247.431,
                "end": 258.239
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 눈을 뜨고 이렇게 딱 봤더니 남자분이세요.",
