        "term": [
            {
                "speaker_id": "1",
                "transcription": "그전에는 이렇게 많이 낳은 적이 없거든요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.506
            },
            {
                "speaker_id": "2",
                "transcription": "아 얘가 출산을 몇 번 했군요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.516,
                "end": 4.551
            },
            {
                "speaker_id": "1",
                "transcription": "네 네. 제가 본 것만 한 2번 정도 되는 거 같아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.561,
                "end": 7.334
            },
            {
                "speaker_id": "3",
                "transcription": "왜 새끼 놔두고 갔어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.344,
                "end": 8.840
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까 새끼를 왜 놔두고 갔을까요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.850,
                "end": 11.254
            },
            {
                "speaker_id": "1",
                "transcription": "어 일어나면 안 돼 일어나면 안 돼.",
                "sound_type": [
                    2
                ],
                "start": 11.264,
                "end": 12.774
            },
            {
                "speaker_id": "2",
                "transcription": "젖 좀 맥여라 젖 좀 줘.",
                "sound_type": [
                    2
                ],
                "start": 12.784,
                "end": 14.368
            },
            {
                "speaker_id": "1",
                "transcription": "조금만 주고",
                "sound_type": [
                    2
                ],
                "start": 14.368,
                "end": 15.135
            },
            {
                "speaker_id": "2",
