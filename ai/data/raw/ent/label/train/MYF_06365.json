        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 그게 신기해서 제가 영상으로 다시 한번 육즙 보여 드리겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.380
            },
            {
                "speaker_id": "1",
                "transcription": "나오는 육즙이 거의 3분의 일이 만두 안에 저렇게 꽉 차 있죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.380,
                "end": 12.590
            },
            {
                "speaker_id": "1",
                "transcription": "에 어 방법을 참 알고 싶은데 그래서 뭐 팍팍하다거나 느끼하다거나 뭐 이런 점이 있을 것 같은데 불구하고 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.590,
                "end": 23.610
            },
            {
                "speaker_id": "1",
                "transcription": "한입에 쏙 들어갑니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.610,
                "end": 25.560
            },
            {
                "speaker_id": "1",
                "transcription": "육즙이 줄줄줄줄 흘러나오니까 어 얌전 빼고 점잖은 자리에서 먹기는 힘든 음식입니다.",
                "sound_type": [
                    2
                ],
                "start": 25.560,
                "end": 33.270
            },
            {
                "speaker_id": "1",
                "transcription": "어떠셨습니까?",
                "sound_type": [
                    2
                ],
                "start": 33.270,
                "end": 34.810
            },
            {
                "speaker_id": "1",
                "transcription": "저만 혼자 먹고 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.810,
                "end": 36.160
            },
            {
                "speaker_id": "1",
                "transcription": "죄송합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.160,
                "end": 37.600
            },
            {
                "speaker_id": "1",
                "transcription": "시청해 주신 여러분께 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.600,
                "end": 39.570
            },
            {
