                    2,
                    3
                ],
                "start": 11.297,
                "end": 13.407
            },
            {
                "speaker_id": "2",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.417,
                "end": 15.457
            },
            {
                "speaker_id": "3",
                "transcription": "그거를 지금부터 미션 자체를 아 처음부터 촬영을 하는 거야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.467,
                "end": 20.557
            },
            {
                "speaker_id": "3",
                "transcription": "여기서부터 자 그러면 2시간 안에 알아서 촬영 해오기 그래 가지고 여기서 인제 알아서 인제 했다가 부탁한 다음에 그리고 마지막에 조회수 경쟁",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.567,
                "end": 36.215
            },
            {
                "speaker_id": "4",
                "transcription": "그거는 너무 경쟁인데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.225,
                "end": 38.912
            },
            {
                "speaker_id": "5",
                "transcription": "동의하셔서 웃으신거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.922,
                "end": 41.627
            },
            {
                "speaker_id": "3",
                "transcription": "그쵸? 동의하시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.637,
                "end": 42.949
            },
            {
                "speaker_id": "4",
                "transcription": "여기 나이대면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.959,
                "end": 44.782
            },
            {
                "speaker_id": "5",
                "transcription": "엠티 가면 다 하잖아요.",
