        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 일단 하루에 1개씩 콘텐츠 올리고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.121
            },
            {
                "speaker_id": "1",
                "transcription": "책의 내용에 충실하게 책의 내용을 설명해 주고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.131,
                "end": 5.796
            },
            {
                "speaker_id": "2",
                "transcription": "그 옆에 계신 @계정명1 자기 소개 좀 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.806,
                "end": 11.287
            },
            {
                "speaker_id": "3",
                "transcription": "자기소개?",
