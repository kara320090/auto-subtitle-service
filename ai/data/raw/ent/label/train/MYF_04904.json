        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "가드니아를 좋아하는 분들 가드니아는요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.735
            },
            {
                "speaker_id": "1",
                "transcription": "미국에서 개발된 장미 품종이에요.",
                "sound_type": [
                    2
                ],
                "start": 2.745,
                "end": 4.859
            },
            {
                "speaker_id": "1",
                "transcription": "장미와는 다른 향을 가지고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 4.859,
                "end": 6.800
            },
            {
                "speaker_id": "1",
                "transcription": "이 가드니아 향을 좋아하는 분들은 안정적인 것을 좋아하는 분들이라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 6.817,
                "end": 11.540
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 시트러스 향을 좋아하는 분들이 타고난 리더로 무언가 의견을 이끌고 이렇게 날 때 가드니아 분들은 그걸 따라가시는 분들, 서포트해 주시고 그런 분들, 예측 불가능한 것보다는 예측 가능한 거 더 좋아하시고 그리고 친구들 사귀더라도 오랜 시간 동안 사귀는 분들, 장거리 연애가 가능하신 분들, 항상 한결같고 그 자리에 있는 분들, 아주 오랜만에 연락을 해도 반갑게 받아주는 이런 분들이 가드니아 향을 좋아하는 분들이라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 11.550,
                "end": 44.063
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 향수와 성격에 대해 말씀드렸는데요.",
                "sound_type": [
                    2
                ],
                "start": 44.073,
                "end": 47.810
            },
            {
                "speaker_id": "1",
                "transcription": "만 8631명을 대상으로 한 이 연구는 미국에서 진행된 연구예요.",
                "sound_type": [
                    2
                ],
                "start": 47.820,
                "end": 52.782
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 사실 우리에게 맞는지 한국 사람들에게 맞는지는 이제부터 우리가 찾아나가야 되지 않을까 이런 생각을 해요.",
                "sound_type": [
                    2
                ],
                "start": 52.792,
                "end": 61.301
            },
            {
                "speaker_id": "1",
                "transcription": "이번 영상을 보시고서 어 나는 좀 그런 거는 같아요.",
                "sound_type": [
                    2
                ],
                "start": 61.311,
                "end": 65.169
            },
            {
                "speaker_id": "1",
                "transcription": "어, 맞아요 저 진짜 바닐라 엠버 바닐라 정말 자주 입고 다니는데 저 진짜 사람들이 저 보고 항상 같이 있으면 기운 난다고 그러고 되게 좋아해 주시더라고요.",
                "sound_type": [
                    2
                ],
                "start": 65.179,
                "end": 74.421
            },
            {
                "speaker_id": "1",
                "transcription": "이번 영상을 보시고 이게 뭔가 본인하고 연결되는 스토리가 있다 그러시다면 댓글 언제든지 남겨주세요.",
                "sound_type": [
                    2
                ],
                "start": 74.431,
                "end": 81.738
            },
            {
                "speaker_id": "1",
                "transcription": "여러분의 좋아요와 구독은 영상을 만드는 데 큰 힘이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 81.748,
                "end": 85.530
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 향수 읽어주는 여자 @이름1였습니다.",
                "sound_type": [
                    2
                ],
                "start": 85.539,
                "end": 88.820
            },
            {
                "speaker_id": "1",
                "transcription": "고맙습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 88.820,
                "end": 91.200
            }
        ]
    },
