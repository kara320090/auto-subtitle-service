        "term": [
            {
                "speaker_id": "1",
                "transcription": "유채를 미워하는 꾸미 그런 꾸미를 증오하는 유채 유채와 꾸미는 그 이후 어떻게 되었을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.576
            },
            {
                "speaker_id": "1",
                "transcription": "계속 꾸미는 유채를 미워하는 걸까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.586,
                "end": 12.897
            },
            {
                "speaker_id": "1",
                "transcription": "오늘의 이야기 한번 보시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.907,
                "end": 16.570
            },
            {
                "speaker_id": "1",
                "transcription": "저 꼬리가 우리 꾸미를 유혹하고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.580,
                "end": 30.201
            },
            {
                "speaker_id": "1",
                "transcription": "꼬리를 보고 꾸미야 이건 또 무슨 시추에이션이야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.211,
                "end": 39.770
            },
            {
                "speaker_id": "1",
                "transcription": "꾸미야 저기 꼬리가 누구의 것인지 알고 있을까?",
