                    2,
                    3
                ],
                "start": 12.471,
                "end": 16.149
            },
            {
                "speaker_id": "1",
                "transcription": "정말 노랑이 유채 무치아는 먹보 고양이가 또 탄생한 것 같은데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.159,
                "end": 26.047
            },
            {
                "speaker_id": "1",
                "transcription": "그러고 보니 노랑이 유채 시루야 모두 남자 친구예요.",
                "sound_type": [
                    2,
