    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "엄청 막 그런 정도는 아닌데 또 제 모발 치고 곱슬기가 있어서 조금 티가 나는 어디 중요한 날이 있으면은 고데기는 꼭 하게 되는 그 정도인 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.909
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 좀 들해요 그죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.919,
                "end": 12.586
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 좀 들하고 그니까 왼쪽 오른쪽 차이도 있고 진짜 복불복도 어느 정도 있는 거 같애.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.596,
                "end": 19.681
            },
            {
                "speaker_id": "1",
                "transcription": "제 두피는 왼쪽이 더 별론가 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.691,
                "end": 21.710
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로 제 흉터에 심어진 거는 곱슬기보다는 이게 피부가 두껍잖아요 제 킬로이드 때문에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.720,
                "end": 27.844
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 모발 방향이 조금 특이한 그 느낌이 꼭 곱슬기는 오히려 그냥 살짝 다르죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.854,
                "end": 34.989
            },
            {
                "speaker_id": "1",
                "transcription": "제가 원래 모발이라 엄청 티 나는 것도 아니고 애매해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.999,
                "end": 38.901
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 생각하는 게 이마 쪽을 하면 불편하실 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.911,
                "end": 43.422
            },
            {
                "speaker_id": "1",
                "transcription": "복불복이니까 안 곱슬거릴 분도 계실 수 있지만 100퍼센트 확률로 곱슬거린다한다면은 M자는 괜찮은 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.432,
                "end": 50.697
            },
            {
                "speaker_id": "1",
                "transcription": "여기 내려오는 머리 따로 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.707,
                "end": 52.331
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기 안을 심은 거잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.341,
                "end": 54.381
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 얘가 곱슬거려도 얘가 내려와 있으니까 딱히 그렇다고 제가 이렇게 했다고 여기가 엄청 곱슬거려서 문제 있는 것도 아니구 모질 차이가 너무 심하지만 않으면 뚜껑이 덮여지다 보니까 그냥 여기나 이런데 괜찮은 거 같은 M자는 편한 거 같은데 그중에 살짝 차이 나는 거 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.391,
                "end": 72.720
            },
            {
                "speaker_id": "1",
                "transcription": "M자는 괜찮은 거 같은데 여기 요쪽은 심으면 곱슬기가 오히려 좀 눈에 잘 띌 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.730,
                "end": 79.452
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 이렇게 넘길 때 이렇게 좀 남아있는 내가 찌글찌글 울어봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.462,
                "end": 82.987
            },
            {
                "speaker_id": "1",
                "transcription": "저는 또 만족하냐 하면은 전 또 만족해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.997,
                "end": 86.071
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 곱슬기가 있어도 제가 말씀드렸다시피 막 뭐 엄청 티 나는 것도 아니고 오히려 그냥 바람불고 해도 제가 고개를 들고 있을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.081,
                "end": 94.293
            },
            {
                "speaker_id": "1",
                "transcription": "축소술하고 심었는데도 이런데 여기 맘 같아선 여기 이렇게 해서 좀 채우고 싶었는데 대체 몇 모를 심는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.303,
                "end": 103.800
            }
        ]
    },
    "summary": "한 여성이 본인 모발치고 곱슬기가 있어 중요한 날은 꼭 고데기 하는 정도라고 말하고는 왼쪽 오른쪽 차이는 복불복이라며 곱슬거린다가 100퍼센트면 M자는 괜찮은 것 같다고 설명하고 본인은 또 만족한다며 엄청 티 나는 것도 아니고 본인이 고개를 바람 불어도 들고 있을 수 있다고 답한다.",
