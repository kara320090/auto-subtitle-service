        "term": [
            {
                "speaker_id": "1",
                "transcription": "냄새는 약간 옥수수 냄새가 진하게 나고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.183
            },
            {
                "speaker_id": "1",
                "transcription": "스피드 글루텐입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.193,
                "end": 5.529
            },
            {
                "speaker_id": "1",
                "transcription": "자 마늘 글루텐이고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.539,
                "end": 8.888
            },
            {
                "speaker_id": "1",
                "transcription": "자 기존의 그 라이어의 마늘 글루텐을 사용하면서 느낀 건데 마늘 글루텐 같은 경우엔 다른 글루텐보다 조금 더 질어요.",
                "sound_type": [
                    2
                ],
                "start": 8.898,
                "end": 22.193
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 똑같은 1대1을 하더라도 다른 글루텐보다 약간 질어집니다.",
                "sound_type": [
                    2
                ],
                "start": 22.203,
                "end": 27.236
            },
            {
                "speaker_id": "1",
                "transcription": "그것 때문에 풀림이 빨라서 그런 건지는 모르겠는데 저는 개인적으로 마늘 글루텐 쓸 때 입질을 좀 많이 받았었거든요? 그래서 새로 나온 이 파워 마늘 글루텐도 굉장히 기대가 되고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 27.246,
                "end": 39.178
            },
            {
                "speaker_id": "1",
                "transcription": "어 냄새는 그 강한 마늘 향이",
