        "term": [
            {
                "speaker_id": "1",
                "transcription": "무겁거나 정말 타는 냄새 이런 그런 것 보다는요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.600
            },
            {
                "speaker_id": "1",
                "transcription": "조금 더 자유로움이 이렇게 느껴지는 그런 향이라고 이제 묘사들을 많이들 해요.",
                "sound_type": [
                    2
                ],
                "start": 3.610,
                "end": 9.385
            },
            {
                "speaker_id": "1",
                "transcription": "저 역시 이 향을 딱 만나면은 처음에 보통 우리가 우디 향수를 뭔가 매끄럽고 부드럽고 좀 차분해지고",
                "sound_type": [
                    2
                ],
                "start": 9.395,
                "end": 16.535
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 이제 표현을 많이 하게 되는데",
                "sound_type": [
                    2
                ],
                "start": 16.545,
                "end": 18.873
            },
            {
                "speaker_id": "1",
                "transcription": "그러기보다는 뭔가 바스러질 듯이 연기 속에 뭐 파우더리하게",
                "sound_type": [
                    2
