        "term": [
            {
                "speaker_id": "1",
                "transcription": "따라라라딴, 이렇게 해서 독립된 테라스가 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.656
            },
            {
                "speaker_id": "1",
                "transcription": "어, 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 4.666,
                "end": 7.824
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 그냥 좋다고.",
                "sound_type": [
                    2
                ],
                "start": 7.834,
                "end": 10.366
            },
            {
                "speaker_id": "1",
                "transcription": "아, 추우니까 들어갈 거야.",
                "sound_type": [
                    2
                ],
                "start": 10.376,
                "end": 12.245
            },
            {
                "speaker_id": "1",
                "transcription": "빨리 봄이 와라.",
                "sound_type": [
                    2
                ],
                "start": 12.255,
                "end": 13.429
            },
            {
                "speaker_id": "1",
                "transcription": "아, 추워.",
                "sound_type": [
                    2
                ],
                "start": 13.439,
                "end": 14.701
            },
            {
                "speaker_id": "1",
                "transcription": "제가 가장 좋아하는 자리는 이 자리예요.",
                "sound_type": [
                    2
                ],
                "start": 14.711,
                "end": 17.741
            },
            {
                "speaker_id": "1",
                "transcription": "일단 의자도 너무너무 그냥 사용감 자체가 되게 고급스럽다라고 느끼실 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.751,
                "end": 23.598
            },
            {
                "speaker_id": "1",
                "transcription": "어, 그리고 뷰도 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.608,
                "end": 26.320
            },
            {
                "speaker_id": "1",
                "transcription": "어, 그냥 석양을 보는 것만으로도 굉장히 힐링이 되는 공간입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.330,
                "end": 31.162
            },
            {
                "speaker_id": "1",
                "transcription": "자, 영업시간 안내해 드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.172,
                "end": 33.021
            },
            {
                "speaker_id": "1",
                "transcription": "오전 11시에 오픈해서요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.031,
                "end": 35.154
            },
            {
                "speaker_id": "1",
                "transcription": "밤 10시에 닫습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.164,
                "end": 37.343
            },
            {
                "speaker_id": "1",
                "transcription": "그리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.353,
                "end": 38.333
            }
        ]
    },
    "summary": "가장 좋아하는 자리는 의자도 고급스럽고 석양을 보며 힐링할 수 있는 자리이고 영업시간은 오전 11시에 오픈해서 밤 10시에 닫는다.",
