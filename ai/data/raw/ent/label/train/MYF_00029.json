    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "바로 전역을 하겠다고 해서 네 바로 전역하고 제가 하고 싶은 일을 바로 시작을 했는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.046
            },
            {
                "speaker_id": "1",
                "transcription": "지금 생각해보면 왜 내가 그 10개월을 선택하지 않았나라는 생각이 듭니다.",
                "sound_type": [
                    2
                ],
                "start": 6.056,
                "end": 11.934
            },
            {
                "speaker_id": "1",
                "transcription": "어 그래서 정말 이미 전역하신 분도 있고 또 전역을 준비하시는 분들이 있는데 이 직보반이라는 이 좋은 기회를 꼭 활용하시라는 말을 해드리고 싶고 그렇기 때문에 정말 요즘은 군에서 제2의 인생을 선택할 때 군에서 많은 지원을 해요.",
                "sound_type": [
                    2
                ],
                "start": 11.944,
                "end": 31.747
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 직업보도반이라는 것도 있지만 나라 지원금도 있고 또 구직활동 지원비도 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 31.757,
                "end": 37.944
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 내가 군에 우선 나가기 전에 또 내가 무슨 일을 잘할 수 있는지 또 내가 어떤 것을 또 배울 수 있는지 이런 것들을 준비를 할 수가 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 37.954,
                "end": 46.951
            },
            {
                "speaker_id": "1",
                "transcription": "제가 있는 한국 부사관 장교 학원에서도 역시 이 지원금과 연계해서 여러분들이 항공준사관나 이런 것들을 준비를 할 수 있는데 제가 아주 꿀팁을 가지고 왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 46.961,
                "end": 58.817
            },
            {
                "speaker_id": "1",
                "transcription": "어 항공준사관 경우도 항공준사관 학원이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 58.827,
                "end": 63.027
            },
            {
                "speaker_id": "1",
                "transcription": "이게 교육비가 많이 비싼데 사실 민간 분들은 사실 비싼 교육비를 본인의 자비로 등록을 해서 준비를 합니다.",
                "sound_type": [
                    2
                ],
                "start": 63.037,
                "end": 71.155
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 우리 군 전역자들이나 예정자들은 무료로 할 수가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 71.165,
                "end": 76.991
            },
            {
                "speaker_id": "1",
                "transcription": "정말 이런 기회를 활용하지 않으면 너무 아깝겠죠.",
                "sound_type": [
                    2
                ],
                "start": 77.001,
                "end": 79.963
            },
            {
                "speaker_id": "1",
                "transcription": "저처럼 그래서 어 5년 이상 군 생활하시고 전역하시는 분 계급 상관없습니다.",
                "sound_type": [
                    2
                ],
                "start": 79.973,
                "end": 87.137
            },
            {
                "speaker_id": "1",
                "transcription": "부사관이든 장교든 상관 없고 5년 이상 내가 근무를 했다면 항공준사관 학원으로 등록하시면 나라 지원금이 이미 됐기 때문에 등록비가 충분히 나라에서 지원하는 걸로 등록을 할 수가 있고요.",
                "sound_type": [
                    2
                ],
                "start": 87.147,
                "end": 100.263
            },
            {
                "speaker_id": "1",
                "transcription": "매달 학원비를 나라에서 구직 활동비로 대체가 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 100.273,
                "end": 104.815
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이런 좋은 기회를 어떻게 쓸 수 있느냐 우선 여러분들이 구직활동을 할 수 있는 거를 인제 증명을 해야 되잖아요.",
                "sound_type": [
                    2
                ],
                "start": 104.825,
                "end": 111.743
            },
            {
                "speaker_id": "1",
                "transcription": "그게 인제 각 회사나 뭐 구직활동을 하고 있다는 업체하고 연결이 되겠지만 항공준사관은 역시 한국 부사관 장교학원에서 원장님과 상담을 받아서 등록을 하시면 결국 구직활동을 하고 있는 것이 내가 그 매달 수강을 해서 등록을 했다라는 그 증명이 되니까 여러분들은 무료로 6개월 동안 항공 준사관 준비를 할 수 있는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 111.753,
                "end": 135.114
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 예 예전에 제가 계속 얘기했던 것처럼 항공 준사관도 보통 집중에 시간이 필요합니다.",
                "sound_type": [
                    2
                ],
                "start": 135.124,
                "end": 141.030
            },
            {
                "speaker_id": "1",
                "transcription": "내가 아무리 자격이 뛰어나고 훌륭해도 사실 그 방법과 필기와 실기와 면접을 준비를 해야되기 때문에 이미 학원에 있는 노하우를 활용해서 하는 것이 가장 효과적이고 또 안타까운 건 내년부터 항공준사관을 2번밖에 뽑지 않는다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 141.040,
                "end": 159.040
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 여러분 어떻게 해야겠어요 노하우와 축적된 거를",
                "sound_type": [
                    2
                ],
                "start": 159.050,
                "end": 162.762
            }
        ]
    },
    "summary": "직업보도반이라는 것도 있지만 나라 지원금도 있고 또 구직활동 지원비도 있다고 말하면서 또 한국 부사관 장교 학원에서도 이 지원금과 연계해서 5년 이상 근무했다면 계급 상관없이 항공 준사관 학원 등록하면 무료로 다닐 수 있다고 얘기한다.",
