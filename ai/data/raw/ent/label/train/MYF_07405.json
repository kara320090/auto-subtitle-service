        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "버터구이 오징어 그리고 고추장 불고기 오징어 맛있겠죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.437
            },
            {
                "speaker_id": "1",
                "transcription": "요거는 또 아기 용품이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.437,
                "end": 8.935
            },
            {
                "speaker_id": "1",
                "transcription": "아빠가 만든 자반",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.935,
                "end": 10.042
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1가 이유식 떼고 지금 거의 유아식 먹고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.042,
                "end": 15.260
            },
            {
                "speaker_id": "1",
                "transcription": "근데 잘 안 먹어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.260,
                "end": 16.992
            },
            {
                "speaker_id": "1",
                "transcription": "밥을 잘 안 먹어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.995,
                "end": 19.317
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 우리 치트키 아시죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.317,
                "end": 22.245
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 아빠들 치트키 아기 간장 계란밥 그리고 김자반",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.252,
                "end": 27.055
            },
            {
                "speaker_id": "1",
                "transcription": "아니 아기들 어른 들 입맛에도 사실 김 맛있잖아요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.055,
                "end": 30.860
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아기들이 먹기에도 김이 되게 맛있나 봐요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.870,
                "end": 33.585
            },
            {
                "speaker_id": "1",
                "transcription": "김 거의 치트키",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.582,
                "end": 35.635
            },
            {
                "speaker_id": "1",
                "transcription": "아 든든합니다 진짜",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.637,
                "end": 38.282
            },
            {
                "speaker_id": "1",
                "transcription": "김자반 왜 이렇게 많이 샀지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.282,
                "end": 40.012
            },
            {
                "speaker_id": "1",
                "transcription": "저의 절박함이 느껴지시나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.012,
                "end": 42.005
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1에게 밥을 먹이겠다는 이 그 강렬한 의지",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.005,
                "end": 46.957
            },
            {
                "speaker_id": "1",
                "transcription": "오 이거 대박 나 이거 먹고 싶었어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.960,
                "end": 49.920
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 이거 뭔지 아세요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.920,
                "end": 52.275
            },
            {
                "speaker_id": "1",
                "transcription": "이게 재가 보여드릴게요 잠깐만요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.275,
                "end": 54.530
            },
            {
                "speaker_id": "1",
                "transcription": "짜자 잔",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.532,
                "end": 56.227
            },
            {
                "speaker_id": "1",
                "transcription": "소화 안될 때도 매실 먹으면 되게 소화에 좀 도움이 되기도 하고 간단하게 이런 거 밥반찬으로 너무 든든하죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.227,
                "end": 64.805
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 있으면 진짜 완전 효자템",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.807,
                "end": 66.847
            },
            {
                "speaker_id": "1",
                "transcription": "냉장고 효자템 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.847,
                "end": 71.491
            },
            {
                "speaker_id": "1",
                "transcription": "다음은 뭐 샀나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.501,
                "end": 73.600
            }
        ]
    },
    "summary": "한 여자가 아기가 밥을 잘 먹지 않아서 김자반을 샀다는 이야기와 냉장고 효자 템이라고 하며 매실장아찌를 샀다고 이야기하고 있다.",
