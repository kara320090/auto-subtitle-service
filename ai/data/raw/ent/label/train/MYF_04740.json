            },
            {
                "speaker_id": "1",
                "transcription": "그냥 대기실에서 흥에 넘치셔가지고 대기실 가셔 가지고 그냥 쓰던 뮈스크 라바는 본품 들고 나오셔 가지고 줘버린",
                "sound_type": [
                    2
                ],
