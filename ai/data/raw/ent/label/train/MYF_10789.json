            },
            {
                "speaker_id": "1",
                "transcription": "사진이 찍혀 있으면 네 무조건 인화를 하고 방으로 보내 버려요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.859,
                "end": 10.318
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그거를 얘기를 해야 돼요.",
