                ],
                "start": 18.386,
                "end": 20.758
            },
            {
                "speaker_id": "1",
                "transcription": "이쪽은 다리 건너 반대편인데 이쪽은 물색이 그나마 좀 낫습니다.",
                "sound_type": [
                    2
