        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 사람마다 정말 많이 다르거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.760
            },
            {
                "speaker_id": "1",
                "transcription": "네 사람마다 많이 달라서 지금 앞에 저희 개인 맞춤 향수 보시면 입생로랑 리브로 이런 거 좋아하시는 분들도 등장을 했잖아요.",
                "sound_type": [
                    2
                ],
                "start": 2.770,
                "end": 11.930
            },
            {
                "speaker_id": "1",
                "transcription": "또 제가 추천도 드리기도 했고.",
                "sound_type": [
                    2
                ],
                "start": 11.930,
                "end": 14.400
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 그런 향이 너무 속에 이제 위장이 거부하는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 14.400,
                "end": 19.090
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도면.",
