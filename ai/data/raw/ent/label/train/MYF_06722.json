        "term": [
            {
                "speaker_id": "1",
                "transcription": "하루에 루틴 하루에 루틴으로 먹으라고 그렇게 돼 있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.689
            },
            {
                "speaker_id": "1",
                "transcription": "여기 내용 보니까 면역력 증진에 좋고 또 피로 개선에 좋고 기억력 개선, 항산화까지 나한테 다 필요한 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.699,
                "end": 11.336
            },
            {
                "speaker_id": "1",
                "transcription": "나 요즘 기억력도 안 좋거든?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.346,
                "end": 12.951
            },
            {
                "speaker_id": "1",
                "transcription": "아 나이를 먹으니까 하나하나 기억이 안 나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.961,
                "end": 15.934
            },
            {
                "speaker_id": "1",
                "transcription": "아이 나 한참 젊은데 말야 벌써부터 그러네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.944,
                "end": 18.569
            },
            {
                "speaker_id": "1",
                "transcription": "야 @이름1이가 아빠 먹으라고 다 꺼내 놨네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.579,
                "end": 20.785
            },
            {
                "speaker_id": "2",
                "transcription": "여보 이게 국내산 6년근 홍삼으로 만들었대.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.795,
                "end": 25.331
            },
            {
                "speaker_id": "2",
                "transcription": "근데 이게 하루에 1팩만 먹으면은 영양을 다 챙길 수 있대.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.341,
                "end": 29.115
            },
            {
                "speaker_id": "1",
                "transcription": "아 그럼 나 이제 뭐 다른 거 필요 없이 그냥 이거 하루 1포만 먹으면 되는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.125,
                "end": 32.836
            },
            {
                "speaker_id": "2",
                "transcription": "자기 약 챙겨 먹는 거 귀찮아하잖아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.846,
                "end": 35.105
            },
            {
                "speaker_id": "1",
                "transcription": "그치 귀찮지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.115,
                "end": 35.936
            },
            {
                "speaker_id": "2",
                "transcription": "하나만 먹으면 된대.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.946,
                "end": 36.903
            },
            {
                "speaker_id": "1",
                "transcription": "오우 좋았어 나 바로 먹어봐도 돼?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.913,
                "end": 38.594
            },
            {
                "speaker_id": "2",
                "transcription": "그럼",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.604,
                "end": 39.400
            }
        ]
    },
