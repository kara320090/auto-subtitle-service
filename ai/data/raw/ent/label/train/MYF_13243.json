        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 한번씩 밖까지 들고 나와서 이제 화장실 가는 거 케이지가 작아서 화장실까지 못 놓아 줬어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.331
            },
            {
                "speaker_id": "1",
                "transcription": "근데 밤톨이가 화장실 가고 싶어 할 것 같아서 한번 화장실 데리고 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.341,
                "end": 13.162
            },
            {
                "speaker_id": "1",
                "transcription": "우리 밤톨이 밥 마저 많이 먹고 물도 많이 먹고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.172,
                "end": 17.952
            },
            {
                "speaker_id": "1",
                "transcription": "예뻐요. 밤톨이 자 우리 밤톨이 이제 기운 냈어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.962,
                "end": 23.105
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아직 야생성이 있어가지고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.115,
                "end": 27.176
            },
            {
                "speaker_id": "1",
                "transcription": "하악질도 하고 깨물기도 하고 얼마나 혼자서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.186,
                "end": 33.800
            }
        ]
    },
    "summary": "밤톨이는 하악질도 하고 깨물기도 한다.",
