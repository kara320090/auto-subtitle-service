        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기 이 친구가요 우리 어 방울이 방울이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.355
            },
            {
                "speaker_id": "1",
                "transcription": "방울아 방울아 어유 우리 방울이 엄청 크죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.365,
                "end": 13.870
            },
            {
                "speaker_id": "1",
                "transcription": "제가 얼굴을 많이 확대했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.880,
                "end": 16.016
            },
            {
                "speaker_id": "1",
                "transcription": "어 우리 방울이 얼굴 한 번 보자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.026,
                "end": 18.830
            },
            {
                "speaker_id": "1",
                "transcription": "어이구 우리 방울이 예쁘다.",
                "sound_type": [
