                    3,
                    5
                ],
                "start": 22.772,
                "end": 30.142
            },
            {
                "speaker_id": "1",
                "transcription": "우리 가지 가지야 어이구 우리 가지 어이구 우리 가지야 어이구 우리 방울이",
