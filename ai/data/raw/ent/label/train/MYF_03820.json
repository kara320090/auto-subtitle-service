    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "영감이 되어준 그 모습이나 이런 것들 굉장히 묘사를 잘 해놓고 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.700
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이솝 홈페이지에 가셔서 확인해 보시면 좋으실 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 5.710,
                "end": 9.701
            },
            {
                "speaker_id": "1",
                "transcription": "카르스트는 뭐 로즈메리 세이지 이런 허브의 그린 그린 함 함과 함께요 샌들우드 시더의 우디 함도 살짝 있지만 전반적으로 어떤 느낌이냐면요.",
                "sound_type": [
                    2
                ],
                "start": 9.711,
                "end": 19.934
            },
            {
                "speaker_id": "1",
                "transcription": "제가 그 댓글로 그런 질문들 제가 얼마 전에 댓글을 받은 게 있는데 비 오는 날 숲속을 걷는 것 같은 향수 추천해 주세요 이런 댓글을 제가 봤었어요.",
                "sound_type": [
                    2
                ],
                "start": 19.944,
                "end": 32.115
            },
            {
                "speaker_id": "1",
                "transcription": "카르스트가 그 느낌에 맞는 향수라고 저는 생각해요.",
                "sound_type": [
                    2
                ],
                "start": 32.125,
                "end": 36.716
            },
            {
                "speaker_id": "1",
                "transcription": "기본적으로 바다와 육지가 만나는 그걸 이제 모티브로 만들어낸 향수인데 바다의 그런 물기 있는 그 마린 노트가 어 비 오는 비의 느낌을 선사를 할 거고요.",
                "sound_type": [
                    2
                ],
                "start": 36.726,
                "end": 51.172
            },
            {
                "speaker_id": "1",
                "transcription": "제가 앞에 말씀드렸던 그런 허브와 나무들이 숲속의 느낌을 충분히 선사할 거거든요.",
                "sound_type": [
                    2
                ],
                "start": 51.182,
                "end": 58.533
            },
            {
                "speaker_id": "1",
                "transcription": "제가 행사장에서 그 향을 딱 맡자마자 아 그 댓글이 딱 떠오르는 거예요. 아 비 오는 날 숲속을 걷는 느낌의 향수 바로 이거 추천드려야겠구나.",
                "sound_type": [
                    2
                ],
                "start": 58.543,
                "end": 67.722
            },
            {
                "speaker_id": "1",
                "transcription": "에레미아같은 경우에는 이솝 홈페이지에서 비 내린 뒤 콘크리트라고 설명을 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 67.732,
                "end": 73.197
            },
            {
                "speaker_id": "1",
                "transcription": "제가 에레미아나 카르스트 잔향까지는 확인을 못하고 그 세라믹 시향만 이제 하게 되었는데 에레미아 같은 경우에는 너무 향이 잔잔하고 예쁜 꽃과 시트러스가 너무 잔잔하게 펼쳐지는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 73.207,
                "end": 87.319
            },
            {
                "speaker_id": "1",
                "transcription": "꽃과 시트러스 함이 바람에 발랄하게 이렇게 실려 가지고 나한테 오면 근데 그게 메이드 바이 이솝이라고 하면은 그러면 정말 이런 향이겠구나라고 생각을 했어요.",
                "sound_type": [
                    2
                ],
                "start": 87.329,
                "end": 98.675
            },
            {
                "speaker_id": "1",
                "transcription": "유자나 그레이프프루트 베르가못의 그런 시트러스 함과 함께요.",
                "sound_type": [
                    2
                ],
                "start": 98.685,
                "end": 102.645
            },
            {
                "speaker_id": "1",
                "transcription": "그 꽃의 느낌은 미모사와 그다음에 아이리스 이쪽에서 이제 주었기 때문에 너무 달달하고 이런 달콤하고 꽃,꽃,꽃,꽃 요렇게 생각하시는 그런 꽃보다는 좀 더 잔잔한 꽃이라고 생각을 해주시면은 좋을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 102.655,
                "end": 117.010
            },
            {
                "speaker_id": "1",
                "transcription": "에레미아는 그 식물원에 들어가는 그 느낌을 얻고 싶은 분들 이런 분들에게 어울리는 향수라는 생각을 생각을 저는 바로 가졌었거든요.",
                "sound_type": [
                    2
                ],
                "start": 117.020,
                "end": 126.452
            },
            {
                "speaker_id": "1",
                "transcription": "카르스트와 에레미아는 도시에서 만나는 자연의 느낌을 충분히 즐기실 수가 있는 향수라고 생각을 해요. 카르스트가 좀 더 비 오는 날이라고 하면은",
                "sound_type": [
                    2
                ],
                "start": 126.462,
                "end": 136.466
            }
        ]
    },
    "summary": "카르스트는 허브의 그린 그린 함과 함께 우디 함도 함께 있는 비오는 날 숲속을 걷는 느낌의 향수이며 에레미아는 꽃과 시트러스 함이 느껴지는 식물원에 들어 가는 느낌의 향수이다.",
