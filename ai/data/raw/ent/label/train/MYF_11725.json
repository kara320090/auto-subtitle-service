        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 이제 알바를 할 거라서 보건소에 가서 보건증 떼러 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.595
            },
            {
                "speaker_id": "1",
                "transcription": "지하철에 사람이 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.605,
                "end": 8.508
            },
            {
                "speaker_id": "2",
                "transcription": "신분증 3000원 주시구요 이거 보건증 앞에 체크 한 번만 더해 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.518,
                "end": 28.799
            },
            {
                "speaker_id": "2",
                "transcription": "안에 있는 면봉을 항문에 2센치쯤 넣었다가 빼가지고 오셔서 저기다 꼽고 가세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.809,
                "end": 57.736
            },
            {
                "speaker_id": "1",
                "transcription": "네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.746,
                "end": 58.548
            },
            {
                "speaker_id": "1",
                "transcription": "끝 너무 빨리 끝났다 한 2 3분 만에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.558,
                "end": 78.476
            },
            {
                "speaker_id": "1",
                "transcription": "지금 코로나가 유행하니까",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 78.486,
                "end": 81.813
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 되어있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.823,
                "end": 86.458
            },
            {
                "speaker_id": "1",
                "transcription": "저 보건증 받으러 왔어요.",
