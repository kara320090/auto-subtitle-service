        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 겨울 집은 고양이 보호 협회에서 어 주문한 것은 아니고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.123
            },
            {
                "speaker_id": "1",
                "transcription": "유어 스페이스라고 하는 고양이 겨울 집 전문 제작 업체에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.133,
                "end": 10.729
            },
            {
                "speaker_id": "1",
                "transcription": "저희가 이 업체 제품을 한 4년 전부터 쓰고 있는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.739,
                "end": 15.736
            },
            {
                "speaker_id": "1",
                "transcription": "해마다 좋은 거는 조금씩 조금씩 제품이 좋아지고 있는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.746,
                "end": 21.617
            },
            {
                "speaker_id": "1",
                "transcription": "아마 소비자들의 그 캣맘 캣대디님들의 의견을 수렴해서 조금씩 더 좋은 겨울 집으로 만들어 가고 계신 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.627,
                "end": 31.834
            },
            {
                "speaker_id": "1",
                "transcription": "사이즈가 사실 엄청 커요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.844,
                "end": 35.675
            },
            {
                "speaker_id": "1",
                "transcription": "거의 굿 똥과 거의 비슷할 만큼 저 뒤에 보이시는 굿 똥이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.685,
                "end": 41.477
            },
            {
                "speaker_id": "1",
                "transcription": "그 굿 똥 사이즈와",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.487,
                "end": 44.010
            }
        ]
    },
    "summary": "한 여자가 이번에 구매한 제품은 고양이 겨울 집 전문 제작 업체에서 구매하였다고 한다.",
