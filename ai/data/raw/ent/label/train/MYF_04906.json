        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "미국 시카고에 있는 스멜링 테이스트 트리트먼트 앤 리서치 파운데이션의 설립자인 @이름1이 집행했던 실험이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.223
            },
            {
                "speaker_id": "1",
                "transcription": "만 8631명을 대상으로 진행됐던 향미 선호도에 따른 성격에 대한 그 결과를 바탕으로 오늘 이야기를 펼쳐나가려고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 8.233,
                "end": 17.564
            },
            {
                "speaker_id": "1",
                "transcription": "시트러스 향수 좋아하는 사람 어떤 사람일 거 같으세요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.574,
                "end": 22.464
            },
            {
                "speaker_id": "1",
                "transcription": "네, 미 이 연구 결과에 따르면요.",
                "sound_type": [
                    2
                ],
                "start": 22.474,
                "end": 25.043
            },
            {
                "speaker_id": "1",
                "transcription": "시트러스 향수를 좋아하는 사람은 타고난 리더 야심가이고, 그리고 일을 할 때 있어서 사람들 앞에 나서는 것을 두려워하지 않는 사람이라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 25.053,
                "end": 35.645
            },
            {
                "speaker_id": "1",
                "transcription": "친구들하고 같이 있을 때 왜 우리 저녁에 뭐 먹으러 갈까?",
                "sound_type": [
                    2
                ],
                "start": 35.655,
                "end": 39.647
            },
            {
                "speaker_id": "1",
                "transcription": "고민하고 있을 때 누군가 이런 얘기하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 39.657,
                "end": 42.685
            },
            {
                "speaker_id": "1",
                "transcription": "어 이 근처에 맛집이 좀 생긴 거 같아.",
                "sound_type": [
                    2
                ],
                "start": 42.695,
                "end": 45.273
            },
            {
                "speaker_id": "1",
                "transcription": "여기 한번 가볼래?",
                "sound_type": [
                    2
                ],
                "start": 45.283,
                "end": 46.609
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 먼저 자기 의견을 이야기를 하고 또 다른 사람들을 끌어나갈 수 있는 사람 그런 사람들이 시트러스 향수를 좋아한다라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 46.619,
                "end": 55.713
            },
            {
                "speaker_id": "1",
                "transcription": "프랑스 향수 아틀리에 코롱의 퍼시픽 라임 멕시코산 라임과 이탈리아산 레몬이 함께 있는 그리고 필리핀 코코넛이 밀키밀키하게 흐르는 이런 시트러스 한 향수 다른 사람들에게 자기 의견을 내세우는 것을 두려워하지 않는 사람이라고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 55.723,
                "end": 73.458
            },
            {
                "speaker_id": "1",
                "transcription": "모든 성격에는요 장점이 되는 부분은 또 어느 누군가에게는 단점으로도 갈 수 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 73.468,
                "end": 79.717
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 그 성격이 너무 세게 나갔을 때는 단점이 되기도 하고요.",
                "sound_type": [
                    2
                ],
                "start": 79.727,
                "end": 83.676
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 자기 의견을 피력한다는 게 긍정적으로 보면 적극이고 진취적이고 또 부정적인 단어로 얘기를 하면은 그게 너무나 샜을 때는 공격적이라던지 지배적이라던지 이렇게 해석을 할 수가 있는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 83.686,
                "end": 96.793
            },
            {
                "speaker_id": "1",
                "transcription": "시트러스 향수를 좋아하시는 여러분 혹시 이런 성격이실까요?",
                "sound_type": [
                    2
                ],
                "start": 96.803,
                "end": 100.906
            },
            {
                "speaker_id": "1",
                "transcription": "너무 궁금합니다.",
                "sound_type": [
                    2
                ],
                "start": 100.916,
                "end": 101.927
            },
            {
                "speaker_id": "1",
                "transcription": "라벤더 향수를 좋아하시는 분들 라벤더 향을 좋아하시는 분들은요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 101.937,
                "end": 106.470
            },
            {
                "speaker_id": "1",
                "transcription": "다가가기가 굉장히 쉽고 친구들과의 우정을 잘 이렇게 유지해 나가고 또 그 우정을 소중하게 여겨주는 사람 왜 친구들하고 모임에 있을 때 그중에서 꼭 누군가는 서프라이즈 파티를 친구를 위한 생일 파티를 열어주려고 하는 사람이 있을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 106.480,
                "end": 123.207
            },
            {
                "speaker_id": "1",
                "transcription": "그런 사람이 라벤더 향을 좋아하는 사람이라고 얘기를 해요.",
                "sound_type": [
                    2
                ],
                "start": 123.217,
                "end": 127.265
            },
            {
                "speaker_id": "1",
                "transcription": "다른 사람들이 힘들 때 격려해 줄 주 아는 사람 마곡에 서울 식물원이 오픈할 때 진행했던 행사가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 127.275,
                "end": 134.229
            },
            {
                "speaker_id": "1",
                "transcription": "향수와 향수의 원료들을 가지고 또 향수를 만들기까지 할 수 있는 그런 행사를 했었는데 한국 사람들 우리 좋아하는 향료 1위에 선정이 됐던 것이 바로 라벤더예요.",
                "sound_type": [
                    2
                ],
                "start": 134.239,
                "end": 146.314
            },
            {
                "speaker_id": "1",
                "transcription": "그 라벤더에 대한 이야기 보다 자세한 이야기는 제가 만들어 놓은 영상을 따로 보시면 되실 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 146.324,
                "end": 153.019
            },
            {
                "speaker_id": "1",
                "transcription": "신기한 연구 결과인데 라벤더 자체가 가지고 있는 그 향에 특별한 힘이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 153.029,
                "end": 159.196
            },
            {
                "speaker_id": "1",
                "transcription": "잠을 잘 자게 한다던지 사람 마음을 편하게 한다던지 그래서 그런 향을 좋아하시는 분들이 좀 더 마음이 편안하고 다른 사람들하고 따스한 관계를 끌어가는 거를 소중하게 여기시고 그렇기 때문에 또 친근하고 사람들한테 친숙한 느낌을 준다는 게 어 굉장히 향이 가지고 있는 원래의 힘과 사람의 성격이 좀 잘 맞는 그런 연구 결과가 아닐까 라는 생각을 했어요.",
                "sound_type": [
                    2
                ],
                "start": 159.206,
                "end": 186.655
            },
            {
                "speaker_id": "1",
                "transcription": "장미 향수를 좋아하시는 분들은요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 186.665,
                "end": 189.729
            },
            {
                "speaker_id": "1",
                "transcription": "행동을 하기 전에 생각을 많이 하시는 분들이라고 하세요.",
                "sound_type": [
                    2
                ],
                "start": 189.739,
                "end": 193.790
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 신중하고 사려 깊으신 분들 어떠한 의사 결정을 하기 전에 그 결정에 따른 모든 경우의 수 이 결정이 어떻게 또 파급력을 가지는지 이런 것도 고민을 하시는 분들 그런 분들이 장미 향을 좋아하신다라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 193.800,
                "end": 209.372
            },
            {
                "speaker_id": "1",
                "transcription": "섬세하시고 또 예민하신 분들 장미 향을 좋아하시는 분들은 우리가 살아오면서 실수 그리고 황당한 일, 당황스러운 일, 부끄러운 일 이런 것들이 있는데 장미 향을 좋아하시는 분들은 그걸 잘 잊지를 못하신다라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 209.382,
                "end": 225.053
            },
            {
                "speaker_id": "1",
                "transcription": "때때로 망각은 신이 주신 또 선물이라고도 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 225.063,
                "end": 229.195
            },
            {
                "speaker_id": "1",
                "transcription": "그러니 어 가끔은 우리 그런 것들은 좀 잊어보자고요.",
                "sound_type": [
                    2
                ],
                "start": 229.205,
                "end": 233.429
            },
            {
                "speaker_id": "1",
                "transcription": "필로소피에 누드 로즈라는 향수와 그리고 프레쉬 프레쉬에 로즈 모닝 향수가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 233.439,
                "end": 241.165
            },
            {
                "speaker_id": "1",
                "transcription": "장미와 비누비누한 향을 함께 만나기에 좋은 향이고요.",
                "sound_type": [
                    2
                ],
                "start": 241.175,
                "end": 245.721
            },
            {
                "speaker_id": "1",
                "transcription": "프레쉬 로즈 모닝 같은 경우에는 불가리아 로즈와 함께 로즈 꽃잎을 만나기가 좋은 프레쉬 특유의 그 아기자기하고 귀여운 그런 로즈를 상큼하게 그런 사랑스러운 장미의 향을 만나실 수가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 245.731,
                "end": 260.502
            },
            {
                "speaker_id": "1",
                "transcription": "장미향을 좋아하시는 분들 아침에 일어나셔서 이 장미향을 만나시고 오늘 하루 어떻게 보낼까 생각을 하시고 그리고 액션에 들어가시는 그런 분들이겠죠.",
                "sound_type": [
                    2
                ],
                "start": 260.512,
                "end": 272.514
            },
            {
                "speaker_id": "1",
                "transcription": "프루티 향수를 좋아하시는 분들 블랙베리, 라즈베리, 스트로베리, 이런 베리류들하고 그다음에 뭐 애플, 피치 이런 이제 과일들이 달달하게 들어가 있는 이 프루티 한 향수를 좋아하는 분들 어떤 분일 거 같아요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 272.524,
                "end": 287.517
            },
            {
                "speaker_id": "1",
                "transcription": "왠지 듣기만 하면은 너무나 성격도 달달하고 귀엽고 애교도 많고 막 이럴 거 같은데 연구에 따르면은 이분들은 절대 반대의 성격이래요.",
                "sound_type": [
                    2
                ],
                "start": 287.527,
                "end": 298.409
            },
            {
                "speaker_id": "1",
                "transcription": "비관적이고 쉽게 빈정거리고 내 세상 짜증 잘 내고 화를 잘 내신데요.",
                "sound_type": [
                    2
                ],
                "start": 298.419,
                "end": 304.672
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이런 분들은 함께 있으면 삶이 너무 피곤하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 304.682,
                "end": 308.889
            },
            {
                "speaker_id": "1",
                "transcription": "그러다 보니 이런 분들은 아마 주변에 좋은 분들이 자기한테 온다고 해도 밀어내시는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 308.899,
                "end": 314.828
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 쉽게 짜증 내고 화를 내니까.",
                "sound_type": [
                    2
                ],
                "start": 314.838,
                "end": 317.244
            },
            {
                "speaker_id": "1",
                "transcription": "네, 저라도 그런 분들 옆에 같이 있긴 어려울 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 317.254,
                "end": 320.994
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 이거는 미국에서 진행된 연구 결과라는 사실이에요.",
                "sound_type": [
                    2
                ],
                "start": 321.004,
                "end": 324.712
            },
            {
                "speaker_id": "1",
                "transcription": "꼭 한국에서는 그렇지 않을 수도 있으니까요 프루티 향을 좋아한다라고 해서 그 사람이 짜증을 내거나 화를 내도 않을 수도 있어요.",
                "sound_type": [
                    2
                ],
                "start": 324.722,
                "end": 332.269
            },
            {
                "speaker_id": "1",
                "transcription": "코코넛 향을 좋아하시는 분들은요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 332.279,
                "end": 334.961
            },
            {
                "speaker_id": "1",
                "transcription": "세상 스타일리시한 분들이라고 하세요.",
                "sound_type": [
                    2
                ],
                "start": 334.971,
                "end": 337.720
            },
            {
                "speaker_id": "1",
                "transcription": "세련됐고 그리고 이제 이분들의 특징이 디자이너 라벨 디자이너 레이블을 굉장히 챙기는 분들 그래서 어디 브랜드 거야?",
                "sound_type": [
                    2
                ],
                "start": 337.730,
                "end": 346.326
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 거 따지시고 좀 그런 분들이라고 하세요.",
                "sound_type": [
                    2
                ],
                "start": 346.336,
                "end": 349.513
            },
            {
                "speaker_id": "1",
                "transcription": "옷만이 아니라 주얼리 주얼리에도 굉장히 신경을 많이 쓰시는 분들 그래서 이분들의 옷장에 가면 뭐 믿고 보는 옷장이 되겠죠.",
                "sound_type": [
                    2
                ],
                "start": 349.523,
                "end": 358.964
            },
            {
                "speaker_id": "1",
                "transcription": "백화점에 있는 그런 브랜드들이 다 있는 옷장들 뭐 가구를 사더라도 가구 디자이너 이름을 보고 산다던지 물건을 뭘 하나 살 때도 항상 퀄리티에 집중하시는 분들 저렴한 거 10개 사느니 그냥 비싼 거 하나 사서 오랫동안 입는다던지 이런 분들이 코코넛향을 좋아하는 분들이라고 하세요.",
                "sound_type": [
                    2
                ],
                "start": 358.974,
                "end": 378.076
            },
            {
                "speaker_id": "1",
                "transcription": "주변분들에게는 굉장히 패션 스타일리시하다라는 이야기를 많이 듣고 또 취향이 있다라는 얘기를 많이 듣고요.",
                "sound_type": [
                    2
                ],
                "start": 378.086,
                "end": 386.180
            },
            {
                "speaker_id": "1",
                "transcription": "좋은 거를 사는데 있어 돈을 아끼지 않는 분들이라고 하세요.",
                "sound_type": [
                    2
                ],
                "start": 386.190,
                "end": 390.117
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 향수와 성격에 대해 말씀드렸는데요.",
                "sound_type": [
                    2
                ],
                "start": 390.127,
                "end": 392.901
            },
            {
                "speaker_id": "1",
                "transcription": "그래요, 이번 영상을 보시고서 어, 나는 좀 그런 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 392.911,
                "end": 397.297
