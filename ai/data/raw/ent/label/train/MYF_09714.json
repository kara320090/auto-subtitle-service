        "term": [
            {
                "speaker_id": "1",
                "transcription": "테이너리에 따라서 그 마감이 좀 많이 다른데 그게 모공 방향이 좀 달라요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.400
            },
            {
                "speaker_id": "1",
                "transcription": "그 가죽이 이제 동물의 껍질이잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.400,
                "end": 7.770
            },
            {
                "speaker_id": "1",
                "transcription": "동물의 가죽, 동물의 피부였고 동물도 이제 모공이 있잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.770,
                "end": 12.780
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이렇게 보면서 어머 모공 방향들이 이렇게 뭐 다르네 라던가",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.780,
                "end": 16.370
            },
            {
                "speaker_id": "1",
                "transcription": "이제 이렇게 자세히 보는 그런 활동을 한번 해 보시는 것도 가까이 보는 이런 활동도 좋고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.370,
                "end": 22.333
            }
        ]
    },
    "summary": "가죽은 테이너리에 따라서 동물의 모공이 다르고 그런 것을 자세히 보는 활동을 해 보는 것이 좋다.",
