        "term": [
            {
                "speaker_id": "1",
                "transcription": "짧은 시간에 굉장히 의외로 너무 딱딱 좋아하시더라구요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 5.354
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 저녁 약속이 있으신 분은 잠시 왔다가 그냥 나도 내가 오면 안 되도 윤이사님이 저걸 입고오면 나는 이거를",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 5.364,
                "end": 12.478
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 했었는데 그래도 마음에 평정심을 찾고 했는데 그 친구들이 이제 저보다는 되게 어린",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 12.488,
                "end": 18.426
            },
            {
                "speaker_id": "3",
                "transcription": "고맙습니다. 메르시보꾸",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 18.436,
                "end": 21.729
            },
            {
                "speaker_id": "2",
                "transcription": "얘길 많이 하고 있다고",
