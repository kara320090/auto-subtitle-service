        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.899
            },
            {
                "speaker_id": "1",
                "transcription": "향수 읽어 주는 여자 @이름1입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.909,
                "end": 3.216
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 딥디크 향수인 도손에 대한 말씀을 드리려고 해요.",
                "sound_type": [
                    2
                ],
                "start": 3.226,
                "end": 7.636
            },
            {
                "speaker_id": "1",
                "transcription": "하고 나서 자기는 딥티크 도손 향 너무 싫어한다고 이렇게 말씀을 주세요.",
                "sound_type": [
                    2
                ],
                "start": 7.646,
                "end": 14.702
            },
            {
                "speaker_id": "1",
                "transcription": "제가 늘 말씀드리지만 괜찮아요.",
                "sound_type": [
                    2
                ],
                "start": 14.712,
                "end": 17.095
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 말고도 딥티크 도손 향을 싫어 하는 분들은 굉장히 많으세요.",
                "sound_type": [
                    2
                ],
                "start": 17.105,
                "end": 21.475
            },
            {
                "speaker_id": "1",
                "transcription": "사랑하시는 분들은 정말 많이 사랑하시고요.",
                "sound_type": [
                    2
                ],
                "start": 21.485,
                "end": 24.527
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 호불호가 극명하게 갈리는 그런 향수예요.",
                "sound_type": [
                    2
                ],
                "start": 24.537,
                "end": 29.157
            },
            {
                "speaker_id": "1",
                "transcription": "네 추천하진 않아요.",
                "sound_type": [
                    2
                ],
                "start": 29.167,
                "end": 30.862
            },
            {
                "speaker_id": "1",
                "transcription": "딥디크 도손은 본인이 직접 시향을 하고 직접 선택을 해야 되는 향수예요.",
                "sound_type": [
                    2
                ],
                "start": 30.872,
                "end": 37.017
            },
            {
                "speaker_id": "1",
                "transcription": "또 딥티크 도손 향이 어딘가에서부터 등장을 한다.",
                "sound_type": [
                    2
                ],
                "start": 37.027,
                "end": 41.033
            }
        ]
    },
    "summary": "딥티크 도손은 그 향을 싫어하는 사람은 정말 싫어하지만 사랑하는 사람도 정말 많은 호불호가 강한 향수이다.",
