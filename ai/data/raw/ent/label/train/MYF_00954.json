                    2
                ],
                "start": 2.620,
                "end": 5.674
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 기분 내시려면 저 같은 경우는 이제 1만 5,000원짜리를 쓰는데 뭐, 더 싸도 상관은 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.684,
                "end": 13.241
            },
            {
                "speaker_id": "1",
                "transcription": "써보면서 나중에 자기 입맛에 맞는 먹이 나와요.",
