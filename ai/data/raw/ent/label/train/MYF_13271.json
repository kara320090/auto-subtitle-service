                "transcription": "감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 20.348,
                "end": 21.657
            },
            {
                "speaker_id": "1",
                "transcription": "구조해주셔서 감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.667,
                "end": 23.816
            },
            {
                "speaker_id": "2",
                "transcription": "제가 감사하죠.",
