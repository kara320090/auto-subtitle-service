        "term": [
            {
                "speaker_id": "1",
                "transcription": "여보",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.711
            },
            {
                "speaker_id": "2",
                "transcription": "응?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.721,
                "end": 1.165
            },
            {
                "speaker_id": "1",
                "transcription": "내가 건강검진 받고 왔는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.175,
                "end": 3.148
            },
            {
                "speaker_id": "2",
                "transcription": "응.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.158,
                "end": 3.641
            },
            {
                "speaker_id": "1",
                "transcription": "아 내가 몸이 굉장히 안 좋대.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.651,
                "end": 6.582
            },
            {
                "speaker_id": "2",
                "transcription": "그럴 것 같앴어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.592,
                "end": 8.087
            },
            {
                "speaker_id": "1",
                "transcription": "내 술 좋아하고 아 나이 먹으니까 어쩐지 요즘 너무 쇠하더라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.097,
                "end": 12.051
            },
            {
                "speaker_id": "2",
                "transcription": "음",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.061,
                "end": 12.551
            },
            {
                "speaker_id": "1",
                "transcription": "자고 일어나도 너무 피곤하고 무지 힘들더라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.561,
                "end": 15.591
            },
            {
                "speaker_id": "1",
                "transcription": "아우 얘 지금 이렇게 애기인데 애기인데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.601,
                "end": 19.842
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 얘도 있고 얘도 있고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.852,
                "end": 21.800
            },
            {
                "speaker_id": "2",
                "transcription": "나도 있고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.810,
                "end": 22.540
            },
            {
                "speaker_id": "1",
                "transcription": "너도 있고 부양가족 3인방",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.550,
                "end": 24.836
            },
            {
                "speaker_id": "2",
                "transcription": "어깨가 아주 무겁지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.846,
                "end": 26.117
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 내가 아직 넘어지거나 쓰러지면 안 되잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.127,
                "end": 28.896
            },
            {
                "speaker_id": "2",
                "transcription": "그렇지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.906,
                "end": 29.320
            },
            {
                "speaker_id": "1",
                "transcription": "아 내가 건강해야 되는데 말이지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.330,
                "end": 31.412
            },
            {
                "speaker_id": "1",
                "transcription": "이제 새해가 밝았으니까 홀몸도 아니고 가족을 책임져야 되니까 건강을 좀 신경을 쓸려고 해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.422,
                "end": 37.221
            },
            {
                "speaker_id": "1",
                "transcription": "조금 몸에 도움이 될만한 그런 제품 없을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.231,
                "end": 40.389
            },
            {
                "speaker_id": "2",
                "transcription": "여보 내가 요즘 TV를 보니까 김희철이 선전하고 있는 하루틴이라는 홍삼 건강식품이 있더라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.399,
                "end": 48.503
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜로?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.513,
                "end": 49.212
            },
            {
                "speaker_id": "2",
                "transcription": "어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.222,
                "end": 49.601
            },
            {
                "speaker_id": "1",
                "transcription": "그런 거 있으면 진작 얘기해야지. 나 올해부터 좀 건강관리 좀 하자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.611,
                "end": 52.780
            },
            {
                "speaker_id": "1",
                "transcription": "그것 좀 아 먹고 싶은데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.790,
                "end": 54.254
            },
            {
                "speaker_id": "2",
                "transcription": "내가 준비했지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.264,
                "end": 55.758
            },
            {
                "speaker_id": "1",
                "transcription": "어 나를 위해서?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.768,
                "end": 56.730
            },
            {
                "speaker_id": "2",
                "transcription": "그럼",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.740,
                "end": 57.205
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜로?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.215,
                "end": 58.109
            },
            {
                "speaker_id": "1",
                "transcription": "아 또 나 오래오래 돈 벌어오라고 내가 이렇게 돈 버는 ATM이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.119,
                "end": 63.014
            },
            {
                "speaker_id": "2",
                "transcription": "건강해야지 자기가 건강해야지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.024,
                "end": 64.835
            },
            {
                "speaker_id": "1",
                "transcription": "그래 내가 건강해야지 우리 그 부양가족 3인방 내가 잘 키우지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.845,
                "end": 67.988
            },
            {
                "speaker_id": "1",
                "transcription": "너를 포함해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.998,
                "end": 68.696
            },
            {
                "speaker_id": "1",
                "transcription": "어딨어 빨리 줘 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.706,
                "end": 69.855
            },
            {
                "speaker_id": "1",
                "transcription": "그래 부양가족 어 아빠 아프지 말아야죠 그죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.865,
                "end": 73.257
            },
            {
                "speaker_id": "1",
                "transcription": "그래 아빠 안 아플게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.267,
                "end": 75.849
            },
            {
                "speaker_id": "1",
                "transcription": "엄마가 아빠 새해라고 건강하게 오래 돈 많이 벌어오라고 엄마가 준비했대.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.859,
                "end": 81.080
            },
            {
                "speaker_id": "1",
                "transcription": "뭔데 꺼내봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.090,
                "end": 81.993
            },
            {
                "speaker_id": "1",
                "transcription": "엇 뿅 하는 사이에 생겼네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.003,
                "end": 83.954
            },
            {
                "speaker_id": "1",
                "transcription": "이게 하루틴이라는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.964,
                "end": 86.586
            },
            {
                "speaker_id": "2",
                "transcription": "자 받아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.596,
                "end": 87.998
            },
            {
                "speaker_id": "1",
                "transcription": "아 고마워.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.008,
                "end": 89.102
            },
            {
                "speaker_id": "1",
                "transcription": "내가 새해라서 내가 이거 먹고 건강 관리 잘 할게 알았지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.112,
                "end": 92.137
            },
            {
                "speaker_id": "2",
                "transcription": "이거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.147,
                "end": 92.966
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1아 아빠 주려고 엄마가 이거 사 왔대.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.976,
                "end": 95.175
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 최고지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.185,
                "end": 97.031
            },
            {
                "speaker_id": "1",
                "transcription": "열어봐 열어봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.041,
                "end": 97.901
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 생겼어 열어봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 97.911,
                "end": 99.039
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.049,
                "end": 99.798
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 뭐지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.808,
                "end": 101.752
            },
            {
                "speaker_id": "1",
                "transcription": "열어 볼까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 101.762,
                "end": 102.866
            },
            {
                "speaker_id": "2",
                "transcription": "열어 볼까?",
                "sound_type": [
                    2,
