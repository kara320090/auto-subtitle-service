        "term": [
            {
                "speaker_id": "1",
                "transcription": "웃자 자 두 번째 붕어가 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.807
            },
            {
                "speaker_id": "1",
                "transcription": "아 이번에 아까보다 조금 더 커졌습니다 6치네요 자 아주 예쁜 토종 붕어입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.817,
                "end": 17.532
            },
            {
                "speaker_id": "1",
                "transcription": "아 지렁이 먹고 나왔습니다 색깔이 허옇네요 지금부터는 살림망에 좀 넣어볼게요.",
                "sound_type": [
                    2
                ],
                "start": 17.542,
                "end": 28.329
            },
            {
                "speaker_id": "1",
                "transcription": "찌를 꼼지락 꼼지락하다가 쭉 올렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.339,
                "end": 31.421
            },
            {
                "speaker_id": "1",
                "transcription": "사이즈는 작은 녀석이 힘을 잘 쓰네요 첫 수도 두 번째 붕어도 어 모두 저기 마름앞에 세워놓은 적벽 40칸에서 나왔습니다.",
                "sound_type": [
