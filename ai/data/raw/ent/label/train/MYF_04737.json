        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거는 애즈프라라는 네 고체향수 브랜드에서 제가 조향을",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.342
            },
            {
                "speaker_id": "2",
                "transcription": "역시 그래서 이렇게 좋았구나.",
                "sound_type": [
                    2
                ],
                "start": 6.352,
                "end": 8.883
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 뭐야.",
                "sound_type": [
                    2
                ],
                "start": 8.893,
                "end": 10.244
            },
            {
                "speaker_id": "2",
                "transcription": "아니 진짜 나 몰랐어.",
                "sound_type": [
                    2
                ],
                "start": 10.254,
                "end": 12.323
            },
            {
                "speaker_id": "1",
                "transcription": "배어마인드라고 그래서요 이게 제가 영감을 받은 그 그 캐릭터가 약간 돌직구",
                "sound_type": [
                    2
                ],
                "start": 12.333,
                "end": 21.054
            },
            {
                "speaker_id": "2",
                "transcription": "강 강하늘 씨?",
                "sound_type": [
                    2
                ],
                "start": 21.064,
                "end": 22.119
            },
            {
                "speaker_id": "1",
                "transcription": "예.",
                "sound_type": [
                    2
                ],
                "start": 22.129,
                "end": 22.578
            },
            {
                "speaker_id": "2",
                "transcription": "역시 그 뭔가 들판에서 뛰어노는 느낌이 있었어. 맞죠?",
                "sound_type": [
                    2
                ],
                "start": 22.588,
                "end": 26.762
            },
            {
                "speaker_id": "1",
                "transcription": "되게 초록의 그런 자연의 느낌이 풍성하시면서 그러시면서 순수하게 자기의 하트를 이렇게 꺼내가지고 보여줄 수 있는 근데 굉장히 엄청나게 순수하신",
                "sound_type": [
                    2
                ],
                "start": 26.772,
                "end": 39.502
            },
            {
                "speaker_id": "2",
                "transcription": "맞아 맞아 순수함.",
