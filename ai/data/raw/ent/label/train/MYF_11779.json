                    5
                ],
                "start": 16.423,
                "end": 24.623
            },
            {
                "speaker_id": "1",
                "transcription": "신라명과 더치팩으로 아이스커피를 만들었더니 세상 간단하면서도 근사하게 홈 카페를 만들 수 있더라구요.",
                "sound_type": [
                    2,
