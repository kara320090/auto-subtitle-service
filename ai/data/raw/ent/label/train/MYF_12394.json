        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "처음부터 여기서 할 걸 그랬나 봐요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.712
            },
            {
                "speaker_id": "1",
                "transcription": "아쉽지만 오늘 낚시는 여기서 마무리해야 될 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.722,
                "end": 7.643
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 아침에 일찍 나와서 굉장히 빡센 낚시를 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.653,
                "end": 11.327
            },
            {
                "speaker_id": "1",
                "transcription": "어마어마한 짐빵을 하면서 저 안쪽 물칸까지 들어갔는데 여기서 예쁜 붕어를 만났네요.",
                "sound_type": [
                    2
                ],
                "start": 11.337,
                "end": 17.132
            },
            {
                "speaker_id": "1",
                "transcription": "아쉽지만 오늘 낚시는 여기서 마무리하고 저는 다음에 더 좋은 곳에서 예쁜 붕어와 함께 인사드리도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.142,
                "end": 25.160
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 시청해 주셔서 감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 25.164,
                "end": 29.090
            },
            {
                "speaker_id": "1",
                "transcription": "너무 아쉽다.",
                "sound_type": [
                    2
                ],
                "start": 29.100,
                "end": 30.629
            },
            {
                "speaker_id": "1",
                "transcription": "이제 막 입질 들어오는 것 같은데.",
                "sound_type": [
                    2
                ],
                "start": 30.639,
                "end": 33.533
            }
        ]
    },
    "summary": "한 남성이 붕어 한 마리를 낚고 아쉽지만 낚시를 접으려고 하고 있다.",
