        "term": [
            {
                "speaker_id": "1",
                "transcription": "보미 스크래쳐 위에 올라가자",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.554
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 포기하지 않는 보미",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.564,
                "end": 4.586
            },
            {
                "speaker_id": "1",
                "transcription": "이야 너희 둘이 참 대단하다 정말",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.596,
                "end": 8.538
