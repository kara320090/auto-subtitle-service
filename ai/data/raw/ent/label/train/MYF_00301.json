        "term": [
            {
                "speaker_id": "1",
                "transcription": "얘가 루트랩도 달아놨잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.139
            },
            {
                "speaker_id": "1",
                "transcription": "어 선루프도 없기 때문에 빛이 들어올 공간이 딱 유리창 밖에 없는데 확실히 촬영을 한다거나 하면 어둡더라고요.",
                "sound_type": [
                    2
                ],
                "start": 2.140,
                "end": 9.660
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 계속 실내 LED 등을 켜고 주행을 할 수도 없잖아요.",
                "sound_type": [
                    2
                ],
                "start": 9.660,
                "end": 13.850
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아예 갬성과 밝음을 함께 충전을 하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.850,
                "end": 18.380
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그렇다면 엠비언트라이트를 어디 설치를 하느냐",
                "sound_type": [
                    2
                ],
                "start": 18.380,
                "end": 22.400
            }
        ]
    },
    "summary": "선루프도 없고 빛이 들어올 곳이 유리창밖에 없기 때문에 촬영할 때 어두워서 엠비언트라이트를 설치하려고 한다.",
