                "start": 0.976,
                "end": 4.814
            },
            {
                "speaker_id": "1",
                "transcription": "보미 이리 오자 어이구 착해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.824,
                "end": 8.283
            },
            {
                "speaker_id": "1",
                "transcription": "보미 거기 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.293,
                "end": 11.093
            },
            {
                "speaker_id": "1",
                "transcription": "응 아니 참이한테 가지 말고 봄아.",
