        "term": [
            {
                "speaker_id": "1",
                "transcription": "보미 이쪽으로 오자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.966
            },
            {
                "speaker_id": "1",
                "transcription": "터널을 바꿔야겠어.",
