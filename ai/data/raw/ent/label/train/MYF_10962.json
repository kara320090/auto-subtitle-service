        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우는 두 마리 토끼를 다 잡고 싶어가지고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.580
            },
            {
                "speaker_id": "1",
                "transcription": "크루즈 여행 전에 스탑오버아시죠?",
                "sound_type": [
                    2
                ],
                "start": 2.590,
                "end": 5.126
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들어 에어프랑스를 타면 서울에서 파리까지 갑니다.",
                "sound_type": [
                    2
                ],
                "start": 5.136,
                "end": 9.339
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래서 파리에서 다른 유럽의 도시로 가게 되는데 파리 같은 데서 이제 체류를 할 수가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 9.349,
                "end": 15.290
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 파리 여행을 할 수도 있고요.",
                "sound_type": [
                    2
                ],
                "start": 15.300,
                "end": 16.716
            },
            {
                "speaker_id": "1",
                "transcription": "그게 이제 스톱오버고요.",
