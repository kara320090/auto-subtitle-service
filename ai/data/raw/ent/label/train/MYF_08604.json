        "term": [
            {
                "speaker_id": "1",
                "transcription": "엄마한테 와.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.139
            },
            {
                "speaker_id": "2",
                "transcription": "어머머 도망간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.149,
                "end": 3.237
            },
            {
                "speaker_id": "1",
                "transcription": "하하하하",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.247,
                "end": 4.680
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 지나가던 벤다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.690,
                "end": 6.174
            },
            {
                "speaker_id": "1",
                "transcription": "당황했냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.184,
                "end": 8.533
            },
            {
                "speaker_id": "1",
                "transcription": "까망이 브로드라인 해볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.543,
                "end": 11.036
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 까망이 브로드라인 할 차례지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.046,
                "end": 15.512
            },
            {
                "speaker_id": "2",
                "transcription": "음 어 속상해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.522,
                "end": 20.939
            },
            {
                "speaker_id": "1",
                "transcription": "어이구 속상해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.949,
                "end": 23.067
            },
            {
                "speaker_id": "1",
                "transcription": "자 우리 까망이 오늘은 브로드라인 하는 날이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.077,
                "end": 26.111
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.121,
                "end": 33.172
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.182,
                "end": 35.920
            },
            {
                "speaker_id": "1",
                "transcription": "저 달래예요 헤헤헤헤.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.930,
                "end": 38.119
            },
            {
                "speaker_id": "2",
                "transcription": "아구 아구",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.129,
                "end": 39.133
            },
            {
                "speaker_id": "1",
                "transcription": "오구 오구 오구",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.143,
                "end": 40.604
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 우리 고양이들의 어 심장 사상충 약을 접종할 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.614,
                "end": 46.396
            },
            {
                "speaker_id": "1",
                "transcription": "심장 사상충 약은 고양이들에게 진드기나 또 기생충 모기로부터 전염되는 각종 질병을 어 예방해주는 약이라고 할 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.406,
                "end": 57.036
            },
            {
                "speaker_id": "1",
                "transcription": "심장 사상충 약에는 여러 가지 종류가 있는데 저희는 이렇게 브로드라인이라는 제품을 사용합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.046,
                "end": 64.358
            },
            {
                "speaker_id": "1",
                "transcription": "어 이 제품 외에도 애드보킷이나 레볼루션 등의 약이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.368,
                "end": 69.829
            },
            {
                "speaker_id": "1",
                "transcription": "이 약들은 모두 이렇게 젤 형으로 되어 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.839,
                "end": 74.674
            },
            {
                "speaker_id": "1",
                "transcription": "주사가 아니랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.684,
                "end": 76.494
            },
            {
                "speaker_id": "1",
                "transcription": "이 젤 형의 꼭지를 이렇게 따시면은 이 속에 액체가 들어 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.504,
                "end": 83.783
            }
        ]
    },
    "summary": "오늘은 까망이에게 고양이 심장 사상충 약을 접종하기 위해 약의 종류와 형태에 대해 설명을 한다.",
