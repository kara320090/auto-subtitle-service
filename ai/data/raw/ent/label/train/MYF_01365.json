                ],
                "start": 8.483,
                "end": 13.170
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 내가 딱 좋아하는 향이 온전하게 존재를 한다 그러면 제가",
                "sound_type": [
                    2
