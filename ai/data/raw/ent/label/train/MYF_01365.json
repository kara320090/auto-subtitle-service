                ],
                "start": 0.000,
                "end": 8.473
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그렇게 레이어링을 해보시면 어떨까 이런 생각을 좀 해보거든요.",
                "sound_type": [
