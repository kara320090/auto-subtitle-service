                    2
                ],
                "start": 5.865,
                "end": 9.868
            },
            {
                "speaker_id": "1",
                "transcription": "그라스에 와서 어 향수도 만들고 어 누구든지 그라스에 가시면 이렇게 향수 만드는 코스들이 다 있어요.",
                "sound_type": [
                    2
                ],
                "start": 9.878,
                "end": 18.689
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 향수를 다 만드실 수 있어요.",
