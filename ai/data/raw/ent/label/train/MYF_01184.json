        "term": [
            {
                "speaker_id": "1",
                "transcription": "다 제 작업실에 걸려서 있는 네 사진들이고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.855
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이제 그라스에 제가 도착을 하게 돼요.",
