        "term": [
            {
                "speaker_id": "1",
                "transcription": "요렇게 내부에도 두 장 여러 가지 카드의 용도별로 사용하기 좋은 제품이고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.339
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 전혀 두껍지 않고 굉장히 슬림 해서 이렇게 잡았을 때 그립감이 전혀 불편하지 않아요.",
                "sound_type": [
                    2
                ],
                "start": 4.349,
                "end": 10.619
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 폰을 부착해서 간편하게 사용하기에도 좋고 필요에 따라서 이렇게 별도로 가지고 다니면서 일반 카드 지갑으로 사용할 수도 있어서 굉장히 유용하더라고요.",
                "sound_type": [
                    2
                ],
                "start": 10.629,
                "end": 20.785
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 정말 감동했던 부분은.",
                "sound_type": [
                    2
