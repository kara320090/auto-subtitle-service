        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이쪽엔 좀 등이 있네.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.083
            },
            {
                "speaker_id": "1",
                "transcription": "이쪽은 좀 밝고 어 밝은 데선 이렇게 잘 나오고",
                "sound_type": [
                    2
                ],
                "start": 1.093,
                "end": 5.845
            },
            {
                "speaker_id": "1",
                "transcription": "이쪽은 완전 어두운 환경",
                "sound_type": [
                    2
                ],
                "start": 5.855,
                "end": 11.121
            },
            {
                "speaker_id": "1",
                "transcription": "이쪽 길 쪽은 빛이 있어서 최대한 지금 빛없는 쪽을 찍고 있거든요?",
                "sound_type": [
                    2
                ],
                "start": 11.131,
                "end": 17.381
            },
            {
                "speaker_id": "1",
                "transcription": "이 다리 밑에가 지금 빛이 하나도 없어요.",
                "sound_type": [
                    2
                ],
                "start": 17.391,
                "end": 20.002
            },
            {
                "speaker_id": "1",
                "transcription": "전혀 빛이 없는 곳이기 때문에 컴퓨터로는 어떻게 보일지 유튜브로 옮겼을 때 어떻게 보일지",
                "sound_type": [
                    2
                ],
                "start": 20.012,
                "end": 27.600
            }
        ]
    },
    "summary": "남자가 강아지와 산책을 하면서 최대한 어두운 쪽을 촬영하고 있다고 말하고 있다.",
