        "term": [
            {
                "speaker_id": "1",
                "transcription": "애정 가지고 봐주셔서 너무너무 고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.259
            },
            {
                "speaker_id": "1",
                "transcription": "종종 이렇게 트렌드 리포트 제가 받으면 그것도 읽어서 같이 공유하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.269,
                "end": 9.987
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 향수 만드는 향수 읽어주는 여자 하니날다였습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.997,
                "end": 13.352
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 도움이 되셨다면 구독과 좋아요 부탁드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 13.362,
                "end": 16.533
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 오늘도 향기로운 하루 되세요.",
                "sound_type": [
                    2
                ],
                "start": 16.543,
                "end": 19.625
            },
            {
                "speaker_id": "1",
                "transcription": "들어가겠습니다.",
