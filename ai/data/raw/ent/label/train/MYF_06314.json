        "term": [
            {
                "speaker_id": "1",
                "transcription": "앞으로 12월까지는 저렇게 뒤에 다 두고 촬영을 하도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.183
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 오늘도 영상 봐주셔서 정말 너무너무 감사드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.193,
                "end": 7.477
            },
            {
                "speaker_id": "1",
                "transcription": "재밌게 보셨으면 좋아요랑 구독 꼭 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.487,
                "end": 10.211
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 안녕.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.221,
                "end": 12.186
            },
            {
                "speaker_id": "1",
                "transcription": "너무 노래방 때 입었던 옷 입고 있나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.196,
                "end": 17.334
            },
            {
                "speaker_id": "1",
                "transcription": "그 다들 막 입던 옷 또 입고 그러잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.344,
                "end": 21.320
            },
            {
                "speaker_id": "1",
                "transcription": "그죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.330,
                "end": 21.752
            },
            {
                "speaker_id": "1",
                "transcription": "빨았어.",
