        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 추천을 드리고 싶은 향수는요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.937
            },
            {
                "speaker_id": "1",
                "transcription": "조말론을 제가 골라봤어요.",
                "sound_type": [
                    2
                ],
                "start": 1.947,
                "end": 3.639
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 인제 이 분들이 강한 선입견을 좀 가지고 계시고 또 전통이나 어떠한 규칙이나 이런 걸 좀 좋아하시다 보니까 그래도 일반적으로 향수를 접근하시는 분들에게 있어서 리치 향수의 첫 번째 관문과도 같은 뭐 이름에서 부터 다 이야기하고 있죠.",
                "sound_type": [
                    2
                ],
                "start": 3.649,
                "end": 20.021
            },
            {
                "speaker_id": "1",
                "transcription": "바질 앤 네롤리 바질과 네롤리를 만날 수 있는 그런 향이에요.",
                "sound_type": [
                    2
                ],
                "start": 20.031,
                "end": 23.909
            },
            {
                "speaker_id": "1",
                "transcription": "누군가는 신선하게 프레쉬하게 느끼시고 굉장히 다채로운 향이 있어서 아로마틱하다고 느끼실 수 있구요.",
                "sound_type": [
                    2
                ],
                "start": 23.919,
                "end": 29.840
            },
            {
                "speaker_id": "1",
                "transcription": "누군가는 그린하다 이렇게 느끼실 수도 있으세요.",
                "sound_type": [
                    2
                ],
                "start": 29.850,
                "end": 33.066
            }
        ]
    },
