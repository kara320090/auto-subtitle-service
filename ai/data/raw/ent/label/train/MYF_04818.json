        "term": [
            {
                "speaker_id": "1",
                "transcription": "그걸 정했다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.819
            },
            {
                "speaker_id": "1",
                "transcription": "그게 바로 나야라고 말하는 것처럼 우리는 우리가 원하는 것을 시장에 내겠다.",
                "sound_type": [
                    2
                ],
                "start": 0.829,
                "end": 5.182
            },
            {
                "speaker_id": "1",
                "transcription": "마케팅이 아니야.",
                "sound_type": [
                    2
                ],
                "start": 5.192,
                "end": 6.408
            },
            {
                "speaker_id": "1",
                "transcription": "이런 말을 하는 걸 진짜 많이 들어서 그러니까 요즘에 이런 라이트 한 꽃향은 남자분들도 굉장히 많이 하실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 6.418,
                "end": 12.727
            },
            {
                "speaker_id": "2",
                "transcription": "이게 이제 조 말론 설립자인 조 말론하고서 네 작년부터 크리에이티브 회의를 해서 나온 걸로 들었어요.",
                "sound_type": [
                    2
                ],
                "start": 12.737,
                "end": 19.879
            },
            {
                "speaker_id": "1",
                "transcription": "자라라는 브랜드 자체가 그렇잖아요 누구에게도 평등하고 누구에게 친절하고.",
                "sound_type": [
                    2
                ],
                "start": 19.889,
                "end": 24.215
            },
            {
                "speaker_id": "2",
                "transcription": "아우 되게 상큼하면서",
                "sound_type": [
                    2
                ],
                "start": 24.225,
                "end": 26.882
            },
            {
                "speaker_id": "1",
                "transcription": "어우 이거 진짜 상큼하다.",
                "sound_type": [
                    2
                ],
                "start": 26.892,
                "end": 28.221
            },
            {
                "speaker_id": "1",
                "transcription": "아까의 두 향과는 또 다르네요.",
                "sound_type": [
                    2
                ],
                "start": 28.231,
                "end": 30.091
            },
            {
                "speaker_id": "1",
                "transcription": "아침 샤워하고 나서 직후에 뿌리면 되게 좋겠다는 이태리 남부로 데려가는 듯한 느낌",
                "sound_type": [
                    2
                ],
                "start": 30.101,
                "end": 37.281
            },
            {
                "speaker_id": "2",
                "transcription": "아말피는 오렌지 잔잔하게 잔잔하게 상큼한 그 느낌이 여기 너무 좋네요.",
                "sound_type": [
                    2
                ],
                "start": 37.291,
                "end": 43.995
            },
            {
                "speaker_id": "2",
                "transcription": "아니 이 이 이공이공이 향수들이 지금 너무 괜찮은데요.",
                "sound_type": [
                    2
                ],
                "start": 44.005,
                "end": 48.196
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 정말 평등한 향이라 누구나 어떤 열린 공간에서는 켈빈 클라인의 CK1이 에브리원으로",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.206,
                "end": 58.966
            }
        ]
    },
    "summary": "다른 종류의 향을 맡아보고 아침 샤워 한 직후에 뿌리면 좋겠다고 이야기합니다.",
