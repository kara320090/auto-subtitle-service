        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지렁이 다 먹지도 못했네요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.309
            },
            {
                "speaker_id": "1",
                "transcription": "자 저녁을 간단히 먹고 자리로 돌아왔습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 3.319,
                "end": 17.969
            },
            {
                "speaker_id": "1",
                "transcription": "달도 떴고 캐미 넣으면서 제대로 된 붕어 한번 기다려보겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 17.979,
                "end": 23.135
            },
            {
                "speaker_id": "1",
                "transcription": "그 아침 장을 보려고 새벽 여섯 시에 일어났는데 너무 추워서 도저히 대를 던질 수가 없더라고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 23.145,
                "end": 94.652
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 해가 정면에 있어서 찌 보기가 굉장히 힘든 상황입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 94.662,
                "end": 99.235
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 어제 만난 여섯 치 두 마리로는 끝낼 수 없죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 99.245,
                "end": 103.303
            },
            {
                "speaker_id": "1",
                "transcription": "지금 전부 다 지렁이 달아났고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 103.313,
                "end": 105.224
            },
            {
                "speaker_id": "1",
                "transcription": "주간 캐미로 교체 해 놨습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 105.234,
                "end": 106.709
            },
            {
                "speaker_id": "1",
                "transcription": "다시 한 번 좋은 붕어 기다려보겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 106.719,
                "end": 111.458
            }
        ]
    },
    "summary": "어제 여섯 치 두 마리 붕어로는 끝낼 수 없어서 저녁을 간단히 먹고 자리로 돌아와 캐미를 넣으면서 제대로 된 붕어를 기다리고 있다.",
