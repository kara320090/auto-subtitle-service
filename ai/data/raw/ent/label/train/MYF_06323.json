        "term": [
            {
                "speaker_id": "1",
                "transcription": "편하게 드실 수 있을 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.846
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 정가가 지금 보니까 한 17만 원 정도 되는 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 1.856,
                "end": 6.166
            },
            {
                "speaker_id": "1",
                "transcription": "17만 8000원 정도 되는 것 같은데 이걸 주고 사기에는 솔직히 좀 비싼 감이 있는 것 같고요.",
                "sound_type": [
                    2
                ],
                "start": 6.176,
                "end": 11.539
            },
            {
                "speaker_id": "1",
                "transcription": "제가 면세점에서 얘를 7만 얼마에 샀어요.",
                "sound_type": [
                    2
                ],
                "start": 11.549,
                "end": 14.649
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그렇게 구입하실 수 있는 분들은 최대한 할인은 해서 구입을 하시면 좋을 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.659,
                "end": 19.456
            },
            {
                "speaker_id": "1",
                "transcription": "제가 원래 비싼 가방을 잘 안 사요.",
                "sound_type": [
                    2
                ],
                "start": 19.466,
                "end": 21.728
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 명품 가방 이런 것도 하나도 없고 관심도 사실 별로 없고 이게 사람마다 그 돈을 투자하는 부분이 좀 다르잖아요.",
                "sound_type": [
                    2
                ],
                "start": 21.738,
                "end": 28.973
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 저는 이런 가방이나 액세서리나 이런 종류에 많은 돈을 투자하는 편은 아니거든요.",
                "sound_type": [
                    2
                ],
                "start": 28.983,
                "end": 34.364
            },
            {
                "speaker_id": "1",
                "transcription": "저는 오히려 먹는 거나",
                "sound_type": [
                    2
                ],
                "start": 34.374,
                "end": 36.036
            }
        ]
    },
    "summary": "발화자는 이 가방이 정가가 17만 원인데 면세에서 할인 최대한 할 수 있는 만큼 해서 구입하면 좋을 것 같다고 이야기합니다.",
