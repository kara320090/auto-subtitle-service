        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요 맛 없으면 안 먹는 남자 쿠키 티비입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.346
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 분당 야탑에서 오랜 시간 아주 큰 사랑을 받았다는 식당이 있어서 한번 방문해 봤는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.356,
                "end": 9.998
            },
            {
                "speaker_id": "1",
                "transcription": "지금 간판에 보이는 것처럼 장독대 김치찌개 김치찜 집입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.008,
                "end": 15.084
            },
            {
                "speaker_id": "1",
                "transcription": "정말 소문만큼 맛이 있나 없나 오늘도 제가 한번 먹어보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.094,
                "end": 20.187
            },
            {
                "speaker_id": "1",
                "transcription": "밖에는 이렇게 가격을 확인하기 편리하게 메뉴판이 당당하게 밖에 나와 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.197,
                "end": 25.602
            },
            {
                "speaker_id": "1",
                "transcription": "가격을 확인했으니 안으로 들어가 봐야겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.612,
                "end": 31.433
            }
        ]
    },
    "summary": "한 남성이 한 음식점 앞에 서서 소개하고 있다.",
