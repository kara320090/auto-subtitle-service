        "term": [
            {
                "speaker_id": "1",
                "transcription": "마지막 향수는요. 시슬리의 이지아 향수에요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.225
            },
            {
                "speaker_id": "1",
                "transcription": "시슬리가 화장품 만드는 곳 아닌 가요 그런 신 분들이 많아요. 맞아요. 시슬리는 화장품을 만드는 곳이에요.",
                "sound_type": [
                    2
                ],
                "start": 3.235,
                "end": 10.848
            },
            {
                "speaker_id": "1",
                "transcription": "도르나로 가문이 계속 대를 이어서 화장품을 만들고 있죠.",
                "sound_type": [
                    2
                ],
                "start": 10.858,
                "end": 14.891
            },
            {
                "speaker_id": "1",
                "transcription": "이 집이요.",
