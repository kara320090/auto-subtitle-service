                    2,
                    5
                ],
                "start": 9.815,
                "end": 12.520
            },
            {
                "speaker_id": "1",
                "transcription": "순식간에 긁히거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.522,
                "end": 15.360
            },
            {
                "speaker_id": "1",
                "transcription": "이런 방법으로도 하고요.",
