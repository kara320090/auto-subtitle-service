                    5
                ],
                "start": 0.000,
                "end": 5.760
            },
            {
                "speaker_id": "1",
                "transcription": "그걸 이렇게 잘라 갖고 이렇게 긁어줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.762,
                "end": 9.812
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 긁어주면 잘 되거든요.",
