                ],
                "start": 5.020,
                "end": 11.440
            },
            {
                "speaker_id": "1",
                "transcription": "EBSI 사이트에 알림 방 공지 그리고 듀냐 공감 핫 톡에 공지로 올라가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.847,
                "end": 18.060
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 EBS 사이트에 제 영상이 올라가게 돼서 너무 기쁘고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.387,
                "end": 22.657
            },
            {
                "speaker_id": "1",
                "transcription": "제 영상을 좋게 봐주신 EBS 관계자분들께도 정말 감사하다는 말씀을 드리고 싶습니다.",
                "sound_type": [
