        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 아기들을 어 앞으로 3주간 수유 임보를 하기로 하고 일단 저희 집으로 데려가기로 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.151
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 우리 아기들 정말 엄마가 돌보던 아기들 맞는 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.161,
                "end": 16.208
            },
            {
                "speaker_id": "1",
                "transcription": "한번 보실까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.218,
                "end": 17.703
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 우리 얘기들 여기 있는 친구는 호두구요 아하하 호두도 아기들이 막 우니까 와서 응 하는데도",
                "sound_type": [
                    2,
