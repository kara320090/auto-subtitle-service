        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런 느낌을 좀 줘 가지고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.063
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요것도 한번 시간 되시면 조말론 와일드 블루벨도 네, 시간 되시면 한번 시향해 보셔도 어떨까 생각이 들더라고요.",
                "sound_type": [
                    2
                ],
                "start": 2.073,
                "end": 10.578
            },
            {
                "speaker_id": "1",
                "transcription": "약간 조금 작은 화분 여러 개가 이렇게 있는 것 같은 고런 느낌들이 있어서 네.",
                "sound_type": [
                    2
                ],
                "start": 10.588,
                "end": 17.204
            },
            {
                "speaker_id": "1",
                "transcription": "어 그러면서도 살짝 네, 물향처럼 느껴질 수도 있을 것 같긴 해요.",
                "sound_type": [
                    2
                ],
                "start": 17.214,
                "end": 21.300
            },
            {
                "speaker_id": "1",
                "transcription": "그 온도는 높고 그리고 습도도 높고 그 뭐랄까 공기가 정체되어 있기 땜에 그 꽉 막힌 도로를 뭔가 이렇게 헤집고 막 올 거, 올 수 있는 헬리콥터 같은 뭔가 아니면 고속 제트 비행기 같은 고런 역할을 해 주는 게 저한테는 그린 아니면 인제 이제 시츄러스한 네.",
                "sound_type": [
                    2
                ],
                "start": 21.310,
                "end": 42.473
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 비 오는 날 향수",
                "sound_type": [
                    2
                ],
                "start": 42.483,
                "end": 45.033
            }
        ]
    },
    "summary": "작은 화분 여러 개가 있는 것 같으면서 물향처럼 느껴질 수도 있는 조말론 와일드 블루벨도 한번 시향해 보시면 어떨까 하는 생각이 들었습니다.",
