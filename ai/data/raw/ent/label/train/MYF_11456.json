                ],
                "start": 13.743,
                "end": 29.189
            },
            {
                "speaker_id": "1",
                "transcription": "만 명이 된 기념으로 큐앤에이 영상을 겸하려고 해요 네 그래서 어떻게 참여를 하느냐 큐앤에이를 어떻게 진행을 할까 고민을 해봤는데요 일단 댓글 이 지금 이 영상 이 해당 영상의 댓글로",
                "sound_type": [
                    2,
