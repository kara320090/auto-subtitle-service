                    2,
                    3
                ],
                "start": 6.525,
                "end": 6.972
            },
            {
                "speaker_id": "2",
                "transcription": "묻어 있던 거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.982,
                "end": 7.670
            },
            {
                "speaker_id": "1",
                "transcription": "나름 병원에 오느라고 신경 썼습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.680,
                "end": 12.854
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 바이러스 검사하고 해야 안 되겠나 싶어서 제가 열을 열 마리가 있어서 검사를 안 하고 데려가기는 좀 무리수가 있어가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.864,
                "end": 24.769
            },
            {
                "speaker_id": "2",
                "transcription": "그러실거면 차라리 여기 두고 가시는 게 나은데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.779,
                "end": 28.509
            },
            {
                "speaker_id": "2",
                "transcription": "아니 근데 그게 바이러스 검사를 해도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.519,
                "end": 31.342
            },
            {
                "speaker_id": "1",
                "transcription": "예에 잘 안 나타나죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.352,
                "end": 33.214
            },
            {
                "speaker_id": "2",
                "transcription": "그게 의미가 없어요. 잠복기간 이럴 때는 잘 나타나지도 않고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.224,
                "end": 36.959
            },
            {
                "speaker_id": "1",
                "transcription": "예",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.969,
                "end": 37.339
            },
            {
                "speaker_id": "2",
                "transcription": "배출기가 돼야지 의미가 있는 거라서 지금 당장 하신다고 합사를 시키시는 거는 문제가 될 수도 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.349,
