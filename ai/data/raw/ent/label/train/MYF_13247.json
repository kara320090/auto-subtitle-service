                "end": 2.802
            },
            {
                "speaker_id": "1",
                "transcription": "치카치카 그게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.812,
                "end": 3.875
            },
            {
                "speaker_id": "2",
                "transcription": "치약같은 거",
                "sound_type": [
                    2,
