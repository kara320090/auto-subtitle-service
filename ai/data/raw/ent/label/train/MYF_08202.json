        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 일단 화장실은 고로케 해보고 고로케 한번 조을 해보시면 괜찮을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.255
            },
            {
                "speaker_id": "1",
                "transcription": "일단 저희가 이제 소독제하고 연고는 조금 챙겨드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.265,
                "end": 9.132
            },
            {
                "speaker_id": "1",
                "transcription": "고로케 해서 적용을 해보시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.142,
                "end": 13.669
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 저희가 뭐 코코넛 오일이나 이런 건 저희가 갖고 있는 게 없어서 그건 따로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.679,
                "end": 19.284
            },
            {
                "speaker_id": "2",
                "transcription": "저희가 충분히 발라주면 되죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.294,
                "end": 21.182
            },
            {
                "speaker_id": "1",
                "transcription": "그거 적용해 보시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.192,
                "end": 22.975
            },
            {
                "speaker_id": "1",
                "transcription": "다른 건 이상 없었어요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.985,
                "end": 24.341
            },
            {
                "speaker_id": "2",
                "transcription": "응가도 잘 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.351,
                "end": 25.616
            },
            {
                "speaker_id": "2",
                "transcription": "너무 똑똑해 가지고 침대 위에 놔두고 어저께 화장실을 밑에 놔뒀거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.626,
                "end": 30.922
            },
            {
                "speaker_id": "2",
                "transcription": "오늘은 침대 위에 접힌 룸 패드를 놔 뒀는데 쟤 화장실 찾아내려 온 것 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.932,
                "end": 36.002
            }
        ]
    },
    "summary": "제가 소독제하고 연고는 챙겨드리고 코코넛 오일은 있는 게 없다.",
