        "term": [
            {
                "speaker_id": "1",
                "transcription": "그때는 제가 직접 종이에 기입을 해서 복권을 구입하는 방법을 영상으로 한 번 보여 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.315
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뭐 제가 내일당첨이 될거니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.315,
                "end": 10.929
            },
            {
                "speaker_id": "1",
                "transcription": "아마 그 영상은 안 올릴 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.939,
                "end": 14.397
            },
            {
                "speaker_id": "1",
                "transcription": "복권에 당첨되는 상상 저만하는 거 아니죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.397,
                "end": 21.127
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 저녁에는 아주 행복하게 잠이 들 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.137,
                "end": 25.785
            },
            {
                "speaker_id": "1",
                "transcription": "저 다른 영상으로 또 찾아뵐게요.",
