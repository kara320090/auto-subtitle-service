        "term": [
            {
                "speaker_id": "1",
                "transcription": "약간 세련됨 거기에서 오는 세련됨.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.565
            },
            {
                "speaker_id": "1",
                "transcription": "그 손석구 배우라는 그 사람하고 어떻게 보면은 좀 잘 맞는 것도 같아요.",
                "sound_type": [
