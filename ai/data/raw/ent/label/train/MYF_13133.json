        "term": [
            {
                "speaker_id": "1",
                "transcription": "아이고 들어가셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.131
            },
            {
                "speaker_id": "1",
                "transcription": "한번 볼까요 우리 방울이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.141,
                "end": 5.381
            },
            {
                "speaker_id": "1",
                "transcription": "저는요 분홍 공주예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.391,
                "end": 9.290
            },
            {
                "speaker_id": "1",
                "transcription": "방울아 거기가 좋아?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.300,
                "end": 12.074
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 하고 딱 어울리네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.084,
                "end": 15.168
            },
            {
                "speaker_id": "1",
                "transcription": "방울이 낸내해라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.178,
                "end": 17.492
            },
            {
                "speaker_id": "1",
                "transcription": "오구 한숨 잘 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.502,
                "end": 19.968
            },
            {
                "speaker_id": "1",
                "transcription": "아이 좋아 아이 거기서 그루밍 할 거야 우리 방울이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.978,
                "end": 25.719
            },
            {
                "speaker_id": "1",
                "transcription": "어 솔이도 엄마 저도 보여주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.729,
                "end": 31.849
            },
            {
                "speaker_id": "1",
                "transcription": "그래 우리 솔이 보자.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.859,
                "end": 33.430
            },
            {
                "speaker_id": "1",
                "transcription": "우리 솔이 얼굴 보자.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.440,
                "end": 35.436
            },
            {
                "speaker_id": "1",
                "transcription": "우리 솔이 예쁜 얼굴 보자.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.446,
                "end": 37.246
            },
            {
                "speaker_id": "1",
                "transcription": "우리 솔이 어딨어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.256,
                "end": 37.880
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 어딨어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.890,
                "end": 38.707
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 어딨어 솔이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.717,
                "end": 41.679
            },
            {
                "speaker_id": "1",
                "transcription": "솔이 솔이 솔이 어구 솔이 솔이도 들어갈 거야?",
