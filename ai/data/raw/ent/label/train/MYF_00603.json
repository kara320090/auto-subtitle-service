                "start": 0.000,
                "end": 6.453
            },
            {
                "speaker_id": "1",
                "transcription": "우리 아기들 조금만 있어요 엄마가 어 집 치우고 얼른 데려올게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.463,
                "end": 12.780
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 밥 먹고 나면요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.790,
                "end": 16.509
            },
            {
                "speaker_id": "1",
                "transcription": "활발하게 움직이다가 조금 있으면 서로 껴안고 자요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.519,
                "end": 21.045
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 아침 우리 꼬물이 3자매 3자매입니다.",
                "sound_type": [
