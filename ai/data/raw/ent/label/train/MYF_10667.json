        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 1880 몇 년이니까 그러네.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.658
            },
            {
                "speaker_id": "1",
                "transcription": "140년이 맞네.",
                "sound_type": [
                    2
                ],
                "start": 4.668,
                "end": 6.204
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 왜 계산을 잘못했죠. 120년으로",
                "sound_type": [
                    2
                ],
                "start": 6.214,
                "end": 9.777
            },
            {
                "speaker_id": "1",
                "transcription": "아 저번 먹방에 제가 말씀드렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.787,
                "end": 14.360
            },
            {
                "speaker_id": "1",
                "transcription": "아 팔마 얘기를 안 했 아 아직 스페인 얘기를 안 했죠.",
                "sound_type": [
                    2
                ],
                "start": 14.370,
                "end": 18.122
            },
            {
                "speaker_id": "1",
                "transcription": "칸느 얘기했죠.",
                "sound_type": [
                    2
                ],
                "start": 18.132,
                "end": 19.108
            },
            {
                "speaker_id": "1",
                "transcription": "리보르노 얘기했죠.",
                "sound_type": [
                    2
                ],
                "start": 19.118,
                "end": 19.930
            },
            {
                "speaker_id": "1",
                "transcription": "로마, 나폴리 예 아 시칠리아 얘길 안 했나?",
                "sound_type": [
                    2
                ],
                "start": 19.940,
                "end": 24.111
            },
            {
                "speaker_id": "1",
                "transcription": "했던 거 같은데.",
                "sound_type": [
                    2
                ],
                "start": 24.121,
                "end": 25.782
            },
            {
                "speaker_id": "1",
                "transcription": "발레타, 칼리아리 예 칼리아리도 얘기했죠.",
                "sound_type": [
                    2
                ],
                "start": 25.792,
                "end": 29.515
            },
            {
                "speaker_id": "1",
                "transcription": "어 저는 남극으로 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.525,
                "end": 34.956
            },
            {
                "speaker_id": "1",
                "transcription": "네 그린랜드 아니면 남극일 거 같은데.",
                "sound_type": [
                    2
                ],
                "start": 34.966,
                "end": 41.875
