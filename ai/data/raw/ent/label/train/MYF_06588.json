                    2,
                    3
                ],
                "start": 8.804,
                "end": 15.699
            },
            {
                "speaker_id": "1",
                "transcription": "바로 행컵 회기점인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.709,
                "end": 17.574
            },
            {
                "speaker_id": "1",
                "transcription": "오 식품 의약품 안전처에서 위생 등급을 매우 우수를 받았네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.584,
                "end": 22.814
            },
            {
                "speaker_id": "1",
                "transcription": "아주 그냥 믿음이 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.824,
                "end": 24.365
            },
            {
                "speaker_id": "1",
                "transcription": "매장 식사도 가능하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.375,
                "end": 25.989
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 내부로 들어가 보겠습니다.",
