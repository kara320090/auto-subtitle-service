        "term": [
            {
                "speaker_id": "1",
                "transcription": "내 부하와 같이 관리를 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.304
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 비문이 잃어버렸어.",
                "sound_type": [
                    2
                ],
                "start": 2.314,
                "end": 4.371
            },
            {
                "speaker_id": "1",
                "transcription": "근데 과연 진짜 잃어버렸을까요?",
                "sound_type": [
                    2
                ],
                "start": 4.381,
                "end": 6.080
            },
            {
                "speaker_id": "1",
                "transcription": "내가 정말 그 지휘관을 모신다면 그 병사가 목숨을 걸고 챙기지 않을까요?",
                "sound_type": [
                    2
                ],
                "start": 6.084,
                "end": 10.760
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 정말 사람과 사람과의 관계도 잘해야 대 된다는 그 교훈이 있을 수 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.780,
                "end": 16.540
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 내 부하를 잘 다루다 보면은 그 부하도 함께 지켜주는지 내가 아무리 비문을 200권 있어서 잘 센다고 해도 이게 잘 지켜지지 않으면 그런 문제가 있으니 사람 관리한테 잘 지켜주시기 바라고요.",
                "sound_type": [
                    2
                ],
                "start": 16.550,
                "end": 29.750
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째는 무엇일까요?",
                "sound_type": [
                    2
                ],
                "start": 29.750,
                "end": 31.300
            }
        ]
    },
    "summary": "지휘관을 잘 모신다면 병사가 목숨 걸고 비문을 챙길 거라고 생각한다며 그럴려면 사람과의 관계도 잘해야 된다는 교훈이 있다고 얘기한다.",
