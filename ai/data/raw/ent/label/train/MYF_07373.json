        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "망은 제가 깨끗이 청소를 자주 하는데요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.550
            },
            {
                "speaker_id": "1",
                "transcription": "아래 보면은 너무 지저분하잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.552,
                "end": 5.357
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 말끔하게 청소하는 방법 바로 과탄산소다입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.357,
                "end": 9.627
            },
            {
                "speaker_id": "1",
                "transcription": "이 과탄산소다 만 있으면은 말끔하게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.630,
                "end": 12.640
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 보통 이 속에 구멍을 막아갖고 보통 청소를 하는데요 이걸 막으불면 이 아래쪽에 보면은 호수에 묻어 있는 찌꺼기 이런 걸 이물질이 안 빠집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.640,
                "end": 25.382
            },
            {
                "speaker_id": "1",
                "transcription": "그것까지 빼려면은 여기 가운데 구멍 막지 말고 뜨거운 물 부은 다음에 과탄산소다만 부어주면은 아주 쉽게 청소할 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.382,
                "end": 34.487
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 보여 드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.490,
                "end": 36.237
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 여기 충분히 뜨거운 물을 부어주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.237,
                "end": 39.757
            },
            {
                "speaker_id": "1",
                "transcription": "네 뜨거운 물을 부어주고 여기 보시면은",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.760,
                "end": 44.010
            }
        ]
    },
    "summary": "한 셰프가 싱크대 배수구 청소를 하기 위해서는 먼저 뜨거운 물을 충분히 부어주고 과탄산소다를 이용할 거라고 이야기한다.",
