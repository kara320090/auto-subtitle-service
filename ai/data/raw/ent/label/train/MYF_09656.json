        "term": [
            {
                "speaker_id": "1",
                "transcription": "쟈스민이 더해진 매끄러운 태양빛을 받아서 영롱하게 투명하게 빛나는 그 물결들에서 반사되어져 나오는 그 빛을 품은 복숭아와 그리고 블랙 커런트 이런 과일 프루티한 애들까지도 만나실 수가 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 17.221
            },
            {
                "speaker_id": "1",
                "transcription": "이게 베이스 노트로 넘어가면은 샌달우드와 바닐라와 머스크가 합쳐진 그 노트들이 어느 정도 뭐랄까 그 깊이감을 더해주는 향이거든요.",
                "sound_type": [
                    2
                ],
                "start": 17.231,
                "end": 28.767
            },
            {
                "speaker_id": "1",
                "transcription": "앞에서 나왔던 향수들보다는 뚜렷하고 명백한 층을 이루고 있다 이렇게 생각하시면 될 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 28.777,
                "end": 36.270
            },
            {
                "speaker_id": "1",
                "transcription": "딥디크 롬브르단로 입니다.",
                "sound_type": [
                    2
                ],
                "start": 36.280,
                "end": 38.454
            },
            {
                "speaker_id": "1",
                "transcription": "딥디크 롬브르단로 경우는 정말 클래식이죠.",
                "sound_type": [
                    2
                ],
                "start": 38.464,
                "end": 41.765
            },
            {
                "speaker_id": "1",
                "transcription": "네 네 니치향수에 수능이 있다면 반드시 출제될 그런 향수이기도 합니다.",
                "sound_type": [
                    2
                ],
                "start": 41.775,
                "end": 47.159
            },
            {
                "speaker_id": "1",
                "transcription": "프루티 계열의 향수라고 할 때 정말 이.",
                "sound_type": [
                    2
                ],
                "start": 47.169,
                "end": 50.833
            }
        ]
    },
    "summary": "발화자는 클래식한 딥디크의 롬브로단로 향수의 특징에 대해서 설명하고 있는 영상이다.",
