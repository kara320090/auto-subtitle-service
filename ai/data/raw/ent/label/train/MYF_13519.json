        "term": [
            {
                "speaker_id": "1",
                "transcription": "참참 어디 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.137
            },
            {
                "speaker_id": "1",
                "transcription": "눈 똥글 우리 참이 친구들 그렇게 쫓아다니니까 살이 저렇게 빠졌죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.147,
                "end": 9.436
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 재밌는 건 노랑이도 은근 참이 옆에 온다는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.446,
                "end": 15.272
            },
            {
                "speaker_id": "1",
                "transcription": "참이를 피해서 어 정말 겁에 질려 도망가는 건 아니고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.282,
                "end": 21.362
            },
            {
                "speaker_id": "1",
                "transcription": "참이랑 조금씩 가까워지고 있는 것 같긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.372,
                "end": 26.359
            }
        ]
    },
    "summary": "노랑이도 참이를 무서워해서 도망가는 것은 아니라 은근 참이 옆으로 다가간다.",
