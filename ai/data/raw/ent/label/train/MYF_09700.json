        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.920
            },
            {
                "speaker_id": "1",
                "transcription": "향수 읽어주는 여자 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.920,
                "end": 3.070
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 공간계의 아이돌 @이름2 대표님을 모셨습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.070,
                "end": 8.029
            },
            {
                "speaker_id": "2",
                "transcription": "네, 감사합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.029,
                "end": 9.320
            },
            {
                "speaker_id": "2",
                "transcription": "네 저는 어반 플레이라는 회사를 2013년도 창업을 해서 지금 여기 보고 계시는 연남장이라는 공간을 대표적으로 운영을 하고 있고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.320,
                "end": 17.330
            },
            {
                "speaker_id": "2",
                "transcription": "어 제 연남 연희동에 한 8개 정도의 문화 복합 공간을 기획 운영을 하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.330,
                "end": 21.920
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 뭐 연남 방앗간이라든지 연희대 공원, 캐비닛 클럽 같은 공간 브랜드들을 만들고 운영을 하고 있고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.920,
                "end": 28.990
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 지역 단위로 에 좋은 크리에이터분들이나 소멸 브랜드 창업자분들하고 함께 에 지역 단위로 이런 것들을 기획하고 운영하고 하는 일들을 하고 있고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.990,
                "end": 39.160
            },
            {
                "speaker_id": "2",
                "transcription": "뭐 연희동에서 1년에 1번씩 저희 연희 걷다라는 이제 또 마을 축제 같은 것들도 기획을 해서 운영을 하고 있기도 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.160,
                "end": 45.080
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 뭐 기업들 에 기업들 그 마케팅이나 아니면 인제 컨설팅 공간 컨설팅 이런 일들도 하고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.080,
                "end": 53.430
            },
            {
                "speaker_id": "2",
                "transcription": "이제 요기 보이시는 이거 아는 동네 매거진이라고 하는데 이 매거진 지금 9번째 이제 전주 편이 최근에 나왔고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.430,
                "end": 59.710
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 아는 동네 매거진도 발행을 하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.710,
                "end": 62.680
            },
            {
                "speaker_id": "2",
                "transcription": "한 5년 정도 된 것 같은데요? 네",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.680,
                "end": 64.510
            },
            {
                "speaker_id": "1",
                "transcription": "네 저는 이태원 편에 필진으로 저 이태원의 향기에 대해서 썼었던 기억이 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.510,
                "end": 72.470
            },
            {
                "speaker_id": "2",
                "transcription": "저는 지방 도시를 더 되게 많이 다니고 해 세계 여행을 할 때도 약간 좋은 도시보다는 막 골목길 이런데 많이 다니다 보니까 그 냄새가 사실은 더 훨씬 인상적이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 72.470,
                "end": 81.854
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 제 인생에서 가장 기억에 남은 사실 향기라고 하면 이게 향기인지 냄새인지 모르겠으나 인도에 딱 도착했을 때 인도 델리에서 났던 냄새가 되게 많이 기억이 나고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 81.864,
                "end": 91.680
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 그때 그 인도 델리 안에 이제 델리역 앞에 파하르간지라는 골목이 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 91.680,
                "end": 95.998
            },
            {
                "speaker_id": "2",
                "transcription": "어떻게 보면 태국의 카오산로드 같은 곳인데 어 거기는 진짜 인도의 향신료 냄새랑 음식 냄새랑 그다음에 소똥 냄새 이런 것들 다 섞여 가지고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 96.000,
                "end": 105.710
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 담배도 워낙 그 나라 거기는 입담배 이런 거 많이 피니까 그런 냄새들이 섞여서 더 워낙 엄청 유니크한 냄새가 났고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 105.720,
                "end": 112.300
            }
        ]
    },
    "summary": "홍주석 대표님은 어반 플레이 회사를 창업하여 연남장, 8개의 문화 복합 공간의 운영과 크리에이터와 소멸 브랜드 창업자와 일을 하고 계시며 세계 여행으로 인도 델리에 갔을 때 파하르간지라는 골목을 갔었는데 그곳에서 향신료, 음식, 담배 냄새들이 섞여서 유니크한 냄새가 났다.",
