    },
    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            },
            {
                "speaker_id": "2",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 초보 때에 그런 경우 있어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.150
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 아 초록불이다 지나가야지 이랬는데 갑자기 노란불이 켜지니까 딱 서는 사람들이 있어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.160,
                "end": 7.707
            },
            {
                "speaker_id": "1",
                "transcription": "이게 초보 때 많이 하는 실수야.",
                "sound_type": [
                    2
                ],
                "start": 7.717,
                "end": 9.158
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지구 이미 신호가 바껴버려가지고 교차로 한 가운데 나만 고립 돼 있어.",
                "sound_type": [
                    2
                ],
                "start": 9.168,
                "end": 13.116
            },
            {
                "speaker_id": "1",
                "transcription": "겁내 무서워, 막 앞 뒤 옆으로 막 차 지나가.",
                "sound_type": [
                    2
                ],
                "start": 13.126,
                "end": 15.829
            },
            {
                "speaker_id": "1",
                "transcription": "나는 누구인가.",
                "sound_type": [
                    2
                ],
                "start": 15.839,
                "end": 17.634
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 교차로에 갇히지 않도록 신속하게 빠져 나가줘야 돼.",
                "sound_type": [
                    2
                ],
                "start": 17.644,
                "end": 21.768
            },
            {
                "speaker_id": "1",
                "transcription": "자, 사진 문제 한 가지 더 풀어 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.768,
                "end": 24.402
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 차량이 그 고정으로 인해서 이렇게 갓길에 서 있는 경우야.",
                "sound_type": [
                    2
                ],
                "start": 24.412,
                "end": 30.005
            },
            {
                "speaker_id": "1",
                "transcription": "그 사진이에요, 여러분.",
                "sound_type": [
                    2
                ],
                "start": 30.015,
                "end": 31.823
            },
            {
                "speaker_id": "1",
                "transcription": "자, 차량이 고장으로 인해 부득이하게 주차하는 경우 조치로 맞는 것 두 가지를 고르시오.",
                "sound_type": [
                    2
                ],
                "start": 31.833,
                "end": 38.221
            },
            {
                "speaker_id": "1",
                "transcription": "1 기어를 중립으로 놓는다, 2 견인에 대비해 주차 제동장치를 작동하지는 않는다, 3 조향장치를 도로의 가장자리 방향 그러니까 자동차에서 가장 가까운 쪽 가장자리 방향으로 돌려놓는다.",
                "sound_type": [
                    2
                ],
                "start": 38.231,
                "end": 55.140
            },
            {
                "speaker_id": "1",
                "transcription": "4 바퀴 방향을 11자로 나란히 놓는다, 5 경사의 내리막 방향으로 바퀴에 고임목을 설치한다, 약간 오르막길에서 비상정차를 한 경우에요.",
                "sound_type": [
                    2
                ],
                "start": 55.150,
                "end": 67.221
            },
            {
                "speaker_id": "1",
                "transcription": "자 정답은요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 67.231,
                "end": 68.415
            },
            {
                "speaker_id": "2",
                "transcription": "어 일단은 기어를 중립으로 두고요.",
                "sound_type": [
                    2
                ],
                "start": 68.425,
                "end": 71.932
            },
            {
                "speaker_id": "1",
                "transcription": "기어를 중립으로 둔다?",
                "sound_type": [
                    2
                ],
                "start": 71.942,
                "end": 73.845
            },
            {
                "speaker_id": "2",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 73.855,
                "end": 73.975
            },
            {
                "speaker_id": "1",
                "transcription": "그리고?",
                "sound_type": [
                    2
                ],
                "start": 73.985,
                "end": 74.651
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 견인에 대비해서 주차 제동 장치를 작동하지 않는다?",
                "sound_type": [
                    2
                ],
                "start": 74.661,
                "end": 79.472
            },
            {
                "speaker_id": "1",
                "transcription": "어, 자 봐.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 79.482,
                "end": 80.720
            },
            {
                "speaker_id": "1",
                "transcription": "지금 오르막인데 기어를 중립으로 두면 어떻게 될까?",
                "sound_type": [
                    2
                ],
                "start": 80.730,
                "end": 85.800
            }
        ]
    },
    "summary": "노란불이 켜져서 딱 서서 교차로 한 가운데에 고립되는 실수를 초보 때 많이 하는데, 교차로에 갇히지 않도록 신속하게 빠져 나가줘야 하고, 사진 문제 하나 더 풀어보는데 이번에는 차량이 고장으로 인해 갓길에 서 있는 경우에 부득이하게 주차하는 경우로 맞는 것을 고르는데 정답은 기어를 중립으로 두고, 견인에 대비해서 주차 제동장치를 작동하지 않는다고 답하자 오르막인데 기어를 중립으로 두면 어떻게 되냐고 묻는다.",
