        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 멋있는 무게감 있는 플로럴 루트를 찾고 계신다면은 이 향수 한번 도전해 보시길 바랄게요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.279
            },
            {
                "speaker_id": "1",
                "transcription": "누군가는 이 프랑지파니 향을 만나면요.",
                "sound_type": [
                    2
                ],
                "start": 7.290,
                "end": 10.030
            },
            {
                "speaker_id": "1",
                "transcription": "어 발리의 호텔 향과 같아요.",
                "sound_type": [
                    2
                ],
                "start": 10.030,
                "end": 12.600
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 생각을 또 하시는 분이 계실 거거든요.",
                "sound_type": [
                    2
                ],
                "start": 12.600,
                "end": 14.970
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 프랑지파니 그 느낌이 이제 강한 향을 가지고 있어서요.",
                "sound_type": [
                    2
                ],
                "start": 14.970,
                "end": 18.760
            },
            {
                "speaker_id": "1",
                "transcription": "그런 추억을 또 불러일으키실 수가 있으실 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 18.760,
                "end": 22.133
            }
        ]
    },
    "summary": "프랑지파니를 만나면 어떤 사람은 발리의 호텔 향과 같다고 생각을 할 수 있는데 워낙 프랑지파니의 향이 강한 향을 가지고 있기 때문에 추억을 불러일으킬 수도 있다.",
