        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "시간이 지나자 이렇게 맛있게 구워주셨고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.054
            },
            {
                "speaker_id": "1",
                "transcription": "4가지의 소스에 대해 설명해 주셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.064,
                "end": 5.221
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 말돈솔트는 제가 또 백과사전을 좀 찾아봤는데 영국 잉글랜드 엑식스 카운티 말돈 마을에서 나는 바다 소금이라고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.231,
                "end": 12.709
            },
            {
                "speaker_id": "1",
                "transcription": "저 소금이 찍어 먹으면 짜지가 않고 달달하니 너무 맛있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.719,
                "end": 16.650
            },
            {
                "speaker_id": "1",
                "transcription": "정말 고급스러운 소금 맛입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.660,
                "end": 18.253
            },
            {
                "speaker_id": "1",
                "transcription": "저 소금을 먹기 위해서라도 또 오고 싶었고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.263,
                "end": 20.460
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 두 번째께 파르미지아노 래지아노 치즈인데 저거는 이탈리아 북부에 위치한 파르마와 래지아노 에밀리아를 중심으로 생산되는 치즈라고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.470,
                "end": 29.866
            }
        ]
    },
