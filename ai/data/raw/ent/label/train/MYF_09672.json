        "term": [
            {
                "speaker_id": "1",
                "transcription": "하니엘다를 입력을 하시면 현금처럼 사용할 수 있는 4,000 원이 제공이 되어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.210
            },
            {
                "speaker_id": "1",
                "transcription": "가격이 정말 보면서 너무 좋아요.",
                "sound_type": [
                    2
                ],
                "start": 5.210,
                "end": 8.799
            },
            {
                "speaker_id": "1",
                "transcription": "지쿠 앱을 꼭 다운받으셔서 편안하게 즐겨 보시길 바랄게요.",
                "sound_type": [
                    2
                ],
                "start": 8.800,
                "end": 13.461
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 정말 이 무료 시향지는 너무 고마운 정말 서비스거든요.",
                "sound_type": [
                    2
                ],
                "start": 13.471,
                "end": 18.090
            },
            {
                "speaker_id": "1",
                "transcription": "꼭 이용해 보시기 바랄게요.",
                "sound_type": [
                    2
                ],
                "start": 18.080,
                "end": 20.050
            },
            {
                "speaker_id": "1",
                "transcription": "딥디크, 르라보, 바이레도, 산타마리아, 노벨라, 이솝, 조말론 이 6개 향수의 14가지 향수들을 리뷰를 해 보았습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.050,
                "end": 29.910
            },
            {
                "speaker_id": "1",
                "transcription": "여러분의 구독과 좋아요는 영상을 만드는 데 큰 힘이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 29.910,
                "end": 33.740
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 저는 이만 들어가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 33.740,
                "end": 36.020
            },
            {
