                    2
                ],
                "start": 6.058,
                "end": 17.288
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요, 그분들 워낙 따스함의 정말 따스함의 극치",
                "sound_type": [
                    2
                ],
                "start": 17.298,
                "end": 22.302
            },
            {
                "speaker_id": "1",
                "transcription": "네, 그래서 그게 너무 좋았던 것 같아요.",
