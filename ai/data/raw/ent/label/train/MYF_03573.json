        "term": [
            {
                "speaker_id": "1",
                "transcription": "비블로스는 향초로 출시가 되었고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.325
            },
            {
                "speaker_id": "1",
                "transcription": "커피와 시더의 향을 느낄 수가 있는 향이라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 2.335,
                "end": 5.791
            },
            {
                "speaker_id": "1",
                "transcription": "그 베니스 같은 경우에는 이렇게 여행 다니면서 정말 입기가 좋은 스프레이 분사 형태인데요.",
                "sound_type": [
                    2
                ],
                "start": 5.801,
                "end": 13.155
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 7.5밀리로 3개가 들어져 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 13.165,
                "end": 16.945
            },
            {
                "speaker_id": "1",
                "transcription": "이 베니스 향에 대해서 채소의 정원 이런 이야기도 적혀져 있었는데요.",
                "sound_type": [
                    2
                ],
                "start": 16.955,
                "end": 21.479
            },
            {
                "speaker_id": "1",
                "transcription": "어 정말로 전체적인 향의 인상이요 그린 그린함을",
                "sound_type": [
                    2
                ],
                "start": 21.489,
                "end": 26.633
            }
        ]
    },
    "summary": "비블로스는 향초로 출시가 되었는데 커피와 시더 향을 느낄 수 있고 베니스는 7.5밀리 스프레이 분사 형태로 향이 채소의 정원이라는 이야기도 있다.",
