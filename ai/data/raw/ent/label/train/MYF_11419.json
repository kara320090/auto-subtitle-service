        "term": [
            {
                "speaker_id": "1",
                "transcription": "얼굴이나 이렇게 맘에 들고 이런 거 보지도 않았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.234
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 대화나 한번 해볼까? 친구나 해볼까? 가벼운 마음이었어 근데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.244,
                "end": 5.965
            },
            {
                "speaker_id": "1",
                "transcription": "혹시 몇 살이에요? 나도 이제 내 나이 자각하는 거지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.975,
                "end": 8.756
            },
            {
                "speaker_id": "1",
                "transcription": "저 나이 되게 많아요 하니까 그분이 나이를 얘기해 주셨는데 저보다 7살이 어린 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.766,
                "end": 13.992
            },
            {
                "speaker_id": "1",
                "transcription": "미쳤나봐. 나 대학교 갈 때 걔 초6인거 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.002,
                "end": 17.256
            },
            {
                "speaker_id": "1",
                "transcription": "저는 그런 나이 차이를 좀 남이 어떻게 살든 상관은 없지만 이해는 못합니다.",
                "sound_type": [
                    2,
