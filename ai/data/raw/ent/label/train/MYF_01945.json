                    2
                ],
                "start": 0.000,
                "end": 5.411
            },
            {
                "speaker_id": "1",
                "transcription": "편하게 접근하기 좋은 또 향수니까요.",
                "sound_type": [
                    2
                ],
                "start": 5.421,
                "end": 8.668
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 한번 시도를 해 보시기를 바랄게요.",
                "sound_type": [
                    2
                ],
                "start": 8.678,
                "end": 11.637
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로 조말론이든 아쿠아 디 파르마든 아니면 르라보든 각 향수 브랜드에서 또 대표되는 향수들 있잖아요.",
                "sound_type": [
                    2
