        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 29.127
            },
            {
                "speaker_id": "1",
                "transcription": "@계정1 @이름1 입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.130,
                "end": 31.352
            },
            {
                "speaker_id": "1",
                "transcription": "미국에서 사시는 분들은 한국 음식 보통 어디서 구입을 하세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.362,
                "end": 35.205
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이번에 한국 제품을 판매하는 꽃마라는 사이트에서 대박 프로모션을 진행하는 소식을 들고 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.205,
                "end": 45.582
            },
            {
                "speaker_id": "1",
                "transcription": "회원 가입하시고 링크를 친구에게 보내면 이 친구가 회원가입을 하는 즉시 그 친구에게 20불 할인쿠폰이 주어지고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.582,
                "end": 57.430
            },
            {
                "speaker_id": "1",
                "transcription": "그 친구가 실제로 구입까지 할 경우에는 초대한 사람에게도 20불 할인 쿠폰이 나오는 대박 프로모션 소식을 들고 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.430,
                "end": 69.250
            },
            {
                "speaker_id": "1",
                "transcription": "아직 회원가입 안 하신 분들은 제가 그 영상 밑에 더 보기 란에 링크 남겨드릴 테니까 그곳을 통해서 회원가입을 하시면 20불 할인 쿠폰을 바로 받으실 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.250,
                "end": 83.042
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이번에 꽃마에서 협찬을 받아서 물건을 한 번 주문을 해봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.042,
                "end": 88.405
            },
            {
                "speaker_id": "1",
                "transcription": "내일 물건 받으면 또 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.407,
                "end": 94.000
            }
        ]
    },
