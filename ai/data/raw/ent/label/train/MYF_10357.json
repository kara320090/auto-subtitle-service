        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 좋은 향이 이제 발현되기가 좀 어렵고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.719
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 인제 커피 믹스 같은 경우에는 워낙 강력하고 지배적인 네 그런 그 화학 냄새와 이런 것들을 입안 가득히 네 정말로 찐득찐득하게 남겨 주기 때문에 네 잘 날 수가 없어요.",
                "sound_type": [
                    2
                ],
                "start": 3.729,
                "end": 21.282
            },
            {
                "speaker_id": "1",
                "transcription": "좋은 향을 가진 향수가 이렇게 삐집고 들어가기가 어렵거든요.",
                "sound_type": [
                    2
                ],
                "start": 21.292,
                "end": 26.097
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 항상 향수를 말씀드릴 때는 라이프 스타일이 굉장히 중요하다 그 말씀을 꼭 드려요.",
                "sound_type": [
                    2
                ],
                "start": 26.107,
                "end": 33.628
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 향수 이런 얘기를 하다 보면은 참 저를 많이 돌아 보게 되는 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 33.638,
                "end": 39.286
            },
            {
                "speaker_id": "1",
                "transcription": "나는 과연 내가 떠난 자리에서도 향이 좋은 사람으로 기억 이 되고 있는지 아니면 나의 생활 습관들이 이렇게 잘 만들어진 향이 잘 표현이 될 수 있는 그런 생활 습관을 내가 가지고 있는지 이런 생각 들을 많이 하게 되는 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 39.296,
                "end": 57.366
            }
        ]
    },
    "summary": "향수는 라이프 스타일이 굉장히 중요하다는 말을 꼭 한다.",
