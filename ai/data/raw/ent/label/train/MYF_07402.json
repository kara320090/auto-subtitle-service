        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와 이 물건들 한국에서 왔다고 하니까 진짜 더 반가운 거 있죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.445
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 아기 먹는 오가닉 우유 맛나는 과자예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.445,
                "end": 15.027
            },
            {
                "speaker_id": "1",
                "transcription": "생각보다 되게 크다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.027,
                "end": 16.387
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이거 되게 작을 줄 알았거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.387,
                "end": 19.487
            },
            {
                "speaker_id": "1",
                "transcription": "근데 생각보다 봉지가 되게 커요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.487,
                "end": 22.680
            },
            {
                "speaker_id": "1",
                "transcription": "같은 브랜드에서 나온 이거는 바나나 맛",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.682,
                "end": 27.910
            },
            {
                "speaker_id": "1",
                "transcription": "어완전 든든하다 어떡해.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.920,
                "end": 30.722
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 좋아하겠다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.722,
                "end": 32.353
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1는 지금 자고 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.363,
                "end": 33.412
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 제가 소곤소곤 말하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.412,
                "end": 36.800
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 안 깨우려고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.802,
                "end": 38.482
            },
            {
                "speaker_id": "1",
                "transcription": "잘 때가 사실 제일 아시죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.482,
                "end": 43.872
            },
            {
                "speaker_id": "1",
                "transcription": "다 공감하실 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.875,
                "end": 45.285
            },
            {
                "speaker_id": "1",
                "transcription": "잘 때가 제일 천사 같은 거",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.287,
                "end": 48.233
