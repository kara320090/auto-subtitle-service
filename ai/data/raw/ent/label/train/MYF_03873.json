        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니라고 생각을 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.320
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이제 여드름을 압출하는 그 한의원에서 한의사 선생님이 직접 이렇게 모공의 방향에 따라서 이렇게 압축을 해 주시는 그 원장님을 만나게 되었고요.",
                "sound_type": [
                    2
                ],
                "start": 1.330,
                "end": 10.836
            },
            {
                "speaker_id": "1",
                "transcription": "그 원장님이 지금 벌써 몇 년째지 전 여전히 네 다니고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 10.846,
                "end": 15.960
            },
            {
                "speaker_id": "1",
                "transcription": "원장님이 페이 닥터이실 때부터 그리고 지금 개원하셨는데 네 개원하신 곳도 이제 찾아서 가고 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 15.970,
                "end": 22.772
            },
            {
                "speaker_id": "1",
                "transcription": "여드름 압출을 제대로 해주실 수 있는 피부과 그리고 뭐 피부 관리실 그리고 한의원 이제 이런 곳들을 전문 기관을 찾으셔서 여드름 압출만 제대로 하셔도 그리고 여드름 압출을 하신 후에 자극받은 피부를 진정시켜줄 수 있는 수분 케어 그다음에 재생 케어 이런 거 확실하게 받으시고 제가 했던 거는 저는 그 관리를 거의 한 3년을 굉장히 집중적으로 했었어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.782,
                "end": 50.141
            },
            {
                "speaker_id": "1",
                "transcription": "1년 동안은 정말 집중했었어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 50.151,
                "end": 52.751
            },
            {
                "speaker_id": "1",
                "transcription": "모든 일에 최우선 순위를 여드름 피부를 내가 올해에는 바꾸겠다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 52.761,
