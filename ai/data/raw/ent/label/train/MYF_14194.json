        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "들고 들어오자마자 친구들이 이거 무엇에 쓰는 물건인고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.560
            },
            {
                "speaker_id": "1",
                "transcription": "엄마 이거는 어디에 쓰는 거예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.570,
                "end": 10.615
            },
            {
                "speaker_id": "1",
                "transcription": "호기심쟁이들이 모두 몰려들었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.625,
                "end": 13.946
            },
            {
                "speaker_id": "1",
                "transcription": "어 저희 아파트에는 공식적인 급식소가 2곳이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.956,
                "end": 20.273
            },
            {
                "speaker_id": "1",
                "transcription": "그 4동에서 9동까지 아파트 중에서 6동과 7동 뒤쪽에 어 모든 주민들이 알고 있고 또 경비 할아버지들과 함께 돌보는 길고양이 급식소가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.283,
                "end": 36.472
            },
            {
                "speaker_id": "1",
                "transcription": "예전에는 5동에도 함께 설치를 했었는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.482,
                "end": 40.940
            }
        ]
    },
    "summary": "한 여자가 본인의 아파트에는 2곳의 급식소가 있다고 말을 한다.",
