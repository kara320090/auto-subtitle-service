        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 이다음부터 설명드릴 향수들은요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.092
            },
            {
                "speaker_id": "1",
                "transcription": "이게 약간 기준이 될 거예요.",
                "sound_type": [
                    2
                ],
                "start": 2.102,
                "end": 3.641
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이걸 기준으로 아 얘보다 좀 더 명확해요.",
                "sound_type": [
                    2
                ],
                "start": 3.651,
                "end": 7.149
            },
            {
                "speaker_id": "1",
                "transcription": "얘보다 좀 더 진해요.",
                "sound_type": [
                    2
                ],
                "start": 7.159,
                "end": 8.285
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 인제 설명을 드릴 건데 아마 이 향수의 향을 아시는 분들이라면 좀 쉽게 상상하실 수 있으실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 8.295,
                "end": 14.969
            },
            {
                "speaker_id": "1",
                "transcription": "2번째 향수는요.",
