        "term": [
            {
                "speaker_id": "1",
                "transcription": "시루 나왔어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.602
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 탐색이 재미있어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.612,
                "end": 4.350
            },
            {
                "speaker_id": "1",
                "transcription": "시루야 아고 잘 올라간다. 아이고아이고아이고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.360,
                "end": 12.389
            },
            {
                "speaker_id": "1",
                "transcription": "이야 우리 시루 엄청 대단한데 어이구 시루 어디로 가게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.399,
                "end": 17.431
            },
            {
                "speaker_id": "1",
                "transcription": "시루 시루 어디 가야 돼 시루 방은 어디지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.441,
                "end": 23.142
            },
            {
                "speaker_id": "1",
                "transcription": "내 방은 어디지 엄마",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.152,
                "end": 26.449
            },
            {
                "speaker_id": "1",
                "transcription": "시루 어제 어디서 잤어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.459,
                "end": 28.821
            },
            {
                "speaker_id": "1",
                "transcription": "시루 어제 어디 있었지 우리 시루",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.831,
                "end": 31.770
            },
            {
                "speaker_id": "1",
                "transcription": "그루밍 하는 거야 아이 우리 시루 장하다. 내 방이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.780,
                "end": 40.540
            }
        ]
    },
    "summary": "시루가 바닥에 앉아서 그루밍을 하고 있다.",
