        "term": [
            {
                "speaker_id": "1",
                "transcription": "어느 수로에 나와 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.623
            },
            {
                "speaker_id": "1",
                "transcription": "수로 폭이 채 10미터도 되지 않는 아주 작은 수로입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.633,
                "end": 6.940
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이 자리에서는 낚시를 처음 해 보는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.950,
                "end": 9.764
            },
            {
                "speaker_id": "1",
                "transcription": "옥수수만 사용해서 어 탐사 낚시를 진행해 보려고 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.774,
                "end": 14.118
            },
            {
                "speaker_id": "1",
                "transcription": "이 수로 같은 경우에는 씨알이 작은 어 잔챙이들과 잡어들이 굉장히 많습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.128,
                "end": 20.449
            },
            {
                "speaker_id": "1",
                "transcription": "글루텐과 지렁이를 넣으면 찌를 가만두질 않거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.459,
                "end": 24.640
            },
            {
                "speaker_id": "1",
                "transcription": "옥수수만 사용해서 오늘 이곳에서 멋진 붕어 한번 만나볼 수 있도록 파이팅 해 보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.650,
                "end": 31.756
            },
            {
                "speaker_id": "1",
                "transcription": "날씨가 많이 덥네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.766,
                "end": 32.941
            },
            {
                "speaker_id": "1",
                "transcription": "지금 시작합니다.",
