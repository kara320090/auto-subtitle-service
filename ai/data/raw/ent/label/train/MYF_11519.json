        "term": [
            {
                "speaker_id": "1",
                "transcription": "원 2만 3천 원 정도에 판매를 하고 싶어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.060
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 설정을 하고 하면은 하나 판매돼서 3788원씩 들어온다.",
                "sound_type": [
                    2
                ],
                "start": 5.070,
                "end": 9.478
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 설정이 가능하고 홍보 승인을 요청을 해 놓고 하면은 이제 마이페이지에 홍보 승인 현황에 요런 식으로 승인 대기 중이다 나오다 보니까",
                "sound_type": [
                    2
                ],
                "start": 9.488,
                "end": 22.373
            },
            {
                "speaker_id": "1",
                "transcription": "승인된 후부터는 제 마이샵에서 판매는 되는 상품이라고 보시면 돼요.",
                "sound_type": [
                    2
                ],
