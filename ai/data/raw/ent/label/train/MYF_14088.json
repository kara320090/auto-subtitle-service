        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 쑥이진이 오늘은 어디로 구경갈 거예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.980
            },
            {
                "speaker_id": "1",
                "transcription": "꼬리는 여전히 현란스럽게 춤을 추고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.982,
                "end": 11.320
            },
            {
                "speaker_id": "1",
                "transcription": "이 자세만 봐도 알 수 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.320,
                "end": 13.837
            },
            {
                "speaker_id": "1",
                "transcription": "많이 편해졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.837,
                "end": 15.002
            },
            {
                "speaker_id": "1",
                "transcription": "바닥에 벌러덩 철퍼덕 저런 모습의 쑥이가 아니었는데 우리 쑥이진이가 요즘은 철퍼덕 벌러덩 많이 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.002,
                "end": 25.245
            },
            {
                "speaker_id": "1",
                "transcription": "안방에 그 침대 위에 이불 안에 누가 들어있더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.245,
                "end": 30.927
            },
            {
                "speaker_id": "1",
                "transcription": "보통 우리 유채가 그렇게 많이 들어가 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.927,
                "end": 34.452
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 유채인 줄 알고 유채야 했더니 누구였을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.452,
                "end": 38.595
            },
            {
                "speaker_id": "1",
                "transcription": "바로 바로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.595,
                "end": 40.073
            }
        ]
    },
    "summary": "쑥이가 많이 편해진 모습을 설명해 주고 있습니다.",
