                "speaker_id": "2",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "스파 갔다 왔어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.258
            },
            {
                "speaker_id": "1",
                "transcription": "그런 얘기 들은 적도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.268,
                "end": 2.974
            },
            {
                "speaker_id": "2",
                "transcription": "음 네, 충분히 그럴 수 있을 것 같아요 정말 스파 편안한 도시의 세련 된 스파에서 샤워를 할 수 있는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.984,
                "end": 11.590
            },
            {
                "speaker_id": "2",
                "transcription": "라이프 스타일을 가진 사람이라면 아마 여유로운 네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.600,
                "end": 15.710
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 향을 이렇게 바르고 왁 화낼 수 없을 것 같은 거 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.720,
                "end": 21.339
            },
            {
                "speaker_id": "2",
                "transcription": "어 화내는 보스가 있다면 이 향을 이렇게 딱 입히면은 네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.349,
                "end": 26.183
            },
            {
                "speaker_id": "2",
                "transcription": "이게 이렇게 그 돌리면서 롤 온을 하는 이게 보통 롤 온 제품들이",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 26.193,
                "end": 32.781
            },
            {
                "speaker_id": "2",
                "transcription": "하이 두식이",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 32.791,
                "end": 35.084
            },
            {
                "speaker_id": "2",
                "transcription": "원통형이어서 그립을 하기가 잡기가 좀 쉽지가 않은데 이게 딱 잡기가 너무 좋아서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.094,
                "end": 42.706
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 입는게 어 너무 좋네요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 42.716,
                "end": 45.776
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이거를 끝까지 써 봤잖아요 얘는 정말 새지 않아요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 45.786,
                "end": 50.210
            },
            {
                "speaker_id": "1",
                "transcription": "제가 모 브랜드 정말 유명한 브랜드인데 길게 생긴 게 에디션으로 나왔는데",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 50.220,
                "end": 55.907
            },
            {
                "speaker_id": "1",
                "transcription": "정말 막 질 질 질 흘러요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.917,
                "end": 58.908
            },
            {
                "speaker_id": "1",
                "transcription": "근데 얘는 정말 끝까지 안 흘러서 이것도 정말 오래",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.918,
                "end": 63.966
            }
        ]
    },
    "summary": "편안한 도시의 세련 된 스파에서 여유로운 느낌의 향을 설명하고 보통의 롤 온 제품은 원통형이어서 잡기가 쉽지 않은데 이 제품은 잡기가 좋고 새어 나오지 않는다.",
