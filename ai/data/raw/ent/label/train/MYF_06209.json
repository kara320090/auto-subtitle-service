                    2,
                    3
                ],
                "start": 6.671,
                "end": 12.455
            },
            {
                "speaker_id": "3",
                "transcription": "이거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.465,
                "end": 14.154
            },
            {
                "speaker_id": "3",
                "transcription": "안녕하세요.",
