                    2,
                    3
                ],
                "start": 15.207,
                "end": 15.997
            },
            {
                "speaker_id": "3",
                "transcription": "운전 중이니까 앞에 보고 얘기할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.007,
                "end": 18.695
            },
            {
                "speaker_id": "3",
                "transcription": "오늘은 유튜버들 모임이 있는 날이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.705,
                "end": 22.360
            },
            {
                "speaker_id": "3",
                "transcription": "같이 한 자리에 모여서 독서 문화의 확산과 출판 시장의 미래에 대해서 됐고요.",
