                    2
                ],
                "start": 0.000,
                "end": 3.106
            },
            {
                "speaker_id": "1",
                "transcription": "체고가 장난 아니다.",
                "sound_type": [
                    2
                ],
                "start": 3.116,
                "end": 4.711
            },
            {
                "speaker_id": "1",
                "transcription": "짧은 대에서 나온 녀석이라 손맛이 최고였습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.721,
                "end": 8.297
            },
            {
                "speaker_id": "1",
                "transcription": "좋다.",
                "sound_type": [
                    2
                ],
                "start": 8.307,
                "end": 9.592
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 촬영은 이대로 망하는 건가 싶었는데 밤새 기다리니까 한번 주네요.",
                "sound_type": [
                    2
                ],
                "start": 9.602,
                "end": 14.658
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이게 2.4칸에 나왔으니까 붕어가 굉장히 바로 앞에 연안까지 붙은 거죠.",
                "sound_type": [
                    2
                ],
                "start": 14.668,
                "end": 20.105
            },
            {
                "speaker_id": "1",
                "transcription": "다시 한번 기다려 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.115,
                "end": 22.276
            },
            {
                "speaker_id": "1",
                "transcription": "이제 4월인데 낚싯대도 얼고 글루텐도 얼고 손물도 얼었습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.286,
                "end": 30.345
            },
            {
                "speaker_id": "1",
                "transcription": "밤새 추위와 싸우면서 입질을 기다렸는데 결국에는 멋진 붕어로 보답받습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.355,
                "end": 37.886
            },
            {
                "speaker_id": "1",
                "transcription": "너무 기분 좋다.",
                "sound_type": [
                    2
                ],
                "start": 37.896,
                "end": 39.860
            },
            {
                "speaker_id": "1",
                "transcription": "한 마리만 더 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.870,
                "end": 41.916
            }
        ]
    },
