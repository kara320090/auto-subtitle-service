        "term": [
            {
                "speaker_id": "1",
                "transcription": "어제 만난 덩어리들입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.950
            },
            {
                "speaker_id": "1",
                "transcription": "오 아야야 체고가 너무 좋고 빵이 장난 아닙니다 진짜 실제로 보여드리지 못하는 게 좀 아쉽네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.950,
                "end": 19.710
            },
            {
                "speaker_id": "1",
                "transcription": "퇴근하고 낚시방에 맞습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.720,
                "end": 22.686
            },
            {
                "speaker_id": "1",
                "transcription": "아 덥다.",
                "sound_type": [
                    2
                ],
                "start": 22.696,
                "end": 25.420
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하십니까.",
                "sound_type": [
                    2
                ],
                "start": 25.434,
                "end": 26.680
            },
            {
                "speaker_id": "2",
                "transcription": "안녕하세요 잘지내세요?",
                "sound_type": [
                    2
                ],
                "start": 26.750,
                "end": 28.050
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하십니까?",
