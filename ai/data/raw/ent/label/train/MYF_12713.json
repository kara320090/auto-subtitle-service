                    2
                ],
                "start": 28.120,
                "end": 29.070
            },
            {
                "speaker_id": "3",
                "transcription": "아 일단 안녕하십니까 @이름1입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.080,
                "end": 33.424
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 아 몇 가지 소품들을 좀 사러왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.434,
                "end": 38.928
            },
            {
                "speaker_id": "1",
                "transcription": "목줄, 원줄 이제 원줄 2호 들어왔네요.",
