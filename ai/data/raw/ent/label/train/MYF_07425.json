        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 지금 일 마치고 퇴근하려고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.479
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 남편이 저녁에 레슨이 있어가지고 좀 서둘러서 집에 가려고요.",
                "sound_type": [
                    2
                ],
                "start": 6.489,
                "end": 11.340
            },
            {
                "speaker_id": "1",
                "transcription": "입사 첫날은 뭐 아시겠지만 멍 때리면서 하루가 지나가잖아요?",
                "sound_type": [
                    2
                ],
                "start": 11.350,
                "end": 17.707
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 별로 뭐 일은 많지 않고 그냥 가볍게 제가 해야 될 일들 좀 배우고 그냥 거의 대부분이 이제 혼자 공부하는 그런 시간을 가졌어요.",
                "sound_type": [
                    2
                ],
                "start": 17.705,
                "end": 32.687
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 어 긴 하루였습니다.",
                "sound_type": [
