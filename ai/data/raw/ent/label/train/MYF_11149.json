        "term": [
            {
                "speaker_id": "1",
                "transcription": "반대쪽도 똑같이 그냥 조여서 고정시켜 주면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.733
            },
            {
                "speaker_id": "1",
                "transcription": "요기 레버가 잘 안 돌아가면 저거 트렁크 문을 살짝 이렇게 조정을 하면서 하면 된다고 저도 배웠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.743,
                "end": 12.430
            },
            {
                "speaker_id": "1",
                "transcription": "배운 대로 하니까 다 되네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.440,
                "end": 14.652
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 요게 트렁크 후미등 있는데 양 볼트 요쪽이랑 반대쪽이랑 똑같이 풀러서 이제 요거 요거를 이제 그대로 또 껴주면 되는 거예요 그것만 하면 끝나는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.662,
                "end": 24.652
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 어려울 건 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.662,
                "end": 33.338
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 하면 빠지죠 별거 아니죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
