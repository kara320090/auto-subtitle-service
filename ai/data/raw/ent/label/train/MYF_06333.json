        "term": [
            {
                "speaker_id": "1",
                "transcription": "셋째 날 아점을 먹으러 가고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.870
            },
            {
                "speaker_id": "1",
                "transcription": "디 에잇이라는 레스토랑에 갈 건데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.870,
                "end": 5.010
            },
            {
                "speaker_id": "1",
                "transcription": "완전 기대되는 곳이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.010,
                "end": 7.240
            },
            {
                "speaker_id": "1",
                "transcription": "딤섬이 완전 이뻐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.240,
                "end": 12.700
            },
            {
                "speaker_id": "1",
                "transcription": "어 엘리베이터가 신기해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.700,
                "end": 15.770
            },
            {
                "speaker_id": "1",
                "transcription": "우 정말 멀리서 봐도 디 에잇이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.770,
                "end": 22.930
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.930,
                "end": 26.960
            },
            {
                "speaker_id": "1",
                "transcription": "지금 디 에잇 레스토랑 앞에서 대기하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.960,
                "end": 30.000
            },
            {
                "speaker_id": "1",
                "transcription": "저희가 11시 반 예약을 했는데 지금 한 11시 15분 정도가 됐거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.000,
                "end": 34.990
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 좀 기다리고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.990,
                "end": 36.680
            },
            {
                "speaker_id": "1",
                "transcription": "너무 기대돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.680,
                "end": 38.000
            },
            {
                "speaker_id": "1",
                "transcription": "여기 초밥이 진짜 막 금붕어 모양도 있고 장난 아니에요 비주얼이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.000,
                "end": 44.480
            },
            {
                "speaker_id": "1",
                "transcription": "제가 잘 찍어 갈게요.",
                "sound_type": [
                    2
                ],
                "start": 44.480,
                "end": 46.150
            },
            {
                "speaker_id": "1",
                "transcription": "먹고는 피셔맨스 와프라는 고 사진을 찍으면 되게 예쁘게 나온다는 곳에 갈 예정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.150,
                "end": 54.170
            },
            {
                "speaker_id": "1",
                "transcription": "시간 너무 빠르다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.170,
                "end": 58.000
            },
            {
                "speaker_id": "2",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2,
