        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러면서 여러분 프리지어 그 노란색 꽃을 기억하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.562
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 정말 비누 향처럼 은은하고 잔잔한 그런 입자가 고운 그런 향 분자를 여러분이 만나는 그 애들이 딱 여러분한테 아주 부드럽게 딱 안아주는 그런 느낌을 선사하는 향이죠.",
                "sound_type": [
                    2
                ],
                "start": 3.572,
                "end": 18.968
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서도 그 잔향으로 베이스 노트에 파촐리와 우디의 이런 느낌이 있어서 좀 더 세련된 잔향을 선사해요.",
                "sound_type": [
                    2
                ],
                "start": 18.978,
                "end": 26.775
            },
            {
                "speaker_id": "1",
                "transcription": "풀을 별로 많이 좋아하지 않으시고 그러나 너무 이렇게 향이 너무 없는 것도 싫으시는 그런 분들이",
                "sound_type": [
                    2
                ],
                "start": 26.785,
                "end": 34.800
            }
        ]
    },
    "summary": "파촐리와 우디의 느낌이 있어서 좀 더 세련된 잔향을 선사한다.",
