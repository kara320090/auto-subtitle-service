        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 나물이 맛있어 아구 아구 아구 잘 먹네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.470
            },
            {
                "speaker_id": "1",
                "transcription": "정말 아프니하고 나물이 봄이 뭉치는 정말 사이가 좋은 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.480,
                "end": 13.417
            },
            {
                "speaker_id": "1",
                "transcription": "뭉치는 주로 나물이를 많이 지켜주구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.427,
                "end": 17.730
            },
            {
                "speaker_id": "1",
                "transcription": "사실 아프니가 봄이를 많이 지켜줘요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.740,
                "end": 21.545
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 나물이를 아프니가 지켜 주고 있네요.",
