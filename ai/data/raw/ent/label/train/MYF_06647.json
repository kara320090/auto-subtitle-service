                ],
                "start": 0.000,
                "end": 12.023
            },
            {
                "speaker_id": "1",
                "transcription": "또 느끼하니까 김치도 한입 자 간장에 먹었으니까 요번에는 소금에도 찍어서 한입 아 소금이 짭짜름하고 맨날 펀집할 때 마다 너무 침이 고입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.033,
                "end": 27.589
            },
            {
                "speaker_id": "1",
                "transcription": "김치도 정말 맛있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.599,
                "end": 29.450
            },
            {
                "speaker_id": "1",
                "transcription": "아 따봉 흔드는 거 보이시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.460,
                "end": 31.387
            },
            {
                "speaker_id": "1",
                "transcription": "너무 맛있어서 따봉을 막 흔들게 됩니다.",
                "sound_type": [
                    2,
