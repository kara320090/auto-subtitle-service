        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 베스킨라빈스 스푼이 좀 필요해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.119
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 양념을 좀 퍼야 돼.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.129,
                "end": 7.417
            },
            {
                "speaker_id": "1",
                "transcription": "양념을 묻히기에는 너무 흐르니까 이렇게 양념을 퍼서 얹어 그리고 먹어.",
                "sound_type": [
