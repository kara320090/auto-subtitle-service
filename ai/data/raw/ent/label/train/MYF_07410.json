        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아기 식품뿐 아니라 이유식도 구 손수건 담요 등 여러 육아 용품과 음식 화장품 문구류 생활용품 패션잡화까지 판매하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.335
            },
            {
                "speaker_id": "1",
                "transcription": "아기 이것도 아기 것 아기 그 퓌레 이유식 퓌레입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.335,
                "end": 17.160
            },
            {
                "speaker_id": "1",
                "transcription": "고급 지게 생겼죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.170,
                "end": 19.108
            },
            {
                "speaker_id": "1",
                "transcription": "약간 유럽 너낌?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.118,
                "end": 21.514
            },
            {
                "speaker_id": "1",
                "transcription": "이 브랜드를 제가 인스타에서 많이 봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.524,
                "end": 24.662
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 한 번 이거 @이름1 줘보고 싶다 생각을 했었는데 여기서 안 팔잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.672,
                "end": 31.080
            },
            {
                "speaker_id": "1",
                "transcription": "여기서는 딱 그 이유식 하는 브랜드가 딱 정해져 있는 거 아시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.090,
                "end": 37.960
            },
            {
                "speaker_id": "1",
                "transcription": "버거에서 젤 많이 나오고 해피베이비 인가 거기서도 많이 나오고 근데 딱 정해져 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.970,
                "end": 44.018
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 마트에서 파는 게 그래서 좀 다양한 브랜드의 이유식을 좀 @이름 1에게 줘보고 싶었는데 뭐 부지런히 만들어 먹이는 게 제일 좋기는 하지만 바쁘다 바빠 현대사회에서 그게 쉽지는 않잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.028,
                "end": 59.236
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 전 솔직히 이유식도 그렇고 유아식 도 그렇고 좀 네 시판 이유식 많이 조금 활용을 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.246,
                "end": 68.948
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 이제 퓌레인데 @이름1 사실 퓌레 이유식은 다 땠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.958,
                "end": 74.271
            },
            {
                "speaker_id": "1",
                "transcription": "지금 거의 어른 음식을 거의 비슷하게 먹기 때문에 근데 아침 식사할 때 이제 오트밀에 요거 퓌레 조금씩 섞어주면은 좀 더 맛있게 먹을 수 있지 않을까 해가지고 한 번 구입을 해봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.281,
                "end": 87.470
            },
            {
                "speaker_id": "1",
                "transcription": "되게 포장도 예쁘게 생겼죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.480,
                "end": 89.941
            },
            {
                "speaker_id": "1",
                "transcription": "사과 랑 배 맛이고요 사과 고구마 사과랑 블루베리 퓌레 사과랑 단호박 퓌레입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.951,
                "end": 100.531
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해서 @사이트1에서 협찬받은 제품 200불어치 물건 언박싱을 마치겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.541,
                "end": 112.933
            }
        ]
    },
    "summary": "한 여자가 식품뿐 아니라 이유식도 구 손수건 담요 등 여러 육아 용품과 음식 화장품 문구류 생활용품 패션잡화까지 판매하고 있는 사이트에서 200불 원치 언박싱을 마치겠다고 한다.",
