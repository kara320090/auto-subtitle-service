        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 대는 다 접었습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 2.643
            },
            {
                "speaker_id": "1",
                "transcription": "어제 한 2시 반 정도까지 밤낚시를 하고 아침장을 보기 위해서 잠을 잤습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.653,
                "end": 10.961
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 6시부터 낚시를 다시 시작했는데 아침에는 계속 살치만 나오더라고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.971,
                "end": 16.760
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아침 붕어는 만나지 못 했습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.770,
                "end": 19.580
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 이곳 팔봉수로에서의 하룻밤 낚시를 마무리하려고 합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.590,
                "end": 23.292
            },
            {
                "speaker_id": "1",
                "transcription": "어제 낮에는 5에서 6미터 퍼세크의 바람이 불었고 밤에도 계속 바람이 불었습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 23.302,
                "end": 28.911
            },
            {
                "speaker_id": "1",
                "transcription": "지금 제가 앉은 자리 같은 경우에는",
                "sound_type": [
                    2
                ],
