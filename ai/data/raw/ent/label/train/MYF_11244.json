                ],
                "start": 11.949,
                "end": 12.918
            },
            {
                "speaker_id": "1",
                "transcription": "나도 그래서 핸드폰을 크게 틀고 뭐 보고 있었어 짜증나서",
                "sound_type": [
                    1,
                    2
