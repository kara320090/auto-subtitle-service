                    1,
                    2
                ],
                "start": 30.309,
                "end": 32.223
            },
            {
                "speaker_id": "1",
                "transcription": "얼른 먹고 인제 정리하고 들어가야 될 것 같애",
                "sound_type": [
                    1,
                    2
                ],
                "start": 32.233,
                "end": 34.689
            },
            {
                "speaker_id": "1",
                "transcription": "아따 비가 계속 오니까 설거지 하러 가기도 힘들겠는데 이거?",
                "sound_type": [
