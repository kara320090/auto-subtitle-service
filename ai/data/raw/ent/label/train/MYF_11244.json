                    1,
                    2
                ],
                "start": 17.754,
                "end": 19.178
            },
            {
                "speaker_id": "1",
                "transcription": "지금 밥 볶고 있었어",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.188,
                "end": 20.934
            },
            {
                "speaker_id": "2",
                "transcription": "어 알아 알아 알았어 얼른 먹어",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.944,
                "end": 23.499
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 내가 이따 다시 할게 음",
