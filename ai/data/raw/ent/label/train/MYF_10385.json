                    2
                ],
                "start": 14.942,
                "end": 15.918
            },
            {
                "speaker_id": "1",
                "transcription": "네 조금 생소하실 수 있을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 15.928,
                "end": 19.222
            },
            {
                "speaker_id": "1",
