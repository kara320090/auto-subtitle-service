                    2
                ],
                "start": 22.724,
                "end": 24.808
            },
            {
                "speaker_id": "2",
                "transcription": "네 저렴이 네 저 근데 바틀이 저는 사실 처음에는 르라보 어 어 깜짝 놀랐어요 처음 봐가지고 네",
                "sound_type": [
                    2
                ],
                "start": 24.818,
                "end": 33.673
            },
            {
                "speaker_id": "1",
                "transcription": "하다 보니까 이런 저렴이들이 판매를 하고 카피라고 할 수 있죠.",
                "sound_type": [
                    2
                ],
                "start": 33.683,
                "end": 38.932
            },
            {
                "speaker_id": "1",
                "transcription": "많이 달라요.",
