        "term": [
            {
                "speaker_id": "1",
                "transcription": "기다려 신호등 기다려야 돼.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.255
            },
            {
                "speaker_id": "1",
                "transcription": "색감이 확실히 뭔가 아이폰이 더 좋은 것 같애.",
                "sound_type": [
                    2
                ],
                "start": 1.265,
                "end": 5.232
            },
            {
                "speaker_id": "1",
                "transcription": "어두운 환경에서는 밝을 때는 색감이 비슷했는데 약간 조금 해가 안 들어오니까",
                "sound_type": [
                    2
                ],
                "start": 5.242,
                "end": 9.468
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1아 안돼 빨간불이야 기다려.",
                "sound_type": [
                    2
                ],
                "start": 9.478,
                "end": 11.498
            },
            {
                "speaker_id": "1",
                "transcription": "차 없어도 가면 안 돼.",
                "sound_type": [
                    2
                ],
                "start": 11.508,
                "end": 12.607
            },
            {
                "speaker_id": "1",
                "transcription": "어어 초록불이다.",
                "sound_type": [
                    2
                ],
                "start": 12.617,
                "end": 13.668
            },
            {
                "speaker_id": "1",
                "transcription": "가자 양 옆에 확인하고",
                "sound_type": [
                    2
                ],
                "start": 13.678,
                "end": 15.604
            },
            {
                "speaker_id": "2",
                "transcription": "손 들어.",
                "sound_type": [
                    2
                ],
                "start": 15.614,
                "end": 16.299
            },
            {
                "speaker_id": "1",
                "transcription": "손들고 손들고 옳지 손들고 야 돌밖에 안 됐는데 손도 들 줄 알아.",
                "sound_type": [
                    2
                ],
                "start": 16.309,
                "end": 21.224
            },
            {
                "speaker_id": "1",
                "transcription": "가자.",
