                "transcription": "달래한테 가봐 우리 노아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.375,
                "end": 50.004
            },
            {
                "speaker_id": "1",
                "transcription": "노아 달래가 신기한가 봐.",
