                "end": 25.183
            },
            {
                "speaker_id": "1",
                "transcription": "달래인 줄 알겠어 노아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.193,
                "end": 29.182
            },
            {
                "speaker_id": "1",
                "transcription": "어 노아 하고 다정이 뽀뽀한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.192,
                "end": 31.696
            },
            {
                "speaker_id": "1",
                "transcription": "노아야 너무 고마워.",
