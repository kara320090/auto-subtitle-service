        "term": [
            {
                "speaker_id": "1",
                "transcription": "피에르 프랑수아 파스칼 겔랑이 태어납니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.073
            },
            {
                "speaker_id": "1",
                "transcription": "약리학과 화학을 공부했고요.",
                "sound_type": [
                    2
                ],
                "start": 3.083,
                "end": 5.088
            },
            {
                "speaker_id": "1",
                "transcription": "약재사와 약사 자격증을 취득을 하게 된 피에르 겔랑은요.",
                "sound_type": [
                    2
                ],
                "start": 5.098,
                "end": 9.039
            },
            {
                "speaker_id": "1",
                "transcription": "1828년에 서른 살의 나이로 겔랑을 오픈하게 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 9.049,
                "end": 13.167
            },
            {
                "speaker_id": "1",
                "transcription": "정말 향을 잘 만드셨다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 13.177,
                "end": 15.812
            },
            {
                "speaker_id": "1",
                "transcription": "그 당시에 그 귀족들과 왕족들이 이제 주요 고객 들이었고요.",
                "sound_type": [
                    2
                ],
                "start": 15.822,
                "end": 20.433
            }
        ]
    },
    "summary": "피에르 프랑수아 파스칼 겔랑은 약리학, 화학을 공부했고 약재사, 약사 자격증을 취득한 뒤 1828년에 서른 살에 겔랑을 오픈하며 향을 잘 만들어 귀족, 왕족들이 주요 고객이었습니다.",
