        "term": [
            {
                "speaker_id": "1",
                "transcription": "떡국 같은 것도 떡국떡 되게 조금만 넣고 이렇게 국물 이렇게 약간 좀 넉넉하게 해가지고 그냥 먹고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.554
            },
            {
                "speaker_id": "1",
                "transcription": "음식 쓰레기가 이렇게 최대한 없도록 그렇게 했었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.564,
                "end": 10.963
            },
            {
                "speaker_id": "1",
                "transcription": "배달을 많이 안 시키다 보니까 평소에 나오던 것보다 많이 안 나와서 그러니까 뭐 너무 많이 쌓여 있으면 사실 좀 보기가 좀 그렇잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.973,
                "end": 19.459
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그런 게 그나마 좀 덜해서 좀 좋았던 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
