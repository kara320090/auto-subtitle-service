        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거는 남자 여자 다 써도 좋을 거 같애요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.031
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 이렇게 기분이 좋아지는 향?",
                "sound_type": [
                    2
                ],
                "start": 3.041,
                "end": 6.827
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 약간 풀 느낌도 있고 해 가지고 초록빛?",
                "sound_type": [
                    2
                ],
                "start": 6.837,
                "end": 11.082
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 좋다.",
                "sound_type": [
                    2
                ],
                "start": 11.092,
                "end": 13.428
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 내가 나도 쓰고 싶은데.",
                "sound_type": [
                    2
                ],
                "start": 13.438,
                "end": 16.005
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 다 잘 어울릴 것 같아 누구나 써도.",
                "sound_type": [
                    2
                ],
                "start": 16.015,
                "end": 18.954
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 상큼 약간 과일 느낌도 있고 풀 느낌도 있고.",
                "sound_type": [
                    2
