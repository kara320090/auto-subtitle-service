        "term": [
            {
                "speaker_id": "1",
                "transcription": "엄청나게 큽니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.321
            },
            {
                "speaker_id": "1",
                "transcription": "씨알이 커요.",
                "sound_type": [
                    2
                ],
                "start": 1.331,
                "end": 2.738
            },
            {
                "speaker_id": "1",
                "transcription": "보통 이제 우리가 이런 거 먹을 때 안주의 양이 작거나 부피가 작으면 실망인데 먹어보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.748,
                "end": 11.871
            },
            {
                "speaker_id": "1",
                "transcription": "자칫 느끼할 수 있는데 안에 알싸한 맛이 있다.",
                "sound_type": [
                    2
                ],
                "start": 11.881,
                "end": 14.660
            },
            {
                "speaker_id": "1",
                "transcription": "안주가 느끼하거나 아니면 매운 걸 잡아주는 그런 용도로 맥주가 딱이라고 생각하거든요.",
                "sound_type": [
                    2
                ],
                "start": 14.670,
                "end": 20.832
            },
            {
                "speaker_id": "1",
                "transcription": "이 안주는 일단 두 가지가 다 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.842,
                "end": 22.495
            },
            {
                "speaker_id": "2",
                "transcription": "일반 테라 맥주랑 달라요?",
                "sound_type": [
                    2
                ],
                "start": 22.505,
                "end": 25.125
            }
        ]
    },
    "summary": "한 남성이 크기가 큰 타코야끼가 알싸한 맛이 있어 맥주 안주로 딱이라고 말하고 있다.",
