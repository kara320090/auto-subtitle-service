                ],
                "start": 0.000,
                "end": 3.157
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키 밥 먹어 쿠키 밥 먹자 쿠키 밥 먹자 쿠키야 먹어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.167,
                "end": 9.858
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 개밥은 평생 내가 책임 질 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.868,
                "end": 12.728
            },
            {
                "speaker_id": "1",
                "transcription": "자기 알았어 몰랐어 웃지 말고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.738,
                "end": 14.787
            },
            {
                "speaker_id": "1",
                "transcription": "내가 자기한테 항상 얘기했지 사랑하는 자기는 개밥 같은 거 챙기지 말라고",
                "sound_type": [
