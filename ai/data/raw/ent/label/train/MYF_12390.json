        "term": [
            {
                "speaker_id": "1",
                "transcription": "지렁이 달아 놓으면 찌가 안 내려가고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.570
            },
            {
                "speaker_id": "1",
                "transcription": "옥수수를 달아 놔도 잔바리들이 엄청나게 덤비네요.",
                "sound_type": [
                    2
                ],
                "start": 2.580,
                "end": 5.427
            },
            {
                "speaker_id": "1",
                "transcription": "외래어종이 있는지는 잘 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.437,
                "end": 7.453
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 1박 낚시는 아니고 짬낚시를 할 건데 엄청난 거리를 짐빵 해서 들어왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.463,
                "end": 13.517
            },
            {
                "speaker_id": "1",
                "transcription": "방금 첫 수로 잉어 한 마리 만났고 오늘 이곳에서 멋진 붕어 만나볼 수 있도록 파이팅 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 13.527,
                "end": 21.165
            },
            {
                "speaker_id": "1",
                "transcription": "지금 시작합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.175,
                "end": 22.981
            }
        ]
    },
    "summary": "한 남성이 짬낚시로 붕어를 낚기를 기대하고 있다.",
