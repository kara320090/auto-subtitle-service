                ],
                "start": 0.000,
                "end": 11.851
            },
            {
                "speaker_id": "1",
                "transcription": "정면 살짝 좌측으로 수몰 나무가 있는데 저쪽이 좀 기대됩니다.",
                "sound_type": [
                    2
                ],
                "start": 11.861,
                "end": 16.513
            },
            {
                "speaker_id": "1",
                "transcription": "배 타고 오는데 사장님은 맹탕에서 나온다고 하시네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.523,
                "end": 19.456
            },
            {
                "speaker_id": "1",
                "transcription": "여기저기 찌를 잘 찔러 넣어 놨으니까 좋은 붕어 만날 수 있을 것 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.466,
                "end": 24.258
            },
            {
                "speaker_id": "1",
                "transcription": "수심도 딱 적당하네요.",
