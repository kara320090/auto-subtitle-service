        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 언젠간 가겠죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.594
            },
            {
                "speaker_id": "1",
                "transcription": "역병의 시기도 다 지나가겠죠?",
                "sound_type": [
                    2
                ],
                "start": 1.604,
                "end": 3.543
            },
            {
                "speaker_id": "1",
                "transcription": "현재 겔랑의 조향사는요.",
                "sound_type": [
                    2
                ],
                "start": 3.553,
                "end": 5.333
            },
            {
                "speaker_id": "1",
                "transcription": "티에리 바세 라는 조향사가 조향을 하고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.343,
                "end": 8.353
            },
            {
                "speaker_id": "1",
                "transcription": "겔랑 하나만 가지고도 진짜 몇 번의 이야기를 할 수 있을 정도로 진짜 많은 향들을 만들어 낸 곳이에요.",
                "sound_type": [
                    2
                ],
                "start": 8.363,
                "end": 15.503
            },
            {
                "speaker_id": "1",
                "transcription": "한국에서는 이제 너무나 좀 강렬하고 너무 무겁고 짙은 그런 향들이 좀 있다 보니 한국에 수입되지 않는 향수들이 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 15.513,
                "end": 24.906
            },
            {
                "speaker_id": "1",
                "transcription": "이 역병의 시기가 끝나고 여행을 가시게 되면은 네 꼭",
                "sound_type": [
                    2
                ],
                "start": 24.916,
                "end": 29.966
            }
        ]
    },
    "summary": "현재 겔랑의 조향사는 티에리 바세이고 향이 강렬하고 무겁고 짙다 보니 한국에 수입되지 않는 향들이 많이 있으니 역병의 시기가 끝나고 여행을 가게 되면 시향을 해보시기 바랍니다.",
