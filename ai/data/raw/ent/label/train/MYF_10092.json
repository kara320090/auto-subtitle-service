        "term": [
            {
                "speaker_id": "1",
                "transcription": "그땐 그래서 저는 가스레인지 되게 무서워해가지고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.774
            },
            {
                "speaker_id": "1",
                "transcription": "가스레인지는 없고 어 이렇게 간이 인덕션이라고 하나?",
                "sound_type": [
                    2
                ],
                "start": 4.784,
                "end": 11.211
            },
            {
                "speaker_id": "1",
                "transcription": "네 조그만한 거 그걸 활용하고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 11.221,
                "end": 15.287
            },
            {
                "speaker_id": "1",
                "transcription": "이제 그 의견이 분분한데 저는 올리브유를 열을 가하지 않는 걸 선호하거든요?",
                "sound_type": [
                    2
                ],
                "start": 15.297,
                "end": 22.684
            },
            {
                "speaker_id": "1",
                "transcription": "어 의견들이 좀 분분하더라고요?",
                "sound_type": [
                    2
                ],
                "start": 22.694,
                "end": 25.932
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 그냥 올리브유는 그대로",
