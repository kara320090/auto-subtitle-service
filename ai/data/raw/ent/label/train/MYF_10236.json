        "term": [
            {
                "speaker_id": "1",
                "transcription": "마법사가 된 기분이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.952
            },
            {
                "speaker_id": "2",
                "transcription": "자 이거 만지셔도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.962,
                "end": 3.080
            },
            {
                "speaker_id": "1",
                "transcription": "어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.090,
                "end": 3.673
            },
            {
                "speaker_id": "2",
                "transcription": "제가 아까 만져서 저런 식으로 옆에 꽃잎도 흩날리는 거거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.683,
                "end": 7.602
            },
            {
                "speaker_id": "1",
                "transcription": "아 저 루팡 소설 주인공 된 기분인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.612,
                "end": 23.416
            },
            {
                "speaker_id": "2",
                "transcription": "먹이사슬을 표현하는 중인데 지금 여기에는 나비랑 그다음에 뱀 도마뱀, 악어 같은 이런 동물이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.426,
                "end": 30.980
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 예를 들어서 나비를 뭐 도마뱀이 잡아먹고 뭐 개구리를 나비가 잡아먹고 이런 식으로 하면 그 개체가 사라져 버리거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.980,
                "end": 39.397
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 여기서 제일 상위에 있는 동물은 악어에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.407,
                "end": 42.935
            },
            {
                "speaker_id": "2",
                "transcription": "근데 그 악어를 잡아먹거나 죽일 수 있는 사람은 사람밖에 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.945,
                "end": 49.366
            }
        ]
    },
    "summary": "이 전시물은 나비, 도마뱀, 악어와 같은 동물의 먹이사슬을 표현하고 있다.",
