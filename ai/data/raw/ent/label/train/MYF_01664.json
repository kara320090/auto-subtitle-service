        "term": [
            {
                "speaker_id": "1",
                "transcription": "로즈프릭도 살짝 이렇게 따스하게 어, 가지고 있는 그 향의 그 결이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.788
            },
            {
                "speaker_id": "1",
                "transcription": "그거를 좀 느끼시기 좋을 거라고 생각을 합니다.",
                "sound_type": [
                    2
                ],
                "start": 5.798,
                "end": 9.389
            },
            {
                "speaker_id": "1",
                "transcription": "아 저는, 저는 이제 이게 너무 재밌더라고요, 그래서 앞으로 추천을 지피티챗이랑 함께 해야겠다.",
                "sound_type": [
                    2
                ],
                "start": 9.399,
                "end": 16.037
            },
            {
                "speaker_id": "1",
                "transcription": "이런 생각을 했고 여기에 제가 추가로 로즈의 그리고 또 머스크까지 좀 더 더해 가지고 추천해 달라.",
                "sound_type": [
                    2
                ],
                "start": 16.047,
                "end": 23.459
            },
            {
                "speaker_id": "1",
                "transcription": "이제 이렇게 제가 키워드를 변경을 했어요.",
                "sound_type": [
                    2
                ],
                "start": 23.469,
                "end": 26.533
            }
        ]
    },
