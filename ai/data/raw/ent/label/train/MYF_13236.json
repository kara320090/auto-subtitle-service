        "term": [
            {
                "speaker_id": "1",
                "transcription": "색깔이 이렇게 바뀌면서 아기로서 털도 케어해줘",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.524
            },
            {
                "speaker_id": "1",
                "transcription": "아기에게 따뜻한 바람도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.534,
                "end": 8.063
            },
            {
                "speaker_id": "1",
                "transcription": "물 많이 먹고 좀 쉬자",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.073,
                "end": 11.888
            },
            {
                "speaker_id": "1",
                "transcription": "우리 톨이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.898,
                "end": 13.532
            },
            {
                "speaker_id": "1",
                "transcription": "우리 밤톨이는요. 이제 저기 보이시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.542,
                "end": 19.557
            },
            {
                "speaker_id": "1",
                "transcription": "주사기로 맘앤 베이비하고 분유를 섞어서 급여를 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.567,
                "end": 26.067
            },
            {
                "speaker_id": "1",
                "transcription": "닦이고 보니까 몸이 너무 말라있어가지고 아유 너무 안쓰러워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.077,
                "end": 34.446
            },
            {
                "speaker_id": "1",
                "transcription": "이제 우리 밤톨이 따뜻한 드라이룸에 들어가서 좀 더 쉬게 하려고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.456,
                "end": 41.701
            },
            {
                "speaker_id": "1",
                "transcription": "어 그래 지금도 따뜻하지만 어 그래",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.711,
                "end": 46.960
            }
        ]
    },
    "summary": "톨이를 닦이고 보니까 몸이 너무 말라있다.",
