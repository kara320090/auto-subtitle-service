        "term": [
            {
                "speaker_id": "1",
                "transcription": "부산에서 아우디 촬영을 마무리하고 이젠 어딜 가냐면 전라도 광주로 갑니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 7.283
            },
            {
                "speaker_id": "1",
                "transcription": "전라도 광주에 제가 친한 언니가 돌잔치를 해요 애기.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.293,
                "end": 11.591
            },
            {
                "speaker_id": "1",
                "transcription": "돌잔치 사회를 보러 이제 광주로 넘어갑니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.601,
                "end": 14.955
            },
            {
                "speaker_id": "1",
                "transcription": "내일 사회라서 오늘 미리 넘어가서 자려고 하고요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 14.965,
                "end": 18.018
            },
            {
                "speaker_id": "1",
                "transcription": "돌잔치를 진짜 오랜만에 사회를 보는데 재밌을 것 같아요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 18.028,
                "end": 22.562
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1아 너 돌잡이 뭐 잡았었냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.572,
                "end": 24.824
            },
            {
                "speaker_id": "2",
                "transcription": "어 뭐요 뭐였지, 뭔 소리지 기억이 안 나지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.834,
                "end": 28.364
            },
            {
                "speaker_id": "1",
                "transcription": "그게 왜 기억이 안 나지 이렇게 막 사진 같은 게 분명히 있었던 것 같은데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.374,
                "end": 31.738
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 광주까지 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.748,
                "end": 34.012
            },
            {
                "speaker_id": "1",
                "transcription": "한 세 시간 정도 250키로 정도 가면 될 것 같아요 뿅.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.022,
                "end": 41.186
            },
            {
                "speaker_id": "1",
                "transcription": "자냐?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.196,
                "end": 43.741
            },
            {
                "speaker_id": "1",
                "transcription": "자네.",
