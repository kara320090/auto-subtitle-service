        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기가 살짝 들어가 있어서 만일에 물이 내려왔다 그러면 이 안에 고여서 얘를 빼서 바로 버릴 수 있는 그런 편리한 칼꽂이 입니다.",
                "sound_type": [
                    2,
