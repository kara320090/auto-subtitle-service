        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 좀 잘 이렇게 뭐 안 찔러 주셨나 보죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.866
            },
            {
                "speaker_id": "1",
                "transcription": "이제 조금 안 좋은 이야기들이 올라가서 그래서 그 이제 파직을 나중엔 당해요.",
                "sound_type": [
