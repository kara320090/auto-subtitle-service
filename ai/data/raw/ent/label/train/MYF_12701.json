                    2,
                    5
                ],
                "start": 33.126,
                "end": 34.616
            },
            {
                "speaker_id": "1",
                "transcription": "아침을 알리는 붕어입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.626,
                "end": 36.414
            },
            {
                "speaker_id": "1",
                "transcription": "자 집중해서 계속 낚시 이어가겠습니다.",
