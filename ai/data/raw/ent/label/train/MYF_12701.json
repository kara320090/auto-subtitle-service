                ],
                "start": 0.906,
                "end": 15.947
            },
            {
                "speaker_id": "1",
                "transcription": "자 정면에 적벽 48칸에서 나온 7치 붕어입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.957,
                "end": 21.851
            },
            {
                "speaker_id": "1",
                "transcription": "붕어가 아주 까맣습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.861,
                "end": 24.463
            },
            {
                "speaker_id": "1",
                "transcription": "하하하 어 2번 찌를 몸통까지 올렸는데 헛 챔질이 나고 어 세 번째 찌올림에 나왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.473,
                "end": 33.116
            },
            {
                "speaker_id": "1",
                "transcription": "아 붕어 참 멋있죠.",
