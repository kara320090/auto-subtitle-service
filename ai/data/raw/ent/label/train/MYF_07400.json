        "term": [
            {
                "speaker_id": "1",
                "transcription": "대박 퇴근한고 오니까 집 앞에 택배 박스가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.070
            },
            {
                "speaker_id": "1",
                "transcription": "한국에서 온 거예요.",
                "sound_type": [
                    2
                ],
                "start": 4.072,
                "end": 8.785
            },
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2
                ],
                "start": 8.787,
                "end": 9.442
            },
            {
                "speaker_id": "1",
                "transcription": "@계정1 @이름1 입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.442,
                "end": 11.834
            },
            {
                "speaker_id": "1",
                "transcription": "저희가 제품 협찬을 받았습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.844,
                "end": 14.995
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 오늘은 앞 광고에요 앞 광고.",
                "sound_type": [
                    2
                ],
                "start": 14.995,
                "end": 16.825
            },
            {
                "speaker_id": "1",
                "transcription": "원래 미국에서 살다 보면 한국 제품들이 그리울 때가 되게 많잖아요?",
                "sound_type": [
                    2
                ],
                "start": 16.825,
                "end": 21.901
            },
            {
                "speaker_id": "1",
                "transcription": "한국에서 물건을 배송받을 수 있는 사이트가 있다는 거 알고 계셨나요?",
                "sound_type": [
                    2
                ],
                "start": 21.911,
                "end": 27.180
            },
            {
                "speaker_id": "1",
                "transcription": "한국 쇼핑을 간편하게 항공 배송으로 안전하게",
                "sound_type": [
                    2
                ],
                "start": 27.180,
                "end": 31.157
            },
            {
                "speaker_id": "1",
                "transcription": "이게 박스가 한국에서 직접 날아온 물건입니다.",
                "sound_type": [
                    2
                ],
                "start": 31.160,
                "end": 36.104
            },
            {
                "speaker_id": "1",
                "transcription": "제가 한 번 뜯어보도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.114,
                "end": 38.315
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 언박싱영상이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.315,
                "end": 45.166
            }
        ]
    },
