                    2
                ],
                "start": 0.000,
                "end": 7.823
            },
            {
                "speaker_id": "1",
                "transcription": "아 조금 더 진하고 명확한 꽃이 존재하는구나.",
                "sound_type": [
                    2
                ],
                "start": 7.833,
                "end": 12.188
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 여러분이 느끼실 수가 있으실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 12.198,
                "end": 14.727
            },
            {
                "speaker_id": "1",
                "transcription": "따뜻한 동남아나 인제 이런 섬나라에 갔을 때 그곳에서 우리를 반겨주는 이국적인 꽃의 향의 느낌 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 14.737,
                "end": 22.697
            },
            {
                "speaker_id": "1",
                "transcription": "그 향의 느",
                "sound_type": [
                    2
                ],
                "start": 22.707,
                "end": 23.966
            }
        ]
    },
    "summary": "이그조티카 향수는 재스민, 네롤리, 로터스 같은 꽃 향이 나고 마치 섬나라의 이국적인 꽃 향의 느낌이 난다.",
