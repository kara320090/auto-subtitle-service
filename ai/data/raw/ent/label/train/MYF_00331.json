        "term": [
            {
                "speaker_id": "1",
                "transcription": "뒤돌아봐야 돼 전화할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.432
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 나보다 먼저 했겠는데 층도 안 알려주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.442,
                "end": 9.389
            },
            {
                "speaker_id": "2",
                "transcription": "네, @이름1님.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.399,
                "end": 10.399
            },
            {
                "speaker_id": "1",
                "transcription": "나 문밖이에요 문 열어주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.409,
                "end": 12.762
            },
            {
                "speaker_id": "2",
                "transcription": "아 네, 문 앞으로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.772,
                "end": 13.917
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.927,
                "end": 21.856
            },
            {
                "speaker_id": "1",
                "transcription": "우와 샌드박스는 화장실도 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.866,
                "end": 25.783
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 화장품도 있네 대박 와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.793,
                "end": 30.900
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 이것이 화장실 뷰 와.",
