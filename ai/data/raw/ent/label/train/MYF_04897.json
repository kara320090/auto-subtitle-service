    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "분사를 하고 난 다음엔요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.589
            },
            {
                "speaker_id": "1",
                "transcription": "아주 발향력이 좋거든요.",
                "sound_type": [
                    2
                ],
                "start": 1.599,
                "end": 3.175
            },
            {
                "speaker_id": "1",
                "transcription": "인간 방향제가 되셔서 네, 화장실에서 테이블 다시 걸어오는 동안 정말 파워워킹 네, 내 등 뒤에 보디가드가 한 11명 붙어있는 것처럼 자신 있게 딱 걸어오시면은 향이 자연스럽게 자연스럽게 그리고 기분 좋게 그렇게 기분 좋게 향을 상대방이 인지할 수가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 3.185,
                "end": 24.290
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 평소에 자주 입으시는 좋아하는 향수이거나 아니면은 여러분을 좀 그날의 여러분을 표현해 주는 향수 그리고 여러분이 조금은 그 향수에 대해서 아시는 게 좋다고 저는 생각을 해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.300,
                "end": 37.211
            },
            {
                "speaker_id": "1",
                "transcription": "오렌지 블라썸이라고 뭐, 오렌지 나무에 열리는 꽃이래, 그런 향이래, 상대방이 아마 그러겠죠.",
                "sound_type": [
                    2
                ],
                "start": 37.221,
                "end": 45.023
            },
            {
                "speaker_id": "1",
                "transcription": "오렌지 나무에 꽃도 열리는구나 그래서 어, 그런 가봐 하면서 그래서 조금 그런 꽃을 생각해 보면서 입게 되네? 내가 알면서 입는다는 그 점을 보여주시면 여러분도 잘 아시겠지만 향수는요.",
                "sound_type": [
                    2
                ],
                "start": 45.033,
                "end": 57.618
            },
            {
                "speaker_id": "1",
                "transcription": "기억을 잘 오래 남겨 주는 효과가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 57.628,
                "end": 60.878
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 여러분이 이용해 하셔야 되는 건 바로 여러분의 흔적을 남기는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 60.888,
                "end": 66.887
            },
            {
                "speaker_id": "1",
                "transcription": "이건 이제 클린 뷰티, 클린 퍼퓸이라고 해서요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.897,
                "end": 70.472
            },
            {
                "speaker_id": "1",
                "transcription": "뭐, 동물실험 같은 거 하지 않고 1792년부터 프랑스의 식물학에 대가로 불리우는 메종 루이 마리 향수인데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 70.482,
                "end": 78.342
            },
            {
                "speaker_id": "1",
                "transcription": "퍼포부아더발린코트 향 퍼퓸오일이라고 그래서요.",
                "sound_type": [
                    2
                ],
                "start": 78.352,
                "end": 81.888
            },
            {
                "speaker_id": "1",
                "transcription": "스프레이 타입이 아니라 이제 롤 온타입이라고 보시면 되세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 81.898,
                "end": 85.676
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 프라이빗하게 롤 온으로 즐길 수 있는 향수예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 85.686,
                "end": 90.175
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 이제 샌달우드, 시더우드, 너맥 이제 이런 향들이 굉장히 파우더리하고 시원하게 흩어지거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 90.185,
                "end": 98.498
            },
            {
                "speaker_id": "1",
                "transcription": "한국에서 남성분들 그리고 여성분들에도 많은 사랑을 받고 있는 르 라보의 샹탈이라든지 아니면은 크리드의 어벤투스라던지 이런 향수들 하고 약간 비슷하게 파우더리 하지만 시원하게 흩어지는 네, 그런 향을 선사하는 향수예요.",
                "sound_type": [
                    2
                ],
                "start": 98.508,
                "end": 115.342
            },
            {
                "speaker_id": "1",
                "transcription": "그 남자 그 여자의 물건에다가 향을 입히시면 되세요.",
                "sound_type": [
                    2
                ],
                "start": 115.352,
                "end": 119.047
            },
            {
                "speaker_id": "1",
                "transcription": "핸드폰 뒷면에다가 살짝 입혀주신다든지 그러면",
                "sound_type": [
                    2,
                    5
                ],
                "start": 119.057,
                "end": 126.233
            }
        ]
    },
    "summary": "아주 발향력이 좋아서 자신 있게 걸어오면 자연스럽게 상대방이 인지할 수가 있고 향수는 기억을 잘 오래 남겨 주는 효과가 있다. 메종 루이 마리 향수는 롤온으로 즐길 수 있는 향수는 파우더리 하지만 시원하게 흩어지는 향을 선사하는 향수이다.",
