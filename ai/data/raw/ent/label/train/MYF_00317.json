            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 그러니까는 저기에서 넣는데 우연치 않게 저렇게.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.000
            },
            {
                "speaker_id": "2",
                "transcription": "어 너무 약간 스타 라이트처럼 돼 가지고 여러분.",
                "sound_type": [
                    2
                ],
                "start": 3.000,
                "end": 6.300
            },
            {
                "speaker_id": "2",
                "transcription": "저는 이 부분도 상당히 마음에 들고요.",
                "sound_type": [
                    2
                ],
                "start": 6.300,
                "end": 8.642
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 레이 같은 경우에는 조수석에 보면 특이하게 이렇게 어 포켓이 오픈형으로 되어 있어요.",
                "sound_type": [
                    2
                ],
                "start": 8.650,
                "end": 15.944
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 여기에다가 피규어 같은 걸 놓으시는 분들도 많은데 여기 조명이 아예 없거든요.",
                "sound_type": [
                    2
                ],
                "start": 15.954,
                "end": 21.032
            },
            {
                "speaker_id": "2",
                "transcription": "요렇게 조명을 넣네요.",
                "sound_type": [
                    2
                ],
                "start": 21.042,
                "end": 22.503
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 22.513,
                "end": 23.110
            },
            {
                "speaker_id": "2",
                "transcription": "어 그리고 여기서 이렇게 연결 어 이것도 힘들지 않아요?",
                "sound_type": [
                    2
                ],
                "start": 23.117,
                "end": 27.250
            },
            {
                "speaker_id": "1",
                "transcription": "어 가운데가 조금 난이도가 좀 있더라고요.",
                "sound_type": [
                    2
                ],
                "start": 27.250,
                "end": 30.872
            },
            {
                "speaker_id": "1",
                "transcription": "보니까.",
                "sound_type": [
                    2
                ],
                "start": 30.880,
                "end": 31.567
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 여러분 이거 난 진짜 이거 꿀이라고 생각해.",
                "sound_type": [
                    2
                ],
                "start": 31.577,
                "end": 34.676
            },
            {
                "speaker_id": "2",
                "transcription": "어 레이 타시는 분들은 여기는 진짜 생각해 보세요.",
                "sound_type": [
                    2
                ],
                "start": 34.686,
                "end": 37.621
            },
            {
                "speaker_id": "2",
                "transcription": "여기에 엘이디를 넣었을 뿐인데 차 분위기도 예뻐졌지만 어 물건 찾기도 쉽고 직접 조명이 아니어서 사실 얘는 운전하다가 키면 눈 아프거든요.",
                "sound_type": [
                    2
                ],
                "start": 37.631,
                "end": 47.590
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 저는 이게 진짜 마음에 들더라고요.",
                "sound_type": [
                    2
                ],
                "start": 47.590,
                "end": 50.204
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 이곳 라인업의 야심작이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 50.214,
                "end": 54.530
            },
            {
                "speaker_id": "2",
                "transcription": "어 진짜 이거는 어 에쿠스 같은 좀 대형 세단 리무진 세단에서 보던 옵션인데 이게 또 레이로 왔네.",
                "sound_type": [
                    2
                ],
                "start": 54.530,
                "end": 64.040
            },
            {
                "speaker_id": "2",
                "transcription": "뭔지 궁금하시죠.",
                "sound_type": [
                    2
                ],
                "start": 64.050,
                "end": 65.016
            },
            {
                "speaker_id": "2",
                "transcription": "보여 드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 65.026,
                "end": 65.879
            },
            {
                "speaker_id": "2",
                "transcription": "뿅.",
                "sound_type": [
                    2
                ],
                "start": 65.889,
                "end": 66.358
            },
            {
                "speaker_id": "2",
                "transcription": "바로 요거.",
                "sound_type": [
                    2
                ],
                "start": 66.368,
                "end": 68.840
            },
            {
                "speaker_id": "2",
                "transcription": "B 필러 무드 등인데 이거요 다른 업체에서는 좀 못 봤던 거 같은데.",
                "sound_type": [
                    2
                ],
                "start": 68.840,
                "end": 74.089
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2
                ],
                "start": 74.099,
                "end": 74.388
            },
            {
                "speaker_id": "1",
                "transcription": "요거는 저희가 따로 금형 제작을 해가지고요.",
                "sound_type": [
                    2
                ],
                "start": 74.398,
                "end": 77.036
            },
            {
                "speaker_id": "1",
                "transcription": "아까도 말씀해 주셨던 것처럼 에쿠스 이제 리무진이나 약간 고급 세단에서 들어가는 이제 그런 B 필러 무드 등인데 특별히 주문 제작을 해서 이제 만들어서 엠비언트 할 때 서비스로 넣어 드려요.",
                "sound_type": [
                    2
                ],
                "start": 77.046,
                "end": 88.810
            },
            {
                "speaker_id": "2",
                "transcription": "오 심지어 이거는 금형 제작까지 한 건데 서비스야.",
                "sound_type": [
                    2
                ],
                "start": 88.820,
                "end": 92.016
            },
            {
                "speaker_id": "2",
                "transcription": "어 저는 솔직히 말해서 왜 유리가 작은 차들 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 92.020,
                "end": 96.315
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 실내 어두컴컴한 차들.",
                "sound_type": [
                    2
                ],
                "start": 96.325,
                "end": 98.513
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 나는 이 앞쪽 엠비언트는 좀 신경 쓰여하시는 분들은 이거 완전 추천.",
                "sound_type": [
                    2
                ],
                "start": 98.523,
                "end": 103.745
            },
            {
                "speaker_id": "2",
                "transcription": "어 1열 2열을 다 카버하고 은은하면서도 되게 고급스러워요.",
                "sound_type": [
                    2
                ],
                "start": 103.755,
                "end": 107.660
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 저는 이거 정말 마음에 들고요.",
                "sound_type": [
                    2
                ],
                "start": 107.660,
                "end": 109.755
            },
            {
                "speaker_id": "2",
                "transcription": "트렁크 등은 저처럼 레이 벤이라서 트렁크를 자주 사용 하는 분들한테는 필수고 이게 또 트렁크를 열면 켜지고 닫으면 또 꺼지더라고요.",
                "sound_type": [
                    2
                ],
                "start": 109.765,
                "end": 119.524
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 아마 좀 트렁크 공간 사용 많이 하시는 분들은 저거 알아보신 분들 되게 많을 것 같애요.",
                "sound_type": [
                    2
                ],
                "start": 119.534,
                "end": 124.841
            },
            {
                "speaker_id": "2",
                "transcription": "어 저것도 너무 유용했습니다.",
                "sound_type": [
                    2
                ],
                "start": 124.851,
                "end": 127.203
            },
            {
                "speaker_id": "2",
                "transcription": "여러분 어때요?",
                "sound_type": [
                    2
                ],
                "start": 127.213,
                "end": 127.970
            },
            {
                "speaker_id": "2",
                "transcription": "저 오늘 레이 엠비언트 성공한 것 같습니까?",
                "sound_type": [
                    2
                ],
                "start": 127.980,
                "end": 132.333
            }
        ]
