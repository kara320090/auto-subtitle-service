        "term": [
            {
                "speaker_id": "1",
                "transcription": "가겠다고 잘 안 먹네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.543
            },
            {
                "speaker_id": "1",
                "transcription": "우리 콩이 맛 없어도 먹어야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.553,
                "end": 4.942
            },
            {
                "speaker_id": "1",
                "transcription": "그래야 응가가 잘 나오지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.952,
                "end": 7.303
            },
            {
                "speaker_id": "1",
                "transcription": "응가만 잘 잡히면 우리 콩이 건강해질거야.",
