        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 친구는 라벤다라고 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.514
            },
            {
                "speaker_id": "1",
                "transcription": "라벤다는 노랑이, 까망이, 하양이 엄마와 어 한배에서 태어난 친구에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.524,
                "end": 9.383
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 먼저 태어났어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.393,
                "end": 12.084
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 노랑이, 까망이, 하양이가 태어났을 때 라벤다도 아기들을 놓고 그 아기들을 독립시켰죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.094,
                "end": 20.205
            },
            {
                "speaker_id": "1",
                "transcription": "노랑이, 까망이, 하양이가 집으로 오고 나서 바깥에 있는 친구들 밥을 챙겨주기 시작했죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.215,
                "end": 27.903
            },
            {
                "speaker_id": "1",
                "transcription": "그때 벤다가 저에게 다가왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.913,
                "end": 33.600
            }
        ]
    },
    "summary": "노랑이, 까망이, 하양이가 집으로 오고 나서 바깥에 있는 친구들 밥을 챙겨주기 시작한 그때 같은 엄마 배속에서 먼저 태어나 아기들을 놓고 독립시킨 라벤다가 다가왔어요.",
