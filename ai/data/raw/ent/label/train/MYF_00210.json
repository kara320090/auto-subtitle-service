        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 몇 명 있어요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.054
            },
            {
                "speaker_id": "1",
                "transcription": "애기 한 명 있어 얼마나 애국자예요 차 주분 진짜 응원 합니다 아이고 그 걸 생각을 해야 돼요 직장에서 일할 때는 가장이야 집에 들어가면 아빠야 그래도 운전대 잡을 때만큼은 남자 아닙니까.",
                "sound_type": [
                    2
                ],
                "start": 1.064,
                "end": 13.248
            },
            {
                "speaker_id": "1",
                "transcription": "우리 차주를 남자로 만드는 차량이라고 생각하시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 13.258,
                "end": 17.327
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 배기는요 커스텀 중통하고요 준비엘엔드 배기했구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.337,
                "end": 22.142
            },
            {
                "speaker_id": "1",
                "transcription": "어 번팁이구나 자 그리고 구조 변경은 완료를 했거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.152,
                "end": 26.155
            },
            {
                "speaker_id": "1",
                "transcription": "배기음 들어 보시죠.",
                "sound_type": [
                    2
                ],
                "start": 26.165,
                "end": 27.360
            }
        ]
    },
    "summary": "차주가 아이가 있어 애국자라고 얘기하고 커스텀 중통과 준비엘엔드 배기로 구조 변경 완료를 했다고 한다.",
