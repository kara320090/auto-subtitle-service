    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "와이프가 힘이 약하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.853
            },
            {
                "speaker_id": "1",
                "transcription": "제가 바로 오픈을 하고 안주로 나오는 과자의 맛을 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.863,
                "end": 7.921
            },
            {
                "speaker_id": "1",
                "transcription": "어 바삭바삭하고 정말 맛있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.931,
                "end": 9.824
            },
            {
                "speaker_id": "1",
                "transcription": "깔끔하게 이렇게 한 봉지씩 주니까 위생적으로도 좀 더 믿음이 가는 그런 느낌이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.834,
                "end": 14.846
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 또 사장님이 아이와 함께 왔다고 이렇게 귤도 하나씩 주셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.856,
                "end": 19.352
            },
            {
                "speaker_id": "1",
                "transcription": "와 서비스가 진짜 최고입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.362,
                "end": 21.440
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 주문한 안주가 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.450,
                "end": 23.275
            },
            {
                "speaker_id": "1",
                "transcription": "와 정말 푸짐하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.285,
                "end": 24.512
            },
            {
                "speaker_id": "1",
                "transcription": "전체적으로 보면은 치킨이 있고 오른쪽에는 샐러드가 있고 왼쪽에는 스테이크 고기와 새우 그리고 오징어튀김, 감자튀김, 소시지 그리고 치킨 무와 또띠아가 준비되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.522,
                "end": 36.836
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 요즘 유행하는 하이볼이 나왔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.846,
                "end": 39.241
            },
            {
                "speaker_id": "1",
                "transcription": "애플민트 하이볼과 밀회관 하이볼이 이렇게 감성적인 잔에 담겨서 준비되었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.251,
                "end": 46.066
            }
        ]
    },
    "summary": "화자가 안주로 주는 과자는 한 봉지씩 되어 있으니까 위생적이라 믿음이 가는 느낌이고 주문한 안주가 나왔는데 정말 푸짐했으며 하이볼 역시 감성적인 잔에 담겨 나왔다고 한다.",
