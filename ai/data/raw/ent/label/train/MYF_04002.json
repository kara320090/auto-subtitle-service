                    2
                ],
                "start": 6.750,
                "end": 13.600
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 다 재료가 준비가 되어서도 네, 이제 넣기만 하면 되는 걸로",
                "sound_type": [
                    2
                ],
                "start": 13.600,
                "end": 20.910
            },
            {
                "speaker_id": "1",
                "transcription": "브유를 팬에 두르라고 해서요 둘러보았습니다.",
