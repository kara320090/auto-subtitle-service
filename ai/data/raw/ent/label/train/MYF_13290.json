    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 우리 밤톨이 데리고 집으로 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.216
            },
            {
                "speaker_id": "1",
                "transcription": "밤톨이가 밖에서 지하실에서 어 있었던 친구라 일단은 목욕은 놔두고요. 몸도 지금 닦이지 않았어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.226,
                "end": 15.324
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 지금은 이렇게 드라이룸에서 따뜻한 온도로 따뜻하게 체온조절을 먼저 해주라고 하셔서 우리 유채왔어 어이",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.334,
                "end": 28.065
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 지금 다행히 집에 수유 임보하는 꼬물이들이 있어서 맘앤 베이비 캔하고 분유를 같이 섞어서 수분이랑 밥을 함께 섭취할 수 있도록 그렇게 주었어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.075,
                "end": 42.634
            },
            {
                "speaker_id": "1",
                "transcription": "아기가 많은 시간 굶었다면 딱딱한 것은 먹기 힘들것 같아서 지금 조금 묽은 농도로 줬어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.644,
                "end": 53.152
            },
            {
                "speaker_id": "1",
                "transcription": "이것을 먹고 좀 아기가 힘을 냈으면 좋겠어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.162,
                "end": 59.359
            },
            {
                "speaker_id": "1",
                "transcription": "밤톨이 하하하하 밤톨아 어이 우리 밤톨이",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.369,
                "end": 66.781
            },
            {
                "speaker_id": "1",
                "transcription": "어 먹어 괜찮아 하하하하하하 맛이 없어 그거는 맛 없는 거야 하하",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.791,
                "end": 78.099
            },
            {
                "speaker_id": "1",
                "transcription": "맛 없다고 덮는데요. 하하하",
                "sound_type": [
                    2,
                    5
                ],
                "start": 78.109,
                "end": 84.159
            },
            {
                "speaker_id": "1",
                "transcription": "야 호불호가 분명한데 우리 애기",
                "sound_type": [
                    2,
                    5
                ],
                "start": 84.169,
                "end": 86.874
            },
            {
                "speaker_id": "1",
                "transcription": "다른 걸 한번 대령해 볼까요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 86.884,
                "end": 89.813
            },
            {
                "speaker_id": "1",
                "transcription": "사료를 조금 갈아가지고 노랑이 나와보세요. 우리 애기 사료를 조금 갈아서 아니면 캔을 조금 주식캔을 조금 줘 볼까요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 89.823,
                "end": 102.145
            },
            {
                "speaker_id": "1",
                "transcription": "주식캔을 가지고 오겠습니다. 두 번째 음식 대령이요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 102.155,
                "end": 107.680
            }
        ]
    },
    "summary": "아기 고양이가 밥을 조금씩 먹고 있다.",
