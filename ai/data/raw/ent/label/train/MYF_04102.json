        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 생각을 하시면서요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.200
            },
            {
                "speaker_id": "1",
                "transcription": "처음부터 미르 그러니까 영어로 이제 머 라고 하는 몰약이 등장을 하구요.",
                "sound_type": [
                    2
                ],
                "start": 1.217,
                "end": 6.550
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 클로브가 함께 등장을 해요.",
                "sound_type": [
                    2
                ],
                "start": 6.570,
                "end": 8.642
            },
            {
                "speaker_id": "1",
                "transcription": "제가 향수 수업할 때 인제 보여드리는 그 향신료들이 있는데 향신료로 많이 쓰구요.",
                "sound_type": [
                    2
                ],
                "start": 8.652,
                "end": 14.078
            },
            {
                "speaker_id": "1",
                "transcription": "어 육류, 가공 된 육류들을 요리를 할 때 그 냄새를 없애기 위해서 사용하는 클로브",
                "sound_type": [
                    2,
