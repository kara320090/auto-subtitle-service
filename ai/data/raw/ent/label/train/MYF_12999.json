                    2,
                    5
                ],
                "start": 33.222,
                "end": 36.909
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 정말 나오길 잘했다는 생각이 듭니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.919,
                "end": 40.688
            },
            {
                "speaker_id": "1",
                "transcription": "최고의 힐링은 가족과 함께 하는 시간이죠.",
