                    5
                ],
                "start": 14.921,
                "end": 19.525
            },
            {
                "speaker_id": "1",
                "transcription": "한 손 한 손 여기 잡고 한 손 여기 잡어 그렇지.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.535,
                "end": 26.230
