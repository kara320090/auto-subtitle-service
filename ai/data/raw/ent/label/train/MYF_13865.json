        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 둘이 또 시작이예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.595
            },
            {
                "speaker_id": "1",
                "transcription": "노아야 어서 도망가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.605,
                "end": 4.912
            },
            {
                "speaker_id": "1",
                "transcription": "시루가 또 잡으러 갈거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.922,
                "end": 6.987
            },
            {
                "speaker_id": "1",
                "transcription": "오 여유 부리는 노아 정말 노아랑 시루도 좋은 친구죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.997,
                "end": 13.757
            },
            {
                "speaker_id": "1",
                "transcription": "노아가 이렇게 활발하게 된 것은 모두 친구들과의 관계 때문이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.767,
                "end": 21.801
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 시루라는 좋은 친구가 생겼기 때문이기도 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.811,
                "end": 27.791
            },
            {
                "speaker_id": "1",
                "transcription": "시루야 노아랑 앞으로도 즐겁게 놀아줘.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.801,
