        "term": [
            {
                "speaker_id": "1",
                "transcription": "베이컨 크림 떡볶이 안에는 이렇게 왕 베이컨이 들어있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.577
            },
            {
                "speaker_id": "1",
                "transcription": "떡볶이도 아주 실하게 들어가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.587,
                "end": 6.145
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러면 먼저 한입 오 엄청 쫄깃쫄깃하고 맛있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.155,
                "end": 16.021
            },
            {
                "speaker_id": "1",
                "transcription": "베이컨도 그러면 한입 음 음 오 진짜 맛있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.031,
                "end": 27.241
            },
            {
                "speaker_id": "1",
                "transcription": "이 떡볶이의 크림이 아주 부드러운 크림 파스타의 맛이 납니다.",
                "sound_type": [
                    2,
                    3
