        "term": [
            {
                "speaker_id": "1",
                "transcription": "이동할 때 사용할 수 있게 그런 손잡이가 안으로 패어 있네요 예 겉으로 튀어나오지 않게 되어있어요 그래서 조금 더 컴팩트한 사이즈를 만들기 위해서 그렇게 또 새로 업그레이드된 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 10.468
            },
            {
                "speaker_id": "1",
                "transcription": "제가 전에 본 것 보다 더 업그레이드가 됐네요 모양이 좀 틀려졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.478,
                "end": 14.772
            },
            {
                "speaker_id": "1",
                "transcription": "자 그렇고 뚜껑 한 번 열어보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.782,
                "end": 18.063
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 뚜껑을 열게 되면은 워터 펌프가 이렇게 나오고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.073,
                "end": 21.718
            },
            {
                "speaker_id": "1",
                "transcription": "일단 뭐 설명서가 있습니다 제품 구성품 이런 거 이런 거 확인해라 뭐 이런 게 있고요.",
                "sound_type": [
                    2,
