        "term": [
            {
                "speaker_id": "1",
                "transcription": "책에 내용의 배경이 되는 곳은 그라스가 맞고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.253
            },
            {
                "speaker_id": "1",
                "transcription": "영화는 그라스에서 촬영되지 않았어요.",
                "sound_type": [
                    2
                ],
                "start": 3.263,
                "end": 6.083
            },
            {
                "speaker_id": "1",
                "transcription": "스페인에서 촬영이 되었다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 6.093,
                "end": 7.784
            },
            {
                "speaker_id": "1",
                "transcription": "간단하게 그라스에 대해서 좀 알아봤는데요.",
                "sound_type": [
                    2
                ],
                "start": 7.794,
                "end": 10.862
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 다들 집에 계시고 저도 집과 스튜디오에만 이렇게 왔다 갔다 하다 보니 그냥 예전 사진들을 이렇게 들춰보다가 그라스에 대한 기억이 떠올라서 여러분하고 공유하고 싶어서 말씀드리게 되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.872,
                "end": 24.067
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지 향수 읽어주는 여자 @이름1였습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.077,
                "end": 27.180
            },
            {
                "speaker_id": "1",
                "transcription": "여러분의 좋아요와 구독은 영상을 만드는데 큰 힘이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 27.190,
                "end": 32.089
            },
            {
                "speaker_id": "1",
                "transcription": "고맙습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.099,
                "end": 35.700
            }
        ]
    },
    "summary": "책에 내용의 배경이 되는 곳은 그라스이고 영화는 스페인에서 촬영이 되었다고 한다. 예전 사진들을 들춰보다가 그라스에 대한 기억이 떠올라 공유하고 싶었다.",
