    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 선택해 주신 르네상스라는 트리트먼트는 총 40분 동안 러시하면 빼놓을 수 없는 향을 이용해서 진행될 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.674
            },
            {
                "speaker_id": "1",
                "transcription": "제가 먼저 소개할 때 향기 명상이라고 말씀을 드렸는데, 오늘 이 트리트먼트는 나의 호흡에 계속 집중하면서 테라피스트가 전하는 그 가벼운 느낌들에 굉장히 집중을 많이 하시게 될 거예요.",
                "sound_type": [
                    2
                ],
                "start": 8.684,
                "end": 24.453
            },
            {
                "speaker_id": "1",
                "transcription": "거기서 오는 편안함을 스스로 느끼면서 거기서 찾아오는 그 릴랙스를 온몸 가득히 느껴보실 수 있도록 도와드리는 트리트먼트입니다.",
                "sound_type": [
                    2
                ],
                "start": 24.463,
                "end": 34.248
            },
            {
                "speaker_id": "1",
                "transcription": "르네상스는 그래서 프랑스어로 재탄생, 부활이라는 뜻이에요.",
                "sound_type": [
                    2
                ],
                "start": 34.258,
                "end": 38.462
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이때 당시에는 의학이 오늘날만큼 많이 발전하지 않았기 때문에 향이 굉장히 중요했거든요.",
                "sound_type": [
                    2
                ],
                "start": 38.472,
                "end": 47.401
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 몸에 좋은 음식을 먹으면 영양분이 생기는 것처럼 좋은 향기를 맡으면 정신의 양분이 쌓인다고 생각했다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 47.411,
                "end": 57.289
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 공기의 질을 관리하는 게 굉장히 중요했고 나쁜 공기는 모든 병의 근원이라고 생각했다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 57.299,
                "end": 64.924
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 향수를 뿌리는 건 당연하고요.",
                "sound_type": [
                    2
                ],
                "start": 64.934,
                "end": 68.272
            },
            {
                "speaker_id": "1",
                "transcription": "향료를 태우거나 몸에 지니고 먹고 마시기까지 하면서 굉장히 향을 가까이 두면서 살았는데요.",
                "sound_type": [
                    2
                ],
                "start": 68.282,
                "end": 76.086
            },
            {
                "speaker_id": "1",
                "transcription": "서양에서도 한 가지 건강 학설이 있었는데 바로 4체액설이라는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 76.096,
                "end": 81.213
            },
            {
                "speaker_id": "1",
                "transcription": "이게 뭐냐면 사람을 포함한 모든 만물은 4가지 원소가 있다고 생각했는데요.",
                "sound_type": [
                    2
                ],
                "start": 81.223,
                "end": 87.475
            },
            {
                "speaker_id": "1",
                "transcription": "뜨겁고 차갑고 촉촉하고 건조하고 이렇게 4가지 원소가 모든 만물에 가지고 있고 이를 인체에 반영하게 되면 사람은 4가지 액체로 나눌 수 있다고 생각을 한 거예요.",
                "sound_type": [
                    2
                ],
                "start": 87.485,
                "end": 100.958
            },
            {
                "speaker_id": "1",
                "transcription": "이 액체의 비율에 따라서 나의 성격이나 성향과 같은 기질이 결정됐다고 생각했대요.",
                "sound_type": [
                    2
                ],
                "start": 100.968,
                "end": 107.534
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 자신의 기질을 알고 그 기질을 바탕으로 건강을 지켜야 한다는 게 바로 그 4체액설에서 주장하는 건강 학설이거든요.",
                "sound_type": [
                    2
                ],
                "start": 107.544,
                "end": 116.001
            },
            {
                "speaker_id": "1",
                "transcription": "제가 뒤쪽에서 르네상스 전용 시향지인 로즈콘을 가지고 왔는데요.",
                "sound_type": [
                    2
                ],
                "start": 116.011,
                "end": 120.815
            },
            {
                "speaker_id": "1",
                "transcription": "이 로즈콘을 제가 요 안에 향을 뿌려서 한번 향을 소개해 드릴 거예요.",
                "sound_type": [
                    2
                ],
                "start": 120.825,
                "end": 126.130
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째로 나의 원래 기질을 강화하고 싶다면 완벽함에 해당하는 네로를 통해서 진행하게 될 거고요.",
                "sound_type": [
                    2
                ],
                "start": 126.140,
                "end": 136.458
            },
            {
                "speaker_id": "1",
                "transcription": "나의 기질의 밸런스를 맞추고 싶다고 한다면 희망의 향인 프랜지패니를 이용해서 진행될 거예요.",
                "sound_type": [
                    2
                ],
                "start": 136.468,
                "end": 145.074
            },
            {
                "speaker_id": "1",
                "transcription": "그때 당시에 썼던 방독면이거든요.",
                "sound_type": [
                    2
                ],
                "start": 145.084,
                "end": 147.232
            },
            {
                "speaker_id": "1",
                "transcription": "의사들이? 근데 부리만 그냥 단순히 길게 만든 게 아니라 부리 끝에 굉장히 독한 향신료들을 많이 넣어놓고 그 향신료의 향을 맡았다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 147.242,
                "end": 157.402
            },
            {
                "speaker_id": "1",
                "transcription": "외부의 공기를 차단하고자 부리를 길게 만들었는데 거기서 착안해서 만들어진 게 바로 로즈 콘이거든요?",
                "sound_type": [
                    2
                ],
                "start": 157.412,
                "end": 164.244
            },
            {
                "speaker_id": "1",
                "transcription": "일단 네롤리 같은 경우에는 사람을 행복하게 해주는 세로토닌을 분비해 주는 효과가 있다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 164.254,
                "end": 171.173
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 내가 지금 그 향을 맡았을 때 뭔가 차분하고 편안해지는 게 바로 향이 주는 효과이기 때문에 그렇거든요.",
                "sound_type": [
                    2
                ],
                "start": 171.183,
                "end": 177.582
            },
            {
                "speaker_id": "1",
                "transcription": "이때 이 시기에는 장갑을 끼고 장갑에 향수를 뿌리는 게 유행이었대요.",
                "sound_type": [
                    2
                ],
                "start": 177.592,
                "end": 183.458
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 장갑은 가죽으로 만들었고 가죽은 무드지라는 과정에서 나는 역한 냄새를 가리기 위해서 향수를 뿌렸다고 하거든요?",
                "sound_type": [
                    2
                ],
                "start": 183.468,
                "end": 191.928
            },
            {
                "speaker_id": "1",
                "transcription": "그게 이 시기에 굉장히 크게 유행했는데, 이탈리아 네롤라 공국에 살고 있던 안나 마리아라고 하는 공주가 있었대요.",
                "sound_type": [
                    2
                ],
                "start": 191.938,
                "end": 199.961
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 공주는 그 시대에 사교계의 여왕이었거든요.",
                "sound_type": [
                    2
                ],
                "start": 199.971,
                "end": 203.812
            },
            {
                "speaker_id": "1",
                "transcription": "많은 파티에 그녀가 나타나 주기만을 바랐고 그녀가 나타나면 나는 향이 있었기 때문에 사람들은 향을 통해서 그녀의 등장을 알 수 있었다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 203.822,
                "end": 213.873
            },
            {
                "speaker_id": "1",
                "transcription": "그녀가 자신의 장갑에 뿌린 그 향이 굉장히 상큼한 향이었는데, 그녀를 대표하는 향이다 보니까 사람들이 그러면 이 향에 그녀의 이름을 지어주자고 했대요.",
                "sound_type": [
                    2
                ],
                "start": 213.883,
                "end": 225.879
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 안나 마리아라는 그녀의 이름보다 더 그녀를 높게 기리기 위해서 그녀가 살고 있던 나라인 네롤라 공국의 이름을 따와서 네롤리라고 이름을 지었다고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 225.889,
                "end": 237.441
            },
            {
                "speaker_id": "1",
                "transcription": "네롤리는 비터 오렌지꽃 오일이에요.",
                "sound_type": [
                    2
                ],
                "start": 237.451,
                "end": 240.392
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 굉장히 상큼한 향과 동시에 쌉싸름한 향도 갖고 있고 날카로운 루트를 가지고 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 240.402,
                "end": 246.134
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 페티그레인은 꽃의 가지와 줄기에 해당됩니다.",
                "sound_type": [
                    2
                ],
                "start": 246.144,
                "end": 252.066
            }
        ]
    },
