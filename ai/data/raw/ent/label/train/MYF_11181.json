                ],
                "start": 28.914,
                "end": 31.041
            },
            {
                "speaker_id": "1",
                "transcription": "제가 그동안 차박을 하면서 가장 고민을 했던 제품이 하나 있어요.",
                "sound_type": [
                    2,
