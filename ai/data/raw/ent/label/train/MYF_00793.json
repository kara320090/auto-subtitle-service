        "term": [
            {
                "speaker_id": "1",
                "transcription": "오케이 와 뭐야 하하하 와 아유 발갱이네.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 20.621
            },
            {
                "speaker_id": "1",
                "transcription": "정면 초강 몬스터 사공칸 붕어인 줄 알았는데 수염이있네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.631,
                "end": 26.432
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 녀석은 바로 보내주겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 26.442,
                "end": 31.058
            },
            {
                "speaker_id": "1",
                "transcription": "찌를 쭉 빨고 들어왔는데요. 발갱이었습니다. 나올 때는 붕어인가 했는데 수염이 달렸어요. 집중해서 좋은 붕어 한번 기다려 보겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 31.068,
                "end": 52.974
            },
            {
                "speaker_id": "1",
                "transcription": "우와. 정면. 초강 몬스터 32칸이고요 글루텐 먹고 아가 붕어 나왔습니다. 아 깔끔하게 생겼네요. 바로 보내주겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 52.984,
                "end": 73.948
            }
        ]
    },
    "summary": "글루텐을 먹고 나온 아기 붕어는 보내준다.",
