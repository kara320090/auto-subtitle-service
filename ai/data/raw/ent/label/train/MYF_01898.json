        "term": [
            {
                "speaker_id": "1",
                "transcription": "좀 더 명확하게 이해하기가 좋으실 것 같아서 그래서 한번 추천을 드려 봤습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.368
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 도움이 되셨기를 바라고요.",
                "sound_type": [
                    2
                ],
                "start": 5.378,
                "end": 8.141
            },
            {
                "speaker_id": "1",
                "transcription": "네, 영상이 도움이 되셨다면 구독과 좋아요, 부탁드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 8.151,
                "end": 11.886
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 만드는 데 큰 힘이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 11.896,
                "end": 14.025
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 저는 다음에 또, 네 다음에 영상을 만들도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.035,
                "end": 19.226
            },
            {
                "speaker_id": "1",
                "transcription": "짧게 만들려고 노력했습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.236,
                "end": 21.403
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 오늘도 향기로운 하루 되세요, 들어가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 21.413,
                "end": 24.892
            },
            {
                "speaker_id": "1",
                "transcription": "고맙습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.902,
                "end": 26.466
            }
        ]
    },
