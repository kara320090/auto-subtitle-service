        "term": [
            {
                "speaker_id": "1",
                "transcription": "더 어렵다고 생각을 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.537
            },
            {
                "speaker_id": "1",
                "transcription": "보통 마음가짐으로는 할 수 없을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 1.547,
                "end": 4.758
            },
            {
                "speaker_id": "1",
                "transcription": "조향만 하는 거와 이걸 가지고 사업을 한다는",
                "sound_type": [
                    2
                ],
                "start": 4.768,
                "end": 8.716
            },
            {
                "speaker_id": "1",
                "transcription": "내가 지금 하는 일에 대해서 즐거움을 찾을 수 있느냐 어 이 이것들이 사실 버티게 하는 가장 중요한 요소 중에 하나인 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 8.726,
                "end": 18.452
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요.",
                "sound_type": [
                    2
                ],
                "start": 18.462,
                "end": 19.711
            },
            {
                "speaker_id": "1",
                "transcription": "해도 되겠다 싶으면 하시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 19.721,
                "end": 22.039
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 사람도 하고 있으니 지금 준비하시는 분들은 더 잘하실 수 있어요.",
                "sound_type": [
                    2
                ],
                "start": 22.049,
                "end": 27.435
            },
            {
                "speaker_id": "1",
                "transcription": "국내와 함께 이제 미국에서 론칭한 스텔라 블랑이라는 브랜드고요.",
                "sound_type": [
                    2
                ],
                "start": 27.445,
                "end": 32.353
            },
            {
                "speaker_id": "2",
                "transcription": "스텔라 블랑.",
                "sound_type": [
                    2
                ],
                "start": 32.363,
                "end": 33.124
            },
            {
                "speaker_id": "1",
                "transcription": "네, 오너분께 허락을 받고 이제 소개를 하게 되었고요.",
                "sound_type": [
                    2
                ],
                "start": 33.134,
                "end": 38.419
            },
            {
                "speaker_id": "2",
                "transcription": "완전 여기 지금 프리미어 시사회.",
                "sound_type": [
                    2
                ],
                "start": 38.429,
                "end": 40.728
            },
            {
                "speaker_id": "1",
                "transcription": "이 중에서 이제 핸 첫 출시 작품이 핸드크림인데",
                "sound_type": [
                    2
                ],
                "start": 40.738,
                "end": 43.935
            },
            {
