        "term": [
            {
                "speaker_id": "1",
                "transcription": "달래 차지 할거다냥 달래 그랬어 요렇게 예쁘고 착한 달래가요 봉투에 대한 집착 만큼은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.709
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나답니다. 우리 예쁜 공주님 달래 어떤 봉투에 대한 집착을 보였는지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.719,
                "end": 16.001
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 한번 함께 보실까요 달래 달래 우리 달래 어 우리 유체도 왔어 달래랑 유체랑",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.011,
                "end": 36.789
            },
            {
                "speaker_id": "1",
                "transcription": "달래야 달래는 지금 보미가 봉투 속에 있는데도 계속 저렇게 긁고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.799,
                "end": 49.206
            },
            {
                "speaker_id": "1",
                "transcription": "보미를 똥으로 생각하는 걸까요 소중한 먹이로 생각하는 걸까요?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 49.216,
                "end": 55.488
            }
        ]
    },
    "summary": "여성이 달래와 보미에게 있었던 일을 말하고 있다.",
