        "term": [
            {
                "speaker_id": "1",
                "transcription": "짜잔.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.537
            },
            {
                "speaker_id": "1",
                "transcription": "어때요, 여러분?",
                "sound_type": [
                    2
                ],
                "start": 2.547,
                "end": 3.920
            },
            {
                "speaker_id": "1",
                "transcription": "테라스 공간이 굉장히 넓고요.",
                "sound_type": [
                    2
                ],
                "start": 3.930,
                "end": 7.032
            },
            {
                "speaker_id": "1",
                "transcription": "사실 날씨만 좋으면 이 테라스 공간에 테이블을 굉장히 많이 놓아서 한 3, 40분 정도는 편안하게 놀 수 있는 공간이 될 것 같고요.",
                "sound_type": [
                    2
                ],
                "start": 7.042,
                "end": 17.392
            },
            {
                "speaker_id": "1",
                "transcription": "이 바로 아래가 주차장이고 여기 이렇게 차가 이렇게 와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.402,
                "end": 22.239
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여기 앉아서 이렇게 차 오는 모습들도 볼 수 있고 오는 모습들도 찍을 수 있고 이래서 저는 이 공간도 되게 모임으로 많이 활용할 수 있지 않을까 어, 이 나무 테이블하고 나무 책상을 좀 더 개수를 많이 늘릴 계획이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.249,
                "end": 37.946
            },
            {
                "speaker_id": "1",
                "transcription": "날씨가 좋은 날 여기 이렇게 칠도 좀 해야겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.956,
                "end": 40.672
            },
            {
                "speaker_id": "1",
                "transcription": "자, 이렇게 해서 2층 공간 보셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.682,
                "end": 43.242
            },
            {
                "speaker_id": "1",
                "transcription": "3층으로 가시죠, 뿅.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.252,
                "end": 45.700
            }
        ]
    },
    "summary": "테라스 공간이 굉장히 넓어서 사람들이 편안하게 놀 수 있는 공간이 될 것 같다.",
