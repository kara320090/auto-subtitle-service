        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "주변에 조사님들이 밤이 돼야 입질이 들어올 거라고 하시는데 그게 맞나 봅니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.181
            },
            {
                "speaker_id": "1",
                "transcription": "지렁이도 조용하네요.",
                "sound_type": [
                    2
                ],
                "start": 5.191,
                "end": 6.649
            },
            {
                "speaker_id": "1",
                "transcription": "이제 글루텐도 준비해서 같이 넣어보도록 할 거고요.",
                "sound_type": [
                    2
                ],
                "start": 6.659,
                "end": 9.943
            },
            {
                "speaker_id": "1",
                "transcription": "바람만 안 불면 정말 좋을 것 같은데 바람이 이쪽에서 이렇게 계속 불어오고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 9.953,
                "end": 15.954
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이렇게 발이 잠긴 채로 수중전을 하고 있는데 장화가 여기 구멍이 났어요.",
                "sound_type": [
                    2
                ],
                "start": 15.964,
                "end": 22.913
            },
            {
                "speaker_id": "1",
                "transcription": "발로 물이 조금씩 스며들고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.923,
                "end": 25.454
            },
            {
                "speaker_id": "1",
                "transcription": "밤 되면 발이 꽤 시리겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.464,
                "end": 30.054
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 좋은 붕어 만나면 전부 다 해소될 수 있을 것 같고요.",
                "sound_type": [
                    2
                ],
                "start": 30.064,
                "end": 34.805
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이곳 화강 붕어 꼭 만나보고 싶네요.",
                "sound_type": [
                    2
                ],
                "start": 34.815,
                "end": 38.226
            },
            {
                "speaker_id": "1",
                "transcription": "파이팅 해보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 38.236,
                "end": 39.748
            }
        ]
    },
    "summary": "한 남성이 바람이 불고 있고 장화에 구멍이 났지만 붕어를 낚을 수 있기를 기대하고 있다.",
