        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고 화장실 들어가는 것도 아주 좋아하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.618
            },
            {
                "speaker_id": "1",
                "transcription": "오히려 처음에는 1층 화장실보다 2층 화장실을 더 좋아하는 거 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.628,
                "end": 10.103
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 사실 어 얘네가 1층을 쓰지 않는 게 아닐까 하고 조금 지켜봤죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.113,
                "end": 18.040
            },
            {
                "speaker_id": "1",
                "transcription": "그랬더니 한 설치하고 한 지금은 설치한 지 한 5일 정도가 지나고 있는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.050,
                "end": 24.963
            },
            {
                "speaker_id": "1",
                "transcription": "1층 화장실 2층 화장실 골고루 잘 사용을 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.973,
                "end": 30.276
            },
            {
                "speaker_id": "1",
                "transcription": "유채야 유채야 엄마가 화장실 보는 줄 알고 화장실에 들어가 주셨어요 우리 유채.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.286,
                "end": 40.551
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 불안하지 않고 안정감 있게 화장실을 잘 사용합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.561,
                "end": 47.847
            }
        ]
    },
    "summary": "처음에는 2층 화장실만 이용을 하다가 현재는 1층과 2층 골고루 잘 사용하고 있다고 한다.",
