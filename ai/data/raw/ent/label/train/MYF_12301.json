                    1,
                    2,
                    4
                ],
                "start": 23.361,
                "end": 24.411
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 예쁘죠?",
                "sound_type": [
                    2
                ],
                "start": 24.421,
                "end": 25.385
            },
            {
                "speaker_id": "1",
                "transcription": "자 낚시 이어가겠습니다.",
