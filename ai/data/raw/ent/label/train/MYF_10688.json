                    2
                ],
                "start": 23.955,
                "end": 29.192
            },
            {
                "speaker_id": "1",
                "transcription": "네 안 가본 데 가고 싶고 아시아 시즌 이거 되게 중요한 거기 때문에 제가 보여드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 29.202,
