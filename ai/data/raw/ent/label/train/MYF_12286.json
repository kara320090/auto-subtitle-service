        "term": [
            {
                "speaker_id": "1",
                "transcription": "대 편성 끝내고 글루텐을 꽤 넣었는데 아직까지 조용합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.910
            },
            {
                "speaker_id": "1",
                "transcription": "역시 배스, 블루길 모두 사는 외래 어종 터답고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 3.920,
                "end": 7.439
            },
            {
                "speaker_id": "1",
                "transcription": "어 그래도 한 번 나오면 좋은 녀석이 나오겠죠?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.449,
                "end": 10.969
            },
            {
                "speaker_id": "1",
                "transcription": "차분하게 기다려 보겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.979,
                "end": 13.272
            },
            {
                "speaker_id": "1",
                "transcription": "지금 바람도 불었다가 멈췄다가 하고 있고 하늘은 매우 흐립니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.282,
                "end": 19.363
            },
            {
                "speaker_id": "1",
                "transcription": "분위기가 폭풍 전야네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.373,
                "end": 21.362
            },
            {
                "speaker_id": "1",
                "transcription": "비 오기 전까지 좋은 붕어 한번 봐야 될 텐데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 21.372,
                "end": 23.843
            },
            {
                "speaker_id": "1",
                "transcription": "화이팅 해보겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 23.853,
                "end": 25.205
            },
            {
                "speaker_id": "1",
                "transcription": "정말 좋은 세상입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 25.215,
                "end": 30.821
            },
            {
                "speaker_id": "1",
                "transcription": "낚시터에서 배달을 먹다니 저녁 먹고 낚시 이어가 보겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 30.831,
                "end": 36.154
            },
            {
                "speaker_id": "1",
                "transcription": "뚜껑 한 번 열어볼까요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.164,
                "end": 37.850
            },
            {
                "speaker_id": "1",
                "transcription": "이게 소금 고기고 7분 7분 돼지찌개입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.860,
                "end": 42.855
            },
            {
                "speaker_id": "1",
                "transcription": "자 잘 먹겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.865,
                "end": 44.082
            },
            {
                "speaker_id": "2",
                "transcription": "잘 먹겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 44.092,
                "end": 45.601
            },
            {
                "speaker_id": "2",
                "transcription": "일주일 간 일주일.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 45.611,
                "end": 46.921
            }
        ]
    },
