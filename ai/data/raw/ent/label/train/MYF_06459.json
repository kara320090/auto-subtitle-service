        "term": [
            {
                "speaker_id": "1",
                "transcription": "분위기가 좋으니까 더 맛있다고 느껴졌을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.251
            },
            {
                "speaker_id": "1",
                "transcription": "정말 너무 맛있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.261,
                "end": 3.749
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 연어 샐러드입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.759,
                "end": 6.289
            },
            {
                "speaker_id": "1",
                "transcription": "연어 샐러드에서는 음 레몬의 향이 좀 난다 그럴까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.299,
                "end": 10.251
            },
            {
                "speaker_id": "1",
                "transcription": "아주 새콤달콤하면서 맛있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.261,
                "end": 12.902
            },
            {
                "speaker_id": "1",
                "transcription": "그 연어 샐러드도 양을 아낌없이 엄청 많이 준 게 느껴지죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.912,
                "end": 16.090
            },
            {
                "speaker_id": "1",
                "transcription": "요거는 대파 김치인데 들어보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.100,
                "end": 21.257
            },
            {
                "speaker_id": "1",
                "transcription": "아삭아삭하니 식감이 아주 좋았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.267,
                "end": 23.818
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 아무것도 안 찍고 순수하게 와사비만 얹어서 한 입",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.828,
                "end": 27.500
            }
        ]
    },
    "summary": "화자가 분위기가 좋아서 더 맛있게 느껴졌나 했으며 연어 샐러드에서는 레몬의 향이 나서 새콤달콤하면서 맛있었고 대파 김치 역시 식감이 아삭하니 좋았다고 한다.",
