        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "향은 눈에 안보이잖아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 1.569
            },
            {
                "speaker_id": "1",
                "transcription": "이 연기를 손으로 쓸어가면서 향을 맡아보시면 오늘 이 안에 블랜딩 되어있는 에센셜 오일의 향이 느껴지실 거예요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 1.579,
                "end": 11.195
            },
            {
                "speaker_id": "2",
                "transcription": "음.",
                "sound_type": [
                    2
                ],
                "start": 11.205,
                "end": 14.802
            },
            {
                "speaker_id": "1",
                "transcription": "그때 당시에는 향을 먹고 마신다고도 말씀드렸잖아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.812,
                "end": 20.218
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 티 한 모금 드실 건데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.228,
                "end": 22.618
            },
            {
                "speaker_id": "1",
                "transcription": "힘을 빼고 있다고 해도 어느 정도의 타이트함이 느껴지거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 22.628,
                "end": 26.413
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 똑같은 과정을 가장 마지막에도 똑같이 진행하는데 그때는 굉장히 자유로워지는 게 느껴져요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 26.423,
                "end": 32.986
            },
            {
                "speaker_id": "1",
                "transcription": "움직임이라든지 이런 부분에서 아 이게 완전히 풀렸구나라는 게 딱 느껴지거든요?",
                "sound_type": [
                    2
                ],
                "start": 32.996,
                "end": 38.772
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 마사지도 근육을 풀어주는 거지만 이렇게 내가 나의 몸을 집중하면서 나의 근육감각 굉장히 상세하게 의식하다 보면 아 이게 지금 짧아졌구나 내가 힘을 풀어야지 힘을 빼면서 늘어난다고 하면 여기서 주는 그 편안함도 완전히 다르거든요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 38.782,
                "end": 56.966
            },
            {
                "speaker_id": "1",
                "transcription": "알렉산더 테크닉이라고 하는 게 베이스로 들어가 있는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 56.976,
                "end": 61.070
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 이제 에프엠 알렉산더가 기계라든지 어떤 문명에 의해서 이 균형이 깨져버렸다고 생각해서요.",
                "sound_type": [
                    2
                ],
                "start": 61.080,
                "end": 68.474
            },
            {
                "speaker_id": "1",
                "transcription": "자신이 정말 거울만 있는 방어 들어가서 자기 몸의 균형만 계속 연구했다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 68.484,
                "end": 74.537
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 정말 가벼운 테크닉 정말 어떻게 화려한 테크닉이 아니라 정말 가벼운 테크닉으로 내 원래 몸의 균형을 찾을 수 있도록 도와드리는 거기 때문에 그중에 한 가지가 핸즈온이거든요?",
                "sound_type": [
                    2
                ],
                "start": 74.547,
                "end": 87.166
            },
            {
                "speaker_id": "1",
                "transcription": "제 손이 닿아있는 그 부분에 내가 집중하면서 테라피스트는 그 부분이 조금 더 편안하게 자세가 만들어질 수 있도록만 도와드리는 거고 나는 거기서부터 오는 그런 에너지를 느끼면서 힘을 빼는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 87.176,
                "end": 100.399
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 되면은 정말 나도 모르게 싹 이렇게 빠져드는 게 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 100.409,
                "end": 104.785
            },
            {
                "speaker_id": "1",
                "transcription": "그런 여유는 한번 경험하고 나면은 내가 집중하면 그게 점점 더 적용이돼요.",
                "sound_type": [
                    2
                ],
                "start": 104.795,
                "end": 111.536
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이건 진짜 저녁에 주무실 때라든지 그리고 명상 오늘 트리트먼트의 정말 전반적인 느낌 향기 명상처럼 정말 나만의 시간 온전히 갖고 어떻게 보면 오늘날 언택트때문에 계속 고립되고 나만의 시간을 계속 갖다보면 다들 고립이라는 표현을 쓰지만 저는 이건 정말 나만을 위한 온전한 시간이라고 저는 계속 생각을 하거든요 그래서 아 못 만",
                "sound_type": [
                    2
                ],
                "start": 111.546,
                "end": 138.966
            }
        ]
    },
    "summary": "알렉산더 테크닉은 가벼운 테크닉으로 몸의 균형을 찾을 수 있도록 도와준다.",
