        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "향수가 최초로 만들어졌을 때는 다양한 향료를 쓸 수가 없었는데 오늘 사용한 네롤리 같은 경우는 초창기 때 향수였던 보드콜용에 많이 쓰이던 원료여 가지고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.871
            },
            {
                "speaker_id": "1",
                "transcription": "이 향은 이제 그때 당시의 향수를 현대적으로 재해석한 하니님도 한 번쯤 분명히 보신 적이 있는 꽃입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.881,
                "end": 20.246
            },
            {
                "speaker_id": "1",
                "transcription": "하와이 여행을 가셨었거나 하와이 관련된 여행 정보를 보게 되면은 하와이 여인들은 머리에 꽂고 있는 풍성한 꽃이 있거든요?",
                "sound_type": [
                    2
                ],
                "start": 20.256,
                "end": 29.662
            },
            {
                "speaker_id": "1",
                "transcription": "그게 바로 프랑지파니예요.",
                "sound_type": [
                    2
                ],
                "start": 29.672,
                "end": 31.604
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 하와이에 도착하면 사람들이 환영의 의미로 꽃목걸이를 걸어주는데 그때 꼭 사용하는 꽃이 프랑지파니라고 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.614,
                "end": 39.411
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 꽃은 러브 하와이라는 애칭도 가지고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 39.421,
                "end": 43.065
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 꽃말이 당신을 만난 건 행운이라는 꽃말도 가지고 있다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 43.075,
                "end": 49.039
            },
            {
                "speaker_id": "1",
                "transcription": "굉장히 풍성한 꽃향기를 가지고 있기 때문에 딱 맡았을 때 내가 마치 꽃다발을 안고 있는 듯한 느낌이 느껴지는 향입니다.",
                "sound_type": [
                    2
                ],
                "start": 49.049,
                "end": 57.905
            },
            {
                "speaker_id": "1",
                "transcription": "한 명이 바로 프랑지파니라고 하는 후작이 있었는데 이 사람이 만든 그 향수가 너무나 인기가 많았기 때문에 사람들이 그 향수를 사기 위해 항상 기다렸다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 57.915,
                "end": 70.130
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 프랑지파니는 정작 자기 장갑에는 아몬드 향기가 나는 향수를 뿌렸다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 70.140,
                "end": 78.165
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그가 만든 향수가 너무나 사람들에게 사랑을 받았고 어느 날 시간이 조금 지나고 난 다음에 외딴섬에서 꽃이 하나 발견이 됐대요.",
                "sound_type": [
                    2
                ],
                "start": 78.175,
                "end": 88.744
            },
            {
                "speaker_id": "1",
                "transcription": "그 꽃의 향기가 너무 좋았던 거예요.",
                "sound_type": [
                    2
                ],
                "start": 88.754,
                "end": 90.857
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아직 이름이 지어지지 않았기 때문에 사람들은 이렇게 좋은 꽃향기를 가진 이 이름을 우리는 프랑지파니라고 하는 향기가 너무나 유명하기 때문에 그 이름을 지어주자고 해서 프랑지파니라고 이름을 지었다고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 90.867,
                "end": 110.533
            }
        ]
    },
    "summary": "프랑지파니라는 꽃의 이름은 향수로 유명했던 프랑지파니라는 후작의 이름에서 명명되었다.",
