        "term": [
            {
                "speaker_id": "1",
                "transcription": "오에 덕 라이스 꽥꽥 아프리칸 치킨 꼬끼오 아 이건 진짜 레알 치킨이네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.940
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지?",
                "sound_type": [
                    2
                ],
                "start": 10.940,
                "end": 11.330
            },
            {
                "speaker_id": "2",
                "transcription": "응.",
                "sound_type": [
                    2
                ],
                "start": 11.330,
                "end": 11.630
            },
            {
                "speaker_id": "1",
                "transcription": "밑에 오리 고기가 깔려 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.630,
                "end": 13.969
            },
            {
                "speaker_id": "1",
                "transcription": "이 소스에다가 이 밥을 먹으면 맛있대요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.970,
                "end": 17.340
            },
            {
                "speaker_id": "2",
                "transcription": "야, 야",
                "sound_type": [
                    2
                ],
                "start": 17.340,
                "end": 18.600
            },
            {
                "speaker_id": "1",
                "transcription": "닿았어 닿았어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.600,
                "end": 20.290
            },
            {
                "speaker_id": "2",
                "transcription": "아니 내가 다행히 내가 잘 막았어.",
                "sound_type": [
                    2
                ],
                "start": 20.290,
                "end": 21.610
            },
            {
                "speaker_id": "2",
                "transcription": "안 닿아 안 닿았어.",
                "sound_type": [
                    2
                ],
                "start": 21.610,
                "end": 22.340
            },
            {
                "speaker_id": "1",
                "transcription": "하나도 안 닿았어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.340,
                "end": 23.120
            },
            {
                "speaker_id": "1",
                "transcription": "고마워.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.120,
                "end": 29.040
            },
            {
                "speaker_id": "1",
                "transcription": "맛있다. 아프리카 치고는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.040,
                "end": 32.530
            },
            {
                "speaker_id": "1",
                "transcription": "요거 그냥 한국 치킨 맛인데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.530,
                "end": 34.340
            },
            {
                "speaker_id": "1",
                "transcription": "가기 싫어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.340,
                "end": 36.040
            },
            {
                "speaker_id": "2",
                "transcription": "다 구울까.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.040,
                "end": 37.640
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.640,
                "end": 39.340
            },
            {
                "speaker_id": "2",
                "transcription": "아 예스",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 39.340,
                "end": 45.160
            },
            {
                "speaker_id": "1",
                "transcription": "여기 너무 좋아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.160,
                "end": 45.970
            },
            {
                "speaker_id": "1",
                "transcription": "여기 진짜 제일 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.970,
                "end": 65.948
            },
            {
                "speaker_id": "1",
                "transcription": "와 너무 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.958,
                "end": 69.202
            }
        ]
    },
    "summary": "덕 라이스와 아프리칸 치킨을 시켰는데 맛있었고 원팰리스 호텔에서 진행하는 분수 쇼가 제일 좋았다.",
