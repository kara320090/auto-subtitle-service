        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 아가 두 번째도 마음에 안 들어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.627
            },
            {
                "speaker_id": "1",
                "transcription": "먹어본 적이 없는 것 같아요. 그래서 일단은 아기에게 강제로 좀 급식을 투여해야겠어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.637,
                "end": 11.929
            },
            {
                "speaker_id": "1",
                "transcription": "우리 아기 따뜻한 수건으로 조금만 닦자",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.939,
                "end": 15.505
            },
            {
                "speaker_id": "1",
                "transcription": "어우 예뻐",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.515,
                "end": 16.533
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 좀 먹어보자 어 엄마 수건 가져올게 기다려",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.543,
                "end": 20.291
            },
            {
                "speaker_id": "1",
                "transcription": "어 우리 화장실 가고 싶은 거야",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.301,
                "end": 23.091
            },
            {
                "speaker_id": "1",
                "transcription": "어 그래 나오고 싶어",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.101,
                "end": 25.744
            },
            {
                "speaker_id": "1",
                "transcription": "기운은 좀 차린 것 같네요. 따뜻한 바람 때문에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.754,
                "end": 28.827
            },
            {
                "speaker_id": "1",
                "transcription": "우리 아기 해보자 어",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.837,
