        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기에는 그 탄 탄산수",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.153
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 뭐 물티슈 같은 거 뒀고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.163,
                "end": 5.265
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음 추천템은 음식물 쓰레기통",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.275,
                "end": 8.715
            },
            {
                "speaker_id": "1",
                "transcription": "이게 2리터 봉지가 들어가는 건데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.725,
                "end": 12.060
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 이게 밀폐가 되는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.070,
                "end": 15.187
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보시면은 푸시하라고 나오죠 지금",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.197,
                "end": 17.834
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 열고 걱정하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.844,
                "end": 20.852
            },
            {
                "speaker_id": "1",
                "transcription": "안에 깨끗한 봉지로 바꿔 놨어요.",
                "sound_type": [
                    2,
