        "term": [
            {
                "speaker_id": "1",
                "transcription": "아기를 이렇게 빠는 건 배가 고프다기보다는 이제 그거죠 엄마 젖 먹던 습관이 남아서 뭐든 빠는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.045
            },
            {
                "speaker_id": "1",
                "transcription": "우리 갓난 아기들도 손가락 빨고 하는 것처럼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.055,
                "end": 13.860
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 또 이제 다음 주쯤에는 이제 유치가 이제 날 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.870,
                "end": 19.093
            },
            {
                "speaker_id": "1",
                "transcription": "콩이 발봐 아이 귀여워 발가락도 너무 귀여워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.103,
                "end": 23.706
            },
            {
                "speaker_id": "1",
                "transcription": "콩아 엄마한테 오는 거야 엄마한테 오는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.716,
                "end": 27.165
            },
            {
                "speaker_id": "1",
                "transcription": "엄마한테 오는 거야 아직은 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.175,
                "end": 32.541
            },
            {
                "speaker_id": "1",
                "transcription": "콩이 이제 들어가자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.551,
                "end": 35.160
            }
        ]
    },
    "summary": "콩이가 엄마 젖 먹던 습관이 있어 빠는 거고 다음주 쯤에 유치가 날거라고 한다.",
