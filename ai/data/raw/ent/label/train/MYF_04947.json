        "term": [
            {
                "speaker_id": "1",
                "transcription": "1등은 제가 강의 때도 여쭤보면은 많은 분들이 예상을 하세요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.419
            },
            {
                "speaker_id": "1",
                "transcription": "지금도 딱 떠오르시는 그 향이 있으실 건데 바로 그게 맞을 거 같아요.",
                "sound_type": [
