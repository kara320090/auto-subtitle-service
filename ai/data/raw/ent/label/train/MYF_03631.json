        "term": [
            {
                "speaker_id": "1",
                "transcription": "약간 꿀 향이 흐르는 꽃 향이라고 생각해 주시면 될 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.340
            },
            {
                "speaker_id": "1",
                "transcription": "태양빛처럼 좀 따뜻한 따스함을 가지고 있을 것 같은 그런 꽃 향이라고 생각해 주시면 더 좋을 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 4.350,
                "end": 12.234
            },
            {
                "speaker_id": "1",
                "transcription": "누군가는 좀 밀키한 느낌으로도 느끼실 수가 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 12.244,
                "end": 16.469
            },
            {
                "speaker_id": "1",
                "transcription": "전체적으로 좀 따스한 노란 빛의 햇볕이 좋은 날 이렇게 손을 이렇게 딱 대면은 왜 피부가 따스해지잖아요.",
                "sound_type": [
                    2
                ],
                "start": 16.479,
                "end": 25.584
            },
            {
                "speaker_id": "1",
                "transcription": "그런 온도감을 만나기에 좋은 향수라고 저는 생각을 하거든요.",
                "sound_type": [
                    2
                ],
