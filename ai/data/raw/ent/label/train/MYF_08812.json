        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 유채도 노랑이도 오늘 배운 거 연습하는 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 32.536
            },
            {
                "speaker_id": "1",
                "transcription": "주원이 누나가 가르쳐 준 거 연습하는 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.546,
                "end": 35.943
            },
            {
                "speaker_id": "1",
                "transcription": "우와 정말 대단하네.",
