        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 밀려오네요. 야 저런 녀석 걸림면 초초초초대박인데",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.339
            },
            {
                "speaker_id": "1",
                "transcription": "아홉 치라도 한 마리 좀 나와라",
                "sound_type": [
                    2
                ],
                "start": 7.349,
                "end": 10.808
            },
            {
                "speaker_id": "1",
                "transcription": "바람이 남서풍이 불구나 그러다 보니까 저수지에 부유물들이 다 저쪽으로 떠내려왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 10.818,
                "end": 17.936
            },
            {
                "speaker_id": "1",
                "transcription": "제일 기대하고 있는 36칸 저기가 좀 부유물이 너무 많아서요.",
                "sound_type": [
                    2
                ],
                "start": 17.946,
                "end": 22.710
            },
            {
                "speaker_id": "1",
                "transcription": "어 맨 우측으로 좀 옮기겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 22.720,
                "end": 25.065
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 보니까 요 발 밑에서 참붕어들이 굉장히 많이 노네요. 새우도 좀 있는 것 같고",
                "sound_type": [
                    2
                ],
                "start": 25.075,
                "end": 32.566
            }
        ]
    },
    "summary": "남자의 발 밑에 참붕어들이 굉장히 많이 있다.",
