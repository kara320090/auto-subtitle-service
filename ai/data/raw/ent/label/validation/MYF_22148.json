        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분 뒷줄 잡아야 되는데 어우 바쁘다 바뻐. 얜 또 어디 갔어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.786
            },
            {
                "speaker_id": "1",
                "transcription": "야 빠졌다.",
                "sound_type": [
                    2
                ],
                "start": 4.796,
                "end": 7.903
            },
            {
                "speaker_id": "1",
                "transcription": "아 정신없네요. 정신없어 지금.",
                "sound_type": [
                    2
                ],
                "start": 7.913,
                "end": 14.961
            },
            {
                "speaker_id": "1",
                "transcription": "아 일단 놔두고 일단 멘트 좀 하고 진행하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 14.971,
                "end": 18.505
            },
            {
                "speaker_id": "1",
                "transcription": "지금 제가 살림망에는 2마리가 있지만은요.",
