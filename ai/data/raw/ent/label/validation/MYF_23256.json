        "term": [
            {
                "speaker_id": "1",
                "transcription": "박소담이란 이름은 할아버지 할머니가 지어주신 이름이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.897
            },
            {
                "speaker_id": "1",
                "transcription": "어릴 적부터 할아버지와 할머니의 사랑을 많이 받고 자라서인지 나이 차이가 많이 나는 배우 신구와도 친구 사이라고 할 정도로 사이가 좋다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.907,
                "end": 10.458
            },
            {
                "speaker_id": "1",
                "transcription": "박소담은 학창 시절 털털하고 남자다운 성격이었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.468,
                "end": 13.327
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 인지 남자애들과 친했으며 친구들 사이에서도 인기가 많았다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.337,
                "end": 17.041
            },
            {
                "speaker_id": "1",
                "transcription": "과목 중에선 수학을 너무 좋아해서 수학 교사가 장래 희망이었다고 하고 운동도 좋아하고 심지어 실력도 좋아 송파구 육상 대표로 나가 수상을 하기도 했다.",
                "sound_type": [
