        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아내인 수잔이 결혼 전부터 키우던 강아지이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.527
            },
            {
                "speaker_id": "1",
                "transcription": "바로는 지인의 창고에 보호자 없는 어미 개가 몰래 들어와 출산한 새끼 중 한 마리이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.537,
                "end": 7.167
            },
            {
                "speaker_id": "1",
                "transcription": "지인의 부탁으로 임시 보호를 하게 되었고 갈 곳이 생기면 보낼 예정이었으나 정이 들어 계속 데리고 살게 되었다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.177,
                "end": 13.135
            },
            {
                "speaker_id": "1",
                "transcription": "레오는 어릴 때 강형욱이 데리고 있다가 경찰견으로 활동을 한 후 은퇴하여 다시 돌아왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.145,
                "end": 17.950
            },
            {
                "speaker_id": "1",
                "transcription": "심한 말썽꾸러기라 산책 중에 몇백만 원짜리 고급 양복을 물어 뜯은 적도 있다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.960,
                "end": 22.504
            },
            {
                "speaker_id": "1",
                "transcription": "현재는 3마리의 반려견과 함께하고 있지만 2020년 7월까지만 해도 강형욱은 다올이라는 레몬 보더콜리와도 함께였다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.514,
                "end": 28.838
            },
            {
                "speaker_id": "1",
                "transcription": "강형욱이 가장 애틋하게 생각하는 반려견이자 7월 6일 약 13살의 나이로 무지개 다리를 건넌 반려견이기도 하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.848,
                "end": 34.966
            },
            {
                "speaker_id": "1",
                "transcription": "과거 용인에 살 때 유기견 보호소에서 약 3살이었던 다올이를 만났다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.976,
                "end": 39.064
            },
            {
                "speaker_id": "1",
                "transcription": "엄청난 미모의 소유자이기 때문에 다올이가 지나가면 동네 어르신들이 칭찬의 의미로 비싼 개가 지나간다라고 하셨다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.074,
                "end": 45.931
            },
            {
                "speaker_id": "1",
                "transcription": "다올이는 당뇨병 때문에 인슐린 주사를 하루에 두 번씩 맞아야 했는데 이에 대해 강형욱은 다올이 잘 참아 준다면 눈시울을 붉혔던 적이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.941,
                "end": 53.278
            },
            {
                "speaker_id": "1",
                "transcription": "강형욱은 2018년 6월에 유튜브 채널의 구독자가 10만이 넘어 실버 버튼을 받았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.288,
                "end": 57.825
            },
            {
                "speaker_id": "1",
                "transcription": "이 실버 버튼을 열어보는 언박싱 영상을 찍었는데 진짜 미국에서 보내준 거냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.835,
                "end": 61.898
            },
            {
                "speaker_id": "1",
                "transcription": "시계냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.908,
                "end": 62.429
            }
        ]
    },
    "summary": "한 남성이 강형욱이 키우는 반려견 3마리에 대해 설명하고 있다.",
