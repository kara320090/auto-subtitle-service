        "term": [
            {
                "speaker_id": "1",
                "transcription": "뷔의 예명은 라틴 문자 V로 브이가 아닌 뷔라고 발음한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.477
            },
            {
                "speaker_id": "1",
                "transcription": "처음에는 본인을 포함해 모두 브이라고 불렀다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.487,
                "end": 6.038
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 빅 히트 사장 방시혁이 뷔라고 짧게 부르는 것이 훨씬 간지 난다고 생각하여 뷔로 가기로 했고 결과적으로 신의 한 수였다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.048,
                "end": 13.104
            },
            {
                "speaker_id": "1",
                "transcription": "특색 있는 예명인 뷔를 받기 전에 예명 후보에는 렉스, 시스가 있었다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.114,
                "end": 17.308
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 일본 팬들은 뷔가 일본어로 발음하기 어렵기 때문에 뷔에게 비공식적인 예명을 붙여주었다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.318,
                "end": 22.779
            },
            {
                "speaker_id": "1",
                "transcription": "바로 뷔의 별명인 태태다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.789,
                "end": 24.384
            },
            {
                "speaker_id": "1",
                "transcription": "태태는 뷔가 데뷔하기 전에 고등학교 때부터 친구들이 불렀던 애칭이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.394,
                "end": 27.908
            },
            {
                "speaker_id": "1",
                "transcription": "일본 팬들은 뷔 대신 거의 태태라고 뷔를 부르며 태태는 비공식이지만 굉장히 자주 불리는 또 다른 예명이 되었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.918,
                "end": 34.934
            }
        ]
    },
    "summary": "뷔의 예명은 라틴 문자 V로 뷔라고 발음하며 예명 후보에는 렉스, 시스가 있었고 일본 팬들은 뷔가 일본어로 발음하기 어렵기 때문에 비공식적인 예명으로 태태라고 부른다.",
