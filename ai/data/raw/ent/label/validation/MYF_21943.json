        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 사진 찍는 거 좋지 재밌지 음악 하는 거 재밌지 유튜브 하는 거 너무 좋지 재밌지 심리 공부 너무 좋지 재밌지 뭔가 한 가지를 뚜렷하게 나는 이거 아니면 안 돼 나 이거 무조건 해야겠어 이런 게 없는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.780
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 사실 더 힘들었거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.790,
                "end": 17.416
            },
            {
                "speaker_id": "1",
                "transcription": "근데 지금 생각해 보면 저는 하고 싶은 걸 해야 되는 사람보다는 하기 싫은 게 너무 죽도록 싫은 사람이었던 거 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.426,
                "end": 25.504
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 회사 생활을 제가 안 해본 게 아니잖아요.",
                "sound_type": [
                    2
                ],
                "start": 25.514,
                "end": 27.788
            },
            {
                "speaker_id": "1",
                "transcription": "근데 번번 회사 생활을 할 때마다 힘들었던 점이 있었고 그런 실패의 경험들이 쌓여가다 보니깐 아 회사는 나랑 안 맞아 이런 게 되게 커졌는데 사실상은 저는 제가 혼자 독립적으로 일하는 게 그렇게 잘 맞는지도 아직 모르겠거든요.",
                "sound_type": [
