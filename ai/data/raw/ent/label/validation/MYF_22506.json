        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거는 푸른 동행이라는 단체에서 저한테 보내주셔서 제가 참여를 하게 돼서 여러분한테 소개를 해드리는데 광고나 뭐 그런 거는 아니고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.272
            },
            {
                "speaker_id": "1",
                "transcription": "이 컬러링 북의 모든 수익금이 희귀난치성 아동이나 독거노인 우리 주변에 어려운 분들한테 전액 기부가 된다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 11.282,
                "end": 21.309
            },
            {
                "speaker_id": "1",
                "transcription": "너무 좋은 취지인 거 같애서 제가 이제 이렇게 함께 하게 됐고요.",
                "sound_type": [
                    2
                ],
                "start": 21.319,
                "end": 26.287
            },
            {
                "speaker_id": "1",
                "transcription": "컬러링 북의 있는 그림도 SNS에서 활동하고 계시는 작가님 분들이 재능 기부로 이렇게 참여를 해주셨다고 해요.",
                "sound_type": [
                    2
                ],
                "start": 26.297,
                "end": 36.704
            },
            {
                "speaker_id": "1",
                "transcription": "그림에 보시면 다 되게 귀엽죠 다 너무 예뻐요.",
                "sound_type": [
                    2
                ],
                "start": 36.714,
                "end": 40.541
            },
            {
                "speaker_id": "1",
                "transcription": "그림이 다 너무 예쁘죠?",
                "sound_type": [
