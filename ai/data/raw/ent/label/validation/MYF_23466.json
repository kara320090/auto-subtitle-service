        "term": [
            {
                "speaker_id": "1",
                "transcription": "조세호의 캐릭터 중 프로불참러는 조세호의 인기를 급상승시켜주었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.341
            },
            {
                "speaker_id": "1",
                "transcription": "프로불참러 캐릭터는 많은 사랑을 받으며 꽤 많이 패러디가 되기도 했었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.351,
                "end": 6.414
            },
            {
                "speaker_id": "1",
                "transcription": "또한 동료 연예인 들도 조세호를 부르지도 않고 왜 안 오냐면서 말장난을 치기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.424,
                "end": 10.415
            },
            {
                "speaker_id": "1",
                "transcription": "처음 프로불참러의 캐릭터가 탄생됐던 건 세바퀴에 출연했을 때이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.425,
                "end": 13.775
            },
            {
                "speaker_id": "1",
                "transcription": "김흥국이 안재욱 결혼식 때 왜 안 왔어라고 묻자 조세호가 누구요라고 말하며 억울하고 황당한 표정으로 모르는데 어떻게 가요라고 말해 스튜디오를 초토화시켰다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.785,
                "end": 21.099
            },
            {
                "speaker_id": "1",
                "transcription": "이 영상은 현재까지도 조세호 레전드 영상으로 남아있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.109,
                "end": 23.740
            },
            {
                "speaker_id": "1",
                "transcription": "이에 네티즌들은 진짜 조세호는 프로불참러 캐릭터 만들어 준 김흥국에게 고마워해야 한다 조세호 어제 우리 집 강아지 생일파티에 왜 안 왔냐 조세호 세상 억울한 듯한 리액션이 제대로 살렸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.750,
                "end": 32.889
            },
            {
                "speaker_id": "1",
                "transcription": "이때부터 조세호 전성기가 시작이었지 등의 뜨거운 반응을 보였다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.899,
                "end": 36.061
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 조세호가 프로불참러로 인기 역주행 후 안재욱이 딸 돌잔치 때 조세호를 초대했지만 스케줄 때문에 가지 못해 끝까지 프로불참러를 유지했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.071,
                "end": 43.333
            },
            {
                "speaker_id": "1",
                "transcription": "현재는 프로 억울러로 활발한 활동 중이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.343,
                "end": 47.113
            }
        ]
    },
