                ],
                "start": 5.190,
                "end": 17.822
            },
            {
                "speaker_id": "1",
                "transcription": "근데 애들이랑 요리 못하는 사람이랑 같이 이렇게 만들어도 망할 일이 없어.",
                "sound_type": [
                    2
                ],
