        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "사이언스 라이브러리는 좀 특별합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.907
            },
            {
                "speaker_id": "1",
                "transcription": "제가 거기에 도착해서 제가 말씀 또 드리도록 할게요.",
                "sound_type": [
                    2
                ],
                "start": 1.917,
                "end": 4.283
            },
            {
                "speaker_id": "2",
                "transcription": "신기하다. 아니 또 궁금한 게 그 제가 다니는 학교는 솔직히 학기 중에는 뭐 평소에는 도서관에 그렇게 학생들이 많지 않아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.293,
                "end": 16.346
            },
            {
                "speaker_id": "2",
                "transcription": "약간 한산한 정도 그런데 시험 기간에는 완전 미어터지고 자리도 없고 그런데 여기 UCI는 분위기가 어때요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.356,
                "end": 24.542
            },
            {
                "speaker_id": "2",
                "transcription": "UCI 분위기도 사실 똑같애요.",
                "sound_type": [
                    2
                ],
                "start": 24.552,
                "end": 26.410
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 보시면 아시겠지만 사람 사는 곳이라 그런지 모르겠는데 뭐 미어터지고 원래 여기 방도 있고 방도 빌릴 수 있고 개인만의 공간을 위해서 빌릴 수도 있고 그런 공간이 있는데 대개 시험 기간만 된다면 정말 꽉 차게 되는 그런 순간을 보실 수가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 26.420,
                "end": 43.131
            },
            {
                "speaker_id": "1",
                "transcription": "평소에는 오지도 않다가 늦게 공부하는 사람들이 있어서 그런지 모르겠는데",
                "sound_type": [
                    2
                ],
                "start": 43.141,
                "end": 47.539
            },
            {
                "speaker_id": "2",
                "transcription": "그러면 이쪽 두 도서관은 좀 비슷해요 성격이?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 47.549,
                "end": 51.982
            },
            {
                "speaker_id": "1",
                "transcription": "두 도서관이 좀 다른 게 이쪽은 게이트웨이는 뭐랄까 어 여긴 좀 더 컴퓨터들도 많고",
                "sound_type": [
                    2
                ],
                "start": 51.992,
                "end": 59.766
            }
        ]
    },
    "summary": "남성과 여성은 한국과 미국 도서관의 시험 기간의 분위기에 대해 이야기를 나누고 있다.",
