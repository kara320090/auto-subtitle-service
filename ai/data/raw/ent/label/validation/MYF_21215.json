        "term": [
            {
                "speaker_id": "1",
                "transcription": "저희 집은요 이제 흩어져 있던 조상님 묘를 한 곳으로 모으고 그 다음에 이제 봉분을 다 없앴습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 7.373
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 조그맣게 가족 묘를 했거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.383,
                "end": 9.765
            },
            {
                "speaker_id": "1",
                "transcription": "네 그런데 저희 5대 할머니 묘가 없습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.775,
                "end": 15.715
            },
            {
                "speaker_id": "1",
                "transcription": "저 잃어 버렸다고 해야되죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 15.725,
                "end": 16.924
            },
            {
                "speaker_id": "1",
                "transcription": "우리 이제 선대 쪽에서 잃어 버리셨겠죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.934,
                "end": 19.192
            },
            {
                "speaker_id": "1",
                "transcription": "네 아버지가 한 오대 할머니 묘를 계속 찾았습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.202,
                "end": 23.237
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 위에 올라가고 올라가고 선대로 올라가서 찾았어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 23.247,
                "end": 27.423
            },
            {
                "speaker_id": "1",
                "transcription": "네 예 그 집안에서 아 같은 집안이겠죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 27.433,
                "end": 31.448
            }
        ]
    },
    "summary": "발화자의 집은 조상님 묘를 한 곳으로 모으고 봉분을 없앴다.",
