                "start": 0.000,
                "end": 1.440
            },
            {
                "speaker_id": "1",
                "transcription": "지금 살치들이 아 지금 낚싯대를 치는 게 눈으로 보이고 있습니다.",
                "sound_type": [
                    1,
                    2
