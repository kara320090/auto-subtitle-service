        "term": [
            {
                "speaker_id": "1",
                "transcription": "야는 블루길 같다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 1.845
            },
            {
                "speaker_id": "1",
                "transcription": "머지 여지 없구마이",
