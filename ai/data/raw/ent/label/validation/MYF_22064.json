                "end": 13.900
            },
            {
                "speaker_id": "1",
                "transcription": "뗏장 말고 이게 저기가 소용이 없거든요. 뜰채가",
                "sound_type": [
                    2
                ],
                "start": 13.910,
                "end": 19.249
            },
            {
