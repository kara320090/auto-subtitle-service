        "term": [
            {
                "speaker_id": "1",
                "transcription": "백설 공주를 기준으로 스타일링 했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.079
            },
            {
                "speaker_id": "1",
                "transcription": "아이스크림 케이크 때는 인어 공주처럼 해보려 했다 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.089,
                "end": 4.864
            },
            {
                "speaker_id": "1",
                "transcription": "스타일링 할 때 자신의 의견을 많이 이야기하는 편이라고 하는데 자신만의 기준이 없으면 예쁜지 아닌지 헷갈리기 때문에 마음 속 기준을 디즈니 공주로 잡고 의견을 말한다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.874,
                "end": 14.231
            },
            {
                "speaker_id": "1",
                "transcription": "조이는 키가 167 센티미터로 팀 내 최장신이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.241,
                "end": 17.251
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 레드 벨벳 멤버가 다같이 찍힌 사진이나 무대 영상, 카메라에 잡히는 것만 봐도 멤버들과의 키 차이가 분명하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.261,
                "end": 23.541
            },
            {
                "speaker_id": "1",
                "transcription": "실물로 본 팬들의 후기 또한",
