        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 어 평범하게 현실적으로 봐야지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.038
            },
            {
                "speaker_id": "1",
                "transcription": "이제 그냥 안정적인 직장을 구해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.048,
                "end": 5.630
            },
            {
                "speaker_id": "1",
                "transcription": "평범하게 살아서 돈을 모아 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.640,
                "end": 8.408
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해야 되지 않겠냐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.418,
                "end": 10.024
            },
            {
                "speaker_id": "1",
                "transcription": "그 이런 마인드가 많잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.034,
                "end": 11.800
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 나는 20대가 얼마나 젊어 우리가 요즘 100세 시대라고 하는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.810,
                "end": 18.176
            },
            {
                "speaker_id": "1",
                "transcription": "아직 5분의 1밖에 안 살았는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.186,
                "end": 20.705
            },
            {
                "speaker_id": "1",
                "transcription": "뭘 늦어 뭘 늦고 뭘 안돼",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.715,
                "end": 23.649
            },
            {
                "speaker_id": "1",
                "transcription": "그치 그러니까 우리 허니 들도 나보다 나이가 조금 어린 허니 들도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.659,
                "end": 28.389
            },
            {
                "speaker_id": "1",
                "transcription": "정말 정말 우리가 어린 나이잖아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.399,
                "end": 30.857
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 뭘 새로 배우고 싶으면 배웠으면 좋겠고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.867,
                "end": 33.878
            },
            {
                "speaker_id": "1",
                "transcription": "도전하고 싶으면 꼭 도전을 했으면 좋겠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.888,
                "end": 36.810
            },
            {
                "speaker_id": "1",
                "transcription": "분명 그에 따른 힘듦도 있을 거야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.820,
                "end": 39.877
            },
            {
                "speaker_id": "1",
                "transcription": "약간 심리적인 불안감이나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.887,
                "end": 41.737
            },
            {
                "speaker_id": "1",
                "transcription": "경제적으로 약간 남들보다 조금 힘들 수가 있어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.747,
                "end": 45.815
            },
            {
                "speaker_id": "1",
                "transcription": "나도 사실 아직 많이 들어 주변에서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.825,
                "end": 50.041
            }
        ]
    },
