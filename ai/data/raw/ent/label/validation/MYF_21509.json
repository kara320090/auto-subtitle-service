                ],
                "start": 2.458,
                "end": 5.168
            },
            {
                "speaker_id": "1",
                "transcription": "불멍 하는 거 말고는 할 게 없어서 저는 저는 여름 캠핑 좋아해요. 물놀이도 하고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.178,
                "end": 8.972
            },
            {
                "speaker_id": "1",
                "transcription": "두 분이 가장 좋아하는 최애 음식은요?",
