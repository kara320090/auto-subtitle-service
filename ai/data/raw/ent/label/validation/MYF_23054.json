                    2,
                    4
                ],
                "start": 12.881,
                "end": 15.482
            },
            {
                "speaker_id": "1",
                "transcription": "어 샐러드 진짜 맛있겠다 이거.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.492,
                "end": 17.210
            },
            {
                "speaker_id": "3",
                "transcription": "이거랑 그 신맛 나는 수용하고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 17.220,
                "end": 19.869
            },
            {
                "speaker_id": "1",
                "transcription": "여보 그거 하나 지금 드셔 보세요.",
