                "end": 4.976
            },
            {
                "speaker_id": "1",
                "transcription": "여보 자기도 한 번 드셔보세요. 진짜 맛있어요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.986,
                "end": 7.770
            },
            {
                "speaker_id": "1",
                "transcription": "저거 하나 그냥 드셔 보세요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.780,
                "end": 12.871
            },
            {
                "speaker_id": "3",
                "transcription": "우리는 우리는 이걸 저 샐러드로 해 먹는데",
