                "start": 0.000,
                "end": 5.475
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 어설퍼진 거",
                "sound_type": [
                    2
                ],
                "start": 5.485,
                "end": 7.511
            },
            {
                "speaker_id": "2",
                "transcription": "아까 어두워서 잘 안 보여서 굽기 정도가",
                "sound_type": [
                    2
                ],
                "start": 7.521,
                "end": 10.767
            },
            {
                "speaker_id": "1",
                "transcription": "이거 완전 덜 익은 것 같은데 괜찮아?",
                "sound_type": [
                    2
                ],
                "start": 10.777,
                "end": 12.968
            },
            {
                "speaker_id": "2",
                "transcription": "아니 그러니까 굽기 정도를 미디엄 레어로 딱 맞출 수 있나 좀 헷갈렸는데 잘 안 보이니까",
                "sound_type": [
                    2
                ],
                "start": 12.978,
                "end": 18.819
            },
            {
                "speaker_id": "2",
                "transcription": "완전 레어인데.",
                "sound_type": [
                    2
                ],
                "start": 18.829,
                "end": 19.613
            },
            {
                "speaker_id": "2",
                "transcription": "어 대신 먹어보니까",
