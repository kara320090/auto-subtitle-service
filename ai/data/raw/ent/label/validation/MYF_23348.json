    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "감히 다른 아이들이 생각하지 못하는 것들만 뽑아다 놓는다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.486
            },
            {
                "speaker_id": "1",
                "transcription": "승희는 1996년 1월생으로 1995년 3월 이후 생들과 같이 학교를 다녔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.496,
                "end": 8.757
            },
            {
                "speaker_id": "1",
                "transcription": "현재 그룹 내 1995년 생인 미미, 유아와는 친구로 지낸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.767,
                "end": 13.156
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 처음 만났을 때에는 미미와 유아를 언니라고 불렀는데 이후 회사에서 고등학교 졸업 연도로 나이를 따져 승희에게 미미, 유아와 동갑처럼 지내라고 하는 바람에 매우 불편하게 반말을 했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.166,
                "end": 24.190
            },
            {
                "speaker_id": "1",
                "transcription": "결국 일본어 수업 시간을 이용해 미미짱, 유아짱을 시작으로 반말을 시작했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.200,
                "end": 28.776
            },
            {
                "speaker_id": "1",
                "transcription": "성격 자체가 크게 나이를 따지지 않고 둥글 둥글한 편이라 다른 1996년 생 연예인들과 동갑 친구로 지내는 경우도 많다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.786,
                "end": 36.389
            },
            {
                "speaker_id": "1",
                "transcription": "아이돌 세븐틴을 좋아하는 것으로 알려져 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.399,
                "end": 38.446
            },
            {
                "speaker_id": "1",
                "transcription": "본인 입으로 직접 세븐틴의 노래인 붐붐이 좋다고 언급했고 방송 등에서 직접 부른 적도 많다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.456,
                "end": 43.798
            },
            {
                "speaker_id": "1",
                "transcription": "응원 법도 아는 것을 보면 캐럿이 확실해 보인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.808,
                "end": 46.307
            },
            {
                "speaker_id": "1",
                "transcription": "또한 세븐틴 노래는 힘찬 에너지가 뿜어져 나와 듣고 있으면 힐링이 된다며 만약 보이 그룹 음악을 해본다면 세븐틴 컨셉의 노래를 하고 싶다고 말하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.317,
                "end": 54.826
            },
            {
                "speaker_id": "1",
                "transcription": "승희는 팬 사인회 레전드 일화들도 많다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.836,
                "end": 57.181
            },
            {
                "speaker_id": "1",
                "transcription": "대표적으로 승희를 주로 찍는 팬이 아린을 찍다가 승희에게 걸린 영상이 300만 뷰를 기록했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.191,
                "end": 62.552
            },
            {
                "speaker_id": "1",
                "transcription": "이 레전드 직캠은 훗날 승희가 이 영상에 더빙을 하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.562,
                "end": 66.966
            }
        ]
    },
    "summary": "승희는 만약 보이 그룹 음악을 해본다면 세븐틴 컨셉의 노래를 하고 싶다고 말했고, 팬 사인회 레전드 일화들도 많다.",
