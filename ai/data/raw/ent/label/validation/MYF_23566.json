            },
            {
                "speaker_id": "1",
                "transcription": "엄지원은 영화 경성학교 사라진 소녀들에서 화려한 헤어나 패션뿐만 아니라 자연스러운 일본어 연기로도 호평을 받았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.949,
                "end": 11.473
            },
            {
                "speaker_id": "1",
                "transcription": "엄지원은 일본어 연기에 대한 질문에 대해 일본 드라마를 정말 많이 봤다며 특히 기무라 타쿠야의 작품을 많이 봤다고 밝혔다.",
                "sound_type": [
                    2,
                    3
                ],
