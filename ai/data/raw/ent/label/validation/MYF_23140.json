        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 컴퓨터 충전도 마음대로 할 수 있는 그런 공간입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.665
            },
            {
                "speaker_id": "2",
                "transcription": "좋다. 휴식 공간이 되게 많은 거 같아요 학교에.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.675,
                "end": 6.183
            },
            {
                "speaker_id": "1",
                "transcription": "그렇죠. 자는 친구들도 많고 엔지니어링도 있고 그렇죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.193,
                "end": 11.829
            },
            {
                "speaker_id": "1",
                "transcription": "자유로워요.",
                "sound_type": [
                    2
                ],
                "start": 11.839,
                "end": 13.029
            },
            {
                "speaker_id": "2",
                "transcription": "아 여기 학교 안에 그것도 있어요 셔틀버스? 학교 안에",
                "sound_type": [
                    2
                ],
                "start": 13.039,
                "end": 17.971
            },
            {
                "speaker_id": "1",
                "transcription": "학교 안에서의 셔틀버스는 없어요.",
                "sound_type": [
                    2
                ],
                "start": 17.981,
                "end": 19.826
            },
            {
                "speaker_id": "1",
                "transcription": "네 보통 다친 사람이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 19.836,
                "end": 22.466
            },
            {
                "speaker_id": "1",
                "transcription": "뭐냐면 제가 예전에 농구를 하다가 발목을 다쳤어가지구 걷지 못했었을 때가 있었는데",
