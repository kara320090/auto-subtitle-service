        "term": [
            {
                "speaker_id": "1",
                "transcription": "싸우면 제가 신나게 두드려 맞지 않을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.753
            },
            {
                "speaker_id": "1",
                "transcription": "선수는 밥 먹고 총만 쏘고 뭐 유디티 애들은 밥 먹고 전투 기술만 배웠을 텐데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.763,
                "end": 6.875
            },
            {
                "speaker_id": "1",
                "transcription": "하여튼 뭐 이거는 할 말이 많아가지고 제가 다음 편에 따로 설명을 해드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.885,
                "end": 10.957
            },
            {
                "speaker_id": "1",
                "transcription": "예 몇 개 더 읽어보려고 했는데 일단 제가 좀 바빠서 여기까지만 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.967,
                "end": 14.384
            },
            {
                "speaker_id": "1",
                "transcription": "오늘의 영상은 여기까지고 궁금하신 점이나 제가 찍어줬으면 하는 영상이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.394,
                "end": 17.705
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 아래 댓글로 남겨 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.715,
                "end": 19.039
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 빠이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.049,
                "end": 20.161
            },
            {
                "speaker_id": "2",
                "transcription": "영상이 마음에 드셨다면 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.171,
                "end": 22.332
            },
            {
                "speaker_id": "2",
                "transcription": "다른 영상이 보고 싶으시다면 구독을 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.342,
                "end": 29.209
            }
        ]
    },
    "summary": "남자 유튜버는 일상적으로 사격 선수는 총을 많이 쏘고 유디티 병사들은 전투 기술을 배웠을 텐데 싸우면 자신이 많이 맞을 거라며 이 부분에 대해선 다음 편에 설명을 해준다고 하며 마무리하면서 궁금한 점이나 찍어줬으면 하는 영상이 있으면 아래 댓글로 남기라고 하고 여성은 영상이 마음에 들었다면 좋아요를 누르고 다른 영상에 보고 싶으면 구독을 누르라고 말하고 있다.",
