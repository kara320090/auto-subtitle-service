            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 오렌지 자몽 주스랑 또띠아 샌드위치.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.509,
                "end": 33.043
            },
            {
                "speaker_id": "1",
                "transcription": "제가 틱톡에서 되게 재밌게 간단하게 만드는 또띠아 봤는데 그걸 만들기에는 저희 또띠아가 좀 큰 거예요.",
                "sound_type": [
                    2
                ],
                "start": 33.053,
                "end": 43.963
            },
            {
                "speaker_id": "1",
                "transcription": "후라이팬에 딱 이렇게 맞아야 되거든요.",
                "sound_type": [
                    2
                ],
                "start": 43.973,
                "end": 48.577
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 한 요정도 지름을 자를려고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.587,
                "end": 59.436
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 잘랐어. 너무 잘했는데?",
                "sound_type": [
                    2
                ],
                "start": 59.446,
                "end": 62.496
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 남은거 이거를 그냥 이렇게 튀겨 먹어도 맛있겠다.",
                "sound_type": [
                    2
                ],
                "start": 62.506,
                "end": 66.266
            }
        ]
    },
    "summary": "화자는 재밌고 간단하게 만드는 또띠아 영상을 보고 직접 만들어보며 또띠아의 크기가 커서 후라이팬에 맞게 자른다.",
