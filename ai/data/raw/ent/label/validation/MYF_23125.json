                ],
                "start": 0.000,
                "end": 7.722
            },
            {
                "speaker_id": "1",
                "transcription": "술병을 들고 다니거나 이런 게 금지되어 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 7.732,
                "end": 10.498
            },
            {
                "speaker_id": "1",
                "transcription": "근데 대학생들은 아무래도 뭐 맥주나 이런 거를 즐기는 사람들이 많을 텐데 캠퍼스에서 이렇게 술을 먹거나 그런 사람들도 있어요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.508,
                "end": 20.116
            },
            {
                "speaker_id": "2",
                "transcription": "전혀 그런 사람 없어요.",
                "sound_type": [
                    2
                ],
                "start": 20.126,
                "end": 21.247
            },
            {
                "speaker_id": "2",
                "transcription": "전혀 그런 사람도 없고 가끔 경찰도 왔다 갔다 해가지구",
