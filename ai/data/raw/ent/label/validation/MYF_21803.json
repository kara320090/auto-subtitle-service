        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 솔직히 말해서 그때 선물을 받고 와 책 진짜 예쁘다 하면서 이렇게 훑어만 보고 책을 읽어 보지 않았었어요.",
                "sound_type": [
