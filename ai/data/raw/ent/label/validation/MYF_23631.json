        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "농구와 관련된 일이라면 아무리 예능이라도 웃기는 쪽으로 나가는 걸 사절한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.003
            },
            {
                "speaker_id": "1",
                "transcription": "진지하게 임하고 절대로 웃기고 싶지 않다고 못 박았으니 농구에 있어 자존심이나 신념이 확고하다는 걸 알 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.013,
                "end": 10.366
            },
            {
                "speaker_id": "1",
                "transcription": "서장훈은 현역 선수 시절부터 현재까지 기부를 꾸준히 해오고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.376,
                "end": 13.802
            },
            {
                "speaker_id": "1",
                "transcription": "자유튜 1점당 일정액을 적립해 소년소녀 가장 및 소아암 어린이 치료비로 매년 1000만 원씩 총 5시즌 동안 기부한 적도 있고 올스타전 최우수 선수로 선정되어 받은 상금에 사비를 더해 월드비전에 1000만 원을 기부한 적도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.812,
                "end": 26.421
            },
            {
                "speaker_id": "1",
                "transcription": "그 외에도 이웃 돕기 성금 가정형편이 어려운 학생들에게 주는 장학금 등 다양한 기부를 실천했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.431,
                "end": 31.561
            },
            {
                "speaker_id": "1",
                "transcription": "박승일 선수의 루게릭병 환우 후원모금 사업에 가장 크게 협조한 일화나 한국 여자 농구 선수 김영희 선수가 거인병을 앓으며 8평짜리 단칸방에서 체육연금으로 생활하고 있다는 소식을 듣고 몇 달치 치료비를 입금한 일은 유명하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.571,
                "end": 44.292
            },
            {
                "speaker_id": "1",
                "transcription": "서장훈은 현재 1억 원 이상 고액 기부자 모임인 아너 소사이어티의 1452번째 회원이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.302,
                "end": 49.356
            },
            {
                "speaker_id": "1",
                "transcription": "가장 최근에 방송에서 잰 서장훈의 키는 205.3센티미터이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.366,
                "end": 53.236
            },
            {
                "speaker_id": "1",
                "transcription": "고등학교 졸업 당시에는 착화 207센티미터에 맨발 205센티미터 정도였으나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.246,
                "end": 58.058
            }
        ]
    },
    "summary": "한 남성이 서장훈이 많은 기부를 해오고 있다는 설명을 하고 있다.",
