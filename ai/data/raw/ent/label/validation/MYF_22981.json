                    5
                ],
                "start": 1.260,
                "end": 6.562
            },
            {
                "speaker_id": "1",
                "transcription": "아 한번 먹어 볼게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.572,
                "end": 8.959
            },
            {
                "speaker_id": "1",
                "transcription": "오빠 이게 아까 얼마였어 솔방울 라떼가?",
