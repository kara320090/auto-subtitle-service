                ],
                "start": 0.000,
                "end": 1.250
            },
            {
                "speaker_id": "2",
                "transcription": "우유를 조금씩 넣어서 한 번에 많이 넣지 말고 이거를 이만큼씩 섞어서 먹으래.",
                "sound_type": [
