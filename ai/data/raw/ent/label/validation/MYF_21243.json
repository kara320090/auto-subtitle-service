        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 시간이 여섯 시 40분인데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.206
            },
            {
                "speaker_id": "1",
                "transcription": "저 위아래 봤더니 제자리만 있네요 이 불 찌꺼기들이.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 3.216,
                "end": 6.970
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 여기가 아침장이거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 6.980,
                "end": 9.020
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 옮겨 걷어 옮긴다고 그래봐야 크게 의미가 없을 것 같고 차라리 집에 가서 자고 일찍 나오는 게 나을 것 같아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.030,
                "end": 17.729
            },
            {
                "speaker_id": "1",
                "transcription": "네 걷겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 17.739,
                "end": 19.785
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 집에 가려다가요 근처 다른 물줄기 냇가로 왔습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.795,
                "end": 24.446
            },
            {
                "speaker_id": "1",
                "transcription": "어 저번에 제가 여기서 짬락을 해서 월척을 한번 만났었고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 24.456,
                "end": 27.777
            }
        ]
    },
    "summary": "집에 가려던 발화자는 근처 냇가에 왔다.",
