        "term": [
            {
                "speaker_id": "1",
                "transcription": "안 좋다라고 말할려 그랬는데 부드러우면서 오래간다고 그래서 좋다고 말씀을 해 주셨습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 7.388
            },
            {
                "speaker_id": "1",
                "transcription": "그러시면서 어 나 쓸 의향이 있으니까 1번만 주라 더.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.398,
                "end": 11.962
            },
            {
                "speaker_id": "1",
                "transcription": "그런 말씀까지 하셨어요.",
                "sound_type": [
                    2
                ],
                "start": 11.972,
                "end": 13.345
            },
            {
                "speaker_id": "1",
                "transcription": "아 사서 쓰신다고 하셨습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.355,
                "end": 15.065
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 손에 묻지 않고 떡밥 그릇에 잘 안 묻으니까 좋다는 말씀도 하셨습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 15.075,
                "end": 21.668
            },
            {
                "speaker_id": "1",
                "transcription": "제가 뭐 10여 년 전부터 이 회사 제품을 사용을 했는데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 21.678,
                "end": 25.242
            },
            {
                "speaker_id": "1",
                "transcription": "주변에서 그 당시에 주변에서 야 돈 주고 사면서 왜 이름 없는 회사 걸 쓰냐 그런 핀잔을 들었는데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 25.252,
                "end": 32.277
            },
            {
                "speaker_id": "1",
                "transcription": "아까 그 이유 땜에 제가",
