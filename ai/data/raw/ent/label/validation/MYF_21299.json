        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 잠깐 지켜보고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.557
            },
            {
                "speaker_id": "1",
                "transcription": "이런 곳들은 저기 맞은편 갈 때나 연안 쪽 갈 때 툭툭 치는 게 있으면은 되려 한번 담가 볼 만합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 1.567,
                "end": 10.091
            },
            {
                "speaker_id": "1",
                "transcription": "수심은 그래도 한 사오십은 나올 것 같고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.101,
                "end": 13.140
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐만 한 이삼 분만 지켜보고 이동하겠습니다.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 13.150,
                "end": 24.019
            },
            {
                "speaker_id": "1",
                "transcription": "우와 자 붕어 나옵니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 24.029,
                "end": 29.613
            },
            {
                "speaker_id": "1",
                "transcription": "자 궁금하면 해 봐야 되죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 29.623,
                "end": 32.238
            },
            {
                "speaker_id": "1",
                "transcription": "자 물이 있는데 붕어가 없을 리가 없죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 32.248,
                "end": 35.936
            },
            {
                "speaker_id": "1",
                "transcription": "사이즈는 한 여섯일곱 치 될 것 같네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.946,
                "end": 41.946
            },
            {
                "speaker_id": "1",
                "transcription": "바로 보내주구요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 41.956,
                "end": 43.475
            },
            {
                "speaker_id": "1",
                "transcription": "자 카메라 세팅하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 43.485,
                "end": 49.080
            },
            {
                "speaker_id": "1",
                "transcription": "지금 여러분께서는 꾼의 흔적이 전혀 없는 새로운 포인트에서 낚시를 하고 있는 @이름1의 모습을 보시고 계십니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 49.090,
                "end": 58.206
            },
            {
                "speaker_id": "1",
                "transcription": "자 계속 진행하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
