        "term": [
            {
                "speaker_id": "1",
                "transcription": "음 요즘에 그게 나왔더라고 민트초코소주",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.517
            },
            {
                "speaker_id": "1",
                "transcription": "내가 민초단이긴 한데 약간 그건 좀 선 넘었다고 생각을 하거든.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.527,
                "end": 9.094
            },
            {
                "speaker_id": "1",
                "transcription": "근데 궁금하긴 한 거야 어떤 맛일지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.104,
                "end": 12.774
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 내가 오늘 너 온다고 해서 그 소주를 사올까 했는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.784,
                "end": 17.873
            },
            {
                "speaker_id": "1",
                "transcription": "내가 간 편의점에 그걸 안 팔더라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.883,
                "end": 20.300
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 그렇다고 또 막 여기저기 편의점 뒤져 뒤져 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.310,
                "end": 23.956
            },
            {
                "speaker_id": "1",
                "transcription": "그걸 사 먹을 만한 가치가 있을까 라는 생각이 들어서 오늘 그냥",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.966,
                "end": 28.865
            },
            {
                "speaker_id": "1",
                "transcription": "후레시 깔끔하게 후레시 사 왔어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.875,
                "end": 32.082
            },
            {
                "speaker_id": "1",
                "transcription": "되게 안 집혀 안 집혀가지고 좀 답답했겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.092,
                "end": 37.583
            }
        ]
    },
    "summary": "여성이 거주 공간에서 유튜브를 통해 음식을 먹으며 시청자와 소통하고 있다.",
