                ],
                "start": 4.171,
                "end": 10.747
            },
            {
                "speaker_id": "1",
                "transcription": "이런 건데 아 뭐 천연이고 솔직히 다 떠나서 너무 예쁜 거예요.",
                "sound_type": [
