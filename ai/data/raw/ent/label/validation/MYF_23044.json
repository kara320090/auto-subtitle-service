        "term": [
            {
                "speaker_id": "1",
                "transcription": "에구야.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.002
            },
            {
                "speaker_id": "1",
                "transcription": "아아구.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.012,
                "end": 4.484
            },
            {
                "speaker_id": "2",
                "transcription": "아구 여기까지 와서 뭔일이야.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.494,
                "end": 11.550
            },
            {
                "speaker_id": "3",
                "transcription": "위로 가야 돼? 아래로 가야 돼?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.560,
                "end": 19.245
            },
            {
                "speaker_id": "3",
                "transcription": "야 이거 완전히 정글 숲 같아.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.255,
                "end": 22.450
            },
            {
                "speaker_id": "3",
                "transcription": "야호.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.460,
                "end": 30.003
            },
            {
                "speaker_id": "3",
                "transcription": "이거예요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 30.013,
                "end": 31.564
            },
            {
                "speaker_id": "2",
                "transcription": "이 나물들인데 이게 쌈 쌈으로도 그렇게 맛있는 나물이고 요고는 어떻게 해야 되면 이런 칼로다가 이렇게 잡고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 31.574,
                "end": 41.568
            },
            {
                "speaker_id": "4",
                "transcription": "아 밑동을?",
                "sound_type": [
                    2
                ],
                "start": 41.578,
                "end": 42.918
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 끊으면 또 올라오니까 요로케 너무 밑에 하지 말고 요정도.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 42.928,
                "end": 49.383
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 해 가지고 쌈 싸먹어봐. 이거 샐러드도 기가 막히게 맛있고",
                "sound_type": [
                    2
                ],
                "start": 49.393,
                "end": 53.267
            },
            {
                "speaker_id": "4",
                "transcription": "요걸로 하나씩 하면 되겠네.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 53.277,
                "end": 65.610
            },
            {
                "speaker_id": "3",
                "transcription": "아이고 다쳤네. 아 어떻게 해.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 65.620,
                "end": 70.504
            },
            {
                "speaker_id": "2",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 70.514,
                "end": 71.594
            },
            {
                "speaker_id": "2",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 71.604,
                "end": 72.337
            },
            {
                "speaker_id": "2",
                "transcription": "시야를 넓게 보면 여기도 있고 저기도 있고 저기도 있고.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 72.347,
                "end": 76.710
            },
            {
                "speaker_id": "4",
                "transcription": "그래 그렇게 자르는 거야.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 76.720,
                "end": 78.369
            },
            {
                "speaker_id": "2",
                "transcription": "그 쌈으로 먹으면 기가 막히게 좋은 거예요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 78.379,
                "end": 80.673
            },
            {
                "speaker_id": "2",
                "transcription": "이게 당귀 같은 향도 나고 그 누나 옆에도 또 있네.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 80.683,
                "end": 87.277
            },
            {
                "speaker_id": "2",
                "transcription": "/거 뒤에.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 87.287,
                "end": 89.566
            }
        ]
    },
    "summary": "완전히 정글 숲 같고 이 나물은 쌈으로도 맛있고 샐러드도 기가 막힌 데 시야를 넓게 보면 여기도 있고 저기도 있다.",
