        "term": [
            {
                "speaker_id": "1",
                "transcription": "다른 이유가 있을 거라는 추측이 난무했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.762
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 후에 밝혀진 서장훈과 오정연 아나운서의 생활 패턴이 정말 극과 극이었고 다들 이러한 이혼 사유에 납득하는 분위기였다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.772,
                "end": 9.425
            },
            {
                "speaker_id": "1",
                "transcription": "나쁘게 헤어진 건 아니라서 지금도 가끔 연락을 주고받는다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.435,
                "end": 12.897
            },
            {
                "speaker_id": "1",
                "transcription": "초반에는 이런 이혼이나 결별 아나운서 등의 키워드에 민감하게 반응하는 듯했으나 현재는 익숙해진 듯하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.907,
                "end": 19.040
            },
            {
                "speaker_id": "1",
                "transcription": "이수근은 이런 서장훈에게 서 서장훈 장 장모님이 찾아와 훈 훈서방 꼭 이랬어야만 했나라는 삼행시를 지어주기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.050,
                "end": 26.159
            }
        ]
    },
    "summary": "한 남성이 서장훈의 이혼에 대해 설명하고 있다.",
