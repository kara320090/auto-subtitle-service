    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "연기에 처음 관심을 가지게 된 것은 17살 때 뮤지컬 그리스를 봤을 때부터다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.701
            },
            {
                "speaker_id": "1",
                "transcription": "배우들이 무대 위에서 열정을 쏟아내는 모습을 보고 동경심을 가졌다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.711,
                "end": 8.589
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 아버지는 박소담의 꿈을 반대했었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.599,
                "end": 10.790
            },
            {
                "speaker_id": "1",
                "transcription": "박소담이 부모님 몰래 연기학원을 다니며 치열하게 노력한 끝에 한예종에 붙었을 때도 아버진 별 말씀이 없었다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.800,
                "end": 17.308
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 박소담이 한예종에서 첫 무대에 섰을 때 아버지는 묵묵하게 마지막까지 남아 엄지를 치켜드셨다고 하는데 이때 박소담은 눈물을 펑펑 흘렀다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.310,
                "end": 26.126
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 차츰 무대 경험을 쌓던 박소담은 2013년 단편영화 더도 말고 덜도 말고로 영화계에 데뷔하게 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.136,
                "end": 32.340
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 같은 해 영화 잉투기를 통해 조금씩 얼굴을 알리기 시작한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.340,
                "end": 35.925
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 경성학교 상의원 등 총 10편의 영화에서 주, 조연, 단역을 가리지 않고 활발하게 활동을 이어가다가 2015년을 맞이하게 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.930,
                "end": 45.663
            },
            {
                "speaker_id": "1",
                "transcription": "베테랑을 통해 천만 관객 영화에 참여하게 됐고 이어서 사도를 통해 또다시 흥행작을 만난다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.673,
                "end": 50.790
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 검은 사제들에서 드디어 연기력 포텐을 터트리며 2015년을 자신의 해로 만들었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.800,
                "end": 55.554
            },
            {
                "speaker_id": "1",
                "transcription": "사실 검은 사제들의 임팩트 때문에 반짝 스타가 된 게 아닌가 하는 사람들이 많지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.564,
                "end": 60.326
            }
        ]
    },
    "summary": "화자는 박소담이 연기에 관심을 갖게 된 계기와 부모님의 반대에도 몰래 학원을 다녀 한예종에 입학하고 첫 무대에 섰을 때까지의 에피소드를 이야기해주고 영화계에서 첫 데뷔를 어떻게 했는지와 2015년에 박소담의 해로 만들었다고 한다.",
