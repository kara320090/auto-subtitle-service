        "term": [
            {
                "speaker_id": "1",
                "transcription": "서장훈은 은퇴 후 다양한 예능 프로그램에 나오면서 스포츠 스타가 아닌 방송인으로 인지도를 쌓으며 전문 방송인으로 전업을 예고하는 듯했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.309
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 2013년 무한도전 웃겨야 산다 특집 때 정준하의 대타로 출연해 이거로 뜨고 싶은 마음 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.319,
                "end": 14.060
            },
            {
                "speaker_id": "1",
                "transcription": "이게 마지막 방송이에요라며 전문 방송인으로서의 전직을 부정했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.070,
                "end": 17.713
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 여러 예능 프로그램에서 활약하며 지금은 방송을 전업으로 삼고 한 발짝 더 나아가 건물주 캐릭터나 염세주의자 등의 캐릭터로 분량을 뽑아내는 중이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.723,
                "end": 26.270
            },
            {
                "speaker_id": "1",
                "transcription": "서장훈이 전문 방송인이길 거부했던 이유에 대해 싸이는 예전에 친분이 있던 몇몇 전직 운동선수들이 방송에 나오면 서장훈이 그들에게 네 본업이 뭐냐고 잔소리를 퍼부었기 때문이라며",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.280,
                "end": 36.870
            }
        ]
    },
    "summary": "한 남성이 서장훈이 한 때 방송인이 되는 걸 거부했으나 현재는 방송을 전업으로 살고 있다고 말하고 있다.",
