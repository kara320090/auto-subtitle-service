        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런 털이 끝일까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.239
            },
            {
                "speaker_id": "1",
                "transcription": "염색은 여름에 특히 많지 않나 손님들이?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.249,
                "end": 5.554
            },
            {
                "speaker_id": "2",
                "transcription": "여름에 계절이 바뀔 때마다 많은 것 같애요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.564,
                "end": 9.418
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜로",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.428,
                "end": 10.041
            },
            {
                "speaker_id": "2",
                "transcription": "확실히 여름에 더 밝은 컬러를 하실려고 하시고 이미지 변화나 기분 전환에는 염색만한 게 없죠.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 10.051,
                "end": 16.089
            },
            {
                "speaker_id": "1",
                "transcription": "맞아 맞아 맞아.",
