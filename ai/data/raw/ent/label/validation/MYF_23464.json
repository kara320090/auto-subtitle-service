        "term": [
            {
                "speaker_id": "1",
                "transcription": "이어 더 이상 저 같은 사람은 빼고 백종원, 유재석, 신동엽 정도만 넣어 달라 그게 긴장감 있다고 말했고 이러한 김구라의 발언에 사이다 발언이라는 반응이 이어졌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.527
            },
            {
                "speaker_id": "1",
                "transcription": "거침없고 현실적인 토크로 시청자의 가려운 곳을 긁어준다는 평가가 있지만 특유의 화법과 태도 때문에 호불호가 많이 갈리는 김구라 씨",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.537,
                "end": 14.219
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 대한민국의 방송을 이끄는 탑 MC 중 한 명이라는 것에는 이견이 없을 듯합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.229,
                "end": 18.256
            },
            {
                "speaker_id": "1",
                "transcription": "과거의 망언들과 구설수에는 제대로 된 사과도 중요하겠지만 앞으로 더 나아지는 모습을 보여주는 것이 가장 중요하지 않을까 생각됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.266,
                "end": 24.382
            },
            {
                "speaker_id": "1",
                "transcription": "시대가 변한 만큼 김구라 씨의 변화된 모습과 성장을 응원하면서 이번 영상 마치겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.392,
                "end": 28.894
            },
            {
                "speaker_id": "1",
                "transcription": "시청해 주셔서 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.904,
                "end": 30.297
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 별로였으면 싫어요와 구독을 눌러주세요.",
                "sound_type": [
                    2,
                    3
