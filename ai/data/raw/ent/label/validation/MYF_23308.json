        "term": [
            {
                "speaker_id": "1",
                "transcription": "실제로 민경훈의 발성은 두성이 많이 쓰이는 탓에 헬륨가스도 힘을 못 쓴다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.516
            },
            {
                "speaker_id": "1",
                "transcription": "헬륨을 마시고 노래를 해도 본인 목소리 그대로 나와버린 것이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.526,
                "end": 8.507
            },
            {
                "speaker_id": "1",
                "transcription": "두성이 헬륨을 무시해 버려 일어난 일이라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.517,
                "end": 11.015
            },
            {
                "speaker_id": "1",
                "transcription": "말할 때는 당연히 헬륨가스에 영향을 받아 목소리가 이상하게 나왔지만 이상하게 노래만 불렀다 하면 두성이 목소리를 원상복구 시켜버린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.025,
                "end": 19.419
            }
        ]
    },
    "summary": "화자는 민경훈이 헬륨가스를 마셨는데 일반적인 목소리는 이상했지만 노래를 부르면 두성으로 헬륨가스도 힘을 못쓴다고 한다.",
