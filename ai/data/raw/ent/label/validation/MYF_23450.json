        "term": [
            {
                "speaker_id": "1",
                "transcription": "길고 늘씬한 체형을 가진 뷔는 긴 팔 때문에 멤버들이 긴팔원숭이라고 부를 정도로 팔과 다리가 매우 긴 편이고 손가락과 발가락까지 길다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.682
            },
            {
                "speaker_id": "1",
                "transcription": "길게 뻗은 팔과 다리 덕분에 뷔는 퍼포먼스를 할 때 굉장히 눈에 띄는 편이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.692,
                "end": 12.334
            },
            {
                "speaker_id": "1",
                "transcription": "존재 자체가 판타지 영화급인 뷔의 매력은 여기서 끝이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.344,
                "end": 16.120
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뷔에 대한 소개는 다음 편에서도 이어집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.130,
                "end": 18.854
            },
            {
                "speaker_id": "1",
                "transcription": "다음 편도 기대해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.864,
                "end": 19.998
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 별로였으면 싫어요와 구독을 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.008,
                "end": 25.366
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 재미있으셨다면 좋아요와 구독을 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.376,
                "end": 28.261
