        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 비가 쏟아지기 시작했는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.665
            },
            {
                "speaker_id": "1",
                "transcription": "아 철수를 해야 되느냐 조금 더 해야 되느냐 고민 되네요.",
                "sound_type": [
                    2
                ],
                "start": 2.675,
                "end": 6.671
            },
            {
                "speaker_id": "1",
                "transcription": "지금 바람까지 불고 있는데 일단 카메라 얼른 정리하고 갑자기 여기 저기서 쿵쿵쿵쿵 각도기 박는 소리가 들립니다.",
                "sound_type": [
                    2
                ],
                "start": 6.681,
                "end": 17.552
            },
            {
                "speaker_id": "1",
                "transcription": "지금 다시 비가 멈췄고요.",
                "sound_type": [
                    2
                ],
                "start": 17.562,
                "end": 20.678
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 준비는 좀 해놓고 기다리겠습니다.",
                "sound_type": [
                    2
