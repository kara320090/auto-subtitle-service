            },
            {
                "speaker_id": "1",
                "transcription": "옥수수에는 아직 반응이 없습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 5.537,
                "end": 8.847
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 @이름1 후배의 충고를 좀 들었거든요.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 8.857,
                "end": 13.467
            },
            {
                "speaker_id": "1",
                "transcription": "형님 자꾸 징크스를 만들지 마십시오 그러더라고요.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 13.477,
                "end": 17.370
            },
            {
                "speaker_id": "1",
                "transcription": "제가 첫 수를 잡기 전에 짬낚에는 절대 이 뜰채를 안 피구요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 17.380,
                "end": 22.199
            },
            {
                "speaker_id": "1",
                "transcription": "밤낚시에는 제가 살림망을 차에서 안 끄내 오거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 22.209,
                "end": 25.533
            },
            {
                "speaker_id": "1",
                "transcription": "근데 오늘 짬낚인데 뜰채를 먼저 폈습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 25.543,
                "end": 30.113
            },
            {
                "speaker_id": "1",
                "transcription": "과연 어떤 결과를 가져올지요.",
