        "term": [
            {
                "speaker_id": "1",
                "transcription": "나이 드는 거지.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.238
            },
            {
                "speaker_id": "1",
                "transcription": "이빨이 부실해지고 이제 씹는 게 귀찮고 뭐 그렇게 되는 거지.",
                "sound_type": [
                    2
                ],
                "start": 1.248,
                "end": 7.331
            },
            {
                "speaker_id": "1",
                "transcription": "자연스러운 거야.",
                "sound_type": [
                    2
                ],
                "start": 7.341,
                "end": 8.359
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이상한 것도 아니고 와 근데 오랜만에 술을 진짜 한두 잔 마시니까 벌써 막 취한다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.369,
                "end": 16.640
            },
            {
                "speaker_id": "2",
                "transcription": "자기 내가 본 이후 쭈욱 같이 겪어온 이후 제일 많이 마시는 거야.",
                "sound_type": [
                    2
                ],
                "start": 16.650,
                "end": 21.659
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그니까 최근만 카운팅 한 걸 거 아니야?",
                "sound_type": [
                    2
                ],
                "start": 21.669,
                "end": 25.094
            },
            {
                "speaker_id": "1",
                "transcription": "옛날 옛날에는 뭐",
                "sound_type": [
                    2
                ],
                "start": 25.104,
                "end": 26.496
            },
            {
                "speaker_id": "2",
                "transcription": "아 아니 신혼 초 말고.",
                "sound_type": [
                    2
                ],
                "start": 26.506,
                "end": 27.807
            },
            {
                "speaker_id": "2",
                "transcription": "최근 몇 년.",
                "sound_type": [
                    2
                ],
                "start": 27.817,
                "end": 30.200
            }
        ]
    },
