        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기 보시면 재밌는 자세가 하나 나오죠?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.011
            },
            {
                "speaker_id": "1",
                "transcription": "무슨 서부시대 리볼버마냥 그냥 조준도 안 하고 냅다 쏘는데 이거 진짜 고증 잘된 거예요.",
                "sound_type": [
                    2
                ],
                "start": 2.021,
                "end": 6.942
            },
            {
                "speaker_id": "1",
                "transcription": "원래 빠르게 쏠 때 이 자세로 쏘는 게 맞아요.",
                "sound_type": [
                    2
                ],
                "start": 6.952,
                "end": 9.520
            },
            {
                "speaker_id": "1",
                "transcription": "연습 좀 했다 하는 사람들은 이 정도 5 6야드 정도 되는 거리에서는 그냥 지향사격으로도 몸통은 맞출 수 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 9.530,
                "end": 16.248
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이것처럼 홀스터에서 바로 뽑자마자 쏘는 자세가 이 자세입니다.",
                "sound_type": [
                    2
                ],
                "start": 16.258,
                "end": 27.139
            },
            {
                "speaker_id": "1",
                "transcription": "아 이건 좀 아쉽다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.149,
                "end": 29.000
            },
            {
                "speaker_id": "1",
                "transcription": "넘어졌는데 왜 안 쏴? 시간이 충분한데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.010,
                "end": 34.256
            },
            {
                "speaker_id": "1",
                "transcription": "에유",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.266,
                "end": 36.939
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 조금 말이 안 되는 게 이렇게 쏘면은 뒤에 있는 사람도 같이 죽는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 36.949,
                "end": 42.165
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이거 쏘는 게 글록34니깐 9mm잖아요.",
                "sound_type": [
                    2
                ],
                "start": 42.175,
                "end": 45.119
            },
            {
                "speaker_id": "1",
                "transcription": "9mm는 사람 2명 정도는 진짜 여유 있게 관통하거든요.",
                "sound_type": [
                    2
                ],
                "start": 45.129,
                "end": 49.841
            }
        ]
    },
