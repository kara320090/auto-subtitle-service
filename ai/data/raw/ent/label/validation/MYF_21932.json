        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 이것도 너무 공감이 됐어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.019
            },
            {
                "speaker_id": "1",
                "transcription": "제가 생각이 너무 많아서 힘들 때가 많거든요.",
                "sound_type": [
                    2
                ],
                "start": 2.029,
                "end": 4.708
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 머릿속이 너무 가득 차서 몸을 움직일 수 없는 늪에 빠진 거 같은 그런 기분이 들 때가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 4.718,
                "end": 11.264
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 또 하나 충격적인 사실 타고난 애정 결핍이 있데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.274,
                "end": 15.837
            },
            {
                "speaker_id": "1",
                "transcription": "물론 누구나 다 사랑 받고 싶은 욕구 인정 받고 싶은 욕구가 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 15.847,
                "end": 20.666
            },
            {
                "speaker_id": "1",
                "transcription": "와 근데 저는 사실 어릴 때부터 상처도 너무 잘 받고 항상 뭔가 내 편을 만들고 싶어 하는 그런 게 있었던 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 20.676,
                "end": 29.435
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 그 채워지지 않는 구멍이랄까 근데 그거는 제가 심리 상담을 길게 받으면서 그런 스스로에게 이해하게 됐었거든요.",
                "sound_type": [
                    2
                ],
                "start": 29.445,
                "end": 38.106
            },
            {
                "speaker_id": "1",
                "transcription": "아 그거를 많이 채워줄 걸 바랄 게 아니라 내가 채워야 되는구나라는 걸 알게 됐었는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.116,
                "end": 45.078
            }
        ]
    },
    "summary": "또 하나 충격적인 사실은 타고난 애정 결핍이 있는 데 어릴 때부터 상처도 너무 잘 받고 항상 뭔가 내 편을 만들고 싶어 하는 그런 게 있었던 거 같은 테 심리 상담을 길게 받으면서 그런 스스로를 이해하게 됐다.",
