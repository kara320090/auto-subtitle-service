                "end": 7.989
            },
            {
                "speaker_id": "1",
                "transcription": "아이 아가 붕어가 나왔습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.999,
                "end": 11.033
            },
            {
                "speaker_id": "1",
                "transcription": "한 네다섯 치 될 것 같고요.",
                "sound_type": [
                    1,
