        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 신경 쓰이는 정도는 아니지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.670
            },
            {
                "speaker_id": "2",
                "transcription": "티가 안나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.680,
                "end": 2.785
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 나 가방 원래 막 써가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.795,
                "end": 5.149
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 디씨 안 되나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.159,
                "end": 6.721
            },
            {
                "speaker_id": "1",
                "transcription": "언니 이거 결제 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.731,
                "end": 9.551
            },
            {
                "speaker_id": "1",
                "transcription": "근데 혹시 여기에 약간 오염 같은 거 있는데 디씨가 조금 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.561,
                "end": 15.669
            },
            {
                "speaker_id": "3",
                "transcription": "아 저희가 디씨를 해서 측정을 한 금액이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.679,
                "end": 18.619
            },
            {
                "speaker_id": "1",
                "transcription": "그쵸.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.629,
                "end": 20.024
            },
            {
                "speaker_id": "3",
                "transcription": "워낙에 너무 보스턴 백이 워낙 비싸거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.034,
                "end": 23.855
            },
            {
                "speaker_id": "1",
                "transcription": "실패 그래도 우리 허니들도 혹시라도 빈티지 살 때 그런 하자 같은 거 있는 경우에는 한번 물어보는 게 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.865,
                "end": 34.220
            },
            {
                "speaker_id": "1",
                "transcription": "디씨가 되는 경우도 있고 이렇게 애초에 디씨가 포함된 가격으로 되는 것들도 있고 하기 때문에 나름 꿀 팁 빈티지 샵들도 다 약간",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.230,
                "end": 45.166
            }
        ]
    },
    "summary": "화자는 얼룩이 묻은 보스턴 백을 디씨해 결제하려다 실패하였다.",
