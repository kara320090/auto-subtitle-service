    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "초기에 뭘로 해야 한다고 배우는 건 있어도 그냥 아무거나 편한 걸로 하면 되고 뭘로 하던 아무 문제 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.912
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 직접 보여줘야겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.922,
                "end": 11.272
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 제가 에이알 소총을 하나 갖고 왔는데 이건 엠포거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.282,
                "end": 14.347
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 보시면 장전 손잡이 여기 달려 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.356,
                "end": 16.270
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 당겨서 장전을 하는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.280,
                "end": 18.624
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 장전 모션이 굉장히 쉬워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.634,
                "end": 20.317
            },
            {
                "speaker_id": "1",
                "transcription": "탄창을 넣고 당기고 여기 노리쇠 전진 버튼을 눌러주기만 하면 장전이 끝납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.327,
                "end": 25.682
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 그에 반해서 에이케이는 이 장전 손잡이 하나로 모든 걸 다 해결해야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.692,
                "end": 30.175
            },
            {
                "speaker_id": "1",
                "transcription": "이 에이케이의 장전 방법은 크게 3가지가 있는데 왼손 언더, 오른손, 왼손 오버 이렇게 3가지가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.187,
                "end": 37.297
            },
            {
                "speaker_id": "1",
                "transcription": "아 뭐 물론 다른 방법으로 장전하시는 분들도 있겠지만 대표적으로 이렇게 3가지예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.307,
                "end": 41.435
            },
            {
                "speaker_id": "1",
                "transcription": "단점이 가장 많은 왼손 리로딩부터 보면은 왼손이 넘어갈 때 옵틱이 왼손에 걸리적거리잖아요 여기에.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.445,
                "end": 47.625
            },
            {
                "speaker_id": "1",
                "transcription": "아 물론 이 모델은 레일이 없어서 옵틱을 못 달지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.635,
                "end": 51.484
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 장전 시에 총이 이렇게 고정이 되어 있는 게 아니라 얘가 돌아가거나 내려야 되기 때문에 느리다는 단점도 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.494,
                "end": 58.677
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 남은 장전 두 가지를 보여드리면 자 우선 에이알 계열 리로딩은 이렇게 오른손 검지로 탄창을 분리를 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.687,
                "end": 65.320
            },
            {
                "speaker_id": "1",
                "transcription": "분리와 동시에 왼손은 새 탄창을 넣고 장착이 됐으면 바로 왼손으로 이 노리쇠 전진 멈치를 눌러주면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.330,
                "end": 74.345
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 방금 전에 제가 에이케이는 이 장전 손잡이 하나로 모든 걸 다 해야 된다고 그랬잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.355,
                "end": 78.916
            },
            {
                "speaker_id": "1",
                "transcription": "그래 순서를 보여드리면 탄창 교체를 할 때 오른손 검지가 아무것도 못 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.926,
                "end": 83.826
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 잡고 쭉",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.836,
                "end": 86.500
            }
        ]
    },
    "summary": "남자 유튜버는 에이알과 에이케이 소총의 장전 방법을 직접 보여주고 있는데 에이알 소총은 탄창을 넣고 당기고 노리쇠 전진 버튼을 눌러주기만 하면 되는 것에 반해 장전 손잡이 하나로 모든 걸 해결해야 하는 에이케이 소총은 왼손 언더, 오른손, 왼손 오버 등 크게 3가지 방법으로 그 중 가장 단점이 많은 왼손 리로딩은 왼손이 넘어갈 때 옵틱이 왼손에 걸리고 장전 시 총이 고정되지 않기 때문에 느리다는 단점이 있고 나머지 장전 방법에서 에이알 소총은 오른손 검지로 탄창을 분리하고 분리와 동시에 새 탄창을 넣고 장착이 되면 왼손으로 노리쇠 전진 멈치를 눌러주면 되는 것에 반해 에이케이 소총은 탄창 교체를 할 때 오른손 검지를 사용할 수 없다.",
