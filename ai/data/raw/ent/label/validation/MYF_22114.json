        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "수문이 열려 있죠. 지금 뭐 붕어들이 자유자재로 왕래를 하고 있는 상황일 것 같애요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 5.134
            },
            {
                "speaker_id": "1",
                "transcription": "더군다나 며칠 전에 예를 들어가 봤더니 배수를 했더라고요여도",
                "sound_type": [
                    1,
                    2
                ],
                "start": 5.144,
                "end": 8.723
            },
            {
                "speaker_id": "1",
                "transcription": "지금 현재는 또 오름 수위입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.733,
                "end": 10.723
            },
            {
                "speaker_id": "1",
                "transcription": "아 쟤 또 깜빡깜빡 건들긴 하네",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.733,
                "end": 13.078
            },
            {
                "speaker_id": "1",
                "transcription": "어라 차가 두 대나 있네 저 분들 또 오름 수위 보러 오셨나",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.088,
                "end": 18.517
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 인제야 좀 살 것 같네",
                "sound_type": [
                    1,
                    2
                ],
                "start": 18.527,
                "end": 25.721
            },
            {
                "speaker_id": "1",
                "transcription": "아 지에 좀 추울라 그러네 오늘은 좀 늦게까지 할 생각이라 여유가 좀 있습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 25.731,
                "end": 31.567
            },
            {
                "speaker_id": "1",
                "transcription": "평상시 같으면 열 시에 철수할 건데 오늘은 11시 12시까지 해볼랍니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 31.577,
                "end": 36.955
            },
            {
                "speaker_id": "1",
                "transcription": "봉돌 잘 쓰고 있어 그나저나 언제 유튜브 복귀할까요. 예",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 36.965,
                "end": 44.579
            }
        ]
    },
    "summary": "남자는 밤 11시, 12시까지 낚시를 할 예정이다.",
