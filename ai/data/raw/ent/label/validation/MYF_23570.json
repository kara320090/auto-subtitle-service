        "term": [
            {
                "speaker_id": "1",
                "transcription": "늘 이어지는 패턴을 깨기가 힘들다고 호소한 적도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.717
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 더더욱 여배우의 한계를 깨뜨리는 도전을 계속하며 그러기 위해서는 더 다양한 한국 영화가 나와야 한다고 강조합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.727,
                "end": 9.472
            },
            {
                "speaker_id": "1",
                "transcription": "정말 연기를 잘하는 배우가 되는 것, 세계 3대 영화제에 참석하는 것이 앞으로의 꿈이라는 엄지원 배우",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.482,
                "end": 14.681
            },
            {
                "speaker_id": "1",
                "transcription": "지금까지의 연기 활동을 생각한다면 아주 먼 꿈이 아닌 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.691,
                "end": 18.234
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로도 엄지원 배우의 멋진 활동을 응원하며 오늘의 영상 마치겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.244,
                "end": 22.308
            },
            {
                "speaker_id": "1",
                "transcription": "시청해 주셔서 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.318,
                "end": 26.008
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 별로였으면 싫어요와 구독을 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.018,
                "end": 33.586
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 재밌으셨다면 좋아요와 구독을 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.596,
                "end": 36.469
            }
        ]
    },
