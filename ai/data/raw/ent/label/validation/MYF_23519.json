    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "양세형은 고등학교 2학년 때 SBS 공채 개그맨 시험에 도전했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.921
            },
            {
                "speaker_id": "1",
                "transcription": "결과는 단 한 번에 합격했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.931,
                "end": 4.530
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 그 기수 내에서 가장 막내였고 SBS 공채 사상 역대 최연소 개그맨이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.540,
                "end": 8.350
            },
            {
                "speaker_id": "1",
                "transcription": "또한 SBS에서 공채 7기를 2003년에 뽑았지만 2004년까지는 공채를 뽑지 않았기 때문에 양세형은 2004년도에 편입됐다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.360,
                "end": 14.692
            },
            {
                "speaker_id": "1",
                "transcription": "양세형과 같은 연도에 데뷔한 동기로는 이수근과 김신영, 오지헌 등이 있으며 유세윤, 장동민, 유민상, 박휘순은 후배 개그맨이라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.702,
                "end": 21.040
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 양세형은 미성년의 나이로 후배 박규선과 함께 서울로 상경해 대학로 박승대 홀에서 공연하기 시작했고 2004년 엠넷의 뻔뻔 개그쇼에서 전무후무하게 5주 연속 우승의 쾌거를 거뒀다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.050,
                "end": 30.372
            },
            {
                "speaker_id": "1",
                "transcription": "덕분에 남다른 아이디어와 센스 있는 실력을 인정 받았고 그 기세를 몰아 웃찾사로 공중파 데뷔에 성공했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.382,
                "end": 35.603
            },
            {
                "speaker_id": "1",
                "transcription": "양세형은 그야말로 새로운 돌풍을 일으킨 신인 개그맨이었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.613,
                "end": 38.570
            },
            {
                "speaker_id": "1",
                "transcription": "양세형과 같은 기수로는 김기욱, 박상철, 권성호 등이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.580,
                "end": 41.600
            },
            {
                "speaker_id": "1",
                "transcription": "양세형과 함께 그들은 화상고를 함께 했고 무겁게 떠오르기 시작했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.610,
                "end": 45.011
            },
            {
                "speaker_id": "1",
                "transcription": "양세형에겐 이 두 명이 과연 형제가 맞나 싶을 정도로 정말 하나도 안 닮은 형제가 한 명 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.021,
                "end": 48.955
            },
            {
                "speaker_id": "1",
                "transcription": "바로 양세형과 같이 개그맨으로 활동 중인 동생 양세찬이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.965,
                "end": 51.767
            },
            {
                "speaker_id": "1",
                "transcription": "처음 양세찬이 양세형을 따라 개그맨이 됐을 땐 양세형은 방송가에서 절대 형제임을 말하지 말라고 했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.777,
                "end": 56.800
            },
            {
                "speaker_id": "1",
                "transcription": "이유는 동생이 본인한테 의지하지 않고 자신과 똑같이 노력해서 성장하길 바래서라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.810,
                "end": 61.114
            },
            {
                "speaker_id": "1",
                "transcription": "또한 오히려 둘이 형제라고 말하면 대답이 뻥치지 마였다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.124,
                "end": 64.120
            },
            {
                "speaker_id": "1",
                "transcription": "외형적으로 닮진 않았지만 장난치는 건 똑닮은 양세형 형제는 과거 동두천 또라이 형제로 유명했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.130,
                "end": 68.760
            },
            {
                "speaker_id": "1",
                "transcription": "양세형은 라디오에서 만약 우리 형제가 여태껏 장난을 친 사람들에게 모두 뺨을 맞아야 한다면 동두천 시민들 중 5분의 1 정도한테는 뺨을 맞아야 할 거라고 밝히기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.770,
                "end": 76.541
            },
            {
                "speaker_id": "1",
                "transcription": "이들의 어린 시절을 보면 육아 난이도 최상이 분명하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.551,
                "end": 80.980
            }
        ]
    },
    "summary": "20대 남성이 양세찬의 개그맨 데뷔 과정과 그의 동생인 양세형과의 어린 시절에 대해 말한다.",
