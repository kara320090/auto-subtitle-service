        "term": [
            {
                "speaker_id": "1",
                "transcription": "이쁘긴 한 거 같습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.757
            },
            {
                "speaker_id": "2",
                "transcription": "약간 동문회관 같은",
                "sound_type": [
                    2
                ],
                "start": 1.767,
                "end": 2.751
            },
            {
                "speaker_id": "1",
                "transcription": "그렇죠 그렇죠",
                "sound_type": [
                    2
                ],
                "start": 2.761,
                "end": 4.387
            },
            {
                "speaker_id": "3",
                "transcription": "아니 그리고 인제 UCI가 그 얘기 들어보셨어요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.397,
                "end": 13.704
            },
            {
                "speaker_id": "3",
                "transcription": "서부의 아이비리그 공립학교계의 아이비리그에 꼽히는 UCI가 이런 말에 대해서 어떻게 생각하시는지",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.714,
                "end": 23.474
            },
            {
                "speaker_id": "1",
                "transcription": "말이라니 엄청난 영광이긴 합니다.",
                "sound_type": [
                    2
                ],
                "start": 23.484,
                "end": 26.551
            },
            {
                "speaker_id": "1",
                "transcription": "엄청난 영광이긴 한데 잘은 모르겠어요.",
                "sound_type": [
                    2
                ],
                "start": 26.561,
                "end": 29.774
            },
            {
                "speaker_id": "3",
                "transcription": "음 재학생으로서 그렇게 크게 공감하지 않는 부분이지만",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.784,
                "end": 33.881
            },
            {
                "speaker_id": "1",
                "transcription": "그렇죠. 아무래도 이거는 안에 있다고 보니까 그 차이을 잘 느낄 수는 없는 거 같애요. 근데 얼핏 듣기로는",
                "sound_type": [
                    1,
                    2
                ],
                "start": 33.891,
                "end": 41.266
            }
        ]
    },
    "summary": "여성이 UCI가 서부의 아이비리그라는데 어떻게 생각하냐고 묻자 남성은 영광이긴 한데 재학생으로선 크게 공감하지 못한다고 말한다.",
