                "transcription": "아 진짜?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 34.544,
                "end": 35.230
            },
            {
                "speaker_id": "1",
                "transcription": "이름이 퓨로랜드야.",
                "sound_type": [
