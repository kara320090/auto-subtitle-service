        "term": [
            {
                "speaker_id": "1",
                "transcription": "내가 일본 가봤어 세 번.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.111
            },
            {
                "speaker_id": "2",
                "transcription": "세 번?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.121,
                "end": 2.012
            },
            {
                "speaker_id": "2",
                "transcription": "우리 완전 진짜 오타쿠처럼 놀 수 있을 것 같애",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.022,
                "end": 5.263
            },
            {
                "speaker_id": "2",
                "transcription": "그치?",
