                    2,
                    4
                ],
                "start": 5.273,
                "end": 6.871
            },
            {
                "speaker_id": "1",
                "transcription": "미친듯이 걍",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.881,
                "end": 8.008
            },
            {
                "speaker_id": "2",
                "transcription": "대놓고 그냥",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.018,
                "end": 9.335
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 대놓고 그냥",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 9.345,
                "end": 11.536
            },
            {
                "speaker_id": "1",
                "transcription": "재밌겠다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 11.546,
                "end": 14.782
            },
            {
                "speaker_id": "1",
                "transcription": "근데 진짜 가보고 싶은 곳이 있거든?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 14.792,
                "end": 16.477
            },
            {
                "speaker_id": "1",
                "transcription": "산리오 놀이공원이야.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 16.487,
                "end": 18.941
            },
            {
                "speaker_id": "2",
                "transcription": "어 맞아 나도 놀이공원 가보고 싶었다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 18.951,
                "end": 21.134
            },
            {
                "speaker_id": "1",
                "transcription": "이거거든?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 21.144,
                "end": 21.690
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 이런데 가보고 싶어요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 21.700,
                "end": 23.315
            },
            {
                "speaker_id": "1",
                "transcription": "가면은 산리오 머리띠 종류별로 다 있고",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 23.325,
                "end": 28.078
            },
            {
                "speaker_id": "1",
                "transcription": "막 음식이나 그런 것도 다",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 28.088,
                "end": 30.511
            },
            {
                "speaker_id": "2",
                "transcription": "이거 디즈니 월드가 아니고",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 30.521,
                "end": 32.658
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 산리오 랜드야.",
