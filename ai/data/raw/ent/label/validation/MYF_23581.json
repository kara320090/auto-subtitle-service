        "term": [
            {
                "speaker_id": "1",
                "transcription": "볶기의 달인이라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.112
            },
            {
                "speaker_id": "1",
                "transcription": "승우 아빠의 본명은 목진화로 별명은 볶진화였다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.122,
                "end": 4.043
            },
            {
                "speaker_id": "1",
                "transcription": "승우 아빠는 요리 실력만 출중한 것이 아니라 언어에도 능통하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.053,
                "end": 6.912
            },
            {
                "speaker_id": "1",
                "transcription": "무려 세 개 국어를 할 수 있는데 모국어인 한국어를 포함해서 영어는 다 년 간의 캐나다 생활 과정에서 익혔다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.922,
                "end": 11.898
            },
            {
                "speaker_id": "1",
                "transcription": "승우 아빠의 영어 실력은 샘 해밍턴과 함께 출연한 아리랑 TV의 요리 방송에서도 볼 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.908,
                "end": 16.202
            },
            {
                "speaker_id": "1",
                "transcription": "또한 캐나다 생활에 적응을 잘 못하고 있을 땐 하루 종일 DVD 대여점에서 빌린 일어 애니에 영어 자막을 깔고 보거나 다른 오덕 성향의 친구들과 매직 더 개더링, 유희왕 등을 하면서 시간을 보낸 덕에 일본어도 할 수 있다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.212,
                "end": 26.625
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 승우 아빠는 덕력이 상당하고 일반인들이 알기 힘든 씹덕 지식까지 많이 알고 있다.",
                "sound_type": [
                    2,
                    3
                ],
