        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "삼각대가 사망하셨습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.541
            },
            {
                "speaker_id": "1",
                "transcription": "새로 하나 사야겠다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.551,
                "end": 24.569
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 초보때로 돌아간 느낌.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.579,
                "end": 29.383
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 저는 집에 들어왔어요.",
                "sound_type": [
                    2
                ],
                "start": 29.393,
                "end": 33.037
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 한 것도 없는 데 피곤하고 그냥 그냥 진짜 한 게 없거든요.",
                "sound_type": [
                    2
                ],
                "start": 33.047,
                "end": 38.615
            },
            {
                "speaker_id": "1",
                "transcription": "아까 삼각대 박살 난 거 다이소에서 새 삼각대를 샀는데 짜잔 이때까지 한 번도 안 사본 종류의 삼각대를 한 번 사봤어요.",
                "sound_type": [
                    2
                ],
                "start": 38.625,
                "end": 50.490
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 좀 튼튼해 보이고 높이 조절도 잘 되는 것 같아서 한 번 써보려고요.",
                "sound_type": [
                    2
                ],
                "start": 50.500,
                "end": 55.434
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 갑자기 생각난 건데 제가 어제 새로 산 코트를 처음으로 입고 나갔다고 했잖아요.",
                "sound_type": [
                    2
                ],
                "start": 55.444,
                "end": 61.599
            },
            {
                "speaker_id": "1",
                "transcription": "제가 평소에 코트를 워낙 안 입다 보니까 그 코트에 뒤트임이 있는 사실도 잘 인지를 못했고 그게 새거라서 이렇게 실밥이 막혀 있다는 걸 모른 거예요.",
                "sound_type": [
                    2
                ],
                "start": 61.609,
                "end": 73.771
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 막 신나게 기분 좋은 입고 나갔는데",
                "sound_type": [
                    2
                ],
                "start": 73.781,
                "end": 76.576
            }
        ]
    },
    "summary": "저는 집에 들어왔고 다이소에서 새 삼각대를 샀고 어제 새로 산 코트를 처음으로 입고 나갔다고 했는데 제가 평소에 코트를 안 입다 보니까 코트 뒤트임이 있는 사실도 인지를 못했고 실밥으로 막혀 있다는 걸 몰랐다.",
