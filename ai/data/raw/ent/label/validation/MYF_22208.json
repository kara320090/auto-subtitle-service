        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 법적으로나 뭐 그런 부분을 떠나서 사람들 마음가짐이 달라요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.344
            },
            {
                "speaker_id": "1",
                "transcription": "여러 가지 국적을 가진 사람들이랑 일을 하는 남편이라서 그런지 당연히 내가 있고 내 삶이 먼저고 내 가족이 먼저고 그 다음에 내가 이 생활을 하기 위해서 잡이 있는 건 거예요.",
                "sound_type": [
                    2
                ],
                "start": 6.354,
                "end": 19.137
            },
            {
                "speaker_id": "1",
                "transcription": "이 내가 직장인 @이름1가 아니라 @이름1가 있고 @이름1 직장이 뿅뿅 이런 느낌으로 자기 삶을 되게 중요시 여겨요. 그래서 이렇게 주말에도 사회 보러 막 즐기고 일에 얽매여 있지 않은 거예요. 좀 여유있는 마음가짐. 그런게 점점 물이들다 보니까 일이랑 생활이 딱 구분도 더 잘 되고 좀 일할 때는 일하고 생활할 때는 생활하고 이렇게 잘됐던 것 같은데 요새는 재택근무 너무 많이해서 계속 일만 해. 법적으로 예를 들면 우리나라도 주 52시간 근무제하고 제도들을 실행하지만 우리 마음이 아직 워라밸 준비가 많이 안 된 편인데 저도 한국에서 그랬고 그래서 워커홀릭이 될 수밖에 없는 그런 구조가 있는 거. 예를 들면 나는 일이 없는데 과장님이 퇴근 안 해서 야근하시는 분들 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 19.147,
                "end": 70.249
            },
            {
                "speaker_id": "1",
                "transcription": "저희도 그랬거든요. 일이 많아서 야근을 하는 게 아닌 거야.",
                "sound_type": [
                    2
                ],
