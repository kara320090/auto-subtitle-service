                "start": 0.000,
                "end": 6.490
            },
            {
                "speaker_id": "1",
                "transcription": "아 붕어들이 들어오는 길을 잃어버렸을까요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.500,
                "end": 11.283
            },
            {
                "speaker_id": "1",
                "transcription": "우째서 그럴까 네비를 좀 달아줘야 되나 올라오는 길이 보여서요.",
                "sound_type": [
                    2,
