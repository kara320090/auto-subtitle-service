        "term": [
            {
                "speaker_id": "1",
                "transcription": "내가 똑같았어 오빠처럼 안 받았다가 다시 받고 하니까 다시 오더라고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.271
            },
            {
                "speaker_id": "2",
                "transcription": "안주 하나 줘볼까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.281,
                "end": 5.357
            },
            {
                "speaker_id": "1",
                "transcription": "이제 이렇게 맥주 마시고 여유 있게 시간 보내다가 어 잠들까해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.367,
                "end": 11.521
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1도 아직 잘려면 멀어보이는데 또 이러다가 졸리면 금방 또 잠들거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.531,
                "end": 17.105
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 12시까지 지켜보다가 재울까 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.115,
                "end": 21.440
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1 이것 봐.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.450,
                "end": 23.131
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 아직 12시가 안 돼서 조금 더 지켜보다가 재워야 될 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.141,
                "end": 28.562
            },
            {
                "speaker_id": "1",
                "transcription": "이것 봐 @이름1도 똑같이 발가락 따라하네?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.572,
                "end": 32.146
            },
            {
                "speaker_id": "2",
                "transcription": "@이름1 이거 누가 그렸어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.156,
                "end": 33.147
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 또 내일 아침에 일정 있는데 일정 그때 또 함께 계속 같이 해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.157,
                "end": 41.958
            },
            {
                "speaker_id": "1",
                "transcription": "안녕 잘자요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.968,
                "end": 44.759
            },
            {
                "speaker_id": "1",
                "transcription": "굿나잇",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.769,
                "end": 49.138
            },
            {
                "speaker_id": "1",
                "transcription": "이제 잠들었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.148,
                "end": 51.876
            },
            {
                "speaker_id": "1",
