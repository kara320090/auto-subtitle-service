        "term": [
            {
                "speaker_id": "1",
                "transcription": "유병재는 온라인에 올린 콘텐츠가 화제가 되어 방송에 출연하게 되었고 본의었든 아니었든 작가 겸 방송인이 된 케이스이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.650
            },
            {
                "speaker_id": "1",
                "transcription": "특히 유병재는 본인의 페이스북 계정에 여러 가지 어록들이나 정치나 사회에 대한 촌철살인 드립을 올리면서 대중들, 특히 젊은 세대들에게 많은 공감을 얻었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.660,
                "end": 13.706
            },
            {
                "speaker_id": "1",
                "transcription": "니가 아는 거라곤 니가 다 아는 줄 아는 것 뿐이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.716,
                "end": 16.030
            },
            {
                "speaker_id": "1",
                "transcription": "듣는 순간 기분 나쁜 말 기분 나빠하지 말고 들어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.040,
                "end": 18.540
            },
            {
                "speaker_id": "1",
                "transcription": "상처는 어째서 준 놈들이 받는 척 할까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.550,
                "end": 20.614
            },
            {
                "speaker_id": "1",
                "transcription": "걱정거리를 통장에 넣어두고 싶다 거기는 뭐 넣기만 하면 염병 다 없어지던데 등 한 번쯤 들어봤을 명언들이 바로 유병재가 페이스북을 통해 올린 어록들이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.624,
                "end": 28.344
            },
            {
                "speaker_id": "1",
                "transcription": "유병재는 2016년 토크쇼 택시에 출연해 유명해지기 위해 SNS 명언을 시작했느냐라는 질문에 웃기려고 했다라고 솔직하게 대답해 화제를 모으기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.354,
                "end": 36.611
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 SNS 명언으로 유명세를 탄 유병재는 이후 YG엔터테인먼트와 전속계약을 체결하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.621,
                "end": 43.710
            }
        ]
    },
    "summary": "20대 남성이 유병재가 작가 겸 방송인이 된 상황에 대해 말한다.",
