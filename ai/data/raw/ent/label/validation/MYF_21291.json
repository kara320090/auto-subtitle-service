        "term": [
            {
                "speaker_id": "1",
                "transcription": "낚시를 이렇게 자주 다니지는 못했지만요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 2.839
            },
            {
                "speaker_id": "1",
                "transcription": "아 다니긴 다녔습니다 근데 뭐 1시간 하다가 오고 2시간 하다가 오고 살짝 바쁘다 바빴습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.849,
                "end": 9.821
            },
            {
                "speaker_id": "1",
                "transcription": "지금 1달여 만에 월척을 잡은 것 같애요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.831,
                "end": 24.553
            },
            {
                "speaker_id": "1",
                "transcription": "옥수수로 다 바꾸자.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 24.563,
                "end": 35.281
            },
            {
                "speaker_id": "1",
                "transcription": "더도 말고 월척 1마리만 잡자 그러고 오기는 왔는데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 35.291,
                "end": 39.761
            },
            {
                "speaker_id": "1",
                "transcription": "좀 빨리 나오다 보니까 욕심이 생기네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 39.771,
                "end": 42.501
            },
            {
                "speaker_id": "1",
                "transcription": "이제 월척 이상 1마리 더 이왕이면 허리급까지 한번 노려 보도록 하겠습니다.",
                "sound_type": [
