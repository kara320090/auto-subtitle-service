                "end": 0.567
            },
            {
                "speaker_id": "2",
                "transcription": "간이 우리한테 너무 잘 맞아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.577,
                "end": 3.382
            },
            {
                "speaker_id": "1",
                "transcription": "응응",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.382,
                "end": 4.060
            },
            {
                "speaker_id": "2",
                "transcription": "고기가 부드럽네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.070,
                "end": 5.212
            },
            {
                "speaker_id": "2",
                "transcription": "근데 이거 맛있게 먹어야 되는 거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.222,
                "end": 6.953
            },
            {
                "speaker_id": "2",
                "transcription": "아 나도 맛있게 먹는 스타일은 아니여 가지고 유튜브 용어 뭐 있어요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.963,
                "end": 10.570
            },
            {
                "speaker_id": "2",
                "transcription": "와 맛있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.580,
                "end": 14.071
            },
            {
                "speaker_id": "2",
                "transcription": "쥐쥐, 쥐쥐는 게임할 때만 쓰는 건가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.081,
                "end": 18.855
            },
            {
                "speaker_id": "1",
                "transcription": "아니. 음식에 대한 얘기를 해야지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.855,
                "end": 20.802
            },
            {
                "speaker_id": "2",
                "transcription": "음식 맛있으니까 그냥 먹는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.802,
                "end": 23.182
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이거 승민이 형이 쓸게 없으시잖아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.180,
                "end": 25.167
            },
            {
                "speaker_id": "1",
                "transcription": "우리가 막 와 맛있다. 하",
                "sound_type": [
                    2,
                    3
                ],
