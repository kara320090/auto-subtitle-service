                    3
                ],
                "start": 0.649,
                "end": 2.251
            },
            {
                "speaker_id": "2",
                "transcription": "왜냐하면 이렇게는 나도 처음 끓여보니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.261,
                "end": 4.904
            },
            {
                "speaker_id": "2",
                "transcription": "어차피 내가 먹을 게 아니라 마음이 편하다.",
