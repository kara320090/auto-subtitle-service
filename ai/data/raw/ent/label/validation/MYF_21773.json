        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분 오늘은 금요일입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.786
            },
            {
                "speaker_id": "1",
                "transcription": "어제 간만에 일찍 자가지고 오늘 아침에 컨디션이 좋더라고요.",
                "sound_type": [
                    2
                ],
                "start": 2.796,
                "end": 7.233
            },
            {
                "speaker_id": "1",
                "transcription": "되게 사무실 올 때 추리하게 오는데 오늘 원피스도 입고 기분이 좋은 아침입니다.",
                "sound_type": [
                    2
                ],
                "start": 7.243,
                "end": 13.911
            },
            {
                "speaker_id": "1",
                "transcription": "음 저희가 새로운 사업 아이템으로 바꾸고 나서 그거를 막 빠르게 추진하기보다 이게 진짜 우리 둘 다가 원하는게 맞나 그거를 지금 조금 더 딥하게 생각을 해보고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 13.921,
                "end": 26.318
            },
            {
                "speaker_id": "1",
                "transcription": "그 유튜버이자 사업가 이신 일헥타르님이라고 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 26.328,
                "end": 31.001
            },
            {
                "speaker_id": "1",
                "transcription": "일헥타르 님의 말을 빌리자면 내가 진짜로 하고 싶은 거 그 포인트를 떨림이라고 표현을 하시거든요.",
                "sound_type": [
                    2
                ],
                "start": 31.011,
                "end": 39.065
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 이게 진짜 나의 떨림이 맞는지 근데 저는 이 작업이 너무 하고 싶었던 게 최근에 굉장히 감명 깊게 읽은 프리워커스 이 모빌스 그룹에서 쓴 이 책이 저의 가치관 이랑 너무 너무 잘 맞더라고요.",
                "sound_type": [
                    2
                ],
                "start": 39.075,
                "end": 54.349
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 이 분들이 일을 하는 이유 일하는 방식 팀을 이루는 그런 모습들 너무 제 가치관이랑 잘 맞는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 54.359,
                "end": 63.733
            }
        ]
    },
    "summary": "한 여자가 본인이 진짜로 하고 싶은 포인트를 떨림이라고 표현하고 있다.",
