        "term": [
            {
                "speaker_id": "1",
                "transcription": "폭격을 진짜 미친 듯이 받고 근데 이게 정말 아프거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.171
            },
            {
                "speaker_id": "1",
                "transcription": "눈물도 사실 날 뻔 했는데 참았어요.",
                "sound_type": [
                    2
                ],
                "start": 3.181,
                "end": 5.559
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 결론은 일단 저는 구체적인 목표가 없는 게 문제고 제발 한 가지를 끝내고 다른 일을 하래요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.569,
                "end": 12.063
            },
            {
                "speaker_id": "1",
                "transcription": "정말 저에게는 그게 어렵거든요.",
                "sound_type": [
                    2
                ],
                "start": 12.073,
                "end": 14.049
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그걸 고쳐야 된대요 저한테 마지막까지 제발 잡생각 그만하고 공부",
                "sound_type": [
                    2,
