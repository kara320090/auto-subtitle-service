    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "제시카 외동딸 일리노이 시카고 과선배는 김진모 그는 네 사촌",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.100
            },
            {
                "speaker_id": "1",
                "transcription": "세계 무대에서 한국 영화의 위상을 떡상 시켜버린 영화 기생충",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.100,
                "end": 9.140
            },
            {
                "speaker_id": "1",
                "transcription": "그 흥행에 주역엔 제시카 기정 역을 맡은 박소담이 있었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.150,
                "end": 12.153
            },
            {
                "speaker_id": "1",
                "transcription": "박소담이 봉준호 감독을 만나 캐스팅 된 과정이 알려져 화제가 되기도 했는데 이 둘의 첫 만남은 기생충이 아니라 영화 옥자였다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.163,
                "end": 19.108
            },
            {
                "speaker_id": "1",
                "transcription": "여주인공 미자 역을 찾던 중 박소담의 연기를 보게 된 봉준호 감독은 10대 역할을 맡겨도 되겠는데라고 생각했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.118,
                "end": 25.526
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 실제로 만나서 보니 생각했던 나이보다 10살이 더 많아 캐스팅은 하지 않았다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.536,
                "end": 30.105
            },
            {
                "speaker_id": "1",
                "transcription": "그 대신 차나 한 잔 하고 가라며 박소담과 여러 이야기를 하며 친해졌고 그 인연이 기생충으로 이어진 것이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.115,
                "end": 36.350
            },
            {
                "speaker_id": "1",
                "transcription": "사실 박소담은 기생충을 찍기 전 슬럼프가 왔다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.360,
                "end": 39.146
            },
            {
                "speaker_id": "1",
                "transcription": "계속해서 작품을 하며 앞으로 달리기만 하다가 대중들의 관심과 압박을 이기지 못하고 휴식을 결정한 것이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.156,
                "end": 44.792
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 친분이 있었던 봉준호 감독을 통해 기적처럼 기생충이라는 작품을 만나게 됐고 자신의 최전성기를 맞이하게 됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.802,
                "end": 51.392
            },
            {
                "speaker_id": "1",
                "transcription": "한국 영화 최초로 칸 영화제 황금종려상 수상 국내 영화 역대 매출액 1위에 빛나는 영화 기생충",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.402,
                "end": 57.200
            },
            {
                "speaker_id": "1",
                "transcription": "싸이, 김연아, 손흥민에 이어 4번째로 두 유 노우 시리즈에 탑승한 기생충의 흥행엔",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.210,
                "end": 61.995
            }
        ]
    },
    "summary": "화자는 기생충에서 흥행의 주역을 맡은 박소담이 봉준호 감독을 만나 캐스팅 된 과정과 슬럼프를 겪게 된 시간까지 말하고 있다.",
