        "term": [
            {
                "speaker_id": "1",
                "transcription": "는 2순위인 거죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.759
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 내가 하는 뭐 이러 이런 거에서 남들에게 이런 거 줄 수 있겠다.",
                "sound_type": [
                    2
                ],
                "start": 1.769,
                "end": 5.997
            },
            {
                "speaker_id": "1",
                "transcription": "이런 느낌인 거죠.",
                "sound_type": [
                    2
                ],
                "start": 6.007,
                "end": 6.947
            },
            {
                "speaker_id": "1",
                "transcription": "근데 내가 진짜 남들한테 뭘 주고 싶지?",
                "sound_type": [
                    2
                ],
                "start": 6.957,
                "end": 9.599
            },
            {
                "speaker_id": "1",
                "transcription": "그게 상품이든 콘텐츠든 상담이든 솔직히 잘 모르겠더라고요.",
                "sound_type": [
                    2
                ],
                "start": 9.609,
                "end": 15.102
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 지금까지 제가 유튜브를 하면서 주고 싶었던 건 사실 확실하거든요.",
                "sound_type": [
                    2
                ],
                "start": 15.112,
                "end": 19.246
            },
            {
                "speaker_id": "1",
                "transcription": "사람들은 보통 행복을 되게 거창하게 생각하기도 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 19.256,
                "end": 23.867
            },
            {
                "speaker_id": "1",
                "transcription": "아 내가 뭔가를 이루면 행복해지겠지?",
                "sound_type": [
                    2
                ],
                "start": 23.877,
                "end": 26.583
            },
            {
                "speaker_id": "1",
                "transcription": "돈이 많아지면 행복해지겠지?",
                "sound_type": [
                    2
                ],
                "start": 26.593,
                "end": 28.189
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 직장에 들어가면",
                "sound_type": [
                    2
                ],
                "start": 28.199,
                "end": 29.662
            }
        ]
    },
    "summary": "내가 남들한테 뭘 주고 싶은지 상품이든 콘텐츠든 상담이든 잘 모르겠다고 여자가 말하고 있다.",
