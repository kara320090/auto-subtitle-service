        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 그 말도 되게 위안이 됐고 그리고 제가 이제 재물운도 물어 봤죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.633
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 제가 돈을 좀 넉넉히 벌고 살 수 있을까요?",
                "sound_type": [
                    2
                ],
                "start": 4.643,
                "end": 7.406
            },
            {
                "speaker_id": "1",
                "transcription": "30대 한 중후반으로 갈수록 돈을 많이 벌거고 근데 제가 어디서 사주를 봐도 항상 저는 30대부터 잘 된다고 했거든요.",
                "sound_type": [
                    2
                ],
                "start": 7.416,
                "end": 16.699
            },
            {
                "speaker_id": "1",
                "transcription": "20대까지 터널의 시기라고 내 거를 하면 30대 중반 후반까지 잘 된다 이 얘기를 제가 진짜 많이 들었어요.",
                "sound_type": [
                    2
                ],
                "start": 16.709,
                "end": 24.410
            },
            {
                "speaker_id": "1",
                "transcription": "여기서도 아니나 다를까 이렇게 얘기를 하셨는데 그런데 이 얘기는 처음 들었거든요.",
                "sound_type": [
