            },
            {
                "speaker_id": "1",
                "transcription": "과연 선천적 운동 천재라는 반응을 보였다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.181,
                "end": 5.806
            },
            {
                "speaker_id": "1",
                "transcription": "체험 삶의 현장 촬영 차 갔던 복싱장에서는 감독이 이쪽을 권유할 정도였다고 한다.",
                "sound_type": [
