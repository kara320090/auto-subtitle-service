        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 다 마실 수 있을 거 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.512
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 조금 한두 세잔밖에 안 남았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.522,
                "end": 4.723
            },
            {
                "speaker_id": "1",
                "transcription": "딱 요 안주랑 먹으면 끝",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.733,
                "end": 8.971
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 편집하면 몇 분짜리 영상이 될지 모르겠네 내가 쉬지 않고 떠들어 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.981,
                "end": 17.079
            },
            {
                "speaker_id": "1",
                "transcription": "지금 영상 찍은 것만 해도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.089,
                "end": 20.338
            },
            {
                "speaker_id": "1",
                "transcription": "한 한 시간 넘었거든 한 시간",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.348,
                "end": 23.474
            },
            {
                "speaker_id": "1",
                "transcription": "역대급 긴 영상이 되지 않을까?",
