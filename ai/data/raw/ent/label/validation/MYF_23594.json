        "term": [
            {
                "speaker_id": "1",
                "transcription": "비투비의 서은광, 허각, 개그우먼 김숙 등이 임창정의 팬으로 유명한데 실제로 비투비의 은광은 임창정의 하위 호환 버전이라고 할 만큼 창법이 유사하다.",
                "sound_type": [
                    2,
