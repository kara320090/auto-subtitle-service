        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 켜놓고 진입을 하게 되면 이 라이트를 보고 나 여기 있어요 하는 꼴밖에 안되는 거거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.155
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 주인공 입장에서는 위치가 이게 훤히 보이니까 오히려 사격이 편해지겠죠.",
                "sound_type": [
                    2
                ],
                "start": 5.162,
                "end": 9.167
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 차이를 둬서 엑스트라들의 총기 숙련도가 존윅보다 좀 떨어진다 뭐 이런 걸 은연중에 연출하려고 한 게 아닌가 싶어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.177,
                "end": 19.916
            },
            {
                "speaker_id": "1",
                "transcription": "여기서도 보시면 라이트 불빛으로 위치 다 보이잖아요.",
                "sound_type": [
                    2,
