                    3,
                    5
                ],
                "start": 17.374,
                "end": 19.110
            },
            {
                "speaker_id": "1",
                "transcription": "뛸려다가 에이전트랑 좀 뭐가 있어가지고 그 저기 세미프로.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 19.120,
                "end": 23.601
            },
            {
                "speaker_id": "2",
                "transcription": "아 그럼 케이쓰리, 케이포에서 뛰신 거예요?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 23.611,
                "end": 26.531
            },
            {
                "speaker_id": "1",
                "transcription": "거기서 뛸려다가 좀 계약이 마음에 안 들더라고. 뭐 연봉도 그렇고.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 26.541,
                "end": 30.836
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저기 동남아에 태국.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 30.846,
                "end": 33.115
            },
            {
                "speaker_id": "2",
                "transcription": "아 태국 프로리그?",
