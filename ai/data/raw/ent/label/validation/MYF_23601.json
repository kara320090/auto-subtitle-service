        "term": [
            {
                "speaker_id": "1",
                "transcription": "MBC 스포츠 뉴스에 과거 안정환과 이동국의 레전드 짤이 나왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.108
            },
            {
                "speaker_id": "1",
                "transcription": "영상 속에서 안정환이 킥 한 볼을 이동국은 트래핑에 성공했는데 이동국이 킥한 볼을 안정환은 완벽하게 볼 트래핑을 못한 탓에 이동국이 아오 진짜라고 외치고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.118,
                "end": 11.720
            },
            {
                "speaker_id": "1",
                "transcription": "이 영상이 공개되자 바로 100만 뷰를 돌파했으며 네티즌들 반응 또한 뜨거웠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.730,
                "end": 15.262
            },
            {
                "speaker_id": "1",
                "transcription": "한국 축구 역사상 최고의 짤 국동와 아유 진짜는 레전드다 등등의 반응을 보이며 과거 안정환과 이동국의 모습을 그리워했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.272,
                "end": 21.781
            },
            {
                "speaker_id": "1",
                "transcription": "한 때 수려한 외모로 대한민국을 흔들었던 축구선수 안정환은 은퇴 후에 살이 찌며 테리우스라는 별명을 들을 수 없었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.791,
                "end": 27.036
            },
            {
                "speaker_id": "1",
                "transcription": "대신을 슈퍼마리오라는 별명이 붙여지게 됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.046,
                "end": 29.318
            },
            {
                "speaker_id": "1",
                "transcription": "또한 은퇴 후 예능 활동을 계속해 왔는데 최근 방영한 위대한 배테랑에도 출연했었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.328,
                "end": 33.767
            }
        ]
    },
    "summary": "한 남성이 과거 안정환과 이동국이 트래핑을 하는 영상이 화제를 모았던 일과 현재는 은퇴 후 살이 쪘다는 얘기를 하고 있다.",
