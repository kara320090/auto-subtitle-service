    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "기분이 좋잖아요 뭔가 좀 택티컬한 느낌",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.269
            },
            {
                "speaker_id": "1",
                "transcription": "파란색도 보여드리 우와 파란색도 괜찮네 예쁘네.",
                "sound_type": [
                    2
                ],
                "start": 2.279,
                "end": 4.900
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 소재는 둘 다 같은 소재고요.",
                "sound_type": [
                    2
                ],
                "start": 4.910,
                "end": 7.093
            },
            {
                "speaker_id": "1",
                "transcription": "이 끈도 여기 다 박스 안에 동봉되어 있어요.",
                "sound_type": [
                    2
                ],
                "start": 7.103,
                "end": 9.367
            },
            {
                "speaker_id": "1",
                "transcription": "자 그럼 이 나이프 소지의 법은 어떻게 되느냐?",
                "sound_type": [
                    2
                ],
                "start": 9.377,
                "end": 11.552
            },
            {
                "speaker_id": "1",
                "transcription": "우선 픽스드나이프 기준 15cm를 넘지 않으면 합법입니다.",
                "sound_type": [
                    2
                ],
                "start": 11.562,
                "end": 15.182
            },
            {
                "speaker_id": "1",
                "transcription": "15cm를 넘으면 도검소지허가증을 발급받으셔야 돼요.",
                "sound_type": [
                    2
                ],
                "start": 15.192,
                "end": 18.041
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 접히는 폴딩 나이프 기준 6cm를 넘으시면 도검소지허가증을 발급받으셔야 되고요.",
                "sound_type": [
                    2
                ],
                "start": 18.051,
                "end": 22.868
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 이 오라이트 폴딩나이프는 3cm니까 도검소지허가증을 따로 발급받지 않으셔도 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 22.878,
                "end": 28.129
            },
            {
                "speaker_id": "1",
                "transcription": "이제 제일 중요한 가격을 한번 얘기해볼게요.",
                "sound_type": [
                    2
                ],
                "start": 28.139,
                "end": 30.255
            },
            {
                "speaker_id": "1",
                "transcription": "이 제품의 가격은 51900원",
                "sound_type": [
                    2
                ],
                "start": 30.265,
                "end": 32.721
            },
            {
                "speaker_id": "1",
                "transcription": "알아요 이게 아무리 성능이 좋아도 가격이 조금 부담 되시죠?",
                "sound_type": [
                    2
                ],
                "start": 32.731,
                "end": 35.690
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이벤트 기간 동안 30퍼센트나 할인을 한대요.",
                "sound_type": [
                    2
                ],
                "start": 35.700,
                "end": 38.265
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 51900원에서 15570원을 할인한 36330원에 판매가 되는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 38.275,
                "end": 43.405
            },
            {
                "speaker_id": "1",
                "transcription": "기간은 4월 25일 월요일 20시부터 4월 29일 금요일 24시까지예요.",
                "sound_type": [
                    2
                ],
                "start": 43.415,
                "end": 48.841
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 만약에 이 영상을 이 기간이 끝나고 나서 보셨다?",
                "sound_type": [
                    2
                ],
                "start": 48.851,
                "end": 51.958
            },
            {
                "speaker_id": "1",
                "transcription": "걱정 마세요 여기 아래에 코드 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 51.968,
                "end": 53.944
            },
            {
                "speaker_id": "1",
                "transcription": "그거 구매 시에 입력해도 10퍼센트 할인됩니다.",
                "sound_type": [
                    2
                ],
                "start": 53.954,
                "end": 56.935
            },
            {
                "speaker_id": "1",
                "transcription": "구매 링크는 아래 고정댓글에 남겨놓을게요.",
                "sound_type": [
                    2
                ],
                "start": 56.945,
                "end": 59.435
            },
            {
                "speaker_id": "1",
                "transcription": "링크를 타고 들어가서 구매하시면 항상 쪼들리는 제 실험비로 일부 지급이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 59.445,
                "end": 64.161
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 끝나기 전에 잠깐만요.",
                "sound_type": [
                    2
                ],
                "start": 64.171,
                "end": 65.722
            },
            {
                "speaker_id": "1",
                "transcription": "이거 2개도 있는데 이번에 신제품 나왔다고 보내주셨더라고요.",
                "sound_type": [
                    2
                ],
                "start": 65.732,
                "end": 68.751
            },
            {
                "speaker_id": "1",
                "transcription": "이건 워리어 3S고 이건 오딘 GL 미니예요.",
                "sound_type": [
                    2
                ],
                "start": 68.761,
                "end": 71.942
            },
            {
                "speaker_id": "1",
                "transcription": "언박싱부터 해보죠.",
                "sound_type": [
                    2
                ],
                "start": 71.952,
                "end": 73.383
            },
            {
                "speaker_id": "1",
                "transcription": "고급지구만",
                "sound_type": [
                    2
                ],
                "start": 73.393,
                "end": 74.707
            }
        ]
    },
    "summary": "나이프 소지의 법은 우선 픽스드나이프 기준 15cm를 넘지 않으면 합법이고 15cm를 넘으면 도검소지허가증을 발급받으셔야 되고 접히는 폴딩 나이프 기준 6cm를 넘으시면 도검소지허가증을 발급받으셔야 된다.",
