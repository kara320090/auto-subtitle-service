        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이준익 감독의 영화 왕의 남자는 이준기의 배우 인생을 바꿨다고 할 만큼 이준기에게 있어 아주 중요한 영화이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.059
            },
            {
                "speaker_id": "1",
                "transcription": "인터뷰나 기사에 따라 다르지만 대략 3000 대 1의 경쟁률을 뚫고 공길역으로 캐스팅되었다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.069,
                "end": 11.463
            },
            {
                "speaker_id": "1",
                "transcription": "이준기는 약 1달 동안 이어진 3번의 오디션에 참여하면서 다른 지원자들과 차별화될 수 있도록 노력했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.473,
                "end": 17.553
            },
            {
                "speaker_id": "1",
                "transcription": "특히 마지막 3차 오디션에서 광대극을 펼치는 장면을 보여줄 때 물구나무를 서서 다리를 쫙 벌려 관계자에게 좋은 반응을 얻어낸 일화는 이미 유명할 정도이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.563,
                "end": 25.991
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 상대역인 장생역의 감우성은 처음에 이준기를 반대했었다고 하는데 그 이유는 이준기가 들어오자마자 인사했을 때 너무 남자애같았기 때문이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.001,
                "end": 34.053
            },
            {
                "speaker_id": "1",
                "transcription": "영화 왕의 남자는 최종적으로 1230만명의 관객을 동원하며 천만관객 영화 반열에 올라섰고 이와 함께 예쁜 남자 신드롬 왕남 폐인이라는 신조어가 생겨나기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.063,
                "end": 43.831
            },
            {
                "speaker_id": "1",
                "transcription": "이준기가 출연한 광고 미녀는 석류를 좋아해는 음료 신제품 가운데 최단기간 매출 100억을 돌파하는 기록을 세우기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.841,
                "end": 50.228
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 광고는 이준기가 지워버리고 싶어 하는 흑역사이기도 하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.238,
                "end": 53.736
            },
            {
                "speaker_id": "1",
                "transcription": "코믹한 구성에 오글거리는 설정 이준기의 능청스런 연기와 노래가 더해졌기 때문이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.746,
                "end": 58.068
            },
            {
                "speaker_id": "1",
                "transcription": "사람들은 조성모의 매실 광고를 이은 충격적인 CF로 평가하기도 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.078,
                "end": 61.856
            },
            {
                "speaker_id": "1",
                "transcription": "조성모는 이준기의 CF를 보면서 저 친구도 집안이 많이 어려웠나보군하고 생각했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.866,
                "end": 66.690
            },
            {
                "speaker_id": "1",
                "transcription": "그 후로도 꾸준히 이 미녀는 석류를 좋아해 광고를 흑역사로 꼽곤 했지만 최근에는 해탈한 건지 전혀 부끄럽지 않다고 말하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.700,
                "end": 76.000
            }
        ]
    },
    "summary": "화자는 이준기가 엄청난 경쟁률을 뚫고 인생을 바꿨다고 할 만큼의 영화인 왕의 남자에 캐스팅이 되고 캐스팅이 되기까지의 일화를 이야기하고 미녀는 석류를 좋아해 CF를 이준기가 흑역사라고 하지만 최근에는 부끄럽지 않다고 한다고 한다.",
