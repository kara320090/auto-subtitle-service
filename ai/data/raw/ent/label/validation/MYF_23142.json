        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 UCI에서 제일 좀 뭐라 하지 경쟁률이 높은 학과는 어떤 학과예요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.495
            },
            {
                "speaker_id": "2",
                "transcription": "가장 경쟁률이 높은 학과는 어 그렇지만 제가 제가 다녔던 아 바이올로지입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.505,
                "end": 14.664
            },
            {
                "speaker_id": "2",
                "transcription": "이러면서 농담 농담이구요.",
                "sound_type": [
                    2
                ],
                "start": 14.674,
                "end": 16.946
            },
            {
                "speaker_id": "2",
                "transcription": "근데 바이올로지가 맞아요.",
                "sound_type": [
                    2
                ],
                "start": 16.956,
                "end": 18.508
            },
            {
                "speaker_id": "1",
                "transcription": "자부심이 대단하시네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.518,
                "end": 20.059
            },
            {
                "speaker_id": "2",
                "transcription": "자부심이 저 죄송합니다. 농담이었어요. 근데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.069,
                "end": 24.463
            },
            {
                "speaker_id": "2",
                "transcription": "근데 정말로 바이올로지컬 사이언스가 맞습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.473,
                "end": 26.199
            },
            {
                "speaker_id": "2",
                "transcription": "거기서 가장 경쟁률이 세고 가장 어 알려져 있는 곳이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.209,
                "end": 32.546
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 제가 찾아보다가 봤는데 화학 쪽에서 그 노벨상 수상자도 배출이 되었다고 교수님 중에서",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.556,
                "end": 41.846
            },
            {
                "speaker_id": "2",
                "transcription": "교수님 성함이",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.856,
                "end": 45.533
            }
        ]
    },
    "summary": "남성은 UCI에서 가장 경쟁률이 높은 학과는 바이올로지컬 사이언스라고 답한다.",
