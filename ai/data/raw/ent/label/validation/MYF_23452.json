        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "김구라에게는 친형과 친동생이 1명씩 있는데 그렇게 친밀하지는 않다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.692
            },
            {
                "speaker_id": "1",
                "transcription": "김구라의 말에 따르면 각개전투를 하는 집안이라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.702,
                "end": 6.392
            },
            {
                "speaker_id": "1",
                "transcription": "특히 여동생의 경우 동생이 젊었을 때 연애를 하다가 집 앞에서 김구라에게 남자친구와 있는 모습을 들켰는데 그때 김구라가 남자친구에게 쌍욕을 했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.402,
                "end": 14.008
            },
            {
                "speaker_id": "1",
                "transcription": "그 뒤로 동생이 김구라를 벌레 보듯 했고 사이가 멀어졌다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.018,
                "end": 17.254
            },
            {
                "speaker_id": "1",
                "transcription": "그 후로는 자신의 오빠가 김구라라는 사실을 잘 알리지 않는다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.264,
                "end": 20.727
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 김구라가 불효 자식은 아니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.737,
                "end": 22.591
            },
            {
                "speaker_id": "1",
                "transcription": "아버지가 임종을 앞두고 나의 낙은 현동이가 라디오 방송하는 걸 듣는 것이다 현동이가 마지막까지 방송하는 걸 보고싶다라고 하자",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.601,
                "end": 28.380
            },
            {
                "speaker_id": "1",
                "transcription": "방송을 취소하지 않고 끝까지 녹화를 한 후 임종을 보러 갔다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.390,
                "end": 33.733
            }
        ]
    },
    "summary": "김구라에게는 친형과 친동생이 1명씩 있고　각개전투를 하는 집안이며 여동생과는 동생이 젊었을 때 집 앞에서 김구라가 남자친구에게 욕을 해서 사이가 멀어졌지만 아버지에게 불효 자식은 아니다.",
