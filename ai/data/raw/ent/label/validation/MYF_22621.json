        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "실제로 군인도 시계는 필수품으로 가지고 다녀요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.299
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 이 손목시계 자체가 전쟁을 위해 만들어진 발명품입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.309,
                "end": 7.088
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 제 영상에 나왔던 대부분의 시계가 전자시계나 쿼츠 시계가 아닌 이런 톱니바퀴가 들어간 기계식 시계였기 때문에 내구성 자체가 그렇게 좋은 시계들은 아니었습니다.",
                "sound_type": [
                    2
                ],
                "start": 7.098,
                "end": 16.511
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 제가 기계식 시계들 중에서는 좀 튼튼함이 강조된 스포츠성이 강한 그런 기계식 시계들만 써 왔거든요.",
                "sound_type": [
                    2
                ],
                "start": 16.521,
                "end": 23.632
            },
            {
                "speaker_id": "1",
                "transcription": "대표적으로 이런 탐험가를 위해 만들어진 렉스 익스플로러 1 같은 모델이 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.642,
                "end": 28.017
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 이게 뭐 스포츠성이 아무리 강조 됐는 이 탐험가를 위해 만들어진 시계느니고 해도 기계식 시계 특성상 총기 반동에 오래 노출되면 당연히 망가질 수밖에 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.027,
                "end": 38.427
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 그동안 망가뜨린 시계만 해도 한 바구니예요.",
                "sound_type": [
                    2
                ],
                "start": 38.437,
                "end": 41.585
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 이 시계도 오버 홀 맡겨 가지고 좀 뚜껑 까 보니까 안에 망가진 부품들이 좀 있어서 몇개 부품도 갈았어요. 그때마다 좀 더 튼튼하고",
                "sound_type": [
                    2
                ],
                "start": 41.595,
                "end": 49.783
            }
        ]
    },
    "summary": "한 남성이 군인도 필수품으로 가지고 다니는 시계가 전쟁을 위해 만들어 진 발명품임을 말하며 영상에서 보였던 대부분의 시계가 내구성이 좋은 시계가 아니었지만 탐험가를 위해 만들어진 스포츠성이 강한 기계식 시계들만 써 왔으며 총기 반동에 오래 노출 시켜서 망가뜨린 시계가 많았고 지금 보이는 시계도 망가진 부품들이 있어 교체했다고 설명하고 있다.",
