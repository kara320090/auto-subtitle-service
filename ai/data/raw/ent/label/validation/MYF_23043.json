        "term": [
            {
                "speaker_id": "1",
                "transcription": "망 같은 거 쓰고 해야 겠다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.662
            },
            {
                "speaker_id": "2",
                "transcription": "그니까.",
                "sound_type": [
                    2
                ],
                "start": 1.672,
                "end": 2.558
            },
            {
                "speaker_id": "3",
                "transcription": "연기도 뿜어야 되는 데.",
                "sound_type": [
                    2
                ],
                "start": 2.568,
                "end": 4.895
            },
            {
                "speaker_id": "2",
                "transcription": "그 머리에 쓰는 거 같은 거는 없으신가요? 집에.",
                "sound_type": [
                    2
                ],
                "start": 4.905,
                "end": 13.721
            },
            {
                "speaker_id": "1",
                "transcription": "조심해야겠다.",
