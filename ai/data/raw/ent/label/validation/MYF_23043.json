                    2,
                    4
                ],
                "start": 13.731,
                "end": 15.272
            },
            {
                "speaker_id": "1",
                "transcription": "얼굴에 여기 막 앉은 것 같은 데.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 15.282,
                "end": 18.030
            },
            {
                "speaker_id": "2",
                "transcription": "오 일로 오는 데?",
                "sound_type": [
                    2
                ],
                "start": 18.040,
                "end": 19.685
            },
            {
                "speaker_id": "2",
                "transcription": "오우씨 일로 온다. 안되겠다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.695,
                "end": 21.760
            },
            {
                "speaker_id": "2",
                "transcription": "그리 가자 우리.",
