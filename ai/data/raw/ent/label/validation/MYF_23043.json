                    2,
                    4
                ],
                "start": 21.770,
                "end": 22.621
            },
            {
                "speaker_id": "1",
                "transcription": "머릿속에 들어 가는 것 같아 벌이.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 22.631,
                "end": 24.902
            },
            {
                "speaker_id": "3",
                "transcription": "그럼 쏘는 데 가만히 있어 가만히.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.912,
                "end": 26.528
            },
            {
                "speaker_id": "2",
                "transcription": "들어갔어요. 머릿속에 여기.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 26.538,
                "end": 27.747
            },
            {
                "speaker_id": "2",
                "transcription": "진짜야?",
                "sound_type": [
                    2
                ],
                "start": 27.757,
                "end": 28.350
            },
            {
                "speaker_id": "1",
                "transcription": "응 여기 있어.",
                "sound_type": [
                    2
                ],
                "start": 28.360,
                "end": 28.927
            },
            {
                "speaker_id": "2",
                "transcription": "아까는 없었는데?",
