        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 앞으로는 짬낚 때도 종종 저 뜰채를 펴야 되겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 13.143
            },
            {
                "speaker_id": "1",
                "transcription": "자 모두 옥무침으로 바꾸겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.153,
                "end": 16.015
            },
            {
                "speaker_id": "1",
                "transcription": "저번 영상에 이제 안 보신 분들, 못 보신 분들을 위해서 제가 말씀드릴게요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.025,
                "end": 20.839
            },
            {
                "speaker_id": "1",
                "transcription": "일반 옥수수예요.",
