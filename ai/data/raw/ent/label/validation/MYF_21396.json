        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "삭은 수초들이 굉장히 많은데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.988
            },
            {
                "speaker_id": "1",
                "transcription": "지금 에어 봉돌을 제가 살짝 풀어서 좀 예민하게 했습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.998,
                "end": 9.524
            },
            {
                "speaker_id": "1",
                "transcription": "그랬더니 나오네요.",
                "sound_type": [
                    2
                ],
                "start": 9.534,
                "end": 20.865
            },
            {
                "speaker_id": "1",
                "transcription": "올해 들어서 아직까지 계측 대상의 붕어는 만나지는 못했습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.875,
                "end": 25.829
            },
            {
                "speaker_id": "1",
                "transcription": "아 1월 말이기는 하지만 아직 2월도 안 됐으니까요.",
                "sound_type": [
                    2
                ],
                "start": 25.839,
                "end": 28.875
            },
            {
                "speaker_id": "1",
                "transcription": "여유를 갖고 자 오늘 수심이 굉장히 낮은 곳에서 낚시를 했는데 손맛이 상당히 좋았습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.885,
                "end": 36.441
            },
            {
                "speaker_id": "1",
                "transcription": "아휴 기회가 된다면 밤 낚시를 한번 해봐도 될 듯 싶습니다.",
                "sound_type": [
                    2
                ],
                "start": 36.451,
                "end": 42.754
            },
            {
                "speaker_id": "1",
                "transcription": "남은 이제 설 연휴 잘 보내시고요.",
                "sound_type": [
                    2
                ],
                "start": 42.764,
                "end": 45.492
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 낚시는 여기서 마무리하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 45.502,
                "end": 48.119
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 48.129,
                "end": 48.503
            }
        ]
    },
    "summary": "에어 봉돌을 살짝 풀어서 예민하게 했더니 나왔고 올해 들어서 계측 대상의 붕어는 만나지 못했지만 아직 2월도 안 됐으니 여유를 갖고 굉장히 낮은 곳에서 낚시를 했는데 손맛이 상당히 좋았고 기회가 되면 밤 낚시를 해도 좋을 것 같다.",
