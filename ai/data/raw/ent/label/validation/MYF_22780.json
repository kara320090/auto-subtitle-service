                    3
                ],
                "start": 16.745,
                "end": 25.145
            },
            {
                "speaker_id": "1",
                "transcription": "제 생각에 한국보다는 스페인 겨울이 더 따뜻하긴 한데. 그래도 좀 쌀쌀하네요.",
                "sound_type": [
