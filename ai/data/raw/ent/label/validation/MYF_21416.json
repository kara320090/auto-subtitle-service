        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 포인트 선정하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 2.232
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기 좋아 보이는데요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.242,
                "end": 4.009
            },
            {
                "speaker_id": "1",
                "transcription": "바로 앞에 여기 부들 벽도 있고 그런데 주차랑 낚시하기가 힘드네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.019,
                "end": 11.092
            },
            {
                "speaker_id": "1",
                "transcription": "다시 좀 더 이동할게요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.102,
                "end": 13.580
            },
            {
                "speaker_id": "1",
                "transcription": "상류 쪽으로 와봤는데요.",
                "sound_type": [
                    2
                ],
                "start": 13.590,
                "end": 15.688
            },
            {
                "speaker_id": "1",
                "transcription": "아 물세기는 괜찮은데 너무 맹탕인 것 같네요.",
                "sound_type": [
                    2
                ],
                "start": 15.698,
                "end": 18.076
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 이 시기엔 좀 수툴을 끼워야 할 거 같아서 저기 반대편으로 한 번 넘어가 보겠습니다.",
                "sound_type": [
