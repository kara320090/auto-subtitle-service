        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 그 19 19년 11월이였나 그때가?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.269
            },
            {
                "speaker_id": "2",
                "transcription": "2년이나 한 달 여보 다음 달에 11월",
                "sound_type": [
                    2
                ],
                "start": 2.279,
                "end": 6.454
            },
            {
                "speaker_id": "1",
                "transcription": "아아 맞어. 다음 달에 11월이잖아.",
                "sound_type": [
                    2
                ],
                "start": 6.464,
                "end": 8.011
            },
            {
                "speaker_id": "2",
                "transcription": "세상에.",
                "sound_type": [
                    2
                ],
                "start": 8.021,
                "end": 8.691
            },
            {
                "speaker_id": "1",
                "transcription": "아 11월이 한참 그 나중인 것처럼 느끼고 있었어. 아니 근데 지금 10월이야 근데.",
                "sound_type": [
                    2
                ],
                "start": 8.701,
                "end": 13.070
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까 한 달 후가 11월이야.",
                "sound_type": [
                    2
                ],
                "start": 13.080,
                "end": 14.924
            },
            {
                "speaker_id": "1",
                "transcription": "세월이 빠르지.",
                "sound_type": [
                    2
                ],
                "start": 14.934,
                "end": 15.987
            },
            {
                "speaker_id": "1",
                "transcription": "나이 먹으면서 점점 세월이 더 빨라.",
                "sound_type": [
                    2
                ],
                "start": 15.997,
                "end": 18.571
            },
            {
                "speaker_id": "2",
                "transcription": "진짜로.",
                "sound_type": [
                    2
                ],
                "start": 18.581,
                "end": 20.800
            }
        ]
    },
    "summary": "11월이 한참 나중인 것처럼 느끼고 있었는데 지금 10월이고 나이 먹으면서 점점 세월이 더 빠르다.",
