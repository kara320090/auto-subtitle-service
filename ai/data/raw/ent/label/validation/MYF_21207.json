        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 또 갑자기 입질이 다 사라져 버렸네.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 2.118
            },
            {
                "speaker_id": "1",
                "transcription": "허천질도 굉장히 많이 했었는데 큰 놈 나올라고 그러나 그래도 여기 명성이 있는데 응.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 2.128,
                "end": 11.981
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 월척 이상 한마리는 나와야지.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 11.991,
                "end": 14.948
            },
            {
                "speaker_id": "1",
                "transcription": "안 그렇습니까? 편지를쓰 제 저 꼭 와 찌르렁 볼 올리고 마네.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.958,
                "end": 45.247
            },
            {
                "speaker_id": "1",
                "transcription": "추워서 커피 한잔 마시러 차 갔다 갈려고 하는데.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 45.257,
