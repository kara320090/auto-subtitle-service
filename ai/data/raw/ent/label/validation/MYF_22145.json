                ],
                "start": 28.649,
                "end": 36.194
            },
            {
                "speaker_id": "1",
                "transcription": "저번에는 이렇게까지 안 좋았었는데 9치 되겠네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 36.204,
                "end": 48.168
            },
            {
                "speaker_id": "1",
                "transcription": "어 얘도 입질하고 있거든요 지금.",
