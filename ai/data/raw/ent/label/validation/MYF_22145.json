                "start": 0.000,
                "end": 4.583
            },
            {
                "speaker_id": "1",
                "transcription": "물었어. 어우 우와 이야 이것도 이것도 이것도 이야 미치겠다.",
                "sound_type": [
                    1,
                    2,
