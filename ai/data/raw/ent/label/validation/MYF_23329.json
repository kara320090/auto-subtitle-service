        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "데뷔 당시에도 레드벨벳의 멤버들 중 가장 마지막에 사진을 공개했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.655
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그런지 팬들이 자신을 좋아해 줄까 걱정하기도 했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.665,
                "end": 6.975
            },
            {
                "speaker_id": "1",
                "transcription": "조이를 영어로 쓰면 JOY로 우리가 알고 있는 즐거움을 뜻하는 그 영어 단어와 같다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.985,
                "end": 15.304
            },
            {
                "speaker_id": "1",
                "transcription": "데뷔 전 잘 웃지도 않고 애교도 없었던 탓에 연습생이 된 후 인사하며 웃는 것부터 연습했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.314,
                "end": 20.485
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 예명도 즐겁게 지내라라는 의미로 조이라고 지었다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.495,
                "end": 24.224
            },
            {
                "speaker_id": "1",
                "transcription": "열심히 연습한 덕분인지 시키면 잘하고 심지어 팀 내에서 제일 잘 한다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.234,
                "end": 28.520
            },
            {
                "speaker_id": "1",
                "transcription": "물론 지금 레드벨벳의 비공식 애교 담당은 웬디이지만 2019년 2월 5일 데뷔 때 자신의 귀여운 영상을 보고 다시 귀여워지기로 결심했다고 말하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.530,
                "end": 37.527
            },
            {
                "speaker_id": "1",
                "transcription": "이미지 컬러는 초록색이다 많은 사람들이 알고 있다시피 레드벨벳은 데뷔 당시 멤버들의 머리색을 다 다르게 해 머리색으로 멤버들을 구별할 수 있게 했는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.537,
                "end": 45.945
            }
        ]
    },
    "summary": "화자는 조이가 데뷔 당시에 멤버들 중에도 마지막으로 사진을 공개해서 자신을 좋아해 줄지 걱정했다는 이야기와 예명을 조이로 지은 이유 그리고 이미지 컬러를 말해주고 있다.",
