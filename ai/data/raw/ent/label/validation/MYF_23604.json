        "term": [
            {
                "speaker_id": "1",
                "transcription": "특히 이탈리아전에서 기적골을 넣고 난 직후로 더 열광적이었는데 아내를 향해 반지에 키스를 한 후 달리는 모습은 꽤나 인상적이었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.488
            },
            {
                "speaker_id": "1",
                "transcription": "알 사람들은 다 알 만큼 안정환은 굉장히 힘든 어린 시절을 겪었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.498,
                "end": 9.770
            },
            {
                "speaker_id": "1",
                "transcription": "외모는 부잣집 귀공자처럼 생겼지만 그와는 다르게 청소년 대표팀에 뽑혔을 때 처음으로 오렌지를 먹어볼 정도라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.780,
                "end": 15.222
            },
            {
                "speaker_id": "1",
                "transcription": "안정환은 외할머니와 판자촌에서 빈곤하게 살았는데 그 당시 배가 너무 고파 무랑 배추를 서리하거나 굿판을 돌아다니면서 음식을 얻어먹고 옷이 없어서 남의 집 빨래까지 훔쳐서 입었다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.232,
                "end": 24.686
            },
            {
                "speaker_id": "1",
                "transcription": "또한 안정환의 할머니는 안정환이 축구하는 것을 처음에는 반대했는데 그 이유가 가뜩이나 잘 못 먹는 애인데 운동까지 하면 배가 더 빨리 꺼질까 봐였다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.696,
                "end": 31.632
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 안정환은 축구부가 되면 간식으로 지급하는 빵과 우유를 먹을 수 있어서 그때부터 축구를 시작했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.642,
                "end": 36.936
            }
        ]
    },
    "summary": "한 남성이 안정환이 매우 가난하게 자란 어린 시절의 일화들을 설명하고 있다.",
