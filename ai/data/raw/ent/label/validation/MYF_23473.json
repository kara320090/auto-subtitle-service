        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이에 조세호는 팬들과 함께 사진을 찍어주며 인기를 증명했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.011
            },
            {
                "speaker_id": "1",
                "transcription": "이후에도 다른 예능에 출연하며 중국을 갔을 때 조세호를 알아보는 팬이 한 명쯤은 있어 놀랍게 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.021,
                "end": 8.150
            },
            {
                "speaker_id": "1",
                "transcription": "아마 정형돈과 함께 중국인 상이라 인기가 많나 싶다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.160,
                "end": 11.148
            },
            {
                "speaker_id": "1",
                "transcription": "조세호의 찐친은 개그맨 동료 남창희이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.158,
                "end": 13.368
            },
            {
                "speaker_id": "1",
                "transcription": "연예계에서도 유명한 절친 관계이며 2003년부터 친해졌다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.378,
                "end": 16.705
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 친하기만 한 게 아니라 함께 개그 콤비를 짜고 활동하는 경우도 많았으며 동거동락까지 한 사이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.715,
                "end": 21.874
            },
            {
                "speaker_id": "1",
                "transcription": "두 사람은 콤비 명도 있는데 사자자리 동갑이라 레오라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.884,
                "end": 24.945
            },
            {
                "speaker_id": "1",
                "transcription": "또한 두 사람은 2019년 초에 조남 지대라는 이름으로 음반을 발매하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.955,
                "end": 28.714
            },
            {
                "speaker_id": "1",
                "transcription": "곡 명은 거기 지금 어디 야로 줄여서 거지야라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.724,
                "end": 31.523
            },
            {
                "speaker_id": "1",
                "transcription": "조남 지대는 유 퀴즈 온 더 블록과 해피투게더4에서 라이브를 하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.533,
                "end": 35.168
            },
            {
                "speaker_id": "1",
                "transcription": "이후 2020년 5월에도 바보야 왜 그래를 발표했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.178,
                "end": 38.738
            }
        ]
    },
    "summary": "조세호는 중국인 상이라 인기가 많은 것 같으며 조세호의 절친은 개그맨 동료 남창희이고 두 사람은 2019년 초에 조남 지대라는 이름으로 거지야, 바보야 왜 그래라는 음반을 발표했다.",
