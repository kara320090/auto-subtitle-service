        "term": [
            {
                "speaker_id": "1",
                "transcription": "많은 아역 배우들의 롤 모델이 되고 있어 잘 자란 아역 출신 여배우의 대표적인 케이스로 자리 잡고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.695
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 일찍 스타가 되었음에도 불구하고 털털하고 싹싹한 성격으로 동료 배우들과 스태프들의 사랑까지 듬뿍 받고 있는 배우 김유정 씨의 다음 작품도 기대해 보며",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.705,
                "end": 15.131
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 영상 여기서 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.141,
                "end": 17.513
            },
            {
                "speaker_id": "1",
                "transcription": "시청해 주셔서 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.523,
                "end": 19.482
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 별로였으면 싫어요와 구독을 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.492,
                "end": 26.616
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 재미있으셨다면 좋아요와 구독을 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.626,
                "end": 29.662
            }
        ]
    },
    "summary": "배우 김유정은 아역 배우들의 롤 모델의 대표적인 케이스로 동료 배우들과 스태프들의 사랑까지 듬뿍 받고 있다.",
