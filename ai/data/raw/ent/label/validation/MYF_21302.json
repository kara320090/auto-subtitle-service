        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 목표는 제가 9치에서 턱걸이 급 1마리입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 4.572
            },
            {
                "speaker_id": "1",
                "transcription": "그 조금 큰 욕심일 것 같애요 이런 곳에서는.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 4.582,
                "end": 11.799
            },
            {
                "speaker_id": "1",
                "transcription": "저 끝까지는 안 가 봤는데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 11.809,
                "end": 14.437
            },
            {
                "speaker_id": "1",
                "transcription": "연결돼 있겠죠 본류랑.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.447,
                "end": 19.105
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 연결이 안 돼 있다고 하면은 저는 여기서 안 할 건데 되어 있을 거란 믿음이 있습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.115,
                "end": 26.163
            },
            {
                "speaker_id": "1",
                "transcription": "수로라 하기도 조금 애매하고 농로라 하기도 좀 그렇고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 26.173,
                "end": 30.075
            },
            {
                "speaker_id": "1",
                "transcription": "아 도랑이라고 해야 되겠죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 30.085,
                "end": 32.714
            }
        ]
    },
    "summary": "남자는 오늘 목표가 9치에서 턱걸이 급 1마리라며 이런 곳에서는 조금 큰 욕심일 것 같지만 본류랑 연결이 돼 있을 거란 믿음이 있다고 하며 수로나 농로라 하기는 그렇고 도랑이라고 해야 되겠다고 한다.",
