        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇게 자세하게는 제가 잘 모르겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.808
            },
            {
                "speaker_id": "1",
                "transcription": "바로 이쪽이 넓은 평야입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.818,
                "end": 4.885
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 이제 중세 시대 놀이도 하고 공놀이도 많이 하고 했었죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.895,
                "end": 10.919
            },
            {
                "speaker_id": "2",
                "transcription": "그 중세 시대 놀이를 하는 그 동아리 회원분들은 여기에 늘 있는 거예요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.929,
                "end": 16.194
            },
            {
                "speaker_id": "1",
                "transcription": "늘 있는 건 아니 금요일마다 있는 거 같애요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.204,
                "end": 18.127
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 제가 정말 깜짝 놀랐던 게 이번에 인제 인터뷰도 하고 UCI 캠퍼스 영상을 찍을려고 자료조사를 좀 했는데",
                "sound_type": [
