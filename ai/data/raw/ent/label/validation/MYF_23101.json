    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "방금 말씀드렸듯이 요즘 차량 출고 기간이 엄청 오래 걸리죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.902
            },
            {
                "speaker_id": "1",
                "transcription": "근데 개인 계좌로 입금해 주셔야 차를 빨리 받을 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.912,
                "end": 5.510
            },
            {
                "speaker_id": "1",
                "transcription": "긴급 코드니 뭐니 이런저런 알지도 못하는 얘기 혼자 하면서 여러분들을 유혹할 텐데 이것도 다 거짓말입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.520,
                "end": 12.192
            },
            {
                "speaker_id": "1",
                "transcription": "또 이런 경우가 있을 수도 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.202,
                "end": 13.758
            },
            {
                "speaker_id": "1",
                "transcription": "다른 대리점이나 영업소에 전시 차량이 있는데 고객님이 원하는 모델, 색상, 옵션이 거의 다 들어가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.768,
                "end": 19.435
            },
            {
                "speaker_id": "1",
                "transcription": "그 차를 잡아 오려면 저한테 우선 입금을 해주셔야 그쪽에 이야기하고 차를 가져올 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.445,
                "end": 24.211
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 식으로 감언이설을 하는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.221,
                "end": 25.982
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 현업에 계신 분이라면 상식선에서 말이 안 되는 이야기인데 소비자는 돌아가는 상황을 잘 모르니까 그런가보다 하는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.992,
                "end": 33.645
            },
            {
                "speaker_id": "1",
                "transcription": "차량 출고 후에 소비자가 영업사원이 해주는 선팅이나 블랙박스 등을 높은 등급으로 업그레이드하는 경우에 영업사원이 추가금을 달라고 하는 경우도 있지만 이 경우를 제외하고는 신차를 구매할 때 어떤 구매 방식을 이용하시더라도 영업 사원 개인 계좌로 돈이 들어가는 일은 없어요 계약금을 포함해서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.655,
                "end": 50.426
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 어디로 넣냐 일시불의 경우 어떤 금융 프로그램이나 신용카드 캐시백을 이용하지 않는다면 고객 명의의 제조사 가상계좌로 들어가고 신용카드 캐시백을 이용하시는 경우 신용카드사에서 제조사에 차량 대금을 지급하고 구매자가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.436,
                "end": 64.833
            }
        ]
    },
    "summary": "남성은 범죄자들의 사기 수법을 예를 들어가면서 설명해 주고 있다.",
