        "term": [
            {
                "speaker_id": "1",
                "transcription": "매드클라운은 이를 올리며 이걸 왜 나에게라는 해시태그를 달았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.207
            },
            {
                "speaker_id": "1",
                "transcription": "아마도 업체에서 메드클라운이 마미손이라고 착각한 듯하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.217,
                "end": 6.420
            },
            {
                "speaker_id": "1",
                "transcription": "매드클라운은 이 고무장갑들을 모두 기부했다고 한다. 마미손은 2018년 11월 2일 소년점프 이후로 간만에 신곡을 발표했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.430,
                "end": 13.171
            },
            {
                "speaker_id": "1",
                "transcription": "노래 제목은 복면 안에 누구이며 SK텔레콤과의 콜라보이자 마미손의 첫 광고이기도 하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.181,
                "end": 18.381
            },
            {
                "speaker_id": "1",
                "transcription": "작곡은 소년점프를 작곡한 예요이며 노래 분위기는 랩보다는 마미손이 추구하는 댄스음악에 가깝다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.391,
