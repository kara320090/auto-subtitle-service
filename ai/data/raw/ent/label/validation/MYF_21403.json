        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 지렁이를 정말 큰 거 끼워놨거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.705
            },
            {
                "speaker_id": "1",
                "transcription": "그랬더니 한 번에 못 먹는거 같아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 3.715,
                "end": 6.053
            },
            {
                "speaker_id": "1",
                "transcription": "4대 다 지렁이 썼으면 아주 난리 났을 거 같아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 6.063,
                "end": 9.769
            },
            {
                "speaker_id": "1",
                "transcription": "아유 생각만 해도 진짜 끔찍하네요 끔찍해.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.779,
                "end": 30.009
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 지렁이가 워낙 크니까 조금씩 갉아먹었네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 30.019,
                "end": 39.566
            },
            {
                "speaker_id": "1",
                "transcription": "이제 바람이 거의 잦고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 39.576,
                "end": 41.916
            },
            {
                "speaker_id": "1",
                "transcription": "캠이 끌 시간인데 이제 지렁이 빼고 입질 업더라도 그냥 옥수수만 사용하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 41.926,
                "end": 48.381
            }
        ]
    },
    "summary": "다 지렁이를 썼으면 난리가 났을 거 같으며 이제 지렁이를 빼고 입질이 없더라도 옥수수만 사용하겠다.",
