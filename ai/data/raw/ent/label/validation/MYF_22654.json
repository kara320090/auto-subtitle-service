        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 훨씬 작으니까 세밀한 컨트롤이 가능하다고 그래야 되나 그런 느낌이 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.269
            },
            {
                "speaker_id": "1",
                "transcription": "이 갈고리 모양 덕분에 훨씬 안정감 있게 잡아주는 느낌이 확실히 있어요.",
                "sound_type": [
                    2
                ],
                "start": 4.279,
                "end": 8.470
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 원래 가지고 있던 큰 거는 그걸로 한 거고 얘는 이번에 받은 오라이트 걸로 했는데 오라이트가 확실히 더 정교하게 작업이 가능했고",
                "sound_type": [
                    2
                ],
                "start": 8.480,
                "end": 16.973
            },
            {
                "speaker_id": "1",
                "transcription": "50번씩 돌로 때리기 해볼게요.",
                "sound_type": [
                    2
                ],
                "start": 16.983,
                "end": 18.877
            },
            {
                "speaker_id": "1",
                "transcription": "일단 돌 종류는 뭔지 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.887,
                "end": 21.040
            },
            {
                "speaker_id": "1",
                "transcription": "주먹도끼처럼 생긴 거 얘를 50번씩 때려볼게요.",
                "sound_type": [
                    2
                ],
