        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고 원래 그 꿈을 적는 데는 기한이 있어야 된대요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.757
            },
            {
                "speaker_id": "1",
                "transcription": "서른다섯 살까지로 정했거든요.",
                "sound_type": [
                    2
                ],
                "start": 2.767,
                "end": 4.831
            },
            {
                "speaker_id": "1",
                "transcription": "지금 제가 스물아홉 살인데 일단 이번 해는 빼고 대략 5년으로 잡으면 한 달에 육백만 원씩 모아야 되더라고요.",
                "sound_type": [
                    2
                ],
                "start": 4.841,
                "end": 12.253
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 적금만으로 모을 생각이 전혀 없기 때문에 시드가 조금 생기면 투자를 해서 투자 당연히 공부를 해야겠죠.",
                "sound_type": [
                    2
                ],
                "start": 12.263,
                "end": 19.487
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 불려 나갈 생각이고 그래도 대략적으로 내가 월에 육백은 모아야 된다라는 걸 머릿속에 집어넣었어요.",
                "sound_type": [
                    2
                ],
                "start": 19.497,
                "end": 26.373
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이건 사실 저에 대한 뭐 생활비가 하나도 포함되지 않은 돈이잖아요.",
                "sound_type": [
                    2
                ],
                "start": 26.383,
                "end": 30.802
            },
            {
                "speaker_id": "1",
                "transcription": "아 그냥 대략 월 천으로 잡자 근데 사실 이 생각을 처음 한 게 아니라 제가 한창 막.",
                "sound_type": [
                    2
                ],
                "start": 30.812,
                "end": 36.733
            }
        ]
    },
    "summary": "한 여자가 목표를 이루려면 월 천은 있어야 한다고 한다.",
