        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러면서 경기장에서 자신에게 외모로 대놓고 지적질했던 팬들을 떠올리며 솔직히 세상에 그렇게 잘생기고 예쁜 사람들 많지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.229
            },
            {
                "speaker_id": "1",
                "transcription": "아니 차라리 장동건, 원빈 같은 사람이 나한테 와서 너 진짜 못생겼다고 하면 깨끗하게 인정하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.239,
                "end": 12.853
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 저한테 얼굴 가지고 뭐라고 하신 분들 대부분 그렇지 않았거든요라며 서러워했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.863,
                "end": 18.225
            },
            {
                "speaker_id": "1",
                "transcription": "서장훈은 드림 브레이커 염세주의자 비관주의자로 유명하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.235,
                "end": 21.657
            },
            {
                "speaker_id": "1",
                "transcription": "이러한 면모는 특히 예능 프로그램 아는 형님에서 빛을 발한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.667,
                "end": 25.392
            }
        ]
    },
    "summary": "한 남성이 서장훈이 과거 팬들에게 외모로 지적받은 것을 서러워했다고 설명하고 있다.",
