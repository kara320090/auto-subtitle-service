        "term": [
            {
                "speaker_id": "1",
                "transcription": "가져가든가 올리든가 조금만 더 힘내 봐 아이고 함익 환입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 18.874
            },
            {
                "speaker_id": "1",
                "transcription": "입질하고 있죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 18.884,
                "end": 20.451
            },
            {
                "speaker_id": "1",
                "transcription": "지금 낚싯대는 이공이팔 삼공 삼이 삼이 다섯 대를 편성을 했습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.461,
                "end": 26.945
            },
            {
                "speaker_id": "1",
                "transcription": "수심은 아까 말씀 드렸듯이 삼십정도 나오고 있고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 26.955,
                "end": 30.681
            },
            {
                "speaker_id": "1",
                "transcription": "바닥은 허벌나게 지저분 합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 30.691,
                "end": 34.240
            },
            {
                "speaker_id": "1",
                "transcription": "장난아닙니다 지금.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 34.250,
                "end": 40.146
            },
            {
                "speaker_id": "1",
                "transcription": "아마 제대로 흡입을 못할 것 같아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 40.156,
                "end": 43.054
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 바닥에 지저분하다 보니까.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 43.064,
                "end": 53.396
            },
            {
                "speaker_id": "1",
                "transcription": "이럴 때는 최대한 작은 걸 써야 되는데 이따가는 좀 옥수수를 작은 걸로 골라서 쓰겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 53.406,
                "end": 60.529
            }
        ]
    },
    "summary": "발화자는 낚시대와 수심에 대해 설명하고 있다.",
