            },
            {
                "speaker_id": "1",
                "transcription": "옥수수 글루텐 1대 1로 배합을 했고요.",
                "sound_type": [
                    2
                ],
                "start": 3.764,
                "end": 6.438
            },
            {
                "speaker_id": "1",
                "transcription": "어 물병 물대신 물병 넣었습니다.",
                "sound_type": [
                    2
                ],
