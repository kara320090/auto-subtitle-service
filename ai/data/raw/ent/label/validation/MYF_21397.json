                    2
                ],
                "start": 27.523,
                "end": 28.867
            },
            {
                "speaker_id": "1",
                "transcription": "나주의 소류지에 나와 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 28.877,
                "end": 30.801
            },
            {
                "speaker_id": "1",
                "transcription": "아 지금 바람이 굉장히 많이 불고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 30.811,
                "end": 33.646
            },
            {
                "speaker_id": "1",
                "transcription": "그나마 이 자리는 뒷바람이 불고 있습니다.",
