        "term": [
            {
                "speaker_id": "1",
                "transcription": "아이쿠야 간다 간다 간다 간다 간다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.169
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지 오 그렇지 아 바람 한번 아주 그냥 개안하게 부네요.",
                "sound_type": [
                    2
                ],
                "start": 7.179,
                "end": 22.858
            },
            {
                "speaker_id": "1",
                "transcription": "바람이 살짝 잦은 틈을 타 얼른 인사 드리자 안녕하십니까?",
                "sound_type": [
                    2
                ],
