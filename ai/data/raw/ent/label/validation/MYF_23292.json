                    3
                ],
                "start": 6.478,
                "end": 11.277
            },
            {
                "speaker_id": "1",
                "transcription": "본인은 이러한 가족 내력 때문에 공부를 계속할 수 밖에 없었다고 한다.",
                "sound_type": [
