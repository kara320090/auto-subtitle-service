        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리가 하는 이런 모든 것들도 다 경험이고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.063
            },
            {
                "speaker_id": "1",
                "transcription": "다 도움이 되는 것들이잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.073,
                "end": 6.045
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 언제든지 직장을 갈 수 있어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.055,
                "end": 9.462
            },
            {
                "speaker_id": "1",
                "transcription": "직장도 갈 수 있고 돈은 벌 수 있어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.472,
                "end": 12.313
            },
            {
                "speaker_id": "1",
                "transcription": "그런 건 다 배제해 놓고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.323,
                "end": 14.366
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 해보고 싶은 거야 하는 거 나는 이게 진짜 중요하다고 생각을 해",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.376,
                "end": 18.298
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 진짜 나중에 나이 들어서 20살 때 그거 한 번 해볼걸",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.308,
                "end": 23.596
            },
            {
                "speaker_id": "1",
                "transcription": "이런 후회를 하게 될 수도 있잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.606,
                "end": 25.755
            },
            {
                "speaker_id": "1",
                "transcription": "우리는 해보고 싶은 건 다 해봐야 돼",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.765,
                "end": 28.320
            },
            {
                "speaker_id": "1",
                "transcription": "물론 그에 따른 책임은 나한테 돌아오는 거지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.330,
                "end": 32.725
            },
            {
                "speaker_id": "1",
                "transcription": "내가 그만큼 또 열심히 하고 한다면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.735,
                "end": 35.442
            },
            {
                "speaker_id": "1",
                "transcription": "그 만큼의 보상이나 결과가 할 수 있으니까 우리 같이 하고 싶은 건 다 해보자?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.452,
                "end": 41.193
            },
            {
                "speaker_id": "1",
                "transcription": "그런 의미로 건배 할까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.203,
                "end": 45.166
            }
        ]
    },
    "summary": "여성이 실내 공간에서 유튜브를 통해 시청자와 소통하고 있다.",
