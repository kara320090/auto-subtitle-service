        "term": [
            {
                "speaker_id": "1",
                "transcription": "앞의 이유로 김구라는 2015년 아내와 합의 이혼을 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.684
            },
            {
                "speaker_id": "1",
                "transcription": "17억의 채무는 김구라가 갚고 아들인 김동현의 양육권도 김구라가 갖고 성인이 될 때까지 김구라와 함께 사는 것으로 결론이 났다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.694,
                "end": 9.336
            },
            {
                "speaker_id": "1",
                "transcription": "김구라는 후에 한 방송에서 왜 그렇게 불리한 협의 이혼을 했냐는 질문을 받자 나는 전 아내의 채무에 법적으로 걸린 게 하나도 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.346,
                "end": 15.603
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 소송을 당하면 법적으로 전 아내가 구속이 될 수도 있기 때문에 그걸 막기 위해 내가 빚을 다 갚겠다고 한 것이라고 답했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.613,
                "end": 21.901
            },
            {
                "speaker_id": "1",
                "transcription": "이러한 답변으로 김구라는 이혼 및 이혼 과정에서 이미지가 좋아진 몇 안 되는 케이스가 되었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.911,
                "end": 26.393
            }
        ]
    },
    "summary": "김구라는 2015년 아내와 합의 이혼을 했지만 아내가 구속이 되는 걸 막기 위해 17억의 채무는 김구라가 갚고 아들 양육권도 김구라가 갖는 불리한 협의 이혼을 했다.",
