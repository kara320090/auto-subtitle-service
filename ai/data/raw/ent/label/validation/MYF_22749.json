        "term": [
            {
                "speaker_id": "1",
                "transcription": "지분 몇 프 몇 퍼센트라고 생각했어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.160
            },
            {
                "speaker_id": "2",
                "transcription": "거의 90 90 90퍼센트 아닌가? 맞지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.170,
                "end": 5.870
            },
            {
                "speaker_id": "3",
                "transcription": "90 되죠 형님. 솔직히 좋았으니까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.880,
                "end": 7.357
            },
            {
                "speaker_id": "2",
                "transcription": "제가 돌려봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.367,
                "end": 8.353
            },
            {
                "speaker_id": "3",
                "transcription": "하하하.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.363,
                "end": 8.981
            },
            {
                "speaker_id": "2",
                "transcription": "아이 그 자기 거 공부하려고 돌려봤는데 잘 찼더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.991,
                "end": 13.629
            },
            {
                "speaker_id": "3",
                "transcription": "아 마찬가지로 저희 그 감독님하고 코치님이 그 경기 전에 뭐 어떤 멘탈적인 부분이라던지 아니면 그 부분 전술 같은 거를 그 디테일하게 많이 준비해 줘서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.639,
                "end": 25.017
            },
            {
                "speaker_id": "3",
                "transcription": "어 그거를 경기장에서 저희가 다 보여줄 수 있었다는 게 굉장히 만족스럽고 다음 경기가 어떻게 될지 모르겠지만 어 지난 경기처럼 좀 좋은 분위기 계속 이어갔으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.027,
                "end": 35.016
            },
            {
                "speaker_id": "4",
                "transcription": "어 짜릿하더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.026,
                "end": 36.424
            },
            {
                "speaker_id": "4",
                "transcription": "마지막에 끝나는 휘슬 불렸을 때도 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.434,
                "end": 39.640
            }
        ]
    },
    "summary": "한 선수는 지분이 몇 퍼센트였냐는 질문에 90퍼센트 정도 된다고 하며 경기 후 공부를 위해 돌려봤는데 잘 찼다고 답했고 다른 선수는 감독과 코치가 멘탈적인 부분이나 부분 전술을 디테일하게 준비해 줘서 경기장에서 그 부분을 다 보여줄 수 있어서 만족스러워 했고 다음 경기에서도 좋은 분위기 이어갔으면 좋겠다고 답했으며 또 다른 선수는 짜릿하다고 소감을 밝혔다.",
