        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 내 자리도 슬슬 지부가 됐을 텐데",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.949
            },
            {
                "speaker_id": "1",
                "transcription": "오 꽤 큰 것 같다.",
                "sound_type": [
                    2
                ],
                "start": 2.959,
                "end": 5.130
            },
            {
                "speaker_id": "1",
                "transcription": "밤이라 보이질 않는데 아니 한번 봐볼까요.",
                "sound_type": [
                    2
                ],
                "start": 5.140,
                "end": 13.556
            },
            {
                "speaker_id": "1",
                "transcription": "열심히 멘트를 하고 있는데요. 들어 올려 빨리",
                "sound_type": [
                    2
                ],
                "start": 13.566,
                "end": 17.074
            },
            {
                "speaker_id": "1",
                "transcription": "어 월척 되어 보이네요.",
                "sound_type": [
                    2
                ],
                "start": 17.084,
                "end": 21.490
            },
            {
                "speaker_id": "1",
                "transcription": "부럽다. 부러워",
                "sound_type": [
                    2
                ],
                "start": 21.500,
                "end": 28.311
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 사실은요. 저도 10분 전에 왼쪽에서 두 번째 사사칸 목줄이 한번 나왔어요. 제가",
