        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이영자의 가족사도 제법 복잡하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.086
            },
            {
                "speaker_id": "1",
                "transcription": "이영자는 예능프로 언니한텐 말해도 돼에서 아버지의 외도에 대해 고백한 적이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.096,
                "end": 6.629
            },
            {
                "speaker_id": "1",
                "transcription": "이영자가 직접 밝힌 이야기에 따르면 이영자의 아버지는 배우 박근형과 닮은 외모로 매우 잘생겼었다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.639,
                "end": 12.366
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이영자가 보기에 아버지는 평생 바람을 피운 것 같고 아버지를 믿는 엄마가 싫었으며 바람을 피는 아버지에게 미련을 떠는 엄마가 싫었다고 고백하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.376,
                "end": 21.401
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 산소에까지도 이름 모를 여자가 찾아올 정도였다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.411,
                "end": 24.646
            },
            {
                "speaker_id": "1",
                "transcription": "어머니께서는 생선가게를 하셨었는데 엄마가 택시에 타시면 비린내가 난다고 승차 거부를 당하혼 하셨다는 말을 하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.656,
                "end": 31.308
            },
            {
                "speaker_id": "1",
                "transcription": "방송 데뷔 이전부터 밤무대에서 활약하던 사람이다 보니 비방용 토크에 강하며 뚱녀 캐릭터에 드센 아줌마 개그에 특화되어있는 코미디언이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.318,
                "end": 39.016
            },
            {
                "speaker_id": "1",
                "transcription": "강호동과 개그 스타일이 비슷한데 강한 카리스마로 좌중을 압도하며 상대가 약하면 무시하거나 윽박지르는 듯한 컨셉이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.026,
                "end": 45.821
            },
            {
                "speaker_id": "1",
                "transcription": "사실 이런 진행방식은 호불호가 많이 갈린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.831,
                "end": 48.342
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 분명한 것은 이영자가 mbc 오늘은 좋은 날, sbs 기쁜 우리 토요일, kbs 슈퍼 선데이 등에 출연해 여러 유행어들을 히트시키며 1990년대 대표적인 여성 개그맨으로 인기를 누렸다는 것이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.352,
                "end": 60.523
            },
            {
                "speaker_id": "1",
                "transcription": "1990년대의 척박했던 방송계에서 여성 코미디언으로 1993년 백상예술상당 코미디언 상과",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.533,
                "end": 67.233
            }
        ]
    },
    "summary": "화자는 이영자가 방송에 나와 본인 아버지가 평생 바람을 피운 것 같다는 이야기와 이영자라는 사람의 캐릭터와 강한 개그 분야 그리고 1990년대 대표적인 여성 개그맨으로 인기를 누렸다는 점을 말해주고 있다.",
