            },
            {
                "speaker_id": "1",
                "transcription": "바로 승우 아빠와 친구들이 모여서 운영했던 채널인데 아저씨들이 모여서 철없이 노는 테마의 영상들을 올렸었다.",
                "sound_type": [
                    2,
