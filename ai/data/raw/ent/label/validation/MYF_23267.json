        "term": [
            {
                "speaker_id": "1",
                "transcription": "1980년대에 접어들면서 개그계에 새 인물이 필요하다고 생각한 전유성이 밤무대와 거리 소극장을 뒤져서 찾아낸 사람이 바로 이영자였다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.139
            },
            {
                "speaker_id": "1",
                "transcription": "당시에 이영자에게 지상파로 나올 것을 제안했는데 이영자는 한참을 생각하더니 정확히 3일 뒤에 나타나서 요청을 수락했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.149,
                "end": 16.721
            },
            {
                "speaker_id": "1",
                "transcription": "더 재미있는 것은 3일간 시간을 달라고 한 이유에 대해 물으니 무대 행사비로 미리 받아놓은 돈을 돌려주고 오느라 늦었다고 했다는 것이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.731,
                "end": 23.800
            },
            {
                "speaker_id": "1",
                "transcription": "당시 밤무대에서 이영자가 벌던 돈의 규모를 짐작할 수 있는 일화이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.810,
                "end": 28.042
            },
            {
                "speaker_id": "1",
                "transcription": "이영자는 개그계 진출 이후에도 바로 밤무대 활동을 중단하지 않고 여전히 레전드급 활약을 했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.052,
                "end": 35.368
            }
        ]
    },
    "summary": "화자가 이영자가 지상파로 나오게 됐던 계기와 밤무대에서 이영자의 입지가 어느 정도 됐는지 알 수 있는 이야기를 하고 있다.",
