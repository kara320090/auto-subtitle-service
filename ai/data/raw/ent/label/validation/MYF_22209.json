        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거는 뭐라고 해야 되지 좀 너무 교과서적인 말인데 세상을 보는 눈이 시야가 넓어진다고 하잖아. 시야",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.818
            },
            {
                "speaker_id": "1",
                "transcription": "한국에서 살면서 아 나는 너무 협소한 시각을 가졌어라든지 우물 안 개구리야라는 생각을 별로 못했거든요.",
                "sound_type": [
                    2
                ],
                "start": 7.828,
                "end": 16.533
            },
            {
                "speaker_id": "1",
                "transcription": "근데 정말 다양한 나라가 있고 정말 다양한 생활 방식, 가치관이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 16.543,
                "end": 23.121
            },
            {
                "speaker_id": "1",
                "transcription": "그것들을 드라마나 영화 가 아니라 실제적으로 느끼게 되면서 그것도 또 존중하게 되고 그거에 대해서 알게 되는 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.131,
                "end": 31.164
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들면 여기는 모스크도 있고 성당도 있고 그런 다양한 종교가 있는 나라예요. 시간이 되면은 성당에서 종을 칠 때도 있고 아니면은 모스크에서 노래를 부를 때가 있어요.",
                "sound_type": [
                    2
                ],
                "start": 31.174,
                "end": 43.667
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지 두 가지지.",
                "sound_type": [
                    2
                ],
                "start": 43.677,
                "end": 45.064
            },
            {
                "speaker_id": "1",
                "transcription": "처음에는 아니 갑자기 무슨 종을 치냐 무슨 누가 노래를 부르는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 45.074,
                "end": 51.400
            },
            {
                "speaker_id": "1",
                "transcription": "그런 게 어색하기도 하고 그 다음에 식자재를 사러 가면 할랄 마크나 비건 마크가 꼭 다 거의 다 돼 있어요.",
                "sound_type": [
                    2
                ],
                "start": 51.410,
                "end": 60.129
            },
            {
                "speaker_id": "1",
                "transcription": "할랄 인증을 받은 것만 먹을 수 있는 사람들을 위해서 그런 것만 많은 건데 우리나라에는 그런 게 거의 없잖아요.",
                "sound_type": [
                    2
                ],
                "start": 60.139,
                "end": 66.952
            },
            {
                "speaker_id": "1",
                "transcription": "이태원에 있으려나 그러다 보니까 아 이런 걸 알게 되는 거야.",
                "sound_type": [
                    2
                ],
                "start": 66.962,
                "end": 71.815
            },
            {
                "speaker_id": "1",
                "transcription": "되게 몰랐던 세상이라고 해야 되나 몰랐던 세상을 그 안에서 같이 살면서 같이 어떻게 이렇게 꾸려 나가게 되는 거",
                "sound_type": [
                    2
                ],
                "start": 71.825,
                "end": 78.902
            },
            {
                "speaker_id": "1",
                "transcription": "내가 한국에서 알던 세계보다 그 세계가 더 넓어지는 게 되게 내가 내가 세계로 발돋움 그 말이 이상한가",
                "sound_type": [
                    2
                ],
                "start": 78.912,
                "end": 89.023
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 커지는 느낌 제가 좀 아 내가 좀 좀 더 대장부가 된 느낌 그런 느낌이 좀 있다는 게 되게 좋은 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 89.033,
                "end": 98.431
            }
        ]
    },
    "summary": "화자는 외국에 거주하면서 다양한 나라, 종교를 접하고 시야가 넓어졌다고 말한다.",
