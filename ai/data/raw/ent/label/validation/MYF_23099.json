        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "평균 피해 금액은 5436만 원 정도고 가장 많이 피해를 당하신 분이 1억 3350만 원입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.490
            },
            {
                "speaker_id": "1",
                "transcription": "GV60과 아이오닉6를 동시에 계약을 하셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.500,
                "end": 9.822
            },
            {
                "speaker_id": "1",
                "transcription": "저와 통화하신 피해자분은 8745만 원을 당하셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.832,
                "end": 13.674
            },
            {
                "speaker_id": "1",
                "transcription": "잊을 만하면 이런 사건들이 일어나는 것 같은데 과거 2, 3년 전에 충북의 한 지점에서 똑같은 수법으로 사기 사건이 발생했었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.684,
                "end": 21.243
            },
            {
                "speaker_id": "1",
                "transcription": "얼마 전 일어난 사건도 그 전 사건의 모방범죄라고 할 만큼 그 수법이 동일하다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.253,
                "end": 26.385
            },
            {
                "speaker_id": "1",
                "transcription": "이런 수법에 당하지 않기 위해서 여러분들이 아셔야 할 것들을 간략하게 말씀드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.395,
                "end": 30.351
            },
            {
                "speaker_id": "1",
                "transcription": "1번째 어떤 이유든지 영업사원이 개인 계좌로 돈을 달라고 하는 경우는 전부 사기입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.361,
                "end": 35.184
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들어 우리가 국산 차를 살 때 비공식적으로 페이백을 해주잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.194,
                "end": 39.190
            },
            {
                "speaker_id": "1",
                "transcription": "선팅이나 블랙박스 같은 거 해주는 경우도 있고 뭐 다양한데 여기서 적나라하게 이야기할 순 없지만 높은 페이백을 가지고 다시 말해서 차량을 구매하고 돈을 일부분 돌려준다라는 걸 가지고 소비자를 유혹하는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.200,
                "end": 51.205
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들어서 저한테 직접 입금하시면 제가 원래는 3프론데 3.5퍼센트까지 드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.215,
                "end": 55.981
            },
            {
                "speaker_id": "1",
                "transcription": "0.5퍼센트 차이라도 금액으로 하면 꽤 큰 금액이라 속아 넘어가시는 분들이 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.991,
                "end": 60.708
            }
        ]
    },
    "summary": "남성은 사기 금액의 액수를 말한 후 영업사원이 개인 계좌로 송금을 요구하는 경우는 전부 사기라고 말하고 그 유형을 설명한다.",
