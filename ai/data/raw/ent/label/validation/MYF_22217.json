        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고 외롭다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.082
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 저희는 솔직히 별로 안 외롭지 별로?",
                "sound_type": [
                    2
                ],
                "start": 1.092,
                "end": 4.849
            },
            {
                "speaker_id": "1",
                "transcription": "둘이가 워낙 원래도 친구도 별로 없고 원래도 둘이서 막 짝짝꿍 놀던 사이라서 별로 안 심심해요.",
                "sound_type": [
                    2
                ],
                "start": 4.859,
                "end": 11.469
            },
            {
                "speaker_id": "1",
                "transcription": "제가 말이 워낙 많다 보니까 한 5명 커버 치거든요.",
                "sound_type": [
                    2
                ],
                "start": 11.479,
                "end": 16.010
            },
            {
                "speaker_id": "1",
                "transcription": "이게 가족들이나 친구들을 못 보잖아요.",
                "sound_type": [
                    2
                ],
                "start": 16.020,
                "end": 20.050
            },
            {
                "speaker_id": "1",
                "transcription": "원래도 엄마를 1년에 1번 봤다 쳐도 언제든지 갈 수 있는 언제든지 볼 수 있는 거랑 또 다르고 나를 다 잘 알고 이런 친구가 여기는 없잖아요.",
                "sound_type": [
                    2
                ],
                "start": 20.060,
                "end": 31.581
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 친구를 만나도 여기서 만난 친구기 때문에 여기에서 우리가 느꼈던 걸 얘기하고 우리의 현재, 우리 미래만 얘기하지 우리 그때 그랬잖아 이러면서 그런 걸 못하는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 31.591,
                "end": 44.456
            },
            {
                "speaker_id": "1",
                "transcription": "그런 좀 허전함이라고 해야 되나 원래도 친구가 되게 많으시고 친구들끼리 어디 놀러가고 친구랑 카톡 하루 종일 하시는 분들 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 44.466,
                "end": 54.835
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들은 진짜 외롭게 느껴지실 거 어쩔 수 없이 멀어진다고 해야 되나 그러한 좀 씁쓸함 외로움이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 54.845,
                "end": 63.945
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 한국 음식 못 먹는 거",
                "sound_type": [
                    2,
                    5
                ],
                "start": 63.955,
                "end": 66.550
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 거 저 진짜 부러운 게 미국에 사시는 분이 캐나다나 막 독일 이런 데서 사시는 분들 보면은 어 순대를 드시더라고요.",
                "sound_type": [
                    2
                ],
                "start": 66.560,
                "end": 76.609
            }
        ]
    },
    "summary": "화자는 가족들이나 친구들을 못 보는 것과 한국 음식을 못 먹는 것이 힘들다고 말한다.",
