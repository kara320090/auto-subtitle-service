                "sound_type": [
                    2
                ],
                "start": 7.417,
                "end": 11.266
            },
            {
                "speaker_id": "1",
                "transcription": "아 돌붕어 사자 처음 잡아 봅니다. 그리고 저도 처음 구경해요.",
