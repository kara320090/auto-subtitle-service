        "term": [
            {
                "speaker_id": "1",
                "transcription": "먼 바람이 이렇게 분디야",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 1.727
            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 그나저나 오름수위 싫어 하는 꾼은 없겠죠.",
                "sound_type": [
                    1,
                    2
                ],
