                "end": 7.456
            },
            {
                "speaker_id": "1",
                "transcription": "뗏장 앞에 아주 기기가 막히게 지금 붙여 놨는데",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.466,
                "end": 13.068
            },
            {
                "speaker_id": "1",
                "transcription": "저게 꼼짝도 안 하네",
