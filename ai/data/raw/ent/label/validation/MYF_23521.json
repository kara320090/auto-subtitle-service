        "term": [
            {
                "speaker_id": "1",
                "transcription": "2020년 MBC 방송 연예 대상에서 백종원의 PD 상 수상을 양세형이 대리 수상했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.601
            },
            {
                "speaker_id": "1",
                "transcription": "양세형이 대리 수상을 하면서 재치 있는 수상 소감이 굉장히 화제가 되었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.611,
                "end": 8.340
            },
            {
                "speaker_id": "1",
                "transcription": "이날 양세형은 백종원이 대충 어떤 느낌으로 말할지 알 것 같아서 살짝 적어왔다며 적어온 종이를 펼쳤다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.350,
                "end": 13.905
            },
            {
                "speaker_id": "1",
                "transcription": "이어서 이렇게 큰 상을 받게 되어 너무 영광이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.915,
                "end": 16.715
            },
            {
                "speaker_id": "1",
                "transcription": "이 상은 사랑하는 아내에게 바치겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.725,
                "end": 18.761
            },
            {
                "speaker_id": "1",
                "transcription": "끝으로 백 파더에게 없어선 안 될 세형아 너가 있어서 내가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.771,
                "end": 22.176
            },
            {
                "speaker_id": "1",
                "transcription": "이 고마움은 훗날 너가 결혼할 때 아파트 한 채로 갚을게라고 말해 큰 웃음을 주었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.186,
                "end": 26.760
            }
        ]
    },
    "summary": "20대 남성이 양세형의 재치 있는 대리 수상 소감에 대해 말한다.",
