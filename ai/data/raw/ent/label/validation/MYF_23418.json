        "term": [
            {
                "speaker_id": "1",
                "transcription": "또한 현관문에도 문 열면 딱 보이게끔 결혼 사진을 걸어놨다며 슬픈 해명을 하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.440
            },
            {
                "speaker_id": "1",
                "transcription": "길고 긴 무명 시절 친척들의 무시와 잔소리가 무서워 집에도 내려가지 않았다던 개그우먼 홍현희는 결혼 후 더 활발한 활동을 하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.450,
                "end": 13.741
            },
            {
                "speaker_id": "1",
                "transcription": "스케줄도 많이 늘어나면서 전담 매니저도 생기고 대중들에게 좋은 이미지를 보여주며 제2의 전성기를 맞이하고 있는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.751,
                "end": 20.454
            },
            {
                "speaker_id": "1",
                "transcription": "홍현희를 끔찍이 사랑하는 연하 남편 제이쓴과의 행복한 가정을 꾸린 것과 동시에 개그우먼으로서의 커리어 또한 차곡차곡 쌓아가고 있는 홍현희 그녀의 멋진 도전을 응원하며 오늘 영상 여기서 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.464,
                "end": 33.581
            },
            {
                "speaker_id": "1",
                "transcription": "시청해 주셔서 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.591,
                "end": 37.175
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 별로였으면 싫어요와 구독을 눌러 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.185,
                "end": 40.363
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 재밌으셨다면 좋아요와 구독을 눌러 주세요.",
