        "term": [
            {
                "speaker_id": "1",
                "transcription": "어떻게 보면 모험이기는 한데 열심히 해보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.515
            },
            {
                "speaker_id": "1",
                "transcription": "한번 지렁이 3대 수상한 옥수수 2대 지금 사용 중이고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.525,
                "end": 10.415
            },
            {
                "speaker_id": "1",
                "transcription": "역시 여기에 묻혀서 사용하고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.425,
                "end": 23.999
            },
            {
                "speaker_id": "1",
                "transcription": "누가 건들기는 한다.",
