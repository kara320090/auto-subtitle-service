        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭔가 핑계를 찾기는 찾아야 돼서 이런 이야기를 합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.445
            },
            {
                "speaker_id": "1",
                "transcription": "아니요.",
                "sound_type": [
                    2
                ],
                "start": 3.455,
                "end": 3.832
            },
            {
                "speaker_id": "1",
                "transcription": "진짜예요.",
                "sound_type": [
                    2
                ],
                "start": 3.842,
                "end": 4.217
            },
            {
                "speaker_id": "1",
                "transcription": "정말 다 긁었어요.",
                "sound_type": [
                    2
                ],
                "start": 4.227,
                "end": 6.366
            },
            {
                "speaker_id": "1",
                "transcription": "아 핑계를 찾아보려고 해도요.",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 6.376,
                "end": 10.971
            },
            {
                "speaker_id": "1",
                "transcription": "야 이렇게 환상적인 포인트에서 어 입질 한번 못 봤다니 제가 완전히 굴욕을 당했습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.981,
                "end": 18.072
            },
            {
                "speaker_id": "1",
                "transcription": "괜히 자리를 옮겼나 싶기도 하고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 18.082,
                "end": 20.302
            },
            {
                "speaker_id": "1",
                "transcription": "그나마 저기서 작은 녀석들이라도 4마리 봐서 다행입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 20.312,
                "end": 25.196
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 그냥 여기까지 하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 25.206,
                "end": 27.419
            },
            {
                "speaker_id": "1",
                "transcription": "시청해 주셔서 감사드립니다.",
                "sound_type": [
                    2
                ],
                "start": 27.429,
                "end": 29.613
            }
        ]
    },
    "summary": "핑계를 찾아보려고 해도 이렇게 환상적인 포인트에서 입질 한번 못 봤다니 굴욕스럽고 그나마 작은 녀석 4마리라도 잡아 봐서 다행이다.",
