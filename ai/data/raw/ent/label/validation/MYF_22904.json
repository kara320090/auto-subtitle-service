        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "인천을 가기 때문에 상태가 미쳤어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.926
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 강사님이 수업하고 계셔서 여기에서 요렇게 전 이렇게 불을 켜주고 커피를 한잔 마실게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.936,
                "end": 20.068
            },
            {
                "speaker_id": "1",
                "transcription": "아 센터에서 마시는 커피가 제일 맛있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.078,
                "end": 28.856
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 커피도 스타벅스 원두기 때문에 너무 맛있거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.866,
                "end": 35.600
            },
            {
                "speaker_id": "1",
                "transcription": "저희가 이번에 큰맘 먹고 구비를 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.610,
                "end": 51.430
            },
            {
                "speaker_id": "1",
                "transcription": "방금 강사님이랑 수다를 엄청 떨고 지금 이제 들어가셨어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.440,
                "end": 57.416
            },
            {
                "speaker_id": "1",
                "transcription": "강사님은 퇴근을 하셨고 저만 지금 남아있는 상태라서 이제 좀 업무를 저도 봐야 될 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.426,
                "end": 66.033
            }
        ]
    },
    "summary": "화자는 큰 맘 먹고 센터에 인바디를 들여놨고 센터에서 마시는 커피가 제일 맛있다고 소소한 이야기를 하고 있다.",
