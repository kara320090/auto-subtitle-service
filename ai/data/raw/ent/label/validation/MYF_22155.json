        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "외래어종이 있는지 없는지를 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.824
            },
            {
                "speaker_id": "1",
                "transcription": "제가 겨울에는 지렁이를 좀 사용을 했었는데요.",
                "sound_type": [
                    2
                ],
                "start": 2.834,
                "end": 6.888
            },
            {
                "speaker_id": "1",
                "transcription": "그때도 블루길이나 뭐 배스나 이런 것들이 안 달라들더라구요 살치나.",
                "sound_type": [
                    2
                ],
                "start": 6.898,
                "end": 12.072
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 지금 이야 우이야 뭔 힘이 이렇게 좋냐.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.082,
                "end": 19.662
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 멘트하는 사이에 1마리 잡았네.",
                "sound_type": [
                    2
                ],
                "start": 19.672,
                "end": 26.311
            },
            {
                "speaker_id": "1",
                "transcription": "자 어디까지 얘기했죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.321,
                "end": 39.669
            },
            {
                "speaker_id": "1",
                "transcription": "아 아무튼 외래어종이 있는지 없는지는 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 39.679,
                "end": 43.581
            },
            {
                "speaker_id": "1",
                "transcription": "지렁이 썼을 때도 블루길, 배스 안 달라들었으니까요.",
                "sound_type": [
                    2
                ],
                "start": 43.591,
                "end": 48.628
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 지렁이를 안 쓰고 있구요.",
                "sound_type": [
                    2
                ],
                "start": 48.638,
                "end": 50.707
            }
        ]
    },
    "summary": "남성은 외래어종을 잡은 적이 없어서 외래어종이 있는지 없는지 알 수 없다고 한다.",
