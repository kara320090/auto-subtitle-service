        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 아 회사에서도 있는 그대로의 나의 나의 모습으로 존재하는 게 가능하구나 희망을 얻었다 할까?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.142
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 보통 우리가 사회 생활을 가면을 쓰기 마련이잖아요.",
                "sound_type": [
                    2
                ],
                "start": 8.152,
                "end": 11.554
            },
            {
                "speaker_id": "1",
                "transcription": "저도 이때까지 그랬거든요.",
                "sound_type": [
                    2
                ],
                "start": 11.564,
                "end": 13.132
            },
            {
                "speaker_id": "1",
                "transcription": "내가 진짜 원하는 일도 아니고 내가 같이 일하고 싶은 사람들도 아니고 그럴 때가면을 많이 썼죠.",
                "sound_type": [
                    2
                ],
                "start": 13.142,
                "end": 19.817
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 여기 모빌스 그룹 팀원 들은 진짜 나로서 존재하더라고요.",
                "sound_type": [
                    2
                ],
                "start": 19.827,
                "end": 24.871
            },
            {
                "speaker_id": "1",
                "transcription": "나도 이런 회사를 만들 수 있다면 얼마나 좋을까 그런 생각도 들고 경국 씨랑 이게 우리의 진짜 떨린 포인트가 맞는지 그거를 확인하는 시간을 갖고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 24.881,
                "end": 35.225
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 과정에서 진짜 많은 대화를 나누고 계속해서 딥해지고 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 35.235,
                "end": 39.637
            },
            {
                "speaker_id": "1",
                "transcription": "어 요만큼도 되게 딥하다고 생각했는데 또 들어가서 더 본질을 얘기하고 거의 제가 심리 상담받을 때 급으로 진짜 깊은 대화를 많이나누고 있는데 오 그게 서로 통한다는 것도 좀 신기하고 제가 지금 돈을 버는게 너무 중요 하지만 이 본질적인 부분을 꼭 건드리고 가야 당장 조금 돌아가더라도 그게 진짜 제대로 가는 길이 아닌가라는 생각이 들어요.",
                "sound_type": [
                    2
                ],
                "start": 39.647,
                "end": 64.635
            },
            {
                "speaker_id": "1",
                "transcription": "인생에서 돈이 너무너무 중요 하지만 음.",
                "sound_type": [
                    2
                ],
                "start": 64.645,
                "end": 68.700
            }
        ]
    },
    "summary": "한 여자가 모빌스 그룹 팀원 들은 진짜 나로서 존재하는데 본인도 그런 회사를 만들고 싶다고 한다.",
