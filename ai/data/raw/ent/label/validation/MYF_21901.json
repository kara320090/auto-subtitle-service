        "term": [
            {
                "speaker_id": "1",
                "transcription": "그거에 집중을 해야겠구나라는 생각이 들더라고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.048
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 제가 최근에 생각했던 건데 @이름1님이 딱 그렇게 정리를 해 주시니까 조금 더 속이 시원하고 넥스트 스텝에 대한 정리가 된 것 같아서 진짜 감사했어요.",
                "sound_type": [
                    2
                ],
                "start": 3.058,
                "end": 14.440
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 그날 이제 작가님을 처음 뵀는데 너무 친절하시고 이렇게 잘해 주셔서 진짜 감사했고 PD 님들도 제 개인 촬영 때 한번 뵙고 그날 또 뵙는데 많이 바빠 보이셨지만 바쁜 와중에도 제 인증샷 찍어 주시고 따뜻하게 잘 챙겨 주셔서 진짜 너무 감사했고 그리고 무사히 촬영을 마치고 집에 돌아오는 버스 안에서 기분이 되게 좋더라고요.",
                "sound_type": [
                    2
                ],
                "start": 14.450,
                "end": 39.896
            },
            {
                "speaker_id": "1",
                "transcription": "좀 스스로가 많이 기특했어요.",
                "sound_type": [
                    2
                ],
                "start": 39.906,
                "end": 41.414
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 제가 두려워하는 일에 대해서 또 도전을 한 거고 누구나 다 어렵고 힘든 게 싫지만 내가 두려워하는 것도 부딪혀 봐야 나의 세계가 한층 더 확장이 되는구나를 느끼면서 앞으로도 이런 기회가 있으면 두렵지만 그래도 도전을 해 봐야겠라는 생각이 들더라고요.",
                "sound_type": [
                    2
                ],
                "start": 41.424,
                "end": 60.577
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 얼마 전에 이제 대망의 방송 날이었어요.",
                "sound_type": [
                    2
                ],
