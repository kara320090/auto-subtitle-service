                    3
                ],
                "start": 1.535,
                "end": 11.945
            },
            {
                "speaker_id": "2",
                "transcription": "그 인사 셀레브레이션 있지 않습니까? 델리알리.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.955,
                "end": 14.585
            },
            {
                "speaker_id": "1",
                "transcription": "이거 안된다니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.595,
                "end": 15.485
            },
            {
                "speaker_id": "2",
                "transcription": "델리알리 셀레브레이션 하면서 영상 마무리하도록 하겠습니다. 연습하기 없어. 하나, 둘, 셋. 어떻게 해야 돼? 하하하. 이렇게인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.495,
                "end": 28.046
            },
            {
                "speaker_id": "1",
                "transcription": "가르쳐줘.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.056,
                "end": 29.991
            },
            {
                "speaker_id": "2",
                "transcription": "이거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.001,
                "end": 32.295
            },
            {
