        "term": [
            {
                "speaker_id": "1",
                "transcription": "올라오기는 올라온 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.438
            },
            {
                "speaker_id": "1",
                "transcription": "자 가고 얼른 던지고 캐미를 끼우자 일단 붕어가 여기까지 올라왔다는 건 확인됐으니까요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.448,
                "end": 22.070
            },
            {
                "speaker_id": "1",
                "transcription": "조금 있으면 이제 큰놈들도 나오겠죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.080,
                "end": 36.670
            },
            {
                "speaker_id": "1",
                "transcription": "저기 맞은편 갈대에 한 4 4칸 정도면 붙을 것 같은데요.",
                "sound_type": [
                    2
                ],
                "start": 36.680,
                "end": 43.264
            },
            {
                "speaker_id": "1",
                "transcription": "위에 전기줄이 있어가지고 어쩔 수가 없습니다.",
                "sound_type": [
