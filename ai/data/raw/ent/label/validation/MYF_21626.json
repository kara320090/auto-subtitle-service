        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇게 본격적으로 말씀드리기 앞서서 제가 분명하게 말씀드릴 사실은 저는 보스니아에 살면서 보스니아 사람들에게 인종 차별을 당한 적이 없어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.519
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 보스니아분들은 정말로 외국인들에게 친절하다고 생각해요.",
                "sound_type": [
                    2
                ],
                "start": 11.529,
                "end": 17.157
            },
            {
                "speaker_id": "1",
                "transcription": "그 어느 나라보다 포용력이 있다고 해야 되나 웰컴해 주는 분위기가 있기 때문에 보스니아 분들이 저한테 인종 차별을 한 적은 없다고 생각합니다.",
                "sound_type": [
                    2
                ],
                "start": 17.157,
                "end": 28.253
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 어떻게 보면 했을 수도 있어요 이게 오늘 제가 드리고 싶은 말씀이에요.",
                "sound_type": [
                    2
                ],
                "start": 28.263,
                "end": 35.428
            },
            {
                "speaker_id": "1",
                "transcription": "음 저희가 이제 길을 가게되면 너무 귀여운 아기들이나 너무 친절하신 분들이 저희한테 니하오하고 인사할 때가 많아요.",
                "sound_type": [
                    2
                ],
                "start": 35.438,
                "end": 46.386
