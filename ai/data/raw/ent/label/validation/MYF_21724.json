        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고 이제 저희 가족에 대해서도 다 물어봤거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.703
            },
            {
                "speaker_id": "1",
                "transcription": "저희 어머니, 아버지, 오빠에 대해서도 막 물어 봤었는데 기억에 남는 게 저희 오빠가 올해 아이다 이제 작년이구나 결혼을 했잖아요.",
                "sound_type": [
                    2
                ],
                "start": 2.713,
                "end": 12.222
            },
            {
                "speaker_id": "1",
                "transcription": "오빠의 아내분이 새언니를 제가 엄청 좋아하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.232,
                "end": 16.764
            },
            {
                "speaker_id": "1",
                "transcription": "때마침 그 선생님께서 오빠 결혼 잘했네.",
