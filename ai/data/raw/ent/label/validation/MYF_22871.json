                ],
                "start": 11.385,
                "end": 19.865
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 부들 쪽에서는 까딱도 안하고 5, 6칸 6, 0칸 맹탕에서 네 치, 다섯 치, 여섯 치들 날라오는데",
                "sound_type": [
