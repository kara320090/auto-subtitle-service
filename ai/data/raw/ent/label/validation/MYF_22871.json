        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 찌가 보이니까 찌잡이를 빼도록 하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 4.866
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우는 밤낚보다 짬낚이 훨씬 조과가 좋은 것 같아요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 4.876,
                "end": 10.247
            },
            {
                "speaker_id": "1",
                "transcription": "딱 일주일 전이죠.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.257,
                "end": 11.375
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 저도 주말에만 출조를 하고 있는데 부들 앞에 짧은대 그리고 맹탕에는 장대로 편성을 해서 정말 열심히 했습니다.",
                "sound_type": [
                    1,
