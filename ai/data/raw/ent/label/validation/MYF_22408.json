        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 앞으로 또 1년 후에 희연이 1년 후의 올릴 유튜브 영상에서는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.135
            },
            {
                "speaker_id": "1",
                "transcription": "또 어떤 말을 하고 있을지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.145,
                "end": 7.594
            },
            {
                "speaker_id": "1",
                "transcription": "되게 궁금하다 그치?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.604,
                "end": 9.821
            },
            {
                "speaker_id": "1",
                "transcription": "유튜브를 한다는 게 그게 좋은 거 같애.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.831,
                "end": 15.528
            },
            {
                "speaker_id": "1",
                "transcription": "이제 정말 기록이 되잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.538,
                "end": 17.693
            },
            {
                "speaker_id": "1",
                "transcription": "내 22살 때 23살 때 24살 때 25살 때 이런 식으로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.703,
                "end": 24.605
            },
            {
                "speaker_id": "1",
                "transcription": "그년도마다 진짜 내가 기록 기록이 되니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.615,
                "end": 28.999
            },
            {
                "speaker_id": "1",
                "transcription": "아예 영상물로 남아있으니까 가끔 나도 내 영상을 정주행하거든?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.009,
                "end": 33.905
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 진짜 새로워 저 때 나 진짜 어렸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.915,
                "end": 37.681
            },
            {
                "speaker_id": "1",
                "transcription": "저 때 나 진짜 발랄했다 이러면서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.691,
                "end": 41.205
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 새롭고 재밌더라고 나름 내 영상 보는 게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.215,
                "end": 46.250
            }
        ]
    },
    "summary": "여자가 실내에서 음식을 먹으며 시청자와 함께 유튜브 영상 속 자기 모습에 관해 이야기하고 있다.",
