        "term": [
            {
                "speaker_id": "1",
                "transcription": "고기류, 야채, 채소, 잡곡, 깨 들어가 있는 것, 씨 있는 과일, 김치 뭐 이거 빼고 나니까 먹을 게 없더라고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 8.867
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 좀 체력적으로 한계가 있을 듯 싶어서 제가 짬내고 왔습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 8.877,
                "end": 13.302
            },
            {
                "speaker_id": "1",
                "transcription": "안 그랬으면 어제 밤 나고 왔을 거예요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.312,
                "end": 15.191
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 검사 끝나고 시간 되는 대로 밤 낚시로도 찾아 뵙겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 15.201,
                "end": 19.711
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 저는 짬 나기도 족과과 좋더라고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 19.721,
                "end": 22.765
            },
            {
                "speaker_id": "1",
                "transcription": "자 그럼 오늘 영상 여기까지 하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 22.775,
                "end": 26.471
            },
            {
                "speaker_id": "1",
                "transcription": "감사드립니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 26.481,
                "end": 27.243
            }
        ]
    },
    "summary": "화자는 대장내시경 때문에 먹을 게 없다고 체력적으로 한계가 있을 것 같아서 짬내서 낚시에 왔다고 한다.",
