        "term": [
            {
                "speaker_id": "1",
                "transcription": "＠이름１ 피디는 당시 KBS의 라디오 피디로 2004년 평소 눈여겨 본 김구라를 9KBS 2FM 김구라의 가요 광장의 DJ로 앉힌 사람이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.931
            },
            {
                "speaker_id": "1",
                "transcription": "김구라에게는 생명의 은인일지도 모르겠지만 객관적으로 보면 정말 용감하고 알 수 없는 선택이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.941,
                "end": 11.433
            },
            {
                "speaker_id": "1",
                "transcription": "라디오라는 매체 자체가 엄청난 성과를 내야 한다거나 청취율이 중요한 매체가 아니기 때문에 적당히 평판이 좋은 사람을 데려다 앉혀도 무리 없는 자리임을 생각하면 정말 불가사의한 선택이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.443,
                "end": 19.593
            },
            {
                "speaker_id": "1",
                "transcription": "당시 김구라는 평판이 좋은 연예인이 아니었을 뿐더러 저질스럽고 자극적인 발언으로 유명한 3류 연예인이었기 때문에 @이름1 PD가 대체 왜 그런 위험을 감수했는지는 아직까지도 알 길이 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.603,
                "end": 28.679
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 PD도 후에 김구라를 기용한다고 했을 때 엄청난 비판과 청취자들의 극에 달한 분노에 시달려 시말서를 쓸 뻔했다고 회고하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.689,
                "end": 35.268
            }
        ]
    },
    "summary": "@이름1 피디는 2004년에 평 김구라를 KBS 2FM 김구라의 가요 광장의 디제이로 앉혔으며 당시 김구라는 평판이 안 좋아 엄청난 비판과 청취자들의 극에 달한 분노에 시달려 시말서를 쓸 뻔했었다.",
