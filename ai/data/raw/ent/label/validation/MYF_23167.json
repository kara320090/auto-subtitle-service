                    2
                ],
                "start": 8.769,
                "end": 10.117
            },
            {
                "speaker_id": "1",
                "transcription": "정말 사실이라고 제가 알고 있습니다. 제가 투어를 다닐 때 그렇게 들었어요.",
                "sound_type": [
                    2
                ],
                "start": 10.127,
                "end": 13.194
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 투어해주시는 그 분이 그렇게 말씀을 해 주셨어요.",
