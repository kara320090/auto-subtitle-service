        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 치우고 있어봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.885
            },
            {
                "speaker_id": "1",
                "transcription": "내가 갖고 올게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.885,
                "end": 2.020
            },
            {
                "speaker_id": "2",
                "transcription": "따라라라단 형님이 준비해 주신 간식",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.030,
                "end": 5.535
            },
            {
                "speaker_id": "1",
                "transcription": "이거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.545,
                "end": 7.108
            },
            {
                "speaker_id": "2",
                "transcription": "어",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.118,
                "end": 7.460
            },
            {
                "speaker_id": "1",
                "transcription": "아이 아",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.470,
                "end": 10.629
            },
            {
                "speaker_id": "2",
                "transcription": "민초단 나가 민초단.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.639,
                "end": 13.043
            },
            {
                "speaker_id": "1",
                "transcription": "아이 치약을 넣어놨어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.053,
                "end": 16.066
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 날아간 관계로 한 번 더 먹어야 되는 아픔이 우리는 반 민초단이라고 이게 뭐냐",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.076,
                "end": 25.977
            },
            {
                "speaker_id": "1",
                "transcription": "이게 망치 망치",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.980,
                "end": 27.450
            },
            {
                "speaker_id": "2",
                "transcription": "민트 초코 마카롱 아이스크림",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.460,
                "end": 29.330
            },
            {
                "speaker_id": "1",
                "transcription": "저희가 싫어하는 것만 들어있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.330,
                "end": 30.794
            },
            {
                "speaker_id": "1",
                "transcription": "민트, 초코, 마카롱, 아이스크림 오빠가 한입에 다 먹으면 끝날 수 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.802,
                "end": 34.669
            },
            {
                "speaker_id": "2",
                "transcription": "와 근데 색깔봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.679,
                "end": 35.469
            },
            {
                "speaker_id": "2",
                "transcription": "미쳤어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.479,
                "end": 36.103
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 진짜 곰팡이 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.113,
                "end": 38.787
            },
            {
                "speaker_id": "2",
                "transcription": "가위바위보 해서 진 사람이 먹자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.787,
                "end": 39.846
            },
            {
                "speaker_id": "2",
                "transcription": "안 내면 먹기 가위바위보 오케이 1대0",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.856,
                "end": 42.490
            },
            {
                "speaker_id": "1",
                "transcription": "아 하지마라 진짜 그런거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.490,
                "end": 44.025
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 치사한 거, 진짜 진짜 얄미시럽고 쫌생이 같은 거 하지 말아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.025,
                "end": 48.360
            },
            {
                "speaker_id": "2",
                "transcription": "판 2선승 제였어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.360,
                "end": 49.227
            },
            {
                "speaker_id": "1",
                "transcription": "이 사기꾼아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.237,
                "end": 50.165
            },
            {
                "speaker_id": "2",
                "transcription": "3판 2선승 한판만 더 이기면 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.162,
                "end": 51.542
            },
            {
                "speaker_id": "2",
                "transcription": "오빠는 2판 이기고 오케이?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.542,
                "end": 52.499
            },
            {
                "speaker_id": "2",
                "transcription": "안내면 진 거 가위바위보",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.507,
                "end": 53.660
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 내가 이겼잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.660,
                "end": 56.832
            },
            {
                "speaker_id": "2",
                "transcription": "1대1 빨리 해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.832,
                "end": 57.789
            },
            {
                "speaker_id": "2",
                "transcription": "안 내면 진 거 가위바위보,가위바위보,가위바위보",
