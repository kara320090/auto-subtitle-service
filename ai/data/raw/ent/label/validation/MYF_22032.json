        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 이런 풍광 풍광 좋은 소류지의 매력이 있죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.707
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 제가 개인적인 일로 낚시 말고요. 약간 속앓이도 하고 스트레스도 받고 좀 가슴도 답답했는데 해소도 되고 가슴도 살짝 뚫렸습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.717,
                "end": 14.660
            },
            {
                "speaker_id": "1",
                "transcription": "시간도 벌써 11시를 향해 가고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 14.670,
                "end": 18.718
            },
            {
                "speaker_id": "1",
                "transcription": "예 가야겠죠.",
                "sound_type": [
                    2
                ],
                "start": 18.728,
                "end": 21.029
            },
            {
                "speaker_id": "1",
                "transcription": "야 또 다른 새로운 곳에서 다시 찾아 뵙고요.",
                "sound_type": [
                    2
                ],
                "start": 21.039,
                "end": 24.697
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 여기까지 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 24.707,
                "end": 26.004
