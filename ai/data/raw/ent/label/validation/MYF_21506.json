        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 이유는 저는 가지처럼 생겼고 토마토는 토마토처럼 생겼어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.785
            },
            {
                "speaker_id": "1",
                "transcription": "저는 얼굴이 이렇게 생겼고 토마토 얼굴이 이렇게 생겼습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.795,
                "end": 10.123
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저희는 채소 가족이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.133,
                "end": 12.099
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 사람들이 아 왜 가지인지 알겠다 이렇게 얘기를 하곤 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.109,
                "end": 16.724
            },
            {
                "speaker_id": "1",
                "transcription": "부부 전 캠핑이 좋아요? 부부 후 캠핑이 좋아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.734,
                "end": 20.134
            },
            {
                "speaker_id": "1",
                "transcription": "결혼 전이랑 제일 크게 달라진 거는 빌라에 살다가 이제 아파트로 이사를 오게 되면서 토마토가 캠핑 짐 나르는 게 엄청 수월해졌어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.144,
                "end": 31.721
            },
            {
                "speaker_id": "1",
                "transcription": "그거 말고는 다 달라진 게 없는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.731,
                "end": 34.094
            },
            {
                "speaker_id": "1",
                "transcription": "그다음으로 MBTI 관련한 질문도 있었거든요.",
