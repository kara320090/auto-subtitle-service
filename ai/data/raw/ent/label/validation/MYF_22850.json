        "term": [
            {
                "speaker_id": "1",
                "transcription": "한 5정도 5가 조금 안 될 것 같네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.453
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 좋아요 와",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.463,
                "end": 4.514
            },
            {
                "speaker_id": "1",
                "transcription": "정말 여기 붕어 이쁘구나 자 살짝 던질게요 가라",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 4.524,
                "end": 10.961
            },
            {
                "speaker_id": "1",
                "transcription": "지금 20칸하고 24칸은 바닥이 완전 보이고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.971,
                "end": 14.754
            },
            {
                "speaker_id": "1",
                "transcription": "야 그나저나 기가 막히게 잘 던져놨네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 14.764,
                "end": 17.103
            },
            {
                "speaker_id": "1",
                "transcription": "그 찌든 수초 사이에다가 맨땅에다가 28칸도 지금 아슬아슬 한데 2024 걷어버리고요 20자리에다가 56칸을 편성하겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 17.113,
                "end": 27.198
            },
            {
                "speaker_id": "1",
                "transcription": "바람 더 불기 전에 얼른 던져야겠어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 27.208,
