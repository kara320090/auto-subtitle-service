        "term": [
            {
                "speaker_id": "1",
                "transcription": "자세히 한번 살펴보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.740
            },
            {
                "speaker_id": "1",
                "transcription": "자 이게 전원 버튼이고 이게 음량 버튼이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.740,
                "end": 7.021
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 하다가는 한도 끝도 없기 때문에 몇 가지 주요 기능들만 말하겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.031,
                "end": 12.185
            },
            {
                "speaker_id": "1",
                "transcription": "일단 크기는 한 손에 딱 들어오는 것이 물통, 작은 음료수병 아 맥주 아 맥주 캔이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.185,
                "end": 19.963
            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 맥주 확 땡기는데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.973,
                "end": 21.164
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 이 정도 크기고 모양은 꼭 칙치기 붐 칙치기 붐 소리 날 것 같이 생겼지만 나지는 않는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.174,
                "end": 26.763
            },
            {
                "speaker_id": "1",
                "transcription": "스피커의 양 끝을 만져보면 볼롱볼롱 눌리는 것이 마치 방방 같은데 양방향 패시브 라디에이터로 베이스 사운드를 즐길 수 있다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.773,
                "end": 34.602
            },
            {
                "speaker_id": "1",
                "transcription": "3시간 완충 최대 8시간 연속 재생이 가능하고 블루투스, TF 카드, 옥스 케이블 연결 또한 가능하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.612,
                "end": 41.375
            },
            {
                "speaker_id": "1",
                "transcription": "밑바닥에는 나사 홀이 있어서 여러 가지 스탠드에 장착도 가능하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.375,
                "end": 46.713
            }
        ]
    },
    "summary": "스피커의 주요 기능은 양방향 패시브 라디에이터가 있어서 베이스 소리를 들을 수 있고 나사홀이 있어서 여러 가지 스텐드에 장착도 가능하고 여러 케이블과도 연결할 수 있고 3시간이면 완충되고 8시간 동안 사용이 가능하다.",
