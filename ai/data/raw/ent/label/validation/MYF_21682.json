        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리는 너무 달라요 제가 봐도 음식도 뭐 막 음식이 엄청 특이하거나 막 못 먹을 게 아니라 한국에서 접할 할 수 없는 음식이 많다 보다 저희 여기 와서 다 처음 보는 음식?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 13.602
            },
            {
                "speaker_id": "2",
                "transcription": "그러면 그거 보스니아 음식 문화에서 섞이는 게 많이 없어요.",
                "sound_type": [
                    2
                ],
                "start": 13.602,
                "end": 17.143
            },
            {
                "speaker_id": "2",
                "transcription": "그냥 그 고기면 고기",
                "sound_type": [
                    2
                ],
                "start": 17.153,
                "end": 19.472
            },
            {
                "speaker_id": "1",
                "transcription": "딱 하나씩 이렇게",
                "sound_type": [
                    2
                ],
                "start": 19.470,
                "end": 20.916
            },
            {
                "speaker_id": "2",
                "transcription": "밥이면 밥 그냥 그렇게 하는데 터키 음식이 한국 음식이랑 좀 더 비슷할 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 20.926,
                "end": 26.512
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그리고 여기 보스니아 음식 왜 이렇게 짜요?",
                "sound_type": [
                    2
                ],
                "start": 26.515,
                "end": 30.282
            },
            {
                "speaker_id": "2",
                "transcription": "저도 잘 몰라요 저도 짠 것을 잘 못 먹는 편인데 어디 가면 너 너무 짜요 네.",
                "sound_type": [
                    2
                ],
                "start": 30.292,
                "end": 38.828
            },
            {
                "speaker_id": "2",
                "transcription": "근데 그거는 건강에 좋은 거 아니에요.",
                "sound_type": [
                    2
                ],
                "start": 38.838,
                "end": 43.001
            }
        ]
    },
    "summary": "보스니아 음식은 한국에서 접하지 못한 음식들이 많고 너무 짠 편이다.",
