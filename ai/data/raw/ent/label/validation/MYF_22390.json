        "term": [
            {
                "speaker_id": "1",
                "transcription": "내가 뭔가 그렇게 크게 취한 티를 안 나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.339
            },
            {
                "speaker_id": "1",
                "transcription": "내가 술주정이 진짜 아니 너무 많이 마시는 거 말고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.349,
                "end": 9.308
            },
            {
                "speaker_id": "1",
                "transcription": "적당히 취했을 때 술주정이 약간 애교가 많아진다고 그러더라구 애교가 많아지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.318,
                "end": 14.691
            },
            {
                "speaker_id": "1",
                "transcription": "약간 좀 웃는다 웃는거 그 정도거든",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.701,
                "end": 18.518
            },
            {
                "speaker_id": "1",
                "transcription": "얼굴이 막 시뻘게지고 이런 건 아니라서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.528,
                "end": 20.963
            },
            {
                "speaker_id": "1",
                "transcription": "지금도 약간 지금 딱 기분 좋은 정도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.973,
                "end": 24.859
            },
            {
                "speaker_id": "1",
                "transcription": "약간 애교가 좀 늘어날라고 하는 건가 모르겠는 정도",
                "sound_type": [
                    2,
                    3
                ],
