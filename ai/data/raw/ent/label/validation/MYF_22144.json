                ],
                "start": 7.989,
                "end": 14.928
            },
            {
                "speaker_id": "1",
                "transcription": "지금 처음부터 그냥 바늘만 살짝 덮을 정도로 어 그렇게 붕어가 먹기 좋게요.",
                "sound_type": [
