        "term": [
            {
                "speaker_id": "1",
                "transcription": "한본어의 창시자라고 불리우는 강유미.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.062
            },
            {
                "speaker_id": "1",
                "transcription": "그녀가 여러 예능에서 한본어를 뽐내며 인기 몰이를 하고 있다.",
                "sound_type": [
                    2,
                    3
                ],
