                "end": 9.980
            },
            {
                "speaker_id": "2",
                "transcription": "너 여기 있어봐봐 갔다올게.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.990,
                "end": 11.740
            },
            {
                "speaker_id": "1",
                "transcription": "자전거 봐봐 자전거 탈래?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.750,
                "end": 14.414
            },
            {
