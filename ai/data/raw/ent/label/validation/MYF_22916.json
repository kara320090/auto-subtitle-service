                    2,
                    5
                ],
                "start": 14.424,
                "end": 15.040
            },
            {
                "speaker_id": "1",
                "transcription": "뷔페를 먹으러 옷을 갈아 입고 나왔어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.050,
                "end": 18.771
            },
            {
                "speaker_id": "1",
                "transcription": "너무 피곤해가지고 밥 먹으면 기절할 것 같은데 배가 너무 고프네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.781,
                "end": 23.735
            },
            {
                "speaker_id": "1",
                "transcription": "자 카메라 보고 이모 삼촌들한테 안녕 해줘 안녕",
                "sound_type": [
                    2,
                    5
                ],
