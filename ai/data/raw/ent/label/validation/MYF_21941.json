        "term": [
            {
                "speaker_id": "1",
                "transcription": "공부 제발 열심히 하라고 언어 쪽으로 공부하라고 그 말을 하셨어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.233
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 그날 그렇게 팩트 폭격을 뚜드려 맞고 나서 혼자 카페에 가가지고 또 들었던 말들을 다 정리를 하고 친한 친구를 만나서 또 막 얘기를 하고 집에 왔는데 그때서야 좀 마음 놓고 울었어요.",
                "sound_type": [
                    2
                ],
                "start": 4.243,
                "end": 17.833
            },
            {
                "speaker_id": "1",
                "transcription": "그래 내가 이런 게 문제였지 이것도 문제지 저것도 문제지 하면서 근데 사실 처음 들은 얘기는 아니거든요.",
                "sound_type": [
                    2
                ],
                "start": 17.843,
                "end": 22.979
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 사람이 참 알면서도 안 바꿔지는 부분들이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 22.989,
                "end": 27.729
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그런 팩트 폭격도 처음 들으면 솔직히 좀 부정하고 싶고 저항하게 되는데 계속 듣다 보니까 슬슬 인정하게 돼요.",
                "sound_type": [
                    2
                ],
                "start": 27.739,
                "end": 36.323
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래 나 이거 진짜 고쳐야겠구나",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.333,
                "end": 38.605
            }
        ]
    },
    "summary": "혼자 카페에 가서 들었던 말을 정리하고 친한 친구를 만나서 얘기하고 집에 왔는데 그때 서야 마음 놓고 울었고 슬슬 인정하게 되었다.",
