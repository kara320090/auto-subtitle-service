        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러 명이 동시에 피해를 입어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.760
            },
            {
                "speaker_id": "1",
                "transcription": "판매를 한다는 건 그에 대한 책임도 있는 거라고 생각합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.770,
                "end": 4.894
            },
            {
                "speaker_id": "1",
                "transcription": "그 책임이 좋은 의미든 나쁜 의미든 이런 측면에서 국산 차 지점과 대리점이 이번 사건처럼 법적인 책임에 대해서 사기 피해를 예방할 수 있고 혹시라도 이런 사건이 발생했을 때 해결하는 방안도 빠르게 만들어줬으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.904,
                "end": 17.724
            },
            {
                "speaker_id": "1",
                "transcription": "소비자는 브랜드를 보고 대리점이든 지점이든 가는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.734,
                "end": 21.325
            },
            {
                "speaker_id": "1",
                "transcription": "제조사에 대한 최소한의 믿음이 있으니까 두 발로 찾아가는 거라구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.335,
                "end": 25.212
            },
            {
                "speaker_id": "1",
                "transcription": "잊지 말고 혹시라도 국산 차 제조사 관계자들이 이 영상을 보고 계신다면 빠르게 이런 방안을 마련해 주시길 간곡히 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.222,
                "end": 33.327
            },
            {
                "speaker_id": "1",
                "transcription": "더 이상 이런 피해자가 나오면 안 되잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.337,
                "end": 35.375
            }
        ]
    },
    "summary": "남성은 피해자들이 자동차 제조사를 믿고 대리점이나 지점을 찾아가는 것이니 제조사에서도 사기를 예방하기 위한 방안을 마련해 주길 바란다고 말한다.",
