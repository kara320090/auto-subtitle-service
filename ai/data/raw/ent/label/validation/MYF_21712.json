        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 오히려 20대 초반 중반까지는 그래도 보통의 연애 좀 길게 만나기도 하고 나름 뭐 럽스타 이런 것도 올리고 스스로 사랑꾼이라고 생각했었거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.230
            },
            {
                "speaker_id": "1",
                "transcription": "근데 20대 중반부터 진짜 연애가 너무 안 되는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.240,
                "end": 14.199
            },
            {
                "speaker_id": "1",
                "transcription": "사람들이 다 저에게서 튕겨 나가는 느낌 이런 경험들이 계속 반복이 되면 당연히 스스로를 돌아 볼 수밖에 없잖아요.",
                "sound_type": [
                    2,
                    3
                ],
