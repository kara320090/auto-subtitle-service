            },
            {
                "speaker_id": "1",
                "transcription": "동시에 여성 예능인으로서 내로라하는 남성 연예인들 사이에서도 절대로 꿀리지 않는 카리스마로 탑의 자리에 올라본 몇 안 되는 레전드 중 1명이기도 하죠.",
                "sound_type": [
                    2,
