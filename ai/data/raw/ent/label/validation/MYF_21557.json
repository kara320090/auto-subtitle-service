        "term": [
            {
                "speaker_id": "1",
                "transcription": "사람들이 우리 귀엽데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.231
            },
            {
                "speaker_id": "1",
                "transcription": "어디 무슨 댓글에 부부 텐션 리을, 기역, 니은 써있어서 내가 무슨 말인지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.241,
                "end": 7.105
            },
            {
                "speaker_id": "2",
                "transcription": "내가 레게노라고 했잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.105,
                "end": 8.359
            },
            {
                "speaker_id": "2",
                "transcription": "레전드라고 레전드",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.367,
                "end": 9.687
            },
            {
                "speaker_id": "1",
                "transcription": "아 맞다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.687,
                "end": 10.345
            },
            {
                "speaker_id": "1",
                "transcription": "오빠가 얘기해줬다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.345,
                "end": 11.172
            },
            {
                "speaker_id": "1",
                "transcription": "잘먹었 하나, 둘, 셋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.182,
                "end": 16.640
            },
            {
                "speaker_id": "1",
                "transcription": "이야야야 앉아봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.637,
                "end": 19.827
            },
            {
                "speaker_id": "1",
                "transcription": "우리 간식",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.827,
                "end": 20.405
            },
            {
                "speaker_id": "2",
                "transcription": "이거 꺼야돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.405,
                "end": 21.046
            },
            {
                "speaker_id": "1",
                "transcription": "아니 우리 간식 먹는 것도 찍어야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.056,
                "end": 23.207
            },
            {
                "speaker_id": "2",
                "transcription": "아 다시 찍으면 되지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.207,
                "end": 24.075
            },
            {
                "speaker_id": "1",
                "transcription": "아니.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.085,
                "end": 24.563
            },
            {
                "speaker_id": "2",
                "transcription": "아니 이거 치우고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.573,
                "end": 25.618
            },
            {
                "speaker_id": "1",
                "transcription": "아니 내가 할 거야.",
