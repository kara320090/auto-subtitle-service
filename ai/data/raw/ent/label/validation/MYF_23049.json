                    2,
                    4
                ],
                "start": 14.666,
                "end": 16.360
            },
            {
                "speaker_id": "1",
                "transcription": "그만 너도 할아버지 나물 뜯어야지. 너 끌어안고 끌어안아 주면 할아버지 나물 못 줍잖어.",
