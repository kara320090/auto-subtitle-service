        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭉치 안아줘? 응 안아주세요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 2.251
            },
            {
                "speaker_id": "2",
                "transcription": "이거 지금 머리카락인지 그건지 모르겠네.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 2.261,
                "end": 5.191
            },
            {
                "speaker_id": "3",
                "transcription": "여기 엄청나다. 여기.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.201,
                "end": 6.538
            },
            {
                "speaker_id": "1",
                "transcription": "거기 나물 밭이여.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.548,
                "end": 7.734
            },
            {
                "speaker_id": "3",
                "transcription": "완전 밭이네.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.744,
                "end": 8.813
            },
            {
                "speaker_id": "2",
                "transcription": "된 거 같아요. 예예예.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.823,
                "end": 11.163
            },
            {
                "speaker_id": "1",
                "transcription": "저쪽으로 전부 다여 그만.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.173,
                "end": 13.040
            },
            {
                "speaker_id": "3",
                "transcription": "그러니까 여기 장난 아니야.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.050,
                "end": 14.656
            },
            {
                "speaker_id": "1",
                "transcription": "할아버지 뽀뽀여.",
