        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "예전부터 팀원들이랑 같이 해보고 싶다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.051
            },
            {
                "speaker_id": "1",
                "transcription": "이런 마음이 있었기 때문에 정말 깊게 고민을 안 하고 진짜 흔쾌히 오케이를 했던 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 3.061,
                "end": 8.595
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 취미로 사이드 프로젝트로 한 게 아니라 그니까 셋 다 본업이 필요한 상황이었어요.",
                "sound_type": [
                    2
                ],
                "start": 8.605,
                "end": 14.280
            },
            {
                "speaker_id": "1",
                "transcription": "대신 두 달이라는 기간을 정해놨었거든요.",
                "sound_type": [
                    2
                ],
                "start": 14.290,
                "end": 17.688
            },
            {
                "speaker_id": "1",
                "transcription": "가능성이 보이면 계속하고 가능성이 안 보이면 그냥 그때 멈추는 걸로 하자.",
                "sound_type": [
                    2
                ],
                "start": 17.698,
                "end": 22.562
            },
            {
                "speaker_id": "1",
                "transcription": "처음에는 저희가 그 유튜브 기획을 쭉쭉쭉 하다가 뭔가 난관에 봉착을 해요.",
                "sound_type": [
                    2
                ],
                "start": 22.572,
                "end": 27.541
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 우리가 컨트롤할 수 없는 외부 효과가 너무 큰 콘텐츠인 것 같다.",
                "sound_type": [
                    2
                ],
                "start": 27.551,
                "end": 31.480
            },
            {
                "speaker_id": "1",
                "transcription": "제가 그때부터 대환장 방황이 시작이 되는데요.",
                "sound_type": [
                    2
                ],
                "start": 31.490,
                "end": 35.167
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 우리가 어떤 걸 콘텐츠로 해야 될까 고민을 하다가 각자가 잘하는 걸 살려보자 하면서 그때 브랜드가 한 세 개로 나뉘게 돼요.",
                "sound_type": [
                    2
                ],
                "start": 35.177,
                "end": 43.500
            }
        ]
    },
    "summary": "사이드 프로젝트로 한 게 아니라 셋 다 본업이 필요한 상황이라서 대신 두 달이라는 기간을 정해 놓고 했다고 여자가 말하고 있다.",
