        "term": [
            {
                "speaker_id": "1",
                "transcription": "도저히 바람 때문에 안 되겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.561
            },
            {
                "speaker_id": "1",
                "transcription": "낚싯대를 왼쪽으로 좀 틀겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.571,
                "end": 5.777
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 짧은 대를 좀 빼와서요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 5.787,
                "end": 7.629
            },
            {
                "speaker_id": "1",
                "transcription": "저기 갈대 앞에다가 1대 붙이고요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.639,
                "end": 10.956
            },
            {
                "speaker_id": "1",
                "transcription": "맨 우측 사공 칸은 빼겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.966,
                "end": 14.726
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 저기는 수심이 십오육밖에 안 돼요.",
