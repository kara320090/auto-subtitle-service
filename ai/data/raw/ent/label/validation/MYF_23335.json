        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "조이가 멤버들 중 가장 크다며 놀리는 반응도 많다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.612
            },
            {
                "speaker_id": "1",
                "transcription": "혼자 키가 커서 좋은 점은 딱히 느끼지 못하며 멤버에 비해 긴소매 옷을 입을 때 좀 더 소화를 잘하는 것 정도라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.622,
                "end": 9.000
            },
            {
                "speaker_id": "1",
                "transcription": "한 명이라도 키가 비슷한 사람이 있으면 좋을 텐데 키 차이가 많이 나다 보니 뭔가 다른 세계의 사람 같다는 느낌을 받을 때도 있다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.010,
                "end": 16.234
            },
            {
                "speaker_id": "1",
                "transcription": "조이는 운동 신경이 좋은 편인데 볼링을 따로 배운 적도 없고 직전에 잠깐 코치님에게 배운 실력으로 아육대 예선에서 스트라이크와 스페어를 쳤다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.244,
                "end": 24.116
            },
            {
                "speaker_id": "1",
                "transcription": "한 번도 타본 적 없는 전동 휠도 바로 타고 균형도 잘 잡는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.126,
                "end": 27.430
            },
            {
                "speaker_id": "1",
                "transcription": "큰 키 덕분에 중학교 운동회 때는 반강제적으로 농구 반 대표로 나간 적도 있고 초등학교 때는 육상부를 중학교 때는 농구부를 하기도 했다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.440,
                "end": 35.439
            },
            {
                "speaker_id": "1",
                "transcription": "성격 자체도 대담하고 거침 없는 편이라 패러글라이딩, 루지, 짚라인, 산악 오프로드 등도 처음에만 무서워하지 금방 적응하고 즐기는 모습을 자주 보인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.449,
                "end": 44.305
            },
            {
                "speaker_id": "1",
                "transcription": "조이는 체력이 약해 부상을 자주 입는다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.315,
                "end": 46.515
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 무릎 부상으로 인해 러시안 룰렛 활동 기간 중에 무릎에 압박 붕대를 맨 채로 활동하기도 했고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.525,
                "end": 52.218
            }
        ]
    },
    "summary": "조이는 운동 신경이 좋은 편이고 성격 자체도 대담하고 거침 없는 편이라 패러글라이딩, 루지, 짚라인 등도 금방 적응하고 즐기는 모습을 보인다.",
