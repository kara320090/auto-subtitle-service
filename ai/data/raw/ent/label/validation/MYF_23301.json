        "term": [
            {
                "speaker_id": "1",
                "transcription": "드라마 촬영을 스케줄 문제로 불과 3개월 만에 중도 하차하자 대타 DJ를 맡은 것을 기점으로 라디오 진행자 커리어를 시작했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.488
            },
            {
                "speaker_id": "1",
                "transcription": "이후 MBC의 푸른밤 그리고 성시경입니다라는 타이틀로 라디오 DJ를 맡았고 초반에는 인기를 끌지 못했으나 슬슬 팬들이 모이면서 나중에는 청취율 1위로 장기 집권을 이룩했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.498,
                "end": 18.639
            },
            {
                "speaker_id": "1",
                "transcription": "성시경은 군입대와 함께 푸른밤 DJ에서 하차했고 제대 후에는 FM 음악도시의 DJ로 라디오에 컴백했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.649,
                "end": 25.129
            },
            {
                "speaker_id": "1",
                "transcription": "FM 음악도시가 끝나면 곧바로 성시경이 전에 했던 푸른밤이 시작되는데 성시경이 음악도시 첫 방송 때 잘자요 멘트를 하고 끝내자 바로 뒤 푸른밤의 DJ 정엽이 아직 안 자죠라고 대응하기도 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.139,
                "end": 36.780
            },
            {
                "speaker_id": "1",
                "transcription": "성시경은 윤종신과 매우 친분이 깊다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.790,
                "end": 39.189
            },
            {
                "speaker_id": "1",
                "transcription": "윤종신은 성시경 음반 최대 참여자 중 하나이며 성시경의 노래들 중 윤종신이 작곡한 곡들이 대히트를 친 경우가 1 2개가 아니기 때문이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.199,
                "end": 47.404
            },
            {
                "speaker_id": "1",
                "transcription": "음악 말고 예능 관련으로도 윤종신의 영향을 많이 받았다고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.414,
                "end": 50.966
            },
            {
                "speaker_id": "1",
                "transcription": "자기가 평소 정말 진지하게 고민하는 부분이 아니라면 그냥 막 던지는 스타일이 닮았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.976,
                "end": 55.791
            },
            {
                "speaker_id": "1",
                "transcription": "또한 성시경은 윤종신 성대모사도 잘 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.801,
                "end": 58.291
            },
            {
                "speaker_id": "1",
                "transcription": "물론 윤종신이 성대모사하기 쉬운 사람이긴 하지만 성시경은 창법이나 분위기까지 똑같이 따라한다는 게 특징이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.301,
                "end": 64.717
            },
            {
                "speaker_id": "1",
                "transcription": "윤종신 외에도 이문세, 이승환, 신승훈, 윤상, 유희열, 김동률, 이적 등 1990년대에 데뷔한 선배 뮤지선들과 친분이 상당하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.727,
                "end": 73.191
            },
            {
                "speaker_id": "1",
                "transcription": "성시경은 어렸을 때 홍콩에서 지냈던 적은 있으나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.201,
                "end": 76.142
            }
        ]
    },
    "summary": "화자가 성시경이 라디오 진행자를 시작하게 된 계기와 청취율 1위로 장기 집권을 했던것 그리고 데뷔 초부터 윤종신과의 친분으로 받은 영향들까지 이야기하고 있다.",
