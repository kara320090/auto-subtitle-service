        "term": [
            {
                "speaker_id": "1",
                "transcription": "옥수수는 빼놓긴 했는데 아직 사용하지는 않고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.916
            },
            {
                "speaker_id": "1",
                "transcription": "시간상 목표했던 다섯 마리는 좀 힘들 것 같고요.",
                "sound_type": [
                    2
                ],
                "start": 4.926,
                "end": 9.569
            },
            {
                "speaker_id": "1",
                "transcription": "두 마리만 더 나와서 세 마리만 좀 잡고 갔으면 좋겠네요.",
                "sound_type": [
                    2
                ],
                "start": 9.579,
                "end": 14.197
            },
            {
                "speaker_id": "1",
                "transcription": "그 중에 한 마리는 좀 월척 이상 급이었으면 좋겠고요.",
                "sound_type": [
                    2
                ],
                "start": 14.207,
                "end": 17.208
            },
            {
                "speaker_id": "1",
                "transcription": "44칸 입질 간다 간다 간다",
                "sound_type": [
                    2
                ],
                "start": 17.218,
                "end": 36.920
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지 와 이녀석은 씨알 좀 된다.",
