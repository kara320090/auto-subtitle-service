            },
            {
                "speaker_id": "1",
                "transcription": "내려가 볼까요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 5.484,
                "end": 6.209
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 보시면은 얼추 얼추 이제 물 튕겨 나가는 부분 보이시죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.219,
                "end": 18.032
            },
            {
                "speaker_id": "2",
                "transcription": "아 아 무슨 말인지 알겠다. 아 이제 이해했어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.042,
                "end": 23.183
            },
            {
                "speaker_id": "1",
                "transcription": "이해할려면 좀 오래 걸려요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.193,
                "end": 24.604
            },
            {
                "speaker_id": "2",
                "transcription": "아니 저는 지금 요 바닥을 보고 있었거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.614,
                "end": 27.683
            },
            {
                "speaker_id": "2",
                "transcription": "바닥에 뭔가 있다고 해서 이 바닥을 열심히 보고 있었는데 그게 아니라 아 그럼 요쪽 각도에서 봐야겠네요. 요쪽 각도에서",
