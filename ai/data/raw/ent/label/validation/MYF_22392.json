        "term": [
            {
                "speaker_id": "1",
                "transcription": "한번 내 흑역사 썰 풀어볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.676
            },
            {
                "speaker_id": "1",
                "transcription": "바야흐로 갓 졸업한 20살이 되던 해",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.686,
                "end": 10.113
            },
            {
                "speaker_id": "1",
                "transcription": "아마 약간 기억이 조금 희미한데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.123,
                "end": 15.883
            },
            {
                "speaker_id": "1",
                "transcription": "졸업식 그때쯤이었을 거야 이제 20살 내가 딱 학교 19살 고등학교를 졸업하고 20살이 돼서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.893,
                "end": 24.578
            },
            {
                "speaker_id": "1",
                "transcription": "술집에 갈 수 있는 그 나이 있잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.588,
                "end": 27.631
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그때는 코로나고 뭐고 없잖아 그냥 친구들끼리 다 모여 가지고 술집에 가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.641,
                "end": 32.676
            },
            {
                "speaker_id": "1",
                "transcription": "술집에 가 가지고 이제 그때 당시만 해도 그런 술이 되게 유행했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.686,
                "end": 37.319
            },
            {
                "speaker_id": "1",
                "transcription": "과일소주 있지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.329,
                "end": 38.915
            },
            {
                "speaker_id": "1",
                "transcription": "청포도에 이슬, 자몽에 이슬, 사과에 이슬 뭐 그런 거 엄청 있잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.925,
                "end": 45.698
            },
            {
                "speaker_id": "1",
                "transcription": "석류에 이슬 막 그런 게 다 있단 말야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.708,
                "end": 50.000
            }
        ]
    },
    "summary": "여자가 주거 공간에서 음식을 앞에 두고 시청자와 흑역사에 대해 이야기하고 있다.",
