        "term": [
            {
                "speaker_id": "1",
                "transcription": "좋고 말고 여기 뭐뭐",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.885
            },
            {
                "speaker_id": "1",
                "transcription": "요땅인데 요땅. 바로 요 밑에꺼.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.895,
                "end": 4.478
            },
            {
                "speaker_id": "2",
                "transcription": "요거 아우 너무 좋은 데요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.488,
                "end": 5.371
            },
            {
                "speaker_id": "1",
                "transcription": "포도 나무 많은 거.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.381,
                "end": 7.406
            },
            {
                "speaker_id": "3",
                "transcription": "너무 좋다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 7.416,
                "end": 8.536
            },
            {
                "speaker_id": "1",
                "transcription": "1000평이라나 뭐 근데 거기는 물이 조금나 한쪽에",
                "sound_type": [
                    2,
                    4
                ],
                "start": 8.546,
                "end": 11.890
            },
            {
                "speaker_id": "4",
                "transcription": "아 물이 쫌 나고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 11.900,
                "end": 13.387
            },
            {
                "speaker_id": "1",
                "transcription": "물 조금 나는 거야 한 쪽이니까 그건 소당 치면 되고",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.397,
                "end": 16.754
            },
            {
                "speaker_id": "4",
                "transcription": "우리 형님이 또 물 나는 거 싫어하시잖아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 16.764,
                "end": 19.374
            },
            {
                "speaker_id": "1",
                "transcription": "아이 그 물이 나오면 안되지 집이. 집까지는 안 되고 그런 거 피해서 해야지.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 19.384,
                "end": 24.467
            },
            {
                "speaker_id": "4",
                "transcription": "아 저기 물 이제 많이 흐른다 저기.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.477,
                "end": 27.142
            },
            {
                "speaker_id": "2",
                "transcription": "너무 예쁘다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.152,
                "end": 28.086
            },
            {
                "speaker_id": "1",
                "transcription": "저기 이렇게 건너가면 되는데",
                "sound_type": [
                    2,
                    4
                ],
                "start": 28.096,
                "end": 29.305
            },
            {
                "speaker_id": "4",
                "transcription": "네 그러 그러니까",
                "sound_type": [
                    2,
                    4
                ],
                "start": 29.315,
                "end": 31.833
            }
        ]
    },
    "summary": "1000평이라는데 한쪽에 물이 조금 나고 저기 이렇게 건너가면 된다.",
