        "term": [
            {
                "speaker_id": "1",
                "transcription": "한 줄 평, 맛 평가, 한 줄 평 생각 좀 해볼 테니까 이따가 좀 끝날 때쯤 얘기해 볼까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.314
            },
            {
                "speaker_id": "2",
                "transcription": "약간 갈비찜, 갈비찜 같아 갈비찜.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.324,
                "end": 10.687
            },
            {
                "speaker_id": "1",
                "transcription": "나 원래 고기 안 좋아하는데 맛있네 이건.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.697,
                "end": 13.484
            },
            {
                "speaker_id": "1",
                "transcription": "이번 요리 좀 망했다고 그랬는데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.494,
                "end": 16.077
            },
            {
                "speaker_id": "2",
                "transcription": "아닌데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.087,
                "end": 16.784
            },
            {
                "speaker_id": "1",
                "transcription": "주워 먹을 게 없네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.794,
                "end": 18.176
            },
            {
                "speaker_id": "2",
                "transcription": "형님 이거 한 번 더 해주시면 안 됩니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.186,
                "end": 20.005
            },
            {
                "speaker_id": "1",
                "transcription": "왜 이렇게 원하는 게 많아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.015,
                "end": 21.420
            },
            {
                "speaker_id": "1",
                "transcription": "감사히 먹어요. 그냥.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.430,
                "end": 23.052
            },
            {
                "speaker_id": "2",
                "transcription": "감사히 맛있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.050,
                "end": 23.944
            },
            {
                "speaker_id": "1",
                "transcription": "오빠는 우리 오빠한테 음식 해 준 적 있어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.954,
                "end": 26.924
            },
            {
                "speaker_id": "2",
                "transcription": "형님한테?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.934,
                "end": 27.415
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.412,
                "end": 28.192
            },
            {
                "speaker_id": "2",
                "transcription": "형님 뭐 해드릴까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.200,
                "end": 29.061
            },
            {
                "speaker_id": "1",
                "transcription": "해 준 것도 없으면서 왜 이렇게 바라는 게 많아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.071,
                "end": 31.931
            }
        ]
    },
    "summary": "고기가 맛있어서 형님에게 한번 더 해달라고 요청하고 있다.",
