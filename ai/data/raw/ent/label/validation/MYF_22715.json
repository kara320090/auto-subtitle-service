    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래도 뭐 자대 배치받고 나서는 뭐 만발 쐈으니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.460
            },
            {
                "speaker_id": "1",
                "transcription": "혹시 신교대 조교가 사격 설명 해줄 때 가소롭다고 느끼셨나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.472,
                "end": 5.335
            },
            {
                "speaker_id": "1",
                "transcription": "어 네 뭐 그건 잘 모르겠고 뭐 무섭더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.345,
                "end": 8.340
            },
            {
                "speaker_id": "1",
                "transcription": "군 복무기간 동안 영상 올리셨던데 불법 아닌가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.352,
                "end": 10.702
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 제가 꼭 설명 해주고 싶었던 건데 군인은 대외 활동을 하는 데 법적으로 문제가 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.715,
                "end": 15.635
            },
            {
                "speaker_id": "1",
                "transcription": "단 군 혹은 정치와 관련이 없고 영리 목적이 아니어야지만 가능해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.647,
                "end": 20.987
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 뭐 유튜브랑 에스엔에스랑 같다고 생각하시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.998,
                "end": 23.470
            },
            {
                "speaker_id": "1",
                "transcription": "아니 근데 무슨 신고를 엄청 하셨더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.480,
                "end": 25.730
            },
            {
                "speaker_id": "1",
                "transcription": "그거 헌병대에서 조사받고 무혐의 입증하느라 뭐 며칠 개꿀 빨긴 했",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.740,
                "end": 29.833
            }
        ]
    },
    "summary": "남자 유튜버는 자대 배치받고 만발 쐈다고 하고 신교대 조교의 사격 설명이 가소롭다고 느꼈냐는 질문에 그저 무서웠다고 답했으며 군 복무기간 중 영상을 올리는 것이 불법이 아닌지 묻는 질문엔 군인은 유튜브나 에스엔에스와 같이 군 혹은 정치와 관련이 없고 영리 목적이 아니면 대외 활동을 하는데 법적인 문제가 없으나 신고를 많이 해서 헌병대에서 조사받고 무혐의 입증하는 데 며칠 소요돼 편했다고 답했다.",
