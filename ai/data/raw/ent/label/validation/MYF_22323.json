                ],
                "start": 0.000,
                "end": 4.151
            },
            {
                "speaker_id": "1",
                "transcription": "우리 허니들 히미입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.161,
                "end": 5.846
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 제가 정말 정말 너무 찍고 싶었던 뿌링클 먹빵이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.856,
                "end": 11.502
            },
            {
                "speaker_id": "1",
                "transcription": "뿌링 치즈볼하고 닭다리만 있는 세트로 한 번 오늘 먹어 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.512,
                "end": 17.833
            },
            {
                "speaker_id": "1",
                "transcription": "저는 치즈볼을 먼저 먹어볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.843,
                "end": 21.153
            },
            {
                "speaker_id": "1",
                "transcription": "음 안에 치즈가 꽉 차있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.163,
                "end": 34.471
            },
            {
                "speaker_id": "1",
                "transcription": "음 맛있어.",
