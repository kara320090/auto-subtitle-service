        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와 야 야 붕어 예쁜데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 23.406
            },
            {
                "speaker_id": "1",
                "transcription": "자 보셨 보이실랑가 모르겠는데 봉돌 끝까지 내려가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.416,
                "end": 30.684
            },
            {
                "speaker_id": "1",
                "transcription": "오 오 미끄럽네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 30.694,
                "end": 36.254
            },
            {
                "speaker_id": "1",
                "transcription": "크기는 여덟 치네 여덟 치 오늘 대박 가나요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 36.264,
                "end": 42.304
            },
            {
                "speaker_id": "1",
                "transcription": "지금 지렁이 3대 옥수수 2대 사용하고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 42.314,
                "end": 46.556
            },
            {
                "speaker_id": "1",
                "transcription": "아 첫 수는 사팔 칸에서 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 46.566,
                "end": 49.924
            },
            {
                "speaker_id": "1",
                "transcription": "지금 어 어 미안하다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.934,
                "end": 54.363
            },
            {
                "speaker_id": "1",
                "transcription": "미안하다.",
                "sound_type": [
                    2
                ],
                "start": 54.373,
                "end": 57.558
            },
            {
                "speaker_id": "1",
                "transcription": "첫 수가 괜찮은 것이 나왔어요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 57.568,
                "end": 60.921
            },
            {
                "speaker_id": "1",
                "transcription": "아홉 치는 조금 안 될 것 같고 어이구 야 또 파고 들어 가냐 자 가라 일단 모험의 시작은 괜찮습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 60.931,
                "end": 71.019
            },
            {
                "speaker_id": "1",
                "transcription": "지금 수심이 굉장히 낮음에도 불구하고 바닥이 굉장히 지저분합니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 71.029,
                "end": 74.860
            }
        ]
    },
    "summary": "봉돌 끝까지 내려가 있고 크기는 여덟 치인 것 같고 지렁이 3대 옥수수 2대 사용하고 있는데 첫 수는 사팔 칸에서 나왔고 모험의 시작은 괜찮은 것 같다.",
