                    2,
                    3
                ],
                "start": 5.997,
                "end": 7.285
            },
            {
                "speaker_id": "1",
                "transcription": "전국 최저가인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.295,
                "end": 9.230
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 최저가인 건 확실해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.240,
                "end": 11.070
            },
            {
                "speaker_id": "1",
                "transcription": "서울에서 가장 넓은 사설 사격장에서 스포츠 사격을 부담 없이 배워 보시라고 진짜 허리끈 바짝 졸라매고 책정했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.080,
                "end": 17.832
            },
            {
                "speaker_id": "1",
                "transcription": "이게 차후에 어떻게 될진 모르지만 일단은 이 금액으로 최대한 유지해서 운영을 해볼라고 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.840,
                "end": 22.585
            },
            {
                "speaker_id": "1",
                "transcription": "총을 좋아하시는 여러분 사격장에서 기다리고 있겠습니다.",
