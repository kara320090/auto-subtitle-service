                "start": 0.000,
                "end": 1.752
            },
            {
                "speaker_id": "1",
                "transcription": "이 사격 레슨 32만 원이란 게 진짜 저렴한 게 현재 서울에서 최저가예요.",
                "sound_type": [
                    2,
                    3
