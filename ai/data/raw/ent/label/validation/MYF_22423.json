                "age": "20대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "나 솔직히 요즘에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.439
            },
            {
                "speaker_id": "1",
                "transcription": "아까 앞에서 말했다시피 편집도 하는 데 오래 걸리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.449,
                "end": 6.045
            },
            {
                "speaker_id": "1",
                "transcription": "일도 알바도 하고 이래저래 바빠서 영상 올리는 주기가 살짝 늦어졌잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.055,
                "end": 11.338
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 유튜버 유튜버로서 유튜브에서는 소식을 그렇게 자주 전하진 못하지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.348,
                "end": 20.147
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 나름 인스타에서는 사진도 올리고 스토리도 올리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.157,
                "end": 23.687
            },
            {
                "speaker_id": "1",
                "transcription": "나름 많이 좀 활동을 보여줄 수가 있거든 그러니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.697,
                "end": 28.826
            },
            {
                "speaker_id": "1",
                "transcription": "우리 나에 대해서 좀 더 궁금한 우리 허니는 내 인스타로 좀 더 놀러 와 줬으면 좋겠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.836,
                "end": 35.634
            },
            {
                "speaker_id": "1",
                "transcription": "인스타로 오면 약간 좀 더 나랑 한 단계 더 친해질 수 있다고 해야 되나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.644,
                "end": 42.318
            },
            {
                "speaker_id": "1",
                "transcription": "인스타로 또 놀러 와 주면 좋겠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.328,
                "end": 44.822
            },
            {
                "speaker_id": "1",
                "transcription": "클리어 클리어 없어 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.832,
                "end": 54.424
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 짠 하고 안주 요기 조금 남았거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.434,
                "end": 59.658
            },
            {
                "speaker_id": "1",
                "transcription": "이거 마지막으로 하고 이제 우리는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.668,
                "end": 62.765
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 정말 수다 많이 많이 떤 홈파티를 끝내보도록 할게요. 짠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.775,
                "end": 70.333
            }
        ]
    },
    "summary": "여자가 실내에서 유튜브를 통해 시청자들과 막바지 소통을 하고 있다.",
