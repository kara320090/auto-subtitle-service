        "term": [
            {
                "speaker_id": "1",
                "transcription": "김구라는 방송에서 자주 게스트에게 삿대질을 해 많은 비판을 받는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.214
            },
            {
                "speaker_id": "1",
                "transcription": "자기보다 어린 사람을 물론이고 고령이거나 선배들에게도 가리지 않고 삿대질을 일삼는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.224,
                "end": 7.317
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 삿대질은 상대에게 손가락 따위를 내지르는 적대적 행위다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.327,
                "end": 10.621
            },
            {
                "speaker_id": "1",
                "transcription": "가수 이승환은 라디오 스타에서 김구라에게 형님이라면서 이렇게 삿대질을 하냐 하며 정색한 적이 있고 박수홍 또한 삿대질 좀 그만하라고 불편해했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.631,
                "end": 17.327
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 김구라의 모친도 방송에서 삿대질 좀 그만해라라고 잔소리를 했을 정도라고 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.337,
                "end": 21.290
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 정작 남이 자신에게 삿대질을 하면 화를 내는 이중적 모습을 보이기도 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.300,
                "end": 25.325
            }
        ]
    },
    "summary": "김구라는 방송에서 삿대질을 해 많은 비판을 받지만 남이 자신에게 삿대질을 하면 화를 내는 이중적 모습을 보인다.",
