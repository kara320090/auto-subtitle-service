        "term": [
            {
                "speaker_id": "1",
                "transcription": "했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.377
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 그때 시간 잘 가더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.387,
                "end": 1.980
            },
            {
                "speaker_id": "1",
                "transcription": "올림픽 금메달 따면 군 면제 아니에요? 근데 왜 군대 가셨어요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.989,
                "end": 5.232
            },
            {
                "speaker_id": "1",
                "transcription": "아니 뭐 제가 올림픽 금메달을 딴 적이 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.245,
                "end": 8.903
            },
            {
                "speaker_id": "1",
                "transcription": "제가 가진 국제대회나 전국대회 메달이 궁금하신 분들은 뭐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.913,
                "end": 13.391
            },
            {
                "speaker_id": "1",
                "transcription": "여긴가? 아 여기구나 여기.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.401,
                "end": 16.508
            },
            {
                "speaker_id": "1",
                "transcription": "여기 눌러서 조회수 좀 올려주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.518,
                "end": 19.047
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 영상이 마음에 들면 뭐 여기 아래 구독이라는 게 있는데 어 뭐 그냥 있다고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.057,
                "end": 24.555
            },
            {
                "speaker_id": "1",
                "transcription": "구독은 뭐 알아서 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.567,
                "end": 25.900
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 어차피 제가 하란다고 할 거 아니니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.912,
                "end": 27.644
            },
            {
                "speaker_id": "1",
                "transcription": "유디티랑 싸우면 누가 이겨요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.654,
                "end": 29.679
            },
            {
                "speaker_id": "1",
                "transcription": "싸우면이 아니라 사격하면 아닌가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.689,
                "end": 33.358
            },
            {
                "speaker_id": "1",
                "transcription": "하 글쎄요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.368,
                "end": 34.416
            }
        ]
    },
    "summary": "남자 유튜버는 올림픽 금메달 따면 군 면제인데 군대를 간 이유를 묻는 질문에 올림픽 금메달은 딴 적이 없고 국제대회나 전국대회 메달이 궁금하면 조회수를 올리거나 구독이라는 게 있는데 구독은 시청자의 몫이라고 답했고 유디티랑 싸우면 누가 이기는지에 대한 질문엔 싸우면이 아닌 사격하면이 맞지 않는지 되묻고 있다.",
