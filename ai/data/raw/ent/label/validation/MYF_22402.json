        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그때 아마 내가 택시 뒤를 막 그렇게 해 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.086
            },
            {
                "speaker_id": "1",
                "transcription": "15만 원인가 변상해 드렸어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.096,
                "end": 10.158
            },
            {
                "speaker_id": "1",
                "transcription": "술 취한 모습 엄마한테 보여주는 게 진짜 흑역사지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.168,
                "end": 16.090
            },
            {
                "speaker_id": "1",
                "transcription": "으이구",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.100,
                "end": 19.176
            },
            {
                "speaker_id": "1",
                "transcription": "2월 또 이제 영상을 편집하면서 빨리 올리고 싶은데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.186,
                "end": 24.929
            },
            {
                "speaker_id": "1",
                "transcription": "제가 아니 내가 또 자칫 존댓말 할뻔했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.939,
                "end": 29.471
            },
            {
                "speaker_id": "1",
                "transcription": "내가 또 이제 알바를 하고 있다고 했잖아 알바",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.481,
                "end": 33.306
            },
            {
                "speaker_id": "1",
                "transcription": "알바를 하기 때문에 끝나고 오면 너무 힘들어 가지고 편집을 막 오래 못해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.316,
                "end": 38.898
            },
            {
                "speaker_id": "1",
                "transcription": "예전에는 하루에 한번 시작하면 막 6시간 8시간 쭉 앉아서 했는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.908,
                "end": 44.676
            },
            {
                "speaker_id": "1",
                "transcription": "요즘에는 그럴 체력이 안 되더라고 그래서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.686,
                "end": 48.054
            },
            {
                "speaker_id": "1",
                "transcription": "하루에 한 두세 시간만 하고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.064,
                "end": 50.681
            },
            {
                "speaker_id": "1",
                "transcription": "멈추고 다음 날 이어서 하고 요런 식으로 해서 요즘에 편집이 조금 늦어지고 있는 편이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.691,
                "end": 56.873
            },
            {
                "speaker_id": "1",
                "transcription": "다들 영상 자주 올리고 나도 진짜 찍고 싶은 영상도 많고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.883,
                "end": 61.393
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 편집에서 약간 좀 오래 걸리는 점이 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.403,
                "end": 64.941
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 요즘에 좀 편집에 공을 들이고 있거든.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.951,
                "end": 69.083
            }
        ]
    },
    "summary": "여자가 주거 공간에서 음식을 먹으며 유튜브 편집에 대해 이야기하고 있다.",
