    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "저희 엄마가 제 채널 맨날 보신대요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.425
            },
            {
                "speaker_id": "1",
                "transcription": "이제 구독자가 한 명씩 느는지 궁금해가지고 그렇습니다 이렇게 댓글도 저희 엄마가 달아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.435,
                "end": 7.742
            },
            {
                "speaker_id": "1",
                "transcription": "내년에는 좀 채널이 좀 떡상해 가지고 효도할 수 있는 그런 일이 있었으면 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.752,
                "end": 11.901
            },
            {
                "speaker_id": "1",
                "transcription": "@계정1 님 어 피부 표현 어떻게 했나요? 너무 예뻐 보여요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.911,
                "end": 16.332
            },
            {
                "speaker_id": "1",
                "transcription": "아 이렇게 또 피부 표현 이런 얘기하시는 분들이 많아서 이제 기초 제품을 설명을 드렸는데 메이크업이 궁금하신 분들도 있는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.342,
                "end": 25.247
            },
            {
                "speaker_id": "1",
                "transcription": "다음번에는 메이크업 영상으로 찾아뵙도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.257,
                "end": 28.155
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음 @계정2 님.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.165,
                "end": 30.078
            },
            {
                "speaker_id": "1",
                "transcription": "아 @계정2 님도 저의 되게 오래된 구독자님이신데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.088,
                "end": 33.573
            },
            {
                "speaker_id": "1",
                "transcription": "항상 이제 댓글로 응원해 주시는 되게 감사한 분입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.583,
                "end": 36.878
            },
            {
                "speaker_id": "1",
                "transcription": "저 구독자 3천 명 쉽지 않은데 너무 축하드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.888,
                "end": 39.929
            },
            {
                "speaker_id": "1",
                "transcription": "협찬 앞으로도 빵빵하게 많이 받으시길 모든 사람들 슬프고 어려웠던 일 훌훌 털고 내년에는 더 좋은 일들만 생기길 그리고 현실 언니와 함께 더 많이 성장하길",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.939,
                "end": 50.371
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 마음이 너무 예쁘신 분인 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.381,
                "end": 52.365
            },
            {
                "speaker_id": "1",
                "transcription": "새해에도 좋은 콘텐츠 많이 기대할게요 하트.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.375,
                "end": 55.906
            },
            {
                "speaker_id": "1",
                "transcription": "아 이렇게 보내주셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.916,
                "end": 57.684
            },
            {
                "speaker_id": "1",
                "transcription": "제가 너무 굉장히 막 마음이 따듯해서 제가 막 표정이 되게 밝아졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.694,
                "end": 62.502
            },
            {
                "speaker_id": "1",
                "transcription": "이 @계정2 님의 이 응원 댓글에서도 후끈후끈하고 따듯함이 이렇게 저도 느껴져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.512,
                "end": 67.943
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 @계정2 님 너무 감사드리고 감사한 마음을 담아서 스타벅스 커피 쿠폰 보내드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.953,
                "end": 74.766
            }
        ]
    },
    "summary": "화자는 댓글 이벤트 중인데 오래된 구독자분이 남긴 댓글을 보고 마음이 따뜻해지고 기분이 좋아진다고 말하고 선물을 보낸다고 하는 상황이다.",
