        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 햇살 눈부셔.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.038
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 비가 안 오는구나 그렇다면 고독한 세차.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.048,
                "end": 7.482
            },
            {
                "speaker_id": "1",
                "transcription": "자 고독한 세차 시작해볼까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.492,
                "end": 11.096
            },
            {
                "speaker_id": "1",
                "transcription": "음 물론 오늘 복장이 좀 이상합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.106,
                "end": 14.833
            },
            {
                "speaker_id": "1",
                "transcription": "일 끝나고 바로 와서 그래요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.843,
                "end": 17.175
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 키즈카페 촬영을 했는데 어 유아용 미끄럼틀만 10번 탔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.185,
                "end": 22.928
            },
            {
                "speaker_id": "1",
                "transcription": "한번 더.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.938,
                "end": 24.083
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 지금부터는 힐링의 시간.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.093,
                "end": 27.294
            },
            {
                "speaker_id": "1",
                "transcription": "치열함을 벗고 세차 복장으로 변신해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.304,
                "end": 31.898
            }
        ]
    },
    "summary": "일 끝나고 바로 와서 복장이 좀 이상하고 키즈카페 촬영을 하던 중 유아용 미끄럼틀만 10번 탔으며 지금부터는 세차 복장으로 변신한다고 말한다.",
