        "term": [
            {
                "speaker_id": "1",
                "transcription": "역시 엄마표 요리가 최고.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.775
            },
            {
                "speaker_id": "1",
                "transcription": "뭐, 뭐 만들었어요, 오늘?",
                "sound_type": [
                    2
                ],
                "start": 2.785,
                "end": 4.766
            },
            {
                "speaker_id": "2",
                "transcription": "오늘 곤약 넣어서 칼로리 적은 떡볶이하고 이거는 지금 밭에서 부추하고 달래가 한참 잘 자라서 밭에서 부추, 달래에 청양고추, 버섯 이런 거 해서.",
                "sound_type": [
                    2
                ],
                "start": 4.776,
                "end": 22.568
            },
            {
                "speaker_id": "1",
                "transcription": "밭에서 딴 부추.",
                "sound_type": [
                    2
                ],
                "start": 22.578,
                "end": 24.141
            },
            {
                "speaker_id": "2",
                "transcription": "달래.",
                "sound_type": [
                    2
                ],
                "start": 24.151,
                "end": 24.634
            },
            {
                "speaker_id": "1",
                "transcription": "달래.",
                "sound_type": [
                    2
                ],
                "start": 24.644,
                "end": 25.689
            },
            {
                "speaker_id": "1",
                "transcription": "뭘 자꾸 달래.",
                "sound_type": [
                    2
                ],
                "start": 25.699,
                "end": 28.157
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 닭볶음탕 했고 감자하고.",
                "sound_type": [
                    2
                ],
                "start": 28.167,
                "end": 31.452
            },
            {
                "speaker_id": "1",
                "transcription": "닭 잡았나요?",
                "sound_type": [
                    2
                ],
                "start": 31.462,
                "end": 32.662
            },
            {
                "speaker_id": "2",
                "transcription": "감자하고 닭고기하고.",
                "sound_type": [
                    2
                ],
                "start": 32.672,
                "end": 33.968
            },
            {
                "speaker_id": "1",
                "transcription": "이게 지금 우리 촬영 오시는 구독자님 용 1인분 상이에요, 여러분.",
                "sound_type": [
                    2
                ],
                "start": 33.978,
                "end": 38.216
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나죠.",
                "sound_type": [
                    2
                ],
                "start": 38.226,
                "end": 40.022
            },
            {
                "speaker_id": "1",
                "transcription": "시골에 오면 좀 많이 먹어야 해요.",
                "sound_type": [
                    2
                ],
                "start": 40.032,
                "end": 41.901
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저는 주말 촬영 올 때마다 다이어트를 포기합니다.",
                "sound_type": [
                    2
                ],
                "start": 41.911,
                "end": 45.479
            },
            {
                "speaker_id": "2",
                "transcription": "칼로리 낮은 걸로만 했어.",
                "sound_type": [
                    2
                ],
                "start": 45.489,
                "end": 48.752
            },
            {
                "speaker_id": "1",
                "transcription": "엄마, 칼로리 낮은 게 모이면 높아.",
                "sound_type": [
                    2
