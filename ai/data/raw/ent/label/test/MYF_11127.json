        "term": [
            {
                "speaker_id": "1",
                "transcription": "고무 파킹이 이렇게 예 아주 촘촘하게 잘 돼 있는 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.683
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뭐 냉기가 샐 일은 별로 없을 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.693,
                "end": 9.260
            },
            {
                "speaker_id": "1",
                "transcription": "이쪽에 보시게 되면 이렇게 컨트롤 패널이 아주 직관적으로 볼 수 있게 간단하게 되어있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.270,
                "end": 14.581
            },
            {
                "speaker_id": "1",
                "transcription": "파워하고 이제 뭐 온도 조절하고 이제 모드 설정하는 그거 딱 그렇게 4가지로 변했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.591,
                "end": 20.570
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 보시면 되면 이렇게 또 손잡이가 여기 좀 튀어 나와있어 가지고 조금 불편할 것 같기도 한데 그래도 많이 불편할 것 같지는 않고 아무튼 그렇게 돼 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.580,
                "end": 29.670
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 편 굉장히 튼튼한 구조로 돼 있긴 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.680,
                "end": 33.349
            },
            {
                "speaker_id": "1",
                "transcription": "그 외관을 보시면 이게 지금 뭐",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.359,
                "end": 36.169
