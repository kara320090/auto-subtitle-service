        "term": [
            {
                "speaker_id": "1",
                "transcription": "사십일 점 삼 도가 됐는데 이게 저도 당근을 사실은 와이프 때문에 뭐 육아용품 사고 아니면 다른 필요한 거 산다고 많이 했는데 아마 남자분은 공감하실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 11.960
            },
            {
                "speaker_id": "1",
                "transcription": "보통 당근이세요라고 물어보고 아 네 당근이에요.",
                "sound_type": [
                    2
                ],
                "start": 11.970,
                "end": 15.223
            },
            {
                "speaker_id": "1",
                "transcription": "이러고 하고 이제 저 근데 물건이 뭐예요?",
