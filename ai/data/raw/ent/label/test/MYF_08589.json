        "term": [
            {
                "speaker_id": "1",
                "transcription": "노랑이 꿀떡 잘 먹었어? 잘했어 우리 노랑이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.604
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 큰 아기들은 알약을 잘 먹을 수 있지만 아기 고양이들은 어떨까요?",
                "sound_type": [
