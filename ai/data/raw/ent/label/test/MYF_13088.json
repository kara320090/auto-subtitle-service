        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리 아기들 아침은 이렇게 소란스럽게 시작되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.420
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 아고 방울이가 솔이한테 뭐라고 뭐라 하는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.430,
                "end": 14.294
            },
            {
                "speaker_id": "1",
                "transcription": "하지 말라니까 그만두라니까 이 녀석 언니 말을 안 들어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.304,
                "end": 20.414
            },
            {
                "speaker_id": "1",
                "transcription": "솔이는 여잔데 꼭 터프하기가 꼭 남자 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.424,
                "end": 24.192
            },
            {
                "speaker_id": "1",
                "transcription": "이유식 먹는 스타일도 그렇고 우와 너 지금 솔이 방울이한테 팡팡한 거야 팡팡한 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.202,
                "end": 33.952
            },
            {
                "speaker_id": "1",
                "transcription": "응 우리 아깽이들의 아침이 시작되고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.962,
                "end": 41.941
            }
        ]
    },
    "summary": "아기들 아침은 소란스럽게 시작되며 솔이는 여자인데 터프한 게 꼭 남자 같다.",
