        "term": [
            {
                "speaker_id": "1",
                "transcription": "그니까요. 어 허리는 안 될 것 같고 월척 살짝 넘었는데 아까 계속 자라가 나오던 초강 몬스터 48칸 글루텐에 붕어가 앞에까지 왔는데 빠져버렸습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 11.768
            },
            {
                "speaker_id": "1",
                "transcription": "월척은 넘어 보였는데 제 우측 정면에서 이제 해가 떠오를 것 같은데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 11.778,
                "end": 17.628
            },
            {
                "speaker_id": "1",
                "transcription": "집중해서 붕어 기다려 보겠습니다. 방금 입질받았던 그 48칸 이 자리는 바닥이 지저분해서 조금만 옆으로 던져도 6초에 걸리고 찌 높이가 달라지고 하는 자리거든요.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 17.638,
                "end": 32.940
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 다른 대보다 더 많은 투척을 했는데 글루텐이 많이 쌓여서 집어가 된 게 아닌가 싶습니다.",
                "sound_type": [
                    1,
