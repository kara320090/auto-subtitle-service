                    2,
                    3
                ],
                "start": 1.420,
                "end": 2.204
            },
            {
                "speaker_id": "1",
                "transcription": "아빠가 안고 올라가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.214,
                "end": 3.141
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 끌게 알았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.151,
                "end": 4.082
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 얼마나 올라가야 되는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.092,
                "end": 5.904
            },
            {
                "speaker_id": "1",
                "transcription": "계단 이거 엘레베이터가 없어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.914,
                "end": 7.544
            },
            {
                "speaker_id": "1",
                "transcription": "이 계단도 제주도에서 봤던 계단인데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.554,
                "end": 11.172
            },
            {
                "speaker_id": "1",
                "transcription": "와 제주도에 있는 그 계단이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.182,
                "end": 12.613
            },
            {
                "speaker_id": "1",
                "transcription": "위험한 거 아냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.623,
                "end": 13.940
            },
            {
                "speaker_id": "1",
                "transcription": "자기야 애기 잘 잡아야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.950,
                "end": 15.313
            },
            {
                "speaker_id": "1",
                "transcription": "별내에는 제주도에 있는 것들을 많이 가져다 놨더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.323,
                "end": 19.159
            },
            {
                "speaker_id": "1",
                "transcription": "불암산 밑자락에 와",
