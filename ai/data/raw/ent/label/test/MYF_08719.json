                    2,
                    3
                ],
                "start": 47.165,
                "end": 48.810
            },
            {
                "speaker_id": "2",
                "transcription": "차갑기도 하고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.820,
                "end": 55.149
            },
            {
                "speaker_id": "2",
                "transcription": "꼼아 아이고 미안해 벤다 밑에 있었어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.159,
                "end": 67.895
            },
            {
                "speaker_id": "2",
                "transcription": "꼼아 몸에 물이 묻지 응?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.905,
                "end": 75.309
            },
            {
                "speaker_id": "2",
                "transcription": "유채 유채는 가습기 처음보지?",
