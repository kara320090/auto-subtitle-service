            },
            {
                "speaker_id": "2",
                "transcription": "가습기에 물방울들이 어디로 가는지 궁금하구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.345,
                "end": 32.758
            },
            {
                "speaker_id": "2",
                "transcription": "어디가지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.768,
                "end": 34.586
            },
            {
                "speaker_id": "2",
                "transcription": "시원한 물방울들이 날아가네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.596,
                "end": 41.221
            },
            {
                "speaker_id": "2",
                "transcription": "유채야 눈에 보여?",
