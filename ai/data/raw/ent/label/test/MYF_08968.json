        "term": [
            {
                "speaker_id": "1",
                "transcription": "츠 저번에 우리 그 황룡강 정출한 데 가는 길에 왼쪽에 있는 거 그거 봤 우와 저거 뭐야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.136
            },
            {
                "speaker_id": "1",
                "transcription": "붕어인데.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.146,
                "end": 5.921
            },
            {
                "speaker_id": "2",
                "transcription": "했는데 나는 수닥과 재밌거든 솔직히.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.931,
                "end": 8.469
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 저는 그 광고 유료 광고 있음 그것만 하고선 그냥 냅둬 버리거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.479,
                "end": 13.663
            },
            {
                "speaker_id": "2",
                "transcription": "중간에 삽임 안 해 일부러?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.673,
                "end": 14.845
            },
            {
                "speaker_id": "1",
                "transcription": "저는 그냥 그거 광고 넣을 거냐 안 넣을 거냐 그거 할 수 있잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.855,
                "end": 18.970
            },
            {
                "speaker_id": "1",
                "transcription": "그냥",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.980,
                "end": 19.850
            },
            {
                "speaker_id": "2",
                "transcription": "중간 거하고 14분에 중간에 하나 넣어. 안 그러면 2분마다 나오고 1분마다 나오고 그래 버려.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.860,
                "end": 25.198
            },
            {
                "speaker_id": "2",
                "transcription": "그 몰라?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.208,
                "end": 26.203
            },
            {
                "speaker_id": "1",
                "transcription": "몰라요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.213,
                "end": 27.460
            }
        ]
    },
    "summary": "유료 광고 있음만 하고 중간 거하고 14분 중간에 안 넣으면 2분 또는 1분마다 광고가 나온다.",
