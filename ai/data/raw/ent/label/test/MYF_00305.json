        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "태우고 시동을 걸고 어디 갈 때는 어떻게 해요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.680
            },
            {
                "speaker_id": "1",
                "transcription": "낮에 움직이면 돼요.",
                "sound_type": [
                    2
                ],
                "start": 2.700,
                "end": 4.200
            },
            {
                "speaker_id": "1",
                "transcription": "낮에는 그렇게 많이 안 보여 밤에 예쁘지.",
                "sound_type": [
                    2
                ],
                "start": 4.200,
                "end": 7.305
            },
            {
                "speaker_id": "1",
                "transcription": "어 그래서 이제 낮저밤이 스타일 되는 거죠.",
                "sound_type": [
                    2
                ],
                "start": 7.305,
                "end": 10.700
            },
            {
                "speaker_id": "1",
                "transcription": "자 저는 사실 고민 했던 거 있어요.",
                "sound_type": [
                    2
                ],
                "start": 10.700,
                "end": 13.625
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 내 차가 핑크와 베이지 투 톤인데 엠비언트라이트를 무슨 색깔로 할까 진짜 고민 많이 했거든요.",
                "sound_type": [
                    2
                ],
                "start": 13.625,
                "end": 20.760
            },
            {
                "speaker_id": "1",
                "transcription": "며칠 고민 했거든요. 그래갖고 와가지고 사장님하고 이제 상의하려고 사장님 저 엠비언트 색깔 무슨 색깔로 해요 그랬더니 그걸 왜 고민하세요.",
                "sound_type": [
                    2
                ],
                "start": 20.745,
                "end": 28.840
            }
        ]
    },
    "summary": "내 차가 핑크와 베이지 투 톤인데 엠비언트라이트 무슨 색깔로 할지 고민돼서 사장님께 여쭈었더니 그걸 왜 고민하냐고 했다.",
