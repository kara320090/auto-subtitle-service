        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 유지 중에 있는데 이거는 그 사귀지는 않았지만 그분이 잠깐 생각날 때마다 뿌리고 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.012
            },
            {
                "speaker_id": "2",
                "transcription": "맞아요.",
                "sound_type": [
                    2
                ],
                "start": 6.022,
                "end": 7.510
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지 않나요?",
                "sound_type": [
                    2
                ],
                "start": 7.520,
                "end": 8.383
            },
            {
                "speaker_id": "2",
                "transcription": "향수 때문에 생각나는 그 남자 그놈 그럼요 네.",
                "sound_type": [
                    2
                ],
                "start": 8.393,
                "end": 14.769
            },
            {
                "speaker_id": "2",
                "transcription": "롬브르단로는 어쨌든 한국에서 그 고현정 향수로 처음에 네 그래 가지고 2000대 초반에 어 딥티크를 거의 대한민국에서 먹여 살린 이제 여기 우디 한 애들에서 굉장히 플로럴 한 애들 가지고 있는데 그 플로럴 한 애들이 결국에는 장미세요.",
                "sound_type": [
                    2
                ],
                "start": 14.779,
                "end": 31.917
            },
            {
                "speaker_id": "1",
                "transcription": "아 그런 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 31.927,
                "end": 33.299
            },
            {
                "speaker_id": "2",
                "transcription": "제라늄도 향 분자 구조는 거의 장미랑 비슷해서 약간 장미과의 애들을 좋아하시는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 33.309,
                "end": 38.474
            },
            {
                "speaker_id": "2",
                "transcription": "어 딥티크 롬브르단로는 엄청 강하죠.",
                "sound_type": [
                    2
                ],
                "start": 38.484,
                "end": 41.457
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 정말 딥티크스러워요.",
                "sound_type": [
                    2
                ],
                "start": 41.467,
                "end": 43.569
            },
            {
                "speaker_id": "2",
                "transcription": "이게 딥티크 설립자 분들 살아 계실 때 친구가 그 블랙커런트 잼 따려고 잼 만들려고 그리고 장미를 따고 그러고 나서 집에 와 가지고 이렇게 손을 딱 맡았는데 그 향이 너무 좋아가지고 그 창립자 3명한테 쭈르륵 가 가지고 나 이거 향수 만들어줘 한 거예요.",
                "sound_type": [
                    2
                ],
                "start": 43.579,
                "end": 62.579
            },
            {
                "speaker_id": "2",
                "transcription": "그러니까 시트러스 향수는요 사람의 기분을 와 이렇게 이제 만들어 주는 네 그리고 장미 향수는 기분을 이렇게 싸악",
                "sound_type": [
                    2
                ],
                "start": 62.589,
                "end": 71.300
            }
        ]
    },
    "summary": "가지고 온 향수 중에 우디 계열의 향수와 다른 플로럴 향의 향수는 대부분 장미라고 이야기합니다.",
