        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분 안녕하세요 @이름1입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 28.208
            },
            {
                "speaker_id": "1",
                "transcription": "동계 캠핑 하면 뭐니 뭐니 해도 또 화목난로 아니겠습니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.218,
                "end": 32.015
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 물론 화목난로가 설치하고 철수하고 좀 귀찮니즘이 있긴 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.025,
                "end": 36.804
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그래도 막상 캠핑 나가서 또 화목난로하고 떼가지고 이렇게 장작불 피우면 또 그것만큼 또 분위기도 좋고 또 재미난 게 또 없더라고요 보면은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.814,
                "end": 46.001
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 약간 귀차니즘을 감수 하고라서도 많이들 하시는데 오늘은 그래도 조금이나마 좀 설치라든가 이런 게 좀 용이하고 그리고 심플하고 그런 제품이라 한번 소개를 시켜드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.011,
                "end": 56.785
            },
            {
                "speaker_id": "1",
                "transcription": "제가 어반 사이드 제품을 많이 쓰고 있는데 어반 사이드 제품 그래도 나름 다 쓸 만한 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 56.795,
                "end": 61.468
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이게 어반 사이드 파이어 헥사곤 캠핑 스토브 이런 모양으로 생긴 그런 화목 난로예요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 61.478,
                "end": 68.814
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이걸 한번 잠깐 소개를 시켜드리고 오늘 또 저도 캠핑하면서 이걸로 또 좀 재미나게 불질도 좀 해볼 생각입니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 68.824,
                "end": 76.236
            },
            {
                "speaker_id": "1",
                "transcription": "일단 한번 제품부터 꺼내볼게요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 76.246,
                "end": 77.892
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이거는 이제 전용 가방입니다 여러분들.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 77.902,
                "end": 80.832
            },
            {
                "speaker_id": "1",
                "transcription": "전용 가방은 또 옵션 상품으로 구매하실 수 있는 그런 건데 전용 가방이 있는 거하고 없는 거하고 또 틀리죠.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 80.842,
                "end": 88.253
            },
            {
                "speaker_id": "1",
                "transcription": "딱 심플하게 갖고 다닐 수 있는 그런 가방이고요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 88.263,
                "end": 92.769
            },
            {
                "speaker_id": "1",
                "transcription": "바닥은 이렇게 또 약간 방수 처리가 돼 있어 가지고 물도 스미지 않는 그런 재질로 되어 있습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 92.779,
                "end": 98.254
            },
            {
                "speaker_id": "1",
                "transcription": "박스에서 한번 제품을 꺼내보도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 98.264,
                "end": 101.645
            },
            {
                "speaker_id": "1",
                "transcription": "자 자란",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 101.655,
                "end": 104.437
            }
        ]
    },
    "summary": "남자는 캠핑에 오랜만에 와서 화목 난로 제품을 언박싱하며 소개하고 있습니다.",
