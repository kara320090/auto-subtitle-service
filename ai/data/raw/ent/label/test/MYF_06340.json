        "term": [
            {
                "speaker_id": "1",
                "transcription": "블랙 색상도 있는데 저는 화이트를 선택했고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.139
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 블루투스 리모컨 추가로 주문한 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.139,
                "end": 7.640
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 카메라 홀더입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.640,
                "end": 11.130
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 박스를 한번 열어 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.130,
                "end": 14.110
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이때 오른손으로 핸드폰으로 찍고 있어서 한 손으로 뜯기 힘드네요.",
                "sound_type": [
                    2
                ],
                "start": 14.110,
                "end": 21.750
            },
            {
                "speaker_id": "1",
                "transcription": "이게 생각보다 크고 되게 튼튼하더라고요.",
                "sound_type": [
                    2
                ],
                "start": 21.750,
                "end": 25.652
            },
            {
                "speaker_id": "1",
                "transcription": "어 제가 화이트 색상을 처음 써 봤는데 깔끔해 보여서 좋았습니다.",
                "sound_type": [
                    2
                ],
                "start": 25.660,
                "end": 30.697
            }
        ]
    },
    "summary": "핸드폰 삼각대의 색상을 화이트로 선택했고 카메라 홀더와 추가로 주문한 블루투스 리모컨이 왔는데 삼각대가 생각보다 튼튼하고 깔끔해서 좋았다.",
