        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.747
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 TV입니다.",
                "sound_type": [
                    2
                ],
                "start": 0.757,
                "end": 1.901
            },
            {
                "speaker_id": "1",
                "transcription": "어 오늘 제가 파주 호수 캠핑장에 와 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 1.911,
                "end": 5.665
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들께 오늘 알려드릴 얘기는 단기 복무자 장기 복무자의 차이점 그리고 단기 복무를 하고 이제 사회로 나갔을 때 장기 복무를 하면 군에서 어떤 이점이 있는지에 대해서 여러분들에게 알려드리도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 5.675,
                "end": 21.807
            },
            {
                "speaker_id": "1",
                "transcription": "우선 단기 복무자는 2년에서 최장 5년까지 내가 복무해야 될 개월 수를 이제 의무 복무를 하고 사회로 나가는 것을 말하고 장기 복무자는 내가 단기 복무를 해봤는데 어 군 생활이 나한테 맞아.",
                "sound_type": [
                    2
                ],
                "start": 21.817,
                "end": 36.377
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 계속해서 군 생활을 해야겠어라고 할 때는 장기 복무를 신청을 하면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 36.387,
                "end": 41.099
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 장기 복무를 내가 군에 남아 있고 싶다고 해서 계속 남아 있는 것이 아니라 내가 선정이 돼야지만 장기 복무가 되거든요.",
                "sound_type": [
                    2
                ],
                "start": 41.109,
                "end": 49.296
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 되면 여러분들이 원하시는 진급이나 그리고 20년 군 생활해서 연금을 받거나 아니면 30년 이상도 할 수가 있겠죠 내 능력에 따라서.",
                "sound_type": [
                    2
                ],
                "start": 49.306,
                "end": 57.866
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 했던 혜택이 있기 때문에 만약에 군에 끝까지 남아있고 싶으신 분들은 장기 복무를 당연히 선호를 하시죠.",
                "sound_type": [
                    2
                ],
                "start": 57.876,
                "end": 65.631
            },
            {
                "speaker_id": "1",
                "transcription": "근데 장기 복무 같은 경우에는 장교는 한 50프로 그리고 부사관 한 20프로 정도만 그 선정이 된다고 합니다.",
                "sound_type": [
                    2
                ],
                "start": 65.641,
                "end": 74.000
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 많이 쉽지는 않지만 그래도 내가 원한다면은 누구나 장기 복무를 할 수가 있고 왜냐면 내가 군 생활을 계속 할려고 해서 들어왔다가 막상해보니까 이 내 적성에 도저히 안 맞아.",
                "sound_type": [
                    2
                ],
                "start": 74.010,
                "end": 87.464
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그냥 나는 내가 원래 해 할려고 했던 단기 복무만 하고 나갈래라고 하는 분들이 있기 때문에 장교에서 50프로만 된다고 해도 나머지 50프로 중에 30프로가 원래 장 단기를 희망했다면 이 20프로만 이제 경쟁에서 이기면 여러분들이 선정되는 거잖아요.",
                "sound_type": [
                    2
                ],
                "start": 87.474,
                "end": 104.465
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 충분히 가망성이 있고 만약에 내가 장기 복무가 되지 않았다라고 해도 전혀 어 희망을 놓지 않아도 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 104.475,
                "end": 113.865
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 내가 우선 장기가 안 됐어.",
                "sound_type": [
                    2
                ],
                "start": 113.875,
                "end": 116.878
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 계속 단기 복무를 하면 복무 연장 제도가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 116.888,
                "end": 120.196
            },
            {
                "speaker_id": "1",
                "transcription": "어 여러분들이 복무 연장을 하면서 꾸준히 군 생활을 열심히 하시면 다시 한번 장기 복무에 기회를 주는데 그것은 이제 내 다음 기수에 이제 후배들이 혹시나 장기 복무를 지원하지 않거나 TO가 남았을 경우에는 그 위에 있는 선배한테 다시 자리를 주는데 그때 되면 내가 될 수가 있는 거고 그 외에도 또 다른",
                "sound_type": [
                    2
                ],
                "start": 120.206,
                "end": 141.421
            }
        ]
    },
    "summary": "장기 복무를 하고 싶어도 계속 남아있을 수 있는 게 아니라 선정이 돼야 하는데 장교는 한 50프로를 부사관은 20프로 정도만 선정되며 만약 장기가 안 되더라도 괜찮은 게 계속 단기 복무를 하면 복무 연장 제도라는 게 있어서 장기 복무 기회를 준다고 말한다.",
