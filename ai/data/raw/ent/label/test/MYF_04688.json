    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "영어로 말을 못할지라도 영어로 내가 듣는 게 좀 어려울지라도 영어로 읽기만 하실 수 있으시면",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.349
            },
            {
                "speaker_id": "1",
                "transcription": "지금 굉장히 많은 정보가 이미 온라인상에 다 풀어져 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 6.359,
                "end": 10.730
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 충분히 그 걸 찾아서 독학을 하실 수가 있으세요.",
                "sound_type": [
                    2
                ],
                "start": 10.740,
                "end": 14.562
            },
            {
                "speaker_id": "1",
                "transcription": "지식의 정보에 근본에 가깝게 하는 게 왜 중요하냐면요.",
                "sound_type": [
                    2
                ],
                "start": 14.572,
                "end": 19.062
            },
            {
                "speaker_id": "1",
                "transcription": "이게 번역이 되었을 때 오역이 되었어도 잘못 번역이 되었어도 확인할 길이 없기 때문이에요.",
                "sound_type": [
                    2
                ],
                "start": 19.072,
                "end": 26.072
            },
            {
                "speaker_id": "1",
                "transcription": "사실 제가 몇몇 책에서 그 한국어로 바뀌어져 있는 내용에서 그 잘못된 번역 내용들을 발견한 경우들이 좀 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 26.082,
                "end": 35.455
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그런 책을 제가 추천하거나 그럴 수가 없어요.",
                "sound_type": [
                    2
                ],
                "start": 35.465,
                "end": 38.877
            },
            {
                "speaker_id": "1",
                "transcription": "또 출처가 적혀져 있지도 않아서 결국에는 제가 하나하나 내용을 일부러 다 찾아가지고 그래서 그 정보에 접근을 해서 거기에 적혀진 내용으로 바탕으로 제가 강의 때 말씀을 드리게 되거든요.",
                "sound_type": [
                    2
                ],
                "start": 38.887,
                "end": 53.238
            },
            {
                "speaker_id": "1",
                "transcription": "불어를 배우는 게 더 좋지 않을까 이런 얘기도 해 주시는데요.",
                "sound_type": [
                    2
                ],
                "start": 53.248,
                "end": 56.292
            },
            {
                "speaker_id": "1",
                "transcription": "프랑스에서 발달 된 그런 정보들이 불어로 적혀져 있기도 하죠.",
                "sound_type": [
                    2
                ],
                "start": 56.302,
                "end": 60.370
            },
            {
                "speaker_id": "1",
                "transcription": "거의 300년간 이제 이 프랑스에서 개발된 내용들이 또 해외에서 산업화를 하기 위해서 영어로 많이 만들어지고 그러면서 크로스 체크가 한 300년에 걸쳐서 있어왔기 때문에 불어까지 하기에 조금 부담이시다 영어만이라도 하시면요.",
                "sound_type": [
                    2
                ],
                "start": 60.380,
                "end": 76.377
            },
            {
                "speaker_id": "1",
                "transcription": "충분하게 엄청나게 방대한 양의 정보에 여러분이 다가가실 수가 있으세요.",
                "sound_type": [
                    2
                ],
                "start": 76.387,
                "end": 82.004
            },
            {
                "speaker_id": "1",
                "transcription": "명동 러쉬에 가시면요 라이브러리가 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 82.014,
                "end": 85.614
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 책 중에 퍼퓨멀이라는 책이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 85.624,
                "end": 88.921
            },
            {
                "speaker_id": "1",
                "transcription": "그 책을 보시면요 아주 찬찬하게 너무너무 잘 적혀져 있어요.",
                "sound_type": [
                    2
                ],
                "start": 88.931,
                "end": 93.936
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 여러분 시향하셨을 경우에 향료 회사에서 사용하는 그 축약어라든지 여러분이 이제 무역회사에 가신다고 해도 무역 용어가 따로 있어서 그 언어를 습득하셔야 되잖아요.",
                "sound_type": [
                    2
                ],
                "start": 93.946,
                "end": 104.961
            },
            {
                "speaker_id": "1",
                "transcription": "또 마케팅 팀에 들어간다고 해도 마케팅 용어들이 있어서 그걸 따로 습득을 하셔야 되는데 향수의 향을 만드는 향료 회사 아니면 향수 회사 여기서도 마찬가지예요.",
                "sound_type": [
                    2
                ],
                "start": 104.971,
                "end": 114.884
            },
            {
                "speaker_id": "1",
                "transcription": "그 기본적인 언어들이 존재하는데요.",
                "sound_type": [
                    2
                ],
                "start": 114.894,
                "end": 117.360
            },
            {
                "speaker_id": "1",
                "transcription": "그 언어들을 다 찬찬히 하나하나씩 다 풀어서 있어요.",
                "sound_type": [
                    2
                ],
                "start": 117.370,
                "end": 121.559
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그 책만 찬찬히 읽어보시면요.",
                "sound_type": [
                    2
                ],
                "start": 121.569,
                "end": 124.658
            },
            {
                "speaker_id": "1",
                "transcription": "아 이렇게 흘러가겠구나 그게 정말 머리에 딱 들어오실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 124.668,
                "end": 129.885
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 이제 화학 분자에 대한 얘기도 다 들어가져 있고 또 플로럴 노트 같은 경우는요.",
                "sound_type": [
                    2
                ],
                "start": 129.895,
                "end": 136.901
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 걸 얼만큼 배합을 해서 이 향이 나간다 이 포뮬러까지 다 적혀져 있어요.",
                "sound_type": [
                    2
                ],
                "start": 136.911,
                "end": 143.116
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 그 정보를 읽으실 수만 있으시면 충분히 독학으로 가능하세요.",
                "sound_type": [
                    2
                ],
                "start": 143.126,
                "end": 148.327
            },
            {
                "speaker_id": "1",
                "transcription": "그러니 영어 공부를 하시길 바랄게요.",
                "sound_type": [
                    2
                ],
                "start": 148.337,
                "end": 151.966
            }
        ]
    },
    "summary": "영어로 말하고 듣는게 어렵더라도 영어를 해석할 수만 있다면 충분히 조향에 대해 독학을 할 수 있으니 영어공부를 하기를 바란다.",
