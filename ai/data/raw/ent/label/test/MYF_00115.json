            },
            {
                "speaker_id": "3",
                "age": "50대 이상",
                "gender": "여성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 누나 @이름1 아직 움직여.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.655
            },
            {
                "speaker_id": "2",
                "transcription": "야 움직이기는 하는데 에어컨이 안 나와서 더워 죽을 것 같애.",
                "sound_type": [
                    2
                ],
                "start": 7.665,
                "end": 12.010
            },
            {
                "speaker_id": "2",
                "transcription": "아씨 더워.",
                "sound_type": [
                    2
                ],
                "start": 12.019,
                "end": 13.360
            },
            {
                "speaker_id": "1",
                "transcription": "뚜껑을 열고 오지 그랬어?",
                "sound_type": [
                    2
                ],
                "start": 13.390,
                "end": 14.921
            },
            {
                "speaker_id": "2",
                "transcription": "아니 뚜껑은 안 열려.",
                "sound_type": [
                    2
                ],
                "start": 14.931,
                "end": 16.241
            },
            {
                "speaker_id": "3",
                "transcription": "우리딸 어서 온나.",
                "sound_type": [
                    2
                ],
                "start": 16.251,
                "end": 17.827
            },
            {
                "speaker_id": "2",
                "transcription": "엄마 내가 왔다.",
                "sound_type": [
                    2
                ],
                "start": 17.837,
                "end": 20.682
            },
            {
                "speaker_id": "3",
                "transcription": "아이고 우리 귀염둥이 딸내미 왔네 이쁜 야 너 요즘 조회수 안 나오냐?",
                "sound_type": [
                    2
                ],
                "start": 20.692,
                "end": 29.506
            },
            {
                "speaker_id": "3",
                "transcription": "왜 이렇게 다 떨어진 옷 입고 왔어 세상에 엄마가 바지 하나 사줄까?",
                "sound_type": [
                    2
                ],
                "start": 29.516,
                "end": 34.309
            },
            {
                "speaker_id": "2",
                "transcription": "아니 엄마 이게 패션이야.",
                "sound_type": [
                    2
                ],
                "start": 34.319,
                "end": 36.233
            },
            {
                "speaker_id": "3",
                "transcription": "야 너무 불쌍하다.",
                "sound_type": [
                    2
                ],
                "start": 36.243,
                "end": 38.159
            },
            {
                "speaker_id": "2",
                "transcription": "아니 이게 요즘 유행이라구.",
                "sound_type": [
                    2
                ],
                "start": 38.169,
                "end": 40.544
            },
            {
                "speaker_id": "2",
                "transcription": "뉴진스 몰라?",
                "sound_type": [
                    2
                ],
                "start": 40.554,
                "end": 41.846
            },
            {
                "speaker_id": "2",
                "transcription": "어 어 아이브 몰라 아이브 아이브?",
                "sound_type": [
                    2
                ],
                "start": 41.856,
                "end": 45.847
            },
            {
                "speaker_id": "2",
                "transcription": "어 맛있겠다 역시 엄마표 밥상이 최고지.",
                "sound_type": [
                    2
                ],
                "start": 45.857,
                "end": 50.629
            },
            {
                "speaker_id": "3",
                "transcription": "너 온다 그래서 엄마 열심히 만들었어.",
                "sound_type": [
                    2
                ],
                "start": 50.639,
                "end": 52.905
            },
            {
                "speaker_id": "2",
                "transcription": "엄마 혹시 단무지 먹을래 단무지?",
                "sound_type": [
                    2
                ],
                "start": 52.915,
                "end": 54.625
            },
            {
                "speaker_id": "3",
                "transcription": "단무지 어 도시락에 쌌는데",
                "sound_type": [
                    2
                ],
                "start": 54.635,
                "end": 56.826
            },
            {
                "speaker_id": "2",
                "transcription": "아니야 내가 단무지 가져왔어 짠.",
                "sound_type": [
                    2
                ],
                "start": 56.836,
                "end": 59.456
            },
            {
                "speaker_id": "3",
                "transcription": "아 이 땐",
                "sound_type": [
                    2
                ],
                "start": 59.466,
                "end": 60.560
            }
        ]
    },
    "summary": "여성이 노란색 차량을 몰고 간 곳은 본가이다.",
