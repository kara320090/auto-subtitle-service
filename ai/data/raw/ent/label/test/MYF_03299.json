        "term": [
            {
                "speaker_id": "1",
                "transcription": "약간 마음에 거친 결이 매끄러워지는 기분 그니까 섬만이 수그러지는 기분",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 11.872
            },
            {
                "speaker_id": "2",
                "transcription": "보면 확실히 몸이 아프신 분들은 머릿결이 확 바뀌어 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.882,
                "end": 16.939
            },
            {
                "speaker_id": "1",
                "transcription": "음",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.949,
                "end": 17.668
            },
            {
                "speaker_id": "2",
                "transcription": "뭔가 빈 껍데기 같은 느낌?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.678,
                "end": 21.663
            },
            {
                "speaker_id": "1",
                "transcription": "음",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.673,
                "end": 22.219
            },
            {
                "speaker_id": "2",
                "transcription": "갑자기 너무 아파서 끼니를 못 드시거나 아님 약을 드시거나 병원을 자주 가시거나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.229,
                "end": 28.778
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 많이 잘랐구나.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 28.788,
                "end": 34.135
            },
            {
                "speaker_id": "1",
                "transcription": "아 요거 공사하십니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.145,
                "end": 41.244
            },
            {
                "speaker_id": "3",
                "transcription": "네 친구랑 한갑으로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.254,
                "end": 42.531
            },
            {
                "speaker_id": "1",
                "transcription": "음 그럼 저희 이렇게 한번 하이 한번 해주시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.541,
                "end": 46.115
            },
            {
                "speaker_id": "3",
                "transcription": "안녕하세요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.125,
                "end": 47.382
            },
            {
                "speaker_id": "2",
