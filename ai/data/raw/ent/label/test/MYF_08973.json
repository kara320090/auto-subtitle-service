        "term": [
            {
                "speaker_id": "1",
                "transcription": "감사합니다 형님.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 0.968
            },
            {
                "speaker_id": "1",
                "transcription": "자 일곱 치입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.978,
                "end": 2.288
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 첫 붕어 나왔으니까 다음 붕어도 한번 기대해 보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.298,
                "end": 5.966
            },
            {
                "speaker_id": "1",
                "transcription": "야 찌 올림 진짜 야무졌다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.976,
                "end": 7.688
            },
            {
                "speaker_id": "1",
                "transcription": "평소 같았으면 별 감흥이 없었을 텐데 아 정말 힘들게 만난 붕어라 너무 예뻐 보이고 좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.698,
                "end": 15.917
            },
            {
                "speaker_id": "1",
                "transcription": "아 붕어 참 깔끔합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.927,
                "end": 18.045
            },
            {
                "speaker_id": "1",
                "transcription": "예쁘죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.055,
                "end": 19.225
            },
            {
                "speaker_id": "1",
                "transcription": "자 어렵게 붕어 만납니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.235,
                "end": 21.288
            },
            {
                "speaker_id": "1",
                "transcription": "자 지금 비린내는 계속 나는데.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.298,
                "end": 27.026
            },
            {
                "speaker_id": "1",
                "transcription": "어 앞쪽에는 입질이 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.036,
                "end": 31.660
            },
            {
                "speaker_id": "1",
                "transcription": "아 짧은 대 하나 펴서 발 앞에 한번 떨궈 보겠습니다.",
