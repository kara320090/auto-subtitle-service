        "term": [
            {
                "speaker_id": "1",
                "transcription": "밤하늘에 비친 호숫가에 이렇게 차분하게 이렇게 샥샥 일렁 일렁 그러면 산뜻하고 어우 어르신 너무 잘 만드셨네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.911
            },
            {
                "speaker_id": "2",
                "transcription": "음 이건 왜 그런 거예요?",
                "sound_type": [
                    2
                ],
                "start": 9.921,
                "end": 10.964
            },
            {
                "speaker_id": "1",
                "transcription": "안 맞으시는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 10.974,
                "end": 12.400
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 그 향이랑 네.",
                "sound_type": [
                    2
                ],
                "start": 12.410,
                "end": 14.152
            },
            {
                "speaker_id": "1",
                "transcription": "부장님의 뇌에서 그냥 거부하시는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 14.162,
                "end": 17.541
            },
            {
                "speaker_id": "1",
                "transcription": "우리 이제 사람마다 각자의 향에 축적된 경험의 그 정도가 다르잖아요.",
                "sound_type": [
                    2
                ],
                "start": 17.551,
                "end": 22.514
            },
            {
                "speaker_id": "1",
                "transcription": "아마 그분은 그게 좀 처음이셔서 거기에 대한 반작용으로 재채기나 이런 걸 하시지 않았을까.",
                "sound_type": [
                    2
                ],
                "start": 22.524,
                "end": 28.416
            },
            {
                "speaker_id": "2",
                "transcription": "에르메스라는 브랜드 자체가 튀는 럭셔리는 아니잖아요.",
                "sound_type": [
                    2
                ],
                "start": 28.426,
                "end": 33.529
            },
            {
                "speaker_id": "2",
                "transcription": "어떤 소재나 텍스처가 되게 좋은 브랜드고 향수에 그게 담겨 있는 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 33.539,
                "end": 38.218
            },
            {
                "speaker_id": "2",
                "transcription": "저는 저 자신한테 선물하고 싶은 동시에 그 양면적인 걸 동시에 가지고 가고 싶거든요.",
                "sound_type": [
                    2
                ],
                "start": 38.228,
                "end": 45.126
            },
            {
                "speaker_id": "2",
                "transcription": "카리스마가 있지만 귀여운 느낌",
                "sound_type": [
                    2
                ],
                "start": 45.136,
                "end": 48.533
            }
        ]
    },
    "summary": "에르메스라는 브랜드는 어떤 소재나 텍스처가 좋은 브랜드고 향수에 그게 담겨 있는 것 같다고 이야기합니다.",
