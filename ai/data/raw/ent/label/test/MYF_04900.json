        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 향인데 이걸 좋아하시는 분들은요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.740
            },
            {
                "speaker_id": "1",
                "transcription": "굉장히 아웃 고잉, 야외 활동 뭐 산에서 자전 안녕하세요.",
                "sound_type": [
                    2
                ],
                "start": 2.750,
                "end": 9.382
            },
            {
                "speaker_id": "1",
                "transcription": "향수 읽어 주는 여자 하니날다입니다.",
                "sound_type": [
                    2
                ],
                "start": 9.392,
                "end": 11.730
            },
            {
                "speaker_id": "1",
                "transcription": "이 연구에 따르면요 바닐라 향을 좋아하는 분들은요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.740,
                "end": 17.460
            },
            {
                "speaker_id": "1",
                "transcription": "파티 파티 파티 피플이라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 17.470,
                "end": 20.950
            },
            {
                "speaker_id": "1",
                "transcription": "진정한 파티 피플들 네.",
                "sound_type": [
                    2
                ],
                "start": 20.960,
                "end": 23.387
            },
            {
                "speaker_id": "1",
                "transcription": "아주 날아다니시는 분들이라고 하십니다.",
                "sound_type": [
                    2
                ],
                "start": 23.397,
                "end": 25.815
            },
            {
                "speaker_id": "1",
                "transcription": "주말 동안 집에 있으라고 하는 거 아주아주 몹쓸 짓이죠 이분들에게는.",
                "sound_type": [
                    2
                ],
                "start": 25.825,
                "end": 32.188
            },
            {
                "speaker_id": "1",
                "transcription": "주말에 무조건 밖으로 나가셔야 되고 사람들하고 사람들 사이에 중간 허브 역할을 하시는 그런 분들 생동감 넘치시고 에너지 넘치시고 네 함께 있으면 같이 막 힘이 막 나는 그런 분들이라고 해요.",
                "sound_type": [
                    2
                ],
                "start": 32.198,
                "end": 46.184
            },
            {
                "speaker_id": "1",
                "transcription": "춤추는 거 술 마시는 거 정말 파티장에서 모르는 사람들하고 대화하는 거 이런 거 너무 좋아하시는 분들 처음 본 사람들하고 함께 있을 때 분위기 이렇게 띄우는 그런 분들이 바닐라를 좋아하는 분들이라고 하세요.",
                "sound_type": [
                    2
                ],
                "start": 46.194,
                "end": 60.410
            },
            {
                "speaker_id": "1",
                "transcription": "바닐라 하면은 정말 결코 빼놓을 수 없는 게 바로 로라 메르시에의 엠버 바닐라",
                "sound_type": [
                    2
                ],
                "start": 60.420,
                "end": 68.133
            }
        ]
    },
