                ],
                "start": 0.000,
                "end": 0.679
            },
            {
                "speaker_id": "1",
                "transcription": "자 어 가지 바늘 채비해 놨는데 에 이 녀석은 아래 바늘 먹었습니다.",
                "sound_type": [
                    2
                ],
