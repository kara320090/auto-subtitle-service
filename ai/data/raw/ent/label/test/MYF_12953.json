                ],
                "start": 44.490,
                "end": 45.261
            },
            {
                "speaker_id": "2",
                "transcription": "그럼 나와.",
                "sound_type": [
                    2
                ],
                "start": 45.271,
                "end": 46.136
            },
            {
                "speaker_id": "1",
                "transcription": "야 진짜 형님 덕분에 손맛 제대로 봅니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.140,
                "end": 49.806
            },
            {
                "speaker_id": "1",
                "transcription": "감사드립니다.",
