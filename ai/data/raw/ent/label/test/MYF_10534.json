        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "저도 되게 많이 찾아보고 구매를 했었거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.414
            },
            {
                "speaker_id": "1",
                "transcription": "근데 막상 사 놓고 안 쓰게 되는 악세사리가 굉장히 많아요.",
                "sound_type": [
                    2
                ],
                "start": 2.424,
                "end": 5.915
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 기본적으로 무조건 추천드리고 싶은 악세사리는 케이스, 그리고 액정 필름 정도구요.",
                "sound_type": [
                    2
                ],
                "start": 5.925,
                "end": 11.143
            },
            {
                "speaker_id": "1",
                "transcription": "어 케이스 영상은 제가 추천드린 제품 영상 올린 적이 있으니까 위에 카드 혹은 더 보기 란 링크 참고 부탁드리구요.",
                "sound_type": [
                    2
                ],
                "start": 11.153,
                "end": 18.520
            },
            {
                "speaker_id": "1",
                "transcription": "어 액정 필름 같은 경우에는 뭐 이것도 말이 많은데 저는 화질에 크게 예민하지도 않고 가끔 뭐 필기 기능도 쓰기 때문에 종이 필름을 사용했었는데 영상 시청이 주 용도라면 강화 필름을 추천드릴게요.",
                "sound_type": [
                    2
                ],
                "start": 18.530,
                "end": 30.598
            },
            {
                "speaker_id": "1",
                "transcription": "어 그 외에 추가적으로 추천하는 악세사리는 애플 펜슬이랑 키보드예요.",
                "sound_type": [
                    2
                ],
                "start": 30.608,
                "end": 35.227
            },
            {
                "speaker_id": "1",
                "transcription": "사실 사기 전에는 애플 펜슬이 필수라고 생각했는데",
                "sound_type": [
                    2
                ],
                "start": 35.237,
                "end": 38.833
            }
        ]
    },
    "summary": "20대 여성이 아이패드 액세서리를 추천한다.",
