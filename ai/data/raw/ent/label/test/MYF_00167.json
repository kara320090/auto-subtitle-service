        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 배송도 지금 배송 여러분이 배송시킬 거 알고 저희 대기 중이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.142
            },
            {
                "speaker_id": "1",
                "transcription": "어 곱창 전골은 곱도리탕보다 곱창이 더 많이 들어가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.152,
                "end": 9.513
            },
            {
                "speaker_id": "1",
                "transcription": "어 곱창 이거 그냥 한 팩 탁 뜯은 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.523,
                "end": 12.781
            },
            {
                "speaker_id": "1",
                "transcription": "어 한 팩 뜯은 게 요 정도 괜찮죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.791,
                "end": 15.782
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 양도 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.792,
                "end": 17.382
            },
            {
                "speaker_id": "1",
                "transcription": "양 요렇게 들어가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.392,
                "end": 19.181
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 괜찮죠 그리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.191,
                "end": 22.733
            }
        ]
    },
    "summary": "곱창 전골은 곱도리탕보다 곱창이 더 많이 들어가있고 한 팩에 들은 양도 보여준다.",
