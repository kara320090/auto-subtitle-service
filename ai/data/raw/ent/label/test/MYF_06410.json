            {
                "speaker_id": "1",
                "transcription": "@이름1 가 워터파크만 좋아하면은 정말 재밌게 놀았을 텐데 저걸 싫어해 가지고 물을 아직 안 좋아해요. 무서워해서",
                "sound_type": [
