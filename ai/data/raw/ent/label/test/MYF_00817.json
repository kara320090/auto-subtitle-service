        "term": [
            {
                "speaker_id": "1",
                "transcription": "예쁜 찌 올림에 나와준 두 번째 붕어입니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.213
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 나오면 최소 허리급이라고 했는데 뭔가 안 맞나 봅니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 3.223,
                "end": 7.837
            },
            {
                "speaker_id": "1",
                "transcription": "배수 때문인지 이런 작은 녀석들만 나오네요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 7.847,
                "end": 10.931
            },
            {
                "speaker_id": "1",
                "transcription": "보내 주겠습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 10.941,
                "end": 12.364
            },
            {
                "speaker_id": "1",
                "transcription": "가라.",
                "sound_type": [
                    2
                ],
                "start": 12.374,
                "end": 14.854
            },
            {
                "speaker_id": "1",
                "transcription": "쉽지 않네요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 14.864,
                "end": 16.641
            },
            {
                "speaker_id": "1",
                "transcription": "밤새도록 블루길, 살치 걷어 내고 만나는 붕어들이 사이즈가 원하는 사이즈가 아닙니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 16.651,
                "end": 25.598
            },
            {
                "speaker_id": "1",
                "transcription": "이곳이 한방터가 아니라면 이렇게 아쉽지도 않을 것 같은데 아.",
                "sound_type": [
