        "term": [
            {
                "speaker_id": "1",
                "transcription": "어젯밤에 비가 많이 와서 봄이와 나물이가 집에 다녀갔는지 걱정이 되었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.159
            },
            {
                "speaker_id": "1",
                "transcription": "아침에 와보니 어 다녀간 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.169,
                "end": 11.481
            },
            {
                "speaker_id": "1",
                "transcription": "흙 발자국이 보이고 참치도 먹었고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.491,
                "end": 15.945
            },
            {
                "speaker_id": "1",
                "transcription": "어 사료도 좀 먹은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.955,
                "end": 19.020
            },
            {
                "speaker_id": "1",
                "transcription": "둘이서 논 것 같은 흔적도 보이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.030,
                "end": 22.404
            },
            {
                "speaker_id": "1",
                "transcription": "봄아 나물아 고마워.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.414,
                "end": 25.585
            },
            {
                "speaker_id": "1",
                "transcription": "우리 여기에서 즐겁게 지내자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.595,
                "end": 28.872
            },
            {
                "speaker_id": "1",
                "transcription": "저녁에 보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.882,
                "end": 31.070
            },
            {
                "speaker_id": "1",
                "transcription": "안녕.",
