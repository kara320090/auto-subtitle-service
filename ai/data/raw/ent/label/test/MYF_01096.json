                ],
                "start": 11.636,
                "end": 18.321
            },
            {
                "speaker_id": "1",
                "transcription": "많이 받는데 마음에 드는 향수를 받은 적이 없고 뭐 처치 곤란이다.",
                "sound_type": [
                    2
