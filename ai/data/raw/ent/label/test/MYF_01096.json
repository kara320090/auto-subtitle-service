                    2
                ],
                "start": 0.000,
                "end": 11.626
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제게 오시는 분들 중에 향수 선물 받았을 때 뭐 향수를 참 선물 많이 받는다.",
                "sound_type": [
