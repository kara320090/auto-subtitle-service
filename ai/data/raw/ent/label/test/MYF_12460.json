        "term": [
            {
                "speaker_id": "1",
                "transcription": "두 번째 붕어 나왔습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.410
            },
            {
                "speaker_id": "1",
                "transcription": "제일 우측에 초강몬스터 38칸이고요.",
                "sound_type": [
                    2
                ],
                "start": 1.420,
                "end": 4.652
            },
            {
                "speaker_id": "1",
                "transcription": "사이즈는 크지 않은데 앞에 덤불이 있어서 안전하게 뜰채로 뺐습니다.",
                "sound_type": [
                    2
                ],
                "start": 4.662,
                "end": 10.008
            },
            {
                "speaker_id": "1",
                "transcription": "글루텐 먹고 나왔고요.",
                "sound_type": [
                    2
                ],
                "start": 10.018,
                "end": 11.021
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 글루텐은 라이어 옥수수와 어분 글루텐을 섞었습니다.",
                "sound_type": [
                    2
                ],
                "start": 11.031,
                "end": 15.120
            },
            {
                "speaker_id": "1",
                "transcription": "이 녀석은 한 8치 되겠네요.",
