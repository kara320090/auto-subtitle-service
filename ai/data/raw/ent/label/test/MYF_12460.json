                    2
                ],
                "start": 15.125,
                "end": 18.130
            },
            {
                "speaker_id": "1",
                "transcription": "좋습니다.",
                "sound_type": [
                    2
                ],
                "start": 18.140,
                "end": 19.569
            },
            {
                "speaker_id": "1",
                "transcription": "찌를 꼬물꼬물 하면서 왼쪽으로 살짝 가져갔습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.579,
                "end": 23.798
            },
            {
                "speaker_id": "1",
                "transcription": "무안 구정리 수로의 두 번째 붕어입니다.",
