        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "한 번은 그분이 소개팅 자리에 나갔는데 그날 나오셨던 여성분이 그 향이 아주 묵직하게 들어간 향수를 입고 나오셨던 거 같데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.171
            },
            {
                "speaker_id": "1",
                "transcription": "자기는 지금까지 몰랐는데 그 향 향 향의 원료를 시향을 하고 나니 그때 그녀가 입었던 향수에 이 원료가 많았구나라는 거를 자기가 지금 느낀다고 말씀을 주시더라고요.",
                "sound_type": [
                    2
                ],
                "start": 10.181,
                "end": 23.459
            },
            {
                "speaker_id": "1",
                "transcription": "소개팅 자리에 이제 그녀가 등장하기 전부터 그 향수 굉장히 지배적인 꽃의 향료거든요.",
                "sound_type": [
                    2
                ],
                "start": 23.469,
                "end": 30.665
            },
            {
                "speaker_id": "1",
                "transcription": "그 향이 등장을 하길래 본인이 너무 속도 안 좋고 이미 그때부터 머리가 아팠데요.",
                "sound_type": [
                    2
                ],
                "start": 30.675,
                "end": 35.927
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그녀가 와서 서로 뭐 인사하고 얘기를 하지만 이미 그냥 너무 싫고 빨리 그 자리를 떠나고 싶고 냄새가 너무 나니까 향수가 아니라 향기가 아니라 냄새인 거예요.",
                "sound_type": [
                    2
                ],
                "start": 35.937,
                "end": 46.748
            },
            {
                "speaker_id": "1",
                "transcription": "나를 거북스럽고 머리 아프게 만드는 그냥 냄새인 거죠.",
                "sound_type": [
                    2
                ],
                "start": 46.758,
                "end": 50.934
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 사실 그녀의 얼굴도 기억이 안 나고 하지만 신기하게 그 향은 기억이 나서 자기가 본인이 너무너무 싫어했던 향이라 그건 너무 기억이 나서 저희 그 모였던 날 시향을 하면서 그 이야기를 공유해 주시더라고요.",
                "sound_type": [
                    2
                ],
                "start": 50.944,
                "end": 66.379
            },
            {
                "speaker_id": "1",
                "transcription": "그것처럼 본인하고 안 맞는 향은 몸이 먼저 반응을 해요.",
                "sound_type": [
                    2
                ],
                "start": 66.389,
                "end": 71.257
            },
            {
                "speaker_id": "1",
                "transcription": "향수와 향의 자극을 통해서 우리 몸이 반응하는 것들이 참 다양한 반응들이 존재해요.",
                "sound_type": [
                    2
                ],
                "start": 71.267,
                "end": 78.618
            },
            {
                "speaker_id": "1",
                "transcription": "그중에서도 가장 빠르게 반응하는 건 역시나 거북하고 좋지 않은 거에 대한 반응이에요.",
                "sound_type": [
                    2
                ],
                "start": 78.628,
                "end": 83.817
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 살아야 되니까.",
                "sound_type": [
                    2
                ],
                "start": 83.827,
                "end": 85.148
            },
            {
                "speaker_id": "1",
                "transcription": "그런 반응이 오면 그 향들을 굳이 좋아하시려고 노력 안 하셔도 돼요.",
                "sound_type": [
                    2
                ],
                "start": 85.158,
                "end": 90.553
            },
            {
                "speaker_id": "1",
                "transcription": "물론 뭐 정말 나는 열심히 노력해 보겠다라면 뭐 시도를 해보셔도 좋은데 어 자연의 그냥 순리대로 가겠다면 굳이 뭐 시도를 안 하셔도 되고요.",
                "sound_type": [
                    2
                ],
                "start": 90.563,
                "end": 100.416
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 뭐 조향사가 꿈이다 아니면 어 나는 그래도 새로운 세계를 도전을 한번 해볼 거야 하면서 새로운 향들을 계속 도전을 해보면 또 그만큼 또 익숙해지면 어 장이 편안해지기도 하고 머리가 안 아파지기도 하거든요.",
                "sound_type": [
                    2
                ],
                "start": 100.426,
                "end": 115.224
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 그렇게 몇 년간의 노력을 했음에도 불구하고 너무나 몸이 힘들다고 하면 과감히 포기할 것을 저는 말씀을 드립니다.",
                "sound_type": [
                    2
                ],
                "start": 115.234,
                "end": 123.711
            },
            {
                "speaker_id": "1",
                "transcription": "마치 연애와 같다고 보시면 돼요 네.",
                "sound_type": [
                    2
                ],
                "start": 123.721,
                "end": 126.827
            },
            {
                "speaker_id": "1",
                "transcription": "이 남자 이 여자분의 그 모든 존재가 나를 너무 힘들게 하는데 내가 나를 바꾸면서까지 그걸 맞추기 위해 너무 노력을 했는데도 불구하고 안 된다고 하면 과감히 놓는",
                "sound_type": [
                    2
                ],
                "start": 126.837,
                "end": 139.906
            }
        ]
    },
    "summary": "소개팅에서 만난 여성분에게 나던 냄새 때문에 속도 안 좋고 머리까지 아팠는데 특정 원료가 들어간 향수였다는 것을 시향을 통해서 알게 된 분처럼 향의 자극을 통해서 우리 몸이 다양하게 반응을 하니 조향사나 도전 정신이 없는 분이라면 굳이 그 향을 좋아하시려고 노력하지 않으셔도 됩니다.",
