        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 디테일한 비용을 위해서 업체명은 따로 언급하지 않겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.963
            },
            {
                "speaker_id": "1",
                "transcription": "이번 영상에는 결혼식을 하는데 필요한 비용만 정리를 했고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.973,
                "end": 7.934
            },
            {
                "speaker_id": "1",
                "transcription": "신혼집에 대한 비용은 제외를 했고 그리고 저희는 예물 예단 폐백을 하지 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.944,
                "end": 13.526
            },
            {
                "speaker_id": "1",
                "transcription": "사실 이 결혼 비용이라는 게 어떻게 하느냐에 따라서 너무 천차만별이어 가지고 제가 얘기하는 비용은 그냥 참고만 해 주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.536,
                "end": 20.924
            },
            {
                "speaker_id": "1",
                "transcription": "저의 경우는 좀 적게 들어간 편임을 감안하고 봐주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.934,
                "end": 25.150
            }
        ]
    },
    "summary": "오프로는 본인의 결혼 비용은 적은 편임을 감안하고 봐달라고 이야기합니다.",
