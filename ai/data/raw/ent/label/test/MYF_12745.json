        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 좋다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.360
            },
            {
                "speaker_id": "1",
                "transcription": "어서 와.",
                "sound_type": [
                    2
                ],
                "start": 2.370,
                "end": 3.545
            },
            {
                "speaker_id": "1",
                "transcription": "하하하하 어유 붕어가 황금색이네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.555,
                "end": 9.888
            },
            {
                "speaker_id": "1",
                "transcription": "붕어 진짜 때깔 죽입니다 오이구 금색입니다 금색.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.898,
                "end": 14.376
            },
            {
                "speaker_id": "1",
                "transcription": "저쪽 부들 앞에 세우는 적벽 32칸입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.386,
                "end": 19.602
            },
            {
                "speaker_id": "1",
                "transcription": "아주 깨끗한 황금 붕어 나와줬습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.612,
                "end": 23.772
            },
            {
                "speaker_id": "1",
                "transcription": "어 이 녀석도 사이즈가 잘아서 어 바로 보내줄게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.782,
                "end": 28.045
            },
            {
                "speaker_id": "1",
                "transcription": "강릉 붕어입니다.",
                "sound_type": [
                    2
                ],
                "start": 28.055,
                "end": 29.563
            },
            {
                "speaker_id": "1",
                "transcription": "눈도 똘망똥망하게 생겼습니다.",
                "sound_type": [
                    2
                ],
                "start": 29.573,
                "end": 32.254
            },
            {
                "speaker_id": "1",
                "transcription": "고맙다 잘가라.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.264,
                "end": 41.737
            },
            {
                "speaker_id": "1",
                "transcription": "어 붕어 정말 예쁩니다.",
                "sound_type": [
                    2
                ],
                "start": 41.747,
                "end": 43.811
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 온 보람이 있구나 하는 생각이 들 정도로 정말 예쁜 붕어들 나오고 있네요.",
                "sound_type": [
                    2
                ],
                "start": 43.821,
                "end": 52.719
            }
        ]
    },
    "summary": "황금색인 강릉 붕어는 부들 앞에 적벽 32칸에서 나왔는데 사이즈가 작아서 바로 방생하겠다며 여기까지 온 보람이 있을 정도로 예쁜 붕어가 나온다고 말한다.",
