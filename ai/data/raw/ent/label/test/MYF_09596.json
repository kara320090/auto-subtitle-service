        "term": [
            {
                "speaker_id": "1",
                "transcription": "아마 이제 여기까지 들으신 분 들은 다들 와 포근함을 느끼는 게 정말 다르구나 그렇게 느끼실거예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.494
            },
            {
                "speaker_id": "1",
                "transcription": "맞아요 사람들마다 정말 많이 다르시고 제가 항상 단어에 집중을 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 6.504,
                "end": 12.181
            },
            {
                "speaker_id": "1",
                "transcription": "이 형용사 특히나 이 형용사들은 상대적이어서 개인의 경험이나 이런 거에 따라 너무 다르기 때문에 우리가 뭔가 함부로 재단하거나 심판할 수 없는 단정 지을 수가 없기 때문에 그래서 더 귀를 기울이게 되거든요 저 같은 경우에는 그래서.",
                "sound_type": [
