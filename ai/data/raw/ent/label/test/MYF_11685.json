        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 아침밥을 먹으러 왔는데요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 3.487
            },
            {
                "speaker_id": "1",
                "transcription": "짜잔 바람의 핫도그를 먹으러 왔습니다.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 3.497,
                "end": 9.488
            },
            {
                "speaker_id": "1",
                "transcription": "어 제가 핫도그를 좋아하기도 하고 아침에 빵이랑 커피 먹고 싶어 가지고 바람의 핫도그 먹으러 왔거든요.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 9.498,
                "end": 16.664
            },
            {
                "speaker_id": "1",
                "transcription": "빵이 달짝지근하니 맛있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.674,
                "end": 35.449
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 저 너무 피곤해 가지고 글루콤 하나 먹고 여행 좀 시작해야겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.459,
                "end": 65.948
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 누른 다음에 잘 흔들어서 먹으면 됩니다.",
                "sound_type": [
