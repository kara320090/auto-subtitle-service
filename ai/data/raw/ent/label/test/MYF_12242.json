        "term": [
            {
                "speaker_id": "1",
                "transcription": "다혈질 그리고 마지막이 점액질 그래서 사람의 그 기질이라는 게 이런 체액의 그 함유량에 따라서 이렇게 다르게 되어 있었던 그때의 그 사람들의 믿음",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 12.981
            },
            {
                "speaker_id": "1",
                "transcription": "그 세계관을 바탕으로 이 향수들이 창작이 되었고요.",
                "sound_type": [
                    2
                ],
                "start": 12.991,
                "end": 16.507
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 바탕으로 러쉬에서 르네상스 스팟 프로그램이 있어요.",
                "sound_type": [
                    2
                ],
                "start": 16.517,
                "end": 20.422
            },
            {
                "speaker_id": "1",
                "transcription": "제가 그 스팟 프로그램을 고맙게도 러쉬의 초대로 받게 되었고.",
                "sound_type": [
                    2
                ],
