        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "음 여군 장교 모집 포스터였는데요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.550
            },
            {
                "speaker_id": "1",
                "transcription": "그때 제가 제 머리에 인제 종이 울렸죠.",
                "sound_type": [
                    2
                ],
                "start": 3.560,
                "end": 6.666
            },
            {
                "speaker_id": "1",
                "transcription": "제가 인생에 살면서 제 머리에 종이 울렸던 게 딱 2번 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 6.676,
                "end": 11.631
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째가 그 대학생 때 그 여군 모집 포스터를 보고 제가 잊혀졌던 꿈을 다시 상기하면서 제 머리에 인제 망치를 맞은 것처럼 종이 울렸죠.",
                "sound_type": [
                    2
                ],
                "start": 11.641,
                "end": 24.249
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 그 벽보를 떼와서 제 자취방에 붙여놓고 이제 여군이 되겠다고 2년 동안 준비를 한 거였거든요.",
                "sound_type": [
                    2
                ],
                "start": 24.259,
                "end": 30.870
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 1번 종이 울렸언 건 뭘까요?",
                "sound_type": [
                    2
                ],
                "start": 30.880,
                "end": 33.186
            },
            {
                "speaker_id": "1",
                "transcription": "군 생활 한 8년 차 9년 차쯤이었을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 33.196,
                "end": 37.564
            },
            {
                "speaker_id": "1",
                "transcription": "그때 인제 제가 아시는 분이 저한테 와서 부모님 용돈을 얼마드리냐고 물어보는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 37.574,
                "end": 43.695
            },
            {
                "speaker_id": "1",
                "transcription": "저는 인제 아 신랑과 제가 인제 같이 군 생활을 했으니까 어 용돈을 자신 있게 계속 저희 월급이 오르듯이 부모님한테 올려서 드렸었거든요.",
                "sound_type": [
                    2
                ],
                "start": 43.705,
                "end": 54.759
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 어 저희 부모님 용돈 각각 시부모님한테 40만 원 우리 엄마 아빠한테 40만 원 드립니다라고 이케 자신 있게 말을 했더니 저희 아시는 그 지인 분이 말씀하시는 거예요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 54.769,
                "end": 67.587
            },
            {
                "speaker_id": "1",
                "transcription": "아 그러세요.",
                "sound_type": [
                    2
                ],
                "start": 67.597,
                "end": 69.207
            },
            {
                "speaker_id": "1",
                "transcription": "어 저희는 각각 300만 원씩 드려요.",
                "sound_type": [
                    2
                ],
                "start": 69.217,
                "end": 72.933
            }
        ]
    },
    "summary": "인생에 살면서 머리에 종이 울렸던 게 2번 있는데 첫 번째는 대학생 때 여군 모집 포스터 보고 잊혀졌던 꿈을 다시 상기했던 때고 두 번째는 아시는 지인 분이 부모님 용돈 얼마드리냐길래 자신 있게 각각 40만 원 드린다고 말을 했다고 얘기한다.",
