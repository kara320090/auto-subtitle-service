                ],
                "start": 26.132,
                "end": 40.018
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 야 이번에는 찌울림이 괜찮았죠?",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 40.028,
                "end": 56.314
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 아침 입질이 시작되는 것 같네요.",
                "sound_type": [
                    1,
                    2,
                    4
                ],
                "start": 56.324,
                "end": 62.209
            },
            {
                "speaker_id": "1",
                "transcription": "신기하게 오늘 나온 붕어들이 첫 수를 제외하고는 전부 다 이 초강 몬스터 3 4칸에서 나왔습니다.",
                "sound_type": [
