            {
                "speaker_id": "1",
                "transcription": "야 붕어 한 마리 더 나왔는데요. 이 녀석도 아까 그 월척 붕어처럼 찌를 쭉 끌고 들어왔습니다.",
                "sound_type": [
                    1,
                    2,
