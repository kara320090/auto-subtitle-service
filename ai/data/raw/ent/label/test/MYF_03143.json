        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 사람의 모습이 이렇게 연상이 되거든요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.541
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 거기에 딱 어울리는 향수라고 저는 생각을 해요.",
                "sound_type": [
                    2
                ],
                "start": 3.551,
                "end": 6.933
            },
            {
                "speaker_id": "1",
                "transcription": "안타깝게 아직 한국에서 만날 수가 없는 게 조금 안타깝기는 해요.",
                "sound_type": [
                    2
                ],
                "start": 6.943,
                "end": 12.460
            },
            {
                "speaker_id": "1",
                "transcription": "제가 좀 물어보기는 했거든요.",
                "sound_type": [
                    2
                ],
                "start": 12.470,
                "end": 14.105
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 우리 구독자만이라도 공구 하면 안 되겠니?",
                "sound_type": [
                    2
                ],
                "start": 14.115,
                "end": 17.840
            },
            {
                "speaker_id": "1",
                "transcription": "막 이렇게 했는데 아직은 이렇게 한국, 아",
                "sound_type": [
                    2
                ],
                "start": 17.850,
                "end": 20.566
            }
        ]
    },
