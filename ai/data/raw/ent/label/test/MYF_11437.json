        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "잘 발리는데도 너무 무르지도 않고 해서 평소에 좀 간편하게 할 수 있을 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.941
            },
            {
                "speaker_id": "1",
                "transcription": "펄 없이 이렇게 밝혀주기만 하는 용도로 애굣살에 잘 쓸 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.951,
                "end": 9.946
            },
            {
                "speaker_id": "1",
                "transcription": "이마 축소술 살짝 여기 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.956,
                "end": 14.366
            },
            {
                "speaker_id": "1",
                "transcription": "오 이렇게 하니까 보인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.376,
                "end": 15.772
            },
            {
                "speaker_id": "1",
                "transcription": "살짝 보이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.782,
                "end": 16.788
            },
            {
                "speaker_id": "1",
                "transcription": "제가 느낄 때는 색깔이 티가 난다거나 그게 아니고 꿰맨 부위가 살짝 이렇게 볼록해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.798,
                "end": 23.368
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 엄청 티 나는 정도는 아니긴 한데 빛을 받으면 조금 알 수 있는 요런 느낌이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.378,
                "end": 32.000
            }
        ]
    },
    "summary": "한 여성이 평소에 간편하게 할 수 있고 애굣살에도 잘 쓸 것 같다 말하며 이마 축소술은 꿰맨 부위가 살짝 볼록한데 빛 받으면 조금 알 수 있으나 엄청 티 나는 정도 아니라고 설명한다.",
