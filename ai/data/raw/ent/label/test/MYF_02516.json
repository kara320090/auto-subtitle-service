        "term": [
            {
                "speaker_id": "1",
                "transcription": "옛날에 그런 말 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.334
            },
            {
                "speaker_id": "1",
                "transcription": "조선 시대 때 식초 몇 방울로 해서 머리를 헹구면 윤기와 두피에도 좋다고 그래서 저희가 샴푸 개발을 한 지를 되게 오래됐어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.344,
                "end": 11.357
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 아무래도 저희가 잘 만들려고 하니까 시간이 굉장히 오래 걸린 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 11.367,
                "end": 17.838
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 드디어 4월에 출시했습니다.",
                "sound_type": [
                    2
                ],
                "start": 17.848,
                "end": 20.634
            },
            {
                "speaker_id": "2",
                "transcription": "축하드려요.",
                "sound_type": [
                    2
                ],
                "start": 20.644,
                "end": 21.743
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 21.753,
                "end": 22.743
            },
            {
                "speaker_id": "2",
                "transcription": "진짜 뭐 하나 만드실 때 너무너무 고생을 하시면서 또 되게 정성을 다해서 만드시니까 그리고 예전에 제가 참여했던 작업이 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 22.753,
                "end": 34.680
            },
            {
                "speaker_id": "2",
                "transcription": "비누를 또 만드셨는데 그 비누향을 개발할 때 제가 참여했던 경험",
