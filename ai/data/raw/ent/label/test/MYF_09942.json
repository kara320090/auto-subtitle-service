        "term": [
            {
                "speaker_id": "1",
                "transcription": "1번째 향수는요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.806
            },
            {
                "speaker_id": "1",
                "transcription": "겔랑의 라 쁘띠 로브 누와르입니다.",
                "sound_type": [
                    2
                ],
                "start": 3.816,
                "end": 6.586
            },
            {
                "speaker_id": "1",
                "transcription": "겔랑 집안에서 만들어내는 이제 향수이고요.",
                "sound_type": [
                    2
                ],
                "start": 6.586,
                "end": 9.677
            },
            {
                "speaker_id": "1",
                "transcription": "향수의 역사에 대해서 조금 관심을 더 가지셔서 공부를 하신 분이라면은 겔랑이라는 집안이 향수의 역사에서 얼마나 큰 위치를 차지하고 있는지 여러분이 쉽게 아실 수 있으실 거예요.",
                "sound_type": [
                    2
                ],
                "start": 9.687,
                "end": 22.458
            },
            {
                "speaker_id": "1",
                "transcription": "라 쁘리 로브 누와르 같은 경우에는 정말 그 체리의 그 달콤달콤한 탑노트의 달달한 고런 느낌을 만나기가 좋은 향수고요.",
                "sound_type": [
