        "term": [
            {
                "speaker_id": "1",
                "transcription": "겉도 바삭하게 튀겼어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.095
            },
            {
                "speaker_id": "1",
                "transcription": "이어서 유부 롤 다른 것들이 너무 맛있으니까 제 느낌에는 상대적으로 유부 롤이 조금 빠지는 거 같았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.105,
                "end": 8.958
            },
            {
                "speaker_id": "1",
                "transcription": "물론 유부 롤도 굉장히 훌륭하게 맛있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.968,
                "end": 11.467
            },
            {
                "speaker_id": "1",
                "transcription": "이어서 봉구 가래 떡볶이 계속 먹습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.477,
                "end": 15.463
            },
            {
                "speaker_id": "1",
                "transcription": "어 먹다 보니까 정말 한 점도 남김없이 이렇게 초토화를 시켰습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.473,
                "end": 24.621
            },
            {
                "speaker_id": "1",
                "transcription": "그 정도로 정말 정말 맛있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.631,
                "end": 26.948
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 진짜 너무 맛있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.958,
                "end": 28.767
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 오늘은 여기까지 까트 준혁이 안녕 아빠 보고 안녕.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.777,
                "end": 33.580
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키도 안녕 쿠키 빠빠이 까트 쿠키 뿅 쿠키 고생했으니까 쿠키도 한입",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.590,
                "end": 42.133
            }
        ]
    },
    "summary": "한 남성이 집으로 포장해 온 음식을 맛보며 평가하고 있다.",
