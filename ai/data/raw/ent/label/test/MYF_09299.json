        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 그러한 디저트의 달달한 달콤한 고 향을 만나기 굉장히 좋은 향수예요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 8.563
            },
            {
                "speaker_id": "1",
                "transcription": "어 그리고 제가 이 향수를 추천해야겠다 싶었던 거는 뭐랄까?",
                "sound_type": [
                    2
                ],
                "start": 8.573,
                "end": 14.237
            },
            {
                "speaker_id": "1",
                "transcription": "그 영화에서 보면 여러 가지 막 클리셰가 있잖아요.",
                "sound_type": [
                    2
                ],
                "start": 14.247,
                "end": 18.455
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 우리 살아서 만나 그러면 꼭 뭔가 둘 중에 하나가 살아서 만나지 않게 되거나 뭐 약간 이런 클리셰 같은 그런 부분들이 어 뭐랄까 이야기의 전개를 우리가 뭐 예상할 수 있게 하는 그런데 고런 느낌을 좀 주는 거 향수거든요.",
                "sound_type": [
                    2
                ],
                "start": 18.465,
                "end": 37.748
            },
            {
                "speaker_id": "1",
                "transcription": "약간의 그런 디저트 계열의 향수로 우리가 이야기를 할 때 좀 만나고 싶었던",
                "sound_type": [
                    2
                ],
                "start": 37.758,
                "end": 44.778
            }
        ]
    },
    "summary": "이 향수를 추천하는 이유는 클리셰 같은 이야기의 전개를 예상할 수 있게 하는 그런 느낌을 주는 향수다.",
