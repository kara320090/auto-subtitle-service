        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 이제 제 첫 미연시 게임이라는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.540
            },
            {
                "speaker_id": "1",
                "transcription": "아까 그 어드벤처 오브 플라워는 미연시가 아니죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.550,
                "end": 5.910
            },
            {
                "speaker_id": "1",
                "transcription": "네 헷갈릴 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.910,
                "end": 8.104
            },
            {
                "speaker_id": "1",
                "transcription": "미연시처럼 생겼지만 그거는 미연시가 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.109,
                "end": 10.765
            },
            {
                "speaker_id": "1",
                "transcription": "엄연히 캐릭터를 강하게 키우는 육성게임이기 때문에 미연시가 아니고 러브인 로그인이 미연시입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.775,
                "end": 16.690
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 선물 받아서 플레이를 해보니까 꽤나 할만하더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.680,
                "end": 20.310
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 스토브인디에서",
                "sound_type": [
