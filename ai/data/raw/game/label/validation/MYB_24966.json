            },
            {
                "speaker_id": "1",
                "transcription": "로컬과 온라인으로 함께 할 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.088,
                "end": 6.050
            },
            {
                "speaker_id": "1",
                "transcription": "스팀에 이런 속담이 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.060,
                "end": 7.625
            },
            {
                "speaker_id": "1",
                "transcription": "둘이 할 거면 잇 테이크스 투 셋이 할 거면 포더 킹이다.",
