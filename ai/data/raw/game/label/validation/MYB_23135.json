        "term": [
            {
                "speaker_id": "1",
                "transcription": "예전에 유저 한글 패치 나왔을 때 소개했던 게임이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.938
            },
            {
                "speaker_id": "1",
                "transcription": "96번 도로 에 스팀에서 로드 96를 6월 19일까지 65퍼센트 할인해서 7700원에 판매 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.948,
                "end": 10.580
            },
            {
                "speaker_id": "1",
                "transcription": "어떠한 이유 때문에 아이들이 나라를 떠나기 위해서 국경으로 도망치고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.590,
                "end": 15.374
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 우리도 그 중 하나인 청소년이 되어서 에 96번 도로를 통해서 국경으로 떠나는 내용이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.384,
                "end": 20.877
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그 과정에서 다양한 사람들을 도로 위에서 만나고 이야기를 나누고 우리는 선택을 내립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.887,
                "end": 26.673
            },
            {
                "speaker_id": "1",
                "transcription": "선택에 따라 결과가 과정이 바뀌는 게임 그래서 반복해서 플레이할 때마다 새로운 사람들을 만나구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.683,
                "end": 32.570
            },
            {
                "speaker_id": "1",
                "transcription": "새로운 스토리를 보게 되는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.580,
                "end": 34.390
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 96번 도로 최고의 장점 중 하나는 바로 BGM인데요.",
                "sound_type": [
                    2,
                    3
                ],
