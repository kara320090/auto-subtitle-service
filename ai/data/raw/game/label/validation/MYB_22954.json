        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 저는 그냥 그 디펜스 2탄인 줄 알았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.529
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이건 뱀서가 좀서로 바뀐 거다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.539,
                "end": 5.050
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 재미는 있어 보여요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.060,
                "end": 6.748
            },
            {
                "speaker_id": "1",
                "transcription": "특이점으로는 동료를 함께 스쿼드로 운영을 할 수 있는 점이 재밌어 보인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.758,
                "end": 11.370
            },
            {
                "speaker_id": "1",
                "transcription": "스쿼드 구성원들에게 각기 다른 무장을 둘러주고 하면은 또 재밌지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.380,
                "end": 15.980
            },
            {
                "speaker_id": "1",
                "transcription": "어 이제는 뱀서가 아니라 좀서네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.986,
                "end": 18.268
            },
            {
                "speaker_id": "1",
                "transcription": "또 오해하시면 안 되는 게 멀티 게임이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.268,
                "end": 20.472
            },
            {
                "speaker_id": "1",
                "transcription": "싱글 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
