        "term": [
            {
                "speaker_id": "1",
                "transcription": "하데스는 원탑인 줄 알아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.603
            },
            {
                "speaker_id": "1",
                "transcription": "액션 로그라이크 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.613,
                "end": 2.759
            },
            {
                "speaker_id": "1",
                "transcription": "지금 영상에 나오는 게임처럼 비스무리하게 생긴 게임들을 엄청 많이 보셨을 텐데 그중에는 하데스가 최고라는 거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.769,
                "end": 9.561
            },
            {
                "speaker_id": "1",
                "transcription": "예 무기를 골라가며 즐기는 액션의 재미.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.571,
                "end": 12.116
            },
            {
                "speaker_id": "1",
                "transcription": "올림푸스 신들의 능력을 조합해가며 사용하는 재미.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.126,
                "end": 14.973
            },
            {
                "speaker_id": "1",
                "transcription": "로그라이크의 특성상 높은 난이도 때문에 죽으면 다시 지옥으로 돌아와서 처음부터 해야 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.983,
                "end": 21.366
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 죽는 것마저도 재밌다는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.376,
                "end": 23.590
            },
            {
                "speaker_id": "1",
                "transcription": "예 죽음마저 극복한 재미.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.600,
                "end": 25.271
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 죽었을 때 진행되는 스토리가 재밌더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.281,
                "end": 28.535
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이렇게 생긴 로그라이크 게임 플레이하고 싶다면 그냥 이 게임 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.545,
                "end": 33.000
            }
        ]
    },
    "summary": "지금 영상에 나오는 게임처럼 비슷하게 생긴 게임들을 엄청 많이 보셨을 텐데 그중에는 하데스가 최고라고 하고 싶다.",
