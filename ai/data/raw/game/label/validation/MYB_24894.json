                ],
                "start": 0.000,
                "end": 6.368
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 12월 최고의 힐링 게임이었더라 마블과 덱빌딩 그리고 엑스컴이 만났습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.378,
                "end": 11.967
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이게 대체 뭔 조합인가 싶지만 결과는 꿀잼이더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.977,
                "end": 15.164
            },
            {
                "speaker_id": "1",
                "transcription": "12월 2일 출시한 마블의 미드 나잇 선즈를 많은 스팀 유저들이 플레이했네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.174,
                "end": 20.333
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 얼마 전에 말씀을 드렸기 때문에 짧게 넘어가자면은.",
                "sound_type": [
                    2,
                    3
                ],
