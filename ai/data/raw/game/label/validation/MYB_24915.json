                "end": 7.782
            },
            {
                "speaker_id": "1",
                "transcription": "우리는 아래로 깊이 내려가서 무슨 일이 벌어졌는지 알아 내야 되는데요.",
                "sound_type": [
                    2,
                    3
                ],
