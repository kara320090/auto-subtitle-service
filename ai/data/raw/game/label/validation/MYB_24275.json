        "term": [
            {
                "speaker_id": "1",
                "transcription": "세계관과 스토리를 이해하려면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.427
            },
            {
                "speaker_id": "1",
                "transcription": "플레이어가 스스로 막 파고들어야 되기 때문에 이해하기 어렵습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.437,
                "end": 6.446
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 스토리랑 세계관의 난도가 스토리랑 세계관의 난도가 높아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.456,
                "end": 11.539
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래서 이걸 이해하기 위한 난도가 높습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.549,
                "end": 14.015
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저도 뭐 라이브러리 오브 루이나 뭐 로보토미 코퍼레이션 플레이를 해봤는데 진짜 못하겠더라고요 저는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.025,
                "end": 19.710
            },
            {
                "speaker_id": "1",
                "transcription": "네 이해가 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.710,
                "end": 20.770
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 그 매력 때문에 많은 분들이 프로젝트 문의 게임을 좋아하기도 하시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.770,
                "end": 24.960
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임이 얼마나 디테일하냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.960,
                "end": 26.490
            },
            {
                "speaker_id": "1",
                "transcription": "게임 출시를 2월 27일에 했잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.490,
                "end": 28.930
            },
            {
                "speaker_id": "1",
                "transcription": "이 2월 27일은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.930,
                "end": 30.532
            },
            {
                "speaker_id": "1",
                "transcription": "전작에 등장하던",
