                    2,
                    3
                ],
                "start": 3.297,
                "end": 5.545
            },
            {
                "speaker_id": "1",
                "transcription": "원피스 극장판을 보는 느낌의 스토리다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.555,
                "end": 8.576
            },
            {
                "speaker_id": "1",
                "transcription": "이거 하나만으로도 원피스 팬이라면 플레이해볼 만한 가치가 있어 보이고 연출 좋고 이를 받쳐주는 BGM 특히 BGM이 역대급이라는 이야기가 종종 있는 걸로 봐서는 노래는 잘 뽑았나 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.586,
                "end": 20.643
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 사람들이 많이 지적하는 단점은요.",
