        "term": [
            {
                "speaker_id": "1",
                "transcription": "좀 더 매끄럽게 해줬으면 어땠을까 많이 아쉽습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.716
            },
            {
                "speaker_id": "1",
                "transcription": "참고로 그린맨 게이밍 골든위크에서도 세일 중이지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.726,
                "end": 6.885
            },
            {
                "speaker_id": "1",
                "transcription": "스팀보다 비쌉니다. 얘는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.895,
                "end": 8.412
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 그냥 스팀에서 사는 게 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.422,
                "end": 11.258
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기까지 할인하는 게임들 중 꿀잼 게임들을 모아서 소개하고 추천하는 영상이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.268,
                "end": 16.610
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 그린맨 게이밍 골든 위크 세일에서 굉장히 좋은 할인율로 많이 나와서 여기 위주로 소개를 했네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.620,
                "end": 22.706
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 소개한 것 말고도 레데리 2 같은 경우도 71퍼센트나 할인하고 있고 굉장히 좋은 가격의 게임들이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.716,
                "end": 28.706
            },
            {
                "speaker_id": "1",
                "transcription": "한 번 둘러보시는 걸 추천을 드려요.",
                "sound_type": [
                    2,
