                ],
                "start": 28.716,
                "end": 30.583
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아 오도록 하겠습니다.",
                "sound_type": [
