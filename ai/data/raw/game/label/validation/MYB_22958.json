        "term": [
            {
                "speaker_id": "1",
                "transcription": "미스터리한 연출.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.964
            },
            {
                "speaker_id": "1",
                "transcription": "기가 막힌데 기대가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.974,
                "end": 2.487
            },
            {
                "speaker_id": "1",
                "transcription": "참고로 제가 앨런 웨이크 2를 기대하는 이유는요 놀랍게도 스토리 때문이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.497,
                "end": 7.705
            },
            {
                "speaker_id": "1",
                "transcription": "예 저는 전투 때문에 기대돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.715,
                "end": 9.486
            },
            {
                "speaker_id": "1",
                "transcription": "컨트롤에서 발전했던 이 슈팅 액션을 어떻게 앨런 웨이크에 적용할지 궁금해지더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.496,
                "end": 14.816
            },
            {
                "speaker_id": "1",
                "transcription": "기대가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.816,
                "end": 15.767
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 무료 배포 소식과 함께 한 주간의 흥미로운 게임 소식을 함께 알아봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.777,
                "end": 20.772
            },
            {
                "speaker_id": "1",
                "transcription": "사실 이 게임 라디오 콘텐츠는 원래 올해부터 예 라이브 영상으로 진행을 할 콘텐츠였는데 자꾸 이게 미뤄지게 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.782,
                "end": 28.090
            },
            {
                "speaker_id": "1",
                "transcription": "제가 꼭 조만간 게임 라디오는 라이브로 도전을 해보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.100,
                "end": 32.438
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게라도 영상에서 얘기를 해야지 제가 더 이상 안 미루고 도전을 하겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.448,
                "end": 36.915
            },
            {
                "speaker_id": "1",
                "transcription": "좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.925,
                "end": 37.473
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.483,
                "end": 38.784
            },
            {
                "speaker_id": "1",
                "transcription": "더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.797,
                "end": 40.968
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
