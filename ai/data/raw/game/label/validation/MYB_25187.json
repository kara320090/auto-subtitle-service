        "term": [
            {
                "speaker_id": "1",
                "transcription": "제 기도가 통한 걸까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.355
            },
            {
                "speaker_id": "1",
                "transcription": "얼마 전에 스타워즈 제다이 오더의 몰락의 후속작인 서바이버가 공개되었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.365,
                "end": 5.828
            },
            {
                "speaker_id": "1",
                "transcription": "저는 항상 이 게임의 후속작이 나오길 바랬었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.838,
                "end": 8.771
            },
            {
                "speaker_id": "1",
                "transcription": "스타워즈 제다이 오더의 몰락은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.781,
                "end": 10.782
            },
            {
                "speaker_id": "1",
                "transcription": "약간 어려운 소울 라이크 액션 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.792,
                "end": 13.212
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임의 강점은 스타워즈 비지엠 미쳤죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.222,
                "end": 15.877
            },
            {
                "speaker_id": "1",
                "transcription": "스타워즈 광선검 미쳤죠.",
