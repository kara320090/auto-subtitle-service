                "end": 11.430
            },
            {
                "speaker_id": "1",
                "transcription": "왜 이 게임이 캐주얼한 게임이냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.430,
                "end": 13.472
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거는 이제 장단점이 될 수도 있을 것 같아요.",
                "sound_type": [
