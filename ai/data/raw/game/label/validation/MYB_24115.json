        "term": [
            {
                "speaker_id": "1",
                "transcription": "응원의 메세지같은 경우는 스팀 창작 마당에 올려주셔도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.644
            },
            {
                "speaker_id": "1",
                "transcription": "다만 배포는 배군의 해피라이프 블로그에서 이제 한글 패치 만드신 라자루스님께 허락을 맡고 패치 파일을 블로그에 업로드를 해놨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.654,
                "end": 13.951
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 받아서 한글 패치를 하셔도 좋을 것 같아요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.961,
                "end": 17.368
            },
            {
                "speaker_id": "1",
                "transcription": "친절하게도 한글 패치 방법이나 적용순서까지 자세하게 설명을 해놨더라구요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.378,
                "end": 22.912
            },
            {
                "speaker_id": "1",
                "transcription": "이거 보고 한글 패치를 받으시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.922,
                "end": 25.491
            },
            {
                "speaker_id": "1",
                "transcription": "우리 모두 기계 교단에 가입합시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.501,
