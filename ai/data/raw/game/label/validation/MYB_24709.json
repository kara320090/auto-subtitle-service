        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여기까지 오늘의 스팀 할인 영상이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.348
            },
            {
                "speaker_id": "1",
                "transcription": "채널의 아이콘이 바뀐 거는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.358,
                "end": 4.771
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이 아이콘으로 바꿔서 쭉 가겠다 뭐 이렇게 생각한 건 아니고 요즘 그런 게 화제 잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.781,
                "end": 10.370
            },
            {
                "speaker_id": "1",
                "transcription": "에이아이가 그림을 그려주는 어 이 인공 지능 놈들이 그림을 그려주는 게 화제라서 저도 좀 가지고 놀아 봤거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.370,
                "end": 17.531
            },
            {
                "speaker_id": "1",
                "transcription": "와 그런데 너무 잘 그립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.541,
                "end": 19.002
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저도 깜짝 놀랐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.012,
                "end": 20.042
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 막 그리다가 마침 채널 아이콘도 바꾸기는 해야 되잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.052,
                "end": 23.829
            },
            {
                "speaker_id": "1",
                "transcription": "제가 바꾼다 생각만 하고 이제 안 바꾸고 있었는데 재미 삼아 테스트 겸 에이아이가 그린 그림을 적용해 봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.839,
                "end": 30.649
            },
            {
                "speaker_id": "1",
                "transcription": "대단하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.659,
                "end": 31.331
            },
            {
                "speaker_id": "1",
                "transcription": "에이아이들 에 진짜로 무섭습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.341,
                "end": 33.345
            },
            {
                "speaker_id": "1",
                "transcription": "곧 있으면 디트로이트 비컴 후먼의 시대가 찾아오겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.355,
                "end": 36.482
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재미있는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.492,
                "end": 40.224
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.234,
                "end": 41.366
            }
        ]
    },
