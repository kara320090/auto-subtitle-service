                    2,
                    3
                ],
                "start": 8.315,
                "end": 11.234
            },
            {
                "speaker_id": "1",
                "transcription": "외계인은 다 쳐 죽여야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.244,
                "end": 13.541
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 외계인만 죽인다고 끝나는 게 아니다.",
