        "term": [
            {
                "speaker_id": "1",
                "transcription": "초능력자들 사이에서 활약을 하는 내용이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.171
            },
            {
                "speaker_id": "1",
                "transcription": "벌써 짜릿하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.181,
                "end": 2.983
            },
            {
                "speaker_id": "1",
                "transcription": "주변에 다 능력자들인데 나 혼자 아무런 힘도 없이 오직 추리 능력 하나만으로 승부를 보니까 장점은 캐릭터성와 스토리를 잘 만들었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.993,
                "end": 11.299
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 한편의 애니메이션같은 뭐 재밌는 스토리 좋아하시면 추천을 드리고 개인적으로 캐릭터성과 스토리는 역전재판보다도 더 재밌는 느낌.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.309,
                "end": 19.226
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 추리의 재미가 상중하면 상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.236,
                "end": 22.128
            },
            {
                "speaker_id": "1",
                "transcription": "기본적으로 추리의 허점은 좀은 많은 편이기 때문에 이거를 너무 신경을 쓰다 보면 몰입이 깨지기 마련이지만 빡빡하게 보지 않는다면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.138,
                "end": 30.176
            },
            {
                "speaker_id": "1",
                "transcription": "굉장히 잘 만든 추리에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.186,
                "end": 31.716
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 개발진이 클리셰를 극복하고자",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.726,
                "end": 34.400
            }
        ]
    },
    "summary": "그는 초능력자들 사이에서 활약하는 추리 능력자의 이야기임을 설명하고 추리의 재미가 높으며 캐릭터성과 스토리가 재밌는 게임이라고 소개하고 있다.",
