        "term": [
            {
                "speaker_id": "1",
                "transcription": "가족과 해도 좋을 것 같고 아바타 자체가 너무나 좋은 가족 영화이기 때문에 가족과 함께 플레이 하는 것도 굉장히 좋을 것 같다.",
                "sound_type": [
