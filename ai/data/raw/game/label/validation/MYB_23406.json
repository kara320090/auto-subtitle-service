        "term": [
            {
                "speaker_id": "1",
                "transcription": "아시아에서는 나름 공포 깎는 장인 중의 하나인 나라가 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.268
            },
            {
                "speaker_id": "1",
                "transcription": "바로 태국입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.278,
                "end": 4.376
            },
            {
                "speaker_id": "1",
                "transcription": "태국에 오컬트적인 무엇이나가 많이 있는지 은근히 이런 공포 장르를 좋아하더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.386,
                "end": 10.539
            },
            {
                "speaker_id": "1",
                "transcription": "그 태국의 공포 명작 홈 스위트 홈이 스토브인디에서 공식 한글화 되었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.549,
                "end": 15.682
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임 유명한 게임이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.692,
                "end": 17.056
            },
            {
                "speaker_id": "1",
                "transcription": "제가 한글화가 되고 잠깐 해보긴 했는데 사실 이 게임은 오래 전부터 알고 있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.066,
                "end": 22.265
            },
            {
                "speaker_id": "1",
                "transcription": "제가 플레이 해 본 건 아니고 다른 유튜버 분이 플레이 하는 걸 봤었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.275,
                "end": 26.233
            }
        ]
    },
    "summary": "한 남성이 새롭게 한글화된 게임 소개하면서 내용을 설명하고 있다.",
