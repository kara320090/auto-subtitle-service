        "term": [
            {
                "speaker_id": "1",
                "transcription": "그냥 밝혀내는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.366
            },
            {
                "speaker_id": "1",
                "transcription": "이 귀신 놈들이 공포 분위기도 자꾸 조성하고 우리를 죽일 수도 있기 때문에 무섭다 귀신이 나오는 집을 함께 똘똘뭉쳐서 들어가는 것만큼 협동이 필요 한 게임은 없겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.376,
                "end": 12.395
            },
            {
                "speaker_id": "1",
                "transcription": "최대 네명이 함께 온라인으로 플레이할 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.405,
                "end": 15.858
            },
            {
                "speaker_id": "1",
                "transcription": "망망대해서 뗏목 하나에 의지해 크래프팅하는 게임 레프트입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.868,
                "end": 20.315
            },
            {
                "speaker_id": "1",
                "transcription": "올해 정식 출시를 했죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.325,
                "end": 21.970
            },
            {
                "speaker_id": "1",
                "transcription": "모든 스토리가 완결이 되었는데 왜 이렇게 바다밖에 없는 건지 대체 어 어떤 스토리 인지는 직접 밝혀보시면 되고 뗏목에서 바다에 떠다니는 고철이나 쓰레기들을 주워서 크래프팅을 하는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.980,
                "end": 33.763
            },
            {
                "speaker_id": "1",
                "transcription": "일단 컨셉 자체가 재미있죠.",
