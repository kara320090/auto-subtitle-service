        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다이렉트 게임즈에서 구매해야지만 한글로 플레이할 수 있다는 점입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.925
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 점이 조금은 아쉽네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.935,
                "end": 5.807
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 훌륭한 액션 게임을 무료 배포로 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.817,
                "end": 8.790
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 호그와트 레거시 평가가 하도 좋아서 만들어본 영상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.800,
                "end": 13.151
            },
            {
                "speaker_id": "1",
                "transcription": "저도 빨리 지금 모자를 뒤집어쓰고 기숙사를 배정받고 싶습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.161,
                "end": 17.074
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 기숙사가 나올지 모르겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.084,
                "end": 18.919
            },
            {
                "speaker_id": "1",
                "transcription": "평소 행실과 마인드를 생각하면 슬리데린인데 또 아무래도 영화에서 그린핀도르가 주인공 기숙사니까 그쪽으로 가고 싶긴 하고 기대가 많이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.929,
                "end": 28.797
            },
            {
                "speaker_id": "1",
                "transcription": "다들 호그와트에서 만나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.807,
                "end": 31.066
            }
        ]
    },
    "summary": "유튜버는 다이렉트 게임즈에서만 한글 지원이 되지만 훌륭한 액션 게임을 무료 배포로 준다는 점을 뒤로 하고 호그와트에서 만나자고 인사하고 있습니다.",
