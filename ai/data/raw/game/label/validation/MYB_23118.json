                ],
                "start": 0.000,
                "end": 8.005
            },
            {
                "speaker_id": "1",
                "transcription": "건물도 부서지고 벽을 부숴버리고 진입할 수도 있겠죠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.015,
