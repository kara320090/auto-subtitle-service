        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠폰 입력란에 듀리듀리를 입력하신다면 우리 듀리 시청자분들을 위해서 추가로 15퍼센트 할인을 준비해 주셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.765
            },
            {
                "speaker_id": "1",
                "transcription": "이 쿠폰은 일립스 말고 오늘 소개하는 다른 게임에도 다 적용이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.775,
                "end": 12.798
            },
            {
                "speaker_id": "1",
                "transcription": "도리도리 아니죠 듀리듀리를 입력하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.808,
                "end": 16.000
            },
            {
                "speaker_id": "1",
                "transcription": "우리만 쓸 수 있는 이런 추가 할인 참 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.010,
                "end": 18.259
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다면 일립스 어떤 게임이냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.269,
                "end": 19.860
            },
            {
                "speaker_id": "1",
                "transcription": "처음 보는 분들은 이렇게 생각할 수도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.870,
                "end": 22.200
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 마치 할로우나이트 같은 메트로배니아 게임인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.210,
                "end": 26.241
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분위기가 풍기긴 하지만요 할로우나이트 같은 메트로배니아는 아니에요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.251,
                "end": 31.209
            },
            {
                "speaker_id": "1",
                "transcription": "메트로배니아를 생각하고 이 게임을 플레이 하시면 안 되고 오히려 일직선 구조의",
                "sound_type": [
