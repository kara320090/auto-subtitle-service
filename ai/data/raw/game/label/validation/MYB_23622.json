                ],
                "start": 0.000,
                "end": 8.155
            },
            {
                "speaker_id": "1",
                "transcription": "어 집에서 매일 농사를 지어야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.165,
                "end": 10.782
            },
            {
                "speaker_id": "1",
                "transcription": "리얼하게 짓습니다.",
