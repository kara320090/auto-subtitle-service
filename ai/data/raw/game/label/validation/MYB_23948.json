        "term": [
            {
                "speaker_id": "1",
                "transcription": "액션 로그라이크 핵앤슬래시 류의 게임이고 아마존 숲에서 다양한 캐릭터를 플래이 하며 액션을 즐기면 되는 간단한 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.180
            },
            {
                "speaker_id": "1",
                "transcription": "근데 특이한 점은 손그림이라고 설명이 되어 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.190,
                "end": 12.591
            },
            {
                "speaker_id": "1",
                "transcription": "어 진짜 손으로 그렸는지는 확인할 수 없지만 독특하고 개성 있는 그림체인 거 보니까 개발자분께서 열심히 손으로 그렸나 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.601,
                "end": 20.331
            },
            {
                "speaker_id": "1",
                "transcription": "보니까 캐릭터가 꽤나 다양해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.341,
                "end": 22.687
            },
            {
                "speaker_id": "1",
                "transcription": "아는 분들은 아시겠지만 어 햇 인 타임이라는 게임의 모자 쓴 캐릭터도 보인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.697,
                "end": 27.643
            },
            {
                "speaker_id": "1",
                "transcription": "툰체는요 싱글로 플레이 해도 최대 3명까지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.653,
                "end": 30.666
            }
        ]
    },
    "summary": "툰체는 아마존 숲에서 다양한 캐릭터를 플래이 하며 액션을 즐기는 간단한 게임이고 개발자가 손으로 캐릭터를 그렸다는 점이 특이하다.",
