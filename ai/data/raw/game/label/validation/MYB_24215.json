        "term": [
            {
                "speaker_id": "1",
                "transcription": "안녕하세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.487
            },
            {
                "speaker_id": "1",
                "transcription": "한 주간의 흥미로운 게임 소식을 전달해 드리는 게임 라디오 시간입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.497,
                "end": 4.230
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 무료 배포 소식이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.240,
                "end": 6.017
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 스토어에서 3월 16일까지 콜 오브 더 씨를 무료배포 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.027,
                "end": 10.412
            },
            {
                "speaker_id": "1",
                "transcription": "1930년대 남태평양을 배경으로 한 수수께끼와 사랑에 대한 퍼즐 어드벤쳐 게임이라고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.422,
                "end": 17.619
            },
            {
                "speaker_id": "1",
                "transcription": "사라진 남편과 그 조사대를 찾기 위해 주인공 로라가 남태평양의 한 섬을 헤매는 이야기인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.629,
                "end": 23.920
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 서로 애틋하게 여기는 부부의 스토리가 참 좋은 게임이라고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.930,
                "end": 28.054
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 시대의 사랑 이야기를 담은 게임이라니 낭만이 좀 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.064,
                "end": 31.263
            },
            {
                "speaker_id": "1",
                "transcription": "한국어 지원도 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.273,
                "end": 32.462
            },
            {
                "speaker_id": "1",
                "transcription": "전체적인 평가가 꽤 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.472,
                "end": 33.873
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 뭐 스토리가 좋고 음악이나 그래픽이 좋다는 이야기가 많네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.883,
                "end": 38.638
            },
            {
                "speaker_id": "1",
                "transcription": "3월 17일까지 받을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.648,
                "end": 41.233
            }
        ]
    },
    "summary": "에픽 스토어에서 3월 16일까지 콜 오브 더씨를 무료배포 중인데 1930년대 남태평양을 배경으로 한 수수께끼와 사랑에 대한 퍼즐 어드벤쳐 게임이며 사라진 남편과 그 조사대를 찾기 위해 주인공 로라가 남태평양의 한 섬을 헤매는 이야기이다.",
