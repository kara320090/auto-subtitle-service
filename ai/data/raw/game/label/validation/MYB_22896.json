        "term": [
            {
                "speaker_id": "1",
                "transcription": "디아4의 스팀 출시 관련해서 빠른 결단을 내릴 수도 있을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.293
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 오버워치2 스팀 출시에서 볼 수 있는 블리자드와 MS의 행보였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.303,
                "end": 9.657
            },
            {
                "speaker_id": "1",
                "transcription": "이왕이면 플랫폼이 여러 군데로 갈리는 건 썩 좋지 않죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.667,
                "end": 12.783
            },
            {
                "speaker_id": "1",
                "transcription": "MS의 블리자드 인수가 완료된다면 사실 배틀넷이 없어질 수도 있을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.793,
                "end": 18.095
            },
            {
                "speaker_id": "1",
                "transcription": "MS는 이미 마이크로소프트 스토어와 엑스박스 앱이 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.105,
                "end": 21.724
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 배틀넷이 필요 없는 상황이기 때문에 배틀넷이 없어지거나 엑스박스 앱으로 합류될 수도 있겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.734,
                "end": 27.321
            },
            {
                "speaker_id": "1",
                "transcription": "에 이런 생각을 해봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.331,
                "end": 28.729
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.739,
                "end": 32.118
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
