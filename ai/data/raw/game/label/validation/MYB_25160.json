        "term": [
            {
                "speaker_id": "1",
                "transcription": "산나비 역시 주목해 보셔도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.851
            },
            {
                "speaker_id": "1",
                "transcription": "마치 세키로와 다크 소울을 플레이하는 것만 같은 인디 게임 베이퍼 월드입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.861,
                "end": 7.678
            },
            {
                "speaker_id": "1",
                "transcription": "그 횡스크롤 액션 게임이고 작화와 디자인이 눈에 확 들어오는 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.688,
                "end": 12.247
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로 생각하는 최고의 장점은 게임의 분위기와 더불어서 타격감이 너무나 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.257,
                "end": 17.510
            },
            {
                "speaker_id": "1",
                "transcription": "예 묵직한 타격감이 최고의 장점 또 플레이 방식은 마치 세키로처럼 적의 공격을 패링으로 튕겨내면서 반격을 하는 식인데 역시나 묵직하고 타격감이 좋았지만 제가 플레이에 본 베이퍼 월드의 이제 문 제점이 하나 있는데 패링을 위주로 플레이 하면은 게임이 일단 재미 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.520,
                "end": 33.355
            },
            {
                "speaker_id": "1",
                "transcription": "예 게임의 장점인 타격감을 100퍼센트 발휘하면서 재미진데 어려운 부분이 있어요 난이도가 조금 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.365,
                "end": 40.224
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 회피를 위주로 플레이하면은 게임의 난이도가 굉장히 내려 가는데요 문제는요 재미가 없어집니다 예.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.234,
                "end": 47.400
            }
        ]
    },
    "summary": "베이퍼 월드는 횡스크롤 액션 게임이고 작화와 디자인이 눈에 확 들어오고 게임의 분위기와 더불어서 타격감이 너무나 좋지만 단점이 패링을 위주로 게임을 하면 재미있지만 난이도가 높고 회피 위주로 하면 난이도는 낮지만 재미가 없다는 것이다.",
