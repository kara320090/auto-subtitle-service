        "term": [
            {
                "speaker_id": "1",
                "transcription": "다른 게임들처럼 싸움을 잘하는 주인공이 아니라 그냥 귀여운 쥐에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.403
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 직업이 음유 시인인 쥐이기 때문에 전투에 탁월하지는 못하다는 것 대신 귀엽긴 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.413,
                "end": 10.161
            },
            {
                "speaker_id": "1",
                "transcription": "전투에 능숙하지 못한 대신 잠입을 하고 빠르게 움직이고 머리를 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.171,
                "end": 16.178
            },
            {
                "speaker_id": "1",
                "transcription": "굉장히 귀여운 쥐를 무료로 줘서 고맙네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.188,
                "end": 19.788
            },
            {
                "speaker_id": "1",
                "transcription": "게임을 받는 방법은요 여기 고투 기부 어웨이.",
                "sound_type": [
