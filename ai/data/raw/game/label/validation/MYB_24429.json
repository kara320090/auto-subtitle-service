        "term": [
            {
                "speaker_id": "1",
                "transcription": "와룡 폴른 다이너스티 출시가 약 5일 정도 남았는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.645
            },
            {
                "speaker_id": "1",
                "transcription": "와룡의 데모 버전을 우리가 지금 플레이 할 수 있게 되었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.655,
                "end": 7.040
            },
            {
                "speaker_id": "1",
                "transcription": "인왕시리즈를 삼국지 컨셉으로 만들었다고 생각을 하면 좋은데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.050,
                "end": 11.331
            },
            {
                "speaker_id": "1",
                "transcription": "저는요. 인왕도 좋아하고요. 삼국지도 좋아합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.341,
                "end": 14.617
            },
            {
                "speaker_id": "1",
                "transcription": "이거 안 해 볼 이유가 없죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.627,
                "end": 15.974
            },
            {
                "speaker_id": "1",
                "transcription": "근데 오늘 제가 스팀페이지를 쓱 보니까 이제 약 오르는 문구가 하나 있는데",
                "sound_type": [
                    2,
