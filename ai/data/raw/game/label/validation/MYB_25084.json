        "term": [
            {
                "speaker_id": "1",
                "transcription": "마지막은 압도적으로 긍정적인 평가를 받은 게임 후즈 라일라입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.823
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임도 제가 플레이를 안 해봤는데 너무나 특이하고 독특해서 뭔 게임인지 모르겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.833,
                "end": 9.905
            },
            {
                "speaker_id": "1",
                "transcription": "네 공포 미스터리 어드벤처 게임으로 깜놀 요소가 등장하는 공포 게임은 아니고 으스스한 분위기만 내는 공포 게임이지만 이 독특한 게임성이 흥미로운데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.915,
                "end": 20.880
            },
            {
                "speaker_id": "1",
                "transcription": "무려 캐릭터의 얼굴을 조작해서 게임을 진행하는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.877,
                "end": 24.020
            },
            {
                "speaker_id": "1",
                "transcription": "각 상황에 걸맞는 표정을 우리가 수동으로 조작을 해야 되는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.030,
                "end": 28.345
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 눈썹 올리고 입꼬리 내리고 요런 식으로 표정을 지어줘야 되는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.355,
                "end": 32.997
            },
            {
                "speaker_id": "1",
                "transcription": "게임 플레이가 아주 흥미롭죠 근데 여기에 더해서 개발자의 창의적인 설계가 돋보이는 게임이더라 어 재미 있어 보이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.007,
                "end": 39.070
            },
            {
                "speaker_id": "1",
                "transcription": "한글 패치는 아까 예스 유어 그레이스에 이어서 오고루님이 번역을 해서 티스토리에서 배포 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.080,
                "end": 46.533
            }
        ]
    },
    "summary": "압도적으로 긍정적인 평가를 받은 후즈 라일라는 공포 미스터리 어드벤처 게임으로 캐릭터의 얼굴을 조작해서 진행하고 개발자의 창의적인 설계가 돋보이며 한글 패치는 오고루님이 번역을 해서 티스토리에서 배포 중이다.",
