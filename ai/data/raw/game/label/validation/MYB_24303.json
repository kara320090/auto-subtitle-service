        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 그래서 마음이 약해가지고 못 지나쳤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.210
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 충분히 플레이하지 못한 채 여러분께 소개해드리는 게임이라는 점 먼저 양해를 부탁드리고 잠깐 플레이해 봤지만 이 게임은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.210,
                "end": 10.202
            },
            {
                "speaker_id": "1",
                "transcription": "텍스트를 위주로 진행되는 캐릭터 키우기 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.212,
                "end": 13.955
            },
            {
                "speaker_id": "1",
                "transcription": "일단 캐릭터 수가 엄청 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.965,
                "end": 16.222
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 하나하나 일러를 그리신다는데 뭐 다양한 매력이 있고 각자의 특징이나 고유한 스킬들이 있는 캐릭터들이 어마어마하게 많아요.",
                "sound_type": [
                    2,
                    3
                ],
