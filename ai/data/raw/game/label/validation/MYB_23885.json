        "term": [
            {
                "speaker_id": "1",
                "transcription": "맵별로 한 판을 진행하는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.105
            },
            {
                "speaker_id": "1",
                "transcription": "한 판이 끝나면은 다음 맵으로 넘어가는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.115,
                "end": 4.802
            },
            {
                "speaker_id": "1",
                "transcription": "각 스테이지에서는 필드를 돌아다니면서 자원을 모으고 내 왕국을 강화시키고 병사들도 업그레이드하고 탐험하고 적을 무찌르고 스테이지를 클리어하면 되는 게임이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.812,
                "end": 15.533
            },
            {
                "speaker_id": "1",
                "transcription": "제가 아직 캠페인만 플레이 해봤지만요 재미 자체는 꽤 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.543,
                "end": 19.886
            },
            {
                "speaker_id": "1",
                "transcription": "에 그렇지만 아직 앞서 해보기 게임이기 때문에 콘텐츠가 부족하다는 느낌은 지울 수가 없더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.896,
                "end": 25.526
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 제가 송즈 오브 컨퀘스트에 거는 기대는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.536,
