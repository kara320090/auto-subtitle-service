        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리는 어떻게든 살아 남아서 아내를 찾아야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.006
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 홈 스위트 홈이 태국만의 분위기 태국의 오컬트 문화 등을 게임 내에 잘 녹여낸 것도 좋았지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.016,
                "end": 9.398
            },
            {
                "speaker_id": "1",
                "transcription": "제가 홈 스위트 홈을 좋아하는 이유 추격전 공포 게임이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.408,
                "end": 13.066
            },
            {
                "speaker_id": "1",
                "transcription": "마치 아웃라스트처럼 뒤에서는 귀신이 쫓아오고 나는 잘 따돌리고 숨어야 하는데 무릇 성공한 공포 게임들은 추격전 류의 게임들이 많았죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.076,
                "end": 21.807
            },
            {
                "speaker_id": "1",
                "transcription": "홈 스위트 홈도 그러하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.817,
                "end": 23.143
            },
            {
                "speaker_id": "1",
                "transcription": "숨 막히는 귀신의 추격을 피해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.153,
                "end": 25.333
            }
        ]
    },
    "summary": "한 남성이 새롭게 한글화된 게임 소개하면서 내용을 설명하고 있다.",
