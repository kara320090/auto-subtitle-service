        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기까지 한 주간의 흥미로운 게임 소식을 함께 알아봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.008
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 스팀이 업데이트 되면서 다양한 기능들과 함께 좀 더 보기 편하게 만들어 줬죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.018,
                "end": 7.668
            },
            {
                "speaker_id": "1",
                "transcription": "예 특히나 메모 기능 같은 거 인게임 내에서 오버레이 열어서 실시간으로 메모를 하기 굉장히 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.678,
                "end": 14.395
            },
            {
                "speaker_id": "1",
                "transcription": "사실 별것도 아닌 기능이지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.405,
                "end": 16.535
            },
            {
                "speaker_id": "1",
                "transcription": "있으면 꽤나 잘 쓰죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.545,
                "end": 17.832
            },
            {
                "speaker_id": "1",
                "transcription": "예 이런 게 중요한 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.842,
                "end": 19.271
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
