        "term": [
            {
                "speaker_id": "1",
                "transcription": "하 당깁니다. 나도 내가 왜 이렇게 됐는지 모르겠는데 이제는 그래픽이 안 좋을 거면 그냥 아예 구려야지 재밌어 보인다.",
                "sound_type": [
                    2,
