        "term": [
            {
                "speaker_id": "1",
                "transcription": "많이 튕기는 분들이 있는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.928
            },
            {
                "speaker_id": "1",
                "transcription": "요점은 주의를 하시고 그리고 게임 구매에 대해서 많은 분들이 뉴욕 확장팩 구매를 추천하더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.938,
                "end": 8.242
            },
            {
                "speaker_id": "1",
                "transcription": "예 그래서 두 번째 뉴욕 애디션 구매를 추천드리고 저는 이제 봄편만 해 봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.252,
                "end": 12.696
            },
            {
                "speaker_id": "1",
                "transcription": "뉴욕 확장팩은 안 해봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.706,
                "end": 14.188
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 디비전에 고인물 요원들 말을 들어 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.198,
                "end": 17.926
            },
            {
                "speaker_id": "1",
                "transcription": "망해버린 세상에서 미국 땅을 방황하는 엘리트 요원이 돼보는 것 어떨까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.936,
                "end": 22.966
            }
        ]
    },
    "summary": "디비전 투는튕기는 현상을 주의하고 게임 구매에 대해서는 많은 분들이 뉴욕 확장팩 구매를 추천한다.",
