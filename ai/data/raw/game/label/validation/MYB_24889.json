                ],
                "start": 0.000,
                "end": 0.966
            },
            {
                "speaker_id": "1",
                "transcription": "그 앞서 해보기라고 그러죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.976,
                "end": 2.451
            },
            {
                "speaker_id": "1",
                "transcription": "미완성인 채로 게임을 정식 출시 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.461,
                "end": 4.739
            },
            {
                "speaker_id": "1",
                "transcription": "거의 배짱 장사다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.749,
                "end": 6.231
            },
            {
                "speaker_id": "1",
                "transcription": "콘텐츠도 부족하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.241,
                "end": 7.752
            },
            {
                "speaker_id": "1",
                "transcription": "맵도 부족하고 아직 구현이 안 된 부분도 많았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.762,
                "end": 11.032
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 나는 이거 미완성이라면서 왜 그렇게 이 플레이했냐 재미있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.042,
                "end": 15.893
            },
            {
                "speaker_id": "1",
                "transcription": "너무 열 받지만 재미있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.903,
                "end": 18.292
            },
            {
                "speaker_id": "1",
                "transcription": "4인 협동 으로 끝 없이 쏟아 지는 적들을 물리치는 레포대식의 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.302,
                "end": 23.046
            },
            {
                "speaker_id": "1",
                "transcription": "네 명 의 캐릭터가 컨셉이 잘 나눠지기도 했고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.056,
