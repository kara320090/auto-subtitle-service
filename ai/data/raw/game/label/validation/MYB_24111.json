        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜로 따로 떼내서 팔아버리게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.685
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 이 사실을 모르던 보더랜드의 팬들은 새로운 보더랜드 게임이 출시한 줄 알고 구매해서 플레이했더니만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.695,
                "end": 10.489
            },
            {
                "speaker_id": "1",
                "transcription": "내가 옛날에 보더랜드 2에서 했던 디엘씨랑 100퍼센트 똑같더라",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.499,
                "end": 14.700
            },
            {
                "speaker_id": "1",
                "transcription": "이에 열받은 유저들이 비추를 준 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.710,
                "end": 17.787
            },
            {
                "speaker_id": "1",
                "transcription": "구매하면 안 되는 사람들이 구매를 했던 거죠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.797,
                "end": 20.122
            },
            {
                "speaker_id": "1",
                "transcription": "그치만 한 번도 안 해본 사람에게는 재미있는 게임이 될 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.132,
                "end": 24.160
            },
            {
                "speaker_id": "1",
                "transcription": "제 기억으로는 예전에 한 번 무료 배포를 했던 게임으로 기억을 하는데 지금 또 주네요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.170,
                "end": 29.533
            },
            {
                "speaker_id": "1",
                "transcription": "보더랜드 2에 존재하는 디엘씨를 따로 스탠드얼론으로 즐길 수 있다라고 생각을 하면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.543,
                "end": 35.678
            },
            {
                "speaker_id": "1",
                "transcription": "게임 자체는 재밌다는 호평을 많이 받았어요",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.688,
                "end": 38.600
            }
        ]
    },
    "summary": "게임자체는 재밌다고 하지만 사실을 모르던 보더랜드의 팬들이 새로운 게임인 줄 알고 구매를 해보니 보더랜드 2에서 했던 게임이랑 똑같아서 화가 난 유저들이 비추를 줬다고 한다.",
