                ],
                "start": 0.000,
                "end": 2.795
            },
            {
                "speaker_id": "1",
                "transcription": "예 지금의 하이파이 러시처럼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.805,
                "end": 5.067
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임도 게임 패스 덕에 많은 사람들이 부담 없이 플레이해 보고 재밌다고 소문 내주고 이게 스팀 판매량으로까지 이어지면서 스팀 판매량 탑텐 진입을 무난히 성공을 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.077,
                "end": 16.109
            },
            {
                "speaker_id": "1",
                "transcription": "곧 있으면 1위까지 넘볼 수 있을 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.119,
                "end": 18.186
            },
            {
                "speaker_id": "1",
                "transcription": "개발사는 홍보 비용 절약하고.",
