    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기 악마가 있는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.106
            },
            {
                "speaker_id": "1",
                "transcription": "당신 손엔 샷건이 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.116,
                "end": 2.874
            },
            {
                "speaker_id": "1",
                "transcription": "둠 슬레이어가 되어 악마들을 찢는 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.884,
                "end": 4.913
            },
            {
                "speaker_id": "1",
                "transcription": "총을 쏘고 싶나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.923,
                "end": 6.328
            },
            {
                "speaker_id": "1",
                "transcription": "둠 하면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.338,
                "end": 7.379
            },
            {
                "speaker_id": "1",
                "transcription": "둠도 비슷한 게임들 엄청 많죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.389,
                "end": 9.300
            },
            {
                "speaker_id": "1",
                "transcription": "그저 적들을 스피디하게 쏘고 찢는다는 단순한 게임성에서 주는 쾌감이 크기 때문에 둠과 비슷한 게임들 많습니다만 그래도 둠은 둠이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.310,
                "end": 17.817
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 먼저 합시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.827,
                "end": 18.977
            },
            {
                "speaker_id": "1",
                "transcription": "적들 사이를 헤집고 다니면서 시원하게 총을 쏘는 쾌감.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.987,
                "end": 22.642
            },
            {
                "speaker_id": "1",
                "transcription": "찢고 또 찢고 마지막에 나만 서 있을 때까지 주변의 악마를 다 학살하는 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.652,
                "end": 27.309
            },
            {
                "speaker_id": "1",
                "transcription": "이게 게임이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.319,
                "end": 28.278
            },
            {
                "speaker_id": "1",
                "transcription": "이게 둠이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.288,
                "end": 29.142
            },
            {
                "speaker_id": "1",
                "transcription": "여기 검 마법 죽지 않는 자들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.152,
                "end": 31.894
            },
            {
                "speaker_id": "1",
                "transcription": "용 판타지 세계가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.904,
                "end": 33.518
            },
            {
                "speaker_id": "1",
                "transcription": "엘든링을 30% 할인해서 45360원에 판매 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.528,
                "end": 38.350
            },
            {
                "speaker_id": "1",
                "transcription": "소울 나이크하고 싶으면 엘든링하면 되죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.360,
                "end": 40.760
            },
            {
                "speaker_id": "1",
                "transcription": "거대한 판타지 오픈 월드.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.756,
                "end": 42.369
            },
            {
                "speaker_id": "1",
                "transcription": "수십 가지가 넘는 무기 중에 내가 들고 싶은 거 들면 되고 다양한 스킬도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.379,
                "end": 47.172
            },
            {
                "speaker_id": "1",
                "transcription": "강력한 적이 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.182,
                "end": 48.433
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 다크 판타지 최고 존엄이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.443,
                "end": 50.431
            },
            {
                "speaker_id": "1",
                "transcription": "엘든링의 유일한 단점은 너무나도 훌륭하고 풍성한 게임이기 때문에 엘든링하고 나면 다른 소울 라이크 게임은 성에 안 찰 수도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.441,
                "end": 58.573
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 RPG 좋아하시는 분들 캐릭터가 성장하고 더 강한 장비를 얻는데 재미를 느끼는 분들은 엘든링 강추입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.583,
                "end": 64.931
            },
            {
                "speaker_id": "1",
                "transcription": "무더운 여름 시원하게 달리죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.941,
                "end": 67.109
            },
            {
                "speaker_id": "1",
                "transcription": "여기 차와 오픈 월드가 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.119,
                "end": 69.136
            },
            {
                "speaker_id": "1",
                "transcription": "포르자 호라이즌 5를 50% 할인해서 39950원에 판매 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.146,
                "end": 74.439
            },
            {
                "speaker_id": "1",
                "transcription": "레이싱 게임이요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.449,
                "end": 75.411
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 포르자 호라이즌 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.421,
                "end": 76.949
            },
            {
                "speaker_id": "1",
                "transcription": "저처럼 레이싱 알못이어도 즐겁게 플레이할 수 있는 게임이고 한국어 더빙까지 지원해 준다는 거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.959,
                "end": 82.628
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 이거 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.638,
                "end": 83.795
            },
            {
                "speaker_id": "1",
                "transcription": "차로 달리는 재미 오픈 월드의 재미 최고다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.805,
                "end": 86.800
            }
        ]
    },
    "summary": "RPG 좋아하시는 분들 캐릭터가 성장하고 더 강한 장비를 얻는데 재미를 느끼는 분들은 엘든링을 강추하고 포르자 호라이즌은 레이싱 알못이어도 즐겁게 플레이할 수 있는 게임에 한국어 지원까지 해준다.",
