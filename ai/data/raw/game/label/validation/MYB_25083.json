        "term": [
            {
                "speaker_id": "1",
                "transcription": "스토리에 의지를 하는 스토리 게임에 더 가까워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.438
            },
            {
                "speaker_id": "1",
                "transcription": "경영 시뮬레이션 파트는 이 스토리를 보좌하는 시스템 정도라고 생각을 하면 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.448,
                "end": 7.580
            },
            {
                "speaker_id": "1",
                "transcription": "여러분은 훌륭한 왕 훌륭한 가장이 될 수 있을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.590,
                "end": 11.251
            },
            {
                "speaker_id": "1",
                "transcription": "유저 한글 패치는요 오고루님이 번역을 해서 네이버 블로그에서 배포 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.261,
                "end": 16.311
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 게임을 구매하고 싶은 분들이 계실 텐데 곧 스팀 겨울 할링이 시작하기 때문에요 그때 구매를 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.321,
                "end": 23.566
            }
        ]
    },
    "summary": "경영 시뮬레이션 파트는 이 스토리를 보좌하는 시스템 정도이고 스토리에 의지를 하는 스토리 게임이며 유저 한글 패치는 오고루님이 번역을 해서 네이버 블로그에서 배포 중이다.",
