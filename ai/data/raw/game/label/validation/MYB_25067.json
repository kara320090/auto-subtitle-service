        "term": [
            {
                "speaker_id": "1",
                "transcription": "4명이서 함께 하는 심령 체험의 끝판왕 파즈모 포비아입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.482
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 현재 에픽 게임즈 스토어에서 매일 하나씩 게임을 무료 배포 중이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.492,
                "end": 8.739
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 고전 폴아웃 시리즈입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.749,
                "end": 10.745
            },
            {
                "speaker_id": "1",
                "transcription": "폴아웃 1, 2, 텍틱스까지 3개의 클래식 폴하우스를 무료 배포 중이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.755,
                "end": 16.102
            },
            {
                "speaker_id": "1",
                "transcription": "12월 24일 01시까 받을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.112,
                "end": 18.860
            },
            {
                "speaker_id": "1",
                "transcription": "그 매일 매일 나오니까 내일도 당연히 무료 배포 게임이 있는데 요건 또 내일 알려 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.870,
                "end": 24.276
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 스팀 겨울 할인 각 분야 최고의 게임들을 만나 봤는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.286,
                "end": 28.296
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 진짜 최고 킹왕짱 게임인데 여기 안 나온 애들도 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.306,
                "end": 31.899
            },
            {
                "speaker_id": "1",
                "transcription": "예 그런 건 뭐 제가 곧 다른 영상에서 소개를 또 할 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.909,
                "end": 35.582
            },
            {
                "speaker_id": "1",
                "transcription": "한 영상의 모든 걸 담을 순 없고 저도 또 라인업을 계속해서 바꾸기도 하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.592,
                "end": 40.234
            },
            {
                "speaker_id": "1",
                "transcription": "예 어쩔 수가 없죠 저는 다음에 더 재미있는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다 다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.244,
                "end": 45.833
            }
        ]
    },
    "summary": "현재 에픽 게임즈 스토어에서 매일 하나씩 게임을 무료 배포 중인데 오늘은 폴아웃 1, 2, 텍틱스까지 3개의 클래식 폴하우스를 무료 배포 중이고 12월 24일 01시까 받을 수 있다.",
