        "term": [
            {
                "speaker_id": "1",
                "transcription": "환상적이고 매력적이더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.870
            },
            {
                "speaker_id": "1",
                "transcription": "저는 전투가 재미있다는 점이 굉장히 의외였어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.880,
                "end": 5.131
            },
            {
                "speaker_id": "1",
                "transcription": "사실 제가 말은 안 했지만 영상만 봤을 때는 뭐 그냥저냥 한 전투 시스템으로 보였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.141,
                "end": 10.654
            },
            {
                "speaker_id": "1",
                "transcription": "사실 뭐 지팡이에서 마법이 날라가 봤자 어떤 대단한 액션을 기대할 수 있겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.664,
                "end": 15.087
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 존재한다는 거에 의미를 두는 그럭저럭한 전투 시스템을 기대했는데 웬걸 전투까지 재미있어 준다면 대박이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.097,
                "end": 22.093
            },
            {
                "speaker_id": "1",
                "transcription": "제가 생각하던 호그와트 레거시의 메인은 그냥 신기한 마법을 사용하고 호그와트를 탐험하고 이런 게 메인이겠다 라고 생각을 했는데 하나같이 말하길 각종 마법에 콤보를 사용하는 게 재밌더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.103,
                "end": 33.542
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들면은 아시오라는 마법으로 끌어당기고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.552,
                "end": 36.233
            }
        ]
    },
    "summary": "유튜버는 본인의 생각하던 호그와트 레거시의 메인은 그냥 신기한 마법을 사용하고 호그와트를 탐험하고 이런 게 메인이겠다 라고 생각을 했는데 하나같이 말하길 각종 마법에 콤보를 사용하는 전투 시스템이 재미있었다고 평가했다고 합니다.",
