        "term": [
            {
                "speaker_id": "1",
                "transcription": "저에게는 가장 큰 만족도를 줬던 게임 중 하나입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.949
            },
            {
                "speaker_id": "1",
                "transcription": "참고로 여러분이 박치라서 리듬게임이 무서운 분들도 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.959,
                "end": 7.378
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들도 그냥 플레이하셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.388,
                "end": 9.210
            },
            {
                "speaker_id": "1",
                "transcription": "리듬의 난이도가 어렵지는 않다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.220,
                "end": 11.749
            },
            {
                "speaker_id": "1",
                "transcription": "최고의 오픈 월드 게임은 사실 고민을 많이 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.759,
                "end": 15.186
            },
            {
                "speaker_id": "1",
                "transcription": "락스타도 있고 베데스다도 있고 그런데 레데리나 스카이림이나 너무 식상하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.196,
                "end": 20.603
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뽑았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.613,
                "end": 21.634
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤컴 딜리버런스",
