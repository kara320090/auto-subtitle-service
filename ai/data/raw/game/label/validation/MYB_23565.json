                "end": 16.077
            },
            {
                "speaker_id": "1",
                "transcription": "유저 한글 패치는요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.087,
                "end": 17.544
            },
            {
                "speaker_id": "1",
                "transcription": "이에이유비아이티에이 뭐라고 읽어야 되는지 모르겠어요?",
