                ],
                "start": 0.000,
                "end": 8.018
            },
            {
                "speaker_id": "1",
                "transcription": "다만 공포 게임은 아닙니다. 그냥 크툴루 분위기 향만 추가해 주는 정도예요.",
                "sound_type": [
