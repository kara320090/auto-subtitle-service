        "term": [
            {
                "speaker_id": "1",
                "transcription": "요리조리 피해가면서 잡는 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.742
            },
            {
                "speaker_id": "1",
                "transcription": "단순하지만 그 단순함이 가장 큰 매력이었는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.752,
                "end": 4.380
            },
            {
                "speaker_id": "1",
                "transcription": "이번 후속작 상당히 기대를 하고 있었습니다만 제가 큰 오해를 하고 있었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.376,
                "end": 8.964
            },
            {
                "speaker_id": "1",
                "transcription": "어 이 게임 디펜스 게임의 후속작이 아니라 보니까요 뱀파이어 서바이버즈류의 게임이었던거더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.974,
                "end": 15.164
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이름에 대놓고 서바이버즈라고 타이틀을 달았는데 제가 이걸 왜 눈치를 못 챘을까요.",
                "sound_type": [
                    2,
