                ],
                "start": 20.509,
                "end": 25.294
            },
            {
                "speaker_id": "1",
                "transcription": "제발 재밌게 잘 나와줬음 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.304,
                "end": 27.642
            },
            {
