                ],
                "start": 9.318,
                "end": 13.217
            },
            {
                "speaker_id": "1",
                "transcription": "액소프라이머리 오픈 베타 테스트도 플레이해 볼 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.227,
                "end": 16.905
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 흥미로운 오늘의 게임 라디오 소식이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.915,
                "end": 20.499
            },
            {
                "speaker_id": "1",
                "transcription": "재밌는 게임들이 한글화가 되기도 했고 디아블로4 베타 테스트도 진행을 하네요.",
                "sound_type": [
                    2,
