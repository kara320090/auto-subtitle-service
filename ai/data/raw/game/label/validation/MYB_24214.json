                    2,
                    3
                ],
                "start": 2.694,
                "end": 9.308
            },
            {
                "speaker_id": "1",
                "transcription": "이 슈트별로 다양한 팀 플레이가 가능할 것 같아서 재밌어 보이네요.",
                "sound_type": [
