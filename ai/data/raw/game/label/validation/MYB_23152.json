        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 국가 기관에서도 당연히 주의 깊게 보고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.157
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 내용이 컨트롤의 DLC에 연동이 되어 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.167,
                "end": 6.603
            },
            {
                "speaker_id": "1",
                "transcription": "이 얼티밋 에디션을 구입하신다면은 세계관이 연계되어 있는 그 스토리를 플레이할 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.613,
                "end": 11.619
            },
            {
                "speaker_id": "1",
                "transcription": "근데 문제는 저처럼 플레이를 해 봐도요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.629,
                "end": 14.219
            },
            {
                "speaker_id": "1",
                "transcription": "잘 설명을 못하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.229,
                "end": 16.630
            },
            {
                "speaker_id": "1",
                "transcription": "도 도통 뭔 말인지 모릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.640,
                "end": 19.107
            },
            {
                "speaker_id": "1",
                "transcription": "에 나도 지금 앨런웨이크랑 뭐 컨트롤이랑 DLC랑 다 플레이를 해 봤는데도 이게 뭔 소리들인지 속시원하게 이해가 가진 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.117,
                "end": 27.720
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 세계관이 연동되어 있구나 정도로만 어 알고 넘어가는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.730,
                "end": 32.600
            },
            {
                "speaker_id": "1",
                "transcription": "어 그래서 이게 컨트롤의 단점이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.610,
                "end": 34.266
            }
        ]
    },
    "summary": "앨런웨이크와 컨트롤 그리고 DLC를 모두 플레이 했지만 이것들의 세계관이 연동되어 있다는 것을 잘 이해하기는 힘들다.",
