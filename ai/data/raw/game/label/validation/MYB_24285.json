        "term": [
            {
                "speaker_id": "1",
                "transcription": "문제가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.700
            },
            {
                "speaker_id": "1",
                "transcription": "거의 뭐 주고 시작하는 거라고 봐도 무방할 정도입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.700,
                "end": 3.320
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 인게임 내에서 눈이 너무 즐거워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.310,
                "end": 5.503
            },
            {
                "speaker_id": "1",
                "transcription": "하나같이 참신하고 아름답고 기괴한 디자인들이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.510,
                "end": 8.861
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 전투 나쁘지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.871,
                "end": 11.075
            },
            {
                "speaker_id": "1",
                "transcription": "FPS가 낫 베드 정도 그렇지만 이 훌륭한 재료들을 모아서 조립을 잘못한 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.085,
                "end": 16.900
            },
            {
                "speaker_id": "1",
                "transcription": "음식으로 치자면 요리 재료들은 신선하고 다 좋은데 잘못 만든 거죠 요리를.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.900,
                "end": 21.120
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 무슨 느낌이냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.120,
                "end": 22.370
            },
            {
                "speaker_id": "1",
                "transcription": "1명의 강력한 디렉터가 없이 게임을 만든 것 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.370,
                "end": 25.120
            },
            {
                "speaker_id": "1",
                "transcription": "네 중심이 되는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.120,
                "end": 26.300
            }
        ]
    },
    "summary": "아토믹 하트 게임은 하나같이 참신하고 아름다운 디자인들이고 전투도 나쁘지 않지만 1명의 강력한 디렉터가 없이 마치 음식으로 치자면 훌륭한 재료들을 모아서 음식을 잘못 만든 것 같은 느낌이다.",
