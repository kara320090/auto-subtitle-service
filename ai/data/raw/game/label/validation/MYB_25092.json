        "term": [
            {
                "speaker_id": "1",
                "transcription": "하나씩 나사가 빠진 혹은 맛탱이가 간 인물들이 모여서 파티를 맺어서 던전을 탐험하는 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.331
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 다들 뭐 한 입담을 하는 인물들이 모였거든요.그래서 게임 내내 뭐 치열한 농담 공방전을 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.341,
                "end": 13.260
            },
            {
                "speaker_id": "1",
                "transcription": "계속 계속해서 농담을 집어던지고 투닥 투닥 거리는데 매우 유쾌하고 코믹한 게임이고 농담의 퀄리티는요 높은 편입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.270,
                "end": 20.425
            },
            {
                "speaker_id": "1",
                "transcription": "보통 이제 코믹 게임인데 재미없는 농담만 하는 게임들이 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.435,
                "end": 24.568
            },
            {
                "speaker_id": "1",
                "transcription": "예 그 최악인데 그러면은 던전 오브 나흘벅은 수준 낮은 농담이 아니라 재미있는 농담을 던져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.578,
                "end": 29.848
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 전투 자체도 굉장히 재미있다 턴제 전투가 상타.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.858,
                "end": 33.466
            }
        ]
    },
    "summary": "하나씩 나사가 빠진 혹은 맛탱이가 간 인물들이 모여서 파티를 맺어서 던전을 탐험하는 게임이고 계속해서 농담을 집어던지고 투닥 투닥 거리는데 매우 유쾌하고 코믹하며 농담의 퀄리티는 높은 편이다.",
