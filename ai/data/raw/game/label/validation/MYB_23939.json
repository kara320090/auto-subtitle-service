        "term": [
            {
                "speaker_id": "1",
                "transcription": "해브 어 나이스 데스가 3월 23일 정식 출시해 좋은 평가를 이어가고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.801
            },
            {
                "speaker_id": "1",
                "transcription": "그전부터 유명세가 조금 있었던 액션 로그라이크 게임인데 예 사실 전 안 해 봤습니다 이 게임",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.811,
                "end": 10.453
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 게임이냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.463,
                "end": 11.191
            },
            {
                "speaker_id": "1",
                "transcription": "주인공은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.201,
                "end": 12.032
            },
            {
                "speaker_id": "1",
                "transcription": "이제 회사의 짱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.042,
                "end": 13.444
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 회사냐 죽음 주식회사의 짱이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.454,
                "end": 16.079
            },
            {
                "speaker_id": "1",
                "transcription": "직원들의 질서가 무너지고 통제 불능이 되면서 영혼의 균형이 무너지기도 했지만 무엇보다 죽음 주식회사의 짱인 주인공의 휴가 계획이 틀어졌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.089,
                "end": 25.624
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 낫을 들고 직원들 서열 정리를 하러 친이 돌아다니는 게임이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.634,
                "end": 30.387
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제 게임 컨셉이랑 이 동화 같은 디자인이 참 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.397,
                "end": 34.271
            },
            {
                "speaker_id": "1",
                "transcription": "예, 정말 매력적인 게임 디자인이고 이거 하나만 놓고 보더라도 충분히 플레이 할 만한 가치가 있지 않나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.281,
                "end": 40.400
            }
        ]
    },
    "summary": "3월 23일 출시한 해브 어 나이스 데스는 액션 로그라이크 게임인데 죽음 주식회사 사장이 직원들의 서열 정리하며 돌아다니는 게임이다.",
