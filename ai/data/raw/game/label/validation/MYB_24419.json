        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리네 인생 같은 게임이라 친근해서 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.924
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이렇게 얘기하지만 제가 실제로 몇 번 소개를 했을 정도로 저는 좋아하는 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.934,
                "end": 7.949
            },
            {
                "speaker_id": "1",
                "transcription": "다음은 멋쟁이 마법사입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.959,
                "end": 10.179
            },
            {
                "speaker_id": "1",
                "transcription": "위에서 내려다보는 쿼터뷰 시점의 로그라이크 게임으로 마법사가 되어서 카드를 던지고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.189,
                "end": 15.847
            },
            {
                "speaker_id": "1",
                "transcription": "마법을 사용하며 적들을 물리쳐 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.857,
                "end": 18.302
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 비슷한 게임을 따지자면 하데스류의 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.312,
                "end": 21.853
            },
            {
                "speaker_id": "1",
                "transcription": "이제 하데스가 워낙에 우주 명작인 게임이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.863,
