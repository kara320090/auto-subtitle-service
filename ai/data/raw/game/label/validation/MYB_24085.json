        "term": [
            {
                "speaker_id": "1",
                "transcription": "어보가히 스팀 게임들 중에서도 탑텐에 들지 않을까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.780
            },
            {
                "speaker_id": "1",
                "transcription": "굉장한 중독성을 가지고 있는 게임이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.790,
                "end": 5.999
            },
            {
                "speaker_id": "1",
                "transcription": "여러분은 과연 식민지를 잘 관리할 수 있을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.009,
                "end": 9.532
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기까지 오늘의 스팀 할인 영상이었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.542,
                "end": 12.397
            },
            {
                "speaker_id": "1",
                "transcription": "라스트 오브 어스 1편 같은 경우는요 정말 좋은 게임이고 아 사실 스토리적으로는 역대 게임 중에 1등이 아닌가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.407,
                "end": 19.422
            },
            {
                "speaker_id": "1",
                "transcription": "이런 생각이 들 정도로 굉장한 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.432,
                "end": 22.664
            },
            {
                "speaker_id": "1",
                "transcription": "한 번쯤 해보셨으면 좋겠네요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.674,
                "end": 24.096
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.106,
                "end": 28.005
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.015,
                "end": 28.866
            }
        ]
    },
    "summary": "라스트 오브 어스 1편은 정말 한 번쯤 해봤으면 하는 게임이고 오늘의 스팀 할인 영상은 여기까지이다.",
