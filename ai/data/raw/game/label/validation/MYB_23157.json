        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 색, 폰트, 배치 이런 것들을 조절해서 어 좀 더 모던한 느낌의 UI와 레이아웃으로 바뀌었고 제가 이제 어 바뀐 스팀을 여기저기 돌아다니다 보니까 뭐 짜잘하게 업데이트를 해 줬는데 뭐 예를 들면은 스팀을 키고 설정에서 뭐 저장 공간 탭에 게임을 크기 별로 뭐 이쁘게 싹 정리가 되어 있는 탭도 있더라구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 19.338
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 기능 등을 통해서 뭐 한층 더 야무지게 저장 공간을 관리할 수 있지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.348,
                "end": 23.887
            },
            {
                "speaker_id": "1",
                "transcription": "어 이것 뿐만이 아니라 폰트, 레이아웃 등등 재배치 했기 때문에 이전보다는 훨씬 더 눈에 잘 들어오더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.897,
                "end": 30.532
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이게 중요한 게 아니죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.542,
                "end": 31.903
            },
            {
                "speaker_id": "1",
                "transcription": "우리는 실제 게임을 플레이할 때 체감할 수 있는 어 편리한 기능들이 중요하죠.",
                "sound_type": [
