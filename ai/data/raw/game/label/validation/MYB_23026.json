    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기 한 남자의 마을이 전쟁에 휘말렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.378
            },
            {
                "speaker_id": "1",
                "transcription": "대장장이의 아들로 전쟁으로 폐허가 된 마을을 떠나 중세 오픈 월드를 누비며 남자로 성장하는 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.388,
                "end": 8.507
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤 컴 딜리버런스를 75% 할인해서 7750원에 판매 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.517,
                "end": 13.467
            },
            {
                "speaker_id": "1",
                "transcription": "중세를 배경으로 한 현실적인 오픈 월드 RPG 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.477,
                "end": 16.790
            },
            {
                "speaker_id": "1",
                "transcription": "너무나도 현실적인 게임이기 때문에 불편한 게 많죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.800,
                "end": 20.223
            },
            {
                "speaker_id": "1",
                "transcription": "배고프면 밥 먹고 졸리면 자고 자꾸 싸워 대가지고 칼날이 무뎌졌다면 칼도 내가 직접 숫돌에 갈아야 되고 더러워지면 씻어야 되고 중세의 삶을 그대로 느껴볼 수 있는 게임이라는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.233,
                "end": 31.794
            },
            {
                "speaker_id": "1",
                "transcription": "우리는 대장장이의 아들로 시작해서 성공을 할 수도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.804,
                "end": 34.767
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 필요하다면 마을을 전쟁에 휘말리게 한 놈을 찾아내야죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.777,
                "end": 38.348
            },
            {
                "speaker_id": "1",
                "transcription": "에 피의 대가를 치르도록 해야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.358,
                "end": 40.741
            },
            {
                "speaker_id": "1",
                "transcription": "중세의 현실적인 오픈 월드를 찾는다면 킹덤 컴 강추드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.751,
                "end": 44.628
            },
            {
                "speaker_id": "1",
                "transcription": "제가 오픈월드 게임을 좋아하고 대깨배 거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.640,
                "end": 47.680
            },
            {
                "speaker_id": "1",
                "transcription": "예 베데스다 빠돌인데 베데스다 게임 말고 킹덤 컴 딜리버런스를 고른 이유는 딱 하나 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.680,
                "end": 53.399
            },
            {
                "speaker_id": "1",
                "transcription": "예 베데스다가 스타필드 한글을 안 해줘서 나는 삐졌다 지금.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.409,
                "end": 57.101
            },
            {
                "speaker_id": "1",
                "transcription": "여기 한 남학생이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.111,
                "end": 58.888
            },
            {
                "speaker_id": "1",
                "transcription": "그의 친구들도 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.898,
                "end": 60.083
            },
            {
                "speaker_id": "1",
                "transcription": "학생의 신분으로 사람의 마음을 훔치는 괴도단을 운영하게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.093,
                "end": 63.740
            },
            {
                "speaker_id": "1",
                "transcription": "페르소나 5 더 로열을 40% 할인해서 41880원에 판매 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.750,
                "end": 69.132
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임 장르를 뭐라고 말해야 될지 고민이 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.142,
                "end": 72.140
            },
            {
                "speaker_id": "1",
                "transcription": "에 JRPG를 하고 싶다면 플레이하시면 되는데 뭐랄까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.136,
                "end": 75.708
            },
            {
                "speaker_id": "1",
                "transcription": "단순 JRPG는 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.718,
                "end": 77.431
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로는 게임 내에서 상호 작용하는 소셜 기능을 높게 치고 싶다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.441,
                "end": 81.802
            },
            {
                "speaker_id": "1",
                "transcription": "등장인물들과 관계를 쌓는 게임이라는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.812,
                "end": 84.944
            },
            {
                "speaker_id": "1",
                "transcription": "현실에 없는 친구가 게임 속엔 들어있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.954,
                "end": 87.424
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 2 가지 파트.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.420,
                "end": 88.642
            },
            {
                "speaker_id": "1",
                "transcription": "현실 세계와 이 세계가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.652,
                "end": 90.614
            },
            {
                "speaker_id": "1",
                "transcription": "현실 세계에서 학교에서 친구들 만나고 선생님들하고 다른 조력자들하고 친해지고 유대를 쌓는다면 이 세계에서 판타지 세계에서도 힘을 발휘하게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.624,
                "end": 100.423
            },
            {
                "speaker_id": "1",
                "transcription": "마치 거미줄을 끝을 모르고 얽혀 있는 소셜 기능이 이 게임 핵심이 아닐까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.433,
                "end": 105.332
            },
            {
                "speaker_id": "1",
                "transcription": "굉장히 독특한 게임성을 가지고 있기 때문에 더욱더 추천을 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.342,
                "end": 109.080
            },
            {
                "speaker_id": "1",
                "transcription": "JRPG 플레이하고 싶다면 페르소나 5 더 로열입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 109.092,
                "end": 113.066
            }
        ]
    },
    "summary": "대장장이의 아들로 전쟁으로 폐허가 된 마을을 떠나 중세 오픈 월드를 누비며 남자로 성장하는 게임인 킹덤 컴 딜리버런스를 75% 할인해서 7750원에 판매 중이고 학생의 신분으로 사람의 마음을 훔치는 괴도단을 운영하는 페르소나 5 더 로열을 40% 할인해서 41880원에 판매 중이다.",
