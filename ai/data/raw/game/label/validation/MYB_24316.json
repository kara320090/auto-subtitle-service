        "term": [
            {
                "speaker_id": "1",
                "transcription": "말 같지도 않은 스토리거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.980
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 개연성을 따지고 들어가면은 뭐 하나도 와닿는 스토리가 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.990,
                "end": 6.767
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 이걸 왜 플레이하고 어떻게 몰입하게 되느냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.770,
                "end": 9.727
            },
            {
                "speaker_id": "1",
                "transcription": "이 모든 것은 다 성우의 힘이더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.737,
                "end": 11.817
            },
            {
                "speaker_id": "1",
                "transcription": "네 내가 보니까 성우 분의 이제 열연이 사실상 게임 지분의 뭐 80퍼센트 이상을 차지한다고 해도 무방할 정도로",
                "sound_type": [
