        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "큰 매력은 없는 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.025
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 가격이 가장 걸림돌이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.035,
                "end": 2.944
            },
            {
                "speaker_id": "1",
                "transcription": "이 가격 주고 플레이하라고 하면 사실 추천이 아니라 반대를 해도 부족하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.944,
                "end": 8.336
            },
            {
                "speaker_id": "1",
                "transcription": "제가 생각하는 추천 가격은 50% 이상 세일을 하면 그때 되면 이제 고민을 시작해 볼만 하지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.336,
                "end": 14.631
            },
            {
                "speaker_id": "1",
                "transcription": "예 이 정도의 느낌.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.641,
                "end": 15.847
            },
            {
                "speaker_id": "1",
                "transcription": "엑조 프라이멀은 출시 전부터 제가 아 애매한 느낌이 든다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.857,
                "end": 19.421
            },
            {
                "speaker_id": "1",
                "transcription": "어 캡콤이 여기서 삐끗할 수도 있겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.431,
                "end": 21.889
            },
            {
                "speaker_id": "1",
                "transcription": "가격이 큰 걸림돌로 작용하지 않을까 어 이렇게 제가 예언 아닌 저주죠 거의.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.899,
                "end": 26.746
            },
            {
                "speaker_id": "1",
                "transcription": "예 저주에 가까운 예언을 했었는데 아쉽지만 예상한 그대로 맞아 떨어졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.756,
                "end": 31.925
            },
            {
                "speaker_id": "1",
                "transcription": "예 캡콤이 다음 게임부터는 다시 갓콤으로 올라왔으면 좋겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.935,
                "end": 36.300
            }
        ]
    },
    "summary": "제가 엑조 프라이멀은 출시 전부터 애매한 느낌이 든다 예상했었는데 아쉽지만 예상한 그대로 맞아 떨어졌다.",
