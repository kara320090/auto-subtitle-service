        "term": [
            {
                "speaker_id": "1",
                "transcription": "조금이라도 있는 게임이면은 추천을 해 보겠습니다하고 이렇게 답장을 보냈습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.310
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 뭐 요즘 할 게임이 너무 많아가지고 어드벤처 오브 플라워는 남한테 추천할 만큼 충분한 플레이를 제가 못했거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.310,
                "end": 11.860
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래서 당분간은 소개할 예정이 없는 게임이었는데 이번에 스토브 할인을 하면서 어떤 게임들이 있을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.870,
                "end": 18.497
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 게임들이 재미 있을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.507,
                "end": 19.840
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 둘러보는데 자꾸만 눈에 밟히더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.840,
                "end": 22.660
            },
            {
                "speaker_id": "1",
                "transcription": "네 이 어드벤처 오브 플라워가 자꾸만 눈에 밟힙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.660,
                "end": 26.066
            }
        ]
    },
    "summary": "사실 요새 할 게임이 너무 많아서 어드벤처 오브 플라워는 추천할 만큼 플레이를 해 보지 못해서 당분간 소개할 예정에 없었는데 이번에 스토브 할인을 하면서 어떤 게임들이 있을까 보는데 이 어드벤처 오브 플라워 게임이 자꾸 눈에 밟혔다.",
