        "term": [
            {
                "speaker_id": "1",
                "transcription": "숙달 되기까지는 약간 시간을 투자해야 되는 게임이고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.553
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 시간을 투자를 해야지 재밌는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.563,
                "end": 6.058
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 벌써 걱정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.068,
                "end": 7.140
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이게 너무 재미있으면 또 제가 오래 붙들고 있어야 되니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.140,
                "end": 11.441
            },
            {
                "speaker_id": "1",
                "transcription": "그게 걱정이고 재미가 없으면 또 그거대로 문제죠.",
