                ],
                "start": 9.146,
                "end": 15.612
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 이제 일하다가 줌을 뒤로 쭉 당겨서 우리가 우주를 구경할 수가 있는데.",
                "sound_type": [
                    2,
                    3
                ],
