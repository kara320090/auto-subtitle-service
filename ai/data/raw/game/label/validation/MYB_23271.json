                    2,
                    3
                ],
                "start": 4.494,
                "end": 5.943
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 우리 흙수저 버전의 디아블로 나는 이게 더 재밌어 보인다.",
                "sound_type": [
