        "term": [
            {
                "speaker_id": "1",
                "transcription": "2021년 6월 출시했던 SRPG 게임 심포니 오브 워가 공식 한국어 지원을 시작했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.992
            },
            {
                "speaker_id": "1",
                "transcription": "유저 한글 패치가 아니라 개발사에서 공식적으로 한국어 지원을 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.002,
                "end": 10.385
            },
            {
                "speaker_id": "1",
                "transcription": "저번 영상에서 말씀을 드렸죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.395,
                "end": 12.336
            },
            {
                "speaker_id": "1",
                "transcription": "소식만 전하고 넘어갈 게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.346,
                "end": 14.041
            },
            {
                "speaker_id": "1",
                "transcription": "저도 그 뒤로 좀 더 플레이를 해봤는데 저는 뭐 꽤 할 만했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.051,
                "end": 17.790
            },
            {
                "speaker_id": "1",
                "transcription": "약간 올드한 맛이 있는데 어 그러니까 이제",
