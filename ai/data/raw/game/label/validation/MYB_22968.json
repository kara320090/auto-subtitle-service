                ],
                "start": 19.407,
                "end": 24.182
            },
            {
                "speaker_id": "1",
                "transcription": "여기서부터 이제 범죄인데 정부 차원에서 이제 범죄를 주도하는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
