                    3
                ],
                "start": 12.341,
                "end": 13.948
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 사람인지 정리를 해서 이 사람이 테러의 위협이 있다.",
                "sound_type": [
                    2,
                    3
                ],
