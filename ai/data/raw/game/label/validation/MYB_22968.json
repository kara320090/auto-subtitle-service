            },
            {
                "speaker_id": "1",
                "transcription": "예 요즘은요 뭐 SNS나 개인 블로그나 이런 거 몇 분만 살피면요 뭐 하는 사람인지 신상이 다 나오죠 예.",
                "sound_type": [
