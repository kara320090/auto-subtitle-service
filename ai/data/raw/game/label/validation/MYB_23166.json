        "term": [
            {
                "speaker_id": "1",
                "transcription": "적용을 하면 되는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.032
            },
            {
                "speaker_id": "1",
                "transcription": "이 스테퍼 케이스가 추리를 하는 게임인데 게임 내의 절름발이가 범인인 것 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.042,
                "end": 5.383
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 절름발이가 범인 이렇게 노트를 작성하구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.393,
                "end": 8.095
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째 노트를 작성하고 싶으면은 예 노트 켜서 여기다 다시 작성을 하면 되고 첫 번째 노트를 킬 수도 있고 중요한 거는 고정을 할 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.105,
                "end": 15.227
            },
            {
                "speaker_id": "1",
                "transcription": "창을 고정해 놓고 쉬프트 탭 오버레이를 끈다면은 화면 위에 고정을 해 놓은 채 게임을 플레이할 수도 있구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.237,
                "end": 21.067
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 너무 까만색 화면이라 쫌 지저분하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.077,
                "end": 23.410
            },
            {
                "speaker_id": "1",
                "transcription": "설정을 바꿔 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.420,
                "end": 24.456
            },
            {
                "speaker_id": "1",
                "transcription": "글자를 키우고",
