            },
            {
                "speaker_id": "1",
                "transcription": "들어가기 전에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.381,
                "end": 7.341
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 스팀 무료 배포가 있습니다.",
                "sound_type": [
                    2,
                    3
