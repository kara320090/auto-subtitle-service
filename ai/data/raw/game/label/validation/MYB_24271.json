        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "애니메이션 만화 영화를 준비해 놨기 때문에 그거는 감상하는 맛도 좋을 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.512
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 워낙에 작화가 멋있으니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.522,
                "end": 7.717
            },
            {
                "speaker_id": "1",
                "transcription": "멋 하나는 최고인 격투게임 길티기어 스트라이브였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.727,
                "end": 11.577
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 오늘의 스팀할인 영상이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.587,
                "end": 14.065
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 마지막으로 아까 둠을 구매했던 그린맨게이밍이 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.075,
                "end": 17.900
            },
            {
                "speaker_id": "1",
                "transcription": "네 그 사이트의 한국 공식 블로그에서 리터널을 무료로 주는 이벤트를 진행 중이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.905,
                "end": 23.490
            },
            {
                "speaker_id": "1",
                "transcription": "여기 그린맨게이밍 블로그에서 이벤트에 참여하실 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.490,
                "end": 26.747
            },
            {
                "speaker_id": "1",
                "transcription": "총 3명을 무작위로 추첨해서 리터널 PC키를 전달한다고 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.757,
                "end": 31.219
            },
            {
                "speaker_id": "1",
                "transcription": "3월 11일까지 이벤트에 참여할 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.229,
                "end": 33.670
            },
            {
                "speaker_id": "1",
                "transcription": "내일까지네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.680,
                "end": 34.700
            },
            {
                "speaker_id": "1",
                "transcription": "혹시 모르죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.700,
                "end": 35.583
            },
            {
                "speaker_id": "1",
                "transcription": "네 여러분이 이 리터널 PC키의 주인공이 될 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.593,
                "end": 39.300
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.306,
                "end": 43.670
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.680,
                "end": 44.533
            }
        ]
    },
