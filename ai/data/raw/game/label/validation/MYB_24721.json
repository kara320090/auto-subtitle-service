        "term": [
            {
                "speaker_id": "1",
                "transcription": "게임 패스 입점비도 받죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.393
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 자연스레 게임 가격을 동결하거나 낮출 수도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.403,
                "end": 4.841
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 게임 가격이 낮아 진다면 소비자도 좋죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.851,
                "end": 7.648
            },
            {
                "speaker_id": "1",
                "transcription": "예 모두가 윈윈이 될 수 있는 전략이 홍보 비용을 세이브한 채 게임 패스를 출시하는 게 될 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.658,
                "end": 13.459
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이 하이파이러시를 보면서 아 이거 좋은 전략일 수도 있겠다라는 생각을 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.469,
                "end": 18.365
            },
            {
                "speaker_id": "1",
                "transcription": "다른 개발사들도 어 이런 생각을 가져줬으면 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.375,
                "end": 21.310
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 마치면서 하이파이 러시에 대한 한줄 평을 해보자면 저는 포스포크큰의 파쿠르 플레이도 나름의 리듬감을 살린 게임이라고 생각 하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.320,
                "end": 29.848
            },
            {
                "speaker_id": "1",
                "transcription": "한줄평 포스포큰 왜 함?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.858,
                "end": 32.018
            },
            {
                "speaker_id": "1",
                "transcription": "그 반값도 안 되는 하이파이 러시하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.028,
                "end": 34.433
            }
        ]
    },
    "summary": "하이파이 러시에 대한 한줄 평을 해보자면은 저는 포스포큰의 파쿠르 플레이도 나름의 리듬감을 살린 게임이라고 생각 했는데 하이파이러시가 훨씬 더 재미 있다.",
