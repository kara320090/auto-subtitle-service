        "term": [
            {
                "speaker_id": "1",
                "transcription": "버민폴의 유저 한글 패치가 공개되었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.507
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 무려 엑스컴 플러스 다키스트 던전이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.517,
                "end": 6.303
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 포스트 아포칼립스다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.313,
                "end": 8.526
            },
            {
                "speaker_id": "1",
                "transcription": "예 제가 환장하죠 그리고 거기에 스팀펑크다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.536,
                "end": 12.200
            },
            {
                "speaker_id": "1",
                "transcription": "예 제가 좋아하는 요소들 장르들 뭐 다 들어가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.210,
                "end": 15.484
            },
            {
                "speaker_id": "1",
                "transcription": "한글 패치 소식을 보자마자 부랴부랴 플레이를 해봤는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.494,
                "end": 19.280
            },
            {
                "speaker_id": "1",
                "transcription": "너무 재밌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.290,
                "end": 20.081
            },
            {
                "speaker_id": "1",
                "transcription": "이거 이 친구는 어썸 딱지를 줘도 되지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.091,
                "end": 22.690
            },
            {
                "speaker_id": "1",
                "transcription": "일단 배경은 증기 뿜뿜하고 예 쇠 냄새 풀풀 풀기는",
                "sound_type": [
                    2,
                    3
