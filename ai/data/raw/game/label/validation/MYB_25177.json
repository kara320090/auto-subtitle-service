        "term": [
            {
                "speaker_id": "1",
                "transcription": "탄막 슈팅 게임인데 그래픽은 깔끔하고 좋아 보였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.058
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 무료니까 좋죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.068,
                "end": 4.422
            },
            {
                "speaker_id": "1",
                "transcription": "탄막 슈팅을 좋아하는 당신 와일드 캣 건 머신을 플레이해 보는 건 어떨까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.432,
                "end": 9.254
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 다음 주 무료 배포 게임을 보시면은 포장지가 또 바뀌었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.264,
                "end": 12.869
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 스토어에서 연말에 항상 이렇게 대형 무료 배포 게임들을 뿌리는데 포장지가 바뀐 거 보니까 기대가 또 많이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.879,
                "end": 19.353
            },
            {
                "speaker_id": "1",
                "transcription": "다음 주에도 꼭 찾아오셔서 무료 배포 게임을 받으시면 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.363,
                "end": 22.798
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 본격적으로 오늘의 스팀 할인 영상을 시작하겠습니다.",
                "sound_type": [
