        "term": [
            {
                "speaker_id": "1",
                "transcription": "어쌔신 크리드는 욕심부리면 안 됩니다 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.229
            },
            {
                "speaker_id": "1",
                "transcription": "모든 걸 다 여러분이 하나 하나 플레이해 보려고 하면 안 돼요.",
                "sound_type": [
                    2,
