                    2,
                    3
                ],
                "start": 6.832,
                "end": 8.917
            },
            {
                "speaker_id": "1",
                "transcription": "삼부작을 다 하려고 하면 반복을 남들보다 3배로 하는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.927,
                "end": 12.335
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 어크는 늘 그렇듯이 초반은 미치게 재밌다.",
