        "term": [
            {
                "speaker_id": "1",
                "transcription": "에디션이 5000원을 안 하기 때문에 가격 면에서는 이보다 좋은 장난감이 없죠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.694
            },
            {
                "speaker_id": "1",
                "transcription": "여기 저스트 코즈 쓰리에서는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.704,
                "end": 6.528
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 신입니다. 마음대로 할 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.538,
                "end": 8.960
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 하늘까지 날 수 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.975,
                "end": 11.650
            },
            {
                "speaker_id": "1",
                "transcription": "기지 건설 시뮬레이션의 레전드 게임이죠",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.650,
                "end": 14.112
            },
            {
                "speaker_id": "1",
                "transcription": "산소 미포함을 4월 7일까지 66퍼센트 할인해서 8840원에 판매 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.122,
                "end": 20.227
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 이런 기지 건설류 거기에 뭐 자원관리류 생존 시뮬레이션의 레전드입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.237,
                "end": 26.285
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 뭐 머저리 같은 애들 데리고 우주식민지에서 생존하는 건데요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.295,
                "end": 30.022
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 하나하나 관리를 똑바로 안 하잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.032,
                "end": 32.800
            }
        ]
    },
    "summary": "저스트 코즈 3에서는 신이고 마음대로 할 수 있고 그리고 기지 건설 시뮬레이션의 레전드 게임 산소 미포함도 4월 7일까지 66퍼센트 할인해서 판매를 하고 있다.",
