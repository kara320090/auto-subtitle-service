        "term": [
            {
                "speaker_id": "1",
                "transcription": "계기판에 버튼도 엄청 많구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.400
            },
            {
                "speaker_id": "1",
                "transcription": "조작해야 될 것도 많고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.410,
                "end": 4.183
            },
            {
                "speaker_id": "1",
                "transcription": "안내 방송도 이게 기관사가 다 일일이 하는 거더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.193,
                "end": 7.802
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 아마 한국의 실제 기관사님들도 본인이 안내 방송을 트시는 것 같은데 어디역에 갈 때 마다 안내 방송 나오는 게 아 그렇게 셀프로 트는 거였구나 요걸 느꼈습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.812,
                "end": 18.119
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 또 느낀 점 아 이거 한글화가 안 됐으면 진짜 플레이 할 엄두도 안 나는 게임이겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.129,
                "end": 24.511
            },
            {
                "speaker_id": "1",
                "transcription": "현실 고증을 철저하게 한 리얼한 시뮬레이터 게임인데 진짜 중에 진짜인 철도 덕후들에게 추천을 드리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.521,
                "end": 32.000
            }
        ]
    },
    "summary": "한 남성이 새롭게 한글화된 게임 소개하면서 내용을 설명하고 있다.",
