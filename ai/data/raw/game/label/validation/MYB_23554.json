        "term": [
            {
                "speaker_id": "1",
                "transcription": "젤다의 전설의 해가 될 것만 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.517
            },
            {
                "speaker_id": "1",
                "transcription": "저도 지금 제 젤다가 열심히 우리 집으로 배송 중인데 빨리 왔으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.527,
                "end": 8.393
            },
            {
                "speaker_id": "1",
                "transcription": "기다리기 힘드네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.403,
                "end": 10.106
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 한 주간의 흥미로운 게임 소식을 알아봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.116,
                "end": 13.475
            },
            {
                "speaker_id": "1",
                "transcription": "젤다의 전설이 역시나 너무나 훌륭한 평가를 받으면서 많은 분들이 빨리 집에 가서 게임을 플레이 해 보고 싶을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.485,
                "end": 20.422
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스테퍼 케이스 이 친구 추리게임 역전재판같은 게임을 좋아하신다면은 강추를 드리니까 한 번쯤 플레이해 보셔도 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.432,
                "end": 28.391
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재미있는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.401,
                "end": 31.934
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.944,
                "end": 32.933
            }
        ]
    },
    "summary": "한 주간의 흥미로운 게임 소식을 알아봤고 젤다의 전설이 너무나 훌륭한 평가를 받아 저와 많은 분들이 빨리 게임을 플레이해 보고 싶을 것 같아요.",
