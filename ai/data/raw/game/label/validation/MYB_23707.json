                ],
                "start": 7.665,
                "end": 11.221
            },
            {
                "speaker_id": "1",
                "transcription": "이는 깜찍하고 신박한 게임을 안 좋아할 수가 없을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.231,
                "end": 15.352
            },
            {
                "speaker_id": "1",
                "transcription": "오늘의 스팀 할인 게임들 중 꿀잼 게임들을 모아서 추천해봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.362,
                "end": 19.797
            },
            {
                "speaker_id": "1",
                "transcription": "켄시 같은 경우는 정말 재밌는데 시간이 없거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.807,
                "end": 22.629
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 저녁까지 빠르게 달려가서 구매해야 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.639,
                "end": 25.613
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
