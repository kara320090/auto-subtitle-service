                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.071
            },
            {
                "speaker_id": "1",
                "transcription": "그분도 이렇게 열받지만 유쾌한 게임이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.081,
                "end": 13.482
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이런 걸 대체 왜 추천하느냐 재미 포인트가 있어요.",
                "sound_type": [
                    2,
