        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 우리 집 지하창고에 벌레들이 나타났네 어이 젊은이 포션 좀 하나 갖다주게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.933
            },
            {
                "speaker_id": "1",
                "transcription": "선착장에 갔다 와 주게 등등 그 맛이 난다. 중세 판타지 알피지 그 맛이 나고 핵 앤 슬래시 게임이거든요. 단순하지만 재밌는 액션도 좋았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.943,
                "end": 14.564
            },
            {
                "speaker_id": "1",
                "transcription": "물건을 부수거나 상호작용할 수 있는 오브젝트들이 많았고 여러분도 플레이를 하면서 아 이거 옛날 맛 나는데 이게 알피 지지 어 이게 판타지지 이런 느낌이 드실 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.574,
                "end": 24.863
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 싱글로 플레이해도 좋지만 온라인 협동 플레이도 지원하기 때문에 친구들과 함께 즐길 수 있는 점도 플러스다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.873,
                "end": 31.088
            },
            {
                "speaker_id": "1",
                "transcription": "다만 오늘 소개하는 게임은요 모두 한글화 예정인 게임들만 소개하는데요. 얘는 데모 버전은 아직 한글이 아니더라고요. 이거는 마이너스",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.098,
                "end": 39.646
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째 추천 게임 고산지대 도시를 건설하는 게임 레이 사라 서밋 킹덤입니다. 무려 높은 산꼭대기에 마을을 건설하고 도시를 건설하는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.656,
                "end": 49.060
            },
            {
                "speaker_id": "1",
                "transcription": "특징은 아름다운 배경과 경사가 지어있는",
                "sound_type": [
                    2
                ],
                "start": 49.070,
                "end": 52.966
            }
        ]
    },
    "summary": "남성은 중세 판타지 알피지 그 맛이 나고 싱글로 플레이해도 좋지만 온라인 협동 플레이도 지원된다고 합니다. 두 번째 추천 게임 고산지대 도시를 건설하는 게임 레이 사라 서밋 킹덤인데 높은 산꼭대기에 마을을 건설하고 도시를 건설하는 게임이에요.",
