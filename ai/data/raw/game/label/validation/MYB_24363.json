        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 요즘 스타일의 게임 시스템도 채용을 해 놨기 때문에 너무 옛날 게임이라던가 너무 불편하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.684
            },
            {
                "speaker_id": "1",
                "transcription": "옛날 게임들은?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.694,
                "end": 7.401
            },
            {
                "speaker_id": "1",
                "transcription": "그런 감성은 또 아니예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.411,
                "end": 8.880
            },
            {
                "speaker_id": "1",
                "transcription": "네. 조작감이나 이런 거는 묘하게 딱딱한 옛날 조작감이 나지만 불편할 정도도 옛날 게임은 아니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.890,
                "end": 14.683
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 클래식한 감성이 좋다는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.693,
                "end": 16.770
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 뭐 메트로 배니아 시스템도 근본이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.780,
                "end": 19.424
            },
            {
                "speaker_id": "1",
                "transcription": "고성을",
                "sound_type": [
