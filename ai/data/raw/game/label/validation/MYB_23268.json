        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 볼트건은요. 너무 화려하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.816
            },
            {
                "speaker_id": "1",
                "transcription": "정 반대를 지향하는 게임이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.826,
                "end": 4.407
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 흐라트는 최대한 절제하면서 게임 속에서 스릴과 긴장감이라는 재미를 뽑아냈지만 볼트건은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.417,
                "end": 10.411
            },
            {
                "speaker_id": "1",
                "transcription": "그딴 거 없죠. 부수고 찢는다. 레트로한 등 아닐 까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.421,
                "end": 14.565
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 디알블로4 많이들 플레이 하시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.575,
                "end": 16.915
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 오리지널 디아블로보다 뭔가 이 게임이",
                "sound_type": [
                    2,
