        "term": [
            {
                "speaker_id": "1",
                "transcription": "한가지 질문드려도 될까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.404
            },
            {
                "speaker_id": "1",
                "transcription": "저에게 이렇게 물어 보는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.414,
                "end": 3.631
            },
            {
                "speaker_id": "1",
                "transcription": "그 제가 뭐 어 예 하세요. 예 뭐 질문 못할 이유 없죠. 예 그러니까 이분이 말하길",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.641,
                "end": 8.507
            },
            {
                "speaker_id": "1",
                "transcription": "혹시 유튜버 아니신가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.517,
                "end": 9.643
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저는 살짝 뜨끔하긴 했는데 솔직히 전혀 겁이 안 났습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.653,
                "end": 13.672
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 왜냐면은 절대 모를 거라고 생각을 했어요 저를.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.682,
                "end": 16.420
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 저분이 그냥 자기가 많이 보는 다른 유튜버분이랑 착각했겠거니 하고 생각을 했는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.430,
                "end": 22.146
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 유튜버분이라고 생각하냐고 그러니까 그 분이 혹시 말 많은 에서 여기까지 여기까지 딱 말씀하시더라고요 그죠 어.",
                "sound_type": [
                    2,
                    3
                ],
