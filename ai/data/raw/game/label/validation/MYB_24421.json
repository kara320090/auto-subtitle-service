                ],
                "start": 0.000,
                "end": 5.156
            },
            {
                "speaker_id": "1",
                "transcription": "제가 지금은 정확하게 기억이 안 나는데 기술들끼리 엮어서 독성이 추가 된다거나",
                "sound_type": [
