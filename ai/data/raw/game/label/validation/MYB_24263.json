                ],
                "start": 1.580,
                "end": 6.942
            },
            {
                "speaker_id": "1",
                "transcription": "네 그렇지만 마냥 쉬운 게임은 아니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.950,
                "end": 8.810
            },
            {
                "speaker_id": "1",
                "transcription": "어느 순간 내 뒤통수까지 와 있는 적들을 발견할 때 섬찟 섬찟합니다.",
                "sound_type": [
