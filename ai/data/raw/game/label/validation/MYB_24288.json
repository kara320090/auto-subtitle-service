        "term": [
            {
                "speaker_id": "1",
                "transcription": "2월 22일 출시한 용과 같이 유신 극이 좋은 평가를 받고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.341
            },
            {
                "speaker_id": "1",
                "transcription": "용과 같이 시리즈의 외전이기 때문에 연결된 스토리도 아니고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.351,
                "end": 8.633
            },
            {
                "speaker_id": "1",
                "transcription": "시대 배경도 다르고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.643,
                "end": 9.840
            },
            {
                "speaker_id": "1",
                "transcription": "네 주인공들이 전부 어디서 본 친숙한 얼굴들이지만 뭐 얼굴만 같지 다른 인물이라고 생각을 하면 되는 게임 시리즈네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.840,
                "end": 17.465
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저도 용과 같이 시리즈는 몇 개 플레이를 해 봤지만 이 외전을 해본 적이 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.475,
                "end": 21.360
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 게임 자체는 할만한 게임인 것 같은데 제가 하나 불만인 점은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.360,
                "end": 26.065
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 2014년 작의 리메이크인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.070,
                "end": 28.450
            },
            {
                "speaker_id": "1",
                "transcription": "아예 하나부터 열까지 뜯어고친 게임은 아니고 대부분 원작과 비슷한 공격모션이라든가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.460,
                "end": 34.533
            }
        ]
    },
    "summary": "용과 같이 유신 극이 2월 22일 출시하였는데 좋은 평가를 받고 있으며 용과 같이 시리즈의 외전이기 때문에 스토리가 연결된 것은 아니고 등장인물들도 얼굴만 비슷하지 다른 인물이라고 생각하면 되고 이 게임은 2014년 작의 리메이크이다.",
