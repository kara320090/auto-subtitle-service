                    3
                ],
                "start": 0.000,
                "end": 1.532
            },
            {
                "speaker_id": "1",
                "transcription": "그런 걸 말하는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.542,
                "end": 2.916
            },
            {
                "speaker_id": "1",
                "transcription": "게임 내에서는 뭐 사람이라면 당연하죠.",
                "sound_type": [
