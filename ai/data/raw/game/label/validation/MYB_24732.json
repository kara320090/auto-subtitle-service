                    3
                ],
                "start": 2.926,
                "end": 5.220
            },
            {
                "speaker_id": "1",
                "transcription": "강동원이 왔는데 남자도 고민하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.230,
                "end": 7.972
            },
            {
                "speaker_id": "1",
                "transcription": "저도 지금 강동원이 와서 사귀자 그러면 네 살짝 0 점 초는 고민하겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.982,
                "end": 14.401
            },
            {
                "speaker_id": "1",
                "transcription": "예 그래서 어쨌든 배신 안 하는 게 중요한 거지 예 고민은 누구나 할 수 있다 사람이라면.",
