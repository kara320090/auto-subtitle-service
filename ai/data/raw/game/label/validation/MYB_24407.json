        "term": [
            {
                "speaker_id": "1",
                "transcription": "깜짝 놀랄만한 연출들이 기다리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.077
            },
            {
                "speaker_id": "1",
                "transcription": "저는 처음에 내가 이걸 뭘 본 거지 눈을 의심했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.087,
                "end": 5.435
            },
            {
                "speaker_id": "1",
                "transcription": "그 정도로 도트 그래픽과 연출이 훌륭하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.445,
                "end": 8.028
            },
            {
                "speaker_id": "1",
                "transcription": "다음은 액션의 재미 액션은 깊이가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.038,
                "end": 11.053
            },
            {
                "speaker_id": "1",
                "transcription": "공격 커맨드를 다양하게 조합하면서 각종 기술과 콤보를 사용할 수 있고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.063,
                "end": 16.571
            },
            {
                "speaker_id": "1",
                "transcription": "패링과 반격 시스템 또한 훌륭합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.581,
                "end": 19.387
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 액션의 깊이가 너무 깊은 것 같기도 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.397,
                "end": 22.401
            },
            {
                "speaker_id": "1",
                "transcription": "저는 네 게임의 액션을 제대로 즐기려면은 숙지해야 하는 기술들이나 익혀야 할 타이밍들이",
