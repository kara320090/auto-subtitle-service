        "term": [
            {
                "speaker_id": "1",
                "transcription": "하나의 유행을 따라가는 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.907
            },
            {
                "speaker_id": "1",
                "transcription": "에 또한 그러한 게임들이 대부분 좋은 평가를 받고 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.917,
                "end": 4.932
            },
            {
                "speaker_id": "1",
                "transcription": "어 예를 들면은 제가 좋아 하는 메탈을 심어라 하는 메탈 플러스 두물 섞은 듯한 게임도 좋은 평가를 받았었는 이번 하이파이 러시 역시 초대박 평가를 받고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.942,
                "end": 15.665
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 게임이냐 데빌 메이크라의 리듬을 섞은 게임이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.675,
                "end": 18.983
            },
            {
                "speaker_id": "1",
                "transcription": "데빌 메이크라의 장점이 뭐냐 다양한 공격 콤보를 통한 스타일리시한 액션이 장점이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.993,
                "end": 24.783
            },
            {
                "speaker_id": "1",
                "transcription": "하이파이러시는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.793,
