                "sound_type": [
                    2,
                    3
                ],
                "start": 12.565,
                "end": 14.143
            },
            {
                "speaker_id": "1",
                "transcription": "7월 20일까지 에픽게임즈 스토어에서 트레인 밸리2를 무료 배포 중입니다.",
                "sound_type": [
                    2,
