                "sound_type": [
                    2,
                    3
                ],
                "start": 3.451,
                "end": 6.240
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 출시한 따끈따끈한 신작 게임 소식과 기대작의 새로운 소식도 있습니다.",
                "sound_type": [
