        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리는 그 반군들을 하나하나 수색을 해나가야 되는 단 한 명만 뒤에 남겨 놓고 와도요 소대가 전멸합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.929
            },
            {
                "speaker_id": "1",
                "transcription": "숨어있는 모든 반군을 색출해내야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.939,
                "end": 8.154
            },
            {
                "speaker_id": "1",
                "transcription": "아 이래서 게릴라 반군과의 시가전이 무서운 거구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.164,
                "end": 12.043
            },
            {
                "speaker_id": "1",
                "transcription": "어 마치 게임을 플레이하는 느낌보다는요 다큐를 플레이하고 보는 듯한 예 말도 안 되는 느낌이 들어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.053,
                "end": 17.900
            },
            {
                "speaker_id": "1",
                "transcription": "예 현실적인 그래픽.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.910,
                "end": 19.033
            },
            {
                "speaker_id": "1",
                "transcription": "현실적인 건플레이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.043,
                "end": 20.259
            },
            {
                "speaker_id": "1",
                "transcription": "장탄이 몇 발 남았는지 확인하려면요 탄창를 뽑아서 두 눈으로 직접 봐야 되는 디테일함과 UI까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.269,
                "end": 26.831
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 4인 협동 업계에서 물건이 아닌가.",
