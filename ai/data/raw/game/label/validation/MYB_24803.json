        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "각자의 고유한 특성을 맞춰가면서 전투를 할 수 있는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.171
            },
            {
                "speaker_id": "1",
                "transcription": "이 특성을 갈아 끼는 게 진짜 다른 게임에서는 본 적이 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.181,
                "end": 7.390
            },
            {
                "speaker_id": "1",
                "transcription": "예 매우 방대하고 각 특성들이 서로 연결되고 상호 작용하면서 전투가 재미있어져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.400,
                "end": 13.312
            },
            {
                "speaker_id": "1",
                "transcription": "대충 비유를 들어서 설명을 하자면은 어마어마하게 많은 양의 패시브 스킬이 존재하는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.322,
                "end": 19.122
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 패시브 스킬들을 캐릭터에 막 조합을 맞춰서 이 패시브 끼고 이 패시브 끼고 막 하는데 이게 패시브 양이 어마어마하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.132,
                "end": 26.142
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이걸 어떻게 잘 상호 작용되게 야무지게 만들어 냈는지 모르겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.152,
                "end": 30.016
            },
            {
                "speaker_id": "1",
                "transcription": "이 점은 해보지 않고서는 모릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.026,
                "end": 31.663
            },
            {
                "speaker_id": "1",
                "transcription": "게임 플레이 타임이 꽤나 긴 편인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.673,
                "end": 33.847
            },
            {
                "speaker_id": "1",
                "transcription": "그 중에 반 이상이 이 패시브 스킬",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.857,
                "end": 36.300
            }
        ]
    },
    "summary": "트러블슈터는 매우 방대한 양의 패시브 스킬들을 캐릭터에 맞게 조합해서 상호 작용하면서 전투를 할 수 있고 게임 플레이 타임이 꽤 긴 편이다.",
