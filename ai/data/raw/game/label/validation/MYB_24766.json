        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 이거를 맨 처음에 기획한 사람이 누구일까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.819
            },
            {
                "speaker_id": "1",
                "transcription": "어 맨 처음 아이디어를 내신 분이 누구고 이 아이디어를 오케이한 분들은 또 누구일까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.829,
                "end": 9.542
            },
            {
                "speaker_id": "1",
                "transcription": "예 통과된 것도 어이없죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.552,
                "end": 10.848
            },
            {
                "speaker_id": "1",
                "transcription": "근데 재미있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.858,
                "end": 11.809
            },
            {
                "speaker_id": "1",
                "transcription": "이런 게 이제 참신한 시도고 좋은 도전이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.819,
                "end": 14.583
            },
            {
                "speaker_id": "1",
                "transcription": "갈 때까지 가버린 낡았던 기존의 용과 같이 시스템과 스토리를 새롭게 바꿨다는 점에서 좋고 현대 일본판의 드래곤 퀘스트와 용과 같이를 보고 싶다면 강추를 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.593,
                "end": 24.853
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 턴제 전투는 조금 좋아하셔야지 재밌게 하실 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.863,
                "end": 28.420
            },
            {
                "speaker_id": "1",
                "transcription": "용과 같이 시리즈를 나는 모른다 입문해 보고 싶다 하셔도 플레이해도 좋고 여러분이 S급 같은 B급 게임을 플레이해 보고 싶으시다면 용과 같이 7을 플레이해 보는 건",
                "sound_type": [
