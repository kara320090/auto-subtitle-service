                "end": 8.294
            },
            {
                "speaker_id": "1",
                "transcription": "네 뭘 익히든 게임에 별 영향을 주지도 않고 뭐 좋아 보이는 것도 별 거 없습니다.",
                "sound_type": [
                    2,
