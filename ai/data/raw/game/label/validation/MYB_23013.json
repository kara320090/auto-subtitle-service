        "term": [
            {
                "speaker_id": "1",
                "transcription": "7월 13일까지 진행 중인 스팀 여름 세일.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.573
            },
            {
                "speaker_id": "1",
                "transcription": "플레이타임 가성비 짱짱한 트리플 에이 게임들과 그냥 가성비 게임들도 모아봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.583,
                "end": 7.718
            },
            {
                "speaker_id": "1",
                "transcription": "그거 아시나요 여러분?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.728,
                "end": 8.631
            },
            {
                "speaker_id": "1",
                "transcription": "이제는 트리플 에이 게임들은 가성비다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.641,
                "end": 11.638
            },
            {
                "speaker_id": "1",
                "transcription": "어 웬만한 인디 게임들이 가격이 만만치가 않죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.648,
                "end": 14.701
            },
            {
                "speaker_id": "1",
                "transcription": "예 할인도 잘 안하고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.711,
                "end": 15.885
            },
            {
                "speaker_id": "1",
                "transcription": "근데 트리플 게임들은 잘만 만들면요 뭐 다 가성비 좋은 게임들이 맞습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.895,
                "end": 20.347
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 야무지게 준비해 왔는데 본격적으로 들어가기 전에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.357,
                "end": 24.100
            }
        ]
    },
