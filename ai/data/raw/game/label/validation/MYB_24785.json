    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "농사를 해서 돈 벌어서 다시 귀운파를 부활시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.387
            },
            {
                "speaker_id": "1",
                "transcription": "내가 약 오르는 점이 바로 여기인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.397,
                "end": 5.659
            },
            {
                "speaker_id": "1",
                "transcription": "이 쥐뿔도 없는 귀운파 놈들이 힘든 일을 안 하려고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.669,
                "end": 8.908
            },
            {
                "speaker_id": "1",
                "transcription": "농사를 나만 지어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.918,
                "end": 10.271
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그런데 돈이 없다고 막 징징대 가지고 그럼 같이 농사를 지어보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.281,
                "end": 15.465
            },
            {
                "speaker_id": "1",
                "transcription": "어 우리 함께 열심히 농사를 해서 돈을 벌어 보면 어떻겠느냐 하면은 지는 또 농사를 해본 적이 없다 그러면서 안 하려고 그럽니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.475,
                "end": 21.595
            },
            {
                "speaker_id": "1",
                "transcription": "예 누군 해봤나 이거를",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.605,
                "end": 23.110
            },
            {
                "speaker_id": "1",
                "transcription": "예 그래서 지금 다시 생각해도 개 열받네요 이거 진짜로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.120,
                "end": 26.070
            },
            {
                "speaker_id": "1",
                "transcription": "예 심지어 나는 귀운파 사람도 아니죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.080,
                "end": 28.055
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 우연히 지나가는 길이었는디 예 어쨌든 이 개차반 놈들하고 같이 멸망한 문파를 일으키면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.065,
                "end": 34.286
            },
            {
                "speaker_id": "1",
                "transcription": "요게 재미있는 점은 일단 무공을 사용한 전투도 존재하고 사람들과 상호 작용도 하고 호감도도 올릴 수 있고 예 그리고 가장 재미있는 점은 사실 요리입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.296,
                "end": 43.376
            },
            {
                "speaker_id": "1",
                "transcription": "요리 시스템이 잘 돼 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.386,
                "end": 45.030
            },
            {
                "speaker_id": "1",
                "transcription": "농사 짓거나 낚시해서 얻은 요리 재료들로 마을 객잔의 부엌에서 요리를 할 수가 있는데 의외로 잘 되어 있고 재미있더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.040,
                "end": 52.249
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 제가 또 요리를 하러 자주 간 게 여기 객잔 주인 아주머니도 한 미모 하시고 어 따님도 예쁘더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.259,
                "end": 57.274
            },
            {
                "speaker_id": "1",
                "transcription": "단점은 아직 앞서 해보기의 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.284,
                "end": 59.477
            },
            {
                "speaker_id": "1",
                "transcription": "나온 지 얼마 안 된 게임이기 때문에 현재 15퍼센트 할인밖에 없지만 우리가 23퍼센트 쿠폰을 받았죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.487,
                "end": 65.395
            },
            {
                "speaker_id": "1",
                "transcription": "예 여기다 추가로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.405,
                "end": 66.600
            }
        ]
    },
    "summary": "이모탈 라이프에서 나는 귀운파 사람들과 함께 멸망한 문파를 일으키게 되는데 재밌는 점은 무공을 사용한 전투도 있고 사람들과의 상호 작용으로 호감도를 올리고 농사짓거나 낚시로 얻은 요리 재료들로 마을 객잔의 부엌에서 요리할 수 있다는 것이고 단점은 아직 앞서 해보기 게임이라는 것이다.",
