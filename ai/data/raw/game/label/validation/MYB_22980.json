    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "픽셀로 가득한 세상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.434
            },
            {
                "speaker_id": "1",
                "transcription": "내가 사용하는 마법이 픽셀로 아름답게 폭발하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.444,
                "end": 5.011
            },
            {
                "speaker_id": "1",
                "transcription": "내 몸뚱아리도 아름답게 터져 나가네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.021,
                "end": 7.317
            },
            {
                "speaker_id": "1",
                "transcription": "노이타를 50% 할인해서 10250원에 판매 중이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.327,
                "end": 11.287
            },
            {
                "speaker_id": "1",
                "transcription": "모든 오브젝트와 자연환경이 부셔지는 세상에서 밑으로 동굴을 탐험해 나아가는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.297,
                "end": 17.497
            },
            {
                "speaker_id": "1",
                "transcription": "픽셀은 아름답지만 동시에 위험하기도 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.507,
                "end": 20.387
            },
            {
                "speaker_id": "1",
                "transcription": "조그마한 불씨 하나는 불에 타는 모든 걸 태워나가기도 하고 용암도 위험하고 독도 위험하고 심지어는 내가 사용하는 마법들도 너무나도 위험하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.397,
                "end": 28.898
            },
            {
                "speaker_id": "1",
                "transcription": "어 내가 하는 모든 행동이 다양하게 상호 작용되고 픽셀들이 폭발해 나가고 터져 나가고 불이 붙고 불을 물로 끌 수 있는 상호 작용 갓겜.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.908,
                "end": 37.153
            },
            {
                "speaker_id": "1",
                "transcription": "일단 수상한 픽셀이 흐른다면 피하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.163,
                "end": 40.008
            },
            {
                "speaker_id": "1",
                "transcription": "노이타를 2개는 살 수 있었겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.018,
                "end": 42.396
            },
            {
                "speaker_id": "1",
                "transcription": "스파이더맨 시리즈가 등장하기 전 최고의 히어로 게임이 있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.406,
                "end": 46.068
            },
            {
                "speaker_id": "1",
                "transcription": "배트맨 아캄 컬렉션을 85% 할인해서 9150원에 판매 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.078,
                "end": 50.795
            },
            {
                "speaker_id": "1",
                "transcription": "배트맨 1 2 3가 포함된 뭐 가히 최고의 히어로 게임 중 하나다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.805,
                "end": 54.953
            },
            {
                "speaker_id": "1",
                "transcription": "배트맨이 되어서 도시의 밤하늘을 가로 지르는 재미.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.963,
                "end": 58.221
            },
            {
                "speaker_id": "1",
                "transcription": "범죄자들과 싸우는 재미.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.231,
                "end": 59.502
            },
            {
                "speaker_id": "1",
                "transcription": "영화 속 유명한 빌런들과 겨루는 재미.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.512,
                "end": 61.846
            },
            {
                "speaker_id": "1",
                "transcription": "액션과 탐험의 재미가 뛰어나고 직관적인 게임을 플레이는요 진입 장벽를 많이 낮추기 때문에 특히나 스팀 뉴비분들께도 강추드리는 시리즈 중 하나입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.856,
                "end": 71.431
            },
            {
                "speaker_id": "1",
                "transcription": "게임 결말도 환상적이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.441,
                "end": 73.444
            },
            {
                "speaker_id": "1",
                "transcription": "배트맨의 고뇌가 여실히 드러나는 뭐 기승전결이 완벽한 시리즈가 아닌가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.440,
                "end": 78.295
            },
            {
                "speaker_id": "1",
                "transcription": "에 단 자동차는 좀 극혐이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.305,
                "end": 80.310
            },
            {
                "speaker_id": "1",
                "transcription": "게임 3개가 포함된 배트맨 아캄 컬렉션을 2개를 살 수 있었겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.320,
                "end": 84.907
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 게임 6개였겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.917,
                "end": 86.933
            }
        ]
    },
    "summary": "배트맨 아캄 컬렉션은 배트맨의 고뇌가 여실히 드러나는 뭐 기승전결이 완벽한 시리즈가 아닌가 생각한다.",
