                ],
                "start": 3.783,
                "end": 9.391
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지가 손즈 오브 더 포레스트의 놀라운 점 그리고 장점이었는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.401,
                "end": 13.735
            },
            {
                "speaker_id": "1",
                "transcription": "그 외에는 사실 전부 미완성이자 단점입니다.",
