        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번 쇼케이스에서 제가 가장 놀랐던 게임 중국이 만든 무협 액션 펜텀 블레이드를 제로입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 16.449
            },
            {
                "speaker_id": "1",
                "transcription": "무채색에 가까운 색감은 다크 소울이 떠오르고 빠른 몸놀림은 쎄키로가 떠오르는데 이거 액션은 무협이다 트레이러 상으로는 정말 말도 안 되는 게임이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.459,
                "end": 27.026
            },
            {
                "speaker_id": "1",
                "transcription": "심지어는 변검이라던가 중국 고유의 문화도 잘 녹여내고 있더라 감상 포인트는 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.036,
                "end": 33.446
            },
            {
                "speaker_id": "1",
                "transcription": "그저 놀라워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.456,
                "end": 34.212
            },
            {
                "speaker_id": "1",
                "transcription": "에 트레일러처럼 나올 수 있을 지가 궁금한 게임이고 하나를 꼽아보자면 저 무협 액션이 어 실제 게임 컨트롤에서 어느 정도로 구현할 수 있을 지가 감이 좀 잡히네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.222,
                "end": 45.191
            },
            {
                "speaker_id": "1",
                "transcription": "놀랍고 기대되는 게임이었습니다.",
                "sound_type": [
                    2,
