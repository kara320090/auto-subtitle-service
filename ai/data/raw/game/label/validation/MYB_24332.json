        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "역시나 현재 82점이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.980
            },
            {
                "speaker_id": "1",
                "transcription": "대체 왜 이런 기이한 현상이 나왔냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.990,
                "end": 4.090
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 와룡은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.090,
                "end": 5.538
            },
            {
                "speaker_id": "1",
                "transcription": "재미있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.540,
                "end": 6.345
            },
            {
                "speaker_id": "1",
                "transcription": "재미있는 게임입니다만 요즘 게임들 특징이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.355,
                "end": 9.500
            },
            {
                "speaker_id": "1",
                "transcription": "네 신작 게임이 신작 게임 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.500,
                "end": 11.970
            },
            {
                "speaker_id": "1",
                "transcription": "최적화해서 매우 매우 아쉬운 모습을 보여주면서 유저들의 스팀 평가가 수직 하락했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.970,
                "end": 18.861
            },
            {
                "speaker_id": "1",
                "transcription": "참고로 이 스팀 평가들에는 키보드, 마우스 유저들의 불만도 존재했는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.871,
                "end": 22.928
            },
            {
                "speaker_id": "1",
                "transcription": "만약 이 와룡을 컨트롤러 없이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.938,
                "end": 25.933
            }
        ]
    },
    "summary": "와룡 게임의 스팀 평가와 메타스코어가 다른 기이한 현상이 나오는 것은 재미는 있는 게임이지만 신작 게임이고 최적화를 해서 매우 아쉬운 모습을 보여주면서 유저들의 스팀 평가가 하락했다.",
