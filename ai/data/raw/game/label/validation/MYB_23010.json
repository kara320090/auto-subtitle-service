        "term": [
            {
                "speaker_id": "1",
                "transcription": "무기 카드를 이용해서 단순하게 필드의 적들을 제거할 수도 있지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.147
            },
            {
                "speaker_id": "1",
                "transcription": "이 무기들은 공격 기능만 있는 게 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.157,
                "end": 6.928
            },
            {
                "speaker_id": "1",
                "transcription": "예 무기 카드를 버리게 되면서 스피드런과 플랫포머에서 유용하게 사용할 수 있는 기능들도 있는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.928,
                "end": 12.635
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들면 뭐 권총 카드를 공중에서 버린다면 점프를 한 번 더 할 수 있다거나 샷건 카드 같은 경우는 하이 점프가 된다거나 라이플 카드는 앞으로 대시한다거나 등등.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.645,
                "end": 22.246
            },
            {
                "speaker_id": "1",
                "transcription": "예 적재적소에 카드를 버리면서 스피드런을 야무지게 통과해야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.256,
                "end": 26.416
            },
            {
                "speaker_id": "1",
                "transcription": "짜릿한 스피드 액션과 흥미로운 스토리까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.426,
                "end": 28.988
            },
            {
                "speaker_id": "1",
                "transcription": "액션 파트 즐기고 와서 스토리 파트 즐기고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.988,
                "end": 31.350
            },
            {
                "speaker_id": "1",
                "transcription": "갓게임이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.360,
                "end": 32.500
            }
        ]
    },
    "summary": "이 게임은 적재적소에 무기 카드를 버리면서 스피드런을 야무지게 통과해야 한다.",
