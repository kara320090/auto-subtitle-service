        "term": [
            {
                "speaker_id": "1",
                "transcription": "악어 만나면 도망 다니기 바쁘다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.750
            },
            {
                "speaker_id": "1",
                "transcription": "에 하지만 우리가 조금만 강해진다면 곧 곳곳에 숨어 있는 강자들을 찾아 다니는 재미가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.760,
                "end": 8.332
            },
            {
                "speaker_id": "1",
                "transcription": "물론 나를 쫓아오는 현상금 사냥꾼들과 싸우는 것도 괜찮고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.342,
                "end": 12.265
            },
            {
                "speaker_id": "1",
                "transcription": "맨이터 심심풀이 킬링타임용으로 좋은 게임이지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.275,
                "end": 16.332
            },
            {
                "speaker_id": "1",
                "transcription": "이 모든 게 반복이라는 단점은 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.342,
                "end": 19.575
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 오늘의 할인하는 스팀 게임들을 추천해봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.585,
                "end": 23.485
            },
            {
                "speaker_id": "1",
                "transcription": "에픽스토어 무료 배포 관심 있는 분들은 꼭 받으셔서 플레이를 해보시고 저처럼 렘넌트2를 노려보고 있었던 분들은 그린맨 게이밍 구매 괜찮은 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.495,
                "end": 32.234
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
