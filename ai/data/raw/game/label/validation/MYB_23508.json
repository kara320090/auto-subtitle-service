        "term": [
            {
                "speaker_id": "1",
                "transcription": "결승이었죠 사실상",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.214
            },
            {
                "speaker_id": "2",
                "transcription": "그치 필리아 대 유리",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.224,
                "end": 3.511
            },
            {
                "speaker_id": "1",
                "transcription": "일단 여왕님 올라오시고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.521,
                "end": 5.282
            },
            {
                "speaker_id": "2",
                "transcription": "유리가 어떻게 여기까지 왔는지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.292,
                "end": 6.887
            },
            {
                "speaker_id": "1",
                "transcription": "하하 유리는 유리는 그 이제 약자들만 상대하면서 올라왔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.897,
                "end": 13.104
            },
            {
                "speaker_id": "2",
                "transcription": "아니 그리고 내가 약간 붕대 버프를 많이 줬나 봐 내가 왜 자꾸 얘 올렸지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.114,
                "end": 17.679
            },
            {
                "speaker_id": "1",
                "transcription": "아니 현아가 떨어졌는데 유리가 여까지 올라왔다고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.689,
                "end": 21.260
            },
            {
                "speaker_id": "2",
                "transcription": "이게 뭔지도 모르겠는데 붕대만 감고 있다고 올라오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.270,
                "end": 24.895
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 제가 이제 설명할 때 주인공을 사지로 몰아넣고 싸가지는 없다고 했는데 여기까지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.905,
                "end": 31.697
            },
            {
                "speaker_id": "2",
                "transcription": "이래서 사람이 뭐가 임팩트가 있어야 되는 게 붕대가 자꾸 눈에 들어오잖아 필리아 퀸",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.707,
                "end": 36.701
            },
            {
                "speaker_id": "1",
                "transcription": "아우 너무 웃기다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.711,
                "end": 37.658
            },
            {
                "speaker_id": "2",
                "transcription": "어 여왕님",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.668,
                "end": 38.683
            },
            {
                "speaker_id": "1",
                "transcription": "사실 이시은과 박하민이 진짜 결승이었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.693,
                "end": 41.536
            },
            {
