        "term": [
            {
                "speaker_id": "1",
                "transcription": "그냥 인터넷이나 유튜브에서 이거 빌드 검색해서 재밌어 보이는 거 골라서 플레이 하시는 것도 저는 추천을 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.503
            },
            {
                "speaker_id": "1",
                "transcription": "맨 땅에 헤딩하는 것도 뭐 나름의 재미가 있지만 이렇게 빌드 검색해서 플레이 하는 것도 스트레스 안 받고 굉장히 좋더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.513,
                "end": 12.537
            },
            {
                "speaker_id": "1",
                "transcription": "스팀 무료 게임의 유저 한글 패치가 하나 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.547,
                "end": 16.506
            },
            {
                "speaker_id": "1",
                "transcription": "간단한 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.516,
                "end": 17.855
            },
            {
                "speaker_id": "1",
                "transcription": "플레이 타임 20분 정도면 끝나는 아주 짧은 무료 게임입니다.",
                "sound_type": [
                    2
                ],
                "start": 17.865,
                "end": 22.228
            },
            {
                "speaker_id": "1",
                "transcription": "올해 2월에 출시한 미싱 하이커라는 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.238,
                "end": 25.261
            },
            {
                "speaker_id": "1",
                "transcription": "내 동생이 하이킹을 하는 도중에 실종이 되었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.271,
                "end": 28.501
            },
            {
                "speaker_id": "1",
                "transcription": "근데 경찰한테 신고를 해도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.511,
                "end": 30.266
            }
        ]
    },
    "summary": "한 남성이 새롭게 한글화된 게임 소개하면서 내용을 설명하고 있다.",
