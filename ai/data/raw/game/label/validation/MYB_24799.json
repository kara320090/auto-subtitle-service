                ],
                "start": 2.272,
                "end": 3.591
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이걸 왜 얘기했느냐 스토브에서만 한글로 즐길 수 있는 스토브 한글화 게임입니다.",
                "sound_type": [
