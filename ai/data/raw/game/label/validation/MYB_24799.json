                ],
                "start": 3.601,
                "end": 8.270
            },
            {
                "speaker_id": "1",
                "transcription": "근데 심지어 타이핑 게임이에요 이거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.280,
                "end": 10.735
            },
            {
                "speaker_id": "1",
                "transcription": "예 그래서 한글이 좀 필요하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.745,
                "end": 12.541
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 영타로 플레이해도 큰 상관은 없긴 하지만 한글로 즐길 수 있으면 더 좋다.",
