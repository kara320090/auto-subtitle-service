        "term": [
            {
                "speaker_id": "1",
                "transcription": "다른 사람을 이기지 못하는 분들은 에이아이가 상대라면은 또 재밌게 할 수도 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.750
            },
            {
                "speaker_id": "1",
                "transcription": "우리가 또 에이아이라고 너무 무시하면 안됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.760,
                "end": 7.977
            },
            {
                "speaker_id": "1",
                "transcription": "예 인공 지능이 마냥 우습지만은 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.987,
                "end": 10.606
            },
            {
                "speaker_id": "1",
                "transcription": "가끔씩 총 잘 쏘는 애들이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.616,
                "end": 12.762
            },
            {
                "speaker_id": "1",
                "transcription": "에 또 에이아이한테 솔직히 말씀 드리자면은 진적이 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.772,
                "end": 16.637
            },
            {
                "speaker_id": "1",
                "transcription": "예 이 샷발 싸움에서 많이 졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.647,
                "end": 18.886
            },
            {
                "speaker_id": "1",
                "transcription": "예 얘네들도 잘 쏘네들이 간간이 있더라고요.",
                "sound_type": [
