        "term": [
            {
                "speaker_id": "1",
                "transcription": "게임 내에서 파괴하는 모든 행위가 곧 돈을 버는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.313
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 뭐 신경 쓸 이유가 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.323,
                "end": 5.028
            },
            {
                "speaker_id": "1",
                "transcription": "그저 부슬 뿐 장점이 단순하고 호쾌한 게임 플레이라라면 단점 역시도 단순함이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.038,
                "end": 10.972
            },
            {
                "speaker_id": "1",
                "transcription": "게임에 이렇다 할 깊이감은 없고 어 그저 단순하게 때려 부수는 킬링 타임형 게임이기 때문에 복잡한 게임이 싫으신 분들께 추천을 많이 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.982,
                "end": 18.987
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 단순함의 유력은.",
