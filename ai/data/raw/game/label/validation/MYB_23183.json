        "term": [
            {
                "speaker_id": "1",
                "transcription": "한글화 계획이 없다 아니면은 아 우리 진행할 거다 이것도 아니고 그냥 논의 중이래요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.759
            },
            {
                "speaker_id": "1",
                "transcription": "예 근데 지금 당장 9월 6일 출시 예정인데 아직 논의 중인 게 말이 됩니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.769,
                "end": 10.874
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 한글화 시작도 안 했단 얘기죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.884,
                "end": 12.417
            },
            {
                "speaker_id": "1",
                "transcription": "지금 당장 시작해도 그때까지 못 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.427,
                "end": 14.672
            },
            {
                "speaker_id": "1",
                "transcription": "너무 열받는다 이거는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.682,
                "end": 15.793
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 안 할 거라고 말하던가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.803,
                "end": 17.566
            }
        ]
    },
    "summary": "게임 출시가 얼마 남지도 않았는데 계획이 없다던가 진행 중이라는 것도 아니고 논의 중이라는 말은 아직 시작도 안 했다는 얘기이기 때문에 너무 화가 난다.",
