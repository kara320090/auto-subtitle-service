                "transcription": "푹 찌고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.301,
                "end": 7.179
            },
            {
                "speaker_id": "1",
                "transcription": "네 뚜껑을 열면 안 됩니다.",
