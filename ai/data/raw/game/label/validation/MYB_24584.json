        "term": [
            {
                "speaker_id": "1",
                "transcription": "한 센스 하는 분인가 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.332
            },
            {
                "speaker_id": "1",
                "transcription": "평가가 좋네요.",
