            },
            {
                "speaker_id": "1",
                "transcription": "예 가짜라는 뜻입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.612,
                "end": 2.197
            },
            {
                "speaker_id": "1",
                "transcription": "가짜라는 말은 거기서 일어난 일들이 다 없었던 일이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.207,
                "end": 6.076
            },
            {
                "speaker_id": "1",
                "transcription": "예 그럼 탐정이 필요 없는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.086,
                "end": 7.568
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 사람들은 이런 식으로 생각을 할 수 있는데 그게 아니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.578,
                "end": 11.493
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 이제 사이버 펑크의 매력이 나오는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.503,
                "end": 13.974
            },
            {
                "speaker_id": "1",
                "transcription": "이들에게는 가상 세계가 진짜더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.984,
                "end": 16.649
            },
            {
                "speaker_id": "1",
                "transcription": "혹은 진짜 세계보다도 더 중요한 걸 수도 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.659,
                "end": 19.425
            },
            {
                "speaker_id": "1",
                "transcription": "예 가상 세계는 인간의 본성이 튀어나오는 곳입니다.",
