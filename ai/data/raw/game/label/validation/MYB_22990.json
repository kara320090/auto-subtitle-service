        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜로 하찮게 생긴 애들이 어 254명이 모여가지고 전쟁을 하는데 있을 거 다 있다는 거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.244
            },
            {
                "speaker_id": "1",
                "transcription": "예 무기도 많고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.244,
                "end": 7.469
            },
            {
                "speaker_id": "1",
                "transcription": "부착물도 많고 탈 것도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.479,
                "end": 9.569
            },
            {
                "speaker_id": "1",
                "transcription": "헬기 있고 뭐 탱크 있고 보트도 있고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.579,
                "end": 11.809
            },
            {
                "speaker_id": "1",
                "transcription": "예 별 거 별 거 다 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.819,
                "end": 13.136
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 맵의 거의 모든 오브젝트들이 부서집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.146,
                "end": 16.720
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 전술적인 선택으로 벽을 부수고 들어가거나 폭파 시키고 돌입하거나 할 수 있는 예 있을 게 다 있는 대규모 전쟁 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.730,
                "end": 23.518
            },
            {
                "speaker_id": "1",
                "transcription": "또 하찮게 생긴 이유 때문인지 죽어도 별 타격이 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.528,
                "end": 27.091
            },
            {
                "speaker_id": "1",
                "transcription": "예 그냥 다시 태어나서 총 쏘러 가면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.101,
                "end": 29.287
