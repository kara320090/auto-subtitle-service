        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 말 그대로 청소만 하는 그 게임 그치만 이게 호불호의 영역이겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.570
            },
            {
                "speaker_id": "1",
                "transcription": "저는 별로지만 많은 스팀 유저들이 좋아해 주는 이유가 있을 거라 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.580,
                "end": 9.148
            },
            {
                "speaker_id": "1",
                "transcription": "그 이유는 아마 노동을 통한 힐링이겠죠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.158,
                "end": 11.936
            },
            {
                "speaker_id": "1",
                "transcription": "더러워진 곳을 열심히 청소하면서 깨끗하게 만들었을 때의 그 보람참 힐링 파워 워시 시뮬레이터에는 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.946,
                "end": 19.766
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 온라인 멀티도 되니까요 예 함께 청소하면은 더 재밌겠네요.",
                "sound_type": [
