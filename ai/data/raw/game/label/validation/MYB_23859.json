        "term": [
            {
                "speaker_id": "1",
                "transcription": "끝내주는 타격감 우와 소리가 절로 나옵니다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.738
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 양손 무기 묵직한 거 한 번 휘두르면은 그냥 우와죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.748,
                "end": 6.772
            },
            {
                "speaker_id": "1",
                "transcription": "비슷한 류의 액션 로그라이크 게임 중에서 타격감은 원탑이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.782,
                "end": 11.534
            },
            {
                "speaker_id": "1",
                "transcription": "이런 류의 게임 대장이 하데스잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.544,
                "end": 13.774
            },
            {
                "speaker_id": "1",
                "transcription": "모든 면에서 하데스가 앞서지만 타격감 하나만큼은 네 이 커스 오브 더 데드갓이 이긴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.784,
                "end": 18.879
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 타격감 때문에라도 한 번쯤 플레이해 볼만 합니다.",
                "sound_type": [
                    2,
