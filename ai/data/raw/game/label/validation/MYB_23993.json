                    2,
                    3
                ],
                "start": 2.735,
                "end": 4.498
            },
            {
                "speaker_id": "1",
                "transcription": "어 지금 자기들이 만든 게임에 너무 자신감이 넘치는 상태로 보여요.",
                "sound_type": [
