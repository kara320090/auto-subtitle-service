        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거는 인정합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.795
            },
            {
                "speaker_id": "1",
                "transcription": "예 너무 무서운 이름이긴 한데 예 잘 알아보니까 아무 문제는 없더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.807,
                "end": 4.248
            },
            {
                "speaker_id": "1",
                "transcription": "에 가입하시고 무료 배포 받으시고 유저 한글 패치 적용하고 로봇캐시 론처를 통해서 게임을 실행하면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.252,
                "end": 10.820
            },
            {
                "speaker_id": "1",
                "transcription": "참고로 가입할 때 스팀 계정을 이용하면 어 뭔가 오류가 생기니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.820,
                "end": 15.115
            },
            {
                "speaker_id": "1",
                "transcription": "다른 이메일 통해서 가입하는 걸 추천 드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.125,
                "end": 17.473
            },
            {
                "speaker_id": "1",
                "transcription": "짤막하게 웨이스트랜드 3에 대해서 설명을 드리자면 포스트 아포칼립스 RPG입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.483,
                "end": 22.513
            },
            {
                "speaker_id": "1",
                "transcription": "예 동료들을 모아서 멸망한 세상에서 종횡무진 활약하는 RPG 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.523,
                "end": 27.228
            },
            {
                "speaker_id": "1",
                "transcription": "멸망한 세상답게 골 때리는 일들 많이 일어나죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.238,
                "end": 30.307
            },
            {
                "speaker_id": "1",
                "transcription": "에 직접 여러분들이 경험을 하시면서 하나하나 해결해도 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.317,
                "end": 33.705
            },
            {
                "speaker_id": "1",
                "transcription": "나도 등쳐먹을 수도 있고 아니면",
