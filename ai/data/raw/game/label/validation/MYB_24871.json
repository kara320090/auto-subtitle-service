                    3
                ],
                "start": 0.000,
                "end": 5.925
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 좋은 게임이 나와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.935,
                "end": 7.332
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 두 가지를 잘 했다는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.342,
                "end": 9.147
            },
            {
                "speaker_id": "1",
                "transcription": "애는 좋습니다.",
