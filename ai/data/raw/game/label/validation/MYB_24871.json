                ],
                "start": 9.157,
                "end": 10.280
            },
            {
                "speaker_id": "1",
                "transcription": "이천이십이년 정식 출시한 게임 그라운디드입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.290,
                "end": 13.392
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임도 참 재밌고 멀티로 플레이하기도 좋은 게임이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.402,
                "end": 16.521
            },
            {
                "speaker_id": "1",
                "transcription": "아이들이 개미만큼 작아져서 집 마당에서 생존을 하는 게임인데요.",
