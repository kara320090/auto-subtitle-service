        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 중세 판타지 공성전을 모바 장르로 플레이하는 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.460
            },
            {
                "speaker_id": "1",
                "transcription": "모바장르는 다들 아시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.470,
                "end": 6.795
            },
            {
                "speaker_id": "1",
                "transcription": "롤 같은 게임이라고 생각을 하면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.805,
                "end": 9.152
            },
            {
                "speaker_id": "1",
                "transcription": "전사 마법사 성직자들이 각자의 성을 지키고 상대방의 성을 함락하기 위해 싸우는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.162,
                "end": 15.792
            },
            {
                "speaker_id": "1",
                "transcription": "굉장히 화려한 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.802,
                "end": 17.276
            },
            {
                "speaker_id": "1",
                "transcription": "만약 다른 어떤 게임에 공성전이라는 이제 콘텐츠가 있다면 꼭 그 알짜배기 공성전만을 떼와서 만든 게임 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.286,
                "end": 25.595
            },
            {
                "speaker_id": "1",
                "transcription": "거대한 맵에서 20명 대 20명 대규모의 플레이어들이 전투를 벌이는데 우리가 생각하는 중세 판타지 공성전이 다 들어가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.605,
                "end": 34.433
            }
        ]
    },
    "summary": "전사 마법사 성직자들이 각자의 성을 지키고 상대방의 성을 함락하기 위해 싸우는데 거대한 맵에서 20명 대 20명 대규모의 플레이어들이 전투를 벌이는데 우리가 생각하는 중세 판타지 공성전이 다 들어가 있다.",
