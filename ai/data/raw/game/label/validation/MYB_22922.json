        "term": [
            {
                "speaker_id": "1",
                "transcription": "교도소장이 되어 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.310
            },
            {
                "speaker_id": "1",
                "transcription": "교도소를 커스텀하고 재소자들을 관리하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.320,
                "end": 4.019
            },
            {
                "speaker_id": "1",
                "transcription": "밥도 먹이고 재우고 운동장 만들어 주고 싸움 못하게 말리고 어느 순간 정신 차려보면 재소자들의 복지와 행복을 위해 힘껏 애쓰는 나의 모습을 발견할 수 있더라 에 죄수들이 너무 행복해 보일 때는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.029,
                "end": 16.809
            },
            {
                "speaker_id": "1",
                "transcription": "옥타곤도 한번 만들어서 싸움도 붙여보죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.819,
                "end": 19.482
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임을 정확하게 설명하는 방법은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.492,
                "end": 22.059
            },
            {
                "speaker_id": "1",
                "transcription": "어항을 만들고 어항 속의 물고기를 쳐다보는 게임이라고 생각하면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.069,
                "end": 26.518
            },
            {
                "speaker_id": "1",
                "transcription": "교도소를 만들고 재소자들이 어떻게 살아가는지 지켜보는 게임 무려 1300시간 동안 지켜보신 분도 있습니다.",
                "sound_type": [
