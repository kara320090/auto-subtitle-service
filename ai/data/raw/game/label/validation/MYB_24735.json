        "term": [
            {
                "speaker_id": "1",
                "transcription": "있다는 것 할아버지의 유골을 들고 은하 장례식으로 향하던 중 우주선이 난파 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.513
            },
            {
                "speaker_id": "1",
                "transcription": "여러분은 이제 홀로 거대한 우주에서 표류하게 되었네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.523,
                "end": 9.377
            },
            {
                "speaker_id": "1",
                "transcription": "브레스엣지를 1월 31일까지 60퍼센트 할인해서 만 400원에 판매 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.387,
                "end": 15.070
            },
            {
                "speaker_id": "1",
                "transcription": "아무도 없는 우주에서 잔해들을 긁어 모아 생존을 하는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.080,
                "end": 19.119
            },
            {
                "speaker_id": "1",
                "transcription": "음식도모으고 부서진 재료들을 모아서 더 나은 장비를 개발하기도 하고 생존에 필요한 구조물을 짓기도 하는 크래프팅 게임인데 바다에서 살아남는 크래프팅 게임인데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.129,
                "end": 26.918
            },
            {
                "speaker_id": "1",
                "transcription": "바다에서 살사남는 크래프팅 게임 서브노티카의 우주버전이라고 생각하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.928,
                "end": 32.055
            },
            {
                "speaker_id": "1",
                "transcription": "장점은 일단 분위기죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.052,
                "end": 33.733
            }
        ]
