        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 이렇게 에픽스토어에서 무료배포했을 때가 사람이 가장 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.521
            },
            {
                "speaker_id": "1",
                "transcription": "멀티로 즐기는 게임들은 사람 많을 때 해야죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.531,
                "end": 7.109
            },
            {
                "speaker_id": "1",
                "transcription": "에 지금이 최적이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.119,
                "end": 8.711
            },
            {
                "speaker_id": "1",
                "transcription": "다음은 스팀입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.721,
                "end": 10.424
            },
            {
                "speaker_id": "1",
                "transcription": "2월 8일 공세시까지 더 싸이클프론티어의 디엘씨 폴투나서바이벌을 무료 배포 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.434,
                "end": 16.738
            },
            {
                "speaker_id": "1",
                "transcription": "더 싸이클프론티어도 피브이피브이의 멀티 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.748,
                "end": 20.958
            },
            {
                "speaker_id": "1",
                "transcription": "애초에 무료 플레이 게임이기 때문에 지금 이 폴트나 디엘씨를 받고 입문을 하기에 최적일 수 있겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.968,
                "end": 27.372
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이 게임을 해본 건 아닌데 퀄리티는 좋은 걸로 압니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.382,
                "end": 30.675
            },
            {
                "speaker_id": "1",
                "transcription": "게임의 퀄리티는 좋지만 서버 문제에서 아쉬움을 많이 드러냈기 때문에 평가가 낮다라고 하더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.685,
                "end": 36.676
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 무료로 디엘씨 하나 주는 거는 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.686,
                "end": 39.382
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기까지 오늘의 스팀 할인과 무료배포 게임들을 만나봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.382,
                "end": 43.759
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 오늘 뭐 0점 5 국밥 게임들이 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.769,
                "end": 46.235
            },
            {
                "speaker_id": "1",
                "transcription": "가격이 싸서 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.245,
                "end": 47.296
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 재미있는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
