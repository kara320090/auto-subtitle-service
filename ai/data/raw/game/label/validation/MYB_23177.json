        "term": [
            {
                "speaker_id": "1",
                "transcription": "대놓고 들어가서 힘으로 밀어버릴 수도 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.986
            },
            {
                "speaker_id": "1",
                "transcription": "에픽스토어에서 페이데이 2편을 현재 무료배포 중이기도 하구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.996,
                "end": 5.815
            },
            {
                "speaker_id": "1",
                "transcription": "저도 몇 번 추천을 드렸다 싶을 정도로 제가 개인적으로 좋아하는 게임이자 수많은 코옵 게임들이 있지만 아 페이데이만큼 괜찮은 것도 찾기 힘듭니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.825,
                "end": 14.393
            },
            {
                "speaker_id": "1",
                "transcription": "좋아진 그래픽, 다양한 기능들이 추가되면서 더욱 재밌는 전략 슈팅 정보를 즐길 수 있겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.403,
                "end": 20.373
            },
            {
                "speaker_id": "1",
                "transcription": "우리가 현실에서는 은행을 못 털지만 게임에서는 시원하게 털 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.383,
                "end": 24.452
            },
            {
                "speaker_id": "1",
                "transcription": "출시도 얼마 안 남았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.462,
                "end": 25.735
            },
            {
                "speaker_id": "1",
                "transcription": "예 페이데이 쓰리는 9월 22일 출시 예정을 알렸네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.745,
                "end": 29.000
            }
        ]
    },
    "summary": "곧 출시를 앞둔 에픽데이 3은 개인적으로 좋아진 그래픽과 다양한 기능들이 추가되어서 더욱 재밌게 즐길 수 있으며 개인적으로도 많이 추천하는 게임으로 현재 2편을 무료 배포 중이기도 하다.",
