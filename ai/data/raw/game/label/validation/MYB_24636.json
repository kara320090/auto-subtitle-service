                "end": 5.341
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 대세가 게임 예약 구매 안 하는 게 대세거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.351,
                "end": 8.420
            },
            {
                "speaker_id": "1",
                "transcription": "근데 젤다는 참을 수가 없다.",
