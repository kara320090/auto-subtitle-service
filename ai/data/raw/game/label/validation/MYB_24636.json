                    3
                ],
                "start": 8.430,
                "end": 9.976
            },
            {
                "speaker_id": "1",
                "transcription": "다들 뭐 통수 조심하느라 얘 구하지 마라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.986,
                "end": 13.045
            },
            {
                "speaker_id": "1",
                "transcription": "말씀을 많이 하지만 젤다는 못 참죠?",
