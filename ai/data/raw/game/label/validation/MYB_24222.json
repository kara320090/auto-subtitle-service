        "term": [
            {
                "speaker_id": "1",
                "transcription": "파이어볼 한 방에는 안 죽더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.530
            },
            {
                "speaker_id": "1",
                "transcription": "그러나 역시 익은 사슴고기가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.540,
                "end": 4.116
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 이 정도는 아직 뭐 큰 만족은 안 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.126,
                "end": 6.964
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다면 과연 곰은 어떨까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.974,
                "end": 8.956
            },
            {
                "speaker_id": "1",
                "transcription": "곰에게도 던져봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.966,
                "end": 10.394
            },
            {
                "speaker_id": "1",
                "transcription": "곰은 진짜 셉니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.404,
                "end": 11.588
            },
            {
                "speaker_id": "1",
                "transcription": "마나 포션을 먹어가면서 파이어볼을 쐈습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.598,
                "end": 14.262
            },
            {
                "speaker_id": "1",
                "transcription": "결과는 들익은 곰고기가 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.272,
                "end": 16.460
            },
            {
                "speaker_id": "1",
                "transcription": "아니 맙소사 여기서 저는 지렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.470,
                "end": 18.824
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.834,
                "end": 19.566
            }
        ]
    },
