        "term": [
            {
                "speaker_id": "1",
                "transcription": "낭만이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.654
            },
            {
                "speaker_id": "1",
                "transcription": "예 낭만이 있는 중세 오픈 월드다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.664,
                "end": 2.965
            },
            {
                "speaker_id": "1",
                "transcription": "대장장이의 아들로 시작해서 부모님의 원수를 갚기 위해 떠난 중세 오픈 월드 모험이 이 정도로 재미있고 낭만이 있을 줄은 몰랐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.975,
                "end": 11.248
            },
            {
                "speaker_id": "1",
                "transcription": "출세, 복수, 사랑 귀족들의 낭만까지도 내가 확인할 수 있는 모든 중세의 낭만이 이 게임이 있더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.258,
                "end": 18.501
            },
            {
                "speaker_id": "1",
                "transcription": "수시로 그냥 가슴이 웅장해집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.511,
                "end": 20.861
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 중세 시뮬레이터라고 불릴 정도로 디테일한 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.871,
                "end": 24.543
            },
            {
                "speaker_id": "1",
                "transcription": "배 고프면 먹어야 되고 뭐 졸리면 자야 되고 이 정도 게임은 많죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.553,
                "end": 28.500
            },
            {
                "speaker_id": "1",
                "transcription": "예 이 정도는 약과입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.510,
                "end": 29.601
            },
            {
                "speaker_id": "1",
                "transcription": "드러워지면 씻어야 되고 칼에 피 묻은 것도 닦아야 되고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.611,
                "end": 33.233
            }
        ]
    },
    "summary": "킹덤 컴 딜리버런스는 대장장이의 아들로 시작해서 부모님의 원수를 갚기 위해 떠나는 모험으로 출세, 복수, 사랑, 귀족들의 낭만까지 확인할 수 있는 중세 오픈 월드 게임으로 중세 시뮬레이터라고 불릴 정도로 디테일한 게임이다.",
