        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래픽도 이쁘고 아바타 세계관에서 나비족으로 플레이하면은 재밌겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.159
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 제가 유비소프트랑 잘 어울린다라고 생각을 했던 가장 큰 이유는 딱 보자마자 이거 아 이거 파크라이인데 아바타 버전의 파크라이잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.169,
                "end": 15.519
            },
            {
                "speaker_id": "1",
                "transcription": "아 보자마자 바로 느꼈습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.529,
                "end": 17.864
            },
            {
                "speaker_id": "1",
                "transcription": "어 파크라이 시리즈를 아바타로 만드는 것 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.874,
                "end": 20.414
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 지구에서 그 못된 놈들이 아바타 그 행성에 가서 전진 기지를 막 세워 놓고 자원을 뽑아 먹잖아요 얘네들이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.424,
                "end": 27.038
            },
            {
                "speaker_id": "1",
                "transcription": "예 그거 이제 기지 파괴하고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.048,
                "end": 30.200
            }
        ]
    },
    "summary": "유비소프트와 잘 어울린다고 생각을 했던 가장 큰 이유는 게임을 보자마자 파크라이 시리즈를 아바타로 만든 것 같다는 느낌이 들어서였다.",
