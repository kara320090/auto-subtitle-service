        "term": [
            {
                "speaker_id": "1",
                "transcription": "공략하는 이러한 스테이지들로 이루어져 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.505
            },
            {
                "speaker_id": "1",
                "transcription": "매우 독특하고 참신하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.515,
                "end": 4.660
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 이 개발자 입장에서 생각해 보자면은 자기가 스테이지 안 만들어 되니까 개꿀이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.670,
                "end": 10.855
            },
            {
                "speaker_id": "1",
                "transcription": "예, 너무 좋다 편하겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.865,
                "end": 13.556
            },
            {
                "speaker_id": "1",
                "transcription": "예, 아주 독특한 게임이고 아이디어도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.566,
                "end": 16.324
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 다른 친구 1명과 함께 최대 2명이서 디펜스 기지를 건설할 수도요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.334,
                "end": 21.370
            },
            {
                "speaker_id": "1",
                "transcription": "함께 습격도 할 수 있기 때문에 협동 플레이를 원하는 분들의 입장에서도 이 게임 주목해 보지 않을 이유가 없더라 밋 유어 메이커였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.380,
                "end": 29.533
            }
        ]
    },
    "summary": "개발자가 스테이지를 만들지 않았다는 독특함이 있고 최대 2명이 함께 디펜스 기지를 건설할 수 있고 습격할 수 있기 때문에 협동 플레이를 할 수 있어 좋다.",
