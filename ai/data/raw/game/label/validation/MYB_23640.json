                    3
                ],
                "start": 0.000,
                "end": 7.687
            },
            {
                "speaker_id": "1",
                "transcription": "산소통도 업그레이드해서 예 좀 더 우주에서 오래 활동할 수 있게 되어야 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.697,
                "end": 12.263
            },
            {
                "speaker_id": "1",
                "transcription": "예 점차 활동 반경을 넓히고 목적지까지 나아가는 재미있는 성취감이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.273,
                "end": 17.251
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로는 강추를 드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.261,
                "end": 19.039
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 스토어에서 꽤나 좋은 게임을 무료로 주네요.",
                "sound_type": [
                    2,
