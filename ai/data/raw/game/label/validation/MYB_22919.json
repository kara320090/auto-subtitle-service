        "term": [
            {
                "speaker_id": "1",
                "transcription": "살 만한 게임 뭐가 있을까 할인하는 스팀 게임들을 정리해 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.525
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 무료 배포부터 받고 시작하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.535,
                "end": 5.851
            },
            {
                "speaker_id": "1",
                "transcription": "GOG에서 7월 17일 22시까지 더 위스퍼러를 무료 배포 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.861,
                "end": 10.787
            },
            {
                "speaker_id": "1",
                "transcription": "19세기 초 로어 캐나다를 배경으로 한 포인트 앤 클릭 어드벤처 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.797,
                "end": 16.191
            },
            {
                "speaker_id": "1",
                "transcription": "로어 캐나다가 뭔가 싶어서 찾아보니까 캐나다 퀘벡주의 옛날 명칭이라고 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.201,
                "end": 21.416
            },
            {
                "speaker_id": "1",
                "transcription": "1814년 로어 캐나다의 외딴 계곡의 한 교육소가 발견되었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.426,
                "end": 26.561
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 거기서 사람이 실종되었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.571,
                "end": 28.752
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 우리는 실종된 사람을 찾는 건데 무섭네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.762,
                "end": 31.554
            },
            {
                "speaker_id": "1",
                "transcription": "에 공포 미스터리 어드벤처 게임이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.564,
                "end": 33.880
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 GOG에서 받으시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.890,
                "end": 35.712
            },
            {
                "speaker_id": "1",
                "transcription": "오늘의 스팀 할인 정리 시작하죠.",
