        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "내가 조금 더 쉽게 요 게임 화면 위에 오버레이로 띄울 수가 있는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.661
            },
            {
                "speaker_id": "1",
                "transcription": "내가 게임을 플레이하다가 막히는 구간이 생겼다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.671,
                "end": 6.120
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 쉽게 쉬프트 탭 누르고 가이드 들어가서 에 공략을 보면 좋지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.130,
                "end": 10.488
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 여기 보니까 다른 유저 분들이 올렸던 뭐 도전 과제를 깨는 가이드라던가 아니면 엔딩에 있어서 분기 등등이 나와 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.498,
                "end": 18.507
            },
            {
                "speaker_id": "1",
                "transcription": "당연하게도 어 스포를 조심해야 되기 때문에 요거는 가벼운 마음으로 누르면 안 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.517,
                "end": 23.786
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 게임을 플레이하면서 쉽게 접근할 수 있는 점은 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.796,
                "end": 26.953
            },
            {
                "speaker_id": "1",
                "transcription": "다섯 번째는 토론입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.963,
                "end": 28.212
            },
            {
                "speaker_id": "1",
                "transcription": "어 요거는 주로 개발자님 혹은 다른 플레이어들과 함께 게임에 대해서 토론을 하면서 뭐 이렇게 업데이트되면 좋겠다 아니면은 요거 좀 문제 있는 것 같다 요거 버그 있는 것 같다 등을 알릴 수도 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.222,
                "end": 38.869
            },
            {
                "speaker_id": "1",
                "transcription": "여기 첫 번째 탭을 보시면은 입 벌린 CG 볼 쪽에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.879,
                "end": 42.033
            }
        ]
    },
    "summary": "가이드 탭은 게임을 하다가 막히면 간편하게 들어가서 공략을 보거나 하면 좋을 것 같지만 스포 방지를 위해서 가벼운 마음으로 눌러서는 안 될 것 같고 다섯 번째는 토론 탭인데 개발자님과 플레이어들이 함께 업데이트나 수정할 점에 대해 알리거나 의견을 나눌 수 있다.",
