        "term": [
            {
                "speaker_id": "1",
                "transcription": "준비할까 말까 굉장히 고민을 많이 했던 게임이고 지금도 사실 고민중이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.490
            },
            {
                "speaker_id": "1",
                "transcription": "네 시간이 날 때 리뷰영상으로 올릴 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.490,
                "end": 7.623
            },
            {
                "speaker_id": "1",
                "transcription": "지금 간단하게만 말씀을 드리자면 이 게임은 소재가 굉장히 좋은 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.630,
                "end": 12.566
            },
            {
                "speaker_id": "1",
                "transcription": "재료가 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.576,
                "end": 13.695
            },
            {
                "speaker_id": "1",
                "transcription": "그래픽 엄청 좋죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.705,
                "end": 15.190
            },
            {
                "speaker_id": "1",
                "transcription": "게임 디자인은 미친 수준입니다 이거.",
