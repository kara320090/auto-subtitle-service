                "end": 6.902
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로는 여러분들도 아 한 번쯤 플레이해보셨으면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.912,
                "end": 11.278
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 돈 한 푼 안 들기도 하고요.",
