        "term": [
            {
                "speaker_id": "1",
                "transcription": "게임의 퀄리티가 발전한 게임이라는 평가가 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.098
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 제가 지적했던 여러 명의 주인공이 따로 노는 스토리는 여전하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.108,
                "end": 7.878
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 전체적인 퀄리티가 높아진 옥토패스 트래블러 기대가 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.888,
                "end": 12.394
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기까지 우리가 놓쳤던 2월의 스팀 신작은 뭐가 있는지 만나봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.404,
                "end": 16.965
            },
            {
                "speaker_id": "1",
                "transcription": "과연 여러분은 어떤 게임을 놓치였나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.975,
                "end": 19.090
            },
            {
                "speaker_id": "1",
                "transcription": "네 저는 옥토패스 트래블러 2 정도는 제가 놓쳤다는 생각이 드네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.090,
                "end": 23.937
            },
            {
                "speaker_id": "1",
                "transcription": "그만큼 2월에는 너무 많은 게임들이 출시해서 플레이할 시간이 많이 부족했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.940,
                "end": 28.584
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재미있는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.594,
                "end": 32.634
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.644,
                "end": 33.533
            }
        ]
    },
    "summary": "옥토패스 트래블러 2는 퀄리티가 많이 발전한 게임이라는 평가가 많지만 여전히 여러 명의 주인공이 따로 노는 스토리는 여전하고 2월은 많은 게임들이 출시를 해서 옥토패스 트래블러 2를 놓친 것 같다.",
