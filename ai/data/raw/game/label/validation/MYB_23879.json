        "term": [
            {
                "speaker_id": "1",
                "transcription": "가상의 도시 하란시에 여러분은 특수 요원으로서 잠입을 하게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.605
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 벌어지는 좌충우돌 좀비들과의 뜨거웠던 여름이야기 파쿠르를 통해 막 건물 위를 달리면서 좀비들을 따돌리고 어려운 미션을 수행할 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.615,
                "end": 15.161
            },
            {
                "speaker_id": "1",
                "transcription": "느려터진 좀비들을 이리저리 약 올리면서 지붕 위로 막 뛰어 당긴다면은 얼마나 재밌겠습니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.171,
                "end": 20.680
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 파쿠르가 잘 돼 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.690,
                "end": 22.625
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 밤이 되면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.635,
                "end": 24.074
            },
            {
                "speaker_id": "1",
                "transcription": "이야기는 달라집니다.",
