                "start": 1.136,
                "end": 5.654
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지가 제가 와룡을 추천하는 이유인 가벼운 재미 복잡하지 않은 재미였는데요.",
                "sound_type": [
                    2,
