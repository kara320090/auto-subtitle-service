                "end": 11.353
            },
            {
                "speaker_id": "1",
                "transcription": "그 1편인 드래곤즈 도그마 다크 어라이즌을 6월 21일까지 84퍼센트 할인해서 4640원에 판매 중이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.363,
                "end": 19.206
            },
            {
                "speaker_id": "1",
                "transcription": "판타지 끝판왕 중 하나인 게임이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.216,
                "end": 21.002
            },
            {
                "speaker_id": "1",
                "transcription": "동료들과 함께 드넓은 판타지 세상에서 모험을 하는 게임 히드라도 만나구요.",
                "sound_type": [
