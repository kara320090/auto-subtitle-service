        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 게임을 플레이한다 하더라도 충분히 플레이하기 좋은 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.986
            },
            {
                "speaker_id": "1",
                "transcription": "이건 제가 예전에도 말했죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.996,
                "end": 5.453
            },
            {
                "speaker_id": "1",
                "transcription": "디자인에 관심 있는 분들은 이거 하나만 보고 플레이해도 제값 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.463,
                "end": 9.203
            },
            {
                "speaker_id": "1",
                "transcription": "그만큼 놀라운 상상력을 아름다운 디자인으로 구현한 게임이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.213,
                "end": 13.380
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 아토믹 하트의 플레이스테이션 버전 출시에 맞춰 과연 이 게임 플레이할 만한지 알아봤는데요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.390,
                "end": 20.011
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 선형적인 액션 FPS를 좋아하신다면은 아토믹 하트 정말 재밌게 플레이할 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.021,
                "end": 26.281
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 놀라운 디자인이 감칠맛을 더해주죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.291,
                "end": 29.165
            },
            {
                "speaker_id": "1",
                "transcription": "대신 주의할 점 지상의 오픈 월드 필드는 빠르게 달려서 스킵합시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.175,
                "end": 33.815
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 저 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.825,
                "end": 37.244
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.254,
                "end": 38.133
            }
        ]
    },
