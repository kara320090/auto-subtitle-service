        "term": [
            {
                "speaker_id": "1",
                "transcription": "인력이 없어서 지금 수색을 못 나간다 그러고 조금 더 오래 실종 되면 에 실종 기간이 좀 더 길어지면은 그때 수색을 해보겠다 이런 답변만 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.647
            },
            {
                "speaker_id": "1",
                "transcription": "이 때문에 주인공인 형은 홀로 산속으로 동생을 찾아 떠나는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.657,
                "end": 16.890
            },
            {
                "speaker_id": "1",
                "transcription": "매우 짧고 간단하지만 스릴이 있는 게임이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.900,
                "end": 19.288
            },
            {
                "speaker_id": "1",
                "transcription": "스팀 평가가 매우 긍정적으로 좋은 편인데 솔직히 말하면 어 이게 왜 매우 긍정적일까라는 생각은 듭니다 저는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.298,
                "end": 26.279
            },
            {
                "speaker_id": "1",
                "transcription": "에 아무래도 공짜라는 점에서 높은 평가를 주지 않았나 혹은 너도 한 번 당해봐라라는 느낌 일단 20분 정도로 짧은 마치 데모 버전같은 무료 게임이지만 강렬한은 게임 체험해보고 싶은 분들께 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.289,
                "end": 39.751
            },
            {
                "speaker_id": "1",
                "transcription": "유저 한글 패치는요 네이버 블로그 @이름1 님께서 진행을 해주셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.761,
                "end": 44.376
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 오늘은 스팀 무료 게임의 유저 한글 패치와 스토브인디 공식 한글화 게임들을 만나봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.386,
                "end": 50.616
            },
            {
                "speaker_id": "1",
                "transcription": "새롭게 재미있어 보이는 게임들이 많이 한글화가 됐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.626,
                "end": 53.728
            },
            {
                "speaker_id": "1",
                "transcription": "우리 도리도리 쿠폰 듀리듀리 15퍼센트 할인 쿠폰도 많이 씁시다 좋네요.",
                "sound_type": [
