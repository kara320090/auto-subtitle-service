        "term": [
            {
                "speaker_id": "1",
                "transcription": "무협지 버전으로 즐긴다고 생각을 하시면 딱 맞습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.123
            },
            {
                "speaker_id": "1",
                "transcription": "이건 뭐 컨셉부터 재미가 없을 수가 없죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.133,
                "end": 5.270
            },
            {
                "speaker_id": "1",
                "transcription": "문제는 이 게임의 컨셉 중에서 저를 약 올리는 게 하나 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.280,
                "end": 9.670
            },
            {
                "speaker_id": "1",
                "transcription": "이모탈 라이프의 스토리가 뭐냐면은 귀운파라는 무림의 문파가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.680,
                "end": 14.414
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 귀운파에 운석이 떨어졌나 어 해 가지고 멸망한 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.424,
                "end": 17.957
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 나는 우연히 게스트로 왔는데 하필 그날 망한 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.967,
                "end": 21.582
            },
            {
                "speaker_id": "1",
                "transcription": "예 그래서 문파가 박살 나고 이 귀운파 애들이 집도 절도 없이 어 생 밑바닥부터 다시 문파를 만들어야 되는 상황에서 내가 함께 꼽사리 껴서 도와주는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.592,
                "end": 31.098
            },
            {
                "speaker_id": "1",
                "transcription": "뭘로 도와주냐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.108,
                "end": 32.133
            }
        ]
    },
    "summary": "이모탈 라이프의 스토리는 귀운파라는 무림의 문파가 있는데 내가 우연히 이곳에 게스트로 온 날 운석이 떨어져서 귀운파가 박살이 나서 내가 귀운파 사람들과 함께 재건을 위해 밑바닥부터 도와준다는 내용이다.",
