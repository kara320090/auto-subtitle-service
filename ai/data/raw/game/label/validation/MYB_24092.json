        "term": [
            {
                "speaker_id": "1",
                "transcription": "에프피에스 게임에서 우리가 연막탄 많이 사용하죠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.120
            },
            {
                "speaker_id": "1",
                "transcription": "예 주로 적에게서 시야를 차단하기 위해서 연막을 사용하는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.130,
                "end": 7.437
            },
            {
                "speaker_id": "1",
                "transcription": "기존에 우리가 사용하던 연막은요 게임적 허용이라고 해야 될지 아니면은 단순한 기술력 부족인지 실제 연막하고는 거리가 멀죠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.447,
                "end": 16.368
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 연막은 단순한 연기잖아요 예 기체란 말이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.378,
                "end": 19.858
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 기존의 에프피에스 게임에서에 연막탄은 기체의 특징을 가지고 있지는 않았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.868,
                "end": 24.913
            },
            {
                "speaker_id": "1",
                "transcription": "예 그냥 앉은 자리에 연막을 깔면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.923,
                "end": 27.066
            }
        ]
    },
    "summary": "게임에서 연막탄을 많이 사용하는데 기존에 사용하던 연막탄은 실제 연막하고는 거리가 멀다.",
