                ],
                "start": 1.938,
                "end": 10.238
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 완전 문드 문드러진 녹아내린 사람이 있네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.248,
                "end": 14.902
            },
            {
                "speaker_id": "1",
                "transcription": "어 이 사람은 뭐하는 사람일까?",
                "sound_type": [
                    2,
                    3
                ],
