        "term": [
            {
                "speaker_id": "1",
                "transcription": "극한의 호러 게임으로 변한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.022
            },
            {
                "speaker_id": "1",
                "transcription": "무진장 재밌는 게임 다잉라이트 인헨스트 에디션 좀비 그리고 나 그때의 하란시는 여름이었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.032,
                "end": 9.825
            },
            {
                "speaker_id": "1",
                "transcription": "스팀 세일로 넘어가기 전에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.835,
                "end": 11.256
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 스토어에서도 봄 세일을 시작을 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.266,
                "end": 14.203
            },
            {
                "speaker_id": "1",
                "transcription": "다잉라이트도 줬으니까 뭐 살 거 있나 한번 찾아보자고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.213,
                "end": 17.738
            },
            {
                "speaker_id": "1",
                "transcription": "현재 에픽스토어 독점으로 있는 세인츠로우를 4월 20일까지 55퍼센트 할인 중이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.748,
                "end": 23.479
            },
            {
                "speaker_id": "1",
                "transcription": "세인츠로우는 출시했을 때 제가 리뷰 영상을 올렸던 게임이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.489,
                "end": 26.969
            },
            {
                "speaker_id": "1",
                "transcription": "가상의 미국 오픈 월드 도시에서 범죄 벤처기업을 세워가지고 최고가 되자.",
