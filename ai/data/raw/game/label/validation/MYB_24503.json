        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기까지 유저 한글 패치나 공식 한글화가 진행된 게임들을 만나봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.814
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 무료로 플레이 할 수 있는 두 개의 게임이 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.824,
                "end": 7.324
            },
            {
                "speaker_id": "1",
                "transcription": "헤븐 번즈 레드랑 어느 겨울밤 네 명의 나그네가라는 두 가지 게임이 있는데 개인적으로는 제가 플레이해봤던 여느 겨울밤 네 명의 나그네가 어 이 게임은 짤막하고 무료이기 때문에 여러분들도 시간 남으시는 분들은 한 번쯤 플레이해보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.334,
                "end": 22.262
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 만한 값어치가 있는 도트 그래픽과 음악 그리고 연출입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.272,
                "end": 26.319
            },
            {
                "speaker_id": "1",
                "transcription": "저는 굉장히 좋게 플레이를 했네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.329,
                "end": 28.207
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.217,
                "end": 32.165
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.175,
                "end": 33.200
            }
        ]
