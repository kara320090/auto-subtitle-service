                    2,
                    3
                ],
                "start": 2.961,
                "end": 8.847
            },
            {
                "speaker_id": "1",
                "transcription": "숲을요 완벽하게 구현해 놨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.857,
                "end": 10.851
            },
            {
                "speaker_id": "1",
                "transcription": "물론 자잘한 버그들도 있고 아직 구현이 안 된 부분들도 있지만 아직 완성까지 한참 남은 앞서해보기 게임이라는 걸 감안했을 때",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.861,
                "end": 19.159
            },
            {
                "speaker_id": "1",
                "transcription": "완성되기까지 기대가 많이 됩니다.",
