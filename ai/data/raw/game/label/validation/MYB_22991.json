        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "해병들과 함께 에일리언이 가득한 건물을 수색합시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.918
            },
            {
                "speaker_id": "1",
                "transcription": "20일 출시한 에일리언 다크 디센트가 좋은 평가를 받고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.928,
                "end": 7.411
            },
            {
                "speaker_id": "1",
                "transcription": "게임 진행에 영향을 주는 자잘한 버그들이 많아서 평가가 확 깼지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.421,
                "end": 11.902
            },
            {
                "speaker_id": "1",
                "transcription": "재미가 없다고 평가 낮게 주는 사람은 거의 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.912,
                "end": 14.672
            },
            {
                "speaker_id": "1",
                "transcription": "재미 하나만큼은 확실한 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.682,
                "end": 16.628
            },
            {
                "speaker_id": "1",
                "transcription": "마치 엑스컴을 실시간으로 만든 듯한 느낌이 들고 에일리언이 포위망을 좁혀 오거나 내 분대원들에게 다가오거나 할 때 이 쫄깃쫄깃함이 아주 좋더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.638,
                "end": 25.427
            },
            {
                "speaker_id": "1",
                "transcription": "분대원들을 데리고 에일리언이 가득한 건물을 조심조심 수색하면서 적들을 제거해 나가는 재미가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.437,
                "end": 31.616
            },
            {
                "speaker_id": "1",
                "transcription": "예 내 해병 캐릭터들을 성장시키는 재미도 있고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.626,
                "end": 34.108
            },
            {
                "speaker_id": "1",
                "transcription": "예 거의 전략의 끝판왕일 정도로 실시간으로 다가오는 에일리언의 위협을 분대를 잘 컨트롤해서 이겨내야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.108,
                "end": 40.690
            },
            {
                "speaker_id": "1",
                "transcription": "전략의 재미는 끝판왕이지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.700,
                "end": 42.800
            }
        ]
    },
    "summary": "20일 출시한 에일리언 다크 디센트가 자잘한 버그들이 많아서 평가가 확 깼지만 재미 하나만큼은 확실한 게임이다.",
