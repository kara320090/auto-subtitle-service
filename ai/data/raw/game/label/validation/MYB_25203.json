        "term": [
            {
                "speaker_id": "1",
                "transcription": "서로의 화면을 보면 안되는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.909
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 늘 그랬듯 깜짝 놀랄만한 사실들도 함께 밝혀지더라 특이한 점은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.919,
                "end": 6.883
            },
            {
                "speaker_id": "1",
                "transcription": "스마트폰으로도 플레이할 수가 있기 때문에 아 집에 뭐 컴퓨터가 하나밖에 없다 그러면 1명은 피시 1명은 스마트폰으로 플레이할 수가 있고 우리 집에는 컴퓨터가 아예 없다 이러면 뭐 둘 다 스마트폰을 가지고 플레이할 수 있을 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.893,
                "end": 19.543
            },
            {
                "speaker_id": "1",
                "transcription": "같이 하기 정말 좋은 게임으로 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.553,
                "end": 21.672
            },
            {
                "speaker_id": "1",
                "transcription": "더 패스트 위딘 같은 경우는 사실 여러분이 놓친 11월의 갓겜은 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.682,
                "end": 26.546
            },
            {
                "speaker_id": "1",
                "transcription": "같이 할 친구가 없으면은",
