        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 재밌네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.926
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도 수준이고 다양한 마법 콤보를 섞어서 사용하는 재미는 있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.936,
                "end": 5.481
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지만 전체적으로 전투든 퍼즐이든 오픈 월드 등 반복적이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.491,
                "end": 10.188
            },
            {
                "speaker_id": "1",
                "transcription": "네 오픈월드도 뭐 공허하고 가벼운 오픈 월드지만 빗자루를 타고 다니며 아름다운 경치를 구경하는 재미는 좋았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.198,
                "end": 17.820
            },
            {
                "speaker_id": "1",
                "transcription": "종합해 볼 때 약간씩 기대에 못 미치는 단점들이 있는 게임이지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.820,
                "end": 22.103
            },
            {
                "speaker_id": "1",
                "transcription": "크게 불평할 수준은 아니더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.110,
                "end": 23.760
            },
            {
                "speaker_id": "1",
                "transcription": "다음으로 호그와트 시리즈를 또 출시한다면은 더욱 기대가 되는 작품이 아닌가.",
                "sound_type": [
                    2,
