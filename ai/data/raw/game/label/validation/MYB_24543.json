                ],
                "start": 2.877,
                "end": 7.044
            },
            {
                "speaker_id": "1",
                "transcription": "적들도 무장을 했기 때문에 마냥 쉽지는 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.054,
                "end": 10.280
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 빠르고 효율적으로 적들을 처리해야 됩니다만 가장 큰 문제는요.",
                "sound_type": [
                    2,
                    3
                ],
