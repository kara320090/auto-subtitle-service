        "term": [
            {
                "speaker_id": "1",
                "transcription": "스테퍼 케이스가 무려 98퍼센트의 압도적으로 긍정적인 평가를 받고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.293
            },
            {
                "speaker_id": "1",
                "transcription": "5월의 갓겜이라고 말해놓고 바로 4월 30일 게임을 소개하니까 약오르는 분들이 계실 텐데 너무 열받지 마시고 월 말에 나오는 게임들은 이월 되기도 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.303,
                "end": 15.644
            },
            {
                "speaker_id": "1",
                "transcription": "데이터가 쌓일 때까지 시간이 조금 필요하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.654,
                "end": 18.522
            },
            {
                "speaker_id": "1",
                "transcription": "이 때문에 간혹 이월 되는 경우가 있으니까 이 점 양해를 해주시고 그래서 스테퍼 케이스 어떤 게임이냐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.532,
                "end": 25.013
            },
            {
                "speaker_id": "1",
                "transcription": "평가 수가 적긴 하지만 98퍼센트라는 압도적으로 긍정적인 수치는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.023,
                "end": 30.182
            },
            {
                "speaker_id": "1",
                "transcription": "스팀 게임 좀 많이 플레이해보신 분들은 쉽지 않은 거란 걸 아실 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.192,
                "end": 33.961
            },
            {
                "speaker_id": "1",
                "transcription": "제가 한번 소개도 했었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.971,
                "end": 35.466
            }
        ]
    },
    "summary": "그는 5월 게임 소개를 하겠다고 하고는 4월의 게임을 소개하는 것에 대해 양해를 구하고 있으며 스테퍼 케이스라는 98퍼센트의 긍정적인 평가를 받은 게임을 소개하고 있다.",
