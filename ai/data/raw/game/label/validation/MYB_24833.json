                ],
                "start": 0.000,
                "end": 1.166
            },
            {
                "speaker_id": "1",
                "transcription": "지금이 2023년이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.176,
                "end": 3.268
            },
            {
                "speaker_id": "1",
                "transcription": "무려 10년째 앞서 해보기를 하고 있는 게임이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.278,
                "end": 6.492
            },
            {
                "speaker_id": "1",
                "transcription": "아직도 정식 출시를 안 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.502,
                "end": 8.152
            },
            {
                "speaker_id": "1",
                "transcription": "근데 둘 다 좀비의 생존이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.162,
                "end": 9.946
            },
            {
                "speaker_id": "1",
                "transcription": "예 희한하게 뭔가 죽이 잘 맞는 두 게임입니다.",
                "sound_type": [
