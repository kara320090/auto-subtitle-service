        "term": [
            {
                "speaker_id": "1",
                "transcription": "머무르지 않을까 우리가 기대했던 갓겜은 아니었나 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.847
            },
            {
                "speaker_id": "1",
                "transcription": "2월 21일 오늘 출시한 아토믹 하트를 다른 리뷰어들은 어떻게 플레이를 해 봤는지 잠깐 만나봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.857,
                "end": 10.001
            },
            {
                "speaker_id": "1",
                "transcription": "저도 이건 플레이를 좀 해보고 나중에 다시 저만의 리뷰는 말씀을 드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.011,
                "end": 14.212
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 기대작들이 마구 쏟아지고 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.222,
                "end": 16.354
            },
            {
                "speaker_id": "1",
                "transcription": "다음 달까지도 그다음까지도 계속해서 초대형 기대작들이 쏟아질 예정인데 2023년은 정말 배부른 해입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.364,
                "end": 23.885
            },
            {
                "speaker_id": "1",
                "transcription": "괜찮은 게임들이 많이 나오고 있고 아토믹 하트도 약간 아쉬운 점은 있지만 충분히 매력적인 게임이란 생각이 듭니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.895,
                "end": 30.103
            },
            {
                "speaker_id": "1",
                "transcription": "제가 오늘 꿈을 꿨거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.113,
                "end": 32.233
            }
        ]
    },
