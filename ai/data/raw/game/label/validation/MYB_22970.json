        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 처음에는 전사 궁수 마법사.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.126
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 3명을 파티로 시작을 하는데 내 덱이 들어있는 카드들도요 전사만 쓸 수 있는 카드 궁수만 쓸 수 있는 카드 다 달아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.136,
                "end": 9.724
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 덱 구성도 예 파티에 맞게 신경을 써야 되고 턴제 전투에 들어가서도요 마법과 유틸을 사용하는 마법사 탱킹과 근접에 능한 전사.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.734,
                "end": 18.838
            },
            {
                "speaker_id": "1",
                "transcription": "원거리 딜러 궁수 등등 예.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.848,
                "end": 20.420
            },
            {
                "speaker_id": "1",
                "transcription": "3인 파티를 움직이나 예 턴제 전투 전략의 재미가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.416,
                "end": 23.917
            },
            {
                "speaker_id": "1",
                "transcription": "그 외에는 슬레이더 스파이더와 똑같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.927,
                "end": 26.004
            },
            {
                "speaker_id": "1",
                "transcription": "3인 턴제 전투라는 것만 다르고 그 외 나머지는 다 똑같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.014,
                "end": 29.553
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 제가 장점으로 보는 부분은 위치에 관련된 전략을 펼칠 수가 있더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.563,
                "end": 34.118
            },
            {
                "speaker_id": "1",
                "transcription": "조금 더 전략성이 높아졌죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.128,
                "end": 35.833
            },
            {
                "speaker_id": "1",
                "transcription": "적을 밀친다거나 당겨온다거나 마법사가 우리 팀을 텔레포트로 이동시킨다거나 등등.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.843,
                "end": 41.094
            },
            {
                "speaker_id": "1",
                "transcription": "이런 위치 관련 전략을 펼칠 수가 있어서 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.104,
                "end": 43.542
            },
            {
                "speaker_id": "1",
                "transcription": "캐주얼한 턴제 전투.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.552,
                "end": 45.099
            },
            {
                "speaker_id": "1",
                "transcription": "덱 빌딩 로그라이크 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.109,
                "end": 47.268
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임도 17일까지 할인 중이니까요 마음에 드시는 분들은 지금 구매해도 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.278,
                "end": 52.940
            },
            {
                "speaker_id": "1",
                "transcription": "한글화가 된 게임들은 우리에게 신작 게임과도 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.950,
                "end": 56.208
            },
            {
                "speaker_id": "1",
                "transcription": "유저 한글 패치가 나오거나 공식 한글화 된 게임들을 만나 봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.208,
                "end": 60.079
            },
            {
                "speaker_id": "1",
                "transcription": "이번 한글화는 재밌어 보이고 상당히 개성 있는 친구들이 많이 됐네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.089,
                "end": 64.681
            },
            {
                "speaker_id": "1",
                "transcription": "좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.691,
                "end": 65.394
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.404,
                "end": 69.182
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.192,
                "end": 98.233
            }
        ]
    },
    "summary": "이 게임은 적을 밀친다거나 당겨온다거나 마법사가 우리 팀을 텔레포트로 이동시키는 등 위치 관련 전략을 펼칠 수가 있어서 좋았다.",
