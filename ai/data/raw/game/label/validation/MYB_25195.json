        "term": [
            {
                "speaker_id": "1",
                "transcription": "공략을 너무나 보고 싶어하는 퍼즐이 간혹 끼어있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.788
            },
            {
                "speaker_id": "1",
                "transcription": "잔혹 동화 같은 기이한 이야기를 좋아하는 당신 여삐 사이코를 플레이해 보는 건 어떨까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.798,
                "end": 8.520
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 오늘의 스팀 할인 영상이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.530,
                "end": 11.392
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로는 위쳐 쓰리와 함께 체인드 에코즈 제이알피지의 팬이라면 지금 당장 구매하는 걸 추천을 드리는데 제가 아직 초반만 플레이해 본 거라 살짝 불안하긴 하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.402,
                "end": 20.894
            },
            {
                "speaker_id": "1",
                "transcription": "조금 더 제가 플레이를 해보고 진짜 재미있으면은 다시 한번 말씀을 드려보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.904,
                "end": 25.974
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재미있는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.984,
                "end": 29.603
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.613,
                "end": 30.600
            }
        ]
    },
