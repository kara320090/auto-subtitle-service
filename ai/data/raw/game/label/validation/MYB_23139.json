        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다방면에서 완벽에 가까운 게임이라면은 메탈 헬 싱어는 그런 게임은 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.711
            },
            {
                "speaker_id": "1",
                "transcription": "액션 그리고 메탈 끝 내 손에 샷건, 쌍권총, 허리춤에는 말하는 해골 주변을 둘러보면 지옥이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.721,
                "end": 12.309
            },
            {
                "speaker_id": "1",
                "transcription": "에 그리고 나와 함께 죽음을 노래하는 메탈 밴드 형님들까지 메탈 음악이 연주되구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.319,
                "end": 17.658
            },
            {
                "speaker_id": "1",
                "transcription": "악마들을 죽인다 그래서 끝이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.668,
                "end": 19.539
            },
            {
                "speaker_id": "1",
                "transcription": "액션 하나만큼은 가히 끝판왕인 게임 그래서 이 게임은 둠보다도 나를 더 미치게 만듭니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.549,
                "end": 24.565
            },
            {
                "speaker_id": "1",
                "transcription": "제가 리뷰를 이렇게 썼어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.575,
                "end": 25.863
            },
            {
                "speaker_id": "1",
                "transcription": "게임을 플레이하다가 점점 달아올라 가지고 모니터를 부숴 버릴 뻔했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.873,
                "end": 30.466
            }
        ]
    },
    "summary": "메탈 헬 싱어는 메탈 음악과 함께 악마들을 죽이는 것이 전부인 게임이라서 다방면에서 완벽한 게임은 아니지만 액션만큼은 가히 끝판왕이라 할 수 있겠다.",
