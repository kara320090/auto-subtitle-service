        "term": [
            {
                "speaker_id": "1",
                "transcription": "마음에 들면 구매해보는 건 어떨까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.156
            },
            {
                "speaker_id": "1",
                "transcription": "참고로 그린맨 게임에서 구매하시면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.166,
                "end": 4.306
            },
            {
                "speaker_id": "1",
                "transcription": "5천 원 더 저렴하게 구매할 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.316,
                "end": 6.822
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 구매해서 스팀에 등록하는 걸 추천을 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.832,
                "end": 9.774
            },
            {
                "speaker_id": "1",
                "transcription": "슈퍼 히어로 캐틱터들을 사용해서 덱 빌딩 턴제 전투를 플레이하는 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.784,
                "end": 14.681
            },
            {
                "speaker_id": "1",
                "transcription": "개인적으로는 파이락시스에 비운의 게임이라는 생각을 하는데 전투 시스템을 굉장히 잘 만들었지만 최적화 문제 때문인지 이상하게 외면을 받네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.691,
                "end": 23.597
