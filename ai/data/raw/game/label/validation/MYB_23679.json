        "term": [
            {
                "speaker_id": "1",
                "transcription": "그걸 지향하는 게임이 아닐까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.834
            },
            {
                "speaker_id": "1",
                "transcription": "깜찍한 협동 게임이 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.844,
                "end": 3.459
            },
            {
                "speaker_id": "1",
                "transcription": "5월 24일 출시하는 브레드와 프레드를 귀여운 펭귄 만 천여 마리가 찜 목록에 넣어두고 기다리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.469,
                "end": 10.907
            },
            {
                "speaker_id": "1",
                "transcription": "펭귄 두 마리가 서로의 몸에 밧줄을 묶고 힘을 합쳐서 올라가는 플랫포머 게임 인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.917,
                "end": 17.243
            },
            {
                "speaker_id": "1",
                "transcription": "느낌은 셀레스트와 굉장히 유사하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.253,
                "end": 19.932
            },
            {
                "speaker_id": "1",
                "transcription": "게임 디자인이라든가 플랫포머라든가 셀레스트와 굉장히 유사 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.942,
                "end": 24.025
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이 게임을 가져온 이유는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.035,
                "end": 26.224
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임 싱글로도 플레이할 수 있는데 싱글로 하면 펭귄이랑 같이 밧줄을 묶는 게 아니라 돌 하고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.234,
                "end": 33.366
            }
        ]
    },
