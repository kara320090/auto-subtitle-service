                ],
                "start": 4.106,
                "end": 7.194
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 오늘은 우리 듀리 채널의 시청자분들이 다들 뭐 친구가 많은 인싸들이기 때문에 다른 사람들과 사이 좋게 함께 즐길 수 있 멀티 협동 게임들을 소개해 보겠습니다.",
                "sound_type": [
