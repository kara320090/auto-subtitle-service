        "term": [
            {
                "speaker_id": "1",
                "transcription": "다음 주 무료 배포 게임이 꽤나 괜찮은 게 세인츠로우를 주네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.104
            },
            {
                "speaker_id": "1",
                "transcription": "다음 주에도 무료 배포 받으러 꼭 오시면 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.114,
                "end": 6.118
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 오늘의 첫 번째 스팀 할인 게임 만나보러 가시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.128,
                "end": 9.537
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째 게임은 서부 시대를 가로지르는 액션 로그라이크 게임 웨스트 오브 데드가 굉장히 좋은 가격에 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.547,
                "end": 16.440
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 제가 출시하자마자 플레이를 했었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.450,
                "end": 19.055
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 영어로 플레이를 했었는데 벌써 2년도 더 전에 출시한 게임이라니 믿기지가 않네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.065,
                "end": 24.172
            },
            {
                "speaker_id": "1",
                "transcription": "마치 고스트 라이더처럼 머리통에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.182,
                "end": 27.066
            }
        ]
    },
