        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기서만 한글로 즐길 수 있다거나 하는 게임들이 있으니까 좋은 기회네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.010
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 23퍼센트 추가 할인 쿠폰도 하나 주기 때문에 가격은 일단 꿀이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.020,
                "end": 8.789
            },
            {
                "speaker_id": "1",
                "transcription": "저는 여러분도 아시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.799,
                "end": 10.411
            },
            {
                "speaker_id": "1",
                "transcription": "예 누가 쿠폰을 주면은 어 이거를 싶어서 안달 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.421,
                "end": 14.086
            },
            {
                "speaker_id": "1",
                "transcription": "예 여러분도 하나씩 받으니까 23퍼센트 어디다 써야 될지 한번 추천을 해보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.096,
                "end": 19.461
            },
            {
                "speaker_id": "1",
                "transcription": "스토브 인디에서 구매하기 좋은 재미있고 가격이 해자인 게임들을 모아봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.471,
                "end": 23.963
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째 게임부터 만나보러 가시죠.",
                "sound_type": [
