        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "나는 선배 할란다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.301
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 디럭스 에디션을 사서 호구선배 하시며 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.311,
                "end": 4.157
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 다들 예구하지 마라 예구하면 통수 맞는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.167,
                "end": 7.183
            },
            {
                "speaker_id": "1",
                "transcription": "하시지만 저는 이제 어쩔 수가 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.193,
                "end": 9.981
            },
            {
                "speaker_id": "1",
                "transcription": "이미 뒤통수를 하도 처맞아가지고 저는 더 이상 아프지도 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.991,
                "end": 15.135
            },
            {
                "speaker_id": "1",
                "transcription": "뒤통수가 사람들 평가처럼 재미있었으면 좋겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.145,
                "end": 17.779
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 영상 원래 올릴 예정이 없었는데 호그와트 레거시 평가가 굉장히 좋고 많은 사람들 기대가 몰리기 시작해서 듀리 구독자분들도 구매하고 싶은 분들이 있을까 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.789,
                "end": 26.976
            },
            {
                "speaker_id": "1",
                "transcription": "단돈 만 원이라도 할인받으시라고 영상을 올립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.986,
                "end": 30.023
            },
            {
                "speaker_id": "1",
                "transcription": "그린맨 게이밍에서 구매해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.033,
                "end": 31.766
            }
        ]
    },
    "summary": "유튜버는 오늘 영상 원래 올릴 예정이 없었는데 호그와트 레거시 평가가 굉장히 좋고 많은 사람들 기대가 몰리기 시작해서 듀리 구독자분들도 만 원이라도 할인받으시라고 영상을 올린다고 말합니다.",
