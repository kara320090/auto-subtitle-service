                ],
                "start": 1.444,
                "end": 7.323
            },
            {
                "speaker_id": "1",
                "transcription": "나름 콘텐츠 중의 하나이기 때문에 나 같은 사람에게는 단점이지만 노가다 좋아하는 사람에게는 장점이다.",
                "sound_type": [
                    2,
