        "term": [
            {
                "speaker_id": "1",
                "transcription": "비밀을 밝혀내는 재미가 아주 맛깔난 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.719
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 왜 이게임이 재미있냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.719,
                "end": 4.400
            },
            {
                "speaker_id": "1",
                "transcription": "모든 상황을 내가 능동적으로 선택하고 추리해야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.410,
                "end": 8.010
            },
            {
                "speaker_id": "1",
                "transcription": "뭐부터 우리가 능동적으로 선택을 해볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.020,
                "end": 10.389
            },
            {
                "speaker_id": "1",
                "transcription": "단 한 명이라도 죄를 저지르면은 모두가 죽는다는 이 저주가 사실인지 아닌지 네 이거부터 우리가 시작을 해야겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.399,
                "end": 17.980
            },
            {
                "speaker_id": "1",
                "transcription": "직접 선택하고 결과를 맛보며 추리하는 재미가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.990,
                "end": 21.146
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이 모두가 죽는 저주를 소문을 그대로 믿고서는 죄를 안 짓고 조심조심 플레이하는 유저분들도 있겠지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.150,
                "end": 28.266
            }
        ]
    },
    "summary": "더 포가튼 시티 게임은 내가 모든 상황을 능동적으로 선택하고 추리해서 결과를 맛보는 재미가 있는 게임이다.",
