        "term": [
            {
                "speaker_id": "1",
                "transcription": "사실 유저들이 모여서 진행하는 번역이 언제 끝날지 모르잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.526
            },
            {
                "speaker_id": "1",
                "transcription": "예 근데 5월경까지만 진행을 한다고 해 놓은 걸 보면은 뭐 데드 라인 정도가 아닐까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.536,
                "end": 10.115
            },
            {
                "speaker_id": "1",
                "transcription": "5월 이후로는 뭐 안 하시거나 못 하시거나 뭐 요런 사연이 있을 수도 있겠다라는 생각을 해 봤네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.125,
                "end": 16.226
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 뭐 대단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.236,
                "end": 17.327
            },
            {
                "speaker_id": "1",
                "transcription": "아마 한글 번역하는 많은 분들이 스타필드에 매달리지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.337,
                "end": 20.824
            },
            {
                "speaker_id": "1",
                "transcription": "저도 그냥 1명의 게이머 입장으로서 다들 뭐 감사드리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.834,
                "end": 24.333
            }
        ]
    },
    "summary": "한글 번역 기간을 5월까지로 정해 놓은 것은 데드 라인 정도로 생각을 해 보면 될 것 같고 어쨌든 대단하고 게이머로서 감사를 드리고 싶다.",
