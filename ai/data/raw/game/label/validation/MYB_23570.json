        "term": [
            {
                "speaker_id": "1",
                "transcription": "담긴 내용은 그야말로 정통 사이버 펑크네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.351
            },
            {
                "speaker_id": "1",
                "transcription": "예 굉장히 재밌어 보이고 생각할 거리도 많이 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.361,
                "end": 5.324
            },
            {
                "speaker_id": "1",
                "transcription": "저처럼 이런 에스에프 뭐 사이버 펑크 이런 철학적인 내용들 예 요런 거에 대한 생각하는 걸 좋아하시는 분들은 한 번 해보시면 재미있게 하실 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.334,
                "end": 13.882
            },
            {
                "speaker_id": "1",
                "transcription": "유저한글패치는 인디게임 갤러리에서 익명으로 배포를 해주셨고 역시 대신 감사의 인사를 전하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.892,
                "end": 20.164
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임이 지금 스팀 할인 중이라서 구매도 좋지만 게임 패스에도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.174,
                "end": 24.699
            },
            {
                "speaker_id": "1",
                "transcription": "예 게임 패스용 패치 파일도 같이 배포를 해주셨으니까 원하는 곳에서 플레이 하시면 될 것 같네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.709,
                "end": 31.333
            }
        ]
    },
    "summary": "정통 사이버 펑크고 재밌어 보이고 생각할 거리도 많이 보이는데 저처럼 철학적인 내용들 좋아하시는 분들은 재미있게 하실 것 같아요.",
