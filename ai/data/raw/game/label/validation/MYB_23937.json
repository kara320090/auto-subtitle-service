                "start": 0.000,
                "end": 4.528
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 하나, 둘 익혀 나간다면은 너무 재밌는 협동 게임이 되지 않을까요?",
                "sound_type": [
                    2,
                    3
                ],
