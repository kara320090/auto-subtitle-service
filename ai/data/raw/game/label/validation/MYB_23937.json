                "end": 9.111
            },
            {
                "speaker_id": "1",
                "transcription": "리듬 게임 스핀 XD가 3월 15일 출시해 어마어마한 평가를 받고 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.121,
                "end": 15.207
            },
            {
                "speaker_id": "1",
                "transcription": "이게 리듬 게임이라 사실 뭐 할 말이 없죠.",
                "sound_type": [
