        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 당황해서 인사도 제대로 못 드렸던 게 마음에 지금 남아있어 가지고 그날 알아봐 주셔서 감사했다고 함께 재미있게 게임을 플레이 했었다고 다시 한번 고맙다는 인사를 드리는 겸",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.118
            },
            {
                "speaker_id": "1",
                "transcription": "여러분게 그저께 있었던 따끈따끈한 소식을 전해 드렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.128,
                "end": 14.563
            },
            {
                "speaker_id": "1",
                "transcription": "이건 사실 뭐 뉴스가 아니죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.573,
                "end": 16.030
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 펑범한 썰입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.040,
                "end": 17.663
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 우리 구독자분들 게임에서 가끔 만났으면 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.673,
                "end": 21.017
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 흥미로운 게임 소식을 알아보는 게임 라디오 시간이었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.027,
                "end": 25.377
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로도 재미있는 게임 찾아서 소개를 많이 해 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.387,
                "end": 28.679
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.689,
                "end": 32.045
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.055,
                "end": 33.200
            }
        ]
    },
