        "term": [
            {
                "speaker_id": "1",
                "transcription": "고아가 된 주인공 칸자키 시오리가 부모님의 방에서 한 장의 사진을 발견합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.572
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이 사진이나 어린 시절 자신과 부모님 그리고 할아버지로 보이는 인물이 함께 찍혀 있었고 아자카와 마을이라는 지명이 보이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.582,
                "end": 15.043
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아자카와 마을을 방문하게 되는 칸자키 시오리가 마을을 탐색하면서 시작되는 공포 게임이더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.053,
                "end": 21.857
            },
            {
                "speaker_id": "1",
                "transcription": "과연 이 아자카와 마을에서 밝혀낼 수 있는 비밀은 무엇인지 궁금하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.867,
                "end": 26.408
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 게임이 보니까 공포스러운 챕터 중간중간에",
                "sound_type": [
                    2,
                    3
