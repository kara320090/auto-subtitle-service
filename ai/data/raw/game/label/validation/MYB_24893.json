        "term": [
            {
                "speaker_id": "1",
                "transcription": "그냥 뜬금 없이 이재료 저재료 섞어서 램덤하게 짜짠 포션을 만드는 게 아 아니라 맵이 존재합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.660
            },
            {
                "speaker_id": "1",
                "transcription": "각 제료마다 이 맵에서 길을 만들어 나가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.670,
                "end": 9.103
            },
            {
                "speaker_id": "1",
                "transcription": "그런 재료들을 섞어 가면서 길을 만들어 나가면은 길 끝에 있는 포션을 만들어 낼 수 있는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.113,
                "end": 14.411
            },
            {
                "speaker_id": "1",
                "transcription": "이러다 보니까 그냥 무작정 재료를 섞는 게 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.421,
                "end": 17.505
            },
            {
                "speaker_id": "1",
                "transcription": "길을 만들어 나가면서 포션을 찾아야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.515,
                "end": 20.124
            },
            {
                "speaker_id": "1",
                "transcription": "이 과정이 꽤 재미있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.134,
                "end": 21.241
            },
            {
                "speaker_id": "1",
                "transcription": "단점은 몇시간 하면은 사실 이 게임의 콘텐츠는 바닥이 납니다.",
                "sound_type": [
                    2,
                    3
                ],
