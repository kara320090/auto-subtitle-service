        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 어둠 속에 무언가가 존재하는 느낌이 들거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.741
            },
            {
                "speaker_id": "1",
                "transcription": "바다가 수상하니까 다른 모든 것들도 수상하게 보이기 시작 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.751,
                "end": 8.374
            },
            {
                "speaker_id": "1",
                "transcription": "과연 이 마을은 어떤 마을인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.384,
                "end": 10.521
            },
            {
                "speaker_id": "1",
                "transcription": "이 사람은 내가 믿을 만한가 재미있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.531,
                "end": 13.041
            },
            {
                "speaker_id": "1",
                "transcription": "크툴루는 사실 게임의 분위기 조성만 합니다.",
                "sound_type": [
