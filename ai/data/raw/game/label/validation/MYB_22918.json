                ],
                "start": 0.000,
                "end": 0.820
            },
            {
                "speaker_id": "1",
                "transcription": "마피아류의 협동 대결 게이 소셜 멀티 디시드2 기대가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.830,
                "end": 5.458
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 출시가 코앞으로 다가온 협동 멀티 게임들을 만나봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.468,
                "end": 10.434
            },
            {
                "speaker_id": "1",
                "transcription": "같이 할 친구가 있는 분들은 뭐 친구들과 함께해도 좋고 어 렘넌트 같은 경우는 혼자 해도 재밌을 것 같거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.444,
                "end": 16.254
            },
            {
                "speaker_id": "1",
                "transcription": "이런 게임은 싱글 플레이어도 즐기기 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.264,
                "end": 18.795
            },
            {
                "speaker_id": "1",
                "transcription": "거기에 우연찮게 온라인에서 마음에 맞는 친구를 만날 수도 있겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.805,
                "end": 23.274
            },
            {
                "speaker_id": "1",
                "transcription": "저는 다음에 더 재밌는 게임 더 흥미로운 소식으로 찾아오도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.284,
                "end": 26.953
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 또 봐요.",
