                    3
                ],
                "start": 0.000,
                "end": 6.139
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 스타워즈 아웃로즈 먼저 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.149,
                "end": 8.156
            },
            {
                "speaker_id": "1",
                "transcription": "주인공 기가 막히게 멋있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.166,
                "end": 10.212
            },
            {
                "speaker_id": "1",
                "transcription": "누나인지 아주머니인지는 잘 모르겠는데 뭔 상관입니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.222,
                "end": 14.182
            },
            {
                "speaker_id": "1",
                "transcription": "너무 멋있는데 예 뭐 심지어 악당이라고 하니까 레데리 느낌도 나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.192,
                "end": 17.958
            },
            {
                "speaker_id": "1",
                "transcription": "예 약간 무법자의 개념이 아닐까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.968,
                "end": 19.899
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 제가 이 게임을 보면서 느낀 점은 스타워즈도 진짜 사기구나.",
                "sound_type": [
