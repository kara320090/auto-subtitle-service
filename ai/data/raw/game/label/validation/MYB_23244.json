        "term": [
            {
                "speaker_id": "1",
                "transcription": "드래곤볼 작가 토리야마 아키라 선생님이 그린 샌드랜드가 게임으로 등장합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.553
            },
            {
                "speaker_id": "1",
                "transcription": "저는 처음보는 만화인데 드래곤볼 그림체는 언제 봐도 정겹죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.563,
                "end": 8.359
            },
            {
                "speaker_id": "1",
                "transcription": "마치 매드맥스를 드래곤볼 그림체로 그린 것만 같은 물이 부족한 세계관에서 사막에서 자동차 타고 탱크를 타고 다니네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.369,
                "end": 16.627
            },
            {
                "speaker_id": "1",
                "transcription": "듣기로는 이 토리야마 아키라 선생님이 탱크를 그리고 싶어서 만든 만화가 샌드랜드라는데 뭐 썩 재미는 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.637,
                "end": 23.324
            },
            {
                "speaker_id": "1",
                "transcription": "는 평가가 많은 만화더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.334,
                "end": 25.680
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 매드맥스를 드레곤볼 그림체로 만든 것만 같은 게임 기대가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.690,
                "end": 36.366
            }
        ]
    },
    "summary": "그는 토리야마 아키라라는 작가가 탱크를 그리고 싶어서 그린 샌드랜드라는 만화가 게임으로 개발됐다고 말하며 물이 부족한 세계관으로 썩 재미는 없으며 매드맥스를 드래곤볼 그림체로 만든 것 같는 감상평을 말한다.",
