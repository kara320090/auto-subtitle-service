        "term": [
            {
                "speaker_id": "1",
                "transcription": "내가 키우는 용사를 무한 챗바퀴 돌리는 게임 루프 히어로를 5월 9일 67퍼센트 할인해서 판매 중이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.333
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 세상을 구하는 용사를 내 손으로 키우는 게임이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.343,
                "end": 11.901
            },
            {
                "speaker_id": "1",
                "transcription": "특이한 점은 플레이어가 직접 영웅에게 시련을 준다는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.911,
                "end": 16.523
            },
            {
                "speaker_id": "1",
                "transcription": "노 페인 노 게인이죠 고통 없이는 성장도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.533,
                "end": 20.064
            },
            {
                "speaker_id": "1",
                "transcription": "용사는 계속해서 루프를 돌고 우리는 용사가 적절하게 성장할 수 있게 시련을 계속해서 주는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.074,
                "end": 25.872
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들면은 용사가 도는 루프 주변에",
                "sound_type": [
