        "term": [
            {
                "speaker_id": "1",
                "transcription": "반대면 기세가 떨어집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.615
            },
            {
                "speaker_id": "1",
                "transcription": "쉽게 생각해서 이 기세는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.625,
                "end": 3.438
            },
            {
                "speaker_id": "1",
                "transcription": "스태미나라고 여러분이 생각을 하셔도 무방합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.448,
                "end": 6.190
            },
            {
                "speaker_id": "1",
                "transcription": "내가 적에게 공격을 명중하거나 잘 회피하면 스태미나가 오르고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.200,
                "end": 10.512
            },
            {
                "speaker_id": "1",
                "transcription": "반대로 적의 공격을 피하지 못한 채 가드만 하거나 뚜드려 맞거나 하면은 스태미나가 떨어진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.522,
                "end": 16.260
            },
            {
                "speaker_id": "1",
                "transcription": "네 이것을 기세라고 표현을 했다고 생각하면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.250,
                "end": 19.560
            },
            {
                "speaker_id": "1",
                "transcription": "이러한 기세 시스템을 포함해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.560,
                "end": 21.300
            }
        ]
    },
    "summary": "와룡은 다른 게임과 달리 스태미나가 아니라 기세가 중심이긴 하지만 같은 결로 봐도 무방한 것이 적에게 공격을 잘하면 스태미나가 오르고 적의 공격을 잘 피하지 못하고 그러면 스태미나가 떨어진다.",
