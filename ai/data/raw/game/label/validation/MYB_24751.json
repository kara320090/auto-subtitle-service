        "term": [
            {
                "speaker_id": "1",
                "transcription": "라고 얘기를 하면서 스타트를 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.313
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 암살자 친구가 얘기하는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.323,
                "end": 3.771
            },
            {
                "speaker_id": "1",
                "transcription": "너 그만두면 주면 죽어 그렇게 이 암살했던 친구와 하루를 보내는 내용의 게임이 바로 이 아디오스다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.781,
                "end": 9.764
            },
            {
                "speaker_id": "1",
                "transcription": "아오스가 이제 굿바이라는 뜻이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.774,
                "end": 11.755
            },
            {
                "speaker_id": "1",
                "transcription": "에 게임 제목부터 섬짓합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.755,
                "end": 13.993
            },
            {
                "speaker_id": "1",
                "transcription": "어쨌든 우리가 하루 동안 내리는 선택에 따라서 결과가 바뀐다고 하니까 살아남는 내용 뭐 죽는 내용 요런 게 있지 않을요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.003,
                "end": 20.820
            },
            {
                "speaker_id": "1",
                "transcription": "참신하고 좋은 게임으로 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
