        "term": [
            {
                "speaker_id": "1",
                "transcription": "당연히 도적떼들도 이제 국룰이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.267
            },
            {
                "speaker_id": "1",
                "transcription": "산속에서 도적떼들 만나고 에 보스전이 정말 재밌는 게임 몬스터 이 등에 올라타서 공격을 하기도 하고 부위 파괴를 하기도 하고 에 재밌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.277,
                "end": 9.902
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에는 액션이 재밌는 스카이림으로 유명했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.912,
                "end": 13.274
            },
            {
                "speaker_id": "1",
                "transcription": "스카이림과의 차이점은 액션은 더 재밌지만 오픈 월드는 훨씬 구리다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.284,
                "end": 17.844
            },
            {
                "speaker_id": "1",
                "transcription": "에 맵은 넓고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.854,
                "end": 19.166
            }
        ]
    },
    "summary": "이 게임은 도적떼들이 등장하고 몬스터 등에 올라타서 공격을 하고 부위를 파괴하기도 하는 등 보스전이 정말 재미있으며 스카이림과 비교하면 액션은 더 재밌지만 오픈 월드는 훨씬 별로이다.",
