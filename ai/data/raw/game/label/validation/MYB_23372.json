        "term": [
            {
                "speaker_id": "1",
                "transcription": "스파이더맨 2가 2023년 가을 출시 예정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.006
            },
            {
                "speaker_id": "1",
                "transcription": "마일즈 모랄레스와 함께 플레이할 수 있는 걸로 보이고 뭐 특별할 건 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.016,
                "end": 7.535
            },
            {
                "speaker_id": "1",
                "transcription": "기존 스파이더맨 시리즈에서 조금 더 추가하고 개선된 작품으로 보이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.545,
                "end": 11.558
            },
            {
                "speaker_id": "1",
                "transcription": "기존께 너무나도 재밌고 완성 되어 있는 게임 시리즈였기 때문에 이번 스파이더맨 2 안 봐도 뻔하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.568,
                "end": 18.488
            },
            {
                "speaker_id": "1",
                "transcription": "에 너무 재밌을 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.498,
                "end": 19.884
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 스파이더맨이 베놈이 되어버렸죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.894,
                "end": 22.240
            },
            {
                "speaker_id": "1",
                "transcription": "그 제가 베놈은 잘 모르거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.230,
                "end": 24.044
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 이거 영화를 봐야 되나 고민이 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.050,
                "end": 26.387
            },
            {
                "speaker_id": "1",
                "transcription": "스파이더맨이 어떻게 뭐 감염돼 가지고 나쁜 마음이 들고 에 요런 컨셉으로 하는데 기대가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.397,
                "end": 31.712
            },
            {
                "speaker_id": "1",
                "transcription": "감상 포인트 시민을 내팽겨쳐 버리는 친절한 이웃 스파이더맨",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.722,
                "end": 41.433
            }
        ]
    },
    "summary": "한 남성이 플레이스테이션 게임 관련 이야기를 하고 있다.",
