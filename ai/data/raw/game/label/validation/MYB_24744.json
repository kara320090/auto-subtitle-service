        "term": [
            {
                "speaker_id": "1",
                "transcription": "단점은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.701
            },
            {
                "speaker_id": "1",
                "transcription": "액션에서 얻는 즐거움은 약한 편입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.711,
                "end": 2.892
            },
            {
                "speaker_id": "1",
                "transcription": "아포칼립스와 스토리를 좋아하는 분들이라면 좋을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.902,
                "end": 6.664
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 사실 추천을 드리는 건 아니고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.674,
                "end": 9.522
            },
            {
                "speaker_id": "1",
                "transcription": "정보 전달차원에서 가져온 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.532,
                "end": 11.835
            },
            {
                "speaker_id": "1",
                "transcription": "1월 27일 오늘 유비소프트의 와치 독스 리진이 스팀으로 출시했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.845,
                "end": 17.177
            },
            {
                "speaker_id": "1",
                "transcription": "며칠 전에는 고스트리콘 브레이크포인트가 스팀으로 출시 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.177,
                "end": 21.387
            },
            {
                "speaker_id": "1",
                "transcription": "이로써 다 나온 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.397,
                "end": 22.931
            },
            {
                "speaker_id": "1",
                "transcription": "스팀에는 공개하지 않았던 유비소프트의 게임들이 다 스팀으로 출시한 걸로 아는데",
                "sound_type": [
                    2,
                    3
                ],
