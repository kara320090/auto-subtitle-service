                ],
                "start": 2.980,
                "end": 13.541
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 단순히 생존만 하는 게 아니라 뚜렷한 목표가 있기 때문에 좋아요.",
                "sound_type": [
