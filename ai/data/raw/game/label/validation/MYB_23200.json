        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 지역 점령하고 요거 이제 파크라이처럼 하는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.607
            },
            {
                "speaker_id": "1",
                "transcription": "예 원래 파크라이가 게릴라 바탕으로 진행되는 게임이기 때문에 아바타 세계관과 너무 잘 어울린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.617,
                "end": 8.624
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 1가지 좋은 점은 친구와 함께 2인 협동으로도요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.634,
                "end": 11.736
            },
            {
                "speaker_id": "1",
                "transcription": "이 스토리 캠페인을 클리어할 수 있다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.746,
                "end": 14.368
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이거는 참 좋죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.378,
                "end": 15.320
            },
            {
                "speaker_id": "1",
                "transcription": "예 친구와 해도 좋을 것 같고",
                "sound_type": [
                    2,
                    3
