        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘 영상이 스팀 할인이긴 하지만 두 개중에 하나 고르라면은 저는 스마트폰에서 구매하는 걸 추천드리기도 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.595
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 이거 짬나는 시간에 스마트폰으로 카드게임 뚝딱 거리기 얼마나 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.605,
                "end": 11.611
            },
            {
                "speaker_id": "1",
                "transcription": "내가 원하는 대로 카드덱을 구성하고 짧은 회차를 도는 게임이기 때문에 스마트폰으로 하기 좋은 최고다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.621,
                "end": 17.521
            },
            {
                "speaker_id": "1",
                "transcription": "카드게임 하고 싶다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.531,
                "end": 18.762
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 슬레이더 스파이어 이거 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.772,
                "end": 21.138
            },
            {
                "speaker_id": "1",
                "transcription": "PC로 하고 싶으신 분들도 스팀으로 그냥 구매하셔도 절대 후회 안 하는 갓겜이긴 합니다. 근데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.148,
                "end": 27.000
            }
        ]
    },
    "summary": "슬레이더 스파이어는 짬나는 시간에 스마트폰으로 카드 게임 뚝딱 거리기 좋고 짧은 회차를 도는 게임이기 때문에 스마트폰으로 하기 좋다.",
