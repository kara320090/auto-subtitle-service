        "term": [
            {
                "speaker_id": "1",
                "transcription": "줘터지고 이제 나가서 스팀 평가에 욕 써놓고 이제 게임 삭제하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.915
            },
            {
                "speaker_id": "1",
                "transcription": "에 근데 여기는 격겜 응애들이 극찬을 하고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.925,
                "end": 9.195
            },
            {
                "speaker_id": "1",
                "transcription": "상당히 뉴비 친화적인 격투 게임이라는 극찬을 내리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.205,
                "end": 12.985
            },
            {
                "speaker_id": "1",
                "transcription": "이게 진정한 세대 통합이 아닐까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.995,
                "end": 15.226
            },
            {
                "speaker_id": "1",
                "transcription": "여기서도 또 나오는 듀리의 캡콤 찬양 시작되죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.236,
                "end": 18.521
            },
            {
                "speaker_id": "1",
                "transcription": "어 요즘 캡콤은 뭐 장르 안 가리죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.531,
                "end": 20.907
            },
            {
                "speaker_id": "1",
                "transcription": "에 격투건 뭐 액션이건 어드벤처건 내는 족족 대성공입니다.",
                "sound_type": [
