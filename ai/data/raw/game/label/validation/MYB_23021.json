        "term": [
            {
                "speaker_id": "1",
                "transcription": "스팀 여름 세일이 시작했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.850
            },
            {
                "speaker_id": "1",
                "transcription": "7월 13일까지 진행을 하고 다시 돌아온 장르별 원탑 게임 추천.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.860,
                "end": 6.569
            },
            {
                "speaker_id": "1",
                "transcription": "비슷한 장르의 게임을 플레이하고 싶다면 그냥 지금 영상에서 추천하는 게임을 플레이하셔도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.579,
                "end": 12.630
            },
            {
                "speaker_id": "1",
                "transcription": "다만 정석 중에 정석 픽이라는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.640,
                "end": 15.068
            },
            {
                "speaker_id": "1",
                "transcription": "게임 많이 하신 분들은 다 알만한 게임이지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.068,
                "end": 18.024
            },
            {
                "speaker_id": "1",
                "transcription": "반대로 여기서 안 해본 게임이 있다면 도전해 볼만한다는 얘기도 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.034,
                "end": 21.877
            },
            {
                "speaker_id": "1",
                "transcription": "각 장르별 원탑 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.887,
                "end": 23.066
            },
            {
                "speaker_id": "1",
                "transcription": "1번째 게임부터 만나보러 가시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.076,
                "end": 25.266
