        "term": [
            {
                "speaker_id": "1",
                "transcription": "받으실 분들은 빨리 가서 받으셔야 할 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.242
            },
            {
                "speaker_id": "1",
                "transcription": "에일리언의 습격을 막는 게임으로 보이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.252,
                "end": 4.927
            },
            {
                "speaker_id": "1",
                "transcription": "클래식한 탑뷰 슈팅 게임을 좋아하는 분들이 받아서 플레이 하시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.937,
                "end": 10.067
            },
            {
                "speaker_id": "1",
                "transcription": "참고로 GOG에 보면은 한국어 텍스트를 지원한다고 되어있지만 막상 게임에 들어가면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.077,
                "end": 15.761
            },
            {
                "speaker_id": "1",
                "transcription": "한국어가 없다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.771,
                "end": 17.312
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째 무료 배포 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.322,
                "end": 19.337
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 스토어에서 2월 24일 01시까지 워핍스를 무료 배포 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.347,
                "end": 23.800
            },
            {
                "speaker_id": "1",
                "transcription": "아기자기한 도트 그래픽이 돋보이는 게임인데요.",
