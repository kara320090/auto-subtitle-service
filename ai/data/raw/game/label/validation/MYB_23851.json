        "term": [
            {
                "speaker_id": "1",
                "transcription": "나머지 엄연히 스토리가 존재하고 사이버펑크 세계관이 존재하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.258
            },
            {
                "speaker_id": "1",
                "transcription": "처음 보는 사람의 마음을 휘어잡는 화려한 비주얼도 존재하지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.268,
                "end": 8.921
            },
            {
                "speaker_id": "1",
                "transcription": "이 모든 것들이 다 사이버펑크 허상이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.931,
                "end": 11.718
            },
            {
                "speaker_id": "1",
                "transcription": "네 마치 사이버 세계 속의 홀로그램처럼 다 허상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.728,
                "end": 15.927
            },
            {
                "speaker_id": "1",
                "transcription": "스토리도 구리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.937,
                "end": 16.962
            },
            {
                "speaker_id": "1",
                "transcription": "세계관 뭐 별거 없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.972,
                "end": 18.219
            },
            {
                "speaker_id": "1",
                "transcription": "비주얼 뭐 나중가면 눈만 아프고요.",
                "sound_type": [
                    2,
                    3
                ],
