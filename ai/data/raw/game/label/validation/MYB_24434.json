        "term": [
            {
                "speaker_id": "1",
                "transcription": "무려 3만 7000개가 쌓여 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.642
            },
            {
                "speaker_id": "1",
                "transcription": "대체 어떻게 이 게임은 인기가 있고 많은 사람들이 기다리고 있을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.652,
                "end": 5.532
            },
            {
                "speaker_id": "1",
                "transcription": "제가 곰곰이 생각을 해 봤는데 우리가 더 포레스트 1편때 맛을 봤잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.542,
                "end": 10.763
            },
            {
                "speaker_id": "1",
                "transcription": "네. 에헤헤 다 같이 맛 봤거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.773,
                "end": 13.983
            },
            {
                "speaker_id": "1",
                "transcription": "근데 괜찮았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.993,
                "end": 15.862
            },
            {
                "speaker_id": "1",
                "transcription": "먹을 만하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.872,
                "end": 17.094
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 우리가 깨달은 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.104,
                "end": 18.210
            },
            {
                "speaker_id": "1",
                "transcription": "문제는 우리는 맛을 알았지만 파는 데가 없습니다.",
