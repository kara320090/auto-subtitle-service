                    2,
                    3
                ],
                "start": 3.841,
                "end": 4.690
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 페이블 캐릭터 사태에서 자연스럽게 다음 이야기로 넘어가 볼게요.",
                "sound_type": [
