        "term": [
            {
                "speaker_id": "1",
                "transcription": "소울 라이크 게이머라면은 당장 구매를 해야 되는 가격이고 단점은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.235
            },
            {
                "speaker_id": "1",
                "transcription": "길 찾기와 퍼즐인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.245,
                "end": 5.584
            },
            {
                "speaker_id": "1",
                "transcription": "길 찾기는 사실 이제 홀로그램 미니맵 때문에 안 좋은 거고 퍼즐은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.594,
                "end": 10.613
            },
            {
                "speaker_id": "1",
                "transcription": "후속작에서는 당장 퍼즐을 없애시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.623,
                "end": 14.253
            },
            {
                "speaker_id": "1",
                "transcription": "제대로 된 퍼즐 만드는 거 아니면은 없애는 게 이득일 정도로 제다이 오더의 몰락의 퍼즐은 너무나 구렸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.263,
                "end": 20.366
            }
        ]
    },
    "summary": "제다이 오더의 몰락의 단점은 길 찾기와 퍼즐이다.",
