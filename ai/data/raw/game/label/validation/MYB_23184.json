        "term": [
            {
                "speaker_id": "1",
                "transcription": "애매하게 발을 걸쳐 가지고 끝까지 우리 한국 시장을 뽑아 먹으려고 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.132
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 뭐 해 줄 거면 빨리 해 주던가 지금 우린 어차피 출시하자마자 한글로 못 즐기거든요 이렇게 되면은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.142,
                "end": 9.074
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 실망이 이만저만이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.084,
                "end": 10.719
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 어쨌든 많이 열받았지만 분을 삭히던 중에 제가 재밌는 걸 봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.729,
                "end": 15.289
            },
            {
                "speaker_id": "1",
                "transcription": "스타필드 한글 번역팀을 모집하더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.299,
                "end": 17.786
            },
            {
                "speaker_id": "1",
                "transcription": "예 벌써 모집 중입니다.",
