        "term": [
            {
                "speaker_id": "1",
                "transcription": "처음 보는 사람 9명이 정신병원에 갇혔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.985
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 우리 9명 중 2명은요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.995,
                "end": 5.156
            },
            {
                "speaker_id": "1",
                "transcription": "평범한 사람이 아닌가 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.166,
                "end": 6.788
            },
            {
                "speaker_id": "1",
                "transcription": "마피아류의 멀티 게임 디시트2가 8월 31일 출시 예정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.798,
                "end": 10.917
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이번 게임은 제가 엄청 기대하는 건 아닌데 그래도 재밌을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.927,
                "end": 14.894
            },
            {
                "speaker_id": "1",
                "transcription": "킬링타임용으로 플레이하기 좋아 보이더라 그래서 한때 이제 어몽어스 같은 마피아류의 게임이 대 히트였죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.904,
                "end": 21.375
            },
            {
                "speaker_id": "1",
                "transcription": "디시트도 2017년 무료 플레이로 많은 인기를 끌었던 마피아류의 게임이었는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.385,
                "end": 26.997
            },
            {
                "speaker_id": "1",
                "transcription": "플레이어들 사이에 혈액 팩을 몰래 마시는 이제 시민들 사이에 숨은 감염자를 찾아내야 하는 게임 이번 디시트2에서도",
                "sound_type": [
                    2,
                    3
                ],
