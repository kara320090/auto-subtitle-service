        "term": [
            {
                "speaker_id": "1",
                "transcription": "와룡은 다릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.973
            },
            {
                "speaker_id": "1",
                "transcription": "스태미나가 아닌 기세를 중심으로 플레이합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.983,
                "end": 3.635
            },
            {
                "speaker_id": "1",
                "transcription": "아마 삼국지에서 부대의 사기 같은 게 중요하잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.645,
                "end": 7.790
            },
            {
                "speaker_id": "1",
                "transcription": "아무리 숫자가 많은 군대에도 사기가 떨어지면은 수가 적은 군대에게도 패배하고 이런 내용이 소설에 나오는데 여기서 따온 것인지 기세라는 시스템을 집어넣었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.800,
                "end": 18.210
            },
            {
                "speaker_id": "1",
                "transcription": "내가 적에게 공격을 명중하거나 잘 회피하거나 하면은 기세가 오르고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.210,
                "end": 22.766
            }
        ]
    },
    "summary": "와룡은 스태미나가 중심이 아니고 기세를 중심으로 플레이하는데 삼국지 같은 경우는 부대의 기세가 전쟁에서 영향을 크게 미치기 때문에 기세라는 시스템을 집어넣었다.",
