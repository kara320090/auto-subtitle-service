        "term": [
            {
                "speaker_id": "1",
                "transcription": "공포명가 암네시아 시리즈의 신작.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.175
            },
            {
                "speaker_id": "1",
                "transcription": "1차 세계대전 참호와 벙커를 배경으로 생존하고 탈출하는 호러 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.185,
                "end": 7.134
            },
            {
                "speaker_id": "1",
                "transcription": "6일 출시한 암네시아 더 벙커가 공포 명작 시리즈의 자존심을 지켜냈습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.144,
                "end": 12.405
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 유저 한글 패치가 나왔을 때 제가 소개를 했었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.415,
                "end": 15.763
            },
            {
                "speaker_id": "1",
                "transcription": "예 저도 부랴부랴 한글 패치 받고서 플레이를 해보니까 아 역시나 나는 3D 멀미때문에 플레이가 불가능하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.773,
                "end": 22.441
            },
            {
                "speaker_id": "1",
                "transcription": "예 그때도 말씀 드렸어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.451,
                "end": 24.229
            },
            {
                "speaker_id": "1",
                "transcription": "쫄아서 못하는 게 아니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.239,
                "end": 25.475
            },
            {
                "speaker_id": "1",
                "transcription": "예 3D 멀미 때문이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.485,
                "end": 27.033
            },
            {
                "speaker_id": "1",
                "transcription": "오해 없으시길 바라고 앞부분 잠깐 플레이 해보는 체감으로는 상호작용이 미친 게임입니다 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.043,
                "end": 32.628
            },
            {
                "speaker_id": "1",
                "transcription": "대부분의 물건을 들어 올릴 수가 있고요.",
