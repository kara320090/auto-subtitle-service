        "term": [
            {
                "speaker_id": "1",
                "transcription": "해리포터 세계관 자체가 말도 안 되는 세계관이구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.879
            },
            {
                "speaker_id": "1",
                "transcription": "괜히 우리가 그 옛날 해리포터 소설 읽으면서 두근두근 하고 영화 보면서 두근두근 했던 게 아니었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.889,
                "end": 9.800
            },
            {
                "speaker_id": "1",
                "transcription": "진짜로 그냥 호그와트 학교를 돌아도니기만 해도 재밌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.810,
                "end": 13.030
            },
            {
                "speaker_id": "1",
                "transcription": "네 물론 그거를 개발진들이 잘 구현하기도 했지만요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.020,
                "end": 16.148
            },
            {
                "speaker_id": "1",
                "transcription": "그 외에도 뭐 전투가 재밌다는 평가도 많았지만 직접 플레이해 본 체감으로는 사실 기대한 거에 비해서는 네",
                "sound_type": [
                    2,
