        "term": [
            {
                "speaker_id": "1",
                "transcription": "닐 북아드 군이 동쪽 폰타르 강을 건넜어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.018
            },
            {
                "speaker_id": "2",
                "transcription": "곧 전쟁터가 된다는 뜻이겠지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.028,
                "end": 5.637
            },
            {
                "speaker_id": "3",
                "transcription": "전쟁은 모든 것을 바꾸지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.637,
                "end": 8.197
            },
            {
                "speaker_id": "4",
                "transcription": "조견님의 명령으로 누구든지 마법사를 집에 숨겨두면 그 마법사와 함께 화형에 처할 것이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.207,
                "end": 16.020
            },
            {
                "speaker_id": "5",
                "transcription": "화영이나 당해라 악마새끼.",
