                ],
                "start": 4.246,
                "end": 8.836
            },
            {
                "speaker_id": "1",
                "transcription": "예 절름발이가 범인인 거를 내가 까먹지 않고 게임을 플레이하면서 확인할 수도 있죠.",
                "sound_type": [
