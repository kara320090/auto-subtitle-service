        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 게임은 얼마 전에 유저 한글 패치가 나온 도트 어드벤처 게임이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.981
            },
            {
                "speaker_id": "1",
                "transcription": "어느 겨울밤 4명의 나그네가입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.991,
                "end": 7.067
            },
            {
                "speaker_id": "1",
                "transcription": "이 친구도 압도적으로 긍정적인 무료 게임인데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.077,
                "end": 10.783
            },
            {
                "speaker_id": "1",
                "transcription": "유저 한글 패치가 나왔을 때 제가 말씀드렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.793,
                "end": 13.462
            },
            {
                "speaker_id": "1",
                "transcription": "분위기 끝내주고 음악 좋고 도트 화려하고 연출 끝판왕이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.472,
                "end": 17.964
            },
            {
                "speaker_id": "1",
                "transcription": "이거 한 번쯤 해볼만 하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.974,
                "end": 19.791
            },
            {
                "speaker_id": "1",
                "transcription": "나도 너무 재밌게 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.801,
                "end": 21.160
            },
            {
                "speaker_id": "1",
                "transcription": "소개를 했었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.170,
                "end": 22.091
            },
            {
                "speaker_id": "1",
                "transcription": "겨울밤 달리는 기차 안에서 4명의 나그네가 우연히 만나",
