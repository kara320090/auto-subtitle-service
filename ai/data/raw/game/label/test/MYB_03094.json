        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 대 혼돈의 파티 어 일단 뭐 이렇게 되어있네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.032
            },
            {
                "speaker_id": "1",
                "transcription": "일단 뭐 서로 딜교를 막 하고 나서 이기긴 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.387,
                "end": 17.792
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱의 뭐 이것도 일종인 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.085,
                "end": 21.052
            },
            {
                "speaker_id": "1",
                "transcription": "이거 같은 경우엔 다크 카카오 대신에 오먹이 들어갔죠?",
                "sound_type": [
                    2,
