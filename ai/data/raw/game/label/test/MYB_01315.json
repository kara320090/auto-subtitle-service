        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 맹고 딜 보자 평타 딜 18만 네 마법 형이라 자 맹고야 스킬쓰면 야 세긴세다. 얘는 스토리에서 써도 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 19.616
            },
            {
                "speaker_id": "1",
                "transcription": "대망의 아레나 아레나는 제가 구상해 놓은 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.626,
                "end": 24.787
            },
            {
                "speaker_id": "1",
                "transcription": "영상 찍기 전에 어떻게 써 볼까 제가 생각을 해 봤는데 제 구상은 샤글이랑 똑같이 적용해서 써볼까 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.797,
                "end": 33.941
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 식으로 써볼거냐면은 1분 전까지 버티기 모드로 갈 거거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.951,
                "end": 37.458
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 호루라기를 받고 망고가 쉽게 죽지는 않을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.468,
                "end": 41.407
            },
            {
                "speaker_id": "1",
                "transcription": "피감 42퍼센트 네 호루라기 있는 피감 여러분들 20퍼센트를 받아서 웬만해서는 절대 죽지 않을 피감이 될 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.417,
                "end": 50.859
            },
            {
                "speaker_id": "1",
                "transcription": "체력은 좀 많이 낮지만 자 전략은 이렇습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.869,
                "end": 54.374
            },
            {
                "speaker_id": "1",
                "transcription": "공격력 증가 버프 거기다가 피해 증가 핵 디 버프까지 묻혀서 용과 드래곤의 1분 때 한방에 브레스로 적을 순삭 시켜 버려라 자 이론은 완벽하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.384,
                "end": 68.966
            }
        ]
    },
    "summary": "아레나의 구상은 샤글이랑 똑같이 1분 버티기 전략으로 호루라기 받고 망고가 쉽게 죽지 않는다.",
