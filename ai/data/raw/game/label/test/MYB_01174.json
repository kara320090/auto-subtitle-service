        "term": [
            {
                "speaker_id": "1",
                "transcription": "모바일 게임을 플레이한 만큼 혜택을 받을 수 있는 플레이오 앱을 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.993
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 쌓이는 젬을 코인으로 교환해 상점에서 기프트카드 문화상품권 등 다양한 상품으로 구매 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.003,
                "end": 10.161
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 시청하고 가입한 신규 유저분들한테는 시크릿 코드 플오ND러너를 입력하면 만젬을 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.171,
                "end": 16.591
            },
            {
                "speaker_id": "1",
                "transcription": "추가로 플레이오의 자체적인 퀘스트들이 있어서 게임을 진행하면서도 다양한 젬을 추가로 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.601,
                "end": 22.725
            },
            {
                "speaker_id": "1",
                "transcription": "게임하고도 기프트카드 문화상품권 무료로 얻고 너무나 좋은 기회 아닌 가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.735,
                "end": 27.414
            },
            {
                "speaker_id": "1",
                "transcription": "다운로드 링크는 고정 댓글을 참고하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.424,
                "end": 29.427
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 요거는 아 이거 강화까지 합시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.437,
                "end": 33.348
            },
            {
                "speaker_id": "1",
                "transcription": "다 저 이거 다 라즈로 받을 거거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.358,
                "end": 37.933
            }
        ]
    },
    "summary": "화자가 플레이오 앱 광고 후 강화까지 하겠다며 다 라즈로 받겠다고 말하고 있다.",
