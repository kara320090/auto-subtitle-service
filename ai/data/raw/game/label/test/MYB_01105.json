    },
    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "모바일 게임을 플레이한 만큼 혜택을 알 수 있는 플레이오 앱을 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.754
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 쌓이는 잼을 코인으로 교환해 상점에서 기프트카드 문화상품원 등 다양한 상품으로 구매 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.764,
                "end": 9.714
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 시청하고 가입한 신규 유저분들한테는 특별 시크릿 코드 프로 엔디러너를 입력하면 10000젤을 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.724,
                "end": 16.868
            },
            {
                "speaker_id": "1",
                "transcription": "추가로 플레이오의 자체적인 퀘스트들이 있어서 게임을 진행하면서도 다양한 잼을 추가를 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.878,
                "end": 22.964
            },
            {
                "speaker_id": "1",
                "transcription": "게임하고도 기프트 카드 문화상품권 무료로 얻고 너무나 좋은 기회 아닌가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.974,
                "end": 27.200
            },
            {
                "speaker_id": "1",
                "transcription": "다운로드 링크 고정 댓글을 참고하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.210,
                "end": 29.369
            },
            {
                "speaker_id": "1",
                "transcription": "자 정확히 비교하자면 아레나에서의 가치에서는 블랙 펄이 압승입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.379,
                "end": 35.394
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스토리에서 만큼은 어둠모드에서 바다요정 활용 가치가 되게 좋았다라는 의견이 좀 있어 가지고 저는 스토리에서는 뭐 바다요정이나 블래펄 둘 다 유용하게 쓸 수 있다 이렇게 보고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.404,
                "end": 46.469
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이거는 제가 잼스톤을 높게 생각을 하면서 느낀 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.479,
                "end": 50.713
            },
            {
                "speaker_id": "1",
                "transcription": "승급이 낮은 것과 높은 거에 질 차이가 확실히 있기는 하지만 잼스톤을 높인다고 하더라도 엄청나게 차이가 나지 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.723,
                "end": 59.433
            },
            {
                "speaker_id": "1",
                "transcription": "무슨 말이냐 제임스 톤의 레벨보다는 이 초월 효과가 더 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.443,
                "end": 64.339
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 여왕이 러너님 저는 초월도 안 달았고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.349,
                "end": 66.876
            },
            {
                "speaker_id": "1",
                "transcription": "레전드 쿠키 레벨도 낮고 키우기 전 단계예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.886,
                "end": 70.089
            },
            {
                "speaker_id": "1",
                "transcription": "아직 고민 단계 하시는 분들은 제가 볼 때는 바다요정 보다는 블랙펄을 골라서 키우는 게 훨씬 더 나은 선택이다 이렇게 볼 수 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.099,
                "end": 79.459
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 아레나에서 활용 가치를 떠나서 리더 효과만 보더라도 바다요정 보다는 더 유용하게 쓸 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.469,
                "end": 86.846
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 또 다른 이유는 바다요정 같은 경우에는 아레나에서 쓸 때 라지베리 색이랑 풀 두 개 또는 라지베리 네 개랑 풀 하나 써가지고 그런데 4초 바요를 꼭 맞춰 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.856,
                "end": 98.093
            },
            {
                "speaker_id": "1",
                "transcription": "4초 바요를 맞춰 주지 않으면 타이밍 자체가 조금 이상하게 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.103,
                "end": 102.111
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 바다요정 같은 경우에는 공격 타임이 생명인데 요 타이밍을 맞춰 주기 위해서는 쿨 피가 되게 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 102.121,
                "end": 108.167
            },
            {
                "speaker_id": "1",
                "transcription": "블래펄 같은 경우에는 되게 무난하게 세팅하기도 쉬운 게 여러분들이 쿨 다섯 개로 맞춰 주고 아니면 여기에 부옵션 하나를 더 넣어서 21퍼센트를 맞춰주면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 108.177,
                "end": 118.478
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 효과를 이렇게 맞춰주면 상대의 딜을 피해주면서 100퍼센트 공중 타이밍에 블랙펄의 딜이 들어갈 수 있게 세팅이 가능한데 바다요정은 그에 비해 세팅 난이도도 있고 그 다음에 피해 감소도 적지 않게 챙겨줘야 생존이 가능하다는 점에서 좀 더 난이도가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 118.488,
                "end": 134.945
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 바다요정은 확실히 초월 효과를 받지 않고 일반 잼스톤 레벨도 낮은 상태에서 그냥 제가 써 봤을 때 부계정으로 테스트해 본 결과 딜이 확실히 미비하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 134.955,
                "end": 145.546
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 자체적인 상향 자체가 있는 게 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 145.556,
                "end": 149.258
            },
            {
                "speaker_id": "1",
                "transcription": "이거 업데이트는 초월효과를 받거나 그래서 세지는 거지 자체적으로 바다요정이 엄청나게 상향된 거가 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 149.268,
                "end": 156.302
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 여러분들이 선택할 때 블랙 펄 쪽에 더 우선순위를 주는 게 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 156.312,
                "end": 161.113
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 또 나온 질문이 아니 러너님 바다요정의 리더 효과도 좋지 않나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 161.123,
                "end": 165.634
            },
            {
                "speaker_id": "1",
                "transcription": "물속성 쿠키들 넣어서 쓰면 더 좋지 않나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 165.644,
                "end": 168.158
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이것도 테스트를 해봤는데 이후에 나오는 신규 쿠키들은 무속성으로 덱을 꾸렸을 때 더 좋을 지는 모르는데 아직까지는 지금 상태에서는 물속성 쿠키 박하사탕을 넣어서 해봤더니 전혀 세지가 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 168.168,
                "end": 181.195
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕 티어가 거의 2티어급이라 여러분들이 시너지 좋게 사용이 불가능하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 181.205,
                "end": 185.997
            },
            {
                "speaker_id": "1",
                "transcription": "지금 업데이트 상황에서는 리더 효과가 되게 블랙홀에 비해서 좋지 않게 흘러가고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 186.007,
                "end": 191.633
            }
        ]
    },
    "summary": "아레나 가치에서 블랙펄이 압승으로 잼스톤을 높인다고 해도 차이나지 않고, 제임스 톤의 레벨보다는 이 초월 효과가 더 중요하고 리더효과도 미비해서 바다요정보다는 블랙펄을 골라서 키우는 데 더 좋은 선택으로 볼 수 있습니다.",
