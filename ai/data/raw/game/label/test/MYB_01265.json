    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "람쥐 상점 자 이거 교환하는 거는 비추입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.695
            },
            {
                "speaker_id": "1",
                "transcription": "지금 뉴비 분이시라 이거는 재고가 너무나 부족할 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.705,
                "end": 7.738
            },
            {
                "speaker_id": "1",
                "transcription": "오 야 이분 광고도 다 봤어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.748,
                "end": 10.845
            },
            {
                "speaker_id": "1",
                "transcription": "지금 킹덤 진짜 진심 모드구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.855,
                "end": 12.701
            },
            {
                "speaker_id": "1",
                "transcription": "열정을 느꼈다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.711,
                "end": 14.005
            },
            {
                "speaker_id": "1",
                "transcription": "광고 다 본 거에서 열정을 느꼈어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.015,
                "end": 17.067
            },
            {
                "speaker_id": "1",
                "transcription": "그러고 지금 영토 확장하고 계신데 영토 확장은 멈추세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.077,
                "end": 22.090
            },
            {
                "speaker_id": "1",
                "transcription": "왜 멈추라고 하냐면은 희귀 재료 없잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.100,
                "end": 25.162
            },
            {
                "speaker_id": "1",
                "transcription": "오로라 재료는 쓸 때가 어마 무시하게 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.172,
                "end": 28.605
            },
            {
                "speaker_id": "1",
                "transcription": "지금 영토 확장을 할 때가 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.615,
                "end": 31.287
            },
            {
                "speaker_id": "1",
                "transcription": "어디다 써야 되냐면은 제가 우선순위를 말씀드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.297,
                "end": 35.298
            },
            {
                "speaker_id": "1",
                "transcription": "1순위 요거 십일회까지 먼저 하시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.308,
                "end": 38.046
            },
            {
                "speaker_id": "1",
                "transcription": "그다음 2순위는 쿠키 하우스 레벨 십레벨 작업을 싹 다 하셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.056,
                "end": 42.192
            },
            {
                "speaker_id": "1",
                "transcription": "3순위 그다음에 랜드마크 작업을 하셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.202,
                "end": 44.959
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 들어가는 오로라 재료가 단순히 이거 몇십 개로가 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.969,
                "end": 49.786
            },
            {
                "speaker_id": "1",
                "transcription": "몇 백개가 들어가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.796,
                "end": 51.195
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 한 이 정도 확장까지는 괜찮다고 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.205,
                "end": 54.326
            },
            {
                "speaker_id": "1",
                "transcription": "이제 오로라 재료 쓸 때는 확실히 알고는 있으셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.336,
                "end": 58.091
            },
            {
                "speaker_id": "1",
                "transcription": "창고 확장도 잘 해놓으셨고 자 그다음에 자 이거 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.101,
                "end": 63.625
            },
            {
                "speaker_id": "1",
                "transcription": "이거 당장 이거 당장 지으세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.635,
                "end": 65.835
            },
            {
                "speaker_id": "1",
                "transcription": "스태미너 젤리 회복 시간 이게 뭐냐면 하루에 저거 만렙 건물 있는 사람과 없는 사람은 대략 고기 젤리 삼십몇 개 차이가 나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.845,
                "end": 73.719
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤은 고기 젤리가 곧 토핑 조각이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.729,
                "end": 76.752
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 어마 무시하게 수급량의 차이가 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.762,
                "end": 80.274
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 반드시 지어주셔야 돼요 이거.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.284,
                "end": 83.581
            },
            {
                "speaker_id": "1",
                "transcription": "요것도 마찬가지 반드시 지어줘야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.591,
                "end": 86.810
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 추후에 필수로 건물 지어야 되는 거 얘도 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.820,
                "end": 90.770
            },
            {
                "speaker_id": "1",
                "transcription": "이 치명타 피해에 대해서 간단하게만 말씀드리면은 단순히 쿠키의 딜을 치명타의 피해를 증가시켜주는 것뿐만 아니라 힐러들도 치명타가 터졌을 때 출혈 자체가",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.780,
                "end": 102.300
            }
        ]
    },
    "summary": "뉴비분 이거 교환하는 거 비추인 게 재고가 너무 부족할 것이고 광고를 다 보신 것을 보면 킹덤에 진심인 열정이 느껴지고 영토 확장은 희귀 재료가 없으니까 멈추고 요거는 11회까지만 먼저 하시고 쿠키 하우스는 십레벨 작업을 싹 다 하신 뒤에 랜드마크 작업을 하셔야 하고 오로라 재료는 몇백 개가 들어가기 때문에 알고 계셔야 하며 창고 확장은 잘 하셨고 스태미너 젤리 회복 시간은 만렙 건물 있는 사람과 없는 사람의 고기 젤리는 삼십몇 개 차이가 나기 때문에 반드시 지어주어야 하고 치명타 피해에 대해서 간단하게 말씀드리겠다.",
