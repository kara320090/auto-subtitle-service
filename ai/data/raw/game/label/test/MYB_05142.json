                    5
                ],
                "start": 0.000,
                "end": 10.712
            },
            {
                "speaker_id": "1",
                "transcription": "야 이건 꼭 사야 돼. 이거 내가 왠만해서 말 안 하는데 야 이건 꼭 사야 돼.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.722,
                "end": 16.210
            },
            {
                "speaker_id": "1",
                "transcription": "내가 진짜 딴 건 모르겠는데 진짜 저건 꼭 사야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.220,
                "end": 20.104
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 저 토핑 조각 주는 게 저 현금 가치로 진짜 어마무시해서. 이건가?",
                "sound_type": [
