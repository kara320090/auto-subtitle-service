        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 이번 판은 네 요런 식으로 지는 스토리가 나와요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.714
            },
            {
                "speaker_id": "1",
                "transcription": "네 보이죠? 요런 식으로 지는 경우가 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.724,
                "end": 12.613
            },
            {
                "speaker_id": "1",
                "transcription": "딜러가 죽어버리면 어이없게 역전 당하는 경우도 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.623,
                "end": 16.311
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 이거 체크해 주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.321,
                "end": 18.173
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 보시는 거와 같이 상위권은 전부 다 투탱이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.183,
                "end": 21.980
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 다른 경우가 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.990,
                "end": 23.889
            },
            {
                "speaker_id": "1",
                "transcription": "원탱은 거의 찾아보기 힘듭니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.899,
                "end": 25.748
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 이번 시즌은 여러분들이 포인트 잡아야 될 거는 투탱 방덱을 어떻게 파야 할 것인가",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.758,
                "end": 36.333
            }
        ]
    },
    "summary": "남성은 이번시즌의 상위권은 전부 투탱이기 때문에 포인트를 잡으려면 투탱의 방덱을 어떻게 파야 할지 라고 했다.",
