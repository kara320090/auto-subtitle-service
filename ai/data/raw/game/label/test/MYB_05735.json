        "term": [
            {
                "speaker_id": "1",
                "transcription": "나도 호박마차를 분석하는 게 꽤 재미있었어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.312
            },
            {
                "speaker_id": "2",
                "transcription": "정말 행복한 여름이었지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.316,
                "end": 6.161
            },
            {
                "speaker_id": "2",
                "transcription": "시간이 멈췄으면 싶을만큼 즐거웠던 건 오랜만이야.",
                "sound_type": [
                    2
                ],
                "start": 6.171,
                "end": 10.659
            },
            {
                "speaker_id": "2",
                "transcription": "하지만 함께 즐겼던 축제도 언젠가는 끝나고 말 거라 생각하니 조금 슬퍼져.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.669,
                "end": 18.969
            },
            {
                "speaker_id": "1",
                "transcription": "글쎄 그럴지도 몰라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.979,
                "end": 21.805
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 매일매일 축제라면 그렇게 즐겁지 않을 거야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.815,
                "end": 26.104
            },
            {
                "speaker_id": "1",
                "transcription": "언젠가는 끝날 걸 아니까 더 신 나게 놀 수 있는걸?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.104,
                "end": 30.192
            },
            {
                "speaker_id": "3",
