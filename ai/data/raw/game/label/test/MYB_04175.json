        "term": [
            {
                "speaker_id": "1",
                "transcription": "스턴 걸려 가지고 아무것도 못 하고 그냥 제 자리에 가만 있는 것 때문에 스토리 깨기가 되게 쉬워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.721
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 이제 캡틴캐비어는 딜 엄청나게 넣어주고 아 러너님 저는 시작한 지 2주 된 초보인데 만약 확정 고대의 전설 상자 있으면 무엇을 얻는 게 좋나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.731,
                "end": 19.053
            },
            {
                "speaker_id": "1",
                "transcription": "바요가 솔직히 어 있으면 좋긴 하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.063,
                "end": 23.189
            },
            {
                "speaker_id": "1",
                "transcription": "시작한지 2주 근데 나중에 떡상하거나 그럴 때 그냥 쓰세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.199,
                "end": 28.039
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 뽑아봤자 걔네 키울 여력이 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.049,
                "end": 31.329
            },
            {
                "speaker_id": "1",
                "transcription": "다른 0티어 쿠키들 키울 게 많아서 지금 어차피 투자할 이유가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.339,
                "end": 36.100
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 저 뽑기 가겠습니다 21000개 모았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.110,
                "end": 39.204
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 뽑고 싶은 거를 보면은 에클레어는 뽑았고 어 제가 뽑고 싶은 거는 웨어울프와 슬슬 토벌덱도 신경 쓸 거면은 웨어울프랑 당연하겠지만 블랙펄을 좀 뽑고 싶습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.214,
                "end": 53.225
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 덕에서는 오징어 먹물, 웨어울프, 마카롱은 있고 걔네들 좀 뽑았으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.235,
                "end": 58.798
            },
            {
                "speaker_id": "1",
                "transcription": "자 가자 블랙펄 뽑으러 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.808,
                "end": 61.693
            },
            {
                "speaker_id": "1",
                "transcription": "자 비티에스 쿠키 일단 3번",
