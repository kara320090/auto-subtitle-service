        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 몸은 용의협곡으로 돌아가다가 배가 고파서 잠깐 베리 숲속에서 쉬고 있었던 것 뿐이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.726
            },
            {
                "speaker_id": "2",
                "transcription": "배가 고팠다고 하기엔 고통스러워하고 있지 않았나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.736,
                "end": 10.647
            },
            {
                "speaker_id": "3",
                "transcription": "쉬고 있었다고 하기엔 날아가다가 추락한 것처럼 주변이 온통 엉망이었고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.657,
                "end": 17.024
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 용의협곡에 있다는 붉은 용은 이 몸이 아니라는 말이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.034,
                "end": 22.975
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키들은 작고 약하잖아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.985,
                "end": 24.810
            },
            {
                "speaker_id": "1",
                "transcription": "나부랭이 용을 보고 벌벌 떠는게 하루 이틀인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.820,
                "end": 27.947
            },
            {
                "speaker_id": "3",
                "transcription": "나부랭이 용이 아니야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.957,
                "end": 30.441
            },
            {
                "speaker_id": "3",
                "transcription": "베리 숲의 몬스터들까지 그 기운으로 잔뜩 흥분해 있다고 모험가 쿠키들 말로는 너만큼 커다란 붉은 용이 용의협곡에서도 가장 높은 화산 꼭대기에서 솟아났다고 했어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.451,
                "end": 43.942
            },
            {
                "speaker_id": "3",
                "transcription": "가장 높은 화산 꼭대기라면 네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.952,
                "end": 48.268
            },
            {
                "speaker_id": "1",
                "transcription": "나의 둥지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.278,
                "end": 51.833
            }
        ]
    },
    "summary": "용의협곡 가장 높은 꼭대기 화산 둥지에서 붉은 용이 솟아났고 그 곳은 용과드래곤 쿠키의 둥지이다.",
