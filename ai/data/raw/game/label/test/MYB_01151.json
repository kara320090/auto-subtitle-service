        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "스냅드래곤은 쿨 높게 이렇게 세팅하시면은 상당히 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.881
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 호루라기는 요렇게 받을거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.891,
                "end": 6.601
            },
            {
                "speaker_id": "1",
                "transcription": "정리를 하자면은 블랙펄쿠키는 정석덱으로 쓰기 되게 좋네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.611,
                "end": 10.354
            },
            {
                "speaker_id": "1",
                "transcription": "바요는 땅바닥에 붙어있어서 용과브레스에 죽기 너무나 쉽고 올 아몬드를 하더라도 죽는 경우가 생기는데 블랙펄은 요렇게 쿨타임과 그 다음에 애플젤리 섞거나 그냥 올쿨세팅에서 세트효과 더해서 쿨타임 20퍼센트 맞춰주면은 기가막히게 상대의 공격을 피해서 스킬을 쓰기때문에 피갑이 조금 낮더라도 상대의 딜을 조금 피할 수 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.364,
                "end": 32.364
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤이랑도 시너지 좋게 쓰였고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.374,
                "end": 34.673
            },
            {
                "speaker_id": "1",
                "transcription": "아까 샤글이랑도 시너지 좋게 쓰일수 있는 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.683,
                "end": 38.138
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 정석덱에서는 블랙펄이 더 좋은거 같고 한방덱에서는 바요가 더 좋았어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.148,
                "end": 43.898
            },
            {
                "speaker_id": "1",
                "transcription": "제가 아까 써봤을 때는 아직 뭐를 키우세요라고 하기에는 여러분들 지금 업데이트된지 3시간 밖에 안됐기 때문에 구체적으로 딱 정해서 말씀드리기 힘들 것 같구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.908,
                "end": 53.459
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 좋은 덱이나 아레나 조합이나 토벌이나 이런데서 쓰이게 되면 또 다른영상에서 또 리뷰를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.469,
                "end": 66.700
            }
        ]
    },
    "summary": "화자가 정리를 하자면 블랙펄 쿠키는 정석 덱으로 쓰기 좋으며 용과 드래곤, 샤글과도 시너지 좋게 쓸 수 있으며 한방 덱에서는 바조가 더 좋았다며 지금은 업데이트된지 얼마 지나지 않았기 때문에 구체적으로 어떤 것을 키우라고 말하기 힘들며 다른 영상에서 또 리뷰를 하겠다고 말하고 있다.",
