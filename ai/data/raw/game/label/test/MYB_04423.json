                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.372
            },
            {
                "speaker_id": "1",
                "transcription": "별 차이가 느껴지지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.382,
                "end": 6.292
            },
            {
                "speaker_id": "1",
                "transcription": "네 그냥 똑같네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.302,
                "end": 10.416
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에 나온 신규 스킨 4종 제가 전부다 스킨 비교를 해봤는데 결론이 딱 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.426,
                "end": 17.295
            },
            {
                "speaker_id": "1",
                "transcription": "가장 눈에 띄는 거는 감초 맛 쿠키는 정말 차이가 나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.305,
                "end": 21.477
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 가장 눈에 띄고 나머진 똑같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.487,
                "end": 24.549
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 별 차이는 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.559,
                "end": 26.147
            },
            {
                "speaker_id": "1",
                "transcription": "혹시나 나는 감초 맛 쿠키를 정말 좋아하고 얘를 자주 쓰고 뭔가 바뀐 모습을 보고 싶다 하시면 감초가 가장 다르다 나머지는 똑같다 이렇게 보시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.157,
                "end": 39.216
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 랭커 분들은 뽑는 이유가 따로 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.226,
                "end": 42.512
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 이렇게 스킨 인연을 통해서 공격력, 방어력, 공격력, 방어력 이렇게 미세하지만 추가적인 능력치를 얻을 수 있다 이거 확인이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.522,
                "end": 53.332
            },
            {
                "speaker_id": "1",
                "transcription": "스킨 인연까지 이렇게 봤고 네 스킨 리뷰는 여기서 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.342,
                "end": 59.647
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
