        "term": [
            {
                "speaker_id": "1",
                "transcription": "요것도 한번 가 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.008
            },
            {
                "speaker_id": "1",
                "transcription": "준비물이 블랙펄 쿠키다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.018,
                "end": 2.819
            },
            {
                "speaker_id": "1",
                "transcription": "그 영상이라도 있는 게 좋은 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.829,
                "end": 5.041
            },
            {
                "speaker_id": "1",
                "transcription": "모두 비켜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.051,
                "end": 6.847
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱 같은 경우에는 화관 신규 보물을 이용한 한방덱 유튜브에 올렸거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.857,
                "end": 11.696
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그거도 뭐 쓰 쓰는 사람은 있지만 이거 그것보다도 뭐 지금 보면은 신규 보물을 굳이 뽑아 않아도 기존 공을 그대로 쓰고 어 이 네 마리 쿠키도 뭐 웬만해서 어느 정도 좀 오래 하신 분들이야 뽑아 놨지 낫고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.706,
                "end": 27.066
            },
            {
                "speaker_id": "1",
                "transcription": "블래펄은 이제 뽑으신 분들 준비물이 이게 좀 세긴 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.076,
                "end": 30.496
            },
            {
                "speaker_id": "1",
                "transcription": "얘 없는 분들이 좀 많지만 저걸 뽑으신 분들은 아레나에서 그냥.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.506,
                "end": 35.300
            }
        ]
    },
    "summary": "준비물이 블랙펄 쿠키이고 한방덱 같은 경우에는 화관 신규 보물을 이용한 한방덱을 유튜브에 올렸던 적이 있었다.",
