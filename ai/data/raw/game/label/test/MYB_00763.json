        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 제일 먼저 3딜 극딜덱에 공격이 들어왔을 때 박하사탕이 견뎌내야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.709
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕이 죽으면 안 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.719,
                "end": 7.787
            },
            {
                "speaker_id": "1",
                "transcription": "자 스킬 순서 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.797,
                "end": 9.591
            },
            {
                "speaker_id": "1",
                "transcription": "제가 아까 23퍼센트 주라는 이유가 블랙펄이 쿨이 조금 늦으면은 안돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.601,
                "end": 15.792
            },
            {
                "speaker_id": "1",
                "transcription": "빨리빨리 스킬이 돌아가서 스타 더스트 다음에 네 계속 쓸 수 있는 구도가 이어져야 되고 박하사탕 맛 쿠키도 이렇게 죽지 않고 버텨주는 구도로 네 이런 식으로 흘러가 주면 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.802,
                "end": 31.833
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 박하사탕은 피감이 높으면 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.843,
                "end": 35.330
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 네 이기는 구도가 나오게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.340,
                "end": 41.140
            },
            {
                "speaker_id": "1",
                "transcription": "무난하게 이기는 구도가 나오기 위해서는 박하사탕이 최대한 안 터지고 버텨주는 그림이 나오면은 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.150,
                "end": 49.911
            },
            {
                "speaker_id": "1",
                "transcription": "딜러가 두 명뿐이지만 버티고 내 공격 쿠키가 상대의 딜러를 하나씩 죽여가면은 이렇게 승리하는 구도가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.921,
                "end": 58.833
            }
        ]
    },
    "summary": "공격이 들어왔을 때 박하사탕이 죽지 않고 버텨서 상대 딜러를 하나씩 죽여가면 승리하는 구도로 만들 수 있다.",
