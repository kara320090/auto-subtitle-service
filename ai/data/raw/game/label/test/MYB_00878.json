        "term": [
            {
                "speaker_id": "1",
                "transcription": "잼스톤 효과 같은 경우에는 이 물감옥 지속 변경 시간 요거 되게 크거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.302
            },
            {
                "speaker_id": "1",
                "transcription": "나머지도 분명히 큽니다 하지만 물감옥 지속시간 변경 자체는 승부를 되게 크게 판도를 바꾸는 큰 요소기 때문에 블랙펄 10강은 반드시 찍어야 된다고 생각을 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.312,
                "end": 19.587
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다요정 30강은 제가 다음에 리뷰할 거지만 딜은 강력하지만 1분 이후에 잘 죽는 거는 아직도 여전합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.597,
                "end": 28.169
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 과전류덱도 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.179,
                "end": 30.584
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 과전류덱도 더 강력해졌습니다 왜냐 과전류덱은 기본적으로 극딜덱이에요 그런데 상대방의 피해 감소를 더 무시해주기 때문에 딜이 더 잘 들어가고 블랙펄의 딜도 더 세지기 때문에 상대가 더 잘 죽는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.594,
                "end": 46.287
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 보겠습니다 자 상대 쿠키가 얼마나 더 잘 녹아나는지",
                "sound_type": [
