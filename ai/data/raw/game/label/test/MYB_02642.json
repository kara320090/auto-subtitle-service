        "term": [
            {
                "speaker_id": "1",
                "transcription": "사람이 없어서 그리고 너무 스트레스 받지 마세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.317
            },
            {
                "speaker_id": "1",
                "transcription": "왜 나는 46스테이지에서 밖에 클리어 안 되나 이런 분들 보통 노움 연구소나 길드 버프에 따라서 스테이지 클리어하는 단계가 차이가 나는 거는 어쩔 수 없어서 나중에 스덱 어차피 천천히 키우다 보면은 쿠키 만랩 찍고 스킬 파우더 레벨 만랩 찍으면은 그런 버프가 조금 낮아도 원덱 클리어하는 거는 나중 되면은 네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.327,
                "end": 29.781
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 좀 파밍 돼 가지고 세팅 하면은 길드 버프랑 노움 연구소 조금 덜 돼도 원덱 클리어 가능하거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.791,
                "end": 36.964
            },
            {
                "speaker_id": "1",
                "transcription": "그전까지만 조금 귀찮더라도 덱을 여러 개 써주시는 게 나을 거 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.974,
                "end": 45.328
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트가 없으면은 에스프레소나 아니면 뭐는 블랙펄 뭐 이런 거 쓰시는 분 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.338,
                "end": 52.878
            },
            {
                "speaker_id": "1",
                "transcription": "네 스타더스트 없으면은 에스프레소나 블랙펄",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.888,
                "end": 58.277
            },
            {
                "speaker_id": "1",
                "transcription": "물론 스타더스트 보다는 안 좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.287,
