        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 과전류 덱이 너무나 사기적으로 완벽한 카운터로 쓸 수 있기 때문에 단 이 과전류 덱은 여러분들 절대 1탱덱한테는 들어가시면 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.766
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 1탱덱에 들어가면 피감이 높고 세팅이 잘 된 분들은 버틸 수 있지만 상대방의 극딜에 파르페나 앞의 딜러가 잘릴 가능성이 크기 때문에 절대 1탱덱한테는 들어가지 마시고 이렇게 2탱덱 조합에만 들어가면 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.776,
                "end": 27.877
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 파르페가 일찍 터지거나 딜이 너무나 부족해서 상대 딜러들이 안 죽습니다 하시는 분들은 딜러가 죽지 않는 피해 감소 내에서 공격력과 치명타 확률을 높여 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.887,
                "end": 41.818
            },
            {
                "speaker_id": "1",
                "transcription": "웬만해서는 딜이 부족해서 지는 경우보다도 어 파르페가 너무 일찍 죽거나 아니면 딜러들이 일찍 죽는 경우만 어 지는 경우가 나오고 어 웬만해서는 이기는 구도가 나올 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.828,
                "end": 56.275
            },
            {
                "speaker_id": "1",
                "transcription": "파르페 은근 몸이 좀 약하기 때문에 피해 감소 가급적이면은 높여서 세팅해 주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.285,
                "end": 63.724
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 무난하게 완벽한 승리로 가져가는 경우가 많이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.734,
                "end": 69.700
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 샤글 어 레모네이드 사용이 가능하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.710,
                "end": 73.780
            },
            {
                "speaker_id": "1",
                "transcription": "자 분명히 또 이런 질문이 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.802,
                "end": 75.862
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리를 그냥 앞에 쓰면 안 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.875,
                "end": 78.108
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리를 쓰게 되면 뒤의 생존이 더 불안정해지고 죽는 경우가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.118,
                "end": 83.760
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리보다는 무조건 코랄을 쓰는 게 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.770,
                "end": 87.420
            },
            {
                "speaker_id": "1",
                "transcription": "정 코랄을 쓸 수 없다 하시는 분들은 홀리베리를 써도 되지만 지금같이 완벽한 어 승률을 볼 수가 없을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.430,
                "end": 95.020
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 불안정한 승률을 볼 수 밖에 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.030,
                "end": 97.762
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 질문 하나가 블랙 레모네이드 대체가 있나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.772,
                "end": 101.842
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱같은 경우에는 완벽한 2탱 저격 조합으로 2개의 조합이 시너지 좋게 사용되는 거라 여러분들 이 만약에 블랙 레모네이드가 없다면은 다른 조합으로 쓰는 게 더 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.852,
                "end": 113.510
            },
            {
                "speaker_id": "1",
                "transcription": "소르베를 넣다던가 아니면 기타 다른 블랙펄을 넣다던가 이러면은 원래 의도했던 시너지가 좋게 나오지가 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.537,
                "end": 123.109
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상은 네 과전류 덱 아레나에서 죽지 않고 2탱 조합 저격으로 아주 잘 쓰고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 123.119,
                "end": 130.624
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 알려드리려고 찍었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 130.634,
                "end": 132.802
            },
            {
                "speaker_id": "1",
                "transcription": "궁금한 점이 있다면 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 132.812,
                "end": 135.599
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 135.609,
                "end": 141.200
            }
        ]
    },
    "summary": "이번 영상에서는 과전류 덱 아레나에서 2탱 조합으로 죽지 않고 잘 쓰고 있다는 걸 알리기 위해 찍었으며 과전류 덱에서는 1탱덱한테는 절대 들어가면 안 되는데 그 이유는 상대방의 극딜에 파르페나 앞의 딜러가 잘릴 가능성이 크기 때문이다.",
