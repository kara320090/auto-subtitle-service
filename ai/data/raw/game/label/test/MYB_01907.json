            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키 뽑기는 살짝 뒤로 해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.214
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보니까 패턴이 크탈 모아서 쿠키뽑기에 다 이런 식의 운영을 하고 계신데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.224,
                "end": 9.970
            },
            {
                "speaker_id": "1",
                "transcription": "아무리 쿠키 승급이 올라간다 해도 토핑이랑 랜드마크랑 쿠키 하우스 별사탕이나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.980,
                "end": 15.817
            },
            {
                "speaker_id": "1",
                "transcription": "이런 약간 기본적인 바탕이 안 되면 게임하는데 나는 투자를 많이 하는데 왜 자꾸만 스펙이 안 좋아지지 이게 무한 반복 이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.827,
                "end": 25.200
            },
            {
                "speaker_id": "1",
                "transcription": "랜드마크 고기젤리 랜드마크 쿠키하우스 별사탕 생산 이거만 먼저 방향을 바꾸셔야 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.210,
                "end": 32.321
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 넉넉하니까 당장 하라는 건 아니고 얘가 점점 가까워 지잖아요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.331,
                "end": 37.186
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 200칸까지 늘리면 어느 정도 해결되니까 부족할 때 마다 200칸까지 쭉쭉 올리시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.196,
                "end": 43.903
            },
            {
                "speaker_id": "1",
                "transcription": "아까 시간 투자 힘들다고 했죠 그러면 기본 재료한테는 500개까지 쓰세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.913,
                "end": 49.034
            },
            {
                "speaker_id": "1",
                "transcription": "시간 투자가 힘들면 얘도 우유 같은 경우는 부족하면 500개까지 써요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.044,
                "end": 53.894
            },
            {
                "speaker_id": "1",
                "transcription": "대기 시간에다가 투자하는 거는 안 아깝거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.904,
                "end": 57.485
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 11성이긴 한데 테크 올려도 상관없거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.495,
                "end": 61.053
            },
            {
                "speaker_id": "1",
                "transcription": "젤리 베리가 주구장창 엄청 쌓일거예요 이런 거 테크 안 올리면 달고나 잼 얘도 다 오픈해 주시고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.063,
                "end": 66.930
            },
            {
                "speaker_id": "1",
                "transcription": "아니 얘네들이 재고가 쌓이는데 테크를 올려야 되나 말아야 되나는 레벨업 기간 동안 여기 보면 시간이 나오는데 어떤 거는 이틀 걸리고 3일 걸리는 것도 있거든요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.940,
                "end": 77.265
            },
            {
                "speaker_id": "1",
                "transcription": "그런 거 레벨업 하기 전에 앞에 재고가 열차 멈추지 않을 정도인지 체크해 보고 여유가 됐다 그러면 테크는 계속 올라가도 상관없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.275,
                "end": 86.839
            },
            {
                "speaker_id": "1",
                "transcription": "이게 패치 되가지고 이게 업그레이드 돼도 열차에 바로 나오는 게 아니라 오픈 되고 나서 신규 이런 재고가 10개 쌓일 동안은 열차에 안 나오거든요 나무 많이 쌓이잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.849,
                "end": 99.805
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 많이 만드세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.815,
                "end": 101.866
            }
        ]
    },
