        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 9월 6일 업데이트 날 여러분들이 이제 크리스탈도 많이 필요하고 준비하면 좋은 그런 팁들을 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.050
            },
            {
                "speaker_id": "1",
                "transcription": "제일 먼저 알려 드릴 거는 건설하기 들어가서 여러분들 꾸미기 들어가면 이거 아시는 분들은 이미 알고 다 했는데 아마 지나친 분들이 상당히 많을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.060,
                "end": 18.749
            },
            {
                "speaker_id": "1",
                "transcription": "이 리미티드 에디션 꾸미기 밑에 보면 크리스탈 5000개를 공짜로 주거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.759,
                "end": 24.351
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아마 무과금러분들은 아직 이걸 다 못 모아서 못 하시는 분도 있지만 대부분 좀 뽑기를 많이 하시는 분들이나 무과금러분들도 이거를 할 수 있는 분이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.361,
                "end": 34.201
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이걸 몰라서 못하는 분도 있어서 요거를 다 사요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.211,
                "end": 38.063
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 사 주시면 업데이트 때 5000개 이거 가지고 뽑기 더 할 수 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.073,
                "end": 42.823
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 꾸미기 여기에 들어가서 크리스탈 5000개 이렇게 공짜로 받아서 디즈니 축제 액자도 받을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.833,
                "end": 50.666
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.676,
                "end": 54.786
            },
            {
                "speaker_id": "1",
                "transcription": "원도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.796,
                "end": 58.071
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.081,
                "end": 63.033
            }
        ]
    },
