                ],
                "start": 10.232,
                "end": 17.301
            },
            {
                "speaker_id": "1",
                "transcription": "아니요. 저 결말도 관심 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.311,
                "end": 18.905
            },
            {
                "speaker_id": "1",
                "transcription": "낭만 100프로 비용 세 개 @이름1님 감사합니다. 고맙습니다.",
                "sound_type": [
