        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿨은 어 세트효과 포함해서 22.3퍼센트 이상 자 블랙펄 같은 경우에는 세트효과 더해서 21퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.803
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스냅 드래곤은 올 쿨 이 조합은 무난하게 2탱 조합한테 모두 들어가도 됩니다 제가 가장 무난하게 추천드리는 조합이다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.813,
                "end": 16.310
            },
            {
                "speaker_id": "1",
                "transcription": "아 러너님 저는 블랙펄을 키우지 않았습니다 없습니다 하시는 분들 그럼 이조합에서 블랙펄 자리에 샤글이나 스타더스트 그다음에 소르베 기타 다른 딜러들 여러분들 키운거 딜러를 넣어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.320,
                "end": 30.945
            },
            {
                "speaker_id": "1",
                "transcription": "자 4번 조합에서 락스타 자리에 스타더스트를 넣은 이 조합 같은 경우에는 누구한테 들어가냐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.955,
                "end": 35.769
            },
            {
                "speaker_id": "1",
                "transcription": "자 일반적으로 전투력이 낮은 원탱덱한테 많이 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.779,
                "end": 40.200
            },
            {
                "speaker_id": "1",
                "transcription": "전투력이 낮은 원탱덱 상대로 이 조합을 쓰면 승률이 굉장히 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.210,
                "end": 45.025
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리는 올 쿨 용과는 네 올 라즈 쿨 높게 스타더스트는 3초 그리고 블랙펄 올 쿨 스냅 드래곤 올 쿨 네 원탱 전투력 낮은 조합한테 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.022,
                "end": 56.398
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이 조합도 정말 사람들이 많이 쓰는 대표적인 유행덱이고 사람들이 원탱덱 2탱덱 가릴 것 없이 정말 무난하게 많이 쓰는 조합입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.408,
                "end": 66.559
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 낮은 분들이 고스펙분들 저격으로 많이 사용하는 조합이고 세팅같은 경우에는 실론나이트는 올 아몬드에다가 뭐 공 치 높게 그다음 공속 홀리베리 올 쿨 락스타는 피감 10정도 세트효과 22.3퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.569,
                "end": 80.960
            },
            {
                "speaker_id": "1",
                "transcription": "소르베는 올 쿨로 해서 뭐 권장 쿨 23 그다음에 파르페는 올 쿨 네 권장 쿨타임 22퍼센트 그다음 피감은 높게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.960,
                "end": 89.167
            },
            {
                "speaker_id": "1",
                "transcription": "요 조합 같은 경우에는 2탱 조합 그리고 원탱 조합 가릴 거 없이 전부 다 사람들이 많이 이용하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.177,
                "end": 96.090
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이 조합은 원탱 극딜 조합이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.100,
                "end": 99.393
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 홀리베리 올 쿨 스타더스트는 3초 네 달빛은 올 쿨 블랙펄 올 쿨 스냅 드래곤 올 쿨입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.403,
                "end": 106.666
            },
            {
                "speaker_id": "1",
                "transcription": "자 1번부터 5번 거기다가 추가적으로 여기에 이제 한방덱류도 참고해서 더 세팅해 주셔도 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 106.676,
                "end": 113.940
            },
            {
                "speaker_id": "1",
                "transcription": "자 1번 조합은 언제 들어가냐 이 조합도 2탱 조합한테 일반적으로 가고요 원탱 조합 방덱한테는 들어가지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.950,
                "end": 123.277
            },
            {
                "speaker_id": "1",
                "transcription": "네 과전류 덱한테 특히나 약한 모습이 있기 때문에 자 전투력이 낮은 2탱한테 들어간다.",
