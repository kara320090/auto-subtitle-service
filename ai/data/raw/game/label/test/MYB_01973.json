        "term": [
            {
                "speaker_id": "1",
                "transcription": "붉은 용의 기운 때문에 날뛰던 몬스터들이 여기까지 넘어온 모양이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.171
            },
            {
                "speaker_id": "2",
                "transcription": "문제 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.181,
                "end": 6.615
            },
            {
                "speaker_id": "1",
                "transcription": "도시의 쿠키들을 다치지 않게 조심해서 잡아보자구.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.625,
                "end": 11.500
            },
            {
                "speaker_id": "3",
                "transcription": "칼 갈아드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.510,
                "end": 13.367
            },
            {
                "speaker_id": "3",
                "transcription": "석궁 창 화살촉 뭐든지 갈아드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.377,
                "end": 17.370
            },
            {
                "speaker_id": "4",
                "transcription": "물약 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.380,
                "end": 19.173
            },
            {
                "speaker_id": "4",
                "transcription": "와이번 눈알 물약 트롤 발톱 물약 뭐든지 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.183,
                "end": 24.535
            },
            {
                "speaker_id": "5",
                "transcription": "모험가의 보따리에는 식량이 필수죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.545,
                "end": 28.681
            },
            {
                "speaker_id": "5",
                "transcription": "배가 든든해야 용도 잡는답니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.691,
                "end": 32.330
            },
            {
                "speaker_id": "1",
                "transcription": "저기서 먹을 것 좀 사가자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
