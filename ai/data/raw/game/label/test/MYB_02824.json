        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 보게 되면은 깃털, 깃털, 깃털 다 이렇게 되어 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.094
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이 깃털로 쓰는 것도 이따가 보여드리겠지만 요 덱을 여러분들이 많이 만날 때 어떻게 해야 되냐면 저는 이 3번 덱으로 가거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.104,
                "end": 12.132
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 3번 덱도 알아두시는 게 좋아서 모노클 보물 쓰고 크런치초코칩은 아몬드, 공속. 소르베는 아까 똑같이 피, 쿨. 그다음에 서리여왕은 피. 그다음에 능력 되면은 공격력, 치명타 확률.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.142,
                "end": 26.962
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 퓨바는 아몬드의 쿨 8퍼센트 이상 그다음에 BTS는 올 쿨입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.972,
                "end": 32.618
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱은 제가 이번에 소개하는 덱이기도 하지만 카운터 덱도 제가 이것도 한번 같이 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.628,
                "end": 39.591
            },
            {
                "speaker_id": "1",
                "transcription": "이걸로 되게 좋게 승률이 잘 나오거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.601,
                "end": 44.375
            }
        ]
    },
