                    2,
                    3
                ],
                "start": 13.645,
                "end": 18.974
            },
            {
                "speaker_id": "1",
                "transcription": "아 마가린까지만 스킨 더 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.984,
                "end": 20.924
            },
            {
                "speaker_id": "1",
                "transcription": "얜 차이가 없어 여러분들.",
