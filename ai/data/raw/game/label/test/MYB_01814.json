        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 스냅드래곤 쿠키 5초월 자 일단 이렇게 스냅드래곤 5초월을 하면 연구소에서 이렇게 없어집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.220
            },
            {
                "speaker_id": "1",
                "transcription": "네. 제가 총 구매한 거는 뭐야 금어초 패키지가 없네 아예?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.230,
                "end": 14.594
            },
            {
                "speaker_id": "1",
                "transcription": "없어졌네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.604,
                "end": 15.518
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 패키지도 없어졌어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.528,
                "end": 17.341
            },
            {
                "speaker_id": "1",
                "transcription": "총 제가 59만 5000원을 결제해서 5초월을 얻었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.351,
                "end": 22.695
            },
            {
                "speaker_id": "1",
                "transcription": "60만원 짜리다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.705,
                "end": 24.056
            },
            {
                "speaker_id": "1",
                "transcription": "스냅드래곤 5초월 뽑기 리뷰는 여기서 마치도록 할게요.",
                "sound_type": [
                    2,
                    3
