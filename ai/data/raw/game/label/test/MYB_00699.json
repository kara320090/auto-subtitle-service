    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 프릴해파리 출시 이후에 제가 아레나 연구를 하면서 상성 관계 파악을 해 봤습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.521
            },
            {
                "speaker_id": "1",
                "transcription": "현재 가장 좋은 프릴해파리 0티어 조합하고 카운터 조합 현재 아레나 상성 조합까지 이번 영상에서 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.531,
                "end": 13.897
            },
            {
                "speaker_id": "1",
                "transcription": "자 프릴해파리 같은 경우에는 기존에 이렇게 극딜 3딜 조합을 저격하기 위한 최고의 조합입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.907,
                "end": 20.965
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 자 프릴해파리는 능력 자체가 시작하자마자 1초만에 최대 5쿠키를 속박해서 스킬을 못 쓰게 막을 수가 있는데 무조건 5쿠키를 다 속박하는 건 아니고 일반적으로 2쿠키나 3쿠키를 속박해서 스킬을 못 쓰게 만듭니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.975,
                "end": 37.878
            },
            {
                "speaker_id": "1",
                "transcription": "그 사이에 아군의 딜러가 상대 딜러를 폭딜해서 죽이는 결과가 나오고 높은 확률로 승률을 가져가게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.888,
                "end": 46.344
            },
            {
                "speaker_id": "1",
                "transcription": "자 그렇다면은 무조건 바다요정을 써야 되냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.354,
                "end": 49.074
            },
            {
                "speaker_id": "1",
                "transcription": "그거는 아니고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.084,
                "end": 50.334
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정이 쓰이는 경우는 자 여러분들이 잼스톤이 20강 이상 권장 3초월 이상 스펙이 높아야지만 바다요정은 쓰일 가치가 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.344,
                "end": 60.830
            },
            {
                "speaker_id": "1",
                "transcription": "그게 아닌 분들이 많기 때문에 제가 추천드리는 가장 좋은 조합은 이렇게 쓰는 걸 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.840,
                "end": 67.596
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 보물 같은 경우에는 무공비, 호루라기, 시계고 자 코랄 같은 경우에는 쿨 타임은 세트 효과 포함해서 21.3퍼센트 이상 주시면 되고 저는 쿨을 좀 더 줬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.606,
                "end": 79.853
            },
            {
                "speaker_id": "1",
                "transcription": "왜 더 줬냐면 나중에 코랄이 혼자 남았을 때 스킬 회전이 더 빨라서 창 찌르기가 예를 들어 스타더스트 같이 킬 시전이 되기 전에 상대를 공격해서 죽이는 경우가 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.863,
                "end": 92.750
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 쿨이 낮게 되면은 상대 쿠키가 스킬 발동해서 떠오르고 나서 스킬 발동되는 약간 헛방을 치는 경우가 많이 나서 저는 쿨을 더 많이 줬다는 점 당연히 공격력과 치명타 확률이 높으면은 더 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.760,
                "end": 107.146
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 크림슨코랄 같은 경우에는 스킬 총 피해량이 높으면 높을수록 체력 보호막을 두껍게 주기 때문에 공격력과 치명타 확률이 높으면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 107.156,
                "end": 117.112
            },
            {
                "speaker_id": "1",
                "transcription": "자 프릴해파리 같은 경우에는 일찍 죽어서 좋은 쿠키가 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 117.122,
                "end": 121.395
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 피해 감소와 쿨이 높으면",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 121.405,
                "end": 124.200
            }
        ]
    },
    "summary": "남성이 프릴해파리 출시 이후에 가장 좋은 프릴해파리 0티어 조합과 카운터 조합, 현재 아레나 상성 관계 조합까지 파악해서 알려준다.",
