        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 자 삼천사백 이번에도 뱀파가 치명이 안 터진 판",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.026
            },
            {
                "speaker_id": "1",
                "transcription": "예 이천팔백삼십 뭐 이렇게 까지 나오는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.036,
                "end": 12.315
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 여러분들 이거 분명히 애플젤리 토핑 이거 안 되어 있는 분들 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.325,
                "end": 17.870
            },
            {
                "speaker_id": "1",
                "transcription": "이런 분들은 올 라즈베리 해도 되는데 그렇게 되면은 어 피감을 훨씬 더 높게 하셔야 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.880,
                "end": 24.583
            },
            {
                "speaker_id": "1",
                "transcription": "아마 십팔 대 후반이나 얘도 올 라즈로 한다면은 피감도 좀 더 높게 세팅을 하셔야 좀 안전하게 할 수가 있을거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.593,
                "end": 34.787
            },
            {
                "speaker_id": "1",
                "transcription": "일단 토핑 설명이나 빌드는 여기서 마치고 이 빌드는 저희 최신부대 @이름 님이 만드신건데 정말 점수 잘 나오고 또 실수나 이런거 없다면 점수가 엄청나게 높게 나오니까 보고 따라 하시면 되고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.797,
                "end": 51.130
            },
            {
                "speaker_id": "1",
                "transcription": "마지막으로 아까 제가 치명타 잘 터진 거 올 치명 터진거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.140,
                "end": 55.400
            }
        ]
    },
    "summary": "뱀파가 치명이 터지지도 않았는데 점수가 높으며 토핑도 중요한 요소로 올 라즈베리로 한다면 피감을 더 높여야 한다.",
