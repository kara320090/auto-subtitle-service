        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 바다요정은 제가 리뷰를 해봤는데 어 확실히 정석 덱으로 쓰기에는 덱 연구가 더 필요할 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.803
            },
            {
                "speaker_id": "1",
                "transcription": "땅에 붙어있어서 용과한테 한방에 녹는 그런 경우가 좀 많이 나오는 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.813,
                "end": 11.998
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 아몬드로 끼면은 또 딜이 낮고 라즈베리로 하면은 한방에 또 죽을 수도 있기 때문에 정석 덱은 힘들지만 아까 방금 본 것처럼 한방 덱으로 활용하면은 아 또 이게 다르게 엄청나게 좋게 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.008,
                "end": 24.444
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 바요 한방 덱으로 활용 가치는 엄청나게 좋다",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.454,
                "end": 28.751
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 마치도록 하겠습니다.",
