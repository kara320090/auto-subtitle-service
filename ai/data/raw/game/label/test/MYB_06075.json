                ],
                "start": 10.919,
                "end": 19.283
            },
            {
                "speaker_id": "1",
                "transcription": "근데 보니까 70렙 찍은 게 많이 없네요 별사탕이 많이 없구나.",
                "sound_type": [
                    2,
