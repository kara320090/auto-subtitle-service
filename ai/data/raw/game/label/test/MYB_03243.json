    },
    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "목소리도 살짝 변형됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.525
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 굳이 신경 안 써도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.535,
                "end": 3.709
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이 은포크는 여러분들 필수입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.719,
                "end": 6.710
            },
            {
                "speaker_id": "1",
                "transcription": "이거 지금 대천사에서 필수이기 때문에 길드 보물 뽑기에서 반드시 키워 주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.727,
                "end": 12.090
            },
            {
                "speaker_id": "1",
                "transcription": "가끔가다 많이 쓰는 게 뭐 만렙까지 찍어 줘야 되는 게 이제 낫, 시계, 뿔은 어느 정도 스펙이 성장되면은 거의 안 쓰기는 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.220,
                "end": 20.543
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 뭐 초반에 어느 정도 활용하면 좋긴 하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.553,
                "end": 24.144
            },
            {
                "speaker_id": "1",
                "transcription": "곰사탕이나 부적이나 뭐 딱총이나 이런 거는 뭐 토벌이나 특정 수호 성전 스테이지에서 쓰이니까 키워 주실 수 있으면 다 만렙을 찍어 주시고 모노클 보물은 갓 보물이기 때문에 여러분들 필수로 키워 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.154,
                "end": 38.850
            },
            {
                "speaker_id": "1",
                "transcription": "대망의 쿠키 추천 이거를 위해서 여태까지 다 밑의 설명을 드린 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.856,
                "end": 44.070
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 랭킹을 보게 되면은 가장 많이 보이는 게 딱 2개가 보이죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.210,
                "end": 49.916
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리랑 휘낭시에가 압도적으로 그냥 아레나를 휩쓸고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.926,
                "end": 56.018
            },
            {
                "speaker_id": "1",
                "transcription": "탱크 조금만 먼저 설명할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.028,
                "end": 57.544
            },
            {
                "speaker_id": "1",
                "transcription": "2개를 묶어서 쓰는 게 현재 가장 베스트입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.554,
                "end": 60.863
            },
            {
                "speaker_id": "1",
                "transcription": "약간 지금 여기서 변형돼서 지금 많이 쓰는 덱 중에 또 하나가 자 현재 많이 쓰는 게 휘낭시에 대신에 와일드베리 이게 정말 좋게 쓰고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.873,
                "end": 70.378
            },
            {
                "speaker_id": "1",
                "transcription": "또 하나 끔찍하게 요렇게도 쓰여요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.388,
                "end": 73.193
            },
            {
                "speaker_id": "1",
                "transcription": "3탱 덱으로도 여러분들이 쓸 수 있다는 점 어 이렇게 지금 많이 쓰는 유형을 제가 말씀드린 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.203,
                "end": 79.275
            },
            {
                "speaker_id": "1",
                "transcription": "여기 잘해도 밀키웨이를 써서 쓰기도 하고 원탱은 안 쓰나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.285,
                "end": 83.872
            },
            {
                "speaker_id": "1",
                "transcription": "원탱은 아까 지금 말씀드린 애들 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.882,
                "end": 85.712
            },
            {
                "speaker_id": "1",
                "transcription": "걔네들이 각각 하나씩 다 따로따로 쓰는 덱도 다 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.722,
                "end": 88.978
            },
            {
                "speaker_id": "1",
                "transcription": "자구마, 찰스 아직도 마스터나 그 크리스탈 부분에서는 아직도 먹히긴 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.988,
                "end": 95.362
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프 쓰는 덱도 아직도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.372,
                "end": 97.191
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프도 좋고 이렇게 앞에 배치해서 써도 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 97.201,
                "end": 100.232
            },
            {
                "speaker_id": "1",
                "transcription": "중앙 쪽으로 오게 되면 이제 딜러 쪽인데 여기에 필수로 들어가야 되는 쿠키 하나를 선택해 주세요 하면은 달빛 술사가 베스트입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 100.242,
                "end": 108.600
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 거의 고정으로 있는 상태이긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 108.710,
                "end": 111.383
            },
            {
                "speaker_id": "1",
                "transcription": "상위권 기준으로는 여기 소르베도 들어오고 블랙펄도 들어올 수 있고 중요한 건 이건 상위권 얘기고 복귀 유저분들 위한 팁을 드리면은 마스터 4, 5 그다음에 크리스탈 부분에는 아직도 바다 요정 쓰는 분도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 111.390,
                "end": 125.464
            },
            {
                "speaker_id": "1",
                "transcription": "그 서리여왕 같은 경우에도 상향 패치가 됐기 때문에 복귀 유저분들이 이전에 알고 있던 그 서리여왕이랑 조금 달라졌거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 125.474,
                "end": 132.746
            },
            {
                "speaker_id": "1",
                "transcription": "나는 달빛 수사도 못 뽑았습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 132.756,
                "end": 134.826
            },
            {
                "speaker_id": "1",
                "transcription": "소르베가 있는 분들은 소르베랑 서리여왕이랑 같이 쓰면 현재 엄청 시너지 좋게 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 134.836,
                "end": 139.558
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 에클레어 당연히 아직도 마스터나 크리스탈 부분에서는 종종 잘 잘 보입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 139.568,
                "end": 145.563
            },
            {
                "speaker_id": "1",
                "transcription": "벰파덱 같은 경우에는 특정 저격덱으로 조금 쓰이고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 145.573,
                "end": 149.270
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파도 뭐 쓸 수도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 149.282,
                "end": 151.310
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳상어 같은 경우에는 소환 덱으로 잘 쓰여요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 151.310,
                "end": 154.152
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 이 가운데 또 에스프레소 마법 사탕 강화 잘 된 분 들 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 154.160,
                "end": 159.257
            },
            {
                "speaker_id": "1",
                "transcription": "광역딜러 위주로 많이 쓰입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 159.267,
                "end": 161.074
            },
            {
                "speaker_id": "1",
                "transcription": "특정 분들은 오징어먹물 지금 아레나에서 활용을 잘하고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 161.084,
                "end": 164.487
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 톱을 키우는 겸 키워놨던 오징어먹물도 활용성 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 164.497,
                "end": 169.260
            },
            {
                "speaker_id": "1",
                "transcription": "네 마지막 힐러 말씀을 드리면은 BTS 쿠키랑 지금 퓨어바닐라 중에 누가 좋나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 169.270,
                "end": 174.400
            },
            {
                "speaker_id": "1",
                "transcription": "이 질문이 가장 많거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 174.400,
                "end": 175.864
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 퓨어바닐가 더 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 175.870,
                "end": 177.208
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 왜 BTS가 왜 쓰이냐 아레나에서는 특별 제한이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 177.218,
                "end": 181.863
            },
            {
                "speaker_id": "1",
                "transcription": "여기다 달빛 술사랑 블랙펄을 쓰는 경우에 이미 3마리가 끝났죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 181.873,
                "end": 186.281
            },
            {
                "speaker_id": "1",
                "transcription": "그런 경우에만 비티에스를 쓰는 경우가 생깁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 186.291,
                "end": 189.685
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키도 성능이 좋기는 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 189.695,
                "end": 192.040
            },
            {
                "speaker_id": "1",
                "transcription": "아직까지도 푸어바닐라 다음으로 또 좋은 쿠키예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 192.040,
                "end": 195.241
            },
            {
                "speaker_id": "1",
                "transcription": "웬만해서는 퓨어바닐라 쓰면 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 195.250,
                "end": 197.906
            },
            {
                "speaker_id": "1",
                "transcription": "정 없으면은 크림유니콘이라도 써 주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 197.916,
                "end": 201.207
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 외에 여러분들이 가장 좋은 덱을 원하거나 유행을 타고 있는 덱 같은 경우에는 제가 유튜브에 관련된 걸 울리고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 201.217,
                "end": 209.579
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 여러분이 다른 유튜브 채널 가서 그거 보고 따라서 키우시면 되고 제가 지금 아레나에서 추천하는 쿠키들은 당장에 뽑기 힘들어서 어쩔 수 없이 대체로 쓰는 경우에 어떤 쿠키를 써야 되는지 그거를 추천드린 거니까 그다음에 이제 보물 쪽으로 오면은 네 보물 무공비랑 시계는 거의 하나의 세트로 거의 답정너로 고정으로 써주시면 되고 이 나머지는 지금 되게 다양해 쓰입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 209.589,
                "end": 234.883
            },
            {
                "speaker_id": "1",
                "transcription": "깃털도 쓰이는 덱 그다음에 모노클 쓰는 덱 그다음에 호루라기 쓰는 덱 당연히 소환 덱 같은 경우에는 핀쿠션을 여기다 넣어서 이렇게 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 234.893,
                "end": 245.630
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 설명을 쭉 드렸는데 추가적으로 궁금한 거 있으면은 댓글에 달아 주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 245.640,
                "end": 261.291
            }
        ]
    },
    "summary": "현재 랭킹은 홀리베리랑 휘낭시에가 압도적으로 아레나를 휩쓸고 있는데 탱크는 홀리베리랑 휘낭시를 묶어서 쓰는게 가장 베스트이고 여기서 변형돼서 지금 많이 쓰는 덱 중 또 하나는 현재 많이 쓰는 게 휘낭시에 대신에 와일드베리고 3탱 덱으로도 쓸 수 있고 힐러의 경우는 BTS 쿠키랑 퓨어바닐라 중에는 퓨어바닐라가 좋기 때문에 웬만해서는 퓨어바닐라를 쓰면 된다.",
