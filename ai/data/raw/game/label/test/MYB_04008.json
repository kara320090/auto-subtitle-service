        "term": [
            {
                "speaker_id": "1",
                "transcription": "최근들어 생명 에너지가 바다 너머로 향하고 있단 건 느껴져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.380
            },
            {
                "speaker_id": "2",
                "transcription": "바다 너머라면 어느 방향인가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.390,
                "end": 8.931
            },
            {
                "speaker_id": "1",
                "transcription": "어썸브레드 대륙의 북동쪽 어디인가 하지만 그 종착지는 저도 알 수가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.941,
                "end": 17.592
            },
            {
                "speaker_id": "1",
                "transcription": "분명한 건 저의 손이 닿지 않는 곳이라는 것 뿐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.602,
                "end": 21.779
            },
            {
                "speaker_id": "2",
                "transcription": "생명 에너지가 어딘가로 모이고 있다는 서리여왕 쿠키님의 짐작을 맞았군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.789,
                "end": 28.427
            },
            {
                "speaker_id": "2",
                "transcription": "목적지라도 알면 가볼 수 있을 텐데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.437,
                "end": 32.013
            },
            {
                "speaker_id": "1",
                "transcription": "많은 도움을 주지 못해 미안해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.023,
                "end": 35.327
            },
            {
                "speaker_id": "1",
                "transcription": "신성한 고목이라면 당신에게 도움이 될 지도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.337,
                "end": 40.907
            }
        ]
    },
    "summary": "바다 요정 쿠키가 어썸브레드 대륙의 어디인가로 생명 에너지가 모이고 있다고 말하고 신성한 고목 나무라면 더 많은 도움을 줄 것이라고 말한다.",
