        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "터 볼게요 연구소 자 잘 찍으셨고요 이게 문제네요 일단 1번째 문제 대장간 이거 만렙 찍으셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.056
            },
            {
                "speaker_id": "1",
                "transcription": "요거 최대한 신경 써서 먼저 찍어주시고요 생산 가속도 한 4까지는 찍어주시면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.066,
                "end": 12.914
            },
            {
                "speaker_id": "1",
                "transcription": "재료 생산 가속 더 찍어주시고 우유 만렙까지 다 찍어주시고 재료 생산 가속 이것도 좀 더 찍어주시고 자 무엇보다 연구 가속을 제일 먼저 찍으세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.924,
                "end": 21.547
            },
            {
                "speaker_id": "1",
                "transcription": "얘 연구 가속을 좀 많이 찍어주시고 나머지 대장간이랑 같이 번갈아가면서 일단 집중적으로 찍어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.547,
                "end": 27.546
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 연구소 레벨업해서 뒤에 연구 가속 있잖아요 요런거 중요니까 저거 먼저 찍어주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.556,
                "end": 33.675
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 해주시고 쿠키 연구 같은 경우에는 일단 왕국 연구 먼저 하세요 지금은 할 때가 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.675,
                "end": 39.635
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 2레벨까지 다 찍으셨는데 싹 다 3레벨 찍고 4레벨 찍고 5레벨 찍고 하시고 나서 나중에 집중적으로 신경 써야 될 거는 공격력 그다음에 체력 그다음에 방어력 이 순서대로 집중해서 찍어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.635,
                "end": 52.180
            },
            {
                "speaker_id": "1",
                "transcription": "예 좀 더 신경 써야 될 유형은 마법, 지원, 폭발, 침투 얘네 먼저 저는 공격력은 신경 써줘야 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.180,
                "end": 59.590
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 분은 좀 마인드가 다른 분들이랑 다른 마인드를 가지고 계신데 별사탕에 대해서 조금 너무 중요성을 모르시는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.590,
                "end": 69.347
            },
            {
                "speaker_id": "1",
                "transcription": "계정 주인분 이거 쿠키 레벨 1레벨당 승급 하나 차이가 나거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.357,
                "end": 73.697
            },
            {
                "speaker_id": "1",
                "transcription": "60레벨로 쭉 냅두면 남들보다 승급 1단계정도 그냥 손해를 계속 보고 있는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.707,
                "end": 78.860
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 최대한 70렙을 다 찍어주시면 되고 지금 걱정하시는 게 그거잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.860,
                "end": 83.664
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 키워봤자 70렙 찍어봤자 나중에 나락가면은 어떡하냐 근데 그럴 경우에는 제 쿠키 티어 영상 그거 보시고 0티어에 가까운 쿠키들은 웬만해서는 나락을 빨리 안 가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.674,
                "end": 94.675
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 대표적으로 제가 집어드리면은 블랙펄 쿠키, 에스프레소뭐 에끌레어 토벌 관련된 쿠키들 요런 애들도 나락을 가기 힘들 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.685,
                "end": 103.695
            },
            {
                "speaker_id": "1",
                "transcription": "아직 한창 많이 쓰일 거라 오징어먹물 그다음에 뭐 아포가토도 토벌용에서도 쓰이고 캡틴케비어 같은 애들 제가 말한 애들은 70렙까지 다 찍으세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 103.705,
                "end": 113.443
            },
            {
                "speaker_id": "1",
                "transcription": "손해가 나는 게 아니기 때문에 쩨 목화맛 쿠키, 와일드베리도 찍어주고 뱀파도 꼭 찍어주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.453,
                "end": 119.600
            },
            {
                "speaker_id": "1",
                "transcription": "이 쿠키들의 레벨이 69레벨이랑 70렙이랑 차이가 나는 게 단순히 이 레벨을 이렇게 올렸을 때 수치가 올라가는 게 끝이 아니라 이 스킬 레벨이 올라가는 것도 크거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 119.610,
                "end": 130.392
            },
            {
                "speaker_id": "1",
                "transcription": "이걸로 인해서 딜 차이가 많이 나기 때문에 스킬 레벨 올리기 위해서 저거 투자를 꼭 해주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 130.402,
                "end": 137.387
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 레벨은 10레벨까지 다 올리셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 137.385,
                "end": 141.700
            }
        ]
    },
    "summary": "대장간 만렙 찍으셔야 되고 왕국 연구 먼저 하시고 쿠키 1레벨당 1승급 차이가 나고 스킬 차이도 있으며 0티어 가까운 쿠키들은 나락을 빨리 안 가기 때문에 블랙펄 쿠키, 에스프레소뭐 에끌레어, 오징어먹물, 아포가토 토벌 관련된 쿠키들은 70레벨을 찍어줘야 한다.",
