            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아무래도 용 토벌 관련된 쿠키들은 이미 하나씩 전부다 교체가 됐고 자 다음 타깃이 감초 토벌 관련된 쿠키가 되지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.236
            },
            {
                "speaker_id": "1",
                "transcription": "조심스럽게 생각도 들고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.246,
                "end": 11.255
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 무엇보다 제가 오늘 영상을 준비한 이유가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.265,
                "end": 15.462
            },
            {
                "speaker_id": "1",
                "transcription": "다음 업데이트 때는 분명히 마법 사탕 쿠키가 같이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.472,
                "end": 20.055
            },
            {
                "speaker_id": "1",
                "transcription": "그게 바로 셔벗 상어 쿠키가 될 가능성이 거의 99.9퍼센트고 여러분들이 셔벗 상어 마탕을 하기 위해서 준비해야 될 것은 자 일반적으로 이 마법 사탕 재료를 만들 때 마법 공방에서 이렇게 재료를 만들 수가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.085,
                "end": 35.520
            },
            {
                "speaker_id": "1",
                "transcription": "이 재료들은 이런 기본 재료들 가지고 제작되는 경우가 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.530,
                "end": 40.595
            },
            {
                "speaker_id": "1",
                "transcription": "아직 일주일의 시간이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.605,
                "end": 42.637
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트가 9월 8일이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.647,
                "end": 44.996
            },
            {
                "speaker_id": "1",
                "transcription": "미리 어떤 재료가 될지는 모르지만 기타 다양한 재료들 미리 모아두시는 게 중요하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.006,
                "end": 52.477
            },
            {
                "speaker_id": "1",
                "transcription": "자 뿐만 아니라 다음 업데이트는 제 생각에는 이 증명의 전장 10단계도 이제 더 이상으로 오픈될 가능성이 크기 때문에 가급적이면 10단계까지 공략을 보고 최대한 뚫어 놓는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.487,
                "end": 65.931
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 질문이 가장 많았던 이 얼파탑 도대체 어떻게 여나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.941,
                "end": 69.856
            },
            {
                "speaker_id": "1",
                "transcription": "매일매일 광고 보면서 깃펜 다 추가로 얻으시고 여기에 스토리 진행을 전부다 끝내시면 얼파탑을 갈 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.866,
                "end": 78.108
            },
            {
                "speaker_id": "1",
                "transcription": "자 얼파탑 보상 정말 좋거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.118,
                "end": 80.552
            },
            {
                "speaker_id": "1",
                "transcription": "이거 전부다 얻으셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.562,
                "end": 83.266
            },
            {
                "speaker_id": "1",
                "transcription": "자 화면에 보는 것처럼 얼파탑 관련된 영상도 올려놨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.276,
                "end": 87.125
            },
            {
                "speaker_id": "1",
                "transcription": "보상을 확인해 보시고 반드시 1층부터 100층 전부다 보상 다 얻으시면 여기서 무지개 큐브 수금 자 증명의 전장에서 얻을 수 있는 잼 스톤 재료도 얻을 수가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.135,
                "end": 98.486
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저기서 꼭 얻어주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.496,
                "end": 101.500
            }
        ]
    },
    "summary": "다음 업데이트 때는 마법 사탕 쿠키가 분명히 나오는데 마법 사탕은 기본 재료를 가지고 제작되는 경우가 많기 때문에 업데이트 전까지 기본 재료를 많이 모아두어야 하며 얼파탑의 경우 보상이 정말 좋기 때문에 그 보상을 전부 얻어야 한다.",
