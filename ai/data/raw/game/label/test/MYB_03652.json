                ],
                "start": 0.000,
                "end": 1.869
            },
            {
                "speaker_id": "1",
                "transcription": "쟤도 상향 받으면서 뭔가 떡상하면은 쓸 일이 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.879,
                "end": 7.711
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 그거 아세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.721,
                "end": 8.683
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤도 오븐브레이크처럼 신규 스킨이 나오면은 그 쿠키는 상향될 가능성이 상당히 큽니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.693,
                "end": 15.372
            },
            {
                "speaker_id": "1",
                "transcription": "오븐브레이크가 항상 그런 식으로 태도를 취해왔거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.382,
                "end": 18.666
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 가볍게 스킨이 하나 나온다고 해서 그 쿠키가 쓰이지도 않는데 스킨만 딸랑 나오지 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.676,
                "end": 26.760
            }
        ]
    },
    "summary": "화자가 쿠키런 킹덤도 오븐브레이크처럼 신규 스킨이 나오면 쓰이지도 않는데 스킨만 딸랑 나오는 게 아니라 그 쿠키는 상향될 가능성이 있다고 한다.",
