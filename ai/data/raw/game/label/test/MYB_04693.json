        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 아레나에서 최신 조합을 기준으로 쿠키 티어를 만들었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.290
            },
            {
                "speaker_id": "1",
                "transcription": "찰스와 BTS 쿠키의 등장으로 인해 기존의 아레나 조합이 크게 변했고 몇몇 쿠키들의 티어가 변했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.300,
                "end": 10.657
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트 전 대유행했던 증표 보물덱의 인기는 식고 다시 깃털 보물덱의 시대가 찾아왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.667,
                "end": 16.044
            },
            {
                "speaker_id": "1",
                "transcription": "현재 유행하는 아레나 핵심 조합을 기준으로 0티어부터 6티어까지 세분화하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.054,
                "end": 21.069
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 전체적인 티어 변화를 업데이트 전과 후로 비교해보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.079,
                "end": 25.154
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트 전에는 증표 보물을 사용하는 핵심 조합들을 기준으로 쿠키 티어가 나왔지만 업데이트 후에는 찰스와 BTS 쿠키로 인해 증표 보물덱 유행이 끝나고 새로운 깃털 보물덱과 소환덱이 부활했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.164,
                "end": 37.200
            },
            {
                "speaker_id": "1",
                "transcription": "그로 인해 오이스터, 목화, 펌킨파이, 샤벳상어, 코코아맛 쿠키의 티어가 올랐고 우유맛 쿠키, 와일드베리, 흑당, 뱀파이어맛 쿠키의 티어가 떨어졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.210,
                "end": 46.373
            },
            {
                "speaker_id": "1",
                "transcription": "물론 티어가 떨어진 쿠키들은 아직도 유용하게 사용되는 쿠키지만 유행과는 살짝 떨어진 상태입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.383,
                "end": 52.175
            },
            {
                "speaker_id": "1",
                "transcription": "또한 특정 조합 저격덱으로 사용되던 바다요정, 호밀, 크런치초코칩, 오징어먹물, 다크카카오의 티어는 떨어졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.185,
                "end": 59.805
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키가 워낙 좋기 때문에 같은 힐러인 검블다이버맛 쿠키의 가치도 더 떨어지게 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.815,
                "end": 65.114
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱에 쓰이던 용감한 쿠키는 이제 찰스가 그 자리를 대체했기 때문에 아레나에서 6티어까지 가장 많이 떨어졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.124,
                "end": 72.186
            },
            {
                "speaker_id": "1",
                "transcription": "변동된 쿠키들 티어를 포함하여 전체적인 쿠키 티어 정리를 지금부터 시작하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.196,
                "end": 77.048
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.058,
                "end": 81.348
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.358,
                "end": 84.618
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.628,
                "end": 89.300
            }
        ]
    },
    "summary": "남성이 게임 캐릭터의 티어를 알려주고 모바일 게임을 PC로 즐길 수 있는 앱을 광고하고 있다.",
