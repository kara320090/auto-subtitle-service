        "term": [
            {
                "speaker_id": "1",
                "transcription": "마카롱이 앞으로 나가면서 전방 장애물 파괴해 주고 이런 느낌인데 아마 얘도 마법형으로 나오기 때문에 어떤 소환덱의 느낌이 날지 뭐 그냥 떼거지로 가서 공격하고 데미지를 주고 끝나는지는 정확히 저도 알 수 가 없는 상태같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 18.367
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이거에 대해서도 제가 말할게 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.377,
                "end": 21.150
            },
            {
                "speaker_id": "1",
                "transcription": "지금 화면에 보이는 저 사슴 같은 얘가 뛰어다니는 거 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.160,
                "end": 25.168
            },
            {
                "speaker_id": "1",
                "transcription": "네 쟤가 저번에 나온 신규 레전드 보물인데 시청자분들이 제보해 주신 저 얘기가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.178,
                "end": 31.569
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 거냐면은 킹덤에 이번에 데코 파는 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.579,
                "end": 35.440
            },
            {
                "speaker_id": "1",
                "transcription": "22000원 짜리 데코 파는 걸 이걸 구입해 보면은 노움이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.450,
                "end": 39.766
            }
        ]
    },
    "summary": "화자가 마카롱이 전방 장애물 파괴해 주는데 마법형으로 나오기 때문에 소환덱이나 공격하고 데미지를 주고 끝날지는 정확히 알 수 없다고 이야기하고 있다.",
