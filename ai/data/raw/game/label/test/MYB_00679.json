    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "버티기만 하면은 이기는 구도로 가는 경우가 대부분입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.122
            },
            {
                "speaker_id": "1",
                "transcription": "완벽한 승리로 가져가죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.132,
                "end": 7.913
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 퓨어바닐라도 확실히 좋게 사용 가능하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.923,
                "end": 12.373
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 영상은 샤이닝글리터 퓨어바닐라 아니면 또 파르페 조합 영상 하나의 공덱으로써 해파리 조합 방덱 파훼법을 알아봤는데 분명히 이러한 분도 있을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.383,
                "end": 24.753
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 대체 있나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.763,
                "end": 26.252
            },
            {
                "speaker_id": "1",
                "transcription": "코랄 대체 있나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.262,
                "end": 27.605
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 코랄이 만약에 없으면은 뭐 홀리베리로 가능하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.615,
                "end": 31.554
            },
            {
                "speaker_id": "1",
                "transcription": "물론 승률은 더 낮아질 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.564,
                "end": 33.338
            },
            {
                "speaker_id": "1",
                "transcription": "코랄이 뒤에 방어하는 게 더 강력하기 때문에 블랙펄 대체는 제가 볼 때는 많이 힘듭니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.348,
                "end": 39.729
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정을 넣는 것도 사실상 의미가 크게 있지는 않을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.739,
                "end": 44.583
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저는 블랙펄잼스톤 키우는 거 무조건 추천드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.593,
                "end": 47.680
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤은 바다요정은 20강 이상, 3초월 이상 되야지만 바다요정은 좀 더 효율적으로 여러분들이 생각하는 강력하게 쓸 수 있기 때문에 그전까지는 블랙펄을 위주로 키워주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.690,
                "end": 59.230
            },
            {
                "speaker_id": "1",
                "transcription": "샤이닝글리터 대신에 뭐 다른 거 대체가 되나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.240,
                "end": 62.283
            },
            {
                "speaker_id": "1",
                "transcription": "샤이닝 글리터를 쓰는 이유 자체가 아군한테 치명타 피해 감소랑 체력 보호막을 주거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.293,
                "end": 69.245
            },
            {
                "speaker_id": "1",
                "transcription": "이것 때문에 극딜을 버틴다는 개념으로 좀 쓰고 상대방한테 공격을 들어가서 딜러를 죽이는 거라 해파리 파훼법으로 그냥 쓰는 거라 대체가 좀 힘들 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.255,
                "end": 78.913
            },
            {
                "speaker_id": "1",
                "transcription": "자 혹시나 궁금한 점이 있다면 댓글에 남겨주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.923,
                "end": 82.775
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 조합 같은 경우에는 이전에 뭐 @이름1님 스페셜 길드의 @이름2이 이미 만들어서 파훼법으로 사용하던 조합인데 여러분들이 맞는 조합을 따로 세팅해서 사용하시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.785,
                "end": 95.438
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 조합은 이렇게 각각 나눠져 있으니까 쿠키와 조합 세팅해서 사용해 보시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.448,
                "end": 117.356
            }
        ]
    },
    "summary": "남성이 코랄이 없으면 홀리베리로 대체 가능하고 블랙펄잼스톤은 무조건 키우는 것을 추천하고 샤이닝글리터는 대체가 힘들다고 한다.",
