        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이겨 버렸습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.387
            },
            {
                "speaker_id": "1",
                "transcription": "마탕 쿠키 5마리 힐러 없이 상대 쿠키를 조합을 압도하는 그림 스펙이 높아서 이긴 걸 수도 있지만 상당히 강력하게 늘어났다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.397,
                "end": 13.839
            },
            {
                "speaker_id": "1",
                "transcription": "자 다른 분도 한번 가 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.849,
                "end": 15.471
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 되어 있는 분들 아마 저격으로 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.481,
                "end": 17.878
            },
            {
                "speaker_id": "1",
                "transcription": "호밀이 시작하자마자 에스프레소를 죽이고 시작할 가능성이 크기 때문에 딜찍누 조합이라고 봐도 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.888,
                "end": 24.647
            },
            {
                "speaker_id": "1",
                "transcription": "호밀하고 에스프레소가 어마무시헌 딜로 그냥 찍어 누른다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.657,
                "end": 31.118
            },
            {
                "speaker_id": "1",
                "transcription": "야 호밀 안 아 에스프레소가 안 죽었는데 야 화상 딥 아",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.128,
                "end": 40.000
            }
        ]
    },
    "summary": "마탕 쿠키 5마리가 힐러 없이 상대 쿠키 조합을 압도했고 화자가 다른 조합을 선택해 호밀이 에스프레소를 죽이는 딜찍누 조합으로 싸움을 한다.",
