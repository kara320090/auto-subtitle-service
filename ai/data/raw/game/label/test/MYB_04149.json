                    2,
                    3
                ],
                "start": 2.363,
                "end": 4.127
            },
            {
                "speaker_id": "1",
                "transcription": "1대 1 최장자는 그럼 뱀파인가 여러분들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.137,
                "end": 6.851
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파 이길만한 얘가 있나?",
