                ],
                "start": 6.861,
                "end": 8.561
            },
            {
                "speaker_id": "1",
                "transcription": "와 와 이거 뱀파가 뱀파가 1대 1은 최강이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.571,
                "end": 28.320
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 종결 1대 1은 뱀파가 최강이다.",
