        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 레벨 15렙입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.631
            },
            {
                "speaker_id": "1",
                "transcription": "업그레이드란 업그레이드는 다 끝판왕까지 다 되어 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.641,
                "end": 5.221
            },
            {
                "speaker_id": "1",
                "transcription": "네 재고 같은 경우에도 뭐 나무 젤리비 각설탕 비스킷 생선도 열심히 그 보면은 지금 우유랑 솜사탕이 없는데 이거 생산 진짜 열심히 하면은 항상 부족합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.231,
                "end": 19.314
            },
            {
                "speaker_id": "1",
                "transcription": "역시 대무역 이벤트를 준비하는 거도 있지만 재고 상태가 상당히 그냥 모범생이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.324,
                "end": 25.809
            },
            {
                "speaker_id": "1",
                "transcription": "완벽합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.819,
                "end": 27.076
            },
            {
                "speaker_id": "1",
                "transcription": "테크는 싹 다 뚫려져 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.086,
                "end": 29.860
            },
            {
                "speaker_id": "1",
                "transcription": "원래 이 정도 돼 있으면은 자 게임할 때 여러분 스트레스가 없을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.870,
                "end": 35.350
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 운영에서는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.360,
                "end": 36.644
            },
            {
                "speaker_id": "1",
                "transcription": "열차 안 막히지 그다음에 뭐 대무역이나 길드무역 이벤트 때도 상위 퍼센트 안에 다 들어갈 수 있을 정도고 그 모든 콘텐츠에서 다 최상위 보상을 다 받으시는 분이라 재화 쌓는 것도 상당히 어 편하게 좀 쌓을 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.654,
                "end": 52.761
            },
            {
                "speaker_id": "1",
                "transcription": "그 토핑 좀 구경 좀 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.771,
                "end": 54.980
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들도 궁금한 게 토핑이잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.990,
                "end": 56.555
            },
            {
                "speaker_id": "1",
                "transcription": "야 일단 시작부터 6퍼센트 야 또 시작부터 6퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.565,
                "end": 61.812
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 쓰지도 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.822,
                "end": 63.525
            },
            {
                "speaker_id": "1",
                "transcription": "6퍼센트 짜리가 있는데 쿠키한테 장착도 안 해주고 남아 도는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.535,
                "end": 67.956
            },
            {
                "speaker_id": "1",
                "transcription": "자 피감 5퍼센트 이상만 즐찾 해 놓은 상태라고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.966,
                "end": 72.443
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 고인물 분들은 피감 5퍼센트 이상이 몇 개가 있냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.453,
                "end": 76.168
            },
            {
                "speaker_id": "1",
                "transcription": "31 32 33 34 35 여 피감 5퍼센트 이상이 181개 실제로 쓰이는 것들은 다 5.9에 가까운 어떤 식으로 토핑을 분류하냐면은 즐겨찾기 4에는 피감 5퍼센트 이상 그리고 즐겨찾기 다섯 번째에는 피쿨이 붙은 거 피해 감소랑 쿨이 붙은 거만 정리해 놨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.178,
                "end": 97.811
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 이렇게 깔끔하게 정리를",
                "sound_type": [
