        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "캠 모습과 실제 모습이 똑같으신가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.514
            },
            {
                "speaker_id": "1",
                "transcription": "제가 전에도 말했잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.524,
                "end": 4.446
            },
            {
                "speaker_id": "1",
                "transcription": "저는 룰렛에서 현대권 뽑아 가지고 그 제가 남학생분 만나서 그냥 밥 사주고 그런 적 있었거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.456,
                "end": 11.631
            },
            {
                "speaker_id": "1",
                "transcription": "딱 보더니 막 놀랐어.",
                "sound_type": [
                    2
                ],
                "start": 11.641,
                "end": 13.464
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 되게 크시네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.474,
                "end": 16.167
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 그 사람이 이제 고백러였거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.177,
                "end": 18.404
            },
            {
                "speaker_id": "1",
                "transcription": "맨날 러너 님 사랑해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.414,
                "end": 19.797
            },
            {
                "speaker_id": "1",
                "transcription": "저랑 뭐 데이트 해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.807,
                "end": 21.016
            },
            {
                "speaker_id": "1",
                "transcription": "막 이렇게 장난으로 그런 식으로 채팅 치는 분인데 실제로 만나서 한마디도 못 해 그런 소리는 만나서 고백 한번 해 보세요 하니까 아 저기 앞에 사람 있어서 이때 한다고 약간 부끄부끄하다고 결국에는 끝까지 한 번도 못 했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.026,
                "end": 36.347
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그분이 이제 원하는 소원이 하나 있다고 해서 러너 님하고 피시방 가서 가서 랜덤 떼탈출 1 대 1 해보고 싶다 그래 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.357,
                "end": 45.833
            }
        ]
    },
    "summary": "화자가 고백러였던 남학생 만나서 밥 사줬던 이야기를 하고 있다.",
