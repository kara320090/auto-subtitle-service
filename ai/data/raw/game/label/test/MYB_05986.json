        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 뱀파 리뷰를 마치겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.016
            },
            {
                "speaker_id": "1",
                "transcription": "일단 총정리를 하자면 자 뱀파이어 맛 쿠키가 정말 좋아졌고 아레나뿐만 아니라 토벌 그냥 완벽하게 활용 가치가 좋고 저는 리뷰할 때 26강이었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.026,
                "end": 14.809
            },
            {
                "speaker_id": "1",
                "transcription": "재료가 부족해서 그런데 여러분들이 질문할 때 뱀파 키워야 되나요, 네 무조건 키워야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.819,
                "end": 20.439
            },
            {
                "speaker_id": "1",
                "transcription": "토벌에서 그냥 넘사로 그냥 0티어고 대체 불가능이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.449,
                "end": 24.306
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 아레나에서도 좋고 또 거기다가 이제 스토리에서도 얘 쓰면은 깨는 그런 부분도 있고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.316,
                "end": 30.603
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 사기적으로 됐네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.613,
                "end": 32.409
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 뱀파 아 요렇게 승급, 초월 2성 마탕 26렙 리뷰 마치도록 하겠습니다.",
                "sound_type": [
