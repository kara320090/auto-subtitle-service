        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이렇게 소르베, 실론나이트 덱 같은 경우에는 깃털을 사용하거나 또는 증표를 사용하기도 하는데 증표를 사용하는 경우에는 소르베가 승급이 3성 이하 대신에 실론나이트는 5 초월인 경우에만 증표를 사용하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 13.265
            },
            {
                "speaker_id": "1",
                "transcription": "그 밖에는 전부 다 네 깃털을 사용해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.275,
                "end": 16.801
            },
            {
                "speaker_id": "1",
                "transcription": "자 기본적으로 요 덱 세팅은 실론나이트는 올 아몬드에다가 쿨 공속 가급적이면 높게 해 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.811,
                "end": 23.227
            },
            {
                "speaker_id": "1",
                "transcription": "네 홀리베리 올 쿨, 락스타도 피의 감소 적당히 20퍼센트 치명타 5퍼센트 쿨은 22.3퍼센트 세트 효과 더해서 해 주시고 소르베는 피감 쿨 높게 가급적이면 세팅해 주시고 파르페도 피감 쿨은 세트 효과와 제외하고 22퍼센트 자 파르페를 했을 경우에는 마법사탕 최소 10감 이상 해 주셔서 쓸 수 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.237,
                "end": 44.689
            },
            {
                "speaker_id": "1",
                "transcription": "네 그게 아니면 스냅 드래곤을 써도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.699,
                "end": 48.369
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베 대신에 이렇게 3힐 덱으로 써도 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.379,
                "end": 52.094
            },
            {
                "speaker_id": "1",
                "transcription": "그때는 증표 보물을 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.104,
                "end": 55.141
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 세팅됐을 때는 홀리베리가 만약에 초월이 높아서 호루라기를 받는다 하시면은 홀리베리 피감을 일부러 낮춰주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.151,
                "end": 64.008
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리가 호루라기를 받지 못한다 승급이 낮아서 그런 분들은 홀리베리의 피감을 가급적이면 높게 세팅을 해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.018,
                "end": 71.973
            },
            {
                "speaker_id": "1",
                "transcription": "자 방덱을 봐도 홀리베리를 활용한 실론나이트의 덱들이 이렇게 많이 사용되는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.983,
                "end": 78.000
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 5번 덱 소개 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.010,
                "end": 80.973
            },
            {
                "speaker_id": "1",
                "transcription": "요새 샤이닝클리터랑 레모네이드 조합이 대유행을 하고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.983,
                "end": 85.282
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 샤이닝클리터랑 레모네이드가 가려져 있어서 네 이렇게 블랙펄, 스타더스트, 달빛술사 3딜덱인지 아니면 이 레모네이드 관련된 조합인지 구분이 잘 안 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.292,
                "end": 97.421
            },
            {
                "speaker_id": "1",
                "transcription": "정말 무지성으로 가도 승률이 좋기 때문에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 97.431,
                "end": 100.400
            }
        ]
    },
    "summary": "한 남성이 방송에서 게임 시 조합하면 좋은 덱을 추천을 해 주는데 4번 덱 같은 경우에는 소르베, 실론나이트, 홀리베리, 락스타, 파르페로 구성하는 걸 추천하며 5번 덱은 요새 샤이닝클리터와 레모네이드 조합이 대유행을 하는데 이걸 활용해서 덱을 구성할 수 있다고 이야기한다.",
