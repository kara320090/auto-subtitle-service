        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤에서 다양한 보상을 폭탄으로 뿌립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.321
            },
            {
                "speaker_id": "1",
                "transcription": "모르고 지나가는 일이 없게끔 여러분들께 알려 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.331,
                "end": 8.223
            },
            {
                "speaker_id": "1",
                "transcription": "자 제일 먼저 추첨을 통해 300분께 BTS 콘서트 티켓 교환권을 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.233,
                "end": 14.163
            },
            {
                "speaker_id": "1",
                "transcription": "이미 이 이벤트 같은 경우에는 300만 명을 돌파했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.173,
                "end": 18.082
            },
            {
                "speaker_id": "1",
                "transcription": "콜라보 사전 예약 개시해 가지고 아직 여러분들 끝나지 않았습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.092,
                "end": 22.232
            },
            {
                "speaker_id": "1",
                "transcription": "나는 사전 등록 안 한 분들은 사전 예약해서 보상을 받으셔야 되는데 전체 보상으로 뿌려지는 우편함 보상이 아니기 때문에 이걸 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.242,
                "end": 31.083
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글 보면은 사전 예약 등록 링크를 제가 걸어 뒀으니까 그거 눌러서 꼭 보상을 받으셔야 되고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.093,
                "end": 38.125
            },
            {
                "speaker_id": "1",
                "transcription": "사전 등록을 한 사람들은 크리스탈 7000개, BTS 뽑기권 20개, 그다음에 각종 데코 같은 경우에 문자로 10월 10일부터 10월 13일 그 사이에 어 문자로 코드로 발송된다고 하니까 참고해 주시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.135,
                "end": 52.393
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 구독 이벤트도 한다고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.403,
                "end": 55.336
            },
            {
                "speaker_id": "1",
                "transcription": "90만 달성시 크리스탈 1000개, 95만은 어 1500개, 그다음에 무큐",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.346,
                "end": 60.594
            },
            {
                "speaker_id": "1",
                "transcription": "100만 달성하면 3000 크리스탈과 무큐 1000개를 준다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.604,
                "end": 65.833
            }
        ]
    },
    "summary": "남자는 쿠키런 킹덤에서 다양한 보상을 폭탄으로 뿌린다며 먼저 추첨을 통해 300분께 BTS 콘서트 티켓 교환권을 드리는데 콜라보 사전 예약을 개시해서 사전 등록 안 한 분들은 사전 예약해서 보상을 받으셔야 되고 사전 등록한 사람들은 크리스탈 7000개, BTS 뽑기권 20개, 각종 데코 같은 경우에 문자로 코드가 발송된다고 하니까 참고하면 좋을 것 같다고 하고 구독 이벤트도 한다고 한다.",
