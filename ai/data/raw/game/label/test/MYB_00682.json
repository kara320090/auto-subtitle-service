                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "공속 덱 교체해서 여기까지 잡아주고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.330
            },
            {
                "speaker_id": "1",
                "transcription": "네 그다음에 바로 네 메인 덱으로 교체해 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.340,
                "end": 6.058
            },
            {
                "speaker_id": "2",
                "transcription": "조심하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.068,
                "end": 7.373
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 아 교체 타이밍도 교체 타이밍인데 이번 수호 성전은 난이도가 있다고 느껴지는 게 원 덱으로 클리어 하면은 쉽지는 않을 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.383,
                "end": 18.730
            },
            {
                "speaker_id": "1",
                "transcription": "물론 클리어할 수는 있겠지만 타수 보호막이랑 아주 까다로운 구간이 몇 군데 있어서 이전보다는 난이도가 살짝 좀 더 높다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.740,
                "end": 28.781
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 보고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.791,
                "end": 30.365
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 덱 2개 뭐 이정도 3개 정도 꾸려서 가면은 시간 단축 크게 할 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.375,
                "end": 36.196
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 귀찮더라도 덱 교체하면서 세팅하는 거는 그렇게 많이 어렵지는 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.206,
                "end": 42.993
            },
            {
                "speaker_id": "1",
                "transcription": "세팅해서 도전해 보시는 게 좋을 거 같다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.003,
                "end": 47.001
            },
            {
                "speaker_id": "1",
                "transcription": "아직도 저는 60 웨이브를 못 깼습니다. 하시는 분들은 이 공략을 보지 마시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.011,
                "end": 52.389
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 최대한 정석 덱을 4번, 5번까지 끝까지 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.399,
                "end": 57.858
            },
            {
                "speaker_id": "1",
                "transcription": "3번 덱처럼 쿠키 두세개만 놓고 하는 그런 세팅이 아니라 최대한 공속 덱 뭐 소환 덱이라도 여러분들이 할 수 있는 최대한의 쿠키 배치를 최대한 해 주시고 진행해 주시면 되고 메인 덱에다가 토핑을 올인하고 나머지 덱에는 메인 덱이 너무 아파서 죽는 구간 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.868,
                "end": 77.747
            },
            {
                "speaker_id": "1",
                "transcription": "그 구간을 대체해서 대신 죽어주고 메인 덱은 최대한 살려서 멀리멀리 가는 게 가장 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.757,
                "end": 86.408
            },
            {
                "speaker_id": "2",
