        "term": [
            {
                "speaker_id": "1",
                "transcription": "에 나 자신 나 자신 사랑해 이게 이런 피지컬해야 하는 부분도 있어서 아 진짜 프로게이머 다 됐네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.795
            },
            {
                "speaker_id": "1",
                "transcription": "그런 부분도 있어서 재밌네요 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.805,
                "end": 10.031
            },
            {
                "speaker_id": "1",
                "transcription": "나 림프절이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.041,
                "end": 11.281
            },
            {
                "speaker_id": "1",
                "transcription": "아 코 막혀 비염인데 아 이제 이쪽으로 나온 거야 붙어 버리렴 이제 이쪽으로 나왔으니까 이리로 올라갈 수 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.291,
                "end": 20.275
            },
            {
                "speaker_id": "1",
                "transcription": "안 돼 그리로 가면 아까 초반이잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.285,
                "end": 27.839
            },
            {
                "speaker_id": "1",
                "transcription": "아까랑 뭐가 달라 이거 왜 못 당기는 거야 대체 이유를 알 수가 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.849,
                "end": 32.007
            },
            {
                "speaker_id": "1",
                "transcription": "아 알 것 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.017,
                "end": 33.194
            },
            {
                "speaker_id": "1",
                "transcription": "알긴 뭘 알아 아 나 알았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.204,
                "end": 42.546
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 어쩔 수 없어 이거는 저쪽으로 들어가야만 해결 보나 봐.",
                "sound_type": [
                    2,
                    3
                ],
