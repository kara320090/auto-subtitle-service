        "term": [
            {
                "speaker_id": "1",
                "transcription": "아. 우와. 이거 재밌겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.214
            },
            {
                "speaker_id": "1",
                "transcription": "위에 또 있네요? 아 피닉스 스킬이야 이건.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.224,
                "end": 6.201
            },
            {
                "speaker_id": "1",
                "transcription": "이거 재밌어 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.211,
                "end": 7.524
            },
            {
                "speaker_id": "1",
                "transcription": "아. 강화하는 건가 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.534,
                "end": 10.196
            },
            {
                "speaker_id": "1",
                "transcription": "길게 눌러서 화염을 두르면 아예 파이어볼이 나가는 거야. 한번 해볼까요? 재밌을 거 같은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.206,
                "end": 18.229
            },
            {
                "speaker_id": "1",
                "transcription": "어 덜렁이 공주님 고마워요. 이따가 같이 봐요. 지금은 이제 유튜브 올릴 거라서. 음.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.239,
                "end": 26.509
            },
            {
                "speaker_id": "1",
                "transcription": "오 이것도 재밌어 보이고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.519,
                "end": 29.233
            }
        ]
    },
