        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 4성 최초 무과금으로 크리스탈 82만 5000개를 모으신 분 뽑기 한 번에 다 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.654
            },
            {
                "speaker_id": "1",
                "transcription": "저희 진짜 처음 봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.664,
                "end": 9.397
            },
            {
                "speaker_id": "1",
                "transcription": "과금러 분들도 많이 뽑아드리고 무과금러 분들도 많이 뽑아드렸지만 82만 개 맡겨주신 분도 거의 드물지만서도 무과금이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.407,
                "end": 17.762
            },
            {
                "speaker_id": "1",
                "transcription": "자 무과금인지 아닌지 제가 좀 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.772,
                "end": 20.674
            },
            {
                "speaker_id": "1",
                "transcription": "요거 유료 재화, 무료 재화 눌러보면은 보면 크리스탈이 무료로 여러분들 82만 5000개가 모였다는 거 볼 수 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.684,
                "end": 29.052
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 패키지 지르거나 그러면은 유료에 크리스탈이 잡힙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.062,
                "end": 32.595
            },
            {
                "speaker_id": "1",
                "transcription": "자 무과금으로 스펙을 키우신 분인데 이거 나쁘진 않네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.605,
                "end": 36.657
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 뭐 열심히 되게 하신 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.667,
                "end": 38.758
            },
            {
                "speaker_id": "1",
                "transcription": "근데 어떻게 무과금인데 5성까지 다 찍으면서 이렇게 올라오셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.768,
                "end": 43.315
            },
            {
                "speaker_id": "1",
                "transcription": "초월까지 있으시네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.325,
                "end": 44.744
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 뭐 없는 쿠키들은 많이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.754,
                "end": 48.117
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 와 소리가 다 나오네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.127,
                "end": 50.619
            },
            {
                "speaker_id": "1",
                "transcription": "와 네 자 이제 뽑기 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.629,
                "end": 53.475
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 뽑기는 공속 해서 요 3개로 가겠습니다.",
