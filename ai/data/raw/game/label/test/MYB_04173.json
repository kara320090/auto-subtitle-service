                ],
                "start": 14.088,
                "end": 17.370
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가장치 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.380,
                "end": 20.573
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
