            },
            {
                "speaker_id": "1",
                "transcription": "특정 분야의 랭커분 계평가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.047,
                "end": 10.813
            },
            {
                "speaker_id": "1",
                "transcription": "자 이분은 어떤 거 때문에 계평을 맡겼냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.823,
                "end": 14.111
            },
            {
                "speaker_id": "1",
                "transcription": "바로 이 재고 중에 엄청나게 비정상적으로 재고를 쌓은 분이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.121,
                "end": 20.046
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 재고를 좀 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.056,
                "end": 22.857
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 나무 평범해요.",
