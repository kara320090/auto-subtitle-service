        "term": [
            {
                "speaker_id": "1",
                "transcription": "최대한 완품으로 좀 뽑고 싶거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.900
            },
            {
                "speaker_id": "1",
                "transcription": "안 나오면은 영혼석으로 사면 되지 않을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.910,
                "end": 6.686
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 해도 모자랄 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.696,
                "end": 9.502
            },
            {
                "speaker_id": "1",
                "transcription": "많이 모자랄 것 같아 와 근데 진짜 안 나오긴 한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.512,
                "end": 16.677
            },
            {
                "speaker_id": "1",
                "transcription": "아미밤 2만 5000개당 랜덤 방탄 쿠키 1개 확정이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.687,
                "end": 20.819
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래요옳",
