        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 바요덱 못 버티고 죽는다 그럴 수도 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.923
            },
            {
                "speaker_id": "1",
                "transcription": "이 바요덱 같은 경우 2 1 2 들어갈 때는 권장은 2 1 2 160만 이하 너무 전투력이 높은 사람들한테는 안 들어가는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.933,
                "end": 14.823
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 너무 전투력이 높은 사람들한테는 바요나 에스프레소가 먼저 터지는 경우가 있거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.833,
                "end": 21.511
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우에는 좀 버틴다는 마인드로 간 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.521,
                "end": 25.949
            },
            {
                "speaker_id": "1",
                "transcription": "지금 엄청 아슬아슬하게 버텼죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.959,
                "end": 27.948
            },
            {
                "speaker_id": "1",
                "transcription": "둘 중에 하나가 버틴다는 마인드로 저는 가서 그나마 하는 거지만.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.958,
                "end": 35.566
            }
        ]
    },
    "summary": "한 남자가 게임에서 2 1 2에는 전투력이 높다면 들어가지 말라고 한다.",
