        "term": [
            {
                "speaker_id": "1",
                "transcription": "요렇게 구도가 잡히게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.152
            },
            {
                "speaker_id": "1",
                "transcription": "딜을 보게 되면은 소르베가 죽어도 뒤에 흐름은 용과가 마무리 하는 구도로 간다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.162,
                "end": 10.454
            },
            {
                "speaker_id": "1",
                "transcription": "소르베는 웬만해서 가려집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.464,
                "end": 12.503
            },
            {
                "speaker_id": "1",
                "transcription": "아까 말씀드린 이유랑 동일하게 소르베는 중요한 역할이 따로 있고 뒤에가 달빛슬사인지 스타더스트인지 또는 락스타인지 그게 요새 주요한 덱들의 흐름이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.513,
                "end": 25.858
            },
            {
                "speaker_id": "1",
                "transcription": "소르베는 거의 뭐 필수로 많이 껴들어가서 사용되고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.868,
                "end": 35.049
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 아 똑같이 두 개가 남았네요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.059,
                "end": 41.554
            },
            {
                "speaker_id": "1",
                "transcription": "요런 경우에는 용과 한방에 따라서 이제 결정되는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.564,
                "end": 48.500
            }
        ]
    },
    "summary": "화자가 소르베는 중요한 역할이 따로 있고 필수로 많이 껴들어가서 사용된다고 말한다.",
