            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 서리여왕 리뷰 이어서 가면 아레나에서 좋은 이 덱.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.625
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 제가 이미 여러분들 영상에 올렸죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.635,
                "end": 7.674
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 사용 자체가 이렇게 세팅해서 쓰면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.684,
                "end": 11.069
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 간단하게만 보여드리면 어느 덱을 가도 승률 100퍼센트예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.079,
                "end": 14.943
            },
            {
                "speaker_id": "1",
                "transcription": "지금 서리여왕 5초월 리뷰라서 뭐 이 덱 자체를 자세하게 보실 분은 유튜브에 세팅이나 이런 거 참고하시면 되고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.953,
                "end": 21.884
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 연계나 이런 게 정말 완벽하기 때문에 승률 자체가 진짜 100퍼센트에 가깝게 나옵니다 미러전을 제외해서는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.894,
                "end": 29.509
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 터트리면서 딜이 많이 들어가기 때문에 어 상위권에서도 상당히 좋게 쓰인다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.519,
                "end": 37.891
            },
            {
                "speaker_id": "1",
                "transcription": "서리여왕이 좋냐고 물어보신 분들.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.901,
                "end": 40.272
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 5초월 리뷰 보면서 전에 키워놨던 분들 이제 다시 키워도 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.282,
                "end": 45.915
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이 덱 세팅 말고 아까 이것저것 해봤을 때 또 좋은 게 얘를 낫으로 해볼까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.915,
                "end": 52.387
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 공속 아니면?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.397,
                "end": 54.164
            },
            {
                "speaker_id": "1",
                "transcription": "낫으로 하면 어떻게 될까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.174,
                "end": 55.465
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 한번 해볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.475,
                "end": 59.133
            }
        ]
    },
    "summary": "서리여왕 좋냐고 물어보신 분들은 이 5초월 리뷰 보면서 이제 다시 키워도 좋을 것 같아요.",
