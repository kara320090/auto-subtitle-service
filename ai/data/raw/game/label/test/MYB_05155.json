    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번에 출시된 블랙펄 제도 미지의 영역을 탐험하는 신규 콘텐츠입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.689
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 사일런트 호를 타고 뭐 영역을 항해하고 미니 게임 있고 뭐 그런 콘텐츠고 비정기적으로 운영되는 콘텐츠고 1회 항해 시 스태미나 젤리를 사용해서 게임을 진행할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.699,
                "end": 17.663
            },
            {
                "speaker_id": "1",
                "transcription": "자 항해하기 눌러보면은 이렇게 배가 출항을 하게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.673,
                "end": 22.684
            },
            {
                "speaker_id": "1",
                "transcription": "위험한 바다에 뛰쳐나온 용기에 박수를 어떤 위험이 도사리고 있을지 모르니 조심하자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.694,
                "end": 27.607
            },
            {
                "speaker_id": "1",
                "transcription": "뒤로 빠꾸가 안 되니까 잘 선택해야 된다고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.617,
                "end": 29.811
            },
            {
                "speaker_id": "1",
                "transcription": "오케이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.821,
                "end": 30.475
            },
            {
                "speaker_id": "1",
                "transcription": "배가 나아갈 수 있는 방향을 정해서 갈 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.485,
                "end": 33.857
            },
            {
                "speaker_id": "1",
                "transcription": "내구도는 줄어든다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.867,
                "end": 36.019
            },
            {
                "speaker_id": "1",
                "transcription": "자 항해 중 얻은 블랙코인으로 배를 수리할 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.029,
                "end": 39.349
            },
            {
                "speaker_id": "1",
                "transcription": "아래 버튼을 누르면 배를 수리할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.359,
                "end": 41.688
            },
            {
                "speaker_id": "1",
                "transcription": "여기 이거 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.698,
                "end": 42.927
            },
            {
                "speaker_id": "1",
                "transcription": "다섯 번 수리할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.937,
                "end": 44.599
            },
            {
                "speaker_id": "1",
                "transcription": "남은 블랙코인은 항해 점수로 바뀌니까 블랙코인은 많으면 많을수록 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.609,
                "end": 49.070
            },
            {
                "speaker_id": "1",
                "transcription": "블랙코인은 이번 항해에서만 유효하고 다음 항해를 시작하게 되면 그전에 하는 코인이 사라진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.080,
                "end": 55.230
            },
            {
                "speaker_id": "1",
                "transcription": "사일런트 호의 내구도가 모두 소모되거나 항해를 멈추고 다시 시작해 보고 싶을 때가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.240,
                "end": 60.589
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때는 이 버튼을 눌러서 빠르게 항해를 종료할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.599,
                "end": 64.211
            },
            {
                "speaker_id": "1",
                "transcription": "요 왼쪽 하단에 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.221,
                "end": 65.381
            },
            {
                "speaker_id": "1",
                "transcription": "자 재단 효과를 보면은 이렇게 버프를 얻을 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.391,
                "end": 68.748
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 오븐 브레이크에 랜덤 떼탈출 버프 얻는 그런 느낌으로 가면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.758,
                "end": 74.643
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 74.653,
                "end": 75.754
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 맵이 크네 생각보다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.764,
                "end": 77.734
            },
            {
                "speaker_id": "1",
                "transcription": "와 여기가 끝판 보스가 있는 데네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.744,
                "end": 79.826
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 저는 위쪽으로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.836,
                "end": 82.197
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야 이거 고래야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.207,
                "end": 83.553
            },
            {
                "speaker_id": "1",
                "transcription": "어 미역 때문에 힘들다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.563,
                "end": 86.333
            }
        ]
    },
    "summary": "남자는 비정기적으로 운영하는 블랙펄 제도 미지의 영역을 탐험하는 신규 콘텐츠를 소개하며 1회 항해 시 스태미나 젤리를 사용해서 게임을 진행할 수가 있다고 한다.",
