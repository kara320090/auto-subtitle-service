        "term": [
            {
                "speaker_id": "1",
                "transcription": "습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 0.553
            },
            {
                "speaker_id": "2",
                "transcription": "반짝이는 거 줄래?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.563,
                "end": 2.121
            },
            {
                "speaker_id": "3",
                "transcription": "와 13억 2800. 와 이게 이렇게 나오네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.131,
                "end": 11.619
            },
            {
                "speaker_id": "3",
                "transcription": "이야 아 자동 켜져 있는 거 알아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.629,
                "end": 14.860
            },
            {
                "speaker_id": "3",
                "transcription": "켜져 있어도 눌러주는 게 더 빠릅니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.860,
                "end": 17.710
            },
            {
                "speaker_id": "3",
                "transcription": "야 이렇게 해도 13억이 넘는 걸 어 실시간으로 찍긴 했네요.",
                "sound_type": [
                    2
                ],
                "start": 17.710,
                "end": 23.080
            },
            {
                "speaker_id": "3",
                "transcription": "예 일단 딜표를 보게 되면 어 이렇게 독버섯, 오먹 나머지도 딜이 이렇게 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.080,
                "end": 28.350
            },
            {
                "speaker_id": "3",
                "transcription": "아 13억은 약간 타이밍이 더 좋고 약간 치명 더 솔직히 약간 그 차이이지 않을까.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.350,
                "end": 33.400
            },
            {
                "speaker_id": "3",
                "transcription": "난 만족해.",
                "sound_type": [
                    2
                ],
                "start": 33.400,
                "end": 34.170
            },
            {
                "speaker_id": "3",
                "transcription": "2등 아 수정님이 1등이고 제가 2등이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.170,
                "end": 37.800
            },
            {
                "speaker_id": "3",
                "transcription": "아 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.800,
                "end": 39.190
            },
            {
                "speaker_id": "3",
                "transcription": "괜찮아요 2등 만족스럽습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.190,
                "end": 41.930
            },
            {
                "speaker_id": "3",
                "transcription": "치명 운발도 아마 있을 거고 타이밍도 아마 아마 좀 약간 세팅은 공속을 좀 많이 줬는데 공속 너무 많이 주는 것도 안 좋은 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.930,
                "end": 49.630
            },
            {
                "speaker_id": "3",
                "transcription": "자 여러분들이 만약에 여기에 만약에 도트딜이 없이 치명타 피해랑 뭐 피해량 10초마다 10퍼센트 증가가 있는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.630,
                "end": 58.933
            }
        ]
    },
    "summary": "13억이 넘는 점수는 실시간으로 찍게 되었고 이 게임은 운발과 타이밍도 있기 때문에 만약에 하게 된다면 세팅에서 공속을 많이 주지 않는 것이 좋다.",
