        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 모든 프로필 모든 칭호를 다 모으신 레전드 유저분 계정 평가갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.405
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 왼쪽에 보시면은 왕국에 번영 20칸 20개 전부 다 채웠고 용감한 쿠키들 18개 중에 18개 전부다 채웠고 모험과 도전도 그랜드 마스터 남들은 따기 어려운 거 다 따 놓으셨고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.415,
                "end": 24.514
            },
            {
                "speaker_id": "1",
                "transcription": "대난투 최후의 정복자 칭호까지 자 무역과 외교도 전부 다 완성 시켜주셨고 그다음에 이벤트 또한 여러분들 모든 이벤트를 전부 다 따신 분입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.524,
                "end": 37.145
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 분이 제가 알기로는 거의 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.155,
                "end": 40.552
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤에 아마 다섯 손가락 안에 들고 저도 이렇게 다 하진 못했었요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.562,
                "end": 45.843
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 모든 프로필 싹 다 다 따셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.853,
                "end": 49.668
            },
            {
                "speaker_id": "1",
                "transcription": "이벤트 칭호뿐만 아니라 이벤트 프로필까지 특히나 여러분들이 잘 못 보신 분도 있겠지만 왕꾸 등수 안에 들면 어 주는 프로필 2022년 왕꾸 프로필 가지고 계십니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.678,
                "end": 62.951
            },
            {
                "speaker_id": "1",
                "transcription": "단 하나도 빠짐없이 전부 다 싹 다 그냥 모르신 분입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.961,
                "end": 67.976
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이분 왕꾸부터 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.986,
                "end": 70.462
            },
            {
                "speaker_id": "1",
                "transcription": "이 프롤필 여러분들 보신 분들 많죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.472,
                "end": 73.703
            },
            {
                "speaker_id": "1",
                "transcription": "왕꾸 대회에 나왔던 그런 꾸고 보라분홍왕국 겨울용 그다음에 미션용 네 그다음에 새로운 왕꾸 전부 다 왕꾸가 그냥 하나하나 다 고퀄리티로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.713,
