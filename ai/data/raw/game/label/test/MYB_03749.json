        "term": [
            {
                "speaker_id": "1",
                "transcription": "175층이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.668
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 보스 자 이런 식으로 확실히 그 뭐 쉽게 그냥 잡히진 않네요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.678,
                "end": 16.364
            },
            {
                "speaker_id": "1",
                "transcription": "조금 더 버텼다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.374,
                "end": 17.837
            },
            {
                "speaker_id": "1",
                "transcription": "물론 쉽게 잡히는 편이긴 하지만 네 좀 더 버티다가 잡히는 그림",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.847,
                "end": 21.985
            },
            {
                "speaker_id": "1",
                "transcription": "자 176 보상 오 스킬 파우더 이건 별로 좋아 보이진 않는데 자 일단 토핑 조각을 받도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.995,
                "end": 31.479
            },
            {
                "speaker_id": "1",
                "transcription": "네 여기서 받고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.489,
                "end": 36.074
            },
            {
                "speaker_id": "1",
                "transcription": "케이크타워 177층 이어서 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.084,
                "end": 40.412
            },
            {
                "speaker_id": "1",
                "transcription": "다 대부분 비슷하게 제한으로 되어 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.422,
                "end": 43.104
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 특정 마법형, 회복형, 침투형 뭐 이런 거 제한 걸려있으니까 피해서 세팅하면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.114,
                "end": 52.018
            }
        ]
    },
    "summary": "한 남성이 게임상에서 보스가 쉽게 잡히는 편이긴 하지만 좀 버티다가 잡혔다고 하며 보상으로 받은 스킬 파우더가 별로 좋아 보이지 않는다고 한다. 177층으로 이어서 가본다고 하며 대부분 제한이 걸려 있으니 피해서 세팅하면 된다고 한다.",
