        "term": [
            {
                "speaker_id": "1",
                "transcription": "에이 시체도 없네 마을 쑥대밭 돼 있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.281
            },
            {
                "speaker_id": "1",
                "transcription": "무사히 돌아왔군 고맙다 여긴 다시 안전해졌어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.291,
                "end": 8.899
            },
            {
                "speaker_id": "1",
                "transcription": "에텔 웅덩이가 사라진 건 아니라서 또 아카시아로 변할거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.909,
                "end": 14.503
            },
            {
                "speaker_id": "1",
                "transcription": "안심 노노 이 마을을 떠나는 게 어때?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.513,
                "end": 19.052
            },
            {
                "speaker_id": "1",
                "transcription": "노노 여기서 대장일을 하는 것이 우리 삶의 보람이니까 마을 사람들도 그렇고.",
                "sound_type": [
