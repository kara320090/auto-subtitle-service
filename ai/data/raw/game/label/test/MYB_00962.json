        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤과 브릭시티 이벤트가 열렸습니다 자 이벤트를 통해서 여러분들이 크리스탈 1000개, 무지개 큐브 1500개, 크리스탈 3000개 그리고 한정판 데코들 그리고 랜드마크 그리고 한정 스킨 등",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 13.395
            },
            {
                "speaker_id": "1",
                "transcription": "자 화면에 보이면 비행기 모양의 랜드마크와 쿠키 하우스 신규 스킨도 볼 수 있고요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.395,
                "end": 18.988
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 꾸미기 상점에 신규 테마도 여러분들 열 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.998,
                "end": 23.399
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키성 스킨도 얻을 수 있고 자 그리고 제가 준비한 2만 5000원 상당의 무지개 큐브 이벤트도 준비했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.409,
                "end": 30.416
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 이벤트는 뒤에서 제가 따로 설명을 드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.426,
                "end": 33.778
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 보상을 받기 위해서는 반드시 데브 플레이 연동을 해주셔야 되고요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.788,
                "end": 38.336
            },
            {
                "speaker_id": "1",
                "transcription": "자 연동을 하려면은 보는 거와 같이 환경 설정에 들어가서 정보를 누르면 데블 플레이 연동이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.346,
                "end": 45.247
            },
            {
                "speaker_id": "1",
                "transcription": "자 이걸 눌러서 반드시 연동을 해주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.247,
                "end": 48.990
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 게임에서 연동을 해주시고 브릭시티도 들어와서 자 이렇게 데브 계정으로 연동을 서로 각각 해주셔야 됩니다.",
