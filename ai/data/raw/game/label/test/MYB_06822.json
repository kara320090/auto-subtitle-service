        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런 거 나오면 장화 신은 고양이 근데 발이 안 보이네요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.671
            },
            {
                "speaker_id": "1",
                "transcription": "장화를 신었는지 이불 속으로 들어가야 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.681,
                "end": 9.338
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 아까 걔인 것 같고 아 재밌네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.348,
                "end": 17.843
            },
            {
                "speaker_id": "1",
                "transcription": "아 나는 왜 맨 처음에 딱 봤을 때 이거 되게 씹덕 같다라고 생각했을까 진짜 솔직히 그냥.",
                "sound_type": [
                    2
                ],
                "start": 17.853,
                "end": 22.906
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 일러스터만 이렇게 봤었을 때도 재밌어 보였는데 사실 제가 이거를 250개 게임에 그",
