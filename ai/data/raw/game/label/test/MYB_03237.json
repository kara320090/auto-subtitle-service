    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "신규 쿠키가 나오면은 현재 만렙까지 한 번에 다 올려도 별사탕이 부족하지 않은 상황이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.290
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 그렇게 되냐면은 쿠키 하우스 개편이 엄청나게 조금 됐기는 했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.380,
                "end": 10.140
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에는 기억나실지 모르겠지만 만렙을 찍어도 6시간마다 생산이 끝나 가지고 막 손실 날까 봐 알람 맞춰가지고 막 이거 받고 막 그런 시절이 있었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.140,
                "end": 19.610
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 지금은 보시다시피 한 번에 받기 시간이 엄청나게 늘어났고 별사탕 수급도 이거 밸런스 패치가 돼서 엄청나게 조금 많이 기존보다 얻을 수가 있게 패치가 됐습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.610,
                "end": 31.057
            },
            {
                "speaker_id": "1",
                "transcription": "그 쿠키 하우스 레벨을 10레벨까지는 반드시 찍어 줘야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.067,
                "end": 34.593
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 1레벨, 2레벨, 3레벨, 4레벨, 5레벨, 6레벨 이렇게 쭉 올리면 별사탕 이 얻는 효율 자체가 계속 늘어나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.603,
                "end": 42.139
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이제 11, 12, 13 ,14, 15는 별사탕 얻는 효율이 살짝씩 조금 떨어지거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.149,
                "end": 46.680
            },
            {
                "speaker_id": "1",
                "transcription": "초반에 올렸던 것보다는 그래서 10레벨까지 빨리 올리는 게 가장 효율이 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.680,
                "end": 51.225
            },
            {
                "speaker_id": "1",
                "transcription": "초보자 입장은 또 다른 게 쿠키 하우스 레벨 초반부터 너무 신경 써서 올리면은 쿠키성 레벨 올리는 데 조금 지장이 가니까 초반 유저분들은 쿠키성 레벨 12렙까지 빨리 올릴 수 있게 쿠키 하우스는 레벨 한 5레벨 정도로 유지하다가 나중에 12렙 됐을 때 레벨 업해 주시면 됩니다 10레벨까지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.230,
                "end": 68.520
            },
            {
                "speaker_id": "1",
                "transcription": "노움 연구소가 오픈 돼서 여러분들이 자 쿠키 연구 쪽으로 보게 되면은 쿠키 관련 업그레이드 유형이 체력 증가 그다음에 방어력 증가 그다음에 공격력 증가 이 3가지 파트가 있는 데 여러분들이 우선순위로 해야 될 거는 공격력 증가를 제일 우선으로 해주고 그다음에 체력 증가를 그다음에 2순위, 3순위는 방어력 증가 얘를 3순위로 해서 집중적으로 이렇게 찍어 주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.540,
                "end": 93.246
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 해서 이렇게 하는 건 절대 비추예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.256,
                "end": 96.036
            },
            {
                "speaker_id": "1",
                "transcription": "아 이번에 달빛 술사가 정말 좋게 나왔으니까 나는 달빛 술사에만 올인할 거야 해서 어 마법형 공격력 증가에만 10강화 방어력만 10 체력도 달빛 술사위해서 10 하나에 몰빵하는 거는 비추입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 96.046,
                "end": 110.208
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 아레나는",
                "sound_type": [
                    2,
                    5
                ],
                "start": 110.218,
                "end": 111.750
            }
        ]
    },
    "summary": "신규 쿠키가 나오면 현재 만렙까지 한 번에 다 올려도 별사탕이 부족하지 않은 상황으로 지금은 보시다시피 한 번에 받기 시간이 엄청나게 늘어났고 별사탕 수급도 밸런스 패치가 돼서 기존보다 많이 얻을 수가 있게 패치가 됐지만 11, 12, 13 ,14, 15레벨은 별사탕 얻는 효율이 살짝씩 조금 떨어지기 때문에 10레벨까지 빨리 올리는 게 가장 효율이 좋다.",
