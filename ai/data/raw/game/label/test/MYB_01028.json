        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 샤이닝글리터와 레모네이드 조합 극딜 조합에 대해서 소개해 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.846
            },
            {
                "speaker_id": "1",
                "transcription": "자 상위권에서 현재 방어 기록을 보게 돼도 많은 분들이 사용되고 있는 조합이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.856,
                "end": 12.062
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 세팅법이 정말 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.072,
                "end": 14.245
            },
            {
                "speaker_id": "1",
                "transcription": "대충 막 세팅하면은 절대 승률이 높게 나오지 않고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.255,
                "end": 17.600
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 방법은 현재 2가지 조합이 대표적으로 많이 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.610,
                "end": 22.708
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 스낵 드래곤을 넣어서 락스타와 스낵 드래곤, 샤이닝글리터, 레모네이드 조합을 이용한 조합",
                "sound_type": [
