        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 무과금으로 55만 개 모은 북극곰님 야 그래도 무과금으로도 55만개가 가능한데 아마 저건 몇 달 동안 모았을 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.543
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 이분 꾸미기 상태 왜 이래 이렇게 야 이거 어떻게 이렇게 잘 꾸미셨냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.553,
                "end": 15.523
            },
            {
                "speaker_id": "1",
                "transcription": "야 무과금으로 이렇게 스펙을 키웠다고 얘는 또 1초월이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.533,
                "end": 19.645
            },
            {
                "speaker_id": "1",
                "transcription": "일단 그러면 얘는 5초월 찍고 그 다음에 고급뽑기로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.655,
                "end": 23.189
            },
            {
                "speaker_id": "1",
                "transcription": "저 55만 개 전부 다 써달라고 하시거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.199,
                "end": 25.544
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 스킨뽑기 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.554,
                "end": 27.200
            },
            {
                "speaker_id": "1",
                "transcription": "야 무과금으로도 무큐를 이렇게 많이 모을 수가 있구나 야 이거 또 두 개야.",
