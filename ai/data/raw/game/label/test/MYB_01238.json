        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 이 일 이 덱 공약을 모르겠다 하시는 분들 얘도 마찬가지입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.349
            },
            {
                "speaker_id": "1",
                "transcription": "네 스타더스트가 네 일찍 죽어서 나머지 애들의 힐을 채워주면은 되는 구조고 이 일 이 구조가 대표적으로 가운데가 소르베가 있는 구조가 가장 많아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.359,
                "end": 17.014
            },
            {
                "speaker_id": "1",
                "transcription": "네 그런 구조도 이 조합으로도 충분히 이길 수가 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.024,
                "end": 20.672
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 레어 무공비급 이번에는 이번 덱으로 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.682,
                "end": 25.536
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 조합 아까 제가 단점이 뭐라 했냐면 상대방도 똑같은 이 조합이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.546,
                "end": 30.799
            },
            {
                "speaker_id": "1",
                "transcription": "저는 무공비고 상대는 레어 무공비기이기 때문에 기술적인 면에서 제가 우위예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.809,
                "end": 36.225
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 상대 딜러나 이런 건 다 먼저 죽일 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.235,
                "end": 39.913
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 문제는 용과 브레스 타이밍이 똑같기 때문에 제가 이거 결과 보지도 않았지만 예측하자면 무승부 날 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.923,
                "end": 47.701
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 용과 브레스 타이밍이 똑같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.711,
                "end": 50.162
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 죽일 수가 없습니다.",
                "sound_type": [
                    2
                ],
                "start": 50.172,
                "end": 51.963
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이번 덱은 지는 경우는 없 거의 잘 안 나지만 어 무승부가 많이 난다는 단점이 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.973,
                "end": 60.021
            },
            {
                "speaker_id": "1",
                "transcription": "이 조합 외에 상대가 저랑 똑같은 조합이 아니면은 무승부 말고 대부분 승리하는 경우가 많으니까 네 방덱으로도 많이 사용할 수가 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.031,
                "end": 74.500
            }
        ]
    },
    "summary": "스타더스트가 일찍 죽어서 나머지 애들 힐을 채워주면 되는 구조이고 대표적으로 소르베가 가운데 있는 구조가 많은데 그런 구조도 이 조합으로 충분히 이길 수 있고 레어 무공비급 이번 덱으로 가보겠는데 이 조합의 단점은 상대방도 똑같은 조합으로 상대 딜러나 이런 건 먼저 죽일 건데 문제는 용과 브레스 타이밍이 똑같아서 결과를 예측하자면 무승부가 날 것이다.",
