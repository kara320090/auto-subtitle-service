    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 잡아내는 그림 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.049
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번엔 좀 더 높은 초월 분한테 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.059,
                "end": 8.124
            },
            {
                "speaker_id": "1",
                "transcription": "3초월 캡사이신 나머지 풀 초월 네 이분한테도 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.134,
                "end": 13.297
            },
            {
                "speaker_id": "1",
                "transcription": "예언자 빙결덱 여러분들도 캡사이신이 나는 있습니다 하신 분들은 이 덱보다 캡사이신 덱을 쓰세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.307,
                "end": 19.007
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제 아직 제가 네 설문 조사나 생방송에서 라이브로 물어보면은 아직도 캡사이신 얻은 분이 많지는 않고 스타더스트 없는 분 달빛술사 없는 분 아직 많거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.017,
                "end": 32.473
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 빙결덱은 어느 정도 세팅 가능한 분들에게는 그래도 너무 절망적으로 아레나 손 놓고 있는 거보다는 빙결덱 세팅해서 아레나 하시는 거 나쁘지 않거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.483,
                "end": 45.208
            },
            {
                "speaker_id": "1",
                "transcription": "지금과 같이 상대방의 딜러를 끊어줄 수만 있다면 그러면은 빙결덱도 확실히 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.218,
                "end": 51.588
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 엄청나게 초월이 높은 분들 그다음에 토핑작 잘 된 분들은 당연히 빙결덱이 들어가기가 힘들어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.598,
                "end": 59.165
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 잘 죽지도 않고 딜도 세기 때문에 그래도 어느 정도 상위권에서도 먹히는 사람한테는 이길 수 있다 고렇게 보면 될 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.175,
                "end": 67.798
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 가장 제가 이번 빙결덱을 소개하는 이유 중에 하나가 다른 게 있는데 그게 뭐냐면 이 깃털덱일 때 빙결덱이 그나마 잘 통할 수 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.808,
                "end": 78.319
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 아마 무공 비급 호루라기 시계일 때는 엄청난 딜이 들어와서 소르베가 즉사하는 경우가 많은데 이 깃털일 때는 상대의 딜이 좀 낮아지기 때문에 아군의 생존이 상당히 높아질 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.329,
                "end": 91.085
            },
            {
                "speaker_id": "1",
                "transcription": "그 상태에서 저는 딜을 많이 넣어서 상대 딜러를 잘 끊어주는 경우에는 쉽게 이길 수도 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.095,
                "end": 96.681
            },
            {
                "speaker_id": "1",
                "transcription": "네 그런 경우도 보여 드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 96.691,
                "end": 100.633
            }
        ]
    },
    "summary": "빙결덱은 어느 정도 세팅 가능한 분들에게는 절망적으로 아레나 손 놓고 있는 거보다는 빙결덱 세팅해서 아레나 하는 거 나쁘지 않다고 남자가 설명하고 있다.",
