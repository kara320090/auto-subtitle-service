        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 무난하게 그럼 깃털 덱이랑 한번 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.563
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 15초가 지나기 전까지는 신규 보물 그냥 보물 하나 안 끼고 하는 거랑 똑같죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.573,
                "end": 8.874
            },
            {
                "speaker_id": "1",
                "transcription": "근데 초반에는 어차피 공경력 증가 공증 버프가 없기 때문에 뭐 큰 의미가 없고 이제 중요한건 1분 타이밍 때죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.884,
                "end": 18.187
            },
            {
                "speaker_id": "1",
                "transcription": "안전하게 보호막이 다 생겼죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.197,
                "end": 20.782
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 안전하게 가져가고 그 다음에 상대방이 스킬 한 번 더 들어올 때쯤 자 여기서 한번 더 터져서 안전하게 보호막이나 이런 거 있어주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.792,
                "end": 31.213
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 문제가 지금 얘가 다 터졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.223,
                "end": 34.141
            },
            {
                "speaker_id": "1",
                "transcription": "근데 상대방도 안 죽고 다 살았고 저도 다 살았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.151,
                "end": 36.735
            },
            {
                "speaker_id": "1",
                "transcription": "한 40초 지나서 남았을 때 이때부터 완벽하게 불리해지는 거예요 그냥.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.745,
                "end": 42.394
            },
            {
                "speaker_id": "1",
                "transcription": "저 상대방은 보물 하나 더 낀 상태고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.404,
                "end": 48.166
            }
        ]
    },
    "summary": "남성이 게임을 하고 있으며 15초가 지나기 전까지는 보물을 하고 안하고 차이가 나지 않고 중요한 건 1분 타이밍 때부터이며 40초 지나서 남았을 때부터는 완벽하게 불리해지는 거라고 설명하고 있다.",
