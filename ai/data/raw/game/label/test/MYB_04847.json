        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 야 자 이런 식으로 초반에 뱀파 얘네를 다 막아 주고 무난하게 이기는 그림 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 16.199
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이거 맨 처음에 크유 쿨이 17퍼센트였을 때는 지는 사람도 있었거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.209,
                "end": 22.052
            },
            {
                "speaker_id": "1",
                "transcription": "근데 확실히 크유의 쿨을 20퍼센트에서 22 사이로 맞춰 주면은 거의 승률 100퍼센트로 나오는 것 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.062,
                "end": 29.051
            },
            {
                "speaker_id": "1",
                "transcription": "거의 안 집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.061,
                "end": 30.366
            },
            {
                "speaker_id": "1",
                "transcription": "네 뱀파덱 상대로만 들어가면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.376,
                "end": 32.927
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파이어가 맨 뒤에 상대가 보이고 공속 보물과 그다음에 증표 보물을 끼고 있다?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.937,
                "end": 39.581
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 승률이 거의 100퍼센트에 가까운 것 같습니다 지금 이 상태로는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.591,
                "end": 43.705
            },
            {
                "speaker_id": "1",
                "transcription": "만나서 지금 네 세팅 제대로 해 놓고서는 진 적이 없거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.715,
                "end": 50.614
            },
            {
                "speaker_id": "1",
                "transcription": "한 4연승, 5연승 하고 있는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.624,
                "end": 56.718
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘이 죽었다 해도",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.728,
                "end": 60.966
            }
        ]
    },
    "summary": "남자는 초반에 뱀파를 다 막아 주고 무난하게 이기는 그림이 좋다고 하며 맨 처음에 크유 쿨이 17퍼센트였을 때는 지는 사람도 있었는데 크유의 쿨을 20에서 22퍼센트 사이로 맞춰 주면 거의 승률 100퍼센트로 나오는 것 같다며 뱀파덱 상대로만 들어가면 된다고 한다.",
