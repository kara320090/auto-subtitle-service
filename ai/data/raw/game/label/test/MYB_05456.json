        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이거 가지고 제일 먼저 어둠 모드로 마법 사탕 쿠키 5마리를 이용해서 힐러 없이 갑니다.",
                "sound_type": [
                    2,
