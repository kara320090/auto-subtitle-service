            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 크림슨 코랄 쿠키가 너무 강력하게 많이 쓰이다 보니까 홀리베리 쿠키 나락 갔나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.587
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤도 나락 갔나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.598,
                "end": 7.320
            },
            {
                "speaker_id": "1",
                "transcription": "이 질문이 가장 많이 올라오고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.322,
                "end": 9.795
            },
            {
                "speaker_id": "1",
                "transcription": "자 하지만 이번 영상에서 말씀드리고 싶은 점은 절대 나락 간 게 아니고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.805,
                "end": 14.430
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리랑 용과 드래곤은 이렇게 2탱 조합으로 여전히 0티어로 활용되고 있고 현재 유행하고 있는 1탱 3딜 극딜 조합 카운터로 활용할 수 있다는 점 이번 영상에서 소개해 드리려고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.580,
                "end": 27.530
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 용과 드래곤 세팅을 보여드리면 자 홀리베리 같은 경우에는 피감 여러분들 능력껏 높게 쿨은 23퍼센트나 22퍼센트 이상 자 용과 드래곤은 너무 피감이 낮으면은 상대 극딜델한테 죽을 수도 있어서 가급적이면 높게 세팅을 해주시고 쿨은 저는 5퍼센트에서 8퍼센트 사이 이렇게 맞추시는 걸 추천드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.540,
                "end": 47.792
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타 되게 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.822,
                "end": 49.263
            },
            {
                "speaker_id": "1",
                "transcription": "피감이 너무 높으면 또 안 죽어서 문제일 수 있고 너무 낮으면 일찍 죽어서 문제일 수 있기 때문에 여러분들에 맞는 스펙에 맞게끔 1분 대까지 버틸 수 있는 피감을 각자 찾으셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.272,
                "end": 62.212
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임은 여러분들 능력껏 높게 세팅해 주셔도 되고 가급적이면은 22퍼센트 이상 저는 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.222,
                "end": 68.995
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 블랙펄 같은 경우에는 두 가지 세팅이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.002,
                "end": 72.185
            },
            {
                "speaker_id": "1",
                "transcription": "능력이 되신다면은 올쿨 세팅으로 피감 높게 세팅이 가능하지만 아 저는 블랙펄 피감 높게 못합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.195,
                "end": 79.652
            },
            {
                "speaker_id": "1",
                "transcription": "일찍 죽을 수 있어요 하시는 분들은 그냥 올 아몬드 피감 높게 아 이렇게 쿨, 공속없이 세팅해도 가능하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.667,
                "end": 87.091
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅 드래곤은 올쿨로 세팅하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.101,
                "end": 89.664
            },
            {
                "speaker_id": "1",
                "transcription": "자 제일 먼저 올쿨로 보여드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.674,
                "end": 91.609
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 피감으로도 되는 거 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.619,
                "end": 94.180
            },
            {
                "speaker_id": "1",
                "transcription": "자 요새 많이 나오는 이 3딜 극딜덱 저격으로 가볼 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.190,
                "end": 99.002
            },
            {
                "speaker_id": "1",
                "transcription": "자 호루라기는 당연히 블랙펄과 용과 드래곤이 받습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.012,
                "end": 104.500
            }
        ]
    },
    "summary": "홀리베리 쿠키와 용과 드래곤이 나락 간 것이냐는 질문이 많이 올라오는데 이 두 가지는 여전히 2탱 조합으로 0티어로 활용되고 있고 1탱 3딜 극딜 조합으로도 활용되고 있기 때문에 절대 나락 간 것이 아니다.",
