        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 깨졌죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 0.649
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 여러분들이 좀 파악을 해야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.659,
                "end": 2.995
            },
            {
                "speaker_id": "1",
                "transcription": "깨지기 전에 오먹을 눌러버리면은 오징어 먹물 스킬 범위가 요렇게 잡혀요. 요렇게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.005,
                "end": 8.186
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 맨 앞에 비석은 이 타스 복어가 깨지 못해서 얘는 남아 있어 가지고 호밀이 스킬 쓰면은 얘한테 박혀서 엄청난 딜 손실이 나거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.196,
                "end": 17.449
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 얘가 깨지고 난 뒤에 오먹이 발동돼야만 오먹의 스킬 범위가 요렇게 잡혀서 맨 앞에 비석을 깨트리게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.459,
                "end": 25.393
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요거 깨진 거 확인하고 스킬 도는 대로 어 바로 써주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.403,
                "end": 31.290
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 호밀 같은 경우에는 이 마카롱 기준 9시에 스킬 쓰면 됩니다. 마카롱 기준 9시",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.300,
                "end": 37.523
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 자동으로 내버려 두면은 대략 9시에 나가긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.533,
                "end": 41.229
            },
            {
                "speaker_id": "1",
                "transcription": "그렇죠 9시에 대충 나가죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.239,
                "end": 42.754
            },
            {
                "speaker_id": "1",
                "transcription": "그르면은 이 비석에 안 맞고 본체에다가 스킬이 발동되게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.764,
                "end": 48.962
            },
            {
                "speaker_id": "1",
                "transcription": "네 마카롱 그다음에 스킬 쿨타임 오는 대로 바로 눌러주고 네 그다음에 블랙베리 스킬 눌러주고 자 그다음에 벚꽃하고 벚꽃 눌러주고 마카롱 눌러줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.972,
                "end": 62.166
            }
        ]
    },
    "summary": "오먹의 스킬 범위가 잡히기 때문에 호밀의 스킬이 비석에 박혀서 엄청난 딜 손실이 나오게 된다며 화자는 비석이 깨진 거 확인하고 오먹이 발동돼야만 한다고 한다.",
