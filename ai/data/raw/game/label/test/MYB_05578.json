                    5
                ],
                "start": 9.644,
                "end": 17.115
            },
            {
                "speaker_id": "1",
                "transcription": "일부 구간에서 최대 획득 개수가 상향된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.125,
                "end": 20.108
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 보상이 많이 늘어난다 이거네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.118,
                "end": 22.529
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 생산품 건물 3종의 최대 레벨 확장 및 묶음 생산 기능 추가 설탕 몽땅 잼가게 최대 레벨이 5레벨에서 7레벨로 확장 이제 묶음으로 이것도 대장간처럼 될 수 있다.",
