        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 클리어해 주는 그림 얘는 보통 2, 1, 2덱한테 많이 들어가거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.054
            },
            {
                "speaker_id": "1",
                "transcription": "그거 한번 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.064,
                "end": 10.896
            },
            {
                "speaker_id": "1",
                "transcription": "이제 요걸로 보통 이 덱 같은 경우에는 바요나 에스프레소 있는 덱이 좀 약한 덱은 상대가 에클레어가 있으면은 좀 약합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.906,
                "end": 24.944
            },
            {
                "speaker_id": "1",
                "transcription": "피해 증가 그 디버프가 중첩되어 있으면은 나중에 그냥 한 번에 확 녹아버리기 때문에 보통은 그런 덱한테는 좀 약해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.954,
                "end": 36.637
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서도 이제 핵이 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.647,
                "end": 40.097
            },
            {
                "speaker_id": "1",
                "transcription": "딜 들어가고 바요까지 딜 이건 아마 질 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.107,
                "end": 48.380
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 질 가능성이 아 근데 거의 2, 2, 1덱한테는 제가 안 들어갔거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.390,
                "end": 56.041
            },
            {
                "speaker_id": "1",
                "transcription": "예 리뷰에서는 제가 들어가지만 확실히 되게 약하긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.051,
                "end": 61.154
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정이 딜은 센데 그래도 약한 몸을 가졌기 때문에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.164,
                "end": 67.133
            }
        ]
    },
    "summary": "이 덱은 상대가 에클레어가 있으면 피해 증가 디퍼트가 중첩돼 나중에 확 녹아버리기 때문에 약하고 바다 요정은 딜은 세지만 약하긴 하다.",
