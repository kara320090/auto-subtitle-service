        "term": [
            {
                "speaker_id": "1",
                "transcription": "벚꽃 예약합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.332
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 보스 출현하면은 발동됐죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.342,
                "end": 4.627
            },
            {
                "speaker_id": "1",
                "transcription": "벚꽃 발동되면은 그다음에 블랙베리 바로 예약해 줍니다. 블랙베리",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.637,
                "end": 9.219
            },
            {
                "speaker_id": "1",
                "transcription": "예약해 주고 블랙베리 써주면 바로 마카롱 예약해 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.229,
                "end": 13.405
            },
            {
                "speaker_id": "1",
                "transcription": "네 이거 숙달이 좀 돼야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.415,
                "end": 15.416
            },
            {
                "speaker_id": "1",
                "transcription": "벚꽃, 블배 쓰고 바로 마카롱 예약",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.426,
                "end": 18.441
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 자동으로 오징어 먹물이 스킬 나가면은 바로 호밀을 눌러주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.451,
                "end": 24.311
            },
            {
                "speaker_id": "1",
                "transcription": "얘 스킬 나가는 거 듣고 바로 호밀",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.321,
                "end": 26.649
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 써 주고요.",
