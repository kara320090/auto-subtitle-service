                "transcription": "아 진짜 예쁘다 질.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.222,
                "end": 44.730
            },
            {
                "speaker_id": "1",
                "transcription": "장면 하나하나가 다 컴퓨터 배경화면급이야.",
                "sound_type": [
