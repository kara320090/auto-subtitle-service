                ],
                "start": 0.000,
                "end": 4.240
            },
            {
                "speaker_id": "1",
                "transcription": "아 약간 너무 고정플래그인데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.240,
                "end": 7.040
            },
            {
                "speaker_id": "1",
                "transcription": "다행이다 여기는 사람들이 죽을 일이 없잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.050,
                "end": 9.170
            },
            {
                "speaker_id": "1",
                "transcription": "그렇죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.180,
                "end": 12.220
            },
            {
                "speaker_id": "1",
                "transcription": "가브가 살아서 다행이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.230,
                "end": 16.590
            },
            {
                "speaker_id": "1",
                "transcription": "디온 게이게이야.",
