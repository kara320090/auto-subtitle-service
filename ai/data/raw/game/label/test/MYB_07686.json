                    2,
                    3
                ],
                "start": 16.590,
                "end": 21.020
            },
            {
                "speaker_id": "1",
                "transcription": "잘 됐다 쟤 몸 뒤로 게임도 보이고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.020,
                "end": 22.990
            },
            {
                "speaker_id": "2",
                "transcription": "&외국어 발화&",
                "sound_type": [
