        "term": [
            {
                "speaker_id": "1",
                "transcription": "와베가 이건 캐리했네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.692
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 와베가 치명타 확률 높여주는 것도 상당히 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.702,
                "end": 5.084
            },
            {
                "speaker_id": "1",
                "transcription": "일찍 죽었지만 피 많이 깎아 놓고 죽긴 했거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.094,
                "end": 8.104
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 다음에 요것도 한번 들어가 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.114,
                "end": 10.018
            },
            {
                "speaker_id": "1",
                "transcription": "2, 1, 2 덱 투탱한테는 거의 많이 들어갔는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.028,
                "end": 18.242
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 독버섯 이 중독이 어떻게 보면 여러분들 딜을 좀 표시하면은 저렇게 계속 지속적으로 딜이 들어가죠 독버섯?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.252,
                "end": 30.502
            },
            {
                "speaker_id": "1",
                "transcription": "야금야금 저 딜 자체가 5천 9백, 5천 9백 요렇게 밖에 안 뜨는 것 같지만",
                "sound_type": [
