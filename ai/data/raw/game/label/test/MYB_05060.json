        "term": [
            {
                "speaker_id": "1",
                "transcription": "이야 이거 딜도 좋고 뭐 완벽한데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.734
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 죽었다 해도 깃털로 부활하면 되니까 이거 방덱으로 해도 상당히 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.744,
                "end": 10.333
            },
            {
                "speaker_id": "1",
                "transcription": "예 바로 방덱으로 바꿔놓을게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.343,
                "end": 12.278
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 바꿔서 방덱 후기도 제가 알려드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.288,
                "end": 15.346
            },
            {
                "speaker_id": "1",
                "transcription": "너무 좋은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.356,
                "end": 16.303
            },
            {
                "speaker_id": "1",
                "transcription": "가리는 쿠키야 당연히 뭐 이렇게 하는 게 낫겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.313,
                "end": 19.288
            },
            {
                "speaker_id": "1",
                "transcription": "에스프레소는 보여줘도 되고 가리는 건 이렇게 가려볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.298,
                "end": 22.853
            },
            {
                "speaker_id": "1",
                "transcription": "오 이거 너무 좋은데?",
