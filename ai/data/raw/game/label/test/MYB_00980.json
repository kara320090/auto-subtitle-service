    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고 달빛술사도 3라즈 2애플젤리.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.211
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 공속 굳이 신경 안 쓰셔도 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.221,
                "end": 5.615
            },
            {
                "speaker_id": "1",
                "transcription": "피해감소만 높게 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.625,
                "end": 8.330
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄도 마찬가지 쿨 공속 신경 안 쓰고 피해감소 높게 공 치 여유가 되면 높게 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.335,
                "end": 17.070
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 무지개 큐브 많이 부족하시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.060,
                "end": 19.657
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.667,
                "end": 24.955
            },
            {
                "speaker_id": "1",
                "transcription": "여러분한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.965,
                "end": 29.481
            },
            {
                "speaker_id": "1",
                "transcription": "무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원 가격에 해당하는 가격인데 제가 무료로 나눠드리고 있는데 받은 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.491,
                "end": 41.282
            },
            {
                "speaker_id": "1",
                "transcription": "고정 댓글에 있는 플레이오 앱을 다운받으시고 우측 하단에 프로필을 누르시고 우측 상단에 톱니바퀴를 누르면 시크릿코드 입력하는 데가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.292,
                "end": 51.321
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오ND러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.331,
                "end": 55.773
            },
            {
                "speaker_id": "1",
                "transcription": "플레이오 앱은 도대체 어떤 걸까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.783,
                "end": 58.039
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 게임만 해도 자동으로 쌓이는 잼을 가지고 상점에서 여러분이 원하는 기프트카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.049,
                "end": 67.036
            },
            {
                "speaker_id": "1",
                "transcription": "게임하는데 여러분한테 따로 광고가 뜨지도 않고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.046,
                "end": 70.403
            },
            {
                "speaker_id": "1",
                "transcription": "방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.413,
                "end": 72.865
            },
            {
                "speaker_id": "1",
                "transcription": "시크릿 코드 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.875,
                "end": 78.862
            },
            {
                "speaker_id": "1",
                "transcription": "자세한 이벤트 확인은 고정댓글을 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.872,
                "end": 82.110
            },
            {
                "speaker_id": "1",
                "transcription": "연습하기를 통해서 상대방 제 자신.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.120,
                "end": 84.525
            },
            {
                "speaker_id": "1",
                "transcription": "28강한테 들어갈 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.535,
                "end": 86.694
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 무공비급 2탱덱한테 갈 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.704,
                "end": 90.377
            },
            {
                "speaker_id": "1",
                "transcription": "일단 제작자분께서 레어 무공비급일 때는 망토 대신에 깃털 써라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.387,
                "end": 95.378
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 알려주셨는데 저 같은 경우에는 그냥 공속 쓰는 게 더 승률이 좋았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.388,
                "end": 100.118
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 중요한 게 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.128,
                "end": 101.470
            },
            {
                "speaker_id": "1",
                "transcription": "이 한방덱은 이렇게 2힐 덱한테는 들어가면 안 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.480,
                "end": 105.062
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 가운데 락스타가 보이고 뒤에 힐러가 2힐덱이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.072,
                "end": 108.247
            },
            {
                "speaker_id": "1",
                "transcription": "1탱이건 2탱이건 들어가시면 안 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 108.257,
                "end": 111.866
            }
        ]
    },
    "summary": "한 남성이 세팅에 대해 자세히 설명하고 시청자에게 무지개 큐브를 무료로 드리는 이벤트에 대해 설명하고 있다.",
