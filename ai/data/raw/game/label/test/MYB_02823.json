        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현재 아레나에서 무공비급이 안 쓰이는 약간 기이한 현상이 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.115
            },
            {
                "speaker_id": "1",
                "transcription": "무공비급이 안 쓰이고 호루라기가 쓰이는 경우도 있고 아니면은 무공비급을 쓰고 깃털과 함께 쓰는 이렇게 경우가 나뉘어지게 되는데 일반적으로 제가 봤을 때는 현재 이렇게가 많이 쓰이고 있는 상황인 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.125,
                "end": 21.613
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 쓰면은 일단 방덱으로 제가 설정을 해 놨더니 방덱도 되게 좋더라고요. 일단 보면은 한방덱 많이 잘 막고 기타 다른 덱도 되게 다 잘 막는 그런 모습을 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.623,
                "end": 35.488
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 많이 쓰이고 있는데 아무래도 이것도 하나의 유행으로 지나갈 가능성이 크지만 그래도 되게 무공비가 이제 빠지게 됐다는 점에서 되게 큰 의미를 가집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.498,
                "end": 46.013
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 자체는 저는 기존에 쓰던 덱에서 그냥 저는 깃털만 바꿔서 썼는데 되게 좋게 쓰였거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.023,
                "end": 52.328
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리는 4 아몬드 1 쿨을 쓰거나 아니면 올 아몬드해서 여러분들 쿨 높게 쓰시면 될 것 같아요. 뭐 쿨은 최대한 8퍼센트 이상 해보시는 게 좋고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.338,
                "end": 61.312
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 소르베 같은 경우에는 제가 아레나에서는 소르베 진짜 많이 쿨이랑 이것저것 바꿔봤는데 얘는 확실히 쿨 높은 게 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.322,
                "end": 70.570
            },
            {
                "speaker_id": "1",
                "transcription": "쿨이 낮다기보다는 높은 게 확실히 더 유리하고 피감은 여러분들이 가능한 한 높게 그 아마 쿨을 높이느라 피감이 낮아지면은 그건 좀 오히려 승률이 떨어지니까 제가 볼 때 피감은 일단 높아야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.580,
                "end": 84.647
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 높은 상태에서 쿨은 가능한 한 최대한 높게 그다음에 달빛은 저는 22퍼센트 무슨 덱을 쓰더라도 저는 22퍼센트 고수하고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.657,
                "end": 92.788
            },
            {
                "speaker_id": "1",
                "transcription": "되게 이기는 그런 그림이 잘 나오기 때문에 22퍼센트에다가 피감 여러분들 능력껏 그다음에 예언자는 아몬드에다가 10퍼센트 이상의 첫째 자리 9로 맞춰줘서 서리여왕 능력 복사 나머지는 울 쿨. 자 요렇게 세팅을 해서 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.798,
                "end": 111.625
            }
        ]
    },
    "summary": "화자는 승률을 높이기 위한 수치를 알려주며 본인은 달빛 22퍼센트를 고수한다고 말한다.",
