        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 녀석이 용의 힘을 휘두르지 못하게 해야 해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.870
            },
            {
                "speaker_id": "2",
                "transcription": "애초에 그런 대단한 힘을 왜 넘겨준 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.880,
                "end": 7.624
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도의 힘을 넘겨준 적 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.634,
                "end": 10.885
            },
            {
                "speaker_id": "1",
                "transcription": "녀석이 이 몸과의 계약을 왜곡시킨 게 분명하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.895,
                "end": 15.401
            },
            {
                "speaker_id": "1",
                "transcription": "아직은 나도 자세히는 모르겠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.411,
                "end": 20.187
            },
            {
                "speaker_id": "2",
                "transcription": "저쪽에서 붉은 빛이 새어나와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.197,
                "end": 23.866
            }
        ]
    },
    "summary": "남성은 녀석이 자신과의 계약을 왜곡시켜서 힘이 넘어간 거라고 이야기한다.",
