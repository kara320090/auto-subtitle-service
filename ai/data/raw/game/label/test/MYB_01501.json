    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 딜표를 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.296
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식의 구조가 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.306,
                "end": 4.538
            },
            {
                "speaker_id": "1",
                "transcription": "락스타는 이렇게 실량이 미쳤죠.",
                "sound_type": [
                    2
                ],
                "start": 4.548,
                "end": 6.994
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 이제 중요한 포인트가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.004,
                "end": 9.608
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이성인데도 불구하고 딜이 되게 좋네 와 이거 완전 사기다 이거 좋은 거 아닌가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.618,
                "end": 14.711
            },
            {
                "speaker_id": "1",
                "transcription": "제가 결론부터 말씀드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.721,
                "end": 16.494
            },
            {
                "speaker_id": "1",
                "transcription": "경험을 아레나에서 많이 돌려봤거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.504,
                "end": 19.028
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 필요하고 무지성으로 이 조합이 무조건 좋은 건 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.038,
                "end": 22.870
            },
            {
                "speaker_id": "1",
                "transcription": "이 조합 자체는 방덱으로도 세워놓고 해봤지만 한방덱한테 뚤려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.880,
                "end": 28.088
            },
            {
                "speaker_id": "1",
                "transcription": "보시면 아시겠지만 한방덱한테 뚫립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.098,
                "end": 30.359
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱한테는 약한 모습을 보이고 특히나 유덱한테도 뚫려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.369,
                "end": 34.780
            },
            {
                "speaker_id": "1",
                "transcription": "소르베 덱한테도 약한 모습을 보이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.790,
                "end": 37.541
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 여러분들이 지금 이 현시점에서 샤이닝글리터 리뷰를 들어와서 얘를 반드시 키워야 되냐 이거를 지금 포인트로 보고 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.551,
                "end": 46.823
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 키워야 되는 쿠키는 아니긴 합니다 아레나에서.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.833,
                "end": 50.648
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 공격 옵션으로는 유용하게 쓸 수는 있으나 현재로서는 락스타가 더 필수적으로 키워야 되는 입장이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.658,
                "end": 58.271
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 써보니까 이 자리에 샤이닝글리터 자리에 스타더스트 들어갈 수 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.281,
                "end": 63.480
            },
            {
                "speaker_id": "1",
                "transcription": "소르베 들어갈 수 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.490,
                "end": 65.031
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신 들어갈 수 있고 네 그 다음에 달빛 술사 들어갈 수 있고 한마디로 샤이닝글러터 자리에 무수히 많은 쿠키들이 들어갈 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.041,
                "end": 73.793
            },
            {
                "speaker_id": "1",
                "transcription": "승급이 높으면 높을 수록 승률이 높지만 별이 낮을 수록 그래도 생존이 조금 힘들 수 있다 얘가 그러면은 샤이닝글리터를 썼을 때 장점이 뭔가요라고 물어볼 수 있잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.803,
                "end": 84.844
            },
            {
                "speaker_id": "1",
                "transcription": "제가 해보니까 확실히 얘의 장점이 뭐냐면은 스타더스트가 상대방은 5초월이고 나는 승급이 낮았을 때 승급이 낮은 거임에도 불구하고 낮은 승급으로 스타더스트 높은 초월을 이길 수 있다 아 러너님 저는 라즈베리 말고요 그냥 아몬드로 할래요 좀 더 단단하게 하게 하고 싶습니다 해봤거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.854,
                "end": 106.287
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들이 아셔야 될 게 얘가 가지는 이 치명타 피해감소를 위해서 난 쓰겠다 얘는 그런 의도로 쓰시면은 수비적으로 가잖아요 상대 쿠키를 내가 못 죽이면 내가 다 어차피 죽게 돼 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 106.297,
                "end": 120.409
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 락스타 샤이닝 스냅드래곤이 약하게 세팅이 되게 되고 용과만 공격하게 되면은 상대 쿠키를 죽일 수 있는 구도가 안 나와서 덱의 밸런스가 깨진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 120.419,
                "end": 132.234
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이렇게 말하는 이유는 이것저것 세팅을 해봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 132.244,
                "end": 135.439
            },
            {
                "speaker_id": "1",
                "transcription": "샤이닝을 활용할 수 있는 방법은 최대한 공격적으로 쓰는 수밖에 없는 느낌이 드는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 135.449,
                "end": 141.753
            },
            {
                "speaker_id": "1",
                "transcription": "상대 보면은 현재 방덱에는 스타더스트랑 달빛이 많아요 그리고 다시 한번 말씀드리지만 한방덱에는 이게 락스타 샤이닝글리터 조합이 한방덱을 뚫지는 못하거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 141.763,
                "end": 157.526
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 물론 한방덱을 뚫을 수도 있긴 하겠지만 성공률이 높지 않아요. 그래서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 157.536,
                "end": 163.396
            },
            {
                "speaker_id": "1",
                "transcription": "무지성으로 한방덱한테는 들어가면 안 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 163.406,
                "end": 167.220
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게",
                "sound_type": [
                    2,
                    5
                ],
                "start": 167.230,
                "end": 170.233
            }
        ]
    },
    "summary": "딜표를 보여주며 샤이닝글리터 무조건 키워야 하는 쿠키는 아니며 현재로서는 락스타가 더 필수적으로 키워야 하는 쿠키라고 하며 락스타의 장점에 대한 소개와 샤이닝을 활용할 수 방법에 대해 소개하고 있다.",
