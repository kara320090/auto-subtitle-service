        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 11월 30일 수요일 업데이트 뉴스입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.438
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트 내용은 상세히 같이 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.448,
                "end": 6.330
            },
            {
                "speaker_id": "1",
                "transcription": "일단 11월 30일 업데이트에서는 되게 쿠키들이 크리스마스 뭔가 그런 느낌으로 되게 화목한 모습이 담겨져 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.340,
                "end": 16.100
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 보면 음유시인맛 쿠키가 출시된다고 바로 나왔는데 이 음유시인맛 쿠키는 에픽 등급이고 회복형 그리고 이제 후방에 있습니다 스킬은 마법의 노래 이렇게 되어 있는데 가장 중요한 포인트는 회복형이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.110,
                "end": 30.316
            },
            {
                "speaker_id": "1",
                "transcription": "이전에 나온 에픽 쿠키 중에 정말 사기였던 크림유니콘맛 쿠키가 회복형이었는데 음유시인도 제가 볼 때 회복형으로 출시되면 상당히 좋게 출시될 거라고 느낌이 옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.326,
                "end": 41.934
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 오븐브레이크에서 보면은 스킬이 3가지가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.944,
                "end": 45.310
            },
            {
                "speaker_id": "1",
                "transcription": "회복, 점수, 파괴 3개가 있는데 아마 쿠키런 킹덤으로 넘어오면서 이와 비슷하게 버프와 디버프를 번갈아주는 그런 형태로 나오지 않을까 아마 필수로 쓰이지 않을까 그런 생각이 들고 자 여러분 가장 중요한 소르베맛 쿠키 정말 나온다 나온다 예측을 많이 했는데 진짜 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.320,
                "end": 65.573
            },
            {
                "speaker_id": "1",
                "transcription": "목화맛 쿠키 남친 절친으로 스토리에 등장했던 쿠키인데 정령이 돼서 떠돌고 이제 사라진다는 그런 엔딩이 나왔는데 실제로는 이렇게 쿠키로 출시가 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.583,
                "end": 77.677
            },
            {
                "speaker_id": "1",
                "transcription": "근데 등급 자체가 많은 분들이 레전드 쿠키로 예상했는데 슈퍼 에픽으로 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.687,
                "end": 83.650
            },
            {
                "speaker_id": "1",
                "transcription": "저도 이제 레전드로 나와야 된다고 생각했지만 슈퍼 에픽으로 나온 이유가 킹덤 같은 경우에는 슈퍼 에픽이 나오는 거는 고대 쿠키랑 레전드 쿠키 출시 그 사이에 껴서 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.650,
                "end": 94.162
            },
            {
                "speaker_id": "1",
                "transcription": "그 사이에 슈퍼 에픽으로 이제 나오게 됐고 특이하게 이번에 사격형이에요 사격형.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.172,
                "end": 100.103
            },
            {
                "speaker_id": "1",
                "transcription": "스킬은 얼음 결정 근데 중요한 거는 이 그림을 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.113,
                "end": 103.511
            },
            {
                "speaker_id": "1",
                "transcription": "소르베맛 쿠키 등 쪽에 클로티드처럼 딱 그 날개를 딱 펼치고 나서 그냥 난사하는 느낌으로 나오거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 103.521,
                "end": 111.098
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 느낌으로 아마 스킬을 막 연속으로 쏘는 느낌이지 않을까 아니면 골드치즈처럼 뭔가 미사일을 쏘는 느낌으로 있지 않을까 그래서 이 적을 이 빙결로 맞추면은 순간적으로 빙결 상태에 빠져서 뭐 쿨타임 정지 아니면 뭐 상태 이상에 걸려서 엄청난 디버프가 걸린다던지 그런 효과로 엄청 사기적으로 나오지 않을까 원래 슈퍼 에픽이 처음 등장했을 때는 정말 사기적으로 출시됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 111.108,
                "end": 135.560
            },
            {
                "speaker_id": "1",
                "transcription": "필수로 뽑아야 되지 않을까 그런 느낌이 듭니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 135.570,
                "end": 139.414
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어처럼 딱 그 위치에 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 139.424,
                "end": 141.645
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키와 함께 그 옆자리를 차지할 가능성이 그냥 99퍼센트다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 141.655,
                "end": 148.466
            }
        ]
    },
    "summary": "한 남성이 쿠키 게임 기사를 보면서 업데이트 될 내용을 설명하고 있다.",
