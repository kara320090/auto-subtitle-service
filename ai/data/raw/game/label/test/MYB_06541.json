                    2,
                    4
                ],
                "start": 0.787,
                "end": 2.186
            },
            {
                "speaker_id": "1",
                "transcription": "나, 나, 나기메임.",
                "sound_type": [
                    2
                ],
                "start": 2.196,
                "end": 5.272
            },
            {
                "speaker_id": "1",
                "transcription": "20분이라뇨.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 5.282,
                "end": 9.387
            },
            {
                "speaker_id": "1",
                "transcription": "릴트님 어서 오세요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 9.397,
                "end": 11.955
            },
            {
                "speaker_id": "1",
                "transcription": "저걸 잡아야지 되는데 바로 돌아가진 않을 거 아니야.",
                "sound_type": [
                    1,
                    2,
                    4,
                    5
                ],
                "start": 11.965,
                "end": 22.295
            },
            {
                "speaker_id": "1",
                "transcription": "바로 돌아가네?",
                "sound_type": [
                    2
                ],
                "start": 22.295,
                "end": 23.046
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이렇게 해서 잡아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.056,
                "end": 26.501
            },
            {
                "speaker_id": "1",
                "transcription": "지금 빨라지면 지금 호로록 옷이 벗겨졌어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.511,
                "end": 35.917
            },
            {
                "speaker_id": "1",
                "transcription": "팬티도 한 장 헤 미쳤다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.927,
                "end": 45.705
            },
            {
                "speaker_id": "1",
                "transcription": "사람 가지고 사람 똘똘 뭉쳐놨네?",
                "sound_type": [
                    2
                ],
                "start": 45.715,
                "end": 48.138
            },
            {
                "speaker_id": "1",
                "transcription": "인체 실험한 거야.",
                "sound_type": [
                    2
                ],
                "start": 48.148,
                "end": 52.117
            },
            {
                "speaker_id": "1",
                "transcription": "지금 저 과학자들이 미치광이 과학자들",
                "sound_type": [
                    2
                ],
                "start": 52.115,
                "end": 56.400
            }
        ]
