                "start": 0.000,
                "end": 6.666
            },
            {
                "speaker_id": "1",
                "transcription": "힘을 줘서 열 수 있게 힘주는 느낌의 그 뭐랄까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.676,
                "end": 11.425
            },
            {
                "speaker_id": "1",
                "transcription": "뭐라 그래야 되지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.435,
                "end": 13.550
            },
            {
                "speaker_id": "1",
                "transcription": "그 그 활시위 당기듯이 어 진동 당기기를 그렇게 만들어 줬어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.560,
                "end": 18.819
            },
            {
                "speaker_id": "1",
                "transcription": "요걸 따악 당기게 그니까 몰입할 수 있게 너무 잘했다는 거지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.829,
                "end": 23.095
            },
            {
                "speaker_id": "1",
                "transcription": "어 텐션이 좋았다는 거죠.",
