        "term": [
            {
                "speaker_id": "1",
                "transcription": "크림슨코랄이 물속성 대미지 추가와 잼스톤의 물속성 공격 피해량까지 더해진다면 어마무시한 시너지로 쓰이지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.994
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정이 지금의 가치보다 엄청나게 올라가지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.004,
                "end": 14.145
            },
            {
                "speaker_id": "1",
                "transcription": "아 또 하나 이번 영상에서 제가 꼭 말하고 싶은 점이 하나 있는데 바다요정은 지금 무적기가 없어서 너무 잘 죽는다, 몸이 약하다, 뭐 그런 얘기도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.155,
                "end": 23.933
            },
            {
                "speaker_id": "1",
                "transcription": "지금 현재 바다요정은 무적기가 없는 게 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.946,
                "end": 27.233
            },
            {
                "speaker_id": "1",
                "transcription": "지금 3번째 강화 스킬을 쓸 때 바다요정은 무적 판정을 받습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.243,
                "end": 32.430
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 한번 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.440,
                "end": 34.640
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다요정이 왜 몸이 약한지 그리고 무적 판정이 있는지 없는지 자 보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.633,
                "end": 41.097
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 지금 스킬을 쓸 때 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.107,
                "end": 43.482
            },
            {
                "speaker_id": "1",
                "transcription": "강화 스킬 쓸 때는 피가 안 닳니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.492,
                "end": 45.578
            },
            {
                "speaker_id": "1",
                "transcription": "아예 무적 판정이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.588,
                "end": 48.566
            }
        ]
    },
    "summary": "이번 영상에서 바다요정은 무적기가 없는 게 아닌 3번째 강화 스킬을 쓸 때 무적 판정을 받는다는 걸 보여주려고 한다.",
