        "term": [
            {
                "speaker_id": "1",
                "transcription": "음 이기긴 이겼어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.419
            },
            {
                "speaker_id": "1",
                "transcription": "끝까지 살아남아서 이겼어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.429,
                "end": 5.485
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드가 확실히 핵심적인 역할로 했는데, 야 그런데 확실히 클로티드가 얘 버프 받고 그런지 딜적인 면 엄청 우수하고 솔직히 상대 이거 너무 불리한 조합이긴 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.495,
                "end": 18.455
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 상대는 1초월도 있었고 사벳상어가 앞에 탱커 다 잡았거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.465,
                "end": 22.683
            },
            {
                "speaker_id": "1",
                "transcription": "그런데도 이기긴 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.693,
                "end": 24.588
            },
            {
                "speaker_id": "1",
                "transcription": "전 일단 초월은 안 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.598,
                "end": 27.376
            },
            {
                "speaker_id": "1",
                "transcription": "차라리 에클레어가 낫지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.386,
                "end": 28.936
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 한 번 이 덱도 한 번 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.946,
                "end": 33.266
            }
        ]
    },
    "summary": "상대방과의 전투에서 이겼고 확실히 클로티드가 핵심적인 역할로 했는데 버프 받고 그런지 딜적인 면이 되게 우수하다며 불리한 조합이긴 했지만 이겼다고 한다.",
