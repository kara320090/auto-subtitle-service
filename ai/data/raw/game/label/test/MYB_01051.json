            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 저게 뭐야 타수 여기 좀 많이 어렵겠다 사람들.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.453
            },
            {
                "speaker_id": "1",
                "transcription": "야 내가 볼 때는 저거 타수 보호막 많은 데 한 군데 있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.463,
                "end": 14.949
            },
            {
                "speaker_id": "1",
                "transcription": "타수 보호막이 엄청나게 많네 이번 시즌은?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.959,
                "end": 18.498
            },
            {
                "speaker_id": "1",
                "transcription": "방금 59웨이브인가요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.508,
                "end": 20.595
            },
            {
                "speaker_id": "1",
                "transcription": "거기가 내가 볼 때는 일반 다른 분들 좀 고비가 되지 않을까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.605,
                "end": 25.768
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 전체 1등 자 이번에는 올 애플젤리 말고 3공 2치로 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.778,
                "end": 33.906
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림만 올 애플젤리로 하고 대신에 공속만 망고랑 타르트한테 주고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.916,
                "end": 40.546
            },
            {
                "speaker_id": "1",
                "transcription": "망고가 안 된다 하시는 분들은 달빛을 쓰면 되고 망토는 그대로 오먹하고 타르트한테 주면 되고 저는 타르트를 못 써요 하시는 분들은 용과로 쓰시면 되고 낫을 쓰면 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.556,
                "end": 53.686
            },
            {
                "speaker_id": "1",
                "transcription": "자 과연 이번 시즌 토핑 세팅 최적화는 어떤 게 좋을지 야 근데 3 라즈, 2 애플젤리가 이론상은 더 좋긴 할 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.696,
                "end": 66.998
            },
            {
                "speaker_id": "1",
                "transcription": "체감상 3 라즈, 2 애플젤리가 난 더 세보이는데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.008,
                "end": 71.105
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뭐 결과가 중요하니까 네 오목은 토벌, 수호 성전, 한방 덱 모든 콘텐츠에서 최고의 끝판왕 활용성 쿠키예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 71.115,
                "end": 83.333
            }
        ]
    },
    "summary": "한 남성이 게임을 마친 후 이번 시즌은 타수 보호막이 엄청나게 많다며 59웨이브는 다른 사람들에게 좀 고비가 될 것 같다고 이야기한 후 앞에서는 올 애플젤리로 게임을 했던 것과는 다르게 다음 게임은 3공 2치로 해보겠다고 하며 다음 게임을 시작한다.",
