        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이거 맞아도 돼지 지금.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 29.470
            },
            {
                "speaker_id": "1",
                "transcription": "아 그런데 그게 너무 빡쳤었던 애가 하나 있었거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.480,
                "end": 33.400
            },
            {
                "speaker_id": "1",
                "transcription": "저희를 왜 공격하셨죠 그랬더니 난 모른다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.400,
                "end": 36.050
            },
            {
                "speaker_id": "1",
                "transcription": "난 모르는 일이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.050,
                "end": 42.130
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 막 되게 태연하게 말했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.130,
                "end": 44.290
            },
            {
                "speaker_id": "1",
                "transcription": "그 몹 하나가 되게 잡기 힘들었거든요 발키리 잡을 때.",
