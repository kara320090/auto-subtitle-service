        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 요거 보면은 뭐 무조건 지는 건 아니네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.178
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 덱 만난다고 무조건 지는 건 아니고 제가 볼 때는 에 그냥 뭐 질 때도 있고 클로티드 덱 이길 수도 있고 고런 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.188,
                "end": 15.722
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳 공격력이 흑당 안 넘겨 지는데 걍 써도 될까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.732,
                "end": 19.458
            },
            {
                "speaker_id": "1",
                "transcription": "공격력 부옵션을 놓으면은 이 전투력이 올라가거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.468,
                "end": 22.785
            },
            {
                "speaker_id": "1",
                "transcription": "맞출 때 한번 그거 한번 해 보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.795,
                "end": 24.775
            },
            {
                "speaker_id": "1",
                "transcription": "얘 흑당에 공격력을 아예 넣지 마시고 그다음에 샤벳한테 공 옵션을 줘서 그래서 한번 맞춰 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.785,
                "end": 31.529
            },
            {
                "speaker_id": "1",
                "transcription": "고렇게 한번 맞춰 보시면 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.539,
                "end": 33.701
            },
            {
                "speaker_id": "1",
                "transcription": "흑당한테 이게 보호막이 간다고 해도 샤벳이 뭐 잘 버텨 지거나 스킬 쓰는 데 문제 없으면은 그래도 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.711,
                "end": 40.753
            },
            {
                "speaker_id": "1",
                "transcription": "저는 보호막 주는 게 이렇게 되었는데 한번 여러분들이 써 보시고 해 보면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.763,
                "end": 45.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 샤벳 공속 덱 요새 많이 쓰는 공속 덱 리뷰를 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.316,
                "end": 55.366
            }
        ]
    },
    "summary": "샤벳 공격력이 흑당 안 넘겨 질 때는 흑당에 공격력을 넣지 말고 샤벳한테 공 옵션을 줘서 맞춰 보고 샤벳이 잘 버텨 지거나 스킬 쓰는 데 문제가 없다면 쓰면 된다.",
