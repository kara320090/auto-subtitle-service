    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "예언자 같은 경우에는 끝자리가 치명타 확률 9 9로 맞춰야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.639
            },
            {
                "speaker_id": "1",
                "transcription": "그래야 서리 능력을 복사할 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.649,
                "end": 7.710
            },
            {
                "speaker_id": "1",
                "transcription": "10퍼센트 이상 고정에다가 9퍼센트까지 맞춰야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.720,
                "end": 10.504
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 확률이 7.9, 8.9 이렇게 10퍼센트 미만일 때는 어 서리여왕 능력이 복사되지 않고 랜덤으로 나갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.514,
                "end": 17.329
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 10퍼센트 이상일 때 굿하고 9퍼센트 첫째 자리 맞춰야지만 서리 능력이 나갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.339,
                "end": 23.982
            },
            {
                "speaker_id": "1",
                "transcription": "퓨바를 같은 경우에는 올 아몬드 쿨 8퍼센트 맞추거나 저처럼 쿨을 더 높여서 쿨 토핑을 써서 해도 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.992,
                "end": 31.858
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 2번째 덱 소개는 얘는 모노클이 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.868,
                "end": 36.233
            },
            {
                "speaker_id": "1",
                "transcription": "공격적으로 호루라기 써가지고 이렇게 맞춰주고 퓨바랑 BTS를 쓰는데 얘는 언제 쓰냐면 상대방이 블루파이덱 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.243,
                "end": 45.705
            },
            {
                "speaker_id": "1",
                "transcription": "블루파이 방덱일 때 요거를 쓰게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.715,
                "end": 48.398
            },
            {
                "speaker_id": "1",
                "transcription": "블루파이 같은 경우에는 BTS 쿠키가 10초 기절 면역이 있기 때문에 디버프가 안 쌓이면은 블루파이가 좀 바보가 되는 경우가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.408,
                "end": 57.120
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 블파 저격 덱으로 쓰는데 나머지는 똑같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.130,
                "end": 60.987
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 쿨이랑 달빛 얘네는 아까랑 똑같고 퓨바도 똑같고 BTS도 올쿨로 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.997,
                "end": 67.768
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 실전으로 가서 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.778,
                "end": 69.605
            },
            {
                "speaker_id": "1",
                "transcription": "아 물론 여기 구간 자체가 티어가 높아가지고 승률이 여러분들이 원하는 그 상성있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.615,
                "end": 76.871
            },
            {
                "speaker_id": "1",
                "transcription": "예 무조건 진짜 승률이 막 90퍼센트 100퍼센트까지에 그런 엄청난 승률을 보기는 힘든 구간이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.881,
                "end": 85.113
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 상대방분들이 쿨이 다양하고 워낙 피감도 높고 그다음에 가장 큰 변수로 작용하는 치명타가 터지면은 딜러가 녹는 그림이 나오면 승리에 좀 변 변수가 나거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.123,
                "end": 99.310
            },
            {
                "speaker_id": "1",
                "transcription": "네 근데 이제 상대방 자",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.320,
                "end": 104.766
            }
        ]
    },
    "summary": "남성이 예언자는 끝자리가 치명타 확률 9로 맞춰야 설인 능력을 복사할 수 있고 2번째 소개하는 덱은 모노클이 없어서 호루라기를 쓰는데 블루파이 방덱일 때 사용한다고 하며 실전으로 가보면 티어가 높은 곳이라 엄청난 승률은 보기 힘든 구간이라고 말한다.",
