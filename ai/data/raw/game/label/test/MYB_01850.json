        "term": [
            {
                "speaker_id": "1",
                "transcription": "상성을 그냥 깨부수고 승부가 차이가 나거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.942
            },
            {
                "speaker_id": "1",
                "transcription": "야 한방덱이 그냥 제가 막고 이긴다는 거는 그마만큼 딴딴하다는 뜻이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.952,
                "end": 9.636
            },
            {
                "speaker_id": "1",
                "transcription": "지금 덱이 제가 아까 추천드린 두 번째 덱이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.646,
                "end": 13.733
            },
            {
                "speaker_id": "1",
                "transcription": "용과랑 홀베를 쓰고 가운데 달빛이랑 스타더스트를 쓰는 덱.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.743,
                "end": 19.711
            },
            {
                "speaker_id": "1",
                "transcription": "아까 이 두 번째 덱 얘는 토핑 설명 안 했나요 제가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.721,
                "end": 24.192
            },
            {
                "speaker_id": "1",
                "transcription": "저건 토핑 설명 안 한 것 같은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.202,
                "end": 27.166
            }
        ]
    },
    "summary": "남자는 한방덱을 막고 이긴다는 건 그만큼 단단하다는 뜻이라며 지금 덱이 용과랑 홀베를 쓰고 가운데 달빛이랑 스타더스트를 쓰는 덱이라고 한다.",
