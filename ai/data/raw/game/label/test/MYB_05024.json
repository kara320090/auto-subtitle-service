        "term": [
            {
                "speaker_id": "1",
                "transcription": "계정을 키운지 일주일 정도 어 되어 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.054
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 킹덤을 플레이한 건 2주 정도 되지만 현재 계정은 7일 차입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.064,
                "end": 7.742
            },
            {
                "speaker_id": "1",
                "transcription": "6만 원 정도 했고 한 달에 10에서 30만 원 정도의 중소 가구를 유지하려고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.752,
                "end": 12.837
            },
            {
                "speaker_id": "1",
                "transcription": "자 어떤 쿠키를 먼저 우선 순위로 키워야 되는지 우선 스토리를 보고 싶어서 스토리 덱을 짜주셨으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.847,
                "end": 20.765
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 아레나에서 현재 어떤 게 가장 베스트 덱인지 추천해 주셨으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.775,
                "end": 25.454
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 운영도 잘 되고 있는지 봐주세요.",
                "sound_type": [
