        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 스토리 모드를 제가 보여드렸습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.475
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들 보신 것처럼 거의 10을 기준으로 난이도가 있었다면은 지금은 3의 난이도가 됐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.077,
                "end": 8.430
            },
            {
                "speaker_id": "1",
                "transcription": "정말 깨기가 쉬워졌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.615,
                "end": 9.882
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 스토리를 깨기 위한 특별하게 키워야 되는 쿠키가 따로 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.155,
                "end": 15.255
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 공통적으로 여러분들이 키워야 될 쿠키들 아까 설명드린 대로 아레나나 그리고 토벌전 관련돼서 그런 공통적으로 묶이는 쿠키들을 써서 같이 키우면 좋다 이게 결론이고 토핑만 간단하게 추천드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.410,
                "end": 29.620
            },
            {
                "speaker_id": "1",
                "transcription": "자 무난하게 추천드리는 거기 때문에 정답이 아니고 여러분들이 이제 세팅할 때 평균적으로 남들이 하는 세팅으로 알려드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.830,
                "end": 36.900
            },
            {
                "speaker_id": "1",
                "transcription": "아레나나 다른 데에서는 콘텐츠에서는 다른 토핑일 수 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.032,
                "end": 42.308
            }
        ]
    },
    "summary": "스토리 모드는 10이 기존 난이도였다면 지금은 3의 난이도가 돼서 정말 쉬어졌기 때문에 스토리를 깨기 위해 특별하게 키워야 되는 쿠키가 따로 없으며 아레나나 토벌전 관련돼서 공통적으로 묶이는 쿠키들을 같이 키우면 좋다는게 결론이고 남성이 무난한 토핑을 추천할건데 평균적으로 남들이 하는 세팅이기 때문에 아레나나 다른 콘텐츠에서는 토핑이 달라질 수 있다.",
