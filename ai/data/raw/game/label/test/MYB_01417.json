        "term": [
            {
                "speaker_id": "1",
                "transcription": "빨리 끝낼 수 있다는 장점이 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.044
            },
            {
                "speaker_id": "1",
                "transcription": "이제 마지막날에는 가장 중요한 게 속도거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.054,
                "end": 7.566
            },
            {
                "speaker_id": "1",
                "transcription": "아레나가 빨리빨리 끝나는 것도 상당히 중요하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.576,
                "end": 10.975
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 이길 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.985,
                "end": 13.734
            },
            {
                "speaker_id": "1",
                "transcription": "자 가운데가 소르베덱일 때 한 번 가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.744,
                "end": 17.974
            },
            {
                "speaker_id": "1",
                "transcription": "잘 가운데에 스타더스타가 올 수도 있고 달빛술사도 올 수 있고 뭐 달빛술사, 스타더스트가 올 수도 있고 다양한 덱이 가려져 있기 때문에",
                "sound_type": [
                    2,
