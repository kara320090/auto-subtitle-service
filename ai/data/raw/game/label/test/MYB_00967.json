            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이건 칠리맛 쿠키의 어 스킬 사용 설명에 대해서 이렇게 나오고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.657
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 용감한 쿠키인가요 딸기맛 쿠키들에 대해서 설명이 나왔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.667,
                "end": 10.340
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이번에 자 해풍도사 이미 설계한 왕국 국지의 배치에 따라 관련 배치를 자신의 왕국 영토 안에 그대로 적용함으로써 빠르게 편리한 구축 작업 할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.350,
                "end": 22.492
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 쉽게 배치할 수 있는 왕국 꾸미기 편의 기능 같은 그런 느낌이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.492,
                "end": 26.650
            },
            {
                "speaker_id": "1",
                "transcription": "네 쿠키성 6레벨 때 요거 생산 도움 기능이 된다 저는 이게 왜 킹덤에도 와야 된다고 생각합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.660,
                "end": 34.503
            },
            {
                "speaker_id": "1",
                "transcription": "친구간의 서로 생산을 도와주는 기능 이거 정말 진짜 도입되야 된다고 생각합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.513,
                "end": 40.357
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 설탕노움연구소 조정 요거는 뭐 있는 기능인데 이게 정말 차별화된 기능이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.367,
                "end": 47.072
            },
            {
                "speaker_id": "1",
                "transcription": "잠시 광고 하나 하고 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.070,
                "end": 48.988
            },
            {
                "speaker_id": "1",
                "transcription": "챗캐시 어플은 어떤 건가요 간단하게 말하자면 여러분들이 카톡을 보낼 때 마다 캐시를 적립하고 적립된 캐시로 현금처럼 상점에서 다양한 상품으로 즉시 교환할 수 있는 어플입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.998,
                "end": 60.078
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들어 스타벅스 커피, 편의점 상품권을 이렇게 직접 구매 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.088,
                "end": 64.081
            },
            {
                "speaker_id": "1",
                "transcription": "추후에는 기프트 카드, 문화상품권 등 다양한 상품까지 추가될 예정이라 무료로 현질도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.091,
                "end": 69.447
            },
            {
                "speaker_id": "1",
                "transcription": "친구한테 메시지만 보내도 100캐시가 바로 적립되고 카톡만 해도 10캐시가 쌓입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.457,
                "end": 74.872
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 메시지 1이 사라짐 없이 확인하는 기능도 있어서 불편한 사람의 카톡도 걱정 없이 확인 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.872,
                "end": 80.475
            },
            {
                "speaker_id": "1",
                "transcription": "매일 사용하는 카톡과 함께 자동으로 쌓이는 캐시를 놓칠 필요는 없겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.485,
                "end": 84.534
            },
            {
                "speaker_id": "1",
                "transcription": "추가로 가입시 5000캐시를 드리고 이벤트로 2000캐시를 더 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.544,
                "end": 89.095
            },
            {
                "speaker_id": "1",
                "transcription": "단 고정 댓글에 있는 다운로드 링크로만 혜택을 받을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.105,
                "end": 93.228
            },
            {
                "speaker_id": "1",
                "transcription": "자세한 내용은 고정 댓글 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.238,
                "end": 95.537
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 새로운 기능 킹덤 코덱스 뭐 새로운 수집 시스템해서 분장, 의상수찰도감 업그레이드 이런 게 있다고 하는데 네 막 수집같은 시스템인 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.547,
                "end": 108.975
            },
            {
                "speaker_id": "1",
                "transcription": "네 그리고 신규 전용 뽑기 자 또 다른 이미지보면 칠리맛 쿠키 나왔을 때 이미지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 108.985,
                "end": 114.666
            }
        ]
    },
    "summary": "쉽게 배치할 수 있는 왕국 꾸미기 편의 기능 같은 것도 있고 친구간의 생산 도움을 줄 수 있는 기능도 있는데 이것도 한국에 도입이 시급하고 설탕노움연구소 조정이란 기능도 있으며 킹덤 코덱스라고 하는 수집 시스템도 있다.",
