        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "바로 가자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.543
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 승급 5성까지만 찍고 그다음에 리뷰하고 오철 또 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.553,
                "end": 5.999
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 하면은 체력이 16만 8천까지 올라가네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.009,
                "end": 12.108
            },
            {
                "speaker_id": "1",
                "transcription": "봅시다 일단 능력을.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.118,
                "end": 13.720
            },
            {
                "speaker_id": "1",
                "transcription": "솔방울맛 쿠키가 트리골렘에 탑승한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.730,
                "end": 16.863
            },
            {
                "speaker_id": "1",
                "transcription": "탑승하는 동안에 자신과 공격력이 가장 높은 아군 최대 두 명에게 회복을 시키며 그리고 가장 공격력이 높은 쿠키에게 솔방울 폭탄을 투척하고 기절시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.873,
                "end": 28.945
            },
            {
                "speaker_id": "1",
                "transcription": "자 솔방울 폭탄은 대상과 주변 적에게 범위 피해를 주고 범위 피해를 입힐 때 서리 디버프가 있을 경우 기절시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.955,
                "end": 37.768
            },
            {
                "speaker_id": "1",
                "transcription": "폭탄에 맞은 적이 기절 면역일 때 추가 피해를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.778,
                "end": 41.975
            },
            {
                "speaker_id": "1",
                "transcription": "폭탄 대상 피해량은 135퍼센트 및 기절 1.5초 폭탄 범위 피해량은 225퍼센트 폭탄 범위 피해량 피해 감소 무시는 이거 뭐야 피해 감소 무시 25퍼센트?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.985,
                "end": 53.918
            },
            {
                "speaker_id": "1",
                "transcription": "우와 잠깐만 이런 게 또 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.928,
                "end": 56.528
            },
            {
                "speaker_id": "1",
                "transcription": "이거 피감 무시는 좀 막강한데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.538,
                "end": 59.129
            },
            {
                "speaker_id": "1",
                "transcription": "폭탄 범위 대상 서리 디버프가 있을 경우 기절 0.3초 살짝 주네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.139,
                "end": 64.098
            },
            {
                "speaker_id": "1",
                "transcription": "기절 면역 대상에게 주는 추가 피해가 225퍼센트 트리골렘 탑승 체력 회복 공격력의 50퍼센트 1회 탑승 중 최대 체력 증가가 200퍼센트 야 두 배가 는다고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.108,
                "end": 77.318
            },
            {
                "speaker_id": "1",
                "transcription": "얘 같은 경우에는 기본 체력이 앞에 탱커임에도 불구하고 되게 생각보다는 지금 낮은 상태이긴 한데 그러니까 올 아몬드에서 2.8 이상 줄게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.328,
                "end": 87.437
            },
            {
                "speaker_id": "1",
                "transcription": "시작 쿨타임 3초로 한번 해봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.447,
                "end": 90.058
            },
            {
                "speaker_id": "1",
                "transcription": "일찍 써서 나쁠 건 없는 거 같애서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.068,
                "end": 94.500
            }
        ]
    },
