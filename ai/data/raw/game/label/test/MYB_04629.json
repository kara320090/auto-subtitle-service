        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 뭐야 아니 쌍 마들렌까지 마들렌도 여러분들 저거 마법 사탕 출시되면은 전성기가 옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.516
            },
            {
                "speaker_id": "1",
                "transcription": "공속 덱이 만약에 아레나에 다시 찾아오면은 재밌을 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.526,
                "end": 11.714
            },
            {
                "speaker_id": "1",
                "transcription": "지금 공속 덱 흑당밖에 안 쓰는데 메인으로 나중에 만들렌, 흑당 뭐 그 라일락 이런 애들 이제 종합세트로 다시 부활되면은 그 보는 재미가 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.724,
                "end": 23.112
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 뭐라 해야 될까 되게 캡틴캐비어가 한 방 막 진짜 치명타 터져서 터지고 약간 이런 느낌이잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.122,
                "end": 30.124
            },
            {
                "speaker_id": "1",
                "transcription": "근데 공속 덱이 한창 유행하게 되면은 화면에 그냥 엄청나게 막 화려하기 때문에",
                "sound_type": [
                    2
                ],
                "start": 30.134,
                "end": 37.198
            },
            {
                "speaker_id": "1",
                "transcription": "아니 뽑기 후에 나오는 이 브금 나만 적응 안 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.208,
                "end": 41.566
            }
        ]
    },
    "summary": "화자가 뽑기를 해서 나온 아이템에 대해서 설명을 하고 있다.",
