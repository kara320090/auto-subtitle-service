            },
            {
                "speaker_id": "1",
                "transcription": "프롤로그에서도 스킬 이펙트까지 바뀌었기 때문에 단순히 어그로가 아닌 진짜 현실적으로 업데이트가 다가왔다는 점 이번 영상에서 같이 확인해 봤습니다.",
                "sound_type": [
