                    3,
                    5
                ],
                "start": 3.364,
                "end": 14.790
            },
            {
                "speaker_id": "1",
                "transcription": "자 항상 저는 모든 쿠키의 리뷰를 업데이트 당일날 하고 있어요.",
                "sound_type": [
