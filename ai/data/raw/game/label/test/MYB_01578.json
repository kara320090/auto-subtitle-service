        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "한방덱으로는 정석덱한테는 들어가면 안 된다 그렇게 보시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.738
            },
            {
                "speaker_id": "1",
                "transcription": "홀 와는 정석덱으로 맞춰주면 되는데 여기 이 덱이 실론덱이 아니네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.748,
                "end": 10.556
            },
            {
                "speaker_id": "1",
                "transcription": "자 원래 여기 실론덱이면은 여기 찰스로 바꿔서 들어가야 되는데 이럴 경우에는 공속덱으로 바꿔서 공속덱이 어차피 한방덱을 막아주니까 이렇게 바꿔서 들어가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.566,
                "end": 21.098
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 많이 하시다보면은 그냥 어 상성이라기보다도 어 하다 보면은 알 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.108,
                "end": 29.638
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱은 이제 공속덱으로 잘 잡혀진다 그리고 홀와덱은 내 그냥 홀 용 정석덱으로 잘 잡혀진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.648,
                "end": 37.257
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 식으로 알고 맞춤으로 들어가시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.267,
                "end": 41.825
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 뭐 공식을 달달 외운다기보다도 변형된 덱이 워낙 많고 이것저것 헷갈린다고 해도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.835,
                "end": 50.466
            }
        ]
    },
    "summary": "변형된 덱에 맞춤 덱을 설명하고 공식을 외운다기보다 게임을 하다 보면 알 것이라고 한다.",
