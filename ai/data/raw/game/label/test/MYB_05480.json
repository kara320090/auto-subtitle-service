                    3,
                    5
                ],
                "start": 24.929,
                "end": 27.488
            },
            {
                "speaker_id": "1",
                "transcription": "아니 딜이 진짜 내가 이거 알잖아요 아레나 많이 해 봐서.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.498,
                "end": 31.423
            },
            {
                "speaker_id": "1",
