                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.183,
                "end": 14.023
            },
            {
                "speaker_id": "1",
                "transcription": "오 야 잠깐만 아니 이거 좀 딜이 좀 강하게 들어가긴 하네?",
                "sound_type": [
                    2,
                    3,
