        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어마 무시한 새로운 뭐 드래곤 적이 있는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.964
            },
            {
                "speaker_id": "1",
                "transcription": "신규 쿠키들도 여럿 보이고 있구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.974,
                "end": 7.520
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기 이 화면을 보면 신규 드래곤 보스같은 것과 용과드래곤 뒷쪽에 보이는 신규 쿠키 그리고 앞쪽에 우 우측하단에 보이는 신규 쿠키도 보이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.530,
                "end": 22.815
            },
            {
                "speaker_id": "1",
                "transcription": "자세히 보게 되면은 용과 드래곤 스킬은 저렇게 용의 이미지가 앞으로 튀어나오면서 용과 드래곤이 앞으로 질주해서 나오는 요런 형식이지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.825,
                "end": 33.498
            },
            {
                "speaker_id": "1",
                "transcription": "돌격형으로 나올지 아니면 침투형으로 나올지 뭐 구체적으로는 아 좀 봐야 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.508,
                "end": 39.741
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 용같은 경우에는 신규 보스로 스토리에 나올 것 같아요 제 예상으로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.751,
                "end": 46.966
            }
        ]
    },
    "summary": "새로 나오는 용과맛 쿠키의 스킬과 보스 용에 대해 스토리에 나올 것 같다고 예상한다.",
