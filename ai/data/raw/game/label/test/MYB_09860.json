        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 아줌마 오드아이인 거 되게 신비롭게 생겼어.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.609
            },
            {
                "speaker_id": "1",
                "transcription": "아 아 얘도 장인이었나 보다 만든 사람도.",
                "sound_type": [
                    2
                ],
                "start": 10.619,
                "end": 23.154
            },
            {
                "speaker_id": "1",
                "transcription": "아 진작 팔아 버렸대요.",
                "sound_type": [
                    2
                ],
                "start": 23.164,
                "end": 26.698
            },
            {
                "speaker_id": "1",
                "transcription": "음 달메키아에서 만났고.",
                "sound_type": [
                    2
                ],
                "start": 26.708,
                "end": 30.345
            },
            {
                "speaker_id": "2",
                "transcription": "아까 질이란 이름 가진 여성 있지 않았나요?",
                "sound_type": [
                    2
                ],
                "start": 30.355,
                "end": 32.754
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 주인공이 최상급 질의 가죽이라 말하다니 인간 사냥꾼이었군요.",
                "sound_type": [
                    2
                ],
                "start": 32.764,
                "end": 37.062
            },
            {
                "speaker_id": "1",
                "transcription": "오 그럼 질이 여러 마리 있었다는 거야?",
                "sound_type": [
                    2
                ],
                "start": 37.072,
                "end": 39.072
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 좀 무서운데?",
