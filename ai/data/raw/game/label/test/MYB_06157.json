    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 클사 100만 개 뽑기 하는데 90만 개까지 쓰고 10만 개는 남겨 달라 하셨거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.012
            },
            {
                "speaker_id": "1",
                "transcription": "뽑기권이란 뽑기권은 다 쓰고 다 해 달라고 하셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.022,
                "end": 9.997
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 스펙을 먼저 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.007,
                "end": 11.900
            },
            {
                "speaker_id": "1",
                "transcription": "야 스펙이 높진 않아요 이거 진짜 이 날을 위해서 정말 참고 또 참고 그렇게 뭐가 모아오신 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.910,
                "end": 19.834
            },
            {
                "speaker_id": "1",
                "transcription": "자 어마무시한 대박을 노려보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.844,
                "end": 22.866
            },
            {
                "speaker_id": "1",
                "transcription": "일단 길드 뽑기부터 가보자 자 길드 뽑기 60만 개 네 가볍게 요거 그러면 하고 가겠습니다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.876,
                "end": 28.724
            },
            {
                "speaker_id": "1",
                "transcription": "네 60만 개 뭐 빠르게 할 수 있으니까 60번 금방 하니까 네 슈크림도 다 뽑아 보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.734,
                "end": 35.405
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 60만 개면은 토핑도 많이 뽑고 오로라 재료도 많이 뽑고 슈크림도 아마 5성 될 거고 그 다음에 보물도 뭐 증표 같은 거 5성 될 거고 별사탕이랑 각종 길드 경험치 그냥 미쳤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.415,
                "end": 52.869
            },
            {
                "speaker_id": "1",
                "transcription": "한번에 폭탄으로 다 모을 수 있겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.879,
                "end": 54.755
            },
            {
                "speaker_id": "1",
                "transcription": "이중에서 가장 중요한 게 별사탕이겠죠 아무래도 쿠키 레벨 확장이 70 레벨이 됐기 때문에 별사탕 엄청나게 모자랄 텐테",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.765,
                "end": 62.672
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 수급을 한번에 많이 하실 수도 있고 재화가 오늘 아마 진짜 레전드로 쌓이는 날이 되지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.682,
                "end": 69.254
            },
            {
                "speaker_id": "1",
                "transcription": "이 분은 진짜 여러분들 스펙에서도 알 수 있겠지만 상당히 오랫동안 모아오신 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.264,
                "end": 76.631
            },
            {
                "speaker_id": "1",
                "transcription": "참고 또 참아서 야 뭐야 야 이렇게도 나오네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.641,
                "end": 81.737
            },
            {
                "speaker_id": "1",
                "transcription": "만 개 뽑기에서 슈크림이 3개가 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.747,
                "end": 84.502
            },
            {
                "speaker_id": "1",
                "transcription": "잘 뜨는 사람은 이렇게도 잘 뜬다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.512,
                "end": 88.100
            }
        ]
    },
    "summary": "한 구독자가 유튜버에게 자신의 게임 뽑기권을 대신 써 달라고 부탁했는데 뽑기권 100만 개 중 90만 개를 쓰고 10만 개는 남겨달라고 했습니다.",
