        "term": [
            {
                "speaker_id": "1",
                "transcription": "배치가 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.108
            },
            {
                "speaker_id": "1",
                "transcription": "스킬이 되게 다양한 거 같아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.118,
                "end": 2.694
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이거 지금 보는 거는 이거 서리여왕 스킬이네요? 그렇죠",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.704,
                "end": 7.219
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.229,
                "end": 8.782
            },
            {
                "speaker_id": "1",
                "transcription": "자 예언자 맛 쿠키는 7개의 예언 스킬을 구사하는 지원형 쿠키이다. 7개의 예언",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.792,
                "end": 13.386
            },
            {
                "speaker_id": "1",
                "transcription": "7개의 스킬을 가진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.396,
                "end": 15.556
            },
            {
                "speaker_id": "1",
                "transcription": "스킬을 보면 포춘 쿠키를 이용하여 7가지 예언 중 1가지를 예언한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.566,
                "end": 19.182
            },
            {
                "speaker_id": "1",
                "transcription": "어 예언 사용하면 아군을 회복 한다 그리고 이로운 효과를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.192,
                "end": 24.019
            },
            {
                "speaker_id": "1",
                "transcription": "이로운 효과 같은 경우는 모르는 분들을 위해서 말씀드리는데 이로운 효과가 증가되면은 아군이 받는 힐량이 증가합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.029,
                "end": 30.746
            },
            {
                "speaker_id": "1",
                "transcription": "공증 버프나 이런 버프의 지속 시간이 길어지는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
