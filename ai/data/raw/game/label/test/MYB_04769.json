        "term": [
            {
                "speaker_id": "1",
                "transcription": "분해하는 기준은 치명타 피해 부 감소 일단 분해하시고 해로운 감소도 분해하시고 이로운 효과도 분해하시고 그리고 공, 치 이런 거 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.903
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거는 한 2.5 이상은 살려두세요 2.5 이상은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.913,
                "end": 12.388
            },
            {
                "speaker_id": "1",
                "transcription": "체력 같은 것도 일단은 저는 분해합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.398,
                "end": 15.980
            },
            {
                "speaker_id": "1",
                "transcription": "방어력도 분해해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.980,
                "end": 17.052
            },
            {
                "speaker_id": "1",
                "transcription": "공격 속도 같은 경우에는 2퍼센트 이상은 일단은 남겨두시고 1퍼센트대는 그냥 다 분해하시고 쿨, 피는 무조건 강화하시고 근데 코인이 지금 많이 부족하잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.062,
                "end": 26.709
            },
            {
                "speaker_id": "1",
                "transcription": "이거 부족하니까 지금 강화는 당장에 하지 마시고 모으시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.719,
                "end": 30.857
            },
            {
                "speaker_id": "1",
                "transcription": "결론만 마치면은 마 말씀드리면은 이게 스펙이 낮다고 아레나 안 하는 건 절대 안 해서는 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.867,
                "end": 36.583
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 보상이 나중에 크탈 보상이나 이 메달 수급도 되게 중요하기 때문에 지금 목표는 딱 하나예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.593,
                "end": 43.398
            },
            {
                "speaker_id": "1",
                "transcription": "용구덱 필살기로 딱 하나만 제대로 세팅해도 스펙 차이 많이 나도 이기니까 그것만 하나만 노리세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.408,
                "end": 51.600
            }
        ]
    },
    "summary": "남성 화자가 분해하는 기준을 알려주고 강화는 당장에 하지 말고 모으라며 스펙이 낮아도 아레나는 해야 하고 용구덱 필살기로 하나만 제대로 세팅하라고 말한다.",
