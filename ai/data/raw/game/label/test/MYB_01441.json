        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 이렇게 다 뽑아드리네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.266
            },
            {
                "speaker_id": "1",
                "transcription": "와 와 와 바요까지 아니 아직 크탈도 많이 남았는데 이렇게 다양하게 다 뽑아드린다.",
                "sound_type": [
