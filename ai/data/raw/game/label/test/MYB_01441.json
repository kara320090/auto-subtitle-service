                    5
                ],
                "start": 3.276,
                "end": 18.817
            },
            {
                "speaker_id": "1",
                "transcription": "락스타도 잘 나왔네?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.827,
                "end": 22.951
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 얘도 타르트가 처음 나왔을 때는 솔직히 토벌에서 쓰일 각이 조금 보이나 싶었지만 너무 세서 좀 문제였는데 뭐 결국에는 쟤는 뭐 보스용이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.961,
                "end": 37.141
            },
            {
                "speaker_id": "1",
                "transcription": "예 수호성전 플러스 오 퓨바까지 야 결국엔 돌아가면서 다 나오네?",
