        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 업데이트해서 쥐도 새도 모르게 잠수 패치로 @이름1랑 @이름2 이 문구가 바뀌었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.270
            },
            {
                "speaker_id": "1",
                "transcription": "같이 보게 되면은 여기 보면 @이름1가 이렇게 돌진하게 되면 추가로 모든 아군 쿠키의 지속 피해, 간접 피해를 제외한 피해 일정량을 대신 흡수한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.270,
                "end": 17.300
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 원래 기존에 있던 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.300,
                "end": 18.930
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기서 중요한 게 피해 집중 지속 시간 중 본인을 포함한 아군 대상의 치명타 피해를 감소시키고 치명타 피해를 받은 횟수만큼 @이름1 시드 버프를 받는다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.930,
                "end": 29.770
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 여러분들이 알고 있던 거랑 다르죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.770,
                "end": 32.183
            },
            {
                "speaker_id": "1",
                "transcription": "홀리 시드 버프가 일정량 중첩되면 홀리 베리 버프로 변경된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.189,
                "end": 38.208
            }
        ]
    },
    "summary": "이번 업데이트로 바뀐 것이 있는데 원래 홀리베리는 돌진을 하면 아군 쿠키의 지속, 간접 피해를 제외한 피해 일정량을 대신 흡수하는데 여기에 피해 집중 지속 시간 중 본인과 아군의 치명타 피해 감소와 치명타 횟수만큼 홀리베리 시드 버프를 받는다고 한다.",
