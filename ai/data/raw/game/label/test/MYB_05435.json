        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아레나에서도 아주 엄청난 활약을 하고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.425
            },
            {
                "speaker_id": "1",
                "transcription": "바요는 이렇게 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.435,
                "end": 4.921
            },
            {
                "speaker_id": "1",
                "transcription": "이게 바요 공속덱이라고 해서 이렇게 쓰이고 있는데 아레나에서는 무조건 라즈만 해서 쓰면은 바요가 죽기 쉽기 때문에 라즈랑 아몬드랑 쿨 이렇게 섞어서 쓰고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.931,
                "end": 15.650
            },
            {
                "speaker_id": "1",
                "transcription": "요거 한번 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.660,
                "end": 18.192
            },
            {
                "speaker_id": "1",
                "transcription": "자 에스프레소 마탕과 바다요정과 함께 광역 딜이 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.202,
                "end": 23.992
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보게 되면은 쿨타임이 8초 9초 이렇게 같이 어 스킬 순서가 바요 먼저 그다음에 에스프레소 이렇게 연속으로 들어가는 그런 상태예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.002,
                "end": 34.995
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 흑당이 이렇게 딜 넣어주고 자 여기서 이어서 이어서 폭딜을 같이 넣어 주는 그런 그림을 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.005,
                "end": 49.666
            }
        ]
    },
    "summary": "바요는 공속덱으로 쓰이고 있는데 라즈만 사용하면 바요가 쉽게 죽기 때문에 라즈, 아몬드, 쿨을 섞어 쓰며 어떻게 하는지 직접 보여드린다.",
