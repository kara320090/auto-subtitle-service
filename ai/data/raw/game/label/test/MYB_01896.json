        "term": [
            {
                "speaker_id": "1",
                "transcription": "이동하는 방식입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.340
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 완주하면 크리스탈과 코인을 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.350,
                "end": 5.295
            },
            {
                "speaker_id": "1",
                "transcription": "한 가지 팁을 드리자면 이렇게 퍼펙이 안뜨면 느리게 걸어가죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.305,
                "end": 9.527
            },
            {
                "speaker_id": "1",
                "transcription": "퍼펙이 뜨지 않았을 때 나갔다가 다시 들어오면 바로 다음 기회로 빠르게 도전할 수 있는 걸 확인할 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.537,
                "end": 17.558
            },
            {
                "speaker_id": "1",
                "transcription": "나갔다 빠르게 들어오면 바로 도전을 할 수 있어서 시간 단축을 할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.568,
                "end": 21.470
            },
            {
                "speaker_id": "1",
                "transcription": "드림 브릿지는 도시 레벨 18레벨을 달성하면 할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.480,
                "end": 26.529
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 가족에 가입해서 가족 꾸미기도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.539,
                "end": 30.414
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 자신만의 가족 영토에 들어와서 꾸미기가 따로 가능하고요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.424,
                "end": 35.080
            },
            {
                "speaker_id": "1",
                "transcription": "가족 버프도 따로 받을 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.090,
                "end": 37.893
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 게임은 위탁 기능이 있어서 내가 굳이 안 꾸며도 친구가 대신 꾸며 줄 수 있는 위탁 기능이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.903,
                "end": 44.571
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 아기자기한 꾸미기와 다양한 미니 게임이 있는 마이 힐링 타운 여러분들 고정 댓글에 다운로드 링크와 제 오픈 톡방 링크 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.581,
                "end": 53.603
            },
            {
                "speaker_id": "1",
                "transcription": "저는 1서버에서 하고 있기 때문에 저랑 같이 하실 분은 프로필 눌러서 계정 관리 누르고 계정 연동해서 1서버로 오셔서 같이 하셔도 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.613,
                "end": 62.898
            },
            {
                "speaker_id": "1",
                "transcription": "1서버 아니더라도 게임 관련된 내용 공유 하실 분은 고정 댓글 제 오픈 톡방 오셔서 공유하시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.908,
                "end": 70.234
            },
            {
                "speaker_id": "1",
                "transcription": "다음 연상은 게임 관련된 팁 정보 공유 영상으로 찾아뵙도록 하겠습니다 감사합니다.",
                "sound_type": [
                    2,
