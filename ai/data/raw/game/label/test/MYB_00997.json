        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "보셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.670
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정은 레어 무공비급은 뚫지 못한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.680,
                "end": 15.722
            },
            {
                "speaker_id": "1",
                "transcription": "다시 돌아와서 여러분이 이렇게 질문할 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.732,
                "end": 18.860
            },
            {
                "speaker_id": "1",
                "transcription": "러너 님 바다요정을 활용한 다양한 덱 좀 보여주세요라고 물어보실 수도 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.870,
                "end": 24.248
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 준비해 봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.258,
                "end": 26.679
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키와 바다요정을 이용한 환상의 덱.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.689,
                "end": 31.019
            },
            {
                "speaker_id": "1",
                "transcription": "얘 리더 효과는 바다요정으로 가보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.029,
                "end": 34.421
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 같은 경우에는 홀리베리는 올 쿨 락스타는 피감 안 줬습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.431,
                "end": 38.007
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 바다요정이 워낙 물몸이기 때문에 먼저 죽어서 피를 채워주는 역할.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.017,
                "end": 42.729
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정은 올 라즈베리로 가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.739,
                "end": 44.925
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 블랙펄은 올 쿨 세트 효과 포함해서 쿨 21퍼센트.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.935,
                "end": 49.176
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스냅 드래건은 올 쿨로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.186,
                "end": 53.666
            }
        ]
    },
    "summary": "한 남성이 바다요정과 블랙펄을 조합한 덱을 만들고 있다.",
