        "term": [
            {
                "speaker_id": "1",
                "transcription": "조각이 잘 나오긴 했나 보네 진짜?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.149
            },
            {
                "speaker_id": "1",
                "transcription": "이거 이렇게 되네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.159,
                "end": 4.055
            },
            {
                "speaker_id": "1",
                "transcription": "이거 크탈로 주지 진짜 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.065,
                "end": 6.657
            },
            {
                "speaker_id": "1",
                "transcription": "이거 차라리 친구한테 선물이라도 주면 좋지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.667,
                "end": 9.459
            },
            {
                "speaker_id": "1",
                "transcription": "이거 여러분 가격으로 얼만 줄 아세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.469,
                "end": 11.880
            },
            {
                "speaker_id": "1",
                "transcription": "이거 7만 7000원인가 여러분?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.890,
                "end": 13.581
            },
            {
                "speaker_id": "1",
                "transcription": "이거 패키지 얼마에 팔지 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.591,
                "end": 14.856
            },
            {
                "speaker_id": "1",
                "transcription": "저 이거 7만 2000원으로 주세요 차라리.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.866,
                "end": 17.498
            },
            {
                "speaker_id": "1",
                "transcription": "다른 패키지로 바꿔주시면 안 될까요?",
