                ],
                "start": 5.968,
                "end": 13.866
            },
            {
                "speaker_id": "1",
                "transcription": "아직까지는 활용성에서는 걔네들은 만능이잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.876,
                "end": 18.414
            },
            {
                "speaker_id": "1",
                "transcription": "크탈 제일 많이 맡겨주신 분 150만 개 아 야 이제 끝났다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.424,
                "end": 23.785
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 고급으로 갑시다.",
                "sound_type": [
