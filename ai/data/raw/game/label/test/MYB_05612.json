        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 퓨바나와라님 계평인데 오늘은 수호의 성전 봐달라 하셨거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.825
            },
            {
                "speaker_id": "1",
                "transcription": "아 스킬 레벨이 중요한데 이거 스킬 레벨이 되게 커요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.835,
                "end": 9.556
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 이 정도 스펙이면은 다크가 낫지 않을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.566,
                "end": 13.569
            },
            {
                "speaker_id": "1",
                "transcription": "제 유튜브에 올린 영상대로 하려면은 자구마가 이 정도 스펙으로는 안 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.579,
                "end": 17.503
            },
            {
                "speaker_id": "1",
                "transcription": "차라리 그냥 다카가 나을 거 같아요.",
                "sound_type": [
                    2,
