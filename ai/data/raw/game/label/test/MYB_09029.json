        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러게 PC판이면은 모드 있을 수도 있겠다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.739
            },
            {
                "speaker_id": "1",
                "transcription": "저번에 보니까 이상한 메이드복 같은 거 입고 있고 뭐 그런 모드 있었던 것 같은데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.749,
                "end": 10.897
            },
            {
                "speaker_id": "1",
                "transcription": "아니면은 지금 하지말고 그거를 파트 2 나오기 전에 한번에 몰아서 할까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.907,
                "end": 16.238
            },
            {
                "speaker_id": "1",
                "transcription": "그게 나을지도?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.248,
                "end": 23.073
            },
            {
                "speaker_id": "1",
                "transcription": "운반업자가 있기 때문에 다양한 물건이 들어오는 거고 그렇게 운반한 술과 고기를 밀란 같은 상인이 내놓고 경비가 경비를 서주기 때문에 안심하고 장사를 할 수 있대.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.083,
                "end": 33.907
            },
            {
                "speaker_id": "1",
                "transcription": "마인드가 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.917,
                "end": 37.434
            },
            {
                "speaker_id": "1",
                "transcription": "주점 주인 좀 된 사람이네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.444,
                "end": 40.951
            },
            {
                "speaker_id": "1",
                "transcription": "서로 도우며 사는구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.961,
                "end": 44.219
            },
            {
                "speaker_id": "1",
                "transcription": "고생이 많아 보여요.",
                "sound_type": [
                    2,
