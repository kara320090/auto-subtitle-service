        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상은 프릴해파리 업데이트 이후에 초보자분들 복귀유저분들을 위한 쿠키런 킹덤 가이드 영상입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.883
            },
            {
                "speaker_id": "1",
                "transcription": "고인물분들은 이 영상을 보실 필요가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.893,
                "end": 10.347
            },
            {
                "speaker_id": "1",
                "transcription": "자 초보자분들은 이 게임을 시작했을 때 가장 먼저 신경 써야 될 건 이 쿠키성 레벨입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.357,
                "end": 16.211
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 성 레벨을 빠르게 12레벨까지 올려 주시면 각종 다양한 콘텐츠가 열리게 되는데 영토 확장도 여러분들 이렇게 쭉 열어서 이쪽 부분 그리고 자 이쪽 부분에 영토를 열게 되면 무역소 그리고 소다제도가 오픈되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.221,
                "end": 32.393
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 쿠키성 레벨을 올리게 되면 자 곰젤리 열차가 오픈되고 나서 여기를 통해서 오로라 재료도 수급되고 자 쿠키성 레벨 5레벨을 달성하면 설탕노움 연구소도 오픈됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.403,
                "end": 44.710
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅드래곤 쿠키도 얻을 수 있고 자 편하게 완구 생산 모아보기 기능도 추가할 수가 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.720,
                "end": 50.747
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 월드 탐험 진행하다 보면 자 수호 성전과 케이크 타워도 열리게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.757,
                "end": 56.205
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 길드 토벌전 아레나 다양한 콘텐츠도 오픈되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.215,
                "end": 60.906
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 영웅들의 신전까지 오픈되게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.916,
                "end": 64.033
            },
            {
                "speaker_id": "1",
                "transcription": "자 영웅들의 신전에서는 여러분들 5칸까지 여는 걸 추천드리고 자 별사탕은 여러분들 골고루 5개만 집중적으로 키워 주시고 레벨이 가장 낮은 쿠키가 기준 쿠키가 되고 그 기준 쿠키의 레벨이 등록되는 쿠키의 레벨로 정해지기 때문에 별사탕을 한 쿠키에만 몰빵으로 주지 말아 주시고 골고루 키워 주시면 됩니다.",
                "sound_type": [
                    2,
