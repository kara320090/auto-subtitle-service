        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 못 버텼네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.273
            },
            {
                "speaker_id": "1",
                "transcription": "야 저 이거 이기네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.283,
                "end": 7.663
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 이거 바요 공속 덱 지거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.673,
                "end": 10.427
            },
            {
                "speaker_id": "1",
                "transcription": "거의 질 확률도 많이 있는데 이건 이기네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.437,
                "end": 14.014
            },
            {
                "speaker_id": "1",
                "transcription": "바요를 5초월인데도 불구하고 이 덱한테 지는 경우가 많이 좀 나오고 비기거나 그런데 저게 아니 내가 볼 때는 지금 포인트가 딱 하나 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.024,
                "end": 22.769
            },
            {
                "speaker_id": "1",
                "transcription": "3성인데 왜 어떤 이런 성능이 나오냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.779,
                "end": 26.002
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거는 진짜 포인트 세게 줬다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.012,
                "end": 28.656
            },
            {
                "speaker_id": "1",
                "transcription": "낙뢰 및 소용돌이 피해 감소 무시 40퍼센트라는 게 여태까지 나오지 않았던 진짜 신규 옵션이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.666,
                "end": 35.400
            }
        ]
    },
