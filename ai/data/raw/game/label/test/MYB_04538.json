        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 클로티트.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.839
            },
            {
                "speaker_id": "1",
                "transcription": "야 그 종류별로 하나씩 다 나오나? 클로, 오일, 지금 바요랑 다크랑 그 2개만 안 나왔네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.859,
                "end": 12.100
            },
            {
                "speaker_id": "1",
                "transcription": "아 애교 어떠냐고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.100,
                "end": 13.610
            },
            {
                "speaker_id": "1",
                "transcription": "애교는 제가 인터넷에 나오는 애교는 웬만큼 다 해봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.620,
                "end": 17.000
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 쿠키런 오븐 브레이크 랜덤떼탈출할 때 최악이야 애교 이런 거 싹 다 다 해봤어. 벌칙으로.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.997,
                "end": 27.100
            },
            {
                "speaker_id": "1",
                "transcription": "아 야 잠깐만. 이번 뽑기는 아 좀 그렇다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.100,
                "end": 33.653
            },
            {
                "speaker_id": "1",
                "transcription": "왜 하필 홀리베리나 저런 게 나오는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.663,
                "end": 36.200
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 3개째 아닌가? 홀리베리 2개째에요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.194,
                "end": 40.760
            },
            {
                "speaker_id": "1",
                "transcription": "오 에픽은 잘 나와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.760,
                "end": 45.380
            },
            {
                "speaker_id": "1",
                "transcription": "아 무인도 가기 어때요? 무인도를 혼자 가라? 생존해 봐라 그 말씀인가? 무인도 가서?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.380,
                "end": 51.620
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 이제 쿠키런 유튜버가 아닌데 그러면은 더 이상?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.640,
                "end": 58.400
            }
        ]
    },
    "summary": "홀리베리가 너무 많이 나와서 뽑기가 별로라고 한다.",
