        "term": [
            {
                "speaker_id": "1",
                "transcription": "뒤에가 얼마나 치명이 잘 터졌는지가 관건이라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.035
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 결론은 이거다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.045,
                "end": 12.829
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 전방 0성이라도 되네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.839,
                "end": 15.013
            },
            {
                "speaker_id": "1",
                "transcription": "이거 승급 차이 별로 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.023,
                "end": 17.205
            },
            {
                "speaker_id": "1",
                "transcription": "상대방 스킬이 쿨 되게 느린 거 보니까 상대방 라즈 했나 보네 그런데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.215,
                "end": 21.738
            },
            {
                "speaker_id": "1",
                "transcription": "전방 탱커가 이 정도 성능이면 그냥 게임 끝이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.748,
                "end": 25.980
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 여기다가 용과 대신에 이 자리에다 넣고 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.990,
                "end": 29.730
            },
            {
                "speaker_id": "1",
                "transcription": "2탱 자리에다가 홀리베리랑 같이 써 보는 거 시너지 한번 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.730,
                "end": 33.357
            },
            {
                "speaker_id": "1",
                "transcription": "기존 덱한테 가보겠습니다.",
