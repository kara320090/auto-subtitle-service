        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 독버섯맛 쿠키가 잠수 패치로 엄청나게 딜이 상향 됐는데 유저분들이 이제 이게 맞냐 그렇게 문의를 보냈었고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.910
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 이제 데브에서 인지를 해서 그렇게 공지가 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.920,
                "end": 12.654
            },
            {
                "speaker_id": "1",
                "transcription": "자 6월 15일 날 이제 상향된 거 정확하게 공지가 나왔는데 기존에는 10초 동안 1초마다 46퍼센트 피해 70 기준이라고 원래는 공지가 있었는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.664,
                "end": 25.395
            },
            {
                "speaker_id": "1",
                "transcription": "6월 15일 날 데브도 인지해서 변경된 게 10초 동안 1초마다 69.1퍼센트의 피해를 준다 요렇게 수정 공지가 올라왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.405,
                "end": 35.733
            },
            {
                "speaker_id": "1",
                "transcription": "좀 차이가 엄청나게 많이 나고 그로 인한 어떤 효과가 일어났냐 토벌덱도 이제 독버섯덱으로 이렇게 바뀌어 버렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.743,
                "end": 44.608
            },
            {
                "speaker_id": "1",
                "transcription": "얼마나 좀 센 지 스토리에서 한번 보도록 할게요.",
