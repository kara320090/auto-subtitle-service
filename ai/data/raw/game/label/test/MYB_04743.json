        "term": [
            {
                "speaker_id": "1",
                "transcription": "일단 확실한 거는 5성이라도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.165
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 여러분들 지금 공속덱에도 좋고 그 정석덱, 증표덱 그냥 밸런스 파괴됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.175,
                "end": 27.622
            },
            {
                "speaker_id": "1",
                "transcription": "시작 쿨타임 2초로 진짜 너무 사기적인데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.632,
                "end": 34.029
            },
            {
                "speaker_id": "1",
                "transcription": "아니 야 근데 이거 너무 밸런스 오버 밸런스로 나온 느낌인데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.039,
                "end": 37.825
            },
            {
                "speaker_id": "1",
                "transcription": "내가 리뷰를 많이 해봤잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.825,
                "end": 40.221
            },
            {
                "speaker_id": "1",
                "transcription": "얘 쿠키 하나 넣었다고 지금 마을 생태계가 이렇게 확 바뀌는 것 보니까 이거 그냥 박살 났는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.230,
                "end": 46.562
            },
            {
                "speaker_id": "1",
                "transcription": "네 목화, 애클급이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.572,
                "end": 48.260
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳상어급이에요 나오자마자.",
