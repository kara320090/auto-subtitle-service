        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 빙결덱 두 가지 여러분들한테 알려드렸습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.086
            },
            {
                "speaker_id": "1",
                "transcription": "다시 한번 말씀드리지만 현재 빙결덱이 떡상 했으니까 여러분들한테 쓰세요 이런 뜻의 영상이 절대 아니고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.096,
                "end": 10.280
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신이나 스타더스트 달빛술사가 없는 분들 그래도 없는 쿠키들 대신에 빙결덱이라도 잘 세팅해서 아레나 좀 해보고 싶다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.290,
                "end": 17.686
            },
            {
                "speaker_id": "1",
                "transcription": "제가 정확히 말씀드리지만 그마 1에서는 빙결덱이 힘듭니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.696,
                "end": 20.906
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 마스터 구간이나 그마 2 사이까지는 빙결덱 세팅 정말 완벽하게 잘 하시는 분들은 아직도 잘 쓰고 있다는 점 고거 참고해서 빙결덱 세팅해서 공덱으로 쓰시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.916,
                "end": 34.192
            },
            {
                "speaker_id": "1",
                "transcription": "네 빙결덱 정말 몸이 약하기 때문에 피해감도 잘 챙겨 주시고 캡사이신이나 다른 달빛술사 이게 나오면은 그걸로 갈아타시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.202,
                "end": 43.359
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 빙결덱 리뷰는 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.369,
                "end": 62.075
            }
        ]
    },
    "summary": "빙결덱 정말 몸이 약하기 때문에 피해감도 잘 챙겨 주고 캡사이신이나 다른 달빛술사 나오면 그걸로 갈아타면 될 것 같다고 남자가 말하고 있다.",
