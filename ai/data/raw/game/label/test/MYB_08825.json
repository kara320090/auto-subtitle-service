        "term": [
            {
                "speaker_id": "1",
                "transcription": "나도 여름에는 발이 뜨거워서 잠을 못 잘 때도 있는 거 같아",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.313
            },
            {
                "speaker_id": "1",
                "transcription": "많았던 거 같아 이유가 뭘까?",
                "sound_type": [
                    2
                ],
                "start": 3.323,
                "end": 6.455
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 검색해 봤었는데 기억이 안 나네",
                "sound_type": [
                    2
                ],
                "start": 6.465,
                "end": 12.240
            },
            {
                "speaker_id": "1",
                "transcription": "안녕",
                "sound_type": [
                    2
                ],
                "start": 12.250,
                "end": 13.436
            },
            {
                "speaker_id": "2",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 13.446,
                "end": 14.764
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 14.774,
                "end": 19.784
            },
            {
                "speaker_id": "1",
                "transcription": "은령 상단이라는 거대 상인 집단의 일원인데",
                "sound_type": [
                    2
                ],
                "start": 19.794,
                "end": 22.509
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 22.519,
                "end": 25.759
            },
            {
                "speaker_id": "1",
                "transcription": "누나의 재능을 알아보고 상단에 들어오라고 권유하는 모양인데 누나도 싫지 않은 모양인 거 같대",
                "sound_type": [
                    2
                ],
                "start": 25.769,
                "end": 32.011
            },
            {
                "speaker_id": "1",
                "transcription": "누나한테 상인의 재능이 있고 운반업보다 낫겠지",
                "sound_type": [
                    2
                ],
                "start": 32.021,
                "end": 36.179
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 36.189,
                "end": 37.470
            },
            {
                "speaker_id": "1",
                "transcription": "누나는 줄곧 베어러를 보호해 왔는데 거기 너무 얽매여 있는 것 같아",
                "sound_type": [
                    2
                ],
                "start": 37.480,
                "end": 41.126
            },
            {
                "speaker_id": "1",
                "transcription": "구하고 싶다는 마음이 구해야만 한다가 된 게 아닐까 하고",
                "sound_type": [
                    2
                ],
                "start": 41.136,
                "end": 45.165
            },
            {
                "speaker_id": "1",
                "transcription": "내가 그 속박을 풀어주고 싶다.",
                "sound_type": [
                    2
                ],
                "start": 45.175,
                "end": 47.517
            },
            {
                "speaker_id": "3",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2
                ],
                "start": 47.527,
                "end": 48.514
            },
            {
                "speaker_id": "1",
                "transcription": "나는 행복했는데 이제 누마 누나가 행복해질 차례다.",
                "sound_type": [
                    2
                ],
                "start": 48.524,
                "end": 52.743
            },
            {
                "speaker_id": "1",
                "transcription": "은령 상단에 들어가는 일이 그 계기가 되면 좋을 텐데",
                "sound_type": [
                    2
                ],
                "start": 52.753,
                "end": 56.561
            },
            {
                "speaker_id": "1",
                "transcription": "이 일을 성공시켜서 누나를 기분 좋게 보내주고 싶어",
                "sound_type": [
                    2
                ],
                "start": 56.571,
                "end": 59.707
            },
            {
                "speaker_id": "1",
                "transcription": "그때까지 힘을 빌려줘 모찌롱다 이게 마지막 일이다.",
                "sound_type": [
                    2
                ],
                "start": 59.717,
                "end": 64.446
            },
            {
                "speaker_id": "1",
                "transcription": "최선을 다하겠다.",
                "sound_type": [
                    2
                ],
                "start": 64.456,
                "end": 65.799
            },
            {
                "speaker_id": "2",
