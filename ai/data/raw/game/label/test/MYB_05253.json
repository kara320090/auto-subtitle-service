        "term": [
            {
                "speaker_id": "1",
                "transcription": "새로운 방식으로 아 오케이 야 크림 유니콘 잘 나온다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.146
            },
            {
                "speaker_id": "1",
                "transcription": "근데 쿠키워즈는 나름 전 되게 재밌게 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.156,
                "end": 11.208
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키워즈 같은 그 요소를 여기 킹덤에다가 그냥 입하는 거 어때요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.218,
                "end": 16.243
            },
            {
                "speaker_id": "1",
                "transcription": "나름 그것도 재밌는데 5성까지 얼마 안 남았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.253,
                "end": 22.107
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 대비해서 얼마나 재화 준비를 해 두셨나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.117,
                "end": 25.860
            },
            {
                "speaker_id": "1",
                "transcription": "저는 한 50만 개 정도 될 것 같아 아 48만 개, 49만 개?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.870,
                "end": 30.338
            },
            {
                "speaker_id": "1",
                "transcription": "물론 재화를 다 쓸 건 아니지만 와 근데 진짜 잘 나온다 크림 유니콘만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.348,
                "end": 36.366
            }
        ]
    },
    "summary": "화자는 쿠키워즈를 재밌게 해서 킹덤에 입혀도 재미있을 것 같다고 한다.",
