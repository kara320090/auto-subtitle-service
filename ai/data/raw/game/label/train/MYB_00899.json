    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 주말에 재고를 쌓아서 20퍼센트 버프를 받아서 건네 주면은 코인을 좀 더 많이 받을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.916
            },
            {
                "speaker_id": "1",
                "transcription": "또한 생산 단계를 높이면 이렇게 추가적으로 50퍼센트 정도 추가 코인을 더 주거든요 그래서 생산 단계도 높여서 거래를 하시면 황금 쪽지는 코인을 더 많이 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.926,
                "end": 19.670
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 무지개 큐브 많이 부족하시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.680,
                "end": 22.222
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.232,
                "end": 27.439
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.449,
                "end": 32.011
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원 가격에 해당하는 가격인데 제가 무료로 나눠드리고 있는데 받는 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.021,
                "end": 43.800
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱을 다운로드 받으시고 우측 하단에 프로필을 누르시고 우측 상단에 톱니바퀴를 누르면 시크릿코드 입력하는데가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.810,
                "end": 53.906
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오ND러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.916,
                "end": 58.350
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 앱은 도대체 어떤 걸까 자 여러분들이 게임만 해도 자동으로 쌓이는 잼을 가지고 자 상점에서 여러분들이 원하는 기프트카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.360,
                "end": 69.588
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임하는데 여러분들한테 따로 광고가 뜨지도 않고요 방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.598,
                "end": 75.651
            },
            {
                "speaker_id": "1",
                "transcription": "자 시크릿 코트 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요 자세한 이벤트 확인은 고정 댓글을 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.661,
                "end": 84.485
            },
            {
                "speaker_id": "1",
                "transcription": "자 또한 코인 부족이 심하다 하시는 분들은 케이크 타워에서 열쇠 교환으로 코인 얻을 수도 있는데 코인을 케이크 타운에서 얻는 거는 살짝 비효율적이라고 생각은 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.495,
                "end": 96.097
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 더 좋은 상자들이 많기 때문에 층수를 최대한 많이 올라가고 더 좋은 상자를 오픈하는 걸 더 추천드린다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.095,
                "end": 104.010
            },
            {
                "speaker_id": "1",
                "transcription": "물론 250층까지 올라가지 못해서 열쇠가 많이 남는 분들은 상자를 많이 오픈하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 104.020,
                "end": 111.239
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 하나 사소한 팁이지만 자 여러분들이 토핑작할 때 무심코 그냥 돌지 마시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 111.249,
                "end": 117.483
            },
            {
                "speaker_id": "1",
                "transcription": "여기다가 보물을 자 요렇게 옮기시기만 해도 추가 코인을 받습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 117.493,
                "end": 123.037
            },
            {
                "speaker_id": "1",
                "transcription": "아니 저거 얼마나 더 한다고 저렇게 끼고 돌리시나요 네 쌓이고 쌓이면은 상당히 많아지기 때문에 자 이렇게 보물을 바꿔서 토핑작을 하시면 코인을 좀 더 벌 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 123.047,
                "end": 134.703
            },
            {
                "speaker_id": "1",
                "transcription": "자 알뜰살뜰하게 자 스페셜 에피소드 남는 깃털도요 자 이렇게 깃털 소모해서 코인도 얻어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 134.713,
                "end": 142.211
            },
            {
                "speaker_id": "1",
                "transcription": "자 절대 해선 안 되는 거는 크리스탈로 코인 구매 아무리 돈이 많은 분이라도 이건 절대 하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 142.221,
                "end": 149.073
            },
            {
                "speaker_id": "1",
                "transcription": "네 엄청나게 손해니까 교환 절대 하지 마시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 149.083,
                "end": 152.353
            },
            {
                "speaker_id": "1",
                "transcription": "또 하나 자 가끔가다가 패키지로 황금 코인 대박 패키지라고 해서 코인 왕창 파는게 있습니다 절대 사지 마세요 그것도 비효율 끝판 패키지입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 152.363,
                "end": 162.620
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 풍요의 분수 레벨 올리는 것도 상당히 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 162.620,
                "end": 166.034
            },
            {
                "speaker_id": "1",
                "transcription": "레벨을 올리면 올릴 수록 코인 생성량도 증가됩니다 풍요의 분수 레벨도 올려주세요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 166.044,
                "end": 172.179
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 오색 조개 갤러리에서 코인 이거 구매하는 사람도 있는데 이거는 사람마다 다릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 172.189,
                "end": 178.352
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우에는 구매는 딱히 안 하고요 왜냐하면 오색 조개 갤러리에서 따로 다른 걸 구매할 게 더 많아서 굳이 필요하신 분은 구매해서 제가 말리지는 않겠지만 더 가치 있는 거에 투자하는 걸 더 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 178.362,
                "end": 193.023
            },
            {
                "speaker_id": "1",
                "transcription": "자 무엇보다 여러분들이 가장 무시하는 게 이 수호성전 티켓이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 193.033,
                "end": 198.383
            },
            {
                "speaker_id": "1",
                "transcription": "제가 많은 계정 평가를 하다 보면 수호성전 티켓이 항상 가득 차있거나 방치하는 분들이 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 198.393,
                "end": 203.775
            },
            {
                "speaker_id": "1",
                "transcription": "자 수호성전에서 귀찮아도 한번 돌리면 이렇게 코인을 얻을 수가 있기 때문에 반드시 수호성전 돌려주셔서 코인을 얻어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 203.785,
                "end": 212.702
            },
            {
                "speaker_id": "1",
                "transcription": "자 코인 수급처는 이 정도로 알아봤고요 그다음에 크리스탈 수급처입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 212.702,
                "end": 217.191
            },
            {
                "speaker_id": "1",
                "transcription": "대표적으로 많이 얻을 수 있는 가장 중요한 수급처 월드탐험입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 217.201,
                "end": 221.690
            },
            {
                "speaker_id": "1",
                "transcription": "자 월드탐험에서는 3별 클리어하면 크리스탈 100개씩 계속 계속 얻을 수가 있고요 자 여러분들 일반모드 쭉 3별 클리어해서 얻고 그다음에 얻은 모드도 일반 스테이지 막히면 3별 클리어해서 쭈욱 모으시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 221.702,
                "end": 235.782
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 나서 모아지는 크리스탈로 쿠키 뽑기 해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 235.785,
                "end": 240.000
            }
        ]
    },
    "summary": "제가 이벤트로 무지개 큐브 3000개를 드리고 있으니 댓글창 확인해서 참여해 주시고 토핑작할 때 보물 옮기면 코인을 받을 수 있고 스페셜 에피소드 남는 깃털 등등 코인을 얻을 수가 있으니 코인이 아무리 부족해도 크리스탈로 코인 구매는 하면 안된다.",
