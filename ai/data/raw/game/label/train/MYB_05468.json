            },
            {
                "speaker_id": "1",
                "transcription": "이길 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.663,
                "end": 3.561
            },
            {
                "speaker_id": "1",
                "transcription": "아 못 죽였네요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.571,
                "end": 6.462
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 마탕 요거 재료 파밍 할 때 마법 공방 많이 이용하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.472,
                "end": 11.813
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 생산하지 마세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.823,
                "end": 13.493
            },
            {
                "speaker_id": "1",
                "transcription": "요거를 집중적으로 여기서 파밍 하시면 되거든요. 왜냐면 얘 같은 경우에는 수급처가 따로 없어요 마법 공방 밖에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.503,
                "end": 20.968
            },
            {
                "speaker_id": "1",
                "transcription": "얘를 먼저 만들고 얘네는 수급처가 많으니까 스토리 모드나 열기구나 따로 이벤트나 케이크 타워나 수급처 정말 많습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.978,
                "end": 29.576
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 여기서 생산 안 해도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.586,
                "end": 31.513
            },
            {
                "speaker_id": "1",
                "transcription": "1순위는 뱀파, 2순위는 에스프레소나 호밀인데 에스프레소보다는 그 토벌전이 더 중요해 져 가지고 뱀파랑 호밀 위주로 일단은 하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.523,
                "end": 41.517
            },
            {
                "speaker_id": "1",
                "transcription": "이제 여유가 있다 하시면은 에스프레소까지 자구마랑 우유는 현재로서는 굳이 당장 급한 건 아닙니다 여러분들.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.527,
                "end": 48.537
            },
            {
                "speaker_id": "1",
                "transcription": "지금 토벌전이 제일 중요해 졌기 때문에 이거 위주로 하시면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.547,
                "end": 53.147
            },
            {
                "speaker_id": "1",
                "transcription": "일단 올 마탕 덱 리뷰는 여기서 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.157,
                "end": 64.466
            }
        ]
    },
    "summary": "화자는 마법 공방에서 마탕 재료를 집중적으로 파밍 설탕 결정은 수급처가 많아 생산하지 말라고 하고 1순위는 뱀파, 2순위는 토벌전이 중요하기 때문에 호밀 위주로 키우고 여유가 있으면 에스프레소까지 키우고 자구마랑 우유는 굳이 당장 필요하지는 않다고 한다.",
