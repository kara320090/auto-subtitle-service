    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 @계정1 님 계정 평가를 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.559
            },
            {
                "speaker_id": "1",
                "transcription": "일단 시작한 지 얼마 안 되신 분이네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.569,
                "end": 6.236
            },
            {
                "speaker_id": "1",
                "transcription": "소원 나무 납품이 2400번에 쿠키성 12렙.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.246,
                "end": 10.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 시작 자체를 8월 20쯤 시작한 유저다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.316,
                "end": 14.904
            },
            {
                "speaker_id": "1",
                "transcription": "한 달 정도 이제 된 유저분이시고 일반 스토리 모드는 다 깼고 어드 모드도 지금 진행 중이고 그리고 창고 같은 경우에는 140칸.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.914,
                "end": 24.230
            },
            {
                "speaker_id": "1",
                "transcription": "일단 장기적으로 이거 200칸까지는 천천히 늘리세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.240,
                "end": 27.343
            },
            {
                "speaker_id": "1",
                "transcription": "지금 뭐 압박감이 안 들어서 당장 늘리는 건 아니지만 한 200칸까지 늘리는 게 좋고 일단 제고 상태가 오로라 재료 어느 정도 여유가 있으시네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.353,
                "end": 36.591
            },
            {
                "speaker_id": "1",
                "transcription": "저 오로라 재료 가지고 지금 쿠키 하우스가 레벨이 10레벨 다 찍으셨나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.601,
                "end": 41.383
            },
            {
                "speaker_id": "1",
                "transcription": "10레벨 다 찍으세요 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.393,
                "end": 42.777
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 지금 이거 2층 상태로 하시네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.787,
                "end": 45.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 계정 주인분 이거 업그레이드할 때는 이거 2층으로 하면 안 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.316,
                "end": 49.889
            },
            {
                "speaker_id": "1",
                "transcription": "분리해서 해야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.899,
                "end": 51.009
            },
            {
                "speaker_id": "1",
                "transcription": "2층으로 하면 손해봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.019,
                "end": 52.200
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 분리해서 업그레이드 꼭 하시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.210,
                "end": 55.160
            },
            {
                "speaker_id": "1",
                "transcription": "연구소 일단 먼저 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.170,
                "end": 56.633
            },
            {
                "speaker_id": "1",
                "transcription": "얘 대장간 먼저 10레벨 만렙을 찍어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.643,
                "end": 59.999
            },
            {
                "speaker_id": "1",
                "transcription": "생산 가속은 3레벨까지는 일단 찍어주시고 우유를 많이 찍어주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.009,
                "end": 64.107
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 많이 7, 8까지 일단 나중에 찍어주시고 일단은 여기 뒤에 연구 가속이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.117,
                "end": 70.165
            },
            {
                "speaker_id": "1",
                "transcription": "얘 많이 찍어주시고 가시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.175,
                "end": 72.058
            },
            {
                "speaker_id": "1",
                "transcription": "연구 가속 우선순위.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.068,
                "end": 73.476
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 연구보다는 얘부터 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.486,
                "end": 75.834
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 별사탕 얘 먼저 만렙 찍어주시고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.844,
                "end": 78.042
            },
            {
                "speaker_id": "1",
                "transcription": "얘 같은 경우에는 이거 만렙 찍고 그러는 동안 어느 정도 기본 재료 쌓일 때 쿠키 연구는 1씩 다 찍어주고 여유 생기면 이런 식으로 하고 우선순위 같은 경우에는 공급력, 체력.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.052,
                "end": 90.200
            }
        ]
    },
    "summary": "남성 화자가 시작한 지 한 달 된 유저의 계정 평가를 시작하고 잘못한 것들과 우선순위로 해야 될 것들을 알려준다.",
