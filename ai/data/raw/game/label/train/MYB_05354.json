        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 노란색후드티 님 계정 평가 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.794
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 분은 사연 자체가 현재 쿠키런 킹덤의 참 안타까운 현실을 보여주는 그런 상황인 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.804,
                "end": 11.335
            },
            {
                "speaker_id": "1",
                "transcription": "이번 길드전 정식 업데이트로 너무나 많이 바뀌어서 길드에 너무 피해가 가는 거 같아서 길드를 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.345,
                "end": 18.528
            },
            {
                "speaker_id": "1",
                "transcription": "이 분처럼 길드전 자체가 부담스러워 가지고 아예 게임을 길드에서 안 하고 나온 분들도 상당 수 있고 아예 게임을 접속 안 하거나 길드 추방 당하거나 그런 분들이 상당 수가 쫌 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.538,
                "end": 31.321
            },
            {
                "speaker_id": "1",
                "transcription": "토핑도 좋은 거 별로 없고 별사탕도 별로 없고 이번 업데이트 이후에 어떻게 뭘 해야 될지 알려주세요 이렇게 왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.331,
                "end": 39.129
            },
            {
                "speaker_id": "1",
                "transcription": "길드 토벌전 지금 출시하고 나서 업데이트 이후에 지금 유저가 많이 감소했거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.139,
                "end": 45.373
            },
            {
                "speaker_id": "1",
                "transcription": "문제가 뭐냐면은 이 3개의 보스를 전부 다 하는 게 너무 부담스럽다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.383,
                "end": 50.181
            },
            {
                "speaker_id": "1",
                "transcription": "조합도 많아지고 키워야 될 쿠키도 많아지고 토핑 난이도도 어렵고 토핑도 많이 필요하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.191,
                "end": 56.110
            },
            {
                "speaker_id": "1",
                "transcription": "쫌 안타까운 현실이 지금 나오고 있는데 한 번 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.120,
                "end": 60.773
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피시에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.783,
                "end": 64.908
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.918,
                "end": 68.249
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
