                "end": 10.452
            },
            {
                "speaker_id": "1",
                "transcription": "저거 다른 데로 하면 전투도 다시 해야 되네요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.462,
                "end": 13.529
            },
            {
                "speaker_id": "1",
                "transcription": "아 다시 1일차부터 다시 하라고?",
