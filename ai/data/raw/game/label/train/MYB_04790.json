        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 우유덱이구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.449
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 치명적인 약점이 우유네.",
