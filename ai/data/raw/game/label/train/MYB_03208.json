                    3,
                    5
                ],
                "start": 10.655,
                "end": 16.452
            },
            {
                "speaker_id": "1",
                "transcription": "나는 이번에 스킨 나온 거 다 너무 좋은 거 같은데 퀄리티가 다 좋은 것 같아요.",
                "sound_type": [
