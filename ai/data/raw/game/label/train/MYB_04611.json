    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 올 아몬드 조합 같은 경우에는 상대의 스킬을 피하기보다는 일단 버티면서 공격 들어가는 건데 이것도 특정 조합에서 쓰입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.953
            },
            {
                "speaker_id": "1",
                "transcription": "올 아몬드로 여러분들이 신경 써야 될 거는 쿨타임도 가장 중요하고 쿨타임이 상대의 이제 캡틴캐비어 같은 폭딜이 들어올 때 스킬 발동해서 무적화 상태로 딜을 안 맞는 그런 상태를 만들어 줄 때 쓰고 보통 이제 부옵션으로 챙겨줘야 될 거는 공격력 치명타 확률 이런 거 더 챙겨주면은 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.963,
                "end": 27.843
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 피해감소는 가장 최우선으로 여러분들이 높게 세팅을 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.853,
                "end": 33.010
            },
            {
                "speaker_id": "1",
                "transcription": "초월 된 거랑 안 된 거랑 차이가 심하냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.020,
                "end": 35.147
            },
            {
                "speaker_id": "1",
                "transcription": "일반적으로 1승급 당 쿠키레벨이 1레벨 정도 차이 난다고 보시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.157,
                "end": 39.373
            },
            {
                "speaker_id": "1",
                "transcription": "1에서 1.5레벨 정도 차이 아예 0성하고 5초월 된 사람하고는 쿠키 레벨 차이가 거의 한 최소 10레벨 이상 차이난다고 보시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.383,
                "end": 48.260
            },
            {
                "speaker_id": "1",
                "transcription": "전투력 가지고 여러분들 되게 질문이 많던데 아몬드로 하면 전투력 확 떨어지죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.270,
                "end": 53.327
            },
            {
                "speaker_id": "1",
                "transcription": "올 쿨로 하면은 또 전투력이 올라가고 가장 많이 올라가는 거는 라즈베리입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.337,
                "end": 57.709
            },
            {
                "speaker_id": "1",
                "transcription": "영상 이런 거 나가면 편집해서 나가면은 왜 러너님이랑 저랑 이렇게 전투력 차이가 많이 나나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.719,
                "end": 63.481
            },
            {
                "speaker_id": "1",
                "transcription": "자 공격력만 높게 이렇게 세팅이 되면 57만이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.491,
                "end": 68.171
            },
            {
                "speaker_id": "1",
                "transcription": "공격력이 높을 수록 전투력이 그냥 어마무시하게 올라가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.181,
                "end": 71.708
            },
            {
                "speaker_id": "1",
                "transcription": "이것만 비교하면 올 아몬드는 전투력이 43만 쿨에다가 애플젤리 섞은 게 53만 마지막에 라즈베리만 섞은게 57만 무조건 전투력이 높아서 좋은 게 아니라 조합에 따라 다르다는 것",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.718,
                "end": 82.992
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 의미가 없다는 것 그것만 여러분들이 체크하고 넘어가시면 되고 고인물분들은 다 알고 있지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.002,
                "end": 88.719
            },
            {
                "speaker_id": "1",
                "transcription": "심해의 공포에서 하나 여러분들이 좀 주의 깊게 봐야 될 부분이 공격속도가 감소된다는 거에 여러분들 좀 주목 해야 되고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.729,
                "end": 96.941
            },
            {
                "speaker_id": "1",
                "transcription": "망토 보물을 적용 받고 있을 때 블랙펄 쿠키가 저한테 만약에 심해의 공포 디버프를 주면은 망토 적용 대상이 바뀔 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.951,
                "end": 104.843
            },
            {
                "speaker_id": "1",
                "transcription": "보통은 블랙펄 쿠키 자체가 공속 버프 적용이 바뀌어요 얘로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 104.853,
                "end": 109.088
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 쿠키들은 다 디버프 받아서 마이너스 20퍼센트가 되기 때문에 그런 거 하나 체크해두고 가시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 109.098,
                "end": 117.633
            }
        ]
    },
