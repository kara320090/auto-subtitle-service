                    5
                ],
                "start": 2.263,
                "end": 3.537
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 방금 저거 속박 들어간 거는 들어간 건가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.547,
                "end": 9.986
            },
            {
                "speaker_id": "1",
                "transcription": "아 중간 보스 이상에서는 면역이라서 자 그러면 스타더스트 빼고 한번 가봅시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.996,
                "end": 17.711
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 속박 걸면은 블랙펄이 굳이 아몬드 쓸 이유는 없지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.721,
                "end": 21.492
            },
            {
                "speaker_id": "1",
                "transcription": "얘 버티려고 아몬드 쓰는 거라 네 이렇게 가보겠습니다.",
                "sound_type": [
