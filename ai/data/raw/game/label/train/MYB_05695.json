        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 덱은 어느 덱한테 들어가냐면 이런 덱한테 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.122
            },
            {
                "speaker_id": "1",
                "transcription": "전투력이 150만 미만 딱 봐도 가운데 클로티드가 있을 것 같고 낮은 덱들 이런 덱 위주로 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.132,
                "end": 10.587
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 모노클이나 증표나 깃털이나 상관없이 다 들어가고 또한 공속덱 있을 때 다 들어가면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.597,
                "end": 17.143
            },
            {
                "speaker_id": "1",
                "transcription": "160만 이하도 다 들어갈 건데 170만이 넘어가는 덱들은 이 덱을 이용해서 가면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.153,
                "end": 23.980
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱 같은 경우에는 세팅이 휘낭시에도 올콜 흑당도 올라즈 똑같죠 저거랑.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.990,
                "end": 28.748
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 아포가토가 올라즈 에클레어는 올쿨 이거 토벌에 쓰는 거 그대로 가져왔고 크림 유니콘은 아까 세팅이랑 똑같이 가는데 여기서 중요한 포인트는 휘낭시에의 버프가 흑당한테 가야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.744,
                "end": 40.043
            },
            {
                "speaker_id": "1",
                "transcription": "얘 둘 다 라즈이기 때문에 여기서 전투력이 높은 게 아닙니다. 댓글 보니까 저는 흑당이 전투력이 아포보다 높은데 왜 얘한테 버프가 안 가나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.053,
                "end": 49.585
            },
            {
                "speaker_id": "1",
                "transcription": "전투력을 기준으로 하는 게 아니라 공격력이 높은 사람한테 휘낭버프가 가는 거예요. 요 공격력 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.595,
                "end": 55.134
            },
            {
                "speaker_id": "1",
                "transcription": "요거 요걸 보셔야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.144,
                "end": 56.991
            },
            {
                "speaker_id": "1",
                "transcription": "이 공격력이 아포가토의 공격력보다 높아야 휘낭시에 버프가 받는 거라 그거 체크해 주셔서 이 덱 세팅해서 가시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.001,
                "end": 68.600
            }
        ]
    },
    "summary": "화자가 전투력이 기준이 아니라 공격력이 높은 사람한테 휘낭버프가 간다고 설명하고 있다.",
