        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 블루파이 3성. 밀키웨이 3성까지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.232
            },
            {
                "speaker_id": "2",
                "transcription": "함부로 마도서를 만졌다가는 무슨 일이 일어날지 모릅니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.242,
                "end": 10.731
            },
            {
                "speaker_id": "2",
                "transcription": "이 도서관에서 제가 모르는 것은 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.741,
                "end": 14.404
            },
            {
                "speaker_id": "2",
                "transcription": "마도 여러분들 이거 블루파이 키워야 되나요 이렇게 질문하는 분 혹시 있을까봐 말씀드리는데 얘 무조금 키워야 돼요. 왜냐하면 달빛 이벤트 할 때 블루파이로 아레나 이기기나 이런 거 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.414,
                "end": 25.589
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 반드시 키우긴 해야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.599,
                "end": 27.234
            },
            {
                "speaker_id": "2",
                "transcription": "꿀 이벤트나 성장 이벤트 뭐 둘 다 동시에 보상받을라면은 밀키웨이 성장 이벤트 다시 열까요? 아니요. 그거는 제가 볼 때 안 할 것 같은데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.244,
                "end": 35.098
            },
            {
                "speaker_id": "2",
                "transcription": "설마 또 하겠어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.108,
                "end": 37.959
            },
            {
                "speaker_id": "2",
                "transcription": "하면 좋지. 하면 이득이죠. 이벤트 아니라도 키워야 되나요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.969,
                "end": 42.718
            },
            {
                "speaker_id": "2",
                "transcription": "블루파이요? 네. 케이크 들개 이런 이벤트에서도 쓰입니다. 정리를 해야 되나?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.728,
                "end": 48.600
            }
        ]
    },
    "summary": "화자는 블루파이를 이벤트가 아니라도 키우는 게 좋다고 말한다.",
