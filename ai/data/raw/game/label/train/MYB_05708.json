        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 공속덱도 잡아내는 그림 볼 수 있다보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.000
            },
            {
                "speaker_id": "1",
                "transcription": "야 이 덱 너무 좋은데요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.000,
                "end": 7.320
            },
            {
                "speaker_id": "1",
                "transcription": "제가 리뷰를 하면서 여러 가지 써봤지만 얘 하나는 지금 상성상 너무 진짜 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.330,
                "end": 14.088
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 리뷰는 이 덱 적극 추천합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.088,
                "end": 19.000
            },
            {
                "speaker_id": "1",
                "transcription": "다크카카오나 다른 레전드 고대 슈퍼 에픽을 쓰지 않기 때문에 조금만 신경 써도 세팅은 가능할 것 같고 크림 유니콘이 여러분들 3성 2성 1성도 쓰입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.000,
                "end": 29.316
            },
            {
                "speaker_id": "1",
                "transcription": "승급이 낮더라도 여러분들 쓰시면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.316,
                "end": 32.194
            },
            {
                "speaker_id": "1",
                "transcription": "이거 세팅에서 제가 좀 중요하다고 생각하는 거는 에클레어 쿨이 상대보다 좀 빠르면은 진짜 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.204,
                "end": 39.740
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳상어도 뭐 쿨 좀 있으면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.750,
                "end": 42.763
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳상어를 이용한 공속덱 리뷰를 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.773,
                "end": 50.633
            }
        ]
    },
    "summary": "화자가 크림 유니콘이 3성 2성 1성이 쓰이고 있다고 설명하고 있다.",
