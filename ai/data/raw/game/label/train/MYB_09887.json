        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 노르방 요새 서문 나 아니 아까 갔었잖아 왜 안 되냐구 노르방 요새 서문.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.806
            },
            {
                "speaker_id": "1",
                "transcription": "동문 아 동문 서문이 어디야 그러면.",
                "sound_type": [
                    2
                ],
                "start": 9.816,
                "end": 15.084
            },
            {
                "speaker_id": "1",
                "transcription": "요새가 여기에 또 있는 거 아니잖아.",
                "sound_type": [
                    2
                ],
                "start": 15.094,
                "end": 18.621
            },
            {
                "speaker_id": "1",
                "transcription": "서문이 어디 있는데 서문이면 서쪽에 있어야지.",
                "sound_type": [
                    2
                ],
                "start": 18.631,
                "end": 23.089
            },
            {
                "speaker_id": "1",
                "transcription": "가만 있어봐 동문으로 가면 서문이 나올지도 모르니까.",
                "sound_type": [
                    2
                ],
                "start": 23.099,
                "end": 30.680
            },
            {
                "speaker_id": "1",
                "transcription": "아니 나 아는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.690,
                "end": 33.100
            },
            {
                "speaker_id": "1",
                "transcription": "저 동문이랑 서문 알아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.110,
                "end": 36.058
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아까 서쪽으로 계속 갔잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.068,
                "end": 38.791
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기가 동문이래 근데 서문은 안보이잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.801,
                "end": 41.379
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 서쪽으로 계속 갔지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.389,
                "end": 50.097
            },
            {
                "speaker_id": "1",
                "transcription": "이런 씨.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.107,
                "end": 52.966
            }
        ]
    },
    "summary": "여자가 노르방 요새 서문이 어디 있는지 찾고 있다.",
