        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 영상을 보면은 여러분들이 우유맛 쿠키가 정말 떡상에서 0티어가 됐으니까 여러분들 키워 주세요 라는 영상이 절대 아니고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.842
            },
            {
                "speaker_id": "1",
                "transcription": "아 이렇게 랭커분들이 특정 덱을 겨냥해서 저격덱으로 우유맛 쿠키를 활용할 수 있구나 이렇게 여러분들이 참고해 주시면 될 것 같고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.852,
                "end": 16.687
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱은 순수히 딱 하나의 덱을 목적으로 저격으로 만들어진 세팅이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.697,
                "end": 21.992
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파이어맛 쿠키가 있고 그다음에 공속증표덱 이 덱 하나에 대해서 승률이 엄청나게 높은 덱입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.002,
                "end": 28.772
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 세팅을 먼저 말씀해 드리면은 우유맛 쿠키 같은 경우에는 어 2.8퍼센트 이상 여러분들이 세팅해 주시면 되는데 보시다시피 표에서 2.8퍼센트 이상이면은 시작 쿨타임이 4초에서 3초로 바뀐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.782,
                "end": 41.524
            },
            {
                "speaker_id": "1",
                "transcription": "고거 참고해 주시고 휘낭시에 같은 경우에는 쿨 23퍼센트 이상, 피해감소는 여러분들 능력껏 높게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.534,
                "end": 47.601
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 캡틴캐비어 같은 경우에도 쿨 8퍼센트 맞춰 주시고 피감은 여러분들 능력껏",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.611,
                "end": 52.401
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키는 쿨 8퍼센트, 피감 여러분들 가능한 높게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.411,
                "end": 56.030
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘은 이게 정말 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.040,
                "end": 58.158
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘 쿨 때문에 승패가 좀 갈리는 경우가 많거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.168,
                "end": 61.028
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘의 쿨은 20퍼센트에서 22퍼센트 사이",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.038,
                "end": 64.544
            },
            {
                "speaker_id": "1",
                "transcription": "너무 쿨이 높아도 안 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.554,
                "end": 66.942
            },
            {
                "speaker_id": "1",
                "transcription": "20에서 22퍼센트 사이로만 여러분들이 세팅해 주시면 좋을 것 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.952,
                "end": 73.270
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.280,
                "end": 76.477
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.487,
                "end": 79.712
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.722,
                "end": 84.566
            }
        ]
    },
    "summary": "남자는 이 영상을 보고 우유맛 쿠키가 떡상에서 0티어가 됐으니까 키워 달라는 게 아니고 랭커분들이 특정 덱을 겨냥해서 저격덱으로 우유맛 쿠키를 활용할 수 있다는 것을 참고해 주면 될 것 같다며 이 덱은 순수히 딱 하나의 저격덱을 목적으로 만들어진 세팅으로 뱀파이어맛 쿠키가 있고 공속증표덱 이 덱 하나에 대해서 승률이 엄청나게 높은 덱이라고 한다.",
