        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 딜이 나쁘지가 않아서 바요도 성능은 내가 볼 때 딜적인 면에서 시너지 좋게 쓰면 좋을 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.040
            },
            {
                "speaker_id": "1",
                "transcription": "그쵸 추월 높으면은 더 좋아지죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.050,
                "end": 11.059
            },
            {
                "speaker_id": "1",
                "transcription": "오 여기 방깎 들어갔죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.069,
                "end": 13.319
            },
            {
                "speaker_id": "1",
                "transcription": "아이 설마 얘 토벌에서 뭐 방깎으로 쓰이거나 그런 극혐은 아니겠지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.329,
                "end": 20.855
            },
            {
                "speaker_id": "1",
                "transcription": "토벌에서 에이 그거 아닐 거야 설마.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.865,
                "end": 24.806
            },
            {
                "speaker_id": "1",
                "transcription": "까 딜적인 면으로 쓰는 건 아니라 진짜 방깎용으로 쓰는 것 같아요.",
                "sound_type": [
                    2,
