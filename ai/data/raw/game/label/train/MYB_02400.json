        "term": [
            {
                "speaker_id": "1",
                "transcription": "한 10연승 정도 하고 나서 영상을 찍는 건데 결론만 말씀드리면은 캡사이신 왜 키우나 이건 도대체 왜 키우나 그 생각이 딱 들더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.969
            },
            {
                "speaker_id": "1",
                "transcription": "슈퍼 에픽으로 힘들게 과금 많이 하고 힘들게 키웠지만 지금으로써는 키울 이유가 1도 없어 보입니다. 현재 자색 고구마만 보면",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.979,
                "end": 17.201
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음 분도 캡사이신 덱 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.211,
                "end": 22.186
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 이 덱이 스킬 순서가 요렇게 쭉 가는 거 똑같이 따라드는지 여러분들 파악을 해야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.196,
                "end": 29.062
            },
            {
                "speaker_id": "1",
                "transcription": "자색 고구마가 홀리베디 다음에 스킬 쓰는지 네 꼭 그거를 확인해 주셔야 좋을 것 같아요.",
                "sound_type": [
                    2,
