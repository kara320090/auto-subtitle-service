            },
            {
                "speaker_id": "1",
                "transcription": "네 그다음에 비석이 떨어집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.460,
                "end": 5.203
            },
            {
                "speaker_id": "1",
                "transcription": "자 비석 떨어지기 전에 자 마카롱 1번 눌러줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.213,
                "end": 9.474
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림 예약은 끊어주면 안 돼요.",
