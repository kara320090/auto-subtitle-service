                    3,
                    5
                ],
                "start": 9.484,
                "end": 11.760
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱 연타해서 누르면은 이거 대기 풀려가지고 오먹 발동되니까 얘는 대기 걸려있는 상태에서 마카롱 쿨 되는대로 바로 눌러주구요.",
                "sound_type": [
