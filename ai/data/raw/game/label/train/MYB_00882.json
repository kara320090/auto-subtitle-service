        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 29강일 때 보면은 방덱 방어 성공률이 뭐 잘 나올 때도 잘 막지만 한 50퍼센트 정도다 질땐 뭐 연달아 다 지고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.134
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 제가 이제 밤새 봤을 때 보시면은 스펙이 높은 분들이 다 들어오는데 어느 정도 보면은 30강 찍고 나서 방어 성공률이 여러분들이 봐도 높아진 게 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.144,
                "end": 20.227
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 차이가 나게끔 좀 더 좋아졌단게 보이니까 아무래도 30강은 차이가 난다는 게 방어덱으로도 보이고 공격덱으로도 보이고 그거를 제가 좀 보여드리고 싶었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.225,
                "end": 33.225
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 제가 또 하나 말씀드리고 싶은 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.235,
                "end": 35.747
            },
            {
                "speaker_id": "1",
                "transcription": "아마 영상 보시는 분들 중에 고민하시는 분들 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.745,
                "end": 39.057
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그럼 러너님 아니 블랙펄 그럼 파밍을 할까요 바다요정 파밍을 할까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.057,
                "end": 44.031
            },
            {
                "speaker_id": "1",
                "transcription": "아니 지금 러너님은 지금 블랙펄이 좋다고만 리뷰를 하시는데 저는 사실 바다요정이 더 좋은 사람도 있고 바다요정이 더 스펙이 높은 사람도 있고 이거를 저는 아직도 고민하고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.041,
                "end": 54.661
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 또 하나 신규 쿠키가 나와서 바다요정이 더 좋아지면 어떡하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.671,
                "end": 59.192
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 하나 말씀드리고 싶은 점은 아까도 말씀드렸지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.202,
                "end": 63.700
            }
        ]
    },
    "summary": "29강일 때 보다는 확실히 30강일 때가 공격덱으로도 방어덱으로도 좋아진 게 보인다.",
