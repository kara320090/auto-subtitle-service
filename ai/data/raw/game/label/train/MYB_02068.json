        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 다음 신규 드래곤 쿠키와 관련된 정보가 유출 되었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.761
            },
            {
                "speaker_id": "1",
                "transcription": "자 이미 여러분들 로딩 화면에서 신규 드래곤 이미지를 볼 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.771,
                "end": 8.123
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기 확대하면은 조그많게 보이는 쿠키 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.133,
                "end": 11.886
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 쿠키가 바로 다음 신규 스페셜 쿠키로 등장할 예정이라고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.896,
                "end": 17.440
            },
            {
                "speaker_id": "1",
                "transcription": "자 유출 내용이긴 하지만 여러분들 자세히 좀 보게되면 신규 쿠키는 스냅드래곤이라고 하고 능력은 보호되고 그들의 기술은 특정 치유 갭을 무시합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.450,
                "end": 28.352
            },
            {
                "speaker_id": "1",
                "transcription": "한 마디로 이게 무슨 뜻이냐면은 소르베처럼 내가 힐량을 받았을 때 최대 체력을 다 채우고 나서도 힐량을 더 없으면 추가적으로 체력이 게이지가 더 생기면서 늘어난다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.362,
                "end": 40.275
            },
            {
                "speaker_id": "1",
                "transcription": "약간 그런 느낌 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.285,
                "end": 41.767
            },
            {
                "speaker_id": "1",
                "transcription": "정확하게 나오진 않았지만 좀 더 힐량을 자기 체력처럼 오바돼서 채울 수 있는 그런 노력으로 보이는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.777,
                "end": 50.037
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 중요한 건 이 쿠키는 BTS쿠키처럼 특수 무적이라고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.047,
                "end": 55.073
            },
            {
                "speaker_id": "1",
                "transcription": "특수 무적이면 지금 현재 BTS쿠키가 독보적으로 특수무적으로 0티어로 쓰이고 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.083,
                "end": 61.434
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 BTS 쿠키는 1월 20일 업데이트 이후에 신규 유저분들이나 복귀 유저분들이 뽑을 수가 없는 상태입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.444,
                "end": 69.047
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 능력도 좋고 현재 아직도 0티어로 쓰이고 있기 때문에 데브시스터즈 게임 회사에서 다음 업데이트 때는 BTS 대체 쿠키로 어 신규 스페셜 쿠키가 출시되도록 준비중인 느낌인 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.057,
                "end": 82.922
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 그 다음 유출된 내용은 스냅드래곤 쿠키는 뭐 스페셜 등급이고 콜라보로 나오는 쿠키 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.932,
                "end": 90.879
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뭐 협업이 된다 이런 거는 아직 모르겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.889,
                "end": 93.719
            },
            {
                "speaker_id": "1",
                "transcription": "특별하면서도 독창적인 한복의 의상처럼 한정 쿠키처럼 나올 수도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.729,
                "end": 98.537
            },
            {
                "speaker_id": "1",
                "transcription": "이런 내용이 또 유출이 있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.547,
                "end": 102.866
            }
        ]
    },
