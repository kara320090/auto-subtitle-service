                ],
                "start": 0.000,
                "end": 1.440
            },
            {
                "speaker_id": "1",
                "transcription": "아니 소르베가 다 했네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.450,
                "end": 5.120
            },
            {
                "speaker_id": "1",
                "transcription": "아니 잠깐만 뭐야 이거.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.130,
                "end": 7.734
            },
            {
                "speaker_id": "2",
                "transcription": "겨울이 오고 있어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.744,
                "end": 9.260
            },
            {
                "speaker_id": "3",
                "transcription": "자극하면",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.260,
                "end": 10.530
            },
            {
                "speaker_id": "1",
                "transcription": "아니 뭐 서리는 내가 뭐 하는지를 모르겠어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.530,
                "end": 13.245
            },
            {
                "speaker_id": "4",
                "transcription": "빛이 인도하실 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.255,
                "end": 15.371
            },
            {
                "speaker_id": "1",
                "transcription": "서리가 뭐 하는지 모르겠는데 소르베가 다 해먹네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.381,
                "end": 19.054
            },
            {
                "speaker_id": "1",
                "transcription": "어우야 딜 반토막 난 거 실화냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.064,
                "end": 21.322
            },
            {
                "speaker_id": "1",
                "transcription": "아 서리가 중첩해서 세진 거 아니냐고요?",
                "sound_type": [
                    2
                ],
                "start": 21.332,
                "end": 23.959
            },
            {
                "speaker_id": "1",
                "transcription": "아 서리 디버프 중첩시켜줘서?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.969,
                "end": 26.396
            },
            {
                "speaker_id": "1",
                "transcription": "서리 그냥 라즈로 하자고요?",
                "sound_type": [
                    2
                ],
                "start": 26.406,
                "end": 27.864
            },
            {
                "speaker_id": "1",
                "transcription": "아 그렇게 한번 해 보긴 해볼게요.",
                "sound_type": [
                    2
                ],
                "start": 27.874,
                "end": 29.189
            },
            {
                "speaker_id": "1",
                "transcription": "라즈로 원하니까.",
                "sound_type": [
                    2
                ],
                "start": 29.199,
                "end": 30.848
            },
            {
                "speaker_id": "1",
                "transcription": "자 요 덱한테 가보겠습니다 라즈.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.858,
                "end": 34.033
            }
        ]
    },
