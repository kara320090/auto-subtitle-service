        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 또 3개 또 나왔어 야 이게 가능하구나",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 3.225
            },
            {
                "speaker_id": "1",
                "transcription": "마일리지 엄청 쌓였구요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.235,
                "end": 7.272
            },
            {
                "speaker_id": "1",
                "transcription": "이거 슈크림이 너무 잘 뜨는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.282,
                "end": 11.171
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들 길드 뽑기 요거 신경 안 쓰는 분도 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.181,
                "end": 14.909
            },
            {
                "speaker_id": "1",
                "transcription": "좋은 길드 들어가야 되는 이유 중에 하나가 이 재화 쌓이는 거 누적하면은 정말 차이 엄청 많이 나거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.919,
                "end": 22.085
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 최대한 여러분들 토벌 신경 써서 높은 길드 들어가세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.095,
                "end": 26.234
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 높은 용까지 올라가는 길드는 재화 쌓이는 양 자체가 달라요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.244,
                "end": 36.344
            },
            {
                "speaker_id": "1",
                "transcription": "야 좋아 좋아 좋아 이거 보세요 증표도 이제 만랩 거의 다 돼갈 텐데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.354,
                "end": 41.138
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 모노클은 만랩 됐어요 모노클 만랩 찍었고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.148,
                "end": 46.729
            },
            {
                "speaker_id": "1",
                "transcription": "증표도 이제 만랩을 찍고 싶은데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.739,
                "end": 50.600
            }
        ]
    },
    "summary": "유튜버는 좋은 길드에 들어가야 되는 이유 중에 하나가 재화가 누적되면 차이가 엄청 많이 나기 때문에 최대한 토벌을 신경 써서 높은 길드에 들어가야 한다고 합니다.",
