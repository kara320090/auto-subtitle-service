        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이거는 현재 상대방 분이랑 미러전을 하고 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.254
            },
            {
                "speaker_id": "1",
                "transcription": "이게 랭커분들 사이에서는 이미 퍼졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.264,
                "end": 5.796
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱은 리사 님이 만드신 덱인데 상당히 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.806,
                "end": 10.569
            },
            {
                "speaker_id": "1",
                "transcription": "이게 좀 많이 널리 퍼졌죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.579,
                "end": 12.896
            },
            {
                "speaker_id": "1",
                "transcription": "이게 왜 그런데 크런치를 써 가지고 쓰는 이 덱이 왜 좋은가요라고 물어보시면은 54초, 55초 그때 한번에 스킬이 딱 들어가서 상대 피를 확 갑자기 확 다 빼거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.906,
                "end": 28.125
            },
            {
                "speaker_id": "1",
                "transcription": "왜 상대가 그때를 못 버티고 죽는 경우가 대부분 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.135,
                "end": 31.866
            },
            {
                "speaker_id": "1",
                "transcription": "그걸 노리고 정확히 만든 덱이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.876,
                "end": 35.210
            },
            {
                "speaker_id": "1",
                "transcription": "네 최상위 랭커분 방 덱도 한번 제가 뚫어보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.220,
                "end": 39.299
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거는 아마 못 뚫을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.309,
                "end": 41.729
            },
            {
                "speaker_id": "1",
                "transcription": "서리, 소르베 덱한테 약합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.739,
                "end": 43.659
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱의 유일한 약점이 빙결 덱한테 약한 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.669,
                "end": 46.923
            },
            {
                "speaker_id": "1",
                "transcription": "아까도 졌다고 나오는 판이 소르베랑 서리 덱한테 작 졌거든요.",
                "sound_type": [
                    2
                ],
                "start": 46.933,
                "end": 53.190
            },
            {
                "speaker_id": "1",
                "transcription": "아니면은 예언자덱, 빙결덱한테도 졌는데 한번 보겠습니다 결과를.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.200,
                "end": 58.043
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 모든 덱이 완벽한 덱이 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.053,
                "end": 62.410
            },
            {
                "speaker_id": "1",
                "transcription": "약한 조합이 상성이라는 게 따로 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.420,
                "end": 68.166
            }
        ]
    },
    "summary": "리사 님이 만든 덱은 54초, 55초에 스킬이 들어가서 상대가 못 버티고 죽는 경우기 많은데 그걸 노리고 만든 거라 상당히 좋고 방 덱은 빙결 덱한테 약한 거 같고 모든 덱은 완벽하지 않다.",
