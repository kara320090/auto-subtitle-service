    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "상위권에서 많이 사용되고 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.054
            },
            {
                "speaker_id": "1",
                "transcription": "자 호루라기는 샤이닝클리터랑 레모네이드한테 가면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.064,
                "end": 6.062
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이거 따로 이제 어제 올린 영상보다 좀 더 최적화해서 토핑을 만들어봤고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.072,
                "end": 12.072
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 올 쿨, 락스타는 전 피감을 아예 안 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.082,
                "end": 15.424
            },
            {
                "speaker_id": "1",
                "transcription": "레모네이드는 올 라즈베리 호루라기를 받아야 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.434,
                "end": 18.494
            },
            {
                "speaker_id": "1",
                "transcription": "샤이닝글리터는 4 라즈 1 애플젤리 올 라즈베리해도 괜찮은데 전 애플젤리 하나 섞어줬고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.504,
                "end": 24.554
            },
            {
                "speaker_id": "1",
                "transcription": "네 쿨 공속 둘 다 없이 공, 치에만 집중적으로 투자를 했고 피의 감소 높게 자 그리고 블랙펄은 호루라기를 받지 말아야 되기 때문에 라즈베리 섞지 않고 올 애플젤리로 쿨 공속은 없어도 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.564,
                "end": 37.572
            },
            {
                "speaker_id": "1",
                "transcription": "자 좀 더 여유가 있다면은 샤이닝클리터도 치피감 높여서 저는 생존을 좀 더 높여줬고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.582,
                "end": 43.138
            },
            {
                "speaker_id": "1",
                "transcription": "자 호루라기 대상이 블랙펄하고 레모네이드까지 가는 것도 괜찮긴 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.148,
                "end": 48.739
            },
            {
                "speaker_id": "1",
                "transcription": "다만 이렇게 받게 하기 위해서는 샤이닝한테 아몬드를 하나 더 섞어 주거나 뭐 아몬드를 2개 섞어주거나 뭐 그렇게 하셔도 괜찮습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.749,
                "end": 58.126
            },
            {
                "speaker_id": "1",
                "transcription": "자 5번 덱 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.136,
                "end": 60.044
            },
            {
                "speaker_id": "1",
                "transcription": "1탱, 2탱 가릴 것 없이 다 들어갑니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.054,
                "end": 63.482
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 시작하자마자 상대의 극딜이 들어오죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.492,
                "end": 68.104
            },
            {
                "speaker_id": "1",
                "transcription": "락스타의 피감을 아예 안 줘서 이렇게 나머지 쿠키들을 살리는 전략을 저는 줬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.114,
                "end": 77.026
            },
            {
                "speaker_id": "1",
                "transcription": "요런 식으로 네 극딜로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.036,
                "end": 81.866
            }
        ]
    },
    "summary": "한 남성이 방송에서 게임 시 조합하면 좋은 덱 중 5번 덱은 샤이닝클리터, 레모네이드, 홀리베리, 락스타, 블랙펄을 추천하며 호루라기는 샤이닝클리터와 레모네이드한테 가면 된다고 이야기한 후 추천은 5번 덱으로 게임을 하는 모습을 보여준다.",
