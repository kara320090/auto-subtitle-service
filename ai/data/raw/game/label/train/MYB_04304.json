    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키는 그냥 초반에 쓰시는 거면 올 쿨을 쓰시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.260
            },
            {
                "speaker_id": "1",
                "transcription": "올 쿨 아니면 올 라즈 무난하기는 그냥 올 쿨이 나은 것 같기도 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.270,
                "end": 11.094
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 아레나나 스토리에서 그냥 두루두루 쓰기에는 그리고 여러분들 이 통로를 최대한 빨리 뚫어야 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.104,
                "end": 18.082
            },
            {
                "speaker_id": "1",
                "transcription": "이거 소다 제도 열리면 보상을 정말 핵으로 많이 받을 수 있기 때문에 저거 집중해서 해 주시고 쿠키 하우스 레벨 업도 계속 신경 써서 레벨 업을 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.092,
                "end": 30.817
            },
            {
                "speaker_id": "1",
                "transcription": "아 보물 뽑기 있네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.827,
                "end": 31.989
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여러분들 저 무공비급 뽑았거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.999,
                "end": 35.333
            },
            {
                "speaker_id": "1",
                "transcription": "오 시계 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.343,
                "end": 36.807
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 생각할 때 초반에 실수하는 분들 중에 이런 분도 있어 아 커먼 등급이네?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.817,
                "end": 42.533
            },
            {
                "speaker_id": "1",
                "transcription": "쓰레기구나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.543,
                "end": 43.593
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 나는 이거 안 쓰고 그냥 레이만 쓸래 이런 분들이 혹시나 있을 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.603,
                "end": 47.910
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 쿠키런 킹덤에 초반 유저분들이 어 에픽을 얘가 등급이 에픽이면 너무 뽑기 힘들까 봐 배려해 준 의미로 커먼으로 등급을 낸 게 100프로입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.920,
                "end": 60.078
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 땐 왜냐하면 쿨타임이라는 게 킹덤을 하다보면 아시겠지만 너무나 중요해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.088,
                "end": 66.306
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키의 스킬을 빨리빨리 쓸 수 있게 회전 시켜주는 엄청나게 중요한 요소이기 때문에 커먼이라고 무시하지 마시고 반드시 쓰셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.316,
                "end": 75.458
            },
            {
                "speaker_id": "1",
                "transcription": "뿔 같은 경우에도 등급이 커먼이긴 하지만 좀 더 안정적으로 진행할 때 뿔 되게 좋거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.468,
                "end": 81.563
            },
            {
                "speaker_id": "1",
                "transcription": "나는 무공비급이 없습니다 하시는 분들은 대체로 낫을 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.573,
                "end": 85.858
            },
            {
                "speaker_id": "1",
                "transcription": "낫을 쓰다가 나중에 어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.868,
                "end": 88.600
            }
        ]
    },
    "summary": "소다 제도 열리면 보상을 정말 핵으로 많이 받을 수 있고 쿠키 하우스 레벨 업도 계속 신경 써서 레벨 업을 해주시면 됩니다.",
