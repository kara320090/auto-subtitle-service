        "term": [
            {
                "speaker_id": "1",
                "transcription": "런 킹덤 우리가 너와 왕국을 지킬거야 약속할게 화이트펄 쿠키 내 동생",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.480
            },
            {
                "speaker_id": "2",
                "transcription": "자 이렇게 해서 영상은 끝이고요 자 업데이트 사전 안내 공지 이제 같이 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.490,
                "end": 16.890
            },
            {
                "speaker_id": "2",
                "transcription": "자 업데이트는 8월 30일날 이루어지고요 자 스페셜 에피소드 꿈꾸는 인어의 바다 2부가 이제 이어집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.900,
                "end": 24.307
            },
            {
                "speaker_id": "2",
                "transcription": "자 얼파탑이 이제 나오는 게 좀 새롭게 나오는 부분이죠 자 얼파탑을 올라가게 되면 100층까지 있는 모습이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.317,
                "end": 33.102
            },
            {
                "speaker_id": "2",
                "transcription": "자 그리고 보상도 되게 엄청난 보상이 있는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.102,
                "end": 37.165
            },
            {
                "speaker_id": "2",
                "transcription": "얼파탑은 런모드 보물상자들로 총 100층까지 구성되어 있다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.175,
                "end": 42.624
            },
            {
                "speaker_id": "2",
                "transcription": "자 그리고 슈퍼 에픽 크림슨코랄 쿠키가 나옵니다 전방이고 방어형 쿠키라고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.634,
                "end": 48.817
            },
            {
                "speaker_id": "2",
                "transcription": "자 크림슨코랄 쿠키는 관용과 냉정한 애정스킬을 사용하는 방어형 쿠키이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.817,
                "end": 54.136
            },
            {
                "speaker_id": "2",
                "transcription": "스킬을 보게 되면 인어자매들이 함께 기운을 모아 크림슨 스피어를 강하게 찔러 적들에게 피해를 주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.146,
                "end": 60.075
            },
            {
                "speaker_id": "2",
                "transcription": "본인을 제외한 공격력이 가장 높은 아군 둘에게 물 속성 스킬 피해량의 일부만큼 체력 보호막을 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.075,
                "end": 67.815
            },
            {
                "speaker_id": "2",
                "transcription": "자 여러분들 제가 예측했죠 바다요정의 생존을 높여 줘서 바다요정을 살려주는 업데이트가 정확히 이루어졌네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.912,
                "end": 76.266
            }
        ]
    },
