        "term": [
            {
                "speaker_id": "1",
                "transcription": "큰 건 아니죠 확실히?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.578
            },
            {
                "speaker_id": "1",
                "transcription": "네 요기 보스들도 네 요렇게 마무리된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.588,
                "end": 6.459
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 실전으로 가서 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.469,
                "end": 9.082
            },
            {
                "speaker_id": "1",
                "transcription": "사실 이 영상 찍기 전에 미리 해봤는데 약간 절망적입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.092,
                "end": 14.420
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.430,
                "end": 19.307
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.317,
                "end": 22.536
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.546,
                "end": 26.367
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱한테 들어가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.377,
                "end": 29.096
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱한테는 제가 샤벳상어를 넣을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.106,
                "end": 32.998
            },
            {
                "speaker_id": "1",
                "transcription": "가보도록 하고 일단 세팅 자체는 올 쿨, 탐라지 이몬드, 아몬드, 쿨, 쿨",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.008,
                "end": 39.733
            },
            {
                "speaker_id": "1",
                "transcription": "사실 승률이 좋은 거는 절대 아니고 요새는 소원 덱으로 가도 무조건 이기는 건 아니거든요?",
