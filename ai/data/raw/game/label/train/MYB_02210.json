                ],
                "start": 13.475,
                "end": 16.448
            },
            {
                "speaker_id": "1",
                "transcription": "아 맞다 용과드래곤 그거 돌격형이더라?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.458,
                "end": 19.400
            },
            {
                "speaker_id": "1",
                "transcription": "그 유출된 거에 따르면은 용과드래곤 돌격형이던데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.410,
                "end": 22.644
            },
            {
                "speaker_id": "1",
                "transcription": "아니 왜 이렇게 돌격형 좋아하는 거야?",
                "sound_type": [
