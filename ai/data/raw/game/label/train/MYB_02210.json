                    3
                ],
                "start": 22.654,
                "end": 25.328
            },
            {
                "speaker_id": "1",
                "transcription": "나는 당연히 침투형이나 그런 건 줄 알았는데 유출된 거에는 돌격형이더라?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.338,
                "end": 32.107
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 확실히 약간 데브가 그런 게 있는 것 같아.",
