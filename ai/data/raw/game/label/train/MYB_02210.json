                    2,
                    3
                ],
                "start": 32.117,
                "end": 34.862
            },
            {
                "speaker_id": "1",
                "transcription": "탱커를 내야 약간 밸붕 안 되고 안전한 약간 그런 느낌으로 갈 수 있어서 그런가?",
