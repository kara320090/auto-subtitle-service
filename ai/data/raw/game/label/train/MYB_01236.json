            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 먼저 소르베 덱 요걸로 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.055
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 조합은 어떻게 이기는 그림이 되냐 자 일단은 상대의 용과 브레스가 들어왔을 때 소르베가 피가 똑같이 깎여요 락스타랑 똑같이.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.065,
                "end": 15.160
            },
            {
                "speaker_id": "1",
                "transcription": "근데 락스타 피가 먼저 깎이면서 소르베랑 네 이 스타더스트랑 피가 다 채워질 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.170,
                "end": 23.363
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 보이죠.",
                "sound_type": [
                    2
                ],
                "start": 23.373,
                "end": 24.819
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 지금 이 그림 봤나요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.829,
                "end": 27.454
            },
            {
                "speaker_id": "1",
                "transcription": "이 그림을 원해야 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 27.464,
                "end": 29.782
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 세팅해야 되는 목적이 이거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.792,
                "end": 32.941
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 락스타가 피감이 너무 높으면은 소르베가 더 일찍 죽어버리는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.951,
                "end": 37.670
            },
            {
                "speaker_id": "1",
                "transcription": "방금 보신 그림을 여러분들이 따라 하시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.680,
                "end": 41.072
            },
            {
                "speaker_id": "1",
                "transcription": "이 세팅 값은 제가 여러분들 계정에 들어가서 직접 세팅을 다 일일이 해드릴 수가 없어요 스펙을.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.082,
                "end": 46.807
            },
            {
                "speaker_id": "1",
                "transcription": "각각의 토핑 세팅 여러분들의 계정 스펙 이런 거에 맞춰서 락스타 피감을 여러분들 딜러의 스펙보다 피감을 낮춰서 먼저 죽게끔 의도적으로 만들어주는 게 가장 핵심적인 거예요.",
                "sound_type": [
                    2
                ],
                "start": 46.817,
                "end": 59.958
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이 조합 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.968,
                "end": 61.864
            },
            {
                "speaker_id": "1",
                "transcription": "이 조합이 지금 이 조합일 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.874,
                "end": 64.322
            },
            {
                "speaker_id": "1",
                "transcription": "근데 원래는 상성상 이 조합이 이 조합한테 원래는 상성상 이렇게 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.332,
                "end": 69.228
            },
            {
                "speaker_id": "1",
                "transcription": "소르베가 있어서 하지만 파르페에 쿨을 이렇게 세팅해서 파르페가 먼저 스킵 발동시켜가지고 소르베 스킬을 풀어줘서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.238,
                "end": 79.033
            }
        ]
    },
    "summary": "소르베 덱으로 이기는 그림은 상대의 용과 브레스가 들어왔을 때 소르베 피가 락스타랑 똑같이 피가 깎이면서 스타더스트랑 피가 다 채워지는 이 그림을 원해서 이 세팅을 해야 하는 목적이고 락스타 피감이 높으면 소르베가 일찍 죽어버리는데 세팅 값을 일일이 해드릴 수는 없고 락스타 피감을 딜러의 스펙보다 피감을 낮춰서 먼저 죽게끔 의도적으로 만드는 게 핵심이며 이 조합한테 원래는 상성상 이렇게 한다.",
