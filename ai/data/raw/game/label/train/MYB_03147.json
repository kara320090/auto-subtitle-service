                ],
                "start": 5.920,
                "end": 12.400
            },
            {
                "speaker_id": "1",
                "transcription": "아 잘못 들고 왔어 보물 보물도 바꿔야 되는데 여러분들이 나중에 할 때는 화관 들고 오세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.400,
                "end": 19.870
            },
            {
                "speaker_id": "1",
                "transcription": "지금 딜 보면 아시죠?",
                "sound_type": [
                    2,
                    5
                ],
