        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어느 정도 토핑 강화가 어느 정도 됐네요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.940
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 이 지금 되게 다양하게 지금 다 뿌려져 있어요 토핑이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.940,
                "end": 6.820
            },
            {
                "speaker_id": "1",
                "transcription": "안 쓰는 쿠키는 다 해제해 가지고 원하는 덱에 그냥 집중을 하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.820,
                "end": 10.650
            },
            {
                "speaker_id": "1",
                "transcription": "근데 너무 좋은 거를 수호 성전에 다 갖다 쓰시는데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.650,
                "end": 13.360
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 같은 경우에는 @이름1 아까 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.360,
                "end": 15.530
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 세팅 제대로 할 거면은 @이름1한테 좀 주셔야 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.530,
                "end": 19.610
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 볼 때 쿨 토핑이 좀 많이 부족하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.610,
                "end": 21.930
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 쿨 맞추기가 힘들 것 같은데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.930,
                "end": 23.940
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 토핑을 조금 더 신경 써서 파밍 해야 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.940,
                "end": 27.060
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이건 사치야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.060,
                "end": 29.040
            },
            {
                "speaker_id": "1",
                "transcription": "지금 토핑 조각이나 코인이나 여유도 없는데 피감이라고 다 올리면 안 되고 지금 올려야 될 건 딱 2가지야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.040,
                "end": 36.110
            },
            {
                "speaker_id": "1",
                "transcription": "피감하고 쿨만 올리세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.110,
                "end": 38.030
            },
            {
                "speaker_id": "1",
                "transcription": "얘네들은 나중에 여유 있을 때 올리고 쿨 파밍은 팔 다시 이십오나 에피소드 십삼에서 하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.030,
                "end": 44.200
            },
            {
                "speaker_id": "1",
                "transcription": "음",
                "sound_type": [
                    2,
