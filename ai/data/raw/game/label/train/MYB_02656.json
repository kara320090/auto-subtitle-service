        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "꿈 열차 은하 탐험 이벤트 귀찮아서 손 놓고 있는 분들 있으신가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.163
            },
            {
                "speaker_id": "1",
                "transcription": "이제 이벤트 남은 기간이 2일도 채 안 남았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.173,
                "end": 7.178
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 벼락치기 용 팁 모음 영상을 준비해봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.188,
                "end": 10.718
            },
            {
                "speaker_id": "1",
                "transcription": "이 이벤트 꼭 해야만 하나요?라고 생각하는 분들 화면에 보이는 보상들이 생각보다 상당히 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.728,
                "end": 17.307
            },
            {
                "speaker_id": "1",
                "transcription": "각종 상위 생산품 뿐 아니라 스타더스트 뽑기권, 에픽 쿠키 영혼석 선택 상자, 토핑 조각, 에픽 토핑, 오로라 재료 등을 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.317,
                "end": 25.861
            },
            {
                "speaker_id": "1",
                "transcription": "게다가 기록 한번만 제대로 세워두면 은하 탐험 시즌 보상으로 크리스탈과 스타더스트 영혼석 조각을 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.871,
                "end": 33.033
            },
            {
                "speaker_id": "1",
                "transcription": "상자를 오픈하기 위한 열쇠는 광고 보기와 무역소에서 구매 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.043,
                "end": 37.783
            },
            {
                "speaker_id": "1",
                "transcription": "단 하루 만이라도 집중해서 시간 투자하면 많은 보상을 얻을 수 있으니 영상을 참고해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.793,
                "end": 45.600
            }
        ]
    },
    "summary": "남성은 꿈 열차 은하 탐험 이벤트가 2일도 안 남았다고 했고 보상이 생각보다 상당히 좋기 때문에 하루 만이라도 집중해서 많은 보상을 얻으라고 했다.",
