        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "방금도 보소",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.071
            },
            {
                "speaker_id": "1",
                "transcription": "방금도 밀려가지고 딜이 살짝 안들어가는 느낌",
                "sound_type": [
                    2
                ],
                "start": 1.081,
                "end": 4.826
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 몸은 또 몸은 또는 약해요.",
                "sound_type": [
                    2
                ],
                "start": 4.836,
                "end": 10.397
            },
            {
                "speaker_id": "1",
                "transcription": "네 일단은 요렇게 완전히 어 야 역대급 30만 딜 넣었어",
                "sound_type": [
                    2
                ],
                "start": 10.407,
                "end": 23.991
            },
            {
                "speaker_id": "1",
                "transcription": "야 진짜 이거 칠레기 진짜",
                "sound_type": [
                    2
                ],
                "start": 24.001,
                "end": 26.573
            },
            {
                "speaker_id": "1",
                "transcription": "이런 쓰레기도 진짜 이런 쓰레기가 없네.",
                "sound_type": [
                    2
                ],
                "start": 26.573,
                "end": 28.899
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 다른 거 커버 쿠키보다 덜 나오는 거 아니냐?",
                "sound_type": [
                    2
                ],
                "start": 28.909,
                "end": 31.980
            },
            {
                "speaker_id": "1",
                "transcription": "야 무화과도 이거보다 잘 나오겠다.",
                "sound_type": [
                    2
                ],
                "start": 31.983,
                "end": 33.940
            },
            {
                "speaker_id": "1",
                "transcription": "보여줘 무화과야.",
                "sound_type": [
                    2
                ],
                "start": 33.943,
                "end": 35.336
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 세계관의 최약체 얘도 딜은 진짜 아예 안 들어간다고 보면 되긴 하는 데",
                "sound_type": [
                    2
                ],
                "start": 35.343,
                "end": 42.033
            }
        ]
    },
    "summary": "화자가 게임 결과를 보고 칠리가 몸도 약하고 딜도 많이 넣지 못해 비슷한 체급의 무화과와 비교하고 있다.",
