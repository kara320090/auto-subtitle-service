        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 여러분들 웨어울프도 방덱으로 많이 쓰고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.221
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프랑 자색 고구마 어떻게 되는지 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.231,
                "end": 6.971
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 궁금하신 점이 아니 자색 고구마가 뭐가 좋길래 왜 쓰이나요라고 생각할 수 있는데 자색 고구마는 상대방 쿠키를 밀어주면서 상대방 쿠키에 그 스킬을 순서를 약간 꼬아주는 느낌이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.981,
                "end": 19.459
            },
            {
                "speaker_id": "1",
                "transcription": "상대 스킬이 이런 식으로 가면은 밀어줄 때 앞에 전방의 쿠키가 스킬이 밀리고 후방으로 넘어가게 돼서 스킬 순서가 좀 원하는 방향으로 진행 안 되게끔 꼬아주는 역할도 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.469,
                "end": 33.317
            },
            {
                "speaker_id": "1",
                "transcription": "그런 식으로 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.327,
                "end": 35.788
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 상대 쿠키 웨어울프라고 해도 딜러 역할로 자색 고구마랑 홀리베리가 너무 좋게 쓰이기 때문에 요런 식으로 이길 수도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.798,
                "end": 47.100
            }
        ]
    },
    "summary": "자색 고구마는 상대방 쿠키를 밀어주면서 상대방 쿠키에 스킬을 순서를 꼬아주는 느낌이 있다고 남자가 설명하고 있다.",
