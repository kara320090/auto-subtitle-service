        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 완전 익스트림으로 어려웠으면 좋겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.281
            },
            {
                "speaker_id": "1",
                "transcription": "이거 재미 저는 되게 재미있거든요 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.291,
                "end": 4.067
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 이거 미니 게임만 따로 떼서 다 막 그 길원분들이랑 같이 할 수 있고 그러면 좋겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.077,
                "end": 11.137
            },
            {
                "speaker_id": "1",
                "transcription": "길원분들 이랑 같이 실시간에서 같이 하는 거야 어때요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.147,
                "end": 15.182
            },
            {
                "speaker_id": "1",
                "transcription": "1단계부터 2단계 3단계 4단계 5단계 6단계 계속 그냥 높아지는 거야 단계가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.192,
                "end": 20.025
            },
            {
                "speaker_id": "1",
                "transcription": "이거지 길원분들이랑 미니 게임인데 오래 나온 사람한테 보상 많이 주고 길원분들이 같지만 그렇게 하는 거야 아니면 시청자분들이랑 다른 사람들이랑.",
                "sound_type": [
