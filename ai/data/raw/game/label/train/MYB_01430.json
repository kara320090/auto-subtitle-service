        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 가장 좋다고 생각하는 게 요 덱인데 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.905
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방분은 스타더스트덱 네 저 같은 경우에는 소르베덱이죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.915,
                "end": 10.522
            },
            {
                "speaker_id": "1",
                "transcription": "네 현재 유행하는 덱은 이렇게 스타더스트 덱과 소르베덱으로 나눠서 아 유행하고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.532,
                "end": 18.617
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과 드래곤 같은 경우에는 얼마나 타이밍을 잘 맞추는지도 상당히 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.627,
                "end": 25.243
            },
            {
                "speaker_id": "1",
                "transcription": "자 1분에 맞춰서 요렇게 브레스가 나가게 설정이 대부분 되어 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.253,
                "end": 30.177
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 에게 매판 완전 똑같지는 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.187,
                "end": 33.369
            },
            {
                "speaker_id": "1",
                "transcription": "네 왜냐면은",
                "sound_type": [
                    2,
                    3,
                    5
                ],
