                    2,
                    3
                ],
                "start": 7.791,
                "end": 10.406
            },
            {
                "speaker_id": "2",
                "transcription": "나쁜 놈이지만 사람 잡아먹는 미친 놈은 아니니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.416,
                "end": 14.421
            },
            {
