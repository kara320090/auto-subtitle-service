        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "모바일 게임을 플레이할만큼 혜택을 받을 수 있는 플레이오 앱을 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.842
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 쌓이는 젤을 코인으로 교환해 상점에서 기프트 카드 문화상품권 등 다양한 상품으로 구매 가능합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.852,
                "end": 9.896
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 시청하고 가입한 신규 유저분들한테는 특별 시크릿코드 플오앤디러너를 입력하면 1,0000젤을 드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.906,
                "end": 16.997
            },
            {
                "speaker_id": "1",
                "transcription": "추가로 플레이오의 자체적으로 플레이들이 있어서 게임을 진행하면서도 다양한 젤을 추가로 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.007,
                "end": 22.647
            },
            {
                "speaker_id": "1",
                "transcription": "게임하고도 기프트카드 문화상품권을 무료로 얻고 너무나 좋은 기회 아닌가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.657,
                "end": 27.309
            },
            {
                "speaker_id": "1",
                "transcription": "다운로드 링크 고정댓글 확인하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.319,
                "end": 30.331
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 쭉 처음에 질주하는 거는 길드 질주 버프 효과 때문에 여러분들이랑 다르게 더 길게 갈 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.341,
                "end": 38.709
            },
            {
                "speaker_id": "1",
                "transcription": "유물 효과 때문에 저는 좀 더 멀리갈 수 있다는 점 수호성전같은 경우에는 가장 중요한 포인트가 시간단축을 위해서는 공속이 무조건 높고 쿨이 높고 이게 중요한 게 아니라 스킬배분이 정말 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.719,
                "end": 52.586
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보시면 아시겠지만 적절하게 쿠키들이 스킬을 모두 다 쓰는 게 중요한 게 아니라 일정 구간에서는 스킬을 나눠스 쓰는 게 중요해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.596,
                "end": 62.867
            },
            {
                "speaker_id": "1",
                "transcription": "구간에 맞처서 너무 한번에 다 쓰지 않도록 스킬 하나로도 넘어갈 수 있게끔 하는 게 좋구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.877,
                "end": 69.052
            },
            {
                "speaker_id": "1",
                "transcription": "여러분이 각각 하시면서 조절하시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.062,
                "end": 72.458
            },
            {
                "speaker_id": "1",
                "transcription": "아 너무 도넛이 쿨이 빨라서 아니면 다른 쿠키의 클릭이 너무 빨라서 스킬 낭비가 되고 있다 그러면 그 쿠키의 공속을 낮추거나 쿨을 살짝 낮추거나 이렇게 해서 오히려 쿨공속을 낮춰서 기록갱신을 더 할 수 있는 경우도 생기니까 각각의 상황에 맞춰서 세팅을 해주시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.468,
                "end": 94.333
            }
        ]
    },
    "summary": "혜택을 받을 수 있는 플레이오 앱을 추천하는데 젤을 코인으로 교환해 상점에서 상품으로 구매가 가능하고, 신규 유저한테는 10000젤을 드리고 다양한 젤을 추가로 얻을 수 있는 기회이고, 오늘은 일단 길드 질주 버트 효과 때문에 여러분과 다르게 길게 가는데 스킬은 나눠스 쓰는 게 중요하고 조절하면 됩니다.",
