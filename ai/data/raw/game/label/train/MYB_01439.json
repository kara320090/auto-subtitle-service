            },
            {
                "speaker_id": "2",
                "transcription": "&외국어 발화&",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.277,
                "end": 2.488
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 아 어제는 제가 텐션이 좋아서 방송 키려다가 말았어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.498,
                "end": 18.685
            },
            {
                "speaker_id": "2",
                "transcription": "즐길 준비 됐어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.695,
                "end": 20.304
            },
            {
                "speaker_id": "1",
                "transcription": "아 락스타 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.314,
                "end": 22.029
            },
            {
                "speaker_id": "1",
                "transcription": "쫙쫙 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.039,
                "end": 23.975
            },
            {
                "speaker_id": "1",
                "transcription": "야 샤이닝 조각 그래 그래 조각도 상당히 좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.985,
                "end": 30.535
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 잘 나오면은 부계정이라도 할 맛 나지.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.545,
                "end": 35.188
            },
            {
                "speaker_id": "1",
                "transcription": "아 토벌 락스타 빌드에 안 들면은 그냥 기존 빌드 쓰다가 나중에 스펙 되면은 갈아타세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.198,
                "end": 41.407
            },
            {
                "speaker_id": "1",
                "transcription": "용토벌 빌드는 항상 최고점 빌드로 갈아타기 힘들면은 그냥 기존 빌드에 있다가 스펙 업 되면은 나중에 갈아타는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.417,
                "end": 51.407
            },
            {
                "speaker_id": "2",
                "transcription": "검을 쥐었다면 가벼이 휘두르지 마라.",
                "sound_type": [
