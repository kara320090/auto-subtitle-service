            },
            {
                "speaker_id": "1",
                "transcription": "뭐지 왜 소름 돋는 소리 히",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.994,
                "end": 7.461
            },
            {
                "speaker_id": "1",
                "transcription": "이상해 소리만 들으니까",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.471,
                "end": 11.065
            },
            {
                "speaker_id": "1",
                "transcription": "잠시 후",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.075,
                "end": 14.212
            },
            {
                "speaker_id": "1",
                "transcription": "오 안내를 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.222,
                "end": 23.415
            },
            {
                "speaker_id": "1",
                "transcription": "은신처 사람을 위한 거니까 필요 없어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.425,
                "end": 26.895
            },
            {
                "speaker_id": "1",
                "transcription": "아 약 가방을 아 약 가방을 올려주는 게 이건가 보다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.905,
                "end": 31.667
            },
            {
                "speaker_id": "1",
                "transcription": "아 가죽을 부드럽게 만드는 약을 정제했고 질겨서 버려지는 가죽을 재 이용해서 은신처의 물자를 조금 더 아끼는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.677,
                "end": 42.908
            },
            {
                "speaker_id": "1",
                "transcription": "약 가방이 그러면 훨씬 쓰기 편해질 거다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.918,
                "end": 46.086
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 정도 답례는 받아야지 이게 이제 약 갯수 올리는 퀘스트 였나보네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.096,
                "end": 53.733
            }
        ]
    },
    "summary": "여성이 게임을 하고 있으며 얻어온 아이템으로 만든 것은 가죽을 부드럽게 해 주는 것이었고 이 것이 약 갯수를 올리는 퀘스트라고 알려준다.",
