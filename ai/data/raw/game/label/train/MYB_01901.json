                    5
                ],
                "start": 3.407,
                "end": 9.468
            },
            {
                "speaker_id": "1",
                "transcription": "그전에 접었다가 복귀하셨는데 중요한 건 이분 제가 스펙을 봤더니만 이 정도 스펙이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.478,
                "end": 15.837
            },
            {
                "speaker_id": "1",
                "transcription": "보면 초월도 좀 달려져 있고 그에 반해 왕국이 되게 그에 비해서는 발전이 조금 늦으신 편이긴 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.847,
                "end": 25.683
            },
            {
                "speaker_id": "1",
                "transcription": "제대로 하는 시간이 게임할 때 시간이 부족하잖아요 근데 가장 우선 순위로 해야 될 것만 잘 하면 어느 정도",
                "sound_type": [
                    2,
                    3
                ],
