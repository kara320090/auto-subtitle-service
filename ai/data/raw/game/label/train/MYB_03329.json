                    2,
                    3
                ],
                "start": 16.459,
                "end": 20.526
            },
            {
                "speaker_id": "1",
                "transcription": "야 저게 저렇게 뜨네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.536,
                "end": 22.316
            },
            {
