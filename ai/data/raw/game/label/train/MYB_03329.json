                    3
                ],
                "start": 1.526,
                "end": 7.345
            },
            {
                "speaker_id": "1",
                "transcription": "하나 더 뽑으면 이제 이득이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.355,
                "end": 9.215
            },
            {
                "speaker_id": "1",
                "transcription": "아 어 야 와 야 모르고 실수로 했는데 쌍 달빛 떴어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.225,
                "end": 16.449
            },
            {
                "speaker_id": "1",
                "transcription": "와 이게 진짜 가능하구나.",
