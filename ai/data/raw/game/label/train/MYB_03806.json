        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 블랙펄 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.206
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 스킬 발동하는 게 무슨 어마무시하게 느리게 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.216,
                "end": 12.743
            },
            {
                "speaker_id": "1",
                "transcription": "예 저렇게 상대방이 블랙펄이 스킬 발동 시간이 저렇게 늦게 되면은 쿨타임 자체도 엄청나게 늦게 굴러가는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.753,
                "end": 21.917
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 시전이 다 되고 나서 제자리로 돌아와야만 다시 쿨타임 좀 돌아가기 때문에 되게 상대방의 쿨타임을 완전 꼬여버리게 만들 수 있다는 장점 고런 점이 정말 좋죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.927,
                "end": 34.791
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄이 날아까는 건가요 아이 그건 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.801,
                "end": 38.699
            },
            {
                "speaker_id": "1",
                "transcription": "근데 요새 대세 덱에서는 블랙펄이 굳이 안 써도 되는 그런 추세긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.709,
                "end": 43.966
            },
            {
                "speaker_id": "1",
                "transcription": "옛날만 해도 블랙펄은 아레나 5자리 중에 1자리는 무조건 들어가는 쿠키였는데 요새는 무조건 쓰이는 쿠키가 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.966,
                "end": 53.104
            },
            {
                "speaker_id": "1",
                "transcription": "지금 덱만 해도 블랙펄 안 쓰이고 다른 덱에서도 블랙퍽 없는 덱들이 상당히 많거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.114,
                "end": 59.206
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 블랙펄이 최고로 0 티어고 무조건 쓰이고 그런 시대는 지나갔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.200,
                "end": 68.902
            }
        ]
    },
    "summary": "블랙퍽 없는 덱들이 많기 때문에 블랙펄이 0 티어고 무조건 쓰이는 시대는 지났다고 한다.",
