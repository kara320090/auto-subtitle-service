                "start": 0.000,
                "end": 1.034
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 몇 개 나올까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.044,
                "end": 9.236
            },
            {
                "speaker_id": "1",
                "transcription": "나는 80만 개면은 최소 최소 10개 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.246,
                "end": 13.416
            },
            {
                "speaker_id": "1",
                "transcription": "고대 레전드 슈퍼 에픽 10개 이상 안 나오면은 뭐 이건 제 문제입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.426,
                "end": 18.177
            },
            {
                "speaker_id": "1",
                "transcription": "자 스타트는 홀리베리",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.187,
                "end": 23.454
            },
            {
                "speaker_id": "1",
                "transcription": "야 설마 저 80만 개 있는데 소르베 안 나오겠어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.464,
                "end": 27.260
            },
            {
                "speaker_id": "1",
                "transcription": "전 소르베를 꼭 뽑을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.270,
                "end": 29.215
            },
            {
                "speaker_id": "1",
                "transcription": "토벌전 쿠키로 잘 뽑아 드려야죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.225,
                "end": 31.815
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 복귀 유저분이시라 토벌 쿠키가 좀 많이 바뀌었을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.825,
                "end": 36.479
            },
            {
                "speaker_id": "1",
                "transcription": "스페셜 쿠키는 하나도 안 쓰고 전부 다 고급에다 써주세요라는 부탁이 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.489,
                "end": 41.677
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들 오늘 80만 개 이상 싹 다 그냥 고급으로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.687,
                "end": 46.934
            },
            {
                "speaker_id": "1",
                "transcription": "음 뭐 계정 주인분이 그렇게 한다고 하시니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.944,
                "end": 51.791
            }
        ]
    },
    "summary": "남자가 게임 속 뽑기를 하면서 소르베 캐릭터를 꼭 뽑을 거라고 말하며 계정 주인이 스페셜 쿠키가 아니라 고급 쿠키로 뽑아달라고 했다고 말하고 있다.",
