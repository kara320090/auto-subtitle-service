        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 제가 말씀드리고 싶은 건 이거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.577
            },
            {
                "speaker_id": "1",
                "transcription": "마법 사탕은 골고루 다 키워야 되는 게 절대 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.577,
                "end": 4.858
            },
            {
                "speaker_id": "1",
                "transcription": "다음 신규 마탕이 나오면 그 쿠키에 집중할 수 있도록 재료를 모아두는 게 정말 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.868,
                "end": 11.017
            },
            {
                "speaker_id": "1",
                "transcription": "자 다음에 나올 신규 마법 사탕은 제가 볼 때는 샤벳상어가 99.99퍼센트예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.027,
                "end": 17.436
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳상어 마법 사탕이 나올 수 있는 이유는 자 인연의 홈에 여기 나와 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.446,
                "end": 22.495
            },
            {
                "speaker_id": "1",
                "transcription": "어 인연의 홀에 나와 있는 쿠키가 마법 사탕이 대부분 항상 어 출시가 되어 왔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.505,
                "end": 27.035
            },
            {
                "speaker_id": "1",
                "transcription": "쓰임새가 없는 마법 사탕은 키울 필요가 전혀 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.035,
                "end": 30.010
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 언급드린 오징어먹물, 슈크림, 파르페, 실론나이트 이것만 선택적으로 키워주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.010,
                "end": 36.957
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 스펙이 높고 토핑이 되시는 분들은 망고까지 요 나머지는 샤벳상어를 준비하자 이게 오늘 영상이 여러분들한테 드리고자 하는 메시지입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.957,
                "end": 46.905
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트 8월 30일날 이루어지고요 업데이트 이후에 마법 사탕 소식이 나오면은 좀 더 최신화된 마법 사탕 영상을 또 찍을거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.905,
                "end": 56.737
            },
            {
                "speaker_id": "1",
                "transcription": "궁금한 점이 있다면 댓글에 남겨주세요 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.747,
                "end": 76.410
            }
        ]
    },
    "summary": "마법 사탕는 절대 다 키워야 하는 것이 아니기 때문에 오징어먹물, 슈크림, 파르페, 실론나이트 이것만 선택적으로 키워주고 다음에 나올 쿠키인 샤벳상어를 위해 재료를 모아두자.",
