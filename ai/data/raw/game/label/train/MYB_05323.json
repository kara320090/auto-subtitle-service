        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤에 블랙펄 쿠키 신규 레전더리가 나오는데 이거는 원래 쿠키런 게임에서 알려진 그런 쿠키가 아니라 완전 새롭게 나온 신규 레전드 쿠키거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 12.046
            },
            {
                "speaker_id": "1",
                "transcription": "많은 분들이 근본 레전드 쿠키를 원하는 분들이 많습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.056,
                "end": 16.634
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 오늘 해볼거는 여러분들이 원하는 근본 레전더리 쿠키런 오븐브레이크에서 어떤 게 있었으면 좋겠는가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.644,
                "end": 24.270
            },
            {
                "speaker_id": "1",
                "transcription": "그거 한 번 투표로 여러분들 민심을 한 번 알아보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.281,
                "end": 28.640
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 모든 레전더리 쿠키가 나와습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.640,
                "end": 32.334
            },
            {
                "speaker_id": "1",
                "transcription": "현재까지 출시된 모든 레전더리 관련 쿠키는 총 11종이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.344,
                "end": 36.637
            },
            {
                "speaker_id": "1",
                "transcription": "용족 관련 쿠키 5개 그다음에 달빛술사, 불꽃정령, 어둠마녀, 바다요정이랑 바람궁수까지 천년나무도 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.647,
                "end": 45.459
            },
            {
                "speaker_id": "1",
                "transcription": "이거 관련돼서 스킨도 한 번 쫙 보여드릴 테니까 댓글에다가도 출시됐으면 하는 근본 레전드 쿠키나 원하는 쿠키 스킨 보고 이런 거 말씀해 주시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.469,
                "end": 55.524
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피시에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.534,
                "end": 59.689
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.699,
                "end": 63.026
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.036,
                "end": 67.750
            }
        ]
    },
    "summary": "남성은 많은 분들이 근본 레전드 쿠키를 원해서 오늘 여러분들이 원하는 근본 레전더리 쿠키런 오븐브레이크에서 어떤 게 있었으면 좋겠는지 투표를 해서 민심을 한 번 알아보도록 하겠다고 말한다.",
