        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐야 그게 세계의 색이었어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.815
            },
            {
                "speaker_id": "1",
                "transcription": "알고 계셨습니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.825,
                "end": 3.667
            },
            {
                "speaker_id": "1",
                "transcription": "알고 자시고 이거 우리집 가보라고 노비할 때 준 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.677,
                "end": 8.224
            },
            {
                "speaker_id": "1",
                "transcription": "이게 그렇게 대단한 거라고 좀 특이한 보석이라고 생각했지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.234,
                "end": 11.742
            },
            {
                "speaker_id": "1",
                "transcription": "이만한 가치가 있을 거라고는 장치로 판별할 능력도 필요도 없군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.752,
                "end": 17.942
            },
            {
                "speaker_id": "1",
                "transcription": "시선에서 주제 넘는 탐욕이 느껴집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.952,
                "end": 20.229
            },
            {
                "speaker_id": "1",
                "transcription": "주제 넘다니 원래 우리집 가보라니까 아니요 가주 님의 것입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.239,
                "end": 25.605
            },
            {
                "speaker_id": "1",
                "transcription": "그러니 그 탐욕을 고이 접어두시고 해방되고 싶다면 더욱이 휴 알았다 알았어 눈빛만 봐도 사람 하나 담글 기세네 아주.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.615,
                "end": 34.392
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 장모 놈들의 반지는 내가 챙긴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.402,
                "end": 36.950
            },
            {
                "speaker_id": "1",
                "transcription": "이건 니 주인 놈의 기억을 되찾는 데 필요하는 것도 아니잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.960,
                "end": 40.249
            },
            {
                "speaker_id": "1",
                "transcription": "마음대로 하시길",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.259,
                "end": 42.800
            }
        ]
    },
    "summary": "여성이 게임 속 세계의 색과 반지에 대해서 이야기한다.",
