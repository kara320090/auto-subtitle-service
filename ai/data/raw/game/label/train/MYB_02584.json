        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 17초 여러분들 중요하거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.195
            },
            {
                "speaker_id": "1",
                "transcription": "여기서는 에클레어 나가자마자 그리고 퓨바랑 밀키웨이 여기서 동시에 눌러줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.205,
                "end": 8.351
            },
            {
                "speaker_id": "1",
                "transcription": "그 전까지는 밀키웨이 도넛 가만히 자동으로 흘러가게 내버려 뒀는데 17초만 여러분들 머릿속에 잘 기억하시면 될 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.361,
                "end": 16.843
            },
            {
                "speaker_id": "1",
                "transcription": "여기만 밀키웨이 퓨바만 바로 에클레어 스킬 나가자마자 바로 누른다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.853,
                "end": 21.019
            },
            {
                "speaker_id": "1",
                "transcription": "자 나갔죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.029,
                "end": 22.688
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 바로 이제 눌러주셔야 돼요. 그래야 안 죽습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.698,
                "end": 25.746
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해주시고 네 에클레어가 죽는 거는 뭐 치명타 터져서 죽을 수도 있어서 자 요거로서 마지막 눌러주시면",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.756,
                "end": 37.398
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 잡는 데에는 지장이 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.408,
                "end": 40.513
            },
            {
                "speaker_id": "1",
                "transcription": "3억 3천",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.523,
                "end": 41.553
            },
            {
                "speaker_id": "1",
                "transcription": "길이 누적 얘 혼자 2억 9천을 뽑습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.563,
                "end": 45.104
            },
            {
                "speaker_id": "1",
                "transcription": "자 다시 한 번 가보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.114,
                "end": 47.017
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 좀 빠르게 1.2배속으로 가볼게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.027,
                "end": 49.669
            },
            {
                "speaker_id": "1",
                "transcription": "제일 먼저 에클레어 예약을 해주시고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.679,
                "end": 52.549
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 보출 뜨면 퓨바",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.559,
                "end": 55.458
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 밀키웨이 밀키웨이 쓰자마자 도넛 그 다음에 주스",
                "sound_type": [
                    2,
                    5
                ],
                "start": 55.468,
                "end": 59.802
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 가면 될것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.812,
                "end": 62.598
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 도넛로서 쓰고 퓨바 자 주스 에클레어 예약",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.608,
                "end": 70.057
            },
            {
                "speaker_id": "1",
                "transcription": "그대로 따라하시면 될 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 70.067,
                "end": 72.336
            },
            {
                "speaker_id": "1",
                "transcription": "퓨바 써주시고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 72.346,
                "end": 75.203
            },
            {
                "speaker_id": "2",
                "transcription": "물러설 수 없어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 75.213,
                "end": 76.071
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 주스 자 여기 여기 한 38초 부분에 다시 한 번 말씀드리지만 에클 너무 일찍 누르면은 이렇게 순서 가니까 얘는 38초 에클레어는 그냥 가만히 내버려 두는 게 나은 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 76.081,
                "end": 88.874
            },
            {
                "speaker_id": "2",
                "transcription": "이렇게 해주시고 퓨바 주스",
                "sound_type": [
                    2,
                    5
                ],
                "start": 88.884,
                "end": 93.666
            }
        ]
    },
