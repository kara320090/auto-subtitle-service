        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 무지개 큐브 많이 부족하시죠 이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.629
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.639,
                "end": 12.262
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원에 해당하는 가격인데 제가 무료로 나눠드리고 있는데 받는 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.272,
                "end": 24.079
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱 다운로드 받으시고 우측 하단에 프로필을 누르시고 우측 상단에 톱니바퀴를 누르면 시크릿 코드 입력하는 데가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.089,
                "end": 34.133
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오ND러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.143,
                "end": 38.585
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 앱은 도대체 어떤걸까 자 여러분들이 게임만 해도 자동으로 쌓이는 잼을 가지고 자 상점에서 여러분들이 원하는 기프트 카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.595,
                "end": 49.879
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임 하는데 여러분들한테 따로 광고가 뜨지도 않고요 방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.889,
                "end": 55.916
            },
            {
                "speaker_id": "1",
                "transcription": "자 시크릿 코드 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요 자세한 이벤트 확인은 고정 댓글을 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.926,
                "end": 64.717
            },
            {
                "speaker_id": "1",
                "transcription": "자 지금 연동으로 인한 피해자가 한 두명이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.727,
                "end": 68.996
            },
            {
                "speaker_id": "1",
                "transcription": "이건 전적으로 데브시스터즈가 자세히 공지를 못한 책임도 크기 때문에 계정 복구를 전부 다 해줬으면 좋겠고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.006,
                "end": 77.240
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 지금 이런 분도 있어요 아니 브릭시티 계정 연동 저는 똑바로 했습니다 데브 플레이 계정과 쿠키런 킹덤 데브 플레이에 계정을 일치 시켰는데도 보상이 안 들어와요 하시는 분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.250,
                "end": 89.464
            },
            {
                "speaker_id": "1",
                "transcription": "그거는 게임 껐다 켜서 우편함에 여러분들 브릭시티 단계 달성 보상 요게 들어오는지 보셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.474,
                "end": 96.972
            },
            {
                "speaker_id": "1",
                "transcription": "우편함으로 이렇게 보상이 들어와야 미션이 깨지는 거기 때문에 여러분들이 접속한 상태에서 그냥 깨지는 게 절대 아니예요 껐다 켜서 우편함을 확인해 보시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.975,
                "end": 107.042
            },
            {
                "speaker_id": "1",
                "transcription": "한 번 껐다 켰는데 안 되는 분들은 어떤 분은 6번째 7번째 껐다 켜서 접속 방법이 들어온 분 있으니까 계속 껐다 켜서 미션이 클리어되는지 확인해 보시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 107.042,
                "end": 116.673
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 또 하나 브릭시티 미션 중에 이런 게 있어요 기능 준비 중입니다 다음 업데이트를 기다려주세요 이런 문구가 뜨는 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 116.683,
                "end": 124.171
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거는 지금 못하는 게 아니고요 바로 가기 기능이 업데이트가 안 된거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 124.181,
                "end": 128.987
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요런 미션 같은 거는 불가능한 게 아니라 시티 좋아요 누르기 같은 경우에는 뭐 소셜 가셔서 여러분들 친구한테 좋아요 누르거나 아니면 친구가 없다 하시는 분들은 다른 분들 시티 투어 가서 좋아요를 누르면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 128.990,
                "end": 143.762
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여기 미션 중에 특별 브릭 선물하기 같은 경우에도 다른 분들의 도시에 가서 브릭을 선물해 주면은 미션이 클리어됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 143.772,
                "end": 151.900
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 제가 지구 복원 10단계까지 했는데 아 시간이 엄청 걸릴 것 같습니다 15단계까지 다 해야 쿠키런 킹덤을 보상을 다 받을 수가 있는데 아마 이런 분도 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 151.900,
                "end": 162.162
            },
            {
                "speaker_id": "1",
                "transcription": "이거 해야 될 필요가 있나요 굳이 이거 안 받고 그냥 넘어가도 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 162.162,
                "end": 166.091
            },
            {
                "speaker_id": "1",
                "transcription": "결론만 말씀드리면은 한정 스킨만 받아서 끝나는 게 아니라 여러분들 이 한정 랜드마크를 받으면 왕국 번영도에서 랜드마크의 총 레벨이 올라가게 되고 그렇게 되면은 번영도의 점수가 올라갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 166.101,
                "end": 179.715
            },
            {
                "speaker_id": "1",
                "transcription": "번영도의 점수가 올라가면 번영도에 따른 버프를 여러분들이 또 따로 받을 수가 있고 이 번영도 랭킹도 여러분들이 따로 올릴 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 179.715,
                "end": 187.841
            },
            {
                "speaker_id": "1",
                "transcription": "자 뿐만 아니라 이번에 미션 5번째를 클리어하게 되면 여러분들이 한정 성 스킨을 얻을 수 있고 그다음에 리미티드 에디션 놀이 테마도 열릴 수가 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 187.851,
                "end": 198.420
            },
            {
                "speaker_id": "1",
                "transcription": "자 리미티드 에디션을 다 모으면 또 왕국 번영도에서 자 리미티드 에디션은 수집 완료한 데코 테마 여기에서도 점수가 추가로 올라가게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 198.417,
                "end": 208.023
            },
            {
                "speaker_id": "1",
                "transcription": "기간 한정 점수 만 5000점이 또 올라가기 때문에 여러분들이 왕국 번영도 점수를 신경쓰는 분들 반드시 클리어해 주셔야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 208.033,
                "end": 217.122
            },
            {
                "speaker_id": "1",
                "transcription": "기간 한정 같은 경우에는 한번 지나가면 나중에 점수를 올릴 수가 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 217.122,
                "end": 222.412
            },
            {
                "speaker_id": "1",
                "transcription": "자 브릭시티 이거 퀘스트 깨는데 재화 좀 더 필요한 분들 브릭시티 관련된 쿠폰 코드가 나온게 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 222.412,
                "end": 229.830
            },
            {
                "speaker_id": "1",
                "transcription": "자 화면에 나오는 코드 입력해서 좀 더 빠르게 깨셔도 되고요 쿠폰은 여기에 보면 쿠폰 입력있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 229.830,
                "end": 236.705
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 정보 들어가서 내 아이디를 복사한 다음에 쿠폰 입력 누르고 자 여기에 들어가서 내 아이디 쓰고 여기에다가 쿠폰 코드 입력하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 236.705,
                "end": 246.620
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러면은 이렇게 다양한 보상을 이렇게 얻을 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 246.630,
                "end": 251.900
            }
        ]
    },
    "summary": "지금 이벤트로 무지개 큐브 3000개를 드리고 있고 연동으로 인한 피해자가 많은데 데브시스터즈에서 공지를 안 한 잘못도 있기 때문에 다 복구를 해줬으면 좋겠고 연동 제대로 했는데 보상은 못 받으신 분들은 계속 켰다 껐다 하시면 들어올 것이다.",
