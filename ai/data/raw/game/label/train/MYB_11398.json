                    2,
                    3
                ],
                "start": 4.773,
                "end": 17.389
            },
            {
                "speaker_id": "1",
                "transcription": "아니 브금이랑 연출 미쳤네요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 17.399,
                "end": 19.870
            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 왜 여기서 엘들링에 이런 라단의 말이 생각나는 걸까요?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 19.880,
                "end": 47.016
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 너무 멋있어 어떡해?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.026,
                "end": 58.366
            },
            {
                "speaker_id": "1",
                "transcription": "나 이제 딴 게임 못해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.376,
                "end": 64.144
            },
            {
                "speaker_id": "1",
                "transcription": "나 그냥 이런 왕자님 캐릭터 별로 안 좋아하긴 하는데.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 64.154,
                "end": 68.529
            },
            {
                "speaker_id": "3",
                "transcription": "안돼 씹덕 포인트 그거 만들면 영상 2시간은 기본이야.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 68.539,
                "end": 73.267
            },
            {
                "speaker_id": "3",
                "transcription": "원신 때도 검은 사막 때도 영상 길이만 기본 1시간이 넘었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.277,
                "end": 77.673
            },
            {
                "speaker_id": "1",
                "transcription": "어 그렇게 되면 제가 빨리 수익 창출을 낼 수 있겠네요 감사합니다.",
                "sound_type": [
                    2,
