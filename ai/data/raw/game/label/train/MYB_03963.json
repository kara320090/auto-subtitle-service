        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "투 힐로 해서 가는 거 어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.382
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 60 웨이브까지 왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.392,
                "end": 11.853
            },
            {
                "speaker_id": "1",
                "transcription": "정말 스무스하게 어 클리어가 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.863,
                "end": 22.093
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 덱 하나로 클리어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.103,
                "end": 27.365
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 지금 수호 성전 이번에 역대급으로 쉬운 것 같거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.375,
                "end": 31.495
            },
            {
                "speaker_id": "1",
                "transcription": "아 세팅하는 방법은 올 에픽으로 세팅 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.505,
                "end": 34.831
            },
            {
                "speaker_id": "1",
                "transcription": "크림유니콘 자리에는 퓨바 아니면 BTS 쿠키 가능하고 나는 올 쿨 토핑이 피해 감소 붙은 게 없으면은 그냥 BTS 해서 쿨만 챙겨서 해도 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.841,
                "end": 45.193
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 피, 피, 쿨, 쿨, 쿨이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.203,
                "end": 48.156
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 부옵션이나 이런 거 상관없이 그냥 피감만 높게 세팅해 주면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.166,
                "end": 52.482
            },
            {
                "speaker_id": "1",
                "transcription": "피감만 높게 네 요거에서 신경 써 줄 거는 뭐 공속 높거나 자구마도 2.8퍼센트 이상 나머지는 피감 좀 신경 써 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.492,
                "end": 61.632
            },
            {
                "speaker_id": "1",
                "transcription": "다크카카오 3템 덱 같은 경우에는 클리어 시간이 더 짧아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.642,
                "end": 65.305
            },
            {
                "speaker_id": "1",
                "transcription": "더 빨리 갱신을 하고 싶으신 분들은 그 덱으로 하시고 수호 성전은 여러분들 편하게 깨시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.315,
                "end": 72.468
            },
            {
                "speaker_id": "1",
                "transcription": "야 이지하다 이지해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.478,
                "end": 76.633
            }
        ]
