        "term": [
            {
                "speaker_id": "1",
                "transcription": "블랙 레모네이드 맛 쿠키 업데이트 이후 파르페 맛 쿠키와 망고 맛 쿠키 마법 사탕이 함께 업데이트되었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.461
            },
            {
                "speaker_id": "1",
                "transcription": "블랙 레모네이드 맛 쿠키는 샤이닝 글리터 맛 쿠키와 함께 사용하면 아레나에서뿐 아니라 스토리에서도 시너지 좋은 조합으로 사용 가능하고 파르페 맛 쿠키도 기존에 비해 사기적인 마법 사탕 신규 능력 추가로 단숨에 0티어로 올라왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.471,
                "end": 19.411
            },
            {
                "speaker_id": "1",
                "transcription": "망고 맛 쿠키도 스킬 능력이 단순하지만 포함 증가와 강력한 딜로 토벌뿐 아니라 스토리에서도 유용하게 활용 가능하게 되었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.421,
                "end": 27.766
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 만들어진 스토리 쿠키 티어는 신규 쿠키들의 능력이 기존 쿠키들의 능력보다 월등하게 좋게 출시됨에 따라 티어 변동이 있게 되었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.776,
                "end": 35.618
            },
            {
                "speaker_id": "1",
                "transcription": "초보자분들은 0티어 위주로 참고해 주시고 망고 맛 쿠키는 현재 토벌에서 유용하게 사용되지만 초보자분들이 우선적으로 키워야 될 쿠키는 아니기 때문에 가급적이면 망고 맛 쿠키 말고 다른 0티어 쿠키를 먼저 키우는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.628,
                "end": 49.423
            },
            {
                "speaker_id": "1",
                "transcription": "스토리 쿠키 티어는 가장 좋은 0티어부터 5티어까지 정리해 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.433,
                "end": 53.862
            },
            {
                "speaker_id": "1",
                "transcription": "모바일 게임을 플레이한 만큼 혜택을 받을 수 있는 플레이오 앱을 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.872,
                "end": 57.939
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 쌓이는 젬을 코인으로 교환해 상점에서 기프트카드 문화상품권 등 다양한 상품으로 구매 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.949,
                "end": 63.653
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 시청하고 가입한 신규 유저분들한테는 특별 시크릿 코드 플오ND러너를 입력하면 만젬을 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.663,
                "end": 70.502
            },
            {
                "speaker_id": "1",
                "transcription": "추가로 플레이오의 자체적인 퀘스트들이 있어서 게임을 진행하면서도 다양한 젬을 추가로 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.512,
                "end": 76.544
            },
            {
                "speaker_id": "1",
                "transcription": "게임하고도 기프트카드 문화상품권 무료로 얻고 너무나 좋은 기회 아닌가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.554,
                "end": 81.366
            },
            {
                "speaker_id": "1",
                "transcription": "다운로드 링크는 고정 댓글을 참고하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.376,
                "end": 84.866
            }
        ]
    },
    "summary": "화자가 블랙 레모네이드 맛 쿠키와 파르페 맛 쿠키 망고 맛 쿠키 마법 사탕이 함께 업데이트되었다며 스킬이나 조합을 설명한 뒤 플레이오 앱을 광고하고 있다.",
