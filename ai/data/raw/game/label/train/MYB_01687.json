    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 마이힐링타운 모바일 게임입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.801
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 꾸미기 게임이고 각종 이벤트와 미니게임이 있는 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.811,
                "end": 13.317
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 드림 브리지 게임을 하기 전에 이 게임이 어떤 건지 처음 들어온 분들한테 간단하게만 소개해 드리고 시작해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.327,
                "end": 22.339
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 게임은 이 바다 쪽으로도 이렇게 영토를 넓히고 그리고 이렇게 육지 쪽으로도 영토 확장을 통해서 나만의 세계를 만들 수 있는 그런 게임입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.349,
                "end": 32.785
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 꾸미기조차도 여러분들이 원하는 꾸미기 테마에 맞게끔 꾸미기를 할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.795,
                "end": 38.129
            },
            {
                "speaker_id": "1",
                "transcription": "자 보시면 이렇게 블록을 쌓아서 입체적으로 원하는 글자도 만들 수 있고 입체적으로 된 꾸미기조차도 고퀄리티로 이렇게 꾸미기를 할 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.139,
                "end": 47.273
            },
            {
                "speaker_id": "1",
                "transcription": "아 단순히 꾸미기만 이 게임을 하는 건가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.283,
                "end": 49.954
            },
            {
                "speaker_id": "1",
                "transcription": "아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.964,
                "end": 50.880
            },
            {
                "speaker_id": "1",
                "transcription": "꾸미기 뿐만 아니라 가족 개념의 길드 개념도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.890,
                "end": 54.756
            },
            {
                "speaker_id": "1",
                "transcription": "길드 버프도 같이 이렇게 올릴 수 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.766,
                "end": 57.666
            },
            {
                "speaker_id": "1",
                "transcription": "가족 영토에서 따로 꾸미기를 하고 따로 영토를 합칠 수도 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.676,
                "end": 61.906
            },
            {
                "speaker_id": "1",
                "transcription": "각자 집 안 꾸미기도 가능하고 농작물 재배와 낚시까지 따로 즐길 수 있는 콘텐츠가 존재합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.916,
                "end": 69.656
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 파티도 존재합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.666,
                "end": 71.824
            },
            {
                "speaker_id": "1",
                "transcription": "파티를 열어서 뭐 요리를 만들고 원재료 파밍도 하고 그래서 이렇게 행상 콘텐츠에서 요리를 만들어서 다양한 보상을 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.834,
                "end": 82.525
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 게임은 굳이 꾸미기를 안 하더라도 보시는 거와 같이 뭐 미니게임에 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.535,
                "end": 87.348
            },
            {
                "speaker_id": "1",
                "transcription": "미니게임을 통해서 영토를 더 넓혀서 갈 수도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.358,
                "end": 91.920
            },
            {
                "speaker_id": "1",
                "transcription": "얘 같은 경우에는 뭐 목적이 분명하죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.930,
                "end": 95.110
            },
            {
                "speaker_id": "1",
                "transcription": "왼쪽에 목표가 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.120,
                "end": 96.503
            },
            {
                "speaker_id": "1",
                "transcription": "요고를 다 없애면은 클리어입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 96.513,
                "end": 100.182
            },
            {
                "speaker_id": "1",
                "transcription": "요고를 야 시원시원하구만.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 100.192,
                "end": 104.400
            }
        ]
    },
    "summary": "마이힐링타운 모바일 게임은 꾸미기와 각종 이벤트, 미니게임이 있는 게임으로 바다 쪽으로 영토확장을 하여 나만의 세계를 만들 수 있고 가족 기념의 길드와 파티도 존재하는 것처럼 콘텐츠가 다양하다.",
