        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 근데 상대 와일드베리도 단단하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.435
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 버텨버리네 이걸 버텨버리네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.445,
                "end": 6.245
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 상대방도 와일드베리를 이용해서 아 역시나 단단하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.255,
                "end": 13.061
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 이 조합 같은 경우에도 딜러가 없다 보니까 상대 쿠키를 죽이지 못하는 단점이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.071,
                "end": 19.262
            },
            {
                "speaker_id": "1",
                "transcription": "네 밤새 방덱으로 해봤는데 방어 기록 보니까 일단은 다 막기는 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.272,
                "end": 24.598
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱도 다 막더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.608,
                "end": 26.511
            },
            {
                "speaker_id": "1",
                "transcription": "예능으로 제가 일단 해봤던 건데 막는 모습을 다 볼 수가 있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.521,
                "end": 32.299
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱 확실히 잘 막네요 와일드베리가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.309,
                "end": 34.379
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막 한 번 더 뭐 이 조합은 여러분들 뭐 엄청 좋으니까 쓰라는 것보다는 예능입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.389,
                "end": 40.894
            },
            {
                "speaker_id": "1",
                "transcription": "정말 모든 방어적인 요소를 다 갖춘 조합이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.904,
                "end": 45.360
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 보호막도 많고 치명타 피해 감소도 올려주고 자체 피감도 높고 네 그런 컨셉이다 보니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.370,
                "end": 54.333
            }
        ]
    },
