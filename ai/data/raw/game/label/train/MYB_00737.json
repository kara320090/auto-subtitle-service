                ],
                "start": 169.608,
                "end": 174.200
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 쿠키는 피해 집중 스킬을 통해 아군이 받는 피해량과 치명타 피해를 35퍼센트 감소시켜 줍니다.",
                "sound_type": [
                    2,
