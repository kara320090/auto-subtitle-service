                    2,
                    3,
                    5
                ],
                "start": 115.150,
                "end": 117.430
            },
            {
                "speaker_id": "1",
                "transcription": "스냅드래곤 쿠키는 죽지 않는 특수 무적 능력을 가진 쿠키입니다.",
                "sound_type": [
