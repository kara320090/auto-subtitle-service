        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 소르베랑 서리를 많이 씁니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.844
            },
            {
                "speaker_id": "1",
                "transcription": "네 그런 식으로 쓰고 있다는 점 에스프레소 4초월이 센가요 블펄 2성이 세나요?",
                "sound_type": [
                    2
                ],
                "start": 1.854,
                "end": 11.233
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 덱에 따라 조합에 따라 다르지만 일반적으로 저라면 에스프레소 보다는 블랙펄을 쓸 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.243,
                "end": 17.827
            },
            {
                "speaker_id": "1",
                "transcription": "승급 차이 때문에 안 쓰이는 게 아니라 블랙펄 쿠키는 디버프가 좋기 때문에 디버프 하나만으로도 상대방한테 엄청 큰 피해 주기 때문에 좀 타격이 크거든요 디버프 걸리면?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.837,
                "end": 29.980
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 블랙펄을 더 많이 쓸 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.990,
                "end": 32.455
            },
            {
                "speaker_id": "1",
                "transcription": "자 보시면 아시겠지만 상대가 소르베 서리덱 빙결덱이 아니면은 웬만해서는 다 이렇게 이깁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.465,
                "end": 41.335
            },
            {
                "speaker_id": "1",
                "transcription": "자 딜랑 보게 되면은 제가 리뷰할 때도 보여드렸지만 2성이라도 블랙펄 5초월보다 딜이 더 높게 나오는 경우가 수두룩 많았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.345,
                "end": 49.605
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 지금 키울까 말까요 고민하시는 분들 승급이 낮아서 키워도 되나 이렇게 생각하시는 분들 무조건 키우세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.615,
                "end": 57.505
            },
            {
                "speaker_id": "1",
                "transcription": "승급 낮아도 확실히 여러분들한테 만족감을 줄 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.515,
                "end": 61.519
            },
            {
                "speaker_id": "1",
                "transcription": "네 1성이라도 키우고 0성이라도 키우고 네 승급 낮아도 키워주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.529,
                "end": 70.583
            }
        ]
    },
    "summary": "덱과 조합에 따라 다르지만 일반적으로 에스프레소 보다는 블랙펄을 쓰고 달빛술사는 승급이 낮아도 만족감을 주기 때문에 무조건 키워야한다.",
