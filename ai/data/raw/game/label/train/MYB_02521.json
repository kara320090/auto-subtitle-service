        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 요로케 주스 덱 리뷰를 마치겠습니다. 이게 장단점이 확실하죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.084
            },
            {
                "speaker_id": "1",
                "transcription": "나보다 스펙을 높은 사람한테는 힘들지만 현재로서 가장 좋은 공덱이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.094,
                "end": 8.921
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 원탱 덱이랑 싸울 때는 미러전을 가면 요 덱으로 그대로 가면 집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.931,
                "end": 13.747
            },
            {
                "speaker_id": "1",
                "transcription": "무공비 대신 깃털을 쓰는 덱도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.757,
                "end": 15.957
            },
            {
                "speaker_id": "1",
                "transcription": "요로케 해서 가시면 됩니다. 주스댁 여기서 리뷰를 마치도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.967,
                "end": 37.690
            }
        ]
    },
    "summary": "주스 덱 리뷰를 마치며 나보다 스펙을 높은 사람한테는 힘들지만 현재로서 가장 좋은 공덱이고 원탱 덱이랑 싸울 때는 미러전을 요 덱으로 그대로 가면 지고 무공비 대신 깃털을 쓰는 덱도 있다.",
