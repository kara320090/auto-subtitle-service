    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 찰스호몬드덱입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.049
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱은 모든 상대방 덱한테 들어가면 안 되고 상대방 방덱이 공속덱으로 되어있는 분들에게만 들어가시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.059,
                "end": 10.690
            },
            {
                "speaker_id": "1",
                "transcription": "자 보물은 무공비, 호루라기, 시계고 이 조합 같은 경우에는 스페셜 길드의 창파이 님이 만드셨는데 호루라기를 창파이 님은 달빗하고 호밀한테 주셨어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.700,
                "end": 20.391
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 그것보다 호루라기가 스타더스트랑 호밀이 만든 게 더 좋아서 저는 요렇게 세팅을 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.401,
                "end": 27.093
            },
            {
                "speaker_id": "1",
                "transcription": "세팅을 각각 해 보시고 좋은 거 쓰시면 될 것 같구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.103,
                "end": 29.721
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 같은 경우에는 아 찰스는 공속 0이어야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.731,
                "end": 33.514
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 0으로 세팅을 세팅해 주시고 쿨은 있어도 상관없고 피해 감소는 많이 있을수록 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.524,
                "end": 39.959
            },
            {
                "speaker_id": "1",
                "transcription": "여유 있으면 공, 치 자 스타더스트 같은 경우에는 쿨타임 10.3 이상 4라즈, 1쿨 이렇게 세팅을 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.969,
                "end": 47.567
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 피감은 최대한 높게 여러분들 신경 써 주시고 여유 있으면 공, 치 10.3퍼센트로 맞춰야 되는 이유가 시작 쿨타임을 요렇게 3초로 가져가기 위해서 세팅을 하는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.577,
                "end": 58.231
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 좀 쿨이 힘들다 하시면 3라즈, 2쿨 세팅을 해 주셔서 10.3퍼센트 이상 넘게 해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.241,
                "end": 66.880
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛술사는 3라즈, 2애플젤리 스타더스트가 호루라기 받기 위해서 일부러 라즈를 빼고 애플젤리 섞어서 공격력을 낮춰줬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.890,
                "end": 75.845
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 같은 경우에는 피해 감소랑 공, 치 위주로 신경 써 주시면 되고 자 호밀 같은 경우에는 피해 감소가 필요 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.855,
                "end": 82.552
            },
            {
                "speaker_id": "1",
                "transcription": "예, 공격력하고 치명타 확률 신경 써 주시고 공격 속도는 무조건 7퍼센트 이상 해 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.562,
                "end": 88.825
            },
            {
                "speaker_id": "1",
                "transcription": "상대방이 스킬 쓰기 전에 잘라줘야 되기 때문에 여러분들이 만약에 이걸 세팅을 해서 쓰는데 상대방달빛술사가 죽지 않고 스킬 써요 하시는 분들은 공속을 꼭 높여 주셔서 죽여줘야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.835,
                "end": 100.607
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 공, 치도 최대한 높게 해서 상대방 달빛술사 죽일 수 있게끔 세팅을 해 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 100.617,
                "end": 105.721
            },
            {
                "speaker_id": "1",
                "transcription": "자 아몬드맛 쿠키는 공속이 0이 필수입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 105.731,
                "end": 108.662
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 피감 그다음에 공, 치 신경 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 108.672,
                "end": 113.600
            }
        ]
    },
    "summary": "찰스호몬드덱은 상대방이 공속덱인 분들에게만 들어가고 호루라기는 스타더스트와 호밀에게 주고 공속은 0이고 피해 감소는 많을수록 좋고 스타더스트는 쿨타임 10.3 이상 4라즈, 1쿨 세팅하고 달빛술사는 3라즈, 2애플젤리, 공격력하고 치명타 확률 신경 써 주고 공격속도는 7퍼센트 이상 세팅해야 하며 아몬드맛 쿠키는 공속 0이 필수이며 피감, 공, 치를 신경 써 주기 바란다.",
