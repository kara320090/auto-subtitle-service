        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기서 체력 싹 다 채워주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.067
            },
            {
                "speaker_id": "1",
                "transcription": "딜 한번 세게 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.077,
                "end": 6.461
            },
            {
                "speaker_id": "1",
                "transcription": "이거 어때?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.471,
                "end": 8.565
            },
            {
                "speaker_id": "1",
                "transcription": "이거 상당히 괜찮긴 하네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.575,
                "end": 12.148
            },
            {
                "speaker_id": "1",
                "transcription": "28강 리뷰 끝났습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.158,
                "end": 14.323
            },
            {
                "speaker_id": "1",
                "transcription": "딜은 최강이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.333,
                "end": 15.646
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 몸은 약하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.656,
                "end": 17.390
            },
            {
                "speaker_id": "1",
                "transcription": "30강이 되면 역시나 전략은 똑같이 1분 전에 상대를 죽이는 그런 전략으로 쓰지 않는 한 바다요정은 쓰기 힘들 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.400,
                "end": 26.976
            },
            {
                "speaker_id": "1",
                "transcription": "신규 쿠키가 나왔을 때 시너지 좋게 또 쓰일 수 있지만 그전까지는 블랙펄이 좀 더 우위적으로 사용하게 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.986,
                "end": 35.444
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 28강 잼스톤 리뷰는 여기서 마치도록 하겠습니다.",
