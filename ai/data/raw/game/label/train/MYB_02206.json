        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 @계정1님 150만 개 뽑기 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.381
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이분은 사연을 따로 보내주셨는데 안녕하세요 저는 올해 40대 후반 데브시스터즈 터줏대감 아재입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.391,
                "end": 11.717
            },
            {
                "speaker_id": "1",
                "transcription": "게임 나오자마자 시작해서 하루 아침 점심 저녁 먹듯이 하루 기본 3번 이상 3시간 이상 접속하는 썩은 물 유저다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.727,
                "end": 20.460
            },
            {
                "speaker_id": "1",
                "transcription": "바다 요정 시즌부터 뽑기가 너무 안 돼서 쿠키커터만 거의 사용하고 거의 크리스털은 사용 안 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.470,
                "end": 26.435
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 마일리지 다 써서 무공비 만렙 찍어주시고 그다음에 한이 서린 바다 요정 초월 가능하게 해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.445,
                "end": 33.603
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 캡사이신 달빛 그다음에 스타더스트 등 요즘 대세인 쿠키들 쫙 다 뽑아주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.613,
                "end": 40.644
            },
            {
                "speaker_id": "1",
                "transcription": "와 그러니까 패키지 2000원짜리 하나 빼고는 무과금으로 모았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.654,
                "end": 45.508
            },
            {
                "speaker_id": "1",
                "transcription": "무공비급 만렙까지 해달라고 하셨거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.518,
                "end": 47.854
            },
            {
                "speaker_id": "1",
                "transcription": "무공비급이랑 일단 공속이랑",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.864,
                "end": 50.600
            }
        ]
    },
    "summary": "화자가 뽑기를 대신해달라고 한 사람의 의뢰를 읽고 있다.",
