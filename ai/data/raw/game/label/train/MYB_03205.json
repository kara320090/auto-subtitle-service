        "term": [
            {
                "speaker_id": "1",
                "transcription": "크리스털 뽑기가 메인이 아니에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.292
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 몸풀기라는 점 이게 본 게임이야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.720,
                "end": 5.040
            },
            {
                "speaker_id": "1",
                "transcription": "여기가 중요해 크리스털 뽑기 확률이 적어서 큰 기대는 안 합니다.",
                "sound_type": [
                    2,
