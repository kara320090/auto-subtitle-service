                ],
                "start": 5.525,
                "end": 11.507
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 메인은 따로 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.812,
                "end": 15.815
            },
            {
                "speaker_id": "1",
                "transcription": "크리스털 몇 개 정도 돼야지 달빛이 달빛이 나올까요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.157,
                "end": 21.208
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 기댓값은 한 55에서 60만 개 사이인 것 같아요.",
