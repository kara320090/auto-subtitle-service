        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 혼돈의 케이크 타워 드디어 열렸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.805
            },
            {
                "speaker_id": "1",
                "transcription": "여기가 드디어 별사탕과 크리스탈과 쿠키커터가 폭발적으로 나오는 여기가 정말 중요하거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.815,
                "end": 16.660
            },
            {
                "speaker_id": "1",
                "transcription": "여기 보이죠 순수의 설탕 결정은 케이크 타워에서 정말 많이 얻을 수 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.670,
                "end": 21.874
            },
            {
                "speaker_id": "1",
                "transcription": "한 가지 제가 더 팁을 드리면 가끔가다가 금요일쯤에 쿠킹덤 공식 카페에서 공지가 와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.884,
                "end": 28.077
            },
            {
                "speaker_id": "1",
                "transcription": "케이크 타워 주말 버프에서 상세 공지가 나오거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.087,
                "end": 32.018
            },
            {
                "speaker_id": "1",
                "transcription": "그 공지 중에 뭐 매주마다 그렇게 되는 건 아니지만 케이크 타워 보상이 상향되는 그런 버프가 되는 날이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.028,
                "end": 40.926
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 평소에 케이크 타워 열쇠를 금요일 때쯤 거의 꽉 채워놓고선 어 주말에 보상 더 추가로 주는 버프가 있는지 체크해 보고 어 만약에 버프가 없으면 그냥 열쇠 다 소모해도 되고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.936,
                "end": 54.545
            },
            {
                "speaker_id": "1",
                "transcription": "다시 또 다음 주 금요일쯤 됐을 때 열쇠를 가득 채운 다음에 주말 버프 하는지 확인해 보고 아니면 또다시 소모해 주고 약간 이런 식으로 준비를 해놓으면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.555,
                "end": 65.366
            }
        ]
    },
