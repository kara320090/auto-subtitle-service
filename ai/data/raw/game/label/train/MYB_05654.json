        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 토벌 121단계까지 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.634
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 좀 놀랄 법 한 게 이번에 제가 이 공격력 쪽은 처음 이렇게 유심히 봤는데 무려 토벌 용 공격력이 6억이 넘습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.644,
                "end": 13.622
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 쿠키들이 용 할퀴기나 이런 거에 스치기만 해도 날라가는지 보면은 공격력이 미쳐 날뜁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.632,
                "end": 19.869
            },
            {
                "speaker_id": "1",
                "transcription": "이건 진짜 버틸 수가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.879,
                "end": 21.347
            },
            {
                "speaker_id": "1",
                "transcription": "근데 더 웃긴 거는 방어력도 12억입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.357,
                "end": 24.499
            },
            {
                "speaker_id": "1",
                "transcription": "방어력이 이렇게 높은데 어떻게 딜이 이렇게 많이 들어갈 수 있고 그러냐 저희가 이제 항상 쓰고 있는 이 장난감 새총 보물이 토벌에서 만큼은 진짜 레전드 중에 레전드 보물이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.509,
                "end": 36.504
            },
            {
                "speaker_id": "1",
                "transcription": "대체가 불가능한 급입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.514,
                "end": 38.550
            },
            {
                "speaker_id": "1",
                "transcription": "거의 이 새총 보물은 쿠키런 킹덤이 망할 때까지 진짜 토벌에 쓰이지 않을까 그렇게 생각이 들고 다크 초코 또한 이 능력만 보면 이 모르시는 분들 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.560,
                "end": 48.507
            },
            {
                "speaker_id": "1",
                "transcription": "방어력 감소가 7초 동안 20퍼센트다 아 그러면은 방깎이 20퍼센트 들어가니까 이게 끝이다라고 생각할 수 있는데 다크 초코는 이 스킬이 딱 들어가면서 용 크기가 이제 되게 크기 때문에 방깎이 최대 3개가 들어가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.517,
                "end": 61.738
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 60퍼센트까지 방깎이 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.748,
                "end": 63.806
            },
            {
                "speaker_id": "1",
                "transcription": "토벌하다 보면은 그 방깎 표시가 다크 초코가 스킬 쓰면 3개 표시가 뜰 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.816,
                "end": 68.740
            },
            {
                "speaker_id": "1",
                "transcription": "다크 초코는 현재 대체가 불가능한 쿠키고 추후에 마법 사탕으로 어떤 쿠키가 방깎을 달고 나올 수도 있지만 그전까지는 다크 초코 대체가 그냥 불가능하다 그렇게 알고 계시면 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.750,
                "end": 83.700
            }
        ]
    },
    "summary": "토벌 121단계에서 토벌의 용 공격력은 6억이 넘고 방어력은 12억이라 강한데 새총 보물로 딜을 많이 넣을 수 있고 다크 초코의 7초 동안 20퍼센트 방깎 스킬로 용에게 최대 60퍼센트 방깎이 가능해서 새총 보물과 다크 초코가 토벌에서 꼭 있어야 한다.",
