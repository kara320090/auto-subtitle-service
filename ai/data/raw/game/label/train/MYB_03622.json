        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 요런식으로 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.122
            },
            {
                "speaker_id": "1",
                "transcription": "마지막에 누가 터지던 간에는 상관 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.132,
                "end": 5.060
            },
            {
                "speaker_id": "1",
                "transcription": "호밀이 터지면 딜 손실이 좀 있긴 한데 뭐 상관없습니다. 이렇게 딜이 나오게 된다는 점",
                "sound_type": [
                    2
                ],
                "start": 5.070,
                "end": 10.955
            },
            {
                "speaker_id": "1",
                "transcription": "아마 이거 보면은 아 너무 어렵다 생각해도 좀 약간 익혀지면은 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.965,
                "end": 16.030
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 금방 끝나기 때문에 요거 하나만 좀 익혀두시길 바랍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.040,
                "end": 20.323
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 대천사 토벌전 이게 최종판입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.333,
                "end": 23.900
            },
            {
                "speaker_id": "1",
                "transcription": "더 이상은 더 없을 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.910,
                "end": 27.833
            }
        ]
    },
    "summary": "화자가 대천사 토벌전 이게 최종판이며 더는 없을 거 같다고 토벌은 금방 끝나기 때문에 어려워 보여도 요거 하나만 익혀두길 바란다고 하면서 호밀이 터지면 딜 손실이 좀 있긴 하지만 상관없다고 한다.",
