        "term": [
            {
                "speaker_id": "1",
                "transcription": "수면에 걸리냐 안 걸리냐에 따라서 상당히 네 경우의 수가 달라지기 때문에 여러분들이 내가 쿨타임 설정한 게 잘못됐다 라기 보다는 상대 조합에 따라 다르다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 14.498
            },
            {
                "speaker_id": "1",
                "transcription": "고거 체크를 계속 해 주면서 게임을 해 주시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.508,
                "end": 19.327
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요고 여기서 좀 중요하게 체크해야 될 포인트가 아니 어떻게 이겼는데 용과 딜 차이가 이렇게 나냐 이게 1분 타이밍에 맞춰서 용과가 스킬이 들어간 경우 저는 1분보다 일찍 들어간 경우에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.337,
                "end": 33.959
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 여기서 되게 중요하게 말씀드리고 싶은 게 어떤 경우가 됐던간에 1분 지나서 스킬 써서 이기고 싶어요라고 말씀하시는 분들 있죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.969,
                "end": 42.232
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 해 가지고 이길 수도 있는데 1분 지나서 승부가 안 나도 이게 돌다 보면은 용과까지 남는 경우가 생기는 경우가 있거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.242,
                "end": 50.689
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 경우에는 30초 싸움될 때 용과가 먼저 1분 전에 스킬 쓴 사람이 이기는 경우가 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.699,
                "end": 57.461
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 여러분들이 선택을 해야 돼요.",
                "sound_type": [
                    2
                ],
                "start": 57.471,
                "end": 59.167
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 무승부로 끝날건가 아니면 내가 1분 전에 스킬을 먼저 써 가주고 풀이 좀 더 빨리 돌아서 30초 때 내가 용과가 스킬 먼저 써서 이길건가",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.177,
                "end": 70.033
            }
        ]
    },
    "summary": "화자는 1분 지나서 스킬을 써서 이기고 싶은 분들도 있는데 1분이 지나도 승부가 안 나는 경우 용과가 먼저 1분 전에 스킬 쓴 사람이 이기는 경우가 있다고 하며 여러분들이 선택을 해야 한다고 한다.",
