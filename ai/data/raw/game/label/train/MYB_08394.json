        "term": [
            {
                "speaker_id": "1",
                "transcription": "아예 갑옷을 벗어버렸네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.181
            },
            {
                "speaker_id": "1",
                "transcription": "사표 내고 왔대요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.191,
                "end": 6.449
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 순직으로 처리해 달라고 했대요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.459,
                "end": 8.856
            },
            {
                "speaker_id": "1",
                "transcription": "어째서 난 널 따르기로 했어 밤의 여왕 아 뭐야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.866,
                "end": 14.327
            },
            {
                "speaker_id": "1",
                "transcription": "오리플람의 공작의 방식에 불만이 있어서가 아니라 노스리지를 위해서다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.337,
                "end": 19.612
            },
            {
                "speaker_id": "1",
                "transcription": "음 아직도 위협은 도사리고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.622,
                "end": 23.705
            },
            {
                "speaker_id": "1",
                "transcription": "음 우선은 도시를 지켜야겠지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.715,
                "end": 27.530
            },
            {
                "speaker_id": "1",
                "transcription": "우리라면 할 수 있다.",
