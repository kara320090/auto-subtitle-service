        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이거 방덱 바꿔야 되겠는데 여러분들?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.480
            },
            {
                "speaker_id": "1",
                "transcription": "그 일반 정석 덱은 한 방에 나가떨어지는 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 2.490,
                "end": 5.726
            },
            {
                "speaker_id": "1",
                "transcription": "자 이분한테도 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.736,
                "end": 8.353
            },
            {
                "speaker_id": "1",
                "transcription": "아 그 @이름1님 이덱 지금 바로 당장 키워야 하나요. 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.363,
                "end": 13.784
            },
            {
                "speaker_id": "1",
                "transcription": "여유 되는 분이 세팅 가능한 분 키우시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.794,
                "end": 17.199
            },
            {
                "speaker_id": "1",
                "transcription": "이 아레나 메타는 시간이 지나면 또 어떻게 될지 모르기 때문에 뭐 당장 지금 키워야 되고 이런 뜻이 아니에요.",
                "sound_type": [
                    2,
