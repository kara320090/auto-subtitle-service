        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덩을 피시에서 즐길 때 녹스 앱 플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.159
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.169,
                "end": 6.468
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.478,
                "end": 10.232
            },
            {
                "speaker_id": "1",
                "transcription": "지금 약간 토핑도 파밍 많이 안 된 상태라 아슬아슬하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.242,
                "end": 16.710
            },
            {
                "speaker_id": "1",
                "transcription": "버텨 버텨",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.720,
                "end": 18.538
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어는 안 쓰시나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.548,
                "end": 20.679
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어도 아직 안뽑았어요 에클레어 자체를",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.689,
                "end": 24.668
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어는 뽑아도 될 거 같긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.678,
                "end": 27.432
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 지금 스킬 파우더 겹치는 게 없거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.442,
                "end": 31.387
            },
            {
                "speaker_id": "1",
                "transcription": "지원형 자체가 지금 없기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.397,
                "end": 34.236
            },
            {
                "speaker_id": "1",
                "transcription": "보통 에클레어는 초반에 뽑으면은 겹치는 게 있으면 진짜 엄청 힘들거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.246,
                "end": 41.348
            },
            {
                "speaker_id": "1",
                "transcription": "근데 겹치는 게 없어서 어 야 죽지 마",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.358,
                "end": 46.556
            },
            {
                "speaker_id": "1",
                "transcription": "죽어도 어차피 부활 보물이 있기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.566,
                "end": 50.366
            }
        ]
    },
    "summary": "에클레어는 스킬 파우더가 겹치는 게 있으면 힘들지만 지금은 스킬 파우더 겹치는 게 없기 때문에 뽑아도 좋습니다.",
