        "term": [
            {
                "speaker_id": "1",
                "transcription": "구독자 20만 명 되면 뭐 하실 건가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.201
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 원하는 거 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.211,
                "end": 3.768
            },
            {
                "speaker_id": "1",
                "transcription": "음 여러분들 원하는 게 있으 있다면 그거 하나 사다리 타기 해서 하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.778,
                "end": 10.144
            },
            {
                "speaker_id": "1",
                "transcription": "오우 야 나 버그 걸렸나 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.154,
                "end": 13.611
            },
            {
                "speaker_id": "1",
                "transcription": "다크카카오 3개째야 이거 뭐야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.621,
                "end": 15.805
            },
            {
                "speaker_id": "1",
                "transcription": "아니 참나 이게 왜 이래.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.815,
                "end": 18.345
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이게 3개나 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.355,
                "end": 20.250
            },
            {
                "speaker_id": "1",
                "transcription": "야 야 이분 완성 많이 시켜드리네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.260,
                "end": 30.142
            },
            {
                "speaker_id": "1",
                "transcription": "서리여왕까지 자 아직 10만 개 남았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.152,
                "end": 38.082
            },
            {
