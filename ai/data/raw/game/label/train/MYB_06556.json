            {
                "speaker_id": "1",
                "transcription": "오",
                "sound_type": [
                    2
                ],
                "start": 58.115,
                "end": 63.898
            },
            {
                "speaker_id": "1",
                "transcription": "제가 침대에서 뭐하는지 보셨어요 혹시? 무서운 인간들이구만.",
                "sound_type": [
                    2
                ],
                "start": 63.908,
                "end": 73.871
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 다들 침대에서는 그렇게 되는 거 아닌가?",
                "sound_type": [
                    2
                ],
                "start": 73.881,
                "end": 80.347
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이거 지금 만약에 들어온 사람 있으면 내가 지금 뭘하고 있는 건가 싶을 거 같애 너무 징그러워서.",
                "sound_type": [
                    2
                ],
                "start": 80.357,
                "end": 87.717
            },
            {
                "speaker_id": "1",
                "transcription": "이게 뭐예요 이러면서 그지?",
                "sound_type": [
                    2
                ],
                "start": 87.727,
                "end": 89.875
            },
            {
                "speaker_id": "1",
                "transcription": "그러게 물귀신 안 나오나?",
                "sound_type": [
                    2
                ],
                "start": 89.885,
                "end": 92.366
            }
        ]
    },
