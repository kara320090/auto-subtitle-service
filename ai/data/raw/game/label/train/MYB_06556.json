            },
            {
                "speaker_id": "1",
                "transcription": "막 뭐 뜯는데?",
                "sound_type": [
                    2
                ],
                "start": 11.803,
                "end": 22.466
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 하는 거야?",
                "sound_type": [
                    2
                ],
                "start": 22.476,
                "end": 24.437
            },
            {
                "speaker_id": "1",
                "transcription": "위에 뭐가 보여요 여러분? 난 아무것도 안 보이는데",
                "sound_type": [
                    2
                ],
                "start": 24.447,
