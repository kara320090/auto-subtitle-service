                    5
                ],
                "start": 0.000,
                "end": 3.157
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 하는 지 안 외워 놓고 있으면 좀 힘든 느낌이네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.167,
                "end": 12.053
            },
            {
                "speaker_id": "1",
                "transcription": "그거면 훌륭해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.063,
                "end": 16.137
            },
            {
                "speaker_id": "1",
                "transcription": "우리 집 플스 파이브는 인테리어라는 말에 완전 공감함",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.147,
                "end": 19.603
            },
            {
                "speaker_id": "1",
                "transcription": "난 가끔 내가 플스 있는 지도 까먹을 정도였잖아",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.613,
                "end": 22.670
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 할 만한 게 있어야 하든지 말든지 하지",
