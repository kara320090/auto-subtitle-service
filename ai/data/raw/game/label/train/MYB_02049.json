        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고 복귀 유저분들 분명히 좀 있으실 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.678
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 덱이 이번에 또 바뀔 가능성이 크기 때문에 기존에 올라온 토벌 영상 일단 보지 말고 좀 기다리세요 알겠죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.688,
                "end": 12.483
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 쓸모없는 것만 계속 나와.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.493,
                "end": 15.677
            },
            {
                "speaker_id": "1",
                "transcription": "오우 야 그래도 3조각 야 근데 얘는 왜 이렇게 밋밋하냐 다른 레전드 고대 슈퍼 에픽이랑 비교했을 때 나는 얘가 너무 밋밋하다 생각하는 건 나만 그렇게 생각하나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.687,
                "end": 25.789
            },
            {
                "speaker_id": "1",
                "transcription": "나름 드로 드래곤 등급이면은 좀 약간 이펙트도 있고 뭔가 좀 화려해야 되는 거 아니야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.799,
                "end": 34.557
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 스페셜 커터 뽑기로 넘어 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.567,
                "end": 40.633
            }
        ]
    },
    "summary": "화자는 토벌 덱이 바뀔 가능성이 있으니 이전 토벌 영상을 보지 말고 기다리라고 조언하고, 3조각을 얻었지만 다른 레전드 슈퍼 에픽 카드와 비교했을 때 이 카드가 밋밋하다고 생각하며, 드래곤 등급의 카드는 더 화려해야 한다고 생각하고 그리고 스페셜 커터 뽑기로 넘어간다고 한다.",
