        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 일단 허브도 5성 웬만한 쿠키들 다 5성 돼가고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.659
            },
            {
                "speaker_id": "1",
                "transcription": "자 서리도 조각 평균적으로 이 분 다 3, 3, 3 찍어 드리고 싶은데 승급 조금씩 부족하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.669,
                "end": 14.194
            },
            {
                "speaker_id": "1",
                "transcription": "아 야 근데 에픽이 잘 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.204,
                "end": 17.685
            },
            {
                "speaker_id": "1",
                "transcription": "야 요렇게 해서 바요도 90조각 넘었고 다크도 여러분들 20, 30에서 3성 조각도 잘 나와서 나름 괜찮습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.695,
                "end": 28.957
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 10만 개 남기고 깔끔하게 여러분들 90만 크리스탈 썼고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.967,
                "end": 35.166
            },
            {
                "speaker_id": "1",
                "transcription": "네 이제 하이라이트 메인 메인 이벤트 자 바로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.176,
                "end": 41.119
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기서 하나만 완품 나와도 진짜 초대박인데",
                "sound_type": [
                    2,
