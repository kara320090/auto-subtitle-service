    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피시에서 즐길 때 녹스 플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.976
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.986,
                "end": 6.254
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.264,
                "end": 10.310
            },
            {
                "speaker_id": "1",
                "transcription": "자 맨 처음에 시작하자마자 마카롱 예약 눌러줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.320,
                "end": 13.700
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 목화 예약 눌러서 써주고 그다음에 오징어 먹물 예약해서 눌러줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.710,
                "end": 18.001
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 보스 출현 전에 스킬 쓰고 바로 웨어 울프 예약해서 스킬 대기 시간 이렇게 걸어줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.011,
                "end": 24.486
            },
            {
                "speaker_id": "1",
                "transcription": "그런 다음에 우유 맛 쿠키는 자동으로 스킬 써지게 그다음에 마카롱, 목화 써주고 자 그다음에 쭉 그냥 가만히 냅둡니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.496,
                "end": 32.313
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 쿨타임 돌아오는 데로 바로바로 스킬 써주면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.323,
                "end": 35.579
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 어려운 거 없이 자 여기 눌러주고 저 같은 경우에는 이거 그냥 냅둬요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.589,
                "end": 41.443
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 냅두고 자 이렇게 가고 여기서 중요한 거는 웨어 울프 써주고 자 요거 눌러주잖아 요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.453,
                "end": 49.292
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 진짜 중요한 포인트가 여기서 이제 우유가 목화보다 쿨이 더 일찍 풀려 가지고 얘 스킬 쓰거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.302,
                "end": 56.204
            },
            {
                "speaker_id": "1",
                "transcription": "가만히 냅두면 그러기 전에 40초 대에 마카롱 스킬 쓰고 목화로 예약을 걸어줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.214,
                "end": 61.969
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 우유가 스킬 쓰기 전에 안 쓰고 대기하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.979,
                "end": 65.322
            },
            {
                "speaker_id": "1",
                "transcription": "얘를 어떻게 하는 거냐면 목화 스킬 써 가지고 쫄들이 밀고 나가잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.332,
                "end": 69.829
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때 우유랑 스킬 같이 쓰는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.839,
                "end": 71.982
            },
            {
                "speaker_id": "1",
                "transcription": "얘 스킬 먼저 쓰게 되면은 혼자 밀고 나가서 쫄들이 우유 맛 쿠키를 엄청나게 엄청나게 집중 공격해서 죽는 경우도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.992,
                "end": 80.100
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 쫄이 밀고 나가서 우유 맛 쿠키랑 같이 나가는 그런 원리입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.110,
                "end": 84.691
            },
            {
                "speaker_id": "1",
                "transcription": "자 목화가 스킬 써서 우유랑 같이 밀고 나가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.701,
                "end": 87.864
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 스킬 그대로 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.874,
                "end": 91.528
            },
            {
                "speaker_id": "1",
                "transcription": "네 스킬 쓰고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.538,
                "end": 94.266
            }
        ]
    },
    "summary": "남성은 쿠키런 킹덤 처음 시작하자마자 마카롱 예약 후에 목화 예약을 하고 그다음 오징어 먹물 예약을 하고 보스 출현 전에 스킬 쓰고 웨어울프 예약해서 스킬 대기시간을 걸어준 다음 우유맛 쿠키는 자동으로 스킬 써지게 해주는데 중요한 거는 40초대에 마카롱 스킬 쓰고 목화로 예약을 걸어서 우유가 스킬 쓰기 전에 안 쓰고 대기하게 해줘야 하는데 그래야 우유랑 스킬을 같이 쓸 수 있기 때문이다.",
