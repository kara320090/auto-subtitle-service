    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "방제를 보고 들어오신 분들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.951
            },
            {
                "speaker_id": "1",
                "transcription": "아니 러너 님 갑자기 샤벳상어가 떡상이라니 이게 도대체 무슨 소리예요라고 들어오신 분들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.961,
                "end": 8.694
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트가 이제 얼마 남지 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.704,
                "end": 11.391
            },
            {
                "speaker_id": "1",
                "transcription": "8월 말에 샤벳상어 마법사탕이 나올 확률이 엄청나게 큽니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.401,
                "end": 15.830
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 인연의 홀에서 유일하게 에픽 쿠키가 2개가 있는데 그중에서 샤벳상어맛 쿠키가 마법사탕을 달고 나올 확률이 엄청나게 높습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.840,
                "end": 26.976
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕맛 쿠키는 신규 쿠키라 에픽에서 제외되고 현재 쿠키런 킹덤 로딩 화면에 보면 프릴해파리맛 쿠키 그리고 크림슨코랄 쿠키가 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.986,
                "end": 37.635
            },
            {
                "speaker_id": "1",
                "transcription": "현재 왼쪽에 크림슨코랄 쿠키는 슈퍼 에픽으로 추정되고 프릴해파리맛 쿠키는 에픽으로 추정되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.645,
                "end": 45.210
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다면 인연의 홀에는 2가지 쿠키가 추가될 것이고 마침 2자리가 딱 비어있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.220,
                "end": 51.936
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 프릴해파리와 크림슨코랄 쿠키가 추가되고 샤벳상어 마탕이 추가되지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.946,
                "end": 57.933
            },
            {
                "speaker_id": "1",
                "transcription": "저번 시즌에는 망고맛 쿠키가 인연의 홀에 있었는데 망고맛 쿠키도 인연의 홀에서 마법사탕을 받게 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.943,
                "end": 66.259
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 러너 님 샤벳상어가 지금은 부활한 게 아닌가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.269,
                "end": 71.395
            },
            {
                "speaker_id": "1",
                "transcription": "현재 샤벳상어는 실론덱을 잡는 용도로 실제로 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.405,
                "end": 77.042
            },
            {
                "speaker_id": "1",
                "transcription": "물론 샤벳상어 대신에 클로티드, 샤벳상어 그다음에 홀리베리 대신에 자색고구마 등 다양한 실론덱 잡는 조합이 사용되고 있어서 그렇게 유명하지는 않지만 제가 샤벳상어 연구를 해보니까 앞으로 마법사탕을 달고 나오면 블랙레모네이드와 엄청난 시너지를 보일 가능성이 높습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.052,
                "end": 98.022
            },
            {
                "speaker_id": "1",
                "transcription": "왜 갑자기 블랙레모네이드인가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.032,
                "end": 100.399
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 샤벳상어 조합을 보기 전에 현재 대유행 중인 샤이닝글리터, 블랙레모네이드 조합부터",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.409,
                "end": 107.900
            }
        ]
    },
    "summary": "한 남성이 다음 업데이트에서 샤벳상어 마법사탕이 나올 확률이 크고 그렇게 되면 블랙레모네이드와 좋은 조합이 될 것이라고 예상하고 있다.",
