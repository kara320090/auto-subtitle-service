        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 그래도 마지막 보상은 좀 많이 주네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.318
            },
            {
                "speaker_id": "1",
                "transcription": "고급 재료 여러분들 많이 쌓을 수 있는 기회네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.328,
                "end": 6.353
            },
            {
                "speaker_id": "1",
                "transcription": "최종 블랙코인 점수 12만 8000 최종 결과 확인하기 오 항해를 마쳤습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.363,
                "end": 13.431
            },
            {
                "speaker_id": "1",
                "transcription": "하 새로운 항해에 다시 시작됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.441,
                "end": 15.791
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그러면 결론은 고기 젤리 많으면은 무한으로 할 수 있는 거예요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.801,
                "end": 19.842
            },
            {
                "speaker_id": "1",
                "transcription": "심심하고 재미없다고 했더니만 거의 무한 노가다 콘텐츠를 내줬네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.852,
                "end": 25.549
            },
            {
                "speaker_id": "1",
                "transcription": "원하는 거는 신규 콘텐츠를 원했긴 했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.559,
                "end": 29.018
            },
            {
                "speaker_id": "1",
                "transcription": "야 그랬더니만 그냥 무한 그냥 노가다 콘텐츠를 그냥 대놓고 출시했구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.028,
                "end": 34.193
            },
            {
                "speaker_id": "1",
                "transcription": "왐마 아 근데 뭐 보상은 나쁘지 않은 것 같아요 제가 볼 때는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.203,
                "end": 37.655
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 블랙펄 제도 리뷰는 여기서 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.665,
                "end": 47.766
            }
        ]
    },
    "summary": "남자는 고급 재료를 많이 쌓을 수 있는 기회라며 신규 콘텐츠를 원했긴 했지만 고기 젤리 많으면 무한으로 할 수 있는 막노동 콘텐츠를 내줬다고 이야기한다.",
