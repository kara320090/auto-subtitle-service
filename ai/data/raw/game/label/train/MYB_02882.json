        "term": [
            {
                "speaker_id": "1",
                "transcription": "너도 설원을 그리고 있느냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.064
            },
            {
                "speaker_id": "2",
                "transcription": "아 서리 서리 굳이 안 키워도 된다고 했는데 나왔네. 오케이",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.074,
                "end": 6.558
            },
            {
                "speaker_id": "2",
                "transcription": "서리는 얘는 제가 이번에 티어 표 만들 때 1티어로 내릴 거거든요. 원래 0티어로 했다가 내리는 이유가 뭐냐면 굳이 서리덱이 전만큼 필수가 아니고 예언자덱 자체가 원래 서리여왕이 들어가는 예언자덱이 많았거든요? 근데 뭐 예언자덱이 이제 달빛 들어가고 해서 굳이 들어갈 이유가 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.568,
                "end": 26.164
            },
            {
                "speaker_id": "2",
                "transcription": "야 벨벳도 이번에 벨벳 한방덱 야 끔찍하게 또 한방덱에 들어갔더라 벨벳. 아 별의별 쿠키들이 다 쓰입니다 지금.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.174,
                "end": 34.212
            },
            {
                "speaker_id": "2",
                "transcription": "바요는 지금 안 쓰여요. 바요 키우지 마세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.222,
                "end": 38.648
            },
            {
                "speaker_id": "3",
                "transcription": "꿈이 흐르고 별빛이 춤을 춰요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.658,
                "end": 42.700
            }
        ]
    },
    "summary": "화자는 벨벳이 끔찍하게도 한방덱에 들어갔으며 바요는 쓰이지 않으니 키우지 말라고 말한다.",
