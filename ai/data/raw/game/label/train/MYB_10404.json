        "term": [
            {
                "speaker_id": "1",
                "transcription": "어우 방금 시드 죽는 줄 알고 괜히 식겁했네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.548
            },
            {
                "speaker_id": "1",
                "transcription": "디아블로 스토리 중에도 그 이름 뭐였지?",
