                    2,
                    3
                ],
                "start": 4.610,
                "end": 6.456
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 좀 티가 나네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.466,
                "end": 7.672
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 또 뭐 안 한 거 뭐 있나?",
