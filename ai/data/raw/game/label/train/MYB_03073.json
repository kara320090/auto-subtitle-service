                    2,
                    3,
                    5
                ],
                "start": 9.695,
                "end": 12.487
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 처음에 보셨죠? 처음에 있는 거랑 보면은 자 뉴 뜬 거 보여요?",
                "sound_type": [
