        "term": [
            {
                "speaker_id": "1",
                "transcription": "아무튼 그래서 여기서 9월 24일이라고 하셨나?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.320
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 근데 이거 한정 판매 상품으로 이걸 구매 아 아 데모가 한정 판매인가?",
                "sound_type": [
                    2
                ],
                "start": 5.330,
                "end": 19.861
            },
            {
                "speaker_id": "1",
                "transcription": "추천 잠깐 추천 유튜브에다가 내일 쉬는 날 올라갈 수 있게 내일 좀 해야 되겠네요.",
                "sound_type": [
                    2
                ],
                "start": 19.871,
                "end": 29.929
            },
            {
                "speaker_id": "1",
                "transcription": "아 너무 재밌다.",
                "sound_type": [
                    2
                ],
                "start": 29.939,
                "end": 31.355
            },
            {
                "speaker_id": "1",
                "transcription": "나 이런 게임 좋아하는구나.",
                "sound_type": [
                    2
                ],
                "start": 31.365,
                "end": 33.193
            },
            {
                "speaker_id": "1",
                "transcription": "몰랐네 나 이런 거 좋아하는지.",
                "sound_type": [
                    2
