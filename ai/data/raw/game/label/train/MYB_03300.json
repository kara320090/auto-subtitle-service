    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때 소다 제도가 네 이렇게 하면 안 된다를 제가 보여드리고 이렇게 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.685
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 되면은 절대 안 되는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.010,
                "end": 6.122
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 보면 시간당 스태미나 젤리 생산하는 게 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.382,
                "end": 9.810
            },
            {
                "speaker_id": "1",
                "transcription": "4시간당 5개예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.005,
                "end": 11.315
            },
            {
                "speaker_id": "1",
                "transcription": "제 기준으로는 몇 시간이지 6시간인가 아무튼 그 기준당 20개인가 생산해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.712,
                "end": 16.885
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 소다 제도 영토 확장하는 게 정말 중요하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.442,
                "end": 20.710
            },
            {
                "speaker_id": "1",
                "transcription": "한 번에 이거 하는 방법 그것도 생겼거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.877,
                "end": 23.160
            },
            {
                "speaker_id": "1",
                "transcription": "한 번에 해 주시고 이렇게 다 열어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.572,
                "end": 26.647
            },
            {
                "speaker_id": "1",
                "transcription": "또 하나 랜드마크입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.222,
                "end": 28.662
            },
            {
                "speaker_id": "1",
                "transcription": "랜드마크 중에 디저트 타워 같은 경우에는 회복 시간 감소해 주거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.950,
                "end": 32.262
            },
            {
                "speaker_id": "1",
                "transcription": "이 2개 필수로 지어주고 레벨 업 높게 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.479,
                "end": 36.477
            },
            {
                "speaker_id": "1",
                "transcription": "자 마법 공방 같은 경우에는 생산을 어떤 식으로 해야 되냐면은 이거는 과금 넣어도 똑같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.665,
                "end": 41.840
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 전용 재료 같은 경우에는 마법 공방에서 밖에 획득처가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.382,
                "end": 46.372
            },
            {
                "speaker_id": "1",
                "transcription": "우선순위를 굳이 해주세요라고 한다면은 저라면은 오징어 먹물을 먼저 1강을 먼저 찍고 그다음에 호밀 맛 쿠키 대천사 했으니까 얘도 10강 이상 찍고 그다음에 웨어울프도 10강 이상 찍고 우유맛 1강 이상 찍고 요렇게 먼저 할 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.775,
                "end": 62.927
            },
            {
                "speaker_id": "1",
                "transcription": "에스프레소 같은 경우에도 10강 이상 찍는 거 자기가 쓰고 싶다고 한다면은 10강 이상 찍고 더 키워주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.300,
                "end": 69.795
            },
            {
                "speaker_id": "1",
                "transcription": "아 스킨 뽑기는 언제 어떻게 하는 건가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.157,
                "end": 72.505
            },
            {
                "speaker_id": "1",
                "transcription": "13인가 14 오픈하면은 스킨 뽑기를 할 수 있고 2 다시 17 클리어하고 보물 상자를 열게 되면 보물 뽑기를 쓸 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.960,
                "end": 80.447
            },
            {
                "speaker_id": "1",
                "transcription": "자 소다 제도를 오픈하기 위해서는 요 땅 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.147,
                "end": 84.137
            },
            {
                "speaker_id": "1",
                "transcription": "여기를 오픈하면은 여기를 오픈할 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.512,
                "end": 86.970
            },
            {
                "speaker_id": "1",
                "transcription": "솜사탕 이 생산 건물 있는 자리를 오픈하게 되면 이 무역선 요게 열리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.362,
                "end": 91.970
            },
            {
                "speaker_id": "1",
                "transcription": "케이크 자리를 오픈하게 되면 영토 확장을 되면 이 갤러리가 오픈 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.457,
                "end": 97.055
            },
            {
                "speaker_id": "1",
                "transcription": "최단 루트로 쭉 이렇게 뚫으세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.482,
                "end": 99.337
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 최단 루트로 쭉 이렇게 뚫으세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.962,
                "end": 102.460
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 뚫어서 와서 요거 오픈하고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.930,
                "end": 105.958
            }
        ]
    },
    "summary": "소다 제도 영토 확장하는 게 정말 중요한데 한 번에 하는 방법이 생겼으니 다 열어주면 되고 랜드마크 중에 디저트 타워 같은 경우에는 회복 시간을 감소해 주기 때문에 필수로 지어주고 레벨 업 높게 해야 하며 쿠키 전용 재료 같은 경우에는 마법 공방이 유일한 획득처로 오징어 먹물 먼저 1강 찍고 그다음에 호밀 맛 쿠키 대천사 했으니까 10강 이상 찍고 그다음에 웨어울프도 10강 이상 찍고 우유맛 1강 이상 찍는 것이 좋고 에스프레소 같은 경우에도 쓰고 싶다고 한다면 10강 이상 찍고 더 키워주면 되며 스킨 뽑기는 13인가 14 오픈하면 할 수 있고 2 다시 17 클리어하고 보물 상자를 열게 되면 보물 뽑기를 쓸 수 있으며 솜사탕 생산 건물 있는 자리를 오픈하게 되면 무역선이 열리고 케이크 자리를 오픈하게 되면 영토 확장이 되면 갤러리가 오픈되는데 최단 루트로 쭉 뚫으면 된다.",
