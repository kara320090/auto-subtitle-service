        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그다음 분도 투탱 캡사이신덱 상대방 분이 웨어울프 홀리베리 덱도 마찬가지로 이길 수가 있는데 근데 여러분들 중요한 게 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.823
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신덱 중에 라즈베리 세팅으로 하는 그 조합이 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.833,
                "end": 15.110
            },
            {
                "speaker_id": "1",
                "transcription": "그 덱한테는 시작하자마자 이 스타더스트가 바로 죽고 시작하는 경우가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.120,
                "end": 21.365
            },
            {
                "speaker_id": "1",
                "transcription": "그런 경우에는 어 못 버티고 무기력하게 지는 경우도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.375,
                "end": 26.801
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱 자체는 제가 가장 좋으니까 여러분들 쓰세요라기 보다는 이 덱의 취지는 네 캡사이신이 없는 분들 현재 공덱 짜기 힘든 분들 블랙펄이랑 달빛수사는 키워 놨는데 네 캡사이신이 없는 분들 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.811,
                "end": 43.483
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들한테 하나의 공격 옵션으로 추천드리는 겁니다.",
                "sound_type": [
                    2,
