        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "세팅 가능한 분 한번 키워보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.210
            },
            {
                "speaker_id": "1",
                "transcription": "서리 여왕이 핵심입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.220,
                "end": 4.047
            },
            {
                "speaker_id": "1",
                "transcription": "곰사탕도 서리가 받아야 되고 자 이 아 이덱의 약점이 또 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.057,
                "end": 8.058
            },
            {
                "speaker_id": "1",
                "transcription": "이 와일드베리 덱한테 약해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.068,
                "end": 9.732
            },
            {
                "speaker_id": "1",
                "transcription": "물론 와베 덱이 거의 멸종 돼 가지고 쓰는 사람이 거의 없기는 합니다만 근데 와베를 하면은 저기 뒤에가 안 녹아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.742,
                "end": 18.311
            },
            {
                "speaker_id": "1",
                "transcription": "네 저 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.321,
                "end": 20.516
            },
            {
                "speaker_id": "1",
                "transcription": "저 버티는 이유가 저 와베 그 단단한 피해 감소 15퍼센트 상승 고거 때문에 버티고 내가 오히려 진다는 점",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.526,
                "end": 29.879
            },
            {
                "speaker_id": "1",
                "transcription": "어 저거 좀 가려서 해보면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.889,
                "end": 32.530
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 터진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.540,
                "end": 35.217
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 승률 100퍼센트 덱이 아닌 거를 파악하고 정석 덱이 많아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.227,
                "end": 39.743
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 덱 정석 덱 같은 것도 많거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.753,
                "end": 42.732
            },
            {
                "speaker_id": "1",
                "transcription": "딱 봤을 때 요런 덱들 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.742,
                "end": 44.952
            },
            {
                "speaker_id": "1",
                "transcription": "요런 덱 그냥 무시성으로 가는거야 한방 덱으로 샤벳, 샤벳이 있어도 만약에 투 탱커다?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.962,
                "end": 52.750
            }
        ]
    },
    "summary": "한 남성이 게임을 하면서 게임상의 서리 여왕이 핵심이며 서리 여왕이 곰사탕을 받아야 한다고 한다. 그리고 와일드베리 덱이 강하다고 하는데 뒤에 녹지 않는다고 한다. 그래서 오히려 본인이 진다고 한다. 무조건 승률 100퍼센트 덱이 아닌 거를 파악하고 정석 덱이 많다며 그런 덱은 무조건 가야 한다고 한다.",
