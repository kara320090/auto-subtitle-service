        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 요거 거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.414
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 저는 일단 티어가 낮아서 160만이 아닐 수도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.424,
                "end": 4.129
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.139,
                "end": 4.971
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 완전 최상위 스펙으로 기준으로 160만이 됐지만 티어가 낮은 분들은 좀 더 낮을 수 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.981,
                "end": 11.784
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 140만 일 수도 있고 130만 일 수도 있고 에스프레소가 보이거나 자신이 있는 티어 내에서 공격력이 되게 높게 되어 있는 2 2 1한테 들어 가시면은 승률이 되게 좋거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.794,
                "end": 22.740
            },
            {
                "speaker_id": "1",
                "transcription": "한 번 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.750,
                "end": 24.031
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 같은 경우에는 어떤식으로 되냐 자 이거는 옛날 아포덱 같은 경우에는 첫 턴에 일단 상대를 죽이지 못하면 승률이 낮았어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.041,
                "end": 32.724
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱같은 경우에는 첫 턴에 못 죽여도 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.734,
                "end": 35.823
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보면 상대 딜러가 둘 다 살아있죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.833,
                "end": 39.559
            },
            {
                "speaker_id": "1",
                "transcription": "상관없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.569,
                "end": 41.522
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 중요한 게 언제 죽이냐 이 두 번째 공격 타이밍 때 이 때 딜러 한 마리 나가 떨어지게 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.532,
                "end": 48.602
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 안 나가떨어졌네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.612,
                "end": 52.205
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 안 나가 떨어질 수도 있지만 네 그래도 이길 수 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.215,
                "end": 59.155
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래도 이길 수 있어 좀 약간 상황이 좀 다르게 흘러 갔는데 그래도 안정적이라고 말 한 이유가 이런식으로 흘러가서 이기는 그림이 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.165,
                "end": 72.735
            },
            {
                "speaker_id": "1",
                "transcription": "네 원래는 보통 이 턴 때 한 마리는 죽는데 클로티드가 딜러를 잡아 가지고 이렇게 됐었네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 72.745,
                "end": 81.650
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 딜을 보게 되면 흑당이 아몬드 임에도 불구하고 딜이 미쳐 날 뛰고 나머지도 아포도 딜이 좋게 나오게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.660,
                "end": 90.007
            },
            {
                "speaker_id": "1",
                "transcription": "2 1 2고 180만 이상인데 이거는 바요텍으로 갑니다 근데 이거 바요덱 쓸 때 사람들이.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 90.017,
                "end": 97.266
            }
        ]
    },
    "summary": "한 남자가 게임에서 티어가 낮은 사람이 들어가면 승률이 좋은 케이스를 보여 준다.",
