        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 무과금 소과금이 이렇게까지 되려면은 어떻게 해야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.061
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 무과금러 분들도 슈퍼 에픽 그다음에 레전드 쿠키 고대 쿠키 제외하고는 올 5초월 찍는 거 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.071,
                "end": 12.444
            },
            {
                "speaker_id": "1",
                "transcription": "이미 이렇게 5초월 많이 찍는 거 무과금으로 찍은 사람 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.454,
                "end": 16.080
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 열심히 하기만 한다면 쿠키 스펙은 에픽은 5초월로 만들 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.090,
                "end": 21.841
            },
            {
                "speaker_id": "1",
                "transcription": "네 칭호까지 이렇게 따는 건 무과금으로는 거의 힘들지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.851,
                "end": 25.618
            },
            {
                "speaker_id": "1",
                "transcription": "아 무과금 소과금 그마1이라는 사람 여태까지 본 적이 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.628,
                "end": 29.093
            },
            {
                "speaker_id": "1",
                "transcription": "어 소과금은 있을 수 있는데 무과금은 그마 1 했다는 사람 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.103,
                "end": 33.173
            },
            {
                "speaker_id": "1",
                "transcription": "소과금도 내가 볼 때는 거의 없을 거 같은데 모르겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.183,
                "end": 36.791
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 왕꾸 나도 좀 이렇게 이쁘게 해 보고 싶다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.801,
                "end": 39.383
            },
            {
                "speaker_id": "1",
                "transcription": "약간 볼 맛이 나죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.393,
                "end": 41.370
            },
            {
