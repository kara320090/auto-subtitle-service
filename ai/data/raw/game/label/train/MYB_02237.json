        "term": [
            {
                "speaker_id": "1",
                "transcription": "트리플콘컵 토핑은 저는 다음 주에 쓰시는 거를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.854
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 덱이 아직도 계속 나오는 중이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.864,
                "end": 8.817
            },
            {
                "speaker_id": "1",
                "transcription": "긍까 종결덱이 어떤 게 이제 정착되고 좋은 덱이 나오면은 그때 그거에 맞춰서 세팅하는 게 가장 좋고 지금은 하루에도 1번씩 계속 덱이 뭐 새롭게 나오고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.827,
                "end": 20.891
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 가서 아몬드 골랐는데 최종 좋은 덱은 뭐 라즈쓴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.901,
                "end": 25.432
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 후회되니까 일단 나중에 쓰는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.442,
                "end": 30.293
            },
            {
                "speaker_id": "1",
                "transcription": "음 너무 급하게 지금 할 필요는 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.303,
                "end": 35.900
            }
        ]
    },
    "summary": "트리플콘컵 토핑은 좋은 덱이 계속 나오기 때문에 다음 주에 쓰는 것을 추천드린다.",
