        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "잠시 후",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.641
            },
            {
                "speaker_id": "2",
                "transcription": "자 빠르게 다음 장으로 7장 벌써 7장으로 왔네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.651,
                "end": 3.646
            },
            {
                "speaker_id": "2",
                "transcription": "그래도 약간 움직이는 것 빼고 넓이가 큰 거는 나름 괜찮아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.656,
                "end": 7.940
            },
            {
                "speaker_id": "2",
                "transcription": "맞추기 좀 쉽죠 저런 거는?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.950,
                "end": 9.600
            },
            {
                "speaker_id": "2",
                "transcription": "네 맞춰서 클리어 자 8장 들어왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.610,
                "end": 12.521
            },
            {
                "speaker_id": "2",
                "transcription": "아직까지 제가 죽진 않았죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.531,
                "end": 14.319
            },
            {
                "speaker_id": "2",
                "transcription": "그만큼 얘를 많이 해봤기 때문에 노련하다 나름.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.329,
                "end": 18.282
            },
            {
                "speaker_id": "2",
                "transcription": "실력이 퍼펙을 할 정도로 완벽하진 않지만 그래도 죽지 않는 실력이다 아직은.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.292,
                "end": 23.901
            },
            {
                "speaker_id": "2",
                "transcription": "개인적으로는 저는 8장이 가장 어려워요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.911,
                "end": 26.533
            },
            {
                "speaker_id": "2",
                "transcription": "원래 장이 넘어가면은 더 어려워야 되는 건 맞는데 저는 되게 어렵더라고요 8장이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.543,
                "end": 31.265
            },
            {
                "speaker_id": "2",
                "transcription": "그래도 1번도 죽지 않고 8장까지 클리어 저 개인적으로 9장이 제일 쉬워요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.275,
                "end": 35.710
            },
            {
                "speaker_id": "2",
                "transcription": "8장보다는 퍼펙 나올 때 되게 기분이 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.720,
                "end": 39.076
            },
            {
                "speaker_id": "2",
                "transcription": "점수가 거의 2배 가까이 50퍼센트 더 주는 거 같아요 점수를.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.086,
                "end": 42.794
            },
            {
                "speaker_id": "2",
                "transcription": "여러분이 죽지만 않으면은 이 이벤트는 너무 혜자인 게 계속 코인하고 크리스털 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.804,
                "end": 48.909
            },
            {
                "speaker_id": "2",
                "transcription": "내가 죽지만 않는다면 죽으면은 크리스털 소모를 하거든요 부활을 할 때마다?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.919,
                "end": 53.433
            },
            {
                "speaker_id": "2",
                "transcription": "그게 없으니까 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.443,
                "end": 55.022
            },
            {
                "speaker_id": "2",
                "transcription": "자 일단 목표 1번도 죽지 않고 클리어하기 도전",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.032,
                "end": 60.000
            }
        ]
    },
    "summary": "남성이 개인적으로 9장이 제일 쉽고 8장이 가장 어렵게 느껴진다고 하며 퍼펙이 나오게 되면 점수를 거의 50퍼센트 더 주는 거 같고 죽지만 않으면 이 이벤트는 계속 코인과 크리스털을 줘서 좋다고 한다.",
