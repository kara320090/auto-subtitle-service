            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 음유시인 리뷰 이어서 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.986
            },
            {
                "speaker_id": "1",
                "transcription": "자 5성까지 찍었고 만렙까지 찍을게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.996,
                "end": 5.892
            },
            {
                "speaker_id": "1",
                "transcription": "자 70렙까지 자 일단은 마법의 노래 자 아름다운 선율로 환희의 노래를 연주해 아군의 체력을 회복시키고 치명타 확률과 치명타 피해량 오이스터 능력이랑 동일하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.902,
                "end": 17.636
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 아군의 체력을 더 회복시킨다는 점 회복형 쿠키기 때문에 자신을 포함한 아군이 둘 이하가 될 경우 파괴의 노래로 변경되며 쿨타임이 초기화 되고 쿨타임 시간이 변경된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.646,
                "end": 28.806
            },
            {
                "speaker_id": "1",
                "transcription": "최초입니다 쿠키런 킹덤에서 회복형 쿠키가 적한테 공격을 할 수 있는 최초의 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.816,
                "end": 34.351
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 파괴의 노래는 적에게 피해를 입히며 아군에게 치명타 버프를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.361,
                "end": 39.458
            },
            {
                "speaker_id": "1",
                "transcription": "동시에 자신을 제외한 아군 쿠키의 스킬 쿨타임을 감소시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.468,
                "end": 43.218
            },
            {
                "speaker_id": "1",
                "transcription": "일반 공격 시 아군 쿠키에게 체력 회복 효과를 분배하고 아군 쿠키가 적어 질 수록 회복량이 증가된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.228,
                "end": 50.584
            },
            {
                "speaker_id": "1",
                "transcription": "체력회복은 공격력의 151.5퍼센트, 치명타 확률과 치명타 피해 증가는 각각 15퍼센트 12퍼센트 중첩은 한 번밖에 안 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.594,
                "end": 58.966
            },
            {
                "speaker_id": "1",
                "transcription": "파괴의 노래의 피해량은 331.4퍼센트 아군 쿨타임 감소는 2.5초가 감소된다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.976,
                "end": 66.724
            },
            {
                "speaker_id": "1",
                "transcription": "야 근데 2.5초 감소라고 스킬 쿨타임 가장 적은 애가 누구죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.734,
                "end": 70.639
            },
            {
                "speaker_id": "1",
                "transcription": "와 그런 애들은 진짜 스킬 엄청 빨리 쓰겠네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.649,
                "end": 75.416
            }
        ]
    },
