        "term": [
            {
                "speaker_id": "1",
                "transcription": "죽었죠 근데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.688
            },
            {
                "speaker_id": "1",
                "transcription": "이유가 있었을 텐데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.698,
                "end": 1.854
            },
            {
                "speaker_id": "1",
                "transcription": "베네딕타가 그렇게 하고 다닌 이유가 있었을 거 아니에요? 궁금하네요 그게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.864,
                "end": 5.290
            },
            {
                "speaker_id": "1",
                "transcription": "요쪽으로 이렇게 시선을 보다 보니?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.300,
                "end": 9.305
            },
            {
                "speaker_id": "1",
                "transcription": "그쵸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.315,
                "end": 10.947
            },
            {
                "speaker_id": "1",
                "transcription": "아 박쥐처럼 이리 붙고 저리 붙고. 살려고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.957,
                "end": 14.819
            },
            {
                "speaker_id": "1",
                "transcription": "하 아 그것도 후반에 나와주면 좋겠는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.829,
                "end": 17.664
            },
            {
                "speaker_id": "1",
                "transcription": "현현이 있고 반현현이 있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.674,
                "end": 21.107
            },
            {
                "speaker_id": "1",
                "transcription": "도미넌트가 인간의 형상을 유지한 채 소환수의 힘의 일부를 몸에 깃들게 하는 것.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.117,
                "end": 25.302
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 뭔지 알아. 음.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.312,
                "end": 27.866
            }
        ]
    },
    "summary": "베네딕타의 행동이 궁금해 구독자들과 살기 위해 박쥐처럼 이리 붙고 저리 붙었다는 등 여러 이유를 추측해 보고 반현현이 도미넌트가 인간의 형상을 유지하면서 소환수의 힘을 몸에 깃들게 한다는 게임 속 설명을 그대로 읽는다.",
