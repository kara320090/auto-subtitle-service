        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 0.773
            },
            {
                "speaker_id": "1",
                "transcription": "이거 되게 인기가 없어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.783,
                "end": 2.516
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 되게 아기자기하고 이쁘게 하면은 되게 인기가 많거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.526,
                "end": 6.363
            },
            {
                "speaker_id": "1",
                "transcription": "이것 봐 너무 이쁘잖아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.373,
                "end": 8.998
            },
            {
                "speaker_id": "1",
                "transcription": "너무 차이가 많이 나잖아요. 그쵸?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.008,
                "end": 10.826
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤에 달빛 스킨 안 나오나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.836,
                "end": 12.922
            },
            {
                "speaker_id": "1",
                "transcription": "내가 나 진짜 킹덤에 이 스킨 나오면은 내가 진짜 무큐 다 쓰더라도 진짜 뽑고 만다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.932,
                "end": 18.947
            },
            {
                "speaker_id": "1",
                "transcription": "제발 이거 나왔으면 좋겠어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.957,
                "end": 20.634
            },
            {
                "speaker_id": "1",
                "transcription": "내가 제일 좋아하는 달빛 스킨 중의 하나야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.644,
                "end": 23.371
            },
            {
                "speaker_id": "1",
                "transcription": "스킨도 되게 이제 게임하는데 되게 영향을 주는 요소긴 하거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.381,
                "end": 28.131
            },
            {
                "speaker_id": "1",
                "transcription": "스킨이 이뻐서 그거만 쓴다. 뭐 그런",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.141,
                "end": 32.260
            },
            {
                "speaker_id": "1",
                "transcription": "오 클러티드 저는 스킨이 진짜 많이 나왔으면 좋겠어요. 개인적으로는",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.270,
                "end": 36.504
            },
            {
                "speaker_id": "1",
                "transcription": "매번 업데이트할 때마다는 아니더라도 저번에는 한 6개월, 5개월 동안 스킨이 안 나왔거든요? 그건 너무 텀이 길다고 생각해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.514,
                "end": 44.166
            },
            {
                "speaker_id": "1",
                "transcription": "못해도 한 2달 정도는 그 안에 나오는 게 좋지 않나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.176,
                "end": 48.875
            }
        ]
    },
    "summary": "남성이 인기가 많은 것과 적은 것의 차이가 심하다고 하고 자기가 좋아하는 스킨이 나오면 무슨 수를 쓰더라도 뽑겠다고 하고 개인적으로 스킨이 많이 나와서 적어도 2달에 1번 정도는 나왔으면 좋겠다고 합니다.",
