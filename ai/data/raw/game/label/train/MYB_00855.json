        "term": [
            {
                "speaker_id": "1",
                "transcription": "오로라 재료 수급을 많이 하다보면 나중에서는 랜드마크 레벨과 쿠키 하우스 레벨업할 수 있는 재료도 충분히 모을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.451
            },
            {
                "speaker_id": "1",
                "transcription": "단 초보자분들은 코인이 부족하다고 크리스탈을 상점에서 절대 사지 말고요 코인을 무리하게 랜드마크 레벨업이나 토핑 강화에 투자하는 거는 추천드리지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.461,
                "end": 21.882
            },
            {
                "speaker_id": "1",
                "transcription": "항상 코인은 내 쿠키성 12레벨까지 빠르게 올릴 수 있을 만큼의 여유는 보유하고 있어야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.892,
                "end": 29.806
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 어떤 쿠키를 키워야 될지 업데이트 리뷰를 통해서 쿠키 티어가 정해질 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.816,
                "end": 36.617
            },
            {
                "speaker_id": "1",
                "transcription": "가장 최신 티어 영상을 보고 선택적으로 키우시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.627,
                "end": 41.420
            },
            {
                "speaker_id": "1",
                "transcription": "자 복귀 유저분들이나 초보자분들이 제 유튜브 채널에서 참고하면 좋을 영상을 추천해 드리면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.430,
                "end": 46.767
            },
            {
                "speaker_id": "1",
                "transcription": "자 마법사탕 우선순위 이 영상 재화를 빨리 모으는 방법 네 복귀 유저분들 신규 유저분들 브릭시티 이벤트가 있어서 브릭시티 연동 계정 문제가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.765,
                "end": 58.940
            },
            {
                "speaker_id": "1",
                "transcription": "카페가서 공지를 확인해 보시거나 예 이 영상 참고해서 자칫하다가 계정이 탈퇴되는 문제가 생기지 않도록 이거 영상 참고해 보시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.940,
                "end": 70.070
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 가장 중요한 거 절대 하지 마세요 킹덤 팁 정리 가장 중요하니까 반드시 확인해 보시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.070,
                "end": 78.123
            },
            {
                "speaker_id": "1",
                "transcription": "자 이외에 스토리 티어 이런 아레나 티어 영상들은 제가 최대한 빨리 최신화해서 제작해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.133,
                "end": 86.280
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 찬란한 영웅들의 신전에서도 별사탕 부족하다고 어 이거 전부 다 열지 마시고요 5개까지만 저는 추천드리고 여기에 등록된 5개의 쿠키의 레벨이 골고루 높아야지만 여기에 등록돼 있는 쿠키의 5개의 레벨 중에 가장 낮은 쿠키의 레벨이 기준 쿠키가 되고 그 기준 쿠키의 레벨이 등록돼 있는 쿠키의 레벨을 결정하기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.280,
                "end": 109.350
            },
            {
                "speaker_id": "1",
                "transcription": "별사탕을 하나만 높게 찍지 마시고 골고루 5개 분산시켜서 키워주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 109.360,
                "end": 116.541
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 제가 드리고 싶은 말씀은 쿠키런 킹덤 쿠키 키울 거 엄청나게 많아요 하지만 전부 다 키울 필요 없습니다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 116.551,
                "end": 124.846
            },
            {
                "speaker_id": "1",
                "transcription": "정말 필요한 쿠키만 먼저 투자해서 키우면 어느 정도 컨텐츠 진행하는 데 무리 없이 진행 가능하고 그리고 컨텐츠마다 무지개 큐브, 크리스탈 매주 정산해서 나오는 컨텐츠들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 124.856,
                "end": 138.087
            },
            {
                "speaker_id": "1",
                "transcription": "네 참여해서 매주 매주 받으면 무과금이라도 한 달에 예 8만개에서 10만개가량 제화를 모을 수 있기 때문에 반드시 길드가입 수호성 전 그리고 아레나 그리고 이번에 나오는 대난투 컨텐츠까지 하시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 138.097,
                "end": 153.747
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 업데이트 리뷰 하는데 라이브 방송을 통해서 신규 쿠키와 다른 쿠키들의 티어도 한번 제가 정리해 보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 153.757,
                "end": 163.150
            },
            {
                "speaker_id": "1",
                "transcription": "구독과 좋아요 한 번씩만 부탁드립니다 앞으로 관련된 팁 정보 영상 네 꾸준히 올려 보도록 할게요 감사합니다.",
