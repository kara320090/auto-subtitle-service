        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 저는 이분 계평을 하면서 느끼는 점은 진짜 코인이 너무 부족해서 좀 답답할 것 같아 제가 봐도.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.625
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 코인이라는 거는 몇 백만 코인 있어도 토핑 강화 12강까지 막 다 무지성으로 하다 보면은 금방 소진되는 게 코인이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.635,
                "end": 15.102
            },
            {
                "speaker_id": "1",
                "transcription": "얘만 조절 잘하면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.112,
                "end": 16.522
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키는 아까 키우는 것 좀 봐달라고 하셨는데 어 선택적으로 다 잘 키우고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.532,
                "end": 21.763
            },
            {
                "speaker_id": "1",
                "transcription": "따로 언급 안 해도 지금 키우는 애들 집중적으로만 다 하면은 알아서 잘하고 계시기 때문에 왕국 운영도 뭐 시간 투자해서 하시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.773,
                "end": 31.049
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 @계정1 님 계평을 마치고 이거 분명히 하다 보면은 궁금한 게 생길 수밖에 없을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.059,
                "end": 38.273
            },
            {
                "speaker_id": "1",
                "transcription": "모르는 거 있으면은 개인 톡으로 물어보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.283,
                "end": 41.700
            },
            {
                "speaker_id": "1",
                "transcription": "자 계평은 여기서 끝.",
                "sound_type": [
