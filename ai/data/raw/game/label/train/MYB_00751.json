    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 아레나 조합 추천 영상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.600
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 상성 관계 파악도 알려드리고 어떨 때 어떤 조합으로 들어가야 되는지 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.615,
                "end": 9.854
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 제일 유행하고 있는 이 코랄 3딜덱 조합 같은 경우에는 여러분들이 무난하게 공덱으로 쓰기 가장 좋고 바다 요정 대신에 달빛 술사를 넣어서 써도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.864,
                "end": 21.520
            },
            {
                "speaker_id": "1",
                "transcription": "자 간단하게 세팅을 보게 되면 자 코랄은 세트 효과 포함해서 21.3퍼센트 이상, 스타더스트는 10.3퍼센트 이상, 바다 요정은 네 쿨타임을 저처럼 높게 해도 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.530,
                "end": 32.260
            },
            {
                "speaker_id": "1",
                "transcription": "23퍼센트 정도 맞춰줘도 괜찮습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.270,
                "end": 35.142
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄 같은 경우에는 아몬드로 주지 않으면 죽는 경우도 있어서 저는 아몬드로 했지만 올쿨로 써도 가능은 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.152,
                "end": 44.535
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 똑같은 3딜덱한테 들어갈 때는 블랙펄이 죽을 수 있기 때문에 가급적이면은 저는 올 아몬드 추천드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.560,
                "end": 51.787
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅 드래곤은 올쿨 쿨 높게 자 2,3딜덱은 무난하게 공덱으로 사용하기 좋고 저처럼 방덱으로도 사용하기 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.797,
                "end": 61.073
            },
            {
                "speaker_id": "1",
                "transcription": "자 3번 박하 사탕 조합은 1번 극딜덱을 저격하는 조합이고 코랄은 세트 효과와 더해서 21.3퍼센트 이상 세팅해 주시고 스타 더스트는 10.3퍼센트 이상 3초 스타더스트 자 블랙펄은 세트 효과 제외하고 쿨타임 23퍼센트 정도 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.083,
                "end": 79.296
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄은 반드시 뭐 쿨 23퍼센트 무조건 맞춰야 되는 건 아니고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.306,
                "end": 83.812
            },
            {
                "speaker_id": "1",
                "transcription": "22퍼센트 이상만 맞춰도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.822,
                "end": 86.975
            },
            {
                "speaker_id": "1",
                "transcription": "자 박하 사탕은 피해 감소 높게 쿨 높게 자 박하 사탕을 못쓴다 하시면 파르페를 넣어서 파르페 피감 높게 쿨 높게 세팅하셔도 대체로 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.985,
                "end": 97.692
            },
            {
                "speaker_id": "1",
                "transcription": "자 3번 조합은 5번 조합으로 잡을 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.700,
                "end": 101.417
            },
            {
                "speaker_id": "1",
                "transcription": "과전류 조합도 제 유튜브에 올라와 있지만 간단하게 세팅 알아보면 네 코랄은 동일하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.427,
                "end": 106.653
            },
            {
                "speaker_id": "1",
                "transcription": "네 블랙 레모네이드는 올 라즈베리에서 피감 높게 뭐 쿨 공속 여유 있으면 높게 해주시면 되고 샤글도 3라즈, 2애플젤리 피감 높게 여러분들 여유 있으면 쿨 공속 높게 자 파르페도 여러분들 피감 높게 여유 있으면 쿨 최대한 높게 스냅은 쿨 높게 자 이 조합 같은 경우에는 이 5번 용과 홀리베리 조합을 저격으로 들어가시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 106.663,
                "end": 130.654
            },
            {
                "speaker_id": "1",
                "transcription": "자 근데 이 영상 보시는 분들 중에 가장 원하는 답변이 현재 지금 박하 사탕 방덱이 되게 많아지고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 130.664,
                "end": 137.924
            },
            {
                "speaker_id": "1",
                "transcription": "또는 박하 사탕 대신에 파르페 조합이 방덱으로 많아지고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 137.934,
                "end": 142.331
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 박하 사탕 방덱이랑 이 3딜덱 방덱을 구분하는 방법은 블랙펄 자리, 바다 요정 자리가 이렇게 가려지면 여러분들이 구분할 수 있는 방법이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 142.341,
                "end": 152.827
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 여러분들이 전투력을 보게 되면 40만에서 50만 정도 떨어지게 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 152.837,
                "end": 158.212
            },
            {
                "speaker_id": "1",
                "transcription": "가려진 쿠키가 있더라도 전투력을 보고 3딜덱이 아니라 박하 사탕이 들어있다는 걸 알 수가 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 158.220,
                "end": 164.324
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 눈치채셨으면 여러분들이 지금 소개해 드릴 5번 덱으로 들어가면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 164.334,
                "end": 169.284
            },
            {
                "speaker_id": "1",
                "transcription": "박하 사탕 방덱을 공략할 수 있는 카운터 잭은 홀리베리는 쿨타임 22퍼센트 이상 피감은 여러분들 능력껏 높게 용과는 쿨타임 6퍼센트 정도 너무 쿨 높게 하면은 또 안 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 169.294,
                "end": 181.250
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 1분 전에 브레스가 너무 일찍 나가면 손해 볼 수 있고 상대 딜러가 안 죽을 수 있기 때문에 어 저는 6퍼센트 정도에 맞춰주는 걸 추천드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 181.260,
                "end": 191.328
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타는 피감을 높게 씁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 191.338,
                "end": 194.009
            },
            {
                "speaker_id": "1",
                "transcription": "1분 지나서도 최대한 버틸 수 있게끔 가급적이면 높게 얘는 일부러 죽어주는 역할보다도 최대한 생존을 높게 해주는 역할로 한 25퍼센트 최대한 높게 해줬습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 194.019,
                "end": 207.212
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 확률은 여러분들 5퍼센트 이상 반드시 시켜줘야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 207.222,
                "end": 211.323
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임도 최솟값을 말하라고 한다면 세트 효과 포함해서 22.3퍼센트 이상 자 블랙펄 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 211.333,
                "end": 218.931
            },
            {
                "speaker_id": "1",
                "transcription": "세트 효과 포함해서 21퍼센트를 맞춰주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 218.941,
                "end": 222.508
            },
            {
                "speaker_id": "1",
                "transcription": "각각 21퍼센트 근처를 맞춰주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 222.518,
                "end": 225.472
            },
            {
                "speaker_id": "1",
                "transcription": "정확히 21퍼센트가 아니라도 상관없지만 가급적이면 근처로 맞춰주시는 게 상대 딜러들이 1분 타임에 맞춰서 공격 들어올 때 블랙펄이 피할 수 있는 절묘한 타이밍이 나오게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 225.515,
                "end": 236.495
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅은 올쿨로 이렇게 세팅을 하게 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 236.507,
                "end": 239.787
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 1번, 3번, 4번은 제 유튜브에 이미 올라와져있는 덱이라 많이 다루지 않고 5번을 집중적으로 다룰 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 239.797,
                "end": 248.757
            },
            {
                "speaker_id": "1",
                "transcription": "박하 사탕 방덱 공략으로 보여드릴 거고 추가적으로 1번을 3딜덱을 공략하는 또 하나의 방법은 네 이미 영상에서도 말씀드렸지만 홀리베리, 용과는 동일하고 락스타 피감만 한 20퍼센트 대 그리고 블랙펄 올 아몬드로만 세팅해서 가시면 1번 3딜덱 공략도 용과 드래곤 덱으로도 가능하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 248.780,
                "end": 271.733
            }
        ]
    },
    "summary": "이번에는 아레나 조합 추천 영상으로 아레나 관계 상성 및 어떨 때 어떤 조합으로 들어가야 하는지 알려줄 예정이고 특히 제 유튜브에 소개되지 않은 5번 덱 위주로 보여드릴 예정이다.",
