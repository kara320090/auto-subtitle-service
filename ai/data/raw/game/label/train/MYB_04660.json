        "term": [
            {
                "speaker_id": "1",
                "transcription": "잠시 후.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.811
            },
            {
                "speaker_id": "2",
                "transcription": "이거 근데 그냥 제가 볼 때는 아포까지는 좀 키우시면 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.821,
                "end": 5.221
            },
            {
                "speaker_id": "2",
                "transcription": "얘는 키워서 손해 없거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.231,
                "end": 7.191
            },
            {
                "speaker_id": "2",
                "transcription": "좀만 신경 써도 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.201,
                "end": 8.428
            },
            {
                "speaker_id": "2",
                "transcription": "뭐 60레벨 70렙까지 아니더라도 좀 어느 정도만 이거 내가 볼 때는 계정 주인 분.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.438,
                "end": 13.463
            },
            {
                "speaker_id": "2",
                "transcription": "이거는 추방 당한 이유가 토벌을 안 해서 추방 당하는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.473,
                "end": 18.236
            },
            {
                "speaker_id": "2",
                "transcription": "이게 세팅 자체가 아예 안 되어 있다 보니까 그래서 추방 당하는 거거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.246,
                "end": 22.299
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 제가 지금 세팅해 준 요거 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.309,
                "end": 24.141
            },
            {
                "speaker_id": "2",
                "transcription": "제 유튜브 보면은 이거 다 조합이나 이거 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.151,
                "end": 27.082
            },
            {
                "speaker_id": "2",
                "transcription": "요거 모양새만 맞춰서 대충 참사만 안 나게 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.092,
                "end": 31.209
            },
            {
                "speaker_id": "2",
                "transcription": "요랑은 가는지 1번 대충 보려고 하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.219,
