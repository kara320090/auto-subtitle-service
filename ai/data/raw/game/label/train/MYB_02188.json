            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "상대방이 공격력이 높으면은 녹을 수가 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.795
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 가급적이면 전투력 높은 덱한테는 이 덱은 쓰지 않는 게 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.795,
                "end": 8.820
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 전투력 높은 덱은 뭘로 들어가냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.820,
                "end": 11.457
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때는 빙결덱으로 들어가시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.460,
                "end": 14.517
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이렇게 2가지로 나누거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.517,
                "end": 16.190
            },
            {
                "speaker_id": "1",
                "transcription": "상대방이 전투력이 높을 때는 빙결덱으로 전투력이 애매하게 좀 낮다 싶을 때는 이 덱으로 이렇게 들어 가시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.190,
                "end": 23.987
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 또 이제 질문 하나가 마들렌 마탕 언제부터 쓰냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.987,
                "end": 27.372
            },
            {
                "speaker_id": "1",
                "transcription": "최소 10강 이상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.372,
                "end": 28.595
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 또 블랙펄 자리에 라떼맛 쿠키 쓰거나 뱀파이어 쓰는 분도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.595,
                "end": 33.295
            },
            {
                "speaker_id": "1",
                "transcription": "그런 경우에도 전부 다 마탕은 최소 10강 이상이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.295,
                "end": 36.877
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림도 마찬가지 마탕은 10강 이상부터 능력이 더 붙기 때문에 그 능력 하나가 정말 크리티컬하게 중요하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.877,
                "end": 44.785
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 마탕 만약에 쓰실거면 10강 이상으로 세팅해서 들어가라 그렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.787,
                "end": 50.915
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이거 같은 경우에는 한방덱도 지금 뭐 쓰신 분들 많긴 하지만 근데 지금 아마 한방덱들은 웬만해선 잘 안 통할 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.917,
                "end": 60.802
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 현재 랭커분들을 보면은 전투력이 210만 220만 다 낮은 이유가 다 이렇게 피감으로 범벅으로 되어있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.802,
                "end": 69.655
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 한방덱은 안 통한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.655,
                "end": 72.130
            },
            {
                "speaker_id": "1",
                "transcription": "전투력이 높은 분한테는 쓰일만한 가치가 있지만 안 통하는 경우가 대다수일 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.130,
                "end": 79.166
            }
        ]
    },
    "summary": "전투력이 높을 때는 빙결덱으로 애매하게 좀 낮을 때는 이 덱으로 들어가면 된다고 얘기하고 있고 마탕은 최소 10강 이상으로 세팅하고 들어가고 한방덱은 웬만해선 안 통한다고 설명하고 있습니다.",
