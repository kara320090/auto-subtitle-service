        "term": [
            {
                "speaker_id": "1",
                "transcription": "버튼이 한 번 눌러서 끝나는 건 줄 알았어.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.302
            },
            {
                "speaker_id": "1",
                "transcription": "물 한 번 마시고 가야 돼. 공기 한 번 마시고.",
                "sound_type": [
                    2
                ],
                "start": 2.312,
                "end": 5.983
            },
            {
                "speaker_id": "1",
                "transcription": "아침에 겁이 나는.",
                "sound_type": [
                    2
                ],
                "start": 5.993,
                "end": 15.645
            },
            {
                "speaker_id": "1",
                "transcription": "공기 마셔 주고. 끝이 없는 바닷가.",
                "sound_type": [
                    2
                ],
                "start": 15.655,
                "end": 21.896
            },
            {
                "speaker_id": "1",
                "transcription": "으아 깜짝이야 놀래라. 으아아 놀래라 미친.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.906,
                "end": 28.365
            },
            {
                "speaker_id": "1",
                "transcription": "여기 연출 미쳤다 방금 봤어요? 연출 개지린다. 그치?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.375,
                "end": 34.098
            },
            {
                "speaker_id": "1",
                "transcription": "와 이거 방금 그거 타고 올라갔는데 뭐야 안 죽는 거 보니까 살아날 수 있는 건가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.108,
                "end": 40.200
            }
        ]
    },
    "summary": "게임 속에서 탈출을 하고 있다가 다시 바닷속으로 떨어졌다.",
