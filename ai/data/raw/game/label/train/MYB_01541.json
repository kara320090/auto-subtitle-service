        "term": [
            {
                "speaker_id": "1",
                "transcription": "압도적으로 이기죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.403
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 아슬아슬하게 이기는 정도가 아니라 그냥 퍼펙으로 이깁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.413,
                "end": 7.139
            },
            {
                "speaker_id": "1",
                "transcription": "상대방 분의 스펙도 여러분들 보시는 거와 같이 네 완전 풀스펙입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.149,
                "end": 13.438
            },
            {
                "speaker_id": "1",
                "transcription": "근데 2, 1, 2 덱은 여러분들 이제 만난면은 이제 뭐 승률 거의 100퍼센트에 가까운 승률로 이길 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.448,
                "end": 19.836
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음이 이제 보여드릴 게 이제 그러면 이 2, 2, 1 덱일 때는 어떻게 돼냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.846,
                "end": 25.310
            },
            {
                "speaker_id": "1",
                "transcription": "아까 말씀드렸지만 3탱덱 일 때는 좀 약합니다 상성상 네 한번 그림을 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.320,
                "end": 30.691
            },
            {
                "speaker_id": "1",
                "transcription": "네 딱 3탱덱 만났네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.701,
                "end": 32.455
            },
            {
                "speaker_id": "1",
                "transcription": "이 3탱덱한테는 안 들어가는 게 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.465,
                "end": 35.484
            },
            {
                "speaker_id": "1",
                "transcription": "웬만해서는 상대방이 앞의 탱커가 캡사이신이 보인다 그러면 들어가지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.494,
                "end": 41.018
            },
            {
                "speaker_id": "1",
                "transcription": "제가 경우의 수를 좀 보여드리도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.028,
                "end": 43.974
            },
            {
                "speaker_id": "1",
                "transcription": "네 일단 소르베가 웬만해서는 1분 전에 버텨야 되는데 이렇게 부활이 1분 전에 빠지게 되면은 지는 그림으로 가게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.984,
                "end": 53.391
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 웬만해서는 3탱덱은 아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.401,
                "end": 58.166
            }
        ]
    },
    "summary": "2, 1, 2 덱은 만난면 거의 100퍼센트에 가까운 승률로 이길 수 고 3탱덱한테는 안 들어가는 게 좋다.",
