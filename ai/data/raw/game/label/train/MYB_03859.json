                ],
                "start": 2.304,
                "end": 9.713
            },
            {
                "speaker_id": "1",
                "transcription": "심해의 공포 해제 시 추가 피해 있잖아요 요거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.723,
                "end": 12.495
            },
            {
                "speaker_id": "1",
                "transcription": "이거 디버프가 없어지면서 폭발하는 거야.",
