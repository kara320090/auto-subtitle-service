        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 왜 안 올렸지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.150
            },
            {
                "speaker_id": "1",
                "transcription": "이거 레벨 업 한 지 알마 안 되셨구나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.150,
                "end": 3.247
            },
            {
                "speaker_id": "1",
                "transcription": "이거 다 건설해 주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.247,
                "end": 5.495
            },
            {
                "speaker_id": "1",
                "transcription": "이야 아 차라리 이거 보다 얘가 더 중요한데 귀찮아도 이거 얘 먼저 건설해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.495,
                "end": 11.722
            },
            {
                "speaker_id": "1",
                "transcription": "크탈 모이면?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.722,
                "end": 12.597
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 랜드마크 다 건설해야 되는 이유가 쿠키 랜드마크 레벨이 올라가면은 다 이거 번영도 점수에 올라가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.600,
                "end": 19.472
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지는 찍어야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.472,
                "end": 21.200
            },
            {
                "speaker_id": "1",
                "transcription": "암만 못해도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.200,
                "end": 22.333
