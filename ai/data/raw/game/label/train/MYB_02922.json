                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 이제 아레나에서 여러분들 보여드릴 텐데 중요한 포인트가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.432
            },
            {
                "speaker_id": "1",
                "transcription": "자 분명히 이 영상을 보시는 분들 입장에서는 5초월이 와 대박이다 세다 이런 느낌으로 어 리뷰를 보는 게 아니라 제가 말씀드리고 싶은 거는 달빛술사가 암만 초월이 높아도 내 세팅을 잘못하면은 정말 엄청난 손해를 보면서 쓸 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.442,
                "end": 22.492
            },
            {
                "speaker_id": "1",
                "transcription": "무슨 말이냐 자 어떤 걸 써도 상관없어요. 올 쿨이나 올 라즈나 어 여러분들은 뭐 덱에 맞게끔 지금 사용하고 있기 때문에 이게 잘못됐다고 하는 게 아니라 중요한 점은 여러분들 이 쿨 세팅 하나 때문에 승률 자체가 승부 자체가 완전히 바뀔 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.502,
                "end": 39.521
            },
            {
                "speaker_id": "1",
                "transcription": "다른 스텟도 물론 피해 감소 중요하고 쿨도 중요하고 뭐 공치도 중요하지만 이 쿨이 어떤 걸 정해주냐 1분 타이밍 때 100퍼센트 공증을 받고 공격을 하냐 아니면 그전에 공격을 하냐에 따라서 상대방 쿠키가 죽냐 사냐가 결정되기 때문에 자 일단 쿨도 분명히 여러분들 상황에 맞게 다 다를 수 있는데 지금 저는 22퍼센트인데 보통 20퍼센트대로 하는 덱도 있고 22퍼센트대로 하는 덱도 있고 23대 하는 덱도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.531,
                "end": 71.033
            },
            {
                "speaker_id": "1",
                "transcription": "각각 다 달라요. 어 라즈베리도 8퍼센트대 하는 덱이 있는데 그 기준을 제가 좀 실전에서 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.043,
                "end": 79.152
            },
            {
                "speaker_id": "1",
                "transcription": "한 번만 확인하면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.162,
                "end": 80.956
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나에서 지금 1분 이렇게 시간이 흘러가는데 자 여기서 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.966,
                "end": 87.351
            },
            {
                "speaker_id": "1",
                "transcription": "1분 지났을 때 모든 피해량이 100퍼센트 증가됩니다. 이거 때문에 어 상대 쿠키가 한 번에 싹 녹을 수도 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.361,
                "end": 95.467
            },
            {
                "speaker_id": "1",
                "transcription": "근데 쿨이 너무 높아버리면은 100퍼센트 피해 증가량을 못 받고 딜이 들어가면 엄청난 손해를 보고 너무 늦게 들어가 버리면 상대방이 딜이 다 들어오고 나서 내 쿠키가 다 죽고 죽어버려서 공격을 못하는 경우들이 생깁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.477,
                "end": 110.833
            }
        ]
    },
