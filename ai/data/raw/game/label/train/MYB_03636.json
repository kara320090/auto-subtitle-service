        "term": [
            {
                "speaker_id": "1",
                "transcription": "BTS가 있으니까 BTS로 해주시고 50레벨 휘낭시에 있으시네 이거 이렇게 세팅해서 요거 키우시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.144
            },
            {
                "speaker_id": "1",
                "transcription": "계정 주인분 요거 하시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.154,
                "end": 8.904
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어는 별사탕 투자하지 마시고 이제 키우지 마세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.914,
                "end": 12.509
            },
            {
                "speaker_id": "1",
                "transcription": "요것도 약간 귀찮으실 거예요. 이거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.519,
                "end": 15.181
            },
            {
                "speaker_id": "1",
                "transcription": "뭔 느낌인지 저도 충분히 알거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.191,
                "end": 17.279
            },
            {
                "speaker_id": "1",
                "transcription": "요거 깰 때도 안 깨졌죠? 이거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.289,
                "end": 19.080
            },
            {
                "speaker_id": "1",
                "transcription": "쟤 물총 쏘는 얘들이 힐러 없으면은 다 녹아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.090,
                "end": 22.242
            },
            {
                "speaker_id": "1",
                "transcription": "이거 안 깨려고 한 게 아니라 못 깬 거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.252,
                "end": 24.867
            },
            {
                "speaker_id": "1",
                "transcription": "보물은 앞으로 할 때 무조건 무공비가 제일 좋거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.877,
                "end": 28.416
            },
            {
                "speaker_id": "1",
                "transcription": "무공비하시고 낫 해도 괜찮고 부활 보물 껴도 괜찮고 시계 보물이 커먼인데 커먼이어도 요걸로 가시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.426,
                "end": 36.894
            },
            {
                "speaker_id": "1",
                "transcription": "잠만 이렇게 되어 있으면 설마 케이크 타워도 아 자 이것도 마찬가지 차라리 와베 혼자 넣고 이렇게 딜러를 해도 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.904,
                "end": 45.711
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 한번 가보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.721,
                "end": 47.295
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 뽑기 갑시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.305,
                "end": 48.837
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 네 녹화 시작한 지 이제 17분 만에 거의 20분 만에 뽑기 시작합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.847,
                "end": 56.583
            }
        ]
    },
    "summary": "화자가 세팅을 해주면서 어떤 걸 키우고 키우지 말 것을 알려주면서 보물은 무공비가 제일이 좋으니까 무조건 무공비를 하고 낫이고 부활 보물 해도 괜찮다고 했고 이제 녹화 20분 만에 뽑기 시작한다고 한다.",
