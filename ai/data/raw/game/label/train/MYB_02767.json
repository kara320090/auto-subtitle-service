        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 저는 따로 하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.620
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 해서 3.28 잘 나오면 3.38 뭐 3.34 잘 나오고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.630,
                "end": 9.107
            },
            {
                "speaker_id": "1",
                "transcription": "예 딜 통계표는 요렇게 나오고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.117,
                "end": 11.409
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 이거 영상 보고 했는데 저는 왜 이렇게 딜이 안 나오죠하는 분들 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.419,
                "end": 15.305
            },
            {
                "speaker_id": "1",
                "transcription": "그분들은 어떻게 하냐면은 캡틴 캐비어가 그 스턴에 걸리면은 모든 게 다 꼬여 버리거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.315,
                "end": 20.751
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요게 상태 이상에 안 걸릴 수 있도록 밀키웨이 쿨을 높이거나 조금 낮추거나 이게 정답이 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.761,
                "end": 27.469
            },
            {
                "speaker_id": "1",
                "transcription": "보니까 저희 길드원분들도 뭐 23.8부터 24.5 뭐 이렇게 왔다 갔다 하면서 다 개인마다 다 다르거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.479,
                "end": 34.675
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 캡틴 캐비어를 살짝 쿨을 바꿔 주시든가 자 다시 한번 더 보여드리겠습니다. 처음에 목화 예약",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.685,
                "end": 41.766
            }
        ]
    },
