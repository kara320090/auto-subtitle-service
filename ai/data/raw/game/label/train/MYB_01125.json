        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 제가 만약에 잠시만요 이거.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.313
            },
            {
                "speaker_id": "1",
                "transcription": "어우 야 이거 겨우 이겼다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.313,
                "end": 5.732
            },
            {
                "speaker_id": "1",
                "transcription": "제가 만약에 똑같은 여러분들 초월도 같고 잼스톤도 똑같이 올릴 수 있는 상황이라면은 바다요정 보다는 블랙펄 쪽에 투자를 더 많이 할 것 같긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.742,
                "end": 15.023
            },
            {
                "speaker_id": "1",
                "transcription": "사실상 블랙펄을 더 많이 지금 유용하게 쓰고 있는 게 현실입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.033,
                "end": 19.603
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 상대가 뒤에 파르페인 거 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.613,
                "end": 22.961
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 샤이닝글리터와 스타더스트 조합 제가 각각의 어 다양한 조합들을 상대로 만났을 때 전부 다 거의 무지성급으로 어 지금 다 유용하게 쓸 수 있다는 걸 보여드리려고 어 제가 지금 보여드리고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.971,
                "end": 38.578
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 아마 티어가 더 낮으면은 더 상대방들이 이제 피감이 낮으면은 못 버티고 다 터질 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.588,
                "end": 46.421
            },
            {
                "speaker_id": "1",
                "transcription": "지금 상위권은 나름 스펙이 다 높은 분들임에도 불구하고 이렇게 다 터지는 경우가 많거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.431,
                "end": 53.829
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 한마디로 스펙이 낮은 구간에서는 더 잘 통할 가능성이 좀 더 크다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.839,
                "end": 59.954
            },
            {
                "speaker_id": "1",
                "transcription": "네 그마라고 해서 뭐 무조건 지금 통하는 게 아니라 오히려 낮은 스펙에서도 잘 통할 가능성이 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.964,
                "end": 68.807
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 이렇게 활용이 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.817,
                "end": 73.266
            }
        ]
    },
    "summary": "사실상 블랙펄을 더 많이 지금 유용하게 쓰고 있는 게 현실이며 다양한 조합들을 상대로 만났을 때 다 유용하게 쓸 수 있다는 걸 보여드리고 있고 스펙이 낮은 구간에서는 더 잘 통할 가능성이 좀 더 크다.",
