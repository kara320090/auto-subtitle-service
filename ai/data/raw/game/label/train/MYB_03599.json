        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 스킨 왜 뽑냐고요 이거 저는 원래 1, 2주년 때까지 기다리라고 말씀드렸는데 계정 주인분이 우유맛 쿠키 스킨은 어차피 안 나올 것 같다고 해서 다 뽑아달라고 하십니다 여러분들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 12.580
            },
            {
                "speaker_id": "1",
                "transcription": "다른 분들도 혹시나 스킨 지금 뽑아야 되나 생각하는 분들이면 안 뽑아도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.580,
                "end": 17.670
            },
            {
                "speaker_id": "1",
                "transcription": "2주년 때 신규 스킨 나오면은 그때 뽑으세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.670,
                "end": 20.581
            },
            {
                "speaker_id": "1",
                "transcription": "물론 신규 레전드가 출시될 때 스킨까지 같이 나온 경우는 단 한 번도 없었거든요 오 나왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.591,
                "end": 35.356
            },
            {
                "speaker_id": "1",
                "transcription": "오 뭐야 독버섯도 나왔어.",
                "sound_type": [
                    2,
