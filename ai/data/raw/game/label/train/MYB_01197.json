        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "확실하게 자 보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.347
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 브레스로 이렇게 녹여버리는게 포인트입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.357,
                "end": 6.696
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 녹여버리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.706,
                "end": 9.665
            },
            {
                "speaker_id": "1",
                "transcription": "좀 이지하게 이렇게 이길 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.675,
                "end": 16.104
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 또 또 하나 상대 깃털있죠? 그러면 당연히 여기에 실론이 있을 가능성이 큽니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.114,
                "end": 21.906
            },
            {
                "speaker_id": "1",
                "transcription": "실론 소르베 조합 이 조합에 아주 강력한 조합입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.916,
                "end": 25.115
            },
            {
                "speaker_id": "1",
                "transcription": "거의 퍼펙으로 이겨요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.125,
                "end": 26.878
            },
            {
                "speaker_id": "1",
                "transcription": "상상상 너무나 중요하기때문에 어 왜 이런 경우가 나오냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.888,
                "end": 31.397
            },
            {
                "speaker_id": "1",
                "transcription": "상대가 소르베가 있으면 어 파르페의 맛탕 중에 공격력이 가장 높은 쿠키에게 디버프 면역을 부여해 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.407,
                "end": 39.880
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 아군의 쿠키 공격력이 가장 높은 용과 드래곤 쿠키나 이런 디버프가 걸리지 않고 생존이 가능하게 돼서 예 무난하게 이기는 스토리로 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.890,
                "end": 56.207
            },
            {
                "speaker_id": "1",
                "transcription": "파르페가 상대 소르베가 있으면은 너무나 좋게 활용 가능해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.217,
                "end": 60.929
            },
            {
                "speaker_id": "1",
                "transcription": "승률이 거의 뭐 퍼펙으로 이기는 그림으로 잘 보여집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.939,
                "end": 65.263
            },
            {
                "speaker_id": "1",
                "transcription": "레어 무공비나 무공비 요 조합은 1번 조합 가면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.273,
                "end": 70.656
            },
            {
                "speaker_id": "1",
                "transcription": "락스타 피감이 높으면 안 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.666,
                "end": 72.809
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 락스타가 너무 늦게 죽으면 다른 쿠키가 다 죽고 나서 락스타만 생존이 되는 경우에는 락스타를 활용을 못하는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.819,
                "end": 83.980
            },
            {
                "speaker_id": "1",
                "transcription": "가장 좋은 건 락스타가 먼저 죽어서 나머지 딜러나 탱커 힐러를 살려주는 게 포인트입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.990,
                "end": 94.266
            }
        ]
    },
    "summary": "화자가 실론 소르베 조합은 강력한 조합이라며 거의 퍼펙트로 이길 수 있다며 파르페는 상대에 소르베가 있으면 너무 좋게 활용이 가능하며 락스타는 피감이 높으면 안 된다고 설명하고 있다.",
