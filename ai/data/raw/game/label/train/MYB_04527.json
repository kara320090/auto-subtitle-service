        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번 영상의 목적은 초보자분들이 종종 질문하는 러너님 전투력 15만으로 마스터 갔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.130
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 10일차 인데 전투력 10만인데 잘하는 건가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.140,
                "end": 9.430
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 저는 왜 전투력이 낮을 까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.440,
                "end": 12.014
            },
            {
                "speaker_id": "1",
                "transcription": "라고 묻는 분들에게 조금이나마 도움이 되길 바라는 영상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.024,
                "end": 16.224
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키는 킹덤이라는 게임은 시간 투자만 잘하면 쿠키 스펙이 엄청나게 올라갈 수 있지만 전투력이 절대적으로 강함을 나타내는 기준이 아니기 때문에 맹목적으로 전투력에만 우선순위를 두지 않는게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.234,
                "end": 29.129
            },
            {
                "speaker_id": "1",
                "transcription": "오히려 쿠키 조합과 보물 세팅으로 수십만 전투력 차이와 스펙 차이를 이겨낼 수 있기 때문에 쿠키 티어 표를 참고해서 유튜브나 공식 카페에 있는 추천 조합을 따라 해 보시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.139,
                "end": 40.624
            },
            {
                "speaker_id": "1",
                "transcription": "마지막으로 궁금한 점이 있다면 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.634,
                "end": 44.098
            },
            {
                "speaker_id": "1",
                "transcription": "좋아요와 구독 눌러주시면 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.108,
                "end": 51.250
            }
        ]
    },
    "summary": "화자가 쿠키는 킹덤이라는 게임은 시간 투자만 잘하면 쿠키 스펙이 올라갈 수 있지만 전투력이 절대적으로 강함을 나타내는 기준이 아니라고 이야기하고 있다.",
