    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쫌 5퍼센트 이상이 어디까지 와있냐면 여기 정도까지 왔거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.336
            },
            {
                "speaker_id": "1",
                "transcription": "오 5퍼센트 이상이 4줄 정도 되면은 어느 정도 진짜 아레나 할 때는 불편함이 없을 거 같거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.346,
                "end": 11.229
            },
            {
                "speaker_id": "1",
                "transcription": "큰 문제가 없을 거 같은데 일단 라즈도 보면은 한15개 정도 밖에 없고 5퍼센트 이상",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.239,
                "end": 16.429
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 토핑 강화를 쫌 하시긴 하셔야 될 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.439,
                "end": 19.569
            },
            {
                "speaker_id": "1",
                "transcription": "이게 쿨 피가 붙은 것도 거의 없고 많이",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.579,
                "end": 22.186
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 토핑 강화를 쪼끔 더 신경 써주셔야 될 거 같애.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.196,
                "end": 25.064
            },
            {
                "speaker_id": "1",
                "transcription": "쿨이 쫌 압도적으로 쫌 많이 부족하시네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.074,
                "end": 27.423
            },
            {
                "speaker_id": "1",
                "transcription": "얘에다가 집중 투자 너무 많이 하는 거 보다는 쿨이 중요해요 왜냐면 토벌이나 아레나 세팅이나 보면은 지금 현재 말도 안 되게 쿨 수치가 높은 걸 요구하는 덱들이 많이 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.433,
                "end": 40.542
            },
            {
                "speaker_id": "1",
                "transcription": "토핑작도 쫌 나름 열심히 하셔야 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.552,
                "end": 43.523
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 아이구야 잠깐만 더 있다 휘낭시에 넣어 보는 게 난 더 좋을 거 같은데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.533,
                "end": 50.335
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 소환덱은 크림 유니콘 보다 파르페가 더 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.345,
                "end": 54.061
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면은 이게 잘못 알고 있는 게 크림 유니콘이 한 번 날아가면은 얘가 힐을 꽉 채워주긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.071,
                "end": 60.833
            },
            {
                "speaker_id": "1",
                "transcription": "근데 체력이 어느 정도 많이 있는 상태에서 크림 유니콘을 쓰게 되면은 소환 덱은 유지력이 그거보다는 파르페 토트 힐이 생명력 유지에 더 좋거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.843,
                "end": 70.860
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 소환 덱을 메인으로 쓰실 거면은 피감 챙기고 부옵션 크게 신경 안 쓰고 파르페 그냥 올 쿨로 세팅을 해주시는 게 훨씬 더 좋고 그다음에 요새는 크런치 초코칩이 피감 높게 하는 게 더 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.870,
                "end": 85.037
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 오히려 크런치 초코칩이 더 오래 살아남는 게 더 중요하거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.047,
                "end": 88.949
            },
            {
                "speaker_id": "1",
                "transcription": "피감을 되게 높게 더 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.959,
                "end": 92.309
            },
            {
                "speaker_id": "1",
                "transcription": "이거 같은 경우에도 오이스터가 보면은 쿨이 11. 2만 넘으면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.319,
                "end": 96.571
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 오이스터는 특이하게 쿨이 높으면 높을 수록 뭐 쿨이 더 빨리 돌고 그런 거 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 96.581,
                "end": 101.911
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 딱 정해져 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 101.921,
                "end": 103.251
            },
            {
                "speaker_id": "1",
                "transcription": "소환하는 몹의",
                "sound_type": [
                    2,
                    5
                ],
                "start": 103.261,
                "end": 105.266
            }
        ]
    },
