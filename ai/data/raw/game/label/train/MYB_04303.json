        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹텀을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.114
            },
            {
                "speaker_id": "1",
                "transcription": "원도우와 맥버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.124,
                "end": 6.411
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.421,
                "end": 10.354
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정이 좋다는 사람도 있고 안 좋다는 사람도 있던데 스토리에서는 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.364,
                "end": 15.217
            },
            {
                "speaker_id": "1",
                "transcription": "스토리에서는 바다요정이 안 좋습니다라고 말하는 분이 있다면 글쎄요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.227,
                "end": 19.614
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서는 지금 바다요정이 안 쓰이기 때문에 좋지 않다는 거는 맞고 스토리 모드에서는 아직도 0티어입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.624,
                "end": 28.600
            }
        ]
    },
    "summary": "아레나에서는 바다요정이 좋지 않다는 거는 맞고 스토리 모드에서는 아직도 0티어입니다.",
