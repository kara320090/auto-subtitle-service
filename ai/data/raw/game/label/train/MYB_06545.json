        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 이게 조작이 점점 달라져요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.767
            },
            {
                "speaker_id": "1",
                "transcription": "내가 애였을 때랑 이 둥그렇게 됐을 때랑 조작이 좀 달라.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.777,
                "end": 12.495
            },
            {
                "speaker_id": "1",
                "transcription": "어 물리가 좀 달라.",
                "sound_type": [
                    2
                ],
                "start": 12.505,
                "end": 16.175
            },
            {
                "speaker_id": "1",
                "transcription": "어 움직여짐이 산타에게 소원 빌어요.",
