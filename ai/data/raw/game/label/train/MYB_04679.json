        "term": [
            {
                "speaker_id": "1",
                "transcription": "아이 되게 빨리 됐다 5초월 생각보다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.466
            },
            {
                "speaker_id": "1",
                "transcription": "와 근데 진짜 200만 원 정도 과금을 다 하신 것 같은데 과금 풀로 하면은 이렇게 되나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.476,
                "end": 9.705
            },
            {
                "speaker_id": "1",
                "transcription": "저는 아직 이 상태까지 가려면 멀은 것 같은데 이거 계정 주인 분 이거 너무 아깝거든요 고기 젤리?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.715,
                "end": 16.880
            },
            {
                "speaker_id": "1",
                "transcription": "태엽이라도 돌려서 토핑작하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.890,
                "end": 19.725
            },
            {
                "speaker_id": "1",
                "transcription": "네 저 고기 젤리 싹 다 토핑작 하시면 됩니다. 알겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.735,
                "end": 24.231
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 일단 뽑기 마치도록 할게요.",
                "sound_type": [
