        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이런 경우에도 극딜 조합으로 상대를 녹일 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.006
            },
            {
                "speaker_id": "1",
                "transcription": "자 시작하자마자 상대가 뭐 아무것도 못하고 그냥 다 녹아버리는 걸 볼 수가 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.016,
                "end": 13.571
            },
            {
                "speaker_id": "1",
                "transcription": "어 시작하고 나서 뭐 한방 덱도 아닌데 마치 한방 덱인 것처럼 이렇게 못 버티고 다 녹아버리는 걸 볼 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.581,
                "end": 21.473
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 이 덱은 이렇게 홀용스달스한테 어마무시하게 강합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.483,
                "end": 26.488
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대 무공비급이고 스타더스트에다가 블랙펄이죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.498,
                "end": 30.884
            },
            {
                "speaker_id": "1",
                "transcription": "저는 무공비급일 때는 살짝 추천하지 않는 게 여러분들이 이 딜을 버틸 수가 있어야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.894,
                "end": 38.569
            },
            {
                "speaker_id": "1",
                "transcription": "좀 버틸 수 있어야지만 어느 정도 유용하게 쓸 수 있는데 못 버티면은 내가 죽어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.579,
                "end": 46.108
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 만약에 지금 보셨나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.118,
                "end": 49.648
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 얘를 무공비급에도 가려고 하신다면은 락스타의 피감을 되게 좀 더 낮추세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.658,
                "end": 55.168
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 락스타가 이렇게 죽으면서 나머지를 다 피를 채워줬죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.178,
                "end": 58.902
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 이렇게 이기는 방법도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.912,
                "end": 61.271
            },
            {
                "speaker_id": "1",
                "transcription": "다 피감 낮게 설정하거나 다 피감 높게 설정하는 거는 잘못된 세팅이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.281,
                "end": 65.991
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 무공비급 덱한테도 들어갈 때는 락스타의 피감은 오히려 확실히 낮춰줘서 가장 먼저 죽게 만들면은 요렇게 조금 완벽하게 승리할 수 있는 구도로 여러분들이 세팅이 가능하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.001,
                "end": 79.722
            },
            {
                "speaker_id": "1",
                "transcription": "네 극딜 조합으로도 이길 수 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 79.732,
                "end": 82.933
            }
        ]
    },
    "summary": "한 남성이 게임에서 상대가 무공비급일 때는 살짝 추천을 하지 않는데 이 딜을 버틸 수 있어야지 아니면 내가 죽는다고 하며 예시를 보여주는데 만약 무공비급에도 가려고 한다면 락스타의 피감을 좀 더 낮추면 락스타가 죽으면서 나머지 피를 채워줘서 이기는 방법이 있다고 말한다.",
