        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 추가로 지금 전설 스킨 뽑기 되고 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.997
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 신규 레전드 스킨이 나왔는데 여러분들 많이 무지개 큐브가 부족할 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.007,
                "end": 8.086
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 라이브 방송이나 고정 댓글을 통해서 무지개 큐브 3000개 이벤트를 하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.096,
                "end": 14.104
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개 받는 방법은 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.114,
                "end": 17.282
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱 다운로드 링크로 다운받으시고 자 여러분들 이렇게 다운받으시면 자 우측 화면에 프로필 프로필 누르시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.292,
                "end": 26.457
            },
            {
                "speaker_id": "1",
                "transcription": "오른쪽 위에 톱니바퀴 누릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.467,
                "end": 28.688
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러면 여기 시크릿코드가 화면에 보이게 되죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.698,
                "end": 32.096
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 플오ND러너 입력해주시면 끝입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.106,
                "end": 35.786
            },
            {
                "speaker_id": "1",
                "transcription": "사용하기 눌러주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.800,
                "end": 37.720
            },
            {
                "speaker_id": "1",
                "transcription": "자 추가로 크리스탈 3000개 쿠폰도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.726,
                "end": 40.193
            },
            {
                "speaker_id": "1",
                "transcription": "아직 입력 안 한 분들은 입력하시고 3000개 받아가시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.193,
                "end": 45.125
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 관련된 자세한 내용은 고정 댓글 확인해보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.135,
                "end": 49.513
            },
            {
                "speaker_id": "1",
                "transcription": "자 궁금한 점이 있다면 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.506,
                "end": 53.040
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
