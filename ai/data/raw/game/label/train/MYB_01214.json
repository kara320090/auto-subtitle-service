        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 쿠키런 킹덤 복잡한 아레나 정보 이야기가 아니라 바다요정 관련된 이야기를 할까 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.149
            },
            {
                "speaker_id": "1",
                "transcription": "CRK 뉴스에서 어 전문적으로 유출하는 분이 따로 계세요 외국 해외 분이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.159,
                "end": 12.849
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕맛 쿠키 페퍼민트 쿠키 뭐 슈퍼 에픽 크림슨코랄 쿠키 글라스마린 쿠키 이렇게 해서 뭐 다른 신규 쿠키가 나온다 뭐 저런 내용들이 100퍼센트 확신적으로 나온 건 아니지만 어 대부분 맞는 내용으로 나오는 경우가 많았거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.859,
                "end": 31.326
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 8월 9일 보면은 추후에 글라스 마린 쿠키는 뭐 나중에 나오고 프릴 해파리가 나온다고 이렇게 되어 있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.336,
                "end": 39.470
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 영상의 주제는 저게 아니라 핵심적으로 바다요정에 관련된 얘기입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.480,
                "end": 44.721
            },
            {
                "speaker_id": "1",
                "transcription": "자 전문적으로 유출하는 분이 자 요런 이미지도 발견 했거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.731,
                "end": 49.754
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 사람들이 유추하기를 물 속성 관련된 것도 이제 앞으로 업데이트된다 그래서 나온 얘기가 이제 생방송이나 댓글을 바다요정 이제 물 속성 업데이트 되면 대 개편돼서 사용된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.764,
                "end": 61.429
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 얘기가 상당히 많이 나오고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.439,
                "end": 64.130
            },
            {
                "speaker_id": "1",
                "transcription": "제가 봐도 이제 쿠키런 킹덤 앞으로 속성 업데이트가 추후에 계속 이루어진다면 지금 보이는 것 같이 바다 관련된 이미지 에피소드가 아 이제 바다 쪽으로 쭉 이어지는 것 같아요.",
                "sound_type": [
