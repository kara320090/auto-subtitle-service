        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번 영상은 쿠키런 킹덤 유저가 많이 떠나가고 있는 상황에 대해서 제 개인적인 생각을 말씀드리려 고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.025
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤은 망했다 게임이 재미 없다 숙제 같다 예전부터 반복되어 들어왔던 말이지만 그래도 업데이트 마다 기대감을 가지고 버텨왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.035,
                "end": 15.831
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 업데이트 마다 유저는 대거 이탈했고 유저부터 부담을 주는 업데이트의 반복으로 길드원들은 엄청나게 빠져나가고 구인하느라 스트레스 반복으로 더 이상 게임같이 느껴지지 않는 상황입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.841,
                "end": 27.886
            },
            {
                "speaker_id": "1",
                "transcription": "왜 그럼 쿠키런 킹덤은 업데이트할 때 마다 유저들이 빠져나갈까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.896,
                "end": 31.799
            },
            {
                "speaker_id": "1",
                "transcription": "힘들다고 다 접는 이유는 뭘까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.809,
                "end": 33.815
            },
            {
                "speaker_id": "1",
                "transcription": "근본적으로 저는 쿠키런 킹덤이 업데이트할 때 마다 유저가 원하는 방향을 잘 모른다고 생각 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.825,
                "end": 39.810
            },
            {
                "speaker_id": "1",
                "transcription": "신규 콘텐츠가 나와도 어차피 반복되는 문제를 해결하지 못하면서 신규 쿠키 출시와 매번 똑같은 퀘스트 이벤트로 이젠 질릴 대로 질려서 떠나가는 유저들이 공식 카페에 문제점에 대해서 언급을 해도 반영되지 않는 상황들 이런 문제에 대해 언급해 보려 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.820,
                "end": 57.446
            }
        ]
    },
    "summary": "남성은 쿠키런 킹덤 유저가 많이 떠나가고 있는 상황에 대해서 근본적으로 쿠키런 킹덤이 업데이트할 때 마다 유저가 원하는 방향을 잘 모른다고 생각한다고 말하고 있다.",
