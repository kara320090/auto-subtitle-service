        "term": [
            {
                "speaker_id": "1",
                "transcription": "좀 궁금하긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.209
            },
            {
                "speaker_id": "1",
                "transcription": "검볼다이버맛 쿠키 이제 뽑을 정도의 크탈은 일단 존버하는 게 나은 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.219,
                "end": 6.838
            },
            {
                "speaker_id": "1",
                "transcription": "가자 아 오케이 바다 관련 쿠키들 많이 나왔는데 약간 인연 도감이 생기지 않을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.848,
                "end": 16.217
            },
            {
                "speaker_id": "1",
                "transcription": "지금 바다 관련 쿠키들 인연 도감이 이 있나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.227,
                "end": 18.895
            },
            {
                "speaker_id": "1",
                "transcription": "바다 관련 애들이 분명히 이제 많이 쌓여서 새로운 신규 인연 나오겠다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.905,
                "end": 24.631
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.641,
                "end": 26.456
            },
            {
                "speaker_id": "1",
                "transcription": "바다 관련 애들 나오겠어 신규 인연 도 나올 가능성이 좀",
                "sound_type": [
                    2,
                    3,
                    5
                ],
