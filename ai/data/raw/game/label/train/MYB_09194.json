                ],
                "start": 7.599,
                "end": 9.501
            },
            {
                "speaker_id": "1",
                "transcription": "혼돈의 세계에 대해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.511,
                "end": 13.058
            },
            {
                "speaker_id": "1",
                "transcription": "대체 이 하늘은 어떻게 된 게냐?",
