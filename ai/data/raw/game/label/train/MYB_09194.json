                    2,
                    3
                ],
                "start": 13.068,
                "end": 15.279
            },
            {
                "speaker_id": "1",
                "transcription": "마치 세상의 종말이라도 온 것 같구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.289,
                "end": 17.202
            },
            {
                "speaker_id": "1",
                "transcription": "바깥 상인들도 혼란에 빠진 모양이더구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.212,
                "end": 19.983
            },
            {
                "speaker_id": "1",
                "transcription": "거래 얘기가 하나도 안 들어오지 뭐냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.993,
                "end": 22.216
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이럴 때야말로 기계 기회가 있는 법이지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.226,
                "end": 24.996
            },
            {
                "speaker_id": "1",
                "transcription": "걱정 말거라 클라이브",
