    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 @이름1 님 계평 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.340
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 분 같은 경우에는 일단 사연을 보면은 쿠키런 킹덤을 1년 반 정도 한 유저입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.340,
                "end": 7.640
            },
            {
                "speaker_id": "1",
                "transcription": "1년 반 정도면은 뭐 지금 2주년 가까워지니까 6개월 빼고는 다 하셨다는 거죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.640,
                "end": 13.390
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 들어 접속 시간이 줄어들고 재고가 좀 박살 났습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.390,
                "end": 16.620
            },
            {
                "speaker_id": "1",
                "transcription": "성 올릴 생각은 하지도 못하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.620,
                "end": 19.160
            },
            {
                "speaker_id": "1",
                "transcription": "올려야 될 테크 재고 봐주시면 감사합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.160,
                "end": 22.360
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 요즘 스펙이 정체된 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.360,
                "end": 24.490
            },
            {
                "speaker_id": "1",
                "transcription": "연구, 초월, 토핑 봐주시면 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.490,
                "end": 26.780
            },
            {
                "speaker_id": "1",
                "transcription": "특히 연구는 왕국 연구해야 될지 쿠키 연구를 해야 되는 상황인지 모르겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.780,
                "end": 31.220
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 어떻게 해야 할지 전체적으로 조언을 해 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.220,
                "end": 34.090
            },
            {
                "speaker_id": "1",
                "transcription": "자 창고 같은 경우에는 176칸 현재 재고 상태를 보면은 넉넉해 보이네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.090,
                "end": 39.050
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 이게 재고가 100개, 백이십, 백삼십 가면은 200칸까지 뚫어 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.050,
                "end": 43.280
            },
            {
                "speaker_id": "1",
                "transcription": "200칸 정도 하면은 좀 여유롭습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.280,
                "end": 46.020
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 쿠키성은 레벨이 13성, 13성 정도면은 이제 쿠키 하우스는 최소 진짜 11레벨이나 10레벨 정도는 찍어야 정상이거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.020,
                "end": 54.840
            },
            {
                "speaker_id": "1",
                "transcription": "11레벨 음 이 정도면은 다 잘 되어 있고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.840,
                "end": 60.326
            }
        ]
    },
    "summary": "쿠키런 킹덤을 1년 반 정도 하셨고 접속 시간이 줄어들면서 재고가 부족해지고 스펙이 정체된 것 같아서 연구, 초월, 토핑을 봐주시면 좋겠고 앞으로 어떻게 해야 하는지 조언을 해 달라고 하셨는데 현재 창고의 재고는 넉넉하고 쿠키성 레벨을 봤을 때 쿠키 하우스가 11레벨로 잘 되어 있다.",
