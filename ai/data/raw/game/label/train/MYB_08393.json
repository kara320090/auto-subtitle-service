        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "돌아왔구나 대화는 어땠어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.572
            },
            {
                "speaker_id": "1",
                "transcription": "아 자초지종 어쩌구저쩌구 도란도란.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.582,
                "end": 11.233
            },
            {
                "speaker_id": "1",
                "transcription": "이 일대를 성채 도시로 만든다며 강한 도시를 만드는 건 찬성이지만 주민을 경시하는 건 다른 얘기다 주민과 협력하면 더 좋은 도시를 만들 수 있을 텐데.",
                "sound_type": [
                    2
                ],
                "start": 11.243,
                "end": 23.963
            },
            {
                "speaker_id": "1",
                "transcription": "그는 국가와 행정이 있어야 백성이 있다고 생각해 협력관계 성립을 보지 않고 있다.",
                "sound_type": [
                    2
                ],
                "start": 23.973,
                "end": 31.030
            },
            {
                "speaker_id": "1",
                "transcription": "주민들은 널 따르는데 병사들은 공작을 따르고 있다.",
                "sound_type": [
                    2
                ],
                "start": 31.040,
                "end": 36.508
            },
            {
                "speaker_id": "1",
                "transcription": "양쪽 다 의지가 굳건해 보인다.",
                "sound_type": [
                    2
                ],
                "start": 36.518,
                "end": 38.840
            },
            {
                "speaker_id": "1",
                "transcription": "병사들의 생각은 당연하다.",
                "sound_type": [
                    2
                ],
                "start": 38.850,
                "end": 44.283
            },
            {
                "speaker_id": "1",
                "transcription": "도시의 분열은 피할 수 없나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.293,
                "end": 46.451
            },
            {
                "speaker_id": "1",
                "transcription": "그건 그때 가서 생각하자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.461,
                "end": 49.366
            }
        ]
    },
    "summary": "두 캐릭터가 대화하고 있고 여자는 주민을 우선적으로 남자는 병사를 우선적으로 생각하고 있는 거 같다.",
