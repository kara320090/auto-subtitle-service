        "term": [
            {
                "speaker_id": "1",
                "transcription": "그것뿐만 아니라 이것도 아시는 분은 아시는데 한 번도 안 눌러 본 사람도 있더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.048
            },
            {
                "speaker_id": "1",
                "transcription": "이게 탭을 누르면 꾸미기 요거 들어가서 여러분들이 살 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.058,
                "end": 8.996
            },
            {
                "speaker_id": "1",
                "transcription": "랜드마크 안 산 거나 쿠키가 모자란 거 여기서 살 수 있는데 여기 아이템 들어가면 크리스탈이랑 토핑이랑 고기 젤리 요거 살 수 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.006,
                "end": 17.389
            },
            {
                "speaker_id": "1",
                "transcription": "마일리지 모아 놓고 힘들게 안 쓰는 분도 있더라고 이거 생긴지 몰라 가지고 요 들어가서 구매해서 꼭 마일리지로 다 챙겨 주시고 이미 하신 분들은 아시겠지만 레전드 주는 거 이거 놓치지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.399,
                "end": 30.507
            },
            {
                "speaker_id": "1",
                "transcription": "너무 아깝거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.517,
                "end": 31.199
            },
            {
                "speaker_id": "1",
                "transcription": "나름 확장적으로 영혼석 20개를 주기 때문에 이거 놓치면 안 돼서 여러분들 꾸준히 해서 막 날까지 다 받으시길 바랍니다.",
                "sound_type": [
