        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분 우리에겐 시간이 얼마 남지 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.617
            },
            {
                "speaker_id": "1",
                "transcription": "곧 신이 우리를 위한 낙원의 문을 여실 것입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.627,
                "end": 10.748
            },
            {
                "speaker_id": "1",
                "transcription": "더 이상 진흙 속에 묻혀있지 마십시오.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.758,
                "end": 14.773
            },
            {
                "speaker_id": "1",
                "transcription": "누구에게나 허락된 빛을 따라 하늘로 올라가십시오.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.783,
                "end": 20.574
            },
            {
                "speaker_id": "2",
                "transcription": "아까부터 자꾸 알 수 없는 소리만 하고 있네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.584,
                "end": 23.679
            },
            {
                "speaker_id": "3",
                "transcription": "그러게 우리한테 필요한 건 신이 아니라 일자리인데 말이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.689,
                "end": 28.771
            },
            {
                "speaker_id": "1",
                "transcription": "감긴 눈을 뜨십시오.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.781,
                "end": 31.385
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 마음을 여십시오.",
                "sound_type": [
                    2,
                    3
                ],
