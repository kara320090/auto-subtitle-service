        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 @이름1님 뽑기 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.556
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키 상태 보시고 필요한 것들 뽑아주시고 소르베맛 쿠키 갖고 싶습니다 자 부탁드립니다 자 필요한 거는 현재 서리 뽑으면 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.566,
                "end": 13.765
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 소르베 뽑으면 좋구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.775,
                "end": 15.470
            },
            {
                "speaker_id": "1",
                "transcription": "어 음유시인이 이렇게 있는데 음유시인에 올인을 해야 되나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.480,
                "end": 21.486
            },
            {
                "speaker_id": "1",
                "transcription": "이거 음유시인 4성만 뽑고 나머지 고급으로 갑시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.496,
                "end": 24.711
            },
            {
                "speaker_id": "1",
                "transcription": "내가 볼 때는 이분한테는 음유시인이 좋은 거 같지가 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.721,
                "end": 28.065
            },
            {
                "speaker_id": "1",
                "transcription": "음유시인 3성까지만 뽑고 예 고급으로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.075,
                "end": 31.183
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 가겠습니다.",
                "sound_type": [
                    2,
