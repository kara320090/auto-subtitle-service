        "term": [
            {
                "speaker_id": "1",
                "transcription": "상대의 뱀파 쿨에 따라서도 좀 달라질 수도 있지만 웬만해서는 승률이 되게 좋은 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.479
            },
            {
                "speaker_id": "1",
                "transcription": "거진 다 안정적으로 이깁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.489,
                "end": 13.124
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 압도적으로 약간 상성 상 유리하게 이기는 걸 볼 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.134,
                "end": 22.085
            },
            {
                "speaker_id": "1",
                "transcription": "우유맛 쿠키는 사실상 초창기 때 쓰이던 쿠키거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.095,
                "end": 26.075
            },
            {
                "speaker_id": "1",
                "transcription": "초창기 때 정말 0티어로 쓰이던 쿠키가 지금 다시 쓰이고 있는 거라 다른 덱에 들어가면 승률이 낮아져요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.085,
                "end": 33.638
            },
            {
                "speaker_id": "1",
                "transcription": "이 시계 보물을 쓰고 있는 덱한테는 승률이 낮으니까 들어가면은 안 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.648,
                "end": 38.964
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 마찬가지 증표, 공속, 뱀파 요 3가지가 있으면은 들어가면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.974,
                "end": 46.266
            }
        ]
    },
    "summary": "남자는 상대의 뱀파 쿨에 따라서 달라질 수도 있지만 웬만해서는 승률이 좋은 것 같다며 거의 다 압도적으로 상성 상 유리하게 이기는 걸 볼 수 있다고 하는데 우유맛 쿠키는 초창기 때 0티어로 쓰이던 쿠키가 지금 다시 쓰이고 있는 거라 다른 덱에 들어가면 승률이 낮아진다며 시계 보물을 쓰고 있는 덱이나 증표, 공속, 뱀파 3가지가 있으면 승률이 낮으니까 들어가면 안 된다고 한다.",
