        "term": [
            {
                "speaker_id": "1",
                "transcription": "걱정 안 하셔도 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.070
            },
            {
                "speaker_id": "1",
                "transcription": "만렙 안 찍는다고 손해 볼 거 없고 이벤트성이고 다람쥐 상점은 나중에 또 나와도 이거 똑같이 팔 거 같아요. 제 생각에는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.080,
                "end": 8.555
            },
            {
                "speaker_id": "1",
                "transcription": "능력 자체는 이게 엄청 좋아 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.565,
                "end": 10.967
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소 20퍼센트, 치명타 피해 감소 15퍼센트가 만약에 5마리 쿠키 전부 다 적용이라면은 그러면은 정말 엄청 사기적일 거 같지만 단 하나의 쿠키만 적용된다는 점 때문에 예능용 보물이 될 거 같아요.",
                "sound_type": [
