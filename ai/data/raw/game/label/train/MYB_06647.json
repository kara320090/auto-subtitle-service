        "term": [
            {
                "speaker_id": "1",
                "transcription": "미친 놈들이 기승이로군.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.744
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 이렇지 않았는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.754,
                "end": 3.481
            },
            {
                "speaker_id": "1",
                "transcription": "저 종이는 백설과를 먹으면 글자가 보였던 것 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.491,
                "end": 8.133
            },
            {
                "speaker_id": "2",
                "transcription": "기매기매님 혹시 이리와 늑대의 차이점을 아시나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.143,
                "end": 13.256
            },
            {
                "speaker_id": "2",
                "transcription": "네 이리와 늑대의 차이점은 이리는 이제 안 쓰는 명칭이고 현재는 늑대라는 명칭을 쓴다는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.266,
                "end": 20.601
            },
            {
                "speaker_id": "3",
                "transcription": "아 나 계란 빵님이 가끔 이렇게 똑똑하게 알려주셔서 좋더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.611,
                "end": 24.149
            },
            {
                "speaker_id": "3",
                "transcription": "가끔 헛소리를 해도 참 유익한 인간이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.159,
                "end": 26.882
            },
            {
                "speaker_id": "3",
                "transcription": "감사드려요 고마워요 이리 와 안아줄게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.892,
                "end": 33.466
            }
        ]
    },
    "summary": "계란 빵님이 기매기매님에게 이리와 늑대의 차이점을 알려주고, 기매기매님은 유익한 인간이라며 고맙다고 말한다.",
