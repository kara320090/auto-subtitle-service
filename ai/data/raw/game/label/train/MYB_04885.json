        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "목 마르다고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.106
            },
            {
                "speaker_id": "2",
                "transcription": "제가 추천하는 거는 자 이렇게 비겼네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.116,
                "end": 4.822
            },
            {
                "speaker_id": "2",
                "transcription": "이거는 제가 추천하는 거는 캡틴케비어도 괜찮고 클로티드도 괜찮은데 공덱으로는 이게 더 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.832,
                "end": 12.390
            },
            {
                "speaker_id": "2",
                "transcription": "지금 방어도 제가 이렇게 세팅을 했거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.400,
                "end": 14.676
            },
            {
                "speaker_id": "2",
                "transcription": "지금 보시면 아시겠지만 자 어마무시하죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.686,
                "end": 17.581
            },
            {
                "speaker_id": "2",
                "transcription": "자 요거 제가 세팅한 이후로 전부 다 이겼어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.591,
                "end": 20.329
            },
            {
                "speaker_id": "2",
                "transcription": "자 상대방분은 크림 유니콘 자 이렇게 가고 이 덱 자체가 승률이 정말 좋게 나와서 리뷰 하는 거지만 이게 보면은 아까 토핑 설명할 때 어 이거 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.339,
                "end": 38.995
            },
            {
                "speaker_id": "2",
                "transcription": "캡틴케비어가 잘 죽을 수도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.005,
                "end": 42.626
            },
            {
                "speaker_id": "2",
                "transcription": "잘 죽는 경우에는 이제 원제작자분이 이제 여기 아몬드 하나 껴서 하나라고 했거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.636,
                "end": 48.839
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 그럴 경우에는 이제 뱀파이어 공격력 맞추려면은 뭐 치명타 이렇게 조절해서 여러분들이 세팅을 잘 해주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.849,
                "end": 56.538
            },
            {
                "speaker_id": "2",
                "transcription": "너무 얘가 잘 죽는다 싶으신 분들은 아몬드 하나 넣고 뱀파이어도 라즈에서 공격력을 빼거나 아니면 치명타 토핑을 통해서 희망 시에 버프를 조절해주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.548,
                "end": 67.600
            },
            {
                "speaker_id": "2",
                "transcription": "또 다른 클로티드도 한번 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.610,
                "end": 71.700
            }
        ]
    },
    "summary": "내가 추천하는 거는 캡틴케비어도 괜찮고 클로티드도 괜찮지만 공덱으로는 이게 더 좋고 방어도 세팅을 했는데 보면 어마무시하고 이렇게 세팅한 이후로 다 이겼고 이 덱 자체가 승률이 좋아서 리뷰하는 거지만 캡틴케비어가 잘 죽는다 싶을 때는 아몬드 하나 넣고 뱀파이어도 라즈에서 공격력을 빼거나 치명타 토핑을 통해서 희망 시에 버프를 조절하면 될 것 같다.",
