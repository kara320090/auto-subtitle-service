        "term": [
            {
                "speaker_id": "1",
                "transcription": "에휴 알았다고 알았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.587
            },
            {
                "speaker_id": "2",
                "transcription": "빨리 와 용과맛 쿠키.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.597,
                "end": 6.047
            },
            {
                "speaker_id": "3",
                "transcription": "잠깐 잠깐만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.057,
                "end": 7.647
            },
            {
                "speaker_id": "3",
                "transcription": "에이씨 아직 먹고 있는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.657,
                "end": 10.817
            },
            {
                "speaker_id": "4",
                "transcription": "그러니까 더더욱 토벌해야 한다는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.827,
                "end": 14.024
            },
            {
                "speaker_id": "4",
                "transcription": "아무 용이 아니라 전설의 붉은 용이니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.034,
                "end": 17.405
            },
            {
                "speaker_id": "5",
                "transcription": "토벌대가 용의 협곡으로 가 있는 동안 용이 도시를 습격하면 어쩔 거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.415,
                "end": 22.590
            },
            {
                "speaker_id": "5",
                "transcription": "용은 날아다닌다고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.600,
                "end": 24.797
            },
            {
                "speaker_id": "4",
                "transcription": "그렇게 따지고 들기 시작하면 어쩌자는 겁니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.807,
                "end": 27.934
            },
            {
                "speaker_id": "4",
                "transcription": "용은 날아다니니까 토벌이 불가능하다고 하시게요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.944,
                "end": 31.841
            },
            {
                "speaker_id": "6",
                "transcription": "아주 틀린 말도 아니죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.851,
                "end": 34.094
            },
            {
                "speaker_id": "6",
                "transcription": "그래서 날아다니는 용을 어떻게 토벌할 계획인데요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.104,
                "end": 38.174
            },
            {
                "speaker_id": "5",
                "transcription": "애초에 토벌대라고 모인 쿠키들도 제대로 훈련받은 적도 없이 뿔뿔이 흩어져서 활동하던 떠돌이 사냥꾼들일 뿐이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.184,
                "end": 47.587
            },
            {
                "speaker_id": "7",
                "transcription": "그래서 더욱 경험이 풍부하고 또 실전에 강하다네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.597,
                "end": 53.133
            }
        ]
    },
    "summary": "열성적인 모험가 쿠키가 전설의 붉은 용이라 더더욱 토벌해야 한다고 하자 학구적인 모험가 마을 쿠키는 용은 날아다니는데 토벌대가 용의 협곡으로 가 있는 동안 용이 도시를 습격하면 어쩔 거냐고 하고 겁이 많은 모험가 마을 쿠키도 날아다니는 용을 어떻게 토벌할 계획인지 묻는다.",
