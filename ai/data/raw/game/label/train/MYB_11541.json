                    2,
                    3
                ],
                "start": 20.252,
                "end": 30.162
            },
            {
                "speaker_id": "2",
                "transcription": "근데 검집 없이 가죽 수납에 대검이 대롱대롱 거리면 본인 또는 누군가는 다치지 않을까 하는 뻘생각이 들었습니다.",
                "sound_type": [
