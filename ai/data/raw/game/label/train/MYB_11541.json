        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 내방이 여기구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.546
            },
            {
                "speaker_id": "1",
                "transcription": "야 방이. 열어볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.556,
                "end": 11.135
            },
            {
                "speaker_id": "1",
                "transcription": "아니 방은 왜 안 보여줘? 방 구경하고 싶었는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.145,
                "end": 15.104
            },
            {
                "speaker_id": "1",
                "transcription": "기절을 했나? 방에 들어가자마자.",
