        "term": [
            {
                "speaker_id": "1",
                "transcription": "쫙쫙 다 녹이는 그림",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.271
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 딜표는 요렇게 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.281,
                "end": 3.597
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째로 이제 공속덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.607,
                "end": 5.282
            },
            {
                "speaker_id": "1",
                "transcription": "아까 공속덱 찰스덱이 좋다고 했죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.292,
                "end": 7.903
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거는 여러분 조심해야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.913,
                "end": 9.894
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 옆에 마들렌이 붙어있는 공속덱이 있거든요? 그거는 스타더스트 달빛 그런 덱이기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.904,
                "end": 16.059
            },
            {
                "speaker_id": "1",
                "transcription": "공속 보물만 있다고 해서 상대가 무조건 공속덱이다? 그런 게 아니라 퀸아망 마들렌이 있는 조합한테만 요걸로 들어가시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.069,
                "end": 24.733
            }
        ]
    },
    "summary": "조심해야 되는 게 있다고 홀리베리 옆에 마들렌이 붙어있는 공속덱이 있는데 그거는 스타더스트 달빛 그런 덱이기 때문에 공속 보물만 있다고 해서 상대가 무조건 공속덱인 게 아니라 퀸아망 마들렌이 있는 조합한테만 요걸로 들어가시면 된다고 얘기한다.",
