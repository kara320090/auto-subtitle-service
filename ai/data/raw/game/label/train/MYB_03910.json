        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 10조각만 더 있으면은 4성이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.516
            },
            {
                "speaker_id": "1",
                "transcription": "10조각만 더 뽑고 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.526,
                "end": 4.357
            },
            {
                "speaker_id": "1",
                "transcription": "음유시인 몇 티어 정도인가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.367,
                "end": 7.924
            },
            {
                "speaker_id": "1",
                "transcription": "지금 특수 아레나에서 특정 덱에서 어우 퓨바까지 굿",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.934,
                "end": 11.917
            },
            {
                "speaker_id": "1",
                "transcription": "네 음유시인 티어는 현재로서는 0티어는 아니고 어 굳이 구간을 세분화해서 정한다면은 1티어 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.927,
                "end": 19.794
            },
            {
                "speaker_id": "1",
                "transcription": "제 생각에는 0티어부터 있다고 치면은 1티어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.804,
                "end": 23.148
            },
            {
                "speaker_id": "1",
                "transcription": "1티어의 기준은 어 0티어처럼 만능 덱은 아니지만 특정 조합에서 되게 좋게 활용할 수 있는 자 일단 이렇게 해서 4성 찍고 고급으로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.158,
                "end": 32.707
            },
            {
                "speaker_id": "1",
                "transcription": "이분은 고급으로 좀 가긴 해야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.717,
                "end": 34.555
            },
            {
                "speaker_id": "1",
                "transcription": "없는 쿠키가 많고 다른 승급 자체가 많이 낮기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.565,
                "end": 39.966
            }
        ]
    },
