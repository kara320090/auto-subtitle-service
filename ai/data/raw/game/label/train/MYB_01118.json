        "term": [
            {
                "speaker_id": "1",
                "transcription": "파악할 수 없는 게 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.153
            },
            {
                "speaker_id": "1",
                "transcription": "전투력을 보고도 충분히 유추돼서 상대방의 덱을 파악하고 저격으로 들어갈 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.163,
                "end": 9.399
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 1번덱은 이렇게 3딜덱 저격으로 여러분들 쓸 수도 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.409,
                "end": 14.449
            },
            {
                "speaker_id": "1",
                "transcription": "아니면은 1번덱 자체는 2탱덱이나 다른 유용하게 여러 덱으로도 사용 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.459,
                "end": 22.234
            },
            {
                "speaker_id": "1",
                "transcription": "자 아까 말씀드린 대로 1번덱은 완벽한 3딜덱 카운터로 이렇게 쓸 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.244,
                "end": 28.133
            },
            {
                "speaker_id": "1",
                "transcription": "완벽하게 이기죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.143,
                "end": 29.554
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 2번덱은 아까 말씀드린 대로 무난하게 2탱덱에 다 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.564,
                "end": 35.266
            },
            {
                "speaker_id": "1",
                "transcription": "무공비든 레어 무공비든 전부 다 들어갈 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
