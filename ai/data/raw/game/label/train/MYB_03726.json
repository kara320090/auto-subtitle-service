        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 최초의 영혼석 주는 랜마네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.483
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐냐 저거 여러분들 저거는 좀 색다르네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.493,
                "end": 5.558
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱 플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.568,
                "end": 10.821
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.831,
                "end": 14.164
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.174,
                "end": 18.017
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 봅시다. 신규 랜드마크 리뷰 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.027,
                "end": 21.356
            },
            {
                "speaker_id": "1",
                "transcription": "여기에서 보상으로 받을 수 있고 떡돗자리 이렇게 랜드마크인데 자 일단 랜드마크 하면은 이거 에픽 이상 주는 건가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.366,
                "end": 33.073
            },
            {
                "speaker_id": "1",
                "transcription": "어 23시간마다 하나 사용하면 오 얘 누르면?",
