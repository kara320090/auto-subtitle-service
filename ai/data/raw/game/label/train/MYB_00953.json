        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 무지배 큐브 많이 부족하시죠 이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.649
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.659,
                "end": 12.421
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원 가격에 해당하는 가격인데 제가 무료로 나눠드리고 있는데 받는 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.431,
                "end": 24.097
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱을 다운로드 받으시고 우측 하단에 프로필을 누르시고 우측 상단에 톱니바퀴를 누르면 시크릿 코드를 입력하는 데가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.107,
                "end": 34.155
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오ND러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.165,
                "end": 38.557
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 앱은 도대체 어떤걸까 자 여러분들이 게임만 해도 자동으로 쌓이는 잼을 가지고 자 상점에서 여러분들이 원하는 기프트 카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.567,
                "end": 50.002
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임하면서 여러분들한테 따로 광고가 뜨지도 않고요 방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.012,
                "end": 55.989
            },
            {
                "speaker_id": "1",
                "transcription": "자 시크릿 코드 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요 자세한 이벤트 확인은 고정 댓글을 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.999,
                "end": 64.669
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 저희 대표해서 데브에다가 문의 좀 넣어주세요 2배해 달라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.679,
                "end": 69.066
            }
        ]
    },
    "summary": "지금 이벤트로 크리스탈 3000개를 무료로 드리니까 고정 댓글 확인하셔서 참여해 주시기 바라고 러너님이 대표해서 데브에 한국도 2배속 해달라고 문의해 줬으면 좋겠다.",
