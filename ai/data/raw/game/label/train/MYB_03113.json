        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 저한테 맡겨주시면 다 뽑아드립니다 달빛술사.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.253
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 저한테 맡겨주신 분들 다 뽑았죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.263,
                "end": 10.202
            },
            {
                "speaker_id": "1",
                "transcription": "계정 주인분 만족하시나요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.212,
                "end": 13.249
            },
            {
                "speaker_id": "1",
                "transcription": "어 영롱한 달빛 아 이분 원래 내일 뽑기 하려고 했는데 오늘 뽑기 잘했네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.259,
                "end": 19.740
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄, 소르베 노리러 갑니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.750,
                "end": 22.936
            },
            {
                "speaker_id": "2",
                "transcription": "믿고 있었습니다.",
