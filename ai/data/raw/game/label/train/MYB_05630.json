        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 클로티드 덱도 이기긴 이기는데 좀 상대가 좀 잘 죽어야 이기는 느낌이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.074
            },
            {
                "speaker_id": "1",
                "transcription": "이 분은 약간 스펙 차이가 좀 있어서 좀 빨리 녹은 거 같아요.",
                "sound_type": [
                    2
                ],
                "start": 5.084,
                "end": 8.545
            },
            {
                "speaker_id": "1",
                "transcription": "지금 아까 클로티드 덱만 좀 많이 만다고 짓거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.555,
                "end": 11.792
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 덱한테 엄청 약한지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.802,
                "end": 13.701
            },
            {
                "speaker_id": "1",
                "transcription": "좋다 자 클로티드 덱 또 만났고 근데 클로티드 덱은 확실히 저 휘낭시에를 무력화하는 게 특화 돼 있기 때문에 저것만 아니면 되게 좋을 거 같거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.711,
                "end": 29.536
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 앞 라인도 샤벳이 좀 잘 때려서 잘 이렇게 녹여 주면은 어 이렇게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.546,
                "end": 40.000
            }
        ]
    },
    "summary": "클로티드 덱은 휘낭시에를 무력화하는 데 특화 됐기 때문에 상대가 잘 죽어 주고 앞 라인의 샤벳이 잘 때려서 녹여 주면 이기는 느낌이다.",
