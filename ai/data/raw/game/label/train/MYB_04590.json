        "term": [
            {
                "speaker_id": "1",
                "transcription": "업데이트에 가장 큰 간접 상향 쿠키 코코아맛 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.240
            },
            {
                "speaker_id": "1",
                "transcription": "아직도 랭커분들 아직도 쓰고 있습니다. 코코아덱은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.260,
                "end": 7.249
            },
            {
                "speaker_id": "1",
                "transcription": "코코아덱 자체는 휘낭시에랑 같이 써가지고 찰스덱한테 들어갈 때 아직도 잘 쓰고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.259,
                "end": 13.937
            },
            {
                "speaker_id": "1",
                "transcription": "코코아처럼 자기 자신의 능력 자체 중에 하나가 특수하게 좋게 쓰이는 방향으로 상향될 수 있는 쿠키들이 있는 반면에 진짜 답이 없는 쿠키들의 예시를 보면은 예를 들어 무화과맛 쿠키 같은 애들은 개는 어떠한 적이 나오든 간에 떡상이 안되는 답없는 쿠키들이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.947,
                "end": 32.604
            },
            {
                "speaker_id": "1",
                "transcription": "아 말하니까 딱 나오는 것 봐. 이거 실화냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.614,
                "end": 35.140
            },
            {
                "speaker_id": "1",
                "transcription": "그래 너. 네가 그렇게 답이 없다고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.152,
                "end": 39.280
            },
            {
                "speaker_id": "1",
                "transcription": "아 대리 뽑기 주인님이 다크카카오 뽑기를 원한다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.280,
                "end": 42.928
            },
            {
                "speaker_id": "1",
                "transcription": "아 알겠습니다. 핸드폰 배경 사진도 다크카카오로 되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.938,
                "end": 46.540
            },
            {
                "speaker_id": "1",
                "transcription": "오케이. 되게 아 다크카카오 세 조각. 오 다크 두 조각.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.563,
                "end": 56.460
            },
            {
                "speaker_id": "1",
                "transcription": "오.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.440,
                "end": 58.633
            }
        ]
    },
    "summary": "코코아맛 쿠키는 아직도 랭커분들이 잘 쓰고 있다.",
