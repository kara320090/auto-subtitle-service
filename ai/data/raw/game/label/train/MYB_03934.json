            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.155
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.165,
                "end": 6.456
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.466,
                "end": 10.336
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 뭐 소르베가 있건 없건 전부 다 쓰고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.346,
                "end": 15.298
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이거 영상 보면서 아니 그러면 소르베 나락 갔나요 서리 나락 갔나요 이 질문이 꼭 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.308,
                "end": 22.047
            },
            {
                "speaker_id": "1",
                "transcription": "절대 소르베랑 서리가 나락 간 게 아니고 공격으로 쓰기에는 상대방이 서리가 있던 소르베가 있던 간에 모든 덱에 맞서서 이 덱이 되게 좋게 쓰이고 있기 때문에 여러분들한테 그냥 추천드리는 거고 나는 지금 소르베가 없다는 분들도 그냥 무난하게 요렇게 써도 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.057,
                "end": 41.643
            },
            {
                "speaker_id": "1",
                "transcription": "소르베가 있으면 좋은 가요라고 질문하는 분도 있는데 소르베 있으면은 공격 덱으로 쓰기 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.653,
                "end": 48.386
            },
            {
                "speaker_id": "1",
                "transcription": "서리랑 같이 그러기 때문에 뭐 티어가 나락 간 건 전혀 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.396,
                "end": 52.578
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 방덱으로도 쓰기 무난하게 좋고 공덱으로도 상대방이 서리나 소르베 덱한테 쓰기 무난하게 쓰기 좋은 덱이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.588,
                "end": 61.044
            },
            {
                "speaker_id": "1",
                "transcription": "무난하게 디자인 나오죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.054,
                "end": 62.818
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드는 스펙에 영향을 많이 받아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.828,
                "end": 65.691
            },
            {
                "speaker_id": "1",
                "transcription": "뭔 말이냐면 스펙이 높으면 높을수록 클로티드는 그만큼 더 좋게 활용이 되기 때문에 초보자분들이 이 영상을 보고 클로티드가 좋아 보이니까 바로 그냥 0순위로 키워야 되지 그거는 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.701,
                "end": 78.719
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드는 어느 정도 스펙이 되는 분들이 좀 키우면 좋고 만약에 클로티드를 나는 못 키 못 쓰겠다 하시는 분들은 캡틴캐비어를 쓰세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.729,
                "end": 90.743
            },
            {
                "speaker_id": "1",
                "transcription": "캡틴캐비어 덱도 상당히 좋기 때문에 쓰셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.753,
                "end": 94.838
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 무난하게 이긴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.848,
                "end": 100.072
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 약점이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.082,
                "end": 102.425
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 상대의 캡캐 덱 낫 들고 있는 캡캐 텍이나 이런 거에 녹아버리면은 집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.435,
                "end": 107.663
            },
            {
                "speaker_id": "1",
                "transcription": "모노클이기 때문에 캡캐 덱한테 크리터져서 녹으면은 무조건 져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 107.673,
                "end": 113.166
            },
            {
                "speaker_id": "1",
                "transcription": "무적 덱은 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.176,
                "end": 115.058
            },
            {
                "speaker_id": "1",
                "transcription": "상대방이 낫 들고 있는 캡틴캐비어 덱이나 이런 거 보면은 가급적이면 잘 피해서 가는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 115.068,
                "end": 121.772
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱 같은 경우에는 왜 쓰이냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 121.782,
                "end": 124.129
            },
            {
                "speaker_id": "1",
                "transcription": "모노클 가지고 대방의 서리나 소르베 쿠키의 디버프를 지우는 역할 어 좀 더 안정적으로 이기는 역할",
                "sound_type": [
                    2,
                    3
                ],
                "start": 124.139,
                "end": 132.839
            },
            {
                "speaker_id": "1",
                "transcription": "자색고구마가 참 얘는 죽지도 않고 정말 잘 쓰이고 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 132.849,
                "end": 138.000
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방분이랑 미러전이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 138.010,
                "end": 140.068
            },
            {
                "speaker_id": "1",
                "transcription": "지금 저렇게 세팅한 이유가 정말 미러전에서 유용하게 많이 쓰이고 있기 때문에 미러전 뿐만 아니라방덱으로 유용하게 쓰이기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 140.078,
                "end": 160.727
            },
            {
                "speaker_id": "1",
                "transcription": "자 뭐 미러전 같은 경우에는 뭐 확실히 좀 스펙으로 이기는 경우가 크겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 160.737,
                "end": 168.207
            },
            {
                "speaker_id": "1",
                "transcription": "아마 세팅도 비쌀 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 168.217,
                "end": 172.219
            },
            {
                "speaker_id": "1",
                "transcription": "리듬 비슷하게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 172.229,
                "end": 176.083
            }
        ]
    },
