            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 나 너무 아깝다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.437
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임 10퍼센트는 의미가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.447,
                "end": 4.188
            },
            {
                "speaker_id": "1",
                "transcription": "이미 맥스를 채웠기 때문에 이거 약간 락 걸어놓는 시스템 있으면 좋을 텐데 제발 한 번만 보여주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.198,
                "end": 11.108
            },
            {
                "speaker_id": "1",
                "transcription": "레전드 찍고 싶습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.118,
                "end": 12.303
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 운영자분들 진짜 잠금 시스템 나오면 안 될까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.313,
                "end": 18.187
            },
            {
                "speaker_id": "1",
                "transcription": "아 야 방금 야 뭐였어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.197,
                "end": 20.347
            },
            {
                "speaker_id": "1",
                "transcription": "방금 뭔가 어 다행이다 쿨타임이었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.357,
                "end": 22.573
            },
            {
                "speaker_id": "1",
                "transcription": "어 나 저거 만약에 종결이었으면 진짜 멘털 터졌을 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.583,
                "end": 25.602
            },
            {
                "speaker_id": "1",
                "transcription": "어 방금 진짜 저렇게 넘겼는데 종결이었다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.612,
                "end": 29.619
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 진짜 게임 하기 싫어질 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.629,
                "end": 32.189
            },
            {
                "speaker_id": "1",
                "transcription": "어우 다행이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.199,
                "end": 33.598
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 한 번 해보자 얘는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.608,
                "end": 35.230
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 20억 나오려나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.240,
                "end": 36.738
            },
            {
                "speaker_id": "2",
                "transcription": "버섯 먹어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.748,
                "end": 37.414
            },
            {
                "speaker_id": "3",
                "transcription": "맛을 보여주지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.424,
                "end": 38.440
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 아마 딜은 잘 나올 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.450,
                "end": 40.716
            },
            {
                "speaker_id": "1",
                "transcription": "와 딜 올라가는 것 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.726,
                "end": 42.780
            },
            {
                "speaker_id": "1",
                "transcription": "얘 20억 각이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.790,
                "end": 44.716
            },
            {
                "speaker_id": "1",
                "transcription": "15 16 17 18 19 20 21 22 23 야 22억 주스 11억 2000 종결 아닌데도 이렇게 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.726,
                "end": 57.646
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야 왜 이게 기갱이야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.656,
                "end": 59.920
            },
            {
                "speaker_id": "1",
                "transcription": "와 일단 이거 해보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.930,
                "end": 65.682
            },
            {
                "speaker_id": "2",
                "transcription": "버섯 먹어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.692,
                "end": 69.339
            },
            {
                "speaker_id": "3",
                "transcription": "매운 맛을 보여주지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.349,
                "end": 70.766
            }
        ]
    },
    "summary": "화자가 레전드로 높은 딜을 기록하고 싶어 하고 있다.",
