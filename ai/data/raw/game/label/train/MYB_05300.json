    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "기회가 주어집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.135
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 얘를 퇴치하는 순간 마지막 보물 상자가 열린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.145,
                "end": 6.236
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 보면 될 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.246,
                "end": 7.946
            },
            {
                "speaker_id": "1",
                "transcription": "자 포인트는 항해 중 마주치는 기믹들을 잘 살펴보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.956,
                "end": 11.975
            },
            {
                "speaker_id": "1",
                "transcription": "블랙 코인, 코인, 별사탕, 사일런트 호 내구도 회복 등을 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.985,
                "end": 16.033
            },
            {
                "speaker_id": "1",
                "transcription": "자 미니 게임 번개 피하기가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.043,
                "end": 18.651
            },
            {
                "speaker_id": "1",
                "transcription": "번개 피하기 게임은 블랙펄 제도에서 만날 수 있는 신규 컨텐츠고 번개를 피해서 배 갑판 위에 생성되는 블랙 코인을 획득할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.661,
                "end": 25.751
            },
            {
                "speaker_id": "1",
                "transcription": "공략을 통해 경험치를 획득할 수 있고 원하는 쿠키를 선택해서 찌릿찌릿 무서운 번개를 피해 보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.761,
                "end": 31.264
            },
            {
                "speaker_id": "1",
                "transcription": "제한 시간 동안 쿠키의 체력이 이렇게 일정하게 계속 감소하고 번개를 맞으면 세력 게이지가 감소 크게 아마 감소가 되는 거고 요거 먹으면 체력이 이렇게 회복이 되고 대쉬 버튼을 눌러 쿠키가 순간적으로 잽싸게 이동할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.274,
                "end": 43.622
            },
            {
                "speaker_id": "1",
                "transcription": "대쉬 버튼 사용 후 일정 시간 지나면 다시 사용할 수 있고 제한 시간 동안 쿠키의 체력이 모두 닳지 않으면 성공 어 되게 새로운 그런 컨텐츠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.632,
                "end": 52.743
            },
            {
                "speaker_id": "1",
                "transcription": "자 미니 게임 런 게임 옛날에 소닉 이벤트에서 해 보신 분들은 알죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.753,
                "end": 57.334
            },
            {
                "speaker_id": "1",
                "transcription": "런 게임은 블랙펄 제도에서 만날 수 있는 신규 컨텐츠인데 만난 봤던 컨텐츠예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.344,
                "end": 61.346
            },
            {
                "speaker_id": "1",
                "transcription": "각종 장애물을 피하며 코인과 블랙 코인을 획득할 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.356,
                "end": 64.934
            },
            {
                "speaker_id": "1",
                "transcription": "원하는 쿠키를 자기가 선택할 수 있는 건 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.944,
                "end": 66.999
            },
            {
                "speaker_id": "1",
                "transcription": "각종 장애물을 피하고 골인 지점까지 통과해 보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.009,
                "end": 69.930
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 랭킹 점수 같은 경우에는 시즌 동안 블랙펄 제도를 탐험한 결과는 랭킹에 반영되며 시즌 종료 시점의 랭킹에 따른 보상이 지급된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.940,
                "end": 79.677
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 랭킹은 각 항해로 획득한 블랙 점수가 시즌 동안 누적 합산되어 반영됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.687,
                "end": 84.995
            },
            {
                "speaker_id": "1",
                "transcription": "누적 합산된다는 말 때문에 고기 젤리 많은 사람들은 항해를 많이 할 수 있기 때문에 이게 유리하지 않을까 아무튼 그 생각이 들었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.005,
                "end": 91.433
            },
            {
                "speaker_id": "1",
                "transcription": "일부러 블랙 코인 아껴 가지고 깰 필요 없이 그냥 획득한 게 반영된다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.443,
                "end": 96.745
            },
            {
                "speaker_id": "1",
                "transcription": "항해를 완주 시 보너스 점수가 추가로 반영됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.755,
                "end": 100.270
            },
            {
                "speaker_id": "1",
                "transcription": "보스까지 클리어하는 그런 상태를 말하는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.280,
                "end": 102.962
            },
            {
                "speaker_id": "1",
                "transcription": "항해는 최종 보스를 처치하고 최종 보물 상자를 개봉 시 완주가 인정된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.972,
                "end": 107.768
            },
            {
                "speaker_id": "1",
                "transcription": "자 항해 완주 시점에 남은 사일런트 호의 내구도 남은 블랙 코인 재단 버프의 개수가 보너스는 점수로 환산됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 107.778,
                "end": 115.566
            }
        ]
    },
    "summary": "화자가 블랙펄 제도에서 포인트와 랭킹 점수에 대한 내용을 설명하고 있다.",
