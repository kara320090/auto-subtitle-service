        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 이번에 이벤트 정말 중요하게 됐어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.780
            },
            {
                "speaker_id": "1",
                "transcription": "저거 이벤트를 하면 장점이 뭐냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.780,
                "end": 5.984
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 최종 보상도 중요하겠지만 토핑 조각 얻는데 엄청나게 좋은 이벤트이기 때문에.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.988,
                "end": 12.316
            },
            {
                "speaker_id": "1",
                "transcription": "싫어도 재고 생산 열심히 해서 토핑 조각 많이 얻는 그런 이벤트가 되길 바라고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.326,
                "end": 17.528
            },
            {
                "speaker_id": "1",
                "transcription": "중요한 점은 이거 5만 점 빨리 채워서 생산 건물 2개를 돌려라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.524,
                "end": 22.536
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 돌릴 때 이 재료 같은 경우에는 일일 미션을 해서 하면 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.536,
                "end": 27.088
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 알면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.101,
                "end": 28.592
            },
            {
                "speaker_id": "1",
                "transcription": "보상이 상당하기 때문에 놓치면 안 되는 이벤트 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.596,
                "end": 34.966
            }
        ]
    },
