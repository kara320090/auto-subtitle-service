        "term": [
            {
                "speaker_id": "1",
                "transcription": "정말 나약해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.959
            },
            {
                "speaker_id": "1",
                "transcription": "벌써 죽어서 부활 썼죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.969,
                "end": 2.700
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 야 감초야 힘내봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.710,
                "end": 10.291
            },
            {
                "speaker_id": "1",
                "transcription": "야 죽었죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.301,
                "end": 11.502
            },
            {
                "speaker_id": "1",
                "transcription": "자 어떻게 되든 간에 순삭 돼 버립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.512,
                "end": 14.908
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 딜은?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.918,
                "end": 15.951
            },
            {
                "speaker_id": "1",
                "transcription": "자 감초맛 쿠키의 딜을 기억해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.961,
                "end": 19.154
            },
            {
                "speaker_id": "1",
                "transcription": "64만 9천 거의 뭐 일반 휘낭시에 탱커보다도 딜이 안 나오는 요런 상태다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.164,
                "end": 26.670
            },
            {
                "speaker_id": "1",
                "transcription": "저는 느꼈던 거는 딜이 정말 안 나오고 쓰레기일수록 마탕 출시되면은 엄청나게 핵딜이 되어서 돌아올 수 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.680,
                "end": 33.458
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요거 한번 기억해두자 고렇게 한번 보면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.468,
                "end": 39.706
            }
        ]
    },
