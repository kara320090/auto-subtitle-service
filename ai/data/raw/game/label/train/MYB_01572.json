        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 대단투 이제 6일밖에 남지 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.666
            },
            {
                "speaker_id": "1",
                "transcription": "시즌 보상으로 용과 드래곤, 크리스탈, 뮤직 큐브 그 다음에 메달도 주기 때문에 반드시 여러분들이 놓치지 말고 챙겨가시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.676,
                "end": 11.506
            },
            {
                "speaker_id": "1",
                "transcription": "자 뿐만 아니라 여러분들이 티어 보상으로 다양한 보상도 챙길 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.516,
                "end": 16.075
            },
            {
                "speaker_id": "1",
                "transcription": "그랜드마스터 1 달성 보상까지는 아니더라도 시즌 한정 아레나 동상 스킨을 받을 수 있으니까 최대한 마스터까지는 여러분들 달성하는 게 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.085,
                "end": 26.495
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 대난투 승리 공식 이거 진짜 100퍼센트 승리 공식이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.505,
                "end": 31.063
            },
            {
                "speaker_id": "1",
                "transcription": "조합만 잘 따라 하셔도 이길 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.073,
                "end": 33.422
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 조합 총 4가지를 세팅하는 방법을 알려드릴 건데 자 나머지 한 가지 조합은 찰스랑 실론나이트만 바꾸면 되는 거기 때문에 3가지 조합에다가 실론나이트만 바꾸면 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.432,
                "end": 45.316
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 세팅을 먼저 말씀드리면은 일단 한방덱 세팅, 정석덱 세팅, 공속덱 세팅, 실론나이트 세팅까지 해서 총 4가지이고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.326,
                "end": 54.858
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱 세팅을 말씀드리면은 무공비1 그 다음에 증표, 깃털 도넛은 4라즈에 1쿨 부옵션은 어차피 적용이 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.868,
                "end": 63.536
            },
            {
                "speaker_id": "1",
                "transcription": "12강짜리 적용을 해주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.546,
                "end": 65.789
            },
            {
                "speaker_id": "1",
                "transcription": "찰스는 올라즈 캡캐 올 라즈 오먹 올 라즈 블랙펄 올 라즈 자 그리고 정석덱은 무공비 호루라기 시계 자 홀리베리 올 아몬드 용과 올 라즈 자 스타더스트 올 애플젤리 퓨어바닐라 올 아몬드",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.799,
                "end": 82.166
            },
            {
                "speaker_id": "1",
                "transcription": "스냅드래곤 올 쿨 자 그 다음에 공속덱은 레어 무공비고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.176,
                "end": 85.832
            },
            {
                "speaker_id": "1",
                "transcription": "공속봉을 그 다음에 증표 봉우리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.842,
                "end": 88.080
            },
            {
                "speaker_id": "1",
                "transcription": "스펙은 올 라즈 아몬드 아몬드 올 라즈 BTS 쿠키는 올 친항입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.090,
                "end": 94.974
            },
            {
                "speaker_id": "1",
                "transcription": "이게 조금 특이하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.984,
                "end": 96.361
            },
            {
                "speaker_id": "1",
                "transcription": "자 실론나이트 쓰는 경우에는 올 아몬드 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.371,
                "end": 101.000
            }
        ]
    },
