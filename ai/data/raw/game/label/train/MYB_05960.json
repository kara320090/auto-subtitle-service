        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 그런데 내가 아까 아레나 방어 덱 봤는데 승급 초월 안 한 사람이랑 차이가 많이 나더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.016
            },
            {
                "speaker_id": "1",
                "transcription": "아 마들렌 쟤 왜 저래 왜 이렇게 자주 나오죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.026,
                "end": 12.506
            },
            {
                "speaker_id": "1",
                "transcription": "오 아 잠깐만 아 쭈글이 님 이거 저 서리만 뽑는 손인가 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.516,
                "end": 19.259
            },
            {
                "speaker_id": "1",
                "transcription": "저렇게 유독 어 와베 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.269,
                "end": 21.456
            },
            {
                "speaker_id": "1",
                "transcription": "저렇게 유독 서리만 뽑기가 힘든데 아 그렇게 또 따지니까 패치 전에 아레나 되게 열심히 했었거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.466,
                "end": 28.597
            },
            {
                "speaker_id": "1",
                "transcription": "막 1등 유지 몇 번 계속하고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.607,
                "end": 31.397
            },
            {
                "speaker_id": "1",
                "transcription": "다 의미 없는 부질없는 짓이었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.407,
                "end": 34.303
            },
            {
                "speaker_id": "1",
                "transcription": "티켓 그거 아껴 가지고 나중에 쓸걸.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.313,
                "end": 37.966
            }
        ]
    },
    "summary": "와베가 나오자 패치 전에는 아레나에서 1등을 유지하고 되게 열심히 했었지만 다 의미 없고 부질없는 짓이라며 티켓 아껴서 나중에 썼어야 한다고 한다.",
