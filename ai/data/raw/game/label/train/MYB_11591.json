                    5
                ],
                "start": 0.000,
                "end": 1.216
            },
            {
                "speaker_id": "1",
                "transcription": "우와. 머리 쓰는 거 봐봐. 그냥 한낱 미물인 줄 알았더니.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.226,
                "end": 5.682
            },
            {
                "speaker_id": "1",
                "transcription": "머리도 쓸 줄 아네? 그쵸? 트수같애 그죠? 아무것도 모르는 줄 알았더니 머리 쓰는 거 보소.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.692,
                "end": 14.250
            },
            {
                "speaker_id": "1",
                "transcription": "방종한다고 하니까 현실을 부정하는 모습이었다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.260,
                "end": 19.291
            },
            {
                "speaker_id": "1",
                "transcription": "나 방종 못하게 할라고. 다른 트수들한테 알리러 간다. 기메가 방종한대요 이러면서.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.301,
                "end": 27.386
            },
            {
                "speaker_id": "1",
                "transcription": "박치기 지린다. 머리도 쓸 줄 안다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.396,
                "end": 32.366
            }
        ]
    },
    "summary": "한낱 미물인 줄 알았더니 머리도 쓸 줄 알고 방송 못하게 하려고 다른 트수들한테 알리러 간다.",
