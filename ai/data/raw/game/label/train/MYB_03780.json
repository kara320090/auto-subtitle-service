        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이렇게 퍼펙으로 이기네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.353
            },
            {
                "speaker_id": "1",
                "transcription": "5마리 쿠키 전부 다 생존한 상태에서 승리를 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.363,
                "end": 8.939
            },
            {
                "speaker_id": "1",
                "transcription": "보시는 거와 같이 소르베 5초월 블랙펄하고 딜이 차이가 그래도 좀 있긴 하지만 높죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.949,
                "end": 15.320
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳 덱이 솔직히 잡기 좀 어려운데 소르베가 공속 느리게 해 가지고 샤벳 쿨을 약간 꼬여버리게 만들거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.313,
                "end": 23.920
            },
            {
                "speaker_id": "1",
                "transcription": "그 효과가 정말 큰 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.926,
                "end": 25.953
            },
            {
                "speaker_id": "1",
                "transcription": "가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.966,
                "end": 27.860
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 덱은 미러전이네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.860,
                "end": 30.320
            },
            {
                "speaker_id": "1",
                "transcription": "네 확실히 덱이 좋다 보니까 미러전으로 네 미러전을 가면은 아무래도 스펙 싸움이 되겠죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.330,
                "end": 38.520
            },
            {
                "speaker_id": "1",
                "transcription": "딜이 더 높냐 누가 어떻게 먼저 죽냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.513,
                "end": 44.041
            }
        ]
    },
