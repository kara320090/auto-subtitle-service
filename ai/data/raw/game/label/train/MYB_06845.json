        "term": [
            {
                "speaker_id": "1",
                "transcription": "아까 전에는 익충이랑 싸웠지 이제는 내 머리랑 싸워야 되는데 야단났군 근데 왜 손이 하나밖에 없어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.076
            },
            {
                "speaker_id": "1",
                "transcription": "손 두 짝이면 움직일 수 있을 것 같긴 한데 어 뭐야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.086,
                "end": 19.421
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.431,
                "end": 21.378
            },
            {
                "speaker_id": "1",
                "transcription": "꼴지야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.388,
                "end": 23.814
            },
            {
                "speaker_id": "1",
                "transcription": "다행이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.824,
                "end": 25.150
            },
            {
                "speaker_id": "1",
                "transcription": "더 멍청한 사람이 있었군.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.160,
                "end": 28.134
            },
            {
                "speaker_id": "2",
                "transcription": "이 앞은 감염 지역이야 조심하도록 해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.144,
                "end": 31.031
            },
            {
                "speaker_id": "2",
                "transcription": "때론 말이야 Z키를 누르는 상상만으로는 부족할 때도 있을 거야.",
                "sound_type": [
                    2,
                    3
