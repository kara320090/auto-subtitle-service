        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "넓어진 것 같습니다. 대난투에 넣어도 돌아가니까 뭐 어떻게든 쓰일 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.022
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 해서 서리여왕 5초월 리뷰를 해 봤는데 결론만 따지면 좋냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.032,
                "end": 11.333
            },
            {
                "speaker_id": "1",
                "transcription": "좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.343,
                "end": 12.079
            },
            {
                "speaker_id": "1",
                "transcription": "이미 키워놓은 사람은 소르베 쿠키랑 같이 아레나 세팅하면 상당히 좋은 효과를 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.089,
                "end": 18.516
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 승급이 낮은 분들도 키울 만한 가치가 생겼고 확실히 이 디버프로 인해서 딜도 좋고 확실히 시너지가 좋게끔 이번에 업데이트가 됐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.526,
                "end": 28.866
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 공격 속도도 낮춰주면서 피해량도 증가되니까 이전에 보였던 그런 약한 이미지가 완전히 없어지지 않았나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.876,
                "end": 36.815
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.825,
                "end": 38.874
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 5초월 리뷰 서리여왕은 마무리 끝입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.884,
                "end": 50.666
            }
        ]
    },
