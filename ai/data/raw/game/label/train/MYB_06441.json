        "term": [
            {
                "speaker_id": "1",
                "transcription": "애가 또 뛴다. 내 냄새를 맡았나?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.209
            },
            {
                "speaker_id": "1",
                "transcription": "아 개가 구정물 속을 잘도 다니네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.219,
                "end": 10.448
            },
            {
                "speaker_id": "1",
                "transcription": "개가 겁나 빠르네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.458,
                "end": 21.852
            },
            {
                "speaker_id": "1",
                "transcription": "개를 어떻게 할 수 있을까? 강아지를.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.862,
                "end": 29.762
            },
            {
                "speaker_id": "1",
                "transcription": "이미 개는 출발했다고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.772,
                "end": 45.746
            },
            {
                "speaker_id": "1",
                "transcription": "못 들어오나 물에?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.756,
                "end": 50.637
            },
            {
                "speaker_id": "1",
                "transcription": "물에서도 잡아먹히네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.647,
                "end": 52.654
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 시간이 엄청 촉박하다는 소리 아니에요? 개뛰라는 말인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.664,
                "end": 59.933
            },
            {
                "speaker_id": "1",
                "transcription": "다른 걸 써 먹을 그게 없어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.943,
                "end": 64.509
            },
            {
                "speaker_id": "1",
                "transcription": "아유 씨 개새끼를 어떻게 하지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.519,
                "end": 73.299
            },
            {
                "speaker_id": "1",
                "transcription": "불쌍하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.309,
                "end": 77.700
            },
            {
                "speaker_id": "1",
                "transcription": "아 알았어. 나 알아버렸다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.710,
                "end": 88.149
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.159,
                "end": 91.373
            },
            {
                "speaker_id": "1",
                "transcription": "이리 온 뽀삐. 뽀삐야. 여기 있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.383,
                "end": 97.576
            },
            {
                "speaker_id": "1",
                "transcription": "간식 먹을까 간식?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.586,
                "end": 99.656
            },
            {
                "speaker_id": "1",
                "transcription": "산책 갈까?",
