        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 제발 죽어 용쿠야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.513
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.523,
                "end": 3.077
            },
            {
                "speaker_id": "1",
                "transcription": "어 세팀 용쿠가 그냥 피감 없이 하는 게 제일 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.087,
                "end": 7.978
            },
            {
                "speaker_id": "1",
                "transcription": "자일단 요렇게 용구덱 새롭게 나왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.988,
                "end": 14.368
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들한테 소개드리려고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.378,
                "end": 16.252
            },
            {
                "speaker_id": "1",
                "transcription": "자 중요한 포인트 다시 짚어보면은 용쿠는 피감 없이 구미호도 얘도 피감 그냥 최대한 낮게 하는 것도 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.262,
                "end": 23.215
            },
            {
                "speaker_id": "1",
                "transcription": "20 퍼센트도 사치야 얘네 둘이 포슨 역할을 하고 얘네 둘도 어느 정도 죽고 나서 어차피 흑당이 마지막 최종적으로 남아서 그냥 역전 노리는 게 제일 좋은 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.225,
                "end": 34.273
            },
            {
                "speaker_id": "1",
                "transcription": "자 용구덱 여러분들 세팅해서 난이도가 진짜 역대급으로 쉬운 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.283,
                "end": 38.333
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 난이도는 공속만 구미호랑 흑당 잘 맞춰주면 된다.",
                "sound_type": [
                    2
                ],
                "start": 38.343,
                "end": 42.706
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 세팅을 해주시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.716,
                "end": 45.366
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 구미호 용구덱 리뷰는 마치도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.376,
                "end": 64.477
            }
        ]
    },
    "summary": "용구덱은 피감 없이 하는 게 제일 좋고 난이도도 역대급으로 쉽고 구미호랑 흑당이랑 세팅만 잘 맞춰주면 된다.",
