                ],
                "start": 4.716,
                "end": 5.850
            },
            {
                "speaker_id": "1",
                "transcription": "미친다 진짜. 이거를 내가 와 이거는 플스가 있는데 이걸 안 한다?",
                "sound_type": [
                    2,
