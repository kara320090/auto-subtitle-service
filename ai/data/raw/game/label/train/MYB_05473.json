        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 비밀스러운 교단의 신성한 은포크 자 요거 뽑아서 리뷰를 해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.835
            },
            {
                "speaker_id": "1",
                "transcription": "이미 이게 길드 토벌에서 쓰인다고 하니까 되게 중요한 보물 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.845,
                "end": 11.736
            },
            {
                "speaker_id": "1",
                "transcription": "자 얘 같은 경우에는 길드 뽑기에서만 나오기 때문에 한번 가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.746,
                "end": 17.501
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 29만 3000개 다 뽑아 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.511,
                "end": 20.174
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 설마 안 나오진 않겠지 그치.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.184,
                "end": 22.448
            },
            {
                "speaker_id": "1",
                "transcription": "2개 스타트 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.458,
                "end": 24.257
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 길드 재화 모으는 게 정말 중요해 졌어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.267,
                "end": 27.705
            },
            {
                "speaker_id": "1",
                "transcription": "여태까지는 별로 상위 길드에 관심 없다 해도 이제는 좀 관심을 가지고 좀 하셔야 될 때입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.715,
                "end": 34.970
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 길드를 통해서 많이 성장할 수 있는 기회가 패치가 됐기 때문에 반드시 좀 해 주셔야 되고 자 쫙 쫙",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.980,
                "end": 44.233
            }
        ]
    },
    "summary": "새롭게 나온 비밀스러운 교단의 신성한 은포크가 길드 토벌에서 쓰여서 중요한 보물이고 화자는 크리스탈 29만 3000개로 비밀스러운 교단의 신성한 은포크를 뽑아서 리뷰를 할 예정이고 스펙이 길드를 통해서 성장할 수 있는 기회가 패치 됐기 때문에 길드 재화 모으는 게 중요해 졌다고 한다.",
