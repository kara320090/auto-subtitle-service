        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "방덱같은 경우에 저는 이렇게 세팅을 했는데 요새 자구마 굳이 안 써도 와베 쓰는 덱도 많거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.615
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 휘낭시에, 와베, 에스프레소, 클로티드 없으신 분들은 이 자리에 에클레어 쓰거나 아니면 에스프레소 자리에다가 샤벳상어나 다른 딜러 넣 가지고 쓰는 분도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.625,
                "end": 17.326
            },
            {
                "speaker_id": "1",
                "transcription": "흑당 넣어서 공속덱으로 바꾸든지 제가 기본적으로 추천해 드릴 덱은 기본 제 방어 승률 좋은 거 기준으로 요렇게 세팅이고 여러분들이 이제 없는 쿠키 대체할 때는 유동적으로 바꿔서 쓰시면 되고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.336,
                "end": 28.653
            },
            {
                "speaker_id": "1",
                "transcription": "보물은 모노클 써서 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.663,
                "end": 30.794
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 같은 경우에는 올 아몬드 피감은 제가 조금 일부러 더 낮췄는데 그래도 승률이 좋거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.804,
                "end": 36.379
            },
            {
                "speaker_id": "1",
                "transcription": "이거 좀 낮아도 상관없지만 쿨타임 2.8퍼센트 이상 이게 중요합니다. 2.8 이상",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.389,
                "end": 41.125
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에 같은 경우에는 올 아몬드에서 피감 낮아도 쿨 8퍼센트 이상 이렇게 해줬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.135,
                "end": 46.793
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 클로티드도 피감 이렇게 조금 낮아도 쿨 8퍼센트 이상 에스프레소 같은 경우에는 피감만 여러분들이 세팅했을 때 가장 높게 세팅해 주시면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.803,
                "end": 55.756
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 크림 유니콘도 아 올 아몬드에서 쿨 8퍼센트 이상 아마 쿨이 많이 들어가서 조금 힘들 수도 있지만 그래도 어느 정도 피감이 그렇게 높게 세팅 안 해도 돌아간다는 점",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.766,
                "end": 66.813
            },
            {
                "speaker_id": "1",
                "transcription": "요걸로 한번 해보시면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.823,
                "end": 68.831
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.841,
                "end": 72.905
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.915,
                "end": 76.201
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.211,
                "end": 80.833
            }
        ]
    },
    "summary": "덱은 방어 승률이 좋은 기준으로 보물 모노클을 써서 세팅하면 되고 토핑은 피해감소가 낮아도 상관은 없지만 쿨타임을 2.8퍼센 이상으로 세팅하는 게 중요하다.",
