        "term": [
            {
                "speaker_id": "1",
                "transcription": "이것도 자 터트리고 그리고 자 상대방도 엄청나게 피감 높은 분입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.801
            },
            {
                "speaker_id": "1",
                "transcription": "피감도 높고 토핑도 좋고 심지어 추월도 높은 분이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.811,
                "end": 12.323
            },
            {
                "speaker_id": "1",
                "transcription": "근데도 불구하고 이렇게 이기네 야 이건 뭐 다시 부활했다가 보시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.333,
                "end": 20.691
            },
            {
                "speaker_id": "1",
                "transcription": "아직 그리고 증표도 안 빠졌어 증표도 안 빠졌어요 참고로.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.701,
                "end": 24.691
            },
            {
                "speaker_id": "1",
                "transcription": "증표도 안 빠졌다는 건 이제 최후의 이제 무적 상태도 아직 안간 상태로 이렇게 이깁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.701,
                "end": 30.797
            },
            {
                "speaker_id": "1",
                "transcription": "자 소원덱한테 먹힌지 보겠습니다.",
