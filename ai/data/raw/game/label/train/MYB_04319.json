        "term": [
            {
                "speaker_id": "1",
                "transcription": "맵 뚫을 거 생각하니까 까마득하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.752
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 여러분들 충격적인 거 한번 보고 갈까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.762,
                "end": 7.132
            },
            {
                "speaker_id": "1",
                "transcription": "아 야 여기 어느 세월에 다 뚫어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.142,
                "end": 10.539
            },
            {
                "speaker_id": "1",
                "transcription": "와 옛날 초창기 때 그 생각했지 이거 진짜 언제 다 뚫나 참고로 이거 1년 넘게 걸립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.549,
                "end": 16.843
            },
            {
                "speaker_id": "1",
                "transcription": "암만 빨리 해도 1년이야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.853,
                "end": 17.887
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 핵 과금에 돈을 많이 써도 1년 걸릴 겁니다.",
