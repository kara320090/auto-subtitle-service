        "term": [
            {
                "speaker_id": "1",
                "transcription": "연애 경험이 많은 아스타 오토를 노리고 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.540
            },
            {
                "speaker_id": "1",
                "transcription": "오토 위험해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.550,
                "end": 8.083
            },
            {
                "speaker_id": "1",
                "transcription": "음 로자리아 동경 피닉스 탤론스로 이어지는 물결 강자들의 영혼을 실어 나르네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.093,
                "end": 14.217
            },
            {
                "speaker_id": "1",
                "transcription": "불의 민족이여 동포여 죽어서도 불사조의 불꽃을 찬양하라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.227,
                "end": 18.424
            },
            {
                "speaker_id": "1",
                "transcription": "하면 로자리아에 행복 있으니 기도하라",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.434,
                "end": 21.448
            },
            {
                "speaker_id": "1",
                "transcription": "노래하라 젖먹이의 가슴에 새로운 불꽃이 깃들기를 그리하면 로자리아에 행복 있으리.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.458,
                "end": 28.315
            },
            {
                "speaker_id": "1",
                "transcription": "다들 로자리아를 그리워하나 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.325,
                "end": 31.900
            }
        ]
    },
    "summary": "로자리아 동경을 읽으며 사람들이 로자리아를 그리워하고 있는 것을 알 수 있다.",
