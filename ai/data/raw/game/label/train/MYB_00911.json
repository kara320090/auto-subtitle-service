        "term": [
            {
                "speaker_id": "1",
                "transcription": "달빛수사 같은 경우에는 스타더스트랑 같이 많이 사용 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.596
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝클리터맛 쿠키는 승급이 낮으면은 솔직히 활용 가치가 많이 낮습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.606,
                "end": 10.328
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 최근에 올린 과전류덱 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.338,
                "end": 12.635
            },
            {
                "speaker_id": "1",
                "transcription": "이거 저도 세팅 가능하냐고 물어보시는 분들 자 이거는 승급에 상관없이 여러분들이 토핑이 좋아야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.645,
                "end": 19.520
            },
            {
                "speaker_id": "1",
                "transcription": "이게 피해 감소가 이렇게 높게 세팅이 좀 가능해야만 어느 정도 생존이 보장되고 그리고 호루라기를 받는 대상도 어 정확하게 맞춰줘야지 세팅이 가능하거라 어 초보자분들이나 복귀 유저분들 세팅 힘든 분들은 추천하지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.517,
                "end": 35.058
            },
            {
                "speaker_id": "1",
                "transcription": "샤이닝글리터 쿠키 키워야 되나요 하시는 분들 별사탕 별로 없고 스킬 파우더 별로 없는 분들은 용과 드래곤이나 블랙펄이나 스타더스트에 일단 먼저 집중해서 키우는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.068,
                "end": 44.957
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이 실론나이트도 정말 좋게 활용될 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.967,
                "end": 49.279
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 실론나이트 소르베덱 정말 유용하게 쓸 수 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.289,
                "end": 52.742
            },
            {
                "speaker_id": "1",
                "transcription": "마법사탕 우선 순위도 살짝만 언급해 드리면 일단 가장 중요한 건 오징어먹물입니다 얘 먼저 마법사탕",
                "sound_type": [
                    2,
                    3
                ],
