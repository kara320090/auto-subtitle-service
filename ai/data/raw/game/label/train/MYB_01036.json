        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 레모네이드랑 샤이닝글리터 조합 소개를 해드렸는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.524
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 이 조합들이 1탱 덱한테는 기본적으로 들어가지 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.534,
                "end": 8.619
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 변수가 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.629,
                "end": 11.079
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 저는 1탱 덱한테는 승률이 고정적으로 높게 나온다고는 말 못하겠고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.089,
                "end": 16.461
            },
            {
                "speaker_id": "1",
                "transcription": "2탱 덱한테는 아까 말한 상황에 따라 구별해서 들어갈 수 있다면 엄청나게 높은 승률로 여러분들 사용해서 이길 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.471,
                "end": 25.847
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 스낵 드래곤으로 들어가는 세팅은 상대방이 가운데 락스타가 있는 2탱커 조합 그리고 블랙펄이 들어가는 조합은 상대방이 가운데에 2개의 딜러가 있는 전투력이 높은 조합일 때 상대방이 그럴 때 들어가면은 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.857,
                "end": 40.050
            },
            {
                "speaker_id": "1",
                "transcription": "각각의 세팅은 다르니까 구별해서 여러분들 들어가시면 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.060,
                "end": 44.349
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝클리터 티어가 전보다는 많이 쓰이는 건 아니지만 아레나에서 요렇게 유용하게 아직도 많이 쓰이고 있으니까 활용해서 쓰실 분들 쓰시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.359,
                "end": 55.391
            },
            {
                "speaker_id": "1",
                "transcription": "네 혹시나 또 궁금한 점이 있다면 영상 댓글에 남겨 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.401,
                "end": 60.032
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.042,
                "end": 64.966
            }
        ]
    },
    "summary": "한 남성이 게임에서 레모네이드와 샤이닝클리터 조합을 소개했는데 우선 이 조합은 1탱 텍한테는 변수가 많아서 기본적으로 들어가지 않는다고 하고 2탱 덱한테는 상황에 따라 구별해서 들어갈 수 있다면 엄청나게 높은 승률로 이길 수 있다고 설명한다.",
