        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "혼자 딜이 천오백만 딜 뭐 세팅 같은 경우에는 저는 제 생각에는 뭐 사람마다 공략이든 다 다를 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.704
            },
            {
                "speaker_id": "1",
                "transcription": "다른 분들은 공속이 중요하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.714,
                "end": 9.927
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 분들은 쿨을 높게 세팅해서 하는 분도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.937,
                "end": 12.812
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 어떤 분들은 공치가 중요하다 하는 분도 있지만 제 생각에는 이 조합은 실론나이트 생존만 보장된다면 승률이 엄청나게 높아지기 때문에 피해 감소 치명타 피해 감소 요 2개만 여러분들 확실하게 챙겨주시는 게 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.822,
                "end": 26.788
            },
            {
                "speaker_id": "1",
                "transcription": "공속은 1줄은 좀 챙겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.798,
                "end": 28.506
            },
            {
                "speaker_id": "1",
                "transcription": "요거 1줄은 있고 없고 차이가 그래도 좀 미세하게 있으니까 자 실론나이트 또 이번에도 콘셉트은 확실합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.516,
                "end": 36.868
            },
            {
                "speaker_id": "1",
                "transcription": "네 30초까지 버텨라.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.878,
                "end": 39.862
            },
            {
                "speaker_id": "1",
                "transcription": "이게 하나의 단점이라고 한다면은 게임 시간이 조금 많이 걸리죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.872,
                "end": 44.594
            },
            {
                "speaker_id": "1",
                "transcription": "다른 조합에 비해서 콘셉트 자체가 1분이 지나고 30초도 지나고 게임 끝날 때까지 버티고 버텨서 역전하는 그림의 조합이다 보니까 네 여러분들이 게임 시간이 오래 걸린다는 단점이 있지만 또 약간 보는 맛도 있고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.604,
                "end": 58.905
            },
            {
                "speaker_id": "1",
                "transcription": "역전하는 묘미도 있으니까 재미는 있다.",
                "sound_type": [
                    2
                ],
                "start": 58.915,
                "end": 62.291
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 역전의 시작",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.301,
                "end": 67.733
            }
        ]
    },
    "summary": "세팅 같은 경우는 사람마다 공략이 다를 수 있지만 제 생각에는 실론나이트 생존만 보장된다면 승률이 엄청나게 높아지기 때문에 피해 감소 치명타 2개만 확실하게 챙겨주고 공속은 있고 없고의 미세한 차이가 있어서 1줄 챙겨주는데 실론나이트의 단점은 다른 조합에 비해서 게임 시간이 조금 많이 걸리지만 보는 맛도 있고 역전하는 묘미도 있어서 재미는 있다.",
