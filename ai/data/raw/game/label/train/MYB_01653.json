        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 마법 사탕 실론 나이트 리뷰 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.073
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 694갠가요 재료?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.083,
                "end": 7.411
            },
            {
                "speaker_id": "1",
                "transcription": "이거 다 하는데 진짜 죽는 줄 알았습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.421,
                "end": 9.906
            },
            {
                "speaker_id": "1",
                "transcription": "거의 각설탕이 거의 7000개 정도가 드나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.916,
                "end": 13.374
            },
            {
                "speaker_id": "1",
                "transcription": "와 이거 패키지 안 사고 그냥 생산해서 만드실 분들 진짜 죽어납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.384,
                "end": 19.504
            },
            {
                "speaker_id": "1",
                "transcription": "저도 오늘 이번에 패키지 안 사고 직접 제작해 봤거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.514,
                "end": 22.917
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 많이 걸리는지 몰랐어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.927,
                "end": 24.974
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 성공 쿠키 최대 체력 비례 고정 피해 3퍼센트 일반 공격 대상 추가 피해가 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.984,
                "end": 31.941
            },
            {
                "speaker_id": "1",
                "transcription": "일단 마탕 추가가 되면은 일단은 실론 나이트 쿠키 각성에서 아군 쿠키 쓰러지면 기사단장의 분노 버프가 2 중첩으로 발동된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.951,
                "end": 41.853
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 사용 시 대상에게 기절과 체력 비례 고정 피해를 주고 스킬 대상이 기절 면역일 때 추가 피해준다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.863,
                "end": 49.690
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 뭐 저 쿠키 쓰러지면은 스킬 쿨타임 감소하고 본인 체력 회복 아 일단 스킬 대상 추가 피해는 최대 체력 비례 고정 피해는 10퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.700,
                "end": 61.172
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스킬 대상 기절 2초 그리고 스틸 대상 기절 면역 시 추가 피해 공격력이 500퍼센트 쿨타임 감소 3.5초 야 이건 좀 세다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.182,
                "end": 70.900
            },
            {
                "speaker_id": "1",
                "transcription": "체력 회복은 공격력의 36.1퍼센트",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.910,
                "end": 74.274
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 패시브는 아군 쿠키의 전체 체력 비율 감소가 5퍼센트 당 본인 공격력 증가 1.5퍼센트 아니 근데 설명만 보면은 얘 딱 봐도 그냥 한방덱에 많이 써라 이런 느낌으로 낸 거 같긴 한데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.284,
                "end": 90.566
            }
        ]
    },
    "summary": "남성이 마법 사탕 실론 나이트 리뷰를 통해 재료가 694개가 필요하고 마탕 추가가 되면 실론 나이트 쿠키 각성에서 아군이 쓰러지면 기사단장의 분노 버프가 2 중첩으로 발동되며 설명을 보면 한방덱에 쓰라는 느낌인 거 같다고 한다.",
