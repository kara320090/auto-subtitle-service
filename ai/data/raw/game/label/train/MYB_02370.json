        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 겨우 뭐 깰 수 있긴 한데 아프긴하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.631
            },
            {
                "speaker_id": "1",
                "transcription": "자 요런 식으로 뭐 마무리로 깰 수는 있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.641,
                "end": 12.995
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 제가 아레나에서 5초월 리뷰를 할 건데 네 여러분들이 분명히 어떤 조합을 써야 될지 막 지금 헷갈리는 분들 제 유튜브에 다 조합 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.005,
                "end": 23.631
            },
            {
                "speaker_id": "1",
                "transcription": "모든 조합에 스타더스트 들어가는 조합들을 가장 중요한 거는 여러분들 무조건 어떤 토핑이 좋다가 아니라 상대의 스킬을 피하는 세팅이 가장 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.641,
                "end": 34.766
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 이렇게 게임을 시작하잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.776,
                "end": 37.536
            },
            {
                "speaker_id": "1",
                "transcription": "이제 여러분들이 뭐 올쿨이든 올 애플 젤리든 어떤 세팅을 하던 간에 어떤 조합을 하던 간에 스타더스트가 상대의 딜을 피해서 들어갈 수 있는 세팅으로 하는 게 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.546,
                "end": 49.416
            },
            {
                "speaker_id": "1",
                "transcription": "아니면은 상대가 이렇게 약간 무방비 상태로 바로 이렇게 때려서 기절 넣거나 고거를 활용하는 게 되게 중요하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.426,
                "end": 62.897
            },
            {
                "speaker_id": "1",
                "transcription": "상대마다 이게 또 다 달라서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.897,
                "end": 67.533
            }
        ]
    },
    "summary": "화자는 어떤 토핑으로 구성하든지 상관없이 상대의 스킬을 피할 수 있는 조합이 가장 좋다고 이야기한다.",
