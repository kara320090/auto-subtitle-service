        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이거는 트리플콘컵 요게 나왔는데 보면은 학교가 3가지로 나눠져 있어요. 여러분들이 뭐 선택해서 가는 게 아니라 자동 배정이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.090
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 걸 할지 자동으로 배정이 되고 그 다음에 모르시는 분들 있을까봐 말씀드리는데 아레나 보면은 왼쪽 프로필 상단에 보면은 이런 표시 마크가 있거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.100,
                "end": 19.136
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 마크를 보고 여러분들이 골라서 가시면 되는데 자 같은 학교끼리 가면은 깃발을 획득할 수가 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.146,
                "end": 26.248
            },
            {
                "speaker_id": "1",
                "transcription": "다른 학교여야지만 들어가서 깃발을 얻을 수 있거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.258,
                "end": 29.458
            },
            {
                "speaker_id": "1",
                "transcription": "제가 일단 보여드리겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.468,
                "end": 30.778
            },
            {
                "speaker_id": "1",
                "transcription": "제가 속한 데는 크렘 나이츠거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.788,
                "end": 33.577
            },
            {
                "speaker_id": "1",
                "transcription": "요거랑 다른 곳에 제가 들어가서 보여드리겠습니다.",
