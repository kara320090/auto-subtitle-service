        "term": [
            {
                "speaker_id": "1",
                "transcription": "감사의 마음이다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.381
            },
            {
                "speaker_id": "1",
                "transcription": "크 너무 좋다 그죠?",
                "sound_type": [
                    2
                ],
                "start": 1.391,
                "end": 6.264
            },
            {
                "speaker_id": "1",
                "transcription": "오토에게 멋진 가족이 생겼네?",
                "sound_type": [
                    2
                ],
                "start": 6.274,
                "end": 9.888
            },
            {
                "speaker_id": "1",
                "transcription": "죽은 아들은 돌아올 수 없지만 지금은 너희가 있으니까",
                "sound_type": [
                    2
                ],
                "start": 9.898,
                "end": 13.701
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 아들이 있었나 봐.",
                "sound_type": [
                    2
                ],
                "start": 13.711,
                "end": 15.943
            },
            {
                "speaker_id": "1",
                "transcription": "베어로였나?",
                "sound_type": [
                    2
                ],
                "start": 15.953,
                "end": 18.690
            },
            {
                "speaker_id": "1",
                "transcription": "시드가 한번 얘기했는데 아들을 구해 주고 싶었었대요.",
                "sound_type": [
                    2
                ],
                "start": 18.700,
                "end": 24.640
            },
            {
                "speaker_id": "1",
                "transcription": "정확하게 무슨 일인지 말을 안 해 줬대.",
                "sound_type": [
                    2
                ],
                "start": 24.650,
                "end": 27.988
            },
            {
                "speaker_id": "1",
                "transcription": "이젠 네가 오토의 가족이야.",
                "sound_type": [
                    2
                ],
                "start": 27.998,
                "end": 30.102
            },
            {
                "speaker_id": "1",
                "transcription": "너의 너도 그의 힘이 되어주렴.",
                "sound_type": [
                    2
                ],
                "start": 30.112,
                "end": 33.273
            },
            {
                "speaker_id": "1",
                "transcription": "알겠겠어요.",
                "sound_type": [
                    2
                ],
                "start": 33.283,
                "end": 35.733
            }
        ]
    },
