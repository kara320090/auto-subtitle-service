        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 27만 개 중에 3만 개 빼놓고 크림 유니콘으로 전부 다 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.018
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 5성을 5초월을 위해서 또 위해서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.028,
                "end": 7.419
            },
            {
                "speaker_id": "1",
                "transcription": "아 홀베 모든 슈퍼 에픽 고대 레전드 중에 나왔을 때 반응이 가장 차가운 쿠키 홀리베리.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.429,
                "end": 18.990
            },
            {
                "speaker_id": "1",
                "transcription": "반응 자체가 그냥 리액션이 없어요 쟤",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.004,
                "end": 22.630
            },
            {
                "speaker_id": "1",
                "transcription": "홀베는 되게 냉정하게 다크카카오랑 비교할 게 아니라 와일드베리 이런 애들이랑 비교해도 안 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.780,
                "end": 29.084
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 쿠키런 몇 년 했습니까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.094,
                "end": 31.720
            },
            {
                "speaker_id": "1",
                "transcription": "이제 6년 다 되어가네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.730,
                "end": 33.772
            },
            {
                "speaker_id": "1",
                "transcription": "쫌 있으면 10월 말 되면 쿠키런 오븐브레이크 6주년이거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.782,
                "end": 37.627
            },
            {
                "speaker_id": "1",
                "transcription": "자 5초월 될지 모르겠네?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.637,
                "end": 41.050
            },
            {
                "speaker_id": "1",
                "transcription": "오오? 왜 이렇게 잘 나와? 이것 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.063,
                "end": 44.090
            },
            {
                "speaker_id": "1",
                "transcription": "오 야야 5초월 됐네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.100,
                "end": 47.173
            },
            {
                "speaker_id": "1",
                "transcription": "네 그다음 오케이 고급으로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.183,
                "end": 48.724
            },
            {
                "speaker_id": "1",
                "transcription": "마지막",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.734,
                "end": 51.066
            }
        ]
    },
    "summary": "남성은 홀리베리는 모든 슈퍼 에픽 고대 레전드 중에 나왔을 때 반응이 가장 차가운 쿠키이며 반응 자체가 그냥 리액션이 없다고 말한다.",
