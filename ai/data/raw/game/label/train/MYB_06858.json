        "term": [
            {
                "speaker_id": "1",
                "transcription": "어떻게 된 거야 책임감을 가져보자 지금 백혈구가 정신 차려라 너가 지금 이 몸을 구해줘야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.622
            },
            {
                "speaker_id": "2",
                "transcription": "다운 받아서 해보는데 키가 헷갈려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.632,
                "end": 8.285
            },
            {
                "speaker_id": "2",
                "transcription": "키읔 키읔 키읔 키읔 키읔 웃었던 나를 반성합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.295,
                "end": 11.790
            },
            {
                "speaker_id": "2",
                "transcription": "따로 있는 게 좀 더 직관적일 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.800,
                "end": 14.376
            },
            {
                "speaker_id": "1",
                "transcription": "야 나는 무슨 아 밀고 당기기 키가 따로 있는 게 좀 더 직관적일 것 같아 어 좋은 평가예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.386,
                "end": 19.473
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 지금 제가 뭐가 헷갈리는 건지도 모르겠고 궁금하면 일단 잡숴봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.483,
                "end": 24.194
            },
            {
                "speaker_id": "1",
                "transcription": "일단 데모 다운로드 받고 님들도 리뷰 남겨 압도적 긍정적으로 알겠니?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.204,
                "end": 29.664
            },
            {
                "speaker_id": "1",
                "transcription": "가만 있어 봐 나는 지금 긍정적일 수가 없어.",
                "sound_type": [
                    2,
                    3
                ],
