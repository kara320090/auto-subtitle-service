        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 이거 이기긴 하네요. 그래도",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.799
            },
            {
                "speaker_id": "1",
                "transcription": "이 웨어울프 덱한테도 웨어울프 잡으면 쉽게 이기는데 안 잡혀도 좀 위험할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.809,
                "end": 10.614
            },
            {
                "speaker_id": "1",
                "transcription": "웬만큼 뭐 승률이 지금까지 100퍼센트죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.624,
                "end": 13.736
            },
            {
                "speaker_id": "1",
                "transcription": "이게 확실한 거는 이제 상위권 분들도 크런치초코칩이나 오이스터 덱 아니면은 이기기 쉽다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.746,
                "end": 22.041
            },
            {
                "speaker_id": "2",
                "transcription": "물러설 수 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.051,
                "end": 23.248
            },
            {
                "speaker_id": "1",
                "transcription": "그게 포인트고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.258,
                "end": 24.926
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 낮아도 이제 상위권들 잡는 덱이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.936,
                "end": 28.760
            },
            {
                "speaker_id": "3",
                "transcription": "무럭무럭 자라라",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.770,
                "end": 30.396
            },
            {
                "speaker_id": "4",
                "transcription": "어둠으로 사라져라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.406,
                "end": 31.377
            },
            {
                "speaker_id": "1",
                "transcription": "투 힐 덱이라 잡기 힘들겠다. 그쵸?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.387,
                "end": 33.386
            },
            {
                "speaker_id": "5",
                "transcription": "느껴 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.396,
                "end": 34.224
            },
            {
                "speaker_id": "6",
                "transcription": "겨울이 오고 있어.",
