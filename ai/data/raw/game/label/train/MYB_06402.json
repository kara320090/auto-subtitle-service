                    2
                ],
                "start": 0.000,
                "end": 1.185
            },
            {
                "speaker_id": "1",
                "transcription": "자 밑에 이 쬐그만 병아리 같은 게 따라오네요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 1.195,
                "end": 3.750
            },
            {
                "speaker_id": "1",
                "transcription": "아기 병아리 트수 몇 마리 쓸쓰니?",
