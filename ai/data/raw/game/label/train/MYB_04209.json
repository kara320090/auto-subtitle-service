        "term": [
            {
                "speaker_id": "1",
                "transcription": "보면은 일일 보상은 다 받고 계십니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.222
            },
            {
                "speaker_id": "1",
                "transcription": "과연 재고는 어떻게 되어 있는지 나무는 야 그래도 700개 안 여셨고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.232,
                "end": 7.977
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 아 요게 젤리빈이 좀 부족하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.987,
                "end": 10.554
            },
            {
                "speaker_id": "1",
                "transcription": "각설탕 여러분들 이렇게 크탈 모으는 분이 다른 거는 700개까지 안 열었는데 유일하게 700개까지 쓴 게 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.564,
                "end": 19.336
            },
            {
                "speaker_id": "1",
                "transcription": "그게 바로 각설탕이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.346,
                "end": 20.862
            },
            {
                "speaker_id": "1",
                "transcription": "모으기 힘들다 고거를 여기서 볼 수가 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.872,
                "end": 24.329
            },
            {
                "speaker_id": "1",
                "transcription": "네 나머지는 500개밖에 안 썼어요 그다음에 대장간은 재고 뭐 다 열차를 안 멈출 정도까지 테크는 다 낮습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.339,
                "end": 31.640
            },
            {
                "speaker_id": "1",
                "transcription": "예 역시 킹덤은 고스펙을 만들어야 되겠다 그런 거 보다 각자가 재미를 느낄 수 있는지 찾아서 하면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.650,
                "end": 40.433
            }
        ]
    },
    "summary": "유일하게 700개 쓴 게 각설탕이다.",
