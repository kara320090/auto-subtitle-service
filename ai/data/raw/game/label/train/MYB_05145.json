        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 나올 싱글 레전드 정말 사기적인 쿠키라 여러분들 반드시 키워야 되고 캡틴 캐비어도 아레나에서 거의 뭐 엄청나게 유용하게 잘 쓰이고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 10.100
            },
            {
                "speaker_id": "1",
                "transcription": "마지막에 소환 덱도 네. 요런 저격 덱. 2번 덱 저격으로 잘 쓰이고 있고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.110,
                "end": 15.409
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 말이 많았던 게 이 피해감소 무시라는 게 상당히 이유가 크게 다가와서 어 사기적으로 되지 않았나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.419,
                "end": 26.041
            },
            {
                "speaker_id": "1",
                "transcription": "물론 이 피해감소 무시가 여러분들 이게 무조건 뭐 사기다라고 물론 사기입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.051,
                "end": 35.205
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제 피해감소 무시라는 게 이 스킬이 들어갈 때 무시가 돼서 피해가 엄청나게 사기적인 스킬이지만 나머지 이 쿠키 외에 나머지 쿠키가 때릴 때에는 피해감소가 되는 건 아니기 때문에.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.215,
                "end": 47.843
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 1, 2, 3번 블랙펄. 그 다음에 캡틴 캐비어까지 맞출 수 있는 덱 세팅해서 하시면 좋을 거 같습니다. 감사합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.853,
                "end": 73.691
            }
        ]
    },
