        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 일단 이 분은 제가 보통 계정 평가를 하면은 아레나 덱 봐 주세요 하면 아레나 뭐 그 세팅도 해 드리고 조합도 맞춰 주고 아니면 토벌 같은 경우에나 아니면 뭐 수호의 성전 이런 거 보면은 그래도 조합 세팅이나 이런 것도 해 드리는데 좀 그런 거 해 드릴 단계가 아니고 그 이 분이 갖고 있는 고통이 시간이 부족한데 코인 부족하고 어떻게 왕국 운영이 힘들다 해결은 딱 하나였습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 24.605
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 강화 12강까지 하지 마세요. 6강까지만 하세요 6강까지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.615,
                "end": 28.112
            },
            {
                "speaker_id": "1",
                "transcription": "12강까지 절대 하지 마시고 코인 모아서 쿠키 성 레벨 11성 그다음에 12성 다 가야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.122,
                "end": 33.997
            },
            {
                "speaker_id": "1",
                "transcription": "가면서 쿠키 성 레벨 업을 해 주시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.007,
                "end": 37.962
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 별사탕 만약에 모자르면은 뭐 이거 저 같은 경우에 무과금 계정 할 때 이거 열었거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.972,
                "end": 42.817
            },
            {
                "speaker_id": "1",
                "transcription": "최대로 제가 생각하는 거는 5개까지는 어떻게든 힘들고 그러면 열어도 된다 생각하지만 6개는 좀 무리 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.827,
                "end": 49.144
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 석상 같은 거 레벨 업 요것도 올리시면 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.154,
                "end": 52.864
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 해서 @이름1님 네 계평은 요렇게 에 보도록 하겠습니다.",
