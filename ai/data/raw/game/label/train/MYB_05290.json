        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오케이 이거 보는 게 더 잘 나오는 것 같애.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.822
            },
            {
                "speaker_id": "1",
                "transcription": "러너 님 초딩 때 여자 여장한 적 있다고 하셨잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.832,
                "end": 7.313
            },
            {
                "speaker_id": "1",
                "transcription": "나무위키 공개할 생각 없냐고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.323,
                "end": 8.888
            },
            {
                "speaker_id": "1",
                "transcription": "대학교 대 장기 자랑 같은 거 해 가지고 브라운 아이드 걸스에 아브라카다브라 여장해서 제가 미르 역할로 장기 자랑한 적이 있었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.898,
                "end": 19.772
            },
            {
                "speaker_id": "1",
                "transcription": "그때 말한 거 그거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.782,
                "end": 21.330
            },
            {
                "speaker_id": "1",
                "transcription": "그때 앞에서 영상 찍어 가지고 녹화해 가지고 옛날에 그 싸이월드를 했거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.340,
                "end": 28.830
            },
            {
                "speaker_id": "1",
                "transcription": "싸이월드 내에 그 거기 있었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.840,
                "end": 31.775
            },
            {
                "speaker_id": "1",
                "transcription": "영상 자체가 근데 다행히도 싸이월드 망해 가지고 다 비공개로 됐었나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.785,
                "end": 37.234
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 볼 수는 없을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.244,
                "end": 38.804
            },
            {
                "speaker_id": "1",
                "transcription": "내가 아마 비번, 아이디 찾아서 들어가면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.814,
                "end": 41.733
            }
        ]
    },
    "summary": "화자가 말한 여장은 대학교 때 장기 자랑 여장한 거라며 녹화 영상이 싸이월드 있는데 망해서 비공개되었다고 한다.",
