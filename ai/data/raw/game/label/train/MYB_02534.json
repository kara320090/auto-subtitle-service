        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 나온 신규 보물 리뷰갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.524
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 벚꽃이 피어나는 도토리 폭죽 일단 피해량이랑 방어력 감소가 있어요. 뭔가 능력만 보면 쓰잘떼기 있어 보이는 것처럼 보이지만 대부분의 스페셜 등급의 보물은 다 예능이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.534,
                "end": 17.196
            },
            {
                "speaker_id": "1",
                "transcription": "네 한 번 뽑기 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.206,
                "end": 18.831
            },
            {
                "speaker_id": "1",
                "transcription": "자 확률이 굉장히 낮지만 야 두 개가 나왔네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.841,
                "end": 22.518
            },
            {
                "speaker_id": "1",
                "transcription": "오 야 뭐야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.528,
                "end": 23.814
            },
            {
                "speaker_id": "1",
                "transcription": "잘 나오는데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.824,
                "end": 24.822
            },
            {
                "speaker_id": "1",
                "transcription": "야 그래도 한 근데 뭐 잘 나올 때는 잘 나오네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.832,
                "end": 28.720
            },
            {
                "speaker_id": "1",
                "transcription": "야 또 나왔어. 자 이렇게 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
