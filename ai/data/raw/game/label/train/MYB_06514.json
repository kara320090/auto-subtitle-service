        "term": [
            {
                "speaker_id": "1",
                "transcription": "아까 전에 그 문 열었던데 있죠?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 4.772
            },
            {
                "speaker_id": "1",
                "transcription": "위에 천장 뚜껑 문 열었던 데 거긴 것 같아",
                "sound_type": [
                    2,
                    4
                ],
                "start": 4.782,
                "end": 13.279
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이걸 옮길 방법이 없는데?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 13.289,
                "end": 16.355
            },
            {
                "speaker_id": "1",
                "transcription": "근데 방금 어떻게 옆으로 갔지?",
