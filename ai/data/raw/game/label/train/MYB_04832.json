        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리도 4000개 걍 뿌리던가 회수를 좀 하고 공지를 해라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.208
            },
            {
                "speaker_id": "1",
                "transcription": "운영자가 이런 말을 한다니까 선동을 이런 식으로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.218,
                "end": 7.132
            },
            {
                "speaker_id": "1",
                "transcription": "전 되게 나름 심각하다 보거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.142,
                "end": 9.309
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그냥 해프닝으로 그 운영자가 계정 잘못 골라서 쓴 거 해프닝으로 그냥 넘기죠 라고 생각할 수도 있지만 야 이거 1번이겠어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.319,
                "end": 19.261
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 지금 글을 써 왔다는 거는 다른 식으로 선동도 여태까지 해 왔다는 건데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.271,
                "end": 25.487
            },
            {
                "speaker_id": "1",
                "transcription": "운영자가 이거는 내가 볼 땐 선동을 했다는 거는 맞잖아요 이 정도로 쓴 거는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.497,
                "end": 30.563
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 단순히 지금 카페에 글 다 삭제하고 이렇게 한다고 하는데 제대로 된 공지도 없고 그런 식으로만 반응한다는 거 자체는 난 너무 심각하다 생각해요 진짜로.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.573,
                "end": 42.666
            }
        ]
    },
    "summary": "남자는 우리도 4000개 걍 뿌리던가 회수를 좀 하고 공지를 해라 이런 말을 운영자가 했다는 건 그냥 해프닝으로 넘기자고 생각할 수도 있지만 이런 식으로 글을 써 왔다는 건 다른 식으로 선동도 해 왔다는 거라며 자신이 볼 땐 운영자가 선동했다는 게 맞고 제대로 된 공지도 없이 단순히 카페의 글 다 삭제하는 식으로만 반응한다는 거 자체는 너무 심각하다 생각한다고 한다.",
