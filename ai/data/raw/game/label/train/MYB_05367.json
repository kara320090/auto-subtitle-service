                    2,
                    3,
                    5
                ],
                "start": 27.522,
                "end": 28.979
            },
            {
                "speaker_id": "1",
                "transcription": "퓨바나 다른 힐러들은 애플젤리 별로 일까요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.989,
                "end": 32.006
            },
            {
                "speaker_id": "1",
                "transcription": "어 그것도 나쁘진 않을 거 같네요 제가 볼 때는.",
