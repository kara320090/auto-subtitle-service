        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그만 주세요 제발. 이거 별사탕 많이 나오네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.827
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그만 줘. 자 마지막 에픽 선택 상자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.837,
                "end": 13.676
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 해서 전부 다 구했고 얘는 하루에 한 번 공짜고 상점에서 패키지를 지르면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.686,
                "end": 20.230
            },
            {
                "speaker_id": "1",
                "transcription": "우측 상단에 보면 이렇게 서프라이즈 행운의 티켓 이벤트 안내 이렇게 하면서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.230,
                "end": 25.757
            },
            {
                "speaker_id": "1",
                "transcription": "따로 포인트 얼마 주는지 나와있거든요? 과금하시는 분들은 과금해서 이거 당첨되면은 진짜 레전드입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.767,
                "end": 33.715
            },
            {
                "speaker_id": "1",
                "transcription": "커터 30개, 크탈 만 개, 에픽 선택 상자, 무큐, 고대 영혼석 선택 상자 좋은 건 많네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.725,
                "end": 41.707
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 쿠키 선택 상자도 3개도 주고 좋은 건 이렇게 쭉 쌓여있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.717,
                "end": 46.263
            },
            {
                "speaker_id": "1",
                "transcription": "이거 보시고 대박을 노려보시는 게 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.273,
                "end": 49.940
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 여러분들 다 스펙이 만렙인 분들은 이거 크탈로 대체해서 주네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.950,
                "end": 55.166
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 쿠키 선택 상자가 크탈 2,500개로 바꿔서 들어온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.176,
                "end": 60.169
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 복권 뽑기 리뷰는 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.179,
                "end": 64.857
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 과금 더 하게 되면은 따로 대박을 노려보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.867,
                "end": 84.873
            }
        ]
    },
    "summary": "행운의 복권 뽑기를 해서 운이 좋으면 커터 30개, 크탈 만 개, 에픽 선택 상자, 무큐, 고대 영혼석 선택 상자 등을 얻을 수 있다.",
