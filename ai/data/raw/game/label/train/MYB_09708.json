        "term": [
            {
                "speaker_id": "1",
                "transcription": "외날 세검에 대해서 이야기해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.371
            },
            {
                "speaker_id": "1",
                "transcription": "아 그 아름다운 검 바가지 다 카론이랑 거래하면 다 바가지 쓰네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.381,
                "end": 12.052
            },
            {
                "speaker_id": "1",
                "transcription": "아 바깥 대륙에서 만들어 진건데 독특한 무슬 유파가 있는 거 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.062,
                "end": 19.560
            },
            {
                "speaker_id": "1",
                "transcription": "일격일살로 쓰고 버린데요 그 유파는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.570,
                "end": 24.764
            },
            {
                "speaker_id": "1",
                "transcription": "우리 문화에는 없는 아름다움이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.774,
                "end": 31.577
            },
            {
                "speaker_id": "1",
                "transcription": "예리한 질문인데 바로 숫돌로 하는 거래",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.587,
                "end": 36.396
            },
            {
                "speaker_id": "1",
                "transcription": "아 아 숫돌이 특별한데 여기서 구할 수 없는 돌이야",
