        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 그 길도 그리 녹록지 않았다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.963
            },
            {
                "speaker_id": "1",
                "transcription": "어두컴컴한 바다에서는 땅 갈라지는 소리가 울렸어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.973,
                "end": 8.136
            },
            {
                "speaker_id": "1",
                "transcription": "해저 화산이 뜨거운 열기를 내뿜으며 어디선가 거대한 바다 생물이 울부짖었지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.146,
                "end": 14.660
            },
            {
                "speaker_id": "1",
                "transcription": "마음을 다잡기 위해 다시 앞을 바라보면 본 적도 없는 생물들과 눈이 마주쳤다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.670,
                "end": 21.011
            },
            {
                "speaker_id": "1",
                "transcription": "그중 커다란 뱀 같은 녀석은 급기야 내 잠수함을 붙들고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.021,
                "end": 26.289
            },
            {
                "speaker_id": "1",
                "transcription": "어허이 그 적당히 합시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.299,
                "end": 29.127
            },
            {
                "speaker_id": "2",
                "transcription": "전에 들었을 때는 이렇게까지 위험하지 않았던 것 같은데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.137,
                "end": 33.029
            },
            {
                "speaker_id": "1",
                "transcription": "에잇 이 그땐 말하는 걸 까먹었었나 보지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.039,
                "end": 37.349
            },
            {
                "speaker_id": "3",
                "transcription": "어 그래서 그 검고 커다란 녀석은 만난 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.359,
                "end": 41.639
            },
            {
                "speaker_id": "1",
                "transcription": "글쎄 어땠을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.649,
                "end": 44.382
            },
            {
                "speaker_id": "1",
                "transcription": "바다의 울부짖음을 뒤로하고 우린 천천히 나아갔다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.392,
                "end": 49.187
            },
            {
                "speaker_id": "1",
                "transcription": "부서진 배의 잔해가 가득한 배들의 무덤을 향해서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.197,
                "end": 55.933
            }
        ]
    },
    "summary": "어두컴컴한 바다 속에서 해저 화산이 뜨거운 열기를 내뿜으며 커다란 뱀 같은 녀석이 잠수함을 붙잡는 등 위험한 여정 속에서 우리는 배의 잔해가 가득한 배들의 무덤을 향해서 나아갔다.",
