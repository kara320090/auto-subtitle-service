        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 하다 보시면은 어려움 없이 세팅을 할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.236
            },
            {
                "speaker_id": "1",
                "transcription": "복잡한 공식보다도 결론만 말씀드리면 이 한방덱 같은 경우에는 결국에는 상대방의 이제 한방덱 종류들 그리고 변형된 다른 뭐 속성들 불 속성 등이나 다른 기타 다양한 덱들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.246,
                "end": 18.338
            },
            {
                "speaker_id": "1",
                "transcription": "전용으로 잡을 때 맞춤으로 세팅해서 순서 맞춰서 가시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.348,
                "end": 22.545
            },
            {
                "speaker_id": "1",
                "transcription": "네 또는 이 실론나이트덱은 정석으로 상대방 정석덱으로 맞춰서 순서 들어간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.555,
                "end": 28.871
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 찰스로 바꿔서는 상대 실론나이트 한방덱에 맞춰서 들어가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.881,
                "end": 33.909
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 이 정석덱은 상대방의 홀 와덱 홀 와 정석덱이나 또는 상대 공속덱에 맞춤으로 들어간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.919,
                "end": 41.188
            },
            {
                "speaker_id": "1",
                "transcription": "또 마지막으로 여러분들이 분명히 런에 어떤 쿠키 없는데 대체 뭐 없을까요라는 질문들 분명히 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.198,
                "end": 48.343
            },
            {
                "speaker_id": "1",
                "transcription": "자 대체되는 쿠키는 뭐 스냅드래곤 자리 같은 경우에는 당연히 뭐 BTS나 아 다른 힐러로 대체하면 되시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.353,
                "end": 55.430
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱 같은 경우에는 아마 대체가 힘들 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.440,
                "end": 58.801
            },
            {
                "speaker_id": "1",
                "transcription": "어 와일드베리 자리나 캡사이신이나 이런 쿠키 같은 경우에는 보니까 마라맛 쿠키나 다른 탱커류도 있죠 그런 걸로 대체해서 쓰시는 분들 있더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.811,
                "end": 69.123
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 되는 스펙에 따라서 최대한 맞춰서 써주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.133,
                "end": 74.172
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번 대난투 공략은 결정 길드의 수정님이 여러 가지 좋은 공략들을 조합해서 정리해서 저한테 또 알려주신 거라 네 수정님한테 다시 한번 감사한 말씀을 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.182,
                "end": 85.695
            },
            {
                "speaker_id": "1",
                "transcription": "궁금한 점이 있다면은 어 댓글에 남겨주세요 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
