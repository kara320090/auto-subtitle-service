        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 마법 사탕 쿠키는 이런 말 하긴 그런데 유행이 좀 빨리빨리 끝납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.635
            },
            {
                "speaker_id": "1",
                "transcription": "시기가 지나자마자 바로 끝 나버린 게 대다수예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.645,
                "end": 7.948
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 지나간 마탕에다가 투자는 하지 말자 요것도 알아 가시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.958,
                "end": 14.830
            },
            {
                "speaker_id": "1",
                "transcription": "자 마법 사탕 관련된 영상은 여기서 마무리짓고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.840,
                "end": 17.966
            },
            {
                "speaker_id": "1",
                "transcription": "궁금한 점이 있다면 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.976,
                "end": 20.472
            },
            {
                "speaker_id": "1",
                "transcription": "제가 댓글은 최대한 다 읽고 답변을 최대한 하도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.482,
                "end": 24.312
            },
            {
                "speaker_id": "1",
                "transcription": "자 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.322,
                "end": 33.000
            }
        ]
    },
    "summary": "마법 사탕 쿠키의 유행은 시기가 지나자마자 끝나버린 게 대다수이다.",
