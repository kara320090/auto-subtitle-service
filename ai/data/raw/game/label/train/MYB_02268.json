        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "라떼맛 쿠키 마법 사탕 출시됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.562
            },
            {
                "speaker_id": "1",
                "transcription": "자 마법 사탕을 하게 되면 뭐가 좋냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.572,
                "end": 5.047
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 뭐 앞 스킬 사용하면은 아군에게 해로운 효과가 감소 부여하고 적들에게는 해로운 증가를 부여한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.057,
                "end": 13.468
            },
            {
                "speaker_id": "1",
                "transcription": "예, 그리고 1회 피해량이 해로운 효과가 증가가 있는 대상에게는 추가 피해까지 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.478,
                "end": 18.069
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 대상에게 중독 디버프가 있으면은 치유량 감소 디버프도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.079,
                "end": 21.804
            },
            {
                "speaker_id": "1",
                "transcription": "이런 능력이 새로 생겼습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.814,
                "end": 23.643
            },
            {
                "speaker_id": "1",
                "transcription": "강화하면은 침묵 시간이 증가된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.653,
                "end": 26.277
            },
            {
                "speaker_id": "1",
                "transcription": "침묵 시간이 뭐 0.1초씩 증가되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.287,
                "end": 29.053
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 아군 전체의 체력을 공격력의 30퍼센트만큼 회복시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.063,
                "end": 33.811
            },
            {
                "speaker_id": "1",
                "transcription": "힐러 느낌이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.821,
                "end": 34.858
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 중독덱이랑 같이 쓰라는 컨셉 같은데 암만 봐도 일단 요렇게 되고 일단 얘 쿨 타임이 15초 15초 쿠키는 달빛이랑 똑같고 일단 월드 탐험에서 볼 텐데 얘는 뭐 보스라기보단 그냥 여기서 1번 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.868,
                "end": 57.766
            }
        ]
    },
    "summary": "라떼맛 쿠키 마법 사탕이 출시가 됐고 스킬 사용하면 아군에게 해로운 효과가 감소되고 적들에게는 해로운 증가되며 대상에게 중독 디버프가 있으면 치유량 감소 디버프도 있고 강화하면 침묵 시간 0.1초씩 증가되며 아군 전체 체력을 공격력의 30퍼센트 회복시킨다.",
