        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "강력한 딜을 가져가면서 상대를 녹일 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.955
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 나락가거나 그러지 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.965,
                "end": 6.830
            },
            {
                "speaker_id": "1",
                "transcription": "아직도 달빛술사는 스타더스트 덱은 유용하게 잘 쓰고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.840,
                "end": 13.567
            },
            {
                "speaker_id": "1",
                "transcription": "상위권에서 잘 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.577,
                "end": 17.439
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 제가 추천드릴거는 락스타, 달빛술사 덱인데 3순위 덱이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.449,
                "end": 23.378
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 이 자리에는 달빛술사 보다는 스타더스트가 더 승률이 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.388,
                "end": 28.600
            },
            {
                "speaker_id": "1",
                "transcription": "여러 제가 경우의 수를 봤을 때 달빛술사는 스타더스트가 없는 분들한테 더 추천을 드린다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.610,
                "end": 34.999
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래도 마지막으로 이렇게 올 클로해서 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.009,
                "end": 39.747
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방은 스타더스 달빛술사 덱 확실히 달빛술사 덱이 많이 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.757,
                "end": 46.553
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 활용해서 그렇기 때문에 여러분들 달빛술사도 당연히 여러분들 메인 쿠키로서 0순위로 여러분들이 키워야 될 쿠키고 아레나에서 아마 빠지기가 힘든 쿠키에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.563,
                "end": 63.860
            },
            {
                "speaker_id": "1",
                "transcription": "빠지기 힘들고 대체 불가능하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.870,
                "end": 71.066
            }
        ]
    },
    "summary": "화자는 아직도 달빛술사와 스타더스트 덱은 상위권에서 잘 쓰이고 있다고 하고 3순위 덱인 락스타, 달빛술사 덱을 설명하려고 한다.",
