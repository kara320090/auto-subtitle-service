        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이 분은 자 이 컨셉이 확실하신 분이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.154
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 딱 이 화면 보면은 뭐야 이거 완전히 초보자잖아. 이렇게 생각할 수 있는데 사실은 컨셉입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.164,
                "end": 9.989
            },
            {
                "speaker_id": "1",
                "transcription": "오른쪽에 이렇게 되어 있고 거의 태초 컨셉으로 만들어놓은 그런 분이거든요. 저번에 낚였어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.999,
                "end": 16.390
            },
            {
                "speaker_id": "1",
                "transcription": "이 분 부계정이고 크탈 이게 30만 개 있으면 가끔가다 저 핵인 줄 알고 뽑기 안 합니다. 이렇게 넘어가는 분도 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.400,
                "end": 22.871
            },
            {
                "speaker_id": "1",
                "transcription": "이 분 50레벨입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.881,
                "end": 25.068
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이 분 뽑기 보겠습니다. 저 마일리지 다 보뽑으로 해주시고 달빛술사가 없습니다. 달빛술사 뽑아 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.078,
                "end": 32.127
            },
            {
                "speaker_id": "1",
                "transcription": "일단 스펙을 보면 달빛 1조각 남았네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.137,
                "end": 34.692
            },
            {
                "speaker_id": "1",
                "transcription": "1조각 제가 무조건 채워드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.702,
                "end": 37.232
            },
            {
                "speaker_id": "1",
                "transcription": "이 분은 5성 가는 게 맞네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.242,
                "end": 39.025
            },
            {
                "speaker_id": "1",
                "transcription": "자 요걸로 뽑기 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.035,
                "end": 40.907
            },
            {
                "speaker_id": "1",
                "transcription": "나올 때까지. 보물 뽑기는 호루라기, 화관, 목 자 바로 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.917,
                "end": 49.600
            }
        ]
    },
    "summary": "화자는 게임 유저의 스펙을 보며 남은 1조각을 본인이 채워주겠다고 말한다.",
