        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.973
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.983,
                "end": 6.295
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.305,
                "end": 10.210
            },
            {
                "speaker_id": "1",
                "transcription": "감초맛 쿠키가 왜 안 쓰이나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.220,
                "end": 15.049
            },
            {
                "speaker_id": "1",
                "transcription": "감초맛 쿠키는 나락을 간 결정적인 기계가 계기가 있었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.059,
                "end": 19.407
            },
            {
                "speaker_id": "1",
                "transcription": "어으 야 평딜이 막 6천 이렇게 되네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.417,
                "end": 22.805
            },
            {
                "speaker_id": "1",
                "transcription": "감초맛 쿠키는 목화맛 쿠키가 출시된 이후로 그냥 완전 나락의 끝을 달렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.815,
                "end": 28.497
            },
            {
                "speaker_id": "1",
                "transcription": "목화맛 쿠키가 감초맛 쿠키의 토벌 자리를 완전히 뺏고 스토리도 완전히 뺏어버리기 때문에 그 다음부터는 쓰일 일이 없었죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.507,
                "end": 41.074
            }
        ]
    },
