        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "달빛술사 시즌2 그마1 자 창고는 현재 406칸 MAX로 되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.512
            },
            {
                "speaker_id": "1",
                "transcription": "나머지도 한번 볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.522,
                "end": 8.334
            },
            {
                "speaker_id": "1",
                "transcription": "연구소도 다 풀이지 뭐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.344,
                "end": 9.970
            },
            {
                "speaker_id": "1",
                "transcription": "이분은 제가 뭐 조언을 드리려고 들어온 게 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.980,
                "end": 12.716
            },
            {
                "speaker_id": "1",
                "transcription": "풀 스펙이라는 게 이런 거다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.726,
                "end": 14.347
            },
            {
                "speaker_id": "1",
                "transcription": "네 왕국 연구는 전부 다 다 찍혀있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.357,
                "end": 17.692
            },
            {
                "speaker_id": "1",
                "transcription": "종결되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.702,
                "end": 19.322
            },
            {
                "speaker_id": "1",
                "transcription": "역시 최정예답게 스펙이 높다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.332,
                "end": 22.403
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키도 보면은 스펙 자체가 좋아 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.413,
                "end": 26.836
            },
            {
                "speaker_id": "1",
                "transcription": "어마무시한 초월이 되어 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.846,
                "end": 28.514
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 할 수 있는데 이 초월 재료가 부족한 거지 5초월 다 가능하신 상태예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.524,
                "end": 34.395
            },
            {
                "speaker_id": "1",
                "transcription": "보물도 풀 스펙이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.405,
                "end": 35.876
            },
            {
                "speaker_id": "1",
                "transcription": "스킨도 풀이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.886,
                "end": 37.117
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 랜드마크 안 지은 거 혹시 있으신가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.127,
                "end": 39.095
            },
            {
                "speaker_id": "1",
                "transcription": "가끔가다 보면은 랜드마크 안 지은 분도 있긴 한데 아 랜드마크도 풀이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.105,
                "end": 44.186
            },
            {
                "speaker_id": "1",
                "transcription": "당연한 거겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.196,
                "end": 45.067
            },
            {
                "speaker_id": "1",
                "transcription": "제가 궁금한 건 쿠키 하우스 레벨인데 야 퍼펙트 다 만렙입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.077,
                "end": 52.310
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 그런데 만렙 아닌 거 찾기가 힘들어 사실.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.320,
                "end": 54.672
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이제 생산 쪽으로 가볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.682,
                "end": 56.471
            },
            {
                "speaker_id": "1",
                "transcription": "자 나무 7600개에 젤리빈도 4500개 각설탕 6000개 넘쳐납니다 재고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.481,
                "end": 63.456
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 재고도 꽉꽉 다 채워져 있고 야 재고 보소 당장 대무역 해도 뭐 모자름이 없죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.466,
                "end": 71.240
            },
            {
                "speaker_id": "1",
                "transcription": "재고 상태도 상당히 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.250,
                "end": 73.812
            },
            {
                "speaker_id": "1",
                "transcription": "이건 계정 평가가 아니라 100점짜리 시험지를 들고 채점 다시 하는 거잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.822,
                "end": 78.155
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 평가라고 말하기 힘들고 이거는 계정 탐방입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.165,
                "end": 83.136
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 보통은 제가 이제 계정 평가할 때 수호 성전을 뭐 덱을 이렇게 하세요 이렇게 추천하잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.146,
                "end": 90.612
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 저는 이제 @계정1님이 알려주는 덱을 제가 배워서 하고 있기 때문에 오히려 성전은",
                "sound_type": [
