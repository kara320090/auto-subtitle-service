        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "전부 다 들어가서 하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.814
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 상대방 분 네 크레 클로티드 자 요 덱도 한번 가 보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.824,
                "end": 8.927
            },
            {
                "speaker_id": "1",
                "transcription": "자 요 덱은 좀 위험한데 왜 위험하냐면은 휘낭시에가 되게 빨리 죽을 거예요.",
                "sound_type": [
                    2
                ],
                "start": 8.937,
                "end": 14.047
            },
            {
                "speaker_id": "1",
                "transcription": "보통은 휘낭시에가 많이 버티고 끝까지 살아남는데 지금 보면은 되게 일찍 죽었죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.057,
                "end": 19.536
            },
            {
                "speaker_id": "1",
                "transcription": "에 좀 일찍 죽어 버렸고 아 요거는 좀 지는 그림이 나올 수 있겠다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.546,
                "end": 26.220
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 덱한테 좀 약하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.230,
                "end": 28.628
            },
            {
                "speaker_id": "1",
                "transcription": "예 아까도 진 거 같은데 클로티드 덱이 요렇게 나와서 휘낭시에 잡으면 지는 그림이 나오네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.638,
                "end": 36.958
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 덱한테 좀 약한 거 같네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.968,
                "end": 39.173
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 덱 휘낭시에가 빨리 죽으면은 위험하다 그렇게 보면 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.183,
                "end": 46.779
            },
            {
                "speaker_id": "1",
                "transcription": "그 클로티드가 있는 거 같으면은 아예 그냥 휘낭시에 뭐 아몬드도 한번 해 보는 것도 네 나쁘지 않은 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.789,
                "end": 57.235
            },
            {
                "speaker_id": "1",
                "transcription": "이제 좀 피해야 될 거는 클로티드 덱 뭐 소환 덱, 원탱 덱 요거 피해서 가면은 그래도 좋지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.245,
                "end": 68.266
            }
        ]
    },
    "summary": "휘낭시가 클로티드 덱에서 일찍 죽어서 지는 그림이 나오고 클로티드가 있는 거 같으면 화자는 휘낭시에 아몬드로 해 보는 것을 추천하며 클로티드 덱, 소환 덱, 원탱 덱을 피해서 가라고 얘기한다.",
