                "start": 0.000,
                "end": 2.420
            },
            {
                "speaker_id": "2",
                "transcription": "그래도 3개월 후에 황금 연휴 있으니 참고 버틸 거예요.",
                "sound_type": [
                    2,
                    3
                ],
