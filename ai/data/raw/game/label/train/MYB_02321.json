        "term": [
            {
                "speaker_id": "1",
                "transcription": "보상 같은 거 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.743
            },
            {
                "speaker_id": "1",
                "transcription": "자 격돌 트리플콘컵 2부 업데이트 트리플콘컵 2부가 시작됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.753,
                "end": 7.006
            },
            {
                "speaker_id": "1",
                "transcription": "새롭게 배정받은 학교에서 다양한 경기를 진행해 보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.016,
                "end": 10.893
            },
            {
                "speaker_id": "1",
                "transcription": "하 이거 진짜 양심에 찔리지 않습니까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.903,
                "end": 13.777
            },
            {
                "speaker_id": "1",
                "transcription": "트리플콘컵 2부는 총 4개의 시즌으로 경기가 진행된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.787,
                "end": 18.086
            },
            {
                "speaker_id": "1",
                "transcription": "각 시즌마다 기 기본 종목의 아레나 깃발 대항전과 시즌 종목 1종으로 경기가 진행된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.096,
                "end": 24.005
            },
            {
                "speaker_id": "1",
                "transcription": "상대적으로 인원수가 적은 두 학교에 그의 상응하는 점수 보정이 진행된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.005,
                "end": 27.827
            },
            {
                "speaker_id": "1",
                "transcription": "트리플콘컵 2부에서는 단일 시즌 정산 시 해당 시즌에 참여하지 않은 유저의 점수는 제외되며 보상은 소속된 학교의 모든 유저에게 지급된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.827,
                "end": 36.487
            },
            {
                "speaker_id": "1",
                "transcription": "학교 순위가 낮을수록 다른 학생과의 전쟁에서 승리 시 더 많은 깃발을 획득할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.487,
                "end": 41.200
            },
            {
                "speaker_id": "1",
                "transcription": "마일리지 샵에서 블루파이맛 쿠키 영혼석 친구 관리의 친구 목록 정렬 기능 추가 민트초코쿠키가 밸런스 상향 공격력이 증가됐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.200,
                "end": 50.506
            },
            {
                "speaker_id": "1",
                "transcription": "그리고",
