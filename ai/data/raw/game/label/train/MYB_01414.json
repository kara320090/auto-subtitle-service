        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 상성 관계를 좀 보기 위해서 여러 덱을 상대로 제가 한 번 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.862
            },
            {
                "speaker_id": "1",
                "transcription": "자 먼저 여러분들 많이 보이는 스타더스트 락스타 덱한테 한방 덱으로 들어가 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.872,
                "end": 11.270
            },
            {
                "speaker_id": "1",
                "transcription": "자 보통 시작하자마자 어떤 그림으로 되게 되나면은 앞에 탱커들은 다 날라가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.280,
                "end": 17.419
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 딜러들만 뒤에 남게 될 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.429,
                "end": 21.358
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 도넛부터 스킬이 진행되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.368,
                "end": 25.656
            },
            {
                "speaker_id": "1",
                "transcription": "자 보시면 알겠지만 가운데만 남게 되죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.666,
                "end": 28.395
            },
            {
                "speaker_id": "1",
                "transcription": "앞에는 달 날라가고 가운데 딜러만 남게 돼서 네 이렇게 실로나이트가 남아서 가운데 딜러를 정리하는 그림으로 가게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.405,
                "end": 41.054
            },
            {
                "speaker_id": "1",
                "transcription": "예 요런 식으로",
                "sound_type": [
                    2,
