        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 남게 된다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.373
            },
            {
                "speaker_id": "1",
                "transcription": "예 1대 1로 남게 돼도 어차피 증표 보물이 있게 때문에 실론나이트가 정리하는 그림으로 마무리가 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.383,
                "end": 9.529
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 해서 네 공격량이 실론이 가장 높게끔",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.539,
                "end": 13.781
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음 세팅",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.791,
                "end": 15.057
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대 달빛술사와 스타더스트덱 요것도 방덱으로 많이 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.067,
                "end": 19.399
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 한 번 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.409,
                "end": 21.507
            },
            {
                "speaker_id": "1",
                "transcription": "들어가게 되면은 앞에 탱커들이 다 날라가고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.517,
                "end": 24.527
            },
            {
                "speaker_id": "1",
                "transcription": "뒤에 딜러만 남게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.537,
                "end": 26.499
            },
            {
                "speaker_id": "1",
                "transcription": "뒤에 딜러만 남았을 때도 마찬가지 실론나이트가 남아서 딜러를 처리하는 과정으로 한방덱이 아 끝나게 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.509,
                "end": 36.357
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 상대딜러만 남게 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.367,
                "end": 38.858
            },
            {
                "speaker_id": "1",
                "transcription": "실로나이트가 이렇게 썰게 되면서 끝나게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.868,
                "end": 44.752
            },
            {
                "speaker_id": "1",
                "transcription": "되게 순식간에 끝나는 걸 볼 수가 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.762,
                "end": 49.398
            },
            {
                "speaker_id": "1",
                "transcription": "무상성급으로 끝나는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.408,
                "end": 52.648
            },
            {
                "speaker_id": "1",
                "transcription": "단 이게 약하게 지는 그림이 나오는 경우는 소르베가 있는 경우 소르베가 실론나이트를 죽이는 경우가 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.658,
                "end": 61.007
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 때문에 실론나이트는 최대한 피감을 높게끔 세팅을 해줘라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.017,
                "end": 65.300
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 상대 풀 초월 인분한테 가보도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.310,
                "end": 68.907
            },
            {
                "speaker_id": "1",
                "transcription": "자 대부분 현재 가운데가 다 가려져 있지만 한방덱으로 들어가면은 앞에 탱커들이 시작하자마자 날라가기 때문에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.917,
                "end": 76.866
            }
        ]
    },
    "summary": "화자가 실론나이트가 공격량이 가장 높게 정리하는 그림으로 마무리되는 것을 설명하고 달빛술사와 스타더스트덱에 대해 설명하고 실론나이트의 세팅에 대해서도 말한다.",
