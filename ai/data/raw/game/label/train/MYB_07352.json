        "term": [
            {
                "speaker_id": "1",
                "transcription": "얼른 잠을 자렴.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.152
            },
            {
                "speaker_id": "1",
                "transcription": "맞네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.162,
                "end": 5.582
            },
            {
                "speaker_id": "1",
                "transcription": "사다이맘 아버지 유언장은 어디 있지?",
                "sound_type": [
                    2
                ],
                "start": 5.592,
                "end": 16.068
            },
            {
                "speaker_id": "1",
                "transcription": "여기 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 16.078,
                "end": 17.834
            },
            {
                "speaker_id": "1",
                "transcription": "하 눈물나는 거 아니야 이거 또?",
                "sound_type": [
                    2
                ],
                "start": 17.844,
                "end": 21.272
            },
            {
                "speaker_id": "1",
                "transcription": "각하 사랑하는 나의 두 아들에게 작금의 정세를 보니 철왕국과의 전쟁은 피할 수 없을 것 같구나.",
                "sound_type": [
                    2
                ],
                "start": 21.282,
                "end": 33.068
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 드레이크 브레스를 되찾는다 해서 흑의 일대의 위협이 로자리아에서 사라지는 것은 아니다.",
                "sound_type": [
                    2
                ],
                "start": 33.078,
                "end": 37.898
            },
            {
                "speaker_id": "1",
                "transcription": "서둘어 계획을 진행해야만 해.",
                "sound_type": [
                    2
                ],
                "start": 37.908,
                "end": 39.763
            },
            {
                "speaker_id": "1",
                "transcription": "다만 에전의 굳건함이 사라진 지금의 로자리아에서 이 시책을 나의 대에서 나의 대에서 완수할 순 없겠지.",
                "sound_type": [
                    2
                ],
                "start": 39.773,
                "end": 46.111
            },
            {
                "speaker_id": "1",
                "transcription": "뒤를 이을 너희에게 큰 짐을 남기게 되는구나.",
                "sound_type": [
                    2
                ],
                "start": 46.121,
                "end": 48.945
            },
            {
                "speaker_id": "1",
                "transcription": "그러니 적어도 현 대공이자 아버지로서 너희 둘의 버팀목이 될 유산을 함께 남기마.",
                "sound_type": [
                    2
                ],
                "start": 48.955,
                "end": 54.054
            },
            {
                "speaker_id": "1",
                "transcription": "아 유산을 남겼구나.",
                "sound_type": [
                    2
                ],
                "start": 54.064,
                "end": 61.533
            }
        ]
    },
