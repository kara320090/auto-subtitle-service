        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 허브야 야 4초 월인데 아 나중에 마탕달고 다시 보자 수고 많았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.968
            },
            {
                "speaker_id": "1",
                "transcription": "그동안 자 과연 어떻게 될지 와 힐 차는거 봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.978,
                "end": 19.147
            },
            {
                "speaker_id": "1",
                "transcription": "방금 에소? 뱀파에 몰렸는데 아 근데 죽었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.157,
                "end": 26.429
            },
            {
                "speaker_id": "1",
                "transcription": "야 쟤 올쿨 하지 말고 아몬드 해야되겠는데? 위쪽에서는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.439,
                "end": 29.919
            },
            {
                "speaker_id": "1",
                "transcription": "야 암만 그래도 쟤 너무 힘들어 초월했으면 버텼다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.929,
                "end": 35.050
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 맞는 말이긴해 초월했으면 버틸 거 같아 근데 야 이거 좋네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.060,
                "end": 39.395
            },
            {
                "speaker_id": "1",
                "transcription": "오 굿 아몬드로 좀 가보자 네 올 아몬드로 해서 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.405,
                "end": 45.810
            },
            {
                "speaker_id": "1",
                "transcription": "피감 좀 낮긴 한데 쿨 좀 높은 상태로 가고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.820,
                "end": 49.800
            }
        ]
    },
    "summary": "화자가 올쿨 하지 말고 아몬드를 해야되겠다고 설명하고있다.",
