        "term": [
            {
                "speaker_id": "1",
                "transcription": "네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.976
            },
            {
                "speaker_id": "1",
                "transcription": "네 그 외에는 뭐 승률이 다 좋기 때문에 클로티드 덱이 전투력이 150만 대가 많거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.986,
                "end": 10.904
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 가운데가 가려져 있다 하시면은 클로티드 덱일 수 있으니까 그거 참고해 주시면 좋을 거 같아요 위 상위권 기준으로.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.914,
                "end": 19.418
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 공격 오는 것도 지금 샤벳 덱이 많죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.428,
                "end": 21.854
            },
            {
                "speaker_id": "1",
                "transcription": "지금 다 요 덱이 엄청나게 많아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.864,
                "end": 24.442
            },
            {
                "speaker_id": "1",
                "transcription": "상위권 분들 쓰는 토핑도 제가 나름 이것저것 하다가 만들었지만 대충 이런 구조인 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.452,
                "end": 30.556
            },
            {
                "speaker_id": "1",
                "transcription": "거의 뭐 무지성으로 다 들어와서 클로티드 덱 이거 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.566,
                "end": 35.521
            },
            {
                "speaker_id": "1",
                "transcription": "무지성으로 들어와서 어 승률 몇 개 다 가져가는 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.531,
                "end": 44.565
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 근데 이번에는 조금 더 잘 버티는 거 같죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.575,
                "end": 51.060
            },
            {
                "speaker_id": "1",
                "transcription": "이 휘낭시에가 잘 버티면은 이길 가능성이 큰 거 같고 네 요거는 이긴 거 같다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.070,
                "end": 63.933
            }
        ]
    },
    "summary": "화자는 상위권 기준으로 가운데가 가려져 있으면 클로티드 덱일 수 있다고 하고 공격 오는 것들이 샤벳 덱이 많으며 휘낭시에가 잘 버티면 이길 가능성이 커진다.",
