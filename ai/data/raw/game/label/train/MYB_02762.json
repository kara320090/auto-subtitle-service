        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "기존에 밀키웨이 한방덱이 왜 1탱 덱한테 쓰면 안 됐는지 허브가 있는 덱한테 쓰면 안 됐는지 먼저 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.378
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 기존의 한방덱을 쓰게 되면 이렇게 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.388,
                "end": 12.231
            },
            {
                "speaker_id": "1",
                "transcription": "자 밀키웨이, 캡틴캐비어 다 들어가고 해도 상대가 죽지 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.241,
                "end": 16.967
            },
            {
                "speaker_id": "1",
                "transcription": "다 살아 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.977,
                "end": 18.351
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 한방덱의 의미가 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.361,
                "end": 21.013
            },
            {
                "speaker_id": "1",
                "transcription": "네 오히려 제가 다 전멸을 당하는 요런 그림을 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.023,
                "end": 27.167
            },
            {
                "speaker_id": "1",
                "transcription": "완벽하게 지죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.177,
                "end": 28.453
            },
            {
                "speaker_id": "1",
                "transcription": "이건 뭐 한방덱이 요렇게 허브 맛 쿠키 하나 때문에 아예 쓰지를 못하는 상황이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.463,
                "end": 34.845
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 단 쿠키 하나만 바꿨을 뿐인데 자 한방덱이 통하는 그림을 볼 수가 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.855,
                "end": 40.517
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 상대방분은 당연히 대부분 허브를 가릴 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.527,
                "end": 43.487
            },
            {
                "speaker_id": "1",
                "transcription": "허브가 없으면 땡 큐고 허브가 있어도 이제 한방덱이 통할 수 있는 그림이 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.497,
                "end": 49.079
            },
            {
                "speaker_id": "1",
                "transcription": "2탱한테는 들어가면 안 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.089,
                "end": 50.854
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱은 지금 2탱한테는 들어가지 마시고 1탱한테만 들어가시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.864,
                "end": 56.283
            },
            {
                "speaker_id": "2",
                "transcription": "내 활이 되어주렴.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.293,
                "end": 57.916
            },
            {
                "speaker_id": "3",
                "transcription": "무럭무럭 자라라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.926,
                "end": 59.840
            },
            {
                "speaker_id": "1",
                "transcription": "자 보이시나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.850,
                "end": 63.166
            }
        ]
    },
    "summary": "남성은 기존의 한방덱이 1탱 덱과 허브가 있는 덱한테 쓰면 안 되는지 게임을 하면서 설명해 주고 있다.",
