        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "유행 따라가면은 별사탕이 너무 부족한데 어떡하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.651
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.661,
                "end": 3.604
            },
            {
                "speaker_id": "1",
                "transcription": "아니 지금 최고의 덱이라고 요렇게 있는데 내가 이걸 보고 완성시키고 키울 때까지는 2 3달 걸려요 최소.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.614,
                "end": 10.282
            },
            {
                "speaker_id": "1",
                "transcription": "근데 완성시켰더니만 이미 얘네들이 다 나락 갔어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.292,
                "end": 13.259
            },
            {
                "speaker_id": "1",
                "transcription": "막 클로티드 같이 안 쓰여.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.269,
                "end": 14.985
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 엄청나게 손해 같잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.995,
                "end": 16.476
            },
            {
                "speaker_id": "1",
                "transcription": "근데 킹덤은 돌고 돌읍니 돌아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.486,
                "end": 19.351
            },
            {
                "speaker_id": "1",
                "transcription": "이 안 쓰이던 게 다음 업데이트 되면 또다시 튀어나와 가지고 다시 메인으로 쓰기도 해서 보통 0티어를 보고 키우는 게 맞아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.361,
                "end": 26.135
            },
            {
                "speaker_id": "1",
                "transcription": "원래 티어 자체가 0티어 얘들은 웬만해선 그렇게 크게 안 떨어져서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.145,
                "end": 32.866
            }
        ]
    },
    "summary": "유행따라 가려면 별사탕이 부족하다고 느끼시는 분들도 계시지만 킹덤은 업데이트되면 다시 쓰이기 때문에 0티어를 보고 키우는 게 맞습니다.",
