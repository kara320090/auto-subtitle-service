        "term": [
            {
                "speaker_id": "1",
                "transcription": "내가 잘못 보는 거 아니지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.732
            },
            {
                "speaker_id": "1",
                "transcription": "야 헛방 지금 다 나는 거 아 야 부계정한테 졌어",
                "sound_type": [
                    2,
