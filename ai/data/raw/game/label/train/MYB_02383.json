                    2
                ],
                "start": 12.649,
                "end": 13.890
            },
            {
                "speaker_id": "1",
                "transcription": "아 잠시만 뭐 잘못된 거 아니야?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.900,
                "end": 15.985
            },
            {
                "speaker_id": "1",
                "transcription": "와 이건 좀 너무하잖아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.995,
                "end": 17.991
            },
            {
                "speaker_id": "1",
                "transcription": "아 잠깐만 내가 뭐 잘못 설정했나?",
                "sound_type": [
