    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "대난투에서 진짜 좋은데요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.563
            },
            {
                "speaker_id": "1",
                "transcription": "야 쓰잘데기 있어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.573,
                "end": 3.036
            },
            {
                "speaker_id": "1",
                "transcription": "방금 느리게 보니까 완벽해.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.046,
                "end": 5.723
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 정리를 해 봅시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.733,
                "end": 10.239
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 아레나에서는 솔직히 말해서 저는 아 활용 가치가 높다고는 말 못 하겠어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.249,
                "end": 16.241
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 현재 아레나 구조는 서로 폭딜 싸움이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.251,
                "end": 19.498
            },
            {
                "speaker_id": "1",
                "transcription": "누가 누가 광역 딜로 상대 딜러를 먼저 죽이냐 싸움이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.508,
                "end": 23.338
            },
            {
                "speaker_id": "1",
                "transcription": "근데 샤벳상어 타깃 대상은 전방입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.348,
                "end": 26.250
            },
            {
                "speaker_id": "1",
                "transcription": "게다가 코랄은 잘 죽지도 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.260,
                "end": 28.378
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 코랄을 죽이려면은 최소 3방은 때려야 돼.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.388,
                "end": 31.855
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 스킬 낭비를 3번이나 할 동안 나머지 딜러들은 얘네들한테 폭격을 가해서 내 딜러가 죽어납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.865,
                "end": 38.587
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 샤벳을 코랄 죽이는데 3번이나 낭비를 해야 될까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.597,
                "end": 42.708
            },
            {
                "speaker_id": "1",
                "transcription": "저는 그게 좀 의문이 들고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.718,
                "end": 44.422
            },
            {
                "speaker_id": "1",
                "transcription": "차라리 샤벳 대신에 다른 스타더스트나 광역 딜러를 넣어서 상대 딜러를 죽이는 게 더 효율적이지 않나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.432,
                "end": 50.653
            },
            {
                "speaker_id": "1",
                "transcription": "물론 상대가 투탱을 쓰거나 실론나이트를 쓰거나 뭐 그런 덱한테 저격용으로는 좋겠지만 요새 그런 덱은 거의 존재하지가 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.663,
                "end": 59.928
            },
            {
                "speaker_id": "1",
                "transcription": "대부분 다 코랄 덱이기 때문에 이 코랄 덱한테 비효율적으로 샤벳을 쓴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.938,
                "end": 64.840
            },
            {
                "speaker_id": "1",
                "transcription": "저는 너무 낭비지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.850,
                "end": 66.567
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 생각이 들고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.577,
                "end": 67.759
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 대난투에서 만큼은 아까 본 것처럼 실론 덱 저격으로는 최고다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.769,
                "end": 72.784
            },
            {
                "speaker_id": "1",
                "transcription": "대난투에서 이렇게 물속성 덱으로 오징어먹물 자리 대신에 들어가면 최고의 덱으로 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.794,
                "end": 78.888
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 마탕은 이렇게 리뷰를 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.898,
                "end": 98.306
            }
        ]
    },
    "summary": "남성이 아레나에서는 낭비라고 생각하지만 대난투에서는 물속성 덱으로 들어가면 실론 덱 저격하는 최고의 덱으로 쓸 수 있다고 하며 리뷰를 마친다.",
