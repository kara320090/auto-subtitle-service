                ],
                "start": 0.000,
                "end": 5.414
            },
            {
                "speaker_id": "1",
                "transcription": "한 1.2배 아 생각보다 뭐 어마 무시하게 커지는 느낌은 아니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.424,
                "end": 11.263
            },
            {
                "speaker_id": "1",
                "transcription": "아 네 그러면 한번 음 무공비급 대신에 넣어서 한 번 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.273,
                "end": 17.654
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 진짜 쓸모가 있는지 한 번 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.664,
                "end": 20.872
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 뭐 사실상 예능 보물입니다.",
                "sound_type": [
                    2,
