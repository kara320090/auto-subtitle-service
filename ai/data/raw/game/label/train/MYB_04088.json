        "term": [
            {
                "speaker_id": "1",
                "transcription": "연속으로 쫙 다 빼주고 이 분홍 색깔 빼기가 좀 힘들 거 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.255
            },
            {
                "speaker_id": "1",
                "transcription": "지금 뒤에 거의 아예 안 보이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.265,
                "end": 6.164
            },
            {
                "speaker_id": "1",
                "transcription": "이럴 때는 어쩔 수 없네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.174,
                "end": 8.276
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 걷어냅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.286,
                "end": 9.684
            },
            {
                "speaker_id": "1",
                "transcription": "네 걷어내면서 진행을 좀 해주면서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.694,
                "end": 13.188
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 배추를 걷어내면서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.198,
                "end": 16.084
            },
            {
                "speaker_id": "1",
                "transcription": "이 분홍 색깔이 지금 엄청나게 큰 트롤을 하고 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
