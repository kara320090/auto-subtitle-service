        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "소환덱도 이렇게 이기는 그림이 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.064
            },
            {
                "speaker_id": "1",
                "transcription": "증표 안 빠졌죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.074,
                "end": 4.456
            },
            {
                "speaker_id": "1",
                "transcription": "근데도 이기는 그림 자 이런 그림이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.466,
                "end": 7.289
            },
            {
                "speaker_id": "1",
                "transcription": "흑당이 아주 메인 포인트다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.299,
                "end": 9.373
            },
            {
                "speaker_id": "1",
                "transcription": "지금 현재 제가 보는 그림에서는 2212 뱀파덱에서 뒤에가 잘 릴 때가 좀 위험하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.383,
                "end": 15.496
            },
            {
                "speaker_id": "1",
                "transcription": "자 참고로 용구덱에서 절대 들어가지 않아야 하는 원래 덱이 뭐였냐 하면은 이 와베랑 휘상신이 쓴 이 단단한 덱 투탱 있을 때는 웬만해서 들어가면 안됐었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.506,
                "end": 25.953
            },
            {
                "speaker_id": "1",
                "transcription": "저희 버티는 덱이 많았기 때문에 근데 한번 봐 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.963,
                "end": 29.486
            },
            {
                "speaker_id": "1",
                "transcription": "신규 용구덱은 뚫을 수 있는지 보통 왜 갑자기 용구덱이 떴나 이게 왜냐하면 이번 신규 레전드 출시 이후에 보통 올 아몬드 대 그런 메타에서 이제 올쿨이나 라즈 섞는 덱으로 좀 바뀌었거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.496,
                "end": 44.376
            },
            {
                "speaker_id": "1",
                "transcription": "그런 의미 때문에 다시 용구가 부활한 게 아닌가 그렇게 보여 집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.386,
                "end": 50.187
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기도 자 아직까지는 모르겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.185,
                "end": 53.904
            },
            {
                "speaker_id": "1",
                "transcription": "역시 와베덱이 단단하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.914,
                "end": 56.050
            },
            {
                "speaker_id": "1",
                "transcription": "역시 단단해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.050,
                "end": 60.133
            }
        ]
    },
    "summary": "소환은 이기는 그림이 나오고 흑당이 아주 메인 포인트이며 참고로 용구덱에서 절대 들어가지 않아야 하는 덱은 와베랑 휘상신이 쓴 단단한 덱이 있으면 들어가지 말아야 한다.",
