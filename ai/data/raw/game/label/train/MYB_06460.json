                ],
                "start": 0.000,
                "end": 15.151
            },
            {
                "speaker_id": "1",
                "transcription": "좋아요. 개구리 아닌데? 귀신인데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.161,
                "end": 23.897
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 저거? 귀신이야.",
