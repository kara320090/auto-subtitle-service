                    2,
                    3,
                    5
                ],
                "start": 23.907,
                "end": 45.477
            },
            {
                "speaker_id": "1",
                "transcription": "이 빛을 비추면 못 오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.487,
                "end": 56.169
            },
            {
                "speaker_id": "1",
                "transcription": "몸통 박치기는 안 하면 안 하는 게 낫지 않을까요 가까워 지면 바로 공격할 거 같은데.",
