        "term": [
            {
                "speaker_id": "1",
                "transcription": "달빛 초대박 이렇게 마무리짓고 창고 좀 봐달라고요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.082
            },
            {
                "speaker_id": "1",
                "transcription": "아 뭐야 이거?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.262,
                "end": 3.850
            },
            {
                "speaker_id": "1",
                "transcription": "잘 모으셨네.",
                "sound_type": [
                    2
                ],
                "start": 4.029,
                "end": 5.029
            },
            {
                "speaker_id": "1",
                "transcription": "어 나 재고 봐 376이네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.039,
                "end": 7.987
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이거 이렇게까지 이렇게 모으시는 이유가 대무역 데브가 잘못했네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.997,
                "end": 13.947
            },
            {
                "speaker_id": "1",
                "transcription": "아니 데브 관계자분들 대무역 지금 목 빠지게 기다리는 분들이 현재 재고 상태가 이렇습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.567,
                "end": 19.915
            },
            {
                "speaker_id": "1",
                "transcription": "야 쿠치아 뭐 천 개나 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.677,
                "end": 23.245
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 뽑기 마무리 지을게요.",
                "sound_type": [
                    2,
                    3
                ],
