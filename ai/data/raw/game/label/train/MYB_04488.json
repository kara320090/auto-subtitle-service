        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 소누님 계정 평가 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.430
            },
            {
                "speaker_id": "1",
                "transcription": "일단 보낸 사연 올해 1월부터 시작했습니다 왕국 운영은 무엇이 문제인지 과금 나름 많이 했고 한 200만 원 정도 과금을 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.430,
                "end": 12.024
            },
            {
                "speaker_id": "1",
                "transcription": "그럼에도 별사탕이 없어서 쿠키 육성 포기했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.034,
                "end": 15.050
            },
            {
                "speaker_id": "1",
                "transcription": "70만렙 단 하나도 안 했습니다 이유는 키워놓으면 다음 업뎃되면 나락가는 데 뭣하러 끝까지 키워라는 생각이 자꾸 들어서 스트레스 받고 현타가 너무 심합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.060,
                "end": 25.545
            },
            {
                "speaker_id": "1",
                "transcription": "사실 작년 출시 때부터 했는데 이러한 현타 때문에 현질해 왔던 계정도 3번에서 4번이나 탈퇴하고 지금 계정에 정착하여서 과금이며 시간 모든 것을 투자 부었음에도 토벌이나 아레나, 상점 등 제대로 잘하는게 없다고 느껴집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.545,
                "end": 41.858
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 코인은 왜 맨날 부족한지 모르겠습니다 제발 저의 생각이나 마인드가 무엇이 잘못됐는지 설명을 해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.868,
                "end": 49.303
            },
            {
                "speaker_id": "1",
                "transcription": "알겠습니다 자 바로 갈게요 자 한 번 쿠키 스펙 아오 진짜 70렙은 하나도 안 찍으셨네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.313,
                "end": 55.127
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거는 이건 일부로 안 찍으신거 아닌가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.127,
                "end": 57.887
            },
            {
                "speaker_id": "1",
                "transcription": "난 이렇게 또 69렙을 이렇게 다 맞추신 분은 또 처음보네 일단 알겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.897,
                "end": 65.500
            }
        ]
    },
    "summary": "소누님은 사실 작년 출시 때부터 했는데 현타 때문에 현질해 왔던 계정도 3번에서 4번이나 탈퇴하고 지금 계정에 정착하여서 과금이며 시간 모든 것을 투자 부었음에도 토벌이나 아레나, 상점 등 제대로 잘하는게 없다고 느껴지는데 무엇이 잘못됐건지 궁금하다.",
