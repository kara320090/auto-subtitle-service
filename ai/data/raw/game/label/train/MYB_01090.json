            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 리뷰 이렇게 24강도 리뷰를 해봤고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.139
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 결론만 따지면은 바다요정도 30강 되면은 어마무시하게 셀 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.149,
                "end": 9.342
            },
            {
                "speaker_id": "1",
                "transcription": "이거보다는 블랙펄이 더 활용가치가 더 좋을 거 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.352,
                "end": 12.983
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄의 피해감소가 진짜 더 사기적인 느낌이긴 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.993,
                "end": 17.188
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정은 정말 세팅하기가 활용하기가 아레나에선 너무 제한적이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.198,
                "end": 21.627
            },
            {
                "speaker_id": "1",
                "transcription": "너무 물몸이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.637,
                "end": 23.116
            },
            {
                "speaker_id": "1",
                "transcription": "용과 브레스에 아직도 쉽게 잘 죽는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.126,
                "end": 26.293
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 강화하는데 영혼의 조각 이거 표를 보시면 아시겠지만 이거 추정치거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.293,
                "end": 32.282
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄하고 둘 다 키우기에는 여러분들 너무나 많은 재화가 소모되고 그러기 때문에 선택적으로 여러분들 하나만 골라서 집중적으로 파밍을 해야되지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.292,
                "end": 41.319
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 저는 유튜버다 보니까 둘 다 비교를 해서 여러분들한테 어떤 게 더 좋을지 앞으로도 비교해서 보여드릴 거지만 여러분들은 잘 선택해서 집중적으로 투자하면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.329,
                "end": 55.426
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다요정 24강 잼스톤 리뷰는 여기서 마치겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.426,
                "end": 68.000
            }
        ]
    },
    "summary": "결론만 따지면은 바다요정도 30강 되면은 세겠지만 블랙펄이 더 활용가치가 좋을 거 같고 바다요정은 아레나에선 활용하기 너무 제한적이고 블랙펄과 바다요정을 둘 다 키우기엔 많은 재화가 소모되기 때문에 선택적으로 집중적으로 투자하면 좋을 거 같다.",
