        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 어뜩하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.963
            },
            {
                "speaker_id": "1",
                "transcription": "왜 이렇게 웃기지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.973,
                "end": 1.981
            },
            {
                "speaker_id": "1",
                "transcription": "궁금하다 이 대사 쓴 사람",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.991,
                "end": 4.417
            },
            {
                "speaker_id": "2",
                "transcription": "왜 저택에선 요리의 백설과를 사용하지 않는 거지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.427,
                "end": 9.509
            },
            {
                "speaker_id": "3",
                "transcription": "노예 신분이면서 저택의 식사에 불만을 표시하는 겁니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.519,
                "end": 13.725
            },
            {
                "speaker_id": "2",
                "transcription": "불만은 없어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.735,
                "end": 14.882
            },
            {
                "speaker_id": "2",
                "transcription": "저택의 식사는 충분히 수준이 높으니까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.892,
                "end": 17.603
            },
            {
                "speaker_id": "3",
                "transcription": "백설과는 저택에서 조달하는 식량에 비해 질이 떨어집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.613,
                "end": 21.128
            },
            {
                "speaker_id": "3",
                "transcription": "그뿐입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.138,
                "end": 22.274
            },
            {
                "speaker_id": "2",
                "transcription": "저택에서 이미 밥을 먹어본 것처럼 얘기하네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.284,
                "end": 24.974
            },
            {
                "speaker_id": "2",
                "transcription": "아직 마을에 한번도 안 내려갔는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.984,
                "end": 28.833
            }
        ]
    },
    "summary": "저택에서는 요리에 백설과를 사용하지 않고 저택에서 조달하는 식량에 비해 질이 떨어지기 때문이라고 합니다.",
