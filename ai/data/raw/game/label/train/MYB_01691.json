        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 자 이렇게 죽으면은 다시 하기는 태초로 가는 거고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.225
            },
            {
                "speaker_id": "1",
                "transcription": "부활하기 눌러서 이어서 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.235,
                "end": 7.358
            },
            {
                "speaker_id": "1",
                "transcription": "부활은 총 5번 자 요렇게 부활 죽지 않고만 가면 돼.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.368,
                "end": 12.271
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기서 떨어졌네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.281,
                "end": 14.053
            },
            {
                "speaker_id": "1",
                "transcription": "자 한 번 더 자 거의 끝이 와요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.063,
                "end": 18.295
            },
            {
                "speaker_id": "1",
                "transcription": "자 거의 다 왔어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.305,
                "end": 19.624
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 최종 스테이지까지 클리어 최종 클리어하면 크리스털과 코인 많이 얻을 수가 있습니다.",
                "sound_type": [
                    2,
