        "term": [
            {
                "speaker_id": "1",
                "transcription": "쓸데없이 혼자 계속 멋있네.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.205
            },
            {
                "speaker_id": "1",
                "transcription": "뭔데. 아니 쓸데없이 자꾸 멋있는 장면 보여줄거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.215,
                "end": 11.386
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 남자는 죽어도 멋이긴 하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.396,
                "end": 15.501
            },
            {
                "speaker_id": "1",
                "transcription": "이동. 멋 빼면 시체네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.511,
                "end": 18.774
            },
            {
                "speaker_id": "1",
                "transcription": "이거 생겼다. 맵에 이거 생겼다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.784,
                "end": 23.257
            },
            {
                "speaker_id": "1",
                "transcription": "아까 만들어 놓은 거 이거 고드름.",
                "sound_type": [
                    2,
