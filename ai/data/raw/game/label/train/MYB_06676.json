        "term": [
            {
                "speaker_id": "1",
                "transcription": "어우워 아 목 따면 괴물 나오는 게 근데 되게 잘 만들지 않았어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.163
            },
            {
                "speaker_id": "1",
                "transcription": "나 되게 의외야 지금 너무 재밌어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.173,
                "end": 8.002
            },
            {
                "speaker_id": "1",
                "transcription": "나 이런 거 좋아했나 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.012,
                "end": 10.118
            },
            {
                "speaker_id": "1",
                "transcription": "이대로 야 우리 이거 이렇다면은 이대로 뭐지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.128,
                "end": 15.494
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 그 뭐야 그거 인디 게임주 끝나면 환세취호전 놓고?",
