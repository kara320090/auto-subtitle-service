        "term": [
            {
                "speaker_id": "1",
                "transcription": "빨간 모자 야 그러면 그건가 보네 여러분.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.784
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보니까 동화를 재해석했을 수도 있잖아요 어떤 챕터는.",
                "sound_type": [
                    2
                ],
                "start": 2.794,
                "end": 8.387
            },
            {
                "speaker_id": "1",
                "transcription": "그런 거보면은 빨간 모자 얘기도 있나 보네.",
                "sound_type": [
                    2
                ],
                "start": 8.397,
                "end": 11.213
            },
            {
                "speaker_id": "1",
                "transcription": "어 빨간 모자 늑대도 있나 봐.",
                "sound_type": [
                    2
                ],
                "start": 11.223,
                "end": 13.203
            },
            {
                "speaker_id": "1",
                "transcription": "우리가 그렇게 유추할 수 있겠네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.213,
                "end": 15.092
            },
            {
                "speaker_id": "1",
                "transcription": "백설공주가 있었고 빨간 모자가 있었고 그렇지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.102,
                "end": 18.277
            },
            {
                "speaker_id": "1",
                "transcription": "동화 컨셉인가 봐. 야 게임 갓 게임이네 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.287,
                "end": 22.233
            }
        ]
    },
    "summary": "여성이 동화 컨셉의 게임이라고 이야기한다.",
