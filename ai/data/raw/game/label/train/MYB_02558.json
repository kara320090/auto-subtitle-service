        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스로서 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.875
            },
            {
                "speaker_id": "1",
                "transcription": "방치형 모바일 게임을 편하게 모니터링 가능하며 핸드폰 발열이나 배터리 부족으로 인한 불편함도 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.885,
                "end": 8.205
            },
            {
                "speaker_id": "1",
                "transcription": "PC에서 큰 화면에 초고화질로 몰입할 수 있는 녹스애플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.215,
                "end": 12.372
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 하시는 분들은 아시겠지만 정말 치명타 전쟁이거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.382,
                "end": 16.482
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 폭딜이 들어가서 상대 쿠키를 죽이거나 못 죽이거나 요 싸움이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.492,
                "end": 22.523
            },
            {
                "speaker_id": "1",
                "transcription": "상대 쿠키를 못 죽이면 내 쿠키가 죽습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.533,
                "end": 25.384
            },
            {
                "speaker_id": "1",
                "transcription": "정말 딜 전쟁이기 때문에 여러분들 공격력과 치명타를 높여주는 거 상당히 중요해졌기 때문에 이렇게 세팅 잘 해주시면 좋고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.394,
                "end": 35.435
            },
            {
                "speaker_id": "1",
                "transcription": "지금도 보시는 것 같이 그냥 서로 정신 없어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.445,
                "end": 39.313
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 폭딜을 누가 더 잘 견디냐 그런 게 정말 중요한 요소가 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.323,
                "end": 45.047
            },
            {
                "speaker_id": "2",
                "transcription": "얼얼함의 마음을 보여주지",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.057,
                "end": 46.866
            }
        ]
    },
    "summary": "쿠키런 킹덤은 치명타 폭딜이 들어가서 상대 쿠키를 죽이거나 못 죽이거나의 싸움이다.",
