        "term": [
            {
                "speaker_id": "1",
                "transcription": "올 라즈로 세팅했을 때 캡사이신이 막아낸 기록들입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.875
            },
            {
                "speaker_id": "1",
                "transcription": "네 다양한 덱들을 다 막을 수 있어서 상당히 좋고 여러분들이 따라하실 분은 중요한 포인트가 하나 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.885,
                "end": 12.087
            },
            {
                "speaker_id": "1",
                "transcription": "이 호루라기가 올 라즈로 얘를 하게 되면 이 호루라기가 얘한테 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.097,
                "end": 18.294
            },
            {
                "speaker_id": "1",
                "transcription": "어 캡사이신 하고 달빛술사한테 간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.304,
                "end": 20.846
            },
            {
                "speaker_id": "1",
                "transcription": "요런데 확인할 때 공격력을 보게 되면 10만 6이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.856,
                "end": 24.325
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 캡사이신은 공격력이 10만 6000이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.335,
                "end": 27.594
            }
        ]
    },
    "summary": "따라하실 분은 중요한 포인트가 하나 있는데 이 호루라기가 올 라즈로 하게 되면 호루라기가 캡사이신 하고 달빛술사한테 간다.",
