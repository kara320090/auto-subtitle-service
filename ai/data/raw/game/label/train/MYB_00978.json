        "term": [
            {
                "speaker_id": "1",
                "transcription": "실론나이트 한방덱 같은 경우에는 보통 도넛을 쓰는데 도넛 없이 정말 극딜을 사용해서 한방덱 구성을 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.019
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 과전류를 이용한 조합이 많이 나오고 있는데 그거에다가 실론나이트까지 결합한 정말 천재적인 조합인 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.029,
                "end": 16.475
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이미 활용을 해봤는데 정말 승률도 좋고 파괴력이 장난이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.485,
                "end": 21.482
            },
            {
                "speaker_id": "1",
                "transcription": "일단 세팅부터 보게 되면 실론나이트 같은 경우에는 피해감소 가장 많이 신경 써 주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.492,
                "end": 27.392
            },
            {
                "speaker_id": "1",
                "transcription": "공격속도는 3순위로 주면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.402,
                "end": 30.232
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 공격력과 치명타 확률 주시면 되고 망토 보물 같은 경우에는 1순위 2순위를 레모네이드랑 샤글한테 주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.242,
                "end": 39.351
            },
            {
                "speaker_id": "1",
                "transcription": "블랙레모네이드는 그냥 올 쿨 세팅을 해주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.361,
                "end": 42.876
            },
            {
                "speaker_id": "1",
                "transcription": "부옵션 더 따로 안 챙기셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.886,
                "end": 45.314
            },
