                ],
                "start": 4.376,
                "end": 7.893
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 되면 돼요 완품 하나 더 나오고 조각으로 하면 돼요.",
                "sound_type": [
                    2,
