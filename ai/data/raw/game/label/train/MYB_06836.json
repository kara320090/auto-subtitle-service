        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 알았어.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.920
            },
            {
                "speaker_id": "1",
                "transcription": "아 오케이 아 하이파이브 했어.",
                "sound_type": [
                    2
                ],
                "start": 0.930,
                "end": 12.474
            },
            {
                "speaker_id": "1",
                "transcription": "왜 안 돼?",
                "sound_type": [
                    2
                ],
                "start": 12.484,
                "end": 14.033
            },
            {
                "speaker_id": "2",
                "transcription": "음 이 경쾌한 소리 드디어 깨어났구나.",
                "sound_type": [
                    2
                ],
                "start": 14.043,
                "end": 18.243
            },
            {
                "speaker_id": "2",
                "transcription": "여기도 없었다고 하면 잽싸게 다음 구역으로 넘어가려고 했거든 아직 움직임이 어설퍼 보이네 잠 좀 깨야겠어.",
                "sound_type": [
                    2
                ],
                "start": 18.253,
                "end": 26.084
            },
            {
                "speaker_id": "2",
                "transcription": "하이파이브를 할 때는 항상 손에 집중해야 해.",
                "sound_type": [
                    2
                ],
                "start": 26.094,
                "end": 29.465
            },
            {
                "speaker_id": "2",
                "transcription": "한번 뻗은 손은 언젠가는 돌아와야만 하니까 말이야.",
                "sound_type": [
                    2
                ],
                "start": 29.475,
                "end": 32.645
            },
            {
                "speaker_id": "2",
                "transcription": "그 손에 주인은 그 누구도 아닌 너뿐이라는 걸 항상 명심해.",
                "sound_type": [
                    2
                ],
                "start": 32.655,
                "end": 37.254
            },
            {
                "speaker_id": "1",
                "transcription": "한 손 한 번 갔다가 한 번에 돌아올 수 있어야 된다는 이야기인 것 같아.",
                "sound_type": [
                    2
                ],
                "start": 37.264,
                "end": 42.833
            }
        ]
    },
    "summary": "여성이 게임을 하는 방법에 대해서 이야기한다.",
