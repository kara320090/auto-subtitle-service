        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 근데 잘 버틴다 이거를",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.859
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거를 설마 버티니?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.869,
                "end": 3.591
            },
            {
                "speaker_id": "1",
                "transcription": "아 못 버텼네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.601,
                "end": 6.700
            },
            {
                "speaker_id": "1",
                "transcription": "딜러가 터져 버려 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.710,
                "end": 10.427
            },
            {
                "speaker_id": "1",
                "transcription": "라즈베리 4 아몬드 1 쿨 5쿨 이렇게 해 봤는데 덱에 따라서 지금 세팅이 다 다르겠지만 올 쿨로 하니까 너무 빨리 죽는 경우가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.437,
                "end": 20.468
            },
            {
                "speaker_id": "1",
                "transcription": "1분 지나서 터지는 경우가 좀 있고 4아몬드 1쿨도 터지는 경우가 있긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.478,
                "end": 24.771
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이상하게 라즈베리가 오히려 더 안 죽었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.781,
                "end": 28.091
            },
            {
                "speaker_id": "1",
                "transcription": "세팅이나 상대방 덱에 따라 다르기 때문에 덱은 제가 최적화된 덱이 나오면은 그때 다시 올려드리도록 하겠습니다 세팅은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.101,
                "end": 37.155
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 달빛술사 영성이라도 키워야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.165,
                "end": 39.342
            },
            {
                "speaker_id": "1",
                "transcription": "티어가 얼마인가요 이렇게 물어보신다면은 압도적인 0티어입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.352,
                "end": 43.346
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄이 나왔을 때 그 이상에 느낌의 사기적인 쿠키이기 때문에 반드시 키워야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.356,
                "end": 49.399
            },
            {
                "speaker_id": "1",
                "transcription": "그런 핵심 쿠키가 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.409,
                "end": 51.784
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛술사 리뷰는 여기서 마칠게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.794,
                "end": 67.166
