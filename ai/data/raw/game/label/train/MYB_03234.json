        "term": [
            {
                "speaker_id": "1",
                "transcription": "쓸 일이 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.092
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 깔끔하게 분해를 해 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.372,
                "end": 5.202
            },
            {
                "speaker_id": "1",
                "transcription": "아 지금 해효감이랑 이효증은 분해해도 되나요라고 물어보셨는데 아시고 분해하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.502,
                "end": 11.790
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 석류맛 쿠키의 공격력 증가 버프 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.217,
                "end": 14.445
            },
            {
                "speaker_id": "1",
                "transcription": "그런 버프의 길이가 증가됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.852,
                "end": 16.617
            },
            {
                "speaker_id": "1",
                "transcription": "또는 힐러가 힐을 해 주면은 받는 힐량 자체가 증가됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.930,
                "end": 20.872
            },
            {
                "speaker_id": "1",
                "transcription": "해로운 효과 같은 경우에는 디버프가 시간이 짧아집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.227,
                "end": 25.155
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소가 뭐 5퍼센트 갔는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.452,
                "end": 28.250
            }
        ]
    },
    "summary": "쓸 일이 단 하나도 없는 것은 깔끔하게 분해를 하고 해효감이랑 이효증은 분해하면 석류맛 쿠키의 공격력 증가 버프의 길이가 증가되고 힐러가 힐을 해 줄 때 받는 힐량 자체가 증가하지만 디버프 시간이 짧아진다.",
