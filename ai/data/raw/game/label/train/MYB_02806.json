        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이거 너무 좋은데 아 여러분들 이거 뭡니까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.150
            },
            {
                "speaker_id": "1",
                "transcription": "야 큰일 났다 이거. 진짜 좋다 덱.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.160,
                "end": 9.645
            },
            {
                "speaker_id": "1",
                "transcription": "와 이 스타더스트가 출시된 거는 블루 파이랑 같이 써서 시너지 좋게 써라. 그리고 소르베나 딜러를 저격해서 죽여라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.655,
                "end": 20.380
            },
            {
                "speaker_id": "1",
                "transcription": "약간 이런 목적으로 나왔고 이 덱이 정말 좋네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.390,
                "end": 24.501
            },
            {
                "speaker_id": "1",
                "transcription": "내 요 덱 1번 여러분들 세팅해서 해보시는 것도 나쁘지 않을 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.511,
                "end": 28.305
            },
            {
                "speaker_id": "1",
                "transcription": "일단 홀리베리는 4 아몬드 1 쿨 그다음에 블루 파이는 5 라즈베리 그리고 스타더스트는 5 애플젤리 제가 볼 때 포인트는 쿨 공속이 따로 필요 없고 피감, 공치 높게 그리고 얘 같은 경우에는 무조건 치명타 확률 얘랑 나머지 다 필요없고 치명타 확률 달빛은 5라즈 썼구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.315,
                "end": 48.390
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 쿨타임은 높으면 좋을 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.400,
                "end": 50.225
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 어 퓨바는 4아몬드 1쿨 요렇게 썼습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.235,
                "end": 54.527
            },
            {
                "speaker_id": "1",
                "transcription": "요게 정말 어마무시하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.537,
                "end": 57.658
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 해서 네 스타더스트 리뷰는 마치도록 하겠습",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.668,
                "end": 63.012
            }
        ]
    },
