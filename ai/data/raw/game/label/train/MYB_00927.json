        "term": [
            {
                "speaker_id": "1",
                "transcription": "귀여운 딜 자 이렇게 중국 킹덤 벨벳 토벌 3번 끝.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.568
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 약간 아레나 대환장 파티도 지금 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.578,
                "end": 13.632
            },
            {
                "speaker_id": "1",
                "transcription": "자 중국 킹덤 아레나 보면 한국 킹덤이랑 완전 다르죠 대환장 파티입니다 지금",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.642,
                "end": 20.860
            },
            {
                "speaker_id": "1",
                "transcription": "별의 별 쿠키가 되게 많다 칠리도 보이고요 허브도 보이고요 근데 진짜 현재 들리는 소문에는 이 웨어울프가 진짜 어마무시하게 사기다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.870,
                "end": 32.623
            },
            {
                "speaker_id": "1",
                "transcription": "블랙레이즌도 사기다 진짜 본섭이면은 한국섭이면은 첫날에 에피소드 9, 10까지 가는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.633,
                "end": 40.150
            },
            {
                "speaker_id": "1",
                "transcription": "야 이게 차이가 이렇게까지 나네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.160,
                "end": 42.214
            },
            {
                "speaker_id": "1",
                "transcription": "고기 젤리가 너무 부족하다 아 에피 챕터 6까지만 있고 챕터 7은 8월 30일에 열려요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.224,
                "end": 49.985
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜요 아 이거 하자 에픽 확정",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.995,
                "end": 55.066
