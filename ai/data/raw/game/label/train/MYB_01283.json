        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 무료료 크리스탈 무지개 큐브 얻는 방법이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.067
            },
            {
                "speaker_id": "1",
                "transcription": "이번 영상에서는 어떻게 얻는지 그리고 제가 따로 무지개 큐브 3000개 이벤트도 진행을 하니까 영상 끝까지 시청해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.077,
                "end": 12.665
            },
            {
                "speaker_id": "1",
                "transcription": "자 브릭시티라는 신작 게임이 데브시스터즈에서 나오게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.675,
                "end": 17.533
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기 사전 예약하기가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.543,
                "end": 19.724
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 휴대폰 번호 입력하고 사전 예약을 하게 되면 사전 예약자 특전이라고 해서 누적 보상을 통해서 도면 크리에이터 매기에서 받을 수가 있구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.734,
                "end": 30.530
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 브릭시티 보상과 쿠키런 보상, 킹덤과 오븐 브레이크 보상을 여러분들 선택해서 받을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.540,
                "end": 38.447
            },
            {
                "speaker_id": "1",
                "transcription": "크리스탈 1500개, 무지개 큐브 500개 자 그리고 사전예약자 특전 두 번째 피포 우주 항공권 발급 시뮬레이터 자 얼리 엑세스 지원하기도 있구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.457,
                "end": 49.680
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 혜택은 여러분들 누구보다 먼저 뜯을 권 뭐 선물 크리에이터만 누릴 수 있는 특권도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.690,
                "end": 56.314
            },
            {
                "speaker_id": "1",
                "transcription": "자 브릭시티같은 경우에 어떤 게임이냐 자 영상 같이 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.324,
                "end": 60.899
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 킹덤처럼 왕국 운영하는 느낌이긴 하지만 가 블럭으로 된 그런 게임 같죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.909,
                "end": 70.415
            },
            {
                "speaker_id": "1",
                "transcription": "캐릭터들도 다양하고 네 건물 짓고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.425,
                "end": 78.600
            }
        ]
    },
