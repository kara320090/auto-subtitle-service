        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 저 네 운석 떨어지기 전에 밀키웨이 스킬 쓰는지 요거 되게 중요한 포인트거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.165
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 밀리면은 딜이 몇천만 딜이 떨어지기 때문에 여러분들 연습할 때 요고 체크해 놨다가 밀리는지 한 번 꼭 체크해 보세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.175,
                "end": 12.196
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 스킬 밀리지 말고 바로바로 스킬 써 주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.206,
                "end": 18.160
            },
            {
                "speaker_id": "1",
                "transcription": "그다음부터는 밀리지 말고 계속 계속 바로 써 주고 에클리어가 죽는 거는 치명타 터져서 어 터지는 거니까 네 굳이 신경 안 써 주셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.170,
                "end": 29.069
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 해서 잡히는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.079,
                "end": 32.265
            },
            {
                "speaker_id": "1",
                "transcription": "71단계가 이렇게 잡히는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.275,
                "end": 36.340
            },
            {
                "speaker_id": "1",
                "transcription": "5억 6,800 요런 어마무시한 딜이 나온다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.350,
                "end": 39.354
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 고단계 131단계에서 하는 걸 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.364,
                "end": 44.810
            },
            {
                "speaker_id": "1",
                "transcription": "자 고단계에서는 빌드 똑같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.820,
                "end": 47.773
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 다른 거 하나도 없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.783,
                "end": 49.033
            },
            {
                "speaker_id": "1",
                "transcription": "자 시작하자마자 로얄마가린 예약 자 보스 출현되면은 자 발동 되자마자 나머지 스킬 연타해서 바로 다 눌러 주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.043,
                "end": 56.625
            },
            {
