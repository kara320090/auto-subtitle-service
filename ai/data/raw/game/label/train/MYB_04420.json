        "term": [
            {
                "speaker_id": "1",
                "transcription": "스킬 이펙트가 똑같은가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.077
            },
            {
                "speaker_id": "1",
                "transcription": "일단 일단은 감초는 확실히 다른 거 같은데 음 이렇게 되어있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.087,
                "end": 16.233
            },
            {
                "speaker_id": "1",
                "transcription": "아 이펙트는 전부 다 바뀌었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.243,
                "end": 18.692
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 이미지가 다 바뀌었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.702,
                "end": 21.718
            },
            {
                "speaker_id": "1",
                "transcription": "감초만 눈에 띄고 나머지는 그렇게 차이가 안 난다.",
                "sound_type": [
                    2
                ],
                "start": 21.728,
                "end": 24.717
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 별로 좀 상세히 좀 볼 수 있게끔 전 차이를 잘 모르겠어 가지고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.727,
                "end": 30.266
            }
        ]
    },
    "summary": "이펙트가 전부 다 바뀌긴 했는데 영상 속 화자가 보기에는 감초만 눈에 띄고 나머지는 그렇게 차이가 안 나는 걸로 보인다.",
