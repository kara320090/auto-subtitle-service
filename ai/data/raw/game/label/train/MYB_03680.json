        "term": [
            {
                "speaker_id": "1",
                "transcription": "들어갈 수 있는 얘가 마법형은 못 쓰니까 위에 웨어울프 들어가자",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.171
            },
            {
                "speaker_id": "1",
                "transcription": "울프 써도 괜찮을 거 같거든요. 어차피 얘 딜이 울프 나쁘지 않기 때문에 아몬드 해서 출발",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.181,
                "end": 11.888
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄도 괜찮지 침투형으로 쓸 수 있으니까. 블랙펄도 괜찮은데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.898,
                "end": 17.357
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프에 대해서 잘 몰 울프 잘 모르는 분들 어 야야 잠깐만 어 다크가 날아가 버렸네 그냥.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.367,
                "end": 27.269
            },
            {
                "speaker_id": "1",
                "transcription": "네 울프 셉니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.279,
                "end": 31.235
            },
            {
                "speaker_id": "1",
                "transcription": "웬만한 딜로 안 부러워요. 탱커인데도 불구하고 어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.245,
                "end": 39.785
            },
            {
                "speaker_id": "1",
                "transcription": "네 다크가 날아갔지만 요걸로 클리어 가능하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.795,
                "end": 46.375
            }
        ]
    },
    "summary": "화자가 웨어울프도 탱커이지만 웬만한 딜로 안 부럽다고 하면서 아몬드를 넣고 했는데 다크가 날아갔지만 클리어했다.",
