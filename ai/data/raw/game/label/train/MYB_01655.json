        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 다크덱도 부활했어요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.613
            },
            {
                "speaker_id": "1",
                "transcription": "그래요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.623,
                "end": 11.134
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐 이거 옛날 야 이거 옛날로 야 뭐야 옛날 실론 나이트 덱 해도 이기네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.144,
                "end": 20.981
            },
            {
                "speaker_id": "1",
                "transcription": "어 어제 올린 영상 보신 분 있나요?",
                "sound_type": [
                    2
                ],
                "start": 20.991,
                "end": 23.404
            },
            {
                "speaker_id": "1",
                "transcription": "실론 나이트가 마탕 나오면은 이제 미래는 이제 실론 나이트 한방덱이 이제 이거 하나밖에 없다 이렇게 올렸었는데 역시나 마탕 나오니까 다르네 성능이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.414,
                "end": 34.596
            },
            {
                "speaker_id": "1",
                "transcription": "2개월 전에 실론 나이트가 쓰였던 조합에서 마탕만 나와가지고 내가 껴넣은 영상이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.606,
                "end": 40.902
            },
            {
                "speaker_id": "1",
                "transcription": "어제 영상 보면은 그냥 순삭당해.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.912,
                "end": 43.474
            },
            {
                "speaker_id": "1",
                "transcription": "아무것도 못 하고 그냥 다 죽어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.484,
                "end": 45.258
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 마탕 하나 넣었다고 이렇게 차이가 나네?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.268,
                "end": 53.566
            }
        ]
    },
    "summary": "남성이 실론 나이트가 마탕이 나오면 미래에 한방덱은 이거 하나밖에 없다고 했는데 마탕 하나 넣었는데 성능이 달라졌다고 한다.",
