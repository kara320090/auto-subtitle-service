                    3,
                    5
                ],
                "start": 9.997,
                "end": 14.934
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 레벨업도 할 수 있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.944,
                "end": 16.863
            },
            {
                "speaker_id": "1",
                "transcription": "아 얘네 닌자를 키워가지고 하는 게임이구나 이렇게?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.873,
                "end": 20.784
            },
            {
                "speaker_id": "1",
                "transcription": "어 야 야 야 야 야 야 잠깐만.",
