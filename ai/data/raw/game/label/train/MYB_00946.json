        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래 내가 냉정한 평가를 하자면은 이거 성격 급한 사람은 안 맞 안 맞겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.027
            },
            {
                "speaker_id": "1",
                "transcription": "확실한 건 약간 나 같은 약간 경쟁 좋아하고 그런 사람들은 목적이 없어 가지고 조금 그렇긴 하겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.037,
                "end": 14.440
            },
            {
                "speaker_id": "1",
                "transcription": "약간 짓는 그런 느낌이 있어서 색다르긴 하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.450,
                "end": 18.029
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤은 자동으로 노움이 지어주잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.039,
                "end": 21.158
            },
            {
                "speaker_id": "1",
                "transcription": "아 맞아 레고 같아 맞아 딱 저 느낌이야 나 지금 레고 게임하는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
