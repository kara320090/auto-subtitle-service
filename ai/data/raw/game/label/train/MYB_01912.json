        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "문어씨 레벨이 너무 맞아서 그래",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.056
            },
            {
                "speaker_id": "1",
                "transcription": "얘네 두 개 레벨 신전에 넣거나 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.066,
                "end": 4.989
            },
            {
                "speaker_id": "1",
                "transcription": "빼내 가지고 아니 토핑이 안 되니까 어떻게 세팅을 못해 드리니까 너무 아쉽네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.999,
                "end": 9.679
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 난이도가 토벌에 너무 높잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.689,
                "end": 13.764
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 좀 배려할 수 있게끔 여기 토벌에서만큼은 토핑을 기본 토핑이라도 주면 안 되나?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 13.774,
                "end": 21.015
            },
            {
                "speaker_id": "1",
                "transcription": "초코그램 좀 따라 할 수라도 있게 딜은 안 나와도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.025,
                "end": 25.005
            },
            {
                "speaker_id": "1",
                "transcription": "진입 장벽이 여기서 그냥 완전히 막혀버리는 느낌이라",
                "sound_type": [
                    2,
                    3,
                    5
                ],
