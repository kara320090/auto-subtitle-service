                "end": 5.070
            },
            {
                "speaker_id": "1",
                "transcription": "심심해서 어케 싸워?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.080,
                "end": 6.944
            },
            {
                "speaker_id": "1",
                "transcription": "되게 심심할 거 같지 않아요 여러분?",
