        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그다음에 이제 생산 쪽으로 본격적으로 한번 봐 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.233
            },
            {
                "speaker_id": "1",
                "transcription": "자 네 개를 돌렸던 그런 의지면은 내가 볼 때 생산은 뭐 안 봐도 다 답이 나오죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.243,
                "end": 10.599
            },
            {
                "speaker_id": "1",
                "transcription": "어마무시한 재고량이 잘 쌓여져 있을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.609,
                "end": 14.473
            },
            {
                "speaker_id": "1",
                "transcription": "나무 같은 경우에 기본적으로 4900개, 5000개가량 어이구야 젤리빈도 4000개, 각설탕이 5000개 자 비스킷 풍차는 상당히 좀 부족한 상태고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.483,
                "end": 24.445
            },
            {
                "speaker_id": "1",
                "transcription": "이거 뭐 얼마나 나머지 생산을 열심히 돌리고 있는지 느낌 오죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.455,
                "end": 28.783
            },
            {
                "speaker_id": "1",
                "transcription": "자 대장간 같은 경우도 재고가 400개, 300개, 300개, 300개, 100개 잼가게도 아주 완벽하게 잘 재고가 쌓여져 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.793,
                "end": 39.029
            },
            {
                "speaker_id": "1",
                "transcription": "롤케이크 공작소도 그냥 모범생 그 자체 완벽합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.039,
                "end": 43.407
            },
            {
                "speaker_id": "1",
                "transcription": "어이구야 무슨 크로와상이 100개가 다 될라 그러네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.417,
                "end": 46.678
            },
            {
                "speaker_id": "1",
                "transcription": "완벽합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.688,
                "end": 47.661
            },
            {
                "speaker_id": "1",
                "transcription": "제가 뭐 생산 쪽에서 따로 이거 해라 저거 해라 이게 좋겠다라고 도움 드릴 발언은 단 하나도 없네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.671,
                "end": 55.821
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 알아서 생산 쪽은 완벽하게 진행하고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.831,
                "end": 60.594
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 그럼 쿠키 쪽으로 바로 넘어갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.604,
                "end": 62.761
            },
            {
                "speaker_id": "1",
                "transcription": "자 스펙도 좋으시네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.771,
                "end": 64.038
            },
            {
                "speaker_id": "1",
                "transcription": "바다 요정이 3성 아이 어쩌 어떻게 바다 요정을 쏙 골라서 이렇게 잘 뽑으셨지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.048,
                "end": 68.465
            },
            {
                "speaker_id": "1",
                "transcription": "아 이것도 되게 신기하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.475,
                "end": 69.904
            },
            {
                "speaker_id": "1",
                "transcription": "바다 요정만 쏙 골라서 나머지 육성 상태로 상당히 잘 되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.914,
                "end": 76.672
            },
            {
                "speaker_id": "1",
                "transcription": "별사탕도 많으셔서 제가 볼 땐 넉넉히 하고 있을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.682,
                "end": 80.558
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 레벨 상태가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.568,
                "end": 83.866
            }
        ]
    },
    "summary": "화자가 생산 쪽 재고량이 잘 쌓여 있다며 완벽하다고 하며 쿠키 쪽 스펙도 좋다며 바다 요정 3성도 신기하다고 한다.",
