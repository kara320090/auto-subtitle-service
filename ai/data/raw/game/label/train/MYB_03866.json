        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현재 여러분들 야 이거 딜 맞냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.435
            },
            {
                "speaker_id": "1",
                "transcription": "야 평타가 4600 이거 원래 맞나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.445,
                "end": 4.628
            },
            {
                "speaker_id": "1",
                "transcription": "원래 저렇게 약했나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.638,
                "end": 5.530
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 애기 딜 자 감초 스킬 딜은 10만 20만 이렇게 표기되긴 하는데 심각합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.540,
                "end": 15.239
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야 쪼리 6명 6마리가 딱 순간적으로 되기도 하네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.249,
                "end": 28.196
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 옛날에는 3마리 나왔다가 스킬 쓰면은 전에 나왔던 3마리는 없어지지 않았나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.206,
                "end": 32.982
            },
            {
                "speaker_id": "1",
                "transcription": "제가 기억하기로는 그렇게 알고 있었는데 가물가물 하네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.992,
                "end": 36.405
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 감초맛 쿠키 여러분들 얘 도대체 뭔 능력인가 뭐 간단하게만 보면은 아군의 방어력이 7초 동안 20퍼센트 증가된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.415,
                "end": 45.966
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 되어있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.976,
                "end": 47.205
            },
            {
                "speaker_id": "1",
                "transcription": "피해량은 439퍼센트 뭐 감초 젤리 해골 같은 경우에는 공격력 시전자의 5퍼센트 방어력의 150퍼센트 체력의 50퍼센트다 뭐 요렇게 되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.215,
                "end": 59.454
            },
            {
                "speaker_id": "1",
                "transcription": "이제 제가 볼 거는 여러분들 분명히 지금 메타에서 아레나에 감초맛 쿠키를 껴서 들어가면은 거의 필패일 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.464,
                "end": 67.170
            },
            {
                "speaker_id": "1",
                "transcription": "거의 다 질 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.180,
                "end": 68.240
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 굳이 지는데도 써 보는 이유가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.250,
                "end": 71.914
            },
            {
                "speaker_id": "1",
                "transcription": "감초맛 쿠키의 딜을 좀 체크해 볼려고 하는 거거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.924,
                "end": 74.696
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 제가 마탕 나왔을 때 이 덱으로 똑같이 해볼 건데 딜이 얼마나 많이 바뀌는지 고거 테스트를 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.706,
                "end": 83.138
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 웨어울프를 예를 들면 상향 전에 웨어울프가 딜이 거의 60만 70만 딜이었거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.148,
                "end": 89.689
            }
        ]
    },
