                ],
                "start": 0.000,
                "end": 1.597
            },
            {
                "speaker_id": "2",
                "transcription": "그거 천오백 개짜리 열두 개 누르면 끝나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.607,
                "end": 3.766
            },
            {
                "speaker_id": "1",
                "transcription": "요것도 아니 스킨 뽑기 많이 안 하셨나? 어째 법사가 중복이 없네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.776,
                "end": 8.043
            },
            {
                "speaker_id": "2",
                "transcription": "러너님이 다 뽑으셨잖아요. 저는 억지로 싼것을 쓰지 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.053,
                "end": 11.329
            },
            {
                "speaker_id": "1",
                "transcription": "야 그러면 이거 제가 뽑기 안 하는 이상 싹 다 모으시는 건가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.339,
                "end": 14.953
            },
            {
                "speaker_id": "2",
                "transcription": "제가 보니까 마지막 대리 뽑기 맡긴 게 오 월 십사 일 인가? 그렇더라구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.963,
                "end": 19.033
            }
        ]
    },
    "summary": "뽑기는 천오백 개로 열두 개 누르면 끝나며 스킨을 많이 안뽑은 이유는 다 대리로 뽑기를 시켰기 때문이다.",
