        "term": [
            {
                "speaker_id": "1",
                "transcription": "저건 뭐냐 저 스킬 뭐야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.258
            },
            {
                "speaker_id": "1",
                "transcription": "이거 이거 회복 주는 거 얘가 회복 주는 건데. 마그마 화산 터지는 거",
