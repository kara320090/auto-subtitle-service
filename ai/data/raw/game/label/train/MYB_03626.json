                    2,
                    3
                ],
                "start": 9.932,
                "end": 15.487
            },
            {
                "speaker_id": "1",
                "transcription": "다크 스킬, 다크 초코 번개 스킬이죠. 자자작 이렇게 나가는 거",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.497,
                "end": 19.594
            },
            {
                "speaker_id": "1",
                "transcription": "일단 요런 스킬이 있다는 거 일단 뭐 얼마나 사기일지는 모르겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.604,
                "end": 23.236
            },
            {
