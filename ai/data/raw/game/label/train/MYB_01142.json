        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 야 이거 여러분들 아 이거 한방덱으로 쓸거면은 바요가 답이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.237
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 블랙펄을 저는 한방덱으로만 쓰겠습니다 하시는 분들 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.247,
                "end": 11.514
            },
            {
                "speaker_id": "1",
                "transcription": "그거 답정너 그냥 바요네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.524,
                "end": 13.651
            },
            {
                "speaker_id": "1",
                "transcription": "야 이제 비교가 됐죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.661,
                "end": 16.340
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 원하는 바요 키워야 될지 블랙펄 키워야 될지를 구분 지을 때 한방덱 기준으로 보면은 블랙펄은 바요한테 밀렸다 이렇게 보시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.350,
                "end": 27.683
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 블랙펄을 그러면 기존에 스타더스트 덱과 함께 네 한번 써볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.693,
                "end": 33.514
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄은 4쿨 1애플젤리로 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.524,
                "end": 36.559
            },
            {
                "speaker_id": "1",
                "transcription": "예전에 이렇게 많이 썼거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.569,
                "end": 40.000
            }
        ]
    },
    "summary": "화자가 게임을 플레이해 보며 바요가 답이라며 바요와 블랙펄 중 어떤 것을 키워야 할지 구분 지을 때 한방덱 기준으로 보면 바요를 키워야 하며 블랙펄을 스타더스트 덱과 함께 써보겠다고 말하고 있다.",
