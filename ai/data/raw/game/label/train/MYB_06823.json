            },
            {
                "speaker_id": "1",
                "transcription": "근데 걸렀던 이유가 뭐였냐면 나 이거 토트까지는 괜찮았거든 근데 전투신 중에 어디냐 이걸 보고 아 이거 너무 복잡해 보이는데 여기 세 칸이 없었잖아요 제가 아까 할 때는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.226,
                "end": 18.724
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이걸 보고 아 이게 내가 이런 거는 못할 것 같은데 뭐 터치로 하는 건가 이게 뭐지 이랬거든요.",
                "sound_type": [
