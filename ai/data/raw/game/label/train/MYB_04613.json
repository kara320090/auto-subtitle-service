        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이겼다 이건",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.191
            },
            {
                "speaker_id": "1",
                "transcription": "변신시에 무적화되는 것도 상당히 좀 좋아서 죽일 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.201,
                "end": 8.494
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 스토리는 되어 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.504,
                "end": 11.829
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 본격적으로 아레나로 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.839,
                "end": 14.633
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나로 넘어가면은 정말 수많은 덱이 많을 텐데 공통점이 딱 하나 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.643,
                "end": 20.791
            },
            {
                "speaker_id": "1",
                "transcription": "전부 다 블랙펄이 들어간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.801,
                "end": 22.680
            },
            {
                "speaker_id": "1",
                "transcription": "그만큼 거의 대체가 불가능한 급이고 웬만해선 다 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.690,
                "end": 26.527
            },
            {
                "speaker_id": "1",
                "transcription": "특수한 경우 제외하고 그런데 보면은 블랙펄이 들어갈 때 이렇게 올 쿨이 아닌 조합도 있고 자 이렇게 올 아몬드인 경우도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.537,
                "end": 35.286
            },
            {
                "speaker_id": "1",
                "transcription": "제 유튜브에 가면 아레나 조합 추천 영상들 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.296,
                "end": 38.534
            },
            {
                "speaker_id": "1",
                "transcription": "그거 맞춰서 세팅을 해서 들어가시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.544,
                "end": 41.270
            },
            {
                "speaker_id": "1",
                "transcription": "런일 추천하는 무난한 세팅은 뭔가요 하면은 저는 올 쿨 추천드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.280,
                "end": 45.218
            },
            {
                "speaker_id": "1",
                "transcription": "방덱도 제가 쓰는 거는 네 이거로 쓰고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.228,
                "end": 48.976
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 세팅으로 쓰고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.986,
                "end": 52.839
            },
            {
                "speaker_id": "1",
                "transcription": "네 이거 덱같은 경우에는 4쿨에다가 1애플젤리 써서 블랙펄의 위엄을 볼 수 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.849,
                "end": 59.077
            },
            {
                "speaker_id": "1",
                "transcription": "추천드리는 것 중에 하나는 애플젤리가 있으면은 애플젤리가 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.087,
                "end": 64.003
            },
            {
                "speaker_id": "1",
                "transcription": "장판딜 저렇게 밑에 때리는 딜 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.013,
                "end": 67.386
            },
            {
                "speaker_id": "1",
                "transcription": "데미지 표시를 보게 되면은 블랙펄 쿠키가 스킬 들어갔을 때 이 밑에 장판딜 막 이렇게 때리는 연속으로 들어가는 딜 있죠 이게 치명타 확률이 높을수록 딜이 되게 세게 들어가거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.396,
                "end": 81.018
            },
            {
                "speaker_id": "1",
                "transcription": "라즈베리보다는 계산상 치명타가 더 좋으니까 치명타 세팅 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.028,
                "end": 91.268
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 랜드마크나 다른 거 다 포함해서 계산했을 때 라즈베리보다는 치명타가 더 딜이 높게 들어간다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.278,
                "end": 102.466
            }
        ]
    },
    "summary": "화자가 캐릭터 능력 세팅에 대해 플레이하면서 설명하고 있다.",
