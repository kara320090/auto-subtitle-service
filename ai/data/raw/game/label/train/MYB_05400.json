        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 이분은 저한테 맡겨 주시는데 이분이 저한테 맡겨주신 이유는 너무 안 나와서 진짜 마지막이라고 생각하고 열심히 모아서 대리 뽑기 맡깁니다라고 하셨거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 11.920
            },
            {
                "speaker_id": "1",
                "transcription": "저 뽑기 권은 전부 다 쓰는 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.930,
                "end": 14.266
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 5만 5000개 어이구야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.276,
                "end": 16.476
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야. 이거",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.486,
                "end": 17.198
            },
            {
                "speaker_id": "1",
                "transcription": "628개 저거 어떻게 모았어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.208,
                "end": 19.554
            },
            {
                "speaker_id": "1",
                "transcription": "18000개 300개 이야 알겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.564,
                "end": 23.210
            },
            {
                "speaker_id": "1",
                "transcription": "전부 뽑고 일단 스펙은 어느 정도 과금하셨구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.220,
                "end": 26.580
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 나쁘지 않 엄청 좋으시네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.590,
                "end": 28.767
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘은 아직 안 뽑았고 일단 길드 뽑기부터 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.777,
                "end": 32.592
            },
            {
                "speaker_id": "1",
                "transcription": "30만 개 자 일단 이거부터 다 뽑아 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.602,
                "end": 37.333
            }
        ]
    },
    "summary": "대리 뽑기를 맡긴 분의 스펙은 엄청 좋지만 아직 크림 유니폼을 안 뽑는 상태인데 우선은 길드 뽑기부터 가도록 한다.",
