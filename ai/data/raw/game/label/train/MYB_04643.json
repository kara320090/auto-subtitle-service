        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤의 최종 컨텐츠는 아레나입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.602
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 스토리 모드를 무난하게 클리어해야 크리스탈 수급이나 각종 컨텐츠를 오픈할 수 있고 쿠키를 성장시킬 수 있는 스킬 파우더, 토핑까지 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.612,
                "end": 11.856
            },
            {
                "speaker_id": "1",
                "transcription": "스토리 모드는 아레나와 다르게 쿠키들의 티어가 상당히 다를 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.866,
                "end": 16.204
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 여러분들이 분명히 알고 가야 될 점은 스토리 모드에서 좋은 쿠키를 키우는 게 정답이 아니라 스토리 모드를 모두 클리어 해도 여전히 다른 컨텐츠에서 활용가치가 높은 쿠키를 키워야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.214,
                "end": 26.964
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 구분하기 쉽게 이번 스토리 쿠키 티어 표에서는 파란색 배경이 있는 쿠키는 충분히 키워도 좋고 활용가치가 높은 쿠키들입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.974,
                "end": 35.388
            },
            {
                "speaker_id": "1",
                "transcription": "반면에 붉은색 배경이 있는 쿠키는 키워야 될 가치가 낮은 쿠키들입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.398,
                "end": 39.968
            },
            {
                "speaker_id": "1",
                "transcription": "초보자분들은 별사탕과 스킬 파우더가 많이 부족하기 때문에 높은 티어와 활용가치가 높은 쿠키들 위주로 키우시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.978,
                "end": 47.792
            },
            {
                "speaker_id": "1",
                "transcription": "스토리 모드를 기준으로 한 쿠키 티어는 0티어부터 6티어까지 구분하도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.802,
                "end": 52.958
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 0티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.968,
                "end": 57.000
            }
        ]
    },
