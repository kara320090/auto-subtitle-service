        "term": [
            {
                "speaker_id": "1",
                "transcription": "고통에서 벗어나세요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.412
            },
            {
                "speaker_id": "1",
                "transcription": "오 해마 떴다.",
                "sound_type": [
