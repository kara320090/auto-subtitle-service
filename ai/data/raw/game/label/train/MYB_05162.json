                ],
                "start": 1.422,
                "end": 2.433
            },
            {
                "speaker_id": "1",
                "transcription": "버프 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.443,
                "end": 3.250
            },
            {
                "speaker_id": "1",
                "transcription": "야 아군의 피해량이 10초마다 증가 별의별 버프 많네.",
                "sound_type": [
                    2,
                    3,
