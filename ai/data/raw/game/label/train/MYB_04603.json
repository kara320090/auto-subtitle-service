        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.198
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 MAC 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.208,
                "end": 6.343
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.353,
                "end": 10.173
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 연구소 한 번 볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.183,
                "end": 11.614
            },
            {
                "speaker_id": "1",
                "transcription": "역시 바쁘시다 보니까 제가 좀 지적할 게 보이긴 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.624,
                "end": 15.466
            },
            {
                "speaker_id": "1",
                "transcription": "왕구 투자에는 시간을 많이 못 썼다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.476,
                "end": 18.736
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 연구 쪽에는 야 쿠키 연구에 진심이시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.746,
                "end": 23.038
            },
            {
                "speaker_id": "1",
                "transcription": "역시 아레나에 진심이셔서 근데 여러분들 여기서 하나 제가 짚고 넘어가야 될 포인트는 그러면 쿠키 연구가 중요해서 이렇게 먼저 다 찍는 거니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.048,
                "end": 32.512
            },
            {
                "speaker_id": "1",
                "transcription": "나도 쿠키 연구를 다 먼저 찍어야지 라고 생각하는 분이 있을 수 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.522,
                "end": 36.504
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 연구 먼저 찍으세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.514,
                "end": 38.497
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 운영은 먼저 업그레이드를 해놓으면 시간이 지날수록 이득을 보는 구조기 때문에 쿠키 연구랑 왕국 연구의 결과적인 차이는 다 코인에서 차이가 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.507,
                "end": 47.810
            },
            {
                "speaker_id": "1",
                "transcription": "코인 수급량에서 쿠키 연구 먼저 한 사람이랑 왕국 연구 먼저 한 사람이랑 억 단위 이상 차이가 난다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.820,
                "end": 53.752
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 프로필 한 번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.762,
                "end": 55.654
            },
            {
                "speaker_id": "1",
                "transcription": "자 소원나무 2만 8000번 했고 아레나 대전 횟수도 많이 하셨고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.664,
                "end": 60.175
            },
            {
                "speaker_id": "1",
                "transcription": "랜드마크는 하나가 없으시네요 아마 제가 알리고는 코인 2퍼센트 주는 회전목마가 없으실 거 같은데 서버 초창기에 줬던 그 회전목마가 없으시네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.185,
                "end": 70.404
            },
            {
                "speaker_id": "1",
                "transcription": "아 회전목마가 아니라 오르골 당연히 쿠키 인연 스킨 인연은 다 채우신 상태입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.414,
                "end": 75.886
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 쿠키 하우스 레벨은 10레벨 아 별사탕이 부족하신가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.896,
                "end": 82.049
            },
            {
                "speaker_id": "1",
                "transcription": "10레벨은 좀 진짜 좀 적긴한데 아이구야 역시 과금을 많이 하다 보니까 솔직히 10레벨이라도 뭐 상관없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.059,
                "end": 89.642
            },
            {
                "speaker_id": "1",
                "transcription": "이거 여러분들 보시는 수치가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.652,
                "end": 91.933
            }
        ]
    },
