        "term": [
            {
                "speaker_id": "1",
                "transcription": "테오도르가 이제 없다는 게 아직도 믿기지 않아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.091
            },
            {
                "speaker_id": "1",
                "transcription": "내게 그 사실이 당연해지는 날은 영원히 오지 않겠지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.101,
                "end": 5.275
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 비록 혼자가 되었지만 앞으로도 운반 업자로서 구할 수 있는 사람은 최선을 다해 돕고 싶어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.285,
                "end": 10.773
            },
            {
                "speaker_id": "1",
                "transcription": "내 마음이 시키는 대로 솔직하게 살아가는 것이 태오의 몫까지 살아내는 것이라고 생각해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.783,
                "end": 16.000
            },
            {
                "speaker_id": "1",
                "transcription": "그게 내가 선택한 내 인생이니까.",
