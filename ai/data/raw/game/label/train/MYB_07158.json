                ],
                "start": 0.000,
                "end": 10.866
            },
            {
                "speaker_id": "1",
                "transcription": "아니 씨 마법 소녀도 아 진짜 미안하다고 어 홀 모양새 안 좋네.",
                "sound_type": [
