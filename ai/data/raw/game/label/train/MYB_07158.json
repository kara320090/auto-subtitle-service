                    5
                ],
                "start": 52.267,
                "end": 71.451
            },
            {
                "speaker_id": "1",
                "transcription": "저도 궁이라는 걸 쓸 줄 압니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.461,
                "end": 76.727
            },
            {
                "speaker_id": "1",
                "transcription": "아줌마는 그러니까 지금부터 아주 지읏 되신 거예요.",
                "sound_type": [
                    2,
