                "end": 7.309
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때 이 신규 보물이 역할을 톡톡히 해줄 수 있는지 가자",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.319,
                "end": 11.414
            },
            {
