        "term": [
            {
                "speaker_id": "1",
                "transcription": "음 근데 지금 스펙으로는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.780
            },
            {
                "speaker_id": "1",
                "transcription": "저 딜이 나오면 안 되는데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.790,
                "end": 3.837
            },
            {
                "speaker_id": "1",
                "transcription": "이거 어떻게 제가 분해해서 세팅해 드려요? 이거 다 분해해야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.847,
                "end": 7.220
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보니까 세팅이 잘 안 되어 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.210,
                "end": 8.960
            },
            {
                "speaker_id": "1",
                "transcription": "근데 어차피 세팅은 제 유튜브에 올린 거 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.960,
                "end": 11.982
            },
            {
                "speaker_id": "1",
                "transcription": "그거 보시거나 아니면 제 유튜브 말고 다른 데도 많으니까 직접 하셔야 할 것 같아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.990,
                "end": 16.280
            },
            {
                "speaker_id": "1",
                "transcription": "이거 보니까 대천사 애들 거 다 가져와야 해. 쿨이 부족해서",
                "sound_type": [
                    2,
