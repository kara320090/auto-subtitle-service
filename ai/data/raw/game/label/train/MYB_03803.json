        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "크런치랑 소르베 쿠키 공속을 느리게 하는 능력을 이용해서 정말 엄청나게 좋은 덱이 탄생했거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.934
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱 같은 경우에는 맨 처음에 @이름1 님이 어 맨 처음에 만드신 거를 걸로 알고 있고 덱을 일단은 보게 되면은 얘가 왜 좋냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.944,
                "end": 17.170
            },
            {
                "speaker_id": "1",
                "transcription": "얘 능력이 좀 이유가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.180,
                "end": 19.354
            },
            {
                "speaker_id": "1",
                "transcription": "공속 감소가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.364,
                "end": 20.958
            },
            {
                "speaker_id": "1",
                "transcription": "근데 18초 동안 25퍼센트고 2 중첩되기 때문에 최대로 50퍼센트 공속이 감소되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.968,
                "end": 27.980
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기에 하필이면 또 소르베를 같이 쓰게 되면 공속 감소가 무려 얘는 50퍼센트가 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.990,
                "end": 35.446
            },
            {
                "speaker_id": "1",
                "transcription": "합해서 공속이 100퍼센트 공속 감소가 이루어지는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.456,
                "end": 39.218
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요걸 이용해서 상대방의 딜러가 바보가 되는 그런 걸 만들어서 아군한테는 소르베랑 서리여왕이 딜을 넣어서 죽이는 그런 전략입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.228,
                "end": 48.980
            },
            {
                "speaker_id": "1",
                "transcription": "일단 토핑 같은 경우에는 크런치는 어 저는 피감을 엄청 높게 줬고 공속을 줬습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.990,
                "end": 54.891
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 줘서 빨리빨리 좀 공격이 들어가게끔 좀 줬는데 다른 분들 세팅 보니까 뭐 치명타를 더 준 분도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.901,
                "end": 62.798
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 공속 더 줬다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.808,
                "end": 64.426
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들 피감 여러분 능력껏 주고 뭐 공속이나 치명타 둘 중에 여러분들 여유되는 대로 주면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.436,
                "end": 71.626
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에 같은 경우에는 쿨 쿨 가능한 대로 높게 한 20퍼센트 이상이면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.620,
                "end": 77.146
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 많으면 많을수록 쿨 좋을 것 같고 소르베 같은 경우에는 피감 능력껏 주고 8퍼센트 정도 맞춰주면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.146,
                "end": 84.928
            },
            {
                "speaker_id": "1",
                "transcription": "빠르면 빨수록 좋을 것 같고 서리는 얘는 피감이랑 쿨 이렇게 안 줘도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.938,
                "end": 90.128
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이렇게 맞추라고 이렇게 한 거 아니라 저는 그냥 쿨 주면 줄수록 좋기 때문에 세팅을 한 거고 가급적이면 세트 효과 제외하면 20점 5퍼센트 이상 주면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.138,
                "end": 99.959
            },
            {
                "speaker_id": "1",
                "transcription": "네 요거 BTS는 쿨 높게 세팅을 해주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.969,
