                "start": 151.878,
                "end": 159.725
            },
            {
                "speaker_id": "1",
                "transcription": "날아가서 눈물이 납니다 아니 조금 더 자세히 공지해 주셔야 되는 거 아닌가요 제가 말하고 싶은 점도 이겁니다.",
                "sound_type": [
