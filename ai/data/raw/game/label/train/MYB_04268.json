        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기까지 좀 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.233
            },
            {
                "speaker_id": "1",
                "transcription": "깔끔하게 여기까지 하고 뽑기 딱 하고 오늘 5일차는 대충 마무리 짓도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.243,
                "end": 16.712
            },
            {
                "speaker_id": "1",
                "transcription": "야 여기도 쉽다 쉬워 요렇게 하고 자 마무리로 뽑기 하겠습니다 12000개 자 블랙펄 뽑기 위해서 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.722,
                "end": 24.576
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 마카롱맛 쿠키 내일 나오지만 아 아니다 안 되겠다 아 저 아낄게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.586,
                "end": 29.199
            },
            {
                "speaker_id": "1",
                "transcription": "내 웬만해선 뽑겠는데 아 마카롱 좋을 것 같아서 킵 해놔야 되 되겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.209,
                "end": 34.214
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱이 만약에 나오면은 지금 찰스 대신에 써야 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.224,
                "end": 38.382
            },
            {
                "speaker_id": "1",
                "transcription": "아 참을게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.392,
                "end": 39.506
            },
            {
                "speaker_id": "1",
                "transcription": "일단 좀 더 깰게요 스토리를.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.516,
                "end": 40.895
            },
            {
                "speaker_id": "1",
                "transcription": "아 깰라고 했더니만 나와 나와 막지마 막지마 자 스토리 조금 더 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.905,
                "end": 47.854
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 구독자 20만명 가자고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.864,
                "end": 50.258
            },
            {
                "speaker_id": "1",
                "transcription": "20만명을 때는 여러분들이 원하는 거 하나 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.268,
                "end": 55.559
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들어 뭐 먹방을 해달라 캠 방송을 해달라 소통 방송을 해달라 어 뭐 노방종 해달라 이런 거 적어서 사다리 타기 한번 가서 걸리는 거 하도록 할게요.",
                "sound_type": [
                    2,
