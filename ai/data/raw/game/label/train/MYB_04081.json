                    2,
                    3
                ],
                "start": 0.665,
                "end": 1.989
            },
            {
                "speaker_id": "1",
                "transcription": "아 잠깐만 이렇게 끝나는 건가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.999,
                "end": 3.867
            },
            {
                "speaker_id": "1",
                "transcription": "아 자 일단 1트 실패했는데 자 2트에 제가 성공하는 거 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.877,
                "end": 9.391
            },
            {
                "speaker_id": "1",
                "transcription": "방식은 너무 쉽기 때문에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.401,
                "end": 11.172
            },
            {
                "speaker_id": "1",
                "transcription": "아니 근데 이게 보는 거는 쉬워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.182,
                "end": 13.614
            },
            {
                "speaker_id": "1",
                "transcription": "똑같은 그림 3개만 맞추면 그대로 진행할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.624,
                "end": 16.615
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이게 난이도가 뒤로 갈수록 좀 진행되면 살짝 어려워지거든요?",
                "sound_type": [
                    2,
                    3
