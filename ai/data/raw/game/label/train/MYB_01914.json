        "term": [
            {
                "speaker_id": "1",
                "transcription": "열차가 흔들리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 4.363
            },
            {
                "speaker_id": "2",
                "transcription": "요번에는 안 죽을 수 있을 것 같은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.373,
                "end": 6.871
            },
            {
                "speaker_id": "2",
                "transcription": "썼어 썼어 썼어",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 6.881,
                "end": 17.960
            },
            {
                "speaker_id": "2",
                "transcription": "이거 칼 타임 44초에 쓰세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.970,
                "end": 20.375
            },
            {
                "speaker_id": "2",
                "transcription": "썼어 썼어",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.385,
                "end": 22.431
            },
            {
                "speaker_id": "1",
                "transcription": "들리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.441,
                "end": 24.893
            },
            {
                "speaker_id": "2",
                "transcription": "오 끝 나름 성공적 1억 8000 소름 어떻게든 쓰기만 하면 돼",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.903,
                "end": 34.085
            },
            {
                "speaker_id": "2",
                "transcription": "44초 보일 때 쓰면 돼요 알겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.095,
                "end": 36.722
            },
            {
                "speaker_id": "2",
                "transcription": "아니면 죽을 거 같다면 그냥 그 전에 써요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.732,
                "end": 40.581
            },
            {
                "speaker_id": "2",
                "transcription": "얘는 이걸로 하셔야 되는데 이거 갈 때 해보니까 다 터지잖아 시작하자마자 도넛이랑 오목이랑 만렙찍고 가세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.591,
                "end": 49.453
            },
            {
                "speaker_id": "2",
                "transcription": "여기 갈 때는 그냥 안전 제일주의가 짱이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.463,
                "end": 53.366
            },
            {
                "speaker_id": "2",
                "transcription": "안 박히잖아요 그러면 그냥 트윌이 짱이야 트윌덱으로는 웬만큼 다 깨지거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.376,
                "end": 59.714
            },
            {
                "speaker_id": "2",
                "transcription": "얘 홀리베리 아몬드 쓰시던데 올 쿨 쿨 뭐 쿨 쿨쿨 다 쿨하시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.724,
                "end": 66.536
            },
            {
                "speaker_id": "2",
                "transcription": "얘 넘어가면 달빛 토핑 주거든요 달빛 토핑 받으면 싹 다 쿨로 하세요 알겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.546,
                "end": 73.047
            },
            {
                "speaker_id": "2",
                "transcription": "제가 말한 대로 해 주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.057,
                "end": 75.423
            },
            {
                "speaker_id": "2",
                "transcription": "뭔가 대규모 대대적인 그런 이야기가 많았는데 해 보시고 궁금한 거 있으면 말씀해 주세요 궁금한거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.433,
