        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스앱플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.813
            },
            {
                "speaker_id": "1",
                "transcription": "방치형 모바일 게임을 편하게 모니터링 가능하며 핸드폰 발열이나 배터리 부족으로 인한 불편함도 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.823,
                "end": 8.140
            },
            {
                "speaker_id": "1",
                "transcription": "PC에서 큰 화면에 초고화질로 몰입할 수 있는 녹스앱플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.150,
                "end": 12.259
            },
            {
                "speaker_id": "1",
                "transcription": "현재 트위터에 공개된 사진 한 장을 보고 제가 유추해 볼 때 이게 의미하는 바는 여러 개로 생각해 볼 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.269,
                "end": 17.975
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째 쿠키런 킹덤의 라떼 맛 쿠키 스킨과 닮았다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.985,
                "end": 22.080
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 라떼 맛 쿠키 이미지를 보면 모자와 지팡이 모습이 조금 닮아 보이긴 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.090,
                "end": 26.520
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 실제 신규 쿠키 이미지에선 물병 같은 걸 들이고 있는 게 눈에 보이기는 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.520,
                "end": 31.599
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째 일부 유저분들께서 합성을 통해서 마법사 맛 쿠키 신규 스킨이 나왔다.라는 모습으로 공식 카페에 올린 이미지가 다른데 그럴 가능성은 낮지만 마법사 맛 쿠키의 외형으로 이미지를 합성해 보시는 분도 있고 이벤트 신규 스킨으로 나온다고 보는 분들도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.609,
                "end": 47.384
            },
            {
                "speaker_id": "1",
                "transcription": "세 번째 쿠키런 오븐 브레이크에 크로우 베리 맛 쿠키와 비슷하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.394,
                "end": 51.401
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 이미지를 보면 외형이 비슷하게 생기긴 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.411,
                "end": 54.946
            },
            {
                "speaker_id": "1",
                "transcription": "모자부터 지팡이까지 하지만 크로우베리맛 쿠키는 스킨에 깃털 외형이 있기 때문에 거리가 좀 있지 않나 그렇게 생각이 듭니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.956,
                "end": 63.346
            },
            {
                "speaker_id": "1",
                "transcription": "자 네 번째 연금술사 쿠키의 신규 이벤트 스킨이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.356,
                "end": 66.449
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 가려진 이미지만 놓고 보면 물약을 들고 있는 모습이라연금살수의 신규 스킨 느낌도 나지만 실제로 연금술사와 관련된 이벤트로 나올지는 지켜봐야 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.459,
                "end": 77.358
            },
            {
                "speaker_id": "1",
                "transcription": "다섯 번째 이번에 유출된 신규 쿠키로 푸룬주스 맛 쿠키다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.368,
                "end": 81.449
            },
            {
                "speaker_id": "1",
                "transcription": "이미 유출된 자료에 따르면 푸룬주스 맛 쿠키라고 명칭까지 나왔고 마법형 쿠키에 중앙 배치 쿠키라는 유출 내용도 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.459,
                "end": 89.547
            },
            {
                "speaker_id": "1",
                "transcription": "아마 가장 가능성이 높은 상황입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.557,
                "end": 92.220
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 제가 생각나는 건 5개 정도 입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.230,
                "end": 94.733
            },
            {
                "speaker_id": "1",
                "transcription": "아직 업데이트 정보가 너무 없어서 기대만 높은 상황이지만 앞으로 다가올 30일 업데이트에서 상세히 리뷰 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 94.743,
                "end": 103.545
            },
            {
                "speaker_id": "1",
                "transcription": "좋아요. 구독 꼭 눌러주시면 감사합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 103.555,
                "end": 106.427
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 생각하는 신규 쿠키 이름을 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 106.437,
                "end": 109.791
            },
            {
                "speaker_id": "1",
                "transcription": "추첨을 통해서 3000개의 무지개 큐브를 3월 29일 저녁 라이브 방송에서 드리도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 109.801,
                "end": 115.734
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 115.744,
                "end": 117.700
            }
        ]
    },
    "summary": "남성은 트위터에 공개된 사진으로 다섯 가지의 쿠키를 생각해봤고 업데이트 정보가 너무 없어서 30일 업데이트에서 상세히 리뷰 해보겠다고 했다.",
