        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 좀비 디펜스 신작 현재 구글 인기순위 7위 다운로드 10만이 넘은 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.237
            },
            {
                "speaker_id": "1",
                "transcription": "타운 서바이벌 시간 가는 줄 모르고 빠져드는 중독성 높은 게임이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.247,
                "end": 10.299
            },
            {
                "speaker_id": "1",
                "transcription": "몰려드는 좀비들을 이렇게 포탑이나 수리를 통해서 막아내는 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.309,
                "end": 15.786
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임 방법은 정말 간단합니다 처음 시작하면은 각 방에 원하는 방으로 이렇게 들어가서 자 이렇게 골드 파밍을 하면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.796,
                "end": 23.643
            },
            {
                "speaker_id": "1",
                "transcription": "체굴 레벨을 올리면 골드 획득량도 올라갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.653,
                "end": 26.529
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 문외 레벨도 올려주고요 자 이렇게 포탑의 레벨로 올려주면 공격력이 엄청 세져서 좀비들을 많이 죽일 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.539,
                "end": 35.302
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 화면에 보이는 것처럼 다른 유저들과 함께 하는 플레이입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.312,
                "end": 39.047
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 다른 유저와 함께 보스를 죽일 수도 있습니다.",
                "sound_type": [
