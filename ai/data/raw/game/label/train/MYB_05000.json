        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 용, 커, 클 뽑기 확정 나오는 거 일단 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.484
            },
            {
                "speaker_id": "1",
                "transcription": "보는 게 저는 되게 확률이 높게 나왔던 거 같아서 보고 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.494,
                "end": 7.361
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키 안 뽑으면 찐따인가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.371,
                "end": 9.461
            },
            {
                "speaker_id": "1",
                "transcription": "지금 현재 아레나 상황이 블랙펄 쿠키가 없으면은 승률이 거의 뭐 안 나온 사람은 20퍼센트도 안 나와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.471,
                "end": 16.100
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 블랙펄 쿠키가 있으면은 이제 승률이 확 올라갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.110,
                "end": 19.090
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하나를 쓰고 안 쓰고 차이가 그렇게 많이 나는 상황이라 그렇게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.100,
                "end": 23.258
            },
            {
                "speaker_id": "1",
                "transcription": "목화 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.268,
                "end": 24.582
            },
            {
                "speaker_id": "1",
                "transcription": "목화 맛 쿠키도 여러분들 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.592,
                "end": 26.697
            },
            {
                "speaker_id": "1",
                "transcription": "힐러 추천해 달라는 분들 있는데 힐러 같은 경우에는 딱 두 개만 키우면 돼요. 에픽에서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.707,
                "end": 31.889
            },
            {
                "speaker_id": "1",
                "transcription": "목화랑 크림 유니콘 초보자 분들은 그 두 개를 우선으로 키우시면 됩니다 서로 파우더 겹치는 것도 아니거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.899,
                "end": 38.759
            },
            {
                "speaker_id": "1",
                "transcription": "목화는 지원형이고 크림 유니콘은 회복형이기 때문에 여러분들이 부담 없어요. 스킬 파우더 이제 부담 자체가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.769,
                "end": 47.633
            }
        ]
    },
    "summary": "아레나 상황이 블랙펄 쿠키가 없으면 승률이 20퍼센트도 안 나오는데 쿠키가 있으면 승률이 확 올라간다고 했고 힐러 추천해 달라는 분들이 있는데 힐러 같은 경우에 초보자 분들은 목화랑 크림 유니콘 두 개를 우선으로 키우시면 되는데 목화는 지원형, 크림 유니콘은 회복형이기 때문에 부담이 없다고 한다.",
