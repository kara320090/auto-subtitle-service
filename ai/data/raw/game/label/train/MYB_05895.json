        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 여기도 백사십만 이렇게 더 나오게 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.599
            },
            {
                "speaker_id": "1",
                "transcription": "자 한 번 더 네 보여드리고 가도록 할게요. 연습모드로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.609,
                "end": 11.224
            },
            {
                "speaker_id": "1",
                "transcription": "자 시작할 때 중요한 거 자동 끄고 자 자동 끄고 자 에클레어가 네 가즈마 이때 써주시면 되고 자동 한 다음에 에클레어 눌러주고 자 일단 보스 출현 자동 끄고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.234,
                "end": 26.390
            },
            {
                "speaker_id": "1",
                "transcription": "예 아포가토 눌러주고 다시 자동",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.400,
                "end": 29.192
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 아무것도 안누르고 쭉 가면 됩니다. 자 다크카카오가 다크초코가 스킬을 쓰게 되면은 에클레어 자동 걸어주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.202,
                "end": 39.888
            },
            {
                "speaker_id": "1",
                "transcription": "자 자동 걸어주고 이 자동 걸어주는 이유를 말해라 라고 한다면 오차가 없기 위해서예요. 사람마다 누르는거 타이밍이 다르기 때문에",
                "sound_type": [
                    2,
