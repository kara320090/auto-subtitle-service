            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 자색 고구마가 화려하게 부활했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.614
            },
            {
                "speaker_id": "1",
                "transcription": "제가 캡사이신 5초월을 찍었는데 이 5초월 보다도 승률이 더 좋게 나오고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.624,
                "end": 9.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 저뿐만 아니라 지금 방어 기록을 보게 되면 자색 고구마를 이용한 공덱이 방어덱 기록에 남아 있습니다. 이만큼",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.316,
                "end": 16.815
            },
            {
                "speaker_id": "1",
                "transcription": "지금 최상위권에서는 자색 고구마가 대유행 중이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.825,
                "end": 20.878
            },
            {
                "speaker_id": "1",
                "transcription": "물론 그마1이나 그마2 구간 아니더라도 마스터 구간에서도 자색 고구마가 퍼져서 점점 많이 쓰고 있는 추세고 일단 세팅부터 보면 무공비 호루라기 시계 보물 쓰시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.888,
                "end": 33.375
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리 같은 경우에는 쿨이 높으면 높을수록 저는 좋은 것 같았습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.385,
                "end": 37.094
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 세팅이 쿨을 이렇게 높게 하기 힘드신 분들은 올 쿨세팅으로 20퍼센트 이상만 시경 써서 세팅해 주시면 좋고 자색 고구마 같은 경우에는 쿨타임 2.8퍼센트 이상 2.8퍼센트 이상해 주셔야 3초 자구마를 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.104,
                "end": 53.586
            },
            {
                "speaker_id": "1",
                "transcription": "피해감소는 높을수록 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.596,
                "end": 56.699
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 되면 공치 그리고 스타더스트는 올 애플젤리입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.709,
                "end": 60.660
            },
            {
                "speaker_id": "1",
                "transcription": "올 쿨 같은 경우에는 스킬 순서가 요렇게 가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.670,
                "end": 63.797
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 4쿨 1아몬드 이렇게도 스킬 순서가 요렇게 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.807,
                "end": 68.291
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 제가 추천드리는 거는 올 애플젤리 해야 스킬 순서가 요렇게 홀리베디 자색 고구마 스타더스트 순으로 가기 때문에 올 애플젤리 추천드리고 자 달빛술사 같은 경우에는 3쿨에다가 2아몬드 줬고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.301,
                "end": 82.180
            },
            {
                "speaker_id": "1",
                "transcription": "피감은 최대한 높게 그리고 쿨타임도 가급적이면 최대한 높게 세팅을 해주시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.190,
                "end": 88.574
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 있으시면 공치나 뭐 공속 줘서 세팅을 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.584,
                "end": 93.366
            },
            {
                "speaker_id": "1",
                "transcription": "자 BTS 쿠키는 올쿨 세팅을 해주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.376,
                "end": 98.400
            }
        ]
    },
    "summary": "방어 기록을 보게 되면 자색 고구마를 이용한 공덱이 방어덱 기록에 남아 있고 자색 고구마가 화려하게 부활했다고 남자가 설명하고 있다.",
