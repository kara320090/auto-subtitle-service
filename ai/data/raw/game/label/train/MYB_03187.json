        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.838
            },
            {
                "speaker_id": "1",
                "transcription": "자 아주 스타트 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.848,
                "end": 10.009
            },
            {
                "speaker_id": "1",
                "transcription": "자 고대 전술 당연히 누구 선택하냐?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.019,
                "end": 13.468
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 스타트 자 홀베 출격 자 이제 스타트 하기 전에 왕국에 여러분들 요 잡초를 제거를 좀 해줘야 됩니다 왜냐 가뜩이나 초반에는 영토가 좁아 터지는데 이거 잡초까지 다 같이 공존하기에는 너무 힘들어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.478,
                "end": 36.084
            },
            {
                "speaker_id": "1",
                "transcription": "노움 집 있죠 바로 사세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 36.094,
                "end": 38.104
            },
            {
                "speaker_id": "1",
                "transcription": "크리스탈 800개로 왜냐 초반에 가뜩이나 건설할 거 많고 할 거 많은데 저거 800개 아낀다?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.114,
                "end": 44.811
            },
            {
                "speaker_id": "1",
                "transcription": "의미없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.821,
                "end": 45.994
            },
            {
                "speaker_id": "1",
                "transcription": "큰 그림으로 보면은 저거 아끼는 게 의미가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.004,
                "end": 49.195
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.205,
                "end": 50.159
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 초반에 스토리 저 끝에까지 거기까지 빨리깨야 될 이유가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.169,
                "end": 53.928
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 쿠키성을 바로 오픈해줘야 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.938,
                "end": 57.765
            },
            {
                "speaker_id": "1",
                "transcription": "여러 가지 다른 생산건물이나 이런 거 발전이 늦을 수밖에 없기 때문에 딴짓하지 마시고 시작하자마자는 바로 1 다시 13까지 바로바로 풀어주시는 게 중요해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.775,
                "end": 67.445
            },
            {
                "speaker_id": "1",
                "transcription": "야 선택 상자도 있네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.455,
                "end": 68.912
            },
            {
                "speaker_id": "1",
                "transcription": "이거 쓰지 마세요 초반에 바로 쓰지마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.922,
                "end": 70.789
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거는 언제 쓰냐면은 쿠키 뽑기가 어느 정도 좀 됐다?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.799,
                "end": 74.578
            },
            {
                "speaker_id": "1",
                "transcription": "진행됐을 때 이제 조각이 부족해질 때 그때 선택해서 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.588,
                "end": 79.016
            },
            {
                "speaker_id": "1",
                "transcription": "자 왔습니다 그 시간이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.026,
                "end": 81.242
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 출발",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.252,
                "end": 85.083
            }
        ]
    },
    "summary": "고대 전술로 홀리베리를 선택하고 출발하기 전에 왕국 영토가 좁기 때문에 잔디 깎이를 해주고 그러기 위해서 노움집을 바로 구매해줘야 하는 데 크리스탈을 아낄 필요가 없는 중요한 집이며 초반이나 스토리 저 끝까지 빠르게 깨는 것이 중요합니다.",
