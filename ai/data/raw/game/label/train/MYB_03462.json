        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 보면은 블랙펄이 살짝 제가 미세하게 빨라요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.393
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 보여드리고 싶은 하이라이트 장면입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.403,
                "end": 13.709
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 엄청나게 중요한 장면이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.719,
                "end": 15.940
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄이 지금 날아가고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.950,
                "end": 18.409
            },
            {
                "speaker_id": "1",
                "transcription": "근데 또 하나의 공격 요소가 또 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.419,
                "end": 20.758
            },
            {
                "speaker_id": "1",
                "transcription": "뭐냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.768,
                "end": 21.354
            },
            {
                "speaker_id": "1",
                "transcription": "우측에 보면은 모노쿨 시계가 돌아가고 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.364,
                "end": 23.762
            },
            {
                "speaker_id": "1",
                "transcription": "그 상대방도 모노클 덱이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.772,
                "end": 25.637
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 클로티드 피가 다 차있는 거 여러분들 확인 가능하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.647,
                "end": 29.062
            },
            {
                "speaker_id": "1",
                "transcription": "이 피가 이 한 번의 공격으로 싹 다 사라질 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.072,
                "end": 32.525
            },
            {
                "speaker_id": "1",
                "transcription": "아까 말씀드렸듯이 모노쿨도 하나의 공격 포인트로 작용해서 플랙펄 디버프가 들어가면은 해제되면은 이제 딜이 들어가거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.535,
                "end": 40.606
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도의 피가 닳고 블랙펄이 이 정도 피를 달아주면은 이게 날아갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.616,
                "end": 46.750
            }
        ]
    },
    "summary": "블랙펄이 날아갈 때 모노쿨 시계라는 또 하나의 공격 요소가 있습니다.",
