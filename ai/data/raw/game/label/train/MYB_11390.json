        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 소름 끼쳐 진짜 그쵸?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.945
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 어떡하니 이걸 진짜 어유 감사해요.",
                "sound_type": [
                    2
                ],
                "start": 1.955,
                "end": 6.935
            },
            {
                "speaker_id": "1",
                "transcription": "돌겠네 진짜.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.945,
                "end": 8.527
            },
            {
                "speaker_id": "2",
                "transcription": "물론 그때는 추측성 썰 게임 시작 전 화면에 클라이브의 모습의 이프리트와 겹친 모습이 있었는데 그게 지금 진짜가 된 거네요.",
                "sound_type": [
                    2
                ],
                "start": 8.537,
                "end": 19.211
            },
            {
                "speaker_id": "1",
                "transcription": "애지네요 진짜.",
                "sound_type": [
                    2
                ],
                "start": 19.221,
                "end": 20.516
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 쌉 애지네요 정말.",
                "sound_type": [
                    2
                ],
                "start": 20.526,
                "end": 22.464
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 말로 할 수가 없다 진짜 더 이상 어유 감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 22.474,
                "end": 26.280
            },
            {
                "speaker_id": "1",
                "transcription": "어 아 이게 이제 윈드 샤드가 가루다의 힘이 깃은 결정이래.",
                "sound_type": [
                    2
                ],
                "start": 26.290,
                "end": 35.638
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 가슴이 웅장해진다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 35.648,
                "end": 39.382
            },
            {
                "speaker_id": "1",
                "transcription": "방금 폭발하는 장면 같은 거 썸네일로 쓰면 스포가 되겠죠?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 39.392,
                "end": 47.600
