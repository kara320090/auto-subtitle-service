        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 먼저 토핑 강화하실 때 여러분들 12강까지 강화할 때 방어력, 치명타 피해감소, 해로운 효과, 이로운 효과 증가, 체력 이런 걸 가지고도 12강까지 올리시는 분들이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 12.968
            },
            {
                "speaker_id": "1",
                "transcription": "아무거나 12강까지 올리는 게 아니고요 일반적으로 제가 추천드리는 거는 피해감소 4퍼센트 이상 쿨타임은 전부 다 올려도 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.978,
                "end": 22.066
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 공격력은 제 기준으로는 2퍼센트 이상 아 그리고 공격속도도 2퍼센트 이상 치명타 확률도 2퍼센트 이상인데 공력력, 치명타 확률, 공격속도는 6강에서 12강까지 올리라는 게 아니라 높은 수치가 뜨면은 가지고 있다가 여유가 될 때 그때 올리시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.076,
                "end": 38.919
            },
            {
                "speaker_id": "1",
                "transcription": "예 6강에서 12강으로 올리는 건 피해감소랑 쿨타임만 초보자분들은 올리시는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.929,
                "end": 46.314
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 피해감소랑 쿨타임이 가장 많이 쓰이기 때문에 이 2가지 요소를 집중적으로 올리시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.324,
                "end": 54.157
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 또 하나 가장 큰 실수 하나가 특별 토핑이 첫 번째가 피해감소가 안 나오고 두 번째가 피해감소가 안 나왔다고 그냥 지워버리는 사람도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.167,
                "end": 64.131
            },
            {
                "speaker_id": "1",
                "transcription": "절대 지우면 안 됩니다 무조건 12강까지 올리셔야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.141,
                "end": 69.275
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 특별 토핑은 최소 수치가 되게 높습니다 그리고 최대 수치는 동일하기 때문에 마지막에서 피해감소 수치가 6퍼센트 뜰 가능성도 있어요 절대 지우지 말고 12강까지 해주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.285,
                "end": 84.000
            },
            {
                "speaker_id": "1",
                "transcription": "잠시 광고 하나 하고 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.010,
                "end": 86.092
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 무지개 큐브 많이 부족하시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.102,
                "end": 88.501
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.511,
                "end": 93.956
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.966,
                "end": 98.529
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원 가격에 해당하는 가격인데 제가 무료로 나눠드리고 있는데 받는 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.539,
                "end": 110.132
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱을 다운로드 받으시고 우측 하단에 프로필을 누르시고 우측 상단에 톱니바퀴를 누르면 시크릿 코드 입력하는 데가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.142,
                "end": 120.331
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오ND러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 120.341,
                "end": 124.717
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 앱은 도대체 어떤걸까 자 여러분들이 게임만 해도 자동으로 쌓이는 잼을 가지고 자 상점에서 원하는 기프트카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 124.727,
                "end": 136.028
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임하면서 여러분들한테 따로 광고가 뜨지도 않고요 방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 136.038,
                "end": 142.016
            },
            {
                "speaker_id": "1",
                "transcription": "자 시크릿 코드 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 142.026,
                "end": 147.883
            },
            {
                "speaker_id": "1",
                "transcription": "자세한는 내용은 고정 댓글을 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 147.893,
                "end": 150.865
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 하나 자 여러분들 강화 분해할 때 이 에픽 토핑은 제가 추천드리는 거는 라즈베리 그리고 아몬드 그리고 애플젤리 초콜릿은 분해하면 안되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 150.875,
                "end": 160.888
            },
            {
                "speaker_id": "1",
                "transcription": "캐러멜도 나중에 쓰일데가 있기 때문에 고인물 분들은 강화하는 분도 있다는 거 나머지 헤이즐넛, 초코캔디, 땅콩, 호두, 키위는 분해 하셔도 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 160.898,
                "end": 172.134
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 땅콩도 일부 유저분들은 쓰는 분도 있지만 초보자분들은 딱히 쓸데가 많이 없으실 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 172.144,
                "end": 178.143
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 중급 토핑은 전부 다 분해해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 178.153,
                "end": 182.043
            },
            {
                "speaker_id": "1",
                "transcription": "자 한 가지 더 완전 초보자 분들 시작한지 얼마 안 된 분들은 토핑을 12강까지 올리시면 안됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 182.053,
                "end": 188.802
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 자 초반에는 쿠키성 레벨 12레벨까지 빠르게 올려야 되기 때문에 12강까지 하면 코인이 너무나 부족해져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 188.800,
                "end": 196.567
            },
            {
                "speaker_id": "1",
                "transcription": "6강까지만 올리고 쓰다가 여유가 될 때 12성까지 찍고 나서 여유가 될 때 12강까지 찍어도 늦지 않아 요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 196.567,
                "end": 204.602
            },
            {
                "speaker_id": "1",
                "transcription": "처음부터 12강까지 이렇게 전부 다 찍으면서 올라가면은 쿠키성 레벨업을 할 수가 없기 때문에 여유가 될 때 12강 찍어주시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 204.612,
                "end": 212.516
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 2번째 가장 해서는 안 될 행동 고기젤리 많이 쌓는 행동 자 쿠키런 킹덤에서 가장 잘못 알고 있는 상식 중에 하나가 쿠키의 승급이 제일 중요하다 생각하는 분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 212.526,
                "end": 224.652
            },
            {
                "speaker_id": "1",
                "transcription": "또는 쿠키의 전투력이 가장 중요하다생각하는 분들이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 224.662,
                "end": 228.366
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤은 승급과 전투력이 가장 중요한 요소가 아니고요 가장 중요한 요소는 토핑입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 228.376,
                "end": 235.704
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 쿠키의 생존을 결정하는 가장 중요한 요소는 쿠키의 피해감소예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 235.714,
                "end": 242.413
            },
            {
                "speaker_id": "1",
                "transcription": "피해감소가 낮으면 5초월이라고 하더라도 쉽게 죽습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 242.423,
                "end": 247.189
            },
            {
                "speaker_id": "1",
                "transcription": "토핑작을 정말 열심히 하셔야 되고요 토핑작을 하기 위해서는 이 고기젤리를 토핑 조각으로 바꿔줄 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 247.199,
                "end": 255.160
            },
            {
                "speaker_id": "1",
                "transcription": "자 월드 탐험에서 자 8 다시 29에 라즈베리, 아몬드 여기서 파밍하시거나 쿨 토핑이 가장 높은 데서 이렇게 파밍하셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 255.170,
                "end": 263.263
            },
            {
                "speaker_id": "1",
                "transcription": "자 파밍할 때 보면 원하는 토핑과 이렇게 토핑 조각을 얻을 수가 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 263.273,
                "end": 267.621
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 지금 이 순간에도 나는 고기젤리가 항상 쌓여있다 그런 분들은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 267.631,
                "end": 274.066
            }
        ]
    },
    "summary": "먼저 토핑 강화하실 때 아무거나 다 12강으로 올리지 마시고 피해감소랑 쿨타임이 가장 많이 쓰이기 때문에 이 2가지 요소를 집중적으로 올리시면 되고 특별 토핑이 피해감소가 안 나왔다고 해서 지우면 안 되고 무조건 12강까지 올려야 하며 고기젤리를 토핑 조각으로 바꿔서 열심히 토핑작을 해야 한다.",
