        "term": [
            {
                "speaker_id": "1",
                "transcription": "우투브에 기다리는 사람이 있었어.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.651
            },
            {
                "speaker_id": "1",
                "transcription": "내일 또 올건데 나 내일 또 오는데?",
                "sound_type": [
                    2
                ],
                "start": 1.661,
                "end": 6.066
            },
            {
                "speaker_id": "1",
                "transcription": "저장하고",
                "sound_type": [
                    2
                ],
                "start": 6.076,
                "end": 10.440
            },
            {
                "speaker_id": "1",
                "transcription": "맨날 방종만하시네요 하루도 빠짐없이",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.450,
                "end": 25.307
            },
            {
                "speaker_id": "1",
                "transcription": "뱅온도 하잖아요.",
                "sound_type": [
                    2
                ],
                "start": 25.317,
                "end": 26.966
            },
            {
                "speaker_id": "1",
                "transcription": "뱅온도 하지 않겠겠어요 제가?",
                "sound_type": [
                    2
                ],
                "start": 26.976,
                "end": 30.063
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 사람이 방종만 하겠어요 방송이 켜졌으니까 방종을 하는 거겠지.",
                "sound_type": [
                    2
                ],
                "start": 30.073,
                "end": 35.002
            },
            {
                "speaker_id": "1",
                "transcription": "아유 감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 35.012,
                "end": 36.613
            },
            {
                "speaker_id": "1",
                "transcription": "팔로우도 감사드려요.",
                "sound_type": [
                    2
                ],
                "start": 36.623,
                "end": 39.004
            },
            {
                "speaker_id": "1",
                "transcription": "나를 팔로우 해주다니 정말 고맙겠군요.",
                "sound_type": [
                    2
                ],
                "start": 39.014,
                "end": 42.173
            },
            {
                "speaker_id": "1",
                "transcription": "암튼 그래서 오늘은 여기까지",
                "sound_type": [
                    2
                ],
                "start": 42.183,
                "end": 45.766
            }
        ]
    },
    "summary": "방종만 하냐는 말에 방송도 켰으니까 방종도 한다고 말한다.",
