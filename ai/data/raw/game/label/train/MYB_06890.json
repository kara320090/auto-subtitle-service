        "term": [
            {
                "speaker_id": "1",
                "transcription": "다른 사람들한테 이상한 거 추천하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.913
            },
            {
                "speaker_id": "1",
                "transcription": "뭐가 방송 시청이 힘들죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.923,
                "end": 3.847
            },
            {
                "speaker_id": "1",
                "transcription": "아 저걸 깨야 되는데 아 밑으로 와버렸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.857,
                "end": 7.136
            },
            {
                "speaker_id": "1",
                "transcription": "이 앞은 여과막 지역이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.146,
                "end": 11.212
            },
            {
                "speaker_id": "1",
                "transcription": "관으로 들어가면 들어왔던 관으로 다시 못 들어와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.222,
                "end": 14.890
            },
            {
                "speaker_id": "1",
                "transcription": "판막이 가로막을 테니 말이지.",
