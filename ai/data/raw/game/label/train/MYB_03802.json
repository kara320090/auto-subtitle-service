            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 뭐 이 정도까지 네 보여드렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 분명히 여러분들 세팅 보면은 어렵다 하시는 분들이 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.316,
                "end": 7.333
            },
            {
                "speaker_id": "1",
                "transcription": "아마 요거는 맞출 수 있겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.333,
                "end": 9.242
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 아마 맞추실 수 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.252,
                "end": 10.866
            },
            {
                "speaker_id": "1",
                "transcription": "문제는 아마 이걸 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.873,
                "end": 12.419
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들 24점 6퍼센트에 맞추라는 게 아니라 그냥 최대한 그냥 쿨 높게 여유되는 대로 한번 해보세요 피감이랑.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.429,
                "end": 18.869
            },
            {
                "speaker_id": "1",
                "transcription": "네 그리고 서리도 마찬가지 쿨 능력껏 최대한 높게끔 음유시인은 뭐 피감 그렇게까지 높게는 필요 없는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.879,
                "end": 25.970
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 맨 후방에서 보니까 뭐 피가 아슬아슬한 경우는 거의 없었거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.980,
                "end": 30.326
            },
            {
                "speaker_id": "1",
                "transcription": "보니까 어느 정도 그냥 40퍼센트 초중반만 돼도 되지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.336,
                "end": 34.893
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임 어느 정도 챙기면서 어 한번 써보시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.903,
                "end": 37.890
            },
            {
                "speaker_id": "1",
                "transcription": "정말 한국인이 좋아하는 속도 그리고 엄청난 폭딜 그런 걸 모두 갖춘 정말 만능 승률 지금 아레나 100퍼센트입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.900,
                "end": 46.173
            },
            {
                "speaker_id": "1",
                "transcription": "1번도 안 졌어요 리뷰할 때까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.180,
                "end": 48.173
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들도 한번 세팅 한번 해보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.166,
                "end": 65.745
            }
        ]
    },
