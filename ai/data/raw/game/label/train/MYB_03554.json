        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.200
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.200,
                "end": 6.340
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.340,
                "end": 10.379
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄 관련해서 현재 첫 번째 대미지가 좀 비정상적인 버그가 있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.389,
                "end": 15.890
            },
            {
                "speaker_id": "1",
                "transcription": "평타 대미지가 비정상적으로 많이 나타나는 버그가 있었고 이 화면을 보면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.880,
                "end": 21.098
            },
            {
                "speaker_id": "1",
                "transcription": "평타 딜이 685만 5137 1대 평타 딜이에요 뭐 스킬 딜도 아니고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.108,
                "end": 27.276
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 비정상적으로 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.286,
                "end": 29.549
            },
            {
                "speaker_id": "1",
                "transcription": "600만이라는 딜이 어떤지 피감을 안 하시거나 초보자분들이나 감이 안 오실 텐데 이 호일맛 쿠키의 스킬 딜이 전부 다 풀 딜이 들어가도 680만이라는 딜이 거의 나오기 힘든 딜입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.559,
                "end": 41.857
            },
            {
                "speaker_id": "1",
                "transcription": "최종적으로 블랙펄이 4500만 거의 뭐 5000만 이런 딜이 나오는 비정상적인 사태가 나오게 됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.867,
                "end": 49.500
            },
            {
                "speaker_id": "1",
                "transcription": "이것뿐만 아니라 아레나에서도 평타 딜이 비정상적으로 나와가지고 좀 문제가 컸던 그런 버그 사태가 있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.500,
                "end": 57.729
            },
            {
                "speaker_id": "1",
                "transcription": "자 최종적으로는 임시 점검해서 여러분들이 이제 점검 보상 이렇게 받게 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.739,
                "end": 62.647
            },
            {
                "speaker_id": "1",
                "transcription": "아직 뭐 이번 현상에 대해서 추가적인 대응을 논의하고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.657,
                "end": 66.738
            },
            {
                "speaker_id": "1",
                "transcription": "그 악용한 분들에 대한 제재나 이런 게 있을 수도 있다는 점 네 아무튼 이렇게 점검이 끝났다 이것까지 최종 결론입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.748,
                "end": 75.682
            },
            {
                "speaker_id": "1",
                "transcription": "최고 논란이 되는 그런 사태가 이렇게 일단 마무리되는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.692,
                "end": 80.428
            },
            {
                "speaker_id": "1",
                "transcription": "추가적인 공지는 나올 것 같습니다 대응에 관련해서는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.438,
                "end": 87.083
            }
        ]
    },
