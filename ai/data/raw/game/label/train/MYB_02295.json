                ],
                "start": 1.051,
                "end": 6.004
            },
            {
                "speaker_id": "1",
                "transcription": "마일리지로 끝 오 야 그런데 퀸아망쿠키 되게 예쁘게 잘 나왔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.014,
                "end": 17.531
            },
            {
                "speaker_id": "1",
                "transcription": "퀸아망맛 쿠키 스킨까지 다 뽑아버렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.541,
                "end": 22.928
            },
            {
                "speaker_id": "1",
                "transcription": "자 이러면 더 이상 뽑을 이유가 없겠죠?",
