        "term": [
            {
                "speaker_id": "1",
                "transcription": "그냥 마일리지로 뽑을게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.041
            },
            {
                "speaker_id": "1",
                "transcription": "이거 뭐 굳이 해야 될 이유가 없잖아.",
                "sound_type": [
