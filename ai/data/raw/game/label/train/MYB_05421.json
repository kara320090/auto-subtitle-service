                    5
                ],
                "start": 0.000,
                "end": 8.642
            },
            {
                "speaker_id": "1",
                "transcription": "어우 재고가 아주 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.652,
                "end": 10.389
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거는 올리세요. 베리 에이드",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.399,
                "end": 12.909
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 테크 다 올리셔야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.919,
                "end": 14.453
            },
            {
                "speaker_id": "1",
                "transcription": "아 재고가 이렇게 많은데 안 올릴 이유가 없지.",
                "sound_type": [
                    2,
