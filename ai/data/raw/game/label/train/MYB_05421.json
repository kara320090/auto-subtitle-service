        "term": [
            {
                "speaker_id": "1",
                "transcription": "그니까 이분은 오로라 생산 자체가 열차나 이런 거 꾸준히 진짜 돌리면서 테크나 이런 걸 안 올리셔 가지고 이렇게 쌓인 거예요.",
                "sound_type": [
                    2,
