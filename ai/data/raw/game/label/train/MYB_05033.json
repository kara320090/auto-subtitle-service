        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "추천드립니다 아니면은 다크랑 그냥 2탱으로 하시는 것도 나쁘지 않고 그리고 지금 소과금으로 하신다고 하는데 패키지 아까 보니까 뭐 코인 관련된 패키지나 뭐 그런 거 사시는 거 같은데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 12.677
            },
            {
                "speaker_id": "1",
                "transcription": "중 소과금으로 한 달에 뭐 10만 원에서 30만 원 과금할 때는 제가 추천드리는 거는 킹덤 패스 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.687,
                "end": 19.416
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 정산 때마다 무조건 구매를 해주시는 게 제일 좋고 그래도 어느 정도 혜자 패키지가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.426,
                "end": 24.426
            },
            {
                "speaker_id": "1",
                "transcription": "만 원 미만의 효율 좋은 거는 다 구매하신 거 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.436,
                "end": 27.863
            },
            {
                "speaker_id": "1",
                "transcription": "4개 좀 너무 스트레스 있다 하면은 5개까지 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.873,
                "end": 31.879
            },
            {
                "speaker_id": "1",
                "transcription": "석상 레벨 신경 써주시고 그다음에 중요한 게 지금 55 55 이렇게 가셨는데 다 똑같이 맞추시면서 올라가는 게 더 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.889,
                "end": 39.766
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면은 얘네가 50레벨로 결정되는 건 5마리 쿠키 중 가장 레벨 낮은 쿠키가 기준 레벨로 잡히고 그 기준 레벨로 잡힌 그 레벨이 나머지 정해지는 수치로 똑같아지기 때문에 51, 51, 51, 51, 52, 51, 52, 52, 52, 52, 52 하나씩 다 똑같이 올라가세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.776,
                "end": 60.461
            },
            {
                "speaker_id": "1",
                "transcription": "석상에 쓰이는 메인 쿠키들은 그다음 이것도 토핑 조각 얻는 효율이 열기구가 가장 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.471,
                "end": 67.311
            },
            {
                "speaker_id": "1",
                "transcription": "텐츠 중에 그렇기 때문에 가장 높은 지역으로 자동 선택해서 얘를 돌려주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.321,
                "end": 73.663
            },
            {
                "speaker_id": "1",
                "transcription": "수호 성전 같은 경우에도 얘는 제가 해보니까 어떤 식으로 하면 되냐면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.673,
                "end": 79.785
            },
            {
                "speaker_id": "1",
                "transcription": "소환 덱을 지금 메인으로 많이 키우셨는데 메인 덱 하나에다가 정말 몰빵을 해서 좋게 해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.795,
                "end": 86.801
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 해서 메인 덱을 하나 가지고 하는 게 훨씬 더 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.811,
                "end": 91.213
            },
            {
                "speaker_id": "1",
                "transcription": "어 방법 같은 경우에는 이 메인 덱 세팅을 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.223,
                "end": 94.583
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 가다가 너무 피가 많이 깎이는 부분이 생긴다 하면은 다른 쿠키로 교체했다가 거기 부분 지나면 다시 메인 세팅으로 돌아오고 그러니까 그런 식으로 운영을 해주시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.593,
                "end": 105.038
            },
            {
                "speaker_id": "1",
                "transcription": "디즈니 뽑기도 해달라고 하셔서 이거 일단 돌려볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.048,
                "end": 109.503
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 109.513,
                "end": 111.100
            }
        ]
    },
    "summary": "중 소과금으로 한 달에 10만 원에서 30만 원 과금할 때는 킹덤 패스를 아레나 정산 때마다 구매를 하는 게 좋으며 석상 레벨을 똑같이 맞추면서 올라가는 게 가장 좋고 소환 덱은 메인 덱 하나에 몰빵을 해서 좋게 하는 게 좋다.",
