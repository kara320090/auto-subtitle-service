        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "우리가 이 이야기를 들었을 때랑 반응이 전혀 달라서 나름 재미있는데?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.699
            },
            {
                "speaker_id": "2",
                "transcription": "엄청 엄청 큰 괴물 금화를 먹는 검은 괴물이야?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 4.709,
                "end": 10.922
            },
            {
                "speaker_id": "2",
                "transcription": "검은 바다 무서워.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 10.932,
                "end": 13.433
            },
            {
                "speaker_id": "2",
                "transcription": "바다에서 무서운 건 전부 모아둔 것 같아.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 13.443,
                "end": 16.909
            },
            {
                "speaker_id": "3",
                "transcription": "딱히 틀린 말은 아니지.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 16.919,
                "end": 18.750
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 제도에서도 가장 위험한 곳이 바로 검은 바다라나?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 18.760,
                "end": 23.375
            },
            {
                "speaker_id": "1",
                "transcription": "농담으로라도 선원들은 검은 바다로 간다는 말을 안 한다니까.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 23.385,
                "end": 27.879
            },
            {
                "speaker_id": "4",
                "transcription": "에이 그건 검은 바다 이야기의 출처가 전부 캡틴이라서잖아.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 27.889,
                "end": 32.976
            },
            {
                "speaker_id": "4",
                "transcription": "정말 과장도 심하시지.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 32.986,
                "end": 34.939
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 존경합니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 34.949,
                "end": 37.629
            },
            {
                "speaker_id": "3",
                "transcription": "아이 그거 진짜라니까.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 37.639,
                "end": 40.089
            },
            {
                "speaker_id": "3",
                "transcription": "그래도 다행인 건 빠르게 조명을 끈 덕분에 우릴 눈치채지 못했다는 거지.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 40.099,
                "end": 45.922
            },
            {
                "speaker_id": "3",
                "transcription": "뭐 눈치채고도 모른 척한 걸지도 모르지만 말이야.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 45.932,
                "end": 52.633
            }
        ]
    },
