    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 오늘 소개해 드릴 덱은 3힐덱 실론 나이트 덱입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.021
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나에서 대 유행하고 있는데 정말 파괴력이 장난이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.031,
                "end": 9.078
            },
            {
                "speaker_id": "1",
                "transcription": "이 콘셉트 자체가 어떤 콘셉트이냐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.088,
                "end": 11.181
            },
            {
                "speaker_id": "1",
                "transcription": "30초까지 실론 나이트를 생존시켜라 그래서 30초 이후에 실론 나이트가 모든 적을 다 휩쓸어버리는 그런 전략입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.191,
                "end": 20.340
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이 조합 같은 경우에는 원래 스냅드래곤 대신에 허브맛 쿠키를 이용해서 @이름1님이 처음에 공략을 올리신 조합인데 허브맛 쿠키가 쓰였다가 이제 3힐 조합으로 변형됐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.350,
                "end": 34.109
            },
            {
                "speaker_id": "1",
                "transcription": "요 조합이 현재 유행하고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.119,
                "end": 36.522
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 써보니까 성능이 어마무시합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.532,
                "end": 40.130
            },
            {
                "speaker_id": "1",
                "transcription": "보물은 증표 호루라기시계고요",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.140,
                "end": 42.829
            },
            {
                "speaker_id": "1",
                "transcription": "자 증표 보물은 홀리베리랑 실론 나이트가 받습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.839,
                "end": 45.988
            },
            {
                "speaker_id": "1",
                "transcription": "토핑같은 경우에는 실론 나이트는 생존이 가장 중요하기 때문에 피해 감소랑 치명타 피해 감소에만 옵션 넣어줬고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.998,
                "end": 53.436
            },
            {
                "speaker_id": "1",
                "transcription": "공격 속도도 1줄은 넣어주시는 게 좋은 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.446,
                "end": 57.545
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 부옵션은 딱히 뭐 그렇게 크게 중요한 거 같지는 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.555,
                "end": 61.522
            },
            {
                "speaker_id": "1",
                "transcription": "체력 부옵션도 있으면 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.532,
                "end": 63.182
            },
            {
                "speaker_id": "1",
                "transcription": "결과적으로는 어차피 생존이 가장 중요하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.192,
                "end": 66.899
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리같은 경우에도 나머지 4개 쿠키는 기존에 쓰던거 그대로 가져왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.909,
                "end": 72.797
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 피감 쿨 힐러 쓰던거 그대로 그냥 가져와서 쓰시면 될 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.807,
                "end": 77.838
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타도 피감 그렇게 높게 안주고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.848,
                "end": 80.568
            },
            {
                "speaker_id": "1",
                "transcription": "아 25퍼센트 미만 그냥 기존에 쓰던 거 가져와서 썼고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.578,
                "end": 84.632
            },
            {
                "speaker_id": "1",
                "transcription": "제가 그리고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.642,
                "end": 85.833
            }
        ]
    },
    "summary": "화자가 3힐 실론 나이트 덱에 대해 설명하고 있다.",
