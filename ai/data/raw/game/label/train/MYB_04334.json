    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "웨어울프랑 우유랑 합한 딜 이랑 찰스랑 웨어울프랑 합한 딜이랑 결국 비슷 비슷해져요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.127
            },
            {
                "speaker_id": "1",
                "transcription": "결국에는 세팅면에서는 우유가 더 쉽기 때문에 난이도는 우유가 더 쉽다.",
                "sound_type": [
                    2
                ],
                "start": 6.137,
                "end": 10.368
            },
            {
                "speaker_id": "1",
                "transcription": "네 또 질문하신 게 휘낭시에 어떻냐고 하시는데 휘낭시에도 똑같이 쓸 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.378,
                "end": 15.254
            },
            {
                "speaker_id": "1",
                "transcription": "소개해 드리는 덱들보다 대략적으로 2천만 정도가 낮습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.264,
                "end": 19.090
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 굳이 휘낭시에 덱을 쓸 이유가 없고 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.100,
                "end": 23.166
            },
            {
                "speaker_id": "1",
                "transcription": "빌드 자체가 뭐 어려운 건 없거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.176,
                "end": 25.200
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에 토핑 세팅은 쿨 23퍼센트 세트 효과 포함하면 28퍼센트 이렇게 맞춰주시고 피감 그냥 가능한 한 높게 여기서 중요한 거는 휘낭시에를 먼저 버프를 걸고 58초에 오먹을 써주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.210,
                "end": 38.350
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 나머지는 똑같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.360,
                "end": 39.630
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 쿨 도는 대로 눌러주시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.640,
                "end": 42.802
            },
            {
                "speaker_id": "1",
                "transcription": "아 이것도 좋네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.812,
                "end": 44.228
            },
            {
                "speaker_id": "1",
                "transcription": "아 휘낭시에도 뭐 나쁘지 않네 딜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.238,
                "end": 47.503
            },
            {
                "speaker_id": "1",
                "transcription": "초반에 쓸 수 있는 찰스 덱 요것까지만 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.513,
                "end": 51.690
            },
            {
                "speaker_id": "1",
                "transcription": "이거 같은 경우에는 이제 초반 1단계부터 30단계까지 쓸 수 있는 덱 입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.700,
                "end": 56.073
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 같은 경우에는 요렇게 찰스는 쿨타임 8퍼센트 체력 부옵션에서 웨어울프 보다 높아야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.083,
                "end": 62.350
            },
            {
                "speaker_id": "1",
                "transcription": "피감은 한 15퍼센트 해야 안전할 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.360,
                "end": 66.221
            },
            {
                "speaker_id": "1",
                "transcription": "좀 안정적으로 초반에 쓸 거면은 한 10퍼센트 뭐 넉넉히 15센트 뭐 줄 수 있는 피감 좀 더 줘서 안정적으로 해도 될 것 같고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.231,
                "end": 74.547
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우에는 쿨 6.5에 11퍼센트 이상하면은 변신 중에 연타 한 번 더 딜 들어가거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.557,
                "end": 82.387
            },
            {
                "speaker_id": "1",
                "transcription": "오징어 먹물 같은 경우에는 뭐 그대로 쿨 3.5에 7퍼센트대 그다음에 뭐 목화 같은 경우에는 24.3퍼센트 이상 31 32도 되긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.397,
                "end": 90.892
            },
            {
                "speaker_id": "1",
                "transcription": "요거 세팅으로 피감 높게 세팅해서 이 빌드 쓰셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.902,
                "end": 94.498
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 빌드 같은 경우에는 목화를 먼저 눌러주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.508,
                "end": 98.576
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 빌드 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.586,
                "end": 100.759
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱 맛 쿠키가 이 계단 올라가기 전에 여기쯤에서 마카롱 쓰시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 100.769,
                "end": 106.066
            }
        ]
    },
    "summary": "남성은 세팅면에서 우유가 더쉽다고 했고 휘낭시에도 딜이 나쁘지 않다고 했고 초반 1단계부터 30단계까지 쓸 수 있는 찰스 섹은 부옵션이 웨어울프 보다 높아야 한다고 했고 해당 빌드는 목화를 먼저 눌러주고 마카롱맛쿠키가 계단 올라가기 전에 마카롱을 쓰라고 했다.",
