                    2,
                    3
                ],
                "start": 8.359,
                "end": 14.696
            },
            {
                "speaker_id": "1",
                "transcription": "쪼꼬만 게 아주 끝까지 살아남아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.706,
                "end": 23.880
            },
            {
                "speaker_id": "1",
                "transcription": "지금 크런치 초코칩이 공속 느리게 하고 소르베도 공속 느리게 해서 상대방이 딜러를 바보로 만드는 세계예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.890,
                "end": 29.424
            },
            {
                "speaker_id": "1",
                "transcription": "크런치 초코칩 대신에 솔방울 넣었을 때 상성이 어떻게 되는지 요것도 한번 파악해 보겠습니다.",
                "sound_type": [
