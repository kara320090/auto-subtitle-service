        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이게 끝이야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 16.674
            },
            {
                "speaker_id": "1",
                "transcription": "아 하나도 안 무섭네 저 놀란 적 한 번도 없네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.684,
                "end": 20.279
            },
            {
                "speaker_id": "1",
                "transcription": "아 참나 아 이거 어쩌나 야 놀란 게 한 번도 없었어",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.289,
                "end": 28.336
            },
            {
                "speaker_id": "1",
                "transcription": "아 참 이 너무 아쉽다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.346,
                "end": 31.959
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 하나도 안 무서워서 금방 끝났네 이게 참 하는 내내 표정 변화가 일도 없었어",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.969,
                "end": 37.797
            },
            {
                "speaker_id": "1",
                "transcription": "아 여러분들 더 무서운 게임 없습니까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.807,
                "end": 40.413
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 여러분들 눈물 흘릴 정도로 진짜 극악의 난이도의 약간 공포 게임 없어요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.423,
                "end": 45.575
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 너무 약간 이지했다 그렇게 보는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.585,
                "end": 66.208
            }
        ]
    },
