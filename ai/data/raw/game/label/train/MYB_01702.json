    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 먼전 68단계 5.2억 나오는 거 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.741
            },
            {
                "speaker_id": "1",
                "transcription": "나름 68단계 정도까지는 저단계로 분류하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.751,
                "end": 8.987
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 처음에 스냅 드래곤 예약해서 발동시켜 주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.997,
                "end": 13.429
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.439,
                "end": 14.591
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 예약을 푸룬주스를 예약을 꼭 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.601,
                "end": 18.201
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 푸룬주스 1순위로 예약 자 푸룬주스가 예약되면은 바로 로얄마가린 쓰는데 여러분들 시작할 때 스킬 연출 효과를 반드시 키고 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.211,
                "end": 29.430
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 연출을 끄고 하시면은 반응 속도가 차이가 나기 때문에 키셔야 빌드대로 하기 좀 편합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.440,
                "end": 35.663
            },
            {
                "speaker_id": "1",
                "transcription": "자 제일 먼저 주스가 발동되자마자 여러분들 로얄마가린 눌러서 발동시켜 주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.673,
                "end": 41.532
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 에클레어 연타 밀키웨이도 연타합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.542,
                "end": 44.892
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 여기서 중요한 게 예약거는 게 스킬 발동이 제일 빠른 거 아닌가요라고 생각하시는 분들 처음에 걸어갈 때는 연타해서 빨리 누르는 게 더 스킬 나가는 게 가장 빠릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.902,
                "end": 56.711
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 초반에는 무조건 연타로 빨리 눌러주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.721,
                "end": 60.354
            },
            {
                "speaker_id": "1",
                "transcription": "밀키웨이도 연타 안 하고 자동 예약하면은 스킬이 밀려서 연타로 빨리 눌러주셔야 빌드대로 잘 돌아갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.364,
                "end": 68.185
            },
            {
                "speaker_id": "1",
                "transcription": "자 밀키도 빨리",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.195,
                "end": 71.500
            }
        ]
    },
    "summary": "남성이 68단계에서 스냅 드래곤 발동을 하고 푸룬주스 예약을 한 다음 로얄마가린, 에클레어, 밀키웨이를 연타해야 한다고 조언한다.",
