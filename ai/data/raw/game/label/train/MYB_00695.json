    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 석상 레벨 올리는데 투자해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.405
            },
            {
                "speaker_id": "1",
                "transcription": "자 가장 많이 질문하는 거 코인 어떻게 모으나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.415,
                "end": 5.449
            },
            {
                "speaker_id": "1",
                "transcription": "자 소원 나무 통해서 버시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.459,
                "end": 8.045
            },
            {
                "speaker_id": "1",
                "transcription": "평일에 월, 화, 수, 목, 금은 미션 3개만 깨시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.055,
                "end": 11.692
            },
            {
                "speaker_id": "1",
                "transcription": "자 고급 재료는 건네주지 마시고 요렇게 기본 재료를 건네줘서 미션 클리어하고요 3단계까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.702,
                "end": 18.833
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 밑에 보면 20퍼센트 추가로 코인을 주죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.843,
                "end": 22.722
            },
            {
                "speaker_id": "1",
                "transcription": "주말에 이렇게 건네주면서 코인을 많이 얻으시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.732,
                "end": 27.528
            },
            {
                "speaker_id": "1",
                "transcription": "자 크리스탈 어디서 버나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.538,
                "end": 29.303
            },
            {
                "speaker_id": "1",
                "transcription": "크리스탈은 스토리 3별 클리어하면은 여러분들이 크리스탈 100개씩 쭉 모을 수가 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.313,
                "end": 34.396
            },
            {
                "speaker_id": "1",
                "transcription": "길드 토벌전 정산, 수호 성전 정산 그리고 아레나 정산, 대난투 정산 등 다양한 정산 통해서 크리스탈 모을 수 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.406,
                "end": 42.673
            },
            {
                "speaker_id": "1",
                "transcription": "초반에는 여러분들 0티어 쿠키들 위주로 모으셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.683,
                "end": 47.138
            },
            {
                "speaker_id": "1",
                "transcription": "자 화면에 보이는 스토리 쿠키 티어 자 스토리 쿠키 티어에서는 여러분들 0티어 위주로 키워주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.148,
                "end": 53.907
            },
            {
                "speaker_id": "1",
                "transcription": "자 스토리 쿠키 티어 0티어에서 우선순위가 아닌 거는 와일드베리 그리고 망고 같은 경우에는 초보자가 우선순위로 키우지는 않으셔도 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.917,
                "end": 64.013
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 아레나 쿠키 티어에서는 어 0티어 쿠키는 여러분들이 우선순위로 키워도 좋지만 바다요정하고 블랙펄 중에서는 블랙펄 위주로 먼저 키우시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.023,
                "end": 74.490
            },
            {
                "speaker_id": "1",
                "transcription": "자 나머지 쿠키들은 나오면 다 먼저 키우셔도 상관없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.500,
                "end": 78.160
            },
            {
                "speaker_id": "1",
                "transcription": "자 이벤트에 보시면 여러분들 고대의 전승이 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.170,
                "end": 80.695
            },
            {
                "speaker_id": "1",
                "transcription": "고대의 전승에서는 네 무조건 홀리데이가 없으면 홀리베리 선택해 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.705,
                "end": 85.357
            },
            {
                "speaker_id": "1",
                "transcription": "네 홀리베리가 있으면 퓨어바닐라 선택해 주시고 다크카카오는 선택 안 하셔도 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.367,
                "end": 91.296
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 레전드 키 선택 상자가 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.306,
                "end": 94.795
            },
            {
                "speaker_id": "1",
                "transcription": "레전드 쿠키 선택 상자에서는 바다요정, 블랙펄, 달빛, 서리여왕이 있는데 4개의 쿠키가 전부 없으면은 1순위 블랙펄 2순위 달빛술사 3순위 바다요정 4순위 서리여왕 이렇게 중요도 순서대로 없는 거 먼저 다 뽑아 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 94.805,
                "end": 111.923
            },
            {
                "speaker_id": "1",
                "transcription": "자 고기젤리는 토핑 조각이랑 동일하다 생각하시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 111.933,
                "end": 114.858
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 조각이 이 게임은 되게 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 114.868,
                "end": 117.029
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 토핑 조각 얻는 방법은 토핑 같은 경우에는 제가 추천하는 건 13 다시 28 또는 여러분들이 가장 높이 올라갈 수 있는 곳에서 따로 해 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 117.039,
                "end": 126.347
            },
            {
                "speaker_id": "1",
                "transcription": "자 나머지 라즈베리, 아몬드는 8 다시 29에서 파밍 해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 126.357,
                "end": 131.325
            },
            {
                "speaker_id": "1",
                "transcription": "자 별사탕 부족해요 하시는 분들 자 쿠키성 레벨 12레벨 올라가면은 쿠키 하우스 10레벨까지 올려 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 131.335,
                "end": 138.402
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 10레벨까지 올려주는 게 가장 효율이 빠르게 올라가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 138.412,
                "end": 142.324
            },
            {
                "speaker_id": "1",
                "transcription": "11레벨 12레벨 13레벨 올라갈 때는 휠이 가파르게 올라가지는 않기 때문에 10레벨까지 빨리 찍어주는 게 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 142.334,
                "end": 149.814
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 제가 자세하게 팁을 담아 놓은 게 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 149.824,
                "end": 152.950
            },
            {
                "speaker_id": "1",
                "transcription": "자 스토리 쿠키 티어 이거 참고해 보시고 자 그리고 이것도 아레나 쿠키 티어 자 그러고 쿠키별 토핑 추천도 여기 따로 담아 놨고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 152.960,
                "end": 161.079
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 재화 모아야 되는지 여기에 재화 관련된 팁 영상도 모아놨습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 161.089,
                "end": 166.239
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 지금 현재 브릭시티 관련돼서 이벤트가 진행 중인데 그 연동할 때 잘못하면 계정이 탈퇴될 수도 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 166.249,
                "end": 173.370
            },
            {
                "speaker_id": "1",
                "transcription": "이 영상도 한번 참고해 보시고 그리고 절대 하지 말아야 될 팁 영상 정리도 여기 따로 모아놨습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 173.380,
                "end": 179.568
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 크리스탈 쿠폰 같은 경우에는 제가 고정 댓글에 쿠폰 입력하는 링크 쿠폰 번호까지 제가 고정 댓글에 달아 놓을 게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 179.578,
                "end": 188.253
            },
            {
                "speaker_id": "1",
                "transcription": "자 이밖에 여러분들 궁금한 점이 있으면은 따로 댓글에 남겨 주시면 제가 복귀 유저분들 신규 유저분들이 궁금한 점 최대한 읽어보고 댓글 달아 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 188.263,
                "end": 199.528
            },
            {
                "speaker_id": "1",
                "transcription": "자 앞으로 도움 되는 영상 정보 위주로 제가 최대한 업로드 하도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 199.538,
                "end": 205.660
            },
            {
                "speaker_id": "1",
                "transcription": "자 구독, 좋아요 그러고 알람 설정까지 한 번씩만 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 205.670,
                "end": 210.186
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 210.196,
                "end": 227.040
            }
        ]
    },
    "summary": "남성이 코인, 크리스탈, 토핑 조각, 별사탕 모으는 방법을 알려주고 쿠키 티어와 이벤트에서 우선순위에 따라 쿠키를 선택하고 키우며 다른 참고 영상들도 소개하면서 마무리 인사를 한다.",
