                ],
                "start": 0.000,
                "end": 3.976
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 감초 괴물 새로운 신규 보스입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.986,
                "end": 9.320
            },
            {
                "speaker_id": "1",
                "transcription": "딜이 아마 높은 단계 가면은 어마무시하게 셀 거 같네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.330,
                "end": 20.897
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 마탕도 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.907,
                "end": 23.718
            },
            {
                "speaker_id": "1",
                "transcription": "우유맛 쿠키가 마법사탕 출시되고 호밀맛 쿠키도 출시가 되는데 다른 거 보다도 이번에 새롭게 빨리 지나가서 못 봤을텐데 이런 보상이 길드 토벌전 메달 교환소가 생기게 되고 여기서 여러분들 레전드 쿠키랑 뭐 다른 재화도 수급이 가능합니다.",
                "sound_type": [
                    2,
