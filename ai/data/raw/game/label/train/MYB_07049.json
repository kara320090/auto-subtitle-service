                    3,
                    5
                ],
                "start": 38.960,
                "end": 41.313
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 그게 여기까지 날아올 줄은 몰랐어 맞으면서 배우는 거지.",
                "sound_type": [
