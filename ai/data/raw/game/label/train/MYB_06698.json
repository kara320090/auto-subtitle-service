        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 앞 백설과가 필요 왜?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.797
            },
            {
                "speaker_id": "1",
                "transcription": "견고 상태에선 넘어짐이 걸리지 않는다고?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.807,
                "end": 9.121
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 먹어 그럼?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.131,
                "end": 13.009
            },
            {
                "speaker_id": "1",
                "transcription": "후후 백설과의 맛은 어떻지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.019,
                "end": 16.250
            },
            {
                "speaker_id": "1",
                "transcription": "먹을 만한가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.260,
                "end": 17.472
            },
            {
                "speaker_id": "1",
                "transcription": "이거 먹어도 괜찮은 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.482,
                "end": 19.534
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 괜찮지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.544,
                "end": 20.794
            },
            {
                "speaker_id": "1",
                "transcription": "백설과는 겨울 공국의 주식이라고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.804,
                "end": 23.141
            },
            {
                "speaker_id": "1",
                "transcription": "추운 곳일수록 더 잘 자라서 세상의 끝의 추위에서만 최고의 과실을 맺지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.151,
                "end": 28.280
            },
            {
                "speaker_id": "1",
                "transcription": "이 백설과에 재미난 이야기가 있는데 한번 들어볼 텐가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.290,
                "end": 32.242
            },
            {
                "speaker_id": "1",
                "transcription": "그래 이왕 겨울 공국까지 온 건데 재밌는 이야기 몇 개 정도 들어 봐야지.",
                "sound_type": [
                    2,
                    3
