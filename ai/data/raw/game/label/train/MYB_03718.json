        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 필요한 거는 다 만렙을 다 찍어놓으셨고 이것도 만렙을 최대한 찍어주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.701
            },
            {
                "speaker_id": "1",
                "transcription": "전투 관련된 건 다 만렙 찍어 주시고 이제 중요한 거는 재고 쪽을 좀 봐야 될 것 같은데 그 전에 연구소부터 봅시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.711,
                "end": 11.772
            },
            {
                "speaker_id": "1",
                "transcription": "자 연구소 잘 찍었고 대장간을 많이 찍어주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.782,
                "end": 16.311
            },
            {
                "speaker_id": "1",
                "transcription": "재고 관리가 안 돼서 지금 더 이상 연구를 하기 힘든 상태인 것 같은데 대장간 먼저 많이 찍어주시고 쭉쭉 올라가서 연구 가속도 있거든요. 여기 뒤에?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.321,
                "end": 27.444
            },
            {
                "speaker_id": "1",
                "transcription": "연구 가속까지라도 빨리 와서 이런 거 많이 찍어주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.454,
                "end": 30.658
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 연구소는 진짜 멈추면 안 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.668,
                "end": 33.073
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤에서 2가지는 절대 24시간 항상 돌아가야 되는게 이 열차랑 연구소거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.083,
                "end": 39.843
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 뭐 열기구도 마찬가지지만 멈추면 안 됩니다.",
                "sound_type": [
                    2,
