        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "실론나이트가 이렇게 먼저 죽어버리죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.644
            },
            {
                "speaker_id": "1",
                "transcription": "이런 그림 때문에 절대 한방덱을 쓰지 말아라 말씀을 드리는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.654,
                "end": 10.805
            },
            {
                "speaker_id": "1",
                "transcription": "가운데 락스타가 보인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.815,
                "end": 12.554
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 원탱일 때 들어가지 말아라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.564,
                "end": 15.042
            },
            {
                "speaker_id": "1",
                "transcription": "한 번 실전에서 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.052,
                "end": 17.615
            },
            {
                "speaker_id": "1",
                "transcription": "이런 경우 가지 말라는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.625,
                "end": 19.438
            },
            {
                "speaker_id": "1",
                "transcription": "과전류 덱일 수 있으니까 들어가지 말아라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.448,
                "end": 21.930
            },
            {
                "speaker_id": "1",
                "transcription": "이 형태는 들어가도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.940,
                "end": 23.699
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 전투력도 높고 3딜러의 형태니까 정확히 저격해서 들어가면 필승이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.709,
                "end": 29.963
            },
            {
                "speaker_id": "1",
                "transcription": "3딜러죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.973,
                "end": 31.075
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 과전류 한방덱에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.085,
                "end": 33.500
            }
        ]
    },
    "summary": "한 남성이 한방덱은 상대가 과전류덱이거나 락스타를 가운데 배치했을 때는 붙으면 안 된다고 설명하고 있다.",
