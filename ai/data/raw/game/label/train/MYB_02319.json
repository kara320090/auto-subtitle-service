    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 화려하게는 잘 만들었네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.436
            },
            {
                "speaker_id": "1",
                "transcription": "누가 보면은 진짜 외관상 정말 재미있는 신규 콘텐츠가 나온 것처럼 막 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.446,
                "end": 9.723
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 네 CM노트가 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.733,
                "end": 13.010
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트 관련된 내용 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.020,
                "end": 14.656
            },
            {
                "speaker_id": "1",
                "transcription": "자 제일 중요한 퀸아망맛 쿠키가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.666,
                "end": 18.033
            },
            {
                "speaker_id": "1",
                "transcription": "방어형이네요 다행히도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.043,
                "end": 19.629
            },
            {
                "speaker_id": "1",
                "transcription": "돌격형이었으면은 지금 3연속으로 돌격형 나왔는데 얘까지 나왔으면은 4연속으로 돌격형이 나와서 정말 엄청나게 욕을 먹었을 텐데 그걸 의식해서 내가 볼 때 방어형으로 내지 않았을까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.639,
                "end": 31.225
            },
            {
                "speaker_id": "1",
                "transcription": "자 퀸아망 쿠키는 패배를 두려워 않는 기사도 스킬을 사용하는 방어형 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.235,
                "end": 36.869
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 설명을 잠깐 보게 되면 스킬 사용 시 일반 공격이 강화돼서 범위가 증가하고 막 칼 같은 거 정말 큰 칼 범위가 나와서 상대를 전체 범위로 공격하는 느낌이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.879,
                "end": 47.778
            },
            {
                "speaker_id": "1",
                "transcription": "빛 속성 피해로 변경되며 공격 속도 증가 버프 수에 비례하여 추가 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.788,
                "end": 53.257
            },
            {
                "speaker_id": "1",
                "transcription": "어 여러분들 공속덱이 내가 볼 땐 이제 대 전성기를 맞지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.267,
                "end": 58.095
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 뒤에 나오겠지만 마들렌 마법 사탕이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.105,
                "end": 61.371
            },
            {
                "speaker_id": "1",
                "transcription": "민트 초코도 상향됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.381,
                "end": 62.948
            },
            {
                "speaker_id": "1",
                "transcription": "공격 속도가 높은 두 아군 쿠키의 공격 속도가 증가하며 아군 쿠키 전체의 공격 속도 감소 저항 버프와 빛 속성 공격 피해량 증가 버프를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.958,
                "end": 75.884
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나게 좀 공속덱을 밀어주겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.894,
                "end": 78.671
            },
            {
                "speaker_id": "1",
                "transcription": "자 스킬 종료 시 빛의 힘을 모아 거대한 대검을 휘둘러 피해 감소를 일부 무시한 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.681,
                "end": 84.796
            },
            {
                "speaker_id": "1",
                "transcription": "참 데브시스터즈 이 피해 감소 무시 좋아해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.806,
                "end": 88.109
            },
            {
                "speaker_id": "1",
                "transcription": "이 피해 감소 무시 달려 있는 사기 쿠키 전통적으로 뭐가 있냐면 블랙펄, 달빛 술사 좋은 쿠키들이 그런 스킬이 있었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.119,
                "end": 95.890
            },
            {
                "speaker_id": "1",
                "transcription": "패배를 두려워 하지 않는 퀸아망맛 쿠키에 디버프가 부여될 경우 자신에게 피해 감소가 증가하고 일반 공격 시 공격 속도 증가 버프가 부여 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.900,
                "end": 104.355
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 디버프가 걸리면 좋은 거네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 104.365,
                "end": 106.130
            },
            {
                "speaker_id": "1",
                "transcription": "좀 나와 봐야 될 것 같은데 결론은 뭐냐면은 공속덱을 대놓고 밀어주겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 106.140,
                "end": 111.063
            },
            {
                "speaker_id": "1",
                "transcription": "대 공속덱의 시대를 열겠다 그런 의미가 좀 보여지네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 111.073,
                "end": 116.259
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 그리고 흥분 라떼맛 쿠키가 마탕이 나오네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 116.269,
                "end": 119.635
            },
            {
                "speaker_id": "1",
                "transcription": "나는 이건 상상도 못했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 119.645,
                "end": 120.939
            },
            {
                "speaker_id": "1",
                "transcription": "넌 왜 나오니 마탕이?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 120.949,
                "end": 122.388
            },
            {
                "speaker_id": "1",
                "transcription": "자 라떼가 더욱 진해진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 122.398,
                "end": 123.969
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 사용 시 아군에게 해로운 효과 감소를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 123.979,
                "end": 127.888
            },
            {
                "speaker_id": "1",
                "transcription": "적들에게는 해로운 효과 증가를 부여하고 1회 피해량이 새로운 효과 증가가 있는 대상에게 추가 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 127.898,
                "end": 134.964
            },
            {
                "speaker_id": "1",
                "transcription": "대상에게 중독 디버프가 있을 경우 치유량 감소 디버프가 부여 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 134.974,
                "end": 139.189
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 방어력은 기존 대비 10퍼센트 증가되고 기본 체력은 기존 대비 9퍼센트 증가됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 139.199,
                "end": 144.160
            },
            {
                "speaker_id": "1",
                "transcription": "공격력은 증가시켜 주지 않네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 144.170,
                "end": 146.438
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이제 메인 마들렌맛 쿠키가 마법 사탕에 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 146.448,
                "end": 150.266
            },
            {
                "speaker_id": "1",
                "transcription": "자 마법 사탕 효과를 보면은 빛의 힘을 받아 스킬에 추가 피해를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 150.276,
                "end": 155.025
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 사용 후 일정 공격 횟수마다 빛의 힘을 방출하여 더 큰 피해를 주며 추가로 최대 체력 비례 고정 피해를 주고 야 사기 나왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 155.035,
                "end": 163.634
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 마들렌 써보신 분은 아시겠지만 지금 딜이 간지러워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 163.644,
                "end": 167.928
            },
            {
                "speaker_id": "1",
                "transcription": "적 때리면은 아프지도 않거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 167.938,
                "end": 169.849
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 최대 체력 비례 고정 피해를 준다면 말이 다르죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 169.859,
                "end": 173.462
            },
            {
                "speaker_id": "1",
                "transcription": "본인의 체력을 회복시킨다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 173.472,
                "end": 175.164
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야 자힐도 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 175.174,
                "end": 176.687
            },
            {
                "speaker_id": "1",
                "transcription": "스킬이 종료되면 남아 있던 빛의 힘이 마들렌에게 보호막까지 생성 어 뭐 대놓고 라즈베리 쓰라는 거 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 176.697,
                "end": 183.023
            },
            {
                "speaker_id": "1",
                "transcription": "이제 옛날에 공속덱 쓸 때 마들렌이 일찍 죽을 수 있어 가지고 라즈베리랑 아몬드랑 섞거나 올 아몬드하거나 그랬거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 183.033,
                "end": 189.794
            },
            {
                "speaker_id": "1",
                "transcription": "근데 대놓고 체력 회복에다가 보호막에다가 이런 식으로 해 준 거 보면은 그냥 공격적으로 써라 약간 그런 느낌이 강하지 않나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 189.804,
                "end": 198.024
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 밸런스 상향도 됐네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 198.034,
                "end": 199.756
            },
            {
                "speaker_id": "1",
                "transcription": "기본 공격력 기존 대비 45퍼센트 미쳤구만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 199.766,
                "end": 203.172
            },
            {
                "speaker_id": "1",
                "transcription": "이 수치가 여러분들 얼마나 대단한가를 말씀드리자면은 승급 하나 당 쿠키 공격력은 2.5에서 3퍼센트 증가합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 203.182,
                "end": 210.191
            },
            {
                "speaker_id": "1",
                "transcription": "근데 지금 45퍼센트라는 거는 이거는 진짜 미친 상향입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 210.201,
                "end": 214.794
            },
            {
                "speaker_id": "1",
                "transcription": "기본 방어력과 체력도 야 14퍼 13퍼센트 이거 내가 볼 땐 공속덱 너무 세게 밀어 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 214.804,
                "end": 222.576
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 신규 스킨 6종 업데이트 어 푸룬 주스, 캡사이신, 퀸아망맛 쿠키 스킨 에픽 스킨이 나오고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 222.586,
                "end": 229.814
            },
            {
                "speaker_id": "1",
                "transcription": "스페셜 뽑기가 나오네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 229.824,
                "end": 231.225
            },
            {
                "speaker_id": "1",
                "transcription": "얘네 라떼, 마라, 마들렌맛 쿠키의 스킨이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 231.235,
                "end": 234.633
            }
        ]
    },
    "summary": "이번 업데이트 내용은 퀸아망맛 쿠키가 출시되고 라떼맛 쿠키와 마들렌맛 쿠키의 마법 사탕 출시되며 신규 스킨 6종이 나온다.",
