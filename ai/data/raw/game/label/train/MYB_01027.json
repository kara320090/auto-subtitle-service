        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 물론 5번 조합은 네 실론 조합한테도 들어가도 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.542
            },
            {
                "speaker_id": "1",
                "transcription": "1탱, 2탱 뭐 저는 가릴 것 없이 다 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.552,
                "end": 6.410
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 안 되는 분들은 5번은 조금 비추하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.420,
                "end": 9.253
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 제가 초보자분들한테는 대표적으로 무난하게 사용하는 홀용스달스 얘가 그냥 무난하게 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.263,
                "end": 16.858
            },
            {
                "speaker_id": "1",
                "transcription": "자 승급이 조금 낮지만 실론나이트를 키운 분들은 이 덱을 적극 활용해서 네 2탱 덱한테 많이 활용하면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.868,
                "end": 25.380
            },
            {
                "speaker_id": "1",
                "transcription": "자 실론나이트를 활용한 한방 덱도 아주 유용하게 사용되니까 여유되는 분들은 한방 덱이나 실론나이트, 소르베 덱 세팅해서 사용하면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.390,
                "end": 34.568
            },
            {
                "speaker_id": "1",
                "transcription": "1, 2, 3, 4, 5번 여러분들 상황에 맞게 대체 쿠키에 맞게 골라서 써 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.578,
                "end": 41.483
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 제가 생각한 아레나에서 가장 좋게 쓰이는 조합들로만 여러분들한테 일단 소개를 해드렸습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.493,
                "end": 48.234
            },
            {
                "speaker_id": "1",
                "transcription": "이거 외에도 다양한 조합들이 많지만 혹시나 여러분들이 추가로 궁금한 사항이 있다면 댓글에 남겨 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.244,
                "end": 56.058
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.068,
                "end": 61.766
            }
        ]
    },
    "summary": "한 남성이 게임 조합 중에서 5번 조합은 스펙이 안 되는 분들에게는 비추천한다고 이야기를 한 후 지금까지 소개한 1번부터 5번까지의 덱은 상황 또는 대체 쿠키에 맞게 골라서 쓰면 된다고 하며 다양한 조합들이 있지만 가장 좋게 쓰이는 조합들을 소개했다고 이야기한다.",
