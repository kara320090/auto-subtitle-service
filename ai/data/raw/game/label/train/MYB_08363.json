        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 여기 여관이고 아 여기도 여기 갔다가 와야겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.946
            },
            {
                "speaker_id": "1",
                "transcription": "갔다가 여관을 가야지 전투 돼요 왜 난 몰랐지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.956,
                "end": 11.684
            },
            {
                "speaker_id": "1",
                "transcription": "아 치코리탄님 어서오세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.694,
                "end": 15.401
            },
            {
                "speaker_id": "1",
                "transcription": "저번 쳐맞고 떨어졌는데 안 된다요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.411,
                "end": 21.711
            },
            {
                "speaker_id": "1",
                "transcription": "나가는 길 다시 해보자 그러면 까악.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 21.721,
                "end": 37.198
            },
            {
                "speaker_id": "1",
                "transcription": "오블린 아 여기서 옛날에 흑기사랑 싸웠는데 헐 충격 이런 전투가 가능했단 말이야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.208,
                "end": 52.566
            }
        ]
    },
    "summary": "게임에서 말을 탄 채로 전투가 안 되는지 알았는데 해보니 되었다.",
