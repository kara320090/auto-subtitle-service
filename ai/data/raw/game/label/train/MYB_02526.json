        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 아까 전판이랑 극과 극이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.131
            },
            {
                "speaker_id": "1",
                "transcription": "아까 전판은 완전 완패했는데 보시는 것 같이 스타더스트가 살아 가지고 딜 좀 넣어주니까 나는 캡사이신이 초월이 없어도 마라맛 쿠키 맛탕만 있어도 이렇게 초월 3초까지 거의 풀 패키지 과금한분을 이길 수 있는 그런 그림이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.141,
                "end": 23.810
            },
            {
                "speaker_id": "1",
                "transcription": "자 웨얼프덱도 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.820,
                "end": 26.271
            },
            {
                "speaker_id": "1",
                "transcription": "지금 방덱으로 되어 있는 게 홀리베리 웨얼프덱이랑 홀리베리 캡사이신덱 뭐 홀리베리 그 다음에 마라덱 요로케 종류별로 있는데 그중에 웨얼플방덱도 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.281,
                "end": 40.222
            },
            {
                "speaker_id": "1",
                "transcription": "마라 맛 쿠키 키워야 되나요 아 여러분들 선택입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.232,
                "end": 43.421
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 키워야 되고 0티어입니다가 아니라 지금 수많은 공덱 수많은 당덱 그중에 하나의 옵션으로 여러분들이 마라 맛탕이 어느 정도 키워져 있는 분도 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.431,
                "end": 55.541
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들 선택해서 키우시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.551,
                "end": 61.269
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 이길 수 있을까?",
                "sound_type": [
                    2,
