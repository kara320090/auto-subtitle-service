        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 제가 해본 결과 어느 정도 이것저것 세팅을 다 해봤거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.074
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 투힐덱으로 해보면은 아까 뭐 최종적으로 이거 한방덱으로도 안 뚫리고 거의 우주 수비적으로 진짜 단단하게 안 뚫리게 무승부까지 갈 정도로 단단하게 할 수 있는 덱이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.084,
                "end": 17.027
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 말고도 여기에 퓨바 자리에다가 달빛 술사나 스타더스트 넣어서도 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.037,
                "end": 22.110
            },
            {
                "speaker_id": "1",
                "transcription": "근데 결론적으로 말씀드리자면은 와일드 베리를 넣고 방덱으로 쓰면은 기존 정석덱에 뚫립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.120,
                "end": 28.371
            },
            {
                "speaker_id": "1",
                "transcription": "다만 아레나에서 얘를 가리게 되면은 만약에 실론 한방덱이 들어오면은 막히거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.381,
                "end": 33.877
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 한마디로 방덱의 다양성이 많아졌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.887,
                "end": 37.326
            },
            {
                "speaker_id": "1",
                "transcription": "경우의 수가 많아졌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.336,
                "end": 38.715
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 여러분들 그렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.725,
                "end": 40.389
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 와일드 베리 마탕 좋나요?라고 물어보신다면 아레나에서 실론 한방덱을 막거나 아니면은 공덱이나 방덱으로 쓸 수 있는 그런 마탕으로 나왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.399,
                "end": 51.280
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 실론 나이트랑 와일드 베리 마탕은 둘 다 좋게 나왔어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.290,
                "end": 54.718
            },
            {
                "speaker_id": "1",
                "transcription": "데브가 의도한대로 아레나에서 활용할 수 있게끔 잘 나온 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.728,
                "end": 59.650
            },
            {
                "speaker_id": "1",
                "transcription": "일단 와일드 베리 마탕까지 여기서 리뷰를 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.660,
                "end": 73.966
            }
        ]
    },
    "summary": "남성이 해본 결과는 투힐덱은 무승부까지 갈 정도의 덱이며 방덱의 경우의 수가 많아졌고 와일드 베리 마탕은 한방덱을 막거나 아니면 공덱이나 방덱으로 쓸 수 있도록 나왔다고 한다.",
