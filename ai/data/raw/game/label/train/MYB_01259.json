        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "스타더스트 자리에 락스타맛 쿠키를 써서 뭐 이렇게 쓰는 버전도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.987
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이것도 아직도 어 많은 유저분들이 쓰는 조합이라 이것도 세팅을 알려드리면 실론나이트 같은 경우에는 피감 높게 쿨 높게 공속도 높으면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.997,
                "end": 15.261
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 되면은 공치 높게 자 홀리베리는 피감 높게 어 쿨 높게 해주시면 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.271,
                "end": 21.511
            },
            {
                "speaker_id": "1",
                "transcription": "락스타는 올쿨 쿨은 이렇게 높을 필요 없이 세트 효과 더해서 22.3퍼센트 이상 소르베도 마찬가지 피감 능력껏 높게 쿨 타임도 높으면 높을수록 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.521,
                "end": 32.870
            },
            {
                "speaker_id": "1",
                "transcription": "스냅 드래곤도 쿨 타입 높으면 높을수록 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.880,
                "end": 36.395
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 쓰시거나 요새는 스냅 드래곤 자리에 파르페 위치하는 게 더 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.405,
                "end": 43.030
            },
            {
                "speaker_id": "1",
                "transcription": "권장은 파르페맛 쿠키 마법사탕 십강 이상 올 쿨로 하시고 쿨은 굳이 안 줘도 되고 피감은 가급적이면 높게 자 이 상태로 쓰셔도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.040,
                "end": 53.799
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기서 락스타 자리에 스타더스트를 놓으면은 공격적인 실론나이트 소르베의 덱이 업그레이드돼서 사용되고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.809,
                "end": 62.315
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 또 여러분들 이게 가운데가 가려져 있 있는 경우가 많을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.325,
                "end": 68.107
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 경우에는 어떻게 이겨야 되나 실론나이트 덱인 건 알겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.117,
                "end": 72.730
            },
            {
                "speaker_id": "1",
                "transcription": "깃털인 거 딱 봐서 아 얘는 실론나이트 덱인 건 알겠는데 어떻게 이 덱을 파해하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.740,
                "end": 78.532
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 굳이 허브맛 쿠키나 이런 걸 쓰지 않고도 파르페맛 쿠키를 키웠다면은 요렇게 이 덱으로도 파해 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.542,
                "end": 86.680
            },
            {
                "speaker_id": "1",
                "transcription": "실론나이트 덱은 깃털 덱은 요 덱으로 잡을 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.690,
                "end": 90.335
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤 같은 경우에는 쿨을 아예 낮춰서 1분 이후에 브레스 나가게 만들어서 상대를 공격해도 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.345,
                "end": 98.949
            },
            {
                "speaker_id": "1",
                "transcription": "그중에서도 제일 유용하게 쓰고 있는 요 조합 제가 실전에서 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.959,
                "end": 106.200
            }
        ]
    },
    "summary": "스타더스트 자리에 락스타맛 쿠키를 쓰는 버전도 있고 많은 유저분들이 쓰는 조합이라 세팅을 알려드리면 실론나이트의 경우 피감 높에 쿨 높게 공속도 높으면 좋고 여유가 있으면 공치 높게 하고 홀리베리는 피감과 쿨 높게 해주고 락스타는 올쿨인데 세트 효과 더해서 22.3퍼센트 이상이고 소르베도 피감 능력껏 높게 하고 쿨 타임 높을수록 좋으며 스냅 드래곤도 쿨 타임이 높을수록 좋아서 이렇게 쓰시거나 스냅 드래곤 자리에 파르페를 위치하는 게 더 좋고 권장은 파르페맛 쿠키 마법사탕 십강 이상에 올 쿨로 하고 쿨은 굳이 안 줘도 되고 피감은 높은 상태로 쓰면 좋고 락스타 자리에 스타더스트를 놓으면 공격적인 실론나이트 소르베의 덱이 업그레이드돼서 사용되고 가운데가 가려져 있는 경우가 많은 텐데 실론나이트 덱에 깃털인 거 딱 봐서 아는데 용과 드래곤 같은 경우 쿨을 아예 맞춰서 1분 이후 브레스 나가게 만들어서 상대를 공격해도 좋다.",
