        "term": [
            {
                "speaker_id": "1",
                "transcription": "예리하다. 타르트 대체 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.446
            },
            {
                "speaker_id": "1",
                "transcription": "일단 공속덱 세팅 말고는 기존 세팅으로 하셔도 돼요. 얘는 따라 하실 거면은 공속 세팅 말고 여기 낫 보물 끼시고 하시면 되구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.456,
                "end": 14.991
            },
            {
                "speaker_id": "1",
                "transcription": "아 요 타르트 자리에다가 용과 끼시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.001,
                "end": 19.695
            },
            {
                "speaker_id": "1",
                "transcription": "용과할 때 낫이에요. 낫 이번 시즌은 더더욱 더 낫이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.705,
                "end": 23.578
            },
            {
                "speaker_id": "1",
                "transcription": "시즌 효과가 치명타 피해 증가기 때문에 오히려 더 낫 써야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.588,
                "end": 28.627
            },
            {
                "speaker_id": "1",
                "transcription": "무난하게 여러분들 원덱 클리어하면 문제가 없다.",
                "sound_type": [
                    2,
                    3
                ],
