        "term": [
            {
                "speaker_id": "1",
                "transcription": "시간이 없는데 잘하는 방법은 없나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.666
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤은 시간이 곧 스팩 상승이기 때문에 진짜 킹덤 만큼은 방법이 없는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.676,
                "end": 9.760
            },
            {
                "speaker_id": "1",
                "transcription": "시간 없는 분들 그나마 좀 더 효율적으로 할 수 있는 방법이 있긴 한데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.770,
                "end": 14.010
            },
            {
                "speaker_id": "1",
                "transcription": "효율적으로 하는 건 뭐 예를 들어서 효율적으로 한다는 게 난 하루에 한 시간밖에 게임을 못해요 그런 분들은 킹덤은 그 한 시간을 여섯 번으로 쪼개서 10분씩 투자하는 게 제일 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.020,
                "end": 28.195
            },
            {
                "speaker_id": "1",
                "transcription": "한 시간 몰아서 하는 것보다 무슨 말인지 알겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.205,
                "end": 31.026
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 아침 점심 저녁 그 3번을 나눠서 좀 하던지 쪼개서 투자해야 돼",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.036,
                "end": 37.288
            },
            {
                "speaker_id": "1",
                "transcription": "복귀 유저인데 뭐부터 키워야 되나요 하시는데 지금 격변의 시기가 왔거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.298,
                "end": 43.338
            },
            {
                "speaker_id": "1",
                "transcription": "제가 쿠키 티어 업데이트하고 바로 제작을 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.348,
                "end": 47.019
            },
            {
                "speaker_id": "1",
                "transcription": "그게 보고 키우시면 될 것 같고 뭐 굳이 지금 당장 키워야 될 거 추천해 주세요라고 말한다면 에픽에서는 캘틴캐비어, 에클리어, 찰스",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.029,
                "end": 57.131
            },
            {
                "speaker_id": "1",
                "transcription": "완전 초보자 분이면 와일드베리도 키우고 좋고 그다음에 BTS 쿠키도 키워야 되고 크림 유니콘도 사실상 힐러 두 마리 쓰는 덱에서는 또 크림 유니콘도 쓰이고 크리스탈 300개만 더 모으고 자 바로 뽑기하고 마무리 지을게요. `",
                "sound_type": [
