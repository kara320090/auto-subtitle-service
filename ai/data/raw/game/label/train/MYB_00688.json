            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이 영상은 프릴해파리 물속성 한방 덱 리뷰입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.951
            },
            {
                "speaker_id": "1",
                "transcription": "자 기존에 사용하던 실론나이트 한방 덱 또는 캡틴캐비어나 다른 밀키웨이, 도넛처럼 방어력 감소를 하는 한방 덱이 아닌 전혀 새로운 물속성 한방 덱이 탄생을 했고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.961,
                "end": 16.405
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 보물 같은 경우에는 무공비 호루라기 시계 보물 자 당연히 호루라기는 프릴이 높으면은 블랙펄 하고 바다요정한테 갈 거고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.415,
                "end": 24.347
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑 같은 경우에는 코랄 올 쿨 프릴은 올 라즈베리 자 요러고 망고는 올 쿨 자 바다요정은 4초 바요를 위해서 11. 8퍼센트 이상 4 라즈 1 쿨 세팅 뭐 블랙펄은 올 아몬드 자 피감 높게 그러고 쿨은 높게 세팅하시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.357,
                "end": 41.509
            },
            {
                "speaker_id": "1",
                "transcription": "상대 블랙펄 하고 1대 1로 마주하는 경우에는 쿨 높은 사람이 이길 수 있기 때문에 자 이 조합은 장점 3 딜 극딜 덱이나 모든 조합한테 좋지만 상대방이 프릴해파리가 있으면은 막힐 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.519,
                "end": 53.697
            },
            {
                "speaker_id": "1",
                "transcription": "자 요러고 이 조합은 되게 비싼 조합입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.707,
                "end": 56.433
            },
            {
                "speaker_id": "1",
                "transcription": "망고도 마탕 있어야 되고 바다요정도 잼스톤이 20강 이상 초월도 30 초월정도는 돼야만 초월 효과에서 추가 물기둥 피해량 추가 물줄기 피해량 기절 3초 요렇게 더 받을 수가 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.443,
                "end": 70.537
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤 레벨이 높아야 당연히 세지기 때문에 좀 더 비싼 조합이지 않나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.547,
                "end": 75.119
            },
            {
                "speaker_id": "1",
                "transcription": "요 영상의 의의는 신규 그래도 한방 덱이 물속성으로 탄생했다는 거에 좀 의의를 두고 여러분한테 적극 추천하는 그런 한방 덱은 아니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.129,
                "end": 85.376
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 한방 덱을 쓸 때 프릴해파리가 있으면 안 되는데 자 보시면 아시겠지만 상대방이 프릴해파리가 있으면은 대각선으로 일치하면은 모양이 똑같다는 얘기거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.386,
                "end": 95.912
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 이런 덱은 들어가면 안 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.922,
                "end": 98.483
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 3딜 극딜덱한테는 엄청나게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.493,
                "end": 101.677
            },
            {
                "speaker_id": "1",
                "transcription": "시작과 동시에 상대 딜러들을 전부 다 녹일 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 101.687,
                "end": 105.518
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 보게 되면 상대가 아무것도 맨 처음에 못하죠. 속박 때문에 자 이렇게 극딜로 가면은 상대 딜러들이 전부 다 녹고 크림슨코랄 하나만 남는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 105.528,
                "end": 118.956
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 1분 되기 전에 순삭 당하는 걸 볼 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 118.966,
                "end": 124.742
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정이 가장 큰 딜을 넣었다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 124.752,
                "end": 127.191
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이 조합 같은 경우에는 @이름1님이 만드신 조합이고 어 저도 리뷰할 때 리뷰 날 완성된 조합이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 127.201,
                "end": 137.108
            },
            {
                "speaker_id": "1",
                "transcription": "근데 너무나 활용하기도 좋고 쓰기 좋지만 가장 치명적인 약점은 프릴해파리가 상대방에 있으면은 쓰기 좀 힘들다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 137.118,
                "end": 147.033
            },
            {
                "speaker_id": "1",
                "transcription": "그거 빼고는 어 상당히 좋은 한방 덱 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 147.043,
                "end": 150.209
            },
            {
                "speaker_id": "1",
                "transcription": "물론 어 스펙도 어느 정도 필요하다는 점 고게 쪼끔 아쉽긴 하죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 150.219,
                "end": 157.355
            },
            {
                "speaker_id": "1",
                "transcription": "무난하게 모두가 쓸 수 있으면 좋겠지만 좀 더 고스펙이 요구되는 한방 덱이라는 점 자 상대방 바다요정 조합도 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 157.365,
                "end": 166.831
            },
            {
                "speaker_id": "1",
                "transcription": "이 조합은 근데 한 여러분들 아시겠지만 아레나에서 방 덱에 프릴해파리가 없는 조합이 거의 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 166.841,
                "end": 173.875
            },
            {
                "speaker_id": "1",
                "transcription": "전부 다 프릴해파리 방 덱을 쓰고 있기 때문에 실제로 사용하기는 쪼끔 힘들기는 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 173.885,
                "end": 180.253
            },
            {
                "speaker_id": "1",
                "transcription": "자 쪼 용과 조합한테도 먹히는지 한번 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 180.263,
                "end": 184.530
            },
            {
                "speaker_id": "1",
                "transcription": "네 방 덱에 용과 조합은 거의 사라졌지만 네 용과 조합한테도 만약에 이 한방 덱이 들어간다면 시작과 동시에 어마무시한 딜이 들어가면서 보이죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 184.540,
                "end": 197.312
            },
            {
                "speaker_id": "1",
                "transcription": "네 앞에 용과 빼고는 홀리베리랑 네 전부 다 녹아버린다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 197.322,
                "end": 203.407
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 프릴해파리 제외하고는 어 전부 다 그냥 순삭 해 버릴 수 있는 약간 한방 덱의 조합에 느낌으로 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 203.417,
                "end": 216.466
            }
        ]
    },
    "summary": "남성이 프릴해파리 물속성 한방 덱 리뷰 영상의 의의는 한방 덱이 물속성으로 탄생했다는 것이고 적극 추천하는 덱은 아니다.",
