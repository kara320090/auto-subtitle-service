        "term": [
            {
                "speaker_id": "1",
                "transcription": "블랙손이 누구야 이름이 사람 이름이 어떻게 흑손.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.057
            },
            {
                "speaker_id": "1",
                "transcription": "어 몬창식 설명 어디야 저기가.",
                "sound_type": [
                    2
                ],
                "start": 6.067,
                "end": 16.287
            },
            {
                "speaker_id": "1",
                "transcription": "아 일단 이거 여기 왔으니까 이거하고 여기 길 좀 복잡해 그쵸?",
                "sound_type": [
                    2
                ],
                "start": 16.297,
                "end": 20.613
            },
            {
                "speaker_id": "1",
                "transcription": "깜짝이야 반말하는 줄 알았어 나한테.",
                "sound_type": [
                    2
                ],
                "start": 20.623,
                "end": 26.075
            },
            {
                "speaker_id": "1",
                "transcription": "로빈 같지 않아요 원피스의 로빈.",
                "sound_type": [
                    2
                ],
                "start": 26.085,
                "end": 29.035
            },
            {
                "speaker_id": "2",
                "transcription": "보이지 않는 손도 있는데요.",
                "sound_type": [
                    2
                ],
                "start": 29.045,
                "end": 31.190
            },
            {
                "speaker_id": "1",
                "transcription": "아 긴팔이었으면 보이지 않는 손 한번 할 텐데 이걸 이렇게 할 수도 없고",
                "sound_type": [
                    2
