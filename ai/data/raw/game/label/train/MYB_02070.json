        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상은 신규 드래곤 쿠키가 유출됐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.042
            },
            {
                "speaker_id": "1",
                "transcription": "그 이미지 자체가 없는 게 아니었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.052,
                "end": 6.286
            },
            {
                "speaker_id": "1",
                "transcription": "되게 귀여운 형식으로 조그맣게 출시될 것 같은데 다음 업데이트가 아마 3주나 2주 뒤에 있을 것 같거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.296,
                "end": 13.221
            },
            {
                "speaker_id": "1",
                "transcription": "그때 제가 또 리뷰를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.231,
                "end": 16.158
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 스킬 파우더 같은 경우에도 미리 뭐 준비하는게 의미 없을 수도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.168,
                "end": 20.803
            },
            {
                "speaker_id": "1",
                "transcription": "BTS처럼 스킬 파우더가 필요없는 형식으로도 나올 수 있으니까 지금으로서는 어떤 유형이다 이걸 예측하는 거는 전혀 의미없는 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.813,
                "end": 30.759
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 자세한 정보가 나온다면 제가 또 다른 영상으로 찾아뵙도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.769,
                "end": 52.550
            }
        ]
    },
    "summary": "신규 드래곤 쿠키가 유출되어 자세한 정보가 나온다면 다시 영상을 업로드 하겠다고 한다.",
