        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 뭐야 뭐 이렇게 바로 쉽게 나와?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.533
            },
            {
                "speaker_id": "1",
                "transcription": "이게 원래 이렇게 쉬운거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.543,
                "end": 4.980
            },
            {
                "speaker_id": "1",
                "transcription": "맞아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.990,
                "end": 6.127
            },
            {
                "speaker_id": "1",
                "transcription": "아니 뭐 이렇게 쉬워?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.137,
                "end": 14.103
            },
            {
                "speaker_id": "1",
                "transcription": "경계를 넘어드는 전령 소르베맛 쿠키 이렇게 쉽게 나오나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.113,
                "end": 21.648
            },
            {
                "speaker_id": "1",
                "transcription": "너무 쉽잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.658,
                "end": 22.899
            },
            {
                "speaker_id": "1",
                "transcription": "이거 여러분들 뽑은 다음에 리뷰까지 바로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.909,
                "end": 25.276
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.286,
                "end": 25.982
            },
            {
                "speaker_id": "1",
                "transcription": "우유가 3개나 나왔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.992,
                "end": 27.607
            },
            {
                "speaker_id": "1",
                "transcription": "야 이게 더 확률이 더 극악이야 여러분들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.617,
                "end": 30.028
            },
            {
                "speaker_id": "1",
                "transcription": "방금 소르베가 나올 확률보다 우유맛 쿠키 뿐만 아니라 초코색으로 다 맞출 확률 야 이렇게 깔맞춤으로 나올 확률이 내가 볼 때는 거의 로또 맞을 확률이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.038,
                "end": 41.035
            },
            {
                "speaker_id": "1",
                "transcription": "야 끝났다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.045,
                "end": 45.021
            },
            {
                "speaker_id": "1",
                "transcription": "종결 끝 아 근데 중복이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.031,
                "end": 51.043
            },
            {
                "speaker_id": "1",
                "transcription": "야아 이게 끝났는데에 하필이면 또 중복으로",
                "sound_type": [
