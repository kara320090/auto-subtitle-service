                ],
                "start": 0.000,
                "end": 7.163
            },
            {
                "speaker_id": "1",
                "transcription": "와 와 이거 또 떴으면 진짜 게임 터졌다 여러분들.",
                "sound_type": [
                    2,
                    3
                ],
