            },
            {
                "speaker_id": "1",
                "transcription": "이런 쿨 높은 거 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.120,
                "end": 4.548
            },
            {
                "speaker_id": "1",
                "transcription": "큘을 쫌 낮으면서 피감 높은 걸로 바꿔주 이런 아몬드 피 쿨 붙는 거는 다른 거에다가 옮겨주는 게 되게 중요합니다.",
                "sound_type": [
