                ],
                "start": 0.000,
                "end": 7.935
            },
            {
                "speaker_id": "1",
                "transcription": "왜 어떻게 말하냐면 공격 보시면 아시겠지만 어마무시하게 많아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.945,
                "end": 12.392
            },
            {
                "speaker_id": "1",
                "transcription": "마라덱 그다음에 블파 신규덱 주스 덱도 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.402,
                "end": 17.109
            },
            {
                "speaker_id": "1",
                "transcription": "실론한방덱도 있습니다. 심지어 뚫립니다. 이것도.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.119,
                "end": 20.283
            },
            {
                "speaker_id": "1",
                "transcription": "어마무시하게 많은 덱들의 종류가 있는데 그 중에서도",
