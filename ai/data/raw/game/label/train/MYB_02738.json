        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러구 빙결덱 하나 그냥 이렇게 해서 등반해도 제가 볼 땐 정말 빙결덱이나 웨울덱이 안 통하는 극소수의 그런 분들이 있긴 한데 그런 분들 제외하고는 웬만해선 많이 잘 잡는 느낌이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 13.867
            },
            {
                "speaker_id": "1",
                "transcription": "자 이덱이 이 한방덱을 어떻게 막는지 제가 고것까지 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.877,
                "end": 19.787
            },
            {
                "speaker_id": "1",
                "transcription": "왜 투탱덱인데 허브가 없는데도 불구하고 어떻게 막는 것인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.797,
                "end": 24.479
            },
            {
                "speaker_id": "1",
                "transcription": "자 얘를 방덱으로 설치해서 여러분들이 만약에 저렇게 한방덱으로 들어온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.489,
                "end": 29.945
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 어 요런 식으로 앞에가 이게 죽어도 상관없는 게 퓨바랑 뒤에가 남아가지고 무조건 이기게 되어 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.955,
                "end": 40.227
            },
            {
                "speaker_id": "1",
                "transcription": "압도적으로 네 요런 식으로 이긴다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.237,
                "end": 45.889
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 심지어 앞에 달빛 혼자만 남아도 달빛이 역전합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.899,
                "end": 51.851
            }
        ]
    },
    "summary": "남성은 게임에서 특정한 세팅으로 어떻게 다른 세팅을 이기는지 보여주겠다고 하면서 게임을 한다.",
