                ],
                "start": 21.037,
                "end": 26.002
            },
            {
                "speaker_id": "1",
                "transcription": "자 뿐만 아니라 힐러로 2개의 쿠키를 쓴다면 락스타맛 쿠키를 가장 많이 활용하게 됩니다.",
                "sound_type": [
