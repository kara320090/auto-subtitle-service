        "term": [
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤 이 두 쿠키가 아레나에서 딜러로 많이 쓰이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.744
            },
            {
                "speaker_id": "1",
                "transcription": "또 추가적으로 스타더스트도 가장 많이 쓰이는 딜러 중에 하나입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.754,
                "end": 8.998
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 용과 드래곤, 블랙펄, 스타더스트를 중심으로 딜러로 활용하시는 게 가장 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.008,
                "end": 16.680
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 홀리베리는 대체 불가능한 필수 0티어입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.690,
                "end": 21.040
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 맨 뒤에 힐러자리는 스냅 드래곤이 가장 많이 활용되고 있고요.",
                "sound_type": [
                    2,
