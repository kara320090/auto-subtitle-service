        "term": [
            {
                "speaker_id": "1",
                "transcription": "세상에 십덕할 때 박하잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.369
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 내가 안 한다고 생각했었을 수도 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.379,
                "end": 5.277
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지만 우리 방에 십덕이 이렇게 많은지는 모르셨을 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.287,
                "end": 8.803
            },
            {
                "speaker_id": "1",
                "transcription": "문제는 로봇십덕이라서 그렇지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.813,
                "end": 10.941
            },
            {
                "speaker_id": "1",
                "transcription": "아 뭐야 왜 안 내려가져.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.951,
                "end": 18.744
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 기본대로 잘 뽑지 않았어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.754,
                "end": 22.716
            },
            {
                "speaker_id": "1",
                "transcription": "누가 기쁨의 눈물을 흘린대.",
