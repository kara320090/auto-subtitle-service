                    2,
                    3
                ],
                "start": 22.726,
                "end": 26.246
            },
            {
                "speaker_id": "1",
                "transcription": "어이 어이 울지 말라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.256,
                "end": 30.700
            }
        ]
    },
    "summary": "우리 방에 십덕이 이렇게 많은지는 모르셨을 건데 문제는 로봇십덕이라고 한다.",
