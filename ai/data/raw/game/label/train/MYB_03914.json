        "term": [
            {
                "speaker_id": "1",
                "transcription": "일단 와베가 여러분들 와베가 왜 떡락한 줄 아세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.582
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에가 너무 좋아 가지고 아레나에서 휘낭시에가 너무 핵 고정이다 보니까 와베가 낄 자리가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.592,
                "end": 10.809
            },
            {
                "speaker_id": "1",
                "transcription": "그 와베 성능 자체가 좀 나쁜 게 아닌데 아군 피해 감소 여러분들이 15퍼센트 스킬 발동 시 15퍼센트 올려주는 것 자체가 진짜 사기적이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.819,
                "end": 20.297
            },
            {
                "speaker_id": "1",
                "transcription": "근데 휘낭시에를 진짜 뺄 수가 없는 구조이기 때문에 어우야 이거 진짜 버그다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.307,
                "end": 27.526
            },
            {
                "speaker_id": "1",
                "transcription": "야 저거 4개 나왔나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.536,
                "end": 28.611
            },
            {
                "speaker_id": "1",
                "transcription": "근데 또 나왔어 다크가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.621,
                "end": 30.217
            },
            {
                "speaker_id": "1",
                "transcription": "야 이 정도 페이스가 제가 첫날 다크카카오 출시됐을 때 첫날에 5성 찍었거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.227,
                "end": 36.327
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도 표였어요 페이스였어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.337,
                "end": 37.937
            },
            {
                "speaker_id": "1",
                "transcription": "저 4개 뽑았나 5개 뽑았나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.947,
                "end": 39.753
            },
            {
                "speaker_id": "1",
                "transcription": "와 무슨 다크카카오가 이렇게 잘 나와?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.763,
                "end": 42.443
            },
            {
                "speaker_id": "1",
                "transcription": "다크카카오 뽑기 장인입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.453,
                "end": 44.813
            },
            {
                "speaker_id": "1",
                "transcription": "야 저게 저게 진짜 싹 다 소르베였으면은 이번 영상 진짜 초대박이었는데 맞죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.823,
                "end": 50.225
            },
            {
                "speaker_id": "1",
                "transcription": "확률은",
