    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "알 수 없지만 대부분은 소르베가 많이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.931
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 중요한 거는 실론나이트가 죽으면은 확실히 아 좀 약간 지는 그림이 많이 나오거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.941,
                "end": 16.603
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그런 게임할 때 아 네 요렇게 이기는 그림도 있지만 실론나이트가 죽으면은 지는 그림도 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.613,
                "end": 27.595
            },
            {
                "speaker_id": "1",
                "transcription": "네 소르베덱은 지는 그림도 나올 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.605,
                "end": 31.299
            },
            {
                "speaker_id": "1",
                "transcription": "요거 알고 계시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.309,
                "end": 33.008
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 실전에서 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.018,
                "end": 36.211
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 여러분들이 아레나 하다 보면은 가운데가 가려져있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.221,
                "end": 39.240
            },
            {
                "speaker_id": "1",
                "transcription": "가운데가 가려졌을 때 무지성으로 이렇게 한방덱으로 들어가 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.250,
                "end": 43.929
            },
            {
                "speaker_id": "1",
                "transcription": "자 가운데 달빛술사, 스타더스트 아마 여러분들 많이 이 덱으로 되어 있을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.939,
                "end": 49.659
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 예상해 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.669,
                "end": 51.360
            },
            {
                "speaker_id": "1",
                "transcription": "가운데 앞에 탱커가 다 날라갈 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.370,
                "end": 54.265
            },
            {
                "speaker_id": "1",
                "transcription": "네 시작하자마자 요렇게 앞에 탱커가 날라가고 가운데 딜러만 남게 될 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.275,
                "end": 61.891
            },
            {
                "speaker_id": "1",
                "transcription": "예 대부분 이렇게 날라가고 네 이렇게 가운데 실론나이트만 남게 돼도",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.901,
                "end": 76.166
            }
        ]
    },
    "summary": "화자가 실론나이트가 죽으면 지는 그림도 나오고 소르베덱이 지는 그림도 나올 수 있는 것을 알고 있어야 하고, 마지막으로 실전을 보여 주며 시작하자마자 탱커가 날라가고 가운데 딜러만 남게 될 거라고 예상을 한다.",
