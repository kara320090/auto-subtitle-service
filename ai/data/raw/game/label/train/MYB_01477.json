        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 토벌 전에 비해서는 토핑 난이도가 많이 내려갔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.445
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 락스타 여러분들 반드시 키워야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.455,
                "end": 7.102
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 낮더라도 토핑으로 여러분들 어느 정도 스펙 극복할 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.112,
                "end": 11.746
            },
            {
                "speaker_id": "1",
                "transcription": "힐량이 적으신 분들 애플젤리로 어느 정도 극복할 수가 있고 피감이 낮다 죽는다 하신 분들은 아몬드도로 극복할 수가 있으니까 어느 정도 여러분들 따라 하실 수 있는 분들은 따라 해 보시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.756,
                "end": 22.649
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 조합 같은 경우에는 처음에 킹길드에서 리사 님한테 토핑을 알려주셨고 그걸 스페셜 길드에서 스페셜 길원분들이 이 토핑이랑 길드를 만들어서 제가 또 여러분들한테 알려드리는 겁니다.",
                "sound_type": [
                    2,
