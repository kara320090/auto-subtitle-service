                    5
                ],
                "start": 16.725,
                "end": 63.996
            },
            {
                "speaker_id": "1",
                "transcription": "어디서 때리는 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.006,
                "end": 65.941
            },
            {
                "speaker_id": "1",
                "transcription": "실드 스킬 아니에요 실드 스킬 너무 80초나 걸려서 그냥 빼버렸어요.",
                "sound_type": [
                    2,
