        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 야 야 이거 탈 수 있네 아 잠깐만 잠깐 멈춰 봐 야 타자 좀 공짜로 탈래 오",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.271
            },
            {
                "speaker_id": "1",
                "transcription": "야 신개념이다 야 야 이거 얼마나 재밌어 그래 이렇게 타면서 좀 돌아댕겨야지",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.281,
                "end": 13.007
            },
            {
                "speaker_id": "1",
                "transcription": "근데 약간 내가 느낀 거는 킹덤이랑 겹치는 건 없긴 하네 많이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.017,
                "end": 18.295
            },
            {
                "speaker_id": "1",
                "transcription": "게임 방향이나 이런 게 완전히 다르긴 해",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.292,
                "end": 20.753
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 점점 시간이 많이 걸리네 아 답답해 아 쓰고 싶지만 참을게요 아 부스터",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.763,
                "end": 27.866
            }
        ]
    },
    "summary": "탈 것을 타고 돌아다닐 수 있고 킹덤이랑 많이 다른 게임이며 점점 시간이 많이 걸리는 게임이다.",
