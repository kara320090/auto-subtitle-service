        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 꽝 나왔고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.203
            },
            {
                "speaker_id": "1",
                "transcription": "자 고급으로 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.213,
                "end": 4.002
            },
            {
                "speaker_id": "1",
                "transcription": "아 제발 오 달빛 3조각 나름 의미가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.012,
                "end": 9.657
            },
            {
                "speaker_id": "1",
                "transcription": "저는 여러분들 초반에 빨리 짓는 빌드로 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.667,
                "end": 12.151
            },
            {
                "speaker_id": "1",
                "transcription": "제가 왜 이렇게 하는 지 알아요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.161,
                "end": 13.589
            },
            {
                "speaker_id": "1",
                "transcription": "오로라 재료가 원래 부족해야 되는데 이벤트로 많이 줄 걸 알고 있기 때문에 초반에 이렇게 짓고 시작하는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.599,
                "end": 19.873
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 레벨은 많이 올리지 말고 천천히를 올리시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.883,
                "end": 23.374
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 게임을 시작했다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.384,
                "end": 25.732
            },
            {
                "speaker_id": "1",
                "transcription": "나는 초반이다 하시는 분들은 고기 젤리가 그냥 무한으로 계속 생길 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.742,
                "end": 30.643
            },
            {
                "speaker_id": "1",
                "transcription": "어디까지 되냐면은 에피소드 아마 3인가 4까지인가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.653,
                "end": 34.472
            },
            {
                "speaker_id": "1",
                "transcription": "거기까지 고기젤리를 써도 써도 계속 생길 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.482,
                "end": 38.144
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 시작을 만약에 게임을 하면은 계속 스토리 진행하고 왕국 꾸미고 왕국 생산하고 이러다보면 3시간 4시간 동안은 그냥 계속 해야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.154,
                "end": 47.658
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키성 오픈하면은 여러분들이 해야 될 게 많아 질 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.668,
                "end": 53.313
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 쿠키 하우스 레벨업도 가능하고 쿠키성도 레벨업 가능하고 풍요의 분수도 레벨업 가능하고 바빠지는 스타트 소원 나무 자 생산 건물이 빨리 지어줘야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.323,
                "end": 66.025
            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 많아졌죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.035,
                "end": 67.329
            },
            {
                "speaker_id": "1",
                "transcription": "이제 생산의 지옥이 시작됐기 때문에 특히나 이 각설탕 채석장 상당히 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.339,
                "end": 74.556
            },
            {
                "speaker_id": "1",
                "transcription": "이것 때문에 고통 많이 받을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 74.566,
                "end": 76.750
            }
        ]
    },
    "summary": "고급으로 가서 달빛 3조각을 얻었고 초반에 빨리 짓는 빌드로 갈건데 오로라가 풍요로울 것을 미리 알고 초반에 이렇게 많이 짓고 있는 것이고 레벨은 천천히 올리셔도 되며 무한으로 생기는 고기 젤리는 많이 써주시고 쿠키성을 오픈하게 되면 갑자기 생산 건물들이 많아 져서 할 일이 많아 집니다.",
