        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그리고 그런 분도 있을 거예요 러너님 저는 시작하자마자 에스프레소가 자꾸 죽어요 막 그런 분들 있죠 근데 그게 보통 뱀파가 너무 일찍 발동돼서 날라가 버려 가지고 에스프레소가 시작하자마자 저격 당해서 죽는 사람도 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 23.347
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그런 분들한테 말씀드리고 싶은 거는 뱀파 쿨이 높은 게 진짜 좋은 게 아니거든요 뱀파 쿨을 다 없애보세요 저 제가 뱀파 쿨을 높여서 보고 낮춰도 보고 해봤는데 최종 결론은 뱀파 쿨 없는 게 전 제일 나았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.357,
                "end": 35.125
            },
            {
                "speaker_id": "1",
                "transcription": "승률도 가장 높고 자 그다음 덱 자 요거 나왔네요 요거 덱 같은 경우에는 지금 전투력 이렇게 돼 있으면은 요거는 안 봐도 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.135,
                "end": 44.256
            },
            {
                "speaker_id": "1",
                "transcription": "요거랑 똑같애 지금 요 한 거랑 똑같이 돼 있거든요 여기에 흑당하고 에스프레소가 있을 텐데 요거 들어갈 때는 2가지가 경우가 있어요 상대가 뱀파가 클로티드를 때리면은 일찍 죽기 때문에 안전한 거는 요렇게 세팅이 나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.266,
                "end": 59.504
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 일단 안전하게 아몬드 끼고 요거 보여드리겠습니다.",
                "sound_type": [
                    2,
