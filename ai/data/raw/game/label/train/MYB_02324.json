        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 간단하게 스토리에서 좀 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.790
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 식으로 되는지 스토리에서 가보도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.800,
                "end": 8.347
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 캡사이신 맛 쿠키의 뭐 딜 능력은 어떻냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.357,
                "end": 13.147
            },
            {
                "speaker_id": "1",
                "transcription": "네 호루라기를 받게 되면은 나쁘지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.157,
                "end": 16.082
            },
            {
                "speaker_id": "1",
                "transcription": "탱커임에도 불구하고 거의 딜러 급의 공격력이 나오거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.079,
                "end": 20.309
            },
            {
                "speaker_id": "1",
                "transcription": "덱의 안정성을 높이는 건 아니기 때문에 딜러 쪽으로 보시면 될 거 같애요 거의",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.319,
                "end": 26.177
            },
            {
                "speaker_id": "1",
                "transcription": "자 요런 식으로 스토리에서는 캡사이신 맛 쿠키가 티어가 완전 0티어는 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.187,
                "end": 31.360
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 단순히 진짜 딜러 쪽으로 생각하시면 되기 때문에 안정성은 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.357,
                "end": 37.600
            }
        ]
    },
    "summary": "화자는 캡사이신 맛 쿠키의 능력에 대해서 보여주면서 탱커지만 딜러 쪽으로 생각하면 된다고 이야기한다.",
