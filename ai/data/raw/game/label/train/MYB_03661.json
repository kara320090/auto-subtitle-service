        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 아이고 일단 16조각 부족하네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.600
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게까지 하고 등불까지 뽑겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.610,
                "end": 5.290
            },
            {
                "speaker_id": "1",
                "transcription": "네 3200개",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.300,
                "end": 6.800
            },
            {
                "speaker_id": "1",
                "transcription": "날파리 한번 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.810,
                "end": 8.149
            },
            {
                "speaker_id": "1",
                "transcription": "야 소르베 뽑기 여러분들 이제 시간 얼마 안 남았거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.159,
                "end": 10.856
            },
            {
                "speaker_id": "1",
                "transcription": "8일 밖에 안 남았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.866,
                "end": 15.187
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이거 진짜 눈물 나는 경우가 보통 무과금러분들 소과금러분들 그런 경우 많이 나오는데 나머지 등불 다 켜지고 하나만 남은 경우가 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.197,
                "end": 23.588
            },
            {
                "speaker_id": "1",
                "transcription": "제 지금 부계정이 그래요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.598,
                "end": 25.002
            },
            {
                "speaker_id": "1",
                "transcription": "지금 하나 남았는데 8일 남았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.012,
                "end": 26.981
            },
            {
                "speaker_id": "1",
                "transcription": "과연 그게 될 것인가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.991,
                "end": 30.764
            }
        ]
    },
    "summary": "화자가 이제 등불을 뽑는데 소르베 뽑기는 8일 남았다면서 눈물 나는 경우가 무과금러분들 소과금러분들이 등불이 하나만 남은 경우 8일 동안 가능할 지 본인의 부계정도 지금 그 상황이라고 한다.",
