    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 무슨 일입니까.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.577
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 여기서 중요한 거는 실론나이트 생존만 신경 써주면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.587,
                "end": 6.297
            },
            {
                "speaker_id": "1",
                "transcription": "세팅이 뭐 난이도가 어려운 게 아니에요.",
                "sound_type": [
                    2
                ],
                "start": 6.307,
                "end": 8.577
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 여러분들 그대로 쓰시고요.",
                "sound_type": [
                    2
                ],
                "start": 8.587,
                "end": 10.413
            },
            {
                "speaker_id": "1",
                "transcription": "실론나이트는 피해 감소 치명타 피해 감소 요것만 신경 써주시면 요런 결과가 나올 수 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.423,
                "end": 16.917
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이 일 이 덱에도 한 번 가보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.927,
                "end": 19.619
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 일 이 덱에는 가운데 소르베가 있어 가줘서 버티고 버텨서 일단 30초 지나서 이제 크레이지 모드 발동되는 그 시점에 결국 이것도 마찬가지예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.629,
                "end": 30.067
            },
            {
                "speaker_id": "1",
                "transcription": "실론나이트가 죽지만 않으면은 이제 이기는 그림은 똑같이 가는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.077,
                "end": 34.983
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 분명히 이 영상 보면서 이 질문이 나올 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.993,
                "end": 38.178
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 @이름1님 실론나이트를 키워야 되나요 실론나이트가 맨 우선순위로 키워야 되는 거는 아니고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.188,
                "end": 44.969
            },
            {
                "speaker_id": "1",
                "transcription": "일단 실론나이트 같은 경우에는 메인 덱들이 다 키워져 있는 분들한테 여유가 있는 분들은 마탕 십강 이상 키워서 쓰시면 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.979,
                "end": 53.811
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 마탕은 한 삼십강 돼야 성능이 확실하게 좋고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.821,
                "end": 58.407
            },
            {
                "speaker_id": "1",
                "transcription": "십강 이상도 쓸 수는 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.417,
                "end": 60.401
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 시작됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 60.411,
                "end": 62.743
            },
            {
                "speaker_id": "1",
                "transcription": "자 찍어주고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.753,
                "end": 65.585
            },
            {
                "speaker_id": "1",
                "transcription": "자 싹 싹 싹",
                "sound_type": [
                    2
                ],
                "start": 65.595,
                "end": 67.800
            }
        ]
    },
    "summary": "중요한 거는 실론나이트 생존만 신경 써주면 세팅과 난이도는 어렵지 않고 실론나이트의 피해 감소 치명타 감소만 신경 써주면 이런 결과가 나올 수 있고 이 일 이 덱도 실론나이트가 죽지 않으면 이기는 건 똑같고 이 영상 보면 질문이 나올 건데 실론나이트는 메인 덱들이 다 키워져 있는 분들이나 여유가 있는 분들은 마탕 십강 이상 키워서 쓰면 되는데 마탕은 삼십강은 돼야 성능이 확실하게 좋다.",
