        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아포가토랑 에클레어가 있는 공속덱이랑 자 일단 이거 좀 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.280
            },
            {
                "speaker_id": "1",
                "transcription": "좀 제가 상대하던 덱이랑은 좀 다른데 아마 이길거 같습니다 요거는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.280,
                "end": 16.436
            },
            {
                "speaker_id": "1",
                "transcription": "1번덱 같은 경우에 왜 세팅을 했냐 상대의 낫 공속덱이 은근 방덱이 상대 쪽에 많이 있고 그냥 공속 시계도 많고 여러분들이 망토 보물만 본다면 1번덱으로 쓰면 승률이 높게 나올 가능성이 큽니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.436,
                "end": 33.228
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 허브맛 쿠키가 저도 이제 안 쓰일 거라 생각했지만 여전히 크림 유니콘이랑 같이 써서 상대가 흑당이거나 에클레어가 있으면 또 유용하게 쓰니까 허브도 나락 간 건 아니다 문제는 이제 이런 덱이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.228,
                "end": 47.384
            },
            {
                "speaker_id": "1",
                "transcription": "이게 저는 이미 알고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.384,
                "end": 49.076
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 클로티드가 들어가 있을 거거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.086,
                "end": 51.535
            },
            {
                "speaker_id": "1",
                "transcription": "2번으로 이걸 가면은 이기는 경우도 있지만 승률이 낮기 때문에 1번덱으로도 공속덱이 아니어서 들어가면 안 되고 그냥 미러전으로 갑니다 요런 경우에는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.545,
                "end": 61.800
            }
        ]
    },
    "summary": "화자가 1번덱으로도 공속덱이 아니어서 들어가면 안된다고 설명하고 있다.",
