    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "1분 전에 빨리 승부보자 극딜적으로 빠르게 승부보자는 전략으로 가야지만 그나마 활용가치가 더 좋을 거 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.597
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 잼스톤 자체가 제가 30강이 아닌 상태에서 19강이거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.607,
                "end": 12.605
            },
            {
                "speaker_id": "1",
                "transcription": "20강 됐을 때 능력이 더 붙고 그리고 30강 되면 더 강력해질 거 같아서 제가 볼 때는 아직 바다요정이 쓰레기라는 이미지가 이제 안 붙여졌으면 좋겠어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.615,
                "end": 22.607
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 높아지면은 조금 더 활용가치가 높아질 수도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.617,
                "end": 25.782
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 극딜적으로 쓸 수 있다는 점이 좀 중요하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.792,
                "end": 29.530
            },
            {
                "speaker_id": "1",
                "transcription": "물론 여러분들이 그럼 블랙펄은 키우지말까요? 하시는 분들도 있을 텐데 블랙펄이 사실상 더 좋긴합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.540,
                "end": 37.166
            },
            {
                "speaker_id": "1",
                "transcription": "정석덱 뿐만 아니라 지금 이 조합에서 바다요정 자리에 블랙펄을 넣으면은 그것도 더 좋게 쓸 수도 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.176,
                "end": 44.026
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 또 달빛술사 자리에 블랙펄을 넣어도 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.036,
                "end": 48.167
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 바다요정을 쓸 수 있는 조합을 여러분들한테 지금 안내해드리는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.177,
                "end": 53.844
            },
            {
                "speaker_id": "1",
                "transcription": "하도 달빛술사에 대한 이미지가 별로 안 좋기 때문에 활용가치가 없다는 이미지 보다는 이번 영상에서 제가 말씀드리고 싶은 거는 제가 이것저것 진짜 모든 조합을 연구를 나름 많이 해봤어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.854,
                "end": 67.001
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정에 대한 최종 결론은 뭐냐 리뷰 영상에서 말씀드렸듯이 딜 자체는 최강입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.011,
                "end": 72.954
            },
            {
                "speaker_id": "1",
                "transcription": "딜은 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.964,
                "end": 73.775
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 몸이 너무 약하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.785,
                "end": 75.291
            },
            {
                "speaker_id": "1",
                "transcription": "그 단점 대문에 얘가 아레나에서 애매한 포지션인 거 같았는데 초반에 한방덱처럼 극딜적으로 사용하면은",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.301,
                "end": 83.300
            }
        ]
    },
    "summary": "20강 됐을 때 능력이 더 붙고 그리고 30강 되면 더 강력해질 거 같아서 내가 볼 때는 바다요정은 딜은 좋지만 몸이 너무 약해서 애매한 포지션으로 된 거 같지만 초반에 한방덱처럼 사용하면 좋다.",
