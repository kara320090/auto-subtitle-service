            },
            {
                "speaker_id": "1",
                "transcription": "그 당시는 안 울 수가 없었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.972,
                "end": 3.444
            },
            {
                "speaker_id": "1",
                "transcription": "아 그러니까요. 진짜 이게 진짜 게임이지 이게 게임이지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.454,
                "end": 8.826
            },
            {
                "speaker_id": "1",
                "transcription": "아 이게 다른 게 요즘에 좀 게임계에 좀 서운했던 걸 잠깐 얘기를 하면 미친놈들이 돈을 진짜 비싸게 팔아 놓고서 자꾸 오픈베타를 시키는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.836,
                "end": 18.467
            },
            {
                "speaker_id": "1",
                "transcription": "최적화도 안 하고 그럼 무슨 내가 돈 내고 오픈베타를 가봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.477,
                "end": 21.689
            },
            {
                "speaker_id": "2",
                "transcription": "우는 거 올리면 나름 그러려니 싶을 거 같은",
