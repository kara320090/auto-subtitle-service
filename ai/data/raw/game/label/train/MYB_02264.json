        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 맨 처음에 네 달빛이랑 퀸아망 이렇게 죽이고 요런 식으로 마무리하는 그림이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.419
            },
            {
                "speaker_id": "1",
                "transcription": "자 딜량 보면은 네 스타더스트 마무리까지 해서 가장 높게 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.429,
                "end": 13.711
            },
            {
                "speaker_id": "1",
                "transcription": "자 이분들도 들어가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.721,
                "end": 15.530
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱의 형태를 취하고 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.540,
                "end": 17.165
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이거 쓸 때 뭐 100퍼센트 무조건 다 이깁니다는 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.175,
                "end": 22.915
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 상대가 치명타 안 터져 가지고 지는 경우도 있기는 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.925,
                "end": 26.980
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이런 식으로 상대방이 삭 녹아버리면서 쉽게 이기는 경우가 더 많이 나와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.990,
                "end": 34.184
            },
            {
                "speaker_id": "1",
                "transcription": "어 공속덱, 방덱으로 되어있는 분들 정말 이기기 힘들거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.194,
                "end": 38.365
            },
            {
                "speaker_id": "1",
                "transcription": "스펙차가 많이 나거나 아니면은 뭐 다른 덱으로 이제 파훼법을 모르겠다 하시는 분들은 요런 식 공속덱 파훼법으로 해 보시면 될 것 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.375,
                "end": 50.166
            }
        ]
    },
    "summary": "공속덱, 방덱으로 되어있는 분들은 이기기 어렵고 공속덱을 파훼법으로 사용하시면 좋을 것 같다.",
