        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쇼 타임 가자 쇼 타임 쇼 타임 쇼 타임 쇼 타임 야 이것도 이기네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.209
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 좋죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.219,
                "end": 13.950
            },
            {
                "speaker_id": "1",
                "transcription": "미러전 외에 지금 모든 덱을 다 이겼어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.960,
                "end": 17.350
            },
            {
                "speaker_id": "1",
                "transcription": "자 결론을 내겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.360,
                "end": 21.829
            },
            {
                "speaker_id": "1",
                "transcription": "지금 영상에서 의도하는 거는 여러분들 영 티어 솔방울입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.839,
                "end": 26.793
            },
            {
                "speaker_id": "1",
                "transcription": "모두 다 키우세요 이 영상의 취지는 그게 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.803,
                "end": 29.624
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 특정 덱에서 정말 영 티어 급으로 쓸 수 있지만 여유가 있는 분들 그런 분들한테 추천 드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.634,
                "end": 37.089
            },
            {
                "speaker_id": "1",
                "transcription": "딜도 좋고 텡도 되고 에 소량이지만 힐도 주고 고런 기능을 아주 좋게 활용할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.099,
                "end": 44.776
            },
            {
                "speaker_id": "1",
                "transcription": "정말 엄청나게 좋네요.",
