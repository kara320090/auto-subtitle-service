        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "떨어지지는 않아 보여요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.412
            },
            {
                "speaker_id": "1",
                "transcription": "랭커분들도 아직도 잘 쓰고 있고 기존의 정석덱으로도 잘 쓰고 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.422,
                "end": 7.370
            },
            {
                "speaker_id": "1",
                "transcription": "무난하게 이기는 그림이 보인다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.380,
                "end": 9.421
            },
            {
                "speaker_id": "1",
                "transcription": "자 아몬드 말고 락스타 쿨로 하는 것도 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.431,
                "end": 14.997
            },
            {
                "speaker_id": "1",
                "transcription": "네 여러분들이 이거 게임하실 때 상대방보다 쿨이 높으면 승률이 높아진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.007,
                "end": 21.219
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방 달빛술사, 스타더스트 조합 자 이번에는 아몬드가 아니라 쿨로 들어가는 거 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.229,
                "end": 27.856
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿨로 들어갔을 때도 락스타가 죽지 않고 버티기만 하면은 오히려 쿨도 빨리 채워주면서 스타더스트 생존을 더 시켜줄 수 있기 때문에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.866,
                "end": 41.966
            }
        ]
    },
    "summary": "화자는 쿨로 하는 것도 보여주면서 쿨이 높으면 승률이 높아지고 락스타가 버티면 쿨도 빨리 채워주면서 스타더스트 생존을 더 시켜줄 수 있다고 말한다.",
