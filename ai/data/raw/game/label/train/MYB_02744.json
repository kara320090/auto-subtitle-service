        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 야 진짜 이게 진짜 이 엄청난 폭딜 싸움이기 때문에 무서워.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.625
            },
            {
                "speaker_id": "1",
                "transcription": "에 요런 식으로 클리어 제가 느끼는 거는 요 레어 무공비 쓰는 분들 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.635,
                "end": 16.920
            },
            {
                "speaker_id": "1",
                "transcription": "이분들한테 특히 더 좋은 거 같애.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.930,
                "end": 18.855
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱 메인으로 해도 될까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.865,
                "end": 20.192
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이 덱을 메인으로 쓰고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.202,
                "end": 22.049
            },
            {
                "speaker_id": "1",
                "transcription": "1탱이든 2탱이든 다 들어가도 승리는 승률이 좋습니다 저는.",
