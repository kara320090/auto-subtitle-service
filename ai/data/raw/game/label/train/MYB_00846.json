                    2,
                    3
                ],
                "start": 5.937,
                "end": 9.394
            },
            {
                "speaker_id": "1",
                "transcription": "이게 에픽 뽑기도 그렇고 항상 느끼는 거지만 진짜 덜 줘 나는.",
                "sound_type": [
