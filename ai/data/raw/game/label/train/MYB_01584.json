        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 뭐야 아 캡사이신이구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.222
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 다른 애인 줄 알았어 순간 다른 애인 줄 알고 멍때리고 있었네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.232,
                "end": 8.856
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 없는 쿠키를 잘 뽑았고요 야 얘 확률 0.021인 애 나오네 여기서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.866,
                "end": 14.957
            },
            {
                "speaker_id": "1",
                "transcription": "와 나도 약간 다른 그냥 없는 에픽이나 그런 건 줄 알고 그냥 멍때리고 있었네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.967,
                "end": 20.237
            },
            {
                "speaker_id": "1",
                "transcription": "아 내일 진짜 지독한 비가 내리는 장마 오 야 와 이거 돈 벌었다 와 캡사가 2개나 나오네.",
                "sound_type": [
                    2,
