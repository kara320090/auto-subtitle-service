        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭔 느낌인지 알겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.019
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 여러분들이 생각하는 단일딜 해가지고 빨리 끊어주고 이런 게 되려면은 지금 메타에서는 힘들어 퓨바 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.029,
                "end": 7.758
            },
            {
                "speaker_id": "1",
                "transcription": "아 마라 아무튼 마라는 야 이거 답이 없는데 어떡하지 여러분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.768,
                "end": 12.739
            },
            {
                "speaker_id": "1",
                "transcription": "마라맛 쿠키를 쓰려면은 여러분들 캡사이신이랑 같이 쓰면 시너지 좋게 쓸 수는 있는데 홀리베리를 빼자니 뒤에가 녹아나고 홀리베리를 넣자니 3탱 덱이 되어버리고 그렇다고 해서 마라랑 홀리베리만 쓰고 캡사이신 안 쓰자니 뒤에 뭐 호밀이나 다른 거 쓰기에도 애매하고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.749,
                "end": 28.734
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 얘는 제가 볼 때는 지금 현재로써는 활용하기가 정말 애매한 포지션이 된 거 아닌가 물론 좋은 덱이 나오면 제가 따로 리뷰해서 올리겠지만 지금첫날 리뷰한 거로는 여러분들이 마라 마탕을 지금 당장 해야되나요?라고 물어보신다면은 현재로서는 그런 건 아닌 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.744,
                "end": 48.436
            },
            {
                "speaker_id": "1",
                "transcription": "토벌에서는 지금은 현재까지는 쓰이지 않는 걸로 나오고 있고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.446,
                "end": 52.412
            },
            {
                "speaker_id": "1",
                "transcription": "좋은 덱이나 좋은 성능이 나오면은 제가 따로 리뷰를 더 찍도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.422,
                "end": 57.367
            },
            {
                "speaker_id": "1",
                "transcription": "일단 마라 리뷰는 여기서 컷하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.377,
                "end": 76.203
            }
        ]
    },
    "summary": "마라 마탕을 지금 당장 하지 않아도 된다.",
