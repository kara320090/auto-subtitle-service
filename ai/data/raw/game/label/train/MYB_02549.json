        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 스킬 돌아오는 대로 써주시면 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.761
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여러분들 생각할 거는 45초만 기억해 주시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
