        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분들 계정 키우는데 검볼 다이버 선택 공짜 또는 무화과 선택 공짜야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.122
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 여러분들 뭐 선택할 거예요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.270,
                "end": 6.815
            },
            {
                "speaker_id": "1",
                "transcription": "둘 중 하나 공짜로 선택해서 바로 에픽을 무료로 준다고 한다.",
                "sound_type": [
                    2
                ],
                "start": 6.825,
                "end": 10.611
            },
            {
                "speaker_id": "1",
                "transcription": "아 차라리 무화과가 나아.",
