            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 한 바퀴 스킬이 돌고 나면은 맨 앞에 탱커 한 마리만 남는 경우 얘 벨벳 너무 쿨이 길어서 올 아몬드 해도 된다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.294,
                "end": 18.743
            },
            {
                "speaker_id": "1",
                "transcription": "이거 아몬드, 아몬드, 라즈, 라즈, 라즈 해도 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.753,
                "end": 21.786
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어 바닐라면은 퓨어 바닐라 끌어 댕기나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.796,
                "end": 24.574
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어 바닐라라도 앞에 있는 딜러 땡기거든요.",
