                    5
                ],
                "start": 27.749,
                "end": 30.855
            },
            {
                "speaker_id": "1",
                "transcription": "그게 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.865,
                "end": 31.373
            },
            {
                "speaker_id": "1",
                "transcription": "오히려 방탄이든 퓨바든 다 이기고 있어요.",
