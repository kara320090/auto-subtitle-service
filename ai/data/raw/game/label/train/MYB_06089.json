        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기 나는 이 포인트가 되게 중요한 것 같은데 저 뒷배경을 보세요 왼쪽에 보면은 우리가 항상 보던 토벌용이죠.",
                "sound_type": [
                    2,
