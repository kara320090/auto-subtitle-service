        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금이 여러분들 킹덤 쿠키런 킹덤이 업데이트가 있고 업데이트가 이렇게 있잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.710
            },
            {
                "speaker_id": "1",
                "transcription": "그 가운데 시기가 지금인데 이 시기 때 사람들이 제일 많이 빠져.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.720,
                "end": 9.465
            },
            {
                "speaker_id": "1",
                "transcription": "지금부터 업데이트 발표 전까지 이 시간을 여러분들 꽉 잡고 계세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.475,
                "end": 14.028
            },
            {
                "speaker_id": "1",
                "transcription": "놓치면 안 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.038,
                "end": 15.170
            },
            {
                "speaker_id": "1",
                "transcription": "이 시기가 가장 약간 고난의 시기야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.180,
                "end": 17.905
            },
            {
                "speaker_id": "1",
                "transcription": "포기하지마.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.915,
                "end": 21.769
            },
            {
                "speaker_id": "1",
                "transcription": "일단 요거 품고 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
