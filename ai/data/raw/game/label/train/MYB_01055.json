        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 올 치가 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.340
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 확실하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.346,
                "end": 2.393
            },
            {
                "speaker_id": "1",
                "transcription": "이거 똑같이 해봤는데 비교가 딱 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.393,
                "end": 6.009
            },
            {
                "speaker_id": "1",
                "transcription": "어 결론은 올 치가 더 좋은 거는 맞네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.019,
                "end": 11.280
            },
            {
                "speaker_id": "1",
                "transcription": "보호막 완전 싹 다 뺄 수 있는 59 웨이브 전용이 나오면은 기록 단축이 엄청나게 될 거 같네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.290,
                "end": 18.614
            },
            {
                "speaker_id": "1",
                "transcription": "자 정리하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.624,
                "end": 19.750
            },
            {
                "speaker_id": "1",
                "transcription": "일단 여러분들 분명히 이대로 따라 할 수 있는 사람이 많이 없을 수도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.760,
                "end": 24.593
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 요 세팅 불가능할 때 대체 되는 걸 말씀드리면은 도넛이 나는 불가능하다 하시는 분들은 뭐 억지로 깨고 싶다하시는 분들은 좀 기록이 늦더라도 뭐 홀리베리나 다른 탱커 위주로 해주시면 되고요 딴딴하게.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.603,
                "end": 38.778
            },
            {
                "speaker_id": "1",
                "transcription": "도넛이 사용 가능한데 죽는다 하시는 분들은 아몬드 껴서 해주시면 되고 오징어 먹물은 무조건 해주셔야 되고 맛탕은 최소 1강 이상 오먹이 죽으면 피감을 넣어주시고 망고는 10강 이상부터는 쓸 수는 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.788,
                "end": 52.953
            },
            {
                "speaker_id": "1",
                "transcription": "권장은 20강 이상 좀 쓰기 애매하다 싶으시면 이 자리에 달빛술사나 광역 딜러 타르트 못 써요 하시는 분들은 타르트 빼면은 이 공석 보물 대신에 낫 보물 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.960,
                "end": 64.867
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이 자리에 용과 드래곤 또는 다른 광역 딜러를 하나 더 넣어서 쓰시면 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.877,
                "end": 71.639
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림은 대체가 원래 안 되지만 굳이 대체를 쓰자면은 퓨어바닐라처럼 힐량이 한번에 많이 되는 쿠키를 넣어주시면 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.649,
                "end": 81.624
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 수호 성전 이번 시즌은 확실하게 기록 단축이 올 치명으로 했을 때가 10초 이상 단축이 됐습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.634,
                "end": 89.812
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 수호 성전 신규 시즌 리뷰는 마무리하시도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.822,
                "end": 108.000
            }
        ]
    },
    "summary": "수호의 성전에서 도넛이 불가능하다면 홀리베리나 다른 탱커 위주로, 도넛이 가능하지만 죽는 사람은 아몬드를 껴서, 오징어 먹물은 무조건 하고 아니면 피감이나 20강 이상의 망고를 사용하며 그게 어려우면 달빛술사나 광역 딜러를 쓰고 타르트를 뺄 경우 보물을 낫 보물로 바꾸고 용과 드래곤 혹은 다른 광역 딜러를 넣고 슈크림은 퓨어바닐라 같은 캐릭터를 넣어 올 치명으로 참여하면 된다.",
