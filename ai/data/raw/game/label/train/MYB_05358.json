        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 27만 갠데 3만 개 빼고 24만 6000개에 뽑기 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.160
            },
            {
                "speaker_id": "1",
                "transcription": "스펙을 보게 되면은 스펙도 좋으셔.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.170,
                "end": 8.029
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘 5초월 일단 찍고 고급으로 가야 되겠네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.027,
                "end": 11.821
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 우유맛 쿠키 5초월을 원한다고 하셨는데 현재 우유맛 쿠키가 초월이 없는 상태인데 5초월까진 쪼끔 힘들 거 같지만 한 번 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.831,
                "end": 20.782
            },
            {
                "speaker_id": "1",
                "transcription": "길드 뽑기부터 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.792,
                "end": 22.266
            },
            {
                "speaker_id": "1",
                "transcription": "어구야 16만 개 자 이것도 가볍게 다 뽑아보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.276,
                "end": 26.765
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 자 슈크림 신규 보물 같은 경우에는 지금 뭐 딱히 쓰이는 데는 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.775,
                "end": 32.390
            },
            {
                "speaker_id": "1",
                "transcription": "저거가 굳이 뭐 쓰이는 것 보다는 이제 낫 보물을 다 쓰고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.400,
                "end": 37.174
            },
            {
                "speaker_id": "1",
                "transcription": "길드 보물이랑 낫이랑 쫌 비교를 해봐야 되겠지만 현재로서는 낫이 더 많이 쓰이고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.184,
                "end": 43.084
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 보시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.094,
                "end": 44.248
            },
            {
                "speaker_id": "1",
                "transcription": "언젠가는 쓰일 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.258,
                "end": 45.892
            },
            {
                "speaker_id": "1",
                "transcription": "지금 당장는 아니지만 오 좋아요 슈크림 2개",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.902,
                "end": 48.587
            },
            {
                "speaker_id": "1",
                "transcription": "언젠가는 쓰일 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.597,
                "end": 50.350
            },
            {
                "speaker_id": "1",
                "transcription": "오 슈크림 잘 나와.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.360,
                "end": 51.794
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 마무리",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.804,
                "end": 54.185
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피시에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.195,
                "end": 58.308
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.318,
                "end": 61.642
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
