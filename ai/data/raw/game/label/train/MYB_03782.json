        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어우 앞에 탱커들이 다 날라갔죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.733
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 클리어 확실히 초월이 높을수록 딜량 자체가 많이 차이납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.733,
                "end": 12.726
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 정석 덱한테도 이 덱은 조금 약한 모습인데 아레나 덱이 아마 시청자분들 중에 그냥 무난하게 승률 가장 좋은 덱 하나 추천해 주세요라고 생각하는 분도 있을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.733,
                "end": 27.644
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 채팅에서도 물어보는 분도 있는데 그런 덱은 현재 존재하지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.654,
                "end": 32.895
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 상성상 다양하게 되어 있기 때문에 여러분들이 세팅 하나 가지고는 아레나 등반하기는 뭐 엄청나게 뭐 꿀 빠는 조합 이런 거는 딱히 지금 없는 것 같고 한 2개 조합 정도는 가지고 올라가시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.905,
                "end": 49.390
            },
            {
                "speaker_id": "1",
                "transcription": "자 전체 2등분 자 요 덱 방금 아까 전에 리뷰했던 덱이죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.400,
                "end": 56.387
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱이랑 3탱 덱이랑 붙었을 때 어떻게 되는지 제 예상에는 상대가 딜러들 안 죽으면은 제가 무조건 필패할 거 같은데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.397,
                "end": 67.583
            }
        ]
    },
    "summary": "세팅 하나 가지고 아레나 등반하는 꿀 빠는 조합은 없는 것 같고 2개 조합 정도 가지고 올라가면 될 것 같다고 한다.",
