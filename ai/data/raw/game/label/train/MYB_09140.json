                "start": 13.224,
                "end": 13.902
            },
            {
                "speaker_id": "1",
                "transcription": "얘 얘랑 싸운 거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.912,
                "end": 16.255
            },
            {
                "speaker_id": "1",
                "transcription": "아 어머 어머 어머",
