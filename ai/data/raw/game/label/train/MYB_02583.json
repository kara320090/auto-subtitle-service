        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.771
            },
            {
                "speaker_id": "1",
                "transcription": "방치형 모바일 게임을 편하게 모니터링 가능하며 핸드폰 발열이나 배터리 부족으로 인한 불편함도 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.781,
                "end": 8.125
            },
            {
                "speaker_id": "1",
                "transcription": "PC에서 큰 화면에 초고화질로 몰입할 수 있는 녹스앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.135,
                "end": 12.363
            },
            {
                "speaker_id": "1",
                "transcription": "자 드래곤 53단계에서 빌드 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.373,
                "end": 17.540
            },
            {
                "speaker_id": "1",
                "transcription": "제일 먼저 에클레어 예약로서 해주시고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.550,
                "end": 19.554
            },
            {
                "speaker_id": "1",
                "transcription": "보스로서 출현 되면은 그 이후에 퓨바 바로 눌러줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.564,
                "end": 23.064
            },
            {
                "speaker_id": "1",
                "transcription": "자 에클레어 스킬 나가자마자 퓨바",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.074,
                "end": 25.375
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 밀키웨이 예약을 해주시고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.385,
                "end": 27.383
            },
            {
                "speaker_id": "1",
                "transcription": "밀키웨이 나가자마자 도넛",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.393,
                "end": 29.120
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 도넛 누르자마자 주스",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.130,
                "end": 30.997
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 해주시고 오른쪽에 도넛하고 밀키웨이는 자동으로 나가게끔 가만히 냅두고 도넛 나가면 퓨바",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.007,
                "end": 39.439
            },
            {
                "speaker_id": "1",
                "transcription": "자 주스 에클레어",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.449,
                "end": 42.245
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 눌러주면서 돌아가는 거 보여주고 그 다음에 퓨바 스킬 쓰고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.255,
                "end": 49.532
            },
            {
                "speaker_id": "1",
                "transcription": "주스 바로바로 자 여기서 에클레어 빨리 누르면은 밀키웨이 도넛 순서대로 스킬 나갈 수도 있으니까 전 여기는 그냥 가만히 자동으로 내버려두는 게 나은 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.542,
                "end": 61.047
            },
            {
                "speaker_id": "1",
                "transcription": "그래야 도넛 밀키웨이 이렇게 순서로 씁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.057,
                "end": 63.854
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 도넛 밀키웨이 자 그리고 다음에 퓨바 눌러주고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 63.864,
                "end": 68.622
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 주스는 저는 바로바로 빨리빨리 눌러주시고 네 그리고 에클",
                "sound_type": [
                    2,
                    5
                ],
                "start": 68.632,
                "end": 75.192
            },
            {
                "speaker_id": "1",
                "transcription": "퓨바 바로바로 눌러주세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 75.202,
                "end": 79.819
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 눌러주고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 79.829,
                "end": 83.366
            }
        ]
    },
    "summary": "에클레어를 빨리 누르면 밀키웨이 도넛 순서대로 스킬 나갈 수도 있으니 여기는 그냥 가만히 자동으로 내버려두는 게 낫다.",
