        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 @이름1님 뽑기 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.709
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이분은 스펙을 보면은 이 장면만 보면은 정말 중요한 쿠키들이 안 보이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.719,
                "end": 7.628
            },
            {
                "speaker_id": "1",
                "transcription": "어우 많이 있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.638,
                "end": 9.027
            },
            {
                "speaker_id": "1",
                "transcription": "이 진짜 뽑아야 될 핵심 쿠키들 얘는 진짜 무엇보다 홀리베리는 조각으로라도 진짜 뽑아야 되는 네 그런 상황 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.037,
                "end": 17.537
            },
            {
                "speaker_id": "1",
                "transcription": "일단 뽑기의 목표는 얘는 삼성까지만 찍고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.547,
                "end": 21.263
            },
            {
                "speaker_id": "1",
                "transcription": "예 락스타 올인 가면 될 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.273,
                "end": 23.454
            },
            {
                "speaker_id": "1",
                "transcription": "도넛이나 얘네들도 다 필요한데 얘는 마일리지로 뽑으면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.464,
                "end": 27.558
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트랑 홀리베리 용과를 노려봅시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.568,
                "end": 31.708
            },
            {
                "speaker_id": "1",
                "transcription": "보물 뽑기는 하지 맙시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.718,
                "end": 33.038
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 이제 신규 보물이 나올 차례가 됐어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.048,
                "end": 36.790
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트 발표 나고 좀 그때 뽑아도 늦지 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.800,
                "end": 40.667
            },
            {
                "speaker_id": "1",
                "transcription": "무지개 큐브도 지금 절대 쓰지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.677,
                "end": 42.472
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 지금 쟤네들 뽑아봤자 스킨 인연에 쟤네가 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.482,
                "end": 47.903
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 아 레전드 스킨 이벤트 때는 스킨 뽑기 횟수를 채우면 레전드 스킨 뽑기권을 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.913,
                "end": 55.795
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 이벤트 때 뽑아야지 이득이라 지금 무지개 큐브 다 소모시키면 완전 손해다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.805,
                "end": 62.145
            },
            {
                "speaker_id": "1",
                "transcription": "야 커터도 많이 모으셨네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.155,
                "end": 64.109
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리는 진짜 대체자가 너무 안 나옴 사실상 홀리베리 대체는 와일드베리를 마법사탕 해가지고 견디는 수밖에 없죠 뭐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.119,
                "end": 73.442
            },
            {
                "speaker_id": "1",
                "transcription": "현재로서는 홀리베리가 너무 압도적으로 좋기 때문에 자 일단 고급 먼저 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.452,
                "end": 79.173
            },
            {
                "speaker_id": "1",
                "transcription": "210개",
                "sound_type": [
                    2,
                    5
                ],
                "start": 79.183,
                "end": 82.033
            }
        ]
    },
    "summary": "이분은 정말 중요한 쿠키들이 안 보이고 홀리베리는 조각으로라도 뽑아야 하는 상황이며 락스타 올인 가고 도넛이나 얘네들도 필요한데 마일리지로 뽑으면 되고 스타더스트랑 홀리베리 용과를 노려보는데 보물 뽑기는 신규 보물 나올 차례가 돼서 업데이트 발표 나고 뽑아도 늦지 않고 무지개 큐브도 절대 쓰지 말아야 하는데 뽑아봤자 스킨 인연에 쟤네가 없고 레전드 스킨 이벤트 때 스킨 뽑기 횟수 채우면 뽑기권을 줘서 이벤트 때 뽑아야 이득이고 커터는 많이 모으셨는데 홀리베리 대체는 와일드베리를 마법사탕 해서 견디는 수밖에 없으며 일단 고급 먼저 가겠다.",
