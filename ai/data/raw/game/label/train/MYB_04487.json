        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이거 스킵 안 눌러서 안 나오는 느낌이야 .",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.430
            },
            {
                "speaker_id": "1",
                "transcription": "스킵 누르면 되게 잘 나왔거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.440,
                "end": 6.257
            },
            {
                "speaker_id": "1",
                "transcription": "아 왜 이렇게 얘는 진짜 볼 때 마다 진짜 너무 안타까운 쿠키야 여태까지 제가 본 쿠키 중에 그냥 제일 불쌍해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.267,
                "end": 14.524
            },
            {
                "speaker_id": "1",
                "transcription": "너무 불쌍하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.534,
                "end": 17.427
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 해서 뽑기 마무리 짓도록 하겠습니다 뽑기 잘 됐죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.437,
                "end": 21.837
            },
            {
                "speaker_id": "1",
                "transcription": "다크 카카오, 서리의 여왕, 블랙펄, 오이스터까지 15만 크리스탈 뽑기로는 상당히 잘 나온 거다 그렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.837,
                "end": 31.302
            },
            {
                "speaker_id": "1",
                "transcription": "찰스도 어느 정도 잘 나온 상태 이렇게 마무리 짓도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.302,
                "end": 35.436
            },
            {
                "speaker_id": "1",
                "transcription": "이거 왜 레벨업 안 하고 계세요 이거 시간 엄청 많이 걸릴 텐데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.446,
                "end": 39.623
            },
            {
                "speaker_id": "1",
                "transcription": "아니 잠깐만 고기젤리 너무 아까운데 고기젤리 이거 쓰세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.633,
                "end": 43.236
            },
            {
                "speaker_id": "1",
                "transcription": "토핑만 살짝 볼까 라즈베리 되게 좋아하시네 라즈베리가 상당히 많고 쿨 토핑이 너무 없거든요 콜 토핑작 많이 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.246,
                "end": 51.011
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤은 제 개인적인 생각입니다 아몬드가 더 중요해요 아몬드랑 쿨이 진짜 비중이 되게 중요하고 라즈도 물론 중요하지만 일단 쿨이랑 아몬드가 상당히 더 중요하다고 생각합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.021,
                "end": 63.461
            },
            {
                "speaker_id": "1",
                "transcription": "파밍 강화 순서를 쿨을 5대 5로 잡고 그다음에 아몬드를 3 그다음에 라즈는 2 중요도를 5대 3대 2로 해가지고 강화하시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.471,
                "end": 75.188
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이렇게 수누피아미님 쿠키는 마무리",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.198,
