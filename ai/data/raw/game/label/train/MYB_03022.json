        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 출시된 블루파이맛 쿠키 리뷰 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.511
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 5성 5초 각각 나눠서 진행할 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.521,
                "end": 7.419
            },
            {
                "speaker_id": "1",
                "transcription": "자 스킬 내용을 한번 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.429,
                "end": 9.768
            },
            {
                "speaker_id": "1",
                "transcription": "마도서의 탐욕 디버프를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.778,
                "end": 12.880
            },
            {
                "speaker_id": "1",
                "transcription": "자 블루파이맛을 쿠키에게는 체력 회복과 피해 감소 버프를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.890,
                "end": 16.763
            },
            {
                "speaker_id": "1",
                "transcription": "악령이 쿠키에게 피해를 입히거나 해당 디버프가 부여된 적이 행동 불가라는 것은 기절, 수면 이런 걸 말하는 거죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.773,
                "end": 24.443
            },
            {
                "speaker_id": "1",
                "transcription": "행동 불가 상태 이상에 빠질 경우 탐욕을 충전한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.453,
                "end": 28.191
            },
            {
                "speaker_id": "1",
                "transcription": "모든 탐욕이 충전된 마도서는 강력한 힘을 해방하여 잠시동안 블루파이맛 쿠키의 공격력을 증가 시키고 적에게 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.201,
                "end": 36.742
            },
            {
                "speaker_id": "1",
                "transcription": "자 뭐 중요한 거는 최대 체력 비례 피해 상한선이 무려 30만, 마도서 피해량은 공격력의 253.6퍼센트, 체력 회복량은 공격력의 115.0퍼센트, 피해 감소는 12초 동안 25퍼센트, 마도서의 탐욕 적이 행동 불가 상태 이상에 걸릴 경우 탐욕 1개 충전, 15초 동안 해로운 효과 10퍼센트 증가, 최대 중첩 1개 해제 불가능 그러면은 허브맛 쿠키 같은 거 써도 뭐 불가능하다 이거죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.752,
                "end": 65.466
            },
            {
                "speaker_id": "1",
                "transcription": "탐욕 7개 중첩 시 힘의 해방 사용, 힘의 해방 피해량 쿠키는 1.5초 동안 최대 6회 피해를 주고 1회 피해량은 164.4퍼센트에다가 체력 비례 고정 피해가 0.95퍼센트 자 그 외에는 뭐 딱히 의미가 없을 것 같아서 요것만 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.476,
                "end": 81.700
            },
            {
                "speaker_id": "1",
                "transcription": "자 피감 29.8에다가 쿨 9퍼센트까지 자 평타 일단 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.710,
                "end": 88.777
            },
            {
                "speaker_id": "1",
                "transcription": "평타는 15만",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.787,
                "end": 92.966
            }
        ]
    },
