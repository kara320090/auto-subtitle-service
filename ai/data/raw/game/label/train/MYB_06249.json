        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 오이스터 공속덱 이거 되게 좋은 덱인데 여기에다가 넣어서 써볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.269
            },
            {
                "speaker_id": "1",
                "transcription": "야 와베 대신에 너가 한번 날뛰어볼래?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.279,
                "end": 8.129
            },
            {
                "speaker_id": "1",
                "transcription": "아 나머지는 뺄 게 없는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.139,
                "end": 10.046
            },
            {
                "speaker_id": "1",
                "transcription": "야 오이스터 빼면 안 되고 흑당은 야 공속덱에 대표인데 얘가 흑당을 뺄 수가 없는데 이거 우짜지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.056,
                "end": 18.096
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 와베 빼고 한번 가봅시다 한번 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.106,
                "end": 20.843
            },
            {
                "speaker_id": "1",
                "transcription": "그나마 와베야 그러면 공속을 얘랑 흑당을 받습니다 이 두 개가.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.853,
                "end": 26.282
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 공속이 낮아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.292,
                "end": 27.858
            },
            {
                "speaker_id": "1",
                "transcription": "자 어떤 그림일지.",
                "sound_type": [
                    2,
