        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 해서 이번에 업데이트 솔직히 뭐 예전에 나왔던 콘텐츠가 과연 옛날의 단점을 좀 보완해서 잘 나올지가 관건이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.968
            },
            {
                "speaker_id": "1",
                "transcription": "네 신규 쿠키도 제 개인적은 바람은 토벌에 안 쓰였으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.978,
                "end": 15.245
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 스트레스를 좀 덜었으면 좋겠다. 아레나에 재밌게 쓰일 수 있을 정도로만 나왔으면 좋겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.255,
                "end": 21.572
            },
            {
                "speaker_id": "1",
                "transcription": "파르페도 마찬가지 아레나에 재밌게 쓰였으면 좋겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.582,
                "end": 24.634
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트는 7월 21일 금요일이고요. 업데이트 아마도 저녁때 또 점검할 거 같거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.644,
                "end": 32.659
            },
            {
                "speaker_id": "1",
                "transcription": "그때 또 리뷰 하도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.669,
                "end": 35.022
            },
            {
                "speaker_id": "1",
                "transcription": "네 좋아요 구독 한 번씩만 부탁드릴게요. 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.032,
                "end": 53.800
            }
        ]
    },
    "summary": "7월 21일 금요일 업데이트인데 신규 쿠키가 토벌에 안 쓰였으면 좋겠고 파르페도 마찬가지 아레나에 재밌게 쓰였으면 좋겠다.",
