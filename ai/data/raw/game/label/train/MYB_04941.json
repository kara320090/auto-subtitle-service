        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 검볼다이버맛 쿠키가 드디어 능력이 공개됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.969
            },
            {
                "speaker_id": "1",
                "transcription": "자 영상 같이 보고 업데이트 공지까지 같이 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.979,
                "end": 11.222
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.232,
                "end": 14.409
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.419,
                "end": 17.676
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.686,
                "end": 29.636
            },
            {
                "speaker_id": "1",
                "transcription": "자 실제로 검볼다이버맛 쿠키 대사가 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.646,
                "end": 33.807
            },
            {
                "speaker_id": "1",
                "transcription": "저렇게 자막으로 나온 게 끝이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.817,
                "end": 42.377
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄 제도에서 많이 보던 그 상자죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.387,
                "end": 53.486
            },
            {
                "speaker_id": "1",
                "transcription": "자 검볼다이버와 함께",
                "sound_type": [
