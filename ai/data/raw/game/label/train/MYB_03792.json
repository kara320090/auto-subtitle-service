        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.073
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.073,
                "end": 6.373
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.373,
                "end": 11.002
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 해서 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.012,
                "end": 13.173
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 아까 제가 아레나에서 봤을 때는 거의 지지 않았어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.166,
                "end": 17.526
            },
            {
                "speaker_id": "1",
                "transcription": "아르나에서는 100전 100승 했고 거의 승률 100퍼센트로 다 이겼었거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.526,
                "end": 23.080
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 덱을 그 보시면 아시겠지만 상대가 다 터지고 난리가 납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.080,
                "end": 28.045
            },
            {
                "speaker_id": "1",
                "transcription": "어느 정도 피감이 받쳐주지 않으면 그냥 다 터져요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.055,
                "end": 32.173
            },
            {
                "speaker_id": "1",
                "transcription": "어 이 덱이 일단 미리 말씀드리면 약점이 클로티드 정석 덱 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.173,
                "end": 37.486
            },
            {
                "speaker_id": "1",
                "transcription": "그 덱한테가 약한데 피감이 높은 완전 높은 최상위 랭커 아니면은 거의 다 터진다고 보시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.496,
                "end": 44.168
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방도 공속 덱이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.178,
                "end": 46.633
            },
            {
                "speaker_id": "1",
                "transcription": "자 솔방울 맛 쿠키가 아레나에서 지금 많이 보고 보이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.647,
                "end": 50.333
            },
            {
                "speaker_id": "1",
                "transcription": "어 원래는 솔방울 맛 쿠키가 초창 출시됐을 때는 많이 안 쓰였지만 자 이렇게 100등 안의 분이 여러분들 시작한 지 15초 만에 그냥 녹아나는 그림을 볼 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.326,
                "end": 61.533
            },
            {
                "speaker_id": "1",
                "transcription": "이분도 뭐 피감을 지금 토핑 장착 안 한 게 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.533,
                "end": 65.133
            },
            {
                "speaker_id": "1",
                "transcription": "다 피감이 있는 상태인데도 불구하고 시작하자마자 그냥 다 녹아버리는 그런 그림을 볼 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.133,
                "end": 73.273
            }
        ]
    },
    "summary": "토핑 장착을 안 한 게 아닌데 피감이 있는 상태인데도 녹아버리는 그림을 볼 수가 있다고 한다.",
