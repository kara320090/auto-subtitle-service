        "term": [
            {
                "speaker_id": "1",
                "transcription": "보고 아 어떡하냐 가서 친구가 죽었다고 어떻게 말해주지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.742
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까요 아이 속상하다 아 디아블로식 엔딩이 나지 않길 바랬는데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.752,
                "end": 18.111
            },
            {
                "speaker_id": "1",
                "transcription": "한 번은 그래서 디아블로4 하고 있을 때 무슨 던전에다가 실수로 친구를 버리고 왔다 그랬나 그래서 친구 좀 찾아 달라는 퀘스트가 있었는데 내가 그래서 당연히 뒤졌겠지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.121,
                "end": 34.862
            },
            {
                "speaker_id": "1",
                "transcription": "이 세계관에서 살아 있는 건 없어 당연히 죽었을걸 이랬거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.872,
                "end": 38.636
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그랬는데 살아 있더라고 참 신기했어요 그래서.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.646,
                "end": 43.515
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 그날은 참 신기한 날이었어.",
                "sound_type": [
                    2,
