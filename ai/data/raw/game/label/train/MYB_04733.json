    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 짧은 뽑기 안에 지금 그렇게 다 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.575
            },
            {
                "speaker_id": "1",
                "transcription": "물론 다 필요 없지만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.585,
                "end": 4.748
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 5초월 끝난 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.758,
                "end": 6.457
            },
            {
                "speaker_id": "1",
                "transcription": "보이죠 빨간 물약이 생기면은 뽑기가 끝난 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.467,
                "end": 9.467
            },
            {
                "speaker_id": "1",
                "transcription": "5성 찍고 5초월 리뷰 각각 따로 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.477,
                "end": 12.233
            },
            {
                "speaker_id": "1",
                "transcription": "일단 찰스 쿠키 스킨 능력을 보면은 일반 공격에 맞은 적은 확률적으로 스턴이 걸리고 스킬 사용 시 하울링 하며 본인에게 공격 속도가 증가되고 피해 감소 버프 걸고 모든 아군에게 공격력 증가 버프 야 좋은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.243,
                "end": 27.847
            },
            {
                "speaker_id": "1",
                "transcription": "하울링이 끝나는 즉시 돌진하며 마지막에 망치 공격을 가해 기절시키고 해머 쇼크 디버프를 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.857,
                "end": 34.338
            },
            {
                "speaker_id": "1",
                "transcription": "해머 쇼크 디버프에 걸린 적은 일정 시간 동안 공격력이 감소하고 망치 스킬 공격이 추가 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.348,
                "end": 41.517
            },
            {
                "speaker_id": "1",
                "transcription": "공격력, 공격 속도, 디버프 중에 스턴 이런 내용이 가장 좋은데 얘가 다 가지고 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.527,
                "end": 47.324
            },
            {
                "speaker_id": "1",
                "transcription": "평타 기절은 50퍼센트의 확률로 1초 기절한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.334,
                "end": 50.929
            },
            {
                "speaker_id": "1",
                "transcription": "돌진 피해량 79퍼센트 피해량 망치 피해량은 450퍼센트고 기절이 2.5초.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.939,
                "end": 57.555
            },
            {
                "speaker_id": "1",
                "transcription": "해머 쇼크 디버프는 40초 동안 공격력 5.5퍼센트 감소 및 망치 스킬 추가 피해량 200퍼센트 최대 중첩 3개까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.565,
                "end": 65.650
            },
            {
                "speaker_id": "1",
                "transcription": "공격력 증가는 8초 동안 15퍼센트 야 이거 크네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.660,
                "end": 69.232
            },
            {
                "speaker_id": "1",
                "transcription": "공격 속도 증가 8초 동안 35퍼센트 피해 감소 8초 동안 30퍼센트 뭐냐 이거 왜 이렇게 사기적으로 나왔냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.242,
                "end": 77.243
            },
            {
                "speaker_id": "1",
                "transcription": "쓰진 않았지만 일단 이거만 봐도 0티어 확정인데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.253,
                "end": 83.306
            },
            {
                "speaker_id": "1",
                "transcription": "야 야 딜 장난 아니네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.316,
                "end": 88.266
            }
        ]
    },
    "summary": "남성 화자가 이제 5초월이 끝났다며 찰스 쿠키 스킨 능력을 설명하고 가장 좋은 것들을 얘가 다 가지고 있고 아직 쓰진 않았지만 0티어 확정이라고 말한다.",
