        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단은 @이름1 같은 경우에는 피감 아예 필요 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.090
            },
            {
                "speaker_id": "1",
                "transcription": "아예 없어도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.090,
                "end": 4.270
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 얘가 중요한 거는 공속이 30 퍼센트 이상이면 좋다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.270,
                "end": 7.660
            },
            {
                "speaker_id": "1",
                "transcription": "물론 30 퍼센트 이하라도 쓸 수는 있지만 좀 더 좋게 쓸라면은 30 퍼센트 이상 요렇게 세팅해 주시고 @이름2 같은 경우에는 쿨 20 퍼센트, 십구에서 20 퍼센트 사이 뭐 요렇게 세팅해 주시고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.660,
                "end": 18.690
            },
            {
                "speaker_id": "1",
                "transcription": "피감도 높게 안 하셔도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.690,
                "end": 20.120
            },
            {
                "speaker_id": "1",
                "transcription": "한 10 퍼센트대, 15 퍼센트, 10 퍼센트 대 고렇게 해서 나머지는 공, 치 위주로 그리고 @이름3 같은 경우에는 쿨 7 퍼센트 가까이 뭐 육에서 7 퍼센트 사이면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.120,
                "end": 29.890
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 공, 치에 집중 그리고 @이름4 같은 경우에는 이것도 피감 높이할 필요 없이 10 퍼센트대에다가 공, 치 그다음에 공속은 조금 있으면 좋은 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.890,
                "end": 39.570
            },
            {
                "speaker_id": "1",
                "transcription": "@이름5는 그냥 올 아몬드 끼시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.570,
                "end": 42.120
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 수치 상관없이 아몬드로",
