        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 중세를 되게 좋아하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.546
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 느낌을 너무 잘 살려서 너무 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.556,
                "end": 4.887
            },
            {
                "speaker_id": "1",
                "transcription": "근데 심지어 판타지도 좋아해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.897,
                "end": 8.110
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 완전 요즘 푹 빠졌어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.120,
                "end": 12.561
            },
            {
                "speaker_id": "1",
                "transcription": "이거 하고 싶어서 방송을 일찍 키고 싶다는 생각을 많이 했는데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.571,
                "end": 19.108
            },
            {
                "speaker_id": "2",
                "transcription": "내가 잘 싸우거나 강력하거나 능력이 뛰어난 게 아니라면 마을 밖으로는 웬만하면 나가는 거 아니다. 위쳐 디아블로.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.118,
                "end": 27.510
            },
            {
                "speaker_id": "1",
                "transcription": "맞아. 나가는 그 순간 그냥 고깃덩어리가 돼버리겠죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.520,
                "end": 30.522
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.532,
                "end": 31.858
            },
            {
                "speaker_id": "1",
                "transcription": "음 이게 요즘에 너무 몸이 피곤한가 잠을 오지게 자요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.868,
                "end": 39.233
            }
        ]
    },
    "summary": "여자 게임 유튜버는 중세와 판타지를 좋아하는데 지금 하고 있는 게임이 그 느낌을 잘 살려서 푹 빠졌다고 하고 한 구독자가 강력하거나 능력이 뛰어난 게 아니면 마을 밖으로 나가면 안 된다고 하자 동의한다.",
