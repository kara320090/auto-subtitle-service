        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자구마가 적용되는 경우가 많긴 하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.348
            },
            {
                "speaker_id": "1",
                "transcription": "자구마가 생존이 좀 더 잘 될 수 있겠다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.358,
                "end": 5.583
            },
            {
                "speaker_id": "1",
                "transcription": "그런 게 보이긴 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.593,
                "end": 7.193
            },
            {
                "speaker_id": "1",
                "transcription": "버티고 버티고 해",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.203,
                "end": 12.974
            },
            {
                "speaker_id": "1",
                "transcription": "어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.984,
                "end": 18.315
            },
            {
                "speaker_id": "1",
                "transcription": "크큼",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.325,
                "end": 25.185
            },
            {
                "speaker_id": "1",
                "transcription": "어 크 클로티드 애기애기 한 것 봐 여러분들",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.195,
                "end": 28.284
            },
            {
                "speaker_id": "1",
                "transcription": "아 너무 귀여워",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.294,
                "end": 30.221
            },
            {
                "speaker_id": "1",
                "transcription": "자 자 또 이겼네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.231,
                "end": 32.545
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 원래 모노클이 무조건 좋은 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.555,
                "end": 35.585
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 여러분들 이 영상 보면서 아 신보가 이거 사기나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.595,
                "end": 40.043
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 무조건 예능이긴 합니다. 운 좋게 이기는 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.053,
                "end": 42.981
            },
            {
                "speaker_id": "1",
                "transcription": "설마 또 이기겠어요. 설마?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.991,
                "end": 46.560
            },
            {
                "speaker_id": "1",
                "transcription": "어유 야 느려진 거 너무 답답하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.570,
                "end": 48.841
            },
            {
                "speaker_id": "1",
                "transcription": "아 이번에 드디어 졌네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.851,
                "end": 50.351
            },
            {
                "speaker_id": "1",
                "transcription": "네 크런치초코칩 덱한테 드디어 졌습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.361,
                "end": 55.682
            },
            {
                "speaker_id": "1",
                "transcription": "네 요 덱에 넣어서 해보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.692,
                "end": 58.754
            },
            {
                "speaker_id": "1",
                "transcription": "다른 보물 대신에 대체해서 쓰기에는 힘듭니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.764,
                "end": 61.546
            },
            {
                "speaker_id": "1",
                "transcription": "시계랑 무공비는 고정 이걸 왜 하냐 실제로 신보를 썼을 때 어 다른 덱에서 모노클 대체해서 이게 정말 만렙을 찍은 보물의 가치가 있나 그거를 보려고 아레나에서 지금 테스트를 하는 거고 모노클 대신해서 효과가 좋으려면은 아무래도 클로티드 덱한테는 좋을지 몰라도 네 나머지 덱한테는 좀 좋지 않지 않을까 모노클보다 좋은 장점이 쿠키 한 마리만 작아지고 세진다고 해서 전체 승부에 영향을 주기는",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.556,
                "end": 97.625
            }
        ]
    },
    "summary": "한 남성이 게임상에서 또 이겼고 운 좋게 이긴거라고 하며 다시 게임을 하는데 드디어 졌다고 한다. 크런치초코칩에게 졌고 이걸 하는 이유는 보물을 썼을 때 다른 덱에게서 모노클 대체해서 이게 정말 최고 레벨을 찍은 보물의 가치가 있나 그거를 보려고 테스트를 하는 거라고 한다. 모노클 대신해서 효과가 좋으려면은 아무래도 클로티드 덱한테는 좋을지 몰라도 나머지 덱한테는 좋지 않지 않을까라고 한다.",
