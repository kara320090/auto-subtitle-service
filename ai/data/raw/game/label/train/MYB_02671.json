    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피시에서 즐길 때 녹스 앱플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.946
            },
            {
                "speaker_id": "1",
                "transcription": "방치형 모바일 게임을 편하게 모니터링 가능하며 핸드폰 발열이나 배터리 부족으로 인한 불편함도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.956,
                "end": 8.253
            },
            {
                "speaker_id": "1",
                "transcription": "피시에서 큰 화면에 초고화질로 몰입할 수 있는 녹스 앱플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.263,
                "end": 12.349
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 운영은 흠잡을 거 딱 하나 있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.359,
                "end": 15.738
            },
            {
                "speaker_id": "1",
                "transcription": "고기 타워 안 지은 거 그거 말고는 아주 잘하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.748,
                "end": 20.521
            },
            {
                "speaker_id": "1",
                "transcription": "생산 탑 답 테크는 다 열어 여 여세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.531,
                "end": 23.610
            },
            {
                "speaker_id": "1",
                "transcription": "지금 15단계니까 무조건 다 여세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.620,
                "end": 26.621
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 쿠키 키워야 될 것 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.631,
                "end": 29.284
            },
            {
                "speaker_id": "1",
                "transcription": "따로 별사탕이 남아돌잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.294,
                "end": 32.000
            },
            {
                "speaker_id": "1",
                "transcription": "지금 쿠키였으면은 일단 뭐 완벽합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.010,
                "end": 35.592
            },
            {
                "speaker_id": "1",
                "transcription": "토핑부터 좀 볼게요. 그러면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.602,
                "end": 36.748
            },
            {
                "speaker_id": "1",
                "transcription": "이분은 개평을 맡길 분은 아닌 거 같아. 다 잘 되어있으셔서 토핑 작도 잘 되어있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.758,
                "end": 43.784
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.794,
                "end": 45.877
            },
            {
                "speaker_id": "1",
                "transcription": "이거 승률 좋아요? 어때요? 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.887,
                "end": 47.462
            },
            {
                "speaker_id": "1",
                "transcription": "내가 볼 때는 무난하게 잘 돌아가는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.472,
                "end": 49.605
            },
            {
                "speaker_id": "1",
                "transcription": "잘 돌아가게 세팅 잘하셨네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.615,
                "end": 51.324
            },
            {
                "speaker_id": "1",
                "transcription": "이거 세팅 요거 고대로 가져가시고 얘 쿨로만 바꾸세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.334,
                "end": 55.065
            },
            {
                "speaker_id": "1",
                "transcription": "쿨은 세트 효과 제외하고 22퍼센트 이상 해주시면은 이상적입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.075,
                "end": 60.981
            },
            {
                "speaker_id": "1",
                "transcription": "야 이분은 뭐 내가 진짜 손댈 게 없는 분이고만 다 알고 있네 이거 랭커 조합이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.991,
                "end": 66.982
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 완벽하고 흠이 없네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.992,
                "end": 69.137
            },
            {
                "speaker_id": "1",
                "transcription": "요것도 세팅 다되셨네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.147,
                "end": 71.969
            },
            {
                "speaker_id": "1",
                "transcription": "한번 보자 잘 굴러가는지 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.979,
                "end": 75.166
            }
        ]
    },
    "summary": "남성은 왕국 운영에서 흠잡을 거는 고기 타워 안 지은 거 딱 하나 있다고 했고 쿠키도 완벽하고 토핑 작도 잘 되어있는데 쿨은 세트 효과 제외하고 22퍼센트 이상해 주는 게 이상적이라고 했고 랭커 조합도 완벽하다고 했다.",
