        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 바다요정 잼스톤 업데이트 이후 바다요정 쿠키는 어디에 써야되고 그리고 잼스톤을 활용한 조합은 어떤 게 있고 그다음에 토핑세팅은 어떻게 해야되냐 이런 질문들이 많이 올라오고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 11.317
            },
            {
                "speaker_id": "1",
                "transcription": "자 제일 먼저 잼스톤 같은 경우에는 여러분들이 아무리 풀과금을 해도 30강을 달기에는 힘들어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.327,
                "end": 17.360
            },
            {
                "speaker_id": "1",
                "transcription": "아마 주간 패키지를 전부 다 사고 한 2주, 3주 지나야지만 30강을 만들 수 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.370,
                "end": 22.758
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 19강으로 아레나를 쭉 달려서 1등까지 올라와봤는데 그 과정에서 여러가지 조합 테스트를 해봤습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.768,
                "end": 29.796
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다요정 관련된 조합을 제가 추천드릴건데 아무래도 바다요정은 몸 자체가 너무 약하기 때문에 장기전으로 가면은 승산이 낮습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.806,
                "end": 38.758
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 극딜 조합으로 써야 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.768,
                "end": 40.623
            },
            {
                "speaker_id": "1",
                "transcription": "무공비, 호루라기, 시계를 쓰고 자 그리고 호루라기 같은 경우에는 바다요정과 달빛술사가 호루라기를 받아주면은 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.633,
                "end": 49.005
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 토핑 같은 경우에는 홀리베리 올 쿨, 피감은 높게, 쿨은 22퍼센트 이상이면 좋을 거 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.015,
                "end": 55.153
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트는 자 이렇게 4애플젤리 1쿨 넣어가지고 자 이렇게 3초로 시작하게 만들면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.146,
                "end": 61.135
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 3초로 시작하게 하는 방법은 10.3퍼센트 이상일 때 시작 쿨타임이 3초로 바뀌기 때문에 저거 이상으로 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.145,
                "end": 68.586
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 달빛술사 같은 경우에는 올 쿨로 맞춰주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.586,
                "end": 71.861
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임은 22퍼센트 이상 해주시면 좋을 거 같고 피감은 여러분들 능력껏 높게 바다요정을 4라즈 1쿨, 이게 불가능하다면 3라즈 2쿨해서 쿨타임은 11.8퍼센트 이상 맞춰주시면 여러분들 4초로 시작하게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.871,
                "end": 86.494
            },
            {
                "speaker_id": "1",
                "transcription": "이 4초 맞춰주시는 거 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.504,
                "end": 88.619
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 마지막 스냅 드래곤은 올 쿨로 공격률과 치명타 확률 높게 세팅해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.629,
                "end": 94.206
            },
            {
                "speaker_id": "1",
                "transcription": "자 분명히 이런 질문 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.217,
                "end": 95.633
            },
            {
                "speaker_id": "1",
                "transcription": "@계정1님 저는 이렇게 피감 높게 못해요 하시는 분들 초반에 극딜로 많이 넣는 조합이라 피감보다는 약간 공격적으로 세팅해도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.633,
                "end": 104.933
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 제가 실전에서 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 104.940,
                "end": 109.733
            }
        ]
    },
    "summary": "바다요정 잼스톤 업데이트 이후 질문들이 많이 올라오고 있는데 아무래도 바다요정은 몸 자체가 너무 약하기 때문에 장기전으로 가면은 승산이 낮기에 극딜 조합으로 써야되고 홀리베리는 올 쿨, 피감은 높게, 스타더스트는 쿨타임 3초로 맞추고 달빛술사는 올 쿨, 쿨타임은 4초로 맞추는 게 중요하고 스냅 드래곤은 올 쿨과 공격률과 치명타 확률을 높게 세팅하면 된다.",
