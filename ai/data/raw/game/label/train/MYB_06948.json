                    3
                ],
                "start": 7.128,
                "end": 9.314
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 어떻게 했었지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.324,
                "end": 11.374
            },
            {
                "speaker_id": "1",
                "transcription": "아 그런데 지금 다들 여기는 아마 어 피지컬이 안 되면 안 되나 봐요.",
