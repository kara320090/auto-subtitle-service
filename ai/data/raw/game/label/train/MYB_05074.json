        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 세팅 그렇게 막 복잡하지 않게 어 사용할 수 있다 그렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.903
            },
            {
                "speaker_id": "1",
                "transcription": "예 용쿠덱 요구 한번 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.913,
                "end": 8.458
            },
            {
                "speaker_id": "1",
                "transcription": "과연 요거 이기려면 상대 좀 잘라주는 그림이 나오긴 해야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.468,
                "end": 14.324
            },
            {
                "speaker_id": "1",
                "transcription": "예 이렇게 이것도 이거는 이기는 그림이겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.334,
                "end": 20.150
            },
            {
                "speaker_id": "1",
                "transcription": "음 이런 그림 그럼 용쿠는 용쿠는 여러분들 제가 볼 때 피가 많이 없는 게 난 것 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.160,
                "end": 25.828
            },
            {
                "speaker_id": "1",
                "transcription": "이거 세팅할 때 아예 용쿠가 피감이 없는 게 난 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.838,
                "end": 31.099
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 죽어서 바요를 살리는 게 더 난 것 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.109,
                "end": 33.853
            },
            {
                "speaker_id": "1",
                "transcription": "예 이렇게 그냥 피감 없이 그냥 세팅해 준 게 제일 난 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.863,
                "end": 37.887
            },
            {
                "speaker_id": "1",
                "transcription": "용쿠 제일 먼저 일찍 죽어라 그렇게 보내주는 게 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.897,
                "end": 44.100
            }
        ]
    },
    "summary": "용쿠덱은 이기려면 상대 좀 잘라주는 그림이 나와야 하고 피감이 없는 게 난 것 같다.",
