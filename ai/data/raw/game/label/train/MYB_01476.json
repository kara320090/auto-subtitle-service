        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 체력이 채워지고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.962
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 예 스킬 도는 대로 바로바로 눌러 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.972,
                "end": 6.953
            },
            {
                "speaker_id": "1",
                "transcription": "네 여기서 여러분들이 이제 돌리다가 네 중요한 포인트는 쿠키가 죽는 다음에는 아까 보여드린 피해 감소 설정에서 피해 감소만 좀 더 높여 주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.963,
                "end": 20.247
            },
            {
                "speaker_id": "1",
                "transcription": "에클레오가 러너 님 저는 왜 자꾸 죽나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.257,
                "end": 22.879
            },
            {
                "speaker_id": "1",
                "transcription": "저거는 풀피 상태라도 치명타가 터지면은 죽는 거는 어쩔 수가 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.889,
                "end": 27.940
            },
            {
                "speaker_id": "1",
                "transcription": "풀스펙이라도 에클레어가 피해 반사 때문에 터지는 거는 어쩔 수가 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.950,
                "end": 32.575
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 해서 131단계도 이렇게 5.3억 고단계에서도 어마무시한 딜이 나온다.",
                "sound_type": [
                    2,
