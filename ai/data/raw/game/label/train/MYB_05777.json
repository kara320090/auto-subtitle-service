        "term": [
            {
                "speaker_id": "1",
                "transcription": "왐마 야 마지막까지 가니까 힐량이 미쳤네. 오래 살아남으니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.583
            },
            {
                "speaker_id": "1",
                "transcription": "초월이 높으면은 올 쿨로 해서 버텨집니다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.593,
                "end": 9.015
            },
            {
                "speaker_id": "1",
                "transcription": "정리를 할게요 나는 올 5성 됐는데 올쿨로 해도 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.025,
                "end": 13.876
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아마 뱀파이어에게 물렸을 때 죽을 확률도 있어가지고 애매하게 죽거든요. 피감이 좀 낮으면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.886,
                "end": 18.297
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들은 그냥 아몬드 섞어서 하거나 그래도 될 거 같아요.",
                "sound_type": [
                    2,
