        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "제가 계정 평가나 다른 걸 진행하면서 느꼈던 거는 분명히 이런 덱을 제가 추천해 드려도 쿠키가 없는 쿠키가 있거나 아직 뭐 토핑이 없거나 이런 분들이 분명히 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.762
            },
            {
                "speaker_id": "1",
                "transcription": "제가 무난하게 추천 드릴 수 있는 거는 현재 이 덱이 가장 좋지만 분명히 복귀 유저나 무과금 유저 아니면 스펙이 안 된 분들은 앞에 신규 쿠키가 없는 분들도 있을 거고 그래도 제가 에픽 0티어로 제가 추천 많이 했던 와일드베리는 좀 많이 있을 거거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.772,
                "end": 26.756
            },
            {
                "speaker_id": "1",
                "transcription": "와베 이렇게 넣어서 크런치초코칩 자리에 넣어서 쓰거나 오이스터도 없는 분들 분명히 많을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.766,
                "end": 33.065
            },
            {
                "speaker_id": "1",
                "transcription": "이 자리에는 이제 파르페를 쓰거나 요 덱 맞춰서 쓰셔도 되는데 보물이 없어요 하시는 분들은 티어 낮은 데서는 그래도 뭐 부활 보물 써서라도 쓸 수는 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.075,
                "end": 43.514
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 시도를 해 보시고 이 덱이 나는 준비가 아예 안 됐다 하시는 분들은 보통 제가 세팅하는 걸 전반적으로 알려드리면 탱커 같은 경우는 피감 높아야 된다고 다 알고 있어서 아몬드작 열심히 해주시고 보통은 이 가운데 라인 뭐 라즈나 쿨이나 뭐 세팅해서 많이 하시는데 세트 효과를 뭐 올 라즈 끼시는 분들 입장에서 피감이 보니까 뭐 2퍼센트 3퍼센트 맞춰놓고 아래나 돌리는 분도 있더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.524,
                "end": 68.614
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그렇게 피감이 낮을 바에는 차라리 아몬드 토핑을 끼워 넣어서 섞어서 쓰시는 게 훨씬 더 낫습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.624,
                "end": 75.116
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 피감이 2퍼센트 3퍼센트 아니 10퍼센트 미만이면은 상대의 공격 첫 턴에 일단 죽고 시작하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.126,
                "end": 81.489
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 되면은 아무 의미가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.499,
                "end": 83.386
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 여러분들 세핑 각자 하실 때 올 라즈나 올 쿨 피해 감소가 너무 낮다 하시면 차라리 아몬드 토핑 껴서 섞어서라도 피감 높게 쓰시면 그게 더 훨씬 더 좋다는 점 그렇게 아시면 좋은 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.396,
                "end": 96.693
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 일단은 힐러들도 뒤에 다 올 쿨인데 피감이 5퍼센트 미만이거나 그럴 경우에도 아몬드 섞어서 쓰시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.703,
                "end": 105.508
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 써가지고 피감 최대한 못해도 제가 볼 때는 15퍼센트는 넘어야 될 것 같거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.518,
                "end": 110.536
            },
            {
                "speaker_id": "1",
                "transcription": "저 밑에 구간이라고 해도 좀 뒤를 버티면서 세팅을 해주면 좋을 것 같고 지금 말씀드린 거 요거는 앞에 투탱 있을 때 샤벳상어 이용해서 이렇게 추천 드리는 영상인데 공속덱 같은 경우에는 지금 뭐 되게 다양한 조합이 많이 나왔지만 흑당이나 와베 이렇게 이용한 투탱공속덱이 되게 많거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.546,
                "end": 128.972
            },
            {
                "speaker_id": "1",
                "transcription": "이 가운데 들어가는 거나 이런 거 되게 다양할 수 있지만 흑당 와베 세팅 앞에 올 아몬드 해 가지고 공속 보물 받을 수 있게 세팅해서 여기 들어가는 게 에클레어랑 서리랑 허브도 들어가고 파르페도 들어가고 되게 다양하니까 그건 여러분들 상황에 맞게 세팅해 주시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 128.982,
                "end": 146.322
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음 제가 또 추천드리는 거는 요것도 되게 좋거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 146.332,
                "end": 149.440
            },
            {
                "speaker_id": "1",
                "transcription": "와베 그리고 에클레어 바다의요정 소리여왕, 목화인데 올 아몬드 올 라즈, 라즈, 라즈, 쿨이예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 149.450,
                "end": 157.175
            },
            {
                "speaker_id": "1",
                "transcription": "근데 에클레어 같은 경우는 올 라즈해서 쿨 8퍼센트에다 피감 이렇게 높게 세팅을 해주는데 이 덱은 피감이 또 요 3개가 좀 높아야 돼요 어느 정도.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 157.185,
                "end": 166.723
            },
            {
                "speaker_id": "1",
                "transcription": "높아야 쓸 수 있다는 점 요거는 되게 유용하게 쓸 수 가 있을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 166.733,
                "end": 171.096
            },
            {
                "speaker_id": "1",
                "transcription": "원탱커덱이나 투탱소환덱한테 많이 쓰는데 잘 쓰고 있다는 점 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 171.106,
                "end": 177.826
            },
            {
                "speaker_id": "1",
                "transcription": "일단 그리고 아레나에서 지금 상당히 많이 보이는 이 원탱소환텍 요거 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 177.836,
                "end": 183.901
            },
            {
                "speaker_id": "1",
                "transcription": "요거 같은 경우에는 저 이걸 되게 추천 드리거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 183.911,
                "end": 186.745
            },
            {
                "speaker_id": "1",
                "transcription": "되게 많아요. 지금 소환덱 방덱이 낚시덱도 있고 그래 가지고 많아서 요거 같은 경우에는 요거 2번째예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 186.755,
                "end": 193.086
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳 자리에 와베를 넣어 가지고 아몬드, 아몬드, 아몬드 오이스터 같은 경우에는 피감 40퍼센트 이상 쿨타임 11.2 이상 권장입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 193.096,
                "end": 201.941
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 해서 쓰고 다음에 목화는 올 쿨",
                "sound_type": [
                    2,
                    3
                ],
                "start": 201.951,
                "end": 205.800
            }
        ]
