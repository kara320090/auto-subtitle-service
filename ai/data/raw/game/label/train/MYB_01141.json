        "term": [
            {
                "speaker_id": "1",
                "transcription": "역전 가능할까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.999
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 글쎄다?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.009,
                "end": 7.893
            },
            {
                "speaker_id": "1",
                "transcription": "야 야 이것도 잘 통한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.903,
                "end": 17.219
            },
            {
                "speaker_id": "1",
                "transcription": "근데 확실히 바요가 더 확실하게 앞에 더 정리 잘해준다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.229,
                "end": 24.886
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거는 확실해.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.896,
                "end": 26.177
            },
            {
                "speaker_id": "1",
                "transcription": "바요가 더 좋아 야 이거는 바요가 더 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.187,
                "end": 29.103
            },
            {
                "speaker_id": "1",
                "transcription": "똑같은 무궁비급 상대로 바요는 그냥 이기거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.113,
                "end": 33.456
            },
            {
                "speaker_id": "1",
                "transcription": "이제 바요로는 잘 보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.466,
                "end": 35.152
            },
            {
                "speaker_id": "1",
                "transcription": "네 바요는 오먹딜 증가가 되게 큽니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.162,
                "end": 38.178
            },
            {
                "speaker_id": "1",
                "transcription": "물 속성 딜 증가때문에 잘 봐요.",
                "sound_type": [
                    2,
