            },
            {
                "speaker_id": "1",
                "transcription": "책에서 홀리베리 궁전에는 늘 아름다운 음악이 흐르고 우아하게 춤추는 쿠키들이 있다고 읽었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.332,
                "end": 10.672
            },
            {
                "speaker_id": "2",
                "transcription": "어머 그래 무슨 춤을 주로 추나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.682,
                "end": 14.111
            },
            {
                "speaker_id": "2",
                "transcription": "나도 최근에 춤 수업을 좀 받았는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.121,
                "end": 17.641
            },
            {
                "speaker_id": "3",
                "transcription": "그건 제 분야가 아니라.",
                "sound_type": [
