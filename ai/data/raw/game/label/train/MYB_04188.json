        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이거 졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.914
            },
            {
                "speaker_id": "1",
                "transcription": "첫판은 지고 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.924,
                "end": 4.876
            },
            {
                "speaker_id": "1",
                "transcription": "첫판은 지고 갔는데 그래도 두 번째는 공식에 의해서 그래도 이기고 가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.886,
                "end": 9.267
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 세 번째 야 세 번째 진검 승부",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.277,
                "end": 15.774
            },
            {
                "speaker_id": "1",
                "transcription": "첫판은 져도 공식대로만 들어가면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.784,
                "end": 18.949
            },
            {
                "speaker_id": "1",
                "transcription": "다시 한번 말씀 드리지만 흑당 관련된 공속 덱 느낌이 있으면은 찰스, 다크 카카오로 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.959,
                "end": 26.717
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 잘 만났네요.",
                "sound_type": [
                    2
                ],
                "start": 26.727,
                "end": 28.947
            },
            {
                "speaker_id": "1",
                "transcription": "찰스랑 다크 카카오 휘낭시에로 맞춰준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.957,
                "end": 31.725
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 휘낭시에 보이면 와베로 맞춰준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.735,
                "end": 34.196
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 하나는 요렇게 들어가면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.206,
                "end": 36.965
            },
            {
                "speaker_id": "1",
                "transcription": "3판 중에 2판만 이기면 좋기 때문에 요거 맞춰주시면 좋을 것 같아요.",
                "sound_type": [
                    2,
