            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이거 참고로 무과금 계정입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.933,
                "end": 5.715
            },
            {
                "speaker_id": "1",
                "transcription": "디즈니 때부터 시작한 분이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.725,
                "end": 7.768
            },
            {
                "speaker_id": "1",
                "transcription": "디즈니 때부터 게임 시작해서 크리스탈 모아서 저한테 맡겨 주셨는데 지금 현재 이렇게 되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.778,
                "end": 14.795
            },
            {
                "speaker_id": "1",
                "transcription": "이게 가능하다니",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.805,
                "end": 15.890
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 또 웃긴 게 뭔지 아세요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.900,
                "end": 18.140
            },
            {
                "speaker_id": "1",
                "transcription": "막 진짜 무화과 쿠키나 칠리 쿠키 같은 거는 단 하나도 안 나오지 않았나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.150,
                "end": 21.992
            },
            {
                "speaker_id": "1",
                "transcription": "다 그냥 좋은 쿠키만 나와요.",
                "sound_type": [
