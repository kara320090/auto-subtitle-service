        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 만랩을 찍으면 대상 체력의 30퍼센트 체력 보호막 피해 감소는 무려 15퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.689
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.699,
                "end": 13.042
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 MAC버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.052,
                "end": 16.494
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드가 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.504,
                "end": 20.321
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 저게 좋게 쓰일 곳이 그냥 뭐 무난한 덱에다 한 번 세팅을 해보죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.331,
                "end": 27.360
            },
            {
                "speaker_id": "1",
                "transcription": "상대방은 모노클 있고 저는 신규 보물로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.370,
                "end": 31.183
            },
            {
                "speaker_id": "1",
                "transcription": "아 아니면은 아예 미러로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.193,
                "end": 33.593
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 비교할 때 제일 좋은 게 미러로 했을 때가 결과가 궁금할 거 같은데 네 자구마는 상관 없을 거 같아요.",
                "sound_type": [
