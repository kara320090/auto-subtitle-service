    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 마의 힐링타운 모바일 게임입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.616
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 썸네일에서 보신 것처럼 이 게임은 뽑기 할 때 SSR 동물을 그냥 무료로 주고 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.626,
                "end": 14.449
            },
            {
                "speaker_id": "1",
                "transcription": "고급 셔틀버스에서 지금 시간이 지나면 자동으로 뽑기 권을 줘요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.459,
                "end": 19.966
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 SR 조각 확정이나, SSR 조각 확정을 여러분들 시간이 지나면은 자동으로 주기 때문에 걱정이 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.976,
                "end": 28.853
            },
            {
                "speaker_id": "1",
                "transcription": "과금할 이유가 딱히 뭐, 욕심이 나면은 당연히 과금해서 뽑아도 되지만 확정으로 주기 때문에 과금 유도가 뭐 엄청나게 있는 것도 아니고, 힐링으로 여러분들 하기 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.863,
                "end": 39.412
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 뿐만 아니라 건설, 그리고 가구, 선물도 SSR을 이렇게 광고를 보면 확정으로 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.422,
                "end": 46.803
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 광고를 보고 나서 타 게임으로 비교하자면 레전드, 뭐 슈퍼 에픽 최고 등급의 그런 동물을 받을 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.813,
                "end": 56.043
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 동물이 뭐냐? 자 동물 같은 경우에는 능력이 다 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.053,
                "end": 60.508
            },
            {
                "speaker_id": "1",
                "transcription": "공장 생산 효율, 낚시 효율, 채굴 효율 각각의 효율이 다 다른데, 가장 높은 등급의 SSR은 효율이 가장 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.518,
                "end": 69.439
            },
            {
                "speaker_id": "1",
                "transcription": "각각의 능력에 따라서 특정 효율이 가장 높은 수치로 부여된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.449,
                "end": 73.917
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들 이 게임 하게 되면 SSR 뽑기에 대해서 스트레스 없이 꾸미기 게임인만큼 좋아하는 왕꾸에 대해서도 부담 없이 즐길 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.927,
                "end": 82.858
            },
            {
                "speaker_id": "1",
                "transcription": "자 뿐만 아니라 여러분들 고정 댓글에 보시면은 지금 현재 쿠폰이 10가지가 입력이 가능 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.868,
                "end": 89.265
            },
            {
                "speaker_id": "1",
                "transcription": "다양한 보상도 받을 수 있고, 그리고 다양한 이벤트도 진행 중이라 여러분들이 정말 힐링으로 하기 좋은 게임이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.275,
                "end": 96.745
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 제가 좋아하는 드림 브리지라는 게임이 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 96.755,
                "end": 99.675
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 이렇게 보시면은 게이지에 맞춰서 진행하는 정말 보기 쉽죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.685,
                "end": 104.720
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 맞춰서 가시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 104.730,
                "end": 106.385
            },
            {
                "speaker_id": "1",
                "transcription": "게이지만 맞춰서 끝까지 가면은 상자가 있고요, 이 상자 오픈하면 보상을 받을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 106.395,
                "end": 112.411
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임의 가장 큰 장점은 뭐냐면은 어떤 콘텐츠든 간에 보상받을 수 있는 수급처가 널리고 널렸어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 112.421,
                "end": 120.237
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보면 뭐 상선, 그다음에 이 표류 병, 그리고 뭐 행상, 가구 제작도 가능하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 120.247,
                "end": 126.804
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 농작물 재배도 가능하고, 그다음에 열기를 통해서도 이렇게 재화를 얻어서 영토 확장이나 토지 개발, 이런 것도 다 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 126.814,
                "end": 135.900
            },
            {
                "speaker_id": "1",
                "transcription": "또한 내가 축제도 개최를 가능하거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 135.910,
                "end": 139.209
            },
            {
                "speaker_id": "1",
                "transcription": "자, 내가 이렇게 축제를 개최해서 뭐 선물 상자를 이렇게 오픈을 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 139.219,
                "end": 143.503
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 사람들이 놀러 와서 같이 축제를 열 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 143.513,
                "end": 146.639
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이렇게 상자 오픈해서 보상받을 수도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 146.649,
                "end": 149.990
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 다른 사람들 축제도 놀러 갈 수도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 150.000,
                "end": 152.535
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 축제에 놀러 가서 뭐 이렇게 상자 오픈된 거 제가 뭐 상자 이렇게 선물을 하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 152.545,
                "end": 159.408
            },
            {
                "speaker_id": "1",
                "transcription": "VIP 이렇게 되고 나서 뭐 이렇게 상자 오픈해서 선물을 받을 수도 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 159.418,
                "end": 163.730
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 여러분들이 진짜 타 게임 해보시면 알겠지만 가장 높은 등급의 그런 뽑기 확률이 극악의 등급을 뽑기 힘들잖아요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 163.738,
                "end": 172.145
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기는 이렇게 놀러 가서 그냥 쉽게 획득할 수가 있어요. SSR 등급을",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 172.155,
                "end": 177.390
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 한 마디로 제가 지금 말씀드리고 싶은 건 뭐냐면은 이 게임은 여러분들이 엄청나게 재화 얻는 거에 대한 스트레스는 없다, 그런 느낌으로 하시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 177.404,
                "end": 188.593
            },
            {
                "speaker_id": "1",
                "transcription": "재화 수급이나 이런 거는 열심히 참여한 만큼 많이 얻을 수가 있고, 힐링하면서 할 수 있다. 1",
                "sound_type": [
                    2,
                    3
                ],
                "start": 188.603,
                "end": 195.010
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 게임의 또 하나의 장점은 내가 부족한 재화에 대해서 친구한테 도움을 줄 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 195.016,
                "end": 202.060
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 가족에 가입하면은 가족 버프가 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 202.067,
                "end": 205.512
            },
            {
                "speaker_id": "1",
                "transcription": "가족끼리 이렇게 꾸미기를 할 수가 있습니다, 또한 파티 같은 시스템도 있어서 같이 사람들끼리 모여서 요리를 만들고, 기본 재료도 만들고, 원재료도 만들고 파티 시스템도 있어서 월요일, 수요일, 금요일, 토요일 날 파티 개최도 가능한 시스템이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 205.522,
                "end": 223.370
            }
        ]
    },
    "summary": "마의 힐링타운 모바일 게임을 설명해 주는데 타 게임처럼 뽑기 확률이 힘들지 않고, 재화 수급이 쉬우며 가족 가입하면 버프가 있어서 가족 꾸미기를 할 수 있고 파티 시스템이 있으며 힐링할 수 있는 게임이라고 설명했다.",
