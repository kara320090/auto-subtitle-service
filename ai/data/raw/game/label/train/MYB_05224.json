                    5
                ],
                "start": 0.000,
                "end": 3.240
            },
            {
                "speaker_id": "1",
                "transcription": "발 딛는 순간 가루로 만들어 가라앉혀 줄 테다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
