        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 아저씨 목소리 진짜 느끼하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 13.666
            },
            {
                "speaker_id": "1",
                "transcription": "아유 아저씨 넷이서.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.676,
                "end": 15.857
            },
            {
                "speaker_id": "1",
                "transcription": "아니 내 친구들 남편이 남편들이 무슨 TV에 출연한 거예요 최근에. 그래서 그게 뭐야 이래갖고서는 영상 올라온 걸 링크 줬길래 봤더니 세상에 세상 그렇게 건전할 수가 없어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.867,
                "end": 29.371
            },
            {
                "speaker_id": "1",
                "transcription": "다 같이 티셔츠 맞춰입고 축구 동호회 하거든요 그 오빠들이?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.381,
                "end": 33.593
            },
            {
                "speaker_id": "1",
                "transcription": "다 같이 티셔츠 맞춰입고 남자들끼리 펜션에 가가지고 무슨 고기 구워먹는데 그거 촬영 해가지고 거기 앉아있는거야 오빠들끼리.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.603,
                "end": 42.134
            },
            {
                "speaker_id": "1",
                "transcription": "아는 오빠들이잖아요 저도 친구 남편들이니까. 어쩜 그렇게 건전한지 몰라 아유.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.144,
                "end": 48.166
            }
        ]
    },
    "summary": "화자는 캐릭터의 목소리가 진짜 느끼하다고 말한다.",
