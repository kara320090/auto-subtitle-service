        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그다음 쿠키 보면은 야 스펙은 스펙은 괜찮으시네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.440
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 레벨이 있다 보니까 추가로 더 별사탕 찍어서 해야 될 거는 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.440,
                "end": 9.780
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.780,
                "end": 10.879
            },
            {
                "speaker_id": "1",
                "transcription": "어 요 덱 좋지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.880,
                "end": 12.190
            },
            {
                "speaker_id": "1",
                "transcription": "계정 주인분 이거 세팅할 때 이 올 라즈로 하고 얘는 올 아몬드 하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.190,
                "end": 17.040
            },
            {
                "speaker_id": "1",
                "transcription": "얘 올 쿨쿨 해 봤자 어차피 둘 다 터질걸요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.040,
                "end": 19.570
            },
            {
                "speaker_id": "1",
                "transcription": "아이구야 이거 이거 잘못 알고 계시네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.570,
                "end": 22.280
            },
            {
                "speaker_id": "1",
                "transcription": "자 계정 주인분 이거는 낫 들고 가야 되고 쿨 이 정도면은 1분 100 퍼센트 공중 타이밍 때 미사일이 너무 일찍 박혀서 손해 봐요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.280,
                "end": 32.060
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 얘 쿨은 그 1줄만 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.060,
                "end": 34.010
            },
            {
                "speaker_id": "1",
                "transcription": "1퍼센트에서 2퍼센트 뭐 3퍼센트 미만 이게 덱 여러 개 운영하지 마시고 왜 딱 2개만 정해서 하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.010,
                "end": 40.350
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 요 덱이나 요 덱 그냥 세팅 제대로 하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.350,
                "end": 44.340
            },
            {
                "speaker_id": "1",
                "transcription": "토핑작은 그래도 1년 반 동안 하셔서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.340,
                "end": 47.280
            }
        ]
    },
    "summary": "쿠키 스펙은 괜찮고 캐릭터 세팅에서 소르베는 올 라즈, 블랙펄은 아몬드를 하는 것이 좋고 쿨을 1줄만 줘야지 미사일 손해를 보지 않으며 2개의 덱만 정해서 세팅하면 된다.",
