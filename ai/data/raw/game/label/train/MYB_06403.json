        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 짚을 날려서 떨어트려야 내가 지나갈 수 있는 거 아닐까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.013
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 이런 게임 많이 해가지고 못 올라가죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.023,
                "end": 13.242
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이 병아리는 어떻게 된 걸까?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.252,
                "end": 18.108
            },
            {
                "speaker_id": "1",
                "transcription": "저 지푸라기가 날리는 거랑 관련 있을 거 같은데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.118,
                "end": 29.808
            },
            {
                "speaker_id": "1",
                "transcription": "떨어지지 않을까 언젠가?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.818,
                "end": 32.334
            },
            {
                "speaker_id": "1",
                "transcription": "병아리는 제가 조종할 수 있는 영역이 아니에요.",
