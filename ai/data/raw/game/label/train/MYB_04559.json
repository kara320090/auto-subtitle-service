        "term": [
            {
                "speaker_id": "1",
                "transcription": "클로티드한테만 계속 가서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.320
            },
            {
                "speaker_id": "1",
                "transcription": "잡을 수도 있겠다. 잘하면.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.320,
                "end": 12.340
            },
            {
                "speaker_id": "1",
                "transcription": "잡네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.340,
                "end": 16.200
            },
            {
                "speaker_id": "1",
                "transcription": "음.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.200,
                "end": 18.000
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 이기긴 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.000,
                "end": 22.340
            },
            {
                "speaker_id": "1",
                "transcription": "근데 상상상. 상상상 상위권에서는 안 먹힙니다. 근데 마스터 구간이나 그마3까지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.340,
                "end": 30.386
            },
            {
                "speaker_id": "1",
                "transcription": "완전 초반 거기 근처에서는 그래도 괜찮게 다 쓰인다고 하더라고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.396,
                "end": 34.898
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱의 가장 큰 장점은 블랙펄이 아예 안 들어간다는 점.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.908,
                "end": 38.538
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 뱀파는 웬만해서 토벌 때문에 많이 키우셨잖아요? 그래서 이거 토핑도 난이도가 엄청나게 극악이거나 그런 면이 크게 없거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.548,
                "end": 46.394
            },
            {
                "speaker_id": "1",
                "transcription": "영상 보고 따라 하실 분들은 이거 하시는 게 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.404,
                "end": 50.559
            },
            {
                "speaker_id": "1",
                "transcription": "아마 이 덱한테 아주 최적화로 좋을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.569,
                "end": 53.239
            },
            {
                "speaker_id": "1",
                "transcription": "상대가 이렇게 딜러도 있죠? 이런 딜러가 있으면은 끊어주기 진짜 좋거든요? 이것도 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.249,
                "end": 60.933
            }
        ]
    },
    "summary": "딜러가 있으면은 끊어주기에 진짜 좋다.",
