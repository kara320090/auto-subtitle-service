        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이것도 마찬가지 스턴 걸고 달빛, 호밀 예 아몬드까지 해서 네 근데 이렇게 되는 경우도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.602
            },
            {
                "speaker_id": "1",
                "transcription": "마들렌이 살아나는 경우 이 경우에도 예 요렇게 녹이는 그림이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.612,
                "end": 15.476
            },
            {
                "speaker_id": "1",
                "transcription": "자 실제로 공속덱은 요렇게 공속 보물로 티가 나거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.486,
                "end": 20.024
            },
            {
                "speaker_id": "1",
                "transcription": "2개 가려진 게 그것도 다 티가 납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.034,
                "end": 22.846
            },
            {
                "speaker_id": "1",
                "transcription": "마들렌하고 퀸아망일 가능성이 상당히 높다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.856,
                "end": 25.622
            },
            {
                "speaker_id": "1",
                "transcription": "자 시작하자마자 스턴 걸고 호몬드로 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.632,
                "end": 31.559
            },
            {
                "speaker_id": "1",
                "transcription": "자 요런 식으로",
                "sound_type": [
                    2,
