        "term": [
            {
                "speaker_id": "1",
                "transcription": "달메키야와 상프레크의 동향을 말하자면 자치령을 둘러싼 양국의 대립은 여전히 교착 상태야. 본격적인 전쟁은 좀 더 시간이 지나야 할 것 같아 계속 주시하도록 할게. 가브",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 10.577
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 가브 이제 나랑 같이 싸우러 갈 거잖아?",
                "sound_type": [
                    2
                ],
                "start": 10.587,
                "end": 13.815
            },
            {
                "speaker_id": "1",
                "transcription": "가볼까요? 이제 전투를 하러 수 수도 로잘리스로?",
                "sound_type": [
                    2
                ],
                "start": 13.825,
                "end": 21.609
            },
            {
                "speaker_id": "1",
                "transcription": "나도 나도 저 어저께 암브로시아 다시 만났을 때 울었어요.",
                "sound_type": [
                    2
                ],
                "start": 21.619,
                "end": 26.516
            },
            {
                "speaker_id": "1",
                "transcription": "우리 옛날 마을 다 그냥 난리를 쳐 놓고 있구나.",
