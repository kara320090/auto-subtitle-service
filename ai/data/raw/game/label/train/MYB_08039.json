        "term": [
            {
                "speaker_id": "1",
                "transcription": "하하 뭔 말인지 알죠.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.243
            },
            {
                "speaker_id": "1",
                "transcription": "한국식 무덤을 찾고 있었어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.253,
                "end": 6.465
            },
            {
                "speaker_id": "1",
                "transcription": "넌 조카 편히 쉬어라 이런 나라서 미안해",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.475,
                "end": 14.517
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 그 볼록한 그 우리나라 식 무덤을 찾고 있었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.527,
                "end": 24.963
            },
            {
                "speaker_id": "1",
                "transcription": "하하 그러니까 도대체 어떻게 된 거야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.973,
                "end": 29.117
            },
            {
                "speaker_id": "1",
                "transcription": "아니 근데 여기 산 모양이 이 안쪽 모양이 약간 비슷하게 생겼었어 음산한 게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.127,
                "end": 37.699
            },
            {
                "speaker_id": "1",
                "transcription": "뭔지 알죠 히히",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.709,
                "end": 42.841
            },
            {
                "speaker_id": "1",
                "transcription": "아이 깜짝이야 놀래라 아이 여기는 그게 안 되나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.851,
                "end": 46.843
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 곧장 길로만 가야 하나",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.853,
                "end": 52.031
            },
            {
