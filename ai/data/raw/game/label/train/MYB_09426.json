        "term": [
            {
                "speaker_id": "1",
                "transcription": "칼리스토 프로토콜은 당장 내 돈을 환불해라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 12.070
            },
            {
                "speaker_id": "1",
                "transcription": "아유 이걸 맞네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.070,
                "end": 32.780
            },
            {
                "speaker_id": "1",
                "transcription": "야 칼리스토 프로토콜도 생각해 보니까 이거랑 가격이 비슷했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.790,
                "end": 64.645
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 게임 나 페리를 강요하지 않아서 너무 좋아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.655,
                "end": 76.886
            },
            {
                "speaker_id": "1",
                "transcription": "균열 갔어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.896,
                "end": 79.320
            },
            {
                "speaker_id": "1",
                "transcription": "아 점프도 있지 참.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.320,
                "end": 83.890
            },
            {
                "speaker_id": "1",
                "transcription": "점프를 못하는 게임만 하다 보니까 점프 안 되는 게임만 오지게 했거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.900,
                "end": 89.267
            },
            {
                "speaker_id": "1",
                "transcription": "모넘 다크 소울 시리즈 이런 건 점프가 없어가지고 평상시에 다른 점프 있는 게임도 점프를 잘 안 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.277,
                "end": 104.570
            },
            {
