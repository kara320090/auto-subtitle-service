        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 뭐야. 난 그냥 있길래 해본 건데 가뒀어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 22.772
            },
            {
                "speaker_id": "1",
                "transcription": "오 뭐야 나 자신.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.782,
                "end": 31.915
            },
            {
                "speaker_id": "1",
                "transcription": "뿅. 근데 뭔가 숨겨진 도전 과제가 되게 많을 것 같죠. 제대로 못 하고 온 거 같아.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.925,
                "end": 46.817
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 잠수정과 이별을 할 시간이 됐네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.827,
                "end": 57.650
            },
            {
                "speaker_id": "1",
                "transcription": "밧줄을 집고 하는 건 아니겠지?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.660,
                "end": 65.807
            },
            {
                "speaker_id": "1",
                "transcription": "우와우 깡깡 와 여기서 떨어졌는데 안 죽었다고? 바깥에 아저씨가 있는데.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 65.817,
                "end": 77.054
            },
            {
                "speaker_id": "1",
                "transcription": "아저씨랑 힘을 합쳐서 이걸 열어야 되는 거 같아요.",
                "sound_type": [
                    2,
                    5
                ],
