        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키를 키우면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.882
            },
            {
                "speaker_id": "1",
                "transcription": "이 쿠키는 스킬 파우더를 투자를 안해도 되기 때문에 여러분들 여기 신전에다가 BTS 쿠키를 해놓으면은 스킬 파우더 자동으로 올라가기 때문에 스킬 레벨도 걱정 안 해도 되거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.892,
                "end": 12.922
            },
            {
                "speaker_id": "1",
                "transcription": "여기다 놓고 BTS 쿠키를 가장 먼저 키워라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.932,
                "end": 16.537
            },
            {
                "speaker_id": "1",
                "transcription": "그다음 2순위는 제가 생각할 때는 토벌전 생각하면은 목화맛 쿠키도 키워야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.547,
                "end": 22.288
            },
            {
                "speaker_id": "1",
                "transcription": "레벨이 낮더라도 일단은 키우긴 키워야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.298,
                "end": 25.181
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 파우더 자체가 크림 유니콘이랑 겹치지 않기 만약에 여러분들 여유가 없다면은 토벌을 위해서 목화 먼저 키우는 것도 나쁘지가 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.191,
                "end": 34.107
            },
            {
                "speaker_id": "1",
                "transcription": "크림유니콘, 목화, BTS 세 개를 먼저 신경 써서 좀 키워라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.117,
                "end": 38.495
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 여러분들이 생각해야 되는 게 퓨어 바닐라 키워야 되냐는 질문도 있는데 얘는 키우지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.505,
                "end": 45.680
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 파우더도 겹치고 있어서 나중에 사양이 됐을 때 그때 키우면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.680,
                "end": 50.260
            },
            {
                "speaker_id": "1",
                "transcription": "스토리 모드에서는 좋긴 한데 만약에 BTS 쿠키나 목화, 크림 유니콘이 나오지 않는 상태에 초보자분이라면 쓰다가 갈아타시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.270,
                "end": 59.812
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 추가로 더 나오는 허브맛 쿠키나 민트초코, 검블다이버 이런 쿠키들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.822,
                "end": 65.707
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림맛 쿠키 같은 경우에도 얘는 수호 성전에서 쓰이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.717,
                "end": 69.199
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 여유 될 때 키우시고 검블다이버는 완전히 진짜 키우면 안 되는 쿠키로 떨어졌기 때문에 키우지 마시고 민트 초코 같은 경우에는 공속덱에 쓰이기 때문에 나중에 여유 될 때 키우시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.209,
                "end": 81.364
            },
            {
                "speaker_id": "1",
                "transcription": "허브맛 쿠키 같은 경우에는 디버프 제거 때문에 원래 쓰이던 쿠키인데 지금은 거의 아예 안 씁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.374,
                "end": 87.035
            },
            {
                "speaker_id": "1",
                "transcription": "상대가 흑당맛 쿠키 있는 조합일 때 그럴 때 이제 데리고 가는 힐러 조합인데 방덱이 공속 덱이 전멸해 버렸어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.045,
                "end": 94.894
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱, 흑당 덱이 다시 부활하거나 에클레어 덱이 엄청나게 많아질 경우.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.904,
                "end": 100.500
            }
        ]
    },
