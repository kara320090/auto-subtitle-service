    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇게 쭉쭉 가고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.835
            },
            {
                "speaker_id": "1",
                "transcription": "하리 자 56웨이브까지 벌써 왔구요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.845,
                "end": 7.433
            },
            {
                "speaker_id": "1",
                "transcription": "자 벨벳 드래곤도 순삭 쿠키가 너무 쉽게 죽는다 부활이 빠진다 하시면 피감을 높여 주시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.443,
                "end": 14.155
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 중요합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.165,
                "end": 16.185
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 웨이브까지 왔고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.195,
                "end": 17.934
            },
            {
                "speaker_id": "1",
                "transcription": "자 2번덱을 써야 되는데 잘 보세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.944,
                "end": 21.070
            },
            {
                "speaker_id": "1",
                "transcription": "자 어디서 쓰냐 자 이때 자 보스가 보일 때 있죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.080,
                "end": 24.565
            },
            {
                "speaker_id": "1",
                "transcription": "자 저 보일때 교체해 주시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.575,
                "end": 26.733
            },
            {
                "speaker_id": "1",
                "transcription": "살짝 보일 때 저는 살짝 보일 때 교체해 줘서 한 번에 빠르게 클리어 한다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.743,
                "end": 32.653
            },
            {
                "speaker_id": "1",
                "transcription": "자 1분 41초 때 그렇게 클리어에서 기록 경신을 하게 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.663,
                "end": 38.203
            },
            {
                "speaker_id": "1",
                "transcription": "자 순위가 전체 9등이 되고요.",
                "sound_type": [
                    2
                ],
                "start": 38.213,
                "end": 42.103
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 순위 상관없이 최고 보상만 받으면 되니까 네 부상 챙길 수 있도록 이번 시즌 남은 기간 동안 세팅해서 알려드린 대체 쿠키들 넣어서 최고 기록 세우시길 바랍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.113,
                "end": 55.553
            },
            {
                "speaker_id": "1",
                "transcription": "자 궁금한 점이 있다면 댓글에 남겨주시구요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 55.563,
                "end": 58.693
            },
            {
                "speaker_id": "1",
                "transcription": "네 그리고 수호 성적 보상은 정상이 끝나고 하루 지나고 들어오니까 그 점도 참고해 주시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.703,
                "end": 67.065
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 고정댓글에 이벤트 진행 중이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.075,
                "end": 70.506
            },
            {
                "speaker_id": "1",
                "transcription": "자 라이브방송에서 제가 무지개 큐브 3000개의 이벤트 매일 진행하고 있는데 고정 댓글 플레이오 시크릿 코드 입력하신 분들한테 제가 이벤트 무지개 큐브 3000개에 드리고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.516,
                "end": 81.459
            },
            {
                "speaker_id": "1",
                "transcription": "네 고정댓글도 읽어 보시고 참가해 주시면 또 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.469,
                "end": 85.130
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 좋아요 구독 한번씩만 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.140,
                "end": 89.212
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.222,
                "end": 104.900
            }
        ]
    },
    "summary": "마지막 웨이브까지 오면 2번덱을 써야하는데 보스가 보일 때 교체해주면 되고, 빠르게 클리어해 1분 41초에 기록경신을 하게 되어 순위가 9등이 되었고, 고정댓글 이벤트 진행중이니 참가해주세요.",
