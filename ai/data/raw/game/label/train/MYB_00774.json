        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "활용가치가 아직도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.081
            },
            {
                "speaker_id": "1",
                "transcription": "락스타 반드시 키워주면 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.091,
                "end": 4.205
            },
            {
                "speaker_id": "1",
                "transcription": "자 박하 맛 쿠키가 원래는 제가 2티어로 쓰임새가 없다고 되게 혹평을 했던 쿠키인데 이번 업데이트 이후에 크림슨 코랄과 원탱 조합보에서 예 올 아몬드 토핑으로 쓰이는 조합이 생겼습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.215,
                "end": 20.813
            },
            {
                "speaker_id": "1",
                "transcription": "네 이거는 추후에 제가 리뷰하겠지만 현재 1티어로 제가 쓰일 수 있다는 점 예 미리 말씀을 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.823,
                "end": 28.232
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 박하 맛 쿠키 무조건 키워야 되나요는 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.242,
                "end": 31.229
            },
            {
                "speaker_id": "1",
                "transcription": "대체로 파르페로 쓸 수도 있긴 해서 네 박하 맛 쿠키가 쓰임새가 있어졌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.239,
                "end": 37.211
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도만 여러분 일단 알고 계시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.221,
                "end": 39.908
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅 드래곤 절대적인 0티어입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.918,
                "end": 42.847
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 뽑아서 키워주셔야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.857,
                "end": 45.471
            },
            {
                "speaker_id": "1",
                "transcription": "자 초보자 분들은 어디서 뽑냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.481,
                "end": 47.802
            },
            {
                "speaker_id": "1",
                "transcription": "자 설탕 노움 연구소는 쿠키성 레벨 5레벨 달성하면 여기에 스냅 드레곤 뽑기가 활성화됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.812,
                "end": 53.617
            },
            {
                "speaker_id": "1",
                "transcription": "메일 매일 3회 뽑기가 무료가 주어지기 때문에 여기서 뽑아서 키워주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.627,
                "end": 59.028
            },
            {
                "speaker_id": "1",
                "transcription": "자 지금 현재 아레나 판도를 보게 되면 달빛술사, 스타더스트, 블랙펄, 네 이렇게 힐러들은 파르페, 스냅 드레곤 그 다음에 요렇게 아까 말씀드린 것처럼 박하, 바다 요정, 락스타, 용과 드래곤",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.038,
                "end": 72.979
            },
            {
                "speaker_id": "1",
                "transcription": "언급되는 중복되는 쿠키들이 상당히 많이 쓰이고 있기 때문에 여러분들이 선택과 집중으로 네 아레나에서 키워주시면 됩니다.9",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.989,
                "end": 84.366
            }
        ]
    },
    "summary": "박하 맛 쿠키가 업데이트 이후에 크림슨 코랄과 조합이 생겼고 현재 1티어로 쓰일 수 있으며 스냅 드래곤 절대적인 0티어로 반드시 키워야 하며 설탕 노움 연구소에서 스냅 드레곤 뽑기를 할 수 있다.",
