        "term": [
            {
                "speaker_id": "1",
                "transcription": "빠져버렸어 내가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.978
            },
            {
                "speaker_id": "1",
                "transcription": "저 수영해서 오는 거 진짜 무섭다. 그치?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.988,
                "end": 16.444
            },
            {
                "speaker_id": "1",
                "transcription": "어 집착 수준이 장난이 아니네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.454,
                "end": 28.610
            },
            {
                "speaker_id": "1",
                "transcription": "뭘 매달아서 보낼 순 없나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.620,
                "end": 36.557
            },
            {
                "speaker_id": "1",
                "transcription": "이거 한 번 눌러나 보고 싶어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.567,
                "end": 44.634
            },
            {
                "speaker_id": "1",
                "transcription": "누르면 문이 닫히네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.644,
                "end": 46.975
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 내가 겁나 빨리 가서 저걸 누르고 빠져나가서 쟤가 못 따라 오게 만드는 것 같은데 그런 역할을 하는 게 이 위에 있는 이건 거 같거든요. 그 쇠사슬 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.985,
                "end": 69.217
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 수수께끼를 풀어야 돼. 안 그러면 못 가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.227,
                "end": 72.261
            },
            {
                "speaker_id": "1",
                "transcription": "절대 갈 수 없게 해 놓은 거 같아.",
                "sound_type": [
                    2
                ],
                "start": 72.271,
                "end": 75.901
            },
            {
                "speaker_id": "1",
                "transcription": "내가 그러면 여기 아주 끝까지 매달려 볼게 맨 끝에.",
                "sound_type": [
                    2
                ],
                "start": 75.911,
                "end": 80.233
            }
        ]
    },
