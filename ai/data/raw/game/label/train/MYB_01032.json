        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "스타더스트일 경우에는 공격력이 되게 전투력이 되게 높게 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.997
            },
            {
                "speaker_id": "1",
                "transcription": "그때는 제가 또 다른 조합을 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.007,
                "end": 8.382
            },
            {
                "speaker_id": "1",
                "transcription": "네 이거는 가운데에 락스타일 때 그때에 사용하면 좋은 조합이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.392,
                "end": 13.979
            },
            {
                "speaker_id": "1",
                "transcription": "어떨 때에 사용하는지 여러분들 그 구분만 지을 줄 알면은 승률이 거의 뭐 백전백승입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.989,
                "end": 21.243
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 상대가 순삭당한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.253,
                "end": 25.885
            },
            {
                "speaker_id": "1",
                "transcription": "샤이닝글리터가 네 요렇게 한창 블랙펄이 대유행일 때 이런 식으로 잘 활용될 수가 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.895,
                "end": 32.061
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 상대방이 레어 무공비급에 전투력이 좀 더 높죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.071,
                "end": 37.397
            },
            {
                "speaker_id": "1",
                "transcription": "자 이럴 경우에 가운데 락스타가 아닐 경우도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.407,
                "end": 40.829
            },
            {
                "speaker_id": "1",
                "transcription": "이럴 때 스낵 드래곤 대신 블랙펄 쿠키를 넣어서 가는 극딜 조합도 소개해 드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.839,
                "end": 47.264
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타가 올 쿨이고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.274,
                "end": 49.471
            },
            {
                "speaker_id": "1",
                "transcription": "자 레모네이드는 동일하게 올 라즈 쿨 높게 8퍼센트 이상 네 샤이닝글리터는 상대방이 전투력이 높게 되면은 극딜이 오면 요렇게 올 라즈 하면은 샤글이 죽는 경우가 있기 때문에 아몬드 4개 그다음에 라즈베리 섞어서 3초 2.8퍼센트 이상 만들어주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.481,
                "end": 67.161
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄은 세트 효과 포함해서 쿨 21퍼센트 만들어 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.171,
                "end": 70.967
            },
            {
                "speaker_id": "1",
                "transcription": "자 호루라기는 레모네이드랑 네 블랙펄 쪽으로 받게 될 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.977,
                "end": 75.733
            }
        ]
    },
    "summary": "한 남성이 게임 시에 조합을 어떤 경우에 사용하는지 그 구분만 지을 줄 알면 승률은 거의 백전백승이라고 이야기하며 락스타, 레모네이드, 샤이닝글리터, 블랙펄 조합에서 세팅해야 할 부분에 대해서 설명을 한 후 마지막으로 호루라기는 레모네이드와 블랙펄 쪽으로 받게 된다고 이야기한다.",
