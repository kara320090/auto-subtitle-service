        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 이거 아 아 덱 바꾸셨구나 와베로.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.903
            },
            {
                "speaker_id": "1",
                "transcription": "실론 한방덱이 나왔는데 그걸 막는 와베가 나왔어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.913,
                "end": 6.757
            },
            {
                "speaker_id": "1",
                "transcription": "창과 방패가 그냥 동시에 나왔는데 그니까 세팅을 알려드리면은 무공비, 호루라기, 깃털입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.767,
                "end": 13.516
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기는 여러분들이 세팅할 때 블랙펄하고 캡틴한테 받으면 되고 실론 나이트는 뭐 쿨없이 그냥 공속 좀 높게 피감 도넛은 쿨만 여러분들 2.8 이상 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.526,
                "end": 26.107
            },
            {
                "speaker_id": "1",
                "transcription": "올 아몬드 캡틴은 피감 없이 공치 위주로 그다음에 오먹은 3아몬드 2라즈 그다음에 블랙펄은 3애플젤리 2라즈",
                "sound_type": [
