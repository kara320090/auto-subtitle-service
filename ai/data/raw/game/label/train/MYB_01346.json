        "term": [
            {
                "speaker_id": "1",
                "transcription": "딴 거로 가 볼까 여러분들?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.289
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이번 덱은 요거 샤글 넣어서 한번 가 보도록 할게요. 출발.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.299,
                "end": 7.360
            },
            {
                "speaker_id": "1",
                "transcription": "네, 시간 단축되는지 볼게요. 샤 샤글 넣었을 때 단축되는지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.380,
                "end": 12.860
            },
            {
                "speaker_id": "1",
                "transcription": "단축의 의미가 뭐냐고요? 기록이 짧아지는 걸 말하는 거죠. 시간이 짧아지는 거 기록을 좀 시간을 줄이는 거 말하는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.860,
                "end": 23.960
            },
            {
                "speaker_id": "1",
                "transcription": "야 샤글 좋은데? 나만 좋아 보이냐 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.960,
                "end": 29.133
            }
        ]
    },
    "summary": "샤글 넣어서 한번 게임을 해보겠다.",
