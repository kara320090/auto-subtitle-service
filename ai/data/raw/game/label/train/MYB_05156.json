                    5
                ],
                "start": 11.762,
                "end": 18.448
            },
            {
                "speaker_id": "1",
                "transcription": "전투 구역마다 5번의 도전 모두 실패하거나 전투를 포기하면 내구도가 더 많이 소모된다.",
                "sound_type": [
