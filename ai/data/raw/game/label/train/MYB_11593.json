                ],
                "start": 1.223,
                "end": 6.931
            },
            {
                "speaker_id": "1",
                "transcription": "우와. 와 이러니까 사람들이 하는구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.941,
                "end": 12.096
            },
            {
                "speaker_id": "1",
                "transcription": "패링 합니다 패링 할게 나 패링 할게.",
