                    5
                ],
                "start": 12.106,
                "end": 18.518
            },
            {
                "speaker_id": "1",
                "transcription": "절로 온 줄 알고 죽이러 갈 뻔했네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.528,
                "end": 21.139
            },
            {
