        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이거 진짜 게임 잘 만들었다. 근데 진짜 재미있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.220
            },
            {
                "speaker_id": "2",
                "transcription": "웬만한 사람 놀리는 거랑은 비교가 안 되지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.230,
                "end": 6.443
            },
            {
                "speaker_id": "1",
                "transcription": "네 아 말 거시는 바람에 잘못 했잖아요 지금.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.453,
                "end": 11.454
            },
            {
                "speaker_id": "1",
                "transcription": "말을 거시는 바람에 그래도 고마워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.464,
                "end": 13.524
            },
            {
                "speaker_id": "1",
                "transcription": "바지락칼국수 님 다시 보여드리겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.534,
                "end": 16.036
            },
            {
                "speaker_id": "1",
                "transcription": "나는 이거 하고 있으면서 나도 리뷰 남기면 커피 쿠폰 주나 이러고 앉아 있어 내 손 어디 있어요?",
                "sound_type": [
                    2,
                    3
                ],
