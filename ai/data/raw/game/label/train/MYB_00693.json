    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 다음 쿠키런 킹덤 업데이트 관련된 내용이 유출이 되었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.566
            },
            {
                "speaker_id": "1",
                "transcription": "자 공식 카페 @이름1님이 올리신 내용 보게 되면 자 요렇게 신규 쿠키 에픽의 모습과 네 이름은 바스크치즈맛 쿠키라고 하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.576,
                "end": 16.409
            },
            {
                "speaker_id": "1",
                "transcription": "네 바스크 치즈는 뭐 요렇게 생긴 케이크라고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.419,
                "end": 20.643
            },
            {
                "speaker_id": "1",
                "transcription": "자 전문적으로 유출하는 분은 @이름2이 신데 자 보게 되면 에피소드 17이 나오고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.653,
                "end": 27.557
            },
            {
                "speaker_id": "1",
                "transcription": "메인 스토리 그리고 바스크치즈맛 쿠키, 페투치니맛 쿠키 이렇게 에픽 2개가 새롭게 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.567,
                "end": 33.792
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 자 심지어 스킬 내용까지 이렇게 유출이 되어 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.802,
                "end": 38.467
            },
            {
                "speaker_id": "1",
                "transcription": "자 신규 쿠키들의 스킬 내용을 잠깐 같이 보게 되면 스킬 사용하면은 스텝과 함께 가장 가까운 적을 공격해서 대미지를 입히고 대미지의 레지스트를 무효화하는 디버프 적용한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.477,
                "end": 50.446
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 땅속에서 모래를 불러내 최고 공격력을 가진 적 2명을 완전히 감싸고 여러 번 피해 입히고 공격력 감소시키는 이렇게 디버프도 있다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.456,
                "end": 61.313
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 대상이 현재 보유하고 있는 버프 수에 비례해서 또 증가하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.323,
                "end": 66.104
            },
            {
                "speaker_id": "1",
                "transcription": "자 요러고 모래 폭풍이 가라앉으면은 번트 치즈 쿠키가 공격력이 가장 높은 두 아군에게 먼지 방패 던진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.114,
                "end": 72.694
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 내용이 뭐 100퍼센트 완벽하게 일치해서 나오는 건 아닌데 대부분 이런 내용이 일치해서 나오는 경우도 많이 있었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.704,
                "end": 79.960
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 또 보게 되면 7개의 불타는 빛의 화살을 불러와서 가장 가까운 적에게 피해를 입힌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.970,
                "end": 86.629
            },
            {
                "speaker_id": "1",
                "transcription": "자 화상 입히고 그들이 받는 파이어형 대미지 증폭하는 디버프도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.639,
                "end": 90.942
            },
            {
                "speaker_id": "1",
                "transcription": "자 해당 스킬과 함께 골든 치즈 쿠키 랜드를 강타할 때마다 스택을 쌓아서 스킬 향상시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.952,
                "end": 97.157
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 골든 치즈는 바스크 치즈와 함께 다음 업데이트 출시할 것으로 보이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.167,
                "end": 102.800
            },
            {
                "speaker_id": "1",
                "transcription": "페투치네는 2부에 그리고 또 다른 무명의 쿠키는 3부에 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.810,
                "end": 107.969
            },
            {
                "speaker_id": "1",
                "transcription": "자 아무튼 이렇게 유출이 구체적으로 나오는 거 보면은 뭐 골드치즈가 나오는 거는 기정사실이 된 느낌이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 107.979,
                "end": 115.681
            },
            {
                "speaker_id": "1",
                "transcription": "자 이미 제가 예전에 올렸지만 자 골든치즈는 최후의 전투에서도 스킬 모션이 좀 더 빛이 반짝이는 모습으로 스킬 이펙트도 바뀌었으니까 여러분들이 최후의 전투에서 바뀐 모습을 직접 보실 수도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 115.691,
                "end": 130.868
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트는 언제 하냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 130.878,
                "end": 132.984
            },
            {
                "speaker_id": "1",
                "transcription": "지금 뭐 예상하는 거는 9월 26일이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 132.994,
                "end": 136.085
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 얘기가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 136.095,
                "end": 137.499
            },
            {
                "speaker_id": "1",
                "transcription": "그날 복귀를 하셔도 좋을 거 같고 지금 아레나 메타상에 골드치즈가 나온다면은 이 물속성 덱이 엄청난 강세를 보이고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 137.509,
                "end": 146.875
            },
            {
                "speaker_id": "1",
                "transcription": "새로운 속성이 나오던가 기존의 물속성과 같이 어울려서 쓰게 된다면 또 아레나 티어도 엄청나게 뒤바뀔 가능성도 큽니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 146.885,
                "end": 155.908
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저한테 댓글에 물어보신 분들이 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 155.918,
                "end": 158.960
            },
            {
                "speaker_id": "1",
                "transcription": "골드치즈를 존버할까요 아니면 신규 쿠키를 뽑아야 될까요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 158.970,
                "end": 162.767
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 저도 확답을 못 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 162.777,
                "end": 164.897
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 쿠키런 킹덤은 아레나 티어나 쿠키 티어가 업데이트 한 번으로 완전히 뒤바뀌는 경우가 너무나 많아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 164.907,
                "end": 172.349
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 저도 뭐 운영자가 아니기 때문에 정확한 예측을 할 수 없고 여러분들이 골드치즈 업데이트에 맞춰서 크리스탈 한 번에 쓰겠다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 172.359,
                "end": 180.731
            },
            {
                "speaker_id": "1",
                "transcription": "하시면 그때 맞춰서 키우면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 180.741,
                "end": 182.959
            },
            {
                "speaker_id": "1",
                "transcription": "현재 상황으로는 박하사탕, 해파리 둘 다 아레나에서 중요하게 쓰이고 있는 상황이기는 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 182.969,
                "end": 189.046
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아예 뽑지 않는 것보다는 최소한 명함이라도 따서 완품으로 가지고 있는 게 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 189.056,
                "end": 197.145
            },
            {
                "speaker_id": "1",
                "transcription": "자 요러고 제 유튜브에 가면은 쿠키 티어 그리고 초보자분들 복귀자분들 가이드뿐만 아니라 다양한 팁 영상도 있으니까 그거 보고 참고해 보시고 궁금한 사항이 있다면 댓글에 남겨주시면 제가 답글을 남겨 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 197.155,
                "end": 211.814
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 골드치즈 나오면 당연히 광산 콘텐츠도 나올 가능성이 크기 때문에 기대가 정말 많이 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 211.824,
                "end": 218.199
            },
            {
                "speaker_id": "1",
                "transcription": "한번 다음 업데이트 미리 기대를 좀 크게 해 보도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 218.209,
                "end": 223.457
            },
            {
                "speaker_id": "1",
                "transcription": "자 구독 안 눌러 주신 분들 있으시면 구독 한 번씩만 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 223.467,
                "end": 227.627
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 227.637,
                "end": 244.393
            }
        ]
    },
    "summary": "남성이 쿠키런 킹덤의 골드 치즈와 신규 쿠키 정보 유출사태에 대한 업데이트 내용이 유출되었으며, 신규 쿠키인 바스크치즈맛 쿠키와 골드치즈 쿠키가 등장할 것으로 예상되는데 업데이트 예상일은 9월 26일로 추정되며, 골드치즈 쿠키는 아레나 메타에 영향을 미칠 것으로 보이며 골드치즈 쿠키의 등장으로 광산 콘텐츠도 예상되며, 다음 업데이트를 기대한다고 한다.",
