                    2,
                    5
                ],
                "start": 3.276,
                "end": 6.393
            },
            {
                "speaker_id": "1",
                "transcription": "달빛이여 내 활이 되어주렴",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.403,
                "end": 8.991
            },
            {
                "speaker_id": "3",
                "transcription": "야 이게 맞죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.001,
                "end": 10.096
            },
            {
                "speaker_id": "3",
                "transcription": "아까랑 완전 180도 다르잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.106,
                "end": 13.389
            },
            {
                "speaker_id": "1",
                "transcription": "달빛이여 내 활이 되어",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.399,
                "end": 15.947
            },
            {
                "speaker_id": "3",
                "transcription": "만약에 주스덱 쓸거면 이걸로 하세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.957,
                "end": 19.537
            },
            {
                "speaker_id": "3",
                "transcription": "주스덱 여러분들 무에 원탱으로 쓰실 거면 캡사이신 없이 홀리베리는 그냥 쿨 높게 여러분 능력에 맞게 해주시면 될 것 같고 얘는 올 아몬드 쿨 그냥 여러분들 능력껏 이렇게 해서 피감 쓰시고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.547,
                "end": 33.305
            },
            {
                "speaker_id": "3",
                "transcription": "얘는 올 애플젤리도 쿨 높게 하시면 좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.315,
                "end": 37.111
            },
            {
                "speaker_id": "3",
                "transcription": "달빛은 쿨 22에다가 올 쿨 그 다음에 퓨바는 4아몬드 1쿨 이렇게 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.121,
                "end": 42.707
            },
            {
                "speaker_id": "3",
                "transcription": "만약에 하실 거면 이렇게 그 다음에 아까 원했데 게 요거 거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.717,
                "end": 47.320
            },
            {
                "speaker_id": "3",
                "transcription": "요것도 한번 보여드릴게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.330,
                "end": 49.426
            },
            {
                "speaker_id": "3",
                "transcription": "쿠키 속성은 공식 카페 가면은 어떤 게 속성으로 되어 있는지 이번에 공식 패치 노트에 있어요.",
