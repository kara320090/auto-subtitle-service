        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라 그리고 재화 같은 경우에는 요런 이미지가 되어 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.842
            },
            {
                "speaker_id": "1",
                "transcription": "네 출석 보상은 다크 초코로 되어 있고요 이벤트도 이렇게 다르다 자 토벌 같은 경우에는 벨벳드래곤 용 하나만 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.842,
                "end": 13.031
            },
            {
                "speaker_id": "1",
                "transcription": "자 토벌기록로 뭐 이렇게 되어 있고요 예 아레나도 정말 기본 쿠키들이 되어있는 걸 볼 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.041,
                "end": 21.887
            },
            {
                "speaker_id": "1",
                "transcription": "기본 쿠키들로 전투가 되어있고 2배속까지 되어 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.897,
                "end": 25.412
            },
            {
                "speaker_id": "1",
                "transcription": "자 간단한 이벤트 일정도 봅시다 뭐 다양한 이벤트가 진행 중이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.627,
                "end": 31.060
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상은 좀 짧지만 제가 말하고 싶은 점이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.070,
                "end": 34.687
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 친구가 도와주기 기능 이거 반드시 우리나라 킹덤에서도 반드시 나왔으면 하는 업데이트입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.685,
                "end": 42.462
            },
            {
                "speaker_id": "1",
                "transcription": "가뜩이나 생산에 대해서 스트레스 많이 받는 분들 때문에 접는 사람도 있거든요 그래서 반드시 업데이트 됐으면 좋겠고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.462,
                "end": 49.737
            },
            {
                "speaker_id": "1",
                "transcription": "퀼이나 이런 거는 각자 뭐 호불호가 있으니까 꼭 나와야 된다 이런 생각은 아니지만 좋은 기능 편의 기능 2배속 기능이나 이런 거는 출시가 됐으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.737,
                "end": 61.344
            },
            {
                "speaker_id": "1",
                "transcription": "중국 서버 어떻게 하나요라고 생각하시는 분들 있을 텐데 지금은 네 따로 할 수 있는 방법은 저도 알아보고는 있고 나중에 추후에 할 수 있는 방법을 알게 되면은 제가 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.354,
                "end": 74.967
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 이벤트 있습니다 읽어보시고 많이 참여해 주시면 감사합니다.",
