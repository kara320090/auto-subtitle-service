                    3
                ],
                "start": 1.832,
                "end": 11.054
            },
            {
                "speaker_id": "1",
                "transcription": "자 다크 초코 뽑아버렸고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.064,
                "end": 22.176
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 무지개 큐브 가지고 계신 분들 이거 스킨 뽑기에 무큐 많이 쓸 것 같은데요 중복 없이 좀 뽑을라면요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.186,
                "end": 32.741
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 야 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.751,
                "end": 39.641
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐만 저 다 뽑았나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.651,
                "end": 41.274
            },
            {
                "speaker_id": "1",
                "transcription": "끝 야 졸업이야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.284,
                "end": 42.876
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 왜 이렇게 빨리 뽑은 것 같냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.886,
                "end": 44.425
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음 갈게요.",
