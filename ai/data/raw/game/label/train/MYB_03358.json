                ],
                "start": 0.000,
                "end": 1.822
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 제발 노 중복 야 이거 중복 아니게 뽑기 힘드네요 상당히.",
                "sound_type": [
