        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 빙결 아오 야 저걸 다 사시네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.490
            },
            {
                "speaker_id": "1",
                "transcription": "너무 센 거 아닙니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.500,
                "end": 17.631
            },
            {
                "speaker_id": "1",
                "transcription": "아 저거 만약에 터졌으면은 내가 이겼을 수도 있겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.641,
                "end": 21.803
            },
            {
                "speaker_id": "1",
                "transcription": "순간 되게 피 적을 때가 있었거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.813,
                "end": 24.104
            },
            {
                "speaker_id": "1",
                "transcription": "어 저때를 넘겼으면은 좋은데 자 이와 같이 이 덱은 만능 무적이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.114,
                "end": 31.528
            },
            {
                "speaker_id": "1",
                "transcription": "상대방이 소르베랑 서리가 있을 때는 상성상 약한 거 같아요 확실히.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.538,
                "end": 37.458
            }
        ]
    },
    "summary": "저때를 넘겼으면 내가 이겼을 수도 있고 이 덱은 상대방이 소르베랑 서리가 있을 때는 약한 것 같다.",
