                    4,
                    5
                ],
                "start": 4.569,
                "end": 14.953
            },
            {
                "speaker_id": "1",
                "transcription": "네 그러고 네 에클레어 먼저 써 주시구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 14.963,
                "end": 20.685
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 노란불 다음에 빨간불 되거든요?",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 20.695,
                "end": 23.362
            },
            {
                "speaker_id": "1",
                "transcription": "이때 밀키를 써 줘야 됩니다.",
