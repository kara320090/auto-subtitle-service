    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "요즘 출시되는 수많은 모바일 게임들은 치열한 경쟁 속에서 과금을 유도하거나 그 경쟁에 살아남지 못하면 게임에 흥미를 잃어버리는 경우가 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.284
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 마이힐링타운 게임은 내가 들어가서 투자한 시간만큼 힐링 할 수 있고 자신만의 꾸미기 세계를 만들 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.294,
                "end": 22.101
            },
            {
                "speaker_id": "1",
                "transcription": "다양한 미니게임 이벤트도 매주 새롭게 열립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.111,
                "end": 25.080
            },
            {
                "speaker_id": "1",
                "transcription": "떨어진 지점을 투명한 다리를 놓아서 건너가는 브릿지 미니게임 같은 종류의 식물을 점점 키워나가는 드림가든, 같은 모양을 맞춰서 터뜨리면서 풀어가는 퍼즐게임과 다양한 물고기를 낚는 낚시게임 등 다양한 미니게임이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.090,
                "end": 39.453
            },
            {
                "speaker_id": "1",
                "transcription": "혼자만의 게임이 싫다면 다양한 축제와 파티 이벤트도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.463,
                "end": 43.315
            },
            {
                "speaker_id": "1",
                "transcription": "축제 상자 파밍에서는 최고급 동물 뽑기와 다양한 아이템 파밍이 가능하고 파티를 통해서는 행상에 필요한 다양한 요리와 원재료 파밍이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.325,
                "end": 52.744
            },
            {
                "speaker_id": "1",
                "transcription": "자기 자신만의 도시 왕국 꾸미기를 하기 부족하다면 길드 개념의 가족에서도 왕국 꾸미기가 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.754,
                "end": 58.743
            },
            {
                "speaker_id": "1",
                "transcription": "다양한 컨셉으로 가능하며 길드 버프를 받아서 영토를 더 크게 확장도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.753,
                "end": 64.872
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 꾸미기에 좀 더 관심이 있는 분이라면 연출 효과를 이와 같이 거품이 올라가는 효과도 가능하며 꽃이 날리는 등 원하는 연출도 맞춤으로 화려하게 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.882,
                "end": 74.950
            },
            {
                "speaker_id": "1",
                "transcription": "입체적인 왕꾸도 다양하게 원하는 대로 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.960,
                "end": 78.847
            },
            {
                "speaker_id": "1",
                "transcription": "무엇보다 제가 이 게임을 추천하는 이유는 치열하게 싸우는 요소가 없어서 스트레스가 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.857,
                "end": 84.651
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 소소하게 즐기면서 일일퀘스트나 미션으로 받는 보상으로도 충분히 많은 재화가 쌓입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.661,
                "end": 91.123
            },
            {
                "speaker_id": "1",
                "transcription": "서버 선택은 왼쪽 상단 프로필 선택 후 계정 관리를 누르면 계정 연동이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.133,
                "end": 97.190
            },
            {
                "speaker_id": "1",
                "transcription": "계정 연동 후 서버 선택을 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.200,
                "end": 99.588
            },
            {
                "speaker_id": "1",
                "transcription": "다양한 이벤트와 미니게임 그리고 왕국 꾸미기까지 같이 힐링 게임 하실 분 게임 다운로드 링크는 고정 댓글을 참고해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.598,
                "end": 107.545
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 107.555,
                "end": 112.866
            }
        ]
    },
    "summary": "수많은 모바일 게임들은 치열한 경쟁 속에서 과금을 유도하거나 그 경쟁에 살아남지 못하면 게임에 흥미를 잃어버리는 경우가 많은데 마이힐링타운은 투자한 시간만큼 힐링 할 수 있고 자신만의 꾸미기 세계를 만들 수 있고 다양한 미니게임 이벤트도 매주 새롭게 열린다.",
