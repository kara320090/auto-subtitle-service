        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 알아서 공격해 주는 거였군.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.235
            },
            {
                "speaker_id": "1",
                "transcription": "회피 해주 알아서 회피해 주는 게 있고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.245,
                "end": 5.017
            },
            {
                "speaker_id": "1",
                "transcription": "포션을 자동으로 먹어주는 게 있네요. 와 좋네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.027,
                "end": 7.862
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 끼고 하면은 이제 방송이 노잼되니까 이건 끼지 말아야겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.872,
                "end": 12.189
            },
            {
                "speaker_id": "1",
                "transcription": "지금도 약간 살짝 그런 느낌이지만.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.199,
                "end": 15.868
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 스토리만 볼 거니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.878,
                "end": 19.400
            }
        ]
    },
    "summary": "자동으로 회피하거나 포션을 먹어주는 게 있지만 그걸 끼면 방송이 노잼되니까 끼지 않고 할 것이다.",
