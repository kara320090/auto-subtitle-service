        "term": [
            {
                "speaker_id": "1",
                "transcription": "일단 이 분 아직 5초월을 레전드 고대 슈퍼 에픽이 다 아니시기 때문에 나오면 다 스펙이 5초월까지 스펙이 다 되는 거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.132
            },
            {
                "speaker_id": "1",
                "transcription": "자 다 전부 다 스킵으로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.142,
                "end": 12.681
            },
            {
                "speaker_id": "1",
                "transcription": "이거 너무나 뽑기 분량이 많아서 전부 다 스킵으로 진행하도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.691,
                "end": 17.493
            },
            {
                "speaker_id": "1",
                "transcription": "최소 2성은 만들어야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.503,
                "end": 19.332
            },
            {
                "speaker_id": "1",
                "transcription": "최소 3성 만들어 드릴게요.",
