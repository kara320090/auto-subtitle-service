        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 마이힐링타운 모바일 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.767
            },
            {
                "speaker_id": "1",
                "transcription": "이번 영상에서는 동물들을 어떻게 활용하는지 동물들을 어떻게 뽑는지 그리고 어디서 어떤 컨텐츠에 쓰이는지 그거에 대해서 자세히 좀 알아보도록 할 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.777,
                "end": 17.901
            },
            {
                "speaker_id": "1",
                "transcription": "그 전에 이 게임을 처음 접하는 분들 이 게임은 간략하게만 말씀드리면 기본적으로 꾸미기 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.911,
                "end": 24.642
            },
            {
                "speaker_id": "1",
                "transcription": "영토 확장을 이쪽 그리고 바다쪽 2가지 전체적으로 할 수가 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.652,
                "end": 29.308
            },
            {
                "speaker_id": "1",
                "transcription": "또한 길드 개념에 가족이라는 게 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.318,
                "end": 32.706
            },
            {
                "speaker_id": "1",
                "transcription": "가족으로 사람들이 모여서 이렇게 버프를 같이 이렇게 올릴 수도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.716,
                "end": 37.638
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 가족 단위로 꾸미기를 할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.648,
                "end": 40.576
            },
            {
                "speaker_id": "1",
                "transcription": "영토가 가족마다 각각 개개인마다 주어지는데 이거를 4명이서 합칠 수도 있고 아니면은 각각 따로 꾸밀 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.586,
                "end": 49.171
            },
            {
                "speaker_id": "1",
                "transcription": "또한 집 내부를 꾸미고 싶어요 하시는 분들 내부도 이렇게 따로 꾸밀 수 있다는 점 자 이렇게 자기 자신만의 가족 왕꾸도 하트 모양이라던지 입체적으로 예쁘게 꾸밀 수도 있습니다.",
