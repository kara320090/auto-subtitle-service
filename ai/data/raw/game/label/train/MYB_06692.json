        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐라고 말하지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.769
            },
            {
                "speaker_id": "1",
                "transcription": "아 레나 PTSD 진짜.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.779,
                "end": 5.462
            },
            {
                "speaker_id": "1",
                "transcription": "버릴 수 없었어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.472,
                "end": 7.081
            },
            {
                "speaker_id": "2",
                "transcription": "제길 이놈이고 저놈이고 내 의사는 묻지도 않고 죽으면 해제되나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.091,
                "end": 14.278
            },
            {
                "speaker_id": "2",
                "transcription": "그렇다면 스스로 목숨을 끊겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.288,
                "end": 16.194
            },
            {
                "speaker_id": "3",
                "transcription": "주박은 영혼에 새겨집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.204,
                "end": 18.026
            },
            {
                "speaker_id": "3",
                "transcription": "부활 마법은 육체의 수복에만 관여할 뿐입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.036,
                "end": 20.747
            },
            {
                "speaker_id": "2",
                "transcription": "제기랄 알겠냐 일단 같이 동행해 주겠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.757,
                "end": 24.620
            },
            {
                "speaker_id": "4",
                "transcription": "버릴 수 없었어 종량제 봉투가 없었거든.",
