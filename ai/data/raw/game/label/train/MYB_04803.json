        "term": [
            {
                "speaker_id": "1",
                "transcription": "저 토핑을 받고 6강짜리를 이제 12강으로 강화를 하려고 할 텐데 중요한 점이 하나 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.630
            },
            {
                "speaker_id": "1",
                "transcription": "초보자분들이 가장 실수 많이 하는 부분을 하나 언급해 드리면은 이 쿠키런 킹덤은 초보자분들은 쿠키성 레벨을 12랩까지 빨리 올려야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.630,
                "end": 14.052
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 생산 건물이 많이 늘어나고 그다음에 테크가 올라가면 쿠키하우스 개수도 늘릴 수 있고 다양한 테크도 올릴 수 있어서 쿠키하우스가 절대적으로 레벨 올리는 게 중요하기 때문에 여러분들이 저 강화를 무리하게 진행하다가 코인 부족해서 발전이 늦어지는 경우가 많기 때문에 절대 12강까지 막 하지 마시고 어느 정도 쿠키성 레벨 올린 다음에 나머지 12강 하는 것을 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.052,
                "end": 36.860
            },
            {
                "speaker_id": "1",
                "transcription": "코인 부족한 분들은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.860,
                "end": 38.040
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 피해감소 5퍼센트랑 쿨타임 1.6퍼센트로 받게 되는데 그 이외에 추가로 붙으면 좋은 거는 전 개인적으로 이제 공격력이나 공격속도도 망토보물 적용받기 위해서 좀 많이 쓰이기 때문에 이런 거 붙으면 되게 좋다 치명타 확률이나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.040,
                "end": 53.887
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 토핑작같은 경우에는 월드탐험에서 여러분들이 여기 13스테이지까지 오신분들은 여기서 토핑작을 해가지고 강화를 더 하셔도 되고 아니면 월드탐험 유일하게 버그 자리가 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.887,
                "end": 66.272
            },
            {
                "speaker_id": "1",
                "transcription": "8 다시 29가면은 아몬드랑 라즈가 동시에 나오는 자리가 하나있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.272,
                "end": 70.175
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 토핑작을 하거나 8 다시 25에서 쿨토핑작을 하거나 이건 여러분들 선택사항으로 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.175,
                "end": 78.366
            }
        ]
    },
    "summary": "쿠키런 킹덤은 초보자분들이 쿠키성 레벨을 12랩까지 빨리 올리는 게 중요하다고 얘기하고 있고 월드탐험에 유일하게 버그 자리가 있다고 얘기해 주고 있습니다.",
