                "end": 5.861
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 늦게 해주시는 게 좋아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.871,
                "end": 7.864
            },
            {
                "speaker_id": "1",
                "transcription": "네 저는 최대한 능력껏 늦게 해 주시는 게 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.874,
                "end": 11.249
            },
            {
                "speaker_id": "1",
                "transcription": "자 지금 보면 제가 녹았죠?",
