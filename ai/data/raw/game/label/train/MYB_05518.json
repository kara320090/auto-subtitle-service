        "term": [
            {
                "speaker_id": "1",
                "transcription": "그다음에 가운데 새로 나온 신규 보슨데 이거는 일단 최적화된 빌드 조합이 나오긴 했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.638
            },
            {
                "speaker_id": "1",
                "transcription": "보물은 이렇게 무공비, 낫, 시계 이렇게 되어 있고 조합은 이렇게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.648,
                "end": 12.236
            },
            {
                "speaker_id": "1",
                "transcription": "석류 올 쿨 22.3퍼센트 이상 그다음에 오이스터는 29.3퍼센트 이상 세트 효과 포함해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.246,
                "end": 18.355
            },
            {
                "speaker_id": "1",
                "transcription": "벚꽃은 쿨타임 8퍼센트 근처가 핵심이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.365,
                "end": 21.551
            },
            {
                "speaker_id": "1",
                "transcription": "호일이랑 뱀파는 최대한 공치 높게 세팅을 해 주시면 되고 연습하기로 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.561,
                "end": 27.644
            },
            {
                "speaker_id": "1",
                "transcription": "오이스터 먼저 예약을 눌러줘요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 27.654,
                "end": 30.016
            },
            {
                "speaker_id": "1",
                "transcription": "오이스터 눌러주고 쭉 갑니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 30.026,
                "end": 33.784
            },
            {
                "speaker_id": "1",
                "transcription": "가서 맨 처음에 석류 먼저 눌러주고 그다음에 이 벚꽃을 여기 보면 파란 색깔 라인 있죠 요 파란 색깔 요 라인 요 파란 색깔 라인",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 33.794,
                "end": 44.376
            },
            {
                "speaker_id": "1",
                "transcription": "여기 맞춰서 벚꽃을 여기서 써 줍니다.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 44.386,
                "end": 46.594
            },
            {
                "speaker_id": "1",
                "transcription": "네 그다음에 호밀이랑 뱀파 그 눌러주면 돼요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 46.604,
                "end": 49.619
            },
            {
                "speaker_id": "1",
                "transcription": "그 뱀파는 좀 늦게 눌러주면 좋다고 합니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 49.629,
                "end": 52.733
            }
        ]
    },
