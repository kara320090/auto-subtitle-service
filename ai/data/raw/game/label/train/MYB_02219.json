        "term": [
            {
                "speaker_id": "1",
                "transcription": "다른 쿠키 다 만렙을 찍을 수 있을 정도야 10만 원이면.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.566
            },
            {
                "speaker_id": "1",
                "transcription": "내가 킹덤 출시날 100만 원 과금합니다 해가지고 준비를 딱 해왔는데 100만 원 가지고 뭐 스펙업 하지도 못해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.576,
                "end": 10.778
            },
            {
                "speaker_id": "1",
                "transcription": "뽑기 뭐 하지도 못하고 몇 개 뽑으니까 다 끝나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.788,
                "end": 13.847
            },
            {
                "speaker_id": "1",
                "transcription": "그때 느꼈지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.857,
                "end": 14.807
            },
            {
                "speaker_id": "1",
                "transcription": "야 이건 100만 원은 진짜 애들 장난이구나 킹덤에서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.817,
                "end": 18.140
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 킹덤은 첫날부터 진짜 존재감을 드러내려는 정도의 과금을 하려면은 정확히 2000만 원 정도 들어갔어야 됐어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.150,
                "end": 27.664
            },
            {
                "speaker_id": "1",
                "transcription": "누가 봐도 랭커가 될 수 있는 딱 그 자세가 나오는 게 2000만 원 정도였거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.674,
                "end": 32.820
            },
            {
                "speaker_id": "1",
                "transcription": "한 자 소르베 여러분들 한 한 마리 더 추가 야 뭐야 소르베 타이밍이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.830,
                "end": 38.732
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베 하나 더 추가 많이 뽑았다 생각했는데 50만 개 남았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.742,
                "end": 44.413
            },
            {
                "speaker_id": "1",
                "transcription": "그리고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.423,
                "end": 46.200
            }
        ]
    },
    "summary": "화자가 첫날부터 랭커가 될 수 있는 과금은 2000만 원 정도라고 한다.",
