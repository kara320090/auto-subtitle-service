        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 좀 있다 울 거냐고요 아니요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.351
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 울 일 없을 것 같은데 잘 모르겠다.",
