    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "딜 폭사 때문에 기존 한방덱은 애매하게 지는 그림도 나오지만 확실하게 이렇게 과전류 한방덱은 100퍼센트 이기는 그림이 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.345
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 대표적인 방덱. 홀, 용, 스, 달, 스 이거 많이 보이고 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.355,
                "end": 14.539
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱도 아주 잘 잡습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.549,
                "end": 16.608
            },
            {
                "speaker_id": "1",
                "transcription": "일단 무공비급의 홀용스달스 그리고 레어 무공비급일 때도 저는 공속 보물로 가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.618,
                "end": 23.943
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 2힐러가 아닌 이상 순식간에 잡아버리는 모습.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.953,
                "end": 32.940
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 실론나이트가 먼저 죽으면 뒤에 있는 쿠키들의 피감을 살짝 더 낮추거나 조금 더 조정해서 실론나이트보다는 먼저 죽게끔 세팅을 해주시면 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.950,
                "end": 46.716
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나게 화력이 좋은 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.726,
                "end": 50.341
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 조심해야 될 덱이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.351,
                "end": 53.050
            },
            {
                "speaker_id": "1",
                "transcription": "그게 바로 뭐냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.060,
                "end": 54.070
            },
            {
                "speaker_id": "1",
                "transcription": "원탱덱일 때 여러분 무지성으로 가면 절대 안 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.060,
                "end": 57.535
            },
            {
                "speaker_id": "1",
                "transcription": "가운데가 락스타가 보이면 웬만해서는 가지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.545,
                "end": 61.857
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 뒤에 가려진 게 스냅드래곤이면 2힐덱일 수가 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.867,
                "end": 65.670
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때 막힐 가능성이 크고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.680,
                "end": 67.478
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 뒤에 이렇게 두 개가 가려졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.488,
                "end": 70.270
            },
            {
                "speaker_id": "1",
                "transcription": "락스타가 가운데 있으면 과전류 덱일 때 절대 가면 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.280,
                "end": 73.526
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 앞에 실론나이트를 저격해서 실론나이트만 먼저 사라지게 만들기 때문에 필패합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.536,
                "end": 79.697
            },
            {
                "speaker_id": "1",
                "transcription": "락스타가 보이면 가지 말라고 하는지 과전류 덱을 피해야 되는지 그걸 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.707,
                "end": 85.236
            },
            {
                "speaker_id": "1",
                "transcription": "과전류 덱을 만나서 한방덱을 쓰게 되면 이런 그림이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.246,
                "end": 90.601
            },
            {
                "speaker_id": "1",
                "transcription": "실론나이트가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.611,
                "end": 94.100
            }
        ]
    },
    "summary": "한 남성이 상대 덱에서 락스타가 보이거나 과전류 덱일 때 붙으면 절대 안 된다고 하며 이유를 보여주고 있다.",
