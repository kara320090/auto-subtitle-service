                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단은 아레나에서 좋은 거는 이 정도로 보여드렸고 블랙펄 쿠키가 유일하게 쓰이지 않는 데가 딱 하나 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.017
            },
            {
                "speaker_id": "1",
                "transcription": "토벌전에선 안 쓰여요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.027,
                "end": 9.375
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄은 토벌에서는 안 쓰이고 대신에 수호의 성전에서는 쓰이고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.385,
                "end": 13.545
            },
            {
                "speaker_id": "1",
                "transcription": "보통 블랙펄 쿠키 같은 경우에는 공속덱에 들어가서 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.555,
                "end": 18.068
            },
            {
                "speaker_id": "1",
                "transcription": "또 민트초코랑 해서 뭐 이런 식으로 해서 쓰이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.078,
                "end": 22.150
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 공속덱 세팅에 넣어서 쓰는 사람도 있고 그냥 안 쓰고 대충 이런 식으로 보셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.160,
                "end": 31.868
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 순삭시키는 그런 그림으로 이렇게 쓰이기도 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.878,
                "end": 37.818
            },
            {
                "speaker_id": "1",
                "transcription": "수호 성전 말고도 아레나에서나 스토리 모드에서도 지금 다 각각 제가 보여드렸지만 가장 좋은 거는 이제 아레나에서 빛을 발하고 그 다음에 월드 탐험에서도 쓰실 분은 쓰고 수호 성전에서도 잘 쓰고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.828,
                "end": 50.302
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 같은 경우에 마지막으로 정리하자면 올 쿨이 좋고 약간 공격적으로 세팅할 때는 라즈베리보다 애플젤리 써가지고 치명타 확률 높이는 게 딜 들어가는 거에선 더 치명적인 딜을 넣을 수 있고 아몬드나 올 라즈도 쓰기는 하는데 웬만해서는 쿨을 많이 쓴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.312,
                "end": 67.628
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 반드시 키워야 되고 이 모든 에픽 레전드 중에 지금 현실적으로 쓰이는 거는 블랙펄 밖에 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.638,
                "end": 74.811
            },
            {
                "speaker_id": "1",
                "transcription": "얘 꼭 뽑아서 쓰시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.821,
                "end": 77.891
            },
            {
                "speaker_id": "1",
                "transcription": "일단 5초월 리뷰는 이렇게 마무리 짓도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.901,
                "end": 97.371
            }
        ]
    },
