    },
    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 방어 덱에 해파리 방덱이 많아지면서 그에 대한 파훼법으로 샤이닝글리터 덱이 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.888
            },
            {
                "speaker_id": "1",
                "transcription": "자 덱의 종류는 2가지가 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.898,
                "end": 7.946
            },
            {
                "speaker_id": "1",
                "transcription": "파르페맛 쿠키를 쓰는 덱과 그리고 퓨어바닐라 쓰는 덱 이렇게 2가지 종류가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.956,
                "end": 13.377
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 덱 소개를 해 드리자면 무공비 호루라기 시계를 쓰고 자 호루라기는 블랙펄과 샤이닝글리터가 받습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.387,
                "end": 21.052
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑 설명을 가면 크림슨코랄은 세트 효과 포함해서 21.3퍼센트 이상 해 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.062,
                "end": 27.368
            },
            {
                "speaker_id": "1",
                "transcription": "저처럼 극단적으로 쿨 이렇게 높게 세팅할 필요는 전혀 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.378,
                "end": 30.845
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 항상 중요한 거는 이 쿨타임을 먼저 세팅하는 것보다 여러분들 피해 감소가 최우선이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.855,
                "end": 37.476
            },
            {
                "speaker_id": "1",
                "transcription": "크림슨코랄은 피해 감소 20퍼센트 이상 맞춰 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.486,
                "end": 41.231
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 되면 공격력과 치명타 확률 높여주시면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.241,
                "end": 44.785
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝글리터는 5 라즈베리보다 4 라즈베리 1 애플젤리가 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.795,
                "end": 49.815
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임은 2.8퍼센트 이상 해서 자 이렇게 3초로 맞춰 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.825,
                "end": 55.321
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝글리터의 딜이 너무 낮으면은 상대의 딜러들이 안 죽을 수 있기 때문에 공격력과 치명타 확률 높여 주시면 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.331,
                "end": 63.202
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 피해 감소가 높아야지 생존이 되기 때문에 이렇게 제가 말한 수치들 외에 피해 감소를 제일 먼저 높게 세팅을 해 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.212,
                "end": 72.821
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄 같은 경우에는 2가지 종류가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.831,
                "end": 75.534
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 올 쿨로 세팅하기 힘드신 분들 그런 분들은 올 아몬드로 피감 높게 세팅 해 주시거나 아니면 올 쿨 세팅으로 피감 높게 그리고 쿨타임은 23퍼센트 이상 가능하신 분들은 요렇게 세팅해 주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.544,
                "end": 88.369
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페는 올쿨 세팅이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.379,
                "end": 90.751
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임 부옵션은 더 안 주고 세트 효과 제외하고 그냥 15퍼센트 중요한 거는 치명타 피해 감소가 높게 세팅이 가능해야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.761,
                "end": 98.242
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소도 높게 여기에 가능하신 분들 파르페가 안 죽을 수 있는 분들 요렇게 세팅하시면 되고 아는 저는 피감 높게 최대 피해 감소 높게 세팅했는데도 죽어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.252,
                "end": 107.790
            },
            {
                "speaker_id": "1",
                "transcription": "너무 힘듭니다 하신 분들은 퓨어바닐라로 대체가 가능하고 퓨어바닐라 같은 경우에는 피감 여러분들 높게 쿨도 능력껏 높게 세팅을 해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 107.800,
                "end": 117.871
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라도 마찬가지로 버티면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 117.881,
                "end": 120.357
            },
            {
                "speaker_id": "1",
                "transcription": "자 퓨어바닐라는 한 번에 채워주는 힐량과 체력 보호막까지 있어서 극딜 덱에 버틸 수 있는 그런 힐러로 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 120.367,
                "end": 128.324
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 스냅드래곤도 쿨타임은 세트 효과 제외 23. 7퍼센트 이상 요렇게 해주시고 공, 치 높게 세팅해 주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 128.334,
                "end": 137.757
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 하나 더 말씀드리면 파르페는 아레나에서 쓸 때는 마법사탕 10강 이상 반드시 찍어주셔야 활용 가치가 좋다는 점 꼭 아셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 137.767,
                "end": 147.339
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 단순히 이 조합만 좋다는 것만 알면 안 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 147.349,
                "end": 151.186
            },
            {
                "speaker_id": "1",
                "transcription": "상대의 프릴해파리 있는 덱한테 들어가는 방법을 알려드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 151.196,
                "end": 154.990
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 이렇게 상대방에 가려진 쿠키가 있을 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 155.000,
                "end": 158.333
            },
            {
                "speaker_id": "1",
                "transcription": "이럴 때 그냥 무작정 다 좋은 게 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 158.343,
                "end": 161.084
            },
            {
                "speaker_id": "1",
                "transcription": "이 조합이 프릴해파리한테만 좋은 거기 때문에 찬성상 상대방이 어떤 조합인지 파악하는 게 중요하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 161.094,
                "end": 167.862
            },
            {
                "speaker_id": "1",
                "transcription": "일단 제일 먼저 전투력으로 보기 힘들다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 167.872,
                "end": 170.235
            },
            {
                "speaker_id": "1",
                "transcription": "구분하기 힘들다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 170.245,
                "end": 171.016
            },
            {
                "speaker_id": "1",
                "transcription": "하시면 가려진 쿠키를 보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 171.026,
                "end": 173.084
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 대각선 크로스가 되죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 173.094,
                "end": 175.017
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 크로스가 된다는 점은 이 자리에 블랙펄이 올 가능성이 상당히 큽니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 175.027,
                "end": 179.262
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 프릴해파리가 있다고 하면 자리가 뒤바뀝니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 179.272,
                "end": 184.018
            },
            {
                "speaker_id": "1",
                "transcription": "잘 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 184.028,
                "end": 184.735
            },
            {
                "speaker_id": "1",
                "transcription": "이게 자리가 바뀌죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 184.745,
                "end": 185.800
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이렇게 정면으로 똑같이 바라보게 되면 이 자리에는 프릴해파리가 오지 않는다는 뜻이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 185.810,
                "end": 191.593
            },
            {
                "speaker_id": "1",
                "transcription": "프릴해파리가 온다면 이게 크로스로 엇갈리게 되는 구도가 돼야 되기 때문에 자 이 조합은 상대방은 블랙펄 조합이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 191.603,
                "end": 199.525
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 이 조합한테는 들어가면 안 되는 거 여러분 꼭 확인해 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 199.535,
                "end": 203.288
            },
            {
                "speaker_id": "1",
                "transcription": "자 반대로 맨 뒤에 블랙펄이 왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 203.298,
                "end": 206.519
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 박하사탕 조합이 아니라는 거죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 206.529,
                "end": 209.216
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 가운데에 프릴해파리가 있을 확률이 상당히 높을 수도 있지만 무조건 프리해파리가 들어있는 것도 아닐 수도 있어요. 하지만 들어가서 확인을 해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 209.226,
                "end": 221.833
            }
        ]
    },
    "summary": "해파리 방덱이 많아지면서 그에 대한 파훼법으로 파르페맛 쿠키를 쓰는 덱과 퓨어바닐라 쓰는 덱으로 샤이닝글리터 덱 2가지 종류가 나왔다.",
