        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 바다요정하고 블랙펄 덱으로 구성되어 있는데 이것도 이렇게 되면 블랙펄이 잡아 당기고 자 블랙펄이 나가고 이게 보면은 벨벳 덱 중에 이제 낫 들고 하시는 분들은 아 아까도 말씀드렸지만 무조건 낫이 좋은 건 아닙니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 22.558
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 모노클 덱한테만 낫이 좋은 것 같은데 뭐 요새는 모노클 덱이 거의 안 보여가지고 혹시나 여러분들 지금 티어에서 모노클이 많이 보인다 하시는 분들은 낫을 들고 한번 가보는 것도 상당히 좋은 방법 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.568,
                "end": 37.453
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 공속덱데 한번 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.463,
                "end": 39.114
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱은 지는 경우가 있기 때문에 저는 비추하는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.124,
                "end": 42.453
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱한테 비정상적으로 약하다 이런 뜻은 아닌데 어 지는 경우가 있어서 전 안 들어간다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.463,
                "end": 51.633
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 상성을 말씀 드리면은 이렇게 말씀을 드리고 이것도",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.643,
                "end": 58.809
            },
            {
                "speaker_id": "2",
                "transcription": "위대한 연구가 될 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.819,
                "end": 60.566
            }
        ]
    },
    "summary": "벨벳 덱 중에 낫 들고 하는 분이 계시는데 낫이 무조건 좋은 건 아니고 모노클 덱한테만 낫이좋은데 요즘 모노클 덱이 안 보이지만 혹시 티어에서 모노클이 보인다 하면 낫을 들고 가보는 것도 좋은 방법 같고 공속덱은 지는 경우가 있기 때문에 비추한다.",
