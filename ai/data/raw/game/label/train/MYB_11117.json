        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 할망구랑 얘기해 볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.646
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 사람 이름이 자동이냐구.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.656,
                "end": 5.001
            },
            {
                "speaker_id": "1",
                "transcription": "동생은 수동인가? 낄낄",
                "sound_type": [
