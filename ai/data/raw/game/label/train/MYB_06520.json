        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 아마 뭔가 뭔가를 해 놓고 뭔가 뭔가로 다시 올리고 뭐 이렇게 사다리를 옮긴다던 지를 생각했는데 사다리는 아예 움직여지질 않는데 가당찮네?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 15.206
            },
            {
                "speaker_id": "2",
                "transcription": "11월 달에 회사에서 오사카 단체 여행 간다고 한 거 그 나라 장가계로 바뀌어서 참석 안 한다고 했습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.216,
                "end": 24.341
            },
            {
                "speaker_id": "2",
                "transcription": "그날 혼자 따로 오사카 가보려고요.",
                "sound_type": [
                    2
                ],
                "start": 24.351,
                "end": 26.927
            },
            {
                "speaker_id": "1",
                "transcription": "아 혼자 가는 것도 나쁘지 않다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.937,
                "end": 28.488
            },
            {
                "speaker_id": "1",
                "transcription": "조심만 잘하고 다니면 잘 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.498,
                "end": 31.719
            },
            {
                "speaker_id": "1",
                "transcription": "혼자 여유롭게 다녀보세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.729,
                "end": 35.353
            },
            {
                "speaker_id": "1",
                "transcription": "천장에 뭐가 있나 보자.",
                "sound_type": [
                    2
