        "term": [
            {
                "speaker_id": "1",
                "transcription": "맞은 적은 화상에 걸린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.095
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 보스 몬스터에게 추가 피해를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.105,
                "end": 4.736
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스킬 사용 일정 횟수마다 강화 포탄 사용하고, 그리고 이 전투 중 공격한 몬스터와 보스 몬스터를 처치하면은 공격력이 증가한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.746,
                "end": 15.280
            },
            {
                "speaker_id": "1",
                "transcription": "아직까지 뭐 테스트 중이긴 한데, 너무 강력해서 감초 토벌정에서 쓰면 쫄이 그냥 죽어버린다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.290,
                "end": 22.322
            },
            {
                "speaker_id": "1",
                "transcription": "쫄 최대한 생존시켜 주면서 좀 살려줘야 최대 딜을 뽑아주는 거기 때문에 아직은 연구 단계다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.332,
                "end": 30.352
            },
            {
                "speaker_id": "1",
                "transcription": "12초 쿠키니까 2.8퍼센트만 넣으면은 3초가 된다.",
                "sound_type": [
                    2,
