            {
                "speaker_id": "2",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "나한테 주는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.536
            },
            {
                "speaker_id": "1",
                "transcription": "반짝이는 거 좋아",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.546,
                "end": 9.910
            },
            {
                "speaker_id": "2",
                "transcription": "야 오징어 먹물 먹 마탕다에서 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.920,
                "end": 12.280
            },
            {
                "speaker_id": "2",
                "transcription": "초싸이언 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.290,
                "end": 21.311
            },
            {
                "speaker_id": "2",
                "transcription": "자 이렇게 쿠키런 킹덤 검볼다이버맛 쿠키가 능력이 공개가 됐는데 잠시 살짝 보게 되면은 다른 능력을 보기보다 이걸 보면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.321,
                "end": 31.034
            },
            {
                "speaker_id": "2",
                "transcription": "자 능력을 쓰게 되면은 자 이렇게 뭐 조개죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.044,
                "end": 35.071
            },
            {
                "speaker_id": "2",
                "transcription": "같은 게 뜨면서 이로운 효과가 버프가 나오는 형식이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.081,
                "end": 39.898
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 특이한 점이 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.908,
                "end": 41.128
            },
            {
                "speaker_id": "2",
                "transcription": "여러분들 이 화면만 보고 특이한 점 하나 발견한다면 뭐냐 다른 쿠키들은 다 게이지가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.138,
                "end": 46.712
            },
            {
                "speaker_id": "2",
                "transcription": "어떤 체력 게이지가 다 있지만 얘는 체력 게이지가 존재하지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.722,
                "end": 52.169
            },
            {
                "speaker_id": "2",
                "transcription": "한마디로 무적입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.179,
                "end": 53.756
            },
            {
                "speaker_id": "2",
                "transcription": "이 쿠키는 시작부터 전투 참여부터 아예 피가 없는 무적 상태의 최초의 그런 쿠키로 나오게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.766,
                "end": 62.713
            },
            {
                "speaker_id": "2",
                "transcription": "심지어 스토리 모드에서조차도 얘는 공격 대상이 안 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.723,
                "end": 66.959
            },
            {
                "speaker_id": "2",
                "transcription": "왜냐 무적 상태니까 오징어 먹물로 능력 다시 아 다시 보게 되면은 자 요렇게 스킬 쓰면은 원래 인디언밥 하고 딱 때리고 끝나는 것 같은데 2대를 더 때리는 것 같아 맞죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.969,
                "end": 78.922
            },
            {
                "speaker_id": "2",
                "transcription": "이게 체력 다는 걸 보면은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.932,
                "end": 81.166
            }
        ]
    },
    "summary": "능력을 쓰게 되면 조개 같은 게 뜨면서 이로운 효과가 나오는데 특이한 점이 있는데 바로 다른 쿠키들은 게이지가 있지만 체력 게이지가 존재하지 않는데 한마디로 무적이고 전투 참여부터 아예 피가 없는 무적 상태의 최초의 그런 쿠키로 나왔다.",
