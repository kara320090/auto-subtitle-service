        "term": [
            {
                "speaker_id": "1",
                "transcription": "요 소르베가 이렇게 있고 자그만한 깃털인데 아마 이길 거긴 하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.707
            },
            {
                "speaker_id": "1",
                "transcription": "이거 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.717,
                "end": 5.918
            },
            {
                "speaker_id": "1",
                "transcription": "요새 모노클 덱을 왜 갑자기 모노클을 쓰시나요라고 물어보시는 분들 위해서 말씀드리는데 상위권은 싹 다 방덱이 다 모노클 쪽으로 막 치우쳐 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.928,
                "end": 15.412
            },
            {
                "speaker_id": "1",
                "transcription": "서리여왕이나 소르베에 많이 쓰기 때문에 디버프 제거용으로 허브맛 쿠키를 쓰지 않는 한 대부분은 다 보물 통해서 디버프 제거용으로 많이 쓰고 있는데 그냥 뭐 무난하게 일단 딜을 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.422,
                "end": 27.552
            },
            {
                "speaker_id": "1",
                "transcription": "일단 쿠키가 다 살은 상태에서 최종적인 딜 얘네 딜러랑과의 비교를 좀 해봐야 되거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.562,
                "end": 35.655
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 150만이 들어간 이유는 초반에 얘네가 빨리 없어져가지고 전체의 딜량 자체가 낮아진 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.665,
                "end": 42.115
            },
            {
                "speaker_id": "1",
                "transcription": "전체의 피해량으로 폭탄 딜이 들어가야 되는데 여기에도 한번 들어가 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.125,
                "end": 47.544
            },
            {
                "speaker_id": "1",
                "transcription": "원래 저 자리는 자구마랑 찰스 자리예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.554,
                "end": 50.066
            },
            {
                "speaker_id": "1",
                "transcription": "그 자리에 솔방울 들어갔을 때 어떤 느낌인지 솔직히 글쎄",
                "sound_type": [
                    2,
                    3
                ],
