                    2,
                    3
                ],
                "start": 21.331,
                "end": 22.487
            },
            {
                "speaker_id": "2",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.497,
                "end": 24.034
            },
            {
                "speaker_id": "2",
                "transcription": "디옹게이게이 말 걸기 싫게 왜 저러고 있어?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 24.044,
                "end": 27.562
            },
            {
                "speaker_id": "2",
                "transcription": "끈질긴 우리 갑친 무우수 님 어서 오세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.572,
                "end": 29.953
            },
            {
                "speaker_id": "4",
                "transcription": "&외국어 발화&",
