            },
            {
                "speaker_id": "2",
                "transcription": "나야 줄리야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.367,
                "end": 3.014
            },
            {
                "speaker_id": "2",
                "transcription": "왜 대답 안 해줘?",
                "sound_type": [
                    1,
                    2,
                    3,
                    5
                ],
                "start": 3.024,
                "end": 13.453
            },
            {
                "speaker_id": "2",
                "transcription": "아니 왜 여기서 혼자 똥폼 잡고 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.463,
                "end": 16.347
            },
            {
                "speaker_id": "3",
                "transcription": "한국 지리요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.357,
                "end": 17.371
            },
            {
                "speaker_id": "2",
                "transcription": "아 한국 지리 좋아하시는구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.381,
                "end": 19.030
            },
            {
                "speaker_id": "2",
                "transcription": "무우수 님 문과 출신이셨군요 아유",
