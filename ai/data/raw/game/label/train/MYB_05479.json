        "term": [
            {
                "speaker_id": "1",
                "transcription": "한번 스킬 1번만 쓰는 걸로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.459
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 한번 385만 이렇게 나와요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.469,
                "end": 13.751
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 신보 만렙이 아닌 걸로 한번 봅시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.761,
                "end": 25.596
            },
            {
                "speaker_id": "1",
                "transcription": "360만 아 근데 이게 만렙이랑 비교를 해야지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.606,
                "end": 30.706
            },
            {
                "speaker_id": "1",
                "transcription": "지금 얘는 8렙 기준이거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.716,
                "end": 33.061
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 더 늘어나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.071,
                "end": 34.402
            },
            {
                "speaker_id": "1",
                "transcription": "이거 30퍼센트까지 되잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.412,
                "end": 36.211
            },
            {
                "speaker_id": "1",
                "transcription": "만렙이 아니라서 그래.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.221,
                "end": 37.392
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 확실히 더 잘 나오겠죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.402,
                "end": 39.217
            },
            {
                "speaker_id": "1",
                "transcription": "저거 아레나에서 한번 써 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.227,
                "end": 41.460
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 아레나에서는 뭐 근데 확실한 거는 길드 토벌전에서 쓰인다고 하니까 나쁠 건 없어요 나쁠 건.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.470,
                "end": 47.322
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 아 이거 시계 빼고 한번 해 봐?",
