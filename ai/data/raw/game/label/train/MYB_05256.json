        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이거 크림 유니콘 5초월까지 뽑을 거고 다 이제 다 꽉 차면은 빨간 물약 나오는 거로 확인 가능해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.534
            },
            {
                "speaker_id": "1",
                "transcription": "오우 고대 어우 다크 카카오 나이스다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.544,
                "end": 14.248
            },
            {
                "speaker_id": "1",
                "transcription": "서리, 서리, 다크 카카오 그래도 저기 폭탄은 피했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.258,
                "end": 19.938
            },
            {
                "speaker_id": "1",
                "transcription": "최악의 무화과급 고대 쿠키 홀리베리 폭탄은 피했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.948,
                "end": 24.494
            },
            {
                "speaker_id": "1",
                "transcription": "그거 하나만 해도 정말 다행입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.504,
                "end": 27.036
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에는 이제 아레나에서 많이 쓰이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.046,
                "end": 30.172
            },
            {
                "speaker_id": "1",
                "transcription": "토벌이랑 스토리에서는 안 쓰입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.182,
                "end": 32.392
            },
            {
                "speaker_id": "1",
                "transcription": "근데 혹시 몰라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.402,
                "end": 33.342
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에가 이번에 블랙펄 제도에서 또 쓰일 수도 있으니까 근데 아레나에서 만큼은 휘낭시에 대체가 거의 불가능할 급으로 너무 중요한 쿠키라 골드 수급을 할 수 있는 방법이 뭔가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.352,
                "end": 46.615
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 월, 화, 수, 목, 금까지 생산을 진짜 열심히 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.625,
                "end": 50.599
            },
            {
                "speaker_id": "1",
                "transcription": "소원 나무 퀘스트만 깨고 그리고 주말에 소원 나무에서 20퍼센트 코인 더 주거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.609,
                "end": 56.069
            },
            {
                "speaker_id": "1",
                "transcription": "가장 효율적인 건 월, 화, 수, 목, 금까지 그 소원 나무 미션만 다 깨고 주말에 재고를 많이 소원 나무 거래를 해서 코인을 모으는 방법이 그나마 낫죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.079,
                "end": 67.432
            },
            {
                "speaker_id": "1",
                "transcription": "오 크런치 없는데 꿀",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.442,
                "end": 73.033
            }
        ]
    },
    "summary": "화자가 서리, 서리, 다크 카카오로 폭탄은 피했다며 다행이라고 하며 골드 수급 방법에 대해 이야기하고 있다.",
