    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "원탱덱 이거한테도 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.359
            },
            {
                "speaker_id": "1",
                "transcription": "이거 같은 경우에는 마들렌맛 쿠키가 특히나 상대가 클로티드 있으면은 더 극혐이 되는 이유가 뭐냐면 보이시나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.386,
                "end": 12.400
            },
            {
                "speaker_id": "1",
                "transcription": "지금 스킬 발동되고 있어야 될 공격을 핵딜 넣어야 되는 이 타이밍이 클로티드의 빛의 가방 때문에 아무것도 못 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.400,
                "end": 21.140
            },
            {
                "speaker_id": "1",
                "transcription": "보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.140,
                "end": 22.080
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 바보가 되어 버립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.100,
                "end": 25.259
            },
            {
                "speaker_id": "1",
                "transcription": "네 거의 딜도 거의 못 넣고 상대 녹이지도 못하고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.260,
                "end": 29.320
            },
            {
                "speaker_id": "1",
                "transcription": "야 계속 빛의 감옥에 갇혀서 지금 메인 딜로 패스츄리랑 같이 핵딜을 같이 넣어야 되는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.320,
                "end": 37.760
            },
            {
                "speaker_id": "1",
                "transcription": "네. 계속 갇혀서 아무것도 못 하고 죽는 그림이 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.775,
                "end": 43.060
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 더 중요한 건 상대 쿠키를 죽일 수도 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.060,
                "end": 46.900
            },
            {
                "speaker_id": "1",
                "transcription": "네 이게 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.920,
                "end": 50.140
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 처참하게 지는 그림이 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.140,
                "end": 53.412
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 솔직히 이거 가지고 좋게 쓰인다 라고 리뷰하기보다는 옛날 공속 덱 지금 쓰면은 어떤 정도의 위력이 있을까 결론만 말씀드리면은 마탕이 없으면 쓰레기다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.422,
                "end": 64.168
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱이 부활하기 힘들다. 즉 패스츄리가 원래 안 쓰이니까 패스츄리 자리에 흑당맛 쿠키를 넣어보면 어떨까요 라고 하셨는데 흑당맛 쿠키를 넣으면은 오히려 더 상대방한테 도움을 주는 덱이 되거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.178,
                "end": 76.099
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키 같은 경우에는 특별한 능력이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.109,
                "end": 79.340
            },
            {
                "speaker_id": "1",
                "transcription": "디버프가 일정 개수 3개 이상일 때 아군 전체에 체력 보호막하고 피해감소 버프를 주거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.350,
                "end": 85.450
            },
            {
                "speaker_id": "1",
                "transcription": "정말 공속덱은 엄청나게 극딜을 넣어서 상대를 죽여야 되는데 흑당맛 쿠키의 디버프 때문에 체력 보호막하고 피해감소 버프를 상대방한테 오히려 주는 역할을 해서 더 안정적으로 만들어 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.460,
                "end": 97.257
            },
            {
                "speaker_id": "1",
                "transcription": "패스츄리 대신에 지금 이게 그나마 옛날 공속덱과 요즘 나오는 흑당맛 쿠키를 섞은 건데 섞게 되면은 어떤 효과가 나오는지를 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.267,
                "end": 108.066
            }
        ]
    },
