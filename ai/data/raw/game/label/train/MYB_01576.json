        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 가운데가 져도 어차피 마지막에서 네 여기서 이기면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.314
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 마지막에서 확실히 여기서 이길 수 있기 때문에 승리를 할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.324,
                "end": 25.029
            },
            {
                "speaker_id": "1",
                "transcription": "대난투가 분명히 이렇게 생각하는 분들 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.039,
                "end": 27.878
            },
            {
                "speaker_id": "1",
                "transcription": "스펙 차 때문에 승부가 많이 갈린다 맞습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.888,
                "end": 31.942
            },
            {
                "speaker_id": "1",
                "transcription": "대난투 승부 차가 스펙 차가 되게 크고요 하지만 상성 차로도 충분히 극복할 수 있기 때문에 요 공식대로 어느 정도 한번 맞춰서 가 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.952,
                "end": 43.088
            },
            {
                "speaker_id": "1",
                "transcription": "어느 정도 커버는 가능한 범위는 있으니까 예 최대한 예 해보시는 걸 추천 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.098,
                "end": 50.197
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 이것도 상대방분도 스펙이 높은 분이지만 네 상성대로 들어가면은 쉽게 이길 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.207,
                "end": 58.485
            },
            {
                "speaker_id": "1",
                "transcription": "네 이것도 마찬가지로 한방덱이 있을 때는 공속덱으로 맞춰주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.495,
                "end": 63.685
            },
            {
                "speaker_id": "1",
                "transcription": "자 공속덱은 정석덱 이렇게 맞춰서 들어가 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.695,
                "end": 67.789
            },
            {
                "speaker_id": "1",
                "transcription": "자 정석덱으로 갈 때는 실론나이트로 들어갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.799,
                "end": 73.706
            },
            {
                "speaker_id": "1",
                "transcription": "출발",
                "sound_type": [
                    2,
                    3
                ],
