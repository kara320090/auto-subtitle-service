        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 과금 이런 거를 떠나서 내가 손해본 거 이런 거 없다고 치고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.387
            },
            {
                "speaker_id": "1",
                "transcription": "어 할 사람은 한다 자 일단 뽑기 가보자 야 운명의 순간이다 가장 중요한 순간",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.397,
                "end": 10.537
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 광고도 없어 가자 제발",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.547,
                "end": 16.857
            },
            {
                "speaker_id": "1",
                "transcription": "아 아 개망했다 야 이러고 이게 보상 끝이야?",
                "sound_type": [
                    2
                ],
                "start": 16.867,
                "end": 21.805
            },
            {
                "speaker_id": "1",
                "transcription": "맞아 아 이걸 이 쿠키로 이걸 다 밀라고 아 어질어질한대?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.815,
                "end": 26.737
            },
            {
                "speaker_id": "1",
                "transcription": "야 그래도 여기 2배속 있어 아니 나는 딱 이거 정리하면 이거야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.747,
                "end": 31.472
            },
            {
                "speaker_id": "1",
                "transcription": "가장 큰 장점 2배속이 있다 끝.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.482,
                "end": 34.827
            },
            {
                "speaker_id": "1",
                "transcription": "그거 말고는 장점이 글쎄요 네 리뷰 끝.",
