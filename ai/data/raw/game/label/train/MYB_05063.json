            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 용구덱이 부활했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.682
            },
            {
                "speaker_id": "1",
                "transcription": "자 이건 좀 특이하게 옛날에 용쿠 증표덱이 한참 있었죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.692,
                "end": 6.616
            },
            {
                "speaker_id": "1",
                "transcription": "용쿠 증표덱인데 그 자리 저 새로 들어온 신규 레전 전드가 껴 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.626,
                "end": 11.333
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱은 처음에 개발하는 사람이 전 누군지는 잘 모르겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.343,
                "end": 14.452
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뭐 어차피 용수덱 옛날 농구 증표 덱에서 신규 레전드만 들어온 거긴 한데 어 용감한 쿠키는 제볼 때 뭐 아무 토핑이나 상관 없을 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.462,
                "end": 23.345
            },
            {
                "speaker_id": "1",
                "transcription": "기왕이면 저는 뒤를 좀 더 주기 위해서 그냥 용쿠에 올 라이즈에 쿨만 줬고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.355,
                "end": 28.499
            },
            {
                "speaker_id": "1",
                "transcription": "제가 중요하다고 생각하는 게 피감을 오히려 많이 주면 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.509,
                "end": 31.773
            },
            {
                "speaker_id": "1",
                "transcription": "얘네가 죽으면서 증표가 포션 효과를 해야 되기 때문에 이거 그냥 피감만 적당하게 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.783,
                "end": 38.161
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 구미호 같은 경우에도 쿨 그냥 보옵션 없이 피해감소 같은 경우에도 얘도 오히려 더 많이 주면 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.171,
                "end": 44.180
            },
            {
                "speaker_id": "1",
                "transcription": "적당히 줘야돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.190,
                "end": 45.211
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 얘가 피감이 너무 높으면 나중에 흑당보다 구미호가 더 살아날 가능성이 크기 때문에 그냥 제가 볼 20퍼센트 이하 아니면 20 퍼센트 정도 뭐 그 정도로 해주시 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.221,
                "end": 57.762
            },
            {
                "speaker_id": "1",
                "transcription": "자 흑당이 제일 중요한 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.772,
                "end": 58.973
            },
            {
                "speaker_id": "1",
                "transcription": "흑당이 가장 오래 남아서 최후의 공격을 다하고 증표까지 받아야 되는 거기 때문에 그거는 공속 5 점 3 퍼센트 이상 이거 망토 보물을 쓸 때 5 점 3 퍼센트 이상하면 스킬 한 발 더 나가기 때문에 이거 55 점 3 퍼센트 이상 그리고 피해 감소는 가능한 한 높게 여러분들 신경 써서 해주시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.983,
                "end": 76.553
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다 요정 같은 경우에는 4초 바요로 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.563,
                "end": 78.809
            },
            {
                "speaker_id": "1",
                "transcription": "4초바요로에서 피감은 뭐 높을 대로 해주시면 되고 그렇다면 11 점 8퍼센트 이상 해 주시면 되구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.819,
                "end": 85.935
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 신규 레전드 같은 경우에도 그냥 다른 거 안 쓰고 올 라지로만 세팅 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.937,
                "end": 91.702
            },
            {
                "speaker_id": "1",
                "transcription": "피가 좀 높게 자 공속 같은 경우에는 구미호랑 그 다음에 흑당이 받으면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.712,
                "end": 98.433
            }
        ]
    },
    "summary": "용구덱이 부활을 해서 이 덱은 처음에 개발한 사람은 누구인 잘 모르고 구미호 같은 경우는 당 보다 살아날 가능성이 크기 때문에 그냥 정당히 해 주고 흑당이 제일 중요하다.",
