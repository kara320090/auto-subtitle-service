        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 야 와 야 가장 이상적이야 이게 바로 베스트야 그니까 이 그림이 나오면은 안 깨질래야 안 깨질 수 없는 환상적인 그림 그니까 이 그림이 나오면 돼.",
                "sound_type": [
