                    2,
                    3
                ],
                "start": 13.620,
                "end": 15.760
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이 덱 리뷰하려고 세팅해 봤는데 상위권에서는 아예 다 안 먹히는데.",
                "sound_type": [
