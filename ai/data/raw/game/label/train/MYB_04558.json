        "term": [
            {
                "speaker_id": "1",
                "transcription": "되게 많이 추천되고 있는 덱이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.260
            },
            {
                "speaker_id": "1",
                "transcription": "이거 카운터 덱이라 안 통할거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.260,
                "end": 9.680
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 있는 덱한테는 들어가면 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.699,
                "end": 13.600
            },
            {
                "speaker_id": "1",
                "transcription": "네 한번 그림만 보려고 해요.",
