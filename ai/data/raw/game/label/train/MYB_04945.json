        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "제발 위에서 자 또 이어서 오 굿 크탈로 블랙펄 뽑을 때가 제일 짜릿해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 16.843
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 뽑기에서 아 아 이것만 보면 진짜 퓨어 바닐라 그 자체야 안 그래요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.853,
                "end": 27.007
            },
            {
                "speaker_id": "1",
                "transcription": "자 와일드베리랑 뱀파 중에 먼저 뭘 키우는 게 나아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.017,
                "end": 30.492
            },
            {
                "speaker_id": "1",
                "transcription": "와일드베리 낫습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.502,
                "end": 31.727
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파이어 같은 경우에는 초반에 키우는 건 비추인 게 완전 단일 딜러거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.737,
                "end": 37.050
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파는 나중에 조금 지나서 키워도 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.060,
                "end": 39.623
            },
            {
                "speaker_id": "1",
                "transcription": "와일드베리는 초반부터 초보자가 무조건 올인해야 되는 쿠키 중에 하나입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.633,
                "end": 46.000
            }
        ]
    },
    "summary": "크탈로 블랙펄 뽑을 때가 제일 짜릿하고 와일드베리랑 뱀파 중에 먼저 키우면 나은 것은 와일드베리고 와일드베리는 초보자가 무조건 올인해야 되는 쿠키 중에 하나다.",
