        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 별사탕 사용하는 거는 현재 퓨어바닐라랑 그 홀리베리가 정말 좋거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.330
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 70레벨까지 일단 찍어 줄게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.340,
                "end": 8.531
            },
            {
                "speaker_id": "1",
                "transcription": "또 미션이네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.541,
                "end": 9.780
            },
            {
                "speaker_id": "1",
                "transcription": "아무 스테이지나 1회 클리어 하기 자 그리고 1가지 여러분들이 아셔야 될 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.790,
                "end": 15.495
            },
            {
                "speaker_id": "1",
                "transcription": "복귀 유저분들 가장 스트레스였던 부분을 제가 알고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.500,
                "end": 19.587
            },
            {
                "speaker_id": "1",
                "transcription": "아 나는 쿠키런 킹덤 1년 전에 할 때 정말 지옥과 같은 스테이지가 있었다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.597,
                "end": 24.943
            },
            {
                "speaker_id": "1",
                "transcription": "바로 11 다시 23이나 11 다시 27 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.953,
                "end": 30.024
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 주차한 상태로 거의 몇 달 동안 그냥 하다가 게임을 접거나 아니면 방치해놓은 사람이 많을 텐데 여러분들 이번에 엄청나게 스테이지 난이도가",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.034,
                "end": 41.875
            }
        ]
    },
    "summary": "아무 스테이지나 1회 클리어 하기 미션이 있는데 복귀 유저가 가장 스트레스였던 부분이 11 다시 23이나 11 다시 27과 같은 지옥 스테이지로 여기에 주차한 상태로 거의 몇 달 동안 하다가 게임을 접거나 방치해놓은 사람이 많았다.",
