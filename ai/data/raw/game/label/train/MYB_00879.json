        "term": [
            {
                "speaker_id": "1",
                "transcription": "상대분도 스펙이 낮은 게 아닌데도 불구하고 예 바로 바로 녹아나는걸 볼 수가 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.793
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 순삭 당한다 자 과전류덱 같은 경우에는 영상보고 오신 분들 이거 되게 좋아보인다 나도 세팅할까 아 이 과전류덱은 확실히 고스펙 분들 그리고 토핑이 되는 분들한테 추천드리는 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.803,
                "end": 21.654
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 또 하나의 극딜덱으로 리뷰를 가보겠습니다 자 이거 탱커는 하나에다가 전부 다 극딜로 가고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.664,
                "end": 28.990
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 극딜로 가다보니까 피해 감소 무시도 높은 상태에서 블랙펄의 딜도 세게 들어가는 그런 조합으로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.000,
                "end": 36.630
            },
            {
                "speaker_id": "1",
                "transcription": "전투력이 무려 300만이 넘어가는 극강의 극딜덱이다 자 상대방 소르베네요 아 이러면은 변수가 생길 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.640,
                "end": 44.082
            },
            {
                "speaker_id": "1",
                "transcription": "소르베는 확실히 딜러들의 스킬 타이밍을 꼬아 주기 때문에 무조건 딜이 높다고 해서 좋은 게 아니거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.082,
                "end": 51.937
            },
            {
                "speaker_id": "1",
                "transcription": "자 하지만 시작하자마자 상대 락스타를 죽였네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.947,
                "end": 57.734
            },
            {
                "speaker_id": "1",
                "transcription": "네 락스타가 시작하자마자 죽어버리면은 상대 입장에서는 와 아니 야 너무나 딜이 세다보니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.744,
                "end": 69.533
            }
        ]
    },
    "summary": "과전류덱은 확실히 고스펙 분들 그리고 토핑이 되는 분들한테 추천하고 극딜덱은 피해 감소 무시도 높은 상태에서 블랙펄의 딜도 세게 들어가는 그런 조합으로 간다.",
