        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상은 2탱을 잡는 2탱 저격 과전류 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.562
            },
            {
                "speaker_id": "1",
                "transcription": "자 1탱 3딜러 덱을 잡는 카운터 덱은 제 유튜브에 박하 사탕이나 파르페를 이용한 조합들 올려져 있으니까 그거 참고해 주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.572,
                "end": 14.525
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 문제는 2탱을 잡는 조합인데 2탱은 이제 과전류 덱으로 쉽게 잡을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.535,
                "end": 21.505
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 분명히 질문이 블랙 레모네이드랑 샤글 승급이 낮은데 써도 될까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.515,
                "end": 27.670
            },
            {
                "speaker_id": "1",
                "transcription": "네 토핑만 어느 정도 세팅이 가능하면 사용이 가능하고 또 하나의 질문이 크림슨 코랄 저 승급이 0승입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.680,
                "end": 35.515
            },
            {
                "speaker_id": "1",
                "transcription": "저 1승입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.523,
                "end": 36.947
            },
            {
                "speaker_id": "1",
                "transcription": "승급 낮은데도 써도 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.957,
                "end": 38.662
            },
            {
                "speaker_id": "1",
                "transcription": "크림슨 코랄은 승급이 낮아도 홀리베리보다도 훨씬 더 좋게 1탱으로 쓰일 수 있기 때문에 승급이 전혀 낮아도 상관이 없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.675,
                "end": 47.814
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페 같은 경우에는 쓰시려면 마탕 10강 이상 쓰셔야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.824,
                "end": 52.791
            },
            {
                "speaker_id": "1",
                "transcription": "자 보물은 호루라기가 샤글이랑 레모네이드한테 가면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.801,
                "end": 57.528
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑은 크림슨 코랄 세트 효과 포함해서 21.3퍼센트 이상 자 블랙 레모네이드는 올 라즈베리 여러분들이 상대방 용과한테 죽으면은 피감을 좀 더 높게 신경 써주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.538,
                "end": 70.612
            },
            {
                "speaker_id": "1",
                "transcription": "자 피감이 어느 정도 세팅이 가능해졌다 하시는 분들은 쿨, 공속 여유 있으면은 올려주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.622,
                "end": 77.312
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝 글리터는 3라즈, 2애플젤리 용과 브레스 죽지 않을 정도의 피감 먼저 신경 써주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.550,
                "end": 83.794
            },
            {
                "speaker_id": "1",
                "transcription": "여유 있으면 쿨, 공속 높여주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.804,
                "end": 86.516
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페 같은 경우에는 피감 높게 쿨 여러분들 높으면 높을수록 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.526,
                "end": 91.416
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 여러분들이 가능한 한 높게 세팅해 주시면 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.426,
                "end": 95.817
            },
            {
                "speaker_id": "1",
                "transcription": "스냅 드래곤은 올 쿨 얘도 쿨 높게 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.827,
