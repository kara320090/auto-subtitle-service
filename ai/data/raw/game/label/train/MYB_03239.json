                    5
                ],
                "start": 5.320,
                "end": 7.620
            },
            {
                "speaker_id": "1",
                "transcription": "대미지 공식입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.650,
                "end": 8.980
            },
            {
                "speaker_id": "1",
                "transcription": "대미지란 쿠키가 실제로 입는 피해 빨간색으로 뜨는 그 대미지 있죠?",
                "sound_type": [
