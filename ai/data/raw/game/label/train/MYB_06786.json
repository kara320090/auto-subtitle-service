        "term": [
            {
                "speaker_id": "1",
                "transcription": "아마 근데 그것도 있는 것 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.645
            },
            {
                "speaker_id": "1",
                "transcription": "님들 그 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.655,
                "end": 2.909
            },
            {
                "speaker_id": "1",
                "transcription": "그 개그 코드가 나랑 맞아서 그런 것도 있는 것 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.919,
                "end": 5.485
            },
            {
                "speaker_id": "1",
                "transcription": "뭐라고 할지 궁금해지고 그 내용에 푹 빠지는 그런 게 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.495,
                "end": 11.340
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 케미가 좋하서 보는 맛이 있는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.350,
                "end": 17.706
            },
            {
                "speaker_id": "1",
                "transcription": "아 맞아 나 없애는 거 쓰려고 있는데 떠들다 까먹었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.716,
                "end": 22.935
            },
            {
                "speaker_id": "1",
                "transcription": "미안해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.945,
                "end": 24.690
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 이걸 어쩔 수 없이 써야 되고 이걸 써야 돼 해제.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.700,
                "end": 29.903
            },
            {
                "speaker_id": "1",
                "transcription": "5번 빠방 어떠냐 이것들아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.913,
                "end": 41.065
