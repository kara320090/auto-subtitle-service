        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래 뒷골목 빌드 가보자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.628
            },
            {
                "speaker_id": "1",
                "transcription": "뒷골목 빌드 간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.638,
                "end": 3.545
            },
            {
                "speaker_id": "1",
                "transcription": "아 그 불길하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.555,
                "end": 6.829
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 씹힌 것 같은데 저거?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.839,
                "end": 8.413
            },
            {
                "speaker_id": "1",
                "transcription": "성당 먼저 여는 게 맞다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.423,
                "end": 10.075
            },
            {
                "speaker_id": "1",
                "transcription": "분수 여기까지 맞아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.085,
                "end": 11.370
            },
            {
                "speaker_id": "1",
                "transcription": "분수 어 시장 떴어 이거 어떻게 해?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.380,
                "end": 16.531
            },
            {
                "speaker_id": "1",
                "transcription": "분수 두니까 시장 떴어 시장 빌드 떴어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.541,
                "end": 18.909
            },
            {
                "speaker_id": "1",
                "transcription": "일단 저택은 가고 성당 가서 이제 밀푀유 만나면 되지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.919,
                "end": 22.722
            },
            {
                "speaker_id": "1",
                "transcription": "나 성시시 빌드 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.732,
                "end": 24.447
            },
            {
                "speaker_id": "1",
                "transcription": "성시시 성당은 근데 왜 왜 스킵하면 안 된다는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.457,
                "end": 30.105
            },
            {
                "speaker_id": "1",
                "transcription": "밀푀유 대화에서 선택해서 거기서 길이 갈린다?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.115,
                "end": 33.705
            },
            {
                "speaker_id": "1",
                "transcription": "아 오케 오케이 대사 빌드 아 진짜 미치겠네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.715,
                "end": 36.767
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 아 연구소 마지막으로 가야 돼요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.777,
                "end": 45.133
            }
        ]
    },
