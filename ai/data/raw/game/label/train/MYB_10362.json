        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 뭘까? 베어러의 행동.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.670
            },
            {
                "speaker_id": "1",
                "transcription": "아 베어러끼리라도 주인의 허가 없인 대화도 안 되고 단독 행동도 안 되고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.682,
                "end": 8.783
            },
            {
                "speaker_id": "1",
                "transcription": "브로치를 소지한 베어러만이 단독 행동을 할 수 있대.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.793,
                "end": 19.948
            },
            {
                "speaker_id": "1",
                "transcription": "그런 것도 있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.958,
                "end": 24.383
            },
            {
                "speaker_id": "1",
                "transcription": "하늘의 문명 시대에 존재했다고 전해지는 하늘을 나는 배.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.393,
                "end": 27.804
            },
            {
                "speaker_id": "1",
                "transcription": "어제 봤죠?",
