        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그나저나 다음 업데이트가 제가 알기론 11월 9일 아니면 8일이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.100
            },
            {
                "speaker_id": "1",
                "transcription": "다음 업데이트에 뭐가 나올지 진짜 참 미스테리야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.110,
                "end": 8.470
            },
            {
                "speaker_id": "1",
                "transcription": "원래 보통은 1주일 전쯤이면은 보통 유출좌가 무슨 쿠키 나올거다 이거 싹 유포되고 사람들이 이제 그냥 기다리기만 하면 되거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.480,
                "end": 16.940
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이번에는 그 업데이트에 대한 정보가 아무것도 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.940,
                "end": 21.677
            },
            {
                "speaker_id": "1",
                "transcription": "어 뭐야 아니 이거 스킵했는데 이게 블랙펄이 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.687,
                "end": 26.017
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 계정주인분 축하드립니다 3성 찍었네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.017,
                "end": 32.045
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이번에 옆집에 쿠키런 오븐브레이크 지금 6주년 맞이해서 좀 되게 큰 불이 났거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.055,
                "end": 39.085
            },
            {
                "speaker_id": "1",
                "transcription": "내가 거기서 느낀 게 하나 있어 쿠키런 킹덤의 2주년은 어떨까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.095,
                "end": 43.625
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐 고민을 해봤거든요 딱 하나 조심해야 할 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.622,
                "end": 46.846
            },
            {
                "speaker_id": "1",
                "transcription": "기존에 있는 거를 개편을 하는 건 개편할 수 있는데 이걸 잘못 건드리면은 진짜 게임이 뒤집어진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.856,
                "end": 54.190
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 옆집에서 잘 교훈을 받았으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.200,
                "end": 60.466
            }
        ]
    },
    "summary": "다음 업데이트에 뭐가 나올지 너무 궁금하고 쿠키런 오븐브레이크의 6주년 이벤트를 보고 교훈 삼아 쿠키런 킹덤 2주년에는 개편을 잘 해야 될 것 같다.",
