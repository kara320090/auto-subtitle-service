    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 슬프다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 12.854
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 이거 제가 살릴 수가 없네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.864,
                "end": 15.242
            },
            {
                "speaker_id": "1",
                "transcription": "지금 연구가 많이 돼야 될 것 같네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.252,
                "end": 17.331
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 박하사탕은 제가 뭐 리뷰 방송에서 주구장창 모든 경우의 수를 싹 다 조합을 연구해서 하는 거는 힘들 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.341,
                "end": 26.144
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕 조합이 나오면은 따로 좋은 조합을 올리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.154,
                "end": 30.838
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 결론만 따지면은 아 기존에 파르페랑 락스타가 워낙 좋기 때문에 여러분들이 기대하는 것만큼 박하가 지금 등장부터 화려하게 진짜 0티어로 쓰이는 경우는 아닌 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.848,
                "end": 43.963
            },
            {
                "speaker_id": "1",
                "transcription": "맞추기 까다롭고요 가장 중요한 건 용과 브레스에 너무 잘 죽는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.973,
                "end": 48.128
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 해서 힐을 파르페처럼 팍팍 줘서 힐량이 나쁘다는 게 절대 아닌데 타이밍상 너무 안 좋게 들어가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.138,
                "end": 55.446
            },
            {
                "speaker_id": "1",
                "transcription": "조합이 연구가 좀 많이 돼야 아레나에서 조금 쓰이지 않을까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.456,
                "end": 59.408
            },
            {
                "speaker_id": "1",
                "transcription": "제가 추천드리는 것은 락스타 그대로 키우시면 될 것같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.418,
                "end": 62.711
            },
            {
                "speaker_id": "1",
                "transcription": "락스타나 파르페가 힐러 중에서는 뭐 티어는 그대로 0티어 유지하면서 즐길 수 있지 않을까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.721,
                "end": 68.262
            },
            {
                "speaker_id": "1",
                "transcription": "박하는 일단 리뷰는 여기서 마치고요 좋은 조합 나오면은 추가로 더 리뷰를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.272,
                "end": 90.520
            }
        ]
    },
    "summary": "화자가 박하는 연구가 많이 되어야 할 것 같고 기존에 파르페와 락스타가 워낙 좋기 때문에 그대로 락스타를 키우는 것을 추천하며 좋은 조합이 나오면 추가로 리뷰를 더 하겠다고 말하고 있다.",
