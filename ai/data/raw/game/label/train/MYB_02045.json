        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 여기서 용과 드라 드래곤은 안 나오나 어 나오네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.799
            },
            {
                "speaker_id": "1",
                "transcription": "근데 확률이 0.02퍼센트야 너무 극악이네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.809,
                "end": 9.418
            },
            {
                "speaker_id": "1",
                "transcription": "용과 하나만 떠 주면 진짜 너무 좋을 것 같은데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.428,
                "end": 13.308
            },
            {
                "speaker_id": "1",
                "transcription": "용과 하나만 주세요 저도 용과 이펙트 보고 싶거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.318,
                "end": 16.534
            },
            {
                "speaker_id": "1",
                "transcription": "나올 때 등장 씬 보고 싶어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.544,
                "end": 18.811
            },
            {
                "speaker_id": "1",
                "transcription": "야 확률 왜 이래 이거?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.821,
                "end": 20.666
            },
            {
                "speaker_id": "1",
                "transcription": "야야야야 야 완품 자체가 진짜 안 나온다?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
