            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "10강 이상 반드시 올려주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.177
            },
            {
                "speaker_id": "1",
                "transcription": "자 슈크림맛 쿠키를 쓰는 이유는 자신의 치명타 확률에 비례해서 공격력 증가 버프를 걸어주기 때문에 기록단축이 중요한 수호 성전에서 필수로 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.177,
                "end": 14.652
            },
            {
                "speaker_id": "1",
                "transcription": "자 뿐만 아니라 월드 탐험이나 뭐 증명의 전장 다른 기타 보스 이벤트 맵에서도 유용하게 활용 많이 되기 때문에 10강 이상 찍어주는 게 중요하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.652,
                "end": 24.203
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 3순위 자 3순위는 저는 파르페 10강을 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.213,
                "end": 29.309
            },
            {
                "speaker_id": "1",
                "transcription": "파르페 10강을 찍어야 되는 이유는 자 파르페는 1강만 찍으면은 파르페가 좋은지 딱히 체감을 못하는 분들이 많이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.319,
                "end": 37.475
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이제 10강부터는 여러분들 이제 아레나에서 쓸 수가 있고요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.472,
                "end": 41.854
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페는 아레나에서 도대체 어떻게 쓰이냐 자 이렇게 스냅 드래곤하고 파르페를 같이 써서 상대방이 소르배덱일 때 실론나이트 소르배덱일 때",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.864,
                "end": 50.687
            },
            {
                "speaker_id": "1",
                "transcription": "엄청난 해로운 효과 감소 능력이 있기 때문에 스냅 드래곤과 같이 쓰면 상대방의 소르배의 서리 디버프 능력이 빨리 해제가 돼서 카운터 덱으로도 많이 활용이 되고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.687,
                "end": 60.542
            },
            {
                "speaker_id": "1",
                "transcription": "락스타맛 쿠키와 함께 같이 써서 2힐 조합으로도 많이 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.552,
                "end": 65.544
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 파르페는 워낙 힐량이 좋기 때문에 뭐 증명의 전장 스페셜 에피소드 기타 다른 컨텐츠에서도 유용하게 활용 가능하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.554,
                "end": 74.872
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 4번째로 제가 추천드릴 거는 실론나이트 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.875,
                "end": 79.075
            },
            {
                "speaker_id": "1",
                "transcription": "아니 러너님 망고맛 쿠키가 더 중요하지 않나요 자 제가 이제 추천드리는 목적은 초보자분들 기준이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.075,
                "end": 86.025
            },
            {
                "speaker_id": "1",
                "transcription": "초보자분들은 망고맛 쿠키를 먼저 키우는 거는 약간 부담스러울 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.025,
                "end": 90.516
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 자 망고맛 쿠키는 현재 토벌에서 좋게 쓰이고 있지만 토벌에서 쓰이려면 갖추어야 될 조건이 많이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.526,
                "end": 99.022
            },
            {
                "speaker_id": "1",
                "transcription": "기타 다른 쿠키들의 스펙이 어느 정도 돼야 되고 그다음에 더욱더 중요한 건 토핑의 스펙이 뒷받침 되어 줘야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.022,
                "end": 107.112
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 초보자분들이 마탕만 높인다고 해서 토벌에 바로 쓸 수 있냐 절대 못 씁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 107.122,
                "end": 112.341
            },
            {
                "speaker_id": "1",
                "transcription": "어느 정도 스펙이 돼야만 쓰기 때문에 초보자 복귀 유저분들이 무턱대고 키우는 건 추천드리지 않고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 112.351,
                "end": 117.922
            },
            {
                "speaker_id": "1",
                "transcription": "자 실론나이트 10강은 도대체 왜 찍어줘야 되냐 실론나이트 정말 만능으로도 많이 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 117.932,
                "end": 123.731
            },
            {
                "speaker_id": "1",
                "transcription": "실론나이트 같은 경우에는 네 월드 탐헝에서도 자 이거 어둠 모드 16 다시 30를 최초로 클리어할 수 있게 도와준 에픽쿠키고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 123.741,
                "end": 132.316
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 아레나에서도 한방덱 종류도 되게 여러 가지로 이렇게 과전류한방덱, 실론나이트, 소르배이용한 정석덱 자 이렇게 실론나이트, 도넛, 캡틴, 오징어먹물을 이용한 한방덱",
                "sound_type": [
                    2,
                    3
                ],
                "start": 132.326,
                "end": 145.422
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 아레나에서 한방덱과 정석덱 등 다양하게 활용되고 있기 때문에 네 어느 정도 메인 덱과 어느 정도 필수 마법 사탕 쿠키들이 육성되어 있으면 실론나이트 키워주면 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 145.422,
                "end": 156.987
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에는 솔직히 현재로서 활용 가치가 높은 마법 사탕은 많이 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 156.987,
                "end": 162.062
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 망고맛 쿠키는 아까 말씀드렸듯이 고스펙 유저분들 토핑이 받쳐줘야 되고 다른 쿠키의 스펙이 받쳐줘야지만 용 토벌전에서 사용이 가능한 쿠기고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 162.062,
                "end": 171.675
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 에스프레소 같은 경우에는 전체적으로 모든 컨텐츠에서 활용 가치가 다 떨어집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 171.677,
                "end": 176.406
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 감초도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 176.416,
                "end": 178.033
            }
        ]
    },
    "summary": "3순위는 파르페 10강을 추천하고 4순위는 만능으로 쓰이고 있는 실론나이트 쿠키 10강이며 그다음으로 활용 가치가 높은 마법 사탕은 많이 없다.",
