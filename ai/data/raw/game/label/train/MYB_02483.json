        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 요런 경우는 또 이기는 그림입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.783
            },
            {
                "speaker_id": "1",
                "transcription": "네 방금 요런 그림은 이기는 그림 그림이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.793,
                "end": 7.721
            },
            {
                "speaker_id": "1",
                "transcription": "자 방금은 이기는 그림이고 지금은 지는 그림을 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.731,
                "end": 12.173
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 하면 지는 그림이냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.183,
                "end": 14.406
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 상대방도 세팅 자체가 자 제가 말한 대로 달빛수사가 생존했죠? 이런 경우를 말하는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.416,
                "end": 23.026
            },
            {
                "speaker_id": "1",
                "transcription": "정말 치명타가 터졌으면 죽겠지만 안 터지고 살아남았을 때 이런 경우에 지는 그림이 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.036,
                "end": 32.000
            }
        ]
    },
    "summary": "방금은 이기는 그림이고 지금은 지는 그림을 보여 드리는데 상대방도 세팅 자체가 달빛수사가 생존했고 안 터지고 살아남았을 때 지는 그림이 나온다.",
