        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런데 더 충격적인 건 여러분 뭔지 아세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.600
            },
            {
                "speaker_id": "1",
                "transcription": "아니 1성인데 아슬아슬하지도 않아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.612,
                "end": 8.420
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 아슬아슬하고 그런 게 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.410,
                "end": 12.413
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 막 승급이 낮아서 여러분 진짜 중요한 포인트가 뭔지 아세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.423,
                "end": 17.981
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 보통의 다른 딜러들이나 그런 거는 승급이 낮으면 딜이 약해서 몸이 약해서 그래서 못 써요 그런 게 되게 많잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.991,
                "end": 27.176
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 얘는 그게 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.186,
                "end": 28.394
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 승급이 낮아서 안 좋아요 소리가 안 나온다니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.404,
                "end": 31.435
            },
            {
                "speaker_id": "1",
                "transcription": "벌써 1초월 분하고 미러전.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.445,
                "end": 33.620
            },
            {
                "speaker_id": "1",
                "transcription": "한번 이것도 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.630,
                "end": 34.756
            },
            {
                "speaker_id": "1",
                "transcription": "1초월과 1성의 대결.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.766,
                "end": 37.004
            },
            {
                "speaker_id": "1",
                "transcription": "저는 1성입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.014,
                "end": 39.833
            }
        ]
    },
