        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 새끼들 작은 주제에 더럽게 강하네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.339
            },
            {
                "speaker_id": "2",
                "transcription": "죽였어 죽여 버렸어 식재료 주제에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.349,
                "end": 5.423
            },
            {
                "speaker_id": "2",
                "transcription": "저 년 제 주인을 죽여 버렸어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.433,
                "end": 7.757
            },
            {
                "speaker_id": "3",
                "transcription": "나쁜 크리스티나 나빠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.767,
                "end": 10.034
            },
            {
                "speaker_id": "4",
                "transcription": "교육이 다시 필요하겠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.044,
                "end": 11.468
            },
            {
                "speaker_id": "4",
                "transcription": "좀 더 철저하게 공포를 주입해야 해.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.478,
                "end": 13.788
            },
            {
                "speaker_id": "5",
                "transcription": "지금이라도 항복해 크리스티나",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.798,
                "end": 15.753
            },
            {
                "speaker_id": "6",
                "transcription": "그럼 다진 고기 형으로 봐주지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.763,
                "end": 18.030
            },
            {
                "speaker_id": "7",
                "transcription": "그렇지 않다면 인간 골이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.040,
                "end": 20.419
            },
            {
                "speaker_id": "2",
                "transcription": "인간 골 요리로 만들어주마.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.429,
                "end": 22.458
            },
            {
                "speaker_id": "8",
                "transcription": "아무 목소리나 막 내고 있어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.468,
                "end": 25.499
            },
            {
                "speaker_id": "9",
                "transcription": "아직 여섯이나 남아서 말이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.509,
                "end": 27.635
            },
            {
                "speaker_id": "8",
                "transcription": "다행이래.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.645,
                "end": 28.850
            },
            {
                "speaker_id": "8",
                "transcription": "야야 죽는다 야야야 얘 죽었다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
