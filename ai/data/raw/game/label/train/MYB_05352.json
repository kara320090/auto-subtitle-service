            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 9월 6일 업데이트 사전 안내 공지가 떴습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.081
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 신규 레전드 쿠키가 나오게 되는데 어떤 건지 자세히 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.091,
                "end": 8.915
            },
            {
                "speaker_id": "1",
                "transcription": "뿌옇게 번진 안개 속 소용돌이 치는 물살 바다 관련 쿠키죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.925,
                "end": 13.073
            },
            {
                "speaker_id": "1",
                "transcription": "검은 바다의 전설을 찾아 떠나는 쿠키들",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.083,
                "end": 16.286
            },
            {
                "speaker_id": "1",
                "transcription": "보면은 9월 6일 업데이트 사전 안내 검은 바다의 전설 기대할 만한 쿠키가 나온 거 같다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.296,
                "end": 21.899
            },
            {
                "speaker_id": "1",
                "transcription": "자 밑에 보면은 캡틴캐비어맛 쿠키 이번에 나오는 에픽 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.909,
                "end": 26.431
            },
            {
                "speaker_id": "1",
                "transcription": "슈퍼 에픽으로 나올까 그런 얘기도 많았는데 결국에는 에픽으로 나오게 되고 중요한 건 폭발형 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.441,
                "end": 33.898
            },
            {
                "speaker_id": "1",
                "transcription": "중앙에 포지션이 되어 있고 스킬은 블랙 샤크 어뢰포 요렇게 되어 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.908,
                "end": 39.434
            },
            {
                "speaker_id": "1",
                "transcription": "폭풍우 속을 가르는 샤크 호의 선장이자 공화국의 원로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.444,
                "end": 44.300
            },
            {
                "speaker_id": "1",
                "transcription": "공화국 관련된 쿠키라 저는 슈퍼 에픽이라 생각했는데 이번에 에픽으로 나오게 되네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.310,
                "end": 49.704
            },
            {
                "speaker_id": "1",
                "transcription": "흔히 해적이라 착각하지만 오히려 해적 잡는 영원한 캡틴",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.714,
                "end": 53.537
            },
            {
                "speaker_id": "1",
                "transcription": "야 엄청나게 되게 강력해 보이는 그런 쿠키 같아 보입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.547,
                "end": 59.400
            }
        ]
    },
    "summary": "남성은 쿠키런 킹덤 9월 6일 업데이트 사전 안내 공지가 떴다면서 이번에 신규 레전드 쿠키가 나오게 되는데 어떤 건지 자세히 보겠다고 말한다.",
