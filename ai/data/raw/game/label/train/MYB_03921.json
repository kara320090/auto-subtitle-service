        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 뒤를 이어서 자 가장 많이 맡겨주신 분이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.476
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄도 조각 모아서 일단은 완품을 만들 수 있겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.486,
                "end": 9.715
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 뽑기 하다가 잘 안 나올 때는 다른 방법이 있는 게 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.725,
                "end": 14.690
            },
            {
                "speaker_id": "1",
                "transcription": "껐다 키면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.700,
                "end": 15.928
            },
            {
                "speaker_id": "1",
                "transcription": "나팔 한물갔나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.938,
                "end": 17.636
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이분 좀 안 나오면 나팔도 한번 불어보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.646,
                "end": 20.879
            },
            {
                "speaker_id": "1",
                "transcription": "요새 나팔 부는 거 한 번도 안 해봤는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.889,
                "end": 23.726
            },
            {
                "speaker_id": "1",
                "transcription": "자 음유시인, 딸크 요거 확률적으로 되게 잘 나오는 느낌이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.736,
                "end": 29.340
            },
            {
                "speaker_id": "1",
                "transcription": "0티어 급 애들이 좀 나와야 되는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.350,
                "end": 33.583
            }
        ]
    },
