        "term": [
            {
                "speaker_id": "1",
                "transcription": "중국 쿠키런 킹덤 야 나 지금 자 태초로 왔어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.385
            },
            {
                "speaker_id": "1",
                "transcription": "나 이거 근데 과금도 똑같이 되나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.385,
                "end": 8.569
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 ND 깔끔하게 야 태초 그 자체다 아 여기 그냥 이거 가자 아 리셋하고 갈까 여러분들?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.579,
                "end": 15.131
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 리셋 안 되네 야 이거 그 방법 안된다 이거 원래 여기 뽑기하면은 바로 가는 거 그거 안 되네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.141,
                "end": 21.858
            },
            {
                "speaker_id": "1",
                "transcription": "어 얘네 연동으로 하는 것도 안 줘 야박하네 연동 보상 3000크리스탈도 안 줘.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.868,
                "end": 27.875
            },
            {
                "speaker_id": "1",
                "transcription": "아 그거 한국 한국도 안되요 아 그거 막힌지 한참 됐어 그거 왜 막았어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.885,
                "end": 33.966
            }
        ]
    },
    "summary": "중국 쿠키런 킹덤 처음 시작해서 하고 연동 보상 3000크리스탈은 중국도 한국도 이제 안 준다.",
