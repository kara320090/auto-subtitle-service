        "term": [
            {
                "speaker_id": "1",
                "transcription": "컨트롤은 어차피 하다 보면 느니까",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.023
            },
            {
                "speaker_id": "1",
                "transcription": "하다 보면 늘 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.033,
                "end": 6.843
            },
            {
                "speaker_id": "1",
                "transcription": "아 저도 여기 처음 와보네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.853,
                "end": 10.588
            },
            {
                "speaker_id": "1",
                "transcription": "아 자 일단 이렇게 기갱",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.598,
                "end": 15.291
            },
            {
                "speaker_id": "1",
                "transcription": "네 대물약 2개를 놓쳤는데도 요런 식으로 하면은 된다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.301,
                "end": 19.864
            },
            {
                "speaker_id": "1",
                "transcription": "어려운 건 아닌 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.874,
                "end": 22.132
            },
            {
                "speaker_id": "1",
                "transcription": "얘를 달려야 하는 이유가 여러분들 나중에 전체 그 아레나 기여도 점수랑 달리는 거랑 이게 합산이 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.142,
                "end": 31.639
            },
            {
                "speaker_id": "1",
                "transcription": "네 보는 것처럼 깃발이나 횃불이 각각 적용이 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.649,
                "end": 35.437
            },
            {
                "speaker_id": "1",
                "transcription": "네 그리고 규칙 보면은 누적한 획득한 횃불 10개 당 1점으로 이렇게 되기 때문에 여러분들 반드시 달려야 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.447,
                "end": 44.047
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 신규는 컨텐츠인데 트리플콘컵 시즌1 리뷰는 여기서 마칠게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
