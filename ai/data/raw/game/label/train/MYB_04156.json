    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.209
            },
            {
                "speaker_id": "1",
                "transcription": "원도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.219,
                "end": 6.429
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.439,
                "end": 10.280
            },
            {
                "speaker_id": "1",
                "transcription": "자 영상 보신 것처럼 음유시인맛 쿠키가 에픽등급으로 나오게 되고 회복형 쿠키로 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.280,
                "end": 16.395
            },
            {
                "speaker_id": "1",
                "transcription": "후방에 위치해 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.405,
                "end": 17.622
            },
            {
                "speaker_id": "1",
                "transcription": "제일 중요한 건 스킬 능력이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.632,
                "end": 19.825
            },
            {
                "speaker_id": "1",
                "transcription": "음유시인맛 쿠키는 이제 마법의 노래 스킬을 사용하는 회복형이고 같은 회복형으로는 크림유니콘 쿠키가 0티어로 쓰였던 쿠키가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.835,
                "end": 28.586
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 설명을 보게 되면은 중요한 부분만 읽을게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.596,
                "end": 31.316
            },
            {
                "speaker_id": "1",
                "transcription": "아군의 체력을 회복시키고 치명타 활률과 치명타 피해량을 증가시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.326,
                "end": 36.520
            },
            {
                "speaker_id": "1",
                "transcription": "요거 보면은 어떤 게 생각나시나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.530,
                "end": 39.063
            },
            {
                "speaker_id": "1",
                "transcription": "오이스터맛 쿠키가 생각이 나죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.073,
                "end": 41.474
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 얘는 아군의 체력을 회복해 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.484,
                "end": 44.410
            },
            {
                "speaker_id": "1",
                "transcription": "자신을 포함해 아군이 둘 이하일 경우 환희의 노래가 파괴의 노래로 변경된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.420,
                "end": 49.497
            },
            {
                "speaker_id": "1",
                "transcription": "자 파괴의 노래로 변경 시 쿨타임이 초기화 되고 쿨타임 시간이 변경 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.507,
                "end": 54.859
            },
            {
                "speaker_id": "1",
                "transcription": "파괴의 노래는 적에게 피해를 입히며 아군에게 치명타 확률과 피해량을 증가시키는 버프를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.869,
                "end": 61.298
            },
            {
                "speaker_id": "1",
                "transcription": "사상 최초입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.308,
                "end": 62.715
            },
            {
                "speaker_id": "1",
                "transcription": "회복형 쿠키가 상대방에게 피해를 입힐 수 있는 정말 최초의 쿠키이자 정말 기대가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.725,
                "end": 69.200
            },
            {
                "speaker_id": "1",
                "transcription": "얼마만큼의 피해를 입힐지 이거는 좀 알아봐야 할 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.190,
                "end": 73.417
            },
            {
                "speaker_id": "1",
                "transcription": "동시에 자신을 제외한 아군 쿠키의 아군 쿠키의 스킬 쿨타임을 감소시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.427,
                "end": 77.789
            },
            {
                "speaker_id": "1",
                "transcription": "드디어 데브시스터즈가 끝까지 왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.799,
                "end": 81.457
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 쿨타임을 건드리는 게 제가 볼 때는 가장 사기적일 거 같은데 얼마나 감소되는지 좀 궁금하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.467,
                "end": 88.717
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키들의 쿨타임을 감소시키면 그만큼 스킬이 좀 더 빨리 회전 된다는 거고 중요한 건 스킬 쿨 타임을 감소해서 스킬을 빨리 쓰게 되는 입장이 더 유리하게 게임을 이길 확률이 높아질 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.727,
                "end": 100.346
            },
            {
                "speaker_id": "1",
                "transcription": "일반 공격 시 생명의 노래를 사용해 아군 쿠키들에게 일정 수치의 체력 회복 효과를 분배하며 아군 쿠키가 적어질 수록 회복량이 증가한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.356,
                "end": 109.069
            },
            {
                "speaker_id": "1",
                "transcription": "힐량이 얼마나 증가하는지도 체크해볼 그런 포인트 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 109.079,
                "end": 113.464
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 소르베맛 쿠키 업데이트 자 슈퍼에픽으로 나오고 사격형입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.474,
                "end": 117.870
            },
            {
                "speaker_id": "1",
                "transcription": "중앙에 배치가 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 117.880,
                "end": 119.937
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 능력을 보게 되면 소르베맛 쿠키는 얼음 결정 스킬을 구사하는 사격형입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 119.947,
                "end": 125.071
            },
            {
                "speaker_id": "1",
                "transcription": "자 15개의 얼음 결정을 발사해서 공격력이 높은 순서대로 적을 나누어 공격한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 125.081,
                "end": 130.880
            },
            {
                "speaker_id": "1",
                "transcription": "자 공격력이 높은 순서 공격력 쿠키는 상대방이 가운데에 있는 뭐 블랙펄 같은 쿠키를 말하는 거겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 130.890,
                "end": 138.699
            },
            {
                "speaker_id": "1",
                "transcription": "자 얼음 결정이 맞은 대상에게 다시 해로운 효과 감소 무시 디버프를 부여하며 해로운 효과 감소 무시가 나오네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 138.709,
                "end": 146.918
            },
            {
                "speaker_id": "1",
                "transcription": "해로운 효과가 요새 하도 많기 때문에 확률적으로 서리 효과를 부여하고 빙결 상태로 만든다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 146.928,
                "end": 152.415
            },
            {
                "speaker_id": "1",
                "transcription": "빙결은 지속 시간이 종료된 순간 추가 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 152.425,
                "end": 155.828
            },
            {
                "speaker_id": "1",
                "transcription": "서리는 누적되어 쌓이며 걸린 대상의 공격 속도를 감소시키고 받는 빙결 피해를 증가시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 155.838,
                "end": 162.085
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 빙결 피해를 증가시켜서 엄청난 피해를 줄 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 162.095,
                "end": 167.027
            },
            {
                "speaker_id": "1",
                "transcription": "얼음 결정은 누적된 서리의 수 만큼 추가 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 167.037,
                "end": 170.911
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 그리고 또 하나 제일 중요한 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 170.921,
                "end": 174.325
            },
            {
                "speaker_id": "1",
                "transcription": "소르베맛 쿠키는 빙결과 일부를 저항하고 이게 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 174.335,
                "end": 177.490
            },
            {
                "speaker_id": "1",
                "transcription": "소르베맛 쿠키는 따뜻한 생명의 빛 효과로 최대 체력을 초과하는 회복량을 보호막으로 전환한다 한마디로 뭐 퓨어바닐라나 아니면 다른 크림유니콘이나 수 많은 즉시 힐 엄청난 힐량을 주는 쿠키들은 체력이 거의 다 차있는 상태에서는 회복량이 낭비되는 경우가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 177.500,
                "end": 194.957
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 소르베맛 쿠키는 그 낭비되는 힐 자체가 체력 보호막으로 전환돼서 생존이 더 유리하게 될 거 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 194.967,
                "end": 203.024
            },
            {
                "speaker_id": "1",
                "transcription": "요것도 하나의 포인트 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 203.034,
                "end": 204.927
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음 뭐 이벤트 같은 경우에는 이거 뭐 뽑기 어 예전에 오이스터 처럼 슈퍼 에픽 뽑기가 나온다는 내용입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 204.937,
                "end": 213.397
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 요것도 포인트죠 서리여왕 쿠키 눈설탕맛 쿠키가 이번에 서리 디버프 추가되어 빙결 효과에 대한 개선 작업 등 일부 조정이 이루어질 예정이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 213.407,
                "end": 223.160
            },
            {
                "speaker_id": "1",
                "transcription": "한 마디로 상향 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 223.170,
                "end": 224.897
            },
            {
                "speaker_id": "1",
                "transcription": "한 번 이건 지켜봐야 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 224.907,
                "end": 226.941
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여기 보면 설탕 케이크 가게 이렇게 이벤트도 하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 226.951,
                "end": 232.536
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키들의 즐거운 연말을 위해서 뭐 케이크 가게 오픈서 뭐 미니 게임 같이 만들어서 도장을 얻는 그런 시스템 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 232.546,
                "end": 240.835
            },
            {
                "speaker_id": "1",
                "transcription": "요기 보면은 각자 여러분들이 원하는 데코 해가지고 예쁘게 꾸밀 수 있는 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 240.845,
                "end": 246.254
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 케이크 타워 확장 및 시스템 추가 무려 250층까지 확장됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 246.264,
                "end": 252.159
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 혼돈의 케이크 타워 시즌 11부터는 50층 단위로 구간이 나눠진다고 하고 특정 구간을 한 번에 클리어할 수 있는 층 돌파 시스템 이게 나오게 된다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 252.169,
                "end": 263.787
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 이렇게 층 많아진다고서 여러분들이 생각할 때는 이거 어떻게 이거 어떻게 깨라는 거야라고 이런 소리들 나올 수 있지만 자 250층까지 늘어난 만큼 보상도 어마무시하게 많아지겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 263.797,
                "end": 275.858
            },
            {
                "speaker_id": "1",
                "transcription": "늘어난다고 나쁜 건 아닌 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 275.868,
                "end": 277.933
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 BTS 쿠키 스킨 14종 출시 자 이렇게 또 나왔네요 여러분들 아미밤 지금 쓰지 마시고 모아두셔야 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 277.943,
                "end": 286.461
            },
            {
                "speaker_id": "1",
                "transcription": "많이 모아둔 다음에 컬렉션 채우면은 리듬 게임 이벤트 여러분들 추가 점수 얻기 때문에 요거 반드시 어 다 뽑아주시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 286.471,
                "end": 296.293
            },
            {
                "speaker_id": "1",
                "transcription": "미션 티켓북 이벤트 통해서도 여러분들 요기 보면은 각 타이틀곡 티켓북 완성하면은 스킨 선택 상자 보상을 획득할 수 있다 총 6개 획득할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 296.303,
                "end": 305.547
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 나오게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 305.557,
                "end": 307.702
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 충격적인 게 신규 보물이 추가됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 307.712,
                "end": 311.102
            },
            {
                "speaker_id": "1",
