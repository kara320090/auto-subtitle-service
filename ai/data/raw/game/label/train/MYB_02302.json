        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 퀸아망맛 쿠키 리뷰 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.912
            },
            {
                "speaker_id": "1",
                "transcription": "5성 5초월 나눠서 리뷰를 진행하도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.922,
                "end": 8.034
            },
            {
                "speaker_id": "2",
                "transcription": "실패에 지지 않는 기사",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.044,
                "end": 24.587
            },
            {
                "speaker_id": "1",
                "transcription": "5성 기준으로 일단 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.597,
                "end": 26.437
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 스킬 보면은 패배를 두려워 하지 않는 기사도 스킬 사용 시 일반 공격이 강화되고 범위가 증가하고 빛 속성 피해로 변경된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.447,
                "end": 35.755
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 공격속도 증가 버프 수에 비례하여 추가 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.765,
                "end": 39.761
            },
            {
                "speaker_id": "1",
                "transcription": "공격속도가 높은 두 아군 쿠키의 공격속도가 증가하고 아군 쿠키 전체의 공격속도 감소 저항 버프와 빛 속성 공격 피해량 증가 버프를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.771,
                "end": 50.802
            },
            {
                "speaker_id": "1",
                "transcription": "빛의 힘을 모아 거대한 대검을 휘두른다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.812,
                "end": 53.336
            },
            {
                "speaker_id": "1",
                "transcription": "피해감소 일부를 무시한 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.346,
                "end": 55.535
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 좀 특이한 거는 퀸아망 쿠키가 디버프가 부여될 경우 자신의 피해감소가 증가한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.545,
                "end": 62.454
            },
            {
                "speaker_id": "1",
                "transcription": "디버프가 쌓이면 오히려 피해감소가 증가하고 일반 공격 시 공격속도가 증가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.464,
                "end": 66.856
            },
            {
                "speaker_id": "1",
                "transcription": "공격속도 버프 비례 추가 피해는 공격속도 증가 버프 1개당 22.5퍼센트의 피가 추가가 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.866,
                "end": 74.926
            },
            {
                "speaker_id": "1",
                "transcription": "공격속도 증가는 8초 동안 25퍼센트 증가 중첩은 1개 공격속도 감소 저항은 12초 동안 50퍼센트 증가 중첩은 1개 그리고 빛 속성 공격 피해량 증가는 10초 동안 20퍼센트 증가 빛의 일격 피해량은 707.9퍼센트 대상의 피해 감소 17.5퍼센트 무시 야 얘는 무슨 야 이거 왜 이렇게 많아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.936,
                "end": 94.620
            },
            {
                "speaker_id": "1",
                "transcription": "일반 공격 시 공격속도 증가 8초 동안 4퍼센트 증가 중첩은 최대 10개나 되네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.630,
                "end": 100.106
            },
            {
                "speaker_id": "2",
                "transcription": "퀸아망 기사도 디버프 받을 경우 15초 동안 피해감소 12.5퍼센트 증가 중첩 최대 2 2.8퍼센트만 넘으면은 3초 쿠키네요 2.8만 넘으면은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.116,
                "end": 112.400
            }
        ]
