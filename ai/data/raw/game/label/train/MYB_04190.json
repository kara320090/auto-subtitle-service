        "term": [
            {
                "speaker_id": "1",
                "transcription": "그리고 저는 영상 찍느라 트로피 차이 많이 나도 어 제가 다 들어가고 있는데 여러분들이 따로 하실 때는 절대 이렇게 들어가시면 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.796
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이제 만 트로피인데 9.100 트로피한테 들어가면은 여러분들 엄청난 손실입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.806,
                "end": 14.464
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 뱀파 다음으로 웨어울프 마탕 올리는 게 좋을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.474,
                "end": 17.221
            },
            {
                "speaker_id": "1",
                "transcription": "현재로서는 뱀파 10강 찍고 웨어울프로 바로 가셔야죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.231,
                "end": 21.622
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파이어가 마탕 순위가 0순위였는데 지금은 현재 0순위는 웨어울프입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.632,
                "end": 27.851
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프 10강 먼저 찍고 호밀맛 쿠키 10강 찍고 그다음 오징어 먹물 1강 찍고 그다음에 여유가 되면은 뱀파 10강 먼 10강 찍어주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.861,
                "end": 37.234
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 추가적으로 에스프레스 더 많이 쓰실 거 분들은 에스프레소 마탕을 이제 찍어주시면 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.244,
                "end": 44.245
            },
            {
                "speaker_id": "1",
                "transcription": "자 요런 식으로 잡아줍니다.",
