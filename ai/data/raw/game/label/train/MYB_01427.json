        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 용과 드래곤 5초월 리뷰 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.333
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과 드래곤은 쿠키 티어에서 0티어를 유지하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.343,
                "end": 7.687
            },
            {
                "speaker_id": "1",
                "transcription": "많은 질문들이 들어오는 용과 드래곤 세팅하는 방법 어떻게 조합을 짜야 되는지 여러분들이 질문을 많이 한 부분에 대해서 초점을 맞춰서 리뷰를 하려고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.697,
                "end": 19.455
            },
            {
                "speaker_id": "1",
                "transcription": "자 제일 먼저 토핑부터 말씀을 드리면 토핑을 아직도 에플젤리 섞어서 쓰는 분도 있고 아몬드도 껴서 쓰는 분도 있고 올라즈베리 섞어서 쓰는 분도 있는데 결론만 말씀 드리자면 대부분은 다 라즈베리 섞어서 쓰고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.465,
                "end": 34.371
            },
            {
                "speaker_id": "1",
                "transcription": "자 왜 라즈베리를 다 섞어서 쓰는 게 대부분이냐 용과 드래곤 쓰시는 분들은 대부분 아시겠지만 이 세트 효과를 받아서 최대한 극딜용으로 1분과 30초 때 공격력 증가 타임에 맞춰서 엄청난 한 방 딜을 쏟아부어서 상태 쿠키들을 죽이는 용도로 많이 사용하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.381,
                "end": 54.773
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 여러분들이 세팅할 때 이 쿨타임 공격 타이밍이 정말 중요하기 때문에 많은 부옵션 수치 중에서 여러분들이 가장 신경써야 될 1순위는 솔직히 피해감소가 1순위고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.783,
                "end": 67.645
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 신경써야 될게 쿨타임입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.655,
                "end": 70.349
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과 드래곤 피해감소 같은 경우에는 여러분들이 아셔야 될 부분이 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.359,
                "end": 75.157
            },
            {
                "speaker_id": "1",
                "transcription": "피해감소 같은 경우에는 피엄킹텀은 맥스 85퍼센트가 최대치입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.167,
                "end": 80.733
            }
        ]
    },
    "summary": "화자가 용과 드래곤의 5초월 리뷰를 하며 토핑은 대부분 라즈베리를 섞어서 쓰고 있고 쿨타임 공격 타이밍이 정말 중요하다고 설명한다.",
