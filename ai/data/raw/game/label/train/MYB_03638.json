        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 무공비급 잘 나왔네요. 공 속이랑",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.284
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 한 번 더 네 이렇게 나왔고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.294,
                "end": 6.208
            },
            {
                "speaker_id": "1",
                "transcription": "자 스킨 뽑기 뽑기권 다 써달라고 하셨는데 계정 주인분 이거 일단 좀 더 모으세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.218,
                "end": 13.024
            },
            {
                "speaker_id": "1",
                "transcription": "2주년 때 왠지 제가 볼 때는 스킨 더 나올 거 같거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.034,
                "end": 16.386
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 스킨 더 나오면 그때 좀 더 모아서 그때 뽑으세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.396,
                "end": 19.600
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 뽑기 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.610,
                "end": 21.161
            },
            {
                "speaker_id": "1",
                "transcription": "20만 개만 딱 깔끔하게 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.171,
                "end": 23.191
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 뽑기는 하셔야 되는 입장은 맞아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.201,
                "end": 25.495
            },
            {
                "speaker_id": "1",
                "transcription": "근데 7만 개 정도는 호밀이 좋고 7만 개 정도는 왕국에 투자하셔야 돼서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.505,
                "end": 32.125
