                "start": 0.000,
                "end": 6.374
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 29강해서 30강 됐을 뿐인데 이런 차이가 나오네요 바로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.384,
                "end": 11.722
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 방덱에서도 제가 차이를 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.732,
                "end": 15.215
            },
            {
                "speaker_id": "1",
                "transcription": "30강을 찍고 지금 제가 어젯밤에 사실 리뷰를 찍었는데 다시 리뷰를 찍고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.225,
                "end": 21.045
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 제가 방덱에서도 어떤 변화가 있는지 그거를 솔직히 리뷰류에 넣고 싶었어요",
                "sound_type": [
                    2,
