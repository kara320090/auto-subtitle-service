        "term": [
            {
                "speaker_id": "1",
                "transcription": "헐 아 깜짝이야 역전하는 줄 알았잖아",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.245
            },
            {
                "speaker_id": "1",
                "transcription": "이벤트 보물이 설마 아레나에서 쓰면 좋을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.255,
                "end": 6.668
            },
            {
                "speaker_id": "1",
                "transcription": "그거 때문에 보신 분들 안심하시고 그냥 만렙 굳이 안 찍어도 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.678,
                "end": 11.716
            },
            {
                "speaker_id": "1",
                "transcription": "스킨 1, 2, 3등 된거 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.726,
                "end": 14.075
            },
            {
                "speaker_id": "1",
                "transcription": "요 3개 한번 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.085,
                "end": 16.518
            },
            {
                "speaker_id": "1",
                "transcription": "자 이론상 피감 정말 단단하고 무적이 될 만한",
                "sound_type": [
