        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 무공비급으로 갈아타시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.144
            },
            {
                "speaker_id": "1",
                "transcription": "바로 스토리로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.154,
                "end": 5.427
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 초반에 목표를 잡아야 될 거는 여기까지 빨리 가자 목표로 가지시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.437,
                "end": 10.368
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 여기 도달하는 순간에 여기 스테이지가 되게 많거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.378,
                "end": 14.930
            },
            {
                "speaker_id": "1",
                "transcription": "여기 다 깨는 순간 왕국 레벨이 거의 35렙에 가까울 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.940,
                "end": 19.991
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나게 폭풍으로 올라갈 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.001,
                "end": 22.751
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 여기서부터 에픽 토핑이 나오기 때문에 여기를 집중적으로 빨리 가야 된다 이거 질문하는 분들 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.761,
                "end": 29.654
            },
            {
                "speaker_id": "1",
                "transcription": "러너 님 저는 쿠키 레벨이 왕국 레벨이랑 똑같이 올릴 수 있는데 어떻게 랭커 분들은 왕국 레벨이 30,40밖에 안 됐는데 쿠키 레벨을 70렙까지 찍을 수 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.664,
                "end": 41.146
            },
            {
                "speaker_id": "1",
                "transcription": "이 질문이 가끔가다 영상 보면 초보자분들이 질문을 하는데 나 지금은 레벨업당 올라가는 데로 왕국 레벨까지만 올릴 수 있지만 나중 가면 왕국 레벨 1 올리는데 쿠키 레벨은 2씩 올릴 수 있게끔 바뀌거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.156,
                "end": 55.697
            },
            {
                "speaker_id": "1",
                "transcription": "네 그렇기 때문에 가능한 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.707,
                "end": 57.415
            },
            {
                "speaker_id": "1",
                "transcription": "뭔 말인지 아셨죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.425,
                "end": 59.700
            }
        ]
    },
