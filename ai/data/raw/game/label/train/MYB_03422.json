        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 여러분들 이거 야 이 참 이게 맞나 싶다 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.565
            },
            {
                "speaker_id": "1",
                "transcription": "와 어 달빛이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.575,
                "end": 12.923
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛 대전 한 번 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.933,
                "end": 14.654
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아까 요구하신 그 덱이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.664,
                "end": 17.700
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 보여달라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.710,
                "end": 19.052
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 피증을 걸어서 빨리 빨리 그냥 디버프를 거는 쪽으로 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.062,
                "end": 23.976
            },
            {
                "speaker_id": "1",
                "transcription": "올 공으로 가자고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.986,
                "end": 25.151
            },
            {
                "speaker_id": "1",
                "transcription": "자 올 공으로 갈게요 그러면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.161,
                "end": 26.899
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리 그다음에 퓨어발닐라 상향된 두 쿠키 전부 다 추가를 했고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.909,
                "end": 34.333
            }
        ]
    },
    "summary": "발화자는 캐릭터 달빛끼리 대결하는 것을 보여주겠다며 다른 쿠키도 추가합니다.",
