            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 네 캡사이신이 없어도 마라 마탕으로도 이길 수 있는 그림이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 11.623
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 클리어가 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.633,
                "end": 15.442
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 아몬드는 처음 본다 그쵸? 저도 아몬드 쓰는 덱으로 리뷰는 한 번 더 해본 적이 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.452,
                "end": 21.371
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음 분도 가볼게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.381,
                "end": 23.985
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방 분은 3초월입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.995,
                "end": 26.361
            },
            {
                "speaker_id": "1",
                "transcription": "보시는 거와 같이 상대방분은 캡사이신이 올 라즈 끼신 분이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.371,
                "end": 32.501
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나게 폭딜이 들어와요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.511,
                "end": 34.299
            },
            {
                "speaker_id": "1",
                "transcription": "그거를 견딜려면 라 아몬드만 견딥니다. 올 라즈 하면 시작하자마자 달빛술사가 요로케 스타더스가 바로 죽을 수도 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.309,
                "end": 43.626
            },
            {
                "speaker_id": "1",
                "transcription": "이러면 지는 그림이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.636,
                "end": 46.079
            },
            {
                "speaker_id": "1",
                "transcription": "이길 수가 없어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.089,
                "end": 47.490
            },
            {
                "speaker_id": "1",
                "transcription": "저 라지색이 워낙 폭딜이 들어오기 때문에 스타더스트가 딜을 다 해주는 이 조합에서는 아 이거는 이길 수가 없는 그림 다시 해볼게요. 이건.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.500,
                "end": 59.379
            },
            {
                "speaker_id": "1",
                "transcription": "초반에 터지면 어떤 덱이든 간에 뭐 답이 없어요.",
                "sound_type": [
                    2
                ],
                "start": 59.389,
                "end": 63.690
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트가 딜을 거의 다 아는 조합이라 초반에 죽으면 안 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.700,
                "end": 69.500
            }
        ]
    },
    "summary": "저는 아몬드 쓰는 덱으로 리뷰는 한 번 더 해본 적이 없고 상대방은 캡사이신이 올 라즈 끼신 분으로 엄청나게 폭딜이 들어오고 올 라즈 하면 시작하자마자 달빛술사가 요로케 스타더스가 바로 죽을 수도 있으며 이길 수가 없다.",
