        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 11월9일 업데이트 사전 안내 공지가 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.654
            },
            {
                "speaker_id": "1",
                "transcription": "관련해서 상세히 같이 보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.664,
                "end": 7.644
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 주요 업데이트 내용부터 보면 신규 스킨 드디어 비 에디 포 스킨이 나오게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.654,
                "end": 14.555
            },
            {
                "speaker_id": "1",
                "transcription": "신규 스킨 및 스킨 인연이 추가가 되죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.565,
                "end": 17.143
            },
            {
                "speaker_id": "1",
                "transcription": "악당도 비이디 포에 수킨 4종 추가 보면은 찰스 스킨, 감초맛 쿠키 스킨, 독버섯맛 쿠키 스킨, 벨벳케이크맛 쿠키 스킨 이렇게 4종이 나오게 되고 퀄리티가 상당히 좋은 걸로 여러분들 볼 수 가 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.153,
                "end": 32.616
            },
            {
                "speaker_id": "1",
                "transcription": "스킨 인연에 대한 인연 1종 추가가 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.626,
                "end": 35.855
            },
            {
                "speaker_id": "1",
                "transcription": "정말 오랜만에 추가가 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.865,
                "end": 38.595
            },
            {
                "speaker_id": "1",
                "transcription": "거의 뭐 5개월 만에 나온 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.605,
                "end": 40.474
            },
            {
                "speaker_id": "1",
                "transcription": "자 비 에이 디 포 그다음 리듬 스테이지가 또 추가가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.484,
                "end": 44.293
            },
            {
                "speaker_id": "1",
                "transcription": "마스터 모드가 추가가 되는 거겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.303,
                "end": 46.038
            },
            {
                "speaker_id": "1",
                "transcription": "스테이지 자체가 정말 전체가 붉은 색이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.048,
                "end": 49.463
            },
            {
                "speaker_id": "1",
                "transcription": "막 끝판 난이도답게 상당히 어려운 거 같은 모습으로 보이고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.473,
                "end": 56.160
            },
            {
                "speaker_id": "1",
                "transcription": "자 비티에스 콘서트 전 투 스테이지 12일 완벽한 소우주 무대를 위해 3 클리어하기를 클리어 하면은 월드맵 우측에 비 에이디 포 입장하기 버튼이 활성화 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.170,
                "end": 67.658
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 그리고 비 에이 디 포 리듬 스테이지는 입장 재화가 아예 필요하지 않고 자유롭게 플레이할 수 있다.",
                "sound_type": [
