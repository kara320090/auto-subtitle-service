    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 박하 사탕 저격으로 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.714
            },
            {
                "speaker_id": "1",
                "transcription": "제가 만약에 3딜덱이면 전투력이 엄청나게 높아야 되는데 상대방 분은 전투력이 240만으로 낮죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.730,
                "end": 8.807
            },
            {
                "speaker_id": "1",
                "transcription": "이런 경우에는 숨겨진 게 박하 사탕입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.817,
                "end": 11.595
            },
            {
                "speaker_id": "1",
                "transcription": "자 예상대로 박하 사탕이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.622,
                "end": 13.739
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과 드래곤으로 박하 사탕 저격으로 갈 수 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.749,
                "end": 17.796
            },
            {
                "speaker_id": "1",
                "transcription": "박하 사탕 저격 용과 안 쓰고 다른 저 저격으로 갈 수 있는 거 없나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.806,
                "end": 22.785
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 생각하는 분도 있을지도 모르는데 그냥 극딜덱으로 가도 되지만 아 너무 확률이 승률이 너무 복불복이고 치명타에 의해서 승부가 나는 경우도 많기 때문에 저는 좀 비추 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.795,
                "end": 38.413
            },
            {
                "speaker_id": "1",
                "transcription": "제가 추천드리는 거는 지금과 같이 어 용과 드래곤을 활용하면 무난하게 이기는 경우가 많기 때문에 용과 드래곤을 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.423,
                "end": 49.346
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤 나락 갔나요 하는 분들도 많은데 공덱으로써는 활용 가치가 아직도 너무 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.356,
                "end": 55.267
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 쓰기에는 용과 드래곤은 과전류 덱이나 다른 파훼법들이 많기 때문에 저는 용과 드래곤 방덱으로는 추천드리지 않지만 공덱으로는 어 추천드리고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.277,
                "end": 67.102
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 파르페를 쓰는 분도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.114,
                "end": 69.547
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페 쓸 때도 용과 덱으로 들어가셔도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.567,
                "end": 74.034
            },
            {
                "speaker_id": "1",
                "transcription": "네 저 같은 경우에는 그냥 극딜 조합으로 들어가는데 만약에 전투력 구분이 힘들다 해도 네 여러분들이 어 1번 조합으로 가도 되고 아니면 아까 말씀드린 대로 어 3딜덱은 확실히 전투력이 엄청나게 높기 때문에 그거보다 낮으면은 다른 딜러 조합이 이 있을 가능성이 높거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.044,
                "end": 96.042
            },
            {
                "speaker_id": "1",
                "transcription": "그걸로 구분해서 가셔도 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.054,
                "end": 98.515
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 파르페를 쓰는 조합도 있으니까 아 용과 조합으로도 가시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.540,
                "end": 103.748
            },
            {
                "speaker_id": "1",
                "transcription": "자 이분도 마찬가지 240만 박하 사탕 조합이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 103.758,
                "end": 107.598
            },
            {
                "speaker_id": "1",
                "transcription": "가장 여러분들이 박하 사탕 방덱을 지금 까다로워 할 가능성이 크기 때문에 네 이걸로 가셔서 파훼법으로 쓰시면 되고 3딜덱 공략이야 에 파훼법은 이미 여러 가지 종류가 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 107.608,
                "end": 122.966
            },
            {
                "speaker_id": "1",
                "transcription": "네 용과 조합 그 다음에 박하 조합, 파르페 조합 뭐 세네 가지가 있기 때문에 여러분들이 보고 상황에 맞춰서 쓰시면 되고 네 이렇게 박하 조합 같은 경우에는 이렇게 용과 드래곤, 락스타 조합으로 아주 쉽게 이길 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 122.976,
                "end": 141.553
            },
            {
                "speaker_id": "1",
                "transcription": "네 일단 현재 나와있는 유행하는 조합들은 전부다 파훼법이 제 유튜브 영상 지금 이 영상 하나에 다 담겨져 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 141.563,
                "end": 151.433
            },
            {
                "speaker_id": "1",
                "transcription": "세팅만 가능하다면은 네 모든 조합에 대해서 공략이 가능하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 151.443,
                "end": 155.902
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 방덱으로 돼있는 거 용과 2탱 조합 그리고 박하 사탕이나 파르페로 된 코랄 1탱 조합 또는 이 3딜로 된 방덱 조합이 있는데 네 각각의 상황에 맞춰서 다 파훼법이 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 155.912,
                "end": 168.620
            },
            {
                "speaker_id": "1",
                "transcription": "자 5번 용과는 4번으로 잡고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 168.630,
                "end": 171.120
            },
            {
                "speaker_id": "1",
                "transcription": "자 3번 조합은 용과 조합으로 잡고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 171.130,
                "end": 173.895
            },
            {
                "speaker_id": "1",
                "transcription": "자 1번 조합은 3번이나 5번으로 잡으면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 173.905,
                "end": 177.966
            },
            {
                "speaker_id": "1",
                "transcription": "자 모든 조합에 대해서 파훼법 나왔는데 마지막까지 달려서 보상 최대한 많이 받으시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 177.976,
                "end": 185.789
            },
            {
                "speaker_id": "1",
                "transcription": "혹시나 궁금한 점이 있다면 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 185.799,
                "end": 188.987
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 188.997,
                "end": 195.166
            }
        ]
    },
    "summary": "일단 현재 나와 있는 유행하는 조합에 대해서는 모두 파훼법이 이 유튜브 영상 하나에 담겨져 있기 때문에 세팅만 가능하다면 모든 조합에 대해서 공략이 가능하다.",
