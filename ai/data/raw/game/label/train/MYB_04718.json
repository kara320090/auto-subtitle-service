                    2,
                    3
                ],
                "start": 9.505,
                "end": 10.790
            },
            {
                "speaker_id": "1",
                "transcription": "오 이번에도 힐량 좀 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.800,
                "end": 15.088
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 그냥 압도적으로 찰스가 있으면은 안 됩니다.",
