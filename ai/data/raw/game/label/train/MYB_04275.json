                ],
                "start": 0.000,
                "end": 1.080
            },
            {
                "speaker_id": "1",
                "transcription": "저기 30레벨까지 그냥 무한 무한입니다 무한",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.090,
                "end": 5.484
            },
            {
                "speaker_id": "1",
                "transcription": "여기 근데 나 옛날에도 여기 지나갈 때 여기 무슨 버그인가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.494,
                "end": 10.815
            },
            {
                "speaker_id": "1",
                "transcription": "경험치가 도대체 왜 이렇게 많이 올라?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.825,
                "end": 12.698
            },
            {
                "speaker_id": "1",
                "transcription": "처음에 할 때 그랬어요 처음에 할 때",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.708,
                "end": 15.776
            },
            {
                "speaker_id": "1",
                "transcription": "자 25렙 자 이렇게 레벨을 올리면 쿠키 이것도 야 30레벨까지 그리고 중요한 게 이 토핑 이거 맞춰주는 게 또 중요해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.786,
                "end": 27.378
            },
            {
                "speaker_id": "1",
                "transcription": "세트 효과 이런 거 있죠 이런 거로 맞춰줘도 세트 효과 받거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.388,
                "end": 31.957
            },
            {
                "speaker_id": "1",
                "transcription": "가끔가다 질문하시는 분들 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.967,
                "end": 33.706
            },
            {
                "speaker_id": "1",
                "transcription": "레너 님 저는 왜 두 번째 세트 효과가 없나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.716,
                "end": 37.081
            },
            {
                "speaker_id": "1",
                "transcription": "토핑마다 두 번째 세트 효과 있는 게 있고 없는 게 있고 나눠지거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.091,
                "end": 41.702
            },
            {
                "speaker_id": "1",
                "transcription": "제일 많이 쓰는 이 라즈베리 얘는 토핑이 두 번째까지 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.712,
                "end": 47.122
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 애플젤리나 나머지는 어 세트 효과가 얘도 한번 하나만 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.132,
                "end": 52.554
            },
            {
                "speaker_id": "1",
                "transcription": "초콜릿칩도 한 하나만 있고 각각 하나씩만 있는 게 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.564,
                "end": 56.357
            },
            {
                "speaker_id": "1",
                "transcription": "모두 다 두 번째까지 있는 게 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.367,
                "end": 60.033
            }
