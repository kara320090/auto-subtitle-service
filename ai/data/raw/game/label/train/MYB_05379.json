        "term": [
            {
                "speaker_id": "1",
                "transcription": "토핑 상태가 나쁘지가 않는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.502
            },
            {
                "speaker_id": "1",
                "transcription": "계정 주인분 이거 지금 애플젤리 강화할 때가 아닌 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.512,
                "end": 6.985
            },
            {
                "speaker_id": "1",
                "transcription": "제가 쭉 훑어 봤는데 문제가 딱 보이는 거는 저 쿨 토핑 강화작이 정말 부족하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.995,
                "end": 12.721
            },
            {
                "speaker_id": "1",
                "transcription": "아몬드나 라즈도 쫌 부족한데 아 애플젤리를 많이 하고 계시구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.731,
                "end": 18.856
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 토벌 때문에 그렇게 하시는 건 알겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.866,
                "end": 21.187
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 어느 정도까지는 해주시고 지금을 보면은 아몬드가",
                "sound_type": [
                    2,
