        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 떠나는 유저 수가 많아지는 건 게임사도 어느 정도 알고 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.606
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 질려서 재미없어서 숙제 같다는 이유도 있지만 그보다 더 중요한 건 업데이트가 하나도 기대되지 않는다는 점입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.616,
                "end": 12.809
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 신규 쿠키만 찍어내고 콘텐츠는 매번 재탕에다가 심지어 나오는 재탕 콘텐츠도 유저 간의 인원수 밸런스도 안 맞추고를 경쟁 콘텐츠라고 홍보하는데 경쟁의 의미가 하나도 없기 때문입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.819,
                "end": 25.234
            },
            {
                "speaker_id": "1",
                "transcription": "3개의 학교로 나뉘어 경쟁 하지만 압도적으로 점수차가 벌어지고 꼴찌 학교로 배정된 유저는 아무리 노력해도 순위 경쟁이 되지 않기 때문에 포기 상태입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.244,
                "end": 34.266
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 2년 4개월이 지난 시점에서 유저가 재미있다고 생각하는 신규 콘텐츠가 나온 게 있을까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.276,
                "end": 41.503
            },
            {
                "speaker_id": "1",
                "transcription": "개인차는 있겠지만 게임 내에 들어가면 아레나를 제외하고 당장 손에 가는 콘텐츠가 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.513,
                "end": 47.501
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 유저의 게임 내 이 불편함을 인지하여 편의성 개선 업데이트를 주 목적으로 하고 있느냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.511,
                "end": 52.932
            },
            {
                "speaker_id": "1",
                "transcription": "아직도 유저가 건의하고 필요하다고 느껴지는 업데이트 우선순위는 계속 미뤄지고 있으니 불만이 쌓일 수밖에 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.942,
                "end": 60.300
            }
        ]
    },
    "summary": "쿠키런 킹덤의 반복되는 재탕 업데이트와 신규 쿠키로인해 유저들이 떠나고 있다.",
