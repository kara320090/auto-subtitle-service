        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 무지개 큐브 많이 부족하시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.366
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.376,
                "end": 7.762
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.772,
                "end": 12.382
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원 가격에 해당하는 가격인데 제가 무료로 나눠드리고 있는데 받는 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.392,
                "end": 24.094
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱을 다운로드 받으시고 우측 하단에 있는 프로필을 누르시고 우측 상단에 톱니바퀴를 누르면 시크릿 코드 입력하는 데가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.104,
                "end": 34.131
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오ND러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.141,
                "end": 38.551
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 앱은 도대체 어떤걸까 자 여러분들이 게임만 해도 자동으로 쌓이는 잼을 가지고 자 상점에서 여러분들이 원하는 기프트 카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.561,
                "end": 49.852
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임하는데 여러분한테 따로 광고가 뜨지도 않고요 방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.862,
                "end": 55.826
            },
            {
                "speaker_id": "1",
                "transcription": "자 시크릿 코드 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.836,
                "end": 61.560
            },
            {
                "speaker_id": "1",
                "transcription": "자세한 이벤트 확인은 고정 댓글을 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.570,
                "end": 64.765
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 0티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.762,
                "end": 66.072
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 쿠키는 잼스톤능력으로 강력한 해일과 파도를 일으켜 적에게 큰 피해를 입히고 적을 밀쳐내며 기절시킵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.082,
                "end": 72.963
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤 강화로 침묵효과 및 면역대상 추가피해, 체력비례 고정피해 등이 있어서 현존하는 가장 강력한 극딜 쿠키지만 몸이 약하기 때문에 쉽게 죽는 단점이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.973,
                "end": 83.048
            },
            {
                "speaker_id": "1",
                "transcription": "스토리 모드만을 생각하면 바다요정도 잼스톤 강화를 적극적으로 활용하여 키우는 것도 좋지만 현시점에서는 블랙펄 쿠키가 아레나에서 잼스톤 활용이 더 많이 되고 있기 때문에 우선적으로 블랙펄 잼스톤 강화를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.058,
                "end": 95.943
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 라즈베리 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.953,
                "end": 98.680
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키는 낙뢰와 함께 소용돌이로 국제게 지속적인 광역딜을 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.690,
                "end": 102.975
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤 능력으로 불감옥, 적에게 공격력 감소, 바다회오리 추가피해 등과 함께 초월효과 능력 추가로 더욱 강력해졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.985,
                "end": 110.420
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키는 광역딜과 더불어 스킬 능력 사용 시 무적상태이기 때문에 이를 활용하여 강력한 딜이 들어오는 타이밍만 잘 맞추면 생존에 유리하며 굳이 스토리뿐만 아니라 다른 컨텐츠에서도 활용이 좋기 때문에 현시점에서 최우선으로 잼스톤 강화와 함께 키우면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.430,
                "end": 126.469
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 126.479,
                "end": 128.684
            },
            {
                "speaker_id": "1",
                "transcription": "락스타맛 쿠키는 아군 전체의 체력을 회복시켜 주고 버프금지 방어 버프와 자신을 제외한 아군 전체쿠키의 치명타 확률을 증가 시켜주는 버프를 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 128.694,
                "end": 136.509
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 만능형 쿠키이며 죽은 이후에도 모든 아군쿠키의 체력을 채워주는 능력이 좋기 때문에 앞으로도 장기적으로 활용할 거라 우선순위 높게 투자하여 키워주시면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 136.519,
                "end": 146.310
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 146.320,
                "end": 148.427
            },
            {
                "speaker_id": "1",
                "transcription": "파르페맛 쿠키는 아군에게 체력회복과 방어력 증가 및 해로운 효과 감소를 주고 특히나 최대체력을 초과하는 회복량일 때 체력 보호막으로 전환시켜 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 148.437,
                "end": 157.077
            },
            {
                "speaker_id": "1",
                "transcription": "마법사탕은 10강 이상일 때 좋다라는 체감이 차이가 나기 때문에 우선적으로 10강을 찍는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 157.087,
                "end": 163.047
            },
            {
                "speaker_id": "1",
                "transcription": "힘량 자체도 쿠키런 킹덤에서 단연 원탑이지만 해로운 효과 감소도 50퍼센트나 해주기 때문에 상태이상이심하게 걸리는 스테이지에서 특히나 유용하게 활용 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 163.057,
                "end": 173.249
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 173.259,
                "end": 175.492
            },
            {
                "speaker_id": "1",
                "transcription": "스냅 드래곤 쿠키는 죽지 않는 특수무적 능력을 가진 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 175.502,
                "end": 179.007
            },
            {
                "speaker_id": "1",
                "transcription": "기절저항, 해로운 효과감소, 공격력 증가, 피해감소 버프, 체력보호막 등이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 179.017,
                "end": 183.839
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤 쿠키와 함께 사용하면 드래곤 타입 체력 증가로 시너지 좋게 사용 가능하고 무과금 유저도 하루 무료 뽑기 3회로 20일 정도 투자하면 획득 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 183.849,
                "end": 193.476
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 193.486,
                "end": 195.738
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라 쿠키는 아군에게 체력회복과 체력 보호막을 주고 부상효과 디버프를 감소시켜 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 195.748,
                "end": 200.848
            },
            {
                "speaker_id": "1",
                "transcription": "사실상 좋은 에픽 힐러들이 많이 출시되어활용가치가 많이 낮아졌지만 여전히 스토리 모드에서 만큼은 힐량도 좋고 체력보호막도 유용하게 활용 가능하며 부상효과 감소 능력은 대체하기 힘든 능력이라 다른 컨텐츠를 위해서라도 반드시 키워야 되는 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 200.858,
                "end": 216.073
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
