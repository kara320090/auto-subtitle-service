        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "글쎄 실론 한방덱 보다도 좀 더 승률이 안정적인 느낌이라고 할까나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.625
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면은 여태까지는 실론 한방덱의 가장 큰 단점이 캡사이신이 올 아몬드면은 지는 그림이 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.635,
                "end": 18.109
            },
            {
                "speaker_id": "1",
                "transcription": "올 아몬드로 해서 버텨버리면은 오히려 역전 당하는 그림이 있는데 얘는 캡사이신이 혼자 남아도 상관없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.119,
                "end": 24.981
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 혼자만 버틴다고 해도 아차피 마무리되는 부분이니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.991,
                "end": 28.515
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 시청자분이 스펙 차이 지금 엄청나도 그냥 이긴다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.525,
                "end": 32.980
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 스펙 차이 엄청나도 여러분들이 이길 수 있는 그림이라 정말 좋은 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.990,
                "end": 37.723
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 지는 그림 같은데 요거는 아 이게 딱 지는 그림이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.733,
                "end": 46.100
            }
        ]
    },
    "summary": "올 아몬드로 해서 버텨버리면 오히려 역전 당하는 그림이 있는데 얘는 캡사이신이 혼자 남아도 상관없다고 남자가 설명하고 있다.",
