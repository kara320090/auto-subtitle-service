        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 뭐 이런 식으로 1억이 넘는 딜이 나오죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.217
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이런 식으로 토벌이 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 6.447,
                "end": 7.627
            },
            {
                "speaker_id": "1",
                "transcription": "아마 복귀 유저분들은 눈이 휘둥그레해질 수 있어요.",
                "sound_type": [
                    2
                ],
                "start": 7.780,
                "end": 11.295
            },
            {
                "speaker_id": "1",
                "transcription": "완전 옛날에는 토벌용에서 1억이 넘는 딜이 나온다는 건 정말 상상도 못한 일이었을 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.537,
                "end": 17.975
            },
            {
                "speaker_id": "1",
                "transcription": "보통 지금 현재 1억 3000 이렇게 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 18.127,
                "end": 20.410
            },
            {
                "speaker_id": "1",
                "transcription": "대략적으로 이렇게 알고 계시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.585,
                "end": 23.310
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에 감초 먼저 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.730,
                "end": 25.497
            },
            {
                "speaker_id": "1",
                "transcription": "요새는 어떻게 되는지 옛날에는 단계가 높아질수록 보스가 점점점 세졌죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.730,
                "end": 30.705
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제는 고정이 됐습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.880,
                "end": 32.174
            },
            {
                "speaker_id": "1",
                "transcription": "34단계 이후로는 보스의 공격력이 다 일정하게 바뀌었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.477,
                "end": 36.795
            },
            {
                "speaker_id": "1",
                "transcription": "단계가 엄청나게 높다고 센 게 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.005,
                "end": 40.750
            }
        ]
    },
    "summary": "옛날에는 토벌용에서 1억이 넘는 딜이 나온다는 건 상상도 못한 일이었지만 지금은 보통 1억 3000 정도 나오기 때문에 복귀 유저들은 놀라울 것이고 옛날에는 단계가 높아질수록 보스가 점점 세졌지만 지금은 34단계 이후로는 보스의 공격력이 다 일정하게 바뀌어서 단계가 엄청나게 높다고 보스가 센 게 아니다.",
