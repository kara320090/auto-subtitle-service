        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 2주년 홀케이크 들개단 이제 마지막 단계가 남았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.453
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 제가 밤새 리뷰할 때는 이 조합이 아니었고 달빛술사였거든요 호밀 대신에?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.463,
                "end": 11.828
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 저 보다 더 공략 잘 쓰시고 더 높은 점수를 내신 분 어 그분의 공약을 보고 저도 한번 따라 해 봤습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.838,
                "end": 21.066
            },
            {
                "speaker_id": "1",
                "transcription": "일단 뭐 간단하게 소개를 드리면은 이렇게 어 홀리베리 서버신 거 같은데 보게 되면 이분이 공략을 이렇게 알려주셨어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.076,
                "end": 29.896
            },
            {
                "speaker_id": "1",
                "transcription": "영상 댓글에 링크를 제가 걸어놓을 건데 최고가 14억 8800만 이렇게 찍으신 분입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.906,
                "end": 36.681
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 이분 공약 제가 해서 한번 가보도록 할 텐데 일단 저도 뭐 올 애플젤리로 새벽에 했었지만 어 밀키웨이까지도 올 애플젤리이고 여러분들 이게 아셔야 될게 저도 이번에 처음 알았는데 여러분 쿠키런 킹덤에는 어 피해 감소 뉴 여러분 최대 맥스 제한이 85퍼 5퍼센트 제한인 건 다들 아시는 분은 아실 텐데 쿨 타임도 최대 맥스가 정해져 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.691,
                "end": 62.628
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기 보면 쿨타임이 보면 30퍼센트가 되어있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.638,
                "end": 66.634
            },
            {
                "speaker_id": "1",
                "transcription": "시계 부분도 25퍼센트 자 그러면 30퍼센트 하고 20퍼 25퍼센트 더하면 55퍼센트죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.644,
                "end": 73.148
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 최대 맥스가 60퍼센트 제한이기 때문에 여러분들이 아무리 쿨타임을 5퍼센트 이상 넣어 넘어가도 5퍼센트",
                "sound_type": [
                    2,
