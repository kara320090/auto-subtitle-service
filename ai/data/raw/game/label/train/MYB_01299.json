        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "예약으로 하는 게 더 빠릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.771
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면은 밀키웨이 같은 거는 연타보다는 자동 예약으로 하는 게 더 빠릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.781,
                "end": 7.303
            },
            {
                "speaker_id": "1",
                "transcription": "자 5억7400 요렇게 나오게 되구요. 최대 6.2억, 최소는 4.3억",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.313,
                "end": 15.534
            },
            {
                "speaker_id": "1",
                "transcription": "자 망고 토벌들 빌드 간단하고 세팅도 뭐 어렵지는 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.544,
                "end": 19.828
            },
            {
                "speaker_id": "1",
                "transcription": "따라 해보실 분은 따라 해 보시구요. 아무래도 락스타 초월에 따라서 힐량이 따라 주지 않으면 푸른 주스가 죽을 수도 있기 때문에 피감 신경 써주시구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.838,
                "end": 28.351
            },
            {
                "speaker_id": "1",
                "transcription": "망고 토벌덱은가급적이면 망고 20강 이상인 분만 따라 해 보시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.361,
                "end": 34.748
            },
            {
                "speaker_id": "1",
                "transcription": "그전까지는 애클리어 쓰다가 갈아타시면 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.758,
                "end": 38.807
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 망고 용트벌 리뷰는 여기서 마치도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.817,
                "end": 42.621
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.631,
                "end": 59.575
            }
        ]
    },
    "summary": "밀키웨이는 연타보다는 자동 예약으로 하는 게 더 빠르고 락스타 초월에 따라서 힐량이 따라 주지 않으면 푸른 주스가 죽을 수도 있기 때문에 피감 신경 써야한다.",
