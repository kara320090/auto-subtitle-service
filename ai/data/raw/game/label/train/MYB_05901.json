                    3
                ],
                "start": 4.503,
                "end": 9.462
            },
            {
                "speaker_id": "1",
                "transcription": "네 오븐 러너도 구독, 좋아요, 알림 설정 네 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
