                    2,
                    3
                ],
                "start": 2.981,
                "end": 4.493
            },
            {
                "speaker_id": "2",
                "transcription": "아 민간요법 하라고 민간요법 이것도 구독, 좋아요 하라고 이렇게 한 거죠?",
                "sound_type": [
