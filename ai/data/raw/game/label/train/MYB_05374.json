        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 리엘님 계정 평가 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.703
            },
            {
                "speaker_id": "1",
                "transcription": "이 분 사연이 되게 긴데 일단 어떤 사연이 있냐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.713,
                "end": 6.135
            },
            {
                "speaker_id": "1",
                "transcription": "자 제 계정의 문제점을 전혀 찾지 못해서 신청하게 되었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.145,
                "end": 10.442
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 운영은 순조롭고 설탕 노움 연구소도 끊임없이 쭉 이어가고 있고 토핑작은 어쩔 수 없이 나는 손실들이 있긴 하지만 절대 절대 잊지 않고 꼬박 꼬박 하는 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.442,
                "end": 22.656
            },
            {
                "speaker_id": "1",
                "transcription": "모든 컨텐츠들을 전부 빠짐없이 완료해도 아레나에서 만큼은 실패를 뼈저리게 느끼게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.666,
                "end": 29.913
            },
            {
                "speaker_id": "1",
                "transcription": "카운트 댁으로 아무리 들어가 봐도 어째선지 항상 패배하고 100번 정도 들어가면 3번 정도 승리하는 승률이 나오기 때문에 쫌 암울하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.923,
                "end": 39.485
            },
            {
                "speaker_id": "1",
                "transcription": "모 계속 패패패패를 계속하니 이게 내 계정의 문제인가 싶어서 토핑도 바꿔가면서 가족꺼도 사용하고 연구소도 몇 번 올려 보았지만 큰 결과가를 보이지 않아서 점점 지쳐간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.495,
                "end": 53.050
            },
            {
                "speaker_id": "1",
                "transcription": "책 차이라고 하기엔 저도 나름 준수한 스펙이라고 느껴지는데 대체 무엇이 문제인지 알아내기가 힘듭니다.",
                "sound_type": [
