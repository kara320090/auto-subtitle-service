    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 스타더스트 쿠키 출시 이후에 지금 여러분들 방덱을 보게 되면은 다 2탱커가 많을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.060
            },
            {
                "speaker_id": "1",
                "transcription": "자 그럼 여러분들이 이거 파훼법 찾기가 아마 힘든 분들이 많을 텐데 스타더스트도 없고 나는 달빛도 없다 하시는 분들 또는 빙결덱은 어느 정도 키워놨는데 막막하신 분도 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.070,
                "end": 19.326
            },
            {
                "speaker_id": "1",
                "transcription": "빙결덱 자체가 무조건 승률이 좋다는 건 아니지만 제 기준으로는 한 8, 90퍼센트 정도 되거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.336,
                "end": 25.722
            },
            {
                "speaker_id": "1",
                "transcription": "빙결덱은 아직 죽지 않았다. 쓸 수는 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.732,
                "end": 28.747
            },
            {
                "speaker_id": "1",
                "transcription": "다만 어떤 게 다르냐면 기존의 빙결덱 자체는 유지력이 힘들기 때문에 모노클을 썼습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.757,
                "end": 35.711
            },
            {
                "speaker_id": "1",
                "transcription": "근데 현재는 모노클 대신에 호루라기를 써가지고 생존율 조금 더 피해 감소를 높여서 어느 정도 유지하면서 공격력 증가로 하고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.721,
                "end": 45.796
            },
            {
                "speaker_id": "1",
                "transcription": "시계 보물 같은 경우에도 만랩을 찍게 되면 일반 커먼 시계에 비해서 공격력이 5퍼센트 증가되기 때문에 만랩을 찍기 전에는 커먼 시계를 써야 되겠죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.806,
                "end": 55.584
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 세팅 같은 경우에는 좀 특이점은 이거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.594,
                "end": 58.376
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리가 이제 여러분들 아몬드 쓰는 시기는 지나갔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.386,
                "end": 62.476
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 왜 올 쿨로 쓰냐면은 빨리빨리 스킬 쿨타임을 돌려가지고 아군의 이제 피해량을 홀리베리가 가져오게 되고 그래도 불구하고 생존이 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.486,
                "end": 73.379
            },
            {
                "speaker_id": "1",
                "transcription": "소르베 같은 경우에는 쿨 여러분의 능력껏 최대한 높여주는 게 좋은 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.389,
                "end": 77.231
            },
            {
                "speaker_id": "1",
                "transcription": "피쿨 어느 정도 챙기면서 최대한 써주시면 좋고 서리 여왕 같은 경우에도 그냥 피감만 높게 여유 있으면은 공력력, 치명타 네 세팅해 주시고 예언자는 마찬가지로 항상 써 왔던 거처럼 첫 번째 소수점 첫 번째 자리가 9 가끔가다 이런 질문 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.241,
                "end": 93.753
            },
            {
                "speaker_id": "1",
                "transcription": "저는 9로 맞췄는데 왜 서리 기술이 안 나가나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.763,
                "end": 96.696
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤은 소수점 둘째 자리까지 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.706,
                "end": 99.693
            },
            {
                "speaker_id": "1",
                "transcription": "그게 반올림돼서 9로 표기될 수도 있기 때문에 9가 되는지 확인 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.703,
                "end": 104.735
            },
            {
                "speaker_id": "1",
                "transcription": "자 퓨어바닐라 같은 경우에는 쿨이 높으면 높을수록 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 104.745,
                "end": 107.664
            },
            {
                "speaker_id": "1",
                "transcription": "4아몬드 1쿨 해가지고 여러분들 쿨 높여주시는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 107.674,
                "end": 112.000
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 능력껏 높여주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 112.010,
                "end": 115.766
            }
        ]
