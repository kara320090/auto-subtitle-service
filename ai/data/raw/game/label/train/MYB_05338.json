        "term": [
            {
                "speaker_id": "1",
                "transcription": "운동 유투버 보기 시작하셨겠네요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.870
            },
            {
                "speaker_id": "1",
                "transcription": "아뇨 운동 유투버는 안 보고 따로 안 해요 안 찾아봐요 운동 유투버는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.880,
                "end": 6.149
            },
            {
                "speaker_id": "1",
                "transcription": "유산소나 가볍게 할 수 있는 거 위주로",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.159,
                "end": 10.345
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 등산 가는 거 좋아하냐구요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.355,
                "end": 12.376
            },
            {
                "speaker_id": "1",
                "transcription": "등산을 좋아하는 건 아닌 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.386,
                "end": 15.693
            },
            {
                "speaker_id": "1",
                "transcription": "닉값 못 하시네요 노 다이어트 러너",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.703,
                "end": 18.182
            },
            {
                "speaker_id": "1",
                "transcription": "이제 그 엔디를 여러분 개명을 할 때 가 됐어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.192,
                "end": 22.299
            },
            {
                "speaker_id": "1",
                "transcription": "노 다이어트 말고 엔디를 약간",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.309,
                "end": 25.910
            }
        ]
    },
    "summary": "남성은 운동 유투버는 따로 안 찾아보고 유산소나 가법게 할 수 있는 거 위주로 한다고 말한다.",
