        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 고대 쿠키 3종이 나왔지만 유일하게 좀 버프를 받지 못했던 다크 카카오를 활용한 한방덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.632
            },
            {
                "speaker_id": "1",
                "transcription": "정말 엄청나게 막강하고 여러분들이 스펙이 낮아도 랭커를 저격해서 잡을 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.777,
                "end": 15.160
            },
            {
                "speaker_id": "1",
                "transcription": "그 점에서 정말 좋은 덱이고 아마 여러분들이 이 덱을 봤을 때 블랙 펄까지 없다 하시는 분들은 오징어 먹물을 대체해서 블랙 펄 대신에 쓸 수 있고 호루라기는 저 같은 경우에는 이게 블랙 펄하고 달빛술사 이렇게 밖에 세팅을 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.485,
                "end": 29.411
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 뭐 다른 분들은 블랙 펄하고 호루라기를 캡틴 캐비아 이렇게 받아서 쓰는 분도 있다는 점 자 일단 토핑을 설명하면은 밀키웨이 같은 경우에는 쿨 타임이 17퍼센트에서 20퍼센트 사이 그리고 피감은 15퍼센트 이상 세팅이 어렵지는 않으실 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.421,
                "end": 45.230
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 세팅 해 주시고 자 다크 카카오 같은 경우에도 그 쿨 타임은 7퍼센트 이상 피감은 그냥 뭐 40퍼센트 이상 이렇게 맞춰 주시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.240,
                "end": 53.788
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 캡틴 캐비아는 쿨 3퍼센트 일단 맞추고 공속 좀 주고 나머지는 공 치에 집중한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.798,
                "end": 59.852
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 세팅하고 피감 아예 없어도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.995,
                "end": 62.167
            },
            {
                "speaker_id": "1",
                "transcription": "오히려 피감이 있으면 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.480,
                "end": 64.517
            },
            {
                "speaker_id": "1",
                "transcription": "죽어야지만 얘가 깃털 부화를 받고 빠르게 공격을 한 번 더 하는 거기 때문에 피감은 아예 주지 않는 게 중요하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.527,
                "end": 72.535
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛술사 같은 경우에는 피감 20퍼센트 이상 그다음에 공 치에 신경 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.795,
                "end": 77.952
            },
            {
                "speaker_id": "1",
                "transcription": "쿨은 있으면 좋고 없어도 상관없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.247,
                "end": 80.670
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 블랙 펄 같은 경우에도 얘는 피감이 제일 우선입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.680,
                "end": 84.222
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 있으면은 공 치 추가적으로 신경 써 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.350,
                "end": 87.612
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.624,
                "end": 89.307
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱 같은 경우에는 @계정1님이 어 제작하신 덱으로 고정 댓글에 링크가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.400,
                "end": 95.737
            },
            {
