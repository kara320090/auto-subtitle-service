        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "신 쿠가 저렇게 투자할 만큼 좋나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.685
            },
            {
                "speaker_id": "1",
                "transcription": "근데 랭커 분들은 쓰나 안 쓰나 어차피 스페셜 뽑기 기간에 그냥 다 5초월 다 만드세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.695,
                "end": 6.515
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 스펙 업도 할 겸 어차피 나중에 스펙 많이 뽑기 해놓으면은 뭐 육성 보상도 있고 이벤트도 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.525,
                "end": 13.475
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들 그 블랙펄 제도 콘텐츠 나름 내가 볼 때 그렇게 지루한 느낌은 안 드는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.485,
                "end": 19.660
            },
            {
                "speaker_id": "1",
                "transcription": "이게 나중 가서는 좀 지루해지려나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.670,
                "end": 21.312
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 버프나 이런 게 좀 다양성이 있어서 그런지 막 소다 제도나 다른 콘텐츠 맨 처음에 나왔을 때처럼 그런 반응은 제가 느껴지지는 않거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.322,
                "end": 30.022
            },
            {
                "speaker_id": "1",
                "transcription": "오 피박 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.032,
                "end": 31.666
            },
            {
                "speaker_id": "1",
                "transcription": "한 바퀴에 너무 오래 걸린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.676,
                "end": 33.471
            },
            {
                "speaker_id": "1",
                "transcription": "그것도 맞는 말이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.481,
                "end": 34.751
            },
            {
                "speaker_id": "1",
                "transcription": "한 보니까 한 30분?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.761,
                "end": 36.020
            },
            {
                "speaker_id": "1",
                "transcription": "나름 꽤 신박하고 재밌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.030,
                "end": 37.853
            },
            {
                "speaker_id": "1",
                "transcription": "하시는데 그게 쿠키런 오븐 브레이크에 약간 랜덤 떼 탈출에서 그 아이디어를 좀 따왔더라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.863,
                "end": 46.100
            }
        ]
    },
    "summary": "랭커 분들은 스펙 업도 할 겸 육성 보상이나 이벤트를 위해서 스페셜 뽑기 기간에는 그냥 다 5초월을 만들고 블랙펄 제도 콘텐츠는 나름 지루한 느낌도 들지 않아서 좋다.",
