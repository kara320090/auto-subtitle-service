        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 원래는 이게 안 통해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.310
            },
            {
                "speaker_id": "1",
                "transcription": "원래 안 통하는데 요렇게 한방덱이 허브가 있는데도 불구하고 통한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.320,
                "end": 9.238
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 오먹은 피감을 아까 제가 29퍼센트를 줘도 어차피 죽긴 죽어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.248,
                "end": 13.849
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들 그냥 공치에 올인하는 것도 나쁘지 않습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.859,
                "end": 16.858
            },
            {
                "speaker_id": "1",
                "transcription": "자 허브 맛 쿠키로 한방덱을 막는 시대는 끝났다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.868,
                "end": 21.020
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기에 이제 허브가 올지 허브가 아닐지 아 허브 잘 만났네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.030,
                "end": 26.535
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방분이 이제 허브가 되어 있는데 보통은 이제 낚시죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.545,
                "end": 30.332
            },
            {
                "speaker_id": "1",
                "transcription": "낚시 용도로도 많이 썼지만 뭐 지금은 진지하게 낚시 아니더라도 네 이렇게 썼는데 잠만 이거 좀 위험하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.342,
                "end": 40.533
            }
        ]
    },
    "summary": "남성은 게임을 하면서 어떤 세팅으로 하면 이길 수 있는지 설명한다.",
