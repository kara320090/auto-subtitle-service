        "term": [
            {
                "speaker_id": "1",
                "transcription": "차마 쟤는 안 쓸래",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.071
            },
            {
                "speaker_id": "1",
                "transcription": "아 다 뽑으러",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.081,
                "end": 7.472
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기서 제발 아 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.472,
                "end": 11.417
            },
            {
                "speaker_id": "1",
                "transcription": "아니 잠깐만 이것도 제한이 있네 야 이거 제한은 좀 심했다 야 보뽑 제한까지는 좀 심했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.427,
                "end": 17.778
            },
            {
                "speaker_id": "1",
                "transcription": "아 야 이거 무화과 써야 되냐 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.788,
                "end": 20.798
            },
            {
                "speaker_id": "1",
                "transcription": "아 눈물난다 진짜 아 아 진짜 진지하게 리세하고 싶어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.808,
                "end": 25.437
            },
            {
                "speaker_id": "1",
                "transcription": "아 무화과 좋네요 예 이렇게 해 보니까 또 무화과가 다른 느낌으로 좋 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.447,
                "end": 30.836
            },
            {
                "speaker_id": "1",
                "transcription": "우와 무화과가 이렇게 좋게 느껴지다니 색다른 걸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.846,
                "end": 36.037
            },
            {
                "speaker_id": "1",
                "transcription": "야 토핑 열렸다 여러분들 옛날에 초창기 때 힐러들 라즈 쓴 거 아세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.047,
                "end": 41.916
            },
            {
                "speaker_id": "1",
                "transcription": "옛날 옛적에는 허브맛 쿠키가 라즈 쓰는 시절도 있었답니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.926,
                "end": 47.160
            },
            {
                "speaker_id": "1",
                "transcription": "걔넨 옛날에는 랭커분들이 이게 정답이다하면 그게 정답인 시절이라",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.160,
                "end": 52.508
            },
            {
                "speaker_id": "1",
                "transcription": "야 못 깬다 이거 와 클났다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.518,
                "end": 59.100
            }
        ]
    },
    "summary": "무화과를 안 쓰려고 했는데 써 보니 색다르고 생각보다 좋다.",
