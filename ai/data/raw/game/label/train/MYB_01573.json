    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 지금부터 승리 공식을 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.258
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 이제 티어가 낮은 데에서는 아마 거의 스펙이 조금 높으면은 무지성을 올라오시면 될 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.268,
                "end": 11.189
            },
            {
                "speaker_id": "1",
                "transcription": "이제 어느 정도 조금만 올라오시면은 자 어느 정도 조합의 틀이 나오기 시작합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.199,
                "end": 16.129
            },
            {
                "speaker_id": "1",
                "transcription": "대표적으로 지금 형식이 어떻게 나오냐면은 정석덱이 이렇게 나와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.139,
                "end": 20.179
            },
            {
                "speaker_id": "1",
                "transcription": "2가지 형식으로 홀리베리 와베 형식의 정석덱 홀리베리 용과 정석덱 크게 여러분들이 딱 들어갔을 때 2가지 형식으로 딱 먼저 첫 번째로 구분하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.189,
                "end": 30.554
            },
            {
                "speaker_id": "1",
                "transcription": "1단계가 홀리베리 용과냐 홀리베리 와베냐 제일 구분할 게 첫 번째 단계고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.564,
                "end": 35.637
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 와베다 상대방분이 무조건 한방덱이 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.647,
                "end": 39.932
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때 도넛 찰스덱 있죠 이 도넛 찰스 한방덱이 실론나이트 한방덱을 이깁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.942,
                "end": 45.422
            },
            {
                "speaker_id": "1",
                "transcription": "매칭을 이렇게 해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.432,
                "end": 46.951
            },
            {
                "speaker_id": "1",
                "transcription": "실론나이트 한방덱이랑 도찰 한방덱이랑 순서를 맞춰주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.961,
                "end": 51.209
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀 와베덱은 제 정석덱이랑 매칭을 해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.219,
                "end": 54.682
            },
            {
                "speaker_id": "1",
                "transcription": "웬만해서는 지지 않는 상성으로 이길 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.692,
                "end": 58.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 두 번째 상대방이 홀리베리 용과덱일 경우 제 덱이랑 똑같은 경우죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.316,
                "end": 63.679
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 경우에는 어떻게 하냐 자 이 실론나이트 한방덱은 공속덱으로 들어가주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.689,
                "end": 68.746
            },
            {
                "speaker_id": "1",
                "transcription": "제 공속덱으로 매칭을 순서를 이렇게 맞춰주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.756,
                "end": 72.240
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 상대방 공속덱은 제 정석덱으로 맞춰주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.250,
                "end": 76.277
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 끝이 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.287,
                "end": 77.807
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 상성을 맞춰서 들어가시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.817,
                "end": 80.674
            },
            {
                "speaker_id": "1",
                "transcription": "자 한 번 실전으로 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.684,
                "end": 82.969
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방이 용 홀이죠 이렇게 정석덱을 먼저 기준으로 분류하시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.979,
                "end": 88.531
            },
            {
                "speaker_id": "1",
                "transcription": "자 한방덱에 공속덱을 넣어주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.541,
                "end": 91.175
            },
            {
                "speaker_id": "1",
                "transcription": "상대방 공속덱에는 제 정석덱을 넣어주시고 가면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.185,
                "end": 96.185
            },
            {
                "speaker_id": "1",
                "transcription": "대난투는 상성에 따라 승률이 엄청나게 차이가 나기 때문에 아 맞춰서 들어 가주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.195,
                "end": 106.066
            }
        ]
    },
    "summary": "상대방 덱에 자신의 어떤 덱 조합을 넣어야 하는지 설명하고 있다.",
