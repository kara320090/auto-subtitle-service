        "term": [
            {
                "speaker_id": "1",
                "transcription": "먼저 0티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.539
            },
            {
                "speaker_id": "1",
                "transcription": "크림슨코랄 쿠키는 스페어로 강하게 상대를 찔러 적에게 피해를 주는 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.549,
                "end": 6.157
            },
            {
                "speaker_id": "1",
                "transcription": "본인을 제외한 공격력이 가장 높은 아군 둘에게 물속성 스킬 피해량의 일부만큼 체력 보호막을 걸어줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.167,
                "end": 12.903
            },
            {
                "speaker_id": "1",
                "transcription": "또한 혼자 전방에 참여할 경우 피해 반사와 피해 감소 버프를 받습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.913,
                "end": 17.329
            },
            {
                "speaker_id": "1",
                "transcription": "이것뿐 아니라 방어력 감소 저항, 피해 감소 증가, 치명타 피해 감소 증가, 버프 금지 방어, 패시브로 피해 감소 효과 30퍼센트 증가 등 현존하는 가장 사기적인 능력은 다 붙어 있다고 할 정도로 대체 불가 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.339,
                "end": 32.098
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 울 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.108,
                "end": 34.752
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키는 낙뢰와 함께 소용돌이로 적에게 지속적인 광역딜을 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.762,
                "end": 39.149
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤 강화를 통해 물 감옥, 공격력 감소, 바다 회오리 추가 피해 등을 줄 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.159,
                "end": 44.628
            },
            {
                "speaker_id": "1",
                "transcription": "리더 효과 설정을 통해 적의 스킬 피해 감소 무시가 현시점에서 가장 사기적이기 때문에 잼스톤 강화를 우선적으로 하시는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.638,
                "end": 52.468
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 무난하게 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.478,
                "end": 55.253
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 쿠키는 물줄기를 쏘아 적에게 피해를 주고 기절시킵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.263,
                "end": 58.946
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤 강화시 거대한 해일과 파도를 일으켜 강력한 피해를 주고 침묵 효과와 추가 피해도 더 받습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.956,
                "end": 65.675
            },
            {
                "speaker_id": "1",
                "transcription": "현시점에서 0티어라는 기준은 고초월과 잼스톤 레벨이 20강 이상의 스펙을 말하는 것이고 일반적으로 바다요정 스펙이 낮은 분들은 바다요정보다도 달빛술사가 더 활용하기 좋을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.685,
                "end": 78.639
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정은 아레나에서는 올 쿨 토핑으로 쓰이지만 무난하게 스토리에서 쓸 때는 올 라즈베리 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.649,
                "end": 85.322
            },
            {
                "speaker_id": "1",
                "transcription": "락스타맛 쿠키는 아군 전체의 체력을 회복시켜 주고 버프 금지 방어 버프와 자신을 제외한 아군의 치명타 확률 증가 버프를 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.332,
                "end": 92.618
            },
            {
                "speaker_id": "1",
                "transcription": "특히 전투 불능 상태가 될 경우 모든 디버프를 제거하고 순간적으로 모든 아군에게 엄청난 체력 회복을 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.628,
                "end": 99.116
            },
            {
                "speaker_id": "1",
                "transcription": "현재는 용과드래곤, 홀리베리와 블랙펄 쿠키, 스냅드래곤 쿠키와 함께 투탱 조합으로 많이 사용되고 있고 1분 타이밍 맞춰서 락스타의 피해 감속 수치를 조절해서 적절한 타이밍에 가장 먼저 죽게 만든다면 락스타맛 쿠키를 제외한 모든 아군 쿠키들이 체력이 거의 없더라도 깃털 부활한 느낌으로 체력을 다 채워주기 때문에 아레나에서 활용하기 좋은 쿠키 중 하나입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.126,
                "end": 119.376
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 일반적으로 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 119.386,
                "end": 122.188
            },
            {
                "speaker_id": "1",
                "transcription": "파르페맛 쿠키는 아군에게 체력 회복과 방어력 증가 및 해로운 효과 감소를 주고 특히나 최대 체력을 초과하는 회복량일 때 체력 보호막으로 전환시켜 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 122.198,
                "end": 130.458
            },
            {
                "speaker_id": "1",
                "transcription": "또한 자기 자신과 공격력이 높은 쿠키 1명에게 디버프 면역을 부여해 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 130.468,
                "end": 134.753
            },
            {
                "speaker_id": "1",
                "transcription": "일반적으로 아레나에서 사용하려면 마법 사탕은 최소 10강 이상 추천드리고 현재는 스냅드래곤 쿠키와 함께 사용하거나 락스타맛 쿠키와 함께 사용하면 덱의 안전성을 크게 올려주기 때문에 투힐 조합으로 다양하게 활용됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 134.763,
                "end": 146.527
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑을 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 146.537,
                "end": 148.726
            },
            {
                "speaker_id": "1",
                "transcription": "스냅드래곤 쿠키는 죽지 않는 특수 무적 능력을 가진 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 148.736,
                "end": 151.799
            },
            {
                "speaker_id": "1",
                "transcription": "기절 저항, 해로운 효과 감소, 공경력 증가, 피해 감소 버프, 체력 보호막 버프 능력을 가진 힐러 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 151.809,
                "end": 158.020
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 이번에 블랙펄 쿠키 잼스톤이 출시되면서 리더 효과로 피해 감소 무시 능력이 엄청나게 중요해지면서 스냅드래곤의 10초 동안 15퍼센트 피해 감소 증가 버프 능력이 중요하게 활용되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 158.030,
                "end": 168.961
            },
            {
                "speaker_id": "1",
                "transcription": "스냅드래곤은 용과드래곤과 함께 사용하면 드래곤 타입 체력 증가로 시너지 좋게 사용가능하며 정석 덱에 1힐러 조합 또는 파르페와 락스타맛 쿠키와 각각 함께 사용되어 2 힐러 조합으로 활용되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 168.971,
                "end": 180.340
            },
            {
                "speaker_id": "1",
                "transcription": "무과금 유저도 노움 연구소에서 하루 무료 뽑기 3회로 20일 정도 투자하면 획득 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 180.350,
                "end": 185.893
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 185.903,
                "end": 188.224
            },
            {
                "speaker_id": "1",
                "transcription": "용과드래곤 쿠키는 강력한 광역 브레스로 상대방에게 큰 피해를 주는 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 188.234,
                "end": 192.409
            },
            {
                "speaker_id": "1",
                "transcription": "상대방에게 공격력과 회복 감소를 주고 자신에게는 치명타 학률과 피해 감소를 증가시켜 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 192.419,
                "end": 197.736
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 1분 100퍼센트 공격력 증가 타이밍을 노려서 쿨 타임 조절을 통해 상대 쿠키를 한 방에 녹여버리는 세팅을 가장 많이 활용합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 197.746,
                "end": 205.342
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 라즈베리 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 205.352,
                "end": 207.754
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 쿠키는 적들에게 피해 증가와 수면 디버프를 걸고 달빛 피해를 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 207.764,
                "end": 212.494
            },
            {
                "speaker_id": "1",
                "transcription": "최근에는 3딜 조합으로 달빛술사, 스타더스트, 블랙펄, 크림슨코랄, 스냅드래곤 정석 덱 조합으로 많이 활용되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 212.504,
                "end": 219.617
            },
            {
                "speaker_id": "1",
                "transcription": "아레나뿐 아니라 스토리, 수호 성전에서도 활용 가치가 좋기 때문에 초보자분들한테 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 219.627,
                "end": 225.235
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 225.245,
                "end": 227.372
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 쿠키는 피해 집중 스킬을 통해 아군이 받는 피해량과 치명타 피해를 35퍼센트 감소시켜 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 227.382,
                "end": 233.257
            },
            {
                "speaker_id": "1",
                "transcription": "크림슨코랄 쿠키가 원탱 조합에서 최고의 쿠키가 되었지만 홀리베리 쿠키는 투탱 조합에서는 크림슨코랄보다 훨씬 더 좋기 때문에 여전히 0티어로서 활용 가치가 높습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 233.267,
                "end": 244.075
            },
            {
                "speaker_id": "1",
                "transcription": "고대의 전승 선택에서 홀리베리 쿠키가 없다면 홀리베리를 최우선으로 선택하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 244.085,
                "end": 249.295
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 249.305,
                "end": 251.532
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 쿠키는 공경력이 가장 높은 적에게 별의 표식을 부여하고 상대 쿠키들에게 범위 피해를 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 251.542,
                "end": 257.571
            },
            {
                "speaker_id": "1",
                "transcription": "별의 표식을 받은 쿠키는 공격력 감소, 버프 금지, 회복량 감소, 피해 증가를 받습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 257.581,
                "end": 262.980
            },
            {
                "speaker_id": "1",
                "transcription": "3딜러 조합이나 일반적으로 모든 정석 덱에 활용되는 쿠키라 최우선으로 키워도 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 262.990,
                "end": 267.952
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 일반적으로 올 애플젤리를 추천드리지만 아레나에서는 쿨 타임 10.3퍼센트 이상 3초 스타더스트 쿠키를 더 많이 활용합니다.",
                "sound_type": [
                    2,
                    3,
