        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 그래도 2561미터 왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.429
            },
            {
                "speaker_id": "1",
                "transcription": "아 50명 중에 9등 게임 시작 한지 한 20분도 안 되는데 나 9등 한 거야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.439,
                "end": 9.421
            },
            {
                "speaker_id": "1",
                "transcription": "나는 잘했다 그래도.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.431,
                "end": 10.771
            },
            {
                "speaker_id": "1",
                "transcription": "초보자 조별에 들어가셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.781,
                "end": 12.205
            },
            {
                "speaker_id": "1",
                "transcription": "조별 내의 유저들은 득점에 따라 랭킹이 정해집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.215,
                "end": 15.160
            },
            {
                "speaker_id": "1",
                "transcription": "코인과 트로피를 획득할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.170,
                "end": 17.231
            },
            {
                "speaker_id": "1",
                "transcription": "야 순위도 이렇게 얻을 수가 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.241,
                "end": 20.407
            },
            {
                "speaker_id": "1",
                "transcription": "암흑 속에 야 잠깐만 이거 어떻게 피해?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.417,
                "end": 23.393
            },
            {
                "speaker_id": "1",
                "transcription": "어 야 어 야 잠깐만.",
