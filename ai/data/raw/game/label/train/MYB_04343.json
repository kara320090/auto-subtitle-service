        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 커스터드 3세 얘도 얘도 한 차례 상향 먹은 쿠키거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.634
            },
            {
                "speaker_id": "1",
                "transcription": "초반에 힐러로 대체로 쓰면 나쁘진 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.644,
                "end": 7.562
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 중요한 게 아미밤 있거든요? 그걸로 비티에스 쿠키 뽑아야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.572,
                "end": 12.998
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 본격적으로 쿠폰 입력을 할 수 있는 상태가 됐죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.008,
                "end": 18.277
            },
            {
                "speaker_id": "1",
                "transcription": "자아 레벨 업 해주고 중요한 거는 여기서 보상을 받아야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.287,
                "end": 23.666
            },
            {
                "speaker_id": "1",
                "transcription": "크리스탈 1000개 요것도 좋고 퍼플 패스 자 일단 요거 여러분들 뽑기까지 다 할 거거든요? 요거 코드까지 바로 갈게요.",
                "sound_type": [
                    2,
