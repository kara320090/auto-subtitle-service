                    2,
                    5
                ],
                "start": 2.398,
                "end": 4.024
            },
            {
                "speaker_id": "1",
                "transcription": "생각보다 야 스타트 상큼해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.034,
                "end": 7.723
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키커터에서 2 달빛 나오면 정말 기분 좋을 거 같아.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.733,
                "end": 11.879
            },
            {
                "speaker_id": "1",
                "transcription": "아 달빛 관련 유튜브 보고 왔는데 토핑 정해졌나요 아직 미정입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.889,
                "end": 15.974
            },
            {
                "speaker_id": "1",
                "transcription": "아직까지는 근데 그냥 대세를 보자면은 약간 쿨토핑 쪽으로 쿨토핑 쪽으로 많이 치우치긴 했어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.984,
                "end": 23.272
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 지금 아몬드는 쓰는 사람은 거의 많이 없거 같고 라즈는 일부 유저분들이 있고 좀 많 대다수는 약간 쿨토핑 쓰는 쪽으로 기울어지긴 했으나 아직 조합이나 이런 게 정해지지 않고 계속 바뀌는 중이라 조금만 더 기다려보시는 게 나를 거 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.282,
                "end": 41.611
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 그 달빛 토핑 전용 토핑은 얻기 힘들기 때문에 빨리 빨리 쓰는 것 보다는 좀 확실하게 쓰는 게 좋은 거 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.621,
                "end": 51.300
            }
        ]
    },
    "summary": "달빛 관련 해서 토핑은 아직 정해지진 않았지만 대세를 보자면 아몬드 보다는 쿨토핑 쪽으로 기우는 경향이 있고 달빛 토핑은 얻기 힘들기 때문에 빨리 쓰는 것보다 확실하게 쓰는 게 좋겠습니다.",
