        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "요새 방덱 다 이런 식으로 많이 되어있는데 한번 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.743
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 와일드베리덱의 장점을 말씀드리면은 얘는 이제 방덱으로 좀 많이 추천 드리는데 실론나이트 한방덱을 잘 막습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.753,
                "end": 12.092
            },
            {
                "speaker_id": "1",
                "transcription": "어 확실히 와일드베리가 보호막도 있고 안정적으로 이제 쓰일 수 있어서 방덱으로는 훌륭하다 그리고 공덱으로도 여러분들이 쓸 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.102,
                "end": 21.705
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제 단점으로는 확실히 어 파훼법도 지금 나오고 있어서 기존 덱으로 뚫립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.715,
                "end": 31.671
            },
            {
                "speaker_id": "1",
                "transcription": "와베덱이 어 장점과 단점이 그래도 어느 정도 있기 때문에 어 여러분들이 실론나이트덱이랑 실론나이트 마탕이랑 와베랑 둘 중에 뭐 선택하냐고 이렇게 저한테 질문을 한다면은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.681,
                "end": 46.538
            },
            {
                "speaker_id": "1",
                "transcription": "저는 실론나이트 마탕을 우선으로 하는 걸 더 추천 드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.548,
                "end": 50.995
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 와베덱을 추천 드리고 있지만 굳이 와베덱 아니더라도 실론나이트 한방덱을 막을 수 있는 방덱은 충분히 있기 때문에 자 기존에 용과 한방덱에 썼던 로얄마가린 한방덱이 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.005,
                "end": 65.803
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 그냥 막는지 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.813,
                "end": 69.866
            }
        ]
