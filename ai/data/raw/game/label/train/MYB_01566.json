        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 각각의 상황에 맞게 제가 좀 보여드릴 건데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.424
            },
            {
                "speaker_id": "1",
                "transcription": "자 먼저 이거 2번부터 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.434,
                "end": 5.984
            },
            {
                "speaker_id": "1",
                "transcription": "1번덱은 여러분들이야 뭐 아시죠 무지성으로 다 쓰신 분들이야 상황에 맞게 들어가시면 되고요 1번은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.994,
                "end": 12.240
            },
            {
                "speaker_id": "1",
                "transcription": "자 2번 같은 경우에는 2 1 2덱 요 덱에 많이 사용하니까 이거 한번 보여드릴게요 어떤 그림으로 가는지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.250,
                "end": 18.652
            },
            {
                "speaker_id": "1",
                "transcription": "자 1 2덱 들어갈 때 얘는 상대방의 깃털 무공비글 대신에 깃털 있고 가운데 소르베가 있거나 뭐 스타더스트가 있어도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.662,
                "end": 26.926
            },
            {
                "speaker_id": "1",
                "transcription": "다만 상대방이 소르베가 있으면은 땡큐지만 어 스타더스트가 있으면은 허브 대신에 퓨바가 있는 게 더 승률이 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.936,
                "end": 37.365
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 요 덱은 이제 가운데 소르베가 가려져 있으면은 스타더스트인지 소르베인지 모르기 때문에 어 요걸로 들어가는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.375,
                "end": 48.175
            },
            {
                "speaker_id": "1",
                "transcription": "승률은 아주 좋고 이거는 누리머님 유튜버에 유튜브에 있는 조합이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.185,
                "end": 53.765
            },
            {
                "speaker_id": "1",
                "transcription": "더 자세하게 설명 듣고 싶으신 분들은 누리머님 유튜브에 가서 참고해 주시면은 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.775,
                "end": 60.444
            },
            {
                "speaker_id": "1",
                "transcription": "네 요 덱 아주 좋거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.454,
                "end": 62.373
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 낮아도 정말 좋기 때문에 이거는 2 1 2 조합에 참고해서 들어가면 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.383,
                "end": 68.246
            },
            {
                "speaker_id": "1",
                "transcription": "자 3번덱 같은 경우에는 아 스타더스트랑 달빛이 있는 경우보다는 캡사이신이랑 용과 그리고 스타더스트가 있는 경우에 승률이 높은 경향이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.256,
                "end": 80.300
            }
        ]
    },
