                ],
                "start": 7.611,
                "end": 12.663
            },
            {
                "speaker_id": "1",
                "transcription": "크탈은 다 뽑기는 안 하고 일단 먼저 로얄마가린부터 뽑기를 가 볼게요.",
                "sound_type": [
