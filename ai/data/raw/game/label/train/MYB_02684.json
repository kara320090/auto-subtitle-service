        "term": [
            {
                "speaker_id": "1",
                "transcription": "또 네 이겼네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.489
            },
            {
                "speaker_id": "1",
                "transcription": "자 요런 식으로 딜은 요렇게 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.499,
                "end": 6.601
            },
            {
                "speaker_id": "1",
                "transcription": "보시는 분들 아시겠지만 상당히 좋아 보인다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.611,
                "end": 10.084
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 안 통하는 분한테는 진짜 안 통해서 자 일단 지는 경우도 보여드릴게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.094,
                "end": 14.822
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 제가 지금 녹화 중이라 다 이기는 경우만 보여드리면 그러니까 어떤 식으로 지나 보통 지는 경우는 어떤 식으로 지냐면은 1분 지나서 달빛술사랑 블랙펄 중에 한 마리가 죽고 그리고 이제 슬슬 상대방은 다 버텨서 상대방이 딜러나 앞에 탱커가 죽으면 제가 이기는 경우가 상당수가 많은데 자 지금도 보면은 스킬이 꼬였죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.832,
                "end": 39.294
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 여러분들이 세팅 잘 못한 게 아니라 스타더스트나 달빛 술사 스킬 상태 이상 때문에 꼬여서 이렇게 나가는 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 39.304,
                "end": 46.795
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 스킬이 꼬이거나 하면은 지는 경우가 생기기도 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.805,
                "end": 51.501
            },
            {
                "speaker_id": "1",
                "transcription": "자 아까 제가 말한 데로 딱 그렇게 되죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.511,
                "end": 54.752
            },
            {
                "speaker_id": "1",
                "transcription": "어",
                "sound_type": [
                    2,
