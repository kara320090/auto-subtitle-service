        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 이런 식으로 아 근데 야 일단 그림은 이렇게 끝났요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.064
            },
            {
                "speaker_id": "1",
                "transcription": "참 비교하기가 좀 애매한 상황이긴 한데 이게 이런 그림이 나오긴 하네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.074,
                "end": 17.816
            },
            {
                "speaker_id": "1",
                "transcription": "모노클이랑 지금 신규 보물이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.826,
                "end": 20.451
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 초반에는 안정적인 거는 보장 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.461,
                "end": 24.146
            },
            {
                "speaker_id": "1",
                "transcription": "신규 보물 자체는 근데 이제 모노클은 뒤에 후반까지도 계속 체력을 더 채워 주잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.156,
                "end": 30.031
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 이제 세 번 기회 쓰면은 끝나고 그러다 보니까 아 요런 그림이 나오게 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.041,
                "end": 36.400
            }
        ]
    },
    "summary": "남성이 게임을 하고 있으며 모노클과 신규 보물을 비교하여 이야기 해 주고 있다.",
