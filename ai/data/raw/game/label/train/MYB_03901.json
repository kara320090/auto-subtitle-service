        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번에 좀 크게 바뀐 게 서리여왕이지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.328
            },
            {
                "speaker_id": "1",
                "transcription": "원래 옛날에 서리여왕 같은 거 레전드에서 뜨면은 옛날에 항상 말하던 게 왜 하필 서리여왕이야 너가 왜 나왔어 약간 이런 멘트했거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.338,
                "end": 10.704
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 이제 대우가 다르죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.714,
                "end": 12.705
            },
            {
                "speaker_id": "1",
                "transcription": "서리여왕 이제 상황 돼서 좋기 때문에 소르베랑 아주 시너리가 좋기 때문에 나오면은 대우가 다르지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.715,
                "end": 19.624
            },
            {
                "speaker_id": "1",
                "transcription": "오와 진짜 또 나왔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.634,
                "end": 22.752
            },
            {
                "speaker_id": "1",
                "transcription": "이분 뭐야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.762,
                "end": 23.720
            },
            {
                "speaker_id": "1",
                "transcription": "아니 크탈 뽑기에서 소르베가 2개가 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.730,
                "end": 27.412
            },
            {
                "speaker_id": "1",
                "transcription": "야 될 계정은 되는구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.422,
                "end": 29.762
            },
            {
                "speaker_id": "1",
                "transcription": "아 이분 소르베 2개에다가 지금 블랙폴에다가 다크카카오에다가 오이스터 2개에다가 홀베에다가 아니 너무 잘 나오는데 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.772,
                "end": 37.766
            }
        ]
    },
    "summary": "남자가 게임 속 캐릭터 서리여왕은 옛날과 다르게 요즘에는 대우가 좋다고 말하고 있다.",
