        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 보셨나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.224
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 딜러들 순삭 한 거 보셨나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.234,
                "end": 5.620
            },
            {
                "speaker_id": "1",
                "transcription": "와일드베리를 사용해서 단단하게 해도 야 보시는 거와 같이 순삭 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.630,
                "end": 12.755
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에 상대방은 자 근본 서리, 소르베 덱 제가 아레나 많이 해보니까 현재 좀 약한 덱은 저겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.765,
                "end": 20.475
            },
            {
                "speaker_id": "1",
                "transcription": "근본 소르베 덱한테 조금 약한 면을 보이지만 그래도 어느 정도 승률이 높기 때문에 자 보시는 거와 같이 순삭해서 딜러들이 없어졌습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.485,
                "end": 32.648
            },
            {
                "speaker_id": "1",
                "transcription": "네 앞에 남은 거는 탱커만 남았네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.658,
                "end": 36.295
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 덱의 또 크나큰 장점은 무승부가 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.305,
                "end": 40.358
            },
            {
                "speaker_id": "1",
                "transcription": "무승부가 없기 때문에 스트레스를 덜 받는다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.368,
                "end": 43.438
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱도 이기는지 자 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.448,
                "end": 51.708
            }
        ]
    },
    "summary": "아레나의 근본 소르베 덱한테 조금 약한 면을 보이지만 그래도 어느 정도 승률이 높기 때문에 보는 거와 같이 순삭해서 딜러들이 없어지고 탱커만 남았고 이 덱의 크나큰 장점은 무승부가 없어 스트레스를 덜 받는 것이다.",
