        "term": [
            {
                "speaker_id": "1",
                "transcription": "그냥이 안 되네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.789
            },
            {
                "speaker_id": "2",
                "transcription": "저기요 저기요 잠깐만 기다려줘요 아니 기다려 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.799,
                "end": 5.807
            },
            {
                "speaker_id": "3",
                "transcription": "당신을 풀어주는 일은 있을 수 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.817,
                "end": 8.531
            },
            {
                "speaker_id": "4",
                "transcription": "그렇지 꼴 좋군 그래.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.541,
                "end": 10.581
            },
            {
                "speaker_id": "2",
                "transcription": "어휴 말도 참 예쁘게들 하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.591,
                "end": 14.431
            },
            {
                "speaker_id": "2",
                "transcription": "그게 은인에게 할 말본새야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.441,
                "end": 16.307
            },
            {
                "speaker_id": "2",
                "transcription": "미친 공왕이 암청색 머리칼의 여자 아이들을 사냥하는 건 알고 있지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.317,
                "end": 20.198
            },
            {
                "speaker_id": "2",
                "transcription": "마침 장로 놈이 여자애들을 팔 작정으로 사냥꾼들 끌어들였단 말이지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.208,
                "end": 25.493
            },
            {
                "speaker_id": "2",
                "transcription": "거기 여자 네가 그대로 있었으면 바로 팔려갔을 걸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.503,
                "end": 28.720
            },
            {
                "speaker_id": "2",
                "transcription": "더 심한 꼴을 당했을 거라고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.730,
                "end": 32.000
            }
        ]
    },
    "summary": "올가는 미친 공왕이 암청색 머리칼의 여자 아이들을 사냥하고 있어 여자가 그대로 있었으면 바로 팔려갔을 거라 말한다.",
