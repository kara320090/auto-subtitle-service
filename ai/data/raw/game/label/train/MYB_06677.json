        "term": [
            {
                "speaker_id": "1",
                "transcription": "일주일에 뭐 글라키가 뭐지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.350
            },
            {
                "speaker_id": "1",
                "transcription": "일주일 만에 못 깨나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.360,
                "end": 4.164
            },
            {
                "speaker_id": "1",
                "transcription": "나 아케이지 아케이지랜다 그 뭐야 아모도쿠 해야 되긴 한데 아 웨딩 피치? 헐 오",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.174,
                "end": 22.098
            },
            {
                "speaker_id": "2",
                "transcription": "켁 머리 사냥꾼 놈.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.108,
                "end": 24.892
            },
            {
                "speaker_id": "3",
                "transcription": "사냥꾼? 저것들은 비인간형 인형으로 추정됩니다만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.902,
                "end": 28.947
            },
            {
                "speaker_id": "2",
                "transcription": "그래 인형이지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.957,
                "end": 30.160
            },
            {
                "speaker_id": "2",
                "transcription": "이런 일은 사람보다 인형이 더 믿음직스러우니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.170,
                "end": 33.627
            },
            {
                "speaker_id": "2",
                "transcription": "저것들에겐 도덕이나 양심 같은 건 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.637,
                "end": 35.978
            },
            {
                "speaker_id": "2",
                "transcription": "그저 명령에 따를 뿐이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.988,
                "end": 37.737
            },
            {
                "speaker_id": "4",
                "transcription": "그건 너도 마찬가지이지 않니?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.747,
                "end": 41.166
            }
        ]
    },
    "summary": "올가는 이런 일은 사람보다 인형이 더 믿음직스럽다며 저것들에겐 도덕이나 양심 같은 건 없다고 말한다.",
