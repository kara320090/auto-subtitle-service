    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이것만 쓰시면 됩니다 이거 하나만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.010
            },
            {
                "speaker_id": "1",
                "transcription": "계정 주인분 이거 트로피컬 락 토핑 받으면은 그냥 다 쿨 받으세요 쿨.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.020,
                "end": 6.743
            },
            {
                "speaker_id": "1",
                "transcription": "파르페랑 락스타랑 써야 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.753,
                "end": 10.076
            },
            {
                "speaker_id": "1",
                "transcription": "이거 이렇게라도 쓰세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.086,
                "end": 11.391
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 쿨 토핑작을 좀 더해서 홀리베리 올쿨로 피감 그래도 한 20퍼센트 이상은 맞춰주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.401,
                "end": 17.119
            },
            {
                "speaker_id": "1",
                "transcription": "이거 락스타 쿨토핑 더 받아서 락스타 피감 더 올려주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.129,
                "end": 21.790
            },
            {
                "speaker_id": "1",
                "transcription": "네 그리고 파르페가 여기 오면 더 좋거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.800,
                "end": 25.287
            },
            {
                "speaker_id": "1",
                "transcription": "오먹 대신에 파르페를 더 강화 먼저 해주세요 십강까지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.297,
                "end": 28.760
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 스냅 드래곤 써야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.770,
                "end": 31.440
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라도 없으셔가지고 지금 덱은 스토리는 안정성이 더 중요하거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.450,
                "end": 37.294
            },
            {
                "speaker_id": "1",
                "transcription": "힐러를 1마리 쓰지 말고 2마리로 가세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.304,
                "end": 40.198
            },
            {
                "speaker_id": "1",
                "transcription": "파르페 마탕 십강 하면은 더 안정적일 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.208,
                "end": 43.437
            },
            {
                "speaker_id": "1",
                "transcription": "그 요걸로 가시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.447,
                "end": 45.044
            },
            {
                "speaker_id": "1",
                "transcription": "얘 피감 더 주시고 토벌은 아예 안 하시고 계시구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.054,
                "end": 49.799
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 내가 볼 때는 스펙이 낮아서 오히려 딜러들 그냥 대체하는 게 더 잘 나올 것 같은데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.809,
                "end": 56.900
            }
        ]
    },
    "summary": "계정 주인분 트로피컬 락토핑 받으면 다 쿨 받고 파르페랑 락스타도 써야 될 것 같고 앞으로 쿨 토핑작을 더 해서 홀리베리 올쿨로 피감을 20퍼센트 이상 맞추고 락스타 쿨토핑 받아서 피감을 더 올려주며 오먹 대신 파르페를 더 먼저 강화해 주고 십강까지 여기는 스냅 드래곤 써야 되고 퓨어바닐라가 없어서 힐러를 2마리로 가고 파르페 마탕 십강 하면 더 안정적일 것이고 피감을 더 주고 스펙이 낮아서 오히려 딜러를 대체하는 게 더 잘 나올 것 같다.",
