            },
            {
                "speaker_id": "1",
                "transcription": "닻모양 이 아이템을 사용하면 이렇게 3개를 얻었죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.518,
                "end": 5.059
            },
            {
                "speaker_id": "1",
                "transcription": "3시간 단축 닻 하나 당 1시간이 단축된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.069,
                "end": 8.917
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 사용해서 개척되는 시간을 단축할 수 있죠?",
