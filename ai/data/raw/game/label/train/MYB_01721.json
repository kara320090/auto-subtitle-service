                    2,
                    3
                ],
                "start": 8.927,
                "end": 12.432
            },
            {
                "speaker_id": "1",
                "transcription": "얘를 개척하면은 이만큼의 영통을 내가 확장할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.442,
                "end": 16.751
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 더 가볼까요?",
