        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러고 해독제 이런 거는 다양한 조합에서 쓰이는 특수 경우가 있기는 하지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.018
            },
            {
                "speaker_id": "1",
                "transcription": "우선순위는 상당히 떨어지고 보물도 신규 보물이 계속 나오는 상황이기 때문에 여러분들이 선택권을 가지고 일단 집중적으로 뽑을 이유는 현재로서는 없어 보입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.028,
                "end": 15.047
            },
            {
                "speaker_id": "1",
                "transcription": "모노클이나 증표나 은포크 같은 길드 보물 같은 경우도 언젠가 뽑아 놓으면 쓰이긴 하지만 현재로서는 메인으로 쓰이지는 않고 있기 때문에 길드 뽑기권을 모아놨다가 한 번에 뽑아주시면 좋을 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.057,
                "end": 29.379
            },
            {
                "speaker_id": "1",
                "transcription": "제 생각에는 길드 보물이 이제 슬슬 나올 때가 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.389,
                "end": 33.455
            },
            {
                "speaker_id": "1",
                "transcription": "길드 보물이 나온지 6개월이 넘은 거 같아서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.465,
                "end": 35.693
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 뽑기권은 일단 모아두고 신규 보물이 나오는 거 퀘스트를 보고 그때 천천히 키우는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.703,
                "end": 44.300
            }
        ]
    },
    "summary": "남자가 쿠키런 킹덤 뽑기권을 모아놨다가 한 번에 뽑아주는 게 좋다고 말하고 있다.",
