        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 쿠키런 킹덤에서 가장 중요한 두 가지 요소 피해 감소와 공격력 2가지를 강조해서 로 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.917
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스킬 사용 시 용과 버프를 중첩하여 최대 중첩 시 스킬이 강화된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.927,
                "end": 13.800
            },
            {
                "speaker_id": "1",
                "transcription": "강화된 스킬 사용으로 용으로 변신해서 브레스를 발사해서 피해감소를 일부 무시하는 피해를 입히고 불 속성 피해 증가를 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.810,
                "end": 23.190
            },
            {
                "speaker_id": "1",
                "transcription": "용으로 변신 시 잠시 동안 치명타 확률이 증가하고 모든 디버프를 제거한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.200,
                "end": 29.455
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 좋은 걸 다 갖다 붙였네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.465,
                "end": 31.398
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이보다 더 사기적인 능력이 있을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.408,
                "end": 34.350
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤 쿠키는 드래곤 등급에게 받는 피해가 감소하고 토핑으로 증가하는 공격력에 비례하여 피해 감소가 증가한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.360,
                "end": 43.236
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제는 토핑까지 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.246,
                "end": 46.179
            },
            {
                "speaker_id": "1",
                "transcription": "가장 사기적인 쿠키가 되지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.189,
                "end": 49.053
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 시전 시간 중 스킬 끊김을 포함한 스킬 시전 방해 효과가 강해지면 브레스 사용 중 피해를 입지 않는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.063,
                "end": 55.710
            },
            {
                "speaker_id": "1",
                "transcription": "약간 침투형처럼 돌격형이지만서도 스킬 사용 시 무적 상태다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.720,
                "end": 60.885
            },
            {
                "speaker_id": "1",
                "transcription": "침투형만의 고유한 진짜 사기적인 능력 중에 하나예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.895,
                "end": 64.691
            },
            {
                "speaker_id": "1",
                "transcription": "침투형은 뱀파이어처럼 변신 시 무적이다라는 것 때문에 엄청나게 사기적인 면이 좀 더 부각될 수 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.701,
                "end": 72.622
            },
            {
                "speaker_id": "1",
                "transcription": "근데 돌격형이 변신시 무적이야 자 이제 아레나에서는 에이전트 레전드 드래곤 희귀도의 쿠키는 한 팀에 3종까지 자 그리고 또 하나 에픽 로얄마가린맛 쿠키도 출시가 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.632,
                "end": 86.558
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 침투형이네요 침투형 뭐 용과급은 아니지만 그래도",
                "sound_type": [
                    2
                ],
                "start": 86.568,
                "end": 92.333
            }
        ]
    },
    "summary": "새로 출시되는 용과맛 쿠키와 로얄마가린맛 쿠키의 특징에 대해 설명한다.",
