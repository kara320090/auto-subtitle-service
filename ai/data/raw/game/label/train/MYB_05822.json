        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 받고 나서 여러분들 중요한 게 이 여기를 누를 때 뽑기를 빨리 들어가는 게 목적이에요 저희는.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.627
            },
            {
                "speaker_id": "1",
                "transcription": "아까랑 마찬가지로 여기서 58초가 됐을 때 나가기 자 나가기를 하면은 여기에 뽑기 바로 갈 수 있는 게 생기거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.637,
                "end": 16.484
            },
            {
                "speaker_id": "1",
                "transcription": "요거를 눌러주시면 됩니다 이게 시간을 엄청나게 단축시켜 줘요 자 그렇게 되면 뽑기 할 때 여러분들 3천 3백 크리스탈과 쿠키 뽑기 커터 31개 그다음에 스페셜 쿠키 70개가 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.494,
                "end": 27.369
            },
            {
                "speaker_id": "1",
                "transcription": "요걸로 뽑기를 진행해 주시면 돼요 자 첫 번째 나오는 거는 칠리맛 쿠키 얘는 고정이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.379,
                "end": 34.161
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 나오고 또 쭉 다 뽑아볼게요 근데 여러분들이 리세마라 할 때 러너 그래서 어떠한 쿠키가 나와야지 제일 베스트로 정말 편하게 할 수 있습니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.171,
                "end": 43.675
            },
            {
                "speaker_id": "1",
                "transcription": "제가 생각할 때는 바다요정이나 아니면 다크카카오 고게 네 고게 나온 게 정말 베스트예요.",
