        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이거는 힐러가 없네요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.687
            },
            {
                "speaker_id": "1",
                "transcription": "보시겠지만 퓨어바닐라나 다른 힐러가 없이 쓰이는 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.697,
                "end": 6.082
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 힐러는 누가 하냐 자 우측 상단의 모노클이 힐러 역할을 대신해 주게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.092,
                "end": 12.652
            },
            {
                "speaker_id": "1",
                "transcription": "자 어마 무시하게 딜로 퍼붓는 네 그런 덱이고 네 자 보시면 아시겠지만 화력이 장난이 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.662,
                "end": 23.155
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방은 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.165,
                "end": 24.914
            },
            {
                "speaker_id": "1",
                "transcription": "딜러들이 거의 50초 됐을 때 순삭 돼어서 없어지는 덱입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.924,
                "end": 29.989
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 힐러가 없어도 쿠키들 전부 다 체력 꽉 차 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.999,
                "end": 35.076
            },
            {
                "speaker_id": "1",
                "transcription": "모노클의 힘으로 요렇게 깔끔하게 승리가 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.086,
                "end": 39.417
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사랑 소르베 딜이 어마 무시합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.427,
                "end": 43.541
            }
        ]
    },
    "summary": "힐러가 없이 쓰이는 덱으로 우측 상단의 모노클이 힐러 역할을 대신해 주는데 어마 무시하게 딜로 퍼붓고 화력이 세고 힐러가 없어도 쿠키들 전부 다 체력이 꽉 차있다.",
