        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 3단계까지 한방으로 갈 수 있어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.016
            },
            {
                "speaker_id": "1",
                "transcription": "야 이런 식으로 아무튼 호밀 좋네요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.026,
                "end": 7.852
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 토벌에서도 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.862,
                "end": 9.479
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 호밀 리뷰 일단 정리 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.489,
                "end": 14.836
            },
            {
                "speaker_id": "1",
                "transcription": "조합을 제가 뭐 바로 말씀드릴 순 없지만 지금 제가 리뷰한 거로는 토벌에서는 그냥 0 티어로 쓰일 거 같네요 확실히.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.846,
                "end": 23.409
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서는 조합이 좀 찾아봐야 될 거 같지만 확실히 올 라즈 딜러는 호밀 맛 쿠키의 극딜로 녹일 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.419,
                "end": 31.809
            },
            {
                "speaker_id": "1",
                "transcription": "저격용으로 쓸 수 있는 그런 덱이 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.819,
                "end": 35.115
            },
            {
                "speaker_id": "1",
                "transcription": "키워야 되냐 물어보실 게 많을 거예요. 근데 아무래도 토벌에서는 쓰일 가능성이 높아서 우유랑 호밀이랑 둘 중에 고민하신다면은 네 호밀 먼저 키우시는 게 훨씬 더 나은 판단 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.125,
                "end": 48.985
            },
            {
                "speaker_id": "1",
                "transcription": "토벌에서 우선으로 우유보다는 확실히 지금 쓰일 거 같은 상황이라",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.995,
                "end": 53.433
            }
        ]
    },
    "summary": "화자는 아레나에서는 조합을 찾아봐야 할 거 같지만 올 라즈 딜러는 호밀 맛 쿠키의 극딜로 녹여 저격용으로 쓸 수 있다고 하고 토벌에서 0티어로 쓰일 가능성이 높아서 호밀 먼저 키우는 게 좋다고 한다.",
