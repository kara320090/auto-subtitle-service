        "term": [
            {
                "speaker_id": "1",
                "transcription": "야만족한테서부터 동료를 지키려고 그 뭐지 유인하다가 죽은 거잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.620
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 머리 없는 공주도 마을 지키겠다고 혼자 성밖에 나가 가지고 원숭이 끌고 온 거 실수로 끌고 온 원숭이 끌고온 놈 있었잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.630,
                "end": 17.922
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 원숭이 유인하다가 나중에 부적만 남기고 사라졌잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.932,
                "end": 23.238
            },
            {
                "speaker_id": "1",
                "transcription": "근데 죽은 걸로 돼 가지고 장례 치뤘잖아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.248,
                "end": 26.333
            },
            {
                "speaker_id": "1",
                "transcription": "나 그때도 되게 충격적 이었거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.343,
                "end": 28.759
            },
            {
                "speaker_id": "1",
                "transcription": "무슨 심지어 어린 공준데 마을 사람은 축제를 하고 있는데 지 혼자 밖에 나갔다가.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.769,
                "end": 36.533
            }
        ]
    },
    "summary": "한 여자가 다른 게임에서 충격이었던 스토리를 말하고 있다.",
