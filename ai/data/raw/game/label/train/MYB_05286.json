        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 하필이면 무화과급을 가장 쓰레기 홀리베리 하필이면 왜 진짜 아 하필이면 많고 많은 에이션트 쿠키 중에 홀리베리 나오는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.019
            },
            {
                "speaker_id": "1",
                "transcription": "아하 야 그래도 여러분들 에픽 네 개 나오니까 뭔가 꽉 찼다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.029,
                "end": 22.455
            },
            {
                "speaker_id": "1",
                "transcription": "화면이?",
                "sound_type": [
                    2
                ],
                "start": 22.465,
                "end": 22.971
            },
            {
                "speaker_id": "1",
                "transcription": "연애할 생각 있으신가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.981,
                "end": 25.684
            },
            {
                "speaker_id": "1",
                "transcription": "때가 되면은 인연이 있겠지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.694,
                "end": 28.118
            },
            {
                "speaker_id": "1",
                "transcription": "여자 친구가 생기면은 제가 방송에서 오픈을 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.128,
                "end": 32.285
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 어느 날 제목에 중대 발표 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.295,
                "end": 35.707
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 나오면은 아 ND 러너 드디어 연애하는구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.717,
                "end": 41.388
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 보면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.398,
                "end": 42.784
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 고급으로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
