        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 꼬꼬 초코보 통구이 꼬꼬 초코보의 목을 딴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.052
            },
            {
                "speaker_id": "1",
                "transcription": "피는 꼼꼼하게 빼자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.062,
                "end": 7.852
            },
            {
                "speaker_id": "1",
                "transcription": "머리와 다리를 자르고 내장을 꺼낸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.862,
                "end": 10.487
            },
            {
                "speaker_id": "1",
                "transcription": "고기를 깨끗하게 씻는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.497,
                "end": 12.186
            },
            {
                "speaker_id": "1",
                "transcription": "물, 와인, 꿀, 소금, 제철 향초 향신료를 섞어서 양념을 만든다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.196,
                "end": 17.107
            },
            {
                "speaker_id": "1",
                "transcription": "시원한 곳에서 하루 동안 양념에 재워 둔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.117,
                "end": 19.691
            },
            {
                "speaker_id": "1",
                "transcription": "양념에서 꺼낸 고기의 뱃속에 빵과 나무 열매를 넣는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.701,
                "end": 23.216
            },
            {
                "speaker_id": "1",
                "transcription": "약불로 천천히 굽는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.226,
                "end": 25.344
            },
            {
                "speaker_id": "1",
                "transcription": "꼬꼬 초코보 통구이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.354,
                "end": 28.066
            }
        ]
    },
    "summary": "꼬꼬 초코보 통구이의 레시피를 읽는다.",
