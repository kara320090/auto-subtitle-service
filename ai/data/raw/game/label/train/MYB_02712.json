        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 본 게임 전부 다 고급으로 가봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.274
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 그 질문도 있더라 @이름1 저 달빛 레전드 스킨 뽑기 저거 한정 스킨 지나면 나중에 못 뽑나요 하시는데 저 기간 지나면 나중에 이제 일반 스킨 뽑기에 나와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.284,
                "end": 17.012
            },
            {
                "speaker_id": "1",
                "transcription": "아 퓨바도 뽑아 달라고요? 알겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.022,
                "end": 19.131
            },
            {
                "speaker_id": "1",
                "transcription": "그런 글도 봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.141,
                "end": 20.480
            },
            {
                "speaker_id": "1",
                "transcription": "카페에 글도 너무 쿠폰만 달라고 징징댄다 이런 식으로 막 싸우는 분들 있던데 그런데 이게 재화 수급이 안 돼서 그래 잘 스펙 낮은 분들 입장에서는 어떻게든 쿠폰이라도 입력해서 조금이라도 크탈 벌어가지고 뽑기를 해야 되는데 워낙 킹덤 자체는 크탈 벌기가 힘들어요, 스펙 낮으면.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.490,
                "end": 40.038
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 심정이 이해는 가",
