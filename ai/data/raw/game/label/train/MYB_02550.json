                ],
                "start": 0.000,
                "end": 1.469
            },
            {
                "speaker_id": "1",
                "transcription": "푸른 주스가 만약에 죽는 분들은 피감을 좀 더 높여 주시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.479,
                "end": 5.615
            },
            {
                "speaker_id": "1",
                "transcription": "자 쭉쭉 돌고 그 다음에 또 자동 한번 더 걸고 나서 해도 되는데 저처럼 그냥 아무거나 스킬 쿨 돌아오는대로 쓰다가 어 하셔도 되고 그 다음에 또 스킬 한번 자동스킬 풀고 해야 되는 부분이 여기 20초 부분이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.625,
                "end": 23.515
            },
            {
                "speaker_id": "1",
                "transcription": "이 부분에서도 퓨바 스킬 쓰지 마세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.525,
                "end": 26.333
            },
            {
                "speaker_id": "1",
                "transcription": "딜을 맞고 씁니다.",
