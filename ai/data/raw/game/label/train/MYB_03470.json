        "term": [
            {
                "speaker_id": "1",
                "transcription": "일단 기본 재료는 생산 잘하고 계시잖아요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.520
            },
            {
                "speaker_id": "1",
                "transcription": "이거 좀 귀찮더라도 접속해서 앞에 거 잘 눌러 주시는 수밖에 없는 거 같아요.",
                "sound_type": [
