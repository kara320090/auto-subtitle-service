        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 이거 이거 데모 맞아요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.392
            },
            {
                "speaker_id": "1",
                "transcription": "엄청 하기 전에 생각해 보니까 데모 같잖아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.402,
                "end": 5.519
            },
            {
                "speaker_id": "1",
                "transcription": "망가진 인형 원래 평상시의 나라면 망가진 인형은 거들떠도 안 봤을 텐데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.529,
                "end": 11.838
            },
            {
                "speaker_id": "1",
                "transcription": "개무섭잖아 뭔가",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.848,
                "end": 13.275
            },
            {
                "speaker_id": "1",
                "transcription": "그죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.285,
                "end": 14.635
            },
            {
                "speaker_id": "1",
                "transcription": "귀신 씌일 거 같고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.645,
                "end": 17.664
            },
            {
                "speaker_id": "1",
                "transcription": "아무것도 없나요 그냥 아이템 먹는 데 구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.674,
                "end": 22.483
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 패드로 하니까 그래서 그런 건지 모르겠는데 되게 움직이는 것도 부드럽고 진짜 잘 만들었다고 생각이 들어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.493,
                "end": 28.804
            },
            {
                "speaker_id": "1",
                "transcription": "원래 어디에 막 부 막 부딪혀 가지고 잘 진행 안 되고 막 이런 거 많잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.814,
                "end": 33.170
            },
            {
                "speaker_id": "1",
                "transcription": "근데 되게 잘 가진다 스무스하게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.180,
                "end": 35.226
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 한 디테일",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.236,
                "end": 46.966
            }
        ]
    },
    "summary": "망가진 인형은 무섭기 때문에 평상시면 안 봤을 것이고 패드로 하는데 움직이는 것이 부드럽고 잘 만들었다고 생각합니다.",
