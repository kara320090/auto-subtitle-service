        "term": [
            {
                "speaker_id": "1",
                "transcription": "쉽게 죽지는 않았죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.572
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지만 이렇게 끝이 났습니다 200층까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.582,
                "end": 5.260
            },
            {
                "speaker_id": "1",
                "transcription": "자 202층도 가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.270,
                "end": 8.464
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 200층 넘어서는 엄청 좀 딜이 그래도 어 기존보다는 좀 세기는 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.474,
                "end": 15.629
            },
            {
                "speaker_id": "1",
                "transcription": "차이가 좀 있긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.643,
                "end": 17.640
            },
            {
                "speaker_id": "1",
                "transcription": "예 아직까지는 뭐 버티면서 올라가는데 아마 스펙이 좀 낮은 분들 입장에서는 어 좀 토핑에 아몬드나 이런 거 둘둘 말고 방어적으로 하기보다는 공격적으로 이렇게 세팅해서 오는 게 나은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.630,
                "end": 33.728
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이렇게 갈림길에서 보상을 봐도 뭐 큰 차이가 나지 않는 느낌이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.738,
                "end": 39.110
            },
            {
                "speaker_id": "1",
                "transcription": "보상 자체는 확실히 이 아군 쿠키들이 가만히 멍 때리고 딜 다 받아주면은 풀스펙이라도 죽는 건 똑같은데 그냥 딜찍누 예 이런 식으로 올라가 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.120,
                "end": 56.328
            },
            {
                "speaker_id": "1",
                "transcription": "자 203층도 이요 자 일단 쭉 가서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.338,
                "end": 66.541
            }
        ]
    },
