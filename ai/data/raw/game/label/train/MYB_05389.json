    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 공속이 크림 유니콘이랑 이렇게 흑당한테 받아야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.969
            },
            {
                "speaker_id": "1",
                "transcription": "아까 전 판은 제가 실수로 얘를 망토 적용을 예 고려를 안 해 줬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.979,
                "end": 10.090
            },
            {
                "speaker_id": "1",
                "transcription": "이걸로 쭉 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.100,
                "end": 13.305
            },
            {
                "speaker_id": "1",
                "transcription": "야 깔끔하게 이기는 것 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.315,
                "end": 22.315
            },
            {
                "speaker_id": "1",
                "transcription": "저 아까 세팅 보셨지만 얘네들 피감이 높게 세팅이 되진 않았거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.325,
                "end": 28.551
            },
            {
                "speaker_id": "1",
                "transcription": "쿨만 되게 좀 중요하게 세팅이 됐는데 요런 식으로 이기는 그림이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.561,
                "end": 34.317
            },
            {
                "speaker_id": "1",
                "transcription": "와 어마무시하죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.327,
                "end": 35.780
            },
            {
                "speaker_id": "1",
                "transcription": "이게 여러분들 제가 올 애플젤리가 갑자기 뜬금없이 웬 소리냐 하실 텐데 지금 보시면 힐량 차이가 어아무시합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.790,
                "end": 41.713
            },
            {
                "speaker_id": "1",
                "transcription": "거의 이게 30퍼센트 40퍼센트 정도 더 나오는 느낌이라 벤파가 있으면 사실 이거 아몬드로 해서 크림 유니콘 가는 게 더 나을 거 같긴 한데 일단 가 볼게요. 이것도",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.723,
                "end": 51.572
            },
            {
                "speaker_id": "1",
                "transcription": "야 이게 또 그림상 힐량이 정말 크림 유니콘에 올 애플젤리 쓸 생각을 한 거 자체가 어 레전드입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.582,
                "end": 63.584
            },
            {
                "speaker_id": "1",
                "transcription": "어마무시한 그런 컨셉",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.594,
                "end": 67.100
            }
        ]
    },
    "summary": "피해감소는 높게 세팅하지 않고 쿨만 중요하게 세팅해도 이기는 그림이 나오는데 이때 유니콘과 애플젤리를 쓴 것이 어마무시한 컨셉이다.",
