        "term": [
            {
                "speaker_id": "1",
                "transcription": "수백년 전 나타났던 전설의 붉은 용이 용의협곡 가장 높은 화산 꼭대기에서 솟아났다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.518
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 그 용이 포효하며 협곡의 부족과 주변 마음을 마구잡이로 불태우고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.528,
                "end": 13.510
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 그게 용과 드래곤 쿠키 네가 아니라고?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.520,
                "end": 20.004
            },
            {
                "speaker_id": "2",
                "transcription": "쉽게 바스라지는 쿠키들을 마구잡이로 불태우는 건 내 취향이 아니거든.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.014,
                "end": 25.800
            }
        ]
    },
    "summary": "수백년 전에 나타났던 붉은 용이 용의협곡 가장 높은 꼭대기에 다시 나타나 쿠키 부족들과 마음을 불태웠다.",
