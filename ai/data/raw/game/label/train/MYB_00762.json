    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 섬네일을 보고 들어오신 분들 아니 박하사탕 맛 쿠키가 쓰인다고요라고 생각하는 분들 실제로 박하사탕 맛 쿠키가 아레나에서 엄청나게 잘 활용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.989
            },
            {
                "speaker_id": "1",
                "transcription": "자 방어 기록만 보더라도 박하사탕 자 수많은 박하사탕 맛 쿠키가 실제로 공덱에 랭커분들이 사용되고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.999,
                "end": 19.654
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 오늘 영상은 박하사탕 맛 쿠키를 활용한 아레나 조합 그리고 이것을 대체할 수 있는 파르페 조합까지 제가 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.664,
                "end": 29.112
            },
            {
                "speaker_id": "1",
                "transcription": "자 박하사탕 맛 쿠키가 갑자기 왜 쓰이냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.122,
                "end": 32.049
            },
            {
                "speaker_id": "1",
                "transcription": "자 기존에는 쿨토핑 세팅으로 아레나에서 써보려는 시도가 있었지만 자 이렇게 용과 드래곤을 활용한 2탱덱에서 만약에 박하사탕 맛 쿠키를 쓰게 된다면 활용 가치가 떨어지게 되는데 그 이유가 상대방이 만약에 용과 드래곤이 있다면 용과 브레스를 맞고 죽는 경우가 대다수가 많았기 때문에 2탱으로 활용할 때는 박하사탕 맛 쿠키가 활용 가치가 매우 낮고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.059,
                "end": 56.627
            },
            {
                "speaker_id": "1",
                "transcription": "지금 박하사탕 맛 쿠키가 쓰이는 이유는 자 1탱 코랄덱에서 상대가 극딜 조합일 때 3딜덱일 때 박하사탕 맛 쿠키가 올쿨 세팅이면은 죽지만 네 올 아몬드로 한 번 버티고 피해 감소와 해로운 효과 감소 버프 부여 그리고 아군 쿠키에게 체력 보호막 부여 자 한마디로 아군한테 보호해주는 능력과 스냅 드래곤의 피해 감소 증가 버프 상대방의 극딜덱한테 카운터 조합으로 어 활용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.637,
                "end": 85.251
            },
            {
                "speaker_id": "1",
                "transcription": "자 먼저 토핑 세팅을 보게 되면 무드, 호루라기, 시계고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.261,
                "end": 88.753
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 호루라기는 블랙펄과 스타 더스트한테 가면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.763,
                "end": 91.825
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 러너님 저는 코랄이 없는데 이 자리 대체 없나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.842,
                "end": 95.440
            },
            {
                "speaker_id": "1",
                "transcription": "코랄이 없으면은 홀리베리를 쓰셔야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.457,
                "end": 98.399
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리를 쓰시면 승률이 많이 떨어질 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.409,
                "end": 101.220
            },
            {
                "speaker_id": "1",
                "transcription": "코랄보다 뒤쪽에 보호해주는 능력이 현저하게 떨어집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.340,
                "end": 105.120
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 블랙펄 없으면은 대체 불가능한가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.172,
                "end": 108.307
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄은 대체가 불가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 108.318,
                "end": 110.292
            },
            {
                "speaker_id": "1",
                "transcription": "자 리더 효과의 피해 감소 무시 때문에 리더 효과 설정만으로도 차이가 엄청 크고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.330,
                "end": 115.740
            },
            {
                "speaker_id": "1",
                "transcription": "스타 더스트도 마찬가지 대체가 불가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 115.750,
                "end": 119.003
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 조합에서 가장 핵심적으로 상대방의 공격력이 가장 높은 적한테 별의 표식과 엄청난 피해량을 주기 때문에 아 얘도 대체가 불가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 119.013,
                "end": 129.932
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 같은 경우에는 세트 효과 포함해서 21.3퍼센트 이상 스타 더스트는 3초 스타 더스트 쿨타임은 10.3퍼센트 이상 자 블랙펄은 세트 효과 제외하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 129.942,
                "end": 142.607
            },
            {
                "speaker_id": "1",
                "transcription": "이거 제외하고 23퍼센트 이상 그래야만 스킬 순서가 블랙펄 그리고 스타 더스트 순서대로 이렇게 나가는 형태가 보여야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 142.620,
                "end": 153.280
            },
            {
                "speaker_id": "1",
                "transcription": "자 박하사탕 맛 쿠키는 올 아몬드 쿨은 여러분들 능력에 맞게 높으면 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 153.310,
                "end": 158.767
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 된다면 체력이나 치명타 피해 감소 부옵션 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 158.777,
                "end": 163.449
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅 드래곤은 올쿨로 세팅을 해주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 163.459,
                "end": 166.965
            },
            {
                "speaker_id": "1",
                "transcription": "자 가급적이면은 쿨타임은 높게 세팅하시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 166.975,
                "end": 170.676
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕 맛 쿠키 안 키웠는데 그럼 지금 키우라는 소리인가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 170.686,
                "end": 174.337
            },
            {
                "speaker_id": "1",
                "transcription": "아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 174.347,
                "end": 175.065
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕 맛 쿠키 활용이 이렇게 된다는 걸 이번 영상을 통해서 알려드린 거고 없어도 파르페로도 쓸 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 175.075,
                "end": 182.542
            },
            {
                "speaker_id": "1",
                "transcription": "자 나머지 세팅은 다 동일하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 182.560,
                "end": 184.590
            },
            {
                "speaker_id": "1",
                "transcription": "파르페 같은 경우에도 올 아몬드 쿨 높게 세팅을 해주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 184.620,
                "end": 190.205
            },
            {
                "speaker_id": "1",
                "transcription": "다만 박하사탕이 좋나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 190.217,
                "end": 191.905
            },
            {
                "speaker_id": "1",
                "transcription": "파르페가 좋나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 191.927,
                "end": 192.997
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 상대 쿨타임에 따라서 승률이 조금 다른 경향이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 193.007,
                "end": 197.915
            },
            {
                "speaker_id": "1",
                "transcription": "저도 여러 판 돌려봤지만 박하사탕 맛 쿠키를 쓴다고 승률이 무조건 좋거나 그런 거는 아니라는 점 예 방덱을 보면 파르페 쓰는 분, 박하사탕 쓰는 분 이렇게 나눠지지만 박하사탕 써도 뚫리고 파르페를 써도 제가 뚫리는 상황이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 197.927,
                "end": 213.108
            },
            {
                "speaker_id": "1",
                "transcription": "자 제 방덱으로 테스트를 해보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 213.118,
                "end": 215.434
            },
            {
                "speaker_id": "1",
                "transcription": "현재 1탱 3딜 극딜덱이 방덱으로 많이 보이고 바다 요정 대신에 달빛 술사 있는 경우도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 215.444,
                "end": 223.566
            }
        ]
    },
    "summary": "영상에서는 박하사탕 맛 쿠키가 아레나에서 잘 활용되는 이유와 박하사탕 조합을 설명하고 있고 박하사탕이 없는 경우에는 파르페 조합을 이용해 활용하는 방법을 설명하고 있다.",
