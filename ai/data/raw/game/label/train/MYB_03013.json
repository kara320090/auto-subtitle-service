                ],
                "start": 0.000,
                "end": 11.281
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 좋게 활용되고 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.291,
                "end": 13.075
            },
            {
                "speaker_id": "1",
                "transcription": "요거 여러분들이 봐주시면 될 거 같아요.",
