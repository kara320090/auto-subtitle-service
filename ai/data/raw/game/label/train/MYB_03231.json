        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 약간 좀 빌드가 꼬였는데 일단 요렇게 자 아무튼 요렇게 해서 1.6억 이상 뭐 1.7억까지도 나오는 그런 상황이 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.077
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프 혼자 비정상적으로 뭐 1억까지도 나오거든요?",
                "sound_type": [
                    2
                ],
                "start": 9.420,
                "end": 12.317
            },
            {
                "speaker_id": "1",
                "transcription": "그만큼 웨어울프의 마법 사탕을 되게 중요하게 여러분들이 강화하시면 될 것 같아요.",
                "sound_type": [
                    2
                ],
                "start": 12.607,
                "end": 18.115
            },
            {
                "speaker_id": "1",
                "transcription": "점수 차이가 10강 20강 30강이 단순히 몇 백만이 증가하는 게 아니라 몇 천만이 계속 증가됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.367,
                "end": 24.957
            },
            {
                "speaker_id": "1",
                "transcription": "네 요게 타이밍이 되게 중요하기 때문에 여러분들이 뭐 자세한 빌드는 유튜브에서 보시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.760,
                "end": 32.240
            },
            {
                "speaker_id": "1",
                "transcription": "좀 복잡해 보여도 뭐 하다 보면 익숙해져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.567,
                "end": 36.377
            },
            {
                "speaker_id": "1",
                "transcription": "중요한 거는 이 5쿠키를 집중적으로 맞춤으로 키우는 게 중요하다 그렇게 보시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.387,
                "end": 42.585
            },
            {
                "speaker_id": "1",
                "transcription": "비석을 깨서 빨리빨리 쿠키가 뒤에 불기둥에 죽지 않게끔 비석 빨리 깨는 게 중요하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.177,
                "end": 49.252
            },
            {
                "speaker_id": "1",
                "transcription": "불길은 안돼 아무튼 이런 식으로 갑니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.212,
                "end": 54.602
            },
            {
                "speaker_id": "1",
                "transcription": "제가 좀 약간 빠르게 해서 그런데 이렇게 해서 지금 현재 1억 2000 가까이 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.700,
                "end": 60.100
            },
            {
                "speaker_id": "1",
                "transcription": "치명타에 따라서 이런 식으로 돌아간다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.242,
                "end": 62.857
            },
            {
                "speaker_id": "1",
                "transcription": "각각 대체를 잠깐 설명을 드리면은 일단 여기서는 광역 딜러가 없으면은 보통 에스프레소나 달빛술사도 씁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.165,
                "end": 70.727
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 소르베도 쓰고 딜이 좀 낮아질 수도 있다는 점 여기 여기서 망토 보물을 쓰기 때문에 망토 보물 받는 적용 대상이 좀 중요하거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.882,
                "end": 79.782
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프랑 오징어 먹물이 망토 보물을 받는다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.195,
                "end": 83.307
            },
            {
                "speaker_id": "1",
                "transcription": "제가 드리고 싶은 말씀은 토벌전에 쓰이는 쿠키들이 어차피 키워야 될 쿠키라면은 스토리 모드에서 같이 그냥 키우는 게 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.605,
                "end": 91.395
            },
            {
                "speaker_id": "1",
                "transcription": "난이도가 이제는 어느 정도 스펙만 되면은 월드 탐험에서 안 깨지는 스테이지는 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.625,
                "end": 97.437
            },
            {
                "speaker_id": "1",
                "transcription": "다 깨져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.810,
                "end": 98.342
            },
            {
                "speaker_id": "1",
                "transcription": "결론 토벌 쿠키 위주로 먼저 키워라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.567,
                "end": 101.295
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 걸 키워야 되는지 추천을 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.777,
                "end": 106.083
            }
        ]
    },
    "summary": "화자는 토벌 쿠키 위주로 먼저 키우고 토벌에 나가는 쿠키를 집중적으로 맞춤으로 키우는 게 중요하다고 게임을 하면서 보여주고 있다.",
