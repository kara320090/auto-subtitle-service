    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 또 다른 한방덱이 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.821
            },
            {
                "speaker_id": "1",
                "transcription": "이번엔 벨벳 케이크입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.831,
                "end": 4.738
            },
            {
                "speaker_id": "1",
                "transcription": "지금 한방덱의 종류만 해도 어마 무시하게 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.748,
                "end": 8.163
            },
            {
                "speaker_id": "1",
                "transcription": "밀키웨이 한방덱 블루파이를 이용한 한방덱 그리고 이제 실론 한방덱 뭐 각종 변경된 다양한 덱도 많지만 하나가 더 추가됐습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.173,
                "end": 18.368
            },
            {
                "speaker_id": "1",
                "transcription": "벨벳 케이크 한방덱 탄생했고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.378,
                "end": 21.175
            },
            {
                "speaker_id": "1",
                "transcription": "보물은 무공비 그다음에 호루라기 깃털 요렇게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.185,
                "end": 25.958
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑도 되게 쉽습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.968,
                "end": 28.492
            },
            {
                "speaker_id": "1",
                "transcription": "도넛 올 아몬드고 여러분들이 신경 써야 될 거 쿨 2.8퍼센트 이상만 지켜주고 아몬드 토핑으로 피감만 높여 주면 끝.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.502,
                "end": 37.574
            },
            {
                "speaker_id": "1",
                "transcription": "자 벨벳 케이크 같은 경우에는 그냥 올 라즈 공속이나 이런 거 다 필요 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.584,
                "end": 42.760
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 공격력 높게 세팅하면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.770,
                "end": 45.273
            },
            {
                "speaker_id": "1",
                "transcription": "피감도 조금 신경 써 주시고 네 캡틴 같은 경우에는 피감 아예 없이 그냥 온리 공치만 신경 써주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.283,
                "end": 53.700
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 오징어 먹물은 피감 많이 주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.710,
                "end": 57.364
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 끈금사에서 시작부터 스킬도 못 쓰고 죽는 경우가 있기 때문에 그리고 공격력 최대한 많이 신경 써 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.374,
                "end": 64.272
            },
            {
                "speaker_id": "1",
                "transcription": "중요한 거는 호루라기는 캡틴캐비어랑 오징어 먹물을 받아야 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.282,
                "end": 69.062
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 승급이 높은 분들은 올 라즈베리 하면은 호루라기 적용이 블랙펄하고 뭐 캡틴캐비어 요렇게 가거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.072,
                "end": 77.164
            },
            {
                "speaker_id": "1",
                "transcription": "얘 승급이 높은 분들은 그래서 공격력을 낮추기 위해서 애플젤리 두 개를 섞어서 이렇게 3라즈 2애플젤리를 했다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.174,
                "end": 84.972
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 나는 블랙펄 승급이 낮아요 하시는 분들은 5라즈베리해도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.982,
                "end": 89.999
            },
            {
                "speaker_id": "1",
                "transcription": "공격 순위가 블랙펄이 3순위로 만들면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.009,
                "end": 92.861
            },
            {
                "speaker_id": "1",
                "transcription": "가끔가다 댓글 보면은 이 전투력으로 오해하시는 분들 있으니까 다시 한번 말씀드리면 여기 보면 공격력 표시된 게 1순위 2순위 된 것만 호루라기 받으니까 여러분들 참고할 때 전투력 말고 공격력 꼭 확인해 주시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.871,
                "end": 108.566
            }
        ]
    },
