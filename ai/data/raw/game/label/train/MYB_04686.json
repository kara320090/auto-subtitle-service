        "term": [
            {
                "speaker_id": "1",
                "transcription": "소환덱이 짱이네요 그냥.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.655
            },
            {
                "speaker_id": "1",
                "transcription": "자 어메이징 아니 힐량도 너무 안정적이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.665,
                "end": 11.321
            },
            {
                "speaker_id": "1",
                "transcription": "이게 샤벳상어가 중요 메인 딜러인데 저 쿨을 맞추니까 그 캡틴캐비어 공격도 안 맞고 블랙펄 공격도 안 맞아서 그냥 너무 사기네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.331,
                "end": 24.354
            },
            {
                "speaker_id": "1",
                "transcription": "아이구야 이거 야 나도 이제 큰일 났는데 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.364,
                "end": 27.113
            },
            {
                "speaker_id": "1",
                "transcription": "지금 방어 이제 소환덱으로 다 뚫리는 거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.123,
                "end": 29.795
            },
            {
                "speaker_id": "1",
                "transcription": "야 나도 무섭다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.805,
                "end": 30.920
            },
            {
                "speaker_id": "1",
                "transcription": "지금 쓰고 있는 이 상태에서 이제 깃털덱 전멸 당할 것 같은데 이걸로.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.930,
                "end": 36.293
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 에소를 넣어서 방어하던가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.303,
                "end": 39.129
            },
            {
                "speaker_id": "1",
                "transcription": "세상에나 어메이징.",
                "sound_type": [
                    2,
                    3
                ],
