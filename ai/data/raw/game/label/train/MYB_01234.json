        "term": [
            {
                "speaker_id": "1",
                "transcription": "그냥 지금은 이렇게 쓰세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.161
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 밀키웨이나 이런 거 목화 뽑으면 여기 다 집어넣으시고 근데 얘는 어차피 초반에 뭔 덱을 가도 그냥 전멸할 거라 이거 어떻게든 그냥 이걸로 어떻게든 딜 욱여넣어야 될 것 같아요 제가 볼 때는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.171,
                "end": 17.254
            },
            {
                "speaker_id": "1",
                "transcription": "치 지금으로서는 이게 최선일 것 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.264,
                "end": 19.696
            },
            {
                "speaker_id": "1",
                "transcription": "제가 어제도 전반적으로 다 콘텐츠 별로 세팅을 해드렸는데 일단 하다가 추가로 뭐 궁금한 거 있으면 물어보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.706,
                "end": 28.583
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 잘 키웠거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.593,
                "end": 29.807
            },
            {
                "speaker_id": "1",
                "transcription": "근데 요런 거는 키우지 마세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.817,
                "end": 31.296
            },
            {
                "speaker_id": "1",
                "transcription": "제가 키우지 말라는 거는 일단 키우지 마시고 파르페만 집중적으로 잘하고 마탕 키워서 하면은 아레나는 재밌게 할 수 있을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.306,
                "end": 39.768
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 좋은 쿠키들 잘 뽑아가지고 네 마무리 짓도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.778,
                "end": 60.600
            }
        ]
    },
    "summary": "지금은 이렇게 쓰고 나중에 밀키웨이나 목화 뽑으면 여기 다 집어넣고 초반에는 그냥 전멸할 거라 이걸로 딜 욱여넣어야 할 것 같은 게 최선이고 제가 키우지 말라는 거는 키우지 말고 파르페만 집중적으로 잘하고 마탕 키워서 하면 아레나 재밌게 할 수 있을 것 같다.",
