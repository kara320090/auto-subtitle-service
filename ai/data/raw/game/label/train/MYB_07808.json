        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 정수기 성능 개 쌉 에렸어 진짜.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.747
            },
            {
                "speaker_id": "1",
                "transcription": "아이 이거 빨리 넘겨볼까? 그러면?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.757,
                "end": 5.124
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 스킵하기가 좀 아까운데 지금 브금 내가 좋아하는 거라서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.134,
                "end": 9.019
            },
            {
                "speaker_id": "1",
                "transcription": "좀 기다려봐요. 여러분. 브금이나 좀 듣자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.029,
                "end": 14.122
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 이거 보니까 갑자기 악몽이 떠올랐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.132,
                "end": 17.751
            },
            {
                "speaker_id": "1",
                "transcription": "님들 혹시 몬스터헌터월드라는 게임을 아세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.761,
                "end": 20.089
            },
            {
                "speaker_id": "1",
                "transcription": "그게 미친 놈의 게임이 스킵이 안돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.099,
                "end": 22.242
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 피씨방에서 엔딩 본 사람은 한 시간 반 동안 이거를 스킵이 안돼 가지고 와 으흐흐흐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.252,
                "end": 30.633
            }
        ]
    },
    "summary": "20대 여성이 브금이 너무 좋아서 계속 듣고 있었는데 쿠키 영상이 있다는 소식을 듣고 스킵을 할까말까 고민하고 있다.",
