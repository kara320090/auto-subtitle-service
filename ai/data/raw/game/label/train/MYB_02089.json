        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 뭐 쓸 수는 있을 거 같고 덱도 나오긴 할 거 같긴 한데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.521
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 볼 때 어떻게 생각하세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.531,
                "end": 6.252
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 뭐 어떻게든 쓸 수는 있을 거 같애.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.262,
                "end": 9.155
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤처럼 그런 존재감 미친 존재감으로 모든 덱에 그냥 0티어급으로 쓰이는 거보다는 약간 특정 조합으로 그냥 쓸 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.165,
                "end": 19.402
            },
            {
                "speaker_id": "1",
                "transcription": "욱여넣어서 그냥 제가 맞춰본 거거든요? 그렇게만 알면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.412,
                "end": 23.435
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 말고 일단 토벌도 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.445,
                "end": 26.130
            },
            {
                "speaker_id": "1",
                "transcription": "도넛에서 얘가 쓰일 수 있는 이유는 얘 보면은 방깎을 해주거든요 13.5퍼센트 중첩 3개까지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.140,
                "end": 33.342
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 해효감 증가가 10초 동안 25퍼센트인데 해효감 저게 상당히 중요한 의미를 가져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.352,
                "end": 40.320
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 도넛도 해효감 때문에 방깎 유지가 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.330,
                "end": 45.183
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 보면은 해효감이 10초 동안 20퍼센트인데 쟤는 25퍼센트",
                "sound_type": [
                    2,
