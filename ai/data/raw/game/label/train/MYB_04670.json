                ],
                "start": 0.000,
                "end": 7.988
            },
            {
                "speaker_id": "1",
                "transcription": "아 뭐 자색 고구마도 1강 해가지고 성전에서 쓰시는 분들도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
