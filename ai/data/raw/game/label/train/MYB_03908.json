                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.553
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 아 음유시인 이번에 잘 나오는 거 맞네요 여러분들?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.563,
                "end": 11.176
            },
            {
                "speaker_id": "1",
                "transcription": "야 그쵸?",
