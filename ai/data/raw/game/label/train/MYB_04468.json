        "term": [
            {
                "speaker_id": "1",
                "transcription": "변신 중 일반 공급에 맞은 적에게 부상을 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.062
            },
            {
                "speaker_id": "1",
                "transcription": "변신 중 부상에 걸린 적을 공격할 경우 치명적인 상처와 상처 찢기 디버프를 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.072,
                "end": 10.757
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 여러분들에 보아야 될 게 야 이게 나와 봤자 얼마나 좋겠어라는 생각을 가지신 분들 이제 토벌의 진심분들은 이거다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.767,
                "end": 19.308
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 토벌용이다라고 점쳐놓고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.318,
                "end": 22.433
            },
            {
                "speaker_id": "1",
                "transcription": "토벌용으로 변신이 끝나면 적들에게 마지막 일격을 가하고 마법사탕 장작 시 무게가 많이 나가 무게가 많이 나가는 거는 홀리베리가 최고인데 홀리베리는 그러면 아예 그냥 움직이지도 않아야 되는 거 아닙니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.443,
                "end": 35.657
            },
            {
                "speaker_id": "1",
                "transcription": "자 무게가 많이 나가서 넉백과 에어본 효과를 덜 받는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.667,
                "end": 39.524
            },
            {
                "speaker_id": "1",
                "transcription": "마법사탕이 적용됨에 따라 한 기능 상향을 위해",
