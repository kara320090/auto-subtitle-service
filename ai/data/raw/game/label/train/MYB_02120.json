        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 캡사이신이 피감이 없어도 죽을 때 호루라기를 가지고 있기 때문에 아군한테 힐러 느낌으로 체력을 채워주고 죽는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.756
            },
            {
                "speaker_id": "1",
                "transcription": "세팅만 되면은 상당히 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.766,
                "end": 12.345
            },
            {
                "speaker_id": "1",
                "transcription": "자 불파한방덱을 이제 나보다 스펙 높은 분들 잡기 위해서 쓰는 분들이 많은데 한방덱의 장점은 확실히 이렇게 스펙 차이가 만약에 내가 불리하다 해도 쉽게 이길 수 있기 때문에 많이 사용하는 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.355,
                "end": 29.932
            },
            {
                "speaker_id": "1",
                "transcription": "불파한방덱도 세팅 하나 해서 준비하는 것도 좋습니다 네 불파한방덱.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.942,
                "end": 35.458
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 캡사정석덱 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.468,
                "end": 39.960
            },
            {
                "speaker_id": "1",
                "transcription": "상대방 분이 전투력이 맞은 이유는 똑같은 풀 초월인데 달빛술사 같은 경우에도 올 아몬드로 하거나 뭐 캡사이신이 있으면은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.970,
                "end": 47.914
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신도 올 라즈베리 대신에 뭐 올 아몬드로 하거나 토핑 세팅이 차이가 난다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.924,
                "end": 52.801
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방 분은 똑같은 세팅이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.811,
                "end": 55.320
            },
            {
                "speaker_id": "1",
                "transcription": "근데도 전투력이 거의 50만 가까이 차이가 나는 건 아몬드 세팅으로 많이 위주로 되어 있기 때문에 전투력 차이가 많이 나게 되고 당연히 제가 더 공격적으로 세팅되어 있기 때문에 상대방을 죽일 수 있으면 상당히 유리하게 진행 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.330,
                "end": 72.438
            },
            {
                "speaker_id": "1",
                "transcription": "딜적으로 유리하게 이길 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.448,
                "end": 78.001
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 이 캡사정석덱을 뭐 굳이 세팅하기 힘들거나 쓰기 힘들다 하더라도 다른 제가 보여드린 덱들이 많기 때문에 그런 거 위주로 세팅해주시면 좋을 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.011,
                "end": 91.111
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 공속덱 같은 경우에는 상대방이 자구마 뭐 무난하게 많이 쓰는 사람도 있지만 뭐 무조건 승률이 높다고는 못하겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.121,
                "end": 100.532
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 이미 방덱은 다 대비를 하고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.542,
                "end": 106.031
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱이 들어왔을 때 달빛술사나 이제 그 스타더스트가 죽을 걸 대비해서 되게 피감을 단단하게 많이 하는 분도 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 106.041,
                "end": 116.158
            },
            {
                "speaker_id": "1",
                "transcription": "네 그럼에도 불구하고 공속덱 이렇게 공덱으로도 잘 활용할 수가 있습니다 네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 116.168,
                "end": 124.438
            },
            {
                "speaker_id": "1",
                "transcription": "자 전체 공격력",
                "sound_type": [
                    2,
