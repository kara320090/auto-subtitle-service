    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 버티면서 어떻게든 뒤에까지 가야되는데 이 횃불이 터진다고 해서 상대가 그래도 뭐 빨리 죽냐 그것도 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.091
            },
            {
                "speaker_id": "1",
                "transcription": "제가 말씀드리고 싶은 거는 빙결덱이 뭐 따로 더 나올 수도 있지만 현재로선 제가 볼 때는 워낙 지금 아레나 유행이 한방덱 신규 슈펄픽과 관련된 블파덱 2개가 너무 좋기 때문에 만약에 쓰더라고 횃불보다는 좀 더 안정적인 모노클 덱으로 가지 않을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.101,
                "end": 27.082
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 뭐 당연한 얘기지만 이 젤리 시계 같은 경우에는 당연히 당연히 뭐 무공비급이랑 동급으로 거의 필수 보물입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.092,
                "end": 34.956
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 반드시 키워야 되고 초보자분들이 그래서 이 앞에서 보물 뽑기 할 때 뭐 해야 되나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.966,
                "end": 42.254
            },
            {
                "speaker_id": "1",
                "transcription": "물어보실 수도 있는데 제 개인적인 생각은 무공비급은 변함없이 그냥 0티어예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.264,
                "end": 48.164
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 뽑아야 되고 시계도 제가 볼 때는 반드시 뽑아야 되는데 호루라기랑 그다음에 공속 둘 다 얘도 뽑아야 되거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.174,
                "end": 55.951
            },
            {
                "speaker_id": "1",
                "transcription": "토벌을 위해서는 공속 만렙을 찍는 것도 길드를 위해서 되게 중요하거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.961,
                "end": 60.764
            },
            {
                "speaker_id": "1",
                "transcription": "요것도 적당히 이제 좀 키워주면서 호루라기 이것도 키워주시면 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.774,
                "end": 67.174
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 결국에는 필수로 키워야 되는 보물이 일단은 4개가 됐네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.184,
                "end": 71.086
            },
            {
                "speaker_id": "1",
                "transcription": "무공비급, 시계, 호루라기, 공속 요 4개를 집중적으로 여러분들 키워주시면 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.096,
                "end": 77.588
            },
            {
                "speaker_id": "1",
                "transcription": "깃털덱도 원래는 이 업데이트 전까지는 깃털덱이 상당히 많았는데 아무 의미가 없어졌습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.598,
                "end": 83.625
            },
            {
                "speaker_id": "1",
                "transcription": "깃털덱이 깃털 한방덱에 쓰네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.635,
                "end": 85.657
            },
            {
                "speaker_id": "1",
                "transcription": "깃털도 제가 볼 때는 한방덱 쓸 때 필요하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.667,
                "end": 89.511
            },
            {
                "speaker_id": "1",
                "transcription": "야 얘도 필수다. 5개가 필요하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.521,
                "end": 92.329
            },
            {
                "speaker_id": "1",
                "transcription": "결국엔 5개를 꼭 키워라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.339,
                "end": 94.262
            },
            {
                "speaker_id": "1",
                "transcription": "시계만 여러분들 집중적으로 키우면 될 거 같애요 신규 보물 중에서는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 94.272,
                "end": 97.440
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 신규 보물 리뷰는 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.450,
                "end": 104.600
            }
        ]
    },
    "summary": "남성은 게임의 신규 보물 중에서 어떤 것을 키우면 좋은지 알려주고 있다.",
