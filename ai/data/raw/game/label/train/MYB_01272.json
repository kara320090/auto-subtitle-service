        "term": [
            {
                "speaker_id": "1",
                "transcription": "보여드린 것처럼 샤이닝 글리터 말고도 소르베 써도 상당히 좋거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.737
            },
            {
                "speaker_id": "2",
                "transcription": "예 소르베 써서도 성능이 좋게 나오니까 예 소르베도 써 주시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.747,
                "end": 14.518
            },
            {
                "speaker_id": "1",
                "transcription": "사실 샤이닝이 고초월 되면은 성능이 진짜 좋아서",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.528,
                "end": 18.921
            },
            {
                "speaker_id": "1",
                "transcription": "네 공연력 보면은 샤이밍과 스타더스트가 어마무시하다 자 이번에는 또 소르베로 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.931,
                "end": 26.364
            },
            {
                "speaker_id": "1",
                "transcription": "이번 영상의 핵심은 파르페와 락스타맛 쿠키 투일과 나머지 딜러 두 쿠키의 안정적인 힐 요걸로 유지력이 돼서 여러분들이 어떤 딜러를 넣어도 조합을 만들 수 있다 요거를 보여드린 거구요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 26.374,
                "end": 45.186
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 용가 드래곤이나 다른 조합도 아레나에서는 어마무시한 게 많습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 45.196,
                "end": 49.542
            },
            {
                "speaker_id": "1",
                "transcription": "다만 이 유지력 좋은 조합을 여러분들 아레나에서 활용하면은",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.552,
                "end": 55.666
            }
        ]
    },
    "summary": "소르베와 샤이닝 글리터는 성능이 좋고 샤이밍과 스타더스트는 공연력 좋다.",
