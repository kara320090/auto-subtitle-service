        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 로얄마가린맛 쿠키 리뷰 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.967
            },
            {
                "speaker_id": "1",
                "transcription": "네 일단 추월 전에 이렇게 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.977,
                "end": 6.945
            },
            {
                "speaker_id": "1",
                "transcription": "공격력이 높은 적 3명에게 탄알을 발사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.955,
                "end": 10.286
            },
            {
                "speaker_id": "1",
                "transcription": "공격 피해를 주고요 중독을 부여하고 공격력과 방어력을 감소시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.296,
                "end": 14.710
            },
            {
                "speaker_id": "1",
                "transcription": "해로운 효과 증가도 부여합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.720,
                "end": 17.084
            },
            {
                "speaker_id": "1",
                "transcription": "빠른 속도로 적에게 돌진해서 피해를 입히고 도트효과 개수 비례 추가 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.094,
                "end": 22.610
            },
            {
                "speaker_id": "1",
                "transcription": "버터크림 볼은 보스 몬스터를 최우선으로 공격을 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.620,
                "end": 26.419
            },
            {
                "speaker_id": "1",
                "transcription": "버터크림 볼 피해량은 1회당 55.9",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.429,
                "end": 29.443
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키랑 이런 걸 보시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.453,
                "end": 31.321
            },
            {
                "speaker_id": "1",
                "transcription": "중독 피해를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.331,
                "end": 32.428
            },
            {
                "speaker_id": "1",
                "transcription": "공격력 감소는 10초 동안 쿠키한테 5퍼센트 그 외에 다른 데에서는 15퍼센트 중첩은 최대 3개까지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.438,
                "end": 40.698
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 방어력 감소는 10초 동안 쿠키한테는 7퍼센트 그 외에는 13.5퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.708,
                "end": 46.573
            },
            {
                "speaker_id": "1",
                "transcription": "해로운 효과 증가는 10초 동안 25퍼센트 증가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.583,
                "end": 49.197
            },
            {
                "speaker_id": "1",
                "transcription": "돌진 피해량은 269퍼센트 도트 효과 1개당 추가 피해도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.207,
                "end": 54.824
            },
            {
                "speaker_id": "1",
                "transcription": "자 로얄마가린맛 쿠키 토핑을 일단 3가지를 준비했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.834,
                "end": 58.453
            },
            {
                "speaker_id": "1",
                "transcription": "일단 올 쿨이랑 토굴에서 리뷰할 때 올 쿨 아니면 아레나에서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.463,
                "end": 62.668
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 아몬드로 아레나에서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.678,
                "end": 64.962
            },
            {
                "speaker_id": "1",
                "transcription": "마지막은 아레나에서 쓸 건데 용과보다는 좀 공격력을 높게 세팅해서 호루라기 받는 세팅입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.972,
                "end": 72.397
            },
            {
                "speaker_id": "1",
                "transcription": "자 평딜부터 보겠습니다 평딜.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.407,
                "end": 77.566
            }
        ]
    },
    "summary": "공격력이 높은 적 3명에게 탄알을 발사하고 공격 피해를 주고요 중독을 부여하고 공격력과 방어력을 감소시키고 해로운 효과 증가도 부여하며 빠른 속도로 적에게 돌진해서 피해를 입히고 도트효과 개수 비례 추가 피해를 입히고 버터크림 볼은 보스 몬스터를 최우선으로 공격을 하고 버터크림 볼 피해량은 1회당 55.9이고 중독 피해를 주고 공격력 감소는 10초 동안 쿠키한테 5퍼센트 그 외에 다른 데에서는 15퍼센트 중첩은 최대 3개까지 그리고 방어력 감소는 10초 동안 쿠키한테는 7퍼센트 그 외에는 13.5퍼센트해로운 효과 증가는 10초 동안 25퍼센트 증가돌진 피해량은 269퍼센트 도트 효과 1개당 추가 피해도 있다고 한다.",
