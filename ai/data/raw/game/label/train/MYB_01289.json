        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 이렇게 안 줘도 돼요. 차라리 이게 더 낫겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.840
            },
            {
                "speaker_id": "1",
                "transcription": "이번 시즌 다 올치명이 좋아서 치명 세팅으로 가셔야 돼요. 라즈보다 치명 세팅, 토벌 세팅 아예 안 하셨나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.850,
                "end": 11.002
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 세팅 안 하셨구나 쿨 토핑작을 좀 많이 하셔야 되겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.012,
                "end": 14.358
            },
            {
                "speaker_id": "1",
                "transcription": "이 약간 별은 되게 높거든요. 근데 토핑이 많이 없으시긴 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.368,
                "end": 19.122
            },
            {
                "speaker_id": "1",
                "transcription": "일단 좀 딴거 보고 오자 승급에 비해 토핑작을 많이 안 하셨구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.132,
                "end": 23.363
            },
            {
                "speaker_id": "1",
                "transcription": "용과댁 스타더스트 이거 너무너무 낮다. 18 퍼센트면 죽어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.373,
                "end": 29.184
            },
            {
                "speaker_id": "1",
                "transcription": "이거 만약에 지는 이유가 있다면은 스더가 피감이 너무 낮아서 죽는다. 이거 이해가 돼 토핑이 너무 약해서 이래",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.194,
                "end": 36.319
            },
            {
                "speaker_id": "1",
                "transcription": "지금 메타에서 스더가 진짜 핵심적인데 생존이 이렇게 약하면은 승률이 낮을 수밖에 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.329,
                "end": 44.482
            },
            {
                "speaker_id": "1",
                "transcription": "용과도 지금 승률이 낮은 이유가 딱 보이죠 승률이 낮을 수밖에 없는 세팅이야 누가 봐도 저도 만약 에 세팅을 지금 상위권에서 용과 쿨 이렇게 낮게 하잖아 다져요. 다집니다. 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.492,
                "end": 59.772
            },
            {
                "speaker_id": "1",
                "transcription": "용과쿨이 어마무시하게 중요해요. 지금 위에서는 피감이 중요한 게 아니에요. 이렇게 되면은 어떻게 되냐면은 상대 용과가 1분 타이밍에다 얘도 다 죽여놓고 그때 얘 혼자서 그냥 공격 들어가는 거라",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.782,
                "end": 75.366
            }
        ]
    },
    "summary": "이번 시즌 다 올치명이 좋아서 치명 세팅으로 해야 하며 토벌 세팅은 쿨 토핑작을 해야 하는데 승급에 비해 토핑이 별로 없다.",
