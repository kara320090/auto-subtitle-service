        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "먼저 왕국 운영입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.804
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 가장 중요하게 생각해야 되는 1순위는 쿠키성 레벨입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.814,
                "end": 5.695
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키성 레벨이 올라가면 몇 가지 큰 장점이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.705,
                "end": 8.827
            },
            {
                "speaker_id": "1",
                "transcription": "제한되어 있던 곰 젤리 열차, 열기구, 아레나, 소다 제도, 해상 무역 센터, 설탕 노움 연구소와 같은 콘텐츠를 오픈하거나 쿠키 하우스와 생산 건물을 추가로 지을 수 있고 풍요의 분수와 생산 단계로 높일 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.837,
                "end": 21.239
            },
            {
                "speaker_id": "1",
                "transcription": "또한 왕국 운영을 통해 생산된 재고들은 소원 나무를 통해 코인으로 바뀌고 쿠키 하우스를 통해 얻은 별사탕은 쿠키 성장에 쓰입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.249,
                "end": 29.209
            },
            {
                "speaker_id": "1",
                "transcription": "결국 쿠키성 레벨업을 통해서 쿠키 성장을 위한 기본 바탕을 만드는 과정이라고 생각하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.219,
                "end": 35.660
            },
            {
                "speaker_id": "1",
                "transcription": "이를 위해 초보자분들이 가장 신경써야 될 부분은 쿠키성 레벨업을 위한 코인과 오로라 재료 수량을 체크하고 모아두어야 해서 토핑 강화나 랜드마크 레벨업 무리해서 코인 소모를 하지 마시고 쿠키성 레벨업에 쓰일 재화를 남기고 여유 있을 때 나머지를 신경 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.670,
                "end": 53.390
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키성 레벨업을 하다 보면 영토 확장할 수 있는 범위도 넓어지게 되고 제한되어 있던 각종 기능과 건물 콘텐츠가 생기게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.400,
                "end": 61.139
            },
            {
                "speaker_id": "1",
                "transcription": "소원 나무는 코인 벌이하는 목적으로 사용하는 핵심입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.149,
                "end": 64.488
            },
            {
                "speaker_id": "1",
                "transcription": "생산 단계가 높아질수록 골드량도 비례해서 늘어나고 주말에는 판매로 얻는 골드량 20퍼센트 추가 이벤트가 진행되기 때문에 평일에는 일일 보상 퀘스트만 다 깨고 주말에 몰아서 소원 나무하는 게 효율적으로 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.498,
                "end": 77.509
            },
            {
                "speaker_id": "1",
                "transcription": "풍요의 분수는 코인, 별사탕, 빛 조각, 기본 재료, 고기 젤리, 설탕 결정을 주며 레벨을 올릴수록 생산 시간이 단축되기 때문에 최대한 레벨을 높게 올려주는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.519,
                "end": 87.963
            },
            {
                "speaker_id": "1",
                "transcription": "곰 젤리 열차는 빛 조각, 크리스털, 토핑 조각.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.973,
                "end": 90.958
            }
        ]
    },
