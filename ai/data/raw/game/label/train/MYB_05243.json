        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 그냥 느낌만 봐도 사기야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.692
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 벌써 랭커분들도 3성 찍고 방덱에 다 세팅했네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.702,
                "end": 5.970
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 여러분들 리뷰할 때 내 반응이 보통 몇 가지로 나눠요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.980,
                "end": 10.834
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째 아 여러분들 이거는 조합을 좀 찾아 보고 최적화된 세팅이 있으면 좋을 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.844,
                "end": 16.692
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 좀 좋은 조합이 나오면 제가 알려드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.702,
                "end": 19.953
            },
            {
                "speaker_id": "1",
                "transcription": "이런 반응이 나오면은 무조건 써라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.963,
                "end": 22.321
            },
            {
                "speaker_id": "1",
                "transcription": "이 느낌이 아닌 거의 1티어 정도의 느낌이고 와 여러분들 이거 좀 괜찮네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.331,
                "end": 27.195
            },
            {
                "speaker_id": "1",
                "transcription": "이거 아레나에서 많이 쓰일 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.205,
                "end": 28.889
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 나오면은 걔는 아레나에서나 다른 컨텐츠에서 두루두루 잘 쓰는 건데 나오자마자 바요처럼 이건 미쳤다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.899,
                "end": 35.837
            },
            {
                "speaker_id": "1",
                "transcription": "야 이건 좀 사기다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.847,
                "end": 38.086
            },
            {
                "speaker_id": "1",
                "transcription": "약간 이런 반응으로 바로 나오는 거는 이건 진짜 키워야 되는 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.096,
                "end": 41.803
            },
            {
                "speaker_id": "1",
                "transcription": "거의 제 2의 바요 느낌이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.813,
                "end": 44.900
            }
        ]
    },
