                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 에일리언 도넛이 출시된 이후로 한방덱이 엄청나게 유행이 됐지만 문제는 상대방이 이렇게 허브가 있을까 봐 1탱 덱은 지금 한방덱에 거의 안 쓰는 추세죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 10.783
            },
            {
                "speaker_id": "1",
                "transcription": "밀키웨이 대신에 찰스를 쓰게 되면 허브가 힐을 쓰기 전에 나머지 애들이 충분히 딜을 넣어가지고 한방덱을 쓸 수가 있는 상태가 됐습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.793,
                "end": 19.420
            },
            {
                "speaker_id": "1",
                "transcription": "물론 허브가 없으면 더 쉽게 상대방을 이길 수 있고 문제가 되는 지점이 허브 맛 쿠키가 디버프 제거였거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.430,
                "end": 27.985
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 찰스 하나로 해결이 될 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.995,
                "end": 31.721
            },
            {
                "speaker_id": "1",
                "transcription": "보물 같은 경우에는 호루라기 깃털 그대로 쓰고 도넛은 그냥 2.8퍼센트 이상 아 주시고 피감 그다음에 공치 여유되면 찰스 같은 경우에는 그냥 전부 다 올 라즈 올 라즈해서 공치 여러분들 주시고 피감은 너무 적은 것 보다는 조금 있는 게 나은 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.731,
                "end": 49.531
            },
            {
                "speaker_id": "1",
                "transcription": "캡틴캐비어 같은 경우에도 쿨 조금이랑 공치 여러분들 올인 단 피감 아예 없는 게 포인트 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.541,
                "end": 55.599
            },
            {
                "speaker_id": "1",
                "transcription": "피감은 없어서 부활을 받을 그런 상태로 만들어 준다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.609,
                "end": 59.534
            },
            {
                "speaker_id": "1",
                "transcription": "달빛 같은 경우에는 제가 이거 좀 몇 번 해보니까 쿨 높으면 높을수록 좋긴하더라구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.544,
                "end": 64.216
            },
            {
                "speaker_id": "1",
                "transcription": "허브가 있다는 가정하에는 첫 턴에 다 죽이지는 못하기 때문에 쿨이 높으면 높을수록 좋은 거 같고 피감도 챙겨주시고 여유 있으면 공치 오 요거 여러분들 나름대로 해주시고 아니 왜 5라즈가 아니라 2 애플 젤리를 꼈나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.226,
                "end": 77.832
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 제 달빛술사 초월이 높아가지고 여러분들 호루라기를 오먹학고 캡캐가 받아야 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.842,
                "end": 84.642
            },
            {
                "speaker_id": "1",
                "transcription": "오먹하고 캡캐 달빛이 받으면 손해가 좀 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.652,
                "end": 87.892
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 스펙이 너무 고스텍이다 하시는 분들은 일부러 애플젤리를 껴서 캡캐가 더 높게 만들어 줘서 호루라기가 받을 수 있도록 자 마지막으로 오먹 같은 경우에는 여러분들 한방덱 기존에 써본 분들은 알겠지만 오징어 먹물은 워낙 물 몸이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.902,
                "end": 102.337
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 피감이 높으면 높을수록 좋은 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.347,
                "end": 104.689
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 여유 있으면 공치랑 쿨 좀 더 주시면 좋을 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 104.699,
                "end": 109.733
            }
        ]
    },
