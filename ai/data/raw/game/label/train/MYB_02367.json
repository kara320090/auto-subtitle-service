                "end": 11.866
            },
            {
                "speaker_id": "1",
                "transcription": "거기다 추가 피해도 주구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.876,
                "end": 13.274
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 여러분들 궁금한 거는 5초월 리뷰에서 떤 토핑을 쓰냐 이게 상당히 중요할 텐데 결과만 따지면은 모든 토핑의 종류를 골고루 다 씁니다.",
                "sound_type": [
