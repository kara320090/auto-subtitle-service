        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "좋아 덕분에 구덩이를 빠져나온 것에 초점을 두도록 하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.292
            },
            {
                "speaker_id": "1",
                "transcription": "나는 @이름1다 너희들에게 알려줄 수 있는 건 이게 전부야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.302,
                "end": 7.084
            },
            {
                "speaker_id": "1",
                "transcription": "그러니 너희가 누군지 목적이 무엇인지도 묻지 않도록 하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.094,
                "end": 10.318
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 엿 같은 식인귀 마을을 빠져나가기 위해서는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.328,
                "end": 13.165
            },
            {
                "speaker_id": "1",
                "transcription": "식인귀 마을이래 여기 식인귀 마을인가봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.175,
                "end": 17.069
            },
            {
                "speaker_id": "1",
                "transcription": "위해서는 잠시 동안 협력이 필요할 거 같군.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.079,
                "end": 19.529
            },
            {
                "speaker_id": "1",
                "transcription": "고려하실 필요도 없는 사항입니다 가주님 인간은 믿을 수 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.539,
                "end": 23.479
            },
            {
                "speaker_id": "1",
                "transcription": "괜찮겠나? 너희는 이곳에서 어떤 위험이 도사리고 있는지 모르고 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.489,
                "end": 27.502
            },
            {
                "speaker_id": "1",
                "transcription": "가주님의 보필은 저 @이름2만으로 충분합니다 어떤 위험이든 미연에 방지해보이겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.512,
                "end": 35.224
            },
            {
                "speaker_id": "1",
                "transcription": "말은 잘하는군 자기가 원인이 되어 주인이 함정에 빠지게 만들어놓고서는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.234,
                "end": 39.600
            },
            {
                "speaker_id": "1",
                "transcription": "말해보시지 인형 방금 내가 한 말은 참인가 거짓인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.610,
                "end": 43.562
            },
            {
                "speaker_id": "1",
                "transcription": "참과 거짓을 판별하기에 정보가 적습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.572,
                "end": 46.721
            },
            {
                "speaker_id": "1",
                "transcription": "풋 고집은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.731,
                "end": 49.166
            }
        ]
    },
    "summary": "식인귀 마을을 빠져나와야 하는데 가주님의 보필은 @이름2만으로 충분하다고 어떤 위험이든 미연에 방지해보이겠다고 말한다.",
