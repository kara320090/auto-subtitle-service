        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤은 피해 감소 맥스치가 85퍼센트예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.981
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 85퍼센트를 넘어서는 피감은 전부다 그냥 85퍼센트 맥스치로 적용된다는 점 알아두시면 되고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.991,
                "end": 13.486
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱 플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.496,
                "end": 16.686
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.696,
                "end": 20.057
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.067,
                "end": 23.907
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 신규 보물 같은 경우에는 여러분들 뭐 예능용입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.917,
                "end": 27.653
            },
            {
                "speaker_id": "1",
                "transcription": "사실상 정말 저 보물을 쓴다고 해서 엄청나게 좋은 건 아니에요. 사실상",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.663,
                "end": 34.305
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 한번 그냥 예능으로 제가 보여드리면 모노클 자리에다 써서 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.315,
                "end": 38.701
            },
            {
                "speaker_id": "1",
                "transcription": "일단 요걸 쓰게 되면 피해 감소가 가장 중요한 게 현재 체력이 가장 낮은 쿠키입니다.",
