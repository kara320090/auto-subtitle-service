        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 끝났습니다 요렇게 만렙을 찍으면 빨간색 물약이 뜹니다 5초월까지 됐구요 야 이제 끝난 게 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.738
            },
            {
                "speaker_id": "1",
                "transcription": "자 6만 개예요 6만 개로 5성 도전 잘 나오면은 가능해 바로 바로 바로 바로 바로 바로 출발.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.748,
                "end": 19.008
            },
            {
                "speaker_id": "1",
                "transcription": "아니 아 이거 확률 맞아 느낌이 벌써부터 싸한데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.018,
                "end": 26.028
            },
            {
                "speaker_id": "1",
                "transcription": "와 그 나 클났다 이거 야 만 개에서 조각조차 거의 안 보이는데 이거 맞나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.038,
                "end": 33.901
            },
            {
                "speaker_id": "1",
                "transcription": "야 나 저주 걸렸다 이거 안 나오는 아 큰일 났는데 이거 하나도 안 나오네?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.911,
                "end": 42.985
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 완품으로 보여드릴게요 잠깐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.995,
                "end": 47.133
            }
        ]
    },
    "summary": "만렙을 찍으면 빨간색 물약이 나오고 5초월까지 된 후 6만 개로 5성을 도전해야 하는데 만 개 중 조각조차 거의 나오지 않고 있다.",
