        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 요즘에 벨벳용에서는 감초도 쓰이고 뭐 석류도 쓰이고 아포가토 그다음에 에클레어 뱀파로 요렇게 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.050
            },
            {
                "speaker_id": "1",
                "transcription": "자 빌드 같은 경우에는 뭐 여기서 설명해서 복잡하게 보여드릴 목적이 아니기 때문에 자 어 아 저런 식으로 되고 있구나 이렇게 보기만 하시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.615,
                "end": 17.762
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 감초도 메인으로 쓰이고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.777,
                "end": 21.805
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 뱀파가 아직도 메인으로 잘 쓰고 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.390,
                "end": 26.082
            },
            {
                "speaker_id": "1",
                "transcription": "네 뭐 뱀파는 항상 고정 멤버죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.317,
                "end": 29.217
            },
            {
                "speaker_id": "1",
                "transcription": "항상 들어가는 네 요렇게 뱀파까지 써 주고 석류가 힐 써 주고",
                "sound_type": [
                    2,
