        "term": [
            {
                "speaker_id": "1",
                "transcription": "나오지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.420
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 별가루 같은 것도 공격적으로 상대방한테 피해를 입히는 그런 형식으로 되지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.420,
                "end": 8.039
            },
            {
                "speaker_id": "1",
                "transcription": "구체적으로 얼마만큼의 디버프가 걸리고 뭐 수치나 이런 거는 지금 나온 게 하나도 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.039,
                "end": 13.700
            },
            {
                "speaker_id": "1",
                "transcription": "네 킹덤에서도 저런 모습을 예측할 수 있을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.700,
                "end": 17.780
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 이제 유출된 내용 자 스킨이 유출이 되었네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.780,
                "end": 22.420
            },
            {
                "speaker_id": "1",
                "transcription": "되게 밤하늘의 별자리 뭐 관련된 스킨이라고 하는데 맨 왼쪽에 @이름1, @이름2 쿠키, @이름3입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.420,
                "end": 30.590
            },
            {
                "speaker_id": "1",
                "transcription": "맨 우측에는 @이름4 되게 이쁘게 나왔고 저는 개인적으로 @이름4 같은 경우에는 하도 자주 쓰기 때문에 스킨 나오면은 필수로 쓰지 않을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.590,
                "end": 39.770
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 뭐 추가로 떠도는 얘기는 지금 뭐 @이름5 쿠키 뭐 무슨 @이름6 쿠키 에픽 등급의 쿠키가 하나 더 출시된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.770,
                "end": 49.250
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 그런 얘기도 있고 어 2주년 맞이해서 뭐 떠도는 얘기가 많이 있는데 패치 노트 나오면 그때 상세히 같이 보면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.250,
                "end": 58.680
            },
            {
                "speaker_id": "1",
                "transcription": "현재 BTS 쿠키가 아무리 나락을 간다 해도 그래도 여러분들 얘는 기간이 지나면은 다시는 못 뽑는 쿠키들이거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.680,
                "end": 66.270
            },
            {
                "speaker_id": "1",
                "transcription": "지금 복귀 안 한 분들 그리고 뉴비분들 아직 시작 안 한 분들 시작해서 BTS 쿠키 하나라도 일단은 가지고 있는 게 진짜 중요한 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.270,
                "end": 75.930
            },
            {
                "speaker_id": "1",
                "transcription": "한정판이기 때문에 지금이 기회다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.930,
                "end": 78.860
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 2주년 관련된 내용은 아직 정확하게 나오지 않았지만 추후에 공지 나오면 또다시 뵙도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.860,
                "end": 89.375
            }
        ]
    },
    "summary": "달빛술사 쿠키의 디버프나 수치가 나오지는 않았지만 모습을 예측할 수 있었고 밤하늘의 별자리와 관련된 스킨이 유출되었으며 그중에 휘낭시에 캐릭터를 잘 쓰고 있어서 스킨이 나온다면 필수로 사용할 것 같고 BTS 쿠키는 한정판이기 때문에 하나라도 가지고 있는 것이 좋다.",
