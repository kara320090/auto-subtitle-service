                ],
                "start": 0.000,
                "end": 0.696
            },
            {
                "speaker_id": "1",
                "transcription": "아무것도 모른 채 털레털레 마을에 발을 들였으면 어떻게 됐겠어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.700,
                "end": 4.474
            },
            {
                "speaker_id": "1",
                "transcription": "이 몸께서 전부 너희를 보호해 주려고 한 거라고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.484,
                "end": 8.746
            },
            {
                "speaker_id": "2",
                "transcription": "그런 걸 보호라고 해?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.756,
                "end": 11.569
            },
            {
                "speaker_id": "1",
                "transcription": "좀 과격한 수단을 사용한 건 인정할게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.579,
                "end": 14.966
            },
            {
                "speaker_id": "3",
                "transcription": "제게 내장된 고도의 분석 기능조차 사용할 필요 없는 수준 낮은 거짓말입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.976,
                "end": 19.914
            },
            {
                "speaker_id": "3",
                "transcription": "가시죠 시장 시간 낭비입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.924,
                "end": 23.449
            },
            {
                "speaker_id": "2",
                "transcription": "진짜 가? 안 구해줘?",
