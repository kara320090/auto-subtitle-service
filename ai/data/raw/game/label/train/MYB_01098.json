    },
    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "많이 사용하고 있으니까 여유가 된다면 키우면 좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.070
            },
            {
                "speaker_id": "1",
                "transcription": "자 실론 나이트 한방덱뿐만 아니라 정석덱에 많이 사용되고 있고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.080,
                "end": 7.766
            },
            {
                "speaker_id": "1",
                "transcription": "보통 올 아몬드로 추천드리고 한방높게해서 공속 높게 정석덱이나 한방덱에서 많이 사용되고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.776,
                "end": 14.981
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 된다면 실론나이트 10강 이상 사용하시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.991,
                "end": 18.203
            },
            {
                "speaker_id": "1",
                "transcription": "자 슈크림맛 쿠키는 아레나에서 활용가치가 거의 없고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.213,
                "end": 22.847
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 된다면 10강 이상 마탕해서 올애플젤리로 사용하시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.857,
                "end": 28.191
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페는 아레나에서 사용할 때는 마법사탕 10강 이상 쓰시면 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.201,
                "end": 32.709
            },
            {
                "speaker_id": "1",
                "transcription": "보통 올 쿨로 세팅을 많이 하면 되고 22퍼센트를 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.719,
                "end": 37.369
            },
            {
                "speaker_id": "1",
                "transcription": "그래야만 1분 타이밍때 용과 브레쓰 나올 때 스킬 발동이 돼서 아군의 생존을 좀 높여줄 수 있거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.379,
                "end": 43.546
            },
            {
                "speaker_id": "1",
                "transcription": "피감 높을수록 좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.556,
                "end": 45.232
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타 정말 중요합니다.",
                "sound_type": [
                    2
                ],
                "start": 45.242,
                "end": 46.806
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키가 피해감소 무시가 있기 때문에 기존보다 이렇게 피해감소 낮게 세팅하면 안되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 46.816,
                "end": 52.868
            },
            {
                "speaker_id": "1",
                "transcription": "권장 피감 20퍼센트 이상 올쿨로 세팅하는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.878,
                "end": 57.182
            },
            {
                "speaker_id": "1",
                "transcription": "락스타도 22퍼센트 추천드리고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.192,
                "end": 59.945
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 치명타 확률은 5퍼센트 이상 그래야만 자 치명타 확률 버프 최대치로 받을 수가 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.955,
                "end": 66.934
            },
            {
                "speaker_id": "1",
                "transcription": "자 박하사탕은 현재 최신쿠키이지만 활용가치가 좀 많이 낮고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.944,
                "end": 71.862
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임을 아무리 높여도 용과 브레스 타이밍 전에 힐이 들어오지 않기 때문에 스킬발동이 좀 어렵습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 71.872,
                "end": 78.505
            },
            {
                "speaker_id": "1",
                "transcription": "힐량이 나빠서 안 쓴다는 게 아니라 힐 타이밍 자체가 조금 불안정하다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 78.515,
                "end": 83.940
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕보다는 락스타나 스냅 드래곤 쪽으로 키우는 게 더 좋다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 83.950,
                "end": 88.333
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅 드래곤의 정말 높아졌습니다.",
                "sound_type": [
                    2
                ],
                "start": 88.343,
                "end": 91.418
            },
            {
                "speaker_id": "1",
                "transcription": "피해감소 증가가 10초 동안 15퍼센트가 붙어있죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 91.428,
                "end": 94.265
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키가 정말 대세가 되면서 피해감소 무시 때문에 피해감소 증가 이 능력이 엄청나게 중요해졌고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 94.275,
                "end": 102.159
            },
            {
                "speaker_id": "1",
                "transcription": "아군의 생존뿐만 아니라 공격력 증가 해로운 감소도 있기 때문에 스냅 드래곤 올 락스타와 함께 좀 더 중점적으로 키워주면 좋다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 102.169,
                "end": 110.124
            },
            {
                "speaker_id": "1",
                "transcription": "자 노움 연구소에서 매일매일 3회 무료 뽑기 가능가 가능하거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 110.134,
                "end": 114.338
            },
            {
                "speaker_id": "1",
                "transcription": "매일매일 뽑아주시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 114.348,
                "end": 116.033
            },
            {
                "speaker_id": "1",
                "transcription": "자 최종적으로 정리하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 116.043,
                "end": 117.845
            },
            {
                "speaker_id": "1",
                "transcription": "자 전설 키워야 되는 쿠키는 여러분들 블랙펄 위주로 먼저 키워주는 게 좋아보이고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 117.855,
                "end": 123.873
            },
            {
                "speaker_id": "1",
                "transcription": "자 드래곤 등급의 용과 드래곤 반드시 키워주세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 123.883,
                "end": 127.158
            },
            {
                "speaker_id": "1",
                "transcription": "활용가치 좋습니다.",
                "sound_type": [
                    2
                ],
                "start": 127.168,
                "end": 128.770
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리는 대체 안되기 때문에 고대의 전승에서 필수로 없는 분들 골라주시고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 128.780,
                "end": 133.366
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 빠질 수 없는 필수 활용가치의 딜러입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 133.376,
                "end": 136.791
            },
            {
                "speaker_id": "1",
                "transcription": "네 반드시 키워주시고 소르베는 여유가 될 때 키우면 활용가치 있게 쓸 수는 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 136.801,
                "end": 142.793
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 소르베와 시론나이트의 정석덱도 정석덱으로 활용되고 있으니까 여유가 되는 분들은 세팅 제 유투브 보시고 요 조합 세팅해서 사용해도 좋고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 142.803,
                "end": 152.696
            },
            {
                "speaker_id": "1",
                "transcription": "파르페는 이전보다 활용이 조금 떨어졌다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 152.706,
                "end": 155.010
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타는 반드시 0순위로 키워주시고 박하사탕은 육성가치가 지금은 없어보입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 155.020,
                "end": 161.987
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅 드래곤을 중점적으로 키워라.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 161.997,
                "end": 163.982
            },
            {
                "speaker_id": "1",
                "transcription": "역시나 추가적으로 궁금한 점이 있다면 댓글에 남겨시고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 163.992,
                "end": 168.187
            },
            {
                "speaker_id": "1",
                "transcription": "제가 무지개 큐브 라이브에서 이벤트 하고 있거든요?",
                "sound_type": [
                    2
                ],
                "start": 168.197,
                "end": 172.176
            },
            {
                "speaker_id": "1",
                "transcription": "고정댓글 무지개큐브 받는 방법 적어놨으니까 확인해보시고 무지개 큐브 받아가시길 바랍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 172.186,
                "end": 179.679
            },
            {
                "speaker_id": "1",
                "transcription": "구독과 좋아요 한번씩만 부탁드립니다.",
                "sound_type": [
                    2
                ],
                "start": 179.689,
                "end": 181.884
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 181.894,
                "end": 195.233
            }
        ]
    },
    "summary": "전설 키워야 되는 쿠키는 블랙펄 위주로 먼저 키우는 게 좋고, 용과 드래곤은 반드시 키우고, 홀리베리는 반드시 선택하고 스타더스트 반드시 키우고, 소르베는 여유될 때 키우고, 락스타는 0순쉬로 키우고 스냅 드래곤을 중점적으로 키워야 합니다.",
