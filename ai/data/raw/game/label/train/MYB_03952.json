        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 와 여기서 약간 치명타 던진 것 같은데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.237
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 아까보다 더 압도적으로 이기는 느낌이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.247,
                "end": 9.684
            },
            {
                "speaker_id": "1",
                "transcription": "눈설탕이 좋아서 이긴 건 절대 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.694,
                "end": 12.072
            },
            {
                "speaker_id": "1",
                "transcription": "그 현재 원 템 덱이 있을 때 소원 덱으로 이렇게 클로티드 소원 덱으로 가서 원래 좋은 거고 그니까 오이스터가 안정적으로 이기는 느낌이 더 강하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.082,
                "end": 20.404
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 제가 지금 보여주는 과정은 뭐냐면 눈설탕이 상향됐다고 해서 기존에 쓰이던 소원 덱에 갑자기 오이스터 자리에 눈설탕이 들어가서 더 좋아지느냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.414,
                "end": 31.133
            },
            {
                "speaker_id": "1",
                "transcription": "절대 그건 아닙니다 현재로서는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.143,
                "end": 33.521
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 서리 디버프를 좀 더 활용해서 자 요렇게 쓰게 된다면은 피해량이 더 시너지가 좋겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.531,
                "end": 41.952
            },
            {
                "speaker_id": "1",
                "transcription": "빙괴 피해가 증가하니까 서로 뭐 요렇게도 쓸 수가 있겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.962,
                "end": 46.204
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.214,
                "end": 47.004
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요 덱한테 한번 대충 비교를 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.014,
                "end": 50.676
            },
            {
                "speaker_id": "1",
                "transcription": "비교를 할라고 하는 점은 딜적인 면이나 이 상황적인 면을 좀 보려고 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.686,
                "end": 56.447
            },
            {
                "speaker_id": "1",
                "transcription": "시너지를 어느 어느 정도 받을 수 있는지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.457,
                "end": 63.541
            }
        ]
    },
