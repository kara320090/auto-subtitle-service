        "term": [
            {
                "speaker_id": "1",
                "transcription": "비슷한데 아 저게 진짜 다 소르베였다면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.073
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 마무리 마지막",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.083,
                "end": 12.071
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 네 마쳤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.081,
                "end": 16.565
            },
            {
                "speaker_id": "1",
                "transcription": "자 이분 보면은 정말 비정상적으로 다크가 많이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.575,
                "end": 20.608
            },
            {
                "speaker_id": "1",
                "transcription": "무려 4개인가요 5개인가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.618,
                "end": 22.901
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나게 몰아서 떴고 모 없는 쿠키를 완품으로 오이스터, 서리 많이 나왔죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.911,
                "end": 29.065
            },
            {
                "speaker_id": "1",
                "transcription": "다크도 없던 거 많이 나왔고 나름 선방했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.075,
                "end": 32.177
            },
            {
                "speaker_id": "1",
                "transcription": "음유시인도 4성인데 이렇게 마무리 짓도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.187,
                "end": 35.824
            },
            {
                "speaker_id": "1",
                "transcription": "아주 잘 나왔네요.",
