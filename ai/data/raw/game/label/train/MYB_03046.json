    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현재 아레나에서 아직도 이 한방덱이 엄청나게 많이 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.932
            },
            {
                "speaker_id": "1",
                "transcription": "제 방덱에도 보면은 그마3인데도 불구하고 아직도 이 한방덱이 계속 들어오고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.942,
                "end": 12.028
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 보시겠지만 엄청나게 들어오고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.038,
                "end": 15.569
            },
            {
                "speaker_id": "1",
                "transcription": "계속 들어와요. 실시간으로도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.579,
                "end": 17.735
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 이 시점까지도 계속 들어오고 있는데 여러분들 방덱 설정을 요렇게 웨어울프로 세팅하게 되면은 엄청나게 높은 확률로 막을 수가 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.745,
                "end": 27.745
            },
            {
                "speaker_id": "1",
                "transcription": "요거에 대해서 제가 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.755,
                "end": 30.063
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 자체는 여러분들이 모노클 보물 쓰시고 홀리베리 같은 경우에는 그냥 올 아몬드, 올 아몬드에 쿨 그냥 여러분들 높게끔 한 8퍼센트 가까이해서 쓰는 분들도 있고 저처럼 그냥 쿨 하나 넣어서 써도 무방합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.073,
                "end": 44.907
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에 같은 경우에는 쿨이 16퍼센트 때 부 옵션 1줄만 하나만 껴있는 거 끼시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.917,
                "end": 52.077
            },
            {
                "speaker_id": "1",
                "transcription": "세트 효과 포함해서 21퍼에서 22퍼 사이 그다음 웨어울프 같은 경우에는 올 애플젤린데 뭐 들어보니까 이거 올 아몬드로 하시는 분도 있고 뭐 취향에 따라 이렇게 하시는 분이 나눠지는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.087,
                "end": 62.454
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 웨어울프가 너무 피감 낮아서 죽게 되면은 질 수도 있어요. 한방 뎀을 못 막을 수도 있습니다. 그래서 피해감소 어느 정도 수치를 높여 줄 수 있을 만큼 여러분들이 좀 신경 써 주시고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.464,
                "end": 74.897
            },
            {
                "speaker_id": "1",
                "transcription": "애플젤리나 아몬드 해주시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.907,
                "end": 77.463
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이거 부 옵션은 제가 그냥 마이웨이로 쿨이랑 공속 높으면 좋을 것 같아서 해줬는데 여러분들 능력껏 그냥 쿨, 공속 높으면은 좋다고 봅니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.473,
                "end": 87.424
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 같은 경우에는 그냥 여러분들 능력껏 피감이랑 쿨 높게끔 세팅을 해주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.434,
                "end": 94.167
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 뭐 정답이 어디다라고 말하기는 힘들어요. 상대의 조합에 따라 다 다르기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.177,
                "end": 99.965
            },
            {
                "speaker_id": "1",
                "transcription": "퓨바 같은 경우에는 그냥 올 아몬드에 쿨 8퍼센트",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.975,
                "end": 104.500
            }
        ]
    },
    "summary": "남성이 아레나에서 아직도 한방덱이 많이 쓰이고 있다며 방덱 설정에 웨어울프를 사용하면 높은 확률로 막을 수 있다고 하면서 캐릭터들의 세팅을 하나하나 알려주고 있습니다.",
