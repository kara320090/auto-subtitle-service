        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "얘도 맨 처음 나왔을 때 약간 놀림감 당하던 쿠키였어 여러분들.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.360
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 처음 나왔을 때 슈퍼커먼이라고 약간 놀림감 받던 쿠키인데 지금은 이제 아예 안 쓰이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.370,
                "end": 15.601
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 마일리지로 커터 살 수 있었지 않았나요 왜 없어진 거죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.611,
                "end": 19.366
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 뭔 사건이 있어가지고 옛날에는 마일리지로 커터를 살 수 있었거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.376,
                "end": 24.439
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제 문제가 풀 스펙인 분들은 뽑기를 이렇게 하면은 이제 풀 스펙이면 마일리지로 바뀌는데 문제는 이 마일리지 쌓인 걸로 커터를 샀어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.449,
                "end": 34.845
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뽑기를 했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.855,
                "end": 35.790
            },
            {
                "speaker_id": "1",
                "transcription": "근데 마일리지가 더 늘어나네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.800,
                "end": 38.076
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 뭔 소리냐면은 상점에서 커터를 사서 뽑기를 하면 할수록 마일리지가 더 증가되는 기이한 현상이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.086,
                "end": 45.005
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이제 만렙 풀스펙인 사람은 마일리지가 무한인 상태가 되는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.015,
                "end": 50.573
            },
            {
                "speaker_id": "1",
                "transcription": "그래가지고 이제 난리가 났지 게임이 마일리지 복사된다 없어졌습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.583,
                "end": 56.608
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 얘는 블랙레모네이드는 삼성까지",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.618,
                "end": 63.000
            }
        ]
    },
    "summary": "얘도 슈퍼커먼이라고 놀림 받던 쿠키인데 이제 아예 안 쓰고 옛날에 마일리지로 커터 살 수 있었는데 문제가 풀 스펙인 분들이 뽑기를 하면 마일리지로 바뀌는데 마일리지 쌓인 걸로 커터를 사서 뽑기를 하니까 마일리지가 더 늘어나는 기이한 현상으로 무한인 상태가 돼서 없어졌다.",
