                    3,
                    5
                ],
                "start": 6.865,
                "end": 13.642
            },
            {
                "speaker_id": "3",
                "transcription": "어 야 미러전 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.652,
                "end": 15.662
            },
            {
                "speaker_id": "3",
                "transcription": "야 잠깐만 무공비가 없어?",
                "sound_type": [
