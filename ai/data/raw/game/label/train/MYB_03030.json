                    3,
                    5
                ],
                "start": 4.742,
                "end": 6.855
            },
            {
                "speaker_id": "3",
                "transcription": "딜이 나쁘지는 않은데 자 그러면은 고스펙 분한테 한번 가볼까요?",
                "sound_type": [
