        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 복귀 유저분들을 위한 팁 영상 라이브 두 번째입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.457
            },
            {
                "speaker_id": "1",
                "transcription": "자 데브 협업 관련된 라이브 영상이고 여러분들께 최대한 도움 되는 영상으로 제가 설명을 좀 도와드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.090,
                "end": 12.797
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 영상의 목표는 뭐냐면 여러분들이 많이 질문하는 스토리덱 어떻게 해야 돼요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.135,
                "end": 18.715
            },
            {
                "speaker_id": "1",
                "transcription": "복귀 유저분들 많이 질문하시는 질문 중에 하나인데 어떤 쿠키를 써야 되는지 그리고 어떻게 키워야 되는지 추천을 드리는 정답이 아닌 그냥 추천을 드리는 형식으로 진행을 할 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.120,
                "end": 31.045
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 월드 탐험 같이 돌면서 비교를 해볼 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.310,
                "end": 34.012
            },
            {
                "speaker_id": "1",
                "transcription": "제가 작년 시점에서 스토리가 막 막혔거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.202,
                "end": 37.192
            },
            {
                "speaker_id": "1",
                "transcription": "막혔던 시점이 월드 탐험 난이도가 많이 내려가서 얼마나 쉬워졌는지 그 부분 체크해 드리고 어떤 쿠키 써서 진행해야 되는지도 같이 진행해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.392,
                "end": 47.685
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 막혔던 부분은 어디에서 막혔냐면은 자 11 다시 23입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.905,
                "end": 53.462
            },
            {
                "speaker_id": "1",
                "transcription": "예전에 요거 많이 막혀서 뭐 옛날에 뭐 딱총이나 뭐 아니면은 뭐 한방에 녹이는 빌드나 정말 다양한 빌드가 있어도 3별 클리어가 힘들었던 그런 스테이지인데 여기 제가 얼마나 많이 바뀌었는지 그냥 기본적으로 여러분들이 세팅할 수 있는 덱으로 평범하게 그냥 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.650,
                "end": 71.192
            },
            {
                "speaker_id": "1",
                "transcription": "자 어둠 모드에서 한 번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.407,
                "end": 73.087
            },
            {
                "speaker_id": "1",
                "transcription": "어 옛날에는 안 깨졌는데 지금은 어떻게 되는지 바로 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.247,
                "end": 79.846
            }
        ]
    },
    "summary": "복귀 유저들을 위한 팁 영상 두 번째 라이브는 데브 협업 관련된 라이브 영상이며 오늘 영상의 목표는 스토리덱을 어떻게 해야 하는지에 대한 것으로 남성이 어떤 쿠키를 써야 되는지 그리고 어떻게 키워야 되는지 월드 탐험을 돌면서 비교를 해 볼 예정이라고 하며 남성이 정말 다양한 빌드가 있어도 3별 클리어가 힘들었던 11 다시 23에서 스토리가 막혔는데 월드 탐험 난이도가 많이 내려가서 얼마나 쉬워졌는지 체크하기 위해 기본적으로 세팅할 수 있는 덱으로 평범하게 가보겠다고 한다.",
