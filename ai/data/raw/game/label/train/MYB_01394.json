        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 그래도 하나는 주지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.783
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막 자 이렇게 해서 야무지게 뽑았네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.793,
                "end": 8.603
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래도 이 분 없는 쿠키가 현재 달빛술사를 좀 뽑았어야 되는데 나머지는 좀 마일리지로 뽑아도 좋을 것 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.613,
                "end": 18.811
            },
            {
                "speaker_id": "1",
                "transcription": "급한 거는 토벌 관련된 쿠키들 먼저 뽑아주시구 달빛술사를 좀 뽑았어야 되는데 그래도 필수 쿠키 제일 중요한 쿠키를 잘 뽑았죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.821,
                "end": 27.100
            },
            {
                "speaker_id": "1",
                "transcription": "샤글도 뽑았고 용과 뽑았고 캡사 뽑았고 제일 중요한 스타더스트 뽑았고 이게 어딥니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.110,
                "end": 34.573
            },
            {
                "speaker_id": "1",
                "transcription": "네 락스타도 5 초월까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.583,
                "end": 36.743
            },
            {
                "speaker_id": "1",
                "transcription": "암튼 이렇게 이렇게 마무리 또 짓도록 하겠습니다.",
                "sound_type": [
