                    2,
                    3
                ],
                "start": 10.322,
                "end": 12.310
            },
            {
                "speaker_id": "1",
                "transcription": "이것과 똑닮았지만 보라색 빛을 띄었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.320,
                "end": 15.115
            },
            {
                "speaker_id": "1",
                "transcription": "왕이 갖고 있다고 잘못 본 거 아니야 나리?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.125,
                "end": 19.216
            },
            {
                "speaker_id": "1",
                "transcription": "단 한 번 봤을 뿐이지만 독특한 모양의 보석이라 쉽게 잊히지 않아.",
                "sound_type": [
