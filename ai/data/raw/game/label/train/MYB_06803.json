        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 보석이 몇 개 있다고 했지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.691
            },
            {
                "speaker_id": "1",
                "transcription": "일곱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.701,
                "end": 4.152
            },
            {
                "speaker_id": "1",
                "transcription": "내가 하나 알고 있는 것 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.162,
                "end": 7.331
            },
            {
                "speaker_id": "1",
                "transcription": "당신이 방황이 소유하고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.341,
                "end": 10.312
            },
            {
                "speaker_id": "1",
                "transcription": "열쇠검에 박혀 있었지.",
