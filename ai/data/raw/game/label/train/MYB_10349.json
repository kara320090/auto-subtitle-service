        "term": [
            {
                "speaker_id": "1",
                "transcription": "바람의 대륙 북동부에 위치한 국가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.402
            },
            {
                "speaker_id": "1",
                "transcription": "황도를 오리플람.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.412,
                "end": 3.930
            },
            {
                "speaker_id": "1",
                "transcription": "영내에 마더 크리스털 드레이크 헤드를 보유한 세계 최거의 최대의 종교 국가로 나라의 통치자는 신황이라 불린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.940,
                "end": 11.150
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 막 무슨 뭐 신이 계시를 줬다고 하면서 자꾸 전쟁하려고 막 그랬잖아요. 그쵸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.162,
                "end": 17.022
            },
            {
                "speaker_id": "1",
                "transcription": "음. 유일신 그레리 그에리고르가 드래곤을 거느렸다는 전설이 있어 드래곤을 성수로 여기며 군의 정예인 용기사는 바로 그 상징이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.032,
                "end": 27.285
            },
            {
                "speaker_id": "1",
                "transcription": "음 종교 국가인데 왕이 자기가 신탁을 받았다 이러면서 자꾸 전쟁을 부추겨요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.295,
                "end": 33.332
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 사람들이 신탁이라고 하면은 그냥 바로 껌뻑 죽어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.342,
                "end": 38.133
            }
        ]
    },
    "summary": "여자 게임 유튜버는 게임 속 국가에 대한 설명을 그대로 읽으며 종교 국가인데 왕이 자기가 신탁을 받았다고 하면서 전쟁을 부추기고 사람들은 신탁을 맹신한다고 첨언한다.",
