        "term": [
            {
                "speaker_id": "1",
                "transcription": "내 지느러미 때문에 놀랐어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.050
            },
            {
                "speaker_id": "1",
                "transcription": "파도를 가르며 가볼까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.060,
                "end": 5.911
            },
            {
                "speaker_id": "2",
                "transcription": "저는 아가씨가 가는 곳이면 어디든 함께 할 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.921,
                "end": 14.196
            },
            {
                "speaker_id": "2",
                "transcription": "쿠키런 킹덤 아가씨를 만난 그날을 잊을 수 없을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.206,
                "end": 21.243
            },
            {
                "speaker_id": "3",
                "transcription": "자 요렇게 영상 같이 봤고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.253,
                "end": 23.880
            },
            {
                "speaker_id": "3",
                "transcription": "자 9월 8일 날 업데이트 금요일 날 진행하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.890,
                "end": 28.131
            },
            {
                "speaker_id": "3",
                "transcription": "맨날 하는 것처럼 오후 2시부터 7시까지 업데이트가 진행될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.141,
                "end": 35.097
            },
            {
                "speaker_id": "3",
                "transcription": "자 일단 프릴해파리는 에픽 지원형이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.107,
                "end": 38.455
            },
            {
                "speaker_id": "3",
                "transcription": "중앙에 위치하게 되는 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.465,
                "end": 41.239
            },
            {
                "speaker_id": "3",
                "transcription": "프릴해파리는 속박 스킬을 사용하는 지원형이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.249,
                "end": 45.214
            },
            {
                "speaker_id": "3",
                "transcription": "자 일단은 5마리를 다리로 속박해서 물거품 피해를 주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.224,
                "end": 50.466
            }
        ]
    },
    "summary": "남성이 쿠키런 킹덤 영상을 같이 봤고 업데이트 날짜와 시간 소개 후 프릴해파리 설명을 한다.",
