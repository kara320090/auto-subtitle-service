        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 아주 깔끔하게 이기는 그림을 볼 수가 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.618
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 블랙레모네이드의 역할이 뭐냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.628,
                "end": 6.398
            },
            {
                "speaker_id": "1",
                "transcription": "전방의 탱커를 순식간에 녹여주는 역할을 하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.408,
                "end": 9.227
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 돼서 실론나이트 덱의 무력화시키는 역할을 톡톡히 해주고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.237,
                "end": 14.721
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 원리로 상대 전방 탱커를 녹이는 전략이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.731,
                "end": 20.128
            },
            {
                "speaker_id": "1",
                "transcription": "앞에 홀리베리를 집중 공략하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.138,
                "end": 24.349
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 홀리베리를 죽이고 나서 부활을 먼저 홀리베리한테 뺏어내고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.359,
                "end": 31.009
            },
            {
                "speaker_id": "1",
                "transcription": "일단 중요한 건 파르페는 여러분 반드시 써야 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.019,
                "end": 34.378
            },
            {
                "speaker_id": "1",
                "transcription": "소르베가 있으면 디버프 무효화를 아군 쿠키한테 시켜주기 때문에 실론덱이 있다면 써서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.388,
                "end": 45.966
            }
        ]
    },
    "summary": "한 남성이 실론덱을 상대할 때 전방의 탱커를 무력화시키는 전략을 설명하고 있다.",
