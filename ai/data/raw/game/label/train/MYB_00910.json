    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뽑아서 스냅 드래곤 완품을 얻으시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.948
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 또 하나 질문 퓨어바닐라 있는데 퓨어바닐라 써도 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.958,
                "end": 6.771
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타맛 쿠키가 너무 승급이 낮고 아니면 토핑도 너무 부족하다 하시는 분들은 퓨어바닐라로 그냥 쓰셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.781,
                "end": 14.431
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 다른 질문 하나가 블랙펄 쿠키 키울지 아직 달빛수사 키울지 아니면 바다요정 키울지 잘 모르겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.441,
                "end": 21.356
            },
            {
                "speaker_id": "1",
                "transcription": "자 전설의 귀한 이벤트로 레전더리 쿠키 선택 상자가 주어졌을 때 4개 중에 어떤 걸 선택해야 되냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.366,
                "end": 27.600
            },
            {
                "speaker_id": "1",
                "transcription": "4개 전부 다 없을 때 블래펄 선택하시는 게 가장 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.610,
                "end": 31.154
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 선택해야 될게 달빛수사입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.164,
                "end": 33.608
            },
            {
                "speaker_id": "1",
                "transcription": "세 번째로는 바다요정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.618,
                "end": 35.747
            },
            {
                "speaker_id": "1",
                "transcription": "네 서리여왕은 현재 쓰임새가 거의 없고요 자 블랙펄 쿠키는 현재 잼스톤의 리더 효과가 너무나 사기적이예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.757,
                "end": 42.675
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 1레벨만 되더라도 적의 피해 감소가 15퍼센트 무시가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.685,
                "end": 47.395
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 잼스톤 리더 효과를 받기 위해서라도 1강을 올려주시는게 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.405,
                "end": 53.362
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정은 그러면은 별론가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.372,
                "end": 55.525
            },
            {
                "speaker_id": "1",
                "transcription": "물론 바다요정도 수호성전에서나 아레나에서 쓸 수는 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.535,
                "end": 59.442
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 활용 가치가 블랙펄보다는 낮기 때문에 우선 순위를 블랙펄 먼저 키우라는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.452,
                "end": 65.023
            },
            {
                "speaker_id": "1",
                "transcription": "자 그럼 러너님 달빛수사는 그러면 이제 나락간건가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.033,
                "end": 67.896
            },
            {
                "speaker_id": "1",
                "transcription": "아닙니다 달빛수사 여전히 좋게 쓰이고 있고요 아직도 현역 0티어입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.906,
                "end": 72.453
            },
            {
                "speaker_id": "1",
                "transcription": "모든 컨텐츠에서 활용 가치가 좋고 올 쿨 토핑으로 쓰시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.463,
                "end": 76.866
            }
        ]
    },
    "summary": "락스타맛 쿠키가 너무 승급이 낮고 아니면 토핑도 너무 부족하다 하면 퓨어바닐라로 사용하면 되고 전설의 귀한 이벤트로 레전더리 쿠키 선택 상자가 주어졌을 때 블랙펄, 달빛수사, 바다요정 순서대로 우선적으로 선택하는 게 좋다.",
