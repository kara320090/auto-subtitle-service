                ],
                "start": 8.364,
                "end": 15.065
            },
            {
                "speaker_id": "1",
                "transcription": "오 그걸 들었어요? 난 아예 들리지도 않았는데 귀도 밝아라 아유 감사합니다.",
                "sound_type": [
                    2
                ],
