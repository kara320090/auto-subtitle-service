        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 그닥 그렇게 막 엄청 차이가 나는 건 없네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.119
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 됐고 이제 마지막은 크림 유니콘이랑 휘낭시에 같이 쓸게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.129,
                "end": 11.486
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.496,
                "end": 12.927
            },
            {
                "speaker_id": "1",
                "transcription": "일단 2개 오 야 크림 유니콘은 완전 다르다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.937,
                "end": 22.667
            },
            {
                "speaker_id": "1",
                "transcription": "별가루 날리네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.677,
                "end": 24.108
            },
            {
                "speaker_id": "1",
                "transcription": "오 휘낭시에는 별자리가 이어지는 것 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.118,
                "end": 30.251
            },
            {
                "speaker_id": "1",
                "transcription": "야 이것도 되게 디테일하게 바꼈는데요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.261,
                "end": 32.329
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 예쁜데 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.339,
                "end": 33.464
            },
            {
                "speaker_id": "1",
                "transcription": "야 이건 가치 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.474,
                "end": 35.543
            },
            {
                "speaker_id": "1",
                "transcription": "이거 퀄리티 제일 좋은 거 같은데?",
