        "term": [
            {
                "speaker_id": "1",
                "transcription": "그쵸 옛날에는 모든 쿠키가 살아있어도 이제 죽일 수가 없어가지고 시간 부족 때문에 못 깨는 경우가 있었는데 지금은 달라졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.455
            },
            {
                "speaker_id": "2",
                "transcription": "바다의 희망",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.445,
                "end": 10.650
            },
            {
                "speaker_id": "3",
                "transcription": "물러설 수 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.660,
                "end": 11.424
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 시간이 남아돌아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.434,
                "end": 13.891
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 딱총 보물이나 단일 딜러 뱀파이어 쓰지 않아도 시간이 무려 거의 뭐 1분 30초 남겠는데요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.901,
                "end": 21.135
            },
            {
                "speaker_id": "1",
                "transcription": "차이가 많이 나도록 네 패치가 됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.385,
                "end": 23.705
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 난이도가 여러분들 기존이 10단계였다고 한다면 지금은 3단계 정도로 낮춰졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.520,
                "end": 29.732
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 제가 체감되기에는 그 정도로 쉬워졌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.817,
                "end": 34.132
            },
            {
                "speaker_id": "1",
                "transcription": "보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.470,
                "end": 35.395
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 프로필도 여러분들 얻으면서 갈 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.510,
                "end": 39.792
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 해서 스토리 정말 비교가 될 정도로 쉽게 클리어가 가능하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.245,
                "end": 45.247
            },
            {
                "speaker_id": "1",
                "transcription": "자 스토리를 밀면 장점이 여러분들 이게 크리스탈도 얻게 되고 그다음에 뭐 영혼석 조각이나 다양한 보상을 얻을 수 있으니까 좀 얻으시면 되고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.780,
                "end": 55.688
            }
        ]
    },
    "summary": "옛날에는 모든 쿠키가 살아있어도 시간 부족 때문에 못 깨는 경우가 있었는데 난이도가 기존이 10단계였다고 한다면 지금은 3단계 정도로 낮춰져서 딱총 보물이나 단일 딜러 뱀파이어를 쓰지 않아도 시간이 남아돌고 쉽게 클리어가 가능하며 스토리를 밀면 크리스탈도 얻게 되고 영혼석 조각이나 다양한 보상을 얻을 수 있다는 장점이 있다.",
