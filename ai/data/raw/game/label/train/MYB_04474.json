            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "킹덤에 이제 다음 업데이트 관련된 내용이 어 스포가 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.583
            },
            {
                "speaker_id": "1",
                "transcription": "자 프랑스 공식 트위터 쿠키런 킹덤 채널에 이렇게 다음 업데이트 관련 소식이 올라왔다가 뭔가 화들짝 놀라서 금방 들어간 내용이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.593,
                "end": 14.674
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 보면은 마카롱 관련된 이미지도 같이 떴었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.684,
                "end": 18.674
            },
            {
                "speaker_id": "1",
                "transcription": "근데 잘못 올라온 건지는 금방 들어갔거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.684,
                "end": 22.475
            },
            {
                "speaker_id": "1",
                "transcription": "관련된 내용은 자세히 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.485,
                "end": 24.671
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 해석을 해보면은 자 첫 번째는 카오스 토탈이라는 거는 이걸 말하는 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.681,
                "end": 30.120
            },
            {
                "speaker_id": "1",
                "transcription": "대난투가 다시 부활하는 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.130,
                "end": 32.356
            },
            {
                "speaker_id": "1",
                "transcription": "화면을 보시면 옆에 체력바 같은 거에 점 같은 게 되어있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.366,
                "end": 36.346
            },
            {
                "speaker_id": "1",
                "transcription": "고게 3번 전투한다 이렇게 보여지거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.356,
                "end": 40.328
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 대난투가 다음 업데이트 때 다시 돌아온 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.338,
                "end": 44.256
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 두 번째는 아마 데코 관련해서 추가라 나온다 이런 내용 같고 세 번째가 이제 마카롱 쿠키가 나온다 이런 내용 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.266,
                "end": 54.217
            },
            {
                "speaker_id": "1",
                "transcription": "우측 하단을 보면 마카롱 쿠키 관련된 이미지가 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.227,
                "end": 56.807
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로는 스킨 표시와 같이 비 에이 디 포와 관련된 신규 스킨이 나오고 아마 리듬 게임도 마스터 모드가 나올 나올 거 같은 그런 느낌으로 화면에 나와있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.817,
                "end": 70.000
            }
        ]
    },
