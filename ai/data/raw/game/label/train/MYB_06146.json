        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금 와일드 벨이랑 흑당 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.372
            },
            {
                "speaker_id": "1",
                "transcription": "근데 얘가 스킬 쓰면 뒤로 물러가면은 앞에 탱커가 얘 하나가 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.382,
                "end": 8.084
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 이게 오이스터를 넣고 가는 게 더 나요 샤베보다는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.094,
                "end": 13.092
            },
            {
                "speaker_id": "1",
                "transcription": "와흑당일 때는 요게 더 낫고 와닥흑 요런 식으로 갈 때는 샤벳, 샤벳을 넣고 가면 되고 그렇게 하면 되는데 저는 그런데 이렇게 그냥 가요 이렇게 넣어도 다 이겼습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.102,
                "end": 24.942
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 공속덱이든 투 탱 흑당덱이든",
                "sound_type": [
                    2,
