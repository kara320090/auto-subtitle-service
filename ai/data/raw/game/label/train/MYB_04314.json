        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래서 생물들이 탄소를 이렇게 먹으면서 진행한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.073
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 단계죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.083,
                "end": 5.681
            },
            {
                "speaker_id": "1",
                "transcription": "생각보다 게임은 좀 무난하게 할 수 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.691,
                "end": 9.051
            },
            {
                "speaker_id": "1",
                "transcription": "요것도 장애물을 점프 뛰어서 피할 수 있고 지금 왼쪽 상단에 보면 하트가 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.061,
                "end": 13.787
            },
            {
                "speaker_id": "1",
                "transcription": "그 하트가 다 달면 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.797,
                "end": 15.640
            },
            {
                "speaker_id": "1",
                "transcription": "네 모두 다 클리어가 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.650,
                "end": 18.028
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 응모하기가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.038,
                "end": 20.438
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이름하고 핸드폰 번호 해서 경품 응모하면은 응모가 완료됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.448,
                "end": 25.375
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 여러분들이 이벤트 참여를 하고 나면",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.385,
                "end": 28.661
            }
        ]
    },
    "summary": "남성은 게임은 무난하게 할 수 있을 거라고 했고 장애물은 점프해서 피하는데 왼쪽 상단에 있는 하트가 다 달면 안된다고 했고 클리어를 하면 응모하기가 나오는데 이름과 핸드폰 번호를 적으면 경품 응모가 완료된다고 했다.",
