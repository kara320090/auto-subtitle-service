        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "겨울 공국이 세워지기 전의 세상의 끝의 생활은 비참했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.998
            },
            {
                "speaker_id": "1",
                "transcription": "당시네는 사람이 사람을 잡아 먹는 건 평범한 일이었다고 하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.008,
                "end": 8.219
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 그런 시절에도 착한 사람들은 있었던 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.229,
                "end": 10.937
            },
            {
                "speaker_id": "1",
                "transcription": "고운 심성의 부부 앞에 한 마법사가 나타나 백설과의 씨앗을 주고 떠났다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.947,
                "end": 15.833
            },
            {
                "speaker_id": "1",
                "transcription": "마법사는 부부에게 이렇게 당부했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.843,
                "end": 18.184
            },
            {
                "speaker_id": "1",
                "transcription": "백설과는 기르는 이의 마음이 반영돼 착한 심성을 유지하지 않으면 좋은 과실을 맺을 수 없을 거라고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.194,
                "end": 24.734
            },
            {
                "speaker_id": "1",
                "transcription": "실제 부부의 아들은 성질이 고약한 자라 마음을 고쳐 먹기 전까지는 제대로 된 백설과를 기르지 못했다고 하더군.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.744,
                "end": 32.933
            }
        ]
    },
    "summary": "화자는 백설과는 기르는 이의 마음이 반영돼 착한 심성을 유지하지 않으면 좋은 과실을 맺을 수 없다고 한다.",
