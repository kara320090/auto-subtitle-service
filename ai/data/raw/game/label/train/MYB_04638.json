        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "10월 13일 BTS 콜라보 업데이트 이후에 여러가지 문제점이 발생했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.221
            },
            {
                "speaker_id": "1",
                "transcription": "자동적으로 로딩 화면에서 게임 화면으로 전환시 화면이 비정상적으로 깨짐 현상",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.231,
                "end": 8.873
            },
            {
                "speaker_id": "1",
                "transcription": "리듬 게임 플레이 시 정산 점수가 0점으로 판정되는 현상",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.883,
                "end": 12.800
            },
            {
                "speaker_id": "1",
                "transcription": "후르츠칸 앵무의 해변 교역소의 캐러멜 망원경 및 지도 조각 수량 오류 현상",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.810,
                "end": 17.318
            },
            {
                "speaker_id": "1",
                "transcription": "마일리지샵에서 쿠키 영혼석을 구매할 경우 영혼석 1개당 마일리지 5개가 지급되는 현상",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.328,
                "end": 22.440
            },
            {
                "speaker_id": "1",
                "transcription": "계정마다 광고 보상을 받을 수 있는 계정과 보상을 받을 수 없는 계정이 나뉘는 현상이 발생하였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.450,
                "end": 28.590
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 광고 보상 문제는 아직 공지도 없고 문의 했을 때 관련 부서에 전달하겠다는 얘기만 반복하는 상태라 유저들의 불만이 쌓이고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.600,
                "end": 36.420
            },
            {
                "speaker_id": "1",
                "transcription": "우편함에 받는 일일 광고 횟수는 3회이고 1회당 토핑 조각 2개, 무지개큐브 30개, 크리스탈 30개고 하루에 최대 토핑 조각은 60개, 무지개큐브는 90개 크리스탈 90개까지 받을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.430,
                "end": 48.692
            },
            {
                "speaker_id": "1",
                "transcription": "현재 업데이트 이후에 7일이 지났지만 이전에 매일매일 광고를 보고 보상을 받아왔던 사람들 입장에서는 광고 보상을 못 받는 상황에 손실이 계속 나고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.702,
                "end": 57.777
            },
            {
                "speaker_id": "1",
                "transcription": "이외에도 광고 보고 무료 선물받기도 계정마다 활성화 된 사람과 안 된 사람으로 나뉘고 남은 시간 단축하기 광고 보상도 계정마다 다릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.787,
                "end": 66.577
            },
            {
                "speaker_id": "1",
                "transcription": "다만 일부 유저분들은 시간 단축하기 광고를 5회 다 시청하면 우편함 광고가 활성화 안 되는 분들은 다시 광고가 뜨는 경우도 있다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.587,
                "end": 76.000
            }
        ]
    },
