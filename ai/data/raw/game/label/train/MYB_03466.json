        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오로라 재료가 지금 많이 부족한데 저 어디다 많이 투자하고 계시지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.950
            },
            {
                "speaker_id": "1",
                "transcription": "네 영토 확장은 일단 멈추시고 제가 볼 때는 이 열차가 멈추면 안 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.960,
                "end": 8.360
            },
            {
                "speaker_id": "1",
                "transcription": "계속 돌리셔야 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.360,
                "end": 9.990
            },
            {
                "speaker_id": "1",
                "transcription": "연구부터 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.990,
                "end": 11.380
            },
            {
                "speaker_id": "1",
                "transcription": "여기 더 뚫어서 여기 보면 뒤에도 연구 가속 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.380,
                "end": 14.930
            },
            {
                "speaker_id": "1",
                "transcription": "말 그대로 연구를 가속시켜 주는 거고 만랩 찍으면은 무려 15 퍼센트까지 가속이 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.930,
                "end": 20.620
            },
            {
                "speaker_id": "1",
                "transcription": "요거 여기까지 일단 쭉쭉 뚫어서 연구 가속 많이 할 수 있게끔 찍어 주는 게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.620,
                "end": 25.680
            },
            {
                "speaker_id": "1",
                "transcription": "연구 가속 위주로 먼저 찍어 주시고 여유가 되면은 대장간도 만렙을 다 찍어 주시고 기본 재료 생산 가속 이런 거 우유나 솜사탕 이런 거 위주로 먼저 하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.680,
                "end": 35.250
            },
            {
                "speaker_id": "1",
                "transcription": "이 쿠키 연구보다는 지금 왕국 연구부터 하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.250,
                "end": 38.300
            },
            {
                "speaker_id": "1",
                "transcription": "지금 초반 자체에서 랭커가 당장에 힘들기 때문에 좀 더 멀리 내다보면 쿠키 연구보다는 왕국 연구 먼저 해야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.300,
                "end": 45.840
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 시간이 지날수록 얘는 이득을 보기 때문에 지금 다 찍어서 올라가고 있는데 1가지 말씀드릴 거는 가끔가다 보면은 돌격형 10레벨 뭐 바다 요정 많이 쓰니까 공격형 10레벨",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.840,
                "end": 58.830
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 하나 몰빵으로 절대 하지 마시고 얘는 하나씩, 하나씩, 2개씩, 2개씩, 3개씩, 3개씩 쭉 그냥 똑같이 올라가세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.830,
                "end": 66.625
            }
        ]
    },
    "summary": "열차가 멈추면 안 되고 연구를 만랩 찍으면 15 퍼센트까지 가속이 되기 때문에 이것을 위주로 먼저 찍어 주고 여유가 된다면 대장간도 업그레이드하는 것이 좋으며 왕국 연구를 먼저 해야 시간이 지날수록 이득을 볼 수 있고 돌격형, 공격형의 레벨을 똑같이 만드는 것이 좋다.",
