                ],
                "start": 0.000,
                "end": 18.618
            },
            {
                "speaker_id": "1",
                "transcription": "네 업데이트는 8월 9일 날 일단은 뭐 골드치즈 업데이트는 아니고요.",
                "sound_type": [
                    2,
