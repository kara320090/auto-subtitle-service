    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.143
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.153,
                "end": 6.428
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.438,
                "end": 10.384
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 두 번째 쿠키성 15렙까지 빨리 찍고 싶은데 12렙에서 잠시 쿠키 하우스 레벨 업하고 연구도 하고 가는 게 좋을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.394,
                "end": 18.730
            },
            {
                "speaker_id": "1",
                "transcription": "무작정 13성 14성 15성 이렇게 빨리 가는 거가 정답은 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.740,
                "end": 23.931
            },
            {
                "speaker_id": "1",
                "transcription": "12성까지 찍고 거기 와서 살짝 한 템포 줄여가지고 쿠키 하우스 10레벨 찍고 랜드마크 레벨 업 어느 정도 찍고 근데 그 와중에 준비는 하셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.941,
                "end": 34.017
            },
            {
                "speaker_id": "1",
                "transcription": "13성 찍을 수 있게 12렙에서 그 조건을 맞춰주시면서 준비하시면서 나머지 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.027,
                "end": 40.066
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키 하우스는 7레벨까지 맞추고 12성 가려면 코인이 부족해서 멈췄습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.076,
                "end": 44.484
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 5레벨로만 맞춰도 그 12렙 가서 10레벨까지 찍어도 상관없기 때문에 지금 멈추세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.494,
                "end": 50.960
            },
            {
                "speaker_id": "1",
                "transcription": "네 지금도 괜찮아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.970,
                "end": 52.804
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 네 번째 연구소도 최대한 많이 돌리고 싶은데 코인과 재고가 너무 많이 필요해서 선뜻 돌리기가 어렵다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.814,
                "end": 58.551
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키성 레벨 업이 먼저인지 연구가 먼저인지 알려주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.561,
                "end": 61.634
            },
            {
                "speaker_id": "1",
                "transcription": "연구소 같은 경우에는 지금 코인이 많이 부족하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.644,
                "end": 64.822
            },
            {
                "speaker_id": "1",
                "transcription": "부족하면은 연구소 너무 부담되는 가격을 안 돌려도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.832,
                "end": 69.808
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 같은 건 다 찍어주고 왕국 연구 같은 거는 멈추지 않고 돌리는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.818,
                "end": 75.988
            },
            {
                "speaker_id": "1",
                "transcription": "노움 연구소는 멈추면 안 되긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.998,
                "end": 78.100
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 얘 일단은 12성 찍고 찍고 갑시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.110,
                "end": 81.786
            },
            {
                "speaker_id": "1",
                "transcription": "12성 찍고 나머지 다 돌려주는 방향으로 신전도 봐달라 신전을 먼저 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.796,
                "end": 87.568
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기까지 하셨고 네 잘하셨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.578,
                "end": 90.448
            },
            {
                "speaker_id": "1",
                "transcription": "여기에는 마법사탕 쿠키는 가급적이면 넣지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.458,
                "end": 93.577
            },
            {
                "speaker_id": "1",
                "transcription": "마법사탕 애들은 직접 50렙까지 퀴워야만 마탕을 능력을 활성화시킬 수 있기 때문에 마탕 쿠키는 넣지 말고 여기다가 해주면 그 여기 안에 넣은 쿠키들도 지금 잘 넣었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.587,
                "end": 104.882
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 레벨 70레벨까지 올릴 수 있는데 키우던 쿠키들 먼저 70렙 찍는 게 좋을지 아니면 다른 쿠키들도 60렙 먼저 맞춰주는 게 좋을지 알려주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 104.892,
                "end": 114.505
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 수호 신전에 있는 얘네들 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 114.515,
                "end": 117.246
            },
            {
                "speaker_id": "1",
                "transcription": "다 하나씩 올라가서 얘네들도 같이 올라가게끔 만드는 게 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 117.256,
                "end": 121.630
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 뭐 웬만큼 다 됐고 지금 더 제가 추가적으로 아까 10가지 질문 중에 추가로 해야 될 거는 수호 성전 덱이랑 아레나 덱 그를 2개가 남았죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 121.640,
                "end": 130.542
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 일단은 왕국을 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 130.552,
                "end": 132.710
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 쿠키성 11렙이고 길드 가입은 이분이 하지 않은 이유는 좀 더 높은 길드를 가기 위해서 그래서 나와있다 그렇게 아시면 됩니다 여러분들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 132.720,
                "end": 141.320
            },
            {
                "speaker_id": "1",
                "transcription": "자 다음 창고 200칸까지 늘려주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 141.330,
                "end": 143.642
            },
            {
                "speaker_id": "1",
                "transcription": "크 탈 모으시면은 좀 여유롭게를 200칸까지 확장을 해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 143.652,
                "end": 147.588
            },
            {
                "speaker_id": "1",
                "transcription": "고렇게 해주시고 지금 재고 상태도 보니까 134면은 열심히 하고 계시는 게 딱 보이네 이게 보통 재고에 관심이 없으신 분들은 이게 되게 많이 낮거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 147.598,
                "end": 157.653
            },
            {
                "speaker_id": "1",
                "transcription": "열심히 생산하고 계시고 그리고 오로라 재료 상태가 지금 어 300개 아니 잠깐만 왜 이렇게 많아 그러면 영토 확장은 이 라인까지 해도 될 것 같아요 요 라인.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 157.663,
                "end": 168.037
            },
            {
                "speaker_id": "1",
                "transcription": "요 라인 쭉 네 요 정도 되고 지금 그러면 쿠키성 레벨 업이나 뭐 다른 거 레벨 업할 때 오로라 재료 걱정은 없기 때문에 코인만 집중해서 얻으시면 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 168.047,
                "end": 177.929
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 계정 주인분 얘는 어떻게 하시냐면 일일 보상 이렇게 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 177.939,
                "end": 182.528
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 3단계로 보상을 받을 수 있는데 월 화 수 목 금은 3단계까지만 받으시면 되는데 여기서 교환할 때 상위 품목 애들은 가급적이면 교환하지 마시고 모았다가 주말에 20퍼센트 코인 추가 보상 버프가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 182.538,
                "end": 198.246
            },
            {
                "speaker_id": "1",
                "transcription": "그때 주말에 몰아서 싹 다 교환해서 코인을 더 많이 받아가시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 198.256,
                "end": 202.639
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이 퀘스트 깰 때는 가급적이면은 빨리빨리 만들 수 있는 젤리빈이나 단계가 낮은 애들 교환을 해가지고 이 보상을 3단계까지 다 채워주시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 202.649,
                "end": 212.183
            },
            {
                "speaker_id": "1",
                "transcription": "코인 티끌 모아 태산이라고 이 토핑작 할 때도 이거 하지 마시고 이거라도 끼고 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 212.193,
                "end": 218.688
            },
            {
                "speaker_id": "1",
                "transcription": "이거 우스갯소리로 하는 게 아니라 진짜 찐으로 토핑작 많이 돌릴 때는 쉽게 난이도 깨지는 구간은 지금 정도 스펙이면 토핑작 어느 정도 하잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 218.698,
                "end": 227.829
            },
            {
                "speaker_id": "1",
                "transcription": "이거 찐으로 진짜 이렇게 해서 돈 더 벌어서 하는 거 맞아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 227.839,
                "end": 233.400
            }
        ]
    },
