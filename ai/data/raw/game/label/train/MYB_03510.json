                    3
                ],
                "start": 70.627,
                "end": 78.426
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 또 얻을 수 있긴 한데 방금 시작한 분들은 다 얻을 수가 없을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.436,
                "end": 83.357
            },
            {
                "speaker_id": "1",
                "transcription": "좀 열심히 하시는 분들은 보상을 받을 수 있는데 보상 같은 경우에도 엄청나게 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.367,
                "end": 89.921
            },
            {
                "speaker_id": "1",
                "transcription": "크리스탈 3000개, 2000개, 3000개 거의 뭐 8000개 여러분들이 얻을 수 있다.",
                "sound_type": [
                    2,
