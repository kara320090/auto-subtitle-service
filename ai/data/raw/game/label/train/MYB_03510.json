                    3
                ],
                "start": 54.658,
                "end": 65.171
            },
            {
                "speaker_id": "1",
                "transcription": "여기에서 여기 코드를 입력하면 바로 전부 다 입력해서 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.181,
                "end": 70.617
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 콜라보 쿠키 영운석도 5개 선택해서 얻을 수 있기 때문에 이거 다 필수로 얻으시면 되고.",
                "sound_type": [
