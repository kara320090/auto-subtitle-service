            },
            {
                "speaker_id": "1",
                "transcription": "자 진행 방법 리세마라 하는 방법을 알려드리면은 처음에 게스트로 시작하기 누르고 게스트로 진행하시면 됩니다.",
                "sound_type": [
                    2,
