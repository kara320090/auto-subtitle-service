                    3,
                    5
                ],
                "start": 7.872,
                "end": 15.118
            },
            {
                "speaker_id": "1",
                "transcription": "아 제발 좀 그 미니 게임이 제2의 소다 제도처럼 나오지 않았으면 좋겠어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.128,
                "end": 20.833
            },
            {
                "speaker_id": "1",
                "transcription": "막상 오픈하니까 제2의 소다 제도야.",
                "sound_type": [
