        "term": [
            {
                "speaker_id": "1",
                "transcription": "다른 의미로 바꾸는 게 어떨까 여러분들?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.258
            },
            {
                "speaker_id": "1",
                "transcription": "만악에 내가 쫌 약간 살을 빼면",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.268,
                "end": 5.073
            },
            {
                "speaker_id": "1",
                "transcription": "아 엔디 그대로 하고 뜻을 바꾸면 뉴 다이어트?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.083,
                "end": 11.158
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘은 진짜 주구장창 나오네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.168,
                "end": 14.393
            },
            {
                "speaker_id": "1",
                "transcription": "아 엔디 뜻을 나우 다이어트로 하자?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.403,
                "end": 19.342
            },
            {
                "speaker_id": "1",
                "transcription": "지금 다이어트 중이다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.352,
                "end": 21.490
            },
            {
                "speaker_id": "1",
                "transcription": "고것도 괜찮네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.500,
                "end": 22.979
            },
            {
                "speaker_id": "1",
                "transcription": "와 야 이거 잠깐만 쫌 이거 나팔 불고 가야 되겠다 왜 이래?",
                "sound_type": [
                    2,
