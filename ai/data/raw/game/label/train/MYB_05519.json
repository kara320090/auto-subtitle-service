        "term": [
            {
                "speaker_id": "1",
                "transcription": "높은 단계까지 갈 수 있다고 하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.137
            },
            {
                "speaker_id": "1",
                "transcription": "요거 말고 여러분들 마이웨이 덱으로 가면은 그냥 엄청나게 그냥 죽어버리니까 저런 식으로 하면 되고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.147,
                "end": 10.679
            },
            {
                "speaker_id": "1",
                "transcription": "자 감초 같은 경우에는 아직 뭐 최적화된 조합이나 빌드가 나오지는 않았거든요 감초 토벌 1단계는 이거 @이름1 님이 만든 빌드거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.689,
                "end": 20.301
            },
            {
                "speaker_id": "1",
                "transcription": "펌킨 올 라즈 쿨 5퍼센트 권장 오이스터는 29.3퍼센트 세트 효과 이상 해주시면 소환 4마리 되는 거",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.311,
                "end": 27.641
            },
            {
                "speaker_id": "1",
                "transcription": "목화 같은 경우에도 최대한 높게 20퍼센트 이상 뭐 이렇게 해 주시면 될 거 같고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.651,
                "end": 31.929
            },
            {
                "speaker_id": "1",
                "transcription": "호밀 같은 경우에도 쿨 6퍼센트 요거 신경 써 주시면 되고 올 라즈 뱀파도 쿨 7퍼센트 올 라즈",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.939,
                "end": 39.322
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 해서 무공비 예 핀 쿠션, 시계 요걸로 하면 된다고 하니까 보여드리게스 겠습니다 이거.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.332,
                "end": 45.427
            },
            {
                "speaker_id": "1",
                "transcription": "아 맨 처음에 다 그냥 스킬 빠르게 빼줘도 된대요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 45.437,
                "end": 49.557
            },
            {
                "speaker_id": "1",
                "transcription": "네 쓸 수 있는 건 바로 다 빼주고 나머지는 쿨 돌 때마다 그냥 해주시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 49.567,
                "end": 58.008
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿨 돌 때마다 다 써주고",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 58.018,
                "end": 61.933
            }
        ]
    },
