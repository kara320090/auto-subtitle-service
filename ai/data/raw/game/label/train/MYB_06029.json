        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 1초월이 넘어간 건 맞죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.226
            },
            {
                "speaker_id": "1",
                "transcription": "아 잠만, 이거 5성을 찍어야지만 나오나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.236,
                "end": 5.574
            },
            {
                "speaker_id": "1",
                "transcription": "일단 얘 5성 먼저 찍을게요.",
