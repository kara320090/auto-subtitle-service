        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 배터리 2개 필요하다고 떴어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.345
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 여기 있네 하나 하나 찾았어요 여러분들.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.355,
                "end": 15.162
            },
            {
                "speaker_id": "1",
                "transcription": "오 야 이렇게 되구나 그래서 얘를 뭐 타고 갈 수 있어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.172,
                "end": 21.334
            },
            {
                "speaker_id": "1",
                "transcription": "얘 타고 갈 수 있나?",
