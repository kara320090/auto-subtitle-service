        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이 덱이 올라갈 시점이면 이제 아레나 종료가 몇 시간 안 남았을 겁 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.750
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 지금 현재 정말 가장 좋은 덱 예언자맛 쿠키 정말 엄청나게 사기적으로 좋거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.750,
                "end": 11.489
            },
            {
                "speaker_id": "1",
                "transcription": "전에 리뷰했을 때는 제가 2성인가 3성밖에 안 돼서 좋을지 모르겠다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.499,
                "end": 16.030
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 5초월되면 리뷰하겠다 했는데 현재 엄청나게 좋게 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.044,
                "end": 20.630
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 객 같은 경우에는 모노클 시기의 무공비고 토핑부터 보면은 자 홀리베리 같은 경우에는 쿨 하나 껴줘서 쿨 여러분들이 능력과 높이 높여 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.630,
                "end": 30.257
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 11퍼센트 후반대라도 괜찮으니까 최대한 높게 세팅을 해 주시면 되고 소르베 또한 마찬가지 네 올쿨로 세팅해서 전부 다 피감하고 쿨을 높게 했고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.267,
                "end": 41.000
            },
            {
                "speaker_id": "1",
                "transcription": "24퍼센트 이상 달빛술사도 마찬가지 쿨, 피 자 이번에 보면은 쿨, 피가 되게 높은 걸 요구하죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.000,
                "end": 47.979
            },
            {
                "speaker_id": "1",
                "transcription": "어 능력껏 여러분들 최대한 높게 세팅을 해주시고 서리여황 같은 경우에는 8퍼센트 가까이에다가 피가 높게끔 여유 있으면 공, 치 그다음에 예언자 같은 경우에도 치명타 이거 알죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.989,
                "end": 59.267
            },
            {
                "speaker_id": "1",
                "transcription": "9퍼센트대 맞춰야지만 여러분들의 서리 능력을 쓸 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.277,
                "end": 65.083
            }
        ]
    },
    "summary": "현재 정말 가장 좋은 덱은 예언자맛 쿠키로 객 같은 경우에는 모노클 시기의 무공비고 토핑부터 보면 홀리베리 같은 경우에는 쿨 하나 껴줘서 쿨 능력을 높여 주고 11퍼센트 후반대라도 괜찮으니까 최대한 높게 세팅을 해 주면 되고 소르베 또한 마찬가지로 세팅해서 전부 다 피감하고 쿨을 높여 주면 된다.",
