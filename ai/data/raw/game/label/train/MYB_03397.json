    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 뽑기는 다 됐고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.271
            },
            {
                "speaker_id": "1",
                "transcription": "바로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.281,
                "end": 3.517
            },
            {
                "speaker_id": "1",
                "transcription": "일단 70렙까지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.527,
                "end": 7.820
            },
            {
                "speaker_id": "1",
                "transcription": "자 승급도 5성까지 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.830,
                "end": 11.001
            },
            {
                "speaker_id": "1",
                "transcription": "자 초월은 이따가 하고 자 일단 스킵 능력부터 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.011,
                "end": 14.488
            },
            {
                "speaker_id": "1",
                "transcription": "자 밀키웨이맛 쿠키 같은 경우에는 열차에 올라타면 기절 저항 버프를 모든 아군한테 걸고 피해 감소 버프를 자신한테 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.498,
                "end": 24.238
            },
            {
                "speaker_id": "1",
                "transcription": "열차는 돌진하여 적들을 여러 번 밀어낸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.248,
                "end": 27.228
            },
            {
                "speaker_id": "1",
                "transcription": "방어력 감소 디버와 피해를 주고 열차 운행이 종료되면 자신과 아군에게 보호막을 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.238,
                "end": 32.785
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 꿈을 꾸는 밀키웨이맛 쿠키는 꿈의 잠식에 걸리지 않고 일반 공격이 자신을 회복하네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.795,
                "end": 38.857
            },
            {
                "speaker_id": "1",
                "transcription": "평타가 나를 회복한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.867,
                "end": 41.290
            },
            {
                "speaker_id": "1",
                "transcription": "자 돌진 지속 피해량 2초 동안 12회 피해, 1회 피해량은 114.1퍼센트 돌진 보호막 피 추가 피해는 쿠키는 114.1퍼센트 그리고 돌진 1회 방어력 감소는 7초 동안 3.5퍼센트 보스에게 방어력 감소 3개 발동",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.300,
                "end": 57.401
            },
            {
                "speaker_id": "1",
                "transcription": "일단 확실한 거는 얘는 대천사에서는 안 쓰이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.411,
                "end": 60.376
            },
            {
                "speaker_id": "1",
                "transcription": "중첩 최대 25개 자 피해 감소는 10초 동안 40퍼센트 자기 자신한테 피해 감소 오는 거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.386,
                "end": 66.754
            },
            {
                "speaker_id": "1",
                "transcription": "기절 저항은 10초 동안 기절 지속 시간 50퍼센트 감소",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.764,
                "end": 71.611
            },
            {
                "speaker_id": "1",
                "transcription": "자신 체력 보호막 30초 간 최대 체력이 20퍼센트 아군 체력 보호막은 3초 동안 최대 체력이 15.5퍼센트 받는 회복량은 15퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.621,
                "end": 80.152
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 능력을 봤고 자 바로 리뷰를 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.162,
                "end": 84.806
            },
            {
                "speaker_id": "1",
                "transcription": "자 5성입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.816,
                "end": 85.951
            },
            {
                "speaker_id": "1",
                "transcription": "5성",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.961,
                "end": 86.329
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 토핑 같은 경우에는 뭐 앞에 탱커이기 때문에 당연히 아몬드 기반으로 가야 될 것 같은데 15초네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.339,
                "end": 92.709
            },
            {
                "speaker_id": "1",
                "transcription": "네 그냥 올 아몬드 세팅하면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.719,
                "end": 94.965
            },
            {
                "speaker_id": "1",
                "transcription": "자 아몬드 세팅 49퍼센트 피감으로 세팅해 주고 자 가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.975,
                "end": 102.936
            }
        ]
    },
    "summary": "발화자가 게임 캐릭터 밀키웨이맛 쿠키의 능력치에 대해서 설명하고 토핑을 어떻게 했는지 보여주고 있습니다.",
