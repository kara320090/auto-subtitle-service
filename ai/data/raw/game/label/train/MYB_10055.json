        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이게 브금으로 깔리는 거 아닌가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.427
            },
            {
                "speaker_id": "1",
                "transcription": "아 맞구나 근데 왜 이렇게 우울해 노래가?",
