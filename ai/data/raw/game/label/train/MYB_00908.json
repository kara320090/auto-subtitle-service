        "term": [
            {
                "speaker_id": "1",
                "transcription": "파르페맛 쿠키를 쓰는 분들 자 파르페는 10강 이상 올려주시면 아레나에서 활용가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.881
            },
            {
                "speaker_id": "1",
                "transcription": "단 여러분들이 아레나에서 퓨어바닐라 대신에 힐러 하나로만 쓰려면은 피해감소가 되게 높아야 되요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.891,
                "end": 13.256
            },
            {
                "speaker_id": "1",
                "transcription": "최소 피해감소가 뭐 28, 29 이 정도 되야만 1분 지나서 브레스도 견딜랑 말랑 하기 때문에 파르페 혼자 쓰는 거는 좀 추천하지 않고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.266,
                "end": 22.762
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 락스타맛 쿠키는 일반적으로 올 쿨을 쓰지만 자 락스타는 일부러 피해감소를 낮췄습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.772,
                "end": 28.085
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 1분 지나서 가장 먼저 죽기 위해서 고의적으로 피감을 낮춰서 많이 쓰고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.082,
                "end": 34.000
            },
            {
                "speaker_id": "1",
                "transcription": "0으로 맞춰서 쓰는 분도 있고 5에서 10으로 맞춰서 쓰는 분이 가장 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.000,
                "end": 38.434
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 확률은 5퍼센트로 맞춰줘야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.444,
                "end": 40.766
            }
        ]
    },
    "summary": "파르페맛 쿠키는 10강 이상 올리면 아레나에서 활용가능하고 락스타맛은 일부러 피해감소를 낮춰서 사용한다.",
