                    5
                ],
                "start": 0.000,
                "end": 2.275
            },
            {
                "speaker_id": "1",
                "transcription": "야야야 저거 세 마리 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.285,
                "end": 4.580
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐만 있어 봐 우리 계획을 좀 짜야 돼 우리 대화 좀 해.",
                "sound_type": [
