                "start": 0.000,
                "end": 5.699
            },
            {
                "speaker_id": "1",
                "transcription": "실전에서 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.709,
                "end": 7.495
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키가 5마리 전부 다 적용되면 모를까 단 한 마리의 쿠키만 적용되기 때문에 자 일단은 지금 작아졌어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.505,
                "end": 16.931
            },
            {
                "speaker_id": "1",
                "transcription": "자색 고구마 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.941,
                "end": 18.039
            },
            {
                "speaker_id": "1",
                "transcription": "조그만 거 네 저렇게 돼서 목소리도 작아지는 효과가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.049,
                "end": 23.896
            },
            {
                "speaker_id": "1",
                "transcription": "지금 휘낭시에도 작아졌죠?",
