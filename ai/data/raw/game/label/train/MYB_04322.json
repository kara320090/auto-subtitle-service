                    2,
                    3
                ],
                "start": 6.627,
                "end": 15.835
            },
            {
                "speaker_id": "1",
                "transcription": "와 무공비 안나왔어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.845,
                "end": 22.285
            },
            {
                "speaker_id": "1",
                "transcription": "큰일 났다 이거 그리고 저 같은 경우에는 왜 마일리지 보뽑에 썼나요? 이렇게 물어보실 수 있는데 쿠키 덱이 어느 정도 완성돼 가지고 그래도 무공비 좀 노려보는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.295,
                "end": 32.743
            },
            {
                "speaker_id": "1",
                "transcription": "초반에 그 덱이 완성 안 된 분들은 마일리지로 0티어 쿠키 모아 모으셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.753,
                "end": 38.177
            },
            {
                "speaker_id": "1",
                "transcription": "그 담에 3다시 10까지 빨리 빨리 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.187,
                "end": 41.600
            },
            {
                "speaker_id": "1",
                "transcription": "그래야 쿠키성 레벨업 레벨업 할 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.610,
                "end": 47.066
            }
        ]
    },
    "summary": "남성은 쿠키 덱이 어느 정도 완성을 해서 무공비를 노려보기 위해서 마일리지를 썼다고 했고 덱이 완성 안 된 분들은 마일리지로 0티어 쿠키 모아야 한다고 했다.",
