            },
            {
                "speaker_id": "1",
                "transcription": "지금 올 쿨이에요 달빛은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.563,
                "end": 8.600
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 내가 볼 때 이거 그냥 달빛술사 가면 다 이기는 거 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.610,
                "end": 14.612
            },
            {
                "speaker_id": "1",
                "transcription": "야 올 쿨로 해도 딜이 이렇게 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.622,
                "end": 17.934
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 한 번 더 써서 그런가?",
