    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 오늘도 마이 힐링 타운 모바일 추천 1순위 게임입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.525
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 게임은 정말 현질이 필요 없고 정말 힐링할 수 있는 게임 이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.535,
                "end": 14.678
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 친구랑 같이 게임 하면서 왕꾸를 같이 할 수 있다는 장점이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.688,
                "end": 20.609
            },
            {
                "speaker_id": "1",
                "transcription": "어 대신 막 수확도 해 줄 수 있구요 돕기를 통해서 내가 재배한 작물을 도와줄 수도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.619,
                "end": 28.065
            },
            {
                "speaker_id": "1",
                "transcription": "왕꾸를 하기 위해서 영토 확장도 지속적으로 가능 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.075,
                "end": 32.251
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 집안 꾸미기도 가능하구요 이 전체 영토 자체도 크게 늘릴 수가 있고 친구들끼리 이렇게 전체 영토도 4개 합쳐 가지고 크게 꾸밀 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.261,
                "end": 44.394
            },
            {
                "speaker_id": "1",
                "transcription": "자 가장 중요한 거는 뭐 친구들끼리 이렇게 제가 부족한 재고를 보내줄 수도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.404,
                "end": 50.767
            },
            {
                "speaker_id": "1",
                "transcription": "좀 스트레스가 적다 생산에 대한 압박감이 없다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.777,
                "end": 54.776
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 재화를 많이 퍼 줍니다 자 지금도 주사위 돌려서 이렇게 쭉쭉 가면 다 재화입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.786,
                "end": 60.985
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 여기서 여러분들한테 말씀 드리고 싶은 거는 주사위 돌려서 얻는 재화들 가만히 냅두고 엑스 눌러서 나가면 안 되구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.995,
                "end": 67.744
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 얻은 재화는 한 번 눌러 줘야 돼요 이렇게 받는 재화를 볼 수가 있습니다 미션 통해서 왼쪽에 있는 거 클리어 해서 얻으면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.754,
                "end": 75.939
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여러분들이 이 게임을 시작하게 되면 프로필을 눌러서 여러분들이 서버 선택을 할 수가 있거든요 계정 관리를 해서 서버 선택이 가능해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.949,
                "end": 85.186
            },
            {
                "speaker_id": "1",
                "transcription": "이 다른 서버에서 기껏 많이 했다가 서버 연동을 하게 되면 옮길 수 있는데 자 서버를 이동하면은 다시 키워야 됩니다 그래서 시작하신 분 들은 바로 연동해서 서버 이동해서 시작을 해 주시면 되구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.196,
                "end": 98.294
            },
            {
                "speaker_id": "1",
                "transcription": "구글 연동을 하시면 됩니다 자 그리구 코인은 어떻게 모아요 코인 같은 경우에는 자 초반에는 표류병 납부를 통해서 이렇게 코인을 많이 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.304,
                "end": 108.997
            },
            {
                "speaker_id": "1",
                "transcription": "환경 점수 도시 점수 뭐 요런 거 다 계속 얻으면서 게임을 진행할 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 109.007,
                "end": 115.220
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리구 여러분들 레벨 올릴 수록 컨텐츠가 계속 무궁무진 하게 나오고 있거든요 저도 아직 레벨 26이라서 많이 오픈 되지 않았지만 앞으로 컨텐츠가 계속 계속 열립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 115.230,
                "end": 127.873
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리구 쿠폰이 지금 현재 많이 있거든요 9개 이상 있기 때문에 쿠폰 입력하면은 여러분들 이 크리스탈도 얻을 수 있고 다양한 재화를 얻을 수 있기 때문에 고정 댓글에 게임 다운로드 링크와 쿠폰 번호도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 127.883,
                "end": 142.097
            },
            {
                "speaker_id": "1",
                "transcription": "제가 단톡방도 운영하기 때문에 들어와서 친구도 찾고 가족도 찾고 같이 하면 좋을 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 142.107,
                "end": 148.329
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리구 무엇보다 무한으로 이 시간만 차면은 공짜로 조각을 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 148.339,
                "end": 154.739
            },
            {
                "speaker_id": "1",
                "transcription": "조각이라 함은 동물을 뽑을 수 있거든요 동물마다 건물 건설 단축이나 생산 단축 시간을 해 주는 각각의 능력이 다르기 때문에 많이 뽑으면은 되게 왕국을 빨리 발전 시킬 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 154.749,
                "end": 167.553
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 바다 개척 이런 컨텐츠가 열리면은 다양한 미니 게임도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 167.563,
                "end": 172.278
            },
            {
                "speaker_id": "1",
                "transcription": "네 보시면 아시겠지만 요런 미니 게임도 있어요 뭐 저 네 잘은 못 해도 이런 식으로 플레이 하다 보면은 다 깰 수가 있습니다 각각의 조건이 다 있어요 어떻게 하면은 되는지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 172.288,
                "end": 183.657
            },
            {
                "speaker_id": "1",
                "transcription": "요런 재화는 어차피 요런 미니 게임을 통해서 다 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 183.667,
                "end": 188.341
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 축제에 입장하면은 상자를 오픈해서 보상도 받을 수 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 188.351,
                "end": 192.589
            },
            {
                "speaker_id": "1",
                "transcription": "오 SSR 동물을 얻을 수 있는 특제 보물 상자도 있습니다 자 여러분들 이 게임은 정말 제 지인 분들이 저한테 적극 추천해서 제가 시작을 하게 됐고 자 이 게임은 과금이 전혀 필요 없고 여러분들이 힐링하면서 왕꾸하고 친구들이랑 같이 할 수 있는 재미있는 게임입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 192.599,
                "end": 212.389
            },
            {
                "speaker_id": "1",
                "transcription": "고정 댓글로 다운로드 링크가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 212.399,
                "end": 214.997
            },
            {
                "speaker_id": "1",
                "transcription": "다운로드 하시고 어 쿠폰 입력하고 에 저한테 친추 주시면 자리 날 때마다 제가 받도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 215.007,
                "end": 221.872
            },
            {
                "speaker_id": "1",
                "transcription": "자 ND러너 이렇게 1섭으로 선택해서 오시면 친추 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 221.882,
                "end": 226.522
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 마이 힐링 타운 팁 영상 같은 경우에도 다음 주에 이어서 쭉 올려보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 226.532,
                "end": 237.033
            }
        ]
    },
    "summary": "힐링 타운 모바일 추천 1순위 게임은 현질이 필요 없고 힐링할 수 있는 게임이며 재화도 미니 게임 같은 것을 통해 얻을 수 있으며 친구나 가족과 함께 왕꾸를 할 수 있는 재미있는 게임이다.",
