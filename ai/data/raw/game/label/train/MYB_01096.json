        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄은 1강만 해도 정말 유용하게 쓸 수 있고요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.422
            },
            {
                "speaker_id": "1",
                "transcription": "아군 쿠키의 스킬 피해가 적의 피감무시기 때문에 1강부터 15퍼센트 피감무시가 적용됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.432,
                "end": 8.916
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛 술사 같은 경우에는 네 일반적으로 무난하게 올쿨토핑 추천드리고, 워낙 활용가치가 다양하고 조합도 다양하기 때문에 때에 따라서 올 라즈베리 사용하기도 합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.926,
                "end": 21.880
            },
            {
                "speaker_id": "1",
                "transcription": "자 스타더스트 같은 경우에는 세팅에 따라 정말 토핑조합이 다양한데 보통 3초를 사용할 때는 4애플젤리 1쿨에서 10점 3퍼센트 이상 세팅을 해주시거나 아니면 락스티랑 같이 쓸 때는 요렇게 4라즈베리 1애플젤리로 쓰거나 아니면 락스타 없이 극딜조합으로 쓸 때는 이렇게 3라즈베리 2애플젤리로 씁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.890,
                "end": 41.342
            },
            {
                "speaker_id": "1",
                "transcription": "쿨이 높게 세팅되거나 낮게 세팅되거나 이거는 상대방의 공격타이밍에 따라서 각각 전략적으로 바꿔서 사용하고 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 41.352,
                "end": 49.934
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝글리터는 현재 많이 사용되고 있지는 않습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 49.944,
                "end": 53.984
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 쿠키가 나쁜건 절대 아니고요.",
                "sound_type": [
                    2
                ],
                "start": 53.994,
                "end": 56.578
            },
            {
                "speaker_id": "1",
                "transcription": "다만 현재 유행하는 조합에서 살짝 뒤에 빠져있다 보시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.588,
                "end": 61.031
            },
            {
                "speaker_id": "1",
                "transcription": "자 보통 일반적으로 4라즈베리 1애플젤리나 3라즈베리 2애플젤리 쓰고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.041,
                "end": 66.162
            },
            {
                "speaker_id": "1",
                "transcription": "3초를 만들기 위해서는 쿨타임 2.8퍼센트 이상 너무 잘 죽으면 이렇게 아몬드랑 섞어서 라즈베리랑 같이 써주시면 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.172,
                "end": 74.433
            }
        ]
    },
    "summary": "블랙펄은 1강만 해도 유용하고 달빛술사는 올쿨토팅 추천하고, 스타더스트는 공격타이밍에 따라서 전략적으로 사용하고, 일반적으로 4라즈베리 1애플젤리나 3라즈베리 2애플젤리로 씁니다.",
