        "term": [
            {
                "speaker_id": "1",
                "transcription": "잠깐 본론에는 들어 가지도 않았거든?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.487
            },
            {
                "speaker_id": "1",
                "transcription": "마을에서 빠져나갈 수 있는 방법을 알려 줄게.",
