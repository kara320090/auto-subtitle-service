                    3
                ],
                "start": 2.497,
                "end": 4.782
            },
            {
                "speaker_id": "1",
                "transcription": "알려줄 테니까 우리 대화 좀 하자고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.792,
                "end": 11.431
            },
            {
                "speaker_id": "1",
                "transcription": "이 마을에서 빠져 나가려면 어찌 됐든 관문을 열 반지가 필요해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.441,
                "end": 19.237
            },
            {
                "speaker_id": "1",
                "transcription": "장로 놈들이 가지고 있는데 그 녀석들 강력한 요마가 되어 버렸거든.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.247,
                "end": 23.771
            },
            {
                "speaker_id": "1",
                "transcription": "이 마을에 제일 이 마을 이 마을 제일의 사냥꾼 도움 없이는 녀석들에게서 반지를 얻는 건 힘들 걸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.781,
                "end": 31.901
            },
            {
                "speaker_id": "2",
                "transcription": "그나마 고려해볼 가치가 있는 제안입니다만 이 인간을 동행으로 삼으실 거면 인장을 심는 건 필수 사항입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.911,
                "end": 38.896
            },
            {
                "speaker_id": "1",
                "transcription": "인장이든 낙인이든 뭐든 찍으라고 일단 꺼내주기만 해줘.",
