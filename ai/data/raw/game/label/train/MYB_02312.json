        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 옛날에 엄청나게 순삭시키는 그런 모습 화력의 공속덱 그런 모습을 다시 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.442
            },
            {
                "speaker_id": "1",
                "transcription": "야 이게 바로 공속덱의 본 모습이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.452,
                "end": 18.504
            },
            {
                "speaker_id": "1",
                "transcription": "최고의 공격 마들렌 마들렌이 최고입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.514,
                "end": 22.311
            },
            {
                "speaker_id": "1",
                "transcription": "마탕 달고 나오니까 미쳐 날뛰고 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 22.321,
                "end": 25.076
            },
            {
                "speaker_id": "1",
                "transcription": "거의 지금 무상성 급으로 승률이 거의 100퍼센트 가까운 상태거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.086,
                "end": 30.458
            },
            {
                "speaker_id": "1",
                "transcription": "제가 지금 해보고 있는데 캡사이신 5초월이나 3초월 초월 높은 분들도 그리고 토핑이 엄청나게 좋은 분들도 지금 공속덱한테는 다 순삭 당하고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.468,
                "end": 43.415
            },
            {
                "speaker_id": "1",
                "transcription": "아 어마무시합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.425,
                "end": 51.200
            }
        ]
    },
    "summary": "공속덱 마들렌이 마탕을 달고 나오니까 무상성 급으로 승률 100퍼센트에 가까운 상태가 되어 상대를 순삭시키고 있다.",
