        "term": [
            {
                "speaker_id": "1",
                "transcription": "27퍼센트를 준다는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.090
            },
            {
                "speaker_id": "1",
                "transcription": "거의 진짜 공격력만 따지면 상당히 많이 올라가는 거긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.100,
                "end": 5.998
            },
            {
                "speaker_id": "1",
                "transcription": "27퍼센트라는 게 기본 방어력도 기본 기조 대비의 15퍼센트 기존 체력도 기준 대비 15퍼센트의 체력증가 버프 아이콘이 노출되도록 있게 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.008,
                "end": 17.946
            },
            {
                "speaker_id": "1",
                "transcription": "제 생각에는 토벌에서 진짜 진지하게 쓸 수도 있는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.956,
                "end": 22.852
            },
            {
                "speaker_id": "1",
                "transcription": "한번 봐야 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.862,
                "end": 24.418
            },
            {
                "speaker_id": "1",
                "transcription": "길드 토벌전이 정말 단순 개편되는 게 아니라 진짜 엄청나게 대대적인 개편을 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.428,
                "end": 30.436
            },
            {
                "speaker_id": "1",
                "transcription": "길드 토벌전 몬스터 보스 몬스터 공통 개선사항 보스 몬스터 및 소환 된 몬스터들의 공격이 치명타가 발생하지 않도록 변경됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.446,
                "end": 39.016
            },
            {
                "speaker_id": "1",
                "transcription": "대천사의 침묵요구나 아니면은 뭐 각종 치명타에 의해서 뜬금사하는 경우를 겪으신 분들이 많을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.026,
                "end": 45.730
            },
            {
                "speaker_id": "1",
                "transcription": "근데 변수가 발생하지 않도록 패치하는 요거 같은 경우는 아마 불만 가진 사람이 단 한 명도 없을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.740,
                "end": 53.535
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 길드 토벌 단계에 따라 보스 몬스터의 체력 비율이 하향은 조정됩니다..",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.545,
                "end": 59.600
            }
        ]
    },
