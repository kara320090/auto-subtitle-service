        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 미쳤다 미친 거 아니에요 진짜?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.033
            },
            {
                "speaker_id": "1",
                "transcription": "아니 진짜 정신 나간 거 아니야 게임?",
                "sound_type": [
                    2
                ],
                "start": 4.043,
                "end": 6.165
            },
            {
                "speaker_id": "1",
                "transcription": "나 한 나 한 10년은 앞선 게임을 한 것 같은 기분이야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.175,
                "end": 10.567
            },
            {
                "speaker_id": "1",
                "transcription": "한 5년 정도 10년은 에바고.",
                "sound_type": [
                    2
                ],
                "start": 10.577,
                "end": 12.676
            },
            {
                "speaker_id": "1",
                "transcription": "5년은 앞선 게임을 한 거 같아.",
                "sound_type": [
                    2
                ],
                "start": 12.686,
                "end": 15.390
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 개쩐다.",
                "sound_type": [
                    2
                ],
                "start": 15.400,
                "end": 19.257
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 어떻게 하냐 진짜 몰라 말로 표현이 안 돼.",
                "sound_type": [
                    2
                ],
                "start": 19.267,
                "end": 22.022
            },
            {
                "speaker_id": "1",
                "transcription": "그나마 지금 어떤 기분이냐면",
                "sound_type": [
                    2
