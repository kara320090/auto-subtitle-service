        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.743
            },
            {
                "speaker_id": "1",
                "transcription": "아 얘 아레나 외에서도 좋나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.753,
                "end": 10.628
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 것 같은데요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.638,
                "end": 12.001
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 밖에서도.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 12.011,
                "end": 13.729
            },
            {
                "speaker_id": "1",
                "transcription": "상대 몹들을 광역 딜러 광역 딜에다가 스턴까지 넣어가지고 뭐 당연히 스토리에서 나쁠 이유가 하나도 없지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.739,
                "end": 22.203
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 보통 스토리에서 좋냐 나쁘냐의 기준이 어떤 걸로 가냐면은 딴딴해야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.213,
                "end": 27.170
            },
            {
                "speaker_id": "1",
                "transcription": "근데 얘 자체적인 피감은 30퍼센트나 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.180,
                "end": 29.831
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이거 이게 너무 사기야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.841,
                "end": 31.560
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 그냥 쿠키런 킹덤에서 나올 수 있는 모든 최고의 탑 버프를 다 가지고 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.570,
                "end": 37.875
            },
            {
                "speaker_id": "1",
                "transcription": "아군한테 공격력 증가 본인 공격 속도 증가 상대방 기절시키고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.885,
                "end": 43.600
            }
        ]
    },
    "summary": "남성 화자가 스토리에서 좋냐 나쁘냐의 기준이 딴딴함인데 얘는 자체적인 피감이 30퍼센트나 있다고 너무 사기이고 쿠키런 킹텀에서 나올 수 있는 모든 최고의 탑 버프를 다 가지고 있다고 말한다.",
