        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키성 13성 어느 정도 올려주셨고 그다음에 창고 같은 경우에는 252칸 넉넉하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.771
            },
            {
                "speaker_id": "1",
                "transcription": "근데 연구소 같은 경우에는 보게 되면은 설탕노음 건설 가속 무조건 다 만렙 찍어야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.781,
                "end": 11.787
            },
            {
                "speaker_id": "1",
                "transcription": "재료 생산 가속도 3단계 4단계까지 찍어야 되고 뒤에 쭉쭉 다 찍어야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.797,
                "end": 16.880
            },
            {
                "speaker_id": "1",
                "transcription": "끝까지 다 찍으셔야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.890,
                "end": 18.176
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 가장 기본적인 이것도 찍어야 돼요 이거 이거를 안 했다는 건 토핑작 자체를 안 하신다는 거네?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.186,
                "end": 24.295
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 노움 연구소는 아예 손 놓으신 것 같은데 천천히 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.305,
                "end": 27.858
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 연구부터 먼저 천천히 해주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.868,
                "end": 33.654
            }
        ]
    },
    "summary": "남성은 연구소 같은 경우에는 설탕노음 건설 가속은 무조건 다 만렙 찍어야 된다고 말한다.",
