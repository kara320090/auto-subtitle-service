        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어휴 야 대박 떴다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.627
            },
            {
                "speaker_id": "1",
                "transcription": "요런 게 이게 필요하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.637,
                "end": 4.696
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 세트 효과가 되면은 여기 세트 효과 보이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.706,
                "end": 7.953
            },
            {
                "speaker_id": "1",
                "transcription": "다 아몬드로 맞추면은 피해 감소 5퍼센트가 추가로 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.963,
                "end": 10.867
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해서 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.877,
                "end": 12.279
            },
            {
                "speaker_id": "1",
                "transcription": "에클리어 같은 경우에는 잘 하셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.289,
                "end": 14.499
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어는 올쿨로 하는 게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.509,
                "end": 16.104
            },
            {
                "speaker_id": "1",
                "transcription": "스토리에서도 캡틴케비어 올 라즈 잘 하셨어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.114,
                "end": 18.848
            },
            {
                "speaker_id": "1",
                "transcription": "목화도 풀을 세팅해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.858,
                "end": 21.378
            },
            {
                "speaker_id": "1",
                "transcription": "풀을 일단은 세팅해야 초콜릿 세트 효과를 받거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.388,
                "end": 24.540
            },
            {
                "speaker_id": "1",
                "transcription": "얘 스킬 파우더 쓰지 마세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.550,
                "end": 26.672
            },
            {
                "speaker_id": "1",
                "transcription": "초반에 스킬 파우더 겹치는 걸 잘 봐야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.682,
                "end": 28.989
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 그냥 똑같이 올리셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.999,
                "end": 30.955
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 똑같이 올리세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.965,
                "end": 32.073
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 어쩔 수 없지",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.083,
                "end": 34.200
            }
        ]
    },
    "summary": "세트 효과가 되면 아몬드로 맞춰주면 피해 감소 5퍼센트가 추가 되니 맞춰주고 에클리어 올쿨로 잘 했고 캡틴케비어 올 라즈로 잘 했고 목화도 풀 세팅을 해야 되는데 그래야 초콜릿 세트 효과를 받고 스킬 파우더는 쓰지 말고초반에 겹치는 걸 잘 봐야 된다.",
