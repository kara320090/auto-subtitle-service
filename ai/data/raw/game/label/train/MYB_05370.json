        "term": [
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘 4성도 5성까지 뽑고 갈까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.704
            },
            {
                "speaker_id": "1",
                "transcription": "어느 정도 뽑아 놓는 게 좋죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.714,
                "end": 4.341
            },
            {
                "speaker_id": "1",
                "transcription": "성능 자체가 너무 좋기 때문에 제가 볼 때는 앞으로 되게 좋은 힐러가 나오기까지는 되게 오랜 시간이 걸리지 않을까 그런 생각이 드네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.351,
                "end": 13.926
            },
            {
                "speaker_id": "1",
                "transcription": "자 벚꽃 벚꽃 여러분들 키우셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
