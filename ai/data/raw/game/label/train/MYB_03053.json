        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 요거는 투 힐 덱이네요? 투 힐 덱 1번 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.514
            },
            {
                "speaker_id": "1",
                "transcription": "상대가 버티고 버티고 하는 덱한테는 글쎄 약할 거 같은데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.524,
                "end": 11.247
            },
            {
                "speaker_id": "2",
                "transcription": "물러설 수 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.257,
                "end": 13.028
            },
            {
                "speaker_id": "1",
                "transcription": "네 이 덱 같은 경우에는 약점이 있어요. 예언자 덱한테는 진짜 약합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.038,
                "end": 16.773
            },
            {
                "speaker_id": "1",
                "transcription": "이 방 덱을 해놓으신 분들은 예언자 덱한테 약한데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.783,
                "end": 21.163
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거는 가운데를 이렇게 2개를 가리기 때문에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.173,
                "end": 24.592
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 웨어울프 덱인지 아닌지 무조건 티가 나는 건 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.602,
                "end": 28.176
            },
            {
                "speaker_id": "1",
                "transcription": "전투력도 그렇게 뭐 높은 것도 아니라서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.186,
                "end": 32.279
            },
            {
                "speaker_id": "1",
                "transcription": "어 모르겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.289,
                "end": 35.398
            },
            {
                "speaker_id": "3",
                "transcription": "겨울이 오고 있어.",
