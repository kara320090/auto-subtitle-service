        "term": [
            {
                "speaker_id": "1",
                "transcription": "스냅 드래곤 쿠키 획득 컨텐츠는 태동하는 용의 알 부화 설탕 노움 연구소에 스냅 드래곤 쿠키를 부활시킬 수 있는 용의 알 부화 콘텐츠가 추가된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 10.343
            },
            {
                "speaker_id": "1",
                "transcription": "순수의 설탕 결정으로는 1일 3회 부화 시도를 할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.353,
                "end": 16.365
            },
            {
                "speaker_id": "1",
                "transcription": "자 한마디로 이 내용은 스냅 드래곤은 기간 한정이 아니라 계속해서 뽑을 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.375,
                "end": 22.488
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 신규 스킨 2종이 추가가 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.498,
                "end": 25.485
            },
            {
                "speaker_id": "1",
                "transcription": "타르티타탕맛 쿠키랑 로얄 마가린이 스킨이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.495,
                "end": 29.051
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 2022년 올해의 쿠키 전사 스킨이 추가가 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.061,
                "end": 33.054
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 소르백 쿠키랑 블랙펄 쿠키 스킨이 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.064,
                "end": 36.120
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 전사 스킨 뽑기 레전드 스킨의 일정 기간 동안 고급 스킨 뽑기보다 더 높은 확률로 획득할 수 있는 전사 스킨 뽑기를 통해 획득할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.130,
                "end": 46.634
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 2022년 올해의 쿠키 전사 스킨 출시 기념 이벤트가 그리고 쿠키의 스킨 2년 달성 보상 시스템도 요렇게 추가가 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.644,
                "end": 58.018
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 인연의 홀 추가가 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.028,
                "end": 61.595
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 신규 건물 이렇게 하나가 더 추가가 되고 쿠키 하우스 스킨 추가 쿠키 인연도 추가가 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.605,
                "end": 68.244
            },
            {
                "speaker_id": "1",
                "transcription": "이번 업데이트 스냅 드래곤 추가랑 콘텐츠는 대난투가 재탕되어서 나오기는 하는데 한번 봐야 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.254,
                "end": 77.318
            },
            {
                "speaker_id": "1",
                "transcription": "스냅 드래곤이 얼마나 사기인지 BTS를 대체할 만한지 한번 봐야 될 거 같고 타르트타탕맛 쿠키는 토벌에서 쓰일만한지 한번 제가 리뷰를 해볼게요",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.328,
                "end": 87.219
            },
            {
                "speaker_id": "1",
                "transcription": "6월 8일 내일 업데이트인데 리뷰 날 보도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.229,
                "end": 90.953
            },
            {
                "speaker_id": "1",
                "transcription": "구독 좋아요 한 번씩만 부탁드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.963,
                "end": 93.277
            },
            {
                "speaker_id": "1",
                "transcription": "라이브 방송에서 뵐게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.287,
                "end": 100.966
            }
        ]
    },
