        "term": [
            {
                "speaker_id": "1",
                "transcription": "얘한테 옮겨 피감 이런 거 높은 거 딴 애 주세요. 바요나 이런 얘",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.905
            },
            {
                "speaker_id": "1",
                "transcription": "이거 지금 제가 세팅을 해드릴게요. 이거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.915,
                "end": 6.924
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해 가지고 공, 치만 이렇게 높일 수 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.934,
                "end": 9.308
            },
            {
                "speaker_id": "1",
                "transcription": "이러면 더 막강해집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.318,
                "end": 10.585
            },
            {
                "speaker_id": "1",
                "transcription": "피감 필요 없어요 쿨도 필요 없고 이거 지금 티켓도 엄청 많잖아요.",
                "sound_type": [
                    2,
