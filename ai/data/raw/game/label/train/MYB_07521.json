        "term": [
            {
                "speaker_id": "1",
                "transcription": "군사에 밝은 자가 지휘하는 게 좋겠지.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.337
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다 하벨 경.",
                "sound_type": [
                    2
                ],
                "start": 3.347,
                "end": 7.176
            },
            {
                "speaker_id": "1",
                "transcription": "네놈은 어떻게 할 생각이지?",
                "sound_type": [
                    2
                ],
                "start": 7.186,
                "end": 10.912
            },
            {
                "speaker_id": "1",
                "transcription": "치안은 계속 나빠질 건데 백성은 누가 이끄냐.",
                "sound_type": [
                    2
                ],
                "start": 10.922,
                "end": 15.870
            },
            {
                "speaker_id": "1",
                "transcription": "수환을 발휘해봐라.",
                "sound_type": [
                    2
                ],
                "start": 15.880,
                "end": 19.543
            },
            {
                "speaker_id": "1",
                "transcription": "제가 근데 서브퀘가 많이 남았습니다.",
                "sound_type": [
                    2
                ],
                "start": 19.553,
                "end": 23.232
            },
            {
                "speaker_id": "1",
                "transcription": "더 뛰어난 자가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 23.242,
                "end": 25.429
            },
            {
                "speaker_id": "1",
                "transcription": "그자를 데려올 수 있나?",
                "sound_type": [
                    2
                ],
                "start": 25.439,
                "end": 27.495
            },
            {
                "speaker_id": "1",
                "transcription": "만만치 않지만 가능할 것입니다.",
                "sound_type": [
                    2
                ],
                "start": 27.505,
                "end": 30.483
            },
            {
                "speaker_id": "1",
                "transcription": "나는 바이런 만나러 갈 테니까 너는 걔를 데려와라.",
                "sound_type": [
                    2
                ],
                "start": 30.493,
                "end": 33.305
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 누굴까 오토 오토는 은신처를 돌봐야 되는데.",
