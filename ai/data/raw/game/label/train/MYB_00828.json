    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "바요 바요도 저거 다시 맞춰야겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.411
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 코랄 있어도 바요 저거 잘 못 맞추면 어차피 죽는 건 똑같네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.421,
                "end": 22.811
            },
            {
                "speaker_id": "1",
                "transcription": "얘 5초월이면 이거 5초월이면 이거 지긴 했는데 이거 코랄 5초월이면 이겼겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.821,
                "end": 35.660
            },
            {
                "speaker_id": "1",
                "transcription": "이제 바로 5초월로 가서 리뷰 할게요 이제.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.650,
                "end": 39.321
            },
            {
                "speaker_id": "1",
                "transcription": "최종 단계 5초월은 공격력이 9만까지 올라갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.331,
                "end": 43.779
            },
            {
                "speaker_id": "1",
                "transcription": "체력은 46만까지 방어력은 18만까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.789,
                "end": 47.838
            },
            {
                "speaker_id": "1",
                "transcription": "일단 홀리베리랑 극단적인 비교를 만약에 한다면 똑같이 아몬드로 비교를 해드리면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.848,
                "end": 55.459
            },
            {
                "speaker_id": "1",
                "transcription": "올 아몬드로 꼈다고 치면 얘는 46만이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.469,
                "end": 59.334
            },
            {
                "speaker_id": "1",
                "transcription": "체력 부옵션 만약에 없다는 기준에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.344,
                "end": 61.452
            },
            {
                "speaker_id": "1",
                "transcription": "방어력은 18만 방어력 부옵션 1퍼센트입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.462,
                "end": 64.225
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 홀리베리 같은 경우에는 체력 부옵션 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.235,
                "end": 67.503
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 자체는 체력이 압도적으로 높긴 하죠 52만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.513,
                "end": 70.511
            },
            {
                "speaker_id": "1",
                "transcription": "방어력 수치가 있어도 22만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.521,
                "end": 72.779
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리가 단단한 거 면에서는 그냥 압도적이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.789,
                "end": 76.056
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 다만 얘 같은 경우에는 좀 더 딜이 좋고 얘를 쓴다고 해서 아군 보호도 잘 되기 때문에 일단 바요는 제가 연구를 더 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.066,
                "end": 86.671
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 그거는 제가 따로 연구할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.681,
                "end": 89.024
            },
            {
                "speaker_id": "1",
                "transcription": "지금 너무 바요는 물몸이라 연구가 많이 필요해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.034,
                "end": 92.700
            },
            {
                "speaker_id": "1",
                "transcription": "첫 턴에 죽는 거 보면.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.710,
                "end": 96.766
            }
        ]
    },
    "summary": "한 남성이 코랄 5초월과 홀리베리의 스펙을 비교하고 또 바요는 따로 연구하겠다고 말하고 있다.",
