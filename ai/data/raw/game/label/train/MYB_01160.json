                "start": 0.000,
                "end": 3.574
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 제가 그 두 개 다 안 쓰고 기존 덱에서 바요만 키웠을 때 어 덱에서 쓸 수 있는지 그걸 좀 제대로 보여드리고 싶어서",
                "sound_type": [
                    2,
                    3,
