    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "투명한 젤리쿠키 님 계정 평가 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.770
            },
            {
                "speaker_id": "1",
                "transcription": "지금 왕국 규모를 보아하니 쿠키성 11렙 아니면 10렙 그쵸 11랩 아니면 10렙 어 일단 사연을 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.780,
                "end": 12.414
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 출시 때부터 즐겨 하다가 너무 과한 과금으로 자괴감을 느끼고 계정을 삭제 했었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.420,
                "end": 19.764
            },
            {
                "speaker_id": "1",
                "transcription": "그러다가 러너 영상을 보고 다시 시작하고 싶어져서 다시 시작했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.774,
                "end": 23.100
            },
            {
                "speaker_id": "1",
                "transcription": "다시 시작하고자 하고 싶어서 과금을 좀 많이 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.110,
                "end": 26.275
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로도 소에서 중과금으로 과금을 시작할 예정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.285,
                "end": 29.945
            },
            {
                "speaker_id": "1",
                "transcription": "시작한 지는 이제 한 달 좀 안됐다구요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.955,
                "end": 32.312
            },
            {
                "speaker_id": "1",
                "transcription": "패키지를 많이 사셨나 보네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.322,
                "end": 34.500
            },
            {
                "speaker_id": "1",
                "transcription": "런 영상을 보고 열심히 하고 있지만 그래도 부족한 부분이 많고 어려운 부분이 많아서 계정 평가 드립니다 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.503,
                "end": 42.320
            },
            {
                "speaker_id": "1",
                "transcription": "전체적으로 다 많이 봐줬으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.320,
                "end": 44.453
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 특별히 봐달라는 부분이 아 부분이 10가지가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.463,
                "end": 48.456
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째 쿠키성 레벨이 11인데 12레벨로 넘어갈 준비 중입니다 근데 코인이 부족해서 레벨 업을 하지 못하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.466,
                "end": 55.019
            },
            {
                "speaker_id": "1",
                "transcription": "이거에 대한 해답을 바로바로 해드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.029,
                "end": 57.777
            },
            {
                "speaker_id": "1",
                "transcription": "코인이 지금 부족한 이유는 코인 부족의 대표적인 3가지 이유가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.787,
                "end": 62.204
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째 이유가 랜드마크에 과도한 투자 두 번째 이유가 토핑 12관까지 과도한 투자 세 번째가 이 쿠키 하우스 레벨을 과도하게 많이 올리는 분들 이런 분들이 보통 코인이 많이 부족하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.214,
                "end": 74.080
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보니까 요 쿠키 하우스 레벨을 7레벨까지 다 싹다 올렸는데 스탑하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.090,
                "end": 79.470
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 레벨은 12렙 찍고나서 찍어도 상관이 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.480,
                "end": 82.831
            },
            {
                "speaker_id": "1",
                "transcription": "랜드마크에 같은 경우에는 아구 8레벨 이것도 많이 찍은 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.841,
                "end": 87.973
            },
            {
                "speaker_id": "1",
                "transcription": "이게 물론 중요해서 많이 찍어야 되는 건 맞는데 지금 얘를 먼저 찍어서 코인이 부족해서 쿠키성 레벨을 못 올리는 경우가 발생하니까 얘도 마찬가지로 5레벨이나 6레벨 정도 적당히 올리고 쿠키성 레벨이 12레벨 찍고 나서 10레벨까지 반드시를 찍어야 되는 거긴 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.983,
                "end": 105.704
            },
            {
                "speaker_id": "1",
                "transcription": "코인이 지금 300만 코인이 있는데 토핑작도 지금은 당장 하지 마세요 .",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.714,
                "end": 110.757
            },
            {
                "speaker_id": "1",
                "transcription": "일단 스탑 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.767,
                "end": 112.273
            },
            {
                "speaker_id": "1",
                "transcription": "6강까지만 하세요 6강까지 왜 자꾸 12성을 도대체 왜 강조하나요라고 물어볼 수도 있는데 생산 건물이나 쿠키 하우스나 어느 정도 되게 많아지는 그 타이밍이 12성 원래 13성 가면 이제 솜사탕 하나 더 지을 수 있고 그렇기 때문에 가급적이면 건물들이 가장 많이 늘어나 있고 쿠키 하우스도 가장 빠르게 올라갈 수 있는 그 단계를 밟아서 올라가라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 112.283,
                "end": 133.940
            },
            {
                "speaker_id": "1",
                "transcription": "고걸 말하고 싶어서 12성을 강조하는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 133.940,
                "end": 137.500
            }
        ]
    },
    "summary": "투명한 젤리쿠키 님 계정 코인이 부족한 이유는 랜드마크와 토핑 12관까지의 과도한 투자와 쿠키 하우스 레벨을 과도하게 많이 올려서라고 설명하고 있다.",
