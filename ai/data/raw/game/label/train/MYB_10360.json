        "term": [
            {
                "speaker_id": "1",
                "transcription": "베네딕타가 막 그랬잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.215
            },
            {
                "speaker_id": "1",
                "transcription": "연인 관계였잖아요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.225,
                "end": 4.515
            },
            {
                "speaker_id": "1",
                "transcription": "그런 느낌이었잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.525,
                "end": 5.711
            },
            {
                "speaker_id": "1",
                "transcription": "그런 다음에 후고하고도 좀 그런 관계였잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.721,
                "end": 9.152
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 무슨 온 나라 수장들이랑 바람피고 돌아다니나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.162,
                "end": 12.944
            },
            {
                "speaker_id": "1",
                "transcription": "아 성주가 왕은 아니니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.954,
                "end": 15.939
            },
            {
                "speaker_id": "1",
                "transcription": "아 아무튼 여기저기다가 돌아다니면서 이 남자 저 남자 다 만나고 다니는구만.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.949,
                "end": 22.166
            }
        ]
    },
    "summary": "여자 게임 유튜버는 베네딕타라는 캐릭터가 다른 사람과 연인 관계의 느낌이었는데 후고와도 그런 느낌의 관계여서 바람피고 다닌다고 생각한다.",
