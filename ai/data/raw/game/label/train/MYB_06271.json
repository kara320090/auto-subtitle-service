        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와 멘탈 나간다 진짜.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.682
            },
            {
                "speaker_id": "1",
                "transcription": "오 야 떴어 뭐야 이거.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.692,
                "end": 6.010
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 왜 떴어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.020,
                "end": 8.468
            },
            {
                "speaker_id": "1",
                "transcription": "야 떴어 오 뭐야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.478,
                "end": 13.648
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 빌드 맞네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.658,
                "end": 16.243
            },
            {
                "speaker_id": "1",
                "transcription": "아 드디어 떴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.253,
                "end": 17.513
            },
            {
                "speaker_id": "1",
                "transcription": "야 이 무슨 히든 빌드 스토리야 이거.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.523,
                "end": 19.894
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 겨우 됐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.904,
                "end": 22.427
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 100퍼센트 맞췄습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.437,
                "end": 26.067
            },
            {
                "speaker_id": "1",
                "transcription": "방금 한 거 여러분들 따라 하셔야 98퍼센트에서 100퍼센트 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.077,
                "end": 30.371
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 극혐인데 저 이거 지금 12번째 했나 저처럼 개고생 하지 말고 한 번에 이거 스토리 보는 순서가 진짜 중요하니까 순서대로 꼭 따라하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.381,
                "end": 40.485
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 데브시스터즈 관계자분들 아 이거 진짜 이건 좀 아닌 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.495,
                "end": 44.753
            },
            {
                "speaker_id": "1",
                "transcription": "3장은 이런 식으로 안 냈으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.763,
                "end": 47.468
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 진짜 좀 수정해서 나와야 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.478,
                "end": 51.230
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 극혐 스토리 100퍼센트 빌드입니다.",
                "sound_type": [
                    2,
