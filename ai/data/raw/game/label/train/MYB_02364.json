        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 스타더스트 5초월 리뷰 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.232
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 쿠키런 킹덤에서 저한테 누가 질문을 한다면은 만약에 여러분들이 모든 쿠키 100개 중에 딱 2개만 골라서 게임을 해라 막 그런 식으로 물어본다면은 필수로 골라야 되는 쿠키가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.242,
                "end": 18.901
            },
            {
                "speaker_id": "1",
                "transcription": "물론 전방에 있는 홀리베리도 중요하고 후방에 퓨어바닐라도 중요하고 다 중요한데 대체가 안 될 정도로 모든 덱에 공통으로 들어가는 몇 개의 쿠키가 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.911,
                "end": 30.768
            },
            {
                "speaker_id": "1",
                "transcription": "그중에 하나가 달빛술사랑 스타더스트예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.778,
                "end": 34.145
            },
            {
                "speaker_id": "1",
                "transcription": "보통 고 한방 덱이든 뭐든 다 달빛술사는 거의 다 들어가죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.155,
                "end": 38.862
            },
            {
                "speaker_id": "1",
                "transcription": "근데 스타더스트는 뭐 한방덱이 필수는 아니지만 모든 정석덱 뭐 빙결덱에 소르베랑 같이 쓰기도 하고 뭐 캡사이신덱이나",
                "sound_type": [
                    2,
