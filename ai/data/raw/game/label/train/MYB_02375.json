        "term": [
            {
                "speaker_id": "1",
                "transcription": "한번 싸움이 이렇게 스타더스트 같은 경우에는 저렇게 1번 차이로 이기고 지고가 결정됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 11.022
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 아까 평균 지금 스타더스트 스펙이 얼마예요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.032,
                "end": 15.491
            },
            {
                "speaker_id": "1",
                "transcription": "평균이 한 지금 한 3성 정도 되지 않나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.501,
                "end": 18.260
            },
            {
                "speaker_id": "1",
                "transcription": "제 계정 기준으로 아 아이 3성은 약간 과금한 기준이고 무과금 기준으로는 한 1성이 1성 2성 무과금 기준으로는 1성이죠 거의.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.270,
                "end": 30.982
            },
            {
                "speaker_id": "1",
                "transcription": "조금 소 과금 기준 3성",
                "sound_type": [
                    2
