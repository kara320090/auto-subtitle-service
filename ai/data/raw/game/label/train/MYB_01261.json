        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 자 소르베가 부화를 좀 일찍 했죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 10.846
            },
            {
                "speaker_id": "1",
                "transcription": "자 스타더스트가 죽어도 워낙 소르베가 1분 지나서도 딜이 좋기 때문에 엄청난 파괴력을 가지면서 녹일 수 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.856,
                "end": 24.582
            },
            {
                "speaker_id": "1",
                "transcription": "네 상대방분도 스펙이 낮은 게 아니죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.592,
                "end": 27.972
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 좀 다른 형태도 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.982,
                "end": 31.566
            },
            {
                "speaker_id": "1",
                "transcription": "자 이게 기본적으로 가장 많이 쓰이는 형태고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.576,
                "end": 34.265
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 저도 방어 덱을 요런 식으로 많이 하고 있는데 무공비급을 썼기 때문에 사람들이 이 형식을 보고 요렇게 많이 들어옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.275,
                "end": 42.299
            },
            {
                "speaker_id": "1",
                "transcription": "실론나이트 덱을 그대로 써서 제 방덱을 다 뚫어버리는 형태가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.309,
                "end": 46.598
            },
            {
                "speaker_id": "1",
                "transcription": "자 물론 제가 아까 말씀드린 대로 스냅 드래곤 대신에 파르페 쓰는 게 더 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.608,
                "end": 51.665
            },
            {
                "speaker_id": "1",
                "transcription": "파르페 마탕이 없는 분들은 스냅 드래곤을 써도 일단은 가능은 하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.675,
                "end": 56.319
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 달빛 술사와 스타더스트네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.329,
                "end": 59.418
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 마찬가지 부활 대상이 어떤 게 되냐가 좀 중요한데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.428,
                "end": 67.133
            }
        ]
    },
    "summary": "소르베 부화가 일찍 했는데 스타더스트가 죽어도 소르베가 1분 지나서 딜이 좋기 때문에 엄청난 파괴력으로 녹일 수 있고 다른 형태로 보여드리면 실론나이트 덱을 그대로 써서 방덱을 다 뚫어버리는 형태가 있는데 스냅 드래곤 대신 파르페를 쓰는 게 더 좋고 파르페 마탕 없는 분들은 스냅 드래곤을 써도 일단 가능하다.",
