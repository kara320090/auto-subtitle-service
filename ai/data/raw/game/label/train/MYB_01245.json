        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 클로티드 클로티드는 진짜 필요 없는데요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.018
            },
            {
                "speaker_id": "1",
                "transcription": "아 클로티드도 보스 약점에 빛의 과목이라는 약점이 있거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.028,
                "end": 9.657
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 보스는 뭐 클로티드 굳이 안 써도 깰 수 있어가지고 별로 샤글은 오 퓨바 홀베 1조각 남았어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.667,
                "end": 20.058
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 오늘 왜 캡사이신만 주구장창 뽑는 거야.",
