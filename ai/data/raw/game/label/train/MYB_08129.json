        "term": [
            {
                "speaker_id": "1",
                "transcription": "마을 안쪽이면 여기가 제일 안쪽 아닌가?",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.048
            },
            {
                "speaker_id": "1",
                "transcription": "어 앤 놓고 갔어 여기다가",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.058,
                "end": 7.330
            },
            {
                "speaker_id": "1",
                "transcription": "올빼미 놓고 갔네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.340,
                "end": 11.168
            },
            {
                "speaker_id": "1",
                "transcription": "마을 안쪽에 흑기사가 있대요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.178,
                "end": 13.399
            },
            {
                "speaker_id": "1",
                "transcription": "귀신 나올 것 같아 그치?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.409,
                "end": 17.862
            },
            {
                "speaker_id": "1",
                "transcription": "아 저도 그게 더 좋긴 한데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.872,
                "end": 23.850
            },
            {
                "speaker_id": "1",
                "transcription": "마을 안쪽 너무 음산한 거 아니야?",
                "sound_type": [
