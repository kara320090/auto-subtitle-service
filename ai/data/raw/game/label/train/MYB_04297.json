        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 빨간색 진짜 아 더 망했어 이거 패 섞기가 좋은 게 아니네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.075
            },
            {
                "speaker_id": "1",
                "transcription": "아 여러분들 나 이게 왜 자꾸 깨려고 하냐면 이거 깨면 스킨 주고 막 뭐가 새로운 단계가 있대요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.085,
                "end": 10.861
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 다음 단계 보고 싶어서 미치겠는데 어떡하지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.871,
                "end": 13.799
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막 막트 진짜 지금 라운드요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.809,
                "end": 16.022
            },
            {
                "speaker_id": "1",
                "transcription": "나도 몰라요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.032,
                "end": 16.696
            },
            {
                "speaker_id": "1",
                "transcription": "이거 깼다는 기준이 제작자분이 저도 알려달라고 했거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.706,
                "end": 20.564
            },
            {
                "speaker_id": "1",
                "transcription": "근데 안 알려주고 이러고 그냥 끝났어",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.574,
                "end": 22.733
