        "term": [
            {
                "speaker_id": "1",
                "transcription": "오늘도 로봇 실컷 보다 왔죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.416
            },
            {
                "speaker_id": "1",
                "transcription": "근데 웃긴 거 얘기해 줄까?",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 5.426,
                "end": 7.609
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그러다가 내가 애니메이션 어디에 빠져가지고 건담을 보고 온다든지 그 가면라이더를 보고 온다든지 이러잖아.",
