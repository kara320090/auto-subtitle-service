                    2,
                    3,
                    5
                ],
                "start": 7.619,
                "end": 15.058
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 그때부터 이제 또 그거 안 보내준다 딴 거 보냄",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.068,
                "end": 19.545
            },
            {
                "speaker_id": "1",
                "transcription": "내가 이제 이미 알게 된 거는 하사 마야도 좋다 그러고 그건 이제 관심 없어 내가 안 싫어하니까",
                "sound_type": [
                    2,
