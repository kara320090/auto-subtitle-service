        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭘 기대하고 여기까지 올라왔지 보상 보상 내놔",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.581
            },
            {
                "speaker_id": "1",
                "transcription": "아니 지금 네 모습을 보면 대답이 필요 없겠군",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.591,
                "end": 6.826
            },
            {
                "speaker_id": "1",
                "transcription": "그래 어떤가 혼돈의 정상에 선 기분 말이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.836,
                "end": 10.283
            },
            {
                "speaker_id": "1",
                "transcription": "보상 내놔 야 달달합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.293,
                "end": 14.708
            },
            {
                "speaker_id": "1",
                "transcription": "요 보상 얻으려고 여기까지 왔던 겁니다. 칭호까지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.718,
                "end": 18.164
            },
            {
                "speaker_id": "1",
                "transcription": "케이크타워 250층 최초 달성 보상 프로필",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.174,
                "end": 21.855
            },
            {
                "speaker_id": "1",
                "transcription": "야 요렇게 돼 있네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.865,
                "end": 23.486
            },
            {
                "speaker_id": "1",
                "transcription": "프로필 중에 이걸로 한 사람은 딱히 안 보이네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.496,
                "end": 26.742
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 남들보다 빨리 올라오긴 했네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.752,
                "end": 29.087
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 여러분들도 도전해 보면 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.097,
                "end": 33.972
            },
            {
                "speaker_id": "1",
                "transcription": "케이크 타워 250층까지 전부 다 올라왔는데 그다음 제가 할 거는 요런 파편 더 얻을 수 있도록 요런 데 더 도전할 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.982,
                "end": 42.561
            },
            {
                "speaker_id": "1",
                "transcription": "아니면은 저 상자 보상을 더 얻던가 네 고렇게 해서 여러분들이 해야 될거는 어 가급적이면 다른 분들은 아직 만렙 안 찍은 분들 있죠? 요거",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.571,
                "end": 51.414
            },
            {
                "speaker_id": "1",
                "transcription": "얘 만렙 다 찍어주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.424,
                "end": 53.958
            }
        ]
    },
    "summary": "한 남성이 게임을 하면서 게임상의 최고 레벨까지 갔고 보상을 내놓으라고 한다. 보상을 받은 남성은 달달하다며 최초 달성한 프로필을 받았고 본인이 받은 프로필을 한 사람은 딱히 보이지 않는다고 한다. 다른 사람들에게도 최고 레벨까지 올라오길 권하고 있으며 본인이 다음에 할 것은 파편을 더 얻는 것에 도전한다고 하며 가급적 최고 레벨을 다 찍길 권하고 있다.",
