        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "비둘기가 존버하는 거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.883
            },
            {
                "speaker_id": "1",
                "transcription": "그거 어떻게 생존하는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.893,
                "end": 4.147
            },
            {
                "speaker_id": "1",
                "transcription": "신기하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.157,
                "end": 4.896
            },
            {
                "speaker_id": "1",
                "transcription": "어디 막 굴 같은데 들어가 있나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.906,
                "end": 7.274
            },
            {
                "speaker_id": "1",
                "transcription": "아 죽고 다시 태어나는 아 그니까 대대손손 그냥 생명을 이어가는 거다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.284,
                "end": 12.240
            },
            {
                "speaker_id": "1",
                "transcription": "죽고 다시 태어난다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.250,
                "end": 13.938
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 그것도 생각난다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.948,
                "end": 15.160
            },
            {
                "speaker_id": "1",
                "transcription": "그 전철 안에 그 안에까지 들어와서 같이 타고 간 적도 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.170,
                "end": 20.051
            },
            {
                "speaker_id": "1",
                "transcription": "비둘기가 내 앞에서 그 전철 이렇게 문이 열리잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.061,
                "end": 23.668
            },
            {
                "speaker_id": "1",
                "transcription": "그때 갑자기 비둘기 날라 들어와 가지고 같이 타고 다음 역까지 저는 가서 내리긴 했는데 야 하도 많으니까 같이 타고도 가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.678,
                "end": 35.266
            }
        ]
    },
    "summary": "화자가 전철 안에 비둘기가 들어와 같이 타고 간 적도 있다고 한다.",
