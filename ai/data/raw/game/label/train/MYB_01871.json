        "term": [
            {
                "speaker_id": "1",
                "transcription": "공속덱으로 쓸려면은 좀 더 정교하고 다듬고, 좀 상대의 덱들이 이제 어느 정도 좀 고정화되는 그런 시기가 필요하고, 좀 어느 정도 기간이 필요한 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 15.732
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 이제 업데이트된 지 얼마 안 돼가지고 혼돈의 시기야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.742,
                "end": 21.298
            },
            {
                "speaker_id": "1",
                "transcription": "상대 지금 업데이트 안 돼서 덱들이 다 지금 막 바뀌는 시기라, 어떤 덱이 가장 좋고 나쁘고는 아직 정해지지 않은 시기거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.308,
                "end": 32.367
            },
            {
                "speaker_id": "1",
                "transcription": "네, 지금은 최고의 공덱을 추천해 주세요, 이런 거는 아무 의미가 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.377,
                "end": 37.776
            },
            {
                "speaker_id": "1",
                "transcription": "내일 정도 돼야, 어느 정도 덱이 파악되고 고정이 되기 때문에, 여러분들이 지금 파악이 돼야 되는 거는 아레나에서 쓸만한 쿠키인지가 중요한 거거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.786,
                "end": 48.692
            },
            {
                "speaker_id": "1",
                "transcription": "일단 활용 가치는 있을 것 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.702,
                "end": 50.522
            },
            {
                "speaker_id": "1",
                "transcription": "공격덱으로써 하나의 덱으로 쓸만한 가치는 있다, 그렇게 보여지네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.532,
                "end": 56.966
            }
        ]
    },
    "summary": "지금 업데이트가 된 지 얼마 안 됐기 때문에 아직은 어떤 덱이 좋고 나쁘고는 아직 알 수는 없지만 공격 덱으로써는 쓸만한 가치가 있다고 보인다고 한다.",
