        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 저거 때리는 효과음 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 28.266
            },
            {
                "speaker_id": "1",
                "transcription": "최후의 일격이 가운데 딜러들한테 들어가게 하면은 좋을 거 같은데 진짜로 앞에 탱커들은 최후의 일격 들어가도 워낙 단단하고 체력도 많기 때문에 별로 티도 안 나고 얘 관건이 중앙 애들한테 가게끔 만들어야 되네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.276,
                "end": 43.534
            },
            {
                "speaker_id": "1",
                "transcription": "일단 뭐 리뷰는 일단 여기까지 합시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.544,
                "end": 45.950
            },
            {
                "speaker_id": "1",
                "transcription": "일단 내가 볼 때 덱 하나 제대로 세팅 되면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.952,
                "end": 49.207
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 공격 덱으로 어 좋게 쓰이는 거는 확정으로 아마 나올 거 같은데 얘는 그냥 무난하게 아까 다크 카카오랑 뭐 에스프레소처럼 부상 덱으로 세팅하거나 아니면 공속 덱으로 세팅해서 좋은 건 아니고 확실히 컨셉이 앞에 탱커를 밀어주고 가운데 딜러들한테 최후의 일격 딜 크게 들어가는 게 들어가는 그런 구조를 만들어야지만 확실히 좋은 쿠키 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.217,
                "end": 78.186
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서는 그렇게 쓰일 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.196,
                "end": 80.340
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 상황 좀 지켜보다가 어 좋은 덱 나오면은 괜찮다 싶으면 할 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.350,
                "end": 85.579
            },
            {
                "speaker_id": "1",
                "transcription": "마탕은 지금 당장 급한 건 아닌 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.589,
                "end": 88.118
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 끝내면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.128,
                "end": 107.156
            }
        ]
    },
    "summary": "이 쿠키는 공속 덱이나 부상 덱으로 세팅해서 좋은 건 아니고 앞의 탱커를 밀어주고 가운데 딜러들한테 최후의 일격 들어가는 구조를 만들어야 좋은 쿠키인 것 같으며 마탕은 당장 급한 건 아닌 것 같다.",
