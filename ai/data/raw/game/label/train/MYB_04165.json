        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 다음 업데이트 지금 많은 다음 예측 관련된 자료들이 나오고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.067
            },
            {
                "speaker_id": "1",
                "transcription": "가장 핫한 자료 중에 하나가 이 목화맛 쿠키의 그림과 함께 공식 트위터에 나온 자료거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.077,
                "end": 13.361
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 상세히 보게 되면은 따뜻한 등불이 반짝이는 설원 마을에서 손뜨개를 모자를 눌러쓰고 따스한 목화 치마로 몸을 감싼 목화맛 쿠키 목화맛 쿠키랑 가장 관련된 쿠키 절친이 1명 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.371,
                "end": 26.981
            },
            {
                "speaker_id": "1",
                "transcription": "바로 소르베맛 쿠키인데 자 동백꽃이 활짝 피는 추운 겨울이 오면 목화맛 쿠키는 항상 오랫동안만나지 못한 친구가 떠올라요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.991,
                "end": 35.467
            },
            {
                "speaker_id": "1",
                "transcription": "이거 스토리를 보신 분은 아시겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.477,
                "end": 37.314
            },
            {
                "speaker_id": "1",
                "transcription": "목화맛 쿠키랑 가장 관련 깊은 소르베 자 관련 영상 제가 이미 찾아놨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.324,
                "end": 43.194
            },
            {
                "speaker_id": "1",
                "transcription": "요거 한번 보고 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.204,
                "end": 46.233
            }
        ]
    },
