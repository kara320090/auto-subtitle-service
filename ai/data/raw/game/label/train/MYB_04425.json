        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 야 뭐야 진짜 강력해 보이긴 하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.787
            },
            {
                "speaker_id": "1",
                "transcription": "이거 상향 전과 비교가 좀 되니까 뭔가 강력해 보이긴 해.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.797,
                "end": 23.517
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뭐 얘가 디버프나 이런 거는 보스한테 안 걸려 가지고 이거 딜만 보는 거예요 이건.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.527,
                "end": 30.594
            },
            {
                "speaker_id": "1",
                "transcription": "38만, 50만, 60만, 70만, 80만, 90만, 120만 아 딜이 점점 세지구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.604,
                "end": 38.527
            },
            {
                "speaker_id": "1",
                "transcription": "아 여러분들 얘는 디버프나 이런 걸 종합적으로 봐야 돼서 그냥 딜만 보세요 딜만.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.537,
                "end": 43.173
            },
            {
                "speaker_id": "1",
                "transcription": "저 딜 올라가는 거 보이세요 때릴수록",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.183,
