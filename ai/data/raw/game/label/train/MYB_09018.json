                ],
                "start": 0.000,
                "end": 8.384
            },
            {
                "speaker_id": "1",
                "transcription": "근데 용병이 범인 찾으러 나갔는데 돌아오질 않는대요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
