                    3,
                    5
                ],
                "start": 12.909,
                "end": 15.982
            },
            {
                "speaker_id": "1",
                "transcription": "짚이는 곳이 있냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.992,
                "end": 18.394
            },
            {
                "speaker_id": "1",
                "transcription": "아 바뀐 건 확실하대.",
