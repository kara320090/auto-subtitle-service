        "term": [
            {
                "speaker_id": "1",
                "transcription": "네. @계정1 님 뽑기 36만 개 자 일단 이 분은 다크카카오 나올 때 접었다가 3일 전에 복귀했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.907
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 나올 때 접었으면은 엄청나게 오래된 건데 일단 지금 뭘 뽑아야 될지 모르겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.917,
                "end": 15.357
            },
            {
                "speaker_id": "1",
                "transcription": "1년이 넘었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.367,
                "end": 16.578
            },
            {
                "speaker_id": "1",
                "transcription": "야 복귀해서 그래도 열심히 하고 계시구만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.588,
                "end": 18.772
            },
            {
                "speaker_id": "1",
                "transcription": "16,000개 일단 제가 방향을 잡아드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.782,
                "end": 23.587
            },
            {
                "speaker_id": "1",
                "transcription": "뽑기 전에 어떤 식으로 해야 되냐면은 옛날이랑 다르게 홀리베리가 되게 좋아졌거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.597,
                "end": 28.657
            },
            {
                "speaker_id": "1",
                "transcription": "알아서 잘 찍어 주셨네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.667,
                "end": 30.115
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 앞으로 뽑기 방향은 용과 필수, 달빛 필수, 샤글은 솔직히 필수는 아닙니다 현재 상황에서는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.125,
                "end": 38.068
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 얘는 있으면 좋구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.078,
                "end": 40.673
            },
            {
                "speaker_id": "1",
                "transcription": "필수, 소르베 필수구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.683,
                "end": 42.530
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 있으면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.540,
                "end": 44.009
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 로얄 필수, 그다음에 밀키 필수 얘도 뭐 있으면은 뭐 가끔 필요하기도 하고 마카롱도 있으면 뭐 가끔 쓰구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.019,
                "end": 52.843
            },
            {
                "speaker_id": "1",
                "transcription": "찰스도 있으면 가끔 쓰고 얘는 필수입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.853,
                "end": 55.144
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 뽑아 주시면 되고 보물은 얘가 그냥 무공 비급 이상이라 보시면 되구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.154,
                "end": 61.752
            },
            {
                "speaker_id": "1",
                "transcription": "얘랑 얘랑 얘랑 세 개 두고 달려야겠네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.762,
                "end": 64.860
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이렇게 해서 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.870,
                "end": 67.936
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.946,
                "end": 69.408
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 고급으로 출발.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.418,
                "end": 81.833
            }
        ]
    },
    "summary": "1년 동안 게임을 안 하다가 최근에 복귀한 구독자에게 필수로 뽑아야할 캐릭터를 알려준 후 게임을 시작한다.",
