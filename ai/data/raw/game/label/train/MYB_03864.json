        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 감초맛 쿠키가 드디어 상향이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.262
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 정말 0티어 쿠키였는데 지금은 아무도 안 쓰는 99티어가 됐거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.272,
                "end": 9.294
            },
            {
                "speaker_id": "1",
                "transcription": "한번 업데이트 전 마탕이 나오기 전에 한번 리뷰를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.304,
                "end": 14.820
            },
            {
                "speaker_id": "1",
                "transcription": "옛날부터 감초맛 쿠키는 다른 토핑을 쓰지 않고 올 쿨로만 썼어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.830,
                "end": 19.276
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 14초긴 한데 그냥 올 쿨로 해서 가보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.286,
                "end": 23.960
            },
            {
                "speaker_id": "1",
                "transcription": "전투력은 39만 천입니다 현재?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.970,
                "end": 27.231
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 스토리 가서 대충 딜적인 면만 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.241,
                "end": 30.940
            },
            {
                "speaker_id": "1",
                "transcription": "상향이 안 됐기 때문에 정말 나약한 쿠키 중에 끝판왕일 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.950,
                "end": 37.231
            },
            {
                "speaker_id": "1",
                "transcription": "네 정말 나약할 텐데 얘도 감초도 소환이긴 하잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.241,
                "end": 40.697
            },
            {
                "speaker_id": "1",
                "transcription": "소환 보물 껴서 가보도록 하겠습니다.",
                "sound_type": [
