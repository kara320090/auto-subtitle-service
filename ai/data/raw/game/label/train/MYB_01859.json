        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 이거 맞아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.837
            },
            {
                "speaker_id": "1",
                "transcription": "나 이 이렇게 많이 쓴 거 처음이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.847,
                "end": 3.925
            },
            {
                "speaker_id": "1",
                "transcription": "빨간 물약 안 나왔잖아요 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.935,
                "end": 5.453
            },
            {
                "speaker_id": "1",
                "transcription": "빨간 물약 나와야 된다니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.463,
                "end": 8.018
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 미쳤네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.028,
                "end": 9.569
            },
            {
                "speaker_id": "1",
                "transcription": "이거 왜 이래 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.579,
                "end": 20.950
            },
            {
                "speaker_id": "1",
                "transcription": "와아 근데 멋있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.960,
                "end": 22.754
            },
            {
                "speaker_id": "1",
                "transcription": "아 야 이거 버그야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.764,
                "end": 24.134
            },
            {
                "speaker_id": "1",
                "transcription": "물약 안 뜨는 버그인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.144,
                "end": 25.621
            },
            {
                "speaker_id": "1",
                "transcription": "아 잠깐만 나 이거 저 이거 5초월 해 보고 가자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.631,
                "end": 28.120
            },
            {
                "speaker_id": "1",
                "transcription": "빨간 물약이 나와야 되는 거긴 한데 버그인 거 같긴 해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.130,
                "end": 32.430
            },
            {
                "speaker_id": "1",
                "transcription": "내가 볼 땐 버그 같애.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.440,
                "end": 33.724
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도일 리가 없거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.734,
                "end": 35.294
            },
            {
                "speaker_id": "1",
                "transcription": "물약 안 뜨는 버그일 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.304,
                "end": 36.751
            },
            {
                "speaker_id": "1",
                "transcription": "이런 적이 단 1번도 없어.",
                "sound_type": [
                    2,
                    3
                ],
