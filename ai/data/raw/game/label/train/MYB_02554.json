        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 쭉 자동으로 여러분들이 기억할 거는 45초랑 22초 부근",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.275
            },
            {
                "speaker_id": "1",
                "transcription": "45초랑 22초 그쯤만 기억하면 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.285,
                "end": 10.209
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 도넛 쓰고 도넛 쓰고 자동 풀고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.219,
                "end": 14.164
            },
            {
                "speaker_id": "1",
                "transcription": "자 맞고 네 스킬 다 쓰고 자 여기서 다시 자동 걸어줘도 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.174,
                "end": 20.442
            },
            {
                "speaker_id": "1",
                "transcription": "네 그리고 이따가 22초 부근에서 다시 자동 풀어줘도 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.452,
                "end": 24.712
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 저처럼 자동 풀고 쭉 하고 상관은 없어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.722,
                "end": 29.253
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 써주시고 이제 22초 22초 근처가 왔죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.263,
                "end": 34.258
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 여기 왔으니까 여기서도 자동을 풀어줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.268,
                "end": 38.400
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제딜 맞고 여기서 다시 써주고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.410,
                "end": 42.727
            },
            {
                "speaker_id": "1",
                "transcription": "예 이렇게 다시 써주고 어 다시 자동으로 해줘도 되고 안 해줘도 여러분들 쿨 오는 대로 바로바로 써주면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 42.737,
                "end": 51.815
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 다 써주시면 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.825,
                "end": 54.827
            },
            {
                "speaker_id": "1",
                "transcription": "네 딜은 상당히 잘 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 54.837,
                "end": 59.300
            }
        ]
    },
