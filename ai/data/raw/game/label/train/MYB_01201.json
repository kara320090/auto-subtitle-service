        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 소르베 맛 쿠키 진짜 여러분들 대체 불가능급입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.101
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 소르베를 활용 안 하면은 게임이 지금 거의 불가능급이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.111,
                "end": 9.009
            },
            {
                "speaker_id": "1",
                "transcription": "모든 유저가 지금 소르베를 거의 메인 딜러로 반드시 쓸 수밖에 없는 상황이 됐고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.019,
                "end": 15.146
            },
            {
                "speaker_id": "1",
                "transcription": "오히려 샤이닝 글리터보다도 소르베를 더 많이 활용하고 있고 여러분들이 여유가 된다면 샤이닝 글리터도 뭐 다른 콘텐츠 때문에 키워야 되지만 소르 베도 여유가 있으면 키워야 되는 상황이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.156,
                "end": 26.902
            },
            {
                "speaker_id": "1",
                "transcription": "소르베 관련된 영상은 여기서 마칠게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.912,
                "end": 29.099
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
