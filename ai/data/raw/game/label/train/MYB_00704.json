    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이거 뭐 그니까 속박을 걸고 안 걸고의 차이가 이 정도로 차이가 많이 난다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.641
            },
            {
                "speaker_id": "1",
                "transcription": "네 아무것도 못 하고 사라져 버리는 효과가 나오게 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.651,
                "end": 11.220
            },
            {
                "speaker_id": "1",
                "transcription": "자 실제로 방어 기록을 보게 되면 보시는 거와 같이 프릴해파리는 크림슨코랄, 해파리, 스타더스트, 블랙펄, 스냅드래곤 이 조합으로 사람들이 다 사용하고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.230,
                "end": 23.107
            },
            {
                "speaker_id": "1",
                "transcription": "또는 스냅드래곤 대신에 이렇게 박하사탕맛 쿠키를 사용하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.117,
                "end": 29.059
            },
            {
                "speaker_id": "1",
                "transcription": "자 박하사탕맛 쿠키를 만약에 사용하실 거면은 아몬드를 써서 견뎌야 될 거 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.069,
                "end": 35.686
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 올 쿨로 하면 터질 수도 있을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.696,
                "end": 39.738
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 아 @이름1님 저 스타더스트 없는데 달빛술사 넣어도 되나요. 이 질문이 분명 있을 텐데 네 딜러가 만약에 없다면은 네 이렇게라도 쓰시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.748,
                "end": 51.057
            },
            {
                "speaker_id": "1",
                "transcription": "자 당연히 달빛술사는 쿨 타임 22퍼센트 이상 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.067,
                "end": 55.340
            },
            {
                "speaker_id": "1",
                "transcription": "피감은 높게 자 이 해파리 조합은 그러면 무적이냐 그거는 아니고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.350,
                "end": 59.647
            },
            {
                "speaker_id": "1",
                "transcription": "이 1번 3딜 덱한테 극강으로 되게 유리한 상성을 보여주고 해파리 덱은 상성상 이 박하사탕 덱한테 약합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.657,
                "end": 68.784
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 박하사탕 세팅 같은 경우에는 무공비, 호루라기, 시계고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.794,
                "end": 72.894
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 네 스타더스트는 3초 네 블랙펄은 올 아몬드 하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.904,
                "end": 78.280
            },
            {
                "speaker_id": "1",
                "transcription": "피감 높게 박하사탕도 피감 높게 쿨 높게 능력껏 높게 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.290,
                "end": 84.065
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅은 올 쿨 자 이 박하사탕 이 조합이 이 해파리 조합한테 상성상 완전히 카운터 덱이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.075,
                "end": 91.721
            },
            {
                "speaker_id": "1",
                "transcription": "보시면 아시겠지만 전투력이 낮습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.731,
                "end": 94.578
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요 덱과 요 덱 2개 세팅하면은 상대방이 지금 해파리 방 덱이 되게 많을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.588,
                "end": 99.822
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕 요 세팅 알려 드리는 대로 세팅해서 카운터 칠 수도 있고 아니면 상대의 3딜 덱이 보인다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.832,
                "end": 107.057
            },
            {
                "speaker_id": "1",
                "transcription": "해파리 덱을 세팅해서 가시면 현재 아레나에서 되게 높은 승률로 가져갈 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 107.067,
                "end": 112.226
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 보시면 자 상대가 버팁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 112.236,
                "end": 122.266
            }
        ]
    },
    "summary": "남성이 실제로 방어 기록을 보면 프릴해파리는 크림슨코랄, 해파리, 스타더스트, 블랙펄, 스냅드래곤 이 조합으로 사람들이 사용하고 있고 해파리 덱은 상성상 박하사탕 덱한테 약하다고 하며 박하사탕 세팅을 알려준다.",
