                ],
                "start": 2.009,
                "end": 3.510
            },
            {
                "speaker_id": "1",
                "transcription": "내 인내심은 지금 한계를 넘어서 분수 오이 국립 맞지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.520,
                "end": 10.116
            },
            {
