        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 출시된 와일드 베리 마법 사탕 리뷰 바로 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.700
            },
            {
                "speaker_id": "1",
                "transcription": "네 30강까지 자 일단 30강 이렇게 찍으면은 이렇게 강화에 따라 10강에는 10퍼센트, 30강에는 20퍼센트 그리고 이번에 마법 사탕을 통해서 얻을 수 있는 거는 스킬 사용 시 보좌관의 보호 기질을 발동해서 모든 아군에게 체력 보강을 건다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.710,
                "end": 25.351
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 마지막 공격에 더 큰 힘을 모아서 강한 추가 피해를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.361,
                "end": 29.681
            },
            {
                "speaker_id": "1",
                "transcription": "체력 보호막은 5초 동안 최대 체력의 10퍼센트를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.691,
                "end": 33.298
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 마지막 공격 추가는 피해량이 175퍼센트다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.308,
                "end": 37.394
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 준다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.404,
                "end": 39.357
            },
            {
                "speaker_id": "1",
                "transcription": "와일드베리는 보통 당연히 답정너로 아몬드를 쓰고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.367,
                "end": 43.858
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 대부분 쿨을 안줍니다.",
