        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 솔방울 맛 쿠키 아 일단 요기에 최적화된 덱이 나왔거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.839
            },
            {
                "speaker_id": "1",
                "transcription": "승률이 되게 높고 이거 @이름1 님 그리고 @이름2 님이 이제 완벽하게 만드신 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.849,
                "end": 10.805
            },
            {
                "speaker_id": "1",
                "transcription": "저희 길드원분이 알려주신 요 덱은 솔방울 맛 쿠키 같은 경우에는 그냥 피감 높게 여러분들 능력껏 피감 세팅에다가 추가적으로 이 망토 보물이 이 솔방울 받을 수 있게 공속 나머지는 저는 치명타에 더 줬습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.815,
                "end": 24.989
            },
            {
                "speaker_id": "1",
                "transcription": "리뷰할 때마다 말씀드리지만 48점 7퍼센트 이하면은 이 덱 못 쓰는 건 절대 아니고 여러분들 능력껏 피감 높게 세팅할 수 있으면은 최대한 해주시고 자 그리고 휘낭시에 같은 경우에도 쿨은 원 제작자분도 7퍼센트대에 했거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.999,
                "end": 40.599
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 85퍼센트 가까이 뭐 주면 좋은데 근데 요것도 피감 부옵션 체력 여유 되는 대로 여러분들 해주시고 자 일단 소르베 같은 경우에는 그냥 쿨타임 9퍼센트 맞추라는 건 아니고 그냥 여러분들이 능력과 쿨 높일 수 있을 때만큼 높여주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.609,
                "end": 54.900
            },
            {
                "speaker_id": "1",
                "transcription": "피감도 어느 정도 여러분들 능력껏 챙겨주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.910,
                "end": 57.824
            },
            {
                "speaker_id": "1",
                "transcription": "자 허브 맛 쿠키 같은 경우에는 얘는 그냥 피감 몰빵입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.834,
                "end": 62.366
            },
            {
                "speaker_id": "1",
                "transcription": "안 죽을 수 있게끔 최대한 피감 뭐 쿨 공속은 안 줘도 되고 체력 줘 가지고 더 버틸 수 있게끔 최대한 버티는 용도다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.376,
                "end": 70.573
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 BTS 쿠키가 망토 보물 받을 수 있게 세팅해 주고 쿨타임은 여러분들 높게 그다음에 부옵션으로 공치 더 주시면 되고 망토 보물은 결론적으로 솔방울하고 BTS가 받는다.",
