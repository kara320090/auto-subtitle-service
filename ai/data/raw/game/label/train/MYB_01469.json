    },
    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 용토벌 신조합이 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.101
            },
            {
                "speaker_id": "1",
                "transcription": "기준에 쓰이던 스냅드래곤을 대체해서 락스타맛 쿠키가 들어갔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.111,
                "end": 6.674
            },
            {
                "speaker_id": "1",
                "transcription": "기존보다 토핑 난이도가 엄청나게 내려갔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.684,
                "end": 10.388
            },
            {
                "speaker_id": "1",
                "transcription": "자 화면을 보게 되면 5.68억까지 5.7억 이상 71단계가 원콤이 난다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.398,
                "end": 17.883
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나게 딜량이 상승하게 되었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.893,
                "end": 20.642
            },
            {
                "speaker_id": "1",
                "transcription": "자 보물은 무공비 호루라기 시계가 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.652,
                "end": 23.509
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기 같은 경우에는 푸룬주스랑 로얄마가린이 받게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.519,
                "end": 27.752
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑 같은 경우에는 밀키웨이 같은 경우에 피해 감소 네 한 줄 주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.762,
                "end": 33.111
            },
            {
                "speaker_id": "1",
                "transcription": "밀키웨이가 죽는다하신 분들은 피감 더 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.121,
                "end": 36.167
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿨 공속 같은 경우에는 여러분들 능력껏 최대한 많이 주시면 되고 제가 권장하는 건 24.3 이상 공속은 4퍼센트 이상 그거 이상 더 주면 더 줄수록 딜은 더 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.177,
                "end": 48.829
            },
            {
                "speaker_id": "1",
                "transcription": "방깍 유지가 되면 될수록 좋기 때문에 여러분들 능력껏 최대한 많이 주는 게 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.839,
                "end": 54.491
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 로얄마가린 같은 경우에는 올 라즈베리 쓰시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.501,
                "end": 58.429
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임은 5퍼센트 맞춰 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.439,
                "end": 61.907
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 공격력과 치명타 확률은 높을수록 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.917,
                "end": 65.305
            },
            {
                "speaker_id": "1",
                "transcription": "공격력에 더 신경을 써서 높게 맞춰 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.315,
                "end": 68.827
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소는 17퍼센트로 맞춰줬지만 여러분들이 죽지 않는 피해 감소로 맞춰주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.837,
                "end": 74.625
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 이거보다 더 낮아도 안 죽을 거 같지만 여러분들이 세팅해 보시고 죽지 않는다 그러면 더 낮춰 주시고 죽는다 싶으면 더 올려 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 74.635,
                "end": 83.947
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타 같은 경우에는 승급이 낮아도 쓸 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.957,
                "end": 87.151
            },
            {
                "speaker_id": "1",
                "transcription": "3 애플젤리 2 아몬드로 섞고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.161,
                "end": 89.665
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소가 나는 더 낮아요 하시는 분들 락스타 죽는다 하신 분들은 아몬드를 더 섞어 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.675,
                "end": 96.737
            },
            {
                "speaker_id": "1",
                "transcription": "제가 5 아몬드로도 빌드 대로 돌아가는 거 확인을 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 96.747,
                "end": 100.907
            },
            {
                "speaker_id": "1",
                "transcription": "다만 여기서 여러분들이 세팅을 신경 써야 되는 거는 쿨타임은 6퍼센트 가까이 맞춰 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.917,
                "end": 106.943
            },
            {
                "speaker_id": "1",
                "transcription": "5.7 5.6까지도 다 괜찮으니까 6퍼센트 가까이만 맞춰 주시면 되고 공격력이 높으면 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 106.953,
                "end": 114.071
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 치명타 확률은 무조건 올 아몬드로 했을 때 치명타 확률 5퍼센트는 무조건 넘겨 주셔야 맥스 치명타 확률이 올라간다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 114.081,
                "end": 123.207
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 올 아몬드할 때는 5퍼센트까지 최대한 맞춰 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 123.217,
                "end": 128.582
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 푸룬주스 같은 경우에는 피해 감소 16.7퍼센트 그리고 쿨타임은 23.5 근처 맞춰 주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 128.592,
                "end": 135.652
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 마찬가지 공치 위주로 더 신경 써줄수록 딜이 더 많이 올라가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 135.662,
                "end": 140.585
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소는 이렇게 세팅했는데 죽는다 피해 감소를 더 높여주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 140.595,
                "end": 145.271
            },
            {
                "speaker_id": "1",
                "transcription": "스펙에 따라 피해 감소는 높여주거나 낮춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 145.281,
                "end": 149.106
            },
            {
                "speaker_id": "1",
                "transcription": "자 에클레어 같은 경우에는 쿨타임 권장은 9퍼센트 이상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 149.116,
                "end": 152.733
            },
            {
                "speaker_id": "1",
                "transcription": "높으면 높을 수록 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 152.743,
                "end": 154.320
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소랑 체력 높으면 높을수록 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 154.330,
                "end": 157.496
            },
            {
                "speaker_id": "1",
                "transcription": "자 에클레어는 쿨타임 9퍼센트가 목적이 아니라 안 죽는 게 더 중요하기 때문에 어는 1차적으로는 피해 감소를 먼저 신경 더 써 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 157.506,
                "end": 165.353
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 쿨타임을 더 신경 써주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 165.363,
                "end": 167.981
            },
            {
                "speaker_id": "1",
                "transcription": "자 71단계 연습 모드로 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 167.991,
                "end": 172.400
            }
        ]
    },
