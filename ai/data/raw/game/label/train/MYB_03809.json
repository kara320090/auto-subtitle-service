                    3,
                    5
                ],
                "start": 9.106,
                "end": 14.220
            },
            {
                "speaker_id": "1",
                "transcription": "급격하게 체력이 감소되지 않기 때문에 네 요런 식으로 이기게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.220,
                "end": 18.686
            },
            {
                "speaker_id": "1",
                "transcription": "크런치 초코칩은 절대 딜러 역할로 하는 게 아닙니다.",
