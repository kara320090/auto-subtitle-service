            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 승리를 가져갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.346,
                "end": 9.106
            },
            {
                "speaker_id": "1",
                "transcription": "상대방이 공속이 느리면은 장점이 뭐냐면 아군의 힐 타임을 더 벌 수 있어요.",
