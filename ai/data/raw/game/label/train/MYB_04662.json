        "term": [
            {
                "speaker_id": "1",
                "transcription": "밝힐게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.687
            },
            {
                "speaker_id": "1",
                "transcription": "불을 밝힐게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.697,
                "end": 5.029
            },
            {
                "speaker_id": "1",
                "transcription": "꺼져 버렸어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.039,
                "end": 6.352
            },
            {
                "speaker_id": "2",
                "transcription": "음 계정 주인 분.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.362,
                "end": 10.404
            },
            {
                "speaker_id": "2",
                "transcription": "쿠키 키우는 거 지금 아레나 위주로 키우지 마시고 일단 토벌부터 맞추고 갑시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.414,
                "end": 14.901
            },
            {
                "speaker_id": "2",
                "transcription": "자 지금부터 키워야 될 거는 아포가토 키우세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.911,
                "end": 18.148
            },
            {
                "speaker_id": "2",
                "transcription": "다크도 어느 정도 레벨 업 더 해주고 아레나가 먼저 중요한 게 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.158,
                "end": 22.229
            },
            {
                "speaker_id": "2",
                "transcription": "왜 이렇게 말하냐면은 잘 모르시는 분들은 길드 관련해서 보상 받는 거 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.239,
                "end": 27.358
            },
            {
                "speaker_id": "2",
                "transcription": "얘도 스펙 업 성장에 진짜 엄청나게 영향을 주거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.368,
                "end": 31.209
            },
            {
                "speaker_id": "2",
                "transcription": "여기 길드 뽑기가 스펙 업 하는데 재화를 정말 많이 줘요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.219,
                "end": 36.007
            },
            {
                "speaker_id": "2",
                "transcription": "특히나 무과금러 분들이나 소과금러 분들은 이런 거 재화 얻는 거 무과금이라고 해도 열심히 하면은 상위권 쪽으로 가입 가능할 정도로 올라갈 수도 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.017,
                "end": 46.733
            },
            {
                "speaker_id": "2",
                "transcription": "그러기 때문에 지금 세팅을 우선시해야 되는 거는 토벌 쿠키 위주로 키웁시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.743,
                "end": 51.130
            },
            {
                "speaker_id": "2",
                "transcription": "쓰이는 애들 먼저 쭉 레벨 업해서 스킬 파우더 쓰고 키우세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.140,
                "end": 55.607
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 마지막 제가 볼 땐 중요한 게 토핑작이 지금 중요한데 아몬드 같은 경우에는 저는 여기서 많이 했었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.617,
                "end": 62.788
            },
            {
                "speaker_id": "2",
                "transcription": "시간 별로 없으시고 고기 젤리 소모 빨리빨리 하고 싶으시면은 여기 보상도 괜찮으니까 여기서나 아니면 쿨은 여기 여기서 파밍하시면 되고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.798,
                "end": 71.452
            },
            {
                "speaker_id": "2",
                "transcription": "나는 라즈랑 아몬드 둘 다 파밍하고 싶다 하시면은 8다시29에서 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.462,
                "end": 78.733
            }
        ]
    },
    "summary": "남성이 게임의 다른 계정의 주인에게 가이드라인을 제시하고 있다.",
