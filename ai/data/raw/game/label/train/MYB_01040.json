        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "요런 식으로 가서 하면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.371
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기 보스 깰 때 중요한 점이 블랙펄이 중간에 죽을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.381,
                "end": 8.149
            },
            {
                "speaker_id": "1",
                "transcription": "저도 못 버티고 죽을 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.159,
                "end": 10.639
            },
            {
                "speaker_id": "1",
                "transcription": "죽어도 상관이 없다 왜냐 어차피 이거는 3별 클리어가 목적이 아니라 깨는 게 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.649,
                "end": 18.387
            },
            {
                "speaker_id": "1",
                "transcription": "네 어차피 죽이기만 하면 되기 때문에 네 최대한 버텨서 피가 다 닳게 하면은 되는 거라 스타더스트를 저는 추천드리고 스타더스트가 없으면 용과 써 주셔서 해도 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.397,
                "end": 31.422
            },
            {
                "speaker_id": "1",
                "transcription": "피를 쫙쫙 닳게 해 주고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.432,
                "end": 33.697
            },
            {
                "speaker_id": "1",
                "transcription": "이제 블랙펄 죽었죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.707,
                "end": 35.653
            },
            {
                "speaker_id": "1",
                "transcription": "죽어도 상관없다 힐러들이 2개나 즉시 힐로 잘 버텨주기 때문에 시간은 아직 넉넉하죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.663,
                "end": 43.790
            },
            {
                "speaker_id": "1",
                "transcription": "요런 식으로 끝까지 마무리가 마지막 40초나 남겨면서 클리어가 된다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.800,
                "end": 51.343
            },
            {
                "speaker_id": "1",
                "transcription": "10단계 이상은 추후에 업데이트 예정이라고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.353,
                "end": 55.002
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 블랙펄 쿠키의 증명의 전장 1단계부터 10단계 조합 대체 쿠키부터 토핑 세팅까지 참고해서 도움이 되셨으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.012,
                "end": 64.701
            },
            {
                "speaker_id": "1",
                "transcription": "좋아요와 구독 한번씩만 부탁드립니다.",
                "sound_type": [
                    2
                ],
                "start": 64.711,
                "end": 67.449
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.459,
                "end": 80.333
            }
        ]
    },
    "summary": "한 남성이 게임 10단계에서 3별 클리어가 목적이 아니라 깨는 게 중요해서 스타더스트나 용과를 써서 피를 닳게 해 주면 되고 블랙펄이 죽어도 힐러들이 즉시 힐을 써서 버텨주기 때문에 괜찮고 10단계 이상은 추후에 업데이트가 될 예정이라고 이야기한다.",
