        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현재 가장 많이 나오는 질문 바다요정 쿠키 잼손을 키울까요 아니면 블랙펄 쿠키 잼손을 키울까요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 7.734
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 질문을 생방송할 때마다 아니면 댓글을 통해서 엄청나게 많이 받고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.744,
                "end": 12.407
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상을 통해서 제가 딱 정리를 해드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.417,
                "end": 15.117
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 저거 선택하는 거 정말 중요하거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.127,
                "end": 18.259
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 중명의 전장에서 여러분들 이 잼스톤 재료를 얻을 수 있는 거는 일주일에 열 번으로 딱 정해져 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.269,
                "end": 25.877
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 각각의 상황에서 장단점을 일단 말씀을 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.887,
                "end": 30.468
            },
            {
                "speaker_id": "1",
                "transcription": "현재 바다 요정 같은 경우에는 여러분들이 사용할 수 있는 곳이 스토리 모드 아레나에서 유용하게 쓸 수가 있는데 특히나 바다요정 같은 경우에 얘기를 들어 보면 어둠모드에서 바다요정을 활용해서 어둠 모드 클리어 하기 너무 편하다 좋다라는 의견이 상당히 많이 있었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.478,
                "end": 47.517
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 아레나에서는 바다요정쿠키는 자 이렇게 3딜덱으로 사용할 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.527,
                "end": 52.403
            },
            {
                "speaker_id": "1",
                "transcription": "이게 바다요정을 활용한 가장 좋은 덱입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.413,
                "end": 55.363
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 조합은 상대의 딜러를 빨리 녹여서 1분 전에 최대한 딜러를 많이 죽여서 승부를 보는 조합으로 사용되고 있고요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.373,
                "end": 63.321
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 같은 경우 에는 극딜조합 외에 쓰면은 1분이 지나면 상대의 용과 드래곤이나 딜러에 의해서 쉽게 죽기 때문에 너무 활용 가치가 떨어지게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.331,
                "end": 73.138
            },
            {
                "speaker_id": "1",
                "transcription": "이에 반해 블랙펄 쿠키는 원탱 투탱 정석덱 그리고 극딜 조합에서도 이렇게 활용 가능하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.148,
                "end": 79.571
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 보다는 정말 다양한 조합에서 훨씬 더 가치 있게 쓸 수가 있고 좀 더 파괴적으로 사용할 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.581,
                "end": 86.734
            },
            {
                "speaker_id": "1",
                "transcription": "그런 리더 효과 같은 경우에도 아군 쿠키 스킬 피해가 적용 피해 감소를 해주기 때문에 요 리더 효과 자체만으로도 좀 더 강력한 피해를 입힐 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.744,
                "end": 97.933
            }
        ]
    },
    "summary": "현재 가장 많이 나오는 질문인 바다요정 쿠키 잼손을 키울 때 블랙펄 쿠키 잼손을 키울지 생방송이나 댓글을 통해 질문을 많이데 이번 영상을 통해서 정리를 하고 장단점을 말하면 아레나에서는 바다요정 쿠키를 3딜덱으로 사용할 수 있고, 블랙펄 쿠키는 원탱 투탱 정석덱 극딜 조합에서 활용가능해 바다요정보다 다양한 조합에서 더 가치가 있고 파괴적으로 쓸 수 있습니다.",
