                    5
                ],
                "start": 15.790,
                "end": 26.509
            },
            {
                "speaker_id": "2",
                "transcription": "뿌뿌 다음 역은 꿈 세계 정거장입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.519,
                "end": 31.880
            },
            {
                "speaker_id": "1",
                "transcription": "자 원하는 쿠키는 아레나에서 잘 쓰이는 쿠키들로 뽑아주세요. 라고 했습니다. 자 아레나에서 잘 쓰이는 쿠키 뭐가 있냐면 달빛, 블펄, 와일드베리도 쓰일 수 있고 찰스도 솔직히 쓰일 수 있고 그 정도만 뽑아보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.890,
                "end": 49.927
            },
            {
