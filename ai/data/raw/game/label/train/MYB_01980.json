        "term": [
            {
                "speaker_id": "1",
                "transcription": "어어 다 당연하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.640
            },
            {
                "speaker_id": "1",
                "transcription": "드래곤 라이더 없이 드래곤을 어떻게 잡으러 가나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.650,
                "end": 6.432
            },
            {
                "speaker_id": "1",
                "transcription": "이 이 로얄마가린맛 쿠키만 믿으라고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.442,
                "end": 11.053
            },
            {
                "speaker_id": "2",
                "transcription": "우와 로얄마가린맛 쿠키가 함께라면 드래곤 시티는 살았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.063,
                "end": 16.858
            },
            {
                "speaker_id": "3",
                "transcription": "오?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.868,
                "end": 18.200
            },
            {
                "speaker_id": "3",
                "transcription": "드래곤 라이더 부족이 아직도 남아 있었나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.210,
                "end": 22.142
            },
            {
                "speaker_id": "3",
                "transcription": "더 이상 드래곤 라이더 전사는 키워 내지 못한다고 들었는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.152,
                "end": 27.699
            },
            {
                "speaker_id": "4",
                "transcription": "푸핫 용은 무슨",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.709,
                "end": 30.118
            },
            {
                "speaker_id": "4",
                "transcription": "그냥 잔챙이 와이번이잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.128,
                "end": 32.824
            },
            {
                "speaker_id": "4",
                "transcription": "용도 아니면서 감히 용 행세를 하고 다녀?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.834,
                "end": 36.573
