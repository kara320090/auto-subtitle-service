        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "보스 몬스터에게 추가 피해를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.624
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 사용 일정 수 마다 강화 포털을 발사한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.634,
                "end": 5.921
            },
            {
                "speaker_id": "1",
                "transcription": "전투 중 타르타탕맛 쿠키가 공격한 몬스터와 보스 몬스터를 처치하면 타르타탕맛 쿠키의 공격력이 증가한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.931,
                "end": 13.973
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 감초맛 쿠키에서 쓰일까요",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.983,
                "end": 16.650
            },
            {
                "speaker_id": "1",
                "transcription": "아까 영상에서 감초에서 쓰는 모습이 나와서 혹시나 토벌에서 쓰일까 했는데 글쎄요 토벌에서 쓰일지 한 번 봐야 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.660,
                "end": 26.703
            },
            {
                "speaker_id": "1",
                "transcription": "자 스페셜 등급에 스냅 드래곤맛 쿠키 얘네 BTS 쿠키 대신에 과연 0티어로 나올지 한번 봐야 될 거 같은데 스냅 드래곤 쿠키는 피어나는 고대 마법을 사용하는 지원형 쿠키다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.713,
                "end": 37.456
            },
            {
                "speaker_id": "1",
                "transcription": "자 스킬을 보게 되면 고대 생물인 스냅 드래곤 쿠키는 적의 공격을 무시하는 특수 무적 효과를 지니고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.466,
                "end": 44.038
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 사용 시 고대 마법으로 금어초를 활짝 피워 아군 전체 체력을 주기적으로 회복 시켜 주고 기절 저항 해로운 효과 감소 공격력 증가 피해 감소 버프 체력 보호막을 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.048,
                "end": 56.682
            },
            {
                "speaker_id": "1",
                "transcription": "능력만 보면 완전 BTS 대체로 0티어네 그러고 고대 마법은 드래곤의 체력을 강화하여 드래곤 타입의 최대체력으로 증가한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.692,
                "end": 66.735
            },
            {
                "speaker_id": "1",
                "transcription": "난 능력만 보면 사기적으로 냈네요 그러고 스냅 드래곤 쿠키는 스킬 레벨은 BTS 쿠키와 다르게 스킬 파우더를 소모하여 스킬 레벨 업을 필요로 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.745,
                "end": 76.089
            },
            {
                "speaker_id": "1",
                "transcription": "초월에 필요한 영혼석은 BTS 쿠키와 동일하게 맥스 270개의 영혼석을 필요로 한다.",
                "sound_type": [
