        "term": [
            {
                "speaker_id": "1",
                "transcription": "그 그치만 로얄마가린맛 쿠키님은 드래곤을 타는 드래곤 라이더잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.600
            },
            {
                "speaker_id": "2",
                "transcription": "하 그러니까 난 누구보다 재빨리 도망칠 수 있지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.610,
                "end": 11.014
            },
            {
                "speaker_id": "2",
                "transcription": "너희들은 용의 불길 앞에서 어떻게 도망칠 건데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.024,
                "end": 15.450
            },
            {
                "speaker_id": "3",
                "transcription": "드래곤 라이더조차도 저렇게 말하는 거라면 토벌은 집어치우고 내일이라도 당장 대피를 하자구요.",
                "sound_type": [
                    2,
