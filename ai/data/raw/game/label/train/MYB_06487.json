            },
            {
                "speaker_id": "1",
                "transcription": "아 까비. 위에부터구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.506,
                "end": 5.574
            },
            {
                "speaker_id": "1",
                "transcription": "밑에인 줄 알았어. 바로 거기인 줄 알았더니 아니네.",
