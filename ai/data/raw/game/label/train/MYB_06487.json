                    5
                ],
                "start": 11.175,
                "end": 16.730
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 수영하며 오는 저 모션 좀 보세요. 수영 모션이 미쳤어.",
                "sound_type": [
