        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 와일드베리맛 쿠키 마법사탕 업데이트가 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.347
            },
            {
                "speaker_id": "1",
                "transcription": "마법사탕 하게 되면 체력 보호막과 그리고 마지막 공격 추가 피해량 그리고 30강까지 하면 아군 치명타 피해 감소가 10초 동안 20퍼센트까지 증가가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.357,
                "end": 13.912
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 아레나에서는 여러분들 덱이 몇 가지 쓰이게 됐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.922,
                "end": 18.396
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 2 1 2덱이나 이렇게 2 2 1덱 뭐 여러 가지로 쓰이게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.406,
                "end": 22.945
            },
            {
                "speaker_id": "1",
                "transcription": "오늘 추천해 드릴 덱은 이 2가지입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.955,
                "end": 25.439
            },
            {
                "speaker_id": "1",
                "transcription": "요 2 1 2덱이나 2 1 2덱 일단 먼저 요 덱 먼저 소개해드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.449,
                "end": 30.810
            },
            {
                "speaker_id": "1",
                "transcription": "일단 요 덱 같은 경우에는 홀리베리 올 쿨 와일드베리 같은 경우에는 쿨 없이 공속이랑 치명타 확률 여유 있으면 그리고 피해 감소 높게 여러분들 중에 이런 생각하시는 분들 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.820,
                "end": 42.059
            },
            {
                "speaker_id": "1",
                "transcription": "아 와일드베리 올 라즈베리 어떨까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.069,
                "end": 44.279
            },
            {
                "speaker_id": "1",
                "transcription": "생각보다 딜이 그렇게 많이 안 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.289,
                "end": 46.647
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래서 그냥 안정적으로 아몬드 하시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.657,
                "end": 49.767
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤은 쿨 높게 최대한 높게 해주시는 게 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.777,
                "end": 52.926
            },
            {
                "speaker_id": "1",
                "transcription": "여유 쓰면 공, 치, 피감 여유 되는 대로 높게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.936,
                "end": 56.055
            },
            {
                "speaker_id": "1",
                "transcription": "아 스타더스트는 쿨 높게 그 다음에 스냅드래곤도 쿨 최대한 높게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.065,
                "end": 62.266
            }
        ]
    },
