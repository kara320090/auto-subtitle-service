        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "먼저 0 티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.512
            },
            {
                "speaker_id": "1",
                "transcription": "락스타맛 쿠키는 에픽 등급으로 출시됐음에도 불구하고 그 능력은 슈퍼에픽 이상의 성능을 가지고 출시된 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.522,
                "end": 7.710
            },
            {
                "speaker_id": "1",
                "transcription": "아군 전체의 체력을 회복시켜 주고 버프 금지 방어 버프와 치명타 확률 증가 버프를 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.720,
                "end": 13.683
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 전투 불능 상태가 됐을 경우 모든 디버프를 제거하고 순간적으로 모든 아군에게 엄청난 체력 회복을 통해서 체력이 거의 없는 아군 쿠키에게 부활 능력의 기타 효과를 받는 느낌으로 체력을 한 번에 채워 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.693,
                "end": 27.005
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 사기적으로 출시되었기 때문에 퓨어바닐라 쿠키보다도 아레나에서 활용 가치가 더 좋으며 스냅드래곤 쿠키와 함께 투 힐러 조합으로 많이 사용됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.015,
                "end": 36.221
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 울 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.231,
                "end": 38.367
            },
            {
                "speaker_id": "1",
                "transcription": "스냅드래곤 쿠키는 죽지 않는 특수 무적 능력을 가진 쿠키로 기절 저항, 해로운 효과 감소, 공격력 증가, 피해 감소 버프, 체력 보호막 등 사기적인 버프 능력을 가지고 출시된 힐러 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.377,
                "end": 49.538
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라 쿠키를 대체하여 락스타맛 쿠키가 출시되었지만 여전히 스냅드래곤 쿠키는 빠질 수 없는 필수 고정 쿠키로 사용되며 용과드래곤 쿠키와 함께 사용 시 드래곤 타입 체력 증가로 시너지 좋게 사용 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.548,
                "end": 62.426
            },
            {
                "speaker_id": "1",
                "transcription": "노움 연구소에서 무과금 유저라도 하루에 무료 뽑기 3회로 20일 정도 투자하면 획득 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.436,
                "end": 69.239
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.249,
                "end": 71.821
            },
            {
                "speaker_id": "1",
                "transcription": "용과드래곤 쿠키는 전방 탱커 포지션이지만 딜러처럼 광범위한 브레스로 상대 쿠키에게 큰 피해를 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.831,
                "end": 78.448
            },
            {
                "speaker_id": "1",
                "transcription": "상대방에게 공격력과 회복 감소를 주고 자신에게는 치명타 확률과 피해 감소를 증가시켜 주기 때문에 토핑 세팅에서도 보다 공격적으로 라즈베리 세팅으로 피해 감소가 좀 낮더라도 공격력과 치명타 확률을 높이고 1분 타이밍과 30초 때 공격력 증가 타이밍을 활용하여 쿠타임 부옵션을 맞춰서 사용합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.458,
                "end": 98.269
            },
            {
                "speaker_id": "1",
                "transcription": "자체적인 피해 감소 증가 스킬 능력도 있기 때문에 올 라즈베리 세팅으로 피해 감소 20퍼센트만 넘어도 잘 죽지는 않지만 피해 감소 수치는 높으면 높을수록 좋으며 그보다도 공격 타이밍이 가장 중요하기 때문에 쿨타임 부옵션에 더 신경 써서 맞춰 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.279,
                "end": 114.588
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 라즈베리 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 114.598,
                "end": 116.769
            },
            {
                "speaker_id": "1",
                "transcription": "소르베맛 쿠키는 15개의 얼음 결정을 발사해서 공격력이 높은 순서대로 적을 나누어 공격합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 116.779,
                "end": 122.839
            },
            {
                "speaker_id": "1",
                "transcription": "또한 적에게 서리 디버프를 부여하고 확률적으로 빙결 상태를 만들고 누적된 서리 디버프 수에 비례하여 추가 피해량과 빙결 확률이 증가됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 122.849,
                "end": 132.338
            },
            {
                "speaker_id": "1",
                "transcription": "이번 업데이트 이후 락스타맛 쿠키가 스냅드래곤과 함께 투 힐 조합으로 정석덱에 사용되면서 소르베맛 쿠키가 1분 전까지 생존하기에 안정적인 환경이 만들어졌고 소르베의 가장 큰 장점인 상대 딜러의 공격 타이밍을 꼬아 주고 1분 이후에 공격력 증가 타이밍에 상대 딜러를 순삭시키는 엄청난 화력으로 활용 가치가 늘어 났습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 132.348,
                "end": 152.609
            },
            {
                "speaker_id": "1",
                "transcription": "상위권에서 소르베를 메인 딜러로 활용한 조합이 대유행하고 있고 앞으로도 소르베는 다양한 정석덱에서 카운터덱으로도 활용될 수 있기 때문에 키워 두시면 유용하게 활용 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 152.619,
                "end": 163.594
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 올 쿨 토핑이지만 피해 감소 수치가 너무 낮은 분들은 아몬드 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 163.604,
                "end": 169.296
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신맛 쿠키는 적에게 마그마 폭발과 함께 화산 디버프를 주는 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 169.306,
                "end": 173.811
            },
            {
                "speaker_id": "1",
                "transcription": "용과드래곤 쿠키와 함께 불속성 피해 증가 시너지를 활용한 조합으로 많이 활용되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 173.821,
                "end": 179.086
            },
            {
                "speaker_id": "1",
                "transcription": "마그마 디버프와 화상 피해량이 딜러 이상의 공격력을 보여 주기 때문에 호루라기 보물 적용을 받아서 올 라즈베리 세팅으로 가장 많이 활용되고 불사 능력을 활용하여 방어덱으로 활용할 때는 아몬드 토핑으로 한방덱을 막는 조합으로 사용합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 179.096,
                "end": 194.163
            },
            {
                "speaker_id": "1",
                "transcription": "주로 유용하는 조합으로는 캡사이신, 용과, 홀리베리, 락스타, 스냅드래곤 조합으로 사용되며 불속성조합으로 강력한 화력 조합으로 사용됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 194.173,
                "end": 203.320
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 공격 조합에서는 라즈베리 방어덱에서는 아몬드 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 203.330,
                "end": 208.212
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 쿠키는 적들에게 피해 증가와 수면 디버프를 걸고 달빛 피해를 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 208.222,
                "end": 213.187
            },
            {
                "speaker_id": "1",
                "transcription": "락스타맛 쿠키 출시 이후 아레나에서 활용 가치가 업데이트 전보다 낮아졌지만 여전히 능력 자체가 타 쿠키에게 밀리는 게 아니라 유행 조합에서 깰 자리가 없을 뿐 여전히 만능 쿠키로써 한방덱, 정석덱, 공속섹 등 모든 조합에서 활용되고 스토리모드, 수호성전 등 모든 콘텐츠에서 유용하게 활용되기 때문에 초보자분들이 우선적으로 키워도 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 213.197,
                "end": 236.294
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사쿠키는 아레나에서 스킬 타이밍이 굉장히 중요하기 때문에 조합에 따라 토핑 세팅이 상당히 다르며 올 쿨 토핑, 라즈베리, 아몬드 세팅 등 다양하게 존재하기 때문에 관련 조합을 참고해서 세팅하시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 236.304,
                "end": 250.200
            },
            {
                "speaker_id": "1",
                "transcription": "무난한 토핑 추천은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 250.210,
                "end": 253.527
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 쿠키는 피해 집중 스킬을 통해 아군이 받는 피해량의 35퍼센트와 치명타 피해 35퍼센트를 감소시켜 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 253.537,
                "end": 260.406
            },
            {
                "speaker_id": "1",
                "transcription": "현재로서는 고대 등급이라 낮은 확률로 인해 초반부터 뽑기도 힘들고 다른 에픽으로 대체하기도 힘들어서 초보자분들은 고대의 전승 고대 쿠키 선택 시 홀리베리를 선택하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 260.416,
                "end": 271.416
            },
            {
                "speaker_id": "1",
                "transcription": "강력한 밀치기 공격과 상대방에게 기절 디버프도 주고 아군 전체 쿠키의 생존을 크게 높여주기 때문에 덱의 안전성을 높여줘서 아레나, 스토리 모드에서 빠질 수 없는 고정으로 사용되고 일반적인 탱커는 아몬드 토핑을 사용하지만 홀리베리 쿠키는 피해 감소 20프로 중반대만 된다면 올 쿨 토핑으로도 충분히 버틸 수 있기 때문에 토핑은 올 쿨 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 271.426,
                "end": 292.908
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소 수치가 너무 낮다면 아몬드 토핑을 섞어서 사용하는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 292.918,
                "end": 297.294
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 쿠키는 공격력이 가장 높은 적에게 별의 표식을 부여하고 상대 쿠키들에게 범위 피해를 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 297.304,
                "end": 302.986
            },
            {
                "speaker_id": "1",
                "transcription": "별의 표식을 받은 쿠키는 공격력 감소, 버프 금지, 회복량 감소, 피해 증가를 받습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 302.996,
                "end": 308.424
            },
            {
                "speaker_id": "1",
                "transcription": "이번 업데이트의 락스타맛 쿠키가 버프 금지, 방어 버프 스킬이 출시되어 스타더스트 티어가 떨어질 것을 걱정하는 분들이 있었지만 오히려 스타더스터의 버프 비례 추가 피해 오류가 수정되면서 좀 더 공격적으로 활용되거나 락스타와 함께 정석덱으로 잘 활용되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 308.434,
                "end": 323.813
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 쿠키는 치명타 확률이 높으면 수면 디버프와 추가 피해를 줄 확률이 높아지기 때문에 일반적으로 올 애플젤리를 추천드리지만 요새는 좀 더 공격적인 세팅으로 3 라즈에 2 애플젤리 세팅으로도 활용됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 323.823,
                "end": 337.836
            },
            {
                "speaker_id": "1",
                "transcription": "다음은 1 티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 337.846,
                "end": 339.545
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라 쿠키는 락스타맛쿠키 출시로 1 티어로 밀려났지만 여전히 힐량 자체만으로는 원탑이며 락스타맛 쿠키 대신 사용 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 339.555,
                "end": 346.923
            },
            {
                "speaker_id": "1",
                "transcription": "또한 부상 효과 감소 능력은 대체 불가이기 때문에 반드시 퓨어바닐라 쿠키도 키워주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 346.933,
                "end": 353.450
            },
            {
                "speaker_id": "1",
