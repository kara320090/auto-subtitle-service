        "term": [
            {
                "speaker_id": "1",
                "transcription": "저는 서리여왕 쿠키님의 부탁을 받고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.008
            },
            {
                "speaker_id": "2",
                "transcription": "알고 있소.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.018,
                "end": 4.737
            },
            {
                "speaker_id": "2",
                "transcription": "자연으로 돌아가려는 생명들의 소망을 누군가 방해하고 있구려",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.747,
                "end": 10.691
            },
            {
                "speaker_id": "2",
                "transcription": "이 숲에 영향을 미칠 정도라면 절대 미약하지만은 않은 크기의 힘이요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.701,
                "end": 18.347
            },
            {
                "speaker_id": "1",
                "transcription": "역시 천년나무 쿠키님도 알고 계셨군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.357,
                "end": 22.450
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 쿠키님은 생명 에너지의 흐름이 어썸브레스 대륙의 북동쪽으로 하고 있다고 하셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.460,
                "end": 30.259
            },
            {
                "speaker_id": "2",
                "transcription": "그 말이 맞소.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.269,
                "end": 31.846
            },
            {
                "speaker_id": "2",
                "transcription": "더 정확히 말하면 생명의 힘이 향하는 곳은 비스트이스트 대륙의 어둠의 땅",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.856,
                "end": 41.741
            }
        ]
    },
    "summary": "바람궁수 쿠키가 자연으로 돌아가려는 생명 에너지가 향하고 있는 곳은 비스트이스트 대륙의 어둠의 땅이라고 말하고 있다.",
