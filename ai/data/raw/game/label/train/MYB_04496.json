        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 보상 달달한데 진짜 아 일단 그러면은 최대 얼마까지 모이는 가서 네 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.553
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 빠른 리세를 할 거면은 이거 굳이 끝까지 안가도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.563,
                "end": 14.392
            },
            {
                "speaker_id": "1",
                "transcription": "최대 얼마까지 받을 수 있는지 확인하기 위해서 영상 보시는 처음 초보자 분들은 지금 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.402,
                "end": 19.797
            },
            {
                "speaker_id": "1",
                "transcription": "지금 게임 하기 좋네 잘 모르시는 분들기 위해서 말씀드리면은 평소에는 쿠폰도 없고 그러면은 막 7개, 8천개 밖에 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.807,
                "end": 27.729
            },
            {
                "speaker_id": "1",
                "transcription": "근데 지금 값어치가 2만 2천개 정도가 값어치가 나온 거는 리세 하기 정말 황금기라 볼 수 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.739,
                "end": 34.204
            },
            {
                "speaker_id": "1",
                "transcription": "아 서리여왕은 리세마로에 나오면은 진짜 이런 말 하기 그런데 그거는 좀 하지 말았으면 좋겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.214,
                "end": 40.012
            },
            {
                "speaker_id": "1",
                "transcription": "서리여황은 진짜 안 쓰거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.022,
                "end": 42.144
            },
            {
                "speaker_id": "1",
                "transcription": "스토리든 아레나든 계정이 있는데 리세마라 하려면 어떻게 해야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.154,
                "end": 46.571
            },
            {
                "speaker_id": "1",
                "transcription": "기존의 계정을 연동을 꼭 해야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.581,
                "end": 48.718
            },
            {
                "speaker_id": "1",
                "transcription": "연동 안 하면 기존 계정 날아가기 때문에 기존 계정을 연동을 하고 난 다음에 로그아웃을 한 다음에 게스트 계정으로 시작한 다음에 부계정으로 시작하면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.728,
                "end": 58.474
            },
            {
                "speaker_id": "1",
                "transcription": "서버 고르고 기존 계정 연동 꼭 하셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.484,
                "end": 60.908
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 안 하면은 계정 날아갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.918,
                "end": 62.440
            },
            {
                "speaker_id": "1",
                "transcription": "큰일나 초보자 분들은 얘가 말하는 게 지금은 잘 못 느끼겠지만 나중가서는 귀엽다는 느낌보다는 약간 왜 저러나 싶을 정도의 멘트를 많이 칩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.450,
                "end": 74.826
            },
            {
                "speaker_id": "1",
                "transcription": "약간 좀 거북해지는 멘트가 많아져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.836,
                "end": 78.800
            }
        ]
    },
    "summary": "화자가 영상 보시는 처음 초보자 분들은 지금 하라고 이야기하고 있다.",
