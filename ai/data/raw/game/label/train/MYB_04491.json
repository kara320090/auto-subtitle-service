        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 재고 먼저 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.975
            },
            {
                "speaker_id": "1",
                "transcription": "지금 생산을 안 하고 있는 이유는 창고가 다 꽉 차서 안 하시는 거거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.985,
                "end": 6.358
            },
            {
                "speaker_id": "1",
                "transcription": "생산도 잘하고 계신데요 왕국 운영에서는 뭐 잘못된 게 없으신데요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.368,
                "end": 10.951
            },
            {
                "speaker_id": "1",
                "transcription": "197개 이거 오픈하세요 앞에재고가 이렇게 많이 잘 쌓여있으면은 뒤에 거 오픈해도 전혀 상관없거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.961,
                "end": 17.863
            },
            {
                "speaker_id": "1",
                "transcription": "끝까지 다 올리세요 재고가 다 너무 좋으신데 소누님 코인이 800만밖에 없잖아요 그리고 창도도 지금다 꽉 찼잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.873,
                "end": 25.177
            },
            {
                "speaker_id": "1",
                "transcription": "그 이유가 소원나무 거래를 제가 볼 땐 많이 안 하시는 것 같아 일단 케스트 일일 일일 보상으로 매일매일 깨시고 주말에 몰아서 싹 다 그냥 교환하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.177,
                "end": 35.156
            },
            {
                "speaker_id": "1",
                "transcription": "어느 정도 많이 아 근데 지금 아 제가 볼 땐 대무역 관련된 거 이벤트가 곧 나올 거 같은 느낌이라 좀 적당히 하고 이벤트 나왔을 때 주말에 그냥 몰아서 교환해서 코인 싹 다 모으시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.166,
                "end": 48.176
            },
            {
                "speaker_id": "1",
                "transcription": "이벤트 할 때 대무역이나 이런 거 할 때 제가 지금 본 3가지 문제점 아 4가지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.186,
                "end": 53.303
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 연구를 지금 너무 안 하고 있다 그다음에 쿠키 하우스 레벨이 너무 낮다 그다음에 소원나무 거래를 안 하고 재고만 쌓고 있다 마지막 쿠키들 레벨을 70레벨 안 찍고 69레벨로 다 찍고 있다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.313,
                "end": 65.552
            },
            {
                "speaker_id": "1",
                "transcription": "지금 요게 4가지 문제가 있거든요 요것만 딱 잡아주고 하시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.562,
                "end": 70.546
            },
            {
                "speaker_id": "1",
                "transcription": "자 신전 보면은 자 여기 신전에서도 손해 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.556,
                "end": 74.389
            },
            {
                "speaker_id": "1",
                "transcription": "기준 레벨이라는 건 이 5마리 등록한 쿠키 중에 가장 레벨이 낮은 쿠키가 기준 쿠키가 되고 반드시 레벨이 높아야 되기 때문에 이 5마리 쿠키는 70렙으로 다 만들어 놓으면 얘네들도 다 70렙이 되거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.399,
                "end": 86.781
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 요거 레벨 70렙까지 찍어주시고 나머지는 별사탕 부족한데 어떡해요 그러면 이렇게 물어보신다면은 쿠키 하우스 레벨만 충분히 10레벨 12레벨 이렇게 올리다 보면은 별사탕 부족은 다 싹 사라져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.791,
                "end": 100.267
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 별사탕이 현질을 안 해서 부족하다는 건 잘못된 얘기예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.280,
                "end": 104.675
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 지금 덱이 좀 문제가 있으신 것 같은데 자 검볼다이버는 시대가 끝났습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 104.675,
                "end": 111.204
            },
            {
                "speaker_id": "1",
                "transcription": "차라리 공속덱을 메인으로 쓸 거면은 요렇게 쓰고 지금 BTS 쿠키는 별사탕 투자하지 마시고 여기 슬롯 자리 하나를 마련하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 111.214,
                "end": 118.745
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 빼야 될 거는 검볼다이버 빼시고 독버섯 빼세요 여기다가 BTS 쿠키 넣어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 118.742,
                "end": 125.608
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나 덱은 아레나는 일단 손 놓으셨구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 125.618,
                "end": 129.199
            }
        ]
    },
    "summary": "왕국 연구를 지금 너무 안 하고 있다 그다음에 쿠키 하우스 레벨이 너무 낮다 그다음에 소원나무 거래를 안 하고 재고만 쌓고 있다 마지막 쿠키들 레벨을 70레벨 안 찍고 69레벨로 다 찍고 있다 이렇게 4가지 문제점이 있고 아레나 덱에서도 검볼다이버랑 독버섯 쿠키를 빼고 BTS쿠키를 넣으면 된다.",
