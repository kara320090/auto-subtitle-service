        "term": [
            {
                "speaker_id": "1",
                "transcription": "선원들을 이끌고 검은 바다에 들어오려고 했잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.086
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 지금은 어머나 내 앞에 서 있네?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.096,
                "end": 9.426
            },
            {
                "speaker_id": "1",
                "transcription": "혼자서 말이야.",
