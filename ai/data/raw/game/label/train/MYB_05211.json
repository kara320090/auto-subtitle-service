                ],
                "start": 11.575,
                "end": 15.387
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 바스러져도 알아주는 쿠키 하나 없을 테지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.397,
                "end": 20.887
            },
            {
                "speaker_id": "2",
                "transcription": "이거야 원 어디서부터 잘못짚었다고 해야 할지 모르겠군.",
                "sound_type": [
                    2,
