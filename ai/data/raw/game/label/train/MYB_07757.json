                ],
                "start": 1.145,
                "end": 10.481
            },
            {
                "speaker_id": "1",
                "transcription": "그거 나름의 이유가 다 있었어요. 서부퀘를 해야만 볼 수 있는 장면들이 있었고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.491,
                "end": 14.768
            },
            {
                "speaker_id": "1",
                "transcription": "나 이거 진짜 어떻게 해.",
