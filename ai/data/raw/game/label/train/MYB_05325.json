        "term": [
            {
                "speaker_id": "1",
                "transcription": "엄청난 능력의 소유자 덧없는 흐름의 지배자 시간지기 쿠키",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.259
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 달빛술사 개인적으로 제일 쫌 기대가 되는 그런 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.269,
                "end": 10.865
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 달빛술사도 이쁜 스킨과 함께 나와있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.875,
                "end": 15.343
            },
            {
                "speaker_id": "1",
                "transcription": "최초의 빛 달빛술사 쿠키",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.353,
                "end": 17.857
            },
            {
                "speaker_id": "1",
                "transcription": "백련 드래곤 요새 또 다른 용족이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.867,
                "end": 20.462
            },
            {
                "speaker_id": "1",
                "transcription": "백련 드래곤 쿠키가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.472,
                "end": 22.756
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음 어둠마녀 항상 지금 쿠키런이나 킹덤이나 세계관에서 맞서 싸우는 적이죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.766,
                "end": 28.980
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 으븐브레이크에서 스킨 자체가 이쁘진 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.993,
                "end": 32.580
            },
            {
                "speaker_id": "1",
                "transcription": "약간 곰팡이 스킨이라고 별명이 있을 정도로 어둠 마녀",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.580,
                "end": 37.736
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 바람궁수 얘도 기다리는 분들이 상당히 많습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.746,
                "end": 42.147
            },
            {
                "speaker_id": "1",
                "transcription": "네 우리 또 엄청나게 스킨이 화려하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.157,
                "end": 44.880
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게",
