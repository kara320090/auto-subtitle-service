        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 썸네일하고 제목을 보고 들어오신 분들 아니 @이름1님 대무역 이벤트가 함정 이벤트라는 게 무슨 소린가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.223
            },
            {
                "speaker_id": "1",
                "transcription": "자 대무역 이벤트 여러분들 보실 때 다양한 보상도 주고 랭킹 보상도 엄청나게 좋은 걸 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.233,
                "end": 15.074
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 여러분들이 한 가지 아셔야 될 중요한 포인트가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.084,
                "end": 18.911
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 가진 재고들을 정말 쏟아부어서 1퍼센트 안에 들었다고 가정합시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.921,
                "end": 24.988
            },
            {
                "speaker_id": "1",
                "transcription": "2퍼센트 보상이 있겠죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.998,
                "end": 26.364
            },
            {
                "speaker_id": "1",
                "transcription": "차이는 2천 크리스탈 정도의 차이가 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.374,
                "end": 29.588
            },
            {
                "speaker_id": "1",
                "transcription": "각각의 단계도 보상 차이가 나는데 점점 줄어들죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.598,
                "end": 33.178
            },
            {
                "speaker_id": "1",
                "transcription": "자 대무역 시대 이벤트 이 이벤트의 목적은 여러분들이 쌓아놓는 이 재고를 최대한 쏟아부어서 소모시키려는 이벤트가 맞습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.188,
                "end": 42.667
            },
            {
                "speaker_id": "1",
                "transcription": "자 하지만 여러분들 대무역 이벤트보다 더 중요한 이벤트가 길드 무역이라고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.677,
                "end": 49.226
            },
            {
                "speaker_id": "1",
                "transcription": "자 대무역 이벤트는 재료 교환을 통해서 최종 보상만 받을 수가 있지만 길드 무역은 여러분들이 교환하는 이 모든 재고가 유용하게 토핑 조각으로 바뀔 수가 있고 또는 길드 티켓 자 또는 혼돈의 케이크 타워 열쇠",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.236,
                "end": 65.500
            }
        ]
    },
    "summary": "남성이 대무역 이벤트가 함정 이벤트라는 제목을 썼고 이 이벤트보다 길드 무역 이벤트가 더 중요하다.",
