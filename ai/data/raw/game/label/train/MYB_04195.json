        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 부계 키우기 오늘 드디어 8일 차 입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.726
            },
            {
                "speaker_id": "1",
                "transcription": "예 제가 이거 최대한 12성 찍을 때까지는 꾸준히 할 생각 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.736,
                "end": 9.797
            },
            {
                "speaker_id": "1",
                "transcription": "네 오늘도 또 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.807,
                "end": 12.163
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 오늘 시간이 없어서 제가 들어가질 잘 못했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.173,
                "end": 17.074
            },
            {
                "speaker_id": "1",
                "transcription": "이거 소원 나무도 잘 못했는데 그래도 여러분들 못해도 15개까지는 채워 주는 게 좋은 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.084,
                "end": 24.363
            },
            {
                "speaker_id": "1",
                "transcription": "시간이 없어도 최대한 해봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.373,
                "end": 27.492
            },
            {
                "speaker_id": "1",
                "transcription": "시간이 제가 부계에다가 올인할 수 있는 시간이 있으면은 진짜 쫙쫙 생산 많이 하고 테크도 쫙쫙 할 수 있는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.502,
                "end": 35.652
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 하루에 제가 방송하는 시간 외에는 접속 잠깐 하루에 3분 4분 플러스 방송에서 1시간 제가 맨날 이렇게 하고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.662,
                "end": 45.462
            },
            {
                "speaker_id": "1",
                "transcription": "거의 즐겜러분들 기준으로 하고 있는데 그래도 뭐 할 만은 합니다 게임",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.472,
                "end": 50.723
            },
            {
                "speaker_id": "1",
                "transcription": "잘 버티면서 하고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.733,
                "end": 53.050
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키들도 레벨 이제 42 랩 요렇게 다 올라가고 다 나름 성장을 하고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.060,
                "end": 59.065
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 쿠키성도 8 레벨 돼 가고 있고 오늘은 스토리 좀 깨볼까 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.075,
                "end": 66.240
            },
            {
                "speaker_id": "1",
                "transcription": "목표는 이제 에피소드 10까지 좀 가보도록 합시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.250,
                "end": 73.133
            }
        ]
    },
    "summary": "유튜버는 시간이 없어서 게임를 잘 하지 못했는데 오늘은 에피소드 10까지 스토리를 깨보려고 합니다.",
