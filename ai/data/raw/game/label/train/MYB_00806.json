        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 바다요정 30강 잼스톤 리뷰 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.524
            },
            {
                "speaker_id": "1",
                "transcription": "자 30강을 하면 잼스톤 강화는 단계가 최고 단계에 이르르게 되고 자 30강 효과 획득을 하게 되면 차오르는 혜일에 맞은 적은 최대 체력 비례 고정 피해를 4퍼센트 받게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.534,
                "end": 16.257
            },
            {
                "speaker_id": "1",
                "transcription": "자 초월 효과 같은 경우에는 잼스톤 15강을 달성하게 되면 능력을 얻게 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.267,
                "end": 21.900
            },
            {
                "speaker_id": "1",
                "transcription": "아군 쿠키의 물 속성 공격 피해량은 40퍼센트까지 증가하게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.910,
                "end": 26.592
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 @이름1 님 30강은 키울만한 가치가 있나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.602,
                "end": 30.556
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 궁금한 포인트 정리해 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.566,
                "end": 34.791
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 어떤 토핑을 써야 되는지 아레나에서는 쓸만한 덱이 있는지 어제 이미 30강 찍어서 리뷰를 찍었는데 제가 오늘 낮에 한 6시간 동안 바다요정 관련된 덱을 연구하면서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.801,
                "end": 47.350
            },
            {
                "speaker_id": "1",
                "transcription": "어 최종적으로 결론이 났고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.360,
                "end": 49.725
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 뭐 라즈베리로 세팅하면은 전투력은 뭐 100만이 넘는 건 블랙 펄과 마찬가지입니다",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.735,
                "end": 55.579
            },
            {
                "speaker_id": "1",
                "transcription": "자 세팅 같은 경우에는 제가 이것저것 다 해봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.589,
                "end": 58.468
            },
            {
                "speaker_id": "1",
                "transcription": "올 아몬드는 정말 쓸데없는 세팅입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.478,
                "end": 62.353
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐?",
                "sound_type": [
                    2
                ],
                "start": 62.363,
                "end": 62.947
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나에서 아몬드를 하게 되면 바다요정의 장점을 다 죽이는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.957,
                "end": 67.686
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 정말 딜 하나로 승부 보는 쿠키인데 강제로 딜을 죽이는 꼴이라 아무 의미가 없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.696,
                "end": 75.431
            },
            {
                "speaker_id": "1",
                "transcription": "라즈베리나 아니면 쿨 또는 라즈 쿨로 섞어서 어 승부를 봐야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.441,
                "end": 80.564
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 네 바다요정 라즈베리 세팅으로 뭐 당연하겠지만 스토리에서는 무조건 0티어로 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.574,
                "end": 88.800
            }
        ]
    },
    "summary": "30강을 하면 잼스톤 강화는 단계가 최고 단계에 이르고 차오르는 혜일에 맞은 적은 최대 체력 비례 고정 피해를 4퍼센트 받게 되며 잼스톤 15강을 하면 초월 효과가 생기며 라즈베리로 세팅하면 전투력은 100만이 넘고 스토리에서는 무조건 0티어로 좋다.",
