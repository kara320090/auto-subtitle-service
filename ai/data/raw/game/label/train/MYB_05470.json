        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 퓨어 바닐라님 계정 평가 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.046
            },
            {
                "speaker_id": "1",
                "transcription": "이분의 특징은 고기 젤리를 보세요 여러분들.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.056,
                "end": 6.360
            },
            {
                "speaker_id": "1",
                "transcription": "무려 만 7691개 보통 제가 계정 평가 수없이 많이 해 왔지만 고기 젤리 단위가 몇 1000개 있는 사람은 있었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.370,
                "end": 17.505
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 만 7691개를 넘는 사람은 처음 봤어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.515,
                "end": 23.538
            },
            {
                "speaker_id": "1",
                "transcription": "혹시나 이 계정 평가가 되고 나서 편집 돼서 올라 갔는데 댓글로 나는 이분보다 고기 젤리가 많다 네 제보해 주시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.548,
                "end": 33.311
            },
            {
                "speaker_id": "1",
                "transcription": "이보다 많은 사람은 일단 못 봤고 그다음에 또 신기한 거는 이분 닉네임 퓨어 바닐라님입니다 퓨어 바닐라님.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.321,
                "end": 41.830
            },
            {
                "speaker_id": "1",
                "transcription": "야 이것도 되게 유니크 한 그런 닉네임 왜냐면 쿠키런 킹덤은 닉네임이 중복이 되지 않기 때문에 저런 닉네임을 가지기가 상당히 힘들다 고렇게 보면 될 거 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.840,
                "end": 54.551
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이분은 고기 젤리를 어마무시허게 쌓았기 때문에 일단 고기 젤리 열기구를 돌리지 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.561,
                "end": 62.400
            }
        ]
    },
    "summary": "계정 평가를 신청한 퓨어 바닐라님의 특징은 고기 젤리가 만 7691개라 고기 젤리 열기구를 돌리지 않고 화자는 이보다 많은 고기 젤리를 본 적이 없으며 닉네임이 유니크 한 특징을 가지고 있다.",
