        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 더스트 좋아 조각 스타더스트는 진짜 뽑아드려야 돼.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.632
            },
            {
                "speaker_id": "1",
                "transcription": "옛날 라떼 얘기를 하자면은 홀리베리는 출시 때부터 약간 문제가 있던 쿠키예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.642,
                "end": 11.036
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 홀리베리가 딱 출시됐을 때 그 당시 영티어가 누구였던지 아시는 분 있나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.046,
                "end": 17.208
            },
            {
                "speaker_id": "1",
                "transcription": "그때 지금의 홀리베리급의 최강의 전방 탱커는 얘가 옛날에 홀리베리급이었어 지금의.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.218,
                "end": 25.729
            },
            {
                "speaker_id": "1",
                "transcription": "근데 문제가 얘보다도 홀리베리가 좋은지 체감이 안 될 정도로 처음에는 별로 안 좋았었거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.739,
                "end": 34.375
            },
            {
                "speaker_id": "1",
                "transcription": "데브시스터즈에서 별의별 뭔 버그였다는 이유로 막 상향을 2번 3번 먹이더니만 이제 홀리베리가 좋아졌죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.385,
                "end": 43.046
            },
            {
                "speaker_id": "1",
                "transcription": "대놓고 완전 진짜 넘사로 된 거는 2주년 때 네 2주년 때 홀리베리가 그냥 일반 사기도 아니고 그냥 핵 고정 사기로 돼서 거의 대체 불가능급으로 바뀌었습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.056,
                "end": 56.266
            }
        ]
    },
    "summary": "스타더스트는 진짜 뽑아드려야 하고 라떼 얘기를 하자면 홀리베리는 출시 때부터 약간 문제가 있었는데 출시됐을 때 영티어는 딸기크레페맛이었고 데브시스터즈가 별의별 버그였다는 이유로 상향을 먹이더니 홀리베리가 좋아져서 넘사가 됐고 2주년 때 핵 고정 사기로 돼서 거의 대체 불가능급으로 바뀌었다.",
