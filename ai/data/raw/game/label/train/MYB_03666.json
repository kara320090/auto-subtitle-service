        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 그다음에 이제 마카롱 예약해 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.795
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱 예약해 주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.805,
                "end": 5.147
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱 스킬 쓰자마자 블랙베리 자 스킬 바로 이렇게 연타해서 써주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.157,
                "end": 11.321
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 벚꽃 예약 눌러주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.331,
                "end": 14.556
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 오먹도 써주는데 오먹 예약하기 전에 여러분들이 꼭 체크해야 되는 게 앞에 비석이 깨진 게 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.566,
                "end": 21.443
            },
            {
                "speaker_id": "1",
                "transcription": "얘를 연타해서 빨리 쓰는 게 중요한 게 아니라 앞에 비석이 깨진 지 이거를 체크를 반드시 해야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.453,
                "end": 27.840
            },
            {
                "speaker_id": "1",
                "transcription": "나는 봤는데 이제 스킬 쿨타임이 돌아오는데 아직 안 깨졌는데 연타해서 빨리 누르면은 오먹 스킬 범위가 요렇게 잡혀요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.850,
                "end": 35.566
            },
            {
                "speaker_id": "1",
                "transcription": "근데 앞에 가 깨지면은 스킬 범위가 요렇게 잡히거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.576,
                "end": 39.143
            },
            {
                "speaker_id": "1",
                "transcription": "뒤에 비석 여기까지 다 깨 주는 게 중요하기 때문에 앞에 비석이 깨지는 거 보고 보고 오먹을 눌러주시면 됩니다. 최대한 보시면서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.153,
                "end": 48.483
            },
            {
                "speaker_id": "1",
                "transcription": "자 오먹 눌러주면 이렇게 뒤에 잡혀서 뒤에 다 깨지고 자 그다음에 오먹 누른 다음에 바로바로 마카롱 스킬 예약을 해야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.493,
                "end": 56.480
            },
            {
                "speaker_id": "1",
                "transcription": "호밀 가만히 멍때리면은 호밀 스킬 나가기 때문에 마카롱 예약을 바로 바로 해주시고 이 비석이 깨질 때쯤 다 깨졌죠? 이제",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.490,
                "end": 65.617
            },
            {
                "speaker_id": "1",
                "transcription": "이때 이제 호밀 스킬 눌러주면 됩니다.",
                "sound_type": [
