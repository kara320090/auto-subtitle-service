        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "요렇게 강한 딜로 들어가서 가운데를 녹여버리는 구조다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.431
            },
            {
                "speaker_id": "1",
                "transcription": "제가 달빛술사가 죽어버려도 녹여버리는 그림이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.441,
                "end": 9.384
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이 자리에 스타더스트 넣어서 쓰는 분도 있지만 달빛술사로 방덱으로도 공덱으로도 엄청나게 좋게 쓰이고 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.394,
                "end": 16.857
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 달빛술사, 스타더스트 덱입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.867,
                "end": 19.770
            },
            {
                "speaker_id": "1",
                "transcription": "자 여전히 상위권에서도 달빛술사, 스타더스트 덱은 공덱으로도 활용되고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.780,
                "end": 25.792
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방은 스타더스트랑 락스타죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.802,
                "end": 28.590
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사, 스타더스트덱 같은 경우에는 기존에 업데이트 전에 대유행했던 정석덱이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.600,
                "end": 36.701
            },
            {
                "speaker_id": "1",
                "transcription": "엄청난 폭딜을 가져가는 덱이기 때문에 1분 타이밍에 요렇게 폭딜을 주는 덱이고 장점이라 함은 확실히",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.711,
                "end": 48.833
            }
        ]
    },
    "summary": "화자는 달빛술사와 스타더스트 덱은 여전히 상위권에서 활용되고 있는 공덱이며 상대방은 스타더스트와 락스타라고 설명하고 있다.",
