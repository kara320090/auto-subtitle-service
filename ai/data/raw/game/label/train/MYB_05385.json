        "term": [
            {
                "speaker_id": "1",
                "transcription": "딱 그 경우의 수를 나눠드리면 와베 있으면 소환 덱 웬만해서 쓰지 말자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.563
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 2, 1, 2면은 5번 들어가자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.573,
                "end": 7.507
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 요거 같은 경우에는 2, 2, 1에 한 번 들어가 보시고 어떻게 지는지 한번 보세요. 이거 깃털 말고 모노클 껴서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.517,
                "end": 16.459
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 지금 계속 아레나에서 진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.469,
                "end": 19.192
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 들어갔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.202,
                "end": 20.434
            },
            {
                "speaker_id": "1",
                "transcription": "들어가서 마지막 최종 결과 창 나오죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.444,
                "end": 22.445
            },
            {
                "speaker_id": "1",
                "transcription": "그 상대방 쿠키 조합이랑 내가 어떤 걸로 들어갔는데 졌다 그 스샷을 보내 주시면 됩니다.",
                "sound_type": [
                    2,
