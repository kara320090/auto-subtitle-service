    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이번 판 그냥 이거 내가 일단 여기 이 상태에서 보게 되면은 따로 뭐 승패를 지금 따지고자 하는 게 아니라 전반적으로 쓰이는 @이름1랑 @이름2만 놓고 보면은",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 12.720
            },
            {
                "speaker_id": "1",
                "transcription": "딜 차이가 확실히 많이 나죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.720,
                "end": 14.880
            },
            {
                "speaker_id": "1",
                "transcription": "피해량 뭐 흡수해 준다고 하지만 크게 뭐 의미가 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.880,
                "end": 19.060
            },
            {
                "speaker_id": "1",
                "transcription": "마탕으로 나온 @이름1나 @이름3나 나름 다른 쿠키에 비해서 장점이 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.060,
                "end": 24.170
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 비교하는 거 어떤 식으로 하면 되냐면 얘가 BTS 쿠키보다 힐량이 딱 반이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.170,
                "end": 29.830
            },
            {
                "speaker_id": "1",
                "transcription": "힐량만 놓고 한번 좀 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.830,
                "end": 33.180
            },
            {
                "speaker_id": "1",
                "transcription": "자 @이름4는 BTS 쿠키의 힐량의 반 네 @이름5는 힐량 자체는 나쁘지 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.180,
                "end": 40.150
            },
            {
                "speaker_id": "1",
                "transcription": "근데 문제가 뭐냐면 지금 상대 아레나에 3탱 덱도 있고 뭐 여러 덱이 존재하는데 3탱 덱에 @이름6가 들어가거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.150,
                "end": 50.560
            },
            {
                "speaker_id": "1",
                "transcription": "@이름6의 능력 중의 하나가 @이름5의 이 체력 보호막 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.560,
                "end": 54.450
            },
            {
                "speaker_id": "1",
                "transcription": "이 체력 보호막을 없애 버리는 역할을 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.450,
                "end": 57.180
            },
            {
                "speaker_id": "1",
                "transcription": "@이름5가 되게 @이름6 덱한테 되게 안 좋게 작용하기도 하고 이렇게 체력이 다 차 있는 애들한테는 힐이 즉시 힐이 많이 들어간다고 해도 어 보호막으로 이렇게 있다 해도",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.180,
                "end": 68.450
            },
            {
                "speaker_id": "1",
                "transcription": "힐이 낭비되는 부분이 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.450,
                "end": 70.840
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키나 다른 쿠키들은 조금씩 차오르는 힐 때문에 좋게 쓰일 수 있지만 저렇게 남는 거 때문에 좀 손해 보는 것도 있을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.840,
                "end": 80.160
            },
            {
                "speaker_id": "1",
                "transcription": "요런데 볼 때는 뭐야 @이름5 힐이 많네라고 생각할 수 있는데 원래 @이름5 자체는 힐이 좋아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 80.160,
                "end": 87.080
            },
            {
                "speaker_id": "1",
                "transcription": "원래 원래 얘도 스토리 모드에서도 지금도",
                "sound_type": [
                    2,
                    5
                ],
                "start": 87.080,
                "end": 90.541
            }
        ]
    },
    "summary": "홀리베리는 자색고구마와 비교했을 때 딜 차이가 있을뿐더러 다른 쿠키에 비해 장점도 없으며 퓨어 바닐라의 힐량은 나쁘지 않지만 다크 덱에는 좋게 작용하지 않고 보호막이 있다 해도 힐이 낭비되어서 손해를 보는 부분이 있다.",
