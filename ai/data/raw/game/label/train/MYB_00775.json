        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 워낙 키워 될게 많으니까 @이름1 님 그냥 편하게 딱 5개만 집어주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.428
            },
            {
                "speaker_id": "1",
                "transcription": "복잡하니까 최종적으로 제가 정리를 해드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.438,
                "end": 8.882
            },
            {
                "speaker_id": "1",
                "transcription": "자 전방에는 홀리 베리, 크림슨 코랄 둘 다 키워줘야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.892,
                "end": 13.515
            },
            {
                "speaker_id": "1",
                "transcription": "자 딜러 블랙펄, 스타더스트, 달빛 술사 여유가 된다면은 용과 드레곤까지 이 쿠키 중에 여러분들 가능한 거 선택해서 키워주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.525,
                "end": 24.367
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막 뒤에 힐러는 스냅 드래곤 반드시 키워주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.377,
                "end": 28.713
            },
            {
                "speaker_id": "1",
                "transcription": "또 여유가 되면은 락스타까지 네 이 정도만 여러분들 알고 선택과 집중해서 키워주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.723,
                "end": 35.803
            },
            {
                "speaker_id": "1",
                "transcription": "자 오늘 뭘 키워야 될지 현재 아레나에서 뭐가 좋은지 알아봤는데 어 추가로 궁금한 점이 있다면 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.813,
                "end": 44.492
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
