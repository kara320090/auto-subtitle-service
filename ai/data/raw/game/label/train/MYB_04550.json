        "term": [
            {
                "speaker_id": "1",
                "transcription": "월화수목금토일까지는 퀘스트만 깨고 주말에 토요일, 일요일 날 추가로 코인 주는 이벤트 하니까 이게 매주마다 항상 하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.004
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 요거 거래해서 주말에 코인을 벌어라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.014,
                "end": 13.378
            },
            {
                "speaker_id": "1",
                "transcription": "코인 모으기가 아마 쉽지 않을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.388,
                "end": 15.811
            },
            {
                "speaker_id": "1",
                "transcription": "지금으로서는 수호 성전 하는 방법은 지금 메인 덱 이거가 최선이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.821,
                "end": 22.315
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 하면 잘 죽으니까 피감 높이세요. 어쩔 수 없다. 아몬드 해야지 뭐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.325,
                "end": 26.246
            },
            {
                "speaker_id": "1",
                "transcription": "메인 덱에다가 일단 최고의 토핑을 다 둘러주고 수호 성전 기갱하려면은 일단 쿠키 뽑기를 더해서 뽑아야 될 쿠키가 많거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.256,
                "end": 34.879
            },
            {
                "speaker_id": "1",
                "transcription": "걔네들 먼저 뽑고 기갱을 도전하세요. 지금은 기갱하려고 노력해봤자 의미가 크게 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.889,
                "end": 40.825
            },
            {
                "speaker_id": "1",
                "transcription": "지금 아까 대기열 투자하고 어느 정도는 고급에다 투자하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.835,
                "end": 45.283
            },
            {
                "speaker_id": "1",
                "transcription": "찰스가 3성까지만 일단은 뽑아주시면 되는데 4성까지 돼있네? 이제 찰스는 그만하시고 고급에다 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.293,
                "end": 51.733
            }
        ]
    },
    "summary": "지금 메인 덱이 최선이라 피감 높여서 아몬드 해야 한다.",
