        "term": [
            {
                "speaker_id": "1",
                "transcription": "가스라이팅 당해서 내가 이제 최고라고 말해 주는 이 게임에서 벗어나지 못하는 걸 수도",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.190
            },
            {
                "speaker_id": "1",
                "transcription": "음 아무튼 이제 이거 봐 보상도 주잖아.",
                "sound_type": [
                    2
                ],
                "start": 5.200,
                "end": 7.760
            },
            {
                "speaker_id": "1",
                "transcription": "근데 벌레를 줬네요?",
                "sound_type": [
                    2
                ],
                "start": 7.770,
                "end": 8.963
            },
            {
                "speaker_id": "1",
                "transcription": "아하하 보상을 받긴 받았는데 벌레를 줬네?",
                "sound_type": [
                    2
                ],
                "start": 8.973,
                "end": 12.688
            },
            {
                "speaker_id": "1",
                "transcription": "이런 건 예상 외인데 음 아무튼 막 칭찬을 해 주잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.698,
                "end": 17.666
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 이 세계에서 어떻게 벗어나냐고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.676,
                "end": 21.600
            }
        ]
    },
    "summary": "화자는 미션 성공 보상으로 벌레를 받았고 비록 벌레지만 칭찬을 하고 내가 최고라고 말해 줘서 이 세계에서 벗어나지 못한다고 한다.",
