        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "제 노래를 들어주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.431
            },
            {
                "speaker_id": "2",
                "transcription": "아 아 맞다 연습 모드 나가면 안 되지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.441,
                "end": 5.888
            },
            {
                "speaker_id": "2",
                "transcription": "아 이거 내가 볼 땐 40 웨이브까지 가겠네 진태님.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.898,
                "end": 9.184
            },
            {
                "speaker_id": "2",
                "transcription": "이거 세팅만 하면 가겠네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.194,
                "end": 11.283
            },
            {
                "speaker_id": "2",
                "transcription": "연습 모드로 지금 해서 느낀 거는 그 샤벳 피하는 거랑 교체 타이밍 와베가 죽을 거 같으면은 빼 주고 죽을 같으면 빼 주고 교체만 해주면 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.293,
                "end": 22.002
            },
            {
                "speaker_id": "2",
                "transcription": "와베가 피감이 좀 낮아서 그래요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.012,
                "end": 25.250
            },
            {
                "speaker_id": "2",
                "transcription": "좀 더 높이면 좋긴 한데 좀 더 보완할 수 있으면 보완해주고 지금 크림 유니콘도 잠깐만 크림 유니콘 얘 키우면은 진짜 좋은데 이거 왜 아 뺏구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.260,
                "end": 35.985
            },
            {
                "speaker_id": "2",
                "transcription": "퓨바 피감 몇 퍼센트 줘야 되나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.995,
                "end": 37.987
            },
            {
                "speaker_id": "2",
                "transcription": "아 그래도 10퍼센트는 심하고 제 생각에는 20퍼센트 가까이는 줘야 된다고는 생각하는데 그래도 막 진짜 한 15퍼센트 이상만 해도 원하는 40 웨이브까지 갈 수 있을 거 같아요 제가 볼 때는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.997,
                "end": 50.514
            },
            {
                "speaker_id": "2",
                "transcription": "제가 느낀 거는 40웨이브 전까지는 이렇게 쓰는 게 더 안정적이었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.524,
                "end": 54.298
            },
            {
                "speaker_id": "2",
                "transcription": "제가 2개 다 해 봤거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.308,
                "end": 55.541
            },
            {
                "speaker_id": "2",
                "transcription": "근데 퓨바랑 같이 쓰는 게 더 안정적일 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.551,
                "end": 58.023
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 목화 같은 경우에는 소환덱도 나쁘지 않다고 했거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.033,
                "end": 62.200
            }
        ]
    },
    "summary": "연습 모드로 했을 때 와베 피가 낮아서 죽을 거 같으면 빼주고 피감 15퍼센트 이상만 해도 원하는 40웨이브까지 갈 수 있을 것 같다고 이야기한다.",
