        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 열받는 거 시작했네.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.340
            },
            {
                "speaker_id": "1",
                "transcription": "또 아 조작이 쉽지 않아요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.340,
                "end": 6.905
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 나 서커스 출신이야?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.915,
                "end": 20.597
            },
            {
                "speaker_id": "1",
                "transcription": "왜 이렇게 잘해?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 20.607,
                "end": 21.182
            },
            {
                "speaker_id": "1",
                "transcription": "아니 뭐야 오늘?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.192,
                "end": 23.913
            },
            {
                "speaker_id": "1",
                "transcription": "왜 이렇게 잘하지 오늘?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 23.923,
                "end": 27.082
            },
            {
                "speaker_id": "1",
                "transcription": "원래 여기는 30번 하면서 열 받아 갖고 울면서 그만한다고 하고 만 원짜리 미션 받고 울면서 깬 다음에 헤헤 하고 웃는 게 국룰 아니냐?",
                "sound_type": [
                    2,
                    4
                ],
                "start": 27.092,
                "end": 37.677
            },
            {
                "speaker_id": "1",
                "transcription": "나 게임 오늘 잘하니까 돈도 못 벌어.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 37.687,
                "end": 44.620
            },
            {
                "speaker_id": "1",
                "transcription": "아하하하하 악귀에 씌었나 봐.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 44.630,
                "end": 50.066
            },
            {
                "speaker_id": "1",
                "transcription": "어저께 게임 잘하는 재능 갖고 싶다고 이야기 해 가지고 좀 잘 해 졌나봐.",
                "sound_type": [
                    2
                ],
                "start": 50.076,
                "end": 55.834
            },
            {
                "speaker_id": "1",
                "transcription": "쓰레기차, 우리기메 돌려줘요.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 55.844,
                "end": 61.139
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 나 이게 뭔 일이야 이게?",
                "sound_type": [
                    2
