                ],
                "start": 5.475,
                "end": 7.689
            },
            {
                "speaker_id": "1",
                "transcription": "리치 잠깐만 아 이거 잠깐만 아유 아유 선생님 아유 이런 거 어떻게 하니?",
                "sound_type": [
