                    5
                ],
                "start": 12.487,
                "end": 30.941
            },
            {
                "speaker_id": "1",
                "transcription": "아니 낫은 사기꾼이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.951,
                "end": 33.982
            },
            {
                "speaker_id": "1",
                "transcription": "어우야 너 왜 이렇게 낫 낫 사기꾼 같아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.922,
                "end": 39.280
            },
            {
                "speaker_id": "1",
                "transcription": "드디어 넘어졌다 이제 너무 멋있어.",
