    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "레드벨벳 드래곤 5억딜이 돌파가 됐습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.784
            },
            {
                "speaker_id": "1",
                "transcription": "신규 쿠키 스냅 드래곤이 출시가 되면서 질리언 도넛 쿠키가 빠지고 토벌 조합이 바뀌게 되었습니다.",
                "sound_type": [
                    2
                ],
                "start": 3.794,
                "end": 11.626
            },
            {
                "speaker_id": "1",
                "transcription": "보물 또한 핀쿠션이 빠지고 호루라기가 들어가게 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.636,
                "end": 16.581
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기 보물 같은 경우에는 받는 대상이 로얄 마가린과 푸룬주스가 요렇게 받아야 된다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.591,
                "end": 24.295
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 먼저 보게 되면 밀키웨이 같은 경우에는 쿨 최소는 24.5 이상 그리고 공속은",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.305,
                "end": 30.668
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이렇게까지 많이 안 주셔도 되긴 하지만 최대한 많이 주셔야 해요 사람마다 방깎이 유지가 되게끔 하려면 최대한 많이 주셔야 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.678,
                "end": 41.716
            },
            {
                "speaker_id": "1",
                "transcription": "아따가 방깎 유지되는 포인트를 제가 알려 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.726,
                "end": 46.265
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 피감은 11퍼센트 이상 그리고 로얄 마가린은 최소 쿨타임은 12.5퍼센트 이상입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.275,
                "end": 53.114
            },
            {
                "speaker_id": "1",
                "transcription": "피감은 스펙에 따라 다르지만 만약에 승급이 낮다 하면 피감 좀 더 주셔야 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.124,
                "end": 59.176
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 맞추기가 힘들다고 하시면 2쿨 3라즈로 해주시고요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.186,
                "end": 62.615
            },
            {
                "speaker_id": "1",
                "transcription": "2쿨 3라즈로 하면 부옵션에 공격 부옵션을 주셔야 하지만 에클레어 보다 공격력 수치가 높아서 호루라기를 이렇게 받을 수가 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.625,
                "end": 72.558
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어 같은 경우에는 쿨타임 권장은 9퍼센트 이상 피감 권장은 48퍼센트 이상인데 권장입니다 여러분들",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.568,
                "end": 80.926
            },
            {
                "speaker_id": "1",
                "transcription": "스냅 드래곤도 쿨타임 권장은 공속이 아예 없는 기준으로는 24.8퍼센트 공속이 있는 경우에는 24.7퍼센트 그리고 공속이 아주 많은 경우에는 24.6퍼센트도 된다고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.936,
                "end": 95.477
            },
            {
                "speaker_id": "1",
                "transcription": "세팅이 가능한 분 한번 따라해 보시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.487,
                "end": 100.208
            }
        ]
    },
    "summary": "남자가 쿠키런 게임에서 질리언 도넛 쿠키가 빠지고 토벌 조합이 바뀌게 되었다고 여러 가지 조합법을 설명하고 있다.",
