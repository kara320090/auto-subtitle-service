        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 크림슨 코랄 출시 이후 현 시점에서 어떤 쿠키를 집중적으로 키워야 될지 정리해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.811
            },
            {
                "speaker_id": "1",
                "transcription": "자 모두 아레나 조합에서는 크림슨 코랄이 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.821,
                "end": 10.761
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그러면 홀리 베리는 나락을 간 건가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.771,
                "end": 14.066
            },
            {
                "speaker_id": "1",
                "transcription": "아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.076,
                "end": 14.854
            },
            {
                "speaker_id": "1",
                "transcription": "홀리 베리는 현재 용과 드래곤과 함께 아주 잘 쓰고 있기 때문에 나락을 간 게 절대 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.864,
                "end": 22.551
            },
            {
                "speaker_id": "1",
                "transcription": "자 원탱 조합에서는 이제 홀리 베리랑 비교도 할 수 없게끔 예 크림슨 코랄이 압도적으로 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.561,
                "end": 29.738
            },
            {
                "speaker_id": "1",
                "transcription": "제가 한 가지 예시를 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.748,
                "end": 32.659
            },
            {
                "speaker_id": "1",
                "transcription": "자 크림슨 코랄이 0성이 홀리 베리 5초월 보다도 훨씬 더 원텍으로는 더 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.669,
                "end": 39.950
            },
            {
                "speaker_id": "1",
                "transcription": "자 똑같은 세팅이고 단지 앞에 탱커만 바꿨을 뿐인데 기존에 뒤에 있는 쿠키들의 생존을 보호해 주는 게 차원이 달라요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.960,
                "end": 50.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 보시는 거와 같이 홀리 베리 5초월이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.316,
                "end": 53.388
            },
            {
                "speaker_id": "1",
                "transcription": "상대는 네 크림슨 코랄이죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 53.398,
                "end": 56.567
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 제 쿠키들은 이제 스킬 돌고 나서 보호가 안 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.577,
                "end": 64.288
            },
            {
                "speaker_id": "1",
                "transcription": "상대 쿠키들도",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.298,
                "end": 67.200
            }
        ]
    },
    "summary": "집중적으로 키워야 될 쿠키에서 홀리 베리는 용과 드래곤과 함께 잘 쓰고 있고 자 원탱 조합에서는 크림슨 코랄이 압도적으로 좋다.",
