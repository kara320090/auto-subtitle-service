        "term": [
            {
                "speaker_id": "1",
                "transcription": "들죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.147
            },
            {
                "speaker_id": "1",
                "transcription": "나쁜 애는 아니었단다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.157,
                "end": 6.849
            },
            {
                "speaker_id": "1",
                "transcription": "우리를 도와줬지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.859,
                "end": 8.470
            },
            {
                "speaker_id": "2",
                "transcription": "점심 먹었던 게 체한 건지 식은 땀 나고 속도 안 좋고 머리도 심하게 아파서 진통제 먹고 잠시 잤는데 곤죽처럼 죽었다가 이제 조금 살아났습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.480,
                "end": 20.488
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 어쩐지 조용하더라니. 주무시는 줄 알았는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.498,
                "end": 25.126
            },
            {
                "speaker_id": "1",
                "transcription": "체했나 봐. 요즘 왜 이렇게 속이 안 좋으세요 속이랑 머리 두통이 좀 심하신 것 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.136,
                "end": 31.202
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 병원을 다니니까 잔소리를 내가 덜 하지 안 그랬으면 그냥.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.212,
                "end": 41.415
            },
            {
                "speaker_id": "1",
                "transcription": "가만 안 둬.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.425,
                "end": 47.120
            },
            {
                "speaker_id": "1",
                "transcription": "잔소리 폭발.",
