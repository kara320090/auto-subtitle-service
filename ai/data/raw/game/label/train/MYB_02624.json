        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.934
            },
            {
                "speaker_id": "1",
                "transcription": "방치형로서 모바일 게임을 편하게 모니터링 가능하며 핸드폰 발열이나 배터리 부족으로 인한 불편함도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.944,
                "end": 8.129
            },
            {
                "speaker_id": "1",
                "transcription": "PC에서 큰 화면에 초고화질로 몰입할 수 있는 녹스앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.139,
                "end": 12.432
            },
            {
                "speaker_id": "1",
                "transcription": "요거를 이제 소르베 자리에 넣고 진행을 해볼 건데 스토리 할 때 아까 아몬드로 했었거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.442,
                "end": 19.469
            },
            {
                "speaker_id": "1",
                "transcription": "아몬드로 일단 해보고 라즈로도 해볼게요. 알겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.479,
                "end": 22.477
            },
            {
                "speaker_id": "1",
                "transcription": "요거 그냥 보물은 똑같고 웨어울프 자리 한번 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.487,
                "end": 26.320
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 차이 있는지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.330,
                "end": 27.605
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 진짜 웨어울프 자리에 그 캡사이신 넣은 결과야",
                "sound_type": [
                    2,
                    5
                ],
                "start": 27.615,
                "end": 32.833
            }
        ]
    },
    "summary": "남자가 웨어울프 자리에 캡사이신을 넣어 게임을 하고 있다.",
