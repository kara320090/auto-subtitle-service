        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현재 가장 많이 쓰이고 있는 공덱 어 제가 몇 가지 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.096
            },
            {
                "speaker_id": "1",
                "transcription": "자 3번, 4번, 5번 이렇게 되어 있고 1번 같은 경우에도 간간히 썼지만 이번 리뷰의 목표는 소르베랑 달빛 조합 원탱 어 딜러 덱 위주로 제가 리뷰해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.106,
                "end": 21.271
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 첫 번째 덱 같은 경우에는 퓨바랑 예언자가 같이 쓰고 있는데 얘도 나름 투힐덱입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.281,
                "end": 27.619
            },
            {
                "speaker_id": "1",
                "transcription": "예언자도 힐을 해주고 퓨바도 힐을 해주기 때문에 상당히 좋고 거기다가 모노클까지 힐을 해준다 이렇게 쓰이는데 정말 승률이 저는 제일 좋았거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.629,
                "end": 38.519
            },
            {
                "speaker_id": "1",
                "transcription": "세팅을 보면은 홀리베리는 올 아몬드 8퍼센트 쿨 그다음 피감은 여러분들 능력껏 높게 그다음에 소르베 같은 경우에는 어 저는 쿨 24퍼센트 이상 높게 줬지만 22퍼센트 이상 여러분들 능력껏 어 주시면 될 거 같고 피감도 능력껏.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.529,
                "end": 54.018
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사는 쿨 22퍼센트 이상 줬습니다. 저는 이게 가장 승률이 좋았고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.028,
                "end": 58.926
            },
            {
                "speaker_id": "1",
                "transcription": "피감은 여러분들 능력껏.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
