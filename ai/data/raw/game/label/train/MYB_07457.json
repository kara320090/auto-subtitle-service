                    2,
                    3,
                    5
                ],
                "start": 48.468,
                "end": 51.424
            },
            {
                "speaker_id": "1",
                "transcription": "너니?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.434,
                "end": 52.019
            },
            {
                "speaker_id": "1",
                "transcription": "얘네 아 이거네 아 싫어 나 너무 싫은 것만 잡아 오늘 아 이거 진짜 어려운 거잖아 생긴 것 좀 봐 개 세게 생겼어",
