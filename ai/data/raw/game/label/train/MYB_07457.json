        "term": [
            {
                "speaker_id": "1",
                "transcription": "위에 못 올라가는데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.123
            },
            {
                "speaker_id": "1",
                "transcription": "아니 뭔가 위에도 갈 수 있는 것 같은데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.133,
                "end": 3.901
            },
            {
                "speaker_id": "1",
                "transcription": "아래 이카시가 에이비씨 이건 아닌 것 같은데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.911,
                "end": 14.077
            },
            {
                "speaker_id": "1",
                "transcription": "여기 자 막 곳 확인해볼까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.087,
                "end": 20.540
            },
            {
                "speaker_id": "1",
                "transcription": "집으로 가서 확인을 해야 될 것 같은데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.550,
                "end": 22.888
            },
            {
                "speaker_id": "1",
                "transcription": "아래가 있나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.898,
                "end": 24.296
            },
            {
                "speaker_id": "1",
                "transcription": "있을 리 없는데 저 위에 올라갈 수 있는 거 아니에요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.306,
                "end": 32.769
            },
            {
                "speaker_id": "1",
                "transcription": "아닌가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.779,
                "end": 36.307
            },
            {
                "speaker_id": "1",
                "transcription": "오르시에르곳 여기 전체가 오르시에르곳인가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.317,
                "end": 48.458
            },
            {
                "speaker_id": "1",
                "transcription": "이건가?",
