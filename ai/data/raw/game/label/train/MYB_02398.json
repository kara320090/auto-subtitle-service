        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그다음 분 또 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.585
            },
            {
                "speaker_id": "1",
                "transcription": "지금 여러분들이 그런 생각 하는 분들 있을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.595,
                "end": 6.614
            },
            {
                "speaker_id": "1",
                "transcription": "자색 고구마를 그면 키워야 되나요라고 하시는 분들.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.624,
                "end": 9.779
            },
            {
                "speaker_id": "1",
                "transcription": "아레나가 지금 업데이트가 이제 또 얼마 남지 않았어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.789,
                "end": 14.195
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트가 이제 일주일 넘게 남았는데 있으신 분들은 활용해도 좋지만 괜히 업데이트 전에 키웠다가 또 신규 이제 방어형 쿠키 또 나오거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.205,
                "end": 25.684
            },
            {
                "speaker_id": "1",
                "transcription": "티어가 갑자기 또 내려갈 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.694,
                "end": 27.870
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들한테 말씀드리고 싶은 거는 자색 고구마 키워 놓으신 분들은 뜨시면 정말 활용할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.880,
                "end": 33.724
            },
            {
                "speaker_id": "1",
                "transcription": "안 키워 놓으신 분들은 일단 일주일 정도 기다렸다가 키우는 게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.734,
                "end": 37.211
            },
            {
                "speaker_id": "1",
                "transcription": "지금 현재 트렌드는 자색 고구마가 정말 좋게 쓰인다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.221,
                "end": 42.500
            }
        ]
    },
    "summary": "자색 고구마 키워 놓으신 분은 뜨시면 활용할 수 있고 안 키워 놓으신 분은 일주일 정도 기다렸다가 키우는 게 좋다고 남자가 설명하고 있다.",
