        "term": [
            {
                "speaker_id": "1",
                "transcription": "스케일이 달라졌어.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 0.000,
                "end": 1.516
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 피 한 방울 안나.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 1.526,
                "end": 6.399
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까",
                "sound_type": [
                    2,
                    4
                ],
                "start": 6.409,
                "end": 14.792
            },
            {
                "speaker_id": "2",
                "transcription": "전 제 몸에 지방이 저렇게 뭉쳐서 나가주면 좋을 것 같네요.",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 14.802,
                "end": 20.798
            },
            {
                "speaker_id": "1",
                "transcription": "저도요.",
                "sound_type": [
                    2
                ],
                "start": 20.808,
                "end": 21.394
            },
            {
                "speaker_id": "1",
                "transcription": "요 정도만 빼도 참 좋을 것 같은데",
                "sound_type": [
                    2,
                    4
                ],
                "start": 21.404,
                "end": 24.572
            },
            {
                "speaker_id": "1",
                "transcription": "야 근데 심지어 이 상황, 이 상황에서 지금 도구를 사용해서 머리를 썼다는 게 진짜 호러임.",
                "sound_type": [
                    2
                ],
                "start": 24.582,
                "end": 30.110
            },
            {
                "speaker_id": "1",
                "transcription": "회사를 다 뒤집고 다니네.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 30.120,
                "end": 38.908
            },
            {
                "speaker_id": "1",
                "transcription": "사람도 죽이고 사장, 사장인가 보다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 38.918,
                "end": 56.006
            },
            {
                "speaker_id": "1",
                "transcription": "으아 잔인해",
                "sound_type": [
                    2,
                    4
                ],
                "start": 56.016,
                "end": 57.702
            },
            {
                "speaker_id": "1",
                "transcription": "회사 그 대표인가 봐.",
                "sound_type": [
                    2
                ],
                "start": 57.712,
                "end": 60.040
            },
            {
                "speaker_id": "1",
                "transcription": "이쪽은 길이 아니고 무섭다 무서워.",
                "sound_type": [
                    2
                ],
                "start": 60.050,
                "end": 70.800
            }
        ]
    },
    "summary": "괴물이 된 게임 속 캐릭터가 회사 안을 휘젓고 다니며 그 회사 대표도 죽였다.",
