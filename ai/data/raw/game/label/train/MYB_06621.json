                ],
                "start": 0.000,
                "end": 2.648
            },
            {
                "speaker_id": "1",
                "transcription": "아줌마는 저택 안에서 주황 룬 운석 20개를 찾았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.658,
                "end": 5.785
            },
            {
                "speaker_id": "1",
                "transcription": "아 이번에 스킬 한번 해보라는 건가보다.",
