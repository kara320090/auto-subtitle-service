                    3
                ],
                "start": 9.438,
                "end": 15.123
            },
            {
                "speaker_id": "1",
                "transcription": "역시 기본 스킬을 강화해주는 게 좋지 않을까 이거는 제한 없이 쓸 수가 있잖아.",
                "sound_type": [
