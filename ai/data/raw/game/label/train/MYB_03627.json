        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱 플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.142
            },
            {
                "speaker_id": "1",
                "transcription": "윈되우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.152,
                "end": 6.503
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.513,
                "end": 10.255
            },
            {
                "speaker_id": "1",
                "transcription": "자 이게 보면은 1월 5일 업데이트 사전 안내 요렇게 나와있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.265,
                "end": 15.195
            },
            {
                "speaker_id": "1",
                "transcription": "자 에픽으로 출시되는 예언자 맛 쿠키 업데이트가 되고 예언자 맛 쿠키는 지원형으로 출시가 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.205,
                "end": 22.263
            },
            {
                "speaker_id": "1",
                "transcription": "네 후방이 오 후방이 되네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.273,
                "end": 24.588
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 웬만한 지원형이면 보통은 뭐 뭐 중앙에 배치되는 게 많긴 한데 이번에 후방에다가",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.598,
                "end": 32.000
            }
        ]
    },
    "summary": "예언자 맛 쿠키는 지원형인데 보통의 지원형은 중앙에 배치되는데 이번에는 후방에 배치가 된다고 화자가 말했다.",
