        "term": [
            {
                "speaker_id": "1",
                "transcription": "비도 추적추적 오고 철조망은 지가 알아서 넘어가고 까마귀가 있네요?",
                "sound_type": [
                    1,
                    2
                ],
                "start": 0.000,
                "end": 12.995
            },
            {
                "speaker_id": "1",
                "transcription": "으 더러워.",
                "sound_type": [
                    1,
                    2
                ],
                "start": 13.005,
                "end": 18.241
            },
            {
                "speaker_id": "1",
                "transcription": "자 돼지를 이용해서 뭐 하면 돼 여기?",
                "sound_type": [
                    1,
                    2,
                    5
                ],
                "start": 18.251,
                "end": 40.992
            },
            {
                "speaker_id": "1",
                "transcription": "사람들이 갇혀있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.002,
                "end": 42.470
            },
            {
                "speaker_id": "1",
                "transcription": "문을 열 수 없나 이걸?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.480,
                "end": 50.227
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 문을 열어서 밟고 올라가야 될 거 같은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.237,
                "end": 55.438
            },
            {
                "speaker_id": "1",
                "transcription": "어 무서워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.448,
                "end": 60.135
            },
            {
                "speaker_id": "1",
                "transcription": "안아줘요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.145,
                "end": 60.889
            },
            {
                "speaker_id": "1",
                "transcription": "저쪽에 갈 수가 없네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.899,
                "end": 64.197
            },
            {
                "speaker_id": "1",
                "transcription": "안에 애들인가 사람이 있는데 아 이걸 타고 올라가야 되나보다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.207,
                "end": 69.417
            },
            {
                "speaker_id": "1",
                "transcription": "돼지를 끌고 옵시다 좀 무섭지만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.427,
                "end": 71.577
            },
            {
                "speaker_id": "1",
                "transcription": "으 쒯.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.587,
                "end": 78.610
            },
            {
                "speaker_id": "1",
                "transcription": "으 징그러 그지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.620,
                "end": 84.625
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 이게?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.635,
                "end": 95.553
            },
            {
                "speaker_id": "1",
                "transcription": "어 난 줄타고 올라갈라 그랬는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.563,
                "end": 99.854
