        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아아 퓨 퓨바가 나오네 다크카카오 나오지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.047
            },
            {
                "speaker_id": "1",
                "transcription": "야아 시작부터 퓨바가 그래도 퓨바 좋아 음",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.057,
                "end": 10.532
            },
            {
                "speaker_id": "1",
                "transcription": "나쁘진 않아요 퓨바 이거 가지고 있으면",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.542,
                "end": 12.951
            },
            {
                "speaker_id": "1",
                "transcription": "스토리에서도 뭐 나쁘지 않게 스토리에서도 역시 지금은 잘 쓸 수 있기 때문에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.961,
                "end": 19.177
            },
            {
                "speaker_id": "1",
                "transcription": "언제나 통하기 마련이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.187,
                "end": 20.507
            },
            {
                "speaker_id": "1",
                "transcription": "아이 그쵸.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.517,
                "end": 21.218
            },
            {
                "speaker_id": "1",
                "transcription": "홀베보단 낫지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.228,
                "end": 22.785
            },
            {
                "speaker_id": "1",
                "transcription": "다행히 꽝보단 낫아 나아요 여러분들.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.795,
                "end": 25.546
            },
            {
                "speaker_id": "1",
                "transcription": "엄청난 확률을 피했어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.556,
                "end": 27.266
            },
            {
                "speaker_id": "1",
                "transcription": "3분의 1의 지뢰를 피해서 그래도 퓨어바닐라를 뽑았다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.276,
                "end": 31.258
            },
            {
                "speaker_id": "1",
                "transcription": "고거에 만족합시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.268,
                "end": 35.164
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 이어서 검볼 3성 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.174,
                "end": 40.000
            }
        ]
    },
    "summary": "남자는 다크카카오가 안 나오고 퓨바가 나온다며 그래도 퓨바 가지고 있으면 스토리에서도 지금은 잘 쓸 수 있기 때문에 나쁘진 않다고 하고 홀베, 꽝보단 낫고 3분의 1의 지뢰를 피해서 퓨바를 뽑았으니 그거에 만족하자며 이어서 검볼 3성 간다고 한다.",
