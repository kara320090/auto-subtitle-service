        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 지금 보시는 거와 같이 지금 뭐 영상 찍는 동안은 다 이겼죠?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.129
            },
            {
                "speaker_id": "1",
                "transcription": "승률이 소르베, 서리덱 제외하고는 거의 뭐 90 퍼센트 이상 95 퍼센트 이상 거의 웬만해서 다 이긴다고 보시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.139,
                "end": 15.071
            },
            {
                "speaker_id": "1",
                "transcription": "상당히 타이밍이 완벽하게 계산된 덱이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.081,
                "end": 19.079
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 상대 쿠키가 못 버티고 죽는 경우가 많거든요 터져서?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.089,
                "end": 23.757
            },
            {
                "speaker_id": "1",
                "transcription": "한순간에 상대방 피가 한번에 다 빠지는 경우가 많기 때문에",
                "sound_type": [
                    2,
                    3
