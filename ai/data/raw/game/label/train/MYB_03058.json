        "term": [
            {
                "speaker_id": "1",
                "transcription": "나는 진짜 이 고통에서 벗어나고 싶다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.789
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 이 계속 들어오는 이 한방 덱의 고통에서 벗어나고 싶다 하시는 분들은 네 요렇게 세팅해서 하는 것도 하나의 막는 방법이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.799,
                "end": 10.953
            },
            {
                "speaker_id": "1",
                "transcription": "반대로 난 한방 덱만 고수해서 쓰고 있는데 상대방이 가운데에 저처럼 가려서 웨어울프 약간 속임수 덱을 쓸 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.963,
                "end": 20.295
            },
            {
                "speaker_id": "1",
                "transcription": "하시는 분들은 원 탱에다 투 힐 덱을 쓰셔도 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.305,
                "end": 24.452
            },
            {
                "speaker_id": "1",
                "transcription": "그런 경우엔 웨어울프가 약하고 그다음에 예언자 덱한테도 약하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.462,
                "end": 28.862
            },
            {
                "speaker_id": "1",
                "transcription": "네 아레나 하는 데 도움이 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
