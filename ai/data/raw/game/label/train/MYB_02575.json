        "term": [
            {
                "speaker_id": "1",
                "transcription": "달빛이여 내 활이 되어주렴",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.108
            },
            {
                "speaker_id": "2",
                "transcription": "내가 앞서 가겠다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.118,
                "end": 5.614
            },
            {
                "speaker_id": "3",
                "transcription": "자 요런 식으로",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.624,
                "end": 7.979
            },
            {
                "speaker_id": "3",
                "transcription": "자 보면은 승리의 깃발에서 학교가 다른 유저를 이기면 깃발을 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.989,
                "end": 14.901
            },
            {
                "speaker_id": "3",
                "transcription": "한 가지 알아둬야 될 거는 그마 1부터는 소속 깃발이 가려집니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.911,
                "end": 19.275
            },
            {
                "speaker_id": "3",
                "transcription": "그리고 그 이상은 깃발 표시가 나와있기 때문에 학교가 같으면 들어가서 깃발 획득을 할 수가 없으니까 가급적이면은 다른 학교로 가서 깃발을 얻는 게 유리하다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.285,
                "end": 29.621
            },
            {
                "speaker_id": "3",
                "transcription": "그렇게 보시면 되고 그리고 이번에 아레나 패치 돼가지고 아레나 하고 싶은데 티켓 없다 하시면 여기 메달로 상점에서 살 수도 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.631,
                "end": 37.185
            },
            {
                "speaker_id": "3",
                "transcription": "자 그리고 다시 여기 와서 여러분들이 기여도를 보면 요렇게 보상을 얻을 수가 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.195,
                "end": 43.418
            },
            {
                "speaker_id": "3",
                "transcription": "그래서 안 하는 것보다는 무조건 해서 기여도 올리는 게 좋고 그 다음에 나중에 최종 학교 랭킹에 따른 보상도 있거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 43.428,
                "end": 51.309
            },
            {
                "speaker_id": "3",
                "transcription": "이렇게 3000 크리스탈 2000 크리스탈 1000크리스탈이랑 프로필까지 요렇게 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 51.319,
                "end": 56.900
            },
            {
                "speaker_id": "3",
                "transcription": "그 다음에 이제 아레나 깃발은 그런 식으로 획득하면 되고 여러분들 이제 횃불 모으기 경주 이거를 할 텐데 많이 하면은 여러분들 이거 얻어서 레벨 업 10레벨이 끝입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 56.910,
                "end": 68.845
            },
            {
                "speaker_id": "3",
                "transcription": "그래서 300체력을 얻을 수가 있어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 68.855,
                "end": 71.482
            },
            {
                "speaker_id": "3",
                "transcription": "쿠키는 아무거나 원하는 거로 하시면 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 71.492,
                "end": 74.380
            },
            {
                "speaker_id": "3",
                "transcription": "일단 찰스로 보여드리겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 74.390,
                "end": 76.167
            },
            {
                "speaker_id": "3",
                "transcription": "이거 어려워하는 분들 있을 건데 오븐브레이크랑 똑같거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 76.177,
                "end": 79.347
            },
            {
                "speaker_id": "3",
                "transcription": "혹시 보물 밀기도 하셨나요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 79.357,
                "end": 84.466
            }
        ]
    },
