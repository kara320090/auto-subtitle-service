        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 잠시만 내 느낌은 틀리지가 않았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.993
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 이거 쓰면 안 되고 네 요렇게 하고 가시고 세팅에 소르베 아 힐 힐러 없이 이걸 여태까지 이걸 뚫어 오셨다는 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.003,
                "end": 12.213
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이 험한 길을 어떻게 뚫어오신 거예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.223,
                "end": 14.818
            },
            {
                "speaker_id": "1",
                "transcription": "대단한 건데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.828,
                "end": 15.858
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 힐러 얘를 키워 주시면 됩니다. 알겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.868,
                "end": 18.847
            },
            {
                "speaker_id": "1",
                "transcription": "힐러 없이 이 머나먼 길을",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.857,
                "end": 20.989
            },
            {
                "speaker_id": "1",
                "transcription": "야 이걸로 뚝심 있게 하셨구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.999,
                "end": 23.730
            },
            {
                "speaker_id": "1",
                "transcription": "일단 제가 세팅을 다 해드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.740,
                "end": 26.027
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 저 뽑기를 먼저 해야 되는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.037,
                "end": 28.583
            }
        ]
    },
    "summary": "화자가 힐러 없이 뚝심 있게 여태까지 한 계정의 주인을 보고 대단하다면서 세팅을 다해주고 있다.",
