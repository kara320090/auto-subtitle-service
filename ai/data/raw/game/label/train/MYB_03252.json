    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 아몬드를 이용한 케이크 들개 공략입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.281
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 세팅은 자 얘는 9쿨이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.291,
                "end": 6.773
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 쿨만 엄청나게 높게 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.783,
                "end": 8.966
            },
            {
                "speaker_id": "1",
                "transcription": "다 필요 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.976,
                "end": 10.142
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 수치는 다 필요 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.152,
                "end": 11.186
            },
            {
                "speaker_id": "1",
                "transcription": "쿨만 높게 그다음에 흑당 같은 경우에는 쿨 4퍼센트 이상 쿨이 중요한 게 아니라 아몬드랑 어떻게 맞혀주느냐가 중요한데 너무 높으면 안 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.196,
                "end": 18.938
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 쿨은 4퍼센트 정도 그리고 올 라즈 당연히 공, 치 있으면 좋고 자 근데 어차피 공 치고 뭐고 간에 쫄이 다 나중에 죽어서 없어지거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.948,
                "end": 29.241
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 쿨 4퍼센트랑 공속 높게 캡틴캐비어는 올 쿨 부 옵션 없이 그냥 세트 효과 제외 15퍼센트 그리고 오징어먹물 올 라즈베리 쿨은 지금 8퍼센트 줬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.251,
                "end": 40.074
            },
            {
                "speaker_id": "1",
                "transcription": "아몬드 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.084,
                "end": 41.450
            },
            {
                "speaker_id": "1",
                "transcription": "24퍼센트 세트 효과 포함해서 24퍼센트에 맞춰 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.460,
                "end": 45.647
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 안 맞춰도 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.657,
                "end": 46.610
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 하나하나 그냥 흑당 게이지에 맞춰서 쓰면 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.610,
                "end": 50.456
            },
            {
                "speaker_id": "1",
                "transcription": "그것만 중요하게 보시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.460,
                "end": 52.333
            },
            {
                "speaker_id": "1",
                "transcription": "이 돌리는 것 중에 중요한 거는 치명타 확률도 좋고 치명타 피해 증가 필수고 공격력 증가된 거 함께 같이 쓰면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.343,
                "end": 60.512
            },
            {
                "speaker_id": "1",
                "transcription": "다른 옵션보다 그냥 치명타 피해 증가 75퍼센트 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.522,
                "end": 64.269
            },
            {
                "speaker_id": "1",
                "transcription": "그것만 가져가도 그냥 랭커가 돼 될 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.450,
                "end": 68.819
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 시간 잘 나왔는데 이거 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.820,
                "end": 71.053
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 하시면 안 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.063,
                "end": 72.117
            },
            {
                "speaker_id": "1",
                "transcription": "이거 그 밀키웨이 먼저 써요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.127,
                "end": 73.704
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 나머지 4개 다 눌러요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.714,
                "end": 74.963
            },
            {
                "speaker_id": "1",
                "transcription": "맨 처음에 자 밀키웨이를 자 밀키웨이를 먼저 누르고 자 나머지 다 눌러요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 74.973,
                "end": 81.544
            },
            {
                "speaker_id": "1",
                "transcription": "다 눌러주고 자 이 4개를 연타해 주면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.554,
                "end": 85.088
            },
            {
                "speaker_id": "1",
                "transcription": "이 4개 연타하고 얘는 누르지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.098,
                "end": 86.580
            },
            {
                "speaker_id": "1",
                "transcription": "이 흑당맛 쿠키 게이지 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.730,
                "end": 88.688
            },
            {
                "speaker_id": "1",
                "transcription": "변신 게이지인데 줄어들고 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.690,
                "end": 90.450
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 거의 다 없어질 때쯤 너무 일찍 누르지 말고 약간 없어질 때쯤 누르면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.460,
                "end": 95.777
            },
            {
                "speaker_id": "1",
                "transcription": "이거 마스터하시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.787,
                "end": 97.201
            },
            {
                "speaker_id": "1",
                "transcription": "자 보여 드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 97.211,
                "end": 98.578
            },
            {
                "speaker_id": "1",
                "transcription": "자 흑당 게이지가 없어질 때쯤 없어질 때쯤 지금이야 보셨죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.588,
                "end": 104.241
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 104.251,
                "end": 106.333
            }
        ]
    },
    "summary": "아몬드를 이용한 케이크 들개 공략은 세팅은 9쿨이고 흑당은 쿨 4퍼센트 이상 공속 높게 캡틴캐비어는 올 쿨 부옵션 없이 세트 효과 제외 15퍼센트 그리고 오징어먹물 올 라즈베리 쿨은 8퍼센트 줬고 아몬드는 세트 효과 포함해서 24퍼센트 맞춰 주고 밀키웨이를 먼저 쓴 후에 나머지 4개 다 눌러주고 4개를 연타해 주면 된다.",
