        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여기 숫자가 막 올라가죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.040
            },
            {
                "speaker_id": "1",
                "transcription": "대략적으로 13 넘었을 때 이렇게 눌러주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.365,
                "end": 4.287
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 눌러주시고 그 다음 빌드가 뭐냐 그냥 다 눌러주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.832,
                "end": 9.202
            },
            {
                "speaker_id": "1",
                "transcription": "다 눌러주시는데 다만 중간에 뱀파이어가 죽거나 이럴 때 그때 막 눌러주시지 마시고 항상 뱀파이어는 밀키웨이가 먼저 스킬이 들어가고 방깎 디버프가 13 이상이 올라갔을 때 뱀파를 눌러준다 이거 하나만 기억하시면은 나머지는 그냥 계속 다 눌러주시면 끝입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.550,
                "end": 26.695
            },
            {
                "speaker_id": "1",
                "transcription": "빌드가 딱히 딱총처럼 복잡하게 맞춰줘야 될 건 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.215,
                "end": 30.600
            },
            {
                "speaker_id": "1",
                "transcription": "보물을 눌러줘야 될 것도 없고 그냥 순서대로 쿨 오는 대로 뱀파이어는 밀키웨이 쓰고 쓰고 난 다음에 이어서 눌러준다 요 생각만 가지고 그냥 다 편하게 눌러주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.610,
                "end": 42.067
            },
            {
                "speaker_id": "1",
                "transcription": "되게 여유롭죠 초반에 네 요것만 눌러주시면은 초반 용은 되게 쉽고 가장 큰 장점이 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.410,
                "end": 48.392
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 이어하기 했을 때 딱총 때문에 막 방해받거나 엄청나게 막 스킬 막 수동으로 막 계산하고 할 필요가 전혀 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.652,
                "end": 56.512
            },
            {
                "speaker_id": "1",
                "transcription": "똑같이 이걸 반복해서 하시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.827,
                "end": 59.541
            }
        ]
    },
    "summary": "빌드는 보물을 눌러줘야 될 것도 없고 쿨 오는 대로 뱀파이어는 밀키웨이 쓰고 쓰고 난 다음에 이어서 눌러준다는 생각만 가지고 편하게 눌러주면 되기 때문에 초반에 여유롭고 가장 큰 장점은 이어하기를 했을 때 딱총 때문에 방해받거나 스킬을 수동으로 계산하고 할 필요가 전혀 없다는 것으로 복잡하게 맞출 것 없이 똑같이 반복하기만 하면 된다.",
