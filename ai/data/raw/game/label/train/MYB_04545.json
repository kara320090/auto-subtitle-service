    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 엉덩국님? 엉덩국님 계정 평가를 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.600
            },
            {
                "speaker_id": "1",
                "transcription": "자 이분 사연을 보게 되면은 저는 러너 님의 영상을 보게 되어 쿠키런 킹덤에 입문하게 되었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.620,
                "end": 11.186
            },
            {
                "speaker_id": "1",
                "transcription": "오늘이 딱 10일 차인데 소과금으로 플레이하고 총 50시간이나 할 정도로 쿠키런 킹텀에 빠져있는 뉴비입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.196,
                "end": 19.231
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 영상을 너무 많이 봐서 초보자가 어떻게 해야 하는지를 알게 되었는데 벌써 쿠키성 10렙으로 업그레이드했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.241,
                "end": 26.852
            },
            {
                "speaker_id": "1",
                "transcription": "해상 무역센터나 길드 토벌, 그리고 아레나에서 얻는 토큰들은 어디 써야 되는지 모르겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.862,
                "end": 33.164
            },
            {
                "speaker_id": "1",
                "transcription": "자신에게 맞는 길드 혹은 좋은 길드에 가입하는 방법이 궁금합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.174,
                "end": 37.111
            },
            {
                "speaker_id": "1",
                "transcription": "스토리 덱이나 아레나 덱 둘 다 한 덱으로 쓰고 있는데 어떤 쿠키를 꼭 얻어야 되는지 그리고 제게 맡는 스토리 덱과 아레나 덱이 궁금합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.121,
                "end": 45.240
            },
            {
                "speaker_id": "1",
                "transcription": "현재 마을 상황이 어떤지도 궁금합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.244,
                "end": 47.800
            },
            {
                "speaker_id": "1",
                "transcription": "수호의 성도 열렸는데 쿠키가 쿠키가 적은 뉴비는 어떻게 해야 되는지 궁금합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.800,
                "end": 52.593
            },
            {
                "speaker_id": "1",
                "transcription": "지금 서버는 다크 카카오 서버고 아레나 티어는 마스터 4까지 왔고 계정 레벨은 41레벨, 아 이렇게 되어있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.603,
                "end": 61.074
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 크리스탈도 어디다 써야되는지 알려주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.084,
                "end": 64.429
            },
            {
                "speaker_id": "1",
                "transcription": "완전 완전 뉴비분이시네요? 자 일단 쿠키성을 빠르게 올리는 거 잘했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.439,
                "end": 69.529
            },
            {
                "speaker_id": "1",
                "transcription": "10일 차인데 10레벨. 그리고 야 쿠키 하우스도 제가 말한 대로 다하고 있군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.539,
                "end": 75.551
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 하나도 안 열었어? 신전에 뭐 넣어야 될까요? 하시는데 저는 BTS 쿠키를 넣는 게 좋다고 생각하는데 지금 보니까 얘를 먼저 키우고 계시네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.561,
                "end": 84.515
            },
            {
                "speaker_id": "1",
                "transcription": "저 신전에 넣어야 될 쿠키 추천을 먼저 하고 가면은 다 케어된 애들.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.525,
                "end": 89.673
            },
            {
                "speaker_id": "1",
                "transcription": "캡틴 캐비어, 크림 유니콘, 목화 다 키워도 되는 애들있거든요? 아니면 휘낭시에도 키워야 되고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.683,
                "end": 94.852
            },
            {
                "speaker_id": "1",
                "transcription": "요런 애들 필수로 나오면은 별사탕 부족하면 쟤네 하시면 됩니다. 요 4개.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.862,
                "end": 100.110
            },
            {
                "speaker_id": "1",
                "transcription": "마탕 있는 쿠키들은 가급적이면 넣지 마세요. 어차피 마탕은 50레벨 직접 별사탕을 투자해야만 마탕이 활성화되기 때문에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.120,
                "end": 110.166
            }
        ]
    },
