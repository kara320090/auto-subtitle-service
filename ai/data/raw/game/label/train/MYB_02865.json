        "term": [
            {
                "speaker_id": "1",
                "transcription": "라즈베리요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 0.971
            },
            {
                "speaker_id": "1",
                "transcription": "아 그렇긴 하네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.981,
                "end": 2.313
            },
            {
                "speaker_id": "1",
                "transcription": "아 아니다. 얘 돌격해서 찌르는 거니까 뭐 돌격형이라 봐도 되지 않을까요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.323,
                "end": 7.288
            },
            {
                "speaker_id": "1",
                "transcription": "야 오먹이 좀 약간 미스네. 야 얘는 완벽하게 침투 아니냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.298,
                "end": 10.985
            },
            {
                "speaker_id": "1",
                "transcription": "아 얘가 왜 왜 마법이야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.995,
                "end": 12.806
            },
            {
                "speaker_id": "1",
                "transcription": "아 그렇죠. 와베도 살짝 솔직히 방어형보다는 돌격형 느낌이긴 한데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.816,
                "end": 17.966
            }
        ]
    },
    "summary": "화자는 오먹 캐릭터가 침투형 같은데 왜 마법형인지 의문을 가진다.",
