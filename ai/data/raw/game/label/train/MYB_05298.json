                    5
                ],
                "start": 0.000,
                "end": 4.382
            },
            {
                "speaker_id": "1",
                "transcription": "이게 좀 이번에 가장 색다른 거야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.392,
                "end": 6.506
            },
            {
                "speaker_id": "1",
                "transcription": "제가 생각하지 못했던 미니 게임 형식인데 빨간색이 이제 번개가 떨어지면 이제 피하는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.516,
                "end": 12.867
            },
            {
                "speaker_id": "1",
                "transcription": "이런 미니 게임 형식은 되게 색다르네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.877,
                "end": 15.437
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 신규 레전드 쿠키 얘 같은 경우에는 최초죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.447,
                "end": 19.033
            },
            {
                "speaker_id": "1",
                "transcription": "고대 레전드 통틀어서 침투형으로 최초로 나옵니다.",
                "sound_type": [
                    2,
