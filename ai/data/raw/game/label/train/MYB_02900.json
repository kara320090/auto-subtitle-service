        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 이게 조금 위험하긴 한데 나는 호밀 죽는 거 너무 스트레스 받는다 하시는 분들 그런 분들 좀 아슬아슬하지만 연습을 하시면 돼요. 6시 반이나 7시 사이 좀 더 가깝게 쓰시면은 호밀 좀 더 일찍 쓸 수 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 15.555
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이거 말하는 거는 비석 참사가 날 수 있는 여지가 있지만 그래도 얘는 호밀이 죽어도 어느 정도 여러분들이 어느 정도 매판 일정하게 연습만 된다면 숙련 되면은 매판 일정하게 잘 나올 수 있는 빌드긴 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.565,
                "end": 32.422
            },
            {
                "speaker_id": "1",
                "transcription": "자 마카롱하고 오먹 떨어지고 자 벚꽃 써주고요. 그 다음에 마카롱.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.432,
                "end": 37.825
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 중요한 게 자 이게 아까보다 좀 더 일찍 나갈 거예요 호밀이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.835,
                "end": 44.479
            },
            {
                "speaker_id": "1",
                "transcription": "아까보다 조금 더 일찍 썼기 때문에 자 여기서도 자동 꺼주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.489,
                "end": 48.765
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서는 아마 즉사기가 호밀로 갈 거예요. 아까보다 제가 좀 일찍 눌렀기 때문에.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.775,
                "end": 54.243
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이거 먼저 써 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.253,
                "end": 56.229
            },
            {
                "speaker_id": "1",
                "transcription": "보셨죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.239,
                "end": 57.581
            },
            {
                "speaker_id": "1",
                "transcription": "제가 가장 중요하게 말씀 드리고 싶은 거는 호밀맛 쿠키 아까 1자 비석 떨어 질 때 마카롱은 거기 몇 시에 맞추느냐에 따라서 이 즉사기 위치가 바뀌어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.591,
                "end": 67.592
            },
            {
                "speaker_id": "1",
                "transcription": "제가 해보니까 그래서 지금은 호밀이 100퍼센트 죽는 상황이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.602,
                "end": 71.439
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 지금 살짝 늦긴 했는데 미리 호밀을 연타해서 빨리 쏘게 만들어주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.449,
                "end": 79.900
            }
        ]
    },
