        "term": [
            {
                "speaker_id": "1",
                "transcription": "80번 스킨 뽑기하면 전설 스킬 확정권 줘요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.481
            },
            {
                "speaker_id": "1",
                "transcription": "아 그러네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.491,
                "end": 4.816
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.826,
                "end": 5.656
            },
            {
                "speaker_id": "1",
                "transcription": "나 여기서 멈췄어야 되네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.666,
                "end": 6.973
            },
            {
                "speaker_id": "1",
                "transcription": "큰일 날 뻔했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.983,
                "end": 7.851
            },
            {
                "speaker_id": "1",
                "transcription": "오 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.861,
                "end": 13.620
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 중복 주구장창 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.630,
                "end": 16.322
            },
            {
                "speaker_id": "1",
                "transcription": "아 이제 끝이었어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.332,
                "end": 23.806
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 야 나 나왔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.816,
                "end": 25.326
            },
            {
                "speaker_id": "1",
                "transcription": "나왔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.336,
                "end": 40.254
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키까지 야 근데 퀄리티 장난 아니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.264,
                "end": 43.913
            },
            {
                "speaker_id": "1",
                "transcription": "얘 만약에 상자 야 이거 나왔으면 무큐 만 개 주는데 만 개 뭐 이득이죠 뭐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.923,
                "end": 50.655
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 중복으로 다 있는데 뽑으면은 어떻게 될까까지 이번 영상에서 여러분들한테 전부 다 보여드렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.665,
                "end": 59.127
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 만약에 인연으로 스킨 인연으로 다 가지고 있으면 요렇게 예 보상으로 요렇게 다 되어있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.137,
                "end": 66.306
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스킨 인연을 가지고 있으면은 모든 쿠키의 이로운 효과가 증가가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.316,
                "end": 71.546
            },
            {
                "speaker_id": "1",
                "transcription": "모든 공격력도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.556,
                "end": 73.277
            },
            {
                "speaker_id": "1",
                "transcription": "이로운 효과 증가가 있으면 뭐가 좋냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.287,
                "end": 75.242
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이로운 효과 있으면은 에클레어 같은 경우엔 보호막 체력 보호막 증가 뿐만 아니라 힐 증가 그런 게 이득이 되기 때문에 무시 못합니다 저런 것도.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.252,
                "end": 86.124
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 이걸로 끝나는 게 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.134,
                "end": 87.867
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 봐야죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.877,
                "end": 89.325
            },
            {
                "speaker_id": "1",
                "transcription": "봐야지 스토리에서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.335,
                "end": 93.900
            }
        ]
    },
