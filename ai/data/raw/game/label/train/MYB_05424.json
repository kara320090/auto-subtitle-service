        "term": [
            {
                "speaker_id": "1",
                "transcription": "아포가토 만렙 찍으시고 다크도 뭐 토벌에서 무조건 쓰니까 네 호밀도 키우셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.767
            },
            {
                "speaker_id": "1",
                "transcription": "요거 먼저 키우셔야 되겠네요. 호밀",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.777,
                "end": 8.137
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에 키워야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.147,
                "end": 9.389
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 할라면 휘낭시에 필수야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.399,
                "end": 10.972
            },
            {
                "speaker_id": "1",
                "transcription": "호밀, 크림, 휘낭시에 이 세 개는 반드시 키워야 됩니다. 만렙까지",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.982,
                "end": 16.125
            },
            {
                "speaker_id": "1",
                "transcription": "벚꽃 토벌에서 0티어가 됐기 때문에 벚꽃도 키우셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.135,
                "end": 20.138
            },
            {
                "speaker_id": "1",
                "transcription": "아레나도 좀 볼게요. 아레나",
                "sound_type": [
                    2,
                    3,
                    5
                ],
