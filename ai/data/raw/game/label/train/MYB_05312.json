        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다크카카오가 생각보다 많네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.143
            },
            {
                "speaker_id": "1",
                "transcription": "야 딸기는 누구야?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.153,
                "end": 4.026
            },
            {
                "speaker_id": "1",
                "transcription": "딸기맛 쿠키를 피규어로 갖고 싶다구요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.036,
                "end": 6.594
            },
            {
                "speaker_id": "1",
                "transcription": "딸기맛 쿠키 원하시는 분 또 처음 보네?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.604,
                "end": 9.576
            },
            {
                "speaker_id": "1",
                "transcription": "아니 딸기를 원한다고?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.586,
                "end": 12.563
            },
            {
                "speaker_id": "1",
                "transcription": "나 이렇게 패키지만 주구장창 업데이트마다 과금 유도하지 말고 차라리 그냥 쿠키들 스킨이나 아니면 피규어나 이런 상품이나 더 팔았으면 좋겠어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.573,
                "end": 23.801
            },
            {
                "speaker_id": "1",
                "transcription": "내가 좋아하는 쿠키들 있잖아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.811,
                "end": 25.698
            },
            {
                "speaker_id": "1",
                "transcription": "그런 쿠키들한테 피규어 사가지고 뭔가 그런 게 더 좋지 개인적으로 저는 그래요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.708,
                "end": 33.867
            }
        ]
    },
    "summary": "남성은 패키지만 주구장창 업데이트마다 과금 유도하지 말고 차라리 쿠키들 스킨이나 피규어 같은 상품이나 더 팔았으면 좋겠다고 말한다.",
