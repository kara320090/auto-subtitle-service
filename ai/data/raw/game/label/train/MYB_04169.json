        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 지금 그래서 첫 번째 소르베맛 쿠키 두 번째 골드 치즈 세 번째 세인트 릴리 다음 업데이트에 뭐 고대나 이런 쿠키가 나온다는 거 알지만 첫 번째 확실한 거는 소르베맛 쿠키는 출시 확정이다 아직 등급은 확정되지 않았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.476
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째 골드 치즈랑 세인트 릴리가 지금 뭐가 나올지 모르겠지만 다음 둘 중에 하나가 출시됐는데 제 생각에는 광산 컨텐츠가 나오면서 골드를 치즈가 나올 수도 있고 아니면은 이 스킬 이펙트가 바뀐 세인트를 릴리가 가장 먼저 고대 쿠키로 둘 중에 하나가 먼저 나올 수도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.486,
                "end": 30.765
            },
            {
                "speaker_id": "1",
                "transcription": "지금 현재 이 이거와 관련된 영상입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.762,
                "end": 33.680
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 다음 업데이트 전에 여러분들이 꼭 알아두셔야 될 게 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.690,
                "end": 37.939
            },
            {
                "speaker_id": "1",
                "transcription": "뭐가 있냐면 자 현재 모르시는 분도 있으니까 말씀드리면 찰스 마카롱 쿠키 성장 이벤트가 진행중이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.949,
                "end": 44.463
            },
            {
                "speaker_id": "1",
                "transcription": "다음 업데이트는 정해졌어요 11월 30일날 저녁 7시에 아마 업데이트가 완료될 거거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.473,
                "end": 49.625
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트 날짜도 아예 정해졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.635,
                "end": 52.041
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 달성하면은 이렇게 뭐 승급에 따라서 여러분들 보상을 받을 수가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.051,
                "end": 56.978
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱맛 쿠키랑 찰스 쿠키 선택해서 여러분들 뽑으셔야 되고 제가 추천 드리는 거는 크리스탈이 별로 없다 하시는 분들은 찰스 3성까지 찍고 나머지는 마카롱에 좀 올인을 많이 하시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.988,
                "end": 67.325
            },
            {
                "speaker_id": "1",
                "transcription": "현재 토벌에서 대천사랑 감초에서 둘 다 다 마카롱맛 쿠키는 0티어로 쓰이고 정말 대체 불가능한 쿠키기 때문에 장기적으로 얘는 엄청나게 오래 쓰일 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.335,
                "end": 77.382
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 얘 얘 투자를 해서 키워도 전 전혀 손해가 없고 3성까지 키우라는 이유는 마법 쿠키커더 있죠 그다음에 별사탕이랑 오로라 기둥 뭐 이렇게 주는데 3성까지는 거의 뭐 손해보는 거는 거의 없기 때문에 어 여기까지 키우는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.392,
                "end": 95.966
            }
        ]
    },
    "summary": "다음 업데이트에 확실시 된 거는 소르베맛 쿠키는 출시 확정이지만 등급은 확정되지 않았다.",
