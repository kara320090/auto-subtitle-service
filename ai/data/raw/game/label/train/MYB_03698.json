                "start": 0.000,
                "end": 7.717
            },
            {
                "speaker_id": "1",
                "transcription": "예 아고 8600개나 있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.727,
                "end": 10.749
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 있더라 @아이디1 이거 판매하면 도대체 얼마나 줍니까?",
                "sound_type": [
