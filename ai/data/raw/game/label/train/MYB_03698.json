                    5
                ],
                "start": 10.759,
                "end": 14.568
            },
            {
                "speaker_id": "1",
                "transcription": "432만 5000코인을 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.578,
                "end": 17.662
            },
            {
                "speaker_id": "1",
                "transcription": "판매하면은 복구할 수 없습니다. 이 문구가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.672,
                "end": 20.924
            },
            {
                "speaker_id": "1",
                "transcription": "자 아무튼 이렇게 케이크 타워 아 드디어 이 끝에 정점에 올라왔습니다.",
                "sound_type": [
