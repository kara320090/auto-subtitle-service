        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝 글리터 맛 쿠키 2성 리뷰 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.508
            },
            {
                "speaker_id": "1",
                "transcription": "슈퍼 에픽 쿠키로 출신이 됐고 자 12초 쿠키로 자 시작 쿨타임은 2 점 8초일 때 3초로 시작한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.518,
                "end": 11.715
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑같은 경우에는 제가 올 애플 젤리 그 다음에 아몬드도 해봤고 라즈베리도 해봤는데 결론적으로 따지면은 호루라기를 받기 위해서 라즈베리를 사용하는 게 가장 좋았다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.725,
                "end": 24.422
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 스킬을 보게 되면은 자신에게 걸려 있는 디버프를 제거하고 자 노래 피해는 치명타 발동 시 대상의 피해감소를 일정량 무시 과전류를 건다 자 이 과전류는 상대방 체력 보호막을 무효로 만들고요 자 그리고 노래 피해의 치명타 횟수에 따라 모든 아군에게 치명타 피해감소 버프를 준다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.432,
                "end": 44.485
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 1회 노래 피해량은 공격력의 77퍼센트 샤이닝 락스피릿은 치명타 피해감소를 주는 버프다 자 전반적으로 샤이닝 글러터 맛 쿠키는 치명타 피해감소에 관한 버프를 준다 이렇게 보시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.495,
                "end": 60.106
            },
            {
                "speaker_id": "1",
                "transcription": "또 하나 체력보호막 무효를 준다는 포인트도 알고 계시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.116,
                "end": 66.014
            },
            {
                "speaker_id": "1",
                "transcription": "자 스토리에서 쓰실 때는 여러분들 무난하게 앞에 탱커에다가 중간에 딜러를 쓰기에는 무난하게 그냥 쓰기에 괜찮다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.024,
                "end": 74.063
            },
            {
                "speaker_id": "1",
                "transcription": "자 평타랑 스킬 딜 한번 보고 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.073,
                "end": 78.268
            },
            {
                "speaker_id": "1",
                "transcription": "자 평타 딜 같은 경우에는 마법형이기 때문에 아무래도 조금 더 다른 쿠키들보다 좀 세다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.278,
                "end": 85.094
            },
            {
                "speaker_id": "1",
                "transcription": "30만 20만 자 스킬 쓰게 되면 이런 식으로 네 노래를 부르면서 나간다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.104,
                "end": 93.333
            }
        ]
    },
    "summary": "샤이닝 글리터 맛 쿠키 리뷰이며 슈퍼 에픽 쿠키로 출신이 됐고 시작 쿨타임 소개와 토핑같은 경우 라즈베리를 사용하는 게 가장 좋았으며 스킬에 대한 소개와 평타랑 스킬 딜 쓰는 거를 보여준다.",
