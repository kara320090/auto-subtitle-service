        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 무난하게 테크 올리면서 열심히 하시는 거 같구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.600
            },
            {
                "speaker_id": "1",
                "transcription": "이 분 창고는 252칸",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.610,
                "end": 6.696
            },
            {
                "speaker_id": "1",
                "transcription": "아주 열심히 하는 게 눈에 보이는데요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.706,
                "end": 9.168
            },
            {
                "speaker_id": "1",
                "transcription": "한 번 볼까요? 랜드마크 뭐 안",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.178,
                "end": 11.584
            },
            {
                "speaker_id": "1",
                "transcription": "네 요것도 지어 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.594,
                "end": 13.329
            },
            {
                "speaker_id": "1",
                "transcription": "자 랜드마크도 전부 다 지었고 문제가 없어 보이는데 뭐가 문제일까나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.339,
                "end": 19.885
            },
            {
                "speaker_id": "1",
                "transcription": "일단 연구소부터 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.895,
                "end": 21.323
            },
            {
                "speaker_id": "1",
                "transcription": "아이구야 뭐 정석대로 다 되어 있는데요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.333,
                "end": 24.084
            },
            {
                "speaker_id": "1",
                "transcription": "재료 생산 가속 하나 더 올려주세요 최소.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.094,
                "end": 27.396
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 연구는 잘 돼있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.406,
                "end": 28.821
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키 연구 보자 아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.831,
                "end": 31.966
