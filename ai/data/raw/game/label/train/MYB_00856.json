        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현시점에서 마법 사탕 쿠키들 어디에 쓰는지 활용도와 그리고 어떤 쿠키를 먼저 키워야 되는지 알려 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.090
            },
            {
                "speaker_id": "1",
                "transcription": "자 모든 마법사탕 쿠키 중에 가장 먼저 키워야 될 1위는 오징어먹물맛 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.090,
                "end": 12.582
            },
            {
                "speaker_id": "1",
                "transcription": "자 오징어먹물맛 쿠키 같은 경우에는 수호 성전, 토벌전, 아레나 모든 컨텐츠에서 활용 되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.582,
                "end": 19.535
            },
            {
                "speaker_id": "1",
                "transcription": "자 수호 성전 같은 경우에는 타수 보호막이 많은 적들을 빠르게 타수 보호막을 벗겨내는 용도와 그리고 딜량도 상당히 좋기 때문에 오징어먹물이 빠지지 않고 항상 많이 쓰이고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.535,
                "end": 30.950
            },
            {
                "speaker_id": "1",
                "transcription": "자 길드 토벌전에서는 감초 보스한테 항상 고정 멤버로 사용이 되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.960,
                "end": 36.454
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 아레나에서는 한방덱의 구성 요소로 실론나이트 한방덱의 멤버로 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.464,
                "end": 43.030
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 2순위는 원래 파르페였는데 현재 아레나 메타상 파르페보다는 스냅 드래곤하고 락스타맛 쿠키가 더 활용이 많이 되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.030,
                "end": 52.468
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 파르페의 마탕이 엄청나게 중요한 가치가 현재 있는지 않고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.478,
                "end": 57.621
            },
            {
                "speaker_id": "1",
                "transcription": "오히려 더 여러분들이 우선으로 키워야 될 것은 슈크림맛 쿠키 마법 사탕이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.631,
                "end": 62.657
            },
            {
                "speaker_id": "1",
                "transcription": "아니 슈크림맛 쿠키는 어디다 쓰냐 자 슈크림맛 쿠키는 수호 성전에서 대체 불가능하게 0티어로 메인정석덱에서 필수로 사용되고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.667,
                "end": 71.865
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 수호 성전에서 쓰려면은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.865,
                "end": 74.366
            }
        ]
    },
    "summary": "마법 사탕 쿠키 중에 1순위로 수호 성전, 토벌전, 아레나 모든 컨텐츠에서 활용이 되는 오징어먹물맛 쿠키를 키워야 하고 2순위로는 슈크림맛 쿠키이다.",
