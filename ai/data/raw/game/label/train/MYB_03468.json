    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 해 주시고 랜드마크 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.821
            },
            {
                "speaker_id": "1",
                "transcription": "케이크 타워 안 지으셨네?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.831,
                "end": 4.100
            },
            {
                "speaker_id": "1",
                "transcription": "그 랜드마크는 반드시 필요한 것 중의 하나가 케이크 타워거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.090,
                "end": 9.270
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 쿠키의 체력을 다 높여 줘서 얘 반드시 필요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.270,
                "end": 13.730
            },
            {
                "speaker_id": "1",
                "transcription": "랜드마크 중에 필요 없는 거는 단 하나도 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.730,
                "end": 16.530
            },
            {
                "speaker_id": "1",
                "transcription": "웬만해서 싹 다 지어 주시면 되고 그리고 지금 별사탕 랜드마크가 보여서 말씀드리는데 지금 가뜩이나 코인하고 오로라 재료 여유 없을 때 얘네들을 10레벨 찍어 주는 건 진짜 완전 잘못된 거고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.530,
                "end": 29.590
            },
            {
                "speaker_id": "1",
                "transcription": "얘네들은 나중에 코인하고 오로라 재료가 넘쳐나고 좀 여유가 있을 때 따로 해 주시고 지금 우선순위는 건물들 테크 트리나 아니면은 이 랜드마크들 10레벨 찍는 거",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.590,
                "end": 39.610
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 공격력과 관련된 애들 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.610,
                "end": 41.970
            },
            {
                "speaker_id": "1",
                "transcription": "게네들 먼저 10레벨 다 찍어 줘야지 가급적이면 얘네는 먼저 올려 주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.970,
                "end": 47.000
            },
            {
                "speaker_id": "1",
                "transcription": "얘를 그냥 토핑 조각으로 보시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.000,
                "end": 49.090
            },
            {
                "speaker_id": "1",
                "transcription": "아 이건 무릇 그냥 토핑 조각이랑 연관 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.090,
                "end": 51.650
            },
            {
                "speaker_id": "1",
                "transcription": "토핑작이랑 연관 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.650,
                "end": 52.980
            },
            {
                "speaker_id": "1",
                "transcription": "고렇게 보시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.980,
                "end": 53.890
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 마찬가지 쿠키런 킹덤은 어차피 최후로의 콘텐츠가 토핑작 제일 잘 만든 사람이 스펙이 제일 좋아지는 거거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.890,
                "end": 61.280
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 신경 써서 레벨업 해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.280,
                "end": 63.320
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 얘는 다른 얘들보다 제일 심한 게 만랩 찍을 때 마지막 구에서 1십이 3 퍼센트나 증가해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.320,
                "end": 70.333
            }
        ]
    },
    "summary": "랜드마크는 다 필요하지만 그중에서 케이크 타워는 꼭 있어야 하고 공격력과 관련된 애들의 레벨을 먼저 올려 줘야 하며 토핑작을 제일 잘 만든 사람의 스펙이 좋은 거기 때문에 신경 써서 레벨업해 주시고 혼돈이 휘몰아치는 마왕성은 9레벨, 10레벨에서 3퍼센트씩 증가한다.",
