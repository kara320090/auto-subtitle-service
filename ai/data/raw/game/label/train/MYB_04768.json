    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그니까 제가 추천드리는 거는 구미호 키우세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.068
            },
            {
                "speaker_id": "1",
                "transcription": "용구덱 하면은 아주 날아다니겠네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.078,
                "end": 5.031
            },
            {
                "speaker_id": "1",
                "transcription": "아 이렇게 하지 마시고 진짜 그 날먹처럼 쓸 수가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.041,
                "end": 9.541
            },
            {
                "speaker_id": "1",
                "transcription": "지금 블랙펄 용구덱 제가 유튜브에 올려놨거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.551,
                "end": 12.582
            },
            {
                "speaker_id": "1",
                "transcription": "그거 세팅해서 용구덱으로 가세요 하나만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.592,
                "end": 15.979
            },
            {
                "speaker_id": "1",
                "transcription": "덱 그냥 하나만 제대로 그냥 세팅해서 가세요 토핑 분산시키지 말고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.989,
                "end": 19.495
            },
            {
                "speaker_id": "1",
                "transcription": "힐러는 크림 유니콘이랑 목화 맛 쿠키 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.505,
                "end": 23.465
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 제가 아까 대충 보기는 했지만 라즈를 되게 강화를 많이 하셨네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.475,
                "end": 28.113
            },
            {
                "speaker_id": "1",
                "transcription": "지금 토핑이 많이 없을 때는 이 강화할 때 이 부옵션 뜨는 거 있잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.123,
                "end": 32.299
            },
            {
                "speaker_id": "1",
                "transcription": "처음에 6강 했을 때 나오는 게 피, 쿨 위주로만 강화하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.309,
                "end": 36.596
            },
            {
                "speaker_id": "1",
                "transcription": "공격력이나 나머지 나온 거는 일단 강화 최대한 자제하고 무조건 피, 쿨만 일단 집중적으로 노려서 강화하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.606,
                "end": 43.935
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 피감이 1퍼센트까지는 내가 볼 때 강화 안 해도 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.945,
                "end": 48.179
            },
            {
                "speaker_id": "1",
                "transcription": "한 진짜 3퍼센트대까지는 토핑이 너무 없으면은 강화 9강까지 이렇게 가도 된다고는 생각하는데 이렇게 1퍼까지는 내가 봤을 때는 안 해도 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.189,
                "end": 58.118
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이 쿨 붙은 거 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.128,
                "end": 59.363
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거는 끝까지 강화하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.373,
                "end": 60.840
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 지금 내가 좀 안 좋게 보는 거는 이게 6강짜리 중에 쿨 붙은 거는 절대 분해하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.850,
                "end": 68.728
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 제가 생각할 때 토핑 조각.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.738,
                "end": 71.133
            }
        ]
    },
    "summary": "남성 화자가 구미호 키우기를 추천하고 하나만 제대로 세팅해서 용구덱으로 가라고 말하며 토핑이 없을 때는 어떻게 해야 하는지 설명해 준다.",
