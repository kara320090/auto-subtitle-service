        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 획득한 선택상자들이 창고에 이동했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.729
            },
            {
                "speaker_id": "1",
                "transcription": "창고에 오 이렇게 창고에 누르면 아 뭐야? 뭐야? 뭐야? 나 못 받아? 야 난 못 받아? 다 만렙이면 못 받아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.739,
                "end": 15.083
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 만렙 찍으면은 못 받습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.093,
                "end": 19.632
            },
            {
                "speaker_id": "1",
                "transcription": "네 이런 엔딩이 나오네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.642,
                "end": 22.646
            },
            {
                "speaker_id": "1",
                "transcription": "만랩을 찍으면은 이 상자는 아무 의미 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.656,
                "end": 27.710
            },
            {
                "speaker_id": "1",
                "transcription": "다른 거라도 주지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.720,
                "end": 30.313
            },
            {
                "speaker_id": "1",
                "transcription": "못 받는 걸로 엔딩 끝나겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.323,
                "end": 32.634
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 리뷰 마칠게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.644,
                "end": 35.000
            }
        ]
    },
    "summary": "획득한 선택상자들이 창고에 이동했지만 만렙을 찍으면 받을 수가 없어서 아무 의미가 없습니다.",
