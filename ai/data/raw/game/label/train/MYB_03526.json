        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그러고 홀리 베리 버프, 홀리 베리 버프는 스킬 시전시 돌진에 맞은 적을 기절시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.660
            },
            {
                "speaker_id": "1",
                "transcription": "기절시키는 내용이 원래 없었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.660,
                "end": 9.680
            },
            {
                "speaker_id": "1",
                "transcription": "새로 추가 된 능력이 있다는 건 기존의 @이름1가 안 쓰이던 쿠키가 드디어 상향이 된다는 점 뭐 밑에는 따로 바뀐 건 없고 아마 2주년 기념으로 아마 패치될 게 미리 적용되지 않았나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.680,
                "end": 23.300
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 적용된지 안 됐는지 제가 보여 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.300,
                "end": 26.540
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 퓨어 바닐라도 마찬가지 @이름2가 원래 뭐 능력이 따로 뭐 크게 없었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.540,
                "end": 31.430
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 체력 보호막 생긴다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.430,
                "end": 32.840
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 있었는데 일반 회복 대상에게 이로운 효과 증가 버프를 건다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.850,
                "end": 37.610
            },
            {
                "speaker_id": "1",
                "transcription": "어 원래 없었던 새로운 버프입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.610,
                "end": 40.380
            },
            {
                "speaker_id": "1",
                "transcription": "빛이 은은하고도 멀리 퍼져 나가며 아군 전체의 체력을 회복시키고 또 하나 부상 효과 감소시킨다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.380,
                "end": 46.310
            },
            {
                "speaker_id": "1",
                "transcription": "@이름3나 뭐 @이름4 같은 부상 효과를 주는 쿠키들의 효과를 감소시킨다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.310,
                "end": 52.190
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이것도 해당 체력 보호막이 해제되거나 면역될 경우 체력을 일정 시간 동안 회복하는 버프 부여한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.190,
                "end": 59.160
            },
            {
                "speaker_id": "1",
                "transcription": "@이름3같이 체력 보호막을 없애는 쿠키들이 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.160,
                "end": 63.150
            },
            {
                "speaker_id": "1",
                "transcription": "그런 거를 카운터가 됐을 때 어 이제는 보호막이 해제돼도 어 크게 뭐 손해 없을 수 있도록 그렇게 되는 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.150,
                "end": 74.500
            }
        ]
    },
    "summary": "홀리 베리 버프는 스킬 시전하면 돌진에 맞은 적을 기절시키고 퓨어 바닐라는 빛이 퍼져 나가며 아군의 체력을 회복시켜 주고 부상 효과를 주는 쿠키들의 능력을 감소시키며 체력 보호막이 해제될 때 일정 시간 동안 회복할 수 있는 버프가 부여된다.",
