        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "확실히 크림 유니콘의 힐량도 어마무시하고 아주 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.145
            },
            {
                "speaker_id": "1",
                "transcription": "힐량이 무슨 이야 이거 맞아?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.155,
                "end": 7.876
            },
            {
                "speaker_id": "1",
                "transcription": "야 힐량이 1000만이네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.886,
                "end": 9.338
            },
            {
                "speaker_id": "1",
                "transcription": "대세는 이제 크림 유니콘은 치명으로 이제 쏠리나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.348,
                "end": 14.106
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 식의 그림으로 나오는 1번 덱 리뷰를 일단 했고 이거 되게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.116,
                "end": 18.978
            },
            {
                "speaker_id": "1",
                "transcription": "제가 보면 일부러 좀 낮췄어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.988,
                "end": 20.439
            },
            {
                "speaker_id": "1",
                "transcription": "아 토핑 너무 극혐이다라고 생각하는 거를 일부러 제가 안 보여드리려고 일부러 조금 낮추게 했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.449,
                "end": 27.075
            },
            {
                "speaker_id": "1",
                "transcription": "물론 쿨이 높긴 한데 높을수록 좋은 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.085,
                "end": 29.508
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 여러분들이 뭐 굳이 꼭 이거 맞추라는 게 아니라 피감이 좀 여러분들이 낮더라도 그래도 쿨 타임 좀 높게 세팅을 요런 방향으로 하면은 나름 또 괜찮다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.518,
                "end": 38.296
            },
            {
                "speaker_id": "1",
                "transcription": "세팅을 좀 보여드렸습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.306,
                "end": 39.597
            },
            {
                "speaker_id": "1",
                "transcription": "물론 이렇게도 따라 하기 힘들 수도 있긴 하지만 가급적이면 이런 모양새 맞춰서 하시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.607,
                "end": 46.966
            }
        ]
    },
    "summary": "1번 덱은 크림 유니콘의 힐량이 상당히 좋으며 쿨 타임을 높게 세팅했는데 이런 모양새를 맞춰서 따라 하면 좋을 것 같다.",
