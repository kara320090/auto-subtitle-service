                ],
                "start": 3.599,
                "end": 6.265
            },
            {
                "speaker_id": "1",
                "transcription": "단골 손님이랑 같이 먹으려고 했는데 가게를 비울 수가 없어서 고민 중.",
                "sound_type": [
