                "end": 21.326
            },
            {
                "speaker_id": "1",
                "transcription": "아 부탁이 있는데 나 대신에 단골 손님들한테 얘기좀 해달래요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.336,
                "end": 29.822
            },
            {
                "speaker_id": "1",
                "transcription": "아 운반업자, 푸줏간, 경비병.",
