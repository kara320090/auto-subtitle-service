        "term": [
            {
                "speaker_id": "1",
                "transcription": "이기는 그림 보여줄 수 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.232
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 스타더스트 때려주고 자 1분 버텼죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.242,
                "end": 7.107
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 되면은 이기는 그림으로 갑니다 안정적으로.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.117,
                "end": 10.964
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우에는 쿨이 더 승률이 좋았는데 아몬드도 여러분들 본인의 조합에 맞춰서 해보시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.974,
                "end": 19.504
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 아몬드가 좋다 쿨이 좋다라기보다는 본인 토핑에 따라서 스펙에 따라서 다르니까 세팅을 해보시면 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.514,
                "end": 27.067
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 캡사 조합을 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.077,
                "end": 29.918
            },
            {
                "speaker_id": "1",
                "transcription": "자 캡사 조합도 저는 쿨로 이렇게 세팅해서 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.928,
                "end": 34.205
            },
            {
                "speaker_id": "1",
                "transcription": "자 캡사 같은 경우에 에 요렇게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.215,
                "end": 38.633
            }
        ]
    },
    "summary": "화자가 아몬드도 본인들의 조합에 맞춰서 해 보기를 바란다고 하며 캡사 조합도 보여준다.",
