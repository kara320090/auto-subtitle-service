        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이제 푸른주스 써주고 자 이렇게 됐을 때가 있을 거예요 분명히",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.177
            },
            {
                "speaker_id": "1",
                "transcription": "이럴 때는 도넛 다음에 도넛이랑 같이 누르지 말고 41초 보면 소르베 누르면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.177,
                "end": 10.752
            },
            {
                "speaker_id": "1",
                "transcription": "자 41초 봤죠? 41초 딱 됐을 때 미리 써줘요 그냥",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.752,
                "end": 15.475
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어는 죽을 거예요 피감이 약해서 어쩔 수 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.475,
                "end": 20.660
            },
            {
                "speaker_id": "1",
                "transcription": "우와 살았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.660,
                "end": 21.642
            },
            {
                "speaker_id": "1",
                "transcription": "살면 됐어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.642,
                "end": 22.812
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이제 도넛에 28초 자 이것도 써주고 자 여기서 중요한 게 도넛이랑 쟤 이제 때리기 전에 써야 되는데 분명히 조금 얘가 좀 더 도넛 생존하려면은 밀키가 쓰기 전에 좀 일찍 눌러주면 얘가 생존을 더 잘하긴 합니다.",
                "sound_type": [
