    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "가급적이면 다 해 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.480
            },
            {
                "speaker_id": "1",
                "transcription": "이 바닐라 연구소나 얘 크리스털 때문에 부담돼서 안 지었잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.480,
                "end": 5.240
            },
            {
                "speaker_id": "1",
                "transcription": "근데 게임 한두 달 하고 접을 거면은 얘 안 지어도 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.240,
                "end": 8.960
            },
            {
                "speaker_id": "1",
                "transcription": "안 접고 지금 1년 반 이상 하신 거잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.960,
                "end": 11.250
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 되면은 크탈을 일찍 건설하는 데 투자를 하면 그만큼 이득은 다 충분히 볼 수 있기 때문에 다 지으세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.250,
                "end": 19.150
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 마찬가지 다 지으세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.150,
                "end": 20.430
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 레벨은 다 만렙이겠지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.430,
                "end": 22.360
            },
            {
                "speaker_id": "1",
                "transcription": "13성이면은 랜드마크 레벨 다 만렙이어야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.360,
                "end": 25.500
            },
            {
                "speaker_id": "1",
                "transcription": "웬만해선 자 이제 그러면은 재고 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.500,
                "end": 28.410
            },
            {
                "speaker_id": "1",
                "transcription": "자 나무 팔백칠십 재고가 심각하네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.410,
                "end": 31.470
            },
            {
                "speaker_id": "1",
                "transcription": "이게 기본 기본 재료가 많이 안 쌓이는 분들은 이거를 주야장천 들어올 때마다 얘 2번째로 계속 생산하지 마시고 한 번 좀 날 잡아 가지고 집중적으로 1번째 거만 어 좀 많이 생산해 보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.470,
                "end": 44.560
            },
            {
                "speaker_id": "1",
                "transcription": "이거 각 잡고 한 30분만 쭉 해도 웬만큼 많이 잘 쌓이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.570,
                "end": 49.400
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 비스킷은 2번째가 더 잘 쌓입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.400,
                "end": 52.600
            },
            {
                "speaker_id": "1",
                "transcription": "얘도 2번째 것이 더 효율이 좋고 그다음에 네 열차가 멈추지 않을 정도 그 정도 유지하고 계시고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.600,
                "end": 58.925
            }
        ]
    },
    "summary": "크리스털을 일찍 건설하면 그만큼 이득을 볼 수 있으며 랜드마크의 레벨이 만렙이어야 되고 재고가 심각할 정도여서 30분 정도만 재료 생산을 집중적으로 해 보시면 좋을 것 같고 열차가 멈추지 않을 정도만 유지하시면 된다.",
