        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "크림슨코랄 쿠키 출시 이후 유행하는 아레나 조합이 크게 바뀌었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.903
            },
            {
                "speaker_id": "1",
                "transcription": "대유행하던 투탱 용과드래곤, 홀리베리 방어 조합이 줄어들고 크림슨코랄 중심으로 한 원탱 조합이 유행하게 되었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.913,
                "end": 11.067
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 세세하게 보자면 크림슨코랄은 후방 쿠키들을 보다 안전하게 보호해 주는 역할을 하기 때문에 스타더스트, 달빛술사, 블랙펄, 바다요정 등과 같은 광역 딜러들을 사용하여 3극딜 조합으로 많이 유행하였고 또는 크리슨코랄과 2개의 딜러와 2개의 힐러를 같이 쓰는 정석 덱도 대유행 중입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.077,
                "end": 29.178
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 홀리베리, 용과드래곤 쿠키가 나락간 건 전혀 아니고 공격 덱으로 잘 활용되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.188,
                "end": 34.658
            },
            {
                "speaker_id": "1",
                "transcription": "크림슨코랄이 워낙 사기적인 능력으로 출시되어 실론나이트 과전류 한방 덱을 제외한 기존의 모든 한방 덱들은 활용 가치가 완전히 떨어진 상태이고 이밖에 소환 덱, 빙결 덱, 공속 덱은 여전히 아레나에서 활용 가치가 없는 상태입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.668,
                "end": 48.075
            },
            {
                "speaker_id": "1",
                "transcription": "특히 1티어에는 클로티드크림 쿠키는 초보자분들한테 추천하지 않는 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.085,
                "end": 52.522
            },
            {
                "speaker_id": "1",
                "transcription": "일시적으로 크림슨코랄 저격 덱으로 급부상한 쿠키이지만 쿠키 자체가 상향된 게 아닌 특정 저격 덱으로 인해 티어가 오른 것뿐이라 초보자분들은 티어 자체만을 보고 키우지 마시고 이미 키우신 분들이나 별사탕 여유가 넘치는 분들에 한해서 화면에 보이는 썸넬 조합을 보고 따라 해 보시는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.532,
                "end": 71.159
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 유행하는 조합 기준으로 가장 좋은 0티어부터 6티어까지 정리해 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.169,
                "end": 78.233
            }
        ]
    },
    "summary": "남성이 크림슨코랄 쿠키 출시 이후 유행하는 아레나 조합을 설명하며 이걸 기준으로 가장 좋은 0티어부터 6티어까지 정리해 본다고 한다.",
