        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 잡을 수 있을까요?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 0.000,
                "end": 5.003
            },
            {
                "speaker_id": "1",
                "transcription": "시간이 좀 부족하네?",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 5.013,
                "end": 10.001
            },
            {
                "speaker_id": "1",
                "transcription": "야 시간이 부족한데 이렇게 딜을 넣을 수가 있네요.",
                "sound_type": [
                    2,
                    3,
                    4
                ],
                "start": 10.011,
                "end": 14.022
            },
            {
                "speaker_id": "1",
                "transcription": "골고루 딜이 다 들어갔네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.032,
                "end": 15.720
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 일단은 쓰이고 있네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.730,
                "end": 17.897
            },
            {
                "speaker_id": "1",
                "transcription": "일단 여러분들 1단계 상태라 아직 조합이 많이 나오지 않은 상태예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.907,
                "end": 24.001
            },
            {
                "speaker_id": "1",
                "transcription": "정리하자면 옛날에 쓰던 목화 덱 제 유튜브에 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.011,
                "end": 27.235
            },
            {
                "speaker_id": "1",
                "transcription": "목화 덱이 다시 돌아왔다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.245,
                "end": 28.829
            },
            {
                "speaker_id": "1",
                "transcription": "운명의 대천사는 아까 말씀드린 요 덱으로 가시면 될 거 같고 요 1단계에서는 또 여기서는 요 덱 각각 분류해서 가면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.839,
                "end": 39.724
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 토벌 리뷰는 여기서 마치고 각각 세분화돼서 빌드가 나오면 제가 예 연구해서 어 올리도록 할게요 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.734,
                "end": 52.700
            }
        ]
    },
    "summary": "20대 남성이 보스를 잡기에는 시간이 부족했지만 딜이 골고루 들어가며 세분화된 빌드가 나오면 연구를 해서 영상을 올리겠다고 말한다.",
