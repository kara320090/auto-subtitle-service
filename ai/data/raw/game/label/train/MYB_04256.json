            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "부계정 키우기 오늘 5일차입니다 드디어 제가 또 조금은 좀 키워놨거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.876
            },
            {
                "speaker_id": "1",
                "transcription": "많이 키워놓은 건 아니고 건물이나 고기 젤리 손해 없게끔 살짝 좀 해놨는데 역시나 뭐 오래 좀 제가 해왔던 부분이라 빠르게 빠르게 성장할 수가 있 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.886,
                "end": 19.305
            },
            {
                "speaker_id": "1",
                "transcription": "시간 투자를 그렇게 많이 안 해도 성장을 쭉쭉 할 수 있고 지금 보면 아시겠지만 소다 지도를 열 수 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.315,
                "end": 25.705
            },
            {
                "speaker_id": "1",
                "transcription": "근데 소다 제도를 열기 위해서는 어 납품 퀘스트가 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.715,
                "end": 29.209
            },
            {
                "speaker_id": "1",
                "transcription": "톱을 5개 갔다주기인가 미션이 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.219,
                "end": 32.374
            },
            {
                "speaker_id": "1",
                "transcription": "일단 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.384,
                "end": 33.430
            },
            {
                "speaker_id": "1",
                "transcription": "우유가 열렸는데 우유 같은 경우에는 그냥 과감하게 해 투자를 500개 바로 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.440,
                "end": 39.864
            },
            {
                "speaker_id": "1",
                "transcription": "우유 지옥이 시작되면은 감당이 안 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.874,
                "end": 42.814
            },
            {
                "speaker_id": "1",
                "transcription": "대기열에 투자를 많이 해놓으면 진짜 스트레스가 해소가 많이 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.824,
                "end": 47.500
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 해주고 일단 소원나무도 미리 다 해놨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.500,
                "end": 50.452
            },
            {
                "speaker_id": "1",
                "transcription": "밀키 우유 가공소로 이제 건설해야 되는데 저거 건설하려면 이제 생산 단계를 좀 높여줘야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.462,
                "end": 56.810
            },
            {
                "speaker_id": "1",
                "transcription": "이제 요거 올려줘야 되는데 아 또 이게 발목을 잡네 쿠키성은 이제 밀키 우유 가공소만 건설 하면은 바로 올릴 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.820,
                "end": 65.621
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 고기 젤리 남는 거로 쭉 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.631,
                "end": 71.433
            }
        ]
    },
