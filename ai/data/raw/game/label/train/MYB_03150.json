                    5
                ],
                "start": 5.430,
                "end": 6.870
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 제가 여기서 얼마만큼 채울지는 모르겠지만 한번 채워봅시다.",
                "sound_type": [
