    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 실론나이트 마법 사탕 업데이트 이후에 어 한방덱에서 엄청나게 잘 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.322
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 어 정석덱에서도 같이 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.332,
                "end": 9.283
            },
            {
                "speaker_id": "1",
                "transcription": "어 오늘 소개해드릴 이 조합은 목성님이 만든 조합이고 이렇게 깃털, 호루라기, 시계 보물을 사용하는 조합입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.293,
                "end": 17.661
            },
            {
                "speaker_id": "1",
                "transcription": "자 호루라기 같은 경우에는 스타더스트랑 소르베가 받으면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.671,
                "end": 21.674
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트가 없는 분들은 서리여왕으로 대체가 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.684,
                "end": 26.456
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑 같은 경우에는 실론나이트는 쿨 높게 그리고 피해 감소 높게 세팅해 주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.466,
                "end": 32.230
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리 같은 경우에는 쿨 23퍼센트 이상 피감은 여러분들 능력껏 높게 소르베도 쿨 여러분들 능력껏 피쿨 높게 세팅을 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.240,
                "end": 43.159
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 스타더스트는 피쿨 높게 뭐 여유되면 치명타 높게 스냅 드래곤도 어 여러분들 능력껏 피, 쿨, 공 요렇게 신경써서 세팅을 해주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.169,
                "end": 53.648
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱은 확실히 엄청난 장점을 가지고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.658,
                "end": 57.030
            },
            {
                "speaker_id": "1",
                "transcription": "상대방 이렇게 2, 1, 2 덱한테는 승를이 거의 100퍼센트 가까운 승률이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.040,
                "end": 62.779
            },
            {
                "speaker_id": "1",
                "transcription": "제가 방덱으로도 한번 테스트를 해봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.789,
                "end": 65.404
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 하면은 어떤 결과가 나오냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.414,
                "end": 67.374
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 확실히 방덱으로 세팅을 해 놓으면 한방덱은 잘 막습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.384,
                "end": 72.770
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 요 방덱 해 놓으면은 한방덱으로 고통 받을 일은 거의 없을 거고 대신에 약점이 어 확실히 보이는 덱이 어떤 게 있냐면 자 일단 보면은 이 허브덱한테는 뚫리는 게 보여요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.780,
                "end": 86.892
            },
            {
                "speaker_id": "1",
                "transcription": "소르베 이 허브덱한테 뚫린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.902,
                "end": 90.521
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 똑같이 상대방이 요런식으로 돼 있고 실론덱 방덱으로 보인다 하면은 요 덱으로 맞춰서 들어가면은 될 거 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.531,
                "end": 99.393
            },
            {
                "speaker_id": "1",
                "transcription": "또 하나 3탱덱한테도 약하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.403,
                "end": 101.981
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 상대방 분이 요 덱으로 방덱이 돼 있는 거 같다 하시면 이 이 3탱덱이나 이 허브덱으로 세팅해서 저격으로 들어가도 좋겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.991,
                "end": 111.200
            }
        ]
    },
    "summary": "오늘 소개해드릴 이 조합은 목성님 만든 조합이고 깃털, 호루라기, 시계 보물을 사용하는 조합으로 어떻게 세팅하는 지 알려드리고자 한다.",
