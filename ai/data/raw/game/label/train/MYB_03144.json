                    5
                ],
                "start": 0.000,
                "end": 4.840
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 도트딜이 없으니까 에클레어를 넣어도 딜이 엄청 잘 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.840,
                "end": 9.720
            },
            {
                "speaker_id": "1",
                "transcription": "제가 이미 이거는 테스트해 봤는데 이것도 에클레어 같은 경우에도 여러분들이 요거 애플 젤리로 하면 되고 쿨 5퍼센트에 5퍼센트 맞춰 주시면 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.720,
                "end": 18.840
            },
            {
                "speaker_id": "1",
                "transcription": "어 이렇게 해서 이것도 빌드를 어 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.840,
                "end": 23.340
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 한번 가볼게요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.340,
                "end": 25.710
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이것도 마찬가지로 오먹 넣어주고",
                "sound_type": [
