                ],
                "start": 0.000,
                "end": 1.466
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 난이도가 전 보다는 쉬워졌다고 하는데 확실히 해 본 사람은 느낄 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.476,
                "end": 7.306
            },
            {
                "speaker_id": "1",
                "transcription": "쉽지 않다는 걸.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.316,
                "end": 8.772
            },
            {
                "speaker_id": "1",
                "transcription": "근데 되게 웃긴 게 깬 사람이 없는 건 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.782,
                "end": 12.575
            },
            {
                "speaker_id": "1",
                "transcription": "있어요.",
