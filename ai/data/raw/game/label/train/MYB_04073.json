                    2,
                    3
                ],
                "start": 12.585,
                "end": 13.362
            },
            {
                "speaker_id": "1",
                "transcription": "인증돼서 올라온 글이 있고 실제로 기프트 카드 받아간 사람이 있습니다.",
                "sound_type": [
