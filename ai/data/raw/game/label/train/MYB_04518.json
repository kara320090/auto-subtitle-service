        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 재고가 뭐야 심폰 케이크도 350개 케이크도 360개 약간 재고 모으는 걸 좋아하시는구나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.128
            },
            {
                "speaker_id": "1",
                "transcription": "다른 분들 이거 여기서 제가 설명 드리면은 랭커분들이 빛의 조각을 만드는 이유는 나머지는 너무 효율이 나빠가지고 빛의 조각을 하는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.138,
                "end": 18.380
            },
            {
                "speaker_id": "1",
                "transcription": "다음 이제 만약에 확장을 대비해서 빛의 조각을 생산하는 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.390,
                "end": 22.334
            },
            {
                "speaker_id": "1",
                "transcription": "다른 분들은 절대 따라하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.344,
                "end": 23.924
            },
            {
                "speaker_id": "1",
                "transcription": "무과금, 소과금분들이나 아직 마탕 재료 만렙 아닌 분들은 어 뱀파이어나 필수로 해 야되는 거 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.934,
                "end": 30.212
            },
            {
                "speaker_id": "1",
                "transcription": "오멍 그다음에 에스프레소나 자색 고구마나 포도맛 쿠키 맛탕 이거 제작을 이걸 해야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.212,
                "end": 37.020
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 당연히 연구소 같은 경우에는 옛날 옛적에 다 만렙을 찍으셨을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.030,
                "end": 41.444
            },
            {
                "speaker_id": "1",
                "transcription": "자 연구소 전부 다 풀만렙 쿠키 연구도 그냥 깔끔하게 싹 다 만렙입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.454,
                "end": 48.124
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 필요 없는 거 안 찍고 이런 거 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.134,
                "end": 50.594
            },
            {
                "speaker_id": "1",
                "transcription": "규다음에 랜드마크도 뭐 보나마다 다 만렙이겠지만 그리고 제일 중요한거는 케이크 타워가 제일 중요하겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.604,
                "end": 57.636
            },
            {
                "speaker_id": "1",
                "transcription": "자 만렙입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.646,
                "end": 58.929
            },
            {
                "speaker_id": "1",
                "transcription": "전부 다 50 뭐 이벤트 같은 경우에도 다 찍어 놓으셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.939,
                "end": 63.624
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 레벨은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.634,
                "end": 64.900
            }
        ]
    },
    "summary": "화자가 전부 다 만렙이라고 이야기하고 있다.",
