        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 달빛이 못 버텨",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.046
            },
            {
                "speaker_id": "1",
                "transcription": "그래 저게 문제예요. 라즈 써도",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.056,
                "end": 4.594
            },
            {
                "speaker_id": "2",
                "transcription": "물러설 수 없어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.604,
                "end": 5.570
            },
            {
                "speaker_id": "3",
                "transcription": "달빛이여 내 활이 되어주렴",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.580,
                "end": 8.795
            },
            {
                "speaker_id": "4",
                "transcription": "불타는 매운 맛을 봐라",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.805,
                "end": 11.735
            },
            {
                "speaker_id": "1",
                "transcription": "문제가 뭔지 알겠죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.745,
                "end": 13.452
            },
            {
                "speaker_id": "1",
                "transcription": "라즈 쓰던 뭐로서 쓰던 못 버텨",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.462,
                "end": 16.018
            },
            {
                "speaker_id": "1",
                "transcription": "얘로서 빼고 호밀로 하라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.028,
                "end": 18.204
            },
            {
                "speaker_id": "1",
                "transcription": "이거 호밀 넣어도 얘 라즈로 못하는데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.214,
                "end": 20.175
            },
            {
                "speaker_id": "1",
                "transcription": "아 지금 메타에서는 뒤에가 못 버텨요.",
