    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현재 아레나에서 좋은 샤벳 공속 덱 리뷰해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.809
            },
            {
                "speaker_id": "1",
                "transcription": "일단 세팅 자체는 쿨, 피, 피, 쿨, 쿨이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.819,
                "end": 8.465
            },
            {
                "speaker_id": "1",
                "transcription": "자 휘낭시에는 쿨로 세팅해 주시고 요렇게 피강 높게 해서 쿨타임은 휘낭시에 자체가 얘가 15초 쿠키기 때문에 22.3퍼센트 이상 저는 맞춰 줬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.475,
                "end": 19.665
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임 세트 효과에서 22.3 이상 해 주시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.675,
                "end": 22.664
            },
            {
                "speaker_id": "1",
                "transcription": "지금 저는 23.3인데 22.3으로 세팅을 해 주시면 될 거 같고 흑당 같은 경우에는 아몬드 공속 망토가 받게끔 전에도 말씀 드렸지만 공속 망토 흑당 쓸 때는 5.3퍼센트 이상 공속을 맞춰 주게 되면은 스킬이 8발에서 9발로 1발 더 쏘게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.674,
                "end": 39.520
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어 같은 경우에도 피감 그다음에 쿨 높게 쿨은 높으면 높을수록 좋은 거 같아요 제가 볼 때는.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.530,
                "end": 45.508
            },
            {
                "speaker_id": "1",
                "transcription": "가끔 가다가 이 덱 따라할 때 에클레어 쿨 아예 없이 쿨 되게 너무 낮게 해서 하시는 분도 있는데 그러면은 승률이 떨어질 수 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.518,
                "end": 53.832
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어는 확실히 빨리 써야 피해 증가를 걸고 아군의 이제 공격이 들어가서 상대를 죽일 수 있는 피해량이 증가되기 때문에 쿨 높게 좀 세팅해 주시고 피해 감소도 신경 써 주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.842,
                "end": 64.421
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳 상어는 올 쿨입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.431,
                "end": 66.302
            },
            {
                "speaker_id": "1",
                "transcription": "부옵션 안 넣고 피해 감소랑 공치 좀 높으면 좋을 거 같고 그냥 공치 없어도 그냥 쿨 샤벳 해서 하시면 되는데 이 올 쿨 해서 잘 죽냐 잘 안 죽습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.312,
                "end": 75.834
            },
            {
                "speaker_id": "1",
                "transcription": "상대 에스프레소가 공격 들어올 때 얘가 스킬 발동으로 뒤에 오는 걸 피하거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.844,
                "end": 80.619
            },
            {
                "speaker_id": "1",
                "transcription": "고런 원리로 올 쿨로도 안 죽고 저 같은 경우에는 휘낭시에 이 보호막 버프 요거 있죠? 요 버프를 샤벳 상어가 받습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.629,
                "end": 88.490
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 크림 유니콘은 올 쿨로 이렇게 세팅해서 공속 버프는 크림 유니콘이랑 흑당한테 받고 휘낭시에 버프는 샤벳 상어가 받도록 요렇게 세팅해서 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.500,
                "end": 100.800
            }
        ]
    },
    "summary": "화자는 휘낭시에는 쿨로 피강을 높게 했고 흑당은 스킬이 1발 더 늘어날 수 있게 공속을 5.3퍼센트 이상으로 맞추고 에클레어는 피감과 쿨을 높게, 샤벳 상어는 올 쿨로만 설정해도 잘 안죽기 때문에 올 쿨, 크림 유니콘도 올 쿨로 설정했고 공속 버프는 크림 유니콘과 흑당한테 받고 휘낭시에 버프는 사벳 상어가 받도록 세팅했다고 아레나에서 좋은 샤벳 공속 덱을 리뷰한다.",
