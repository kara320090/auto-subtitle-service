        "term": [
            {
                "speaker_id": "1",
                "transcription": "러너 님 민초 호불 호예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.959
            },
            {
                "speaker_id": "1",
                "transcription": "불이에요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.969,
                "end": 2.762
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 딱 가운데 중간입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.772,
                "end": 4.696
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 민초가 좋아서 뭐 찾아 먹고 그러진 않고 또 싫어서 안 먹는 것도 아니고 있으면 먹고 없으면 안 먹는 아 나는 내가 생각나는 건 저 고등학교 때 학교에 그게 있었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.706,
                "end": 15.436
            },
            {
                "speaker_id": "1",
                "transcription": "라면 자판기 그 요새도 다 있나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.446,
                "end": 17.964
            },
            {
                "speaker_id": "1",
                "transcription": "딱 급식 메뉴를 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.974,
                "end": 19.582
            },
            {
                "speaker_id": "1",
                "transcription": "딱 봐도 내가 맛없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.592,
                "end": 21.190
            },
            {
                "speaker_id": "1",
                "transcription": "라면 자판기 가서 그냥 라면 먹었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.200,
                "end": 23.454
            },
            {
                "speaker_id": "1",
                "transcription": "점심 때 라면 자판기 그거 없나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.464,
                "end": 26.219
            },
            {
                "speaker_id": "1",
                "transcription": "아 요새 매점도 사라졌어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.229,
                "end": 28.774
            },
            {
                "speaker_id": "1",
                "transcription": "아니 학교에 근데 매점이 왜 없어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.784,
                "end": 30.841
            },
            {
                "speaker_id": "1",
                "transcription": "오우 야 커터 색깔 너무 이쁘다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.851,
                "end": 34.466
            }
        ]
    },
    "summary": "화자가 민초는 중간이라며 고등학교 때 학교에 라면 자판기가 있어 급식 메뉴가 맛 없을 때 라면을 먹었다고 한다.",
