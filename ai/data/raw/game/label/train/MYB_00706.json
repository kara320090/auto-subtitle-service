        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 정리하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.362
            },
            {
                "speaker_id": "1",
                "transcription": "자 프릴해파리 조합 같은 경우에는 쿨이랑 라즈 2가지가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.372,
                "end": 5.635
            },
            {
                "speaker_id": "1",
                "transcription": "자 미러전 같은 경우에는 라즈해서 일찍 죽는 경우 또는 여 여러분들이 프릴해파리가 계속 한 방에 죽는 경우에는 라즈베리 세팅에서 힐러로 쓸 수도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.645,
                "end": 15.925
            },
            {
                "speaker_id": "1",
                "transcription": "어 그렇지 않는 경우에는 웬만해서는 쿨 세팅에서 피감 높게 쿨 높게 세팅해서 쓰는 게 더 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.935,
                "end": 22.531
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이렇게 세팅했을 때는 블랙펄은 고정으로 쓰고 리더 효과는 블랙펄을 리더 효과 딜러 자리에는 가장 좋은 거는 바다요정 쓰는 조건은 잼스톤 20강 초월 3초월 이상 그렇게 되는 분들만 쓰는 게 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.541,
                "end": 37.554
            },
            {
                "speaker_id": "1",
                "transcription": "그렇지 않으면 스타더스트가 가장 좋고 스타더스트라도 못 쓰는 분들은 달빛술사라도 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.564,
                "end": 43.434
            },
            {
                "speaker_id": "1",
                "transcription": "자 상성 정리 1번 극딜 덱은 2번 해파리 조합한테 약하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.444,
                "end": 48.402
            },
            {
                "speaker_id": "1",
                "transcription": "2번 해파리 조합은 박하 조합한테 약하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.412,
                "end": 51.353
            },
            {
                "speaker_id": "1",
                "transcription": "박하 조합은 다시 클로티드나 용과 덱한테 약하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.363,
                "end": 56.103
            },
            {
                "speaker_id": "1",
                "transcription": "용과 덱들은 다시 이 극딜들한테 약하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.113,
                "end": 59.932
            },
            {
                "speaker_id": "1",
                "transcription": "예 상성은 이렇게 물고 물리는 관계가 형성되어 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.942,
                "end": 64.429
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나 조합 관련돼서 궁금한 점이 있다면 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.439,
                "end": 69.034
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
