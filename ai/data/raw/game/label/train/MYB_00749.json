        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현재 많이 쓰는 쿠키들 위주로 토핑 추천을 해드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.522
            },
            {
                "speaker_id": "1",
                "transcription": "제가 언급하지 않은 쿠키들 토핑이 궁금하면 댓글에 물어봐 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.532,
                "end": 9.087
            },
            {
                "speaker_id": "1",
                "transcription": "자 가장 먼저 홀리베리 쿠키 자 홀리베리 쿠키는 올쿨토핑을 추천드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.097,
                "end": 13.927
            },
            {
                "speaker_id": "1",
                "transcription": "때에 따라서 올 아몬드를 쓰는 경우도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.947,
                "end": 17.430
            },
            {
                "speaker_id": "1",
                "transcription": "자 초보자 분들 피해 감소가 너무 낮으면 일찍 죽기 때문에 올쿨토핑을 추천하지만 피해 감소가 너무 낮다면 아몬드 토핑을 섞어서 사용하시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.447,
                "end": 28.062
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임은 일반적으로 가장 좋은 건 22퍼센트 이상 추천드리지만 쿨타임보다도 피해 감소를 우선으로 더 신경 써서 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.070,
                "end": 38.519
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라 쿠키는 현재 아레나에서 많이 쓰지는 않지만 스토리 모드에서 쓸 때는 올쿨토핑을 쓰시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.529,
                "end": 45.796
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소가 너무 낮으면 죽을 수도 있으니까 적당히 피해 감소 스토리 모드에서는 10에서 20퍼센트 사이만 돼도 어느 정도 생존이 가능하고 여유가 있으면 쿨타임 부옵션, 공격력, 치명타 확률, 공격 속도가 빠르면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.806,
                "end": 61.642
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과 드래곤 너무나 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.652,
                "end": 63.709
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 브레스 타이밍에 맞게끔 쿨타임 설정을 해주셔야 되는데 가장 먼저 신경 써야 할 건 피해 감소입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.719,
                "end": 71.116
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소 이렇게 극단적으로 높게 세팅을 하라는 게 아니라 어느 정도 20퍼센트는 넘겨 주셔야 되고 요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.126,
                "end": 78.114
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임은 1분 타이밍에 맞춰서 브레스가 나가야 되는데 너무 쿨을 높여 주면은 1분 전에 브레스를 일찍 쓰게 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.124,
                "end": 86.402
            },
            {
                "speaker_id": "1",
                "transcription": "너무 낮게 하면 상대 용과보다도 브레스 타임이 늦어져서 아군의 딜러가 먼저 전멸 당하는 상황이 나오기 때문에 여러분들이 직접 아레나에서 돌려보고 언제 브레스가 나가는지 꼭 체크를 해보셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.430,
                "end": 99.641
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 있다면 공격력과 치명타 확률 높여 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.651,
                "end": 103.570
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다 요정 같은 경우에는 아레나에서 현재 1분 타이밍에 맞춰서 쓰기 위해서 올쿨토핑을 쓰고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 103.582,
                "end": 110.398
            },
            {
                "speaker_id": "1",
                "transcription": "물론 3딜덱 기준으로만 이렇게 올쿨토핑을 쓰고 일반적인 상황에서는 이렇게 라즈베리로 사용하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.408,
                "end": 118.490
            },
            {
                "speaker_id": "1",
                "transcription": "일반적인 상황이라는 것은 수호 성전이나 스토리보드 등 보스 스테이지 같은 곳에서 필승템으로 이렇게 사용하시면 되고요.",
                "sound_type": [
                    2,
