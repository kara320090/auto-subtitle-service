                "end": 12.626
            },
            {
                "speaker_id": "1",
                "transcription": "돌아왔다, 뱀파가 돌아왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.636,
                "end": 15.235
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파가 돌아왔어.",
