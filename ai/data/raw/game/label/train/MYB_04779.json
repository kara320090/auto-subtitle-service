                ],
                "start": 0.000,
                "end": 1.763
            },
            {
                "speaker_id": "1",
                "transcription": "보뽑 마일리지 어디다 써야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.773,
                "end": 4.174
            },
            {
                "speaker_id": "1",
                "transcription": "제일 좋은 거는 보뽑이 효율 제일 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.184,
                "end": 7.546
            },
            {
                "speaker_id": "1",
                "transcription": "이거 전부 다 보뽑 갑니다.",
