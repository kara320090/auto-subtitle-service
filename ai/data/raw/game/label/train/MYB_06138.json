        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 자 두 번째 덱 같은 경우에는 이거는 원 덱 소환덱 적용용으로 쓰는 건데 와일드베리 같은 경우에는 올 피감 치명타 확률 높여질 수 있으면 좋다고 생각해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.154
            },
            {
                "speaker_id": "1",
                "transcription": "1분 공중 타이밍 때 핵펀치로 상대를 높일 수 있게끔 거의 와베는 방어형이지만 사실상 진짜 딜러급으로 엄청나게 딜이 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.164,
                "end": 20.166
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 피감이랑 확실히 좋고 이 소환덱 저격에서는 어 올 아몬드로 피해 감소 높게 그냥 세팅해 주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.176,
                "end": 28.242
            },
            {
                "speaker_id": "1",
                "transcription": "펌킨파이랑 나머지는 그냥 일반 소환덱이랑 똑같이 세팅해 주시면 되고 자 세 번째 덱 같은 경우에 얘는 공속덱 저격입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.252,
                "end": 36.941
            },
            {
                "speaker_id": "1",
                "transcription": "낫, 공속 부물, 망토 부물 이런 게 보이면 요걸로 세팅해서 가는데 이것도 마찬가지 크런치 초코칩은 올 아몬드로 샤벳 상어도 올 아몬드, 펌킨파이도 올 아몬드",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.951,
                "end": 49.404
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 나머지는 쿨쿨 이렇게 세팅을 해 줬습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.414,
                "end": 52.900
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳 상어 같은 경우에 쿨을 좀 높게 세팅 하신 이유는 좀 더 빨리 죽일라고 한 거지만 굳이 쿨 신경 안 쓰고 피감만 좀 더 높게 세팅해 주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.910,
                "end": 63.899
            },
            {
                "speaker_id": "1",
                "transcription": "자 네 번째 덱은 제가 유튜브에 올렸지만 요거는 상대 2, 1, 2 덱한테 많이 들어가는 덱이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.909,
                "end": 71.856
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 뭐 다 다크 카카오는 6.3퍼센트 이상 피감, 와베는 피감이랑 치확 그 다음에 석류 올쿨, 과다종 4초 바요 그 다음에 서리는 그냥 피감만 높게 요렇게 세팅해서 요걸로 많이 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.866,
                "end": 85.633
            },
            {
                "speaker_id": "1",
                "transcription": "방덱 같은 경우에는 저는 이걸로 쓰고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.643,
                "end": 87.935
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 와베, 아몬드 그리고 또 아몬드 6.3퍼센트 이상 클로티드는 쿨 6퍼센트 때 와베랑 스킬 연계 때문에 어 6퍼센트대를 많이 좀 쓰게 되는 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.945,
                "end": 99.603
            },
            {
                "speaker_id": "1",
                "transcription": "서리 같은 경우에는 피감 높게 아 목화는 그냥 올 쿨 이렇게 세팅을 해서 쓰게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.613,
                "end": 107.166
            }
        ]
    },
    "summary": "와일드베리는 피해 감소를 높게 세팅하고 펌킨파이는 일반 소환덱이랑 똑같이 세팅하고 크런치 초코칩, 샤벳 상어, 펌킨파이는 올 아몬드로 세팅해 줍니다.",
