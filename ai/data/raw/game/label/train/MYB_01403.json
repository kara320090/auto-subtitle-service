        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 이런 그림으로 이기는 그림이 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.964
            },
            {
                "speaker_id": "1",
                "transcription": "아마 여러분들 아레나 하면서 아니 왜 갑자기 아레나에 레어 무공비급이 갑자기 많아졌지 그렇게 생각하는 분들 다 저게 요 한방덱 때문이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.974,
                "end": 14.274
            },
            {
                "speaker_id": "1",
                "transcription": "이 관련 한방덱 영상은 지금 화면에 보이는 섬네일 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.284,
                "end": 18.389
            },
            {
                "speaker_id": "1",
                "transcription": "화면에 보이는 섬네일 영상 고거 참고해서 세팅을 해보시면 될 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.399,
                "end": 24.008
            },
            {
                "speaker_id": "1",
                "transcription": "아 그 한번 보여 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.018,
                "end": 26.057
            },
            {
                "speaker_id": "1",
                "transcription": "레어 무공비급이 아니고 일반 무공비급이 됐을 땐 이 한방덱으로 들어가거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.067,
                "end": 31.303
            },
            {
                "speaker_id": "2",
                "transcription": "내가 앞서가겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.313,
                "end": 35.529
            },
            {
                "speaker_id": "1",
                "transcription": "근데 지금 한방덱을 낚시로 막는 덱도 있거든요.",
                "sound_type": [
                    2
                ],
                "start": 35.539,
                "end": 39.255
            },
            {
                "speaker_id": "3",
                "transcription": "천명을 따르라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.265,
                "end": 41.700
            }
        ]
    },
    "summary": "한방덱은 화면에 보이는 섬네일대로 세팅하면 되고 일반 무공비급으로 했을 때의 한방덱도 보여준다고 한다.",
