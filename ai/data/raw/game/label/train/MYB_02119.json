        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 찰스 들어가구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.951
            },
            {
                "speaker_id": "1",
                "transcription": "아니 찰스가 공속덱한테 왜 좋나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.961,
                "end": 6.827
            },
            {
                "speaker_id": "1",
                "transcription": "스턴 거는 거 때문에 상대의 공격이 다 끊겨버려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.837,
                "end": 10.913
            },
            {
                "speaker_id": "1",
                "transcription": "에 그런",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.923,
                "end": 12.164
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 연계가 너무 환상적으로 좋다 그렇게 보시면 되구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.174,
                "end": 16.522
            },
            {
                "speaker_id": "1",
                "transcription": "계속 스킬이 끊기니까 상대가 딜이 중간에 끊겨버려서 제 아군이 죽지를 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.532,
                "end": 22.892
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 상대 마들렌도 죽어버리기 때문에 손쉽게 이길 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.902,
                "end": 28.426
            },
            {
                "speaker_id": "1",
                "transcription": "찰스가 퀸아망 마들렌 조합으로는 거의 승률 100퍼센트로 가져가고 있기 때문에 그마 2나 그마 3이나 마스터 구간에 공속덱 유형이 되게 많이 보이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.436,
                "end": 39.843
            },
            {
                "speaker_id": "1",
                "transcription": "어 찰스덱으로 여러분들 공격 들어가면 상당히 좋게 이길 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.853,
                "end": 45.001
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요 조합은 상대방이 자색고구마, 마들렌, 캡사이신 네 요렇게 되어 있으면은 네 상당히 승률 좋게 이긴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.011,
                "end": 57.666
            }
        ]
    },
    "summary": "찰스가 퀸아망 마들렌 조합으로는 거의 승률 100퍼센트로 가져가고 있기 때문에 그마 2나 그마 3이나 마스터 구간에 공속덱 유형이 되게 많이 보이는데 찰스덱으로 여러분들 공격 들어가면 상당히 좋게 이길 수 있다고 하면서 상대방이 자색고구마, 마들렌, 캡사이신 요렇게 되어 있으면 상당히 승률 좋게 이긴다고 한다.",
