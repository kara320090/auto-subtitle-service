    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "같은 경우에도 아레나도 좀 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.136
            },
            {
                "speaker_id": "1",
                "transcription": "마스터 3위 시고 토핑 한번 볼까요? 이분 열심히 하시고 있으니까 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.146,
                "end": 8.090
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 토핑작 역시 많이 하고 계시네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.100,
                "end": 10.901
            },
            {
                "speaker_id": "1",
                "transcription": "야 토핑 좋은 거 많다. 야 뭐야 이거 야 나도 갖고 싶다. 종결 토핑이네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.911,
                "end": 16.278
            },
            {
                "speaker_id": "1",
                "transcription": "피감6, 쿨탐2, 치명타 확률 2.9. 이것도 종결이네. 거의. 나도 이렇게까지 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.288,
                "end": 23.398
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이분은 아몬드가 아주 핵사기네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.408,
                "end": 26.558
            },
            {
                "speaker_id": "1",
                "transcription": "이게 아몬드가 6퍼센트 가까이에다 쿨이 이렇게 높은 게 잘 붙기가 힘든데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.568,
                "end": 31.300
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 좋은 토핑들 많이 가지고 계시면은 세팅할 때 무난하게 할 수 있고 6퍼센트가 상당히 많으시네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.305,
                "end": 39.000
            },
            {
                "speaker_id": "1",
                "transcription": "아 찬란한 영웅들의 신전. 근데 지금 와서는 후회돼죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.000,
                "end": 43.340
            },
            {
                "speaker_id": "1",
                "transcription": "이게 제가 이거 신전 이거 슬롯 여는 거 가지고 항상 말하면 댓글에 아 러너님 스트레스 없이 하는 무과금 유저는 생각 안 하십니까 유저분들이 스트레스 없게 하려면 시원하게 다 뚫어도 상관없다 생각합니다 이렇게 댓글 다는 분들 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.360,
                "end": 58.805
            },
            {
                "speaker_id": "1",
                "transcription": "맞는 말이에요. 랭커 1도 상관없고 그냥 나는 편하게 즐겜만 하겠다시는 분들은 다 뚫어도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.815,
                "end": 65.238
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 게임은 나중 가면은 후회하는 시점이 옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.248,
                "end": 68.683
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 말한 분들도 나중에 하다보면은 별사탕이 너무 쌓이다 보니까 이렇게 뚫었던 것에 대해서 후회가 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.693,
                "end": 75.859
            },
            {
                "speaker_id": "1",
                "transcription": "왜 이걸 뚫었을까 저거 뚫은 걸로 석상 레벨이나 더 올릴 걸 이렇게 후회되는 시점이 반드시 오거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.869,
                "end": 81.927
            },
            {
                "speaker_id": "1",
                "transcription": "이게 엄청나게 쌓입니다. 무과금러 분들도 마찬가지많이 쌓이게 되는 시점이 오기때문에 쿠키하우스만 많이 레벨업 해주면은 이거 그렇게까지 많이 안 뚫어도 되는 시점이 오고 제가 생각했을 때는 5, 6개는 스트레스 없이할 수 있고 물론 더 뚫으면 뚫을수록 스트레스가 덜한 건 맞아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.937,
                "end": 99.599
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 가급적이면은 많이 안 뚫었으면 좋겠다 그냥 제 추천입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.609,
                "end": 106.366
            }
        ]
    },
    "summary": "쿠키하우스만 많이 레벨업을 해주면은 그렇게까지 많이 안 뚫어도 된다.",
