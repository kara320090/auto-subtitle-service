        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱 플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.183
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.193,
                "end": 6.500
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.510,
                "end": 10.373
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제부터 빌드 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.383,
                "end": 12.029
            },
            {
                "speaker_id": "1",
                "transcription": "천천히 영상 보고 따라 하시면 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.039,
                "end": 15.627
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 그렇게 어렵진 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.637,
                "end": 17.438
            },
            {
                "speaker_id": "1",
                "transcription": "하다 보면은 괜찮은데 처음이 좀 어려울 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.448,
                "end": 20.809
            },
            {
                "speaker_id": "1",
                "transcription": "자 맨 처음에 가동으로 가고 마카롱 먼저 스킬 발동 시켜줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.819,
                "end": 24.961
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 벚꽃 맛 쿠키 눌러주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.971,
                "end": 27.778
            },
            {
                "speaker_id": "1",
                "transcription": "자 벚꽃 맛 쿠키 눌러지면은 그다음에 블랙베리 바로 눌러줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.788,
                "end": 32.995
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음 블랙베리 눌러주고 발동되면은 자 바로 마카롱으로 넘어가서 마카롱 예약을 눌러줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.005,
                "end": 40.380
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱 스킬 쓰자마자 호밀을 눌러주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.390,
                "end": 43.916
            }
        ]
    },
    "summary": "화자가 쿠키런 킹덤을 PC에서 즐길 때는 녹스 앱 플레이어를 추천한다며 더 보기 및 고정 댓글에 전용 링크를 통해 다운로드 할 수 있다고 말하며 빌드를 알려주는데 천천히 따라 하면 어렵지 않지만 처음이 조금 어렵다고 말했다.",
