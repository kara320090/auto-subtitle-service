        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 무지개 큐브 많이 부족하시죠 이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.719
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.729,
                "end": 12.342
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원 가격에 해당하는 가격인데 제가 무료로 나눠드리고 있는데 받는 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.352,
                "end": 24.167
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱을 다운로드 받으시고 우측 하단에 프로필을 누르시고 우측 상단에 톱니바퀴를 누르면 시크릿코드 입력하는 데가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.177,
                "end": 34.191
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오ND러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.201,
                "end": 38.564
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 앱은 도대체 어떤 걸까 자 여러분들이 게임만 해도 자동으로 쌓이는 잼을 가지고 자 상점에서 여러분들이 원하는 기프트 카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.574,
                "end": 49.993
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임하하는데 여러분들한테 따로 광고가 뜨지도 않고요 방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.003,
                "end": 55.908
            },
            {
                "speaker_id": "1",
                "transcription": "자 시크릿 코드 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.918,
                "end": 61.690
            },
            {
                "speaker_id": "1",
                "transcription": "자세한 이벤트 확인은 고정 댓글로 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.700,
                "end": 64.660
            },
            {
                "speaker_id": "1",
                "transcription": "조금만 정리를 해보면 여러분들이 앞에 전방에 반드시 키워야 되는 쿠키는 홀리베리는 완벽하게 고정인 쿠키가 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.670,
                "end": 73.134
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 딜러로 선택해서 키워야 될 쿠키는 용과 드래곤, 블래펄 쿠키, 스타더스트 이 3개 쿠키를 집중적으로 키우시면 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.144,
                "end": 81.906
            },
            {
                "speaker_id": "1",
                "transcription": "물론 여기에 바다요정, 달빛수사, 샤이닝글리터 그리고 용과 대신에 캡사이신, 소르베맛 쿠키 그리고 실론나이트 자 그리고 힐러를",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.916,
                "end": 92.200
            }
        ]
    },
    "summary": "홀리베리는 전방 고정으로 키워야 하고 딜러로 선택해서 키워야 될 쿠키는 용과 드래곤, 블래펄 쿠키, 스타더스트이다.",
