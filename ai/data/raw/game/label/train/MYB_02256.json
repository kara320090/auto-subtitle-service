        "term": [
            {
                "speaker_id": "1",
                "transcription": "네, 자 일단 여러분들 이게 중요한 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.291
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이렇게 퓨 퓨바 있는 덱 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.301,
                "end": 5.621
            },
            {
                "speaker_id": "1",
                "transcription": "퓨바 있는 요렇게 마들렌 공속덱도 이 덱으로 잘 잡혀요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.631,
                "end": 11.418
            },
            {
                "speaker_id": "1",
                "transcription": "음 음 이런 식으로 상위권에서 잡힌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.428,
                "end": 16.412
            },
            {
                "speaker_id": "1",
                "transcription": "내가 전에도 말했지만 지금 현재 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.422,
                "end": 20.280
            },
            {
                "speaker_id": "1",
                "transcription": "그마 1 2에서만 공속덱이 엄청나게 활발하지 나머지 그마 3 그다음에 마스터 부분에서는 공속덱 세팅이 되는 분이 많이 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.290,
                "end": 29.903
            },
            {
                "speaker_id": "1",
                "transcription": "마탕 아직 만드는 중이라 그래서 차라리 그 구간에서는 불파, 서리덱 같은 한방덱 더 최적화해 가지고 그걸 더 활용하는 게 더 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.913,
                "end": 40.710
            },
            {
                "speaker_id": "1",
                "transcription": "어설프게 공속덱 따라 할 바에는 차라리 그냥 기존 덱을 더 어 활용 잘 하는 게 저 더 낫다고 봅니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.720,
                "end": 48.303
            },
            {
                "speaker_id": "1",
                "transcription": "음 좀 애매할 수 있어.",
