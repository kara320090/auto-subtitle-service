    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 다음에 많이 질문하는 것에 하나가 트리플콘컵 토핑 어떤 거 선택하나요 이 질문 많은데 자 현재 트리플콘컵 토핑 같은 경우에는 퀸아망 쿠키나 캡사이신 쿠키가 쓸 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 11.164
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 마지막으로 자 푸룬주스맛 쿠키도 쓸 수가 있는데 일단 정해진 거는 캡사이신은 대부분은 라즈를 많이 쓰고 푸룬주스는 라즈 또는 토블론에 쿨 자 그리고 퀸아망 쿠키는 라즈 또는 아몬드 토핑을 씁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.174,
                "end": 25.830
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱의 종류가 2가지가 있기 때문에 여러분들이 선택해서 골라야 되는 상황인데 제가 조심스럽게 말씀드리면은 현재 어 무조건 선택해서 쓰는 거는 좀 추천드리지 않아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.840,
                "end": 37.541
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 트리플콘컵 토핑 자체가 워낙 신중하게 써야 되는 토핑이긴 해서 특정 토핑이 여유가 많다 하시면은 무조건 토핑을 선택해서 해도 되지만 제 생각에는 아직 특정된 답이 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.551,
                "end": 50.219
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 며칠 정도 더 기다렸다가 공속덱에 좀 더 최적화 돼서 쓰는 거 더 좋지 않나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.229,
                "end": 57.064
            },
            {
                "speaker_id": "1",
                "transcription": "근데 장기적으로 볼 때는 제 생각인데 아까 말씀드렸듯이 용과 드래곤이 나오면은 캡사이신이 다시 부활할 가능성이 상당히 높거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.074,
                "end": 65.934
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신 라즈베리 쓰는 시대가 또 올 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.944,
                "end": 68.637
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뭐 저는 이건 제 개인적인 생각입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.647,
                "end": 71.991
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신은 나중에 다시 라즈로 쓸 것 같고 퀸아망도 뭐 라즈로 쓸 수 있어서 저는 일단은 판단 하에 나머지 뭐 아몬드나 쿨 같은 경우에는 좀 여유가 있어서 저는 이렇게 라즈로 다 선택해서 강화를 다 끝냈습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.001,
                "end": 86.392
            },
            {
                "speaker_id": "1",
                "transcription": "절대 라즈베리를 하라는 내용이 아니라 여러분들 판단 하에 부족한 토핑으로 하시거나 아니면 가장 좋은 거 좀 시간 지나서 어 최적화된 토핑을 고속덱이 나오면은 그걸 선택해서 쓰는 것도 가장 좋은 것 같다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.402,
                "end": 100.451
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 트리플콘컵 토핑에서 제가 생각할 때는 공속덱에서는 피감하고 공격 속도 이 2개가 상당히 중요한 포인트거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 100.461,
                "end": 109.220
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 공속이 나왔다 해도 버리지 말고 꼭 챙겨서 강화해 주시기 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 109.230,
                "end": 114.618
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 키워야 될 쿠키들 이 5개 쿠키가 아마 제일 많이 추천되는 쿠키가 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 114.628,
                "end": 121.437
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 중에서도 특히나 퀸아망이나 마들렌은 여러분들이 세팅이 2가지로 크게 나뉘고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 121.447,
                "end": 127.682
            },
            {
                "speaker_id": "1",
                "transcription": "라즈 세팅, 아몬드 세팅 장단점이 있지만 어 저는 약간 극 공으로 올 라즈로 선택해서 쓰고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 127.692,
                "end": 134.539
            },
            {
                "speaker_id": "1",
                "transcription": "세팅할 때 아몬드나 라즈나 둘 다 공통적으로 퀸아망 쿠키가 마들렌보다는 공격력이 높게 세팅이 돼야 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 134.549,
                "end": 142.792
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이제 퓨바 같은 경우에도 올 아몬드로 세팅을 다시 제가 세팅을 하고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 142.802,
                "end": 147.703
            },
            {
                "speaker_id": "1",
                "transcription": "너무나 딜이 세서 퓨어 바닐라가 죽는 경우에는 올 아몬드로 하시고 달빛술사도 저도 올 아몬드도 이렇게 세팅해서 쓰고 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 147.713,
                "end": 156.524
            },
            {
                "speaker_id": "1",
                "transcription": "죽기 쉬워서 정말 피감 높게 체력도 좋게 이렇게 해서 쓰고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 156.534,
                "end": 161.576
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 보물도 공속덱이 엄청나게 떴기 때문에 보물 선택권 써서 망토 만렙을 꼭 찍어주시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 161.586,
                "end": 170.102
            },
            {
                "speaker_id": "1",
                "transcription": "공격 속도가 증가되면은 마들렌 같은 경우에는 변신했을 때 때리는 타수가 증가되기 때문에 공격 속도를 최대한 높여 주시는 게 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 170.112,
                "end": 178.453
            },
            {
                "speaker_id": "1",
                "transcription": "자 최종적으로 정리해 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 178.463,
                "end": 180.526
            },
            {
                "speaker_id": "1",
                "transcription": "러너 님 지금 그래서 뭘 키워야 되나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 180.536,
                "end": 182.502
            },
            {
                "speaker_id": "1",
                "transcription": "현재 아레나를 즐기고 싶으신 분 퀸아망 쿠키, 마들렌, 홀리베리, 퓨바, 달빛 요 5쿠키가 가장 메인 핵심 쿠키들이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 182.512,
                "end": 191.206
            },
            {
                "speaker_id": "1",
                "transcription": "라떼맛 쿠키도 상향돼서 좋지만 공속덱에는 좀 많이 밀리는 편이라 마들렌 먼저 키우고 여유가 될 때 라떼맛 쿠키를 키워주시는 게 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 191.216,
                "end": 200.586
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 나머지 토벌 관련된 쿠키나 서브로 아레나덱 만드실 분들은 특히 뭐 스타더스트나 이런 거 다 키워주시면 좋고 캡사이신은 티어가 좀 떨어져서 지금은 활용 가치가 좀 낮아졌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 200.596,
                "end": 213.028
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 한방덱이 또 올라와서 에일리언 도넛이랑 찰스 한방덱이 다시 티어가 올랐으니까 고것도 세팅해서 쓰는 것도 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 213.038,
                "end": 222.721
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 쿠키 어떤 거 키워야 될지 티어 변화랑 추천 쿠키에 대해서 마치도록 하겠습니다. 감사합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 222.731,
                "end": 240.500
            }
        ]
    },
    "summary": "퀸아망 쿠키, 마들렌, 홀리베리, 퓨바, 달빛술사 메인 쿠키이고 캡사이신 쿠키는 티어가 낮아졌고 에일리언 도넛과 찰스 한방덱도 세팅하시면 좋으실 것 같다.",
