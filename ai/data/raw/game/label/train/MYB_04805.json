        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 10월 13일 목요일 쿠키런 킹덤 업데이트 같이 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.715
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키런 킹덤 카드뉴스 이렇게 사진이 나와있고 최고의 무대를 보여줄 일곱 쿠키들 BTS 쿠키들이 스페셜 등급으로 나오게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.715,
                "end": 14.712
            },
            {
                "speaker_id": "1",
                "transcription": "자 후방에 위치하는 쿠키로 되고 스킬 이름은 아미의 가호 이렇게 되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.712,
                "end": 20.405
            },
            {
                "speaker_id": "1",
                "transcription": "아미들의 따뜻한 가호로 특수 무적 효과가 적용되며 음악을 통해 팀의 체력을 회복하고 보호한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.405,
                "end": 27.285
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 팀의 체력을 회복해 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.285,
                "end": 30.142
            },
            {
                "speaker_id": "1",
                "transcription": "검볼다이버 쿠키와 같이 힐러 개념으로 뒤쪽에서 배치 되어 있는 쿠키다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.142,
                "end": 35.155
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 중요한 거는 스페셜 등급이라 거 그리고 곧 쿠키 왕국의 축제가 시작됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.155,
                "end": 41.165
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 꾸미기도 새롭게 여러 개 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.165,
                "end": 44.717
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.717,
                "end": 46.315
            },
            {
                "speaker_id": "1",
                "transcription": "방탄소년단 쿠키와 함께 즐기는 쿠키왕국에서의 첫 공연 미니게임 식으로 나오는 것 같죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.315,
                "end": 53.402
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이게 되게 놀랍게도 이번에 찰스 쿠키가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.405,
                "end": 59.187
            },
            {
                "speaker_id": "1",
                "transcription": "스킬은 초코칩 망치고 돌격형 전방에 배치되는 쿠키로 나오게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.187,
                "end": 65.489
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱 플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.489,
                "end": 68.807
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.807,
                "end": 72.100
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
