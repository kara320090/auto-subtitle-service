                ],
                "start": 0.000,
                "end": 0.829
            },
            {
                "speaker_id": "2",
                "transcription": "슈크림맛 쿠키 마탄도 나오죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.839,
                "end": 2.598
            },
            {
                "speaker_id": "1",
                "transcription": "젤리우스 익스트리모스",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.608,
                "end": 5.380
            },
            {
                "speaker_id": "2",
                "transcription": "마탄 뭐가 추가된 거지? 슈크림은",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.390,
                "end": 8.897
            },
            {
                "speaker_id": "3",
                "transcription": "저 달빛술사 쿠키가 마법사들의 이름으로 감사할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.907,
                "end": 13.312
            },
            {
                "speaker_id": "4",
                "transcription": "만나게 되어서 영광이야. 우리를 초대해 줘서 고마워.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.322,
                "end": 18.723
            },
            {
                "speaker_id": "5",
                "transcription": "여길 부수고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.733,
                "end": 23.093
            },
            {
                "speaker_id": "2",
                "transcription": "야 오로라 캔디 이거 나와요? 이거 언제 나오지 얘는",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.103,
                "end": 26.621
            },
            {
                "speaker_id": "5",
                "transcription": "모든 힘을 다해서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.631,
                "end": 27.735
            },
            {
                "speaker_id": "2",
                "transcription": "지금 안 낼 것 같고 나중에 나올 것 같다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.745,
                "end": 30.553
            },
            {
                "speaker_id": "6",
                "transcription": "지키기 위해 싸우겠어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.563,
                "end": 32.175
            },
            {
                "speaker_id": "6",
                "transcription": "가자 얘들아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.185,
                "end": 34.966
            }
        ]
    },
    "summary": "남성이 영상을 보며 슈크림맛 쿠키의 마탄이 나오는데 뭐가 추가된 건지 궁금해하고 오로라 캔디는 지금 안 내고 나중에 낼 것 같다고 합니다.",
