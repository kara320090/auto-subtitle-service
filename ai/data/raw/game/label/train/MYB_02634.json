        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 그냥 스킬도 연속으로 다 들어 가니까 그냥 정신 못 차리네 상대가 아 여러분들이 볼 때는 어때요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 14.128
            },
            {
                "speaker_id": "1",
                "transcription": "나는 그냥 이거 이렇게 세팅해서 공택 쓰면은 거의 진짜 기존 덱들 다 박살 낼 거 같은데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.138,
                "end": 20.525
            },
            {
                "speaker_id": "1",
                "transcription": "뚫은 사람도 이걸로 써서 나온거야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.535,
                "end": 22.801
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 무공비 쓰셨네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.811,
                "end": 25.490
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이거 한번 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.500,
                "end": 27.167
            },
            {
                "speaker_id": "1",
                "transcription": "저보다 초월 높으신 분이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.177,
                "end": 29.560
            },
            {
                "speaker_id": "1",
                "transcription": "이분은 3초월이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.570,
