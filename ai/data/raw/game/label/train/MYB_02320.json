        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 아레나 개선 자 명예의 전당 네 시즌 별로 이렇게 1위, 2위, 3위 한 사람들한테 저렇게 명예의 전당이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.083
            },
            {
                "speaker_id": "1",
                "transcription": "진작에 이런 게 나왔어야 되는데 이전 시즌의 상위 랭킹 100위를 확인할 수 있는 명예의 전당 아 100위까지 확인할 수 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.093,
                "end": 16.066
            },
            {
                "speaker_id": "1",
                "transcription": "전투 준비 화면이 바뀌었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.076,
                "end": 18.003
            },
            {
                "speaker_id": "1",
                "transcription": "전투 준비 화면에서 아군 팀 정보와 상대 팀 정보가 함께 노출됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.013,
                "end": 21.595
            },
            {
                "speaker_id": "1",
                "transcription": "물론 가려지는 건 쿠키가 그림자를 달겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.605,
                "end": 24.995
            },
            {
                "speaker_id": "1",
                "transcription": "원래 이거 대난투에 이렇게 했잖아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.005,
                "end": 26.504
            },
            {
                "speaker_id": "1",
                "transcription": "들어갈 때 화면이 이렇게 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.514,
                "end": 28.139
            },
            {
                "speaker_id": "1",
                "transcription": "전투에 참여하는 쿠키들의 썸네일이 노출됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.149,
                "end": 30.543
            },
            {
                "speaker_id": "1",
                "transcription": "기존에는 상대방의 쿠키 5개 중에 하나가 랜덤으로 그냥 하나가 그냥 뜨고 끝이었죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.553,
                "end": 35.423
            },
            {
                "speaker_id": "1",
                "transcription": "전투 결과 화면이 개선됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.433,
                "end": 37.951
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 최고의 쿠키 캡사이신맛 쿠키 뭐 이렇게 MVP 같은 걸로 좀 뭐 해주나 보네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.961,
                "end": 43.631
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐만 나 지금 중요한 포인트를 찾았어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.641,
                "end": 46.242
            },
            {
                "speaker_id": "1",
                "transcription": "깃발 70개에다가 순위 보너스 80개씩 주네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.252,
                "end": 50.255
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 기존에 15개 고정에 비해서 5배 6배 준다는 거네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.265,
                "end": 54.108
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 그냥 여러분들 테스트겠지 여러분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.118,
                "end": 56.333
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 뭐 정확한 건 아니니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.343,
                "end": 58.002
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 밑에 이렇게 나왔구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.012,
                "end": 59.833
            },
            {
                "speaker_id": "1",
                "transcription": "다음 승급 티어를 확인할 수 있는 정보가 추가되고 티어가 마스터 5 이상일 경우에 해당 영역의 현재 순위가 표시",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.843,
                "end": 66.721
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 전투 리포트 뭐 한눈에 보고 싶은 분들한테는 뭐 좋을 수 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.731,
                "end": 71.563
            },
            {
                "speaker_id": "1",
                "transcription": "난 복잡하다 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.573,
                "end": 73.298
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 아레나 입장권 부족 시 마일리지 충전할 수 있는 기능 추가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.308,
                "end": 77.793
            },
            {
                "speaker_id": "1",
                "transcription": "오 아레나 미션이 추가됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.803,
                "end": 79.952
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 미션 횟수에 따라 프로필, 크리스탈, 전용 케이크, 들개 케이크",
                "sound_type": [
                    2,
