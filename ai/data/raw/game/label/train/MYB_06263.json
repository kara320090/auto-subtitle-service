        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 여기 절대 가지 말라는 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.825
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 기억하세요 초코 머드 타운 절대 가지 마.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.835,
                "end": 4.710
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 할 때마다 정 뚝떨이야 진짜 이렇게 동시에 뜰 때 여기 순서가 중요해요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.720,
                "end": 12.180
            },
            {
                "speaker_id": "1",
                "transcription": "분위기가 이거 또다시 해야 되는 분위기인데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.190,
                "end": 16.385
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 진짜 미쳐버리겠네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.395,
                "end": 18.892
            },
            {
                "speaker_id": "1",
                "transcription": "아 꽝이야 아 이거 운빨이야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.902,
                "end": 21.352
            },
            {
                "speaker_id": "1",
                "transcription": "아 뭐 스토리 보는 걸 운빨로 해야 돼 이거.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.362,
                "end": 24.058
            },
            {
                "speaker_id": "1",
                "transcription": "아 용쿠가 시장 가는 게 확률이에요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.068,
                "end": 27.179
            },
            {
                "speaker_id": "1",
