                ],
                "start": 7.589,
                "end": 17.165
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 때문에 가급적이면은 한 번만 그냥 딱 눌러주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
