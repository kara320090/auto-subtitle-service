        "term": [
            {
                "speaker_id": "1",
                "transcription": "것 같아 진짜 어떻게 된 일이지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.194
            },
            {
                "speaker_id": "1",
                "transcription": "야 바보야 뭐가 똑똑해 밥 많으세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.204,
                "end": 26.435
            },
            {
                "speaker_id": "1",
                "transcription": "다음 타임에 또 슈늉슈뇽 보려고 아 진짜 하지 말라고 그랬지 이거 뽑지 마.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.445,
                "end": 41.545
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 하지 하 하",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.555,
                "end": 46.688
            },
            {
                "speaker_id": "2",
                "transcription": "그래도 감각이 많이 좋아지셨네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.698,
                "end": 49.430
            },
            {
                "speaker_id": "2",
                "transcription": "담배 한 대 피우고 와야지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.440,
                "end": 51.065
            },
            {
                "speaker_id": "3",
                "transcription": "그러면 백혈구가 또 일할 수밖에 없어 몸이 안 좋아지니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.075,
                "end": 55.185
            },
            {
                "speaker_id": "3",
                "transcription": "백혈구 지금 바쁘잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.195,
                "end": 57.006
            },
            {
                "speaker_id": "3",
                "transcription": "왜 자꾸 담배 피우고 그래 몸이 안 좋아진다고.",
                "sound_type": [
                    2,
                    3
