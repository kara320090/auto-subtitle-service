        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 이거 다른 분한테 통하는지 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.130
            },
            {
                "speaker_id": "1",
                "transcription": "캡사덱한테 가 볼게.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.140,
                "end": 4.476
            },
            {
                "speaker_id": "1",
                "transcription": "가장 강력하신 분이 1분 있지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.486,
                "end": 6.738
            },
            {
                "speaker_id": "1",
                "transcription": "이 분 뚫었으면은 말 다한 거야.",
