        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 왕국까지 가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.613
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 티얼스 레벨업 바로 해줍니다. 저는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.623,
                "end": 8.846
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이거 할 때 쿠키성이나 이런 거 레벨업 하거나 이럴 때 시간권 써야 되나요? 이렇고 물어보시는 분들 있잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.856,
                "end": 15.660
            },
            {
                "speaker_id": "1",
                "transcription": "저는 어떻게 생각하냐면 시간권은 그냥 무조건 아낀다고 좋은 게 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.670,
                "end": 21.338
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 그냥 필요하다 싶을 때 써요. 알겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.348,
                "end": 24.451
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 아낀다고 좋은 게 아닙니다.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 24.461,
                "end": 27.026
            },
            {
                "speaker_id": "1",
                "transcription": "가장 효율적으로 나는 시간권을 극한의 효율로 쓰고 싶습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.036,
                "end": 31.147
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1님 어떻게 쓸까요? 하시는 분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.157,
                "end": 32.750
            },
            {
                "speaker_id": "1",
                "transcription": "자기 전에 열기구나 막 10분이나 막 1시간 남았어 자기 전인데 아니면 열차 같은 게 자기 전인데 막 1시간에서 30분 남았어요 그럴 때 쓰는 게 가장 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.760,
                "end": 42.170
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 자는 동안에도 엄청난 손실이 있으니까 시간",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.180,
                "end": 47.500
            }
        ]
    },
    "summary": "남성은 시간권을 효율적으로 쓰는 방법으로 자기 전에 열기구나 열차 같은 게 1시간에서 30분 이 정도 남았을 때 쓰는 게 가장 좋을 것 같다고 했고 이유는 자는 동안에도 시간의 손실이 있기 때문이라고 했다.",
