        "term": [
            {
                "speaker_id": "1",
                "transcription": "벌써 시작하자마자 아 달토끼 하나 왜 이렇게 잘 나와?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.771
            },
            {
                "speaker_id": "1",
                "transcription": "아 하필이면 똑같은 거 자 이것도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.781,
                "end": 13.962
            },
            {
                "speaker_id": "1",
                "transcription": "야 진짜 이거 스킨 노 중복",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.972,
                "end": 20.130
            },
            {
                "speaker_id": "1",
                "transcription": "오 야 근데 진짜 잘 나오는거든요 이 정도면",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.140,
                "end": 31.376
            },
            {
                "speaker_id": "1",
                "transcription": "자 좋습니다. 이제 본 게임 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.386,
                "end": 35.017
            },
            {
                "speaker_id": "1",
                "transcription": "계정 주인분 뭐 원해요?",
