        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "보셨어요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 0.677
            },
            {
                "speaker_id": "1",
                "transcription": "이게 가장 중요한 포인트예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.687,
                "end": 2.285
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 분명히 이 빌드를 봤을 때 러너님 저는 호밀이 죽는데요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.295,
                "end": 7.898
            },
            {
                "speaker_id": "1",
                "transcription": "호밀이 안 죽는데 이렇게 나올 거예요. 근데 이 즉사기가 지금 오징어먹물에 딱 꽂혀있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.908,
                "end": 13.448
            },
            {
                "speaker_id": "1",
                "transcription": "이게 성공적인 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.458,
                "end": 14.863
            },
            {
                "speaker_id": "1",
                "transcription": "자 아까 말했듯이 이거를 일으키는 가장 큰 원인은 호밀 스킬 누르는 타이밍이에요. 첫 번째 비석 때 마카롱 7시 근처에서 쓸 때 그 지점에 맞춰서 써 주셔야 이 호밀 생존이 되기 때문에 호밀이 만약에 즉사기에 죽는 분들은 첫 비석 때 마카롱 그 기준에 맞춰서 호밀을 눌러 주는 게 가장 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.873,
                "end": 35.232
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 된다면은 이제 오먹을 눌러 주시면 됩니다. 호밀도 같이 눌러주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.242,
                "end": 39.291
            },
            {
                "speaker_id": "1",
                "transcription": "자 이러면은 전부 다 살죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.301,
                "end": 42.625
            },
            {
                "speaker_id": "1",
                "transcription": "전부 다 살고 클리어가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.635,
                "end": 44.892
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 해서 1.51 나왔는데 호밀맛 쿠키 딜이 조금 낮게 나왔고 오먹이 좀 딜이 많이 낮게 나왔네요 치명이 좀 낮아서.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.902,
                "end": 52.707
            },
            {
                "speaker_id": "1",
                "transcription": "자 원래대로라면 아까 제가 실전에서 나온 건데 제가 토벌했을 때 1.57이 나왔고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.717,
                "end": 58.933
            }
        ]
    },
    "summary": "화자는 호밀이 죽지 않도록 호밀 누르는 타이밍을 알려준다.",
