        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 샤벳상어 마법 사탕 자 일단 30강까지 찍으면 받는 회복 감소 15초 동안 50퍼센트 증가라고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 12.678
            },
            {
                "speaker_id": "1",
                "transcription": "회복 감소가 50퍼센트나 자 일단은 마법 사탕을 하게 되면은 최대 체력이 가장 높은 적군 둘을 강하게 물어뜯는다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.688,
                "end": 20.919
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 부상 효과와 그다음에 받는 회복 감소 디버프를 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.929,
                "end": 25.947
            },
            {
                "speaker_id": "1",
                "transcription": "범위 추가 피해는 공격력의 804.4퍼센트 그리고 최대 체력이 가장 높은 적군 둘 피해는 공격력의 400퍼센트 부상 효과는 15초 동안 최대 체력의 12.5퍼센트 감소 부상 제한은 최대 25퍼센트까지 일단 세팅을 올 쿨 세팅을 해 볼 건데 요 3가지를 해 봅시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.957,
                "end": 46.237
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기 받는 전용 그다음에 올 쿨 세팅 네 그다음에 그냥 극피감 세팅 뭐 스토리에서도 한번 써봅시다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.247,
                "end": 53.468
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 평타 딜이랑 바뀐 걸 봐 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.478,
                "end": 57.875
            },
            {
                "speaker_id": "1",
                "transcription": "아 체력 대비 9년패이긴 한데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
