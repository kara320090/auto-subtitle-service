        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 어떤 거에 그 강하고 약한지를 보고 여러분들이 일일히 세팅 하나 해 놓으면은 상선 방이 파악 되고 그냥 아래에서 무지성으로도 갈 수 있고 그런 상황이 어 딱 우와 이것도 원탱덱한테 좋네 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.198
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 딱 봐도 그림 자체가 원탱덱은 뒤쪽 라인이 다 좀 올쿨이나나 라즈 쪽으로 많이 배치되어 있는 경우가 많기 때문에 와 이것도 그냥 스무스하게 이기네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.208,
                "end": 25.718
            },
            {
                "speaker_id": "1",
                "transcription": "아주 스무스하게 이거 진짜 세팅 하나 공격덱으로 하나 하긴 해야 되겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.728,
                "end": 29.842
            },
            {
                "speaker_id": "1",
                "transcription": "와 이거 좋네요.",
                "sound_type": [
                    2,
