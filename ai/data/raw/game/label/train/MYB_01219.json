        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 이번에 나온 신규 보물을 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.732
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 얼음 가득 시원한 에너지 드링크고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.742,
                "end": 6.349
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 체력 회복을 해줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.359,
                "end": 8.040
            },
            {
                "speaker_id": "1",
                "transcription": "레벨 업을 하면은 첫 사용 시간이 2초 쿨타임이 10초네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.050,
                "end": 11.258
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 현재 체력이 가장 낮은 쿠키 1명의 크기를 8초 동안 크게 만드네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.268,
                "end": 17.244
            },
            {
                "speaker_id": "1",
                "transcription": "보통 다른 신규 스페셜 보물은 크기를 작게 만들고 도토리로 바꾸고 뭐 이런 식이었다면 이거는 최대 체력이 가장 낮은 키 하나를 크기를 8초동안 크게 만드네요.",
                "sound_type": [
