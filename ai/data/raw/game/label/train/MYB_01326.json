        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단은 뭐 스토리에서 보는 거는 좀 의미가 없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.116
            },
            {
                "speaker_id": "1",
                "transcription": "제가 궁금한 거는 이 스냅 자리에 대체가 되는지가 난 너무나 궁금하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.126,
                "end": 9.853
            },
            {
                "speaker_id": "1",
                "transcription": "일단 여러분이 아셔야 될 거 얘네 둘이 힐량 비교하면은 락스타가 힐량이 미세하게 조금 더 높습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.863,
                "end": 17.662
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 비교 하자면은 일반적으로 얘가 힐량이 1000 만 이라고 나왔으면 얘가 1100만 아니면 둘이 비슷하거나 아마도 힐량 자체가 비스무리하게 나오는 그런 결과가 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.672,
                "end": 29.024
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 파르페를 넣었을 때 어떤 결과가 나오는 지 오 달빛스사랑 스타더스트덱한테 한번 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.034,
                "end": 38.590
            },
            {
                "speaker_id": "1",
                "transcription": "이게 극딜 덱이라 버티기 거의 힘들거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.600,
                "end": 42.476
            },
            {
                "speaker_id": "1",
                "transcription": "저 덱한테 버티기 너무 힘들 텐데 버텨봐 버텨봐 버텨봐",
