        "term": [
            {
                "speaker_id": "1",
                "transcription": "찌개같이 생각하는 사람들 있는데 반드시 거기다가 베이크드 빈즈를 넣어줘야 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.488
            },
            {
                "speaker_id": "1",
                "transcription": "그게 콩 콩조림인데 그걸 느야 그 맛이나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.498,
                "end": 11.691
            },
            {
                "speaker_id": "1",
                "transcription": "그걸 안 넣으면은 그거는 부대찌개라고 할 수가 있겠어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.701,
                "end": 16.578
            },
            {
                "speaker_id": "1",
                "transcription": "아줌마가 봤을 때는 아줌마가 고춧가루도 많이 넣고 자 다 때려 넣고 아유 팔팔 끓여요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.588,
                "end": 31.720
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐 기다려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.730,
                "end": 32.946
            },
            {
                "speaker_id": "1",
                "transcription": "아 아줌마 아줌마가 아까 보니까 아유 이거 뚜껑을 덮어놔야 되는데 뚜껑이 어디 갔니?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.956,
                "end": 46.297
            },
            {
                "speaker_id": "1",
                "transcription": "뚜껑 안 덮어 놓으면 넘치는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.307,
                "end": 49.093
            },
            {
                "speaker_id": "1",
                "transcription": "아 잠깐 아 어디 쏘는 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.103,
                "end": 56.132
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 꼭 넣고 음 어우 불 넘친다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.142,
                "end": 66.166
            }
        ]
    },
    "summary": "한 여성이 반드시 베이크드 빈즈를 넣어야 하며 안 넣으면 부대찌개라 할 수 없다 말하고 고춧가루 넣고 다 때려 넣어 팔팔 끓인다며 설명한다.",
