        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 출시된 프릴해파리 바로 리뷰 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.413
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 딱히 5성, 5초월 이렇게 나눌 필요가 전혀 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.423,
                "end": 8.924
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 얘가 딜러가 아니라 말 그대로 지원형이기 때문에 자 이렇게 빠르게 5초월까지 여러분들 이거 보면은 힐러라는 느낌이 있는데 죽어야지만 힐러로서의 의미를 가져요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.934,
                "end": 23.120
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 맨 처음에 스킬 사용하게 되면 최대 다섯을 다리로 속박하며 물거품 피해를 준다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.130,
                "end": 28.966
            },
            {
                "speaker_id": "1",
                "transcription": "제가 아까 아레나 상대방이랑 붙어 봤거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.976,
                "end": 31.770
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 무조건 전부 다 속박 거는 게 절대 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.780,
                "end": 34.983
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 최대 다섯까지 뭉쳐져 있으면 5마리를 속박을 거는 거지 확정 5마리 속박은 아니라는 점 그리고 뭐 이동 속도 감소 과전류 뭐 물속성 피해 증가 디버프 이렇게 있고 쿠키는 땅속에 숨어 들어가서 받는 피해 감속 그리고 공격 속도 증감의 영향 받지 않는다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.993,
                "end": 53.367
            },
            {
                "speaker_id": "1",
                "transcription": "그러고 이게 가장 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.377,
                "end": 55.259
            },
            {
                "speaker_id": "1",
                "transcription": "자 프릴해파리는 전투 불능 상태 죽었을 때 아기 해파리로 아군의 팀을 따라다니면서 회복을 주는 데 중요한 거는 미리 해 봤거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.269,
                "end": 65.184
            },
            {
                "speaker_id": "1",
                "transcription": "체력 회복력 자체가 이게 엄청 적어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.194,
                "end": 67.756
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 기대하는 힐러로서 대체할 수 있는 그런 쿠키는 여러분들 전혀 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.766,
                "end": 74.577
            },
            {
                "speaker_id": "1",
                "transcription": "그러고 물속성 피해 증가량이 10초 동안 32.5퍼센트다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.587,
                "end": 78.234
            },
            {
                "speaker_id": "1",
                "transcription": "일단 뭐 쿨로 해 보고 다른 토핑은 뭐 필요 연구가 더 필요하면 더 다른 것도 해 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.244,
                "end": 84.916
            }
        ]
    },
    "summary": "남성이 프릴해파리 리뷰를 하는데 딜러가 아니라 지원형이며 기대하고 있는 힐러로서 대체할 수 있는 쿠키는 전혀 아니라고 한다.",
