        "term": [
            {
                "speaker_id": "1",
                "transcription": "끝 아 여기 안 그랬으면 여기만 한 바퀴 뺑 돌 뻔했네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 20.578
            },
            {
                "speaker_id": "1",
                "transcription": "제가 약간 하나만 보면은 그것만 하는 스타일이어가지고 안 가르쳐 주셨으면 이번에는 진짜 새벽 두 시까지 여기를 돌면서 찾다가",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.588,
                "end": 30.174
            },
            {
                "speaker_id": "1",
                "transcription": "채팅 창 보고 눈치 보고 그러다 기어이 여기가 아닌가 다음에 하죠 하고 껐을 거야",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.184,
                "end": 38.933
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 이제 심호흡 한 세 번 해야 돼 그래야 화가 더 날거든",
                "sound_type": [
                    2,
                    3,
