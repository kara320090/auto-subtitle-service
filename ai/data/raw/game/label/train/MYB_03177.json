        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 자 마지막 호몬드 하면은 1초 컷 납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.074
            },
            {
                "speaker_id": "1",
                "transcription": "와 마지막에 시원하게 그냥 뭐야 나 1등인데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.084,
                "end": 10.519
            },
            {
                "speaker_id": "1",
                "transcription": "자 찍먹했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.529,
                "end": 13.231
            },
            {
                "speaker_id": "1",
                "transcription": "전체 1등 자 근데 이거 여러분들 되게 편한 조합인 게 여러분들 부담이 좀 없을 수 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.241,
                "end": 22.653
            },
            {
                "speaker_id": "1",
                "transcription": "자 어떻게 했냐면은 레전드, 고대 하나도 안 썼습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.663,
                "end": 26.039
            },
            {
                "speaker_id": "1",
                "transcription": "이제 거의 이걸로 다 깼어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.049,
                "end": 27.639
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들이 세팅할 때 자색 고구마, 올 아몬드 그다음에 마카롱 올쿨 피감도 심지어 없어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.649,
                "end": 34.285
            },
            {
                "speaker_id": "1",
                "transcription": "이래서 죽었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.295,
                "end": 35.641
            },
            {
                "speaker_id": "1",
                "transcription": "토벌에서 쓰는 거 그대로 썼다가 죽었던 거라 여러분들 피감 넣어주시면 좋은 거 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.651,
                "end": 40.451
            },
            {
                "speaker_id": "1",
                "transcription": "에소 좀 자주 나온다 싶으면은 아몬드 1 2개 넣어도 되지 않을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.461,
                "end": 45.314
            },
            {
                "speaker_id": "1",
                "transcription": "오징어먹물도 피감은 그렇게 안 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.324,
                "end": 47.336
            },
            {
                "speaker_id": "1",
                "transcription": "쿨만 많이 줬어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.346,
                "end": 48.317
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 음유시인 올쿨 피라미드 올쿨 2번째 대결은 여러분들 좋은 쿠키들 뒤로 싹 다 넣어세요 그냥.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.327,
                "end": 54.198
            },
            {
                "speaker_id": "1",
                "transcription": "3번째 4번째 쓰지도 않았어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.208,
                "end": 56.307
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 솔직히 막 넣은 거거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.317,
                "end": 58.242
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아예 쓰지도 않았으니까 여러분들 남는 덱에 넣어주시면 되고 이거 한방에 클리어할 수 있는데 미봉비분 화관 낫쓰고 요렇게 다 있는데 제일 중요한 거는 호밀한테 화관이 들어가야 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.252,
                "end": 69.284
            },
            {
                "speaker_id": "1",
                "transcription": "공격력은 이 호밀이 제일 높게 끔 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.294,
                "end": 72.609
            },
            {
                "speaker_id": "1",
                "transcription": "아몬드는 쿨 공속없이 그냥 올 아몬드 얘는 공치 높게 캡틴캐비어도 그냥 공치 높게 소르베도 그냥 공치 얘는 그냥 올쿨 덱 하나로 하는 방법은 여기 세팅에서 얘 아몬드로 다 도배해도 될 거 같긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.619,
                "end": 86.356
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 되게 날먹이 되는 역대 쉬운 시즌 요렇게 1등으로 리뷰 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.366,
                "end": 100.750
            }
        ]
    },
    "summary": "제가 전체 1등 차지했고 어떤 조합인지 알려드리면 레전드, 고대 하나도 쓰지 않았고 자색 고구마, 올 아몬드, 마카롱 올쿨을 피감 없이 썼는데 토벌에서 쓰는 거 그대로 썼다가 죽었기 때문에 피감은 넣어주시고 오징어먹물에도 쿨만 줬고 2번째 대결은 여러분들이 좋은 쿠키 다 넣으셔도 됩니다.",
