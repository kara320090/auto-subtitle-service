        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피시에서 즐길 때 녹스앱플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.688
            },
            {
                "speaker_id": "1",
                "transcription": "방치형 모바일 게임을 편하게 모니터링 가능하며 핸드폰 발열이나 배터리 부족으로 인한 불편함도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.698,
                "end": 8.251
            },
            {
                "speaker_id": "1",
                "transcription": "피시에서 큰 화면에 초고화질로 몰입할 수 있는 녹스앱플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.261,
                "end": 12.310
            },
            {
                "speaker_id": "1",
                "transcription": "아맞다. 이거 처음에 여러분들 1배속으로 해야 되는 거 알아요?",
                "sound_type": [
                    2
                ],
                "start": 12.320,
                "end": 15.913
            },
            {
                "speaker_id": "1",
                "transcription": "배속 높이면은 마지막에 스킬 쓰면서 지나가거나 그렇거든요?",
                "sound_type": [
                    2
                ],
                "start": 15.923,
                "end": 21.294
            },
            {
                "speaker_id": "1",
                "transcription": "근데 1배속으로 하면은 마지막 몹을 그냥 지나가게 되고 아무튼 이거 배속 차이도 있으니까 여러분들 한번 차이 비교해보세요.",
                "sound_type": [
                    2
                ],
                "start": 21.304,
                "end": 29.208
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 유물에 따라서 이게 질주하는 거리가 달라지거든요?",
                "sound_type": [
                    2
                ],
                "start": 29.218,
                "end": 33.552
            },
            {
                "speaker_id": "1",
                "transcription": "네 그거 한번 테스트해보세요.",
                "sound_type": [
                    2
                ],
                "start": 33.562,
                "end": 35.127
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이게 1배속으로 하면은 저 마지막 애들 지나가잖아요?",
                "sound_type": [
                    2
                ],
                "start": 35.137,
                "end": 39.935
            },
            {
                "speaker_id": "1",
                "transcription": "근데 1배속 안 하면은 2.5배속 하면은 마지막 애들한테 스킬 쓰면서 지나가요.",
                "sound_type": [
                    2
                ],
                "start": 39.945,
                "end": 46.754
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 시계 야 시계 왜 나 이거 커먼 시계냐?",
                "sound_type": [
                    2
                ],
                "start": 46.764,
                "end": 53.000
            }
        ]
    },
    "summary": "남성은 유물에 따라서 질주하는 거리가 달라지기 때문에 배속을 높이지 말고 1배속으로 해야 마지막에 스킬을 안 쓰고 지나간다고 했다.",
