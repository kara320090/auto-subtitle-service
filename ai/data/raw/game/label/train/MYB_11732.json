        "term": [
            {
                "speaker_id": "1",
                "transcription": "전반적으로 한번 훑어보는 시간을 가지고 9일 뒤에는 파판으로 뵙도록 하겠겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.146
            },
            {
                "speaker_id": "1",
                "transcription": "정말 하 너무너무 재밌네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.156,
                "end": 7.240
            },
            {
                "speaker_id": "1",
                "transcription": "아 암튼 여기서 유튜브 각은 이제 종료를 좀 해 보고 방송도 이제 이쯤에서 종료를 해보고 내일 만나는 시간 가지도록 하겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.250,
                "end": 18.720
            },
            {
                "speaker_id": "1",
                "transcription": "빨리 인제 섬네일 이거 해 가지고 유튜브에 올릴 수 있도록 해 보겠겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.730,
                "end": 23.517
            },
            {
                "speaker_id": "1",
                "transcription": "암튼 유바 고맙습니다.",
