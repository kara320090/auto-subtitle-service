        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "잠시 광고 이벤트 홍보하고 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.331
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 출시된 비에이디포 스킨 뽑기에 쓸 수 있는 무지개 큐브를 제품 구매 이벤트로 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.341,
                "end": 7.571
            },
            {
                "speaker_id": "1",
                "transcription": "300개 쿠폰 1000장 총 30만 무지개 큐브가 준비되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.581,
                "end": 11.479
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 바다요정 띠부실 5종 가운데 1개를 랜덤으로 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.489,
                "end": 15.884
            },
            {
                "speaker_id": "1",
                "transcription": "제품을 구매하는 개수에 따라 추가로 무지개 쿠폰을 더 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.894,
                "end": 19.461
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 솔티 크리미 클렌징 폼은 제품 만족도가 최고입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.471,
                "end": 23.445
            },
            {
                "speaker_id": "1",
                "transcription": "트러블 피부가 좋아지고 순하고 무자극에 당김없이 촉촉하게 피부를 유지해 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.455,
                "end": 28.928
            },
            {
                "speaker_id": "1",
                "transcription": "사용 방법은 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.938,
                "end": 30.701
            },
            {
                "speaker_id": "1",
                "transcription": "세안시 적당량을 펌핑하여 피부결을 따라 마사지 하고 미온수로 깨끗이 헹구어 내면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.711,
                "end": 36.405
            },
            {
                "speaker_id": "1",
                "transcription": "영상 설명란이나 고정 댓글에 있는 엔디러너 팬카페 링크를 통해 들어가셔서 제품 구매 인증란에 인증하시면 선착순 10명에게 각각 무지개 큐브 3000개씩 추가로 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.415,
                "end": 47.524
            },
            {
                "speaker_id": "1",
                "transcription": "추가 무지개 쿠폰은 제품 구매시 할인 코드 적용란에 엔디엔디 소문자 입력을 해야만 더 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.534,
                "end": 54.290
            },
            {
                "speaker_id": "1",
                "transcription": "제품 구매 사이트 링크는 영상 설명란과 고정 댓글에 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.300,
                "end": 58.832
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 제가 볼 때는 쿨타임이 13초네요 13초면은 자 시작 쿨타임이 10.3퍼센트 이상이 되어야만 시작 쿨타임이 3초로 바뀌거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.842,
                "end": 70.123
            },
            {
                "speaker_id": "1",
                "transcription": "일단 4피 1쿨로 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.133,
                "end": 71.695
            },
            {
                "speaker_id": "1",
                "transcription": "네 일단 요렇게 맞춰볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.705,
                "end": 73.187
            },
            {
                "speaker_id": "1",
                "transcription": "올 라즈 해달라는 분 아까 있었잖아요 올 라즈도 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.197,
                "end": 76.677
            },
            {
                "speaker_id": "1",
                "transcription": "올 라즈로 하되 대신에 쿨을 좀 높일게요 얘는 쿨이 좀 필요한 것 같거든요.",
                "sound_type": [
