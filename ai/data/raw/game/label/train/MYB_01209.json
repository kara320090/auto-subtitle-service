        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그냥 싹 싹 싹 싹 너무하지 않습니까.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.584
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때 이거는 아 이거 이렇게 무승부가 나올 수도 있겠네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.594,
                "end": 14.794
            },
            {
                "speaker_id": "1",
                "transcription": "약간 이런 거 보면은 안전하게는 무승부 안 나오게 하려면은 공속을 좀 높여주는 것도 좋을 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.804,
                "end": 21.054
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 빠르게 때릴 수 있게끔 해주는 것도 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.064,
                "end": 24.258
            },
            {
                "speaker_id": "1",
                "transcription": "자 드디어 나왔다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.268,
                "end": 25.637
            },
            {
                "speaker_id": "1",
                "transcription": "제가 만나보고 싶은 스타더스트 덱 스타더스트 덱은 질 확률이 좀 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.647,
                "end": 30.230
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 스타더스트는 공격 대상이 후방을 때리는 게 아니라 네 전방을 때리기 때문에 어 엄청난 폭딜이 전방에 피해가 와서 실론나이트가 죽을 가능성이 상당히 큽니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.240,
                "end": 44.434
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 제가 아까 말씀드렸듯이 피해 감소랑 치명타 피해가 높다면은 그래도 어느 정도 괜찮을 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.444,
                "end": 52.480
            },
            {
                "speaker_id": "1",
                "transcription": "세팅만 여러분들 신경 잘 써주시면은 나머지가 죽으면 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.490,
                "end": 57.335
            },
            {
                "speaker_id": "1",
                "transcription": "아 요 자 요거 안타깝게",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.345,
                "end": 62.200
            }
        ]
    },
    "summary": "무승부가 안 나오게 하려면 공속을 높여서 빠르게 때릴 수 있게 해주는 것이 좋고 제가 만나보고 싶은 스타더스트 덱에는 질 확률이 있는데 엄청난 폭딜이 전방에 피해가 와서 실론나이트가 죽을 가능성이 크지만 피해 감소랑 치명타 피해가 높으면 어느 정도 괜찮을 것 같고 세팅만 잘 신경 쓰고 나머지가 죽으면 된다.",
