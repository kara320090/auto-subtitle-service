        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 쓰고 올렸어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.068
            },
            {
                "speaker_id": "1",
                "transcription": "얼마 전 죽은 베어러 중에 내 딸이 있었다.",
                "sound_type": [
                    2
                ],
                "start": 3.078,
                "end": 6.512
            },
            {
                "speaker_id": "1",
                "transcription": "딸을 관청에 맡긴 후로 딸과는 1번도 만나지 않았다.",
                "sound_type": [
                    2
                ],
                "start": 6.522,
                "end": 9.219
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 군 기록에는 사망한 베어러가 틀림없이 내 딸이라고 기재되어 있었다.",
                "sound_type": [
                    2
                ],
                "start": 9.229,
                "end": 13.043
            },
            {
                "speaker_id": "1",
                "transcription": "나는 줄곧 내 딸을 학대해 온 것이었다.",
                "sound_type": [
                    2
                ],
                "start": 13.053,
                "end": 16.365
            },
            {
                "speaker_id": "1",
                "transcription": "오늘도 다른 소녀가 끼니를 얻기 위해 아내와 꼭 닮은 얼굴로 나에게 미소를 짓는다.",
                "sound_type": [
                    2
                ],
                "start": 16.375,
                "end": 21.040
            },
            {
                "speaker_id": "1",
                "transcription": "이것은 베어러를 낳았다는 죄로 아내를 죽인 저주일까?",
                "sound_type": [
                    2
                ],
                "start": 21.050,
                "end": 24.001
            },
            {
                "speaker_id": "1",
                "transcription": "미친놈이네.",
                "sound_type": [
                    2
                ],
                "start": 24.011,
                "end": 24.910
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 자식의 딸을 죽인 저주",
                "sound_type": [
                    2
                ],
                "start": 24.920,
                "end": 27.766
            }
        ]
    },
    "summary": "얼마 전에 죽인 베어러 중에 내 딸이 있었고 딸을 관청에 맡기고 1번도 만나지 않았으며 베어러를 낳았다는 죄로 아내를 죽였다.",
