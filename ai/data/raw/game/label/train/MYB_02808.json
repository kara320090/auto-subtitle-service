        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 깨졌죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 0.872
            },
            {
                "speaker_id": "1",
                "transcription": "깨지고 발동되게끔 자 그다음에 블랙베리 예약 이 약하네 비석.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.882,
                "end": 6.933
            },
            {
                "speaker_id": "1",
                "transcription": "쟤 깨지거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.943,
                "end": 8.764
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우는 얘는 비석 칸이 1칸 남았을 때 발동해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.774,
                "end": 12.985
            },
            {
                "speaker_id": "1",
                "transcription": "1칸 남았을 때 호밀을 발동 너무 일찍 하면은 비석에 손실 나니까 여러분들 막 이 깨질 때쯤 여러분들 나름의 타이밍 잡아서 하시면 되고 예 마카롱 예약 마카롱 바로 눌러주시구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.995,
                "end": 26.483
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 슈크림 눌러주고 네 블랙베리 여기 중요해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.493,
                "end": 32.570
            },
            {
                "speaker_id": "1",
                "transcription": "이거 이렇게 하고 이렇게 순서대로 하고 오징어 먹물 발동되면 안 되고 호밀을 바로 예약 이거 발동되면 안 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.580,
                "end": 42.511
            },
            {
                "speaker_id": "1",
                "transcription": "자 호밀 발동되면은 슈크림",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.521,
                "end": 46.000
            }
        ]
    },
