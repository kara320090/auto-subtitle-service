        "term": [
            {
                "speaker_id": "1",
                "transcription": "한가하군 소울 잼 연구가 끝날 때까지 그저 기다리고만 있으면 되는 건가?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.166
            },
            {
                "speaker_id": "2",
                "transcription": "아 몸이 근질거려 미치겠군.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 7.176,
                "end": 9.894
            },
            {
                "speaker_id": "2",
                "transcription": "매일 설산을 지키던 나에게 이런 조용한 도시 구경은 어울리지 않아.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 9.904,
                "end": 14.616
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 뭘 할 셈이지?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 14.626,
                "end": 16.293
            },
            {
                "speaker_id": "2",
                "transcription": "야시장 야시장을 다시 한번 가봐야겠어.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 16.303,
                "end": 19.789
            },
            {
                "speaker_id": "2",
                "transcription": "왠지 엄청나게 수상해 보였다고.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 19.799,
                "end": 22.565
            },
            {
                "speaker_id": "1",
                "transcription": "분위기가 조금 다른 것만 빼면 평범한 시장이던데.",
                "sound_type": [
                    1,
                    2,
