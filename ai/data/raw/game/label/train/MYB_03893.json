        "term": [
            {
                "speaker_id": "1",
                "transcription": "복귀 해야 되나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.122
            },
            {
                "speaker_id": "1",
                "transcription": "복귀하실 분들은 그런 분들이 꼭 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.132,
                "end": 3.755
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 보면서 아 복귀 언제 하지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.765,
                "end": 6.229
            },
            {
                "speaker_id": "1",
                "transcription": "다음 업데이트에 할까 오늘 할까 내일 할까 어우 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.239,
                "end": 11.254
            },
            {
                "speaker_id": "1",
                "transcription": "바요 그런 분들 있잖아요 지금 당장 하셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.264,
                "end": 14.546
            },
            {
                "speaker_id": "1",
                "transcription": "지금 당장 킹덤은 시간이 곧 과금이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.556,
                "end": 17.844
            },
            {
                "speaker_id": "1",
                "transcription": "시간이 곧 과금 그래서 복귀 유저 분들이 항상 하는 말이 말이 뭐가 있냐면 아 따라가기 힘들다 이 얘기를 항상 하는데 어차피 나중에 해도 따라가기 힘들고 지금 해도 똑같이 힘든 건 맞지만 그래도 이벤트로 뿌리는 보상을 미리미리 받아서 한 사람은 그만큼 그래도 좀 덜 해요.",
                "sound_type": [
                    2,
