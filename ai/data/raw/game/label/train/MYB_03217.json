        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "에클레어가 죽어도 잡는 거는 문제가 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.692
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 시간이 좀 어느 정도 남아 있어도 13단계 잡는 데는 전혀 지장이 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.237,
                "end": 8.867
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파이어 보세요 딜이 이렇게 많이 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.287,
                "end": 11.847
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 보통은 이렇게까지 티켓을 안 써요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.995,
                "end": 15.027
            },
            {
                "speaker_id": "1",
                "transcription": "대천사나 감초에다가 티켓을 쓰는 경우가 많기 때문에 이렇게까지 오는 단계는 거의 없겠지만 그래도 여기까지 한 방 컷으로 이제 끝낼 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.252,
                "end": 23.650
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 자 디버프 13까지 올라갔을 때 여기 이 숫자 보고 그냥 이렇게 눌러주고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.332,
                "end": 29.666
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 그냥 1.5배속하고 네 이렇게 눌러주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.676,
                "end": 33.537
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파가 죽을 경우가 이 생겨요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.665,
                "end": 35.810
            },
            {
                "speaker_id": "1",
                "transcription": "죽는 경우에는 뱀파 바로 눌러주지 마시고 방깎이 꼭 들어간 다음에 눌러줘야만 딜이 제대로 들어가기 때문에 그것만 지켜주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.890,
                "end": 45.232
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 제가 밀키웨이 지금 디버프 썼는데 방깎 하나 더 들어갔죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.577,
                "end": 49.852
            },
            {
                "speaker_id": "1",
                "transcription": "방금 같은 경우에는 밀키웨이 좀 늦게 써주는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.112,
                "end": 52.947
            },
            {
                "speaker_id": "1",
                "transcription": "좀 밀렸다고 싶으면은 앞에 가서 밀키웨이 써주면 방깎 손해는 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.165,
                "end": 57.497
            },
            {
                "speaker_id": "1",
                "transcription": "네 그거와 상관없이 그냥 눌러도 보시는 거와 같이 18단계까지 1억 3480만 자 딜 보게 되면 뱀파는 무슨 8000만 아포가토는 3000만",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.507,
                "end": 67.958
            }
        ]
    },
    "summary": "에클레어가 죽어도 13단계 잡는 데는 전혀 지장이 없으며 뱀파이어는 딜이 많이 나오고 보통 티켓은 대천사나 감초에다가 많이 쓰며 디버프 13까지 올라갔을 때 1.5배속 하고 나머지를 누르면 되는데 뱀파가 죽는 경우가 생기면 꼭 방깎이 들어간 다음에 눌러줘야만 딜이 제대로 들어가며 밀키웨이를 좀 늦게 쓰는 것이 좋고 좀 밀렸다 싶으면 앞에 가서 밀키웨이를 쓰면 방깎 손해가 없으며 18단계까지 딜을 보면 1억 3480만인데 뱀파가 8000만 아포가토가 3000만이다.",
