        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 맞나 싶다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.488
            },
            {
                "speaker_id": "1",
                "transcription": "아니 근데 이거 용과 타이밍이 모든 걸 결정하는 거 같애.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.498,
                "end": 6.361
            },
            {
                "speaker_id": "1",
                "transcription": "암만 그래도 야 이거는 좀 약간 타이밍이 또 다르네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.371,
                "end": 20.903
            },
            {
                "speaker_id": "1",
                "transcription": "아 어? 온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.913,
                "end": 35.881
            },
            {
                "speaker_id": "1",
                "transcription": "야 이게 이게 더 확실하게 더 이기네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.891,
                "end": 38.698
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 뭐냐?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.708,
                "end": 39.998
            },
            {
                "speaker_id": "1",
                "transcription": "이게 더 확실하게 이기는 느낌이긴 해.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.008,
                "end": 42.493
            },
            {
                "speaker_id": "1",
                "transcription": "나쁘지 않은데 이제 본격적으로 해볼 수 있는 거는 완벽하게 홀베를 대추 대체할 수 있냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.503,
                "end": 51.609
            },
            {
                "speaker_id": "1",
                "transcription": "저는 그게 제일 궁금하거든요?",
