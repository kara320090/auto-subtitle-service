                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 근데 내가 딴 것 보다 제일 힘든 거는 진짜 커피 끊는 게 제일 힘들었어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.605
            },
            {
                "speaker_id": "1",
                "transcription": "4일째 안 먹고 이제 아예 끊었는데 와 진짜 커피 맨 처음에 카페인을 못 먹으니까 첫날부터 막 힘이 없는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.615,
                "end": 14.180
            },
            {
                "speaker_id": "1",
                "transcription": "방송을 해도 진짜 쳐지고 지금은 쫌 많이 괜찮아졌는데 와 커피 끊는 게 제일 힘들었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.190,
                "end": 20.776
            },
            {
                "speaker_id": "1",
                "transcription": "커피부터가 1차 고비였어.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.786,
                "end": 23.861
            },
            {
                "speaker_id": "1",
                "transcription": "카페인이 거의 하루에 카페인 2, 3잔 기본으로 마셨어 가지고 지금은 그래도 괜찮습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.871,
                "end": 29.905
            },
            {
                "speaker_id": "1",
                "transcription": "커피는 다이어트에 좋다구요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.915,
                "end": 32.091
            },
            {
                "speaker_id": "1",
                "transcription": "누가 그래요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.101,
                "end": 33.141
            },
            {
                "speaker_id": "1",
                "transcription": "커피가 어떻게 다이어트에 좋아.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 33.151,
                "end": 35.087
            },
            {
                "speaker_id": "1",
                "transcription": "커피 보통 일어나자 마자 한 잔 아예 다 끊었어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.097,
                "end": 40.669
            },
            {
                "speaker_id": "1",
                "transcription": "담배는 아예 안 피워.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.679,
                "end": 42.687
            },
            {
                "speaker_id": "1",
                "transcription": "술 담배는 원래 안 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.697,
                "end": 46.135
            },
            {
                "speaker_id": "1",
                "transcription": "술도 그렇게 좋아하진 않아서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.145,
                "end": 48.464
            },
            {
                "speaker_id": "1",
                "transcription": "자 크림 유니콘 아니 다른 것도 원래 제가 패턴이 방송하는 사람들 알겠지만 방송이 원래 새벽에 끝나고 그러면은 그 때 밥을 먹어요 보통.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.474,
                "end": 59.195
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 그 때 밥 먹고 깨어있다가 하면은 또 이제 밤 낮 바뀌고 그러거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 59.205,
                "end": 63.458
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 밤에 잘라고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.468,
                "end": 65.800
            }
        ]
    },
    "summary": "남성은 커피 끊는 것이 제일 힘들었다고 말하고 있다.",
