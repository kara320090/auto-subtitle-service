        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 용쿠 시대는 끝났습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.383
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 이제 기존에 한방덱에 항상 들어갔던 용감한 쿠키 자리에 찰스가 들어왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.393,
                "end": 9.603
            },
            {
                "speaker_id": "1",
                "transcription": "정말 사기적이고 물론 모든 덱에서 다 지금 0티어로 쓰이고 있고 지금 능력을 보게 되면 왜 용쿠 자리에 대체가 됐냐면 얘가 시작 쿨타임이 2초이기 때문에 전체 상대 스턴을 걸고 들어가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.613,
                "end": 22.073
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 능력 자체가 평타 기절 그다음에 공격력 증가에다가 해머 디버프에다가 망치 피해량도 좋고 공격력 증가에다 공속 증가에다가 피해 감소 버프.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.083,
                "end": 32.732
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 모든 사기적인 버프를 다 안고 나온 그런 쿠키이기 때문에 일단 세팅 자체는 블랙펄 쿠키가 안 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.742,
                "end": 40.659
            },
            {
                "speaker_id": "1",
                "transcription": "무공비, 공속, 그다음에 아이스크림이 들어가고 자 찰스 쿠키는 여러분 세팅이 너무 쉬워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.669,
                "end": 47.765
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 공속만 망토 보물 적용 받게끔 공속만 주고 피감도 여러분 적당히 주시면 되고 구미호 쿠키 같은 경우에도 쿨은 그냥 올쿨만 세팅해주시면 되고 공격 속도도 망토만 받으면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.775,
                "end": 60.358
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 캡틴캐비어 같은 경우에도 쿨타임 8퍼센트 권장입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.368,
                "end": 63.676
            },
            {
                "speaker_id": "1",
                "transcription": "피감보다는 그래도 여러분들 공치 높게 해주는 게 더 좋을 것 같고 그다음에 바요도 공격력만 높게 피감 적당히 오징어먹물도 쿨 공속 필요 없습니다. 그냥.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.686,
                "end": 73.620
            },
            {
                "speaker_id": "1",
                "transcription": "공격력하고 치명좀 신경 써주고 피감도 적당히 있으면 좋을 것 같아요.",
