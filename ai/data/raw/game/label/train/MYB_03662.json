                ],
                "start": 4.947,
                "end": 7.195
            },
            {
                "speaker_id": "1",
                "transcription": "이런 분들 특징 토핑작이 거의 안 되어있다. 그렇죠.",
                "sound_type": [
                    2,
                    3,
                    5
