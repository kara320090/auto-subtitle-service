        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 바다요정의 생존이 너무 약해서 죽어있는 바다요정의 부활을 알리는 그런 업데이트가 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.750
            },
            {
                "speaker_id": "1",
                "transcription": "자 아군들 전방에 크림슨코랄 쿠키 홀로 전투에 참여할 경우 산호의 갑옷 효과를 받고요 산호의 갑옷은 본인과 아군을 강화시키는 이로운 효과를 발동시킨다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.760,
                "end": 19.739
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 홀로 전투에 참여한다 전방에 홀리베리 대신에 얘 혼자 쓸 수도 있을 것 같고요 추가로 크기와 무게가 커서 넉백과 에어본 효과가 감소한다고 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.749,
                "end": 31.084
            },
            {
                "speaker_id": "1",
                "transcription": "크림슨코랄 쿠키는 스킬을 사용할 때 공격 속도 증감의 영향을 받지 않고 스킬 시전 방해 효과에 강해진다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.094,
                "end": 38.095
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 이제 뽑기 방법에 대해서 나와있고요 자 그리고 게스트 등급이 나와서 예 뽑기가 뭐 새롭게 나올 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.105,
                "end": 46.092
            },
            {
                "speaker_id": "1",
                "transcription": "예 얘네들은 전투나 뭐 성장 관련 활동에는 참여하지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.102,
                "end": 50.813
            },
            {
                "speaker_id": "1",
                "transcription": "자 대난투가 이번에 이제 새롭게 나오고요 최소 레벨 최소 스킬 적용이 되고 네 토핑 능력같은 경우에도 세부 부옵션은 적용되지 않는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.823,
                "end": 61.567
            },
            {
                "speaker_id": "1",
                "transcription": "이번 대난투같은 경우에는 뭐 이렇게 바다의 격류 효과 그리고 물의 보호 효과 특별한 규칙이 적용되는데 이거는 나중에 리뷰할 때 제가 세세하게 다뤄 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.567,
                "end": 72.706
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 대난투 티어랑 뭐 인연의 홀에 이번에 크림슨코랄이 추가가 되고요 신규 데코 추가 개선에는 횃불이 예 9999개에서 9만 9999로 개선",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.716,
                "end": 85.170
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 뭐 아이콘같은 경우에도 이렇게 개편된다 뭐 큰 틀은 대난투 컨테츠 추가 그리고 게스트 등급의 보석인어 쿠키 그리고 슈퍼 에픽의 크림슨코랄 쿠키, 얼파타 콘텐츠 이렇게 보면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.170,
                "end": 99.969
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트는 8월 30일날 되니까 제가 리뷰 방송을 진행할거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.979,
                "end": 104.071
            },
            {
                "speaker_id": "1",
                "transcription": "구독과 좋아요 한번씩만 여러분들 부탁드립니다 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 104.081,
                "end": 123.933
            }
        ]
    },
    "summary": "업데이트의 큰 틀은 대난투 컨테츠 추가 그리고 게스트 등급의 보석인어 쿠키 그리고 슈퍼 에픽의 크림슨코랄 쿠키, 얼파타 콘텐츠 이렇게 보면 될 것 같다.",
