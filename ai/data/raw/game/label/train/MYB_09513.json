        "term": [
            {
                "speaker_id": "1",
                "transcription": "에디타 지음 여왕과 고블린 호수에는 여왕과 고블린 세 마리가 살았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.966
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 고블린들은 장난꾸러기였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.976,
                "end": 6.817
            },
            {
                "speaker_id": "1",
                "transcription": "화가 난 여왕은 고블린들을 호수에서 내쫓았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.827,
                "end": 9.874
            },
            {
                "speaker_id": "1",
                "transcription": "고블린들은 입이 까매질 때까지 진흙을 먹는 빨리 호수에 돌아가고 싶다며 울었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.884,
                "end": 14.615
            },
            {
                "speaker_id": "1",
                "transcription": "그것을 가엾게 여긴 여왕은 투수들을 용서하고 방송으로 돌아오게 해주었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.625,
                "end": 20.916
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 오래오래 행복하게 살았답니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.926,
                "end": 24.433
            }
        ]
    },
    "summary": "한 여성이 영상을 보며 내용을 설명하고 있다.",
