    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 @이름1 님 계정 평가 가도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.080
            },
            {
                "speaker_id": "1",
                "transcription": "와 왕꾸가 오 이게 뭐죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.080,
                "end": 6.673
            },
            {
                "speaker_id": "1",
                "transcription": "왕꾸 되게 신박한 거 같아 자 일단 이분 사연을 보게 되면은 시작한 지 3개월에서 4개월 정도밖에 안 안 돼서 아래나 메인 덱 위주로만 성장하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.673,
                "end": 19.131
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 덱 성전 덱이 많이 약한 편이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.141,
                "end": 22.217
            },
            {
                "speaker_id": "1",
                "transcription": "스토리는 어둠 14 중반에서 막혀서 어둠 14 마스터 클리어 덱도 키울 예정입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.227,
                "end": 27.560
            },
            {
                "speaker_id": "1",
                "transcription": "진행도에 비해 연구소나 테크가 많이 올려져 있지 않은 것 같아서 조언이 필요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.560,
                "end": 33.088
            },
            {
                "speaker_id": "1",
                "transcription": "재고 관리는 수능 치르느라 시간을 많이 할애하지 못해서 잘 안 돼 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.098,
                "end": 40.726
            },
            {
                "speaker_id": "1",
                "transcription": "과금은 이것저것 해서 140만 원 정도 과금했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.733,
                "end": 44.302
            },
            {
                "speaker_id": "1",
                "transcription": "스킨 콜라보 현질을 꽤 해서 스펙이 높지는 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.312,
                "end": 48.033
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 그러면은 왕국 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.043,
                "end": 51.196
            },
            {
                "speaker_id": "1",
                "transcription": "46레벨 어 소원나무 납부 보니까 그래도 열심히 하고 계시네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.206,
                "end": 55.971
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키 상태는 야 그래도 과금을 하신 게 진짜 티가 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.981,
                "end": 61.383
            },
            {
                "speaker_id": "1",
                "transcription": "야 BTS 쿠키 여기에 과금을 좀 하셨군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.393,
                "end": 66.040
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스는 10레벨 쿠키성 12성 13성까지는 무조건 찍어서 올려주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.050,
                "end": 72.740
            },
            {
                "speaker_id": "1",
                "transcription": "노움 연구소 보게 되면은 대장간이 잘못되어 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.750,
                "end": 76.564
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 무조건 많이 올려야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.574,
                "end": 78.558
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보면 연구 가속하고 있으시거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.568,
                "end": 81.233
            },
            {
                "speaker_id": "1",
                "transcription": "일단 요거 연구 가속 찍는 거 잘한 선택인데 요거 그 금방 하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.226,
                "end": 86.440
            },
            {
                "speaker_id": "1",
                "transcription": "5레벨까지 먼저 찍고 나중에 연구 가속 다 하시면은 이런 재료 생산 가속이나 우유 네 요런 거 좀 올려주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.450,
                "end": 95.600
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 연구 이거 왜 안 하셨어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.610,
                "end": 97.340
            },
            {
                "speaker_id": "1",
                "transcription": "이거 진짜 필수입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.333,
                "end": 98.609
            },
            {
                "speaker_id": "1",
                "transcription": "토핑작 하려면은 이거 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.619,
                "end": 101.183
            },
            {
                "speaker_id": "1",
                "transcription": "모든 쿠키 공격력 증가나 나머지 요런 거는 일단 왕국 연구 먼저 좀 집중적으로 하고 나서 그때 해도 늦지 않으니까 좀 되게 효율적으로 하는 거를 추구하는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.193,
                "end": 114.208
            }
        ]
    },
    "summary": "쿠키 공격력 증가나 나머지는 왕국 연구 먼저 집중적으로 하고 나서 해도 늦지 않는다고 한다.",
