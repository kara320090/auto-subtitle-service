        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 보면은 이 덱입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.137
            },
            {
                "speaker_id": "1",
                "transcription": "자 보게 되면은 아니 퓨어바닐라가 당연히 좋으니까 퓨바를 써야지. 라고 생각할 수 있는데 퓨바 대신에 허브가 들어갔고 그다음에 예언자맛 쿠키 여러분들이 잘 모르시는 분도 있겠지만 힐을 해 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.147,
                "end": 15.024
            },
            {
                "speaker_id": "1",
                "transcription": "아군한테 힐을 해 주는 능력이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.034,
                "end": 16.987
            },
            {
                "speaker_id": "1",
                "transcription": "근데 지금 보통은 다른 덱을 보면 3번 4번 5번 웬만해서는 모노클 쓰는 덱이 많아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.997,
                "end": 22.820
            },
            {
                "speaker_id": "1",
                "transcription": "모노클을 써서 디버프 제거를 해 주는 대신에 얘 같은 경우는 허브맛 쿠키가 디버프 제거를 해 주고 네 호루라기 써 가지고 아군의 공격력을 증가시켜 주고 딜러들 이렇게 쓰는 구조로 사용하게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.830,
                "end": 36.428
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑 같은 경우에는 홀리베리는 올 아몬드 쿨은 7퍼센트 이상만 돼도 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.438,
                "end": 41.650
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 소르베 같은 경우에는 22퍼센트 이상 달빛도 22퍼센트 이상 피감은 여러분들 능력껏 어느 정도 맞춰 주시고 그다음에 예언자맛 쿠키 같은 경우에는 서리여왕 능력을 복사해야 되기 때문에 10퍼센트 이상에다가 소수점 첫째 자리를 9퍼센트로 맞춰 줘야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.660,
                "end": 58.220
            },
            {
                "speaker_id": "1",
                "transcription": "그래야 서리 능력이 복사가 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.230,
                "end": 60.677
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 허브맛 쿠키 같은 경우에는 쿨 굳이 이렇게 안 줘도 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.687,
                "end": 64.202
            },
            {
                "speaker_id": "1",
                "transcription": "저 아까 방 덱 잘 막는 분은 쿨 타임 없이 그래도 피감만 신경 써 줬는데 제 생각에는 그냥 제가 테스트해 본 결과 큰 차이가 없는 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.212,
                "end": 73.405
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 저는 쿨 없이도 괜찮으니까 여러분들이 피감 신경 쓰고 공속이 높아지면 아군의 힐을 더 많이 빨리 줄 수 있고 공격력이 높으면 힐량도 증가되기 때문에 여러분들이 부옵션 여유되는 대로 해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.415,
                "end": 86.952
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 아까 디버프 얘기하다 말았는데 디버프는 허브맛 쿠키 능력 발동 시 디버프가 제거되는 거니까 이 구역이랑은 상관이 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.962,
                "end": 96.766
            }
        ]
    },
    "summary": "남성이 구성된 쿠키들의 토핑 설정 설명을 한다.",
