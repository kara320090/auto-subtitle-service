                    5
                ],
                "start": 3.003,
                "end": 8.590
            },
            {
                "speaker_id": "1",
                "transcription": "왜 이렇게 생태계가 파괴된 느낌이냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.585,
                "end": 10.492
            },
            {
                "speaker_id": "1",
                "transcription": "어 뭔가 되게 진짜 사기적인 느낌이지?",
