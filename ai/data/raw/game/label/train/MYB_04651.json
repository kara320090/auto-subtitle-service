        "term": [
            {
                "speaker_id": "1",
                "transcription": "초보자분들이나 복귀 유저분들은 어떤 쿠키에 무슨 토핑을 써야 되는지 잘 모를 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.363
            },
            {
                "speaker_id": "1",
                "transcription": "고인물분들을 위한 토핑 정리가 아니라 일반적으로 무난하게 추천드리는 거다 보니 완벽한 정답이 아니고 특수한 조합에 따라서는 토핑 세팅이 달라지는 쿠키도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.373,
                "end": 15.152
            },
            {
                "speaker_id": "1",
                "transcription": "최근 아레나 쿠키 티어표를 기준으로 0티어부터 6티어 쿠키들 순서로 정리해 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.162,
                "end": 20.435
            },
            {
                "speaker_id": "1",
                "transcription": "아레나, 스토리 모드, 수호성전 컨텐츠 별로 나누고 길드 토벌전 컨텐츠는 워낙 토핑 세팅이 세분화되고 복잡하기 때문에 관련 영상을 따로 참고해서 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.445,
                "end": 31.444
            },
            {
                "speaker_id": "1",
                "transcription": "고정 댓글이나 영상 설명란에 여러분들이 원하는 쿠키의 토핑 세팅 설명으로 바로 갈 수 있도록 타임라인 좌표를 적어놨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.454,
                "end": 39.046
            },
            {
                "speaker_id": "1",
                "transcription": "시간이 없으신 분들은 선택적으로 참고하시면 됩니다.",
