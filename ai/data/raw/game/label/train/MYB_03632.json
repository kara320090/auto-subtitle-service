        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 뭐 따로 중요한 건 없네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.124
            },
            {
                "speaker_id": "1",
                "transcription": "어 잠깐만 일부 기간제 아이템 이벤트 종료 시간 변경.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.134,
                "end": 6.994
            },
            {
                "speaker_id": "1",
                "transcription": "이거 잠깐만 왜 14시에서 5시로 바꿨다는 거는 이번 업데이트 2주년 업데이트 새벽에 하는 거 같은데? 새벽 5시에 하네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.004,
                "end": 15.466
            },
            {
                "speaker_id": "1",
                "transcription": "아 그니까 점검을 뭐 5시부터 10시나 뭐 그렇게까지 하는 거죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.476,
                "end": 18.848
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 나머지는 뭐 따로 뭐 중요한 건 없네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.858,
                "end": 22.591
            },
            {
                "speaker_id": "1",
                "transcription": "2주년 업데이트 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.601,
                "end": 24.109
            },
            {
                "speaker_id": "1",
                "transcription": "간혹 여러분 다른 분들이 이번 2주년 업데이트 왜 예언자만 나오냐 이런 소리가 있는데 제가 볼 때는 업데이트 2주년 전에 그냥 짧게 간단하게 업데이트되는 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.119,
                "end": 34.849
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때 예언자 맛 쿠키가 나왔다는 거는 마도시가 나올 예장 예상이라는 거고 마도시가 나온다는 거는 달빛 술사 레전드가 나온다는 얘기랑 똑같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.859,
                "end": 44.208
            },
            {
                "speaker_id": "1",
                "transcription": "네 그렇기 때문에 2주년은 제가 볼 때 99.9퍼센트 달빛 술사 레전드가 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.218,
                "end": 49.947
            },
            {
                "speaker_id": "1",
                "transcription": "고렇게 여러분들이 알아두시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.957,
                "end": 52.235
            },
            {
                "speaker_id": "1",
                "transcription": "자 1월 5일 업데이트 내용은 여기서 마치고 저 라이브 방송 저도 하니까 구독 좋아요 한 번씩만 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.245,
                "end": 61.958
            }
        ]
    },
    "summary": "화자가 이벤트 종료 시각이 14시에서 5시로 변경된 걸 보더니 이번 업데이트 점검은 5시부터 10시로 변경된 것 같다고 하며 예언자 맛 쿠키가 이번에 나온 건 마도시가 나올 예상이고 마도시가 나오면 2주년 때 달빛 술사가 99.9퍼센트 나올 것 같다고 한다.",
