        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 밀당 쌉 고수라뇨. 아니",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.164
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 지금 만약에 이거 진행하잖아요?",
                "sound_type": [
                    2
                ],
                "start": 2.174,
                "end": 4.306
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 적어도 3시간이에요.",
                "sound_type": [
                    2
                ],
                "start": 4.316,
                "end": 6.306
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 밤새고 내일 방송 못해.",
                "sound_type": [
                    2
                ],
                "start": 6.316,
                "end": 8.189
            },
            {
                "speaker_id": "1",
                "transcription": "내일 볼래 아니면은 오늘 하고 내일 안 볼래?",
                "sound_type": [
                    2
                ],
                "start": 8.199,
                "end": 12.008
            },
            {
                "speaker_id": "1",
                "transcription": "둘 중에 하나 골라 봐.",
