        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 목화 어디갔니?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.525
            },
            {
                "speaker_id": "1",
                "transcription": "괜찮아요 목화가 없어져도 다다다다다다다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.535,
                "end": 8.011
            },
            {
                "speaker_id": "1",
                "transcription": "네 보셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.021,
                "end": 10.825
            },
            {
                "speaker_id": "1",
                "transcription": "목화가 없어져도 클리어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.835,
                "end": 13.835
            },
            {
                "speaker_id": "1",
                "transcription": "와 소환덱이 돌아왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.845,
                "end": 17.366
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 아시는 그 블랙펄 5초월 클로티드도 높고 나머지 신규 쿠키도 5초월 필요 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.376,
                "end": 25.113
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 근본 요렇게 있으면은 정말 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.123,
                "end": 29.185
            },
            {
                "speaker_id": "1",
                "transcription": "힐량을 보면은 야 여러분들 이거 목화는 이제 BTS쿠키한테 힐량을 논할 때가 아니네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.195,
                "end": 38.093
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 압도적인 승리.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.103,
                "end": 40.057
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음 또 들어가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.067,
                "end": 42.096
            },
            {
                "speaker_id": "1",
                "transcription": "아 낫덱 이 낫덱은 비추입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.106,
                "end": 44.539
            },
            {
                "speaker_id": "1",
                "transcription": "부활덱한테만 들어가면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.549,
                "end": 46.267
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 낫으로 하면은 갑자기 뭐 뜬금사 하거나 뭐 그럴 가능성도 있는데 1번 전 들어가볼게요.",
                "sound_type": [
