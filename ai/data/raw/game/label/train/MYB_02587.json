        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 출시한 마라맛탕 바로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.227
            },
            {
                "speaker_id": "1",
                "transcription": "자 마라맛탕 같은 경우에 30강이 해보니까 매콤한 마라 철퇴에서 범위가 증가되고 철퇴 피해에 기절 2초 추가 기절까지 네 그리고 기절 면역 대상이 불속성 추가 피해추가 화상 피해량은 6초 동안 0.5초 마다 32.1퍼센트 피해",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.237,
                "end": 21.579
            },
            {
                "speaker_id": "1",
                "transcription": "매콤한 마라하면 아군의 전체 치명타 확률 12초 동안 25퍼센트 증가 중첩은 최대 1개",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.589,
                "end": 27.441
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 마탕 강화를 하게 되면은 마라맛 쿠키가 일반 공격시 피격 공격하면은 피격시 15초 동안 자신의 피해 감소가 1퍼센트가 증가되고 그리고 30강을 하게 되면은 40퍼센트까지 증가된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.451,
                "end": 43.454
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 매콤한 마라 추가 기능 12초 동안 불속성 피해 치명타 피해량이 15퍼센트 증가된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.464,
                "end": 49.988
            },
            {
                "speaker_id": "1",
                "transcription": "치명타율이 가장 높은 아군 둘 에게 치명타 확률 증가 버프 철퇴 피해량은 132 용암 폭발 피해량은 309 화상 피해량은 6초마다 0. 5 57.3",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.998,
                "end": 62.531
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 내가 볼 때 일단 올 쿨로 한번 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.541,
                "end": 65.521
            },
            {
                "speaker_id": "1",
                "transcription": "일단 세팅은 두 가지로 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.531,
                "end": 67.714
            },
            {
                "speaker_id": "1",
                "transcription": "라라지는 내가 볼 때 진짜 아닌 것 같고 쿨이랑 아몬드랑 자 쿨로 해서 일단 먼저 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.724,
                "end": 73.338
            },
            {
                "speaker_id": "1",
