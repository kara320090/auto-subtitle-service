        "term": [
            {
                "speaker_id": "1",
                "transcription": "30만 개 크탈 뽑기랑 복지권이 지금 엄청 많거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.356
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 커터만 해도 거의 770개가 넘는 뽑기량 이거 다 하면 20만개고 크탈 30만개까지 하면 550만개 뽑기랑 동일합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.366,
                "end": 14.970
            },
            {
                "speaker_id": "1",
                "transcription": "없는 쿠키는 없고 지금 찰스 5000까지 갈 예정이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.980,
                "end": 19.975
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 길드 뽑기도 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.985,
                "end": 22.134
            },
            {
                "speaker_id": "1",
                "transcription": "길드 뽑기 몇 개 있으시지 45만 개 네 요거 그냥 빠르게 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.144,
                "end": 26.051
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에는 이게 45만개면은 진짜 1시간 걸리고 그랬거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.061,
                "end": 30.005
            },
            {
                "speaker_id": "1",
                "transcription": "근데 요새는 45번만 누르면 되기 때문에 뭐 생각보다 오래 걸리지도 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.015,
                "end": 35.800
            }
        ]
    },
    "summary": "화자가 옛날에는 길드 뽑기가 45만 개면 1시가 걸렸지만 지금은 오래 걸리지 않는 다고 이야기하고 있다.",
