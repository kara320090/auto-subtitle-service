        "term": [
            {
                "speaker_id": "1",
                "transcription": "아레나 했을 때 블랙펄 쿠키가 캡틴 캐비어의 미사일을 다 몸으로 맞는지 그거 체크를 해주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.137
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프 딜이 상당히 높은 걸 알 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.147,
                "end": 10.538
            },
            {
                "speaker_id": "1",
                "transcription": "극과 극 비교 체험으로 제가 마법 사탕 나오기 전에 웨어울프를 똑같이 이 덱에 써봤거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.548,
                "end": 17.005
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때 딜이 얼마가 나왔냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.015,
                "end": 19.340
            },
            {
                "speaker_id": "1",
                "transcription": "놀랍게도 70만 딜 적게 나오면은 20만 딜 어 거의 딜이 몇 십 배 70만 딜 기준으로는 거의 8배 정도 딜이 올라갔다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.350,
                "end": 30.644
            },
            {
                "speaker_id": "1",
                "transcription": "마법 사탕 때문에 그렇게 보시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.654,
                "end": 33.616
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 네 2탱 낫은 또 3번 에클레어덱으로 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.626,
                "end": 40.200
            }
        ]
    },
    "summary": "웨어울프 딜이 상당히 높은데 마법 사탕이 나오기 전에 웨어울프를 똑같은 덱에서 써봤을 때와 비교하면 거의 8배 정도 딜이 올라갔다.",
