                "end": 8.147
            },
            {
                "speaker_id": "2",
                "transcription": "그 그치만",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.157,
                "end": 9.779
            },
            {
                "speaker_id": "1",
                "transcription": "다들 용을 너무 쉽게 생각하는 거 아냐?",
