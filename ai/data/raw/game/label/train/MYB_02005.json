                    3,
                    5
                ],
                "start": 9.789,
                "end": 12.908
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 용을 본 적이나 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.918,
                "end": 15.302
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키들은 용의 발톱보다도 작아.",
                "sound_type": [
                    2,
