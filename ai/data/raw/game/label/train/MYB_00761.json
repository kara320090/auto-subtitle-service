    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그리고 중요한 게 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.724
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 님 저는 블랙펄 안 키우는데 바다 요정 넣어도 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.734,
                "end": 5.490
            },
            {
                "speaker_id": "1",
                "transcription": "이런 질문하시는 분들 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.500,
                "end": 6.915
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄이 필수입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.924,
                "end": 8.402
            },
            {
                "speaker_id": "1",
                "transcription": "리더 효과 피해 감소 무시 이게 꼭 있어야지만 용과 드래곤의 활용 가치가 높아지는 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.550,
                "end": 13.997
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1 님 락스타 저 안 키우는데 락스타 대신에 뭐 파르페 넣어도 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.020,
                "end": 19.245
            },
            {
                "speaker_id": "1",
                "transcription": "절대 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.255,
                "end": 20.052
            },
            {
                "speaker_id": "1",
                "transcription": "파르페를 넣어서 활용하는 그런 덱의 구조가 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.080,
                "end": 23.677
            },
            {
                "speaker_id": "1",
                "transcription": "락스타가 1분 때 죽어서 나머지 피 채워주고 깔끔하게 이기는 방향으로 설계된 조합이라 락스타 필수고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.690,
                "end": 30.107
            },
            {
                "speaker_id": "1",
                "transcription": "아 그렇다면은 홀리베리 대신에 코랄 넣어서 써도 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.127,
                "end": 34.007
            },
            {
                "speaker_id": "1",
                "transcription": "코랄은 2탱에서만큼은 여러분들이 아시는 1탱에서의 그런 활용 가치가 안 나오기 때문에 홀리베리가 코랄보다 2탱에서는 훨씬 더 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.020,
                "end": 43.613
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 또 하나의 질문 저 락스타 승급이 낮은데 1성, 2성인데도 써야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.623,
                "end": 48.631
            },
            {
                "speaker_id": "1",
                "transcription": "승급이 낮으면 버티기가 더 힘들 거라 피감을 높게 그리고 쿨세팅 힘드신 분들은 이 3초가 될 수 있게끔 세트 효과 더해서 22.3퍼센트 이상 그거를 최소로 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.641,
                "end": 61.610
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 분명히 또 이런 분도 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.625,
                "end": 63.540
            },
            {
                "speaker_id": "1",
                "transcription": "아니 저 왜 러너님이랑 스킬 순서가 안 맞죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.550,
                "end": 66.742
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 저는 승률이 낮은데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.752,
                "end": 68.285
            },
            {
                "speaker_id": "1",
                "transcription": "자 스냅 드래곤도 그냥 쿨세팅만 하는 게 아니라 세트 효과 더해서 권장은 28.7퍼센트 이상 하시는 게 가장 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.292,
                "end": 77.443
            },
            {
                "speaker_id": "1",
                "transcription": "그게 불가능하다 하시는 분들도 가급적이면 쿨은 최대한 높게 세팅을 해야 스킬 순서에 지장 없이 원하는 그림이 나올 수가 있다는 점 자 용과 드래곤 쿨타임은 5에서 8퍼센트 주라고 했지만 정답이 반드시 있는 건 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.453,
                "end": 91.742
            },
            {
                "speaker_id": "1",
                "transcription": "상대의 쿨타임에 따라서 어떤 게 가장 좋은지는 매번 달라지기 때문에 가장 중요한 건 용과 드래곤이 1분 타이밍 때 죽지 않아야 된다는 점 그래서 피감은 어느 정도 있어야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.925,
                "end": 102.657
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 아레나에서 용과 드래곤 나락 갔다는 얘기가 많아서 말씀드리지만 이렇게 3딜덱 카운터 덱으로 활용 가치가 높기 때문에 아레나 얼마 안 남은 시점에서 용과 드래곤도 잘 활용해서 써보시면 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.667,
                "end": 116.917
            },
            {
                "speaker_id": "1",
                "transcription": "자 물론 저는 블랙펄이 없습니다 하시는 분들 입장에서는 스타 더스트를 넣어도 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 116.940,
                "end": 122.320
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 소르베를 넣는 조합도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 122.332,
                "end": 124.332
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 현 시점에서는 소르베나 다른 딜러를 넣었을 때는 3딜 극딜덱한테 승률이 낮아질 수 있다는 점 여러분들 참고해서 아레나 조합 세팅을 하시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 124.352,
                "end": 136.054
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상 용과 드래곤 아직도 0티어라는 점 말씀드리면서 영상 마무리 짓겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 136.064,
                "end": 144.453
            },
            {
                "speaker_id": "1",
                "transcription": "궁금한 점 있으면 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 144.463,
                "end": 147.038
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 147.048,
                "end": 162.266
            }
        ]
    },
    "summary": "아레나에서 용과 드래곤 나락 갔다는 말이 많지만 3딜덱에서는 여전히 활용가치가 높다고 할 수 있으며 블랙펄과 락스타는 어떤 것과 대체할 수 없이 필수로 가지고 있어야 한다.",
