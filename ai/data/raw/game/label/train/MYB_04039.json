        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 아레나에서 다크 카카오도 이제 모습을 보이네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.619
            },
            {
                "speaker_id": "1",
                "transcription": "왜 등장했냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.629,
                "end": 5.631
            },
            {
                "speaker_id": "1",
                "transcription": "보호막을 없애주는 용도고 더 크죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.641,
                "end": 8.315
            },
            {
                "speaker_id": "1",
                "transcription": "딜적인 면을 위해서라기 보다는 소르베 맛 쿠키의 체력 보호막 각종 보호막이 생성되는 걸 없애는 용도로 나왔다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.325,
                "end": 17.289
            },
            {
                "speaker_id": "1",
                "transcription": "아 그쵸 아 이게 낫 보물이 지금 사장되 가지고 신규 보물이 진짜 빛을 보려면은 진짜 공격적으로 나는 들어가겠다 하는 덱들한테 그런 덱한테 정말 좋을 거 같은데 지금 아레나 현 상황은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.299,
                "end": 34.013
            },
            {
                "speaker_id": "1",
                "transcription": "낫을 들고 가는 상황은 덱들이 거의 많이 죽었기 때문에 이 신규 보물이 엄청나게 핫 해지는 경우는 낫 들고 있는 방덱이 활성화 많이 됐을 때",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.023,
                "end": 45.543
            },
            {
                "speaker_id": "1",
                "transcription": "그때 다시 뜰 거 같습니다 지금 당장으로서는 글쎄요 얘가 지금 필요하다고 막 느껴지는 경우는 딱히 없어서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.553,
                "end": 54.079
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 질 거 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.089,
                "end": 58.851
            },
            {
                "speaker_id": "1",
                "transcription": "어우 야",
