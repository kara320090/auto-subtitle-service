        "term": [
            {
                "speaker_id": "1",
                "transcription": "@계정1 님 32만 개 뽑기 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.019
            },
            {
                "speaker_id": "1",
                "transcription": "보면은 왕꾸 아주 예쁘게 하셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.019,
                "end": 6.560
            },
            {
                "speaker_id": "1",
                "transcription": "우유맛 쿠키 좋아하시는 분이라 마음 왕꾸 키워드 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.560,
                "end": 10.180
            },
            {
                "speaker_id": "1",
                "transcription": "꺾이지 않는 마음 왕꾸 한번 불러오기 봐달라고 하셨는데 오 야 자 꾸미기 보면은 하나 꺾이지 않는 마음 둘 우유의 봄날은 온다 셋 2023년 당뇨 극복하자 라면 빵 먹자 넷 쿠키런 킹덤 2주년 망하지 말자 네 일단은 이렇게 하고 이제 뽑기 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.180,
                "end": 35.480
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이분 사연을 보면은 개인적으로 우유맛 뽑기 모션 보는 게 소원입니다 현재 지금 우유가 4초월이지만 각종 이벤트에서 에픽 영어 상자 나올 때마다 우유 픽해서 겨우 만든 4초월입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.480,
                "end": 47.810
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 거의 2년차 돼 가는데 우유맛 쿠키 완품은 정말 잘 안 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.821,
                "end": 52.230
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 혹시 5초월이 되었는데 크리스탈이 남는다면 클로티드 뽑기로 올인해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.230,
                "end": 58.744
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 여기 고급 뽑기로 해서 클로티드로 뽑아 달라 이거 이 말씀이시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.754,
                "end": 62.928
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 그래도 웬만큼 해야 되는 거는 솔방울 3성은 무조건 찍어야 되거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.938,
                "end": 68.030
            },
            {
                "speaker_id": "1",
                "transcription": "얘 3성하고 얘 5성은 찍읍시다 내가 볼 때 얘는 수호성전에서 계속 쓰일 것 같거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.020,
                "end": 74.441
            }
        ]
    },
    "summary": "발화자는 게임 유저들의 키워드를 보고 뽑기 이벤트를 하고 있습니다.",
