        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.179
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 뭐 여러분들이 궁금한 거는 이 정도의 왕꾸 그리고 모든 프로필 그 정도의 스펙을 가지려면 어느 정도 스펙을 가져야 되냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.189,
                "end": 9.796
            },
            {
                "speaker_id": "1",
                "transcription": "자 보면은 모든 게 다 5초월에 가까이 되어 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.806,
                "end": 14.476
            },
            {
                "speaker_id": "1",
                "transcription": "초월을 올릴 순 있지만 전설 물약이 부족해서 일단 이렇게 되어 있고 네 스펙 자체는 뭐 어마무시하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.486,
                "end": 21.457
            },
            {
                "speaker_id": "1",
                "transcription": "물약만 있으면은 5초월이 가능한 상태다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.467,
                "end": 24.359
            },
            {
                "speaker_id": "1",
                "transcription": "사실 계정 평가라기 보다는 계정 탐방이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.369,
                "end": 27.798
            },
            {
                "speaker_id": "1",
                "transcription": "음 스펙도 보시며은 이렇게 다 스킨도 122개 중에 전부 다 왕국 레벨은 당연히 15렙",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.808,
                "end": 35.609
            },
            {
                "speaker_id": "1",
                "transcription": "퀘스트나 아레나도 그랜드 마스터 1 케이크타워도 250층까지 자 한번 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.619,
                "end": 41.969
            },
            {
                "speaker_id": "1",
                "transcription": "끝까지 올라오면은 이렇게 되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.979,
                "end": 45.042
            },
            {
                "speaker_id": "1",
                "transcription": "소다 제도 같은 경우에도 다 오픈이 되어 있는 상태죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.052,
                "end": 49.594
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 남았네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.604,
                "end": 51.177
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 나머지는 뭐 이벤트도 여러분들이 아셔야 될 게 정말 극혐으로 하기 힘든 이벤트 하나 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.187,
                "end": 59.497
            },
            {
                "speaker_id": "1",
                "transcription": "티켓도 전부 다 올 클리어 당연히 궁금한 거 연구소 같은 경우에도 보시면 아시겠지만 전부 다 다 찍혀져 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.507,
                "end": 69.573
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 고인물 분들은 뭐 이 정도는 다 되어 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.583,
                "end": 72.202
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 연구 또한 마찬가지로 네 모든 연구가 올 클리어 돼 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.212,
                "end": 78.401
            },
            {
                "speaker_id": "1",
                "transcription": "네 싹 다 되어 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.411,
                "end": 80.646
            },
            {
                "speaker_id": "1",
                "transcription": "네 랜드마크나 이런 거야 뭐 여러분들 아시다시피 다 건물 지어져 있고 다 10레벨로 찍혀져 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.656,
                "end": 88.061
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 하면 이렇게 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.071,
                "end": 89.855
            },
            {
                "speaker_id": "1",
                "transcription": "방법은 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.865,
                "end": 91.077
            },
            {
                "speaker_id": "1",
                "transcription": "시간 투자를 많이 하면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.087,
                "end": 92.558
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤에 시간 투자를 정말 많이 하면 이렇게 여러분들도 따라 할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.568,
                "end": 99.041
            }
        ]
    },
    "summary": "지금 둘러보는 계정처럼 되려면 킹덤에 시간 투자를 정말 많이 하면 가능합니다.",
