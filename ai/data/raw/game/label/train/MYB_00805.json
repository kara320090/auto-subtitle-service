        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 승급을 할 수 있구나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.761
            },
            {
                "speaker_id": "1",
                "transcription": "아 하급 닌자에서 뭐 상급 닌자 이렇게 올라가야 돼?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.771,
                "end": 9.675
            },
            {
                "speaker_id": "1",
                "transcription": "다음에 할 때 시청자 참여까지 네 같이 시작하는 분들하고 이제 3 대 3 모드 뭐 이렇게 시참하는 모드도 있다고 하니까 시참하는 모드까지 같이 해보죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.685,
                "end": 22.745
            },
            {
                "speaker_id": "1",
                "transcription": "저도 이제 런 게임 추천받아서 한번 해보는 건데 아 진짜 색다르고 재미있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.755,
                "end": 29.433
            },
            {
                "speaker_id": "1",
                "transcription": "네 기존에 하던 아기자기한 그런 런 게임이랑은 다르게 정말 색다른 게임이라 제가 앞으로 런 게임류나 이런 걸 제가 좋아하니까 하나 제대로 잡고 좀 콘텐츠 화해서 분야를 넓혀갈 생각이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.443,
                "end": 45.105
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래서 뭐 같이 계속하실 분들 공약이나 뭐 노하우나 방법 이런 거 같이 쭉 해 볼 생각입니다 저도 하나 잡아서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.115,
                "end": 54.025
            },
            {
                "speaker_id": "1",
                "transcription": "닌자 머스트 다이 오늘 리뷰는 여기서 마치고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.035,
                "end": 57.514
            },
            {
                "speaker_id": "1",
                "transcription": "네 다음 영상에서도 쭉 이어서 뵙도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.524,
                "end": 61.841
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
