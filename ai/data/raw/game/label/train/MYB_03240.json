        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "피해 감소가 더 중요하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.715
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 특별히 피해 감소 높이는데 신경을 써주시고 방어력 또한 퍼센트가 높아지면은 어 대미지가 더 적게 들어오는 거 맞으니까 저거 공식 보고 생존하는데 방어력도 조금 중요하다는 점 어 확인해 보시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.725,
                "end": 16.628
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 피해 증가가 생겼습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.638,
                "end": 18.597
            },
            {
                "speaker_id": "1",
                "transcription": "이게 만렙을 찍으면은 자 20퍼센트까지 증가가 되죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.607,
                "end": 21.890
            },
            {
                "speaker_id": "1",
                "transcription": "예전에 아마 복귀 유저분들이 이런 시스템 없을 때는 대미지가 들어가는 게 150퍼센트가 끝이었거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.900,
                "end": 28.175
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 현재는 노움 연구에서 20퍼센트 거기다가 초콜릿 판 위령 제단에서 최대 만렙을 시키면은 20퍼센트 증가됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.185,
                "end": 36.053
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 40퍼센트가 증가됐기 때문에 복귀 유저분들 입장에서는 치명타가 확률이 그리고 치명타 피해 증가가 옛날에 비해서 엄청나게 높아졌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.063,
                "end": 45.929
            },
            {
                "speaker_id": "1",
                "transcription": "힐러들 또한 치명타 피해 증가가 되었으면 힐량도 그만큼 증가되는 거기 때문에 상당히 중요한 부옵션으로 여러분들이 알고 계시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.939,
                "end": 56.000
            }
        ]
    },
    "summary": "방어력 또한 퍼센트가 높아지면은 대미지가 더 적게 들어오는 거 맞으니까 대미지 공식을 보고 생존하는데 방어력도 중요하다는 점을 확인하고 치명타 피해는 만렙을 찍으면은 자 20퍼센트까지 증가가 되는데 현재는 노움 연구에서 20퍼센트 거기다가 초콜릿 판 위령 제단에서 최대 만렙을 시키면은 20퍼센트 증가되기 때문에 복귀 유저 입장에서는 치명타가 확률과 치명타 피해의 증가가 옛날에 비해서 엄청나게 높아졌다.",
