        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 누가 그런 소릴",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.810
            },
            {
                "speaker_id": "2",
                "transcription": "분명히 전설의 붉은 용이야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.820,
                "end": 3.787
            },
            {
                "speaker_id": "3",
                "transcription": "용의 협곡에 있던 부족들도 다들 피난을",
                "sound_type": [
                    2
                ],
                "start": 3.797,
                "end": 8.438
            },
            {
                "speaker_id": "4",
                "transcription": "드래곤 시티에서 토벌대를 모으고 있다던데",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.448,
                "end": 13.389
            },
            {
                "speaker_id": "5",
                "transcription": "뭐야 너 용의 협곡에 돌아왔다는 붉은 용이 네가 아니라는 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.399,
                "end": 21.429
            },
            {
                "speaker_id": "5",
                "transcription": "분명히 생김새는 똑같다고 했는데 뭐가 어떻게 된 거지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.439,
                "end": 27.477
            },
            {
                "speaker_id": "6",
                "transcription": "용은 간악하다고 하지 않으셨습니까?",
                "sound_type": [
                    2,
