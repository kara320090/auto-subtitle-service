        "term": [
            {
                "speaker_id": "1",
                "transcription": "아무튼 이제 이런 것들을 어제 좀 봤어요. 그쵸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.957
            },
            {
                "speaker_id": "1",
                "transcription": "오딘이 진짜 멋있었는데. 오딘.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.964,
                "end": 4.550
            },
            {
                "speaker_id": "1",
                "transcription": "발루드 왕국의 국왕 바르바나스 잘름이 현현한 모습이래.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.560,
                "end": 10.052
            },
            {
                "speaker_id": "1",
                "transcription": "캬 이거 진짜 멋있었어 오딘. 그쵸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.062,
                "end": 14.599
            },
            {
                "speaker_id": "1",
                "transcription": "오딘 진짜 멋있었고 바하무트.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.609,
                "end": 17.302
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 상브레크 황국 디옹 르사주가 현현한 모습.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.312,
                "end": 21.160
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 우리가 지금 가려고 했던 그 성에 있는 왕자를 말하는 거죠?",
                "sound_type": [
