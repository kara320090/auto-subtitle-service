        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 근데 너무 안 나온다 뽑기.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.166
            },
            {
                "speaker_id": "1",
                "transcription": "스킨만 자주 나오고 지금 12만 개 뽑기죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.176,
                "end": 7.395
            },
            {
                "speaker_id": "1",
                "transcription": "자 오케이 완품 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.405,
                "end": 9.206
            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 든 생각인데 이 분 바깥에 여러분 이렇게 꺼내 놔야 돼요. 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.216,
                "end": 14.404
            },
            {
                "speaker_id": "1",
                "transcription": "야미 분들이나 초보자 분들이나 복귀 유저 분들 사기라고 해서 패키지 풀과금 했는데 밖에 안 꺼내 놓으면은 이거 손해거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.414,
                "end": 22.163
            },
            {
                "speaker_id": "1",
                "transcription": "응원봉 공짜로 주니까 24시간 쿨타임 돌면서 이게 총 10개예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.173,
                "end": 26.823
            },
            {
                "speaker_id": "1",
                "transcription": "다 뽑은 사람은 10개거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.833,
                "end": 28.352
            },
            {
                "speaker_id": "1",
                "transcription": "다 마을에 있는지 확인하고 이거 아마 편집해서 보면 헷갈릴 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.362,
                "end": 32.213
            },
            {
                "speaker_id": "1",
                "transcription": "3번째를 봐가지고 이 집이랑 사람 모양 있는 거 이 풀 모양 이게 환경 점수가 600점 짜리가 요거거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.223,
                "end": 39.132
            },
            {
                "speaker_id": "1",
                "transcription": "600점 짜리를 꺼내 놓으면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.142,
                "end": 41.126
            },
            {
                "speaker_id": "1",
                "transcription": "아 방탄 도감에서도 볼 수 있어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.136,
                "end": 43.465
            },
            {
                "speaker_id": "1",
                "transcription": "완풍으로 주세요. 그렇지 완풍 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.475,
                "end": 46.862
            },
            {
                "speaker_id": "1",
                "transcription": "방탄 쿠키 키워야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.872,
                "end": 48.835
            },
            {
                "speaker_id": "1",
                "transcription": "키워야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.845,
                "end": 49.456
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 넘사 0티어로 나와서 아 스킨만 다 나왔고요.",
                "sound_type": [
