        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 자 이런 식으로 버티면서 버티면서 버티면서 비바람 네 이런 식으로 이긴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.441
            },
            {
                "speaker_id": "1",
                "transcription": "야 크런치 빙결덱이 다시 또 많이 쓰일 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.451,
                "end": 20.915
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 깃털덱한테 이기는 모습 이것도 깃털덱이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.925,
                "end": 25.514
            },
            {
                "speaker_id": "1",
                "transcription": "깃털덱 여러분들이 1가지 아셔야 될게 이게 일반적으로 요 덱은 아니에요 달빛이랑 달빛이랑 똑같은 위치에서 보고 있으면 이건 소르베가 아닌 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.524,
                "end": 36.241
            },
            {
                "speaker_id": "1",
                "transcription": "소르베가 올라오면은 이게 크로스가 돼야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.251,
                "end": 39.588
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄이 오면은 서로 이제 크로스가 되면서 블랙펄덱 그렇게 되는 걸 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.598,
                "end": 45.426
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 요 덱으로 갈게요 미러전으로 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.436,
                "end": 48.458
            }
        ]
    },
