        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 프릴해파리 업데이트 이후 어떤 쿠키를 집중적으로 키워야 될지 정리해 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.553
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 크림슨코랄 쿠키가 너무 압도적으로 좋기 때문에 초보자분들 복귀자분들 기존 유저분들 누구나 가릴 거 없이 무조건 0순위로 키우셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.563,
                "end": 16.207
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑은 올 쿨 토핑으로 세팅을 하시고 쿨 타임은 세트 효과 포함해서 21.3퍼센트 이상 세팅해 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.217,
                "end": 24.004
            },
            {
                "speaker_id": "1",
                "transcription": "피감은 여러분들 능력껏 높게 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.014,
                "end": 27.573
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리 같은 경우에는 나락가지 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.583,
                "end": 29.764
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과드래곤하고 같이 투탱으로 잘 사용하고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.774,
                "end": 32.764
            },
            {
                "speaker_id": "1",
                "transcription": "물론 우선순위 자체는 크림슨이 1순위 그리고 2순위가 홀리베리가 되겠고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.774,
                "end": 38.974
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과드래곤 같은 경우에는 원탱으로는 절대 사용 못 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.984,
                "end": 42.648
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리도 마찬가지 올 쿨 세팅 그리고 피감 여러분 능력껏 권장은 쿨 타임 세트 효과 제외하고 22퍼센트 이상 세팅해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.658,
                "end": 52.906
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과드래곤도 마찬가지 원탱으로는 절대 쓸 수 없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.916,
                "end": 56.646
            },
            {
                "speaker_id": "1",
                "transcription": "올 라즈베리 세팅에 자 쿨 타임은 0에서 9퍼센트 사이로 맞춰 주시면 되는데 자 피감은 20퍼센트 이상 자 이 질문이 나올 거예요. 왜 저는 1분 타이밍 지나서 브레스 타이밍 못 맞출까요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.656,
                "end": 68.745
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 여러분들이 잘못 세팅한 게 아니라 상대방의 딜러들이 스타더스트, 달빛술사, 소르베같이 용과드래곤의 공격 타임을 늦춰 주는 쿠키가 있어야지 1분이 지나서 브레스가 나가는 거라 쿨 타임을 0으로 맞춰도 상대 쿠키가 용과드래곤 공격 타임을 늦춰 주는 게 없으면은 1분 전에 브레스가 나갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.755,
                "end": 88.197
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들의 세팅이 문제보다 상대방의 쿠키 조합에 따라서 타이밍이 다르게 되는 거다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.207,
                "end": 93.321
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 바다요정 얘 같은 경우에는 젬스톤 20강 이상 그리고 초월도 3초월 이상 뭐 이렇게 돼야 엄청나게 좋게 사용이 되는 거고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.331,
                "end": 102.445
            },
            {
                "speaker_id": "1",
                "transcription": "그전까지는 스타더스트, 달빛술사, 블랙펄 이런 쿠키들이 더 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.455,
                "end": 107.078
            },
            {
                "speaker_id": "1",
                "transcription": "스펙이 낮은 분들 제임슨이 아직도 낮은 분들은 블랙펄 쿠키를 더 우선으로 키워주시는 걸 더 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 107.088,
                "end": 113.373
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄 너무나 중요한 0티어고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.383,
                "end": 115.870
            },
            {
                "speaker_id": "1",
                "transcription": "네 스펙이 낮아도 잼스톤 효과 하나로도 엄청나게 이득을 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 115.880,
                "end": 120.204
            },
            {
                "speaker_id": "1",
                "transcription": "저 잼스톤 우선적으로 키우시고 블랙펄도 우선적으로 키우는 걸 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 120.214,
                "end": 124.545
            },
            {
                "speaker_id": "1",
                "transcription": "무난하게 추천드리는 거는 올 쿨 세팅을 제일 많이 쓰고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 124.555,
                "end": 128.006
            },
            {
                "speaker_id": "1",
                "transcription": "자 세트 효과 포함해서 일반적으로 21 퍼나 요새는 세트 효과 제외하고 3 딜러 덱에서는 23 퍼로 맞춰서 쓰이기도 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 128.016,
                "end": 137.796
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛술사 만능으로 많이 키우고 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 137.806,
                "end": 140.151
            },
            {
                "speaker_id": "1",
                "transcription": "무난하게는 올 쿨 세팅을 많이 하고 한방 덱이나 스토리 모드에서는 라즈베리 세팅을 많이 하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 140.161,
                "end": 146.815
            },
            {
                "speaker_id": "1",
                "transcription": "자 스타더스트 같은 경우에는 자 무난하게 올 애플젤리 세팅을 추천 드리지만 현재 아레나에서는 요렇게 4 애플젤리 1 쿨 해서 10.3퍼센트 이상 3초 스타더스트를 많이 사용하고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 146.825,
                "end": 159.824
            },
            {
                "speaker_id": "1",
                "transcription": "언급되는 쿠키들은 키워서 손해가 없는 쿠키들입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 159.834,
                "end": 162.894
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝글리터는 현재 쓰임새가 좀 낮아졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 162.904,
                "end": 166.003
            },
            {
                "speaker_id": "1",
                "transcription": "우선순위로 키울 필요는 현재까지는 높지 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 166.013,
                "end": 169.060
            },
            {
                "speaker_id": "1",
                "transcription": "자 클로티드 같은 경우에는 초보자분들한테 키우는 건 좀 추천드리지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 169.070,
                "end": 173.611
            },
            {
                "speaker_id": "1",
                "transcription": "일시적으로 크림슨코랄 저격으로 현재 1 티어로 쓰이고 있지만 다음에 골드치즈가 나오거나 언제든지 대체 조합이 나오거나 티오가 떨어질 가능성이 크기 때문에 초보자분들한테는 추천드리지 않고 고인물분들이나 이미 키워주신 분들은 적극 활용해 주시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 173.621,
                "end": 190.556
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베도 활용 가치가 너무나 떨어졌기 때문에 우선순위로 키우는 건 추천드리지 않고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 190.566,
                "end": 195.421
            },
            {
                "speaker_id": "1",
                "transcription": "자 토벌 관련된 오징어먹물, 망고 이런 애들은 토벌 덱 관련된 영상 참고해서 키워주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 195.431,
                "end": 202.295
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤벳 이번에 마탕 나왔지만 대난투에서 유용하게 쓰이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 202.305,
                "end": 206.115
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나는 연구가 더 많이 필요한 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 206.125,
                "end": 208.676
            },
            {
                "speaker_id": "1",
                "transcription": "자 실론나이트도 한방 덱에서는 좋았지만 한방 덱 가치가 떨어졌고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 208.686,
                "end": 213.334
            },
            {
                "speaker_id": "1",
                "transcription": "과전류 한방 덱도 네 활용 가치가 좀 많이 떨어졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 213.344,
                "end": 216.994
            },
            {
                "speaker_id": "1",
                "transcription": "자 슈크림맛 쿠키 수호 성전이나 스토리 모드에서 활용 가치가 좋기 때문에 스냅드래곤이 있는 분들은 네 10강 이상 먼저 해 주셔도 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 217.004,
                "end": 225.009
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 봅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 225.019,
                "end": 225.998
            },
            {
                "speaker_id": "1",
                "transcription": "네 스냅드래곤이 없는 분들은 마법 사탕을 파르페를 먼저 10강을 해 주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 226.008,
                "end": 230.748
            },
            {
                "speaker_id": "1",
                "transcription": "자 푸른주스, 캡틴 이런 애들 토벌 관련된 애들은 토벌 영상 참고해서 키워 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 230.758,
                "end": 236.662
            },
            {
                "speaker_id": "1",
                "transcription": "자 밀키도넛도 마찬가지 토벌 영상 자 해파리 같은 경우에는 아레나 전용 쿠키입니다 현재로선.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 236.672,
                "end": 243.126
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 3 딜 저격 덱으로 나왔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 243.136,
                "end": 245.955
            },
            {
                "speaker_id": "1",
                "transcription": "물론 여유가 있으면 키우면 좋지만 제가 그때 초보자분들이나 복귀 유저분들이 당장 필수로 우선순위로 키워야 될 쿠키는 아닌 거 같아요 왜냐하면.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 245.965,
                "end": 254.462
            },
            {
                "speaker_id": "1",
                "transcription": "다른 덱들이 키워져 있어야 가치가 있는 거지 얘보다 더 우선적으로 제가 언급된 딜러들이나 탱커들이 없는 분들 아직 안 키워져 있는 분들은 먼저 저 상위 0티어를 키우고 여유가 될 때 키워 주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 254.472,
                "end": 269.586
            },
            {
                "speaker_id": "1",
                "transcription": "네 아직 여유가 많다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 269.596,
                "end": 270.955
            },
            {
                "speaker_id": "1",
                "transcription": "하시는 분들은 뭐 키워 주셔도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 270.965,
                "end": 273.593
            },
            {
                "speaker_id": "1",
                "transcription": "자 모카도 토벌 자 박하 이거는 되게 활용 가치가 좋아졌거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 273.603,
                "end": 277.306
            },
            {
                "speaker_id": "1",
                "transcription": "박하도 여유가 있으면은 키워 주시면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 277.316,
                "end": 280.058
            },
            {
                "speaker_id": "1",
                "transcription": "자 해파리 저격 덱으로 아주 활용이 잘 되고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 280.068,
                "end": 283.399
            },
            {
                "speaker_id": "1",
                "transcription": "자 초보자분들한테 우선순위로 키우라는 거는 아니지만 아 그래도 키워도 나쁘지는 않을 정도까지 이번에 업데이트 이후에 활용이 좋아졌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 283.409,
                "end": 292.891
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타도 키워서 손해 볼 거는 없는 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 292.901,
                "end": 296.256
            },
            {
                "speaker_id": "1",
                "transcription": "네 용과 덱이나 투탱덱이 너무나 안 쓰이다 보니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 296.266,
                "end": 299.533
            }
        ]
    },
    "summary": "쿠키런 킹덤 프릴해파리 업데이트 이후에 어떤 쿠키를 키워야 하는지에 대해 설명하며 모든 유저들에게 크림슨코랄 쿠키를 0순위로 키우라고 권장하며 2순위가 홀리베리 그리고 다른 쿠키들의 우선순위와 활용 가치를 알려준다.",
