                    5
                ],
                "start": 0.000,
                "end": 6.553
            },
            {
                "speaker_id": "1",
                "transcription": "자 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.563,
                "end": 7.658
            },
            {
                "speaker_id": "1",
                "transcription": "오징어먹물도 아레나에서 엄청나게 맹활약하고 있구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.668,
                "end": 13.814
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이 덱 세팅의 최종 목표가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.824,
                "end": 16.522
            },
            {
                "speaker_id": "1",
                "transcription": "그게 뭐냐면은 자구마가 최종적으로 살아남아서 어 얘가 막 있는 스킬 쓰면은 그냥 체력이 그냥 끝까지 다시 다 차거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.532,
                "end": 25.792
            },
            {
                "speaker_id": "1",
                "transcription": "그런 사기적인 스킬을 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.802,
                "end": 30.172
            },
            {
                "speaker_id": "1",
                "transcription": "자 보이죠?",
