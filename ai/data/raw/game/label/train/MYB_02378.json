        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 사양된 칠리맛쿠키 리뷰 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.697
            },
            {
                "speaker_id": "1",
                "transcription": "정말 상향 전에는 99 티어 아마 최악의 쿠키 탑 쓰리 안에 드는 쿠키거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.707,
                "end": 9.591
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 어떻게 상향됐는지 보게 되면 일단 칠리맛쿠키는 기존보다 변경된 점에서 자신의 치명타 확률에 비료해서 치명타 피해가 증가된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.601,
                "end": 19.196
            },
            {
                "speaker_id": "1",
                "transcription": "어 그래도 딜을 좀 더 상향시켜 줬다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.206,
                "end": 21.723
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 바람처럼 빠른 몸놀림으로 가장 뒤에 있는 적들을 기습해 범위 피해를 준다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.733,
                "end": 28.144
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파이어처럼 가장 뒤에 있는 적을 공격하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.154,
                "end": 30.690
            },
            {
                "speaker_id": "1",
                "transcription": "4연타의 마지막 검격은 반드시 독하디독한 칠리맛 치명타가 적용된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.700,
                "end": 36.546
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 일부 밸런스 조정 기본 공격력 대비 12 점 5 퍼센트가 증가됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.556,
                "end": 42.185
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 이거 12 퍼센트가 감이 잘 안 오시겠지만 보통 승급 하나당 2 점 5에서 3 퍼센트 정도 증가 되거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.195,
                "end": 49.577
            },
            {
                "speaker_id": "1",
                "transcription": "까 대략적으로 아마 한 5성 정도의 차이를 올려줬다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.587,
                "end": 53.825
            },
            {
                "speaker_id": "1",
                "transcription": "4에서 5성 정도를 승급을 시켜줬다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.835,
                "end": 56.391
            },
            {
                "speaker_id": "1",
                "transcription": "고렇게 보면 되고 기본 체력도 22 퍼센트나 증가됐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.401,
                "end": 60.111
            },
            {
                "speaker_id": "1",
                "transcription": "22 퍼센트의 수치는 대략적으로 거의 뭐 단계를 올려줬다 뭐 그 정도까지 보시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.121,
                "end": 66.408
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 승급을 강제로 올려주는 효과로 공격력과 체력을 많이 올려줬다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.418,
                "end": 71.501
            },
            {
                "speaker_id": "1",
                "transcription": "네 그렇게 보면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.511,
                "end": 75.400
            }
        ]
    },
    "summary": "화자는 상향된 캐릭터에 대해서 어떤 점이 이전보다 좋아졌는지 읽어주고 공격력과 체력이 올랐다고 정리한다.",
