        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 달빛 술사 혼자 남았는데 여러분들이 뭐 해보시면 아시겠지만 뭐 매번 100퍼센트 이게 통하는 것도 아닌 게 네 지금은 이겼지만 뭐 안 통하는 경우도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 14.410
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1님도 유튜브에서 말씀드렸지만 이게 안 통하는 분도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.420,
                "end": 18.717
            },
            {
                "speaker_id": "1",
                "transcription": "매번 통하는 것도 아니고 그나마 현존 한방덱이 통하는 유일한 덱이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.727,
                "end": 24.086
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 중요한 건 아까 말씀드렸지만 이번에 업데이트 통해서 데블시스터즈가 에픽을 살리려는 의도로 실론 나이트 마탕을 좀 내는 게 아닌가 그렇게 되면은 어떻게 쓰이게 되냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.096,
                "end": 35.761
            },
            {
                "speaker_id": "1",
                "transcription": "실론 나이트는 전에 2달 전에 요렇게 쓰였습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.771,
                "end": 39.519
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 쓰였거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.529,
                "end": 40.896
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기 같은 경우에는 기존에 캡틴캐비어랑 오징어먹물한테 들어갔고 그때는 오징어 먹물 올 라즈베리 해서 피감 높게 공치 캡틴캐비어도 올 라즈베리 해서 피감없이 공치 달빛 술사 같은 경우에는 얘 호루라기 받으면 안 되기 때문에 저는 애플 젤리를 줬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.906,
                "end": 58.600
            },
            {
                "speaker_id": "1",
                "transcription": "똑같이 도넛도 2.8퍼센트 이상 실론 나이트는 그때 올 아몬드에다가 피감 공격력 높게 세팅해서 해줬거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.610,
                "end": 67.009
            },
            {
                "speaker_id": "1",
                "transcription": "한번 업데이트 전입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.019,
                "end": 68.611
            },
            {
                "speaker_id": "1",
                "transcription": "마법 사탕 나오기 전에 한번 한방덱으로 요거 지금은 어떤 상황이 나오는지 테스트를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.621,
                "end": 75.172
            },
            {
                "speaker_id": "1",
                "transcription": "한번 비교를 해볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
