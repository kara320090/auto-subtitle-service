        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 첫 번째 용족 관련 쿠키부터 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.039
            },
            {
                "speaker_id": "1",
                "transcription": "자 용안 드래곤입니다. 이번에 나온 신규 마지막 용족이거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.049,
                "end": 7.283
            },
            {
                "speaker_id": "1",
                "transcription": "자 스킨을 보게 되면은 오 킹덤과 다르게 엄청나게 화려합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.293,
                "end": 11.560
            },
            {
                "speaker_id": "1",
                "transcription": "자 자 요렇게 용안 드래곤 쿠키 망자들의 군주 용안 드래곤 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.570,
                "end": 18.052
            },
            {
                "speaker_id": "1",
                "transcription": "불꽃정령 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.062,
                "end": 19.390
            },
            {
                "speaker_id": "1",
                "transcription": "불꽃정렁 같은 경우에도 스킨이 정말 다양합니다 이렇게까지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.393,
                "end": 22.550
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나게 화려하죠? 불꽃정령도 출시되기 기다리는 분도 많은데 자 요렇게 화려하게 타오르는 혼돈의 제왕 불꽃정령 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.540,
                "end": 33.367
            },
            {
                "speaker_id": "1",
                "transcription": "자 세 번째 로는 리치 드래곤 용족이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.377,
                "end": 35.771
            },
            {
                "speaker_id": "1",
                "transcription": "드래곤 아마 가장 되게 쪼그만 할 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.781,
                "end": 38.661
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 시간지기 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.671,
                "end": 40.329
            },
            {
                "speaker_id": "1",
                "transcription": "이 시간지기를 잘 모르시는 분도 있겠지만 되게 능력 자체도 사기적으로 좋은 쿠키거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.339,
                "end": 45.852
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게",
                "sound_type": [
                    2,
                    3
                ],
