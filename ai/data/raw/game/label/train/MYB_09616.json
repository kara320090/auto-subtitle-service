        "term": [
            {
                "speaker_id": "1",
                "transcription": "자유 도시 칸베르의 지인에게 녀석이 후원 중인 엔터프라이즈에 관해 들었다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.414
            },
            {
                "speaker_id": "1",
                "transcription": "나도 힘을 보태도록 하마.",
                "sound_type": [
                    2
                ],
                "start": 4.424,
                "end": 6.293
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 소문에 따르면 칸베르의 관리들이 무허가 대형 선박 건조를 단속하려 돌아다니고 있다는구나.",
                "sound_type": [
                    2
                ],
                "start": 6.303,
                "end": 12.344
            },
            {
                "speaker_id": "1",
                "transcription": "이대로라면 손을 써둔 새로운 항구 건설도 위험할 수 있어.",
                "sound_type": [
                    2
                ],
                "start": 12.354,
                "end": 16.201
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 가브 군의 힘을 좀 빌려줬으면 한다.",
                "sound_type": [
                    2
                ],
                "start": 16.211,
                "end": 19.500
            }
        ]
    },
    "summary": "여성이 게임 속 항구가 위험할 수 있어 힘을 빌려달라는 글을 읽고 있다.",
