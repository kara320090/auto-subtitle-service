        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 티켓 하나당 토핑 40개 정말 할만한 콘텐츠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.881
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 수급도 하고 코인도 수급하고 다양한 보상 얻으면서 제가 추천 드리는 각성 오징어 독속성 많이 파밍을 하고 광고 많이 보시면서 게임 즐기시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.891,
                "end": 17.854
            },
            {
                "speaker_id": "1",
                "transcription": "네 목록 갱신하면서 하시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.864,
                "end": 21.175
            },
            {
                "speaker_id": "1",
                "transcription": "자 궁금한 점이 있다면 댓글에 남겨주시구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.185,
                "end": 24.202
            },
            {
                "speaker_id": "1",
                "transcription": "친구 구하는 것도 댓글에 해도 저는 삭제 안 할 테니까 친구 어 댓글에서 구하셔도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.212,
                "end": 30.651
            },
            {
                "speaker_id": "1",
                "transcription": "네 구독 좋아요 한 번씩만 부탁드릴게요. 감사합니다.",
                "sound_type": [
                    2,
