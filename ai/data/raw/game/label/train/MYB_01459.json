        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현시점에서 아레나에 소르베가 엄청나게 유행하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.507
            },
            {
                "speaker_id": "1",
                "transcription": "자 공격덱을 알아보게 되면은 소르베를 활용한 덱은 총 4가지로 크게 유행하고 있고 소르베를 활용한 이렇게 락스타 어 용과드래곤 조합 소르베 용과 조합인데 무공비 대신에 깃털 조합 자 소르베 실론 조합 그리고 마지막으로 소르베 샤이닝 조합 이렇게 되어있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.517,
                "end": 23.846
            },
            {
                "speaker_id": "1",
                "transcription": "자 보통 허브맛 쿠키와 함께 들어오면은 카운터덱으로 상성상 약하기 때문에 방덱으로는 소르베를 보통은 노출을 안 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.856,
                "end": 32.271
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베를 활용한 4가지 덱 세팅에 대해서 제가 알려 드리면은 일단 제가 주력으로 사용하는 요 세팅 5번 덱 같은 경우에는 홀리베리 같은 경우에는 쿨 용과는 라즈 쿨 공속 높게 그다음에 락스타는 쿨이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.281,
                "end": 47.751
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿨 같은 경우에는 어 세트 효과 포함해서 22.3퍼센트 이상 피해 감소는 높게 치명타 확률도 5퍼센트 이상 맞춰 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.761,
                "end": 57.142
            },
            {
                "speaker_id": "1",
                "transcription": "소르베는 쿨타임 여러분들 능력껏 최대한 높여 주시면 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.152,
                "end": 61.241
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 이 권장은 23퍼센트 이상 피감은 높게 그다음에 스냅은 쿨 높게 자 깃털덱 같은 경우에는 무공비 대신에 깃털을 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.251,
                "end": 71.595
            },
            {
                "speaker_id": "1",
                "transcription": "네 이거랑 이거의 차이점은 세팅은 그대로고 깃털만 바뀌어서 간다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.605,
                "end": 76.612
            },
            {
                "speaker_id": "1",
                "transcription": "아 다만 요 덱 같은 경우에는 1분 지나서 어 소르베가 부활하고 소르베가 한 번 더 쓴다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.622,
                "end": 83.146
            },
            {
                "speaker_id": "1",
                "transcription": "부활 타깃이 소르베가 돼야 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.156,
                "end": 85.524
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 실론덱 같은 경우에도 부활로 타깃이 소르베가 부활해서 한 번 더 스킬을 써 주면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.534,
                "end": 92.357
            },
            {
                "speaker_id": "1",
                "transcription": "실론나이트 같은 경우에도 마탕에 자 기사 단장의 분노 버프가 2중첩으로 어 소르베가 부활하면서 실론한테 많이 쌓여주면 되고 실론나이트는 올 아몬드 쿨 높게 그다음에 여유가 되면은 치명타 확률 높게 해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.367,
                "end": 108.279
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 쿨이랑 락스타 쿨 락스타 같은 경우에는 아몬드로 하시는 분도 있지만 저는 개인적으로 아몬드 보다는 쿨이 더 성능이 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 108.289,
                "end": 116.905
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 샤이닝 같은 경우에는 라즈베리를 저는 세팅을 했고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 116.915,
                "end": 120.997
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 소르베는 쿨 나머지는 네 이렇게 다 다른 조합이랑 동일합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
