                    2,
                    3
                ],
                "start": 8.771,
                "end": 15.448
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 퀘스트가 풍년이고만. 헤이. 하이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.458,
                "end": 21.516
