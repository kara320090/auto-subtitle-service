    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 무지개 큐브 많이 부족하시죠?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 2.292
            },
            {
                "speaker_id": "1",
                "transcription": "이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.302,
                "end": 7.730
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.740,
                "end": 12.395
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원 가격에 해당하는 가격인데 제가 무료로 나누어 드리고 있는데 받는 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.405,
                "end": 24.159
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱을 다운로드 받으시고 우측 하단에 프로필을 누르시고 우측 상단의 톱니바퀴를 누르면 시크릿 코드 입력하는 데가 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.169,
                "end": 34.211
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오 ND 러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.221,
                "end": 38.612
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 앱은 도대체 어떤 걸까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.622,
                "end": 41.143
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 게임만 해도 자동으로 쌓이는 잼을 가지고 상점에서 여러분들이 원하는 기프트 카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.153,
                "end": 49.827
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임하는데 여러분들한테 따로 광고가 뜨지도 않고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.837,
                "end": 53.099
            },
            {
                "speaker_id": "1",
                "transcription": "방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.109,
                "end": 55.990
            },
            {
                "speaker_id": "1",
                "transcription": "자 시크릿 코드 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.000,
                "end": 61.686
            },
            {
                "speaker_id": "1",
                "transcription": "자세한 이벤트 확인은 고정 댓글을 확인해 주세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.696,
                "end": 64.661
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트는 8월 30일쯤으로 예상을 하고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.671,
                "end": 68.915
            },
            {
                "speaker_id": "1",
                "transcription": "대부활을 해서 에픽 전성 시대가 다시 또 찾아올지 기대가 되는 쿠키예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.925,
                "end": 75.477
            },
            {
                "speaker_id": "1",
                "transcription": "자 궁금한 사항 있다면 네 댓글에 남겨 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.487,
                "end": 79.044
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.054,
                "end": 80.800
            }
        ]
    },
    "summary": "한 남성이 이벤트로 게임에서 무지개 큐브 3000개를 무료로 준다고 하는데 받는 방법으로는 플레이오 앱을 다운을 받고 남성 채널에서 시크릿 코드를 입력하는 데가 나오는데 거기에 플오 ND 러너라고 입력해 주면 라이브 방송 시에 남성이 추첨을 통해 랜덤으로 제공을 한다고 설명한다.",
