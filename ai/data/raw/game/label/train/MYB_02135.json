        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "고대가 나와도 에픽 쿠키랑 같이 출시가 될 수 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.855
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 신규 쿠키가 2개가 출시가 될 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.865,
                "end": 7.593
            },
            {
                "speaker_id": "1",
                "transcription": "이게 월드탐험에서 새로운 대륙으로 이제 쿠키들이 이동을 할 때 신규 에피소드가 나올 때 드래곤이 많이 나오는 그런 에피소드로 넘어가면서 같이 나오지 않을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.603,
                "end": 19.701
            },
            {
                "speaker_id": "1",
                "transcription": "결정적으로 여러분들이 그래서 준비해야 될 거 업데이트 때 스킬 파우더 같은 경우에는 뭐 용과 들고는 돌격형이다라고 유출이 됐지만 드래곤 에픽 쿠키는 감이 안 옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.711,
                "end": 31.670
            },
            {
                "speaker_id": "1",
                "transcription": "아마 돌격형으로는 안 나오고 다른 유형으로 나올 수 있기 때문에 파우더는 나와봐야 알 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.680,
                "end": 37.029
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 오븐브레이크에서 전갈 꼬리를 가진 쿠키가 있긴 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.039,
                "end": 41.310
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 전갈맛 쿠키가 꼬리 자체가 꼬리가 전갈 꼬리랑 상당히 비슷하긴 한데 확실히 전갈맛 쿠키랑은 이미지가 완전 다르죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.320,
                "end": 50.845
            },
            {
                "speaker_id": "1",
                "transcription": "용족처럼 날개가 없기 때문에 전갈맛 쿠키라고 이제 예측하는 분도 있어서 비교를 하지만 전갈맛 쿠키는 좀 거리가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.855,
                "end": 58.785
            },
            {
                "speaker_id": "1",
                "transcription": "자 그렇다면 희귀도 순으로 봤을 때 레전드 쿠키가 다른 버전으로 나올 수 있지 않냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.795,
                "end": 64.212
            },
            {
                "speaker_id": "1",
                "transcription": "오븐 브레이크에 나오는 모든 쿠키를 봤을 때 용족과 관련된 쿠키들은 5개를 제외해서는 전혀 닮은 게 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.222,
                "end": 71.290
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 막 용과 관련된 이미지가 겹치는 에픽 쿠키는 단 하나도 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.300,
                "end": 77.249
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 최종 결론은 이번에 신규 드래곤 시리즈에 쿠키들이 어 쭉 출시될 예정인 것 같다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.259,
                "end": 84.200
            },
            {
                "speaker_id": "1",
                "transcription": "등급은 에픽이지만 레전드나 신규 등급도 나올 수가 있다는 점 솔직히 이번 업데이트 상당히 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.210,
                "end": 91.678
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이번 영상에서 여러분들한테 신규 드래곤이 나온다 이런 이미지를 주 전달하는 목적이 크지만 제 개인적인 입장은 그것보다도 신규 에피소드가 나올 가능성이 좀 큰 것 같은데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.688,
                "end": 103.189
            },
            {
                "speaker_id": "1",
                "transcription": "스토리도 정말 재미있게 보시는 분도 있어요 하지만 좀 더 이제 지쳐서 떠나가는 분들 지금 고정 콘텐츠 즐길 만한 재밌는 콘텐츠를 기다리는 분들이 더 많거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 103.199,
                "end": 114.466
            }
        ]
    },
    "summary": "이번에 신규 드래곤 시리즈에 쿠키들이 대거 출시될 예정인 것 같다고 말한다.",
