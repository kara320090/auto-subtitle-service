        "term": [
            {
                "speaker_id": "1",
                "transcription": "게시판에 수 수배지가 붙어 있대요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.229
            },
            {
                "speaker_id": "1",
                "transcription": "와 이거다 오 그리폰 비급.",
                "sound_type": [
                    2
                ],
                "start": 4.239,
                "end": 9.732
            },
            {
                "speaker_id": "1",
                "transcription": "야 그래도 여기 저번에 한번 침략 받아 가지고 개판돼 있었는데 정리 정돈 잘돼있네.",
                "sound_type": [
                    2
                ],
                "start": 9.742,
                "end": 18.280
            },
            {
                "speaker_id": "1",
                "transcription": "고기 너무 맛있게 생겼어요.",
                "sound_type": [
                    2
                ],
                "start": 18.290,
                "end": 20.383
            },
            {
                "speaker_id": "2",
                "transcription": "기메님이 그리폰 알아요?",
                "sound_type": [
                    2
                ],
                "start": 20.393,
                "end": 21.709
            },
            {
                "speaker_id": "2",
                "transcription": "시티폰 착각하신 거 아니에요?",
                "sound_type": [
                    2
                ],
                "start": 21.719,
                "end": 23.744
            },
            {
                "speaker_id": "1",
                "transcription": "시티폰이 뭐예요 할아버지?",
                "sound_type": [
                    2
                ],
                "start": 23.754,
                "end": 25.980
            },
            {
                "speaker_id": "1",
                "transcription": "전 그런 거 처음 들어보겠는데 그게 뭔지 전 잘 모르는데 혹시 아시나요?",
                "sound_type": [
                    2
                ],
                "start": 25.980,
                "end": 30.504
            },
            {
                "speaker_id": "1",
                "transcription": "저도 알려주시겠어요?",
                "sound_type": [
                    2
                ],
                "start": 30.500,
                "end": 34.380
            },
            {
                "speaker_id": "1",
                "transcription": "로랜드 스콜피온의 꼬리 어 드롭이 왜 들어오지?",
                "sound_type": [
                    2
                ],
                "start": 34.393,
                "end": 42.740
            },
            {
                "speaker_id": "1",
                "transcription": "아 다른 데 켜 놓은 거.",
                "sound_type": [
                    2
                ],
                "start": 42.720,
                "end": 48.140
            },
            {
                "speaker_id": "1",
                "transcription": "쓰리 리즈 습지에서",
                "sound_type": [
                    2
