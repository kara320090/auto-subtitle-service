        "term": [
            {
                "speaker_id": "1",
                "transcription": "호밀은 제가 보니까 피감이 더 낮아도 상관없네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.127
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 휘낭시에 버프를 계속 받기 때문에 피감이 20퍼센트만 넘어도 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.137,
                "end": 16.085
            },
            {
                "speaker_id": "1",
                "transcription": "차라리 그렇게 하고 공격하고 치명타를 진짜 높게 세팅을 해주시는 게 더 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.095,
                "end": 23.707
            },
            {
                "speaker_id": "1",
                "transcription": "아슬아슬하게 호밀이 못 버티거나 이런 그림은 전혀 안 나오기 때문에 제가 볼 때는 굳이 피감을 좀 더 신경 써줘야 된다는 거는 클로티드",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.717,
                "end": 33.040
            },
            {
                "speaker_id": "1",
                "transcription": "자 실전에서 그런데 이 앞에 두 개를 가렸을 때가 문제기는 하네 만약에 우유가 들어 있으면 하필 가리면 문제네 이게 여러분들이 보시는 가장 큰 문제라고 보시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.050,
                "end": 45.374
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 앞에 두 개 가렸다 싶으면 그냥 이 덱은 좀 피하는 게 좋은 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.384,
                "end": 50.895
            },
            {
                "speaker_id": "1",
                "transcription": "대놓고 나는 우유다라고 그냥 광고하는 거라 요고 조심 해야 되네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.905,
                "end": 58.318
            },
            {
                "speaker_id": "1",
                "transcription": "앞에 가려져 있을 때",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.328,
                "end": 64.533
            }
        ]
    },
    "summary": "남자가 앞에 두 개가 가렸다 싶으면 피하는 게 좋은 거 같다는 말을 하고 있다.",
