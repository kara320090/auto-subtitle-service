                    2
                ],
                "start": 6.020,
                "end": 10.791
            },
            {
                "speaker_id": "1",
                "transcription": "자기 이지만 우리 방에 조카 바보들이 많잖아요.",
                "sound_type": [
                    2
                ],
                "start": 10.801,
                "end": 17.459
            },
            {
                "speaker_id": "1",
                "transcription": "오 방금 너무 감동 오 오늘도 진짜 감동 진짜.",
                "sound_type": [
                    2
                ],
                "start": 17.469,
                "end": 24.811
            },
            {
                "speaker_id": "1",
                "transcription": "맞아 유일한 가족이죠 이제.",
                "sound_type": [
                    2
                ],
                "start": 24.821,
                "end": 27.784
            },
            {
                "speaker_id": "1",
                "transcription": "조슈아는 어디로 갔는지 모르고 동생.",
                "sound_type": [
