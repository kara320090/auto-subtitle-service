        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 내 눈물 억제기.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 6.020
            },
            {
                "speaker_id": "1",
                "transcription": "소중하지 원래 조카가 제일 예쁜 거거든.",
