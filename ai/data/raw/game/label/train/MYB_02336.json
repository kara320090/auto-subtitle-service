        "term": [
            {
                "speaker_id": "1",
                "transcription": "가고 그 아까 제가 하나 더 말씀드리고 싶은 거는 와일드베리는 진짜 쿨 주면 안 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.379
            },
            {
                "speaker_id": "1",
                "transcription": "쿨이 있으면은 1분 전에 핵 펀치 나가면은 진짜 손해가 크기 때문에 꼭 말씀드릴 거는 와베는 쿨 주지 말고 공속 줘라",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.389,
                "end": 19.147
            },
            {
                "speaker_id": "1",
                "transcription": "공속 몰빵을 줘라",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.157,
                "end": 22.718
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 세팅하는 게 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.728,
                "end": 24.957
            },
            {
                "speaker_id": "1",
                "transcription": "커먼 시계 쓸 수 있나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.967,
                "end": 26.592
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 중요한 게 커먼 시계가 등급 자체가 커먼이라고 해서 이제 쓰면 안 되는 것처럼 느껴질 수도 있는데 이 에픽 시계가 만렙이 되기 전까지는 무조건 얘를 써야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.602,
                "end": 39.519
            },
            {
                "speaker_id": "1",
                "transcription": "커먼 등급이지만 실질적으로 얘는 조금 과장해서 레전드 보물이라 보면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.529,
                "end": 44.310
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 커먼이라 무시하지 마시고 얘는 만렙 되기 전까지 커먼 시계 써주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.320,
                "end": 51.281
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 만렙 시계랑 커먼 시계랑 차이가 딱히 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.291,
                "end": 56.294
            },
            {
                "speaker_id": "1",
                "transcription": "아 공격력 5 퍼센트 차이는 있지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.304,
                "end": 60.600
            }
        ]
    },
    "summary": "화자는 커먼 등급의 시계 보물은 등급에 신경 쓰지 말고 대체 보물 업그레이드가 끝날 때까지는 무조건 사용하라고 이야기한다.",
