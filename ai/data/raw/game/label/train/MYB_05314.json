        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 뭐야 블랙베리가 무슨 3마리나.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.761
            },
            {
                "speaker_id": "1",
                "transcription": "블랙베리 요즘에 토벌에서 날아다니는 거 알죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.771,
                "end": 6.529
            },
            {
                "speaker_id": "1",
                "transcription": "나름 토벌 0티어입니다. 얘 천사덱에서",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.539,
                "end": 10.177
            },
            {
                "speaker_id": "1",
                "transcription": "러니 다이아는 높은 곳에서 어떻게 모아야 되나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.187,
                "end": 13.448
            },
            {
                "speaker_id": "1",
                "transcription": "다이아 수급처는 딱 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.458,
                "end": 15.084
            },
            {
                "speaker_id": "1",
                "transcription": "길드 토벌 정산, 아레나 정산, 수호 성진 정산, 대난투 정산 네 그거 아니고는 소원 나무에서 미션 깨서 얻는 다이아.",
                "sound_type": [
