                    3,
                    5
                ],
                "start": 12.479,
                "end": 22.991
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 달빛도 여러분 능력껏 피쿨 능력껏 둘 다 신경 써서 해주시고 에스프레소도 피감이랑 쿨 능력껏 최대한 많이 주시면 됩니다.",
                "sound_type": [
