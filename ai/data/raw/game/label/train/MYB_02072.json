        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 연타해서 소르베랑 로얄마가린 먼저 나가고 자 그다음에 에클리어 주스 나가구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 0.000,
                "end": 5.027
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 밀키웨이는 57초 되자마자 여러분들 써주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 5.037,
                "end": 9.168
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 로얄마가린은 쿨 되는대로 바로 바로",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 9.178,
                "end": 12.372
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 주스도 쿨 되는대로 바로 바로 눌러 주시면 되구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 12.382,
                "end": 16.479
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 로얄마가린 쿨 되는대로 바로 눌러주고 에클레어도 바로 눌러 줍니다.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 16.489,
                "end": 21.051
            },
            {
                "speaker_id": "1",
                "transcription": "자 밀키웨이는 46초 되자마자 눌러주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 21.061,
                "end": 24.790
            },
            {
                "speaker_id": "1",
                "transcription": "46초가 되면 이때 밀키웨이 눌러주시구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 24.800,
                "end": 27.807
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 중요한 점이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.817,
                "end": 29.633
            },
            {
                "speaker_id": "1",
                "transcription": "기존에는 소르베가 어 41초 40초에 써야 된다 이렇게 되어 있잖아요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.643,
                "end": 34.202
            },
            {
                "speaker_id": "1",
                "transcription": "빌드가 근데 이번에 어 로얄마가린 쿠키가 이번에 에일리언도넛 쿠키보다 해로운 효과 증가 수치가 5퍼센트가 더 많거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.212,
                "end": 45.176
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 소르베는 44초부터 쓸 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.186,
                "end": 48.991
            },
            {
                "speaker_id": "1",
                "transcription": "45초에서 44초 바뀌자마자 쓰면 안 되고 44.5초 정도 이때부터 써도 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.001,
                "end": 55.655
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 권장은 40초였어요 기존 빌드는 근데 44초도 쓸 수 있다는 거 먼저 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.665,
                "end": 61.626
            },
            {
                "speaker_id": "1",
                "transcription": "소르베 피가 간당간당 하시는 분들은 44초부터 쓰는 거 알고 있으니까 좀 더 빌드가 깨지는 걸 방지할 수가 있을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.636,
                "end": 71.554
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이제부터는 바로 로얄마가린 써주구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.564,
                "end": 75.248
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 되는대로 로얄마가린 계속 써주구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.258,
                "end": 80.966
            }
        ]
    },
