                    2,
                    3
                ],
                "start": 10.798,
                "end": 13.272
            },
            {
                "speaker_id": "1",
                "transcription": "어떡하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.282,
                "end": 13.825
            },
            {
                "speaker_id": "1",
                "transcription": "그래 드디어 왔군.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.835,
                "end": 17.758
            },
            {
                "speaker_id": "1",
                "transcription": "여긴 여과막들 때문에 움직이기 좀 불편할 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.768,
                "end": 20.534
            },
            {
                "speaker_id": "1",
                "transcription": "여과막을 통과할 때는 색깔을 잘 보고 들어가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.544,
                "end": 23.255
            },
            {
                "speaker_id": "1",
                "transcription": "색깔도 글씨 귀여워.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.265,
                "end": 24.631
            },
            {
                "speaker_id": "1",
                "transcription": "안 그랬다가는 벽에 머리를 박는 거나 다름없을 테니까 말이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.641,
                "end": 28.338
            },
            {
                "speaker_id": "1",
                "transcription": "뭐라고?",
