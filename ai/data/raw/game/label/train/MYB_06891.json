        "term": [
            {
                "speaker_id": "1",
                "transcription": "마음의 준비가 되면 망설이지 말고 빨려 들어가라구.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.752
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다는 건 들어가라는 거잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.762,
                "end": 6.537
            },
            {
                "speaker_id": "1",
                "transcription": "들어가서 일로 나오란 말이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.547,
                "end": 10.788
            },
            {
                "speaker_id": "1",
                "transcription": "이미 들어가 버렸어요.",
