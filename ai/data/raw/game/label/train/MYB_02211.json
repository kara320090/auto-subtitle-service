        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 퓨바 자 기록해 주세요 1 퓨바.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.573
            },
            {
                "speaker_id": "1",
                "transcription": "야 150만 개다 데브야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.583,
                "end": 6.730
            },
            {
                "speaker_id": "1",
                "transcription": "보 150만 개면은 여러분들 최소한 종류별로 하나씩은 다 기본적으로 나오고도 넘쳐야 되는데 업데이트가 한 달 만에 하는 거잖아요 다음 업데이트.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.740,
                "end": 17.883
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뭔가 왕창 뭐가 나오지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.893,
                "end": 20.312
            },
            {
                "speaker_id": "1",
                "transcription": "용과 만약에 나오면은 용과랑 보물이랑 뭔가 왕창 나올 것 같은 느낌 길드 보물 나왔으면 좋겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.322,
                "end": 28.047
            },
            {
                "speaker_id": "1",
                "transcription": "길드 보물도 이제 슬슬 나올 때 된 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.057,
                "end": 30.572
            },
            {
                "speaker_id": "1",
                "transcription": "좀 되게 업데이트된 지 오래되지 않았나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.582,
                "end": 32.897
            },
            {
                "speaker_id": "1",
                "transcription": "몇 달 됐잖아 길드 보물은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.907,
                "end": 34.629
            },
            {
                "speaker_id": "1",
                "transcription": "아 보물로 용과드래곤 꼬리 나온다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.639,
                "end": 38.235
            },
            {
                "speaker_id": "1",
                "transcription": "드래곤 관련된 보물도 나올 가능성이 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.245,
                "end": 42.137
            },
            {
                "speaker_id": "1",
                "transcription": "약간 최초의 레전드 보물 그런 것도 나오는 거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.147,
                "end": 46.028
            },
            {
                "speaker_id": "1",
                "transcription": "오 오케이 여러분들 퓨바 하나 다크 하나 자 2퓨 1다크",
                "sound_type": [
                    2,
                    3
                ],
