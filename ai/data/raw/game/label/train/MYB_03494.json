    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 요거 실전에서는 이미 사람들이 앞에 찰스가 있어 가지고 막힐 것 같아서 제가 친구에서 보여 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.740
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.740,
                "end": 9.890
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱 아마 지긋지긋하게 방덱에서 많이 보셨을 텐데 이 덱으로 세팅해 놓으면은 다 그냥 1번에 다 터집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.890,
                "end": 16.660
            },
            {
                "speaker_id": "1",
                "transcription": "잠시 광고 하나 하고 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.660,
                "end": 18.710
            },
            {
                "speaker_id": "1",
                "transcription": "노노그램이라는 쉽지만 시간을 순삭시키는 게임입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.710,
                "end": 22.550
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번 게임은 정말 보기에 쉬워 보이기도 하고 어려워 보이기도 하는 그런 게임입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.550,
                "end": 28.070
            },
            {
                "speaker_id": "1",
                "transcription": "쉽 앤 쉽 개발자가 한국 유저를 굴복시키기 위해 만들었다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.070,
                "end": 31.890
            },
            {
                "speaker_id": "1",
                "transcription": "그런 포인트로 만든 게임이라 이벤트로 3일간 선착순 100명에게 기프트 카드 5만 원권을 무조건 지급하는 이벤트를 하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.890,
                "end": 40.280
            },
            {
                "speaker_id": "1",
                "transcription": "도전해서 받아 가시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.280,
                "end": 42.110
            },
            {
                "speaker_id": "1",
                "transcription": "간단한 게임 원리를 설명해 드리면 가장 쉬운 거는 저 화면에 보이는 왼쪽에 숫자 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.110,
                "end": 47.290
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 드래그로 왼쪽에서 딱 드래그 해 버리면은 채워집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.290,
                "end": 51.210
            },
            {
                "speaker_id": "1",
                "transcription": "자 이, 일은 뭐냐면은 2칸, 1칸을 채운다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.210,
                "end": 54.100
            },
            {
                "speaker_id": "1",
                "transcription": "자 일, 이는 1칸, 2칸을 채운다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.100,
                "end": 56.780
            },
            {
                "speaker_id": "1",
                "transcription": "자 1칸은 요거 1칸을 채운다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.780,
                "end": 58.900
            },
            {
                "speaker_id": "1",
                "transcription": "어 요런 식으로 하면 되는데 되게 간단합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.900,
                "end": 61.870
            },
            {
                "speaker_id": "1",
                "transcription": "자 본격적으로 시작해 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.870,
                "end": 63.820
            },
            {
                "speaker_id": "1",
                "transcription": "자 칠 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.820,
                "end": 65.519
            },
            {
                "speaker_id": "1",
                "transcription": "칠 연속으로 7칸 그다음에 육 있죠. 숫자",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.519,
                "end": 68.960
            },
            {
                "speaker_id": "1",
                "transcription": "6칸 연속으로 쭉 칠해 주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.960,
                "end": 71.560
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 볼 때는 이 숫자가 의미하는 거는 연속으로 칸이 이어진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.560,
                "end": 76.610
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 보시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.610,
                "end": 77.720
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 이, 오가 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.720,
                "end": 79.390
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 2칸 연속에다가 5칸 연속이니까 여기 5칸 연속 자 그리고 9칸이니까 여기 X 있으니까 9칸 연속으로 쭉 자 10칸이니까 10칸 연속으로 쭉 자 그리고 8칸, 1칸입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.390,
                "end": 90.740
            },
            {
                "speaker_id": "1",
                "transcription": "8칸 연속에다가 1칸짜리 하나 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.740,
                "end": 93.840
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요렇게 쭉 칠해 주면 되죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.840,
                "end": 95.330
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 숫자가 많다고 해서 어려운 게 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.330,
                "end": 97.960
            },
            {
                "speaker_id": "1",
                "transcription": "정 모르겠으면 요 힌트를 사용해도 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 97.960,
                "end": 103.303
            }
        ]
    },
    "summary": "쿠키런 킹덤에서 이 덱으로 세팅하면 1번에 다 터지고 이번에 쉽 앤 쉽 개발자가 한국 유저를 굴복시키기 위해 노노그램이라는 게임을 만들었는데 이벤트로 3일간 선착순 100명에게 기프트 카드 5만 원권을 준다고 하며 게임 방법은 화면에 보이는 숫자만큼 드래그해서 연속으로 칸을 채우면 되고 힌트를 사용할 수 있다.",
