        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 소환덱이 돌아왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.356
            },
            {
                "speaker_id": "1",
                "transcription": "정말 와 이게 진짜 깜짝 놀랐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.366,
                "end": 5.022
            },
            {
                "speaker_id": "1",
                "transcription": "깃털덱한테 무지성으로 가서 엄청난 승률을 보이는 이 덱.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.032,
                "end": 8.440
            },
            {
                "speaker_id": "1",
                "transcription": "소환덱이 돌아왔는데 보면은 소환덱의 전용 보물 핀쿠션 요거 같이 써 주시면 되고 토핑 같은 경우에는 샤벳은 쿨 필요 없이 그냥 피감만 여러분들 신경써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.450,
                "end": 20.174
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 있으면 공치 해주시면 되고 펌킨은 그냥 피감만 여유되면은 공치 오이스터같은 경우에는 아몬드 4개랑 쿨 해가지고 11.2이상.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.184,
                "end": 31.194
            },
            {
                "speaker_id": "1",
                "transcription": "피감이 어느 정도 높게 여러분들이 해주시면 되고 @이름1님 쿨이 부족해요 하시는 분들은 3아몬드에 2쿨 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.204,
                "end": 38.676
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 피감 같은 경우에는 저랑 똑같이 이거 수치 맞추려고 하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.686,
                "end": 42.709
            },
            {
                "speaker_id": "1",
                "transcription": "저는 제가 가진 토핑 최고로 좋은 거로만 해서 이렇게 높게 나온 거니까 꼭 이 수치만큼 맞추라는 거 절대 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.719,
                "end": 49.253
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 능력껏 맞춰주시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.263,
                "end": 50.947
            },
            {
                "speaker_id": "1",
                "transcription": "목화같은 경우에는 쿨 23.5퍼센트 이상 네 세트 효과 포함 없이 최대한 높게 해주시고 피감도 나름대로 능력껏 해주시면 좋을 것 같습니다.",
                "sound_type": [
