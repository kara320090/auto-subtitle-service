        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.092
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.102,
                "end": 6.537
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.547,
                "end": 10.398
            },
            {
                "speaker_id": "1",
                "transcription": "자 요런 요런 구조입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.408,
                "end": 11.635
            },
            {
                "speaker_id": "1",
                "transcription": "2, 1, 2덱 말고 2, 2, 1덱인데 앞에 찰스가 있으면은 요걸로 들어가면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.645,
                "end": 18.618
            },
            {
                "speaker_id": "1",
                "transcription": "자 시작할 때 제일 중요한 포인트는 이겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.628,
                "end": 21.469
            },
            {
                "speaker_id": "1",
                "transcription": "보이죠 시작하자마자 스킬 얘가 쓰는데 코코아는 아직 스킬을 안 썼죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.479,
                "end": 25.767
            },
            {
                "speaker_id": "1",
                "transcription": "근데 스킬 시전 시간이 얘가 좀 있다 보니까 코코아가 얘가 기절이 들어오기 전에 스킬이 발동 되면서 전체 기절 면역이 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.777,
                "end": 34.499
            },
            {
                "speaker_id": "1",
                "transcription": "보이죠 기절 면역이 됐죠?",
