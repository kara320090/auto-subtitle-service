                    2,
                    3,
                    5
                ],
                "start": 13.133,
                "end": 17.373
            },
            {
                "speaker_id": "1",
                "transcription": "맞아 아저씨들 잘 울어 우리 아빠도 많이 울었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.383,
                "end": 21.166
            },
            {
                "speaker_id": "1",
                "transcription": "문제가 또 생겼대요.",
