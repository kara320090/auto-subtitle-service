                ],
                "start": 0.000,
                "end": 1.500
            },
            {
                "speaker_id": "1",
                "transcription": "제가 메인으로 쓰고 있는 덱인데 너무나 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.510,
                "end": 4.980
            },
            {
                "speaker_id": "1",
                "transcription": "소르베가 상위권에서 너무나 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.990,
                "end": 7.827
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사랑 스타더스트를 굳이 안 써도 소르베만 잘 키워놨어도 여러분들이 활용 가치가 너무나 좋게 쓸 수 가 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.837,
                "end": 16.369
            },
            {
                "speaker_id": "1",
                "transcription": "자 실론나이트 소르베 덱 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.379,
                "end": 18.582
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 이 락스타 자리에 스타더스트가 있던 자리예요.",
