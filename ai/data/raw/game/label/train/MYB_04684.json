        "term": [
            {
                "speaker_id": "1",
                "transcription": "1번 어떤 구도로 되는지 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.048
            },
            {
                "speaker_id": "1",
                "transcription": "그 소환덱이 한층 더 강력해졌다고 보는 이유는 아시다시피 기존에는 BTS쿠키 자리에 파르페가 들어가는데 BTS쿠키가 뭐 엄청난 그냥 각종 좋은 버프란 버프는 다 있는 데다가 힐량도 좋기 때문에 소환덱이 더 좋아졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.058,
                "end": 22.881
            },
            {
                "speaker_id": "1",
                "transcription": "와 지금 보셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.891,
                "end": 23.696
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 때문에 쓰지 말라는 거구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.706,
                "end": 25.423
            },
            {
                "speaker_id": "1",
                "transcription": "방금 보셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.433,
                "end": 26.396
            },
            {
                "speaker_id": "1",
                "transcription": "낫이라서 1번에 들어오는 딜 때문에 전멸 당할 수도 있다는 점.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.406,
                "end": 29.759
            },
            {
                "speaker_id": "1",
                "transcription": "버티면 이기지만 스펙이 낮은 분들은 못 버티면 질 수 있다는 점 때문에 낫은 가급적이면 안 들어가는 게 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.769,
                "end": 36.444
            },
            {
                "speaker_id": "1",
                "transcription": "거의 무지성입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.454,
                "end": 37.535
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 깃털 있으면은 다 들어가도 되는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.545,
                "end": 40.131
            },
            {
                "speaker_id": "1",
                "transcription": "단 이게 좀 약하다는 덱들은 보니까 원탱 완전 범위 공격 올공덱들 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.141,
                "end": 49.345
            },
            {
                "speaker_id": "1",
                "transcription": "원탱 공속 공격덱들 광범위 공격덱들한테는 들어가면 안 되고 그다음 또 에스프레소 있는 덱한테도 약하다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.355,
                "end": 57.776
            },
            {
                "speaker_id": "1",
                "transcription": "근데 지금 뭐 광범위 에스프레소 있는 사람들은 거의 안 보이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.786,
                "end": 63.800
            }
        ]
    },
