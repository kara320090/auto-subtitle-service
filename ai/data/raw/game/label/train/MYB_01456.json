    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 슈퍼에픽 샤이닝글리터 맛 쿠키 출시 이후 모든 쿠키들의 토핑을 추천해 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.460
            },
            {
                "speaker_id": "1",
                "transcription": "자 중요한 쿠키들을 집중적으로 토핑 추천과 상세 부옵션 추천으로 제가 해 드릴 거고 키워야 될 가치가 낮은 쿠키들은 무난하게 토킹 추천을 하고 간단하게 넘어가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.470,
                "end": 16.932
            },
            {
                "speaker_id": "1",
                "transcription": "자 다크카카오 같은 경우에는 아몬드 토핑 무난하게 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.942,
                "end": 20.664
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 같은 경우에는 울 콜 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.674,
                "end": 23.871
            },
            {
                "speaker_id": "1",
                "transcription": "자 중요한 부옵션은 피해 감소, 쿨타임 부옵션 높으면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.881,
                "end": 27.867
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라 같은 경우에도 스냅드래곤, 락스타맛 쿠키를 먼저 키우고 여유가 된다면 3순위로 반드시 여러분들 어느 정도 키워 두셔야 되는 쿠키입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.877,
                "end": 37.516
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라의 부상 효과 감소 이 능력 자체가 대체 불가능하고 여러분들이 부상 효과 감소 능력 자체는 유용하게 활용할 수 있기 때문에 반드시 퓨어바닐라도 키워 두셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.526,
                "end": 48.082
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 무난하게 올 쿨 토핑 추천드리고 때에 따라서는 올 아몬드 토핑 세팅도 필요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.092,
                "end": 54.039
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소 쿨타임 높으면 상당히 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.049,
                "end": 57.276
            },
            {
                "speaker_id": "1",
                "transcription": "자 여유가 된다면 공격력과 공격 속도 치명타 확률도 상당히 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.286,
                "end": 63.107
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과드래곤도 토핑 추전은 올 라즈베리 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.117,
                "end": 67.011
            },
            {
                "speaker_id": "1",
                "transcription": "자 피해 감소 부옵션 상당히 중요하고 쿨타임도 상당히 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.021,
                "end": 70.978
            },
            {
                "speaker_id": "1",
                "transcription": "요새는 쿨타임 높여서 1분 그다음에 30초 타이밍 때 공격력 증가 타이밍에 맞춰서 쿨타임 높여서 많이 사용하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.988,
                "end": 78.201
            },
            {
                "speaker_id": "1",
                "transcription": "공격력 증가 부옵션 치명타 확률 부옵션 높여주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.211,
                "end": 82.362
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과드래곤 같은 경우에는 피해 감소를 엄청나게 높게 세팅하는 것보다 쿨타임에 더 신경써 주시는 게 더 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.372,
                "end": 90.455
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛술사 같은 경우에는 무난하게 올 쿨 토핑을 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.465,
                "end": 94.497
            },
            {
                "speaker_id": "1",
                "transcription": "조합에 따라서 세팅이 워낙 다양하기 때문에 관련 조합을 참고해 주시는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 94.507,
                "end": 100.544
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다요정은 무난하게 라즈베리 자 블랙펄도 무난하게 한방덱에서는 라즈베리 자 서리여왕 같은 경우에는 무난하게 빙결되기 위해서 아몬드 또는 울 쿨로 사용합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 100.554,
                "end": 111.282
            },
            {
                "speaker_id": "1",
                "transcription": "자 클로티드 같은 경우에도 어 무난하게 아몬드로 많이 사용합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 111.292,
                "end": 115.527
            },
            {
                "speaker_id": "1",
                "transcription": "보통은 무난하게 에플젤리로 많이 사용하고 중요한 부옵션은 피해 감소와 쿨타임 높게 사용하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 115.537,
                "end": 121.678
            },
            {
                "speaker_id": "1",
                "transcription": "자 요새는 3 라지베리 3 애플젤리 세팅으로 피해 감소와 쿨을 높게 세팅하기도 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 121.688,
                "end": 127.486
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베 같은 경우에는 피해 감소와 쿨타임 높게 세팅해서 올 쿨 토핑으로 많이 사용합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 127.496,
                "end": 133.264
            },
            {
                "speaker_id": "1",
                "transcription": "보통 쿨 세팅 같은 경우에는 어 호루라기 보물을 반드시 받아야지 소르베가 죽지 않고 생존이 가능하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 133.274,
                "end": 140.435
            },
            {
                "speaker_id": "1",
                "transcription": "보통 아몬드 세팅으로도 하기도 하지만 일반적으로는 쿨을 더 많이 세팅을 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 140.445,
                "end": 145.644
            },
            {
                "speaker_id": "1",
                "transcription": "자 오이스터 같은 경우에는 무난하게 어 올 쿨 세팅이나 아니면은 쿨과 아몬드를 섞어서 사용하기도 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 145.654,
                "end": 153.221
            },
            {
                "speaker_id": "1",
                "transcription": "오이스터도 거의 사용 안 하고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 153.231,
                "end": 155.432
            },
            {
                "speaker_id": "1",
                "transcription": "자 캡사이신 같은 경우에는 뭐 올 아몬드 세팅이나 올 라즈베리 세팅을 많이 사용하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 155.442,
                "end": 160.294
            },
            {
                "speaker_id": "1",
                "transcription": "보통은 피해 감소, 공격력 위주로 높게 세팅을 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 160.304,
                "end": 164.594
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기를 받에 세팅을 할 때 보통 공격력 높게 세팅을 많이 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 164.604,
                "end": 169.102
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 많이 사용할 때 아몬드 세팅을 많이 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 169.112,
                "end": 172.199
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝 같은 경우에는 호루라기를 안 받을 때는 올 아몬드 세팅을 많이 하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 172.209,
                "end": 176.880
            },
            {
                "speaker_id": "1",
                "transcription": "보통 호루라기 받을 수 있게끔 라즈베리 세팅을 많이 하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 176.890,
                "end": 180.855
            },
            {
                "speaker_id": "1",
                "transcription": "자 피해 감소랑 쿨타임 어느 정도 2.8퍼센트 이상 자 오징어먹물은 저 토벌에서 많이 사용하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 180.865,
                "end": 187.097
            },
            {
                "speaker_id": "1",
                "transcription": "토벌에서는 보통 세팅에 맞게끔 뭐 3 라즈에 2 애플젤리, 올 라즈베리 어 때에 따라서 오 치명 사용하고 스토리나 한방덱에서는 5 라즈베리로 사용합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 187.107,
                "end": 196.784
            },
            {
                "speaker_id": "1",
                "transcription": "자 무난하게 에스프레소 오 라떼 이런 거는 스토리나 이런 데서는 라즈베리 그다음에 감추는 울 쿨 그다음에 마라 같은 경우에는 올 쿨이나 때에 따라서는 라즈베리 뭐 아몬드도 각각 어 이벤트 보스에서 사용하기도 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 196.794,
                "end": 211.026
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프 같은 경우에는 아레나에서 올 아몬드 피해 감소나 뭐 쿨 공속 높여서 사용하기도 하는데 요새는 많이 사용이 안 되고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 211.036,
                "end": 219.166
            },
            {
                "speaker_id": "1",
                "transcription": "어 때에 따라서는 올 라즈베리 어 올 애플젤리도 예전에 사용하기도 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 219.176,
                "end": 224.264
            },
            {
                "speaker_id": "1",
                "transcription": "자 호밀 같은 경우에는 무난하게 올 라즈베리 자 실론나이트는 올 아몬드 사용하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 224.274,
                "end": 230.428
            },
            {
                "speaker_id": "1",
                "transcription": "보통 피해 감소 쿨 높게 세팅해서 정석덱에서 많이 사용되고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 230.438,
                "end": 234.790
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 확률 부옵션이 높으면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 234.800,
                "end": 237.285
            },
            {
                "speaker_id": "1",
                "transcription": "자 뱀파는 무난하게 올 라즈베리 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 237.295,
                "end": 239.920
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림도 올 애플젤리 추천드리고 수호성전 같은 경우에는 쿨 높게 자 와일드베리는 올 아몬드로 많이 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 239.930,
                "end": 249.543
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소 높게 세팅해서 어 사용하고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 249.553,
                "end": 252.391
            },
            {
                "speaker_id": "1",
                "transcription": "자 자색고구마 올 아몬드 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 252.401,
                "end": 255.007
            },
            {
                "speaker_id": "1",
                "transcription": "자 마들렌도 망토 보물 받기 위해서 공속 부옵션 그다음에 피해 감소 부옵션 되게 중요하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 255.017,
                "end": 260.458
            },
            {
                "speaker_id": "1",
                "transcription": "공격력 치명타 확률 높게 올 아몬드 또는 올 라즈베리 또는 올 애플젤리 공속덱 위주로 세팅을 많이 해서 사용됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 260.468,
                "end": 268.531
            },
            {
                "speaker_id": "1",
                "transcription": "자 우유 같은 경우에는 올 아몬드 뭐 때에 따라서는 뭐 쿨세팅도 하기도 합 합니다마는 사용을 별로 많이 안 하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 268.541,
                "end": 275.489
            },
            {
                "speaker_id": "1",
                "transcription": "타르트 같은 경우에는 올 라즈베리하는 경우도 있고 뭐 때에 따라서는 있지 않게끔 아몬드 섞어서 라즈랑 아몬드랑 섞어서 사용하기도 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 275.499,
                "end": 283.744
            },
            {
                "speaker_id": "1",
                "transcription": "자 트위즐젤리는 보통 무난하게 애플젤리 눈설탕 같은 경우에는 거의 사용이 안 되고 있는데 굳이 사용한다면 토한덱에서 라즈베리 자 망고도 거의 사용 안 되지만 굳이 사용한다면 라즈베리 그다음 솔방울 같은 경우에는 공속덱에서 아몬드 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 283.754,
                "end": 298.891
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 독버섯도 딜러로 사용된다면 무난하게 라즈베리 에 캡틴캐비어도 토벌에서는 올 쿨 토핑 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 298.901,
                "end": 306.797
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱에서나 스토리에서는 라즈베리 자 흑당 같은 경우에는 공속덱에서 쓰이지만 현재는 쓰이지 않고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 306.807,
                "end": 312.806
            },
            {
                "speaker_id": "1",
                "transcription": "추천드리자면 라즈베리나 올 아몬드 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 312.816,
                "end": 316.240
            },
            {
                "speaker_id": "1",
                "transcription": "자 애클레어는 네 토벌에서 많이 사용되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 316.250,
                "end": 319.187
            },
            {
                "speaker_id": "1",
                "transcription": "네 올 아몬드로 토벌에서 사용되고 스토리에서는 울 쿨이나 라즈베리 사용하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 319.197,
                "end": 324.658
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙레이즌 무난하게 라즈베리 자 찰스도 무난하게는 아몬드 자 아포가토 무난하게 아몬드 자 펌킨파이는 무난하게 아몬드 자 블루파이도 무난하게 사용할 때 라즈 사벳도 요새는 거의 안 사용하지만 라즈 로얄마가린 같은 경우에는 뭐 스토리에서 라즈 많이 사용하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 324.668,
                "end": 343.201
            },
            {
                "speaker_id": "1",
                "transcription": "때에 따라서는 쿨, 라즈 이렇게 섞어서 쿨이나 라즈로 사용하시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 343.211,
                "end": 347.996
            },
            {
                "speaker_id": "1",
                "transcription": "자 페스츄리는 사용 거의 안 하지만 네 라즈베리 공속덱으로 뭐 쓰시면 될 것 같고요.",
