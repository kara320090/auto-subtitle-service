        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 지금은 요런 식으로 아마 실론 나이트가 마탕 달고 나오면은 확실히 더 딜도 나오고 네 효과 자체도 다르기 때문에 네 제가 이거 비교 영상으로 쓸 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 16.707
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱이 먹히지 않는 그림이지만 앞으로 업데이트 지나면 확실히 달라질 가능성이 크다.",
                "sound_type": [
                    2
                ],
                "start": 16.717,
                "end": 22.452
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 스냅드래곤 0성이 BTS 5초이 보다 좋게끔 출시가 됐거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.462,
                "end": 27.094
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 지금 해야 될 건 뭐냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.104,
                "end": 29.361
            },
            {
                "speaker_id": "1",
                "transcription": "스냅드래곤을 뽑아야 되는 거는 당연한 얘기고 정석덱의 스펙을 높이기 힘들다면은 나머지 결과적으로 할 수 있는 건 상성 상 우위로 들어가서 이겨야 되는데 아레나에서 그러기 위해선 에픽 조합을 키워야 되고 한방덱이나 아니면은 그밖에 공속덱이나 좋은 조합으로 들어가서 이겨야 되는데 현재 공속덱으로는 이기기가 힘들어요 많이.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.371,
                "end": 52.071
            },
            {
                "speaker_id": "1",
                "transcription": "기대할 수 있는 거는 진짜 실론 나이트이자 한방덱 밖에 기대할 게 없다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.081,
                "end": 56.015
            },
            {
                "speaker_id": "1",
                "transcription": "저는 그렇게 생각이 들거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.025,
                "end": 58.212
            },
            {
                "speaker_id": "1",
                "transcription": "실론 나이트 한방덱에 기대를 많이 해보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.222,
                "end": 60.934
            },
            {
                "speaker_id": "1",
                "transcription": "그게 이번 영상에 가장 큰 목적이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.944,
                "end": 63.851
            },
            {
                "speaker_id": "1",
                "transcription": "지금 스킬 설명보면은 한방덱을 위해서 좀 좋게 만들어지는 느낌이긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.861,
                "end": 69.398
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 보시는 것처럼 밑에 보면은 와일드 베리 마탕도 나오는데 와일드 베리 같은 경우에는 얘는 뭐 한방덱을 위해서 나오는 건 전혀 아닌 거 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.408,
                "end": 78.514
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리랑 같이 쓰거나 아니면은 대체해서 뭐 쓸 수 있게끔 아니면 뭐 3탱, 4탱 뭐 요렇게 쓸 수 있게끔 나오는 거라 뭐 한방덱과는 거리가 멀다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.524,
                "end": 88.971
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 승률이 예전처럼 막 무지성으로 들어가서 극한의 승률, 무조건 다 이기는 승률이 나오지는 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.981,
                "end": 96.840
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱을 지금 쓰기에는 좀 꺼려지는 상황이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.850,
                "end": 99.748
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트는 6월 21일 14시부터 16시까지 2시간 동안 이루어집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.758,
                "end": 104.768
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트 끝나고 라이브 방송을 통해서 리뷰 바로 해보도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 104.778,
                "end": 109.149
            },
            {
                "speaker_id": "1",
                "transcription": "구독 좋아요 한 번씩만 부탁드립니다.",
                "sound_type": [
                    2
                ],
                "start": 109.159,
                "end": 111.742
            },
            {
                "speaker_id": "1",
