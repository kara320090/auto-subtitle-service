        "term": [
            {
                "speaker_id": "1",
                "transcription": "토벌 연습모드로 한 번 보여드리겠습니다. 자 시작했을 때 자동 켜져 있는 상태에서 감초 한 번 예약해 줍니다.",
                "sound_type": [
