        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "굿굿굿 자 일단 뽑기 가볍게 가겠습니다 제발 퓨바 나와라 잠깐만 아 뭔가 시스템이 좀 좀 너무 이상하다 이거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.828
            },
            {
                "speaker_id": "1",
                "transcription": "아 제발 딸크 떴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.838,
                "end": 16.300
            },
            {
                "speaker_id": "1",
                "transcription": "아 으악 아 최악의 쿠키 나왔어 아 목소리가 뭔가 어려가지고 딸크인 줄 알았는데 아 아 하필이면 너야 진짜 와 진짜 세상에나 진짜 저건 진짜 나와도 안 쓴다 와",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.310,
                "end": 30.670
            },
            {
                "speaker_id": "1",
                "transcription": "와 계정 망했다 할 의욕을 잃었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.680,
                "end": 34.697
            },
            {
                "speaker_id": "1",
                "transcription": "야 근데 이거 재밌긴 하겠다 여러분들 이거 왜냐면은 여기서 한국 유저들 다 같이 하면은 다 같이 무과금으로 할 거 아니야 과금 못하니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.707,
                "end": 42.936
            },
            {
                "speaker_id": "1",
                "transcription": "어 진정한 실력겜 되겠는데 전부 다 무과금 상태에서 경쟁하는 거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.946,
                "end": 47.697
            },
            {
                "speaker_id": "1",
                "transcription": "진정한 실력 게임인데 여기서 야 모두 다 경쟁해 보자 진정한 실력 게임으로 가보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.707,
                "end": 53.467
            },
            {
                "speaker_id": "1",
                "transcription": "아 그건 그렇다 야 누구는 퓨바 뽑고 누구는 퓨바 못 뽑고 그거 차이 되게 심하겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.477,
                "end": 60.138
            },
            {
                "speaker_id": "1",
                "transcription": "야 누구는 독하게 리세로 퓨바 뽑고 시작하겠네 아 그러게요 나 그거 궁금하다 퓨바 상향 전 능력일까 상향 후 능력일까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.148,
                "end": 69.425
            },
            {
                "speaker_id": "1",
                "transcription": "그게 가장 포인트네 여긴 고대 전승 없나요 없을 거 같은데 그 중국 쿠키런 킹덤 하는 방법은 제가 내일 자세하게 영상화 시켜서 만들어 드리겠습니다 알겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.435,
                "end": 81.822
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 이거 본섭 나오면은 날라가지 않나 안 날라갈 걸요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.832,
                "end": 85.420
            },
            {
                "speaker_id": "1",
                "transcription": "이거 본섭 나오면 안 날라가지 않나 이거 여러분들 상식적으로 과금이 나왔는데 날아가는 게 말이 안되지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.430,
                "end": 91.117
            },
            {
                "speaker_id": "1",
                "transcription": "날라가요 과금한 사람 어떻게 돼요 그러면?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.127,
                "end": 93.597
            },
            {
                "speaker_id": "1",
                "transcription": "현질재화만 과금액에 따라서 100퍼센트 150퍼센트 200퍼센트로 페이백 해준다고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.607,
                "end": 99.305
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 여러분들 이거 하고 싶어요 나 궁금해 여러분들이 만약에 중국 쿠키런 킹덤을 이제 하는 법을 완벽하게 하는 방법을 알았어 그럼 바로 설치해서 할 거예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.315,
                "end": 108.965
            },
            {
                "speaker_id": "1",
                "transcription": "하고 싶어 이거를 궁금하다 무화과 안 쓰나요 나 죽어도 안 써요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 108.975,
                "end": 113.090
            },
            {
                "speaker_id": "1",
                "transcription": "근데 속도 2배는 너무 좋다 아 근데 야 여러분들 아니 데브 좀 약간 괘씸한 게 뭐 2배속 할 줄 알면서 왜 안 해주는 거야 본 서브에?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.100,
                "end": 120.988
            },
            {
                "speaker_id": "1",
                "transcription": "아니 도대체 2배속은 약올리는 것도 아니고 한국 서버에는 2배속 왜 안 해주는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 120.998,
                "end": 127.581
            },
            {
                "speaker_id": "1",
                "transcription": "어 찬스 왜 이렇게 아파?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 127.591,
                "end": 131.066
            }
        ]
    },
    "summary": "중국 쿠키런 킹덤하는 방법은 내일 영상화해서 올려드리고 중국에는 2배속을 해주면서 한국에는 2배속을 안 해주는 데브가 너무 괘씸하다.",
