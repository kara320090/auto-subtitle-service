        "term": [
            {
                "speaker_id": "1",
                "transcription": "예 상성 차이가 어마무시하게 많이 나죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.181
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 쫙쫙 네 이런 식으로 압승할 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.191,
                "end": 21.273
            },
            {
                "speaker_id": "1",
                "transcription": "자 다음도 공식대로 가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.283,
                "end": 25.357
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방이 홀 와일 때는 자 찰스를 쓰게 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.367,
                "end": 29.007
            },
            {
                "speaker_id": "1",
                "transcription": "자 한방덱을 찰스에 맞춰주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.017,
                "end": 31.386
            },
            {
                "speaker_id": "1",
                "transcription": "정석덱을 제 메인덱으로 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.396,
                "end": 34.772
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 순서만 맞춰주시면 승률은 거의 100퍼센트에 가깝게 이길 수가 있다.",
                "sound_type": [
