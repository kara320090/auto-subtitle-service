        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 출시된 용과 드래곤 드래곤 등급 최초로 나왔거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.265
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤 스킬을 보게 되면은 검기 2회 날리구요 회복량 감소시키구요 그리고 브레스 발사해서 피해 입히고 공격력 감소시키구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.275,
                "end": 13.050
            },
            {
                "speaker_id": "1",
                "transcription": "용과 버프를 중첩해서 스킬이 강화되구요 그리고 용으로 변신했을 때는 피해를 안 받구요 브레스 발사해서 피해 입히고 불 속성 피해 증가시키구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.060,
                "end": 22.766
            },
            {
                "speaker_id": "1",
                "transcription": "용으로 변신 시 이제 자신의 치명타 확률이 증가하고 모든 디버프 제거 용과 드래곤 등급에게 받는 피해 감소 그리고 토핑으로 증가하는 공격력에 비해서 피해 감소 증가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.776,
                "end": 33.585
            },
            {
                "speaker_id": "1",
                "transcription": "자 검기 피해량은 뭐 이렇게 되구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.595,
                "end": 36.102
            },
            {
                "speaker_id": "1",
                "transcription": "수치적인 면은 여러분들이 쭉 보시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.112,
                "end": 38.850
            },
            {
                "speaker_id": "1",
                "transcription": "에 받는 회복 감소는 15초 동안 35퍼센트 뭐 이런 식으로 중첩은 1개 브레스 피해량은 2초 동안 0.4초마다 110퍼센트 대상의 피해 감소 10퍼센트 무시",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.860,
                "end": 49.697
            },
            {
                "speaker_id": "1",
                "transcription": "공격력 감소는 15초 동안 이렇게 되고 중첩은 1개고 그리고 강화 브레스 피해량은 2초 동안 0.25초마다 195.6퍼센트 대상의 피해 감소 40퍼센트 무시",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.707,
                "end": 62.863
            },
            {
                "speaker_id": "1",
                "transcription": "불 속성 피해도 증가되구요 음 치명타 확률은 3초 동안 10퍼센트 증가 공격력 1퍼센트당 피해 감소 3퍼센트 드래곤 등급에게 받는 피해 감소 30퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.873,
                "end": 72.408
            },
            {
                "speaker_id": "1",
                "transcription": "야 용과 대 용과 한번 볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.418,
                "end": 74.426
            },
            {
                "speaker_id": "1",
                "transcription": "아 오늘 라즈베리다 그냥 이걸로 가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.436,
                "end": 77.143
            },
            {
                "speaker_id": "1",
                "transcription": "야 미러전 가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.153,
