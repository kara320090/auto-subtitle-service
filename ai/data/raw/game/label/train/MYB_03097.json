        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "힐러 덱한테는 세팅 어느 정도 좀 되긴 해야 되네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.614
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 여러분들 진심 세팅하면 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.624,
                "end": 6.068
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 종류 상관없이 다 들어가도 이기는지 그거를 좀 봐야 될 거 같네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.078,
                "end": 11.998
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 이 세팅을 지금 아까 보셨겠지만 막 진짜 어마무시한 피감을 요구하는 게 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.008,
                "end": 19.796
            },
            {
                "speaker_id": "1",
                "transcription": "보면 캡틴캐비어도 피감 없고 피감 얘 15퍼센트 다크카카오도 뭐 42퍼센트 뭐 블랙펄만 신경 써서 했는데 아마 여러분들이 볼 때 무조건 피감이 높아서 이겨야 된다. 이렇게 생각은 안 하셔도 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.806,
                "end": 34.831
            },
            {
                "speaker_id": "1",
                "transcription": "세팅은 쉽습니다. 세팅은 쉽고 거기서 여러분들 공, 치나 그거 세팅을 조금 더 진심으로 세팅하면은 한방 덱으로 더 활용할 수 있는 게 더 커질 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.841,
                "end": 50.083
            }
        ]
    },
    "summary": "남성이 힐러 덱한테는 세팅이 어느 정도 되어야 하지만 큰 피감을 요구하는 게 아니라 세팅이 쉬운데 진심으로 세팅하면 한방 덱으로도 활용할 수 있다고 합니다.",
