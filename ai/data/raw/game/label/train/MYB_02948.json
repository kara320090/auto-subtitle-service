    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 허브맛 쿠키가 지금 아레나에서 상당히 많이 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.066
            },
            {
                "speaker_id": "1",
                "transcription": "도대체 왜 이 허브맛 쿠키에 대해서 잠깐 설명을 드리자면은 이 쿠키가 출시 됐을 때부터 있던 쿠키거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.076,
                "end": 12.277
            },
            {
                "speaker_id": "1",
                "transcription": "단 한 차례의 상향도 없는데 현재까지 아직도 아레나에서 이번에 특히나 엄청나게 활용이 많이 되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.287,
                "end": 20.466
            },
            {
                "speaker_id": "1",
                "transcription": "그것 중의 하나가 이유가 하나가 디버프 제거 모든 디버프 이 한 줄이 거의 레전드 능력이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.476,
                "end": 28.107
            },
            {
                "speaker_id": "1",
                "transcription": "이 하나 때문에 엄청나게 활용성 높게 쓰이고 있고 힐량 자체는 어떠냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.117,
                "end": 33.451
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 퓨어바닐라보다도 낮고 BTS 쿠키보다도 낮고 크림유니콘보다도 힐링이 낮습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.461,
                "end": 40.043
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 힐량 자체는 티어로 굳이 구분하자면 1티어, 2티어 이렇게 떨어지지만 얘는 얘가 가진 능력 중에 가장 좋은 모든 디버프 제거 하나 때문에 엄청나게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.053,
                "end": 51.890
            },
            {
                "speaker_id": "1",
                "transcription": "또 하나 얘는 또 단점이 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.900,
                "end": 53.918
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 게 있냐면 힐링을 해 주는 구간이 딱 정해져 있기 때문에 만약에 아군의 홀리베리가 밀고 나거나 아니면은 자색고구마 같이 스킬을 밀어주는 애가 전방으로 뛰쳐나가면은 힐 받는 구역을 아군이 벗어나면 피를 받지 못하는 단점도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.928,
                "end": 69.800
            },
            {
                "speaker_id": "1",
                "transcription": "그럼에도 불구하고 허브맛 쿠키가 지금 상당히 많이 쓰이고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.810,
                "end": 75.056
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 한방 덱을 정말 잘 막아주거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.066,
                "end": 78.307
            },
            {
                "speaker_id": "1",
                "transcription": "일단 시작부터 보여드리자면 자 여러분 보시는 것 같이 전부다 되게 파란색 부분이 많이 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.317,
                "end": 84.035
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 허브 방 덱으로 되어 있는데 아 잘 맞는다 이게 지금 여기서 그렇게 끝이 된 끝이 아니라 어떤 덱을 잘 막는지를 여러분들 유심히 봐야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.045,
                "end": 93.441
            },
            {
                "speaker_id": "1",
                "transcription": "자 첫 번째 사진에서는 보면 밀키웨이, 다크초코, 다크카카오인데 막았죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.451,
                "end": 98.516
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째 요 사진에서도 보면은 무난하게 나머지 덱 뭐 잘 막고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.526,
                "end": 103.389
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여기서도 여러분들 봐 보셔야 될 게 다크카카오, 밀키웨이 한방 덱을 잘 막는다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 103.399,
                "end": 108.743
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 네 번째 사진에서도 밀키웨이, 다크카카오 요 덱을 잘 막고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 108.753,
                "end": 115.633
            }
        ]
    },
    "summary": "남성이 허브맛 쿠키가 한방 덱을 잘 막아줘서 지금 아레나에서 상당히 많이 쓰이는데 어떤 덱을 잘 막는지를 소개한다.",
