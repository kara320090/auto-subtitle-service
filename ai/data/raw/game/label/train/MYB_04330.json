        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 스킬 쿨타임 도는 대로 바로바로 써주고 자 이제 피감이 6퍼센트인데도 불구하고 버티죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 8.708
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 오징어 먹물도 스킬 써주고 네 최종적으로 살게 됐네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.718,
                "end": 17.767
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 하게 되면은 네 딜이 요렇게 나오는데 이 치명타 딜이 9500도 나오고 되게 높게 나오거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.777,
                "end": 25.527
            },
            {
                "speaker_id": "1",
                "transcription": "웨어울프의 치명타가 얼마나 터지냐에 따라서 얘가 1억도 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 25.537,
                "end": 29.237
            },
            {
                "speaker_id": "1",
                "transcription": "최고점이 1.6억까지 나옵니다.",
                "sound_type": [
                    2
                ],
                "start": 29.247,
                "end": 31.986
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보여드린 건 웨어울프 세팅 자체가 제가 즉석으로 공치 부 옵션 신경 없이 뭐 피감만 그냥 6퍼센트가 사는 걸 보여드리기 위해서 요렇게 세팅한 거거든요?",
                "sound_type": [
                    2
                ],
                "start": 31.996,
                "end": 41.439
            },
            {
                "speaker_id": "1",
                "transcription": "어 이렇게 가능하다.",
                "sound_type": [
                    2
                ],
                "start": 41.449,
                "end": 42.714
            },
            {
                "speaker_id": "1",
                "transcription": "다시 원래 제가 세팅한 걸로 다시 보여드리겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 42.724,
                "end": 45.710
            },
            {
                "speaker_id": "1",
                "transcription": "요걸로 피감 전 17퍼센트 안전하게 줬거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.720,
                "end": 47.998
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 뭐 나머지 세팅 그대로 입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.008,
                "end": 50.181
            },
            {
                "speaker_id": "1",
                "transcription": "이건 좀 1.5배속으로 갈게요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.191,
                "end": 51.604
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱 써주고 목화 눌러 주시고 그다음에 오징어 먹물 누르시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.614,
                "end": 55.672
            },
            {
                "speaker_id": "1",
                "transcription": "자 오먹 쓰고 나서 보스 출현 뒤에 웨어 울프 써서 자동으로 스킬 나가고 얘는 안 눌러주고 가만히 그냥 스킬 냅둡니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.682,
                "end": 62.415
            },
            {
                "speaker_id": "1",
                "transcription": "자 마카롱 누르고 나서 목화를 먼저 대기를 눌러줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 62.425,
                "end": 66.782
            },
            {
                "speaker_id": "1",
                "transcription": "40초 여기 40초를 기억하시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.792,
                "end": 68.965
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 목화 쓰고 우유 써주시고 자 25초 여기 부분 기억하셨다가 마카롱 먼저 스킬 먼저 대기 한 다음에 우유 누른다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.975,
                "end": 78.688
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 기억해 두시고 나머지는 스킬 쿨타임 도는 데로 바로바로 눌러주시고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.698,
                "end": 84.766
            }
        ]
    },
    "summary": "남성은 치명타 딜이 9500도 나오고 웨어울프의 치명타가 얼마나 터지냐에 따라서 1억도 나온다고 했고 지금 보여드린 건 공치 부 옵션 신경 없이 피감만으로 산다는 걸 보여준 것이고 40초를 기억하고 25초 부분에서 마카롱 쓰고 우유를 누른다는 걸 기억하라고 했다.",
