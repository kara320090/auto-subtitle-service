        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "주여 내 활이 되어주렴.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.134
            },
            {
                "speaker_id": "2",
                "transcription": "아무튼 저거 한방덱 일부러 들어오라고 낚시로 있는 것도 알긴 해요 제가 알기로는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.144,
                "end": 9.349
            },
            {
                "speaker_id": "1",
                "transcription": "주여 내 활이 되어주렴.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.359,
                "end": 11.546
            },
            {
                "speaker_id": "2",
                "transcription": "아 이거 일단 요렇게 해서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.556,
                "end": 14.616
            },
            {
                "speaker_id": "3",
                "transcription": "천명을 따르라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.626,
                "end": 15.579
            },
            {
                "speaker_id": "2",
                "transcription": "이기긴 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.589,
                "end": 16.489
            },
            {
                "speaker_id": "2",
                "transcription": "네 요런 식으로 지금 아무튼 무공비가 되면은 아마 무수히 많은 한방덱들이 들어갈 겁니다.",
                "sound_type": [
                    2
                ],
                "start": 16.499,
                "end": 22.592
            },
            {
                "speaker_id": "2",
                "transcription": "자 레어 무공비급 되어있는 거 두 번째 파훼법 덱도 제가 알려드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.602,
                "end": 27.436
            },
            {
                "speaker_id": "2",
                "transcription": "자 레어 무공비급이 되어 있을 때 나는 모노클덱이 없어요 하시는 분들한테 추천드릴 두 번째 덱은 요거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.446,
                "end": 34.481
            },
            {
                "speaker_id": "2",
                "transcription": "네 깃털덱으로 하시구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.491,
                "end": 36.479
            },
            {
                "speaker_id": "2",
                "transcription": "홀리베리 쿨, 올 쿨이고 용과 라즈베리 해주시고 쿨, 공속 높게 소르베는 올 쿨 그다음에 스타더스트 이렇게 4 애플젤리, 쿨 얘는 올 쿨 세팅.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.489,
                "end": 48.070
            },
            {
                "speaker_id": "2",
                "transcription": "근데 얘는 세팅하기 난이도가 좀 있는 게 소르베가 요렇게 호루라기를 받아야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.080,
                "end": 53.890
            },
            {
                "speaker_id": "2",
                "transcription": "용과가 이렇게 받아야 되고 호루라기 받는 대상 여러분들이 좀 유의해서 세팅을 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.900,
                "end": 59.778
            },
            {
                "speaker_id": "2",
                "transcription": "용과 4라즈, 1쿨은 어떤가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.788,
                "end": 62.460
            },
            {
                "speaker_id": "2",
                "transcription": "쿨이 너무 부족하면은 그렇게라도 세팅하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.470,
                "end": 65.964
            },
            {
                "speaker_id": "1",
                "transcription": "활이 되어주렴.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.974,
                "end": 67.092
            },
            {
                "speaker_id": "2",
                "transcription": "왜냐면 용과는 사실상 공격 타이밍이 가장 중요하기 때문에 쿨 자체가 너무나 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.102,
                "end": 76.300
            }
        ]
    },
    "summary": "레어 무공비급일 때 모노쿨덱이 없는 사람들에게는 깃털덱을 장착하고 홀리베리, 용과, 소르베, 스타더스트, 스냅 쿠키로 세팅한다.",
