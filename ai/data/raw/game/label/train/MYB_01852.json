        "term": [
            {
                "speaker_id": "1",
                "transcription": "그게 승부를 결정짓는 요소로 지금 이 순간 봤죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.862
            },
            {
                "speaker_id": "1",
                "transcription": "1분이 지나서 브레스가 상대 쿠키를 녹여 줬을 때 승부가 딱 결정이 납니다. 이런 식으로",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.872,
                "end": 13.165
            },
            {
                "speaker_id": "1",
                "transcription": "이분은 1 초월이고요. 나머지 스펙도 저보다 스펙이 높은 분입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.175,
                "end": 18.087
            },
            {
                "speaker_id": "1",
                "transcription": "자 가 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.097,
                "end": 20.359
            },
            {
                "speaker_id": "1",
                "transcription": "자 결국에는 이런 고스펙분하고 싸울 때 관전 포인트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.369,
                "end": 27.242
            },
            {
                "speaker_id": "1",
                "transcription": "승부 포인트는 1분 브레스에서 상대 쿠키가 먼저 녹냐 내 쿠키가 먼저 녹냐거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.252,
                "end": 35.441
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.451,
                "end": 36.609
            },
            {
                "speaker_id": "1",
                "transcription": "얼마나 정교하게 1분 브레스를 잘 다듬었냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.619,
                "end": 41.596
            },
            {
                "speaker_id": "1",
                "transcription": "자 1분이 다가옵니다.",
