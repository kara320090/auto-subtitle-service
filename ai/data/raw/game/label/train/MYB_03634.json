        "term": [
            {
                "speaker_id": "1",
                "transcription": "쟤네만 승급 높아서 의미가 없어. 벚꽃하고 웨어 울프 이런 거 뽑아야 되기 때문에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.388
            },
            {
                "speaker_id": "1",
                "transcription": "자 가도록 하겠습니다. 뽑기",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.398,
                "end": 6.873
            },
            {
                "speaker_id": "1",
                "transcription": "자 보물 뽑기도 지금 현재 무공비가 아이구야 귀욤 귀욤 1레벨이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.883,
                "end": 13.375
            },
            {
                "speaker_id": "1",
                "transcription": "너무나 귀여운 1레벨 자 이거는 무조건 레벨업 해주고 중요한 거는 이 무공비 같은 애들이 중요하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.385,
                "end": 21.610
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐만 내 제 느낌적인 느낌으로 내가 볼 때 스토리 왠지 시계나 다른 거 안 쓰실 거 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.620,
                "end": 27.885
            },
            {
                "speaker_id": "1",
                "transcription": "희한한 에픽으로 약간 중무장 돼 있을 가능성이 좀 큰 거 같은데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.895,
                "end": 33.551
            },
            {
                "speaker_id": "1",
                "transcription": "잠시만요. 아",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.561,
                "end": 36.583
            }
        ]
    },
    "summary": "화자가 무공비나 보물 뽑기를 레벨 업하다가 이분 스토리가 시계나 다른 거 안 쓰실 거 같다면서 희한한 에픽으로 중무장 돼 있을 가능성이 있다고 하면서 화면을 봤다.",
