        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 스냅 드래곤 예약하시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.970
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 중요한 게 이 두 가지를 연타로 정말 빠르게 눌러주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.980,
                "end": 7.536
            },
            {
                "speaker_id": "1",
                "transcription": "조금이라도 주스가 밀리면 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.546,
                "end": 9.596
            },
            {
                "speaker_id": "1",
                "transcription": "눌러서 발동 다 시켜주시고 자 그 다음에 밀키웨이를 예약을 눌렀죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.606,
                "end": 16.325
            },
            {
                "speaker_id": "1",
                "transcription": "아까 말씀드린 대로 쿠키가 걸어갈 때는 연타해서 누르는 게 빠르고요.",
                "sound_type": [
                    2
                ],
                "start": 16.335,
                "end": 20.009
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키들이 가만히 이렇게 멈춰서 있을 때 이럴 때는 예약 눌러서 하는 게 가장 빠릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.019,
                "end": 24.830
            },
            {
                "speaker_id": "1",
                "transcription": "연타 안 하시고 이때는 자동으로 하시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 24.840,
                "end": 27.301
            },
            {
                "speaker_id": "1",
                "transcription": "단 쿠키가 스킬이 연속으로 이어질 때 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.311,
                "end": 30.867
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 발동되고 얘가 발동될 때 그 다음 쿠키는 예약하지 마시고 연타를 눌러야 바로 나갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.877,
                "end": 36.420
            },
            {
                "speaker_id": "1",
                "transcription": "이런 각각의 상황에 따라서 쿠키가 가장 스킬이 빨리 나가는 상황이 몇 가지가 다른 경우가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.430,
                "end": 43.233
            }
        ]
    },
    "summary": "남성이 쿠키가 걸어갈 때나 스킬이 연속될 때에는 연타를 하는 게 빠르고 쿠키가 가만히 있을 때에는 예약을하는 게 가장 빠르다고 조언한다.",
