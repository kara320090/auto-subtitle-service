        "term": [
            {
                "speaker_id": "1",
                "transcription": "저도 아까 전에 그 얘기를 할까 말까 하다가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.189
            },
            {
                "speaker_id": "1",
                "transcription": "걔가 범용 검 쓰니까 붙어 있으면 안 되겠고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.199,
                "end": 5.296
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 좀 이렇게 살짝 거리가 있어야지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.306,
                "end": 7.695
            },
            {
                "speaker_id": "1",
                "transcription": "너무 멀어 가지고.",
