                    2,
                    3
                ],
                "start": 7.705,
                "end": 8.384
            },
            {
                "speaker_id": "2",
                "transcription": "기메 말 해석해 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.380,
                "end": 9.415
            },
            {
                "speaker_id": "2",
                "transcription": "힐 쓰기 힘드니까 내 쪽에 붙어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.424,
                "end": 10.935
            },
            {
                "speaker_id": "1",
                "transcription": "붙는 거 안 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.945,
                "end": 11.980
            },
            {
                "speaker_id": "1",
                "transcription": "붙으면 너무 가까워서 저게 범용 검 쓰면 얻어맞고 죽기 때문에.",
                "sound_type": [
                    2,
