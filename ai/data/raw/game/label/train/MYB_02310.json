        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "내가 수많은 리뷰를 해봤지만 약간 이렇게 조합 하나 못 찾고 쓰는 방향성을 못 찾은 리뷰는 진짜 처음이네 아레나 조합이 나올 때까지는 일단은 티어는 저도 모르겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 13.055
            },
            {
                "speaker_id": "1",
                "transcription": "이거 진짜 최초다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.065,
                "end": 13.984
            },
            {
                "speaker_id": "1",
                "transcription": "내가 보통은 1티어다 0티어다 이렇게 말하는데 아 덱 개발에 시간이 필요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.994,
                "end": 19.038
            },
            {
                "speaker_id": "1",
                "transcription": "확실한 좋은 사용처가 나오면은 제가 따로 조합을 올리고 티어를 다시 좀 정해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.048,
                "end": 25.482
            },
            {
                "speaker_id": "1",
                "transcription": "자 퀸아망쿠키가 제가 리뷰할 때까지만 해도 방향을 못 찾아서 제가 방황을 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.492,
                "end": 32.820
            },
            {
                "speaker_id": "1",
                "transcription": "@계정1님이 길드를 깎아서 조합을 깎아서 완성형으로 만드셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.830,
                "end": 38.008
            },
            {
                "speaker_id": "1",
                "transcription": "세팅이 이렇게 따라 하시면은 진짜 사기적인 승률을 볼 수가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.018,
                "end": 42.861
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 조건이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.871,
                "end": 44.037
            },
            {
                "speaker_id": "1",
                "transcription": "뭔 조건이냐면 망토 보물은 퀸아망이랑 마들렌이 받습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.047,
                "end": 48.218
            },
            {
                "speaker_id": "1",
                "transcription": "또 다른 조건은 퀸아망의 공격력이 마들렌보다 높아야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.228,
                "end": 52.732
            },
            {
                "speaker_id": "1",
                "transcription": "그 이유가 스타더스트가 공격력이 가장 높은 쿠키를 별 표식을 붙이는데 달빛술사가 공격력이 높아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.742,
                "end": 61.100
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 얘는 맨 처음에 별 표식 들어올 때 얘는 스킬 발동돼서 무적 돼서 붕 떠 가는 상태라 스타더스트는 퀸아망쪽으로 날아오게 타깃을 잡아줘야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.110,
                "end": 71.709
            },
            {
                "speaker_id": "1",
                "transcription": "토핑은 홀리베리는 쿨 높으면 높을수록 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.719,
                "end": 75.492
            },
            {
                "speaker_id": "1",
                "transcription": "이거 만드신 @계정1님도 홀베 쿨 되게 높게 하셨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.502,
                "end": 79.691
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 23퍼센트도 저는 괜찮게 돌아가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.701,
                "end": 82.082
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 퀸아망 같은 경우에는 공속 부분을 망토 보물을 받을 수 있게끔 쿨 없이 뒤에 피감 높게 해주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.092,
                "end": 88.787
            },
            {
                "speaker_id": "1",
                "transcription": "저는 공격력에 좀 더 부옵션 더 줬고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.797,
                "end": 91.950
            },
            {
                "speaker_id": "1",
                "transcription": "마들렌은 쿨 3퍼센트 대 공속도 망토 받을 수 있게끔 여유되면 공치 주는데 중요한 건 퀸아망이 더 공격력이 높아야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.960,
                "end": 100.820
            },
            {
                "speaker_id": "1",
                "transcription": "달빛은 쿨 3퍼센트 이하 낮게 해주시고 피감은 높으면 높을수록 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.830,
                "end": 108.730
            },
            {
                "speaker_id": "1",
                "transcription": "퓨바는 어 쿨타임 7퍼센트 후반 이상 그 이상으로 맞춰주면 좋을 것 같고 올 아몬드입니다.",
                "sound_type": [
                    2,
