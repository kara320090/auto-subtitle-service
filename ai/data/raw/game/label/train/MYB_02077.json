    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분들이 하고 있는 게임 재미있나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.269
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 모바일게임 요즘 너무 할 게 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.279,
                "end": 9.866
            },
            {
                "speaker_id": "1",
                "transcription": "과금 없이 즐길 만한 게임 없나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.876,
                "end": 11.970
            },
            {
                "speaker_id": "1",
                "transcription": "더 이상 숙제 말고 힐링하고 재미를 느끼고 싶어요 하시는 분들 이 게임은 현질 없이도 엄청나게 빠져듭니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.980,
                "end": 19.055
            },
            {
                "speaker_id": "1",
                "transcription": "주변에 지인분들도 다운로드 받고 재미없다고 지운 사람을 한 명도 못 봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.065,
                "end": 23.634
            },
            {
                "speaker_id": "1",
                "transcription": "저 또한 이미 갓게임이라고 추천받아서 게임을 하고 있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.644,
                "end": 27.428
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 이 게임을 제가 찍먹식으로 소개하고 끝나는 게 아니라 저는 정말 제대로 쭉 할 생각입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.438,
                "end": 32.783
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 도대체 뭐가 재밌다는 건가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.793,
                "end": 35.156
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 게임은 일단 왕국 꾸미기 게임입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.166,
                "end": 37.997
            },
            {
                "speaker_id": "1",
                "transcription": "다양한 미니게임도 있고 친구들과 함께 왕국을 합쳐서 같이 꾸밀 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.007,
                "end": 42.802
            },
            {
                "speaker_id": "1",
                "transcription": "낚시 시스템도 있고 농작물 재배도 할 수 있고 친구들끼리 가족들끼리 부족한 물품을 대신 채워줄 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.812,
                "end": 50.667
            },
            {
                "speaker_id": "1",
                "transcription": "도시 레벨을 올리면 다양한 콘텐츠도 새롭게 열리고 다양한 꾸미기 건물들도 건설 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.677,
                "end": 56.350
            },
            {
                "speaker_id": "1",
                "transcription": "또한 뽑기를 통해 동물들을 뽑을 수 있고 그 동물들을 통해서 아기 동물도 태어납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.360,
                "end": 61.631
            },
            {
                "speaker_id": "1",
                "transcription": "뽑기 재화는 과금할 필요 없이 일정 시간마다 계속 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.641,
                "end": 65.361
            },
            {
                "speaker_id": "1",
                "transcription": "꾸미기 뽑기도 일정 시간마다 계속 계속 지급해줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.371,
                "end": 69.107
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 뽑기권 자체를 무료로 계속 지급해줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.117,
                "end": 72.521
            },
            {
                "speaker_id": "1",
                "transcription": "왕국 꾸미기 대회도 항상 열려 있고 이벤트를 통해서 무료로 얻는 재화나 이벤트 쿠폰도 엄청나게 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.531,
                "end": 79.589
            },
            {
                "speaker_id": "1",
                "transcription": "지금 신규 쿠폰도 무려 9개나 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.599,
                "end": 82.439
            },
            {
                "speaker_id": "1",
                "transcription": "고정 댓글에 다운로드 링크와 쿠폰 번호 오픈톡방 링크를 적어놨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.449,
                "end": 87.132
            },
            {
                "speaker_id": "1",
                "transcription": "화면에 보이는 설정 쿠폰 입력란에 입력해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.142,
                "end": 90.645
            },
            {
                "speaker_id": "1",
                "transcription": "또한 제가 아까 말씀드린 대로 제대로 게임을 오랫동안 팁 정보 공유하면서 시청자분들과 함께 할 거라 오픈톡방도 만들었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.655,
                "end": 98.528
            },
            {
                "speaker_id": "1",
                "transcription": "미니게임을 통해서 기프트카드 이벤트도 하고 서로 친구와 가족도 찾으실을 분들은 오픈톡방으로 들어와주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.538,
                "end": 105.466
            }
        ]
    },
    "summary": "더 이상 숙제 말고 힐링하고 재미를 느끼고 싶어요 하시는 분들 이 게임은 현질 없이도 엄청나게 빠져든다고 주변에 지인분들도 다운로드 받고 재미없다고 지운 사람을 한 명도 못 봤다고 하면서 저 또한 이미 갓게임이라고 추천받아서 게임을 하고 있었다고 얘기한다.",
