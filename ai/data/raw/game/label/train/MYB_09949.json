        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 진격의 거인 그 캐릭터랑 비슷해요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.030
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 오르골 소리 너무 좋다. 어디로 가야 되냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.030,
                "end": 7.128
            },
            {
                "speaker_id": "1",
                "transcription": "문 여기 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.138,
                "end": 16.950
            },
            {
                "speaker_id": "1",
                "transcription": "나 근데 내가 너무 쎄서 이게 다크소울 같은 거였으면 개 사리면서 했을 텐데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.950,
                "end": 33.700
            },
            {
                "speaker_id": "1",
                "transcription": "아 또 이거 너무 멀어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.700,
                "end": 39.643
            },
            {
                "speaker_id": "1",
                "transcription": "아 잘못 왔다.",
