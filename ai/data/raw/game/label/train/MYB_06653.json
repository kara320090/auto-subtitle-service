                    3
                ],
                "start": 11.861,
                "end": 16.221
            },
            {
                "speaker_id": "2",
                "transcription": "당신이 눈에서 개안한 이의 맑음이 느껴지지 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.231,
                "end": 19.527
            },
            {
                "speaker_id": "2",
                "transcription": "오히려 불안감의 냄새만이 진득하게 풍기는 군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.537,
                "end": 22.369
            },
            {
                "speaker_id": "2",
                "transcription": "이 종이를 이것을 봐 주십시오.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.379,
                "end": 24.451
            },
            {
                "speaker_id": "2",
                "transcription": "당신 여기에 무엇이 그려져 있습니까?",
