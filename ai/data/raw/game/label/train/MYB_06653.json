        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 앞 백설과를 먹어라?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.835
            },
            {
                "speaker_id": "1",
                "transcription": "아 잘못 눌렀다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.845,
                "end": 5.855
            },
            {
                "speaker_id": "1",
                "transcription": "왔다 왔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.865,
                "end": 8.179
            },
            {
                "speaker_id": "2",
                "transcription": "거기 당신 처음 보는 얼굴이로군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.189,
                "end": 11.851
            },
            {
                "speaker_id": "2",
                "transcription": "개안하셨습니까? 성령의 목소리가 들리시나요? 성령의 모습이 보이십니까?",
                "sound_type": [
