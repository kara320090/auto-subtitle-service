        "term": [
            {
                "speaker_id": "1",
                "transcription": "나 아무래도 JRPG로 가야 되나 봐. 갬성은 어쩔 수 없나봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.721
            },
            {
                "speaker_id": "1",
                "transcription": "무슨 노래 이어지는 거 미쳤다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.731,
                "end": 9.184
            },
            {
                "speaker_id": "1",
                "transcription": "근데 무슨 이렇게 정말 많은 사람들이 투입됐네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.194,
                "end": 19.129
            },
            {
                "speaker_id": "1",
                "transcription": "너무너무 진짜 뭔가 게임이 끝나는 게 아쉬워 가지고 이거를 못 끈다. 지금 내가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.139,
                "end": 25.486
            },
            {
                "speaker_id": "1",
                "transcription": "이게 이 여운을 지금 밖에 못 느끼는 거거든.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.496,
                "end": 29.428
            },
            {
                "speaker_id": "1",
                "transcription": "이게 여기서 바로 스킵해 가지고 넘어가 버리면은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.438,
                "end": 32.866
            }
        ]
    },
    "summary": "20대 여성이 게임 브금이 너무 멋있어서 스킵해서 끌 수가 없다고 이야기하고 있다.",
