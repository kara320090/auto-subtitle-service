        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "에픽 등급으로 나오고 크림 유니콘 쿠키가 등장합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.797
            },
            {
                "speaker_id": "1",
                "transcription": "이 쿠키는 회복형입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.807,
                "end": 6.300
            },
            {
                "speaker_id": "1",
                "transcription": "회복형 쿠키는 평타자체가 아군한테 힐을 주는 개념이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.310,
                "end": 10.346
            },
            {
                "speaker_id": "1",
                "transcription": "따른 유형들은 전부 다 평타가 상대를 적한테 공격을 가지만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.356,
                "end": 14.432
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 회복형은 평타자체가 일반공격이 다 아군한테 힐을 주는 거기 때문에 제가 예상하기에는 허브맛 쿠키를 대체해서 아레나에서 맹활약을 할 가능성이 상당히 높다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.442,
                "end": 24.432
            },
            {
                "speaker_id": "1",
                "transcription": "후방향에다가 중요한 거는 이쿠키의 능력인데 아직 오픈 되지가 않았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.442,
                "end": 29.341
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 떠도는 스킬 유출된거를 들어보면 엄청나게 사기일 가능성이 크다 제가 이거는 출시날 5 초월까지 찍어서 리뷰를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.351,
                "end": 38.683
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 왕국 꾸미기 기능 추가 및 개선 그동안 왕국 꾸미기불편했던 부분들의 다양한 개선과 함께 추가기능이 업데이트됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.693,
                "end": 46.078
            },
            {
                "speaker_id": "1",
                "transcription": "편리한 꾸미기 기능과 함께 여러분들의 쿠키 왕국을 멋지게 꾸며보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.088,
                "end": 49.451
            },
            {
                "speaker_id": "1",
                "transcription": "편집 언두 리두 기능 그다음 데코 빠른 교체 데코 한 번에 구매 쿠키 하우스 스킨 바닥 일괄 변경 데코 보유량 표시 그다음에 바로 구매 비정상종료에 대한 편집복구 이렇게 된다고 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.461,
                "end": 63.860
            },
            {
                "speaker_id": "1",
                "transcription": "자세한 내용은 공식 카페 있으니까 확인해 보시면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.870,
                "end": 66.921
            },
            {
                "speaker_id": "1",
                "transcription": "일부 컨텐츠 보상 수량 상향 쿠키 하우스 풍요의 분수 월드 탐험에서 경험의 별사탕 생산량이 증가된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.931,
                "end": 75.023
            },
            {
                "speaker_id": "1",
                "transcription": "지금 쿠키가 70레벨까지 확장됐기 때문에 별사탕 수급에 대한 문제가 꾸준히 제기가 되는 부분인데 근데 그런부분은 이제 보통 초반 유저분들 그다음에 복귀 유저분들한테 별사탕이 상당히 부족해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.033,
                "end": 87.242
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들을 위해서 생산량이 증가되는 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.252,
                "end": 91.032
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 디즈니 콜라보 업데이트 이번 업데이트는 확실히 콜라보에 집중돼서 나오는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.042,
                "end": 97.931
            },
            {
                "speaker_id": "1",
                "transcription": "되게 기대가 되고 7월 28일 목요일 날 진행되기 때문에 언제나 그래왔듯이 전 여태까지 업데이트 리뷰를 놓친 적이 단 한 번도 없는데 이날도 마찬가지로 모든 거 다 리뷰를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.941,
                "end": 111.202
            },
            {
                "speaker_id": "1",
                "transcription": "구독과 좋아요 한 번씩만 부탁드리고 열심히 리뷰해보도록 할게요. 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 111.212,
                "end": 119.300
            }
        ]
    },
    "summary": "화자가 복귀 유저분들한테 별사탕이 상당히 부족하다고 설명하고있다.",
