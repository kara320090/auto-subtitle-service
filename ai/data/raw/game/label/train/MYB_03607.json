                "end": 4.600
            },
            {
                "speaker_id": "1",
                "transcription": "1주년 때 쿠폰 그때 몇 장이었죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.600,
                "end": 7.544
            },
            {
                "speaker_id": "1",
                "transcription": "그때 쿠폰으로만 크리스탈 15000개 이상이었던 것 같은데?",
