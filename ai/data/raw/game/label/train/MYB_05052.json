        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 서리가 쓰는 덱이 돌아왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.685
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱 정말 좋거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.695,
                "end": 4.136
            },
            {
                "speaker_id": "1",
                "transcription": "상대가 공속덱 제외하고 투탱이면 정말 승률이 엄청나게 높고 원탱덱도 질 때도 있지만 아까 해보니까 이길 때도 많고 투탱공속덱도 해보니까 이길 때도 있고 질 때도 있고 뭐 그렇게 나오는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.146,
                "end": 16.995
            },
            {
                "speaker_id": "1",
                "transcription": "일단 투탱방덱에서 정말 상대가 많이 보일 때 이거 들어가면 엄청난 승률을 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.005,
                "end": 23.610
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 세팅을 먼저 보면은 무공비 깃털 시계 부분에다가 와일드 베리 쿠키는 쿨타임 뭐 3퍼센트 근처 그렇게 주시면 될 것 같고 피감 높게 능력 되는대로 하고 공속은 굳이 그렇게 크게 신경 안 써도 될 것같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.620,
                "end": 37.170
            },
            {
                "speaker_id": "1",
                "transcription": "에스프레소 같은 경우에도 보니까 8퍼센트 맞춰주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.180,
                "end": 40.886
            },
            {
                "speaker_id": "1",
                "transcription": "너무 높으면은 1분 전에 공격이 다 들어갈 것 같아서 8퍼센트 대 맞추고 에스프레소 피감 신경 써 주시면 될 것 같고 서리 같은 경우에는 쿨타임 공속 필요 없이 그냥 피감하고 체력 부옵션 있을 수 있으면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.896,
                "end": 53.678
            },
            {
                "speaker_id": "1",
                "transcription": "안 죽는 게 중요한 역할이라 신규 레전드 블랙펄 같은 경우에도 쿨타임 23.7로 했는데 23점 휴반대에 해주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.688,
                "end": 62.014
            },
            {
                "speaker_id": "1",
                "transcription": "세트 효과 포함 안 하고 피감은 가능한한 여러분들이 세팅이 높게 크림 유니콘은 쿨타임 17퍼센트대에 피감은 가능한 높게 여러분들 능력껏 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.024,
                "end": 73.152
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.162,
                "end": 76.316
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.326,
                "end": 79.656
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.666,
                "end": 84.332
            },
            {
                "speaker_id": "1",
                "transcription": "자 한 번 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.342,
                "end": 86.479
            },
            {
                "speaker_id": "1",
                "transcription": "이게 투탱이면 다 들어가면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.489,
                "end": 88.056
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱 아니고 투탱이면은 전부 다 승률 거의 100퍼센트 가까운 승률을 보인다고 하니까 네 이거 쓰시면 좋을 거 같아요.",
                "sound_type": [
