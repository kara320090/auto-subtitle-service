            },
            {
                "speaker_id": "1",
                "transcription": "요 웨울덱이 지금 방덱에 많이 쓰이는 이유는 덱 종류가 되게 다양하거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.104,
                "end": 10.308
            },
            {
                "speaker_id": "1",
                "transcription": "그거를 무난하게 제일 잘 막는 덱이에요.",
