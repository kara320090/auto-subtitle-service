        "term": [
            {
                "speaker_id": "1",
                "transcription": "제 던지는 게 핵폭탄이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.533
            },
            {
                "speaker_id": "1",
                "transcription": "네 이번에는 소르베가 좀 역할을 했는데 아까 얘 혼자 1400만 딜 넣었거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.533,
                "end": 7.420
            },
            {
                "speaker_id": "1",
                "transcription": "어마무시하게 혼자 원맨쇼 할 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.420,
                "end": 11.486
            },
            {
                "speaker_id": "1",
                "transcription": "음 서리랑 그다음에 그 디버프 같은 경우에는 허브가 다 풀어 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.496,
                "end": 19.526
            },
            {
                "speaker_id": "1",
                "transcription": "크런치 덱이 있을 때 딜이 뻥튀기 되는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.526,
                "end": 22.780
            },
            {
                "speaker_id": "1",
                "transcription": "일반적으로 1400만 딜이 매판 나오는 건 아니고 크런치 초코칩이 상대방 있을 때 그럴 때 좀 그럼 딜이 뻥튀기가 되는 느낌",
                "sound_type": [
                    2,
