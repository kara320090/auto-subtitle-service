        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.204
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 MAC 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.214,
                "end": 6.468
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.478,
                "end": 10.222
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 쿠폰을 모두 입력하면 크리스탈 5000개, 무지개큐브 2000개, 아미밤 3500개를 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.232,
                "end": 17.334
            },
            {
                "speaker_id": "1",
                "transcription": "자 추가로 여러분들이 바로 해야 될 이벤트는 지금 시간이 얼마 안 남았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.344,
                "end": 21.848
            },
            {
                "speaker_id": "1",
                "transcription": "자 랭킹 보상으로 여러분들 크리스탈 7000개 그 다음에 한정 칭호 그 다음에 아미밤 2500개 또 펄미션 투 댄스에서도 크리스탈 7000개랑 아미밤 7000개 한정 칭호를 얻을 수 있는데 이게 이제 남은 시간이 얼마 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.858,
                "end": 35.839
            },
            {
                "speaker_id": "1",
                "transcription": "영상이 올라간 시점에서는 몇 시간밖에 안 남았을 텐데 요거를 꼭 하셔야 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.849,
                "end": 40.892
            },
            {
                "speaker_id": "1",
                "transcription": "실력적인 부분보다도 다른 부분에서 점수를 더 올릴 수가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.902,
                "end": 45.489
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기 보면은 체력 같은 경우에도 여러분들 BTS 쿠키 레벨, 승급 그 다음에 스킨 상테에 따라서 점수가 더 올라가기 때문에 여러분들이 뽑기를 통해서 어 점수 높게 해서 퍼센트 상위 보상을 받기를 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.499,
                "end": 59.201
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 기본적으로 이렇게 뽑기를 해서 나오는 뭐 스큰이나 승급을 하셔가지고 어 랜드마크까지 얻게 되면은 자 이 랜드마크를 밖에다 꺼내놓고 아미밤을 항상 받으셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.211,
                "end": 72.107
            },
            {
                "speaker_id": "1",
                "transcription": "아미밤을 받아서 뽑기를 많이 하시면은 여러분들 나중에 여기 보이죠 리미티드 에디션 요렇게 다 컬렉션을 모으게 되면 크리스탈도 전부 다 합해서 8000개를 더 받을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.117,
                "end": 84.694
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 여러분들이 귀찮아서 안 받는 분도 있는데 하루에 한 번 무료 패키지라고 해서 아미밤 이거 200개씩 매일매일 주거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.704,
                "end": 92.538
            },
            {
                "speaker_id": "1",
                "transcription": "귀찮아도 여러분들 로그인해서 크리스탈 공짜로 주는 거 저거 놓치지 말고 이거 받으시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.548,
                "end": 98.907
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 여러분들 이 기능에 대해서도 잘 모르시는 분도 있는데 티켓 보상 배수 요렇게 늘려가지고 한 번에 깨는 방법이 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.917,
                "end": 107.287
            },
            {
                "speaker_id": "1",
                "transcription": "다섯 번을 한 번에 티켓 소모해서 하는 방법인데 자 저거 같은 경우에는 리듬 스테이지에서 A등급 이상 10회 클리어하기 이런 거 있죠 한 번에 클리어할 때 쓰시거나 여러 번",
