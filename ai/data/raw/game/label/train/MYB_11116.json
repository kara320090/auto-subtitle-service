            {
                "speaker_id": "2",
                "transcription": "저녁 때 여동생의 생존 확인 중 기침이 심하다고 하길래 혹시 모르니 병원 가 보라고 했는데 답장 온게 역시 코로나 키윽 키윽 키윽 나고 한약 챙겨 먹으라고 했음",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.523,
                "end": 16.311
            },
            {
                "speaker_id": "3",
                "transcription": "아 진짜 아프겠다 물도 많이 드시라고 전해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.321,
                "end": 18.603
            },
            {
                "speaker_id": "3",
                "transcription": "코로나 목이 너무 아프니까 그죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.613,
                "end": 20.301
            },
            {
                "speaker_id": "3",
                "transcription": "아이고 아이고 이런",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.311,
                "end": 21.128
            },
            {
                "speaker_id": "3",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
