    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 논란이 오늘 하루에 3개나 터졌습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.893
            },
            {
                "speaker_id": "1",
                "transcription": "정말 심각한 내용들이고 관련해서 제가 한번 다뤄 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.903,
                "end": 8.425
            },
            {
                "speaker_id": "1",
                "transcription": "아 간단하게 일단 첫 번째 논란이 되었던 거는 오늘 임시 점검을 했죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.435,
                "end": 13.204
            },
            {
                "speaker_id": "1",
                "transcription": "임시 점검 보상이 특정 유저는 3번이 들어왔어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.214,
                "end": 16.696
            },
            {
                "speaker_id": "1",
                "transcription": "어 어떤 사람은 2번 들어온 사람도 있고 어떤 사람은 1번 들어왔는데 이거에 대해서 불만이 있다고 이제 유저분들이 글을 카페에다 쓰면은 글을 무차별적으로 삭제되는 상황이 있다고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.706,
                "end": 28.906
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 이런 관련된 내용에 대해서 공지도 하나도 없고 운영자분들은 아무 얘기도 없는 상황이다 첫 번째.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.916,
                "end": 36.581
            },
            {
                "speaker_id": "1",
                "transcription": "자 두 번째는 임시 점검을 통해서 5시간 동안 이 점검을 했거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.591,
                "end": 42.320
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이제 변동된 가격이 생겼어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.330,
                "end": 45.435
            },
            {
                "speaker_id": "1",
                "transcription": "앱스토어랑 이제 구글스토어 가격 변동이 생겼는데 문제는 오전에 업데이트를 하고 나서 앱스토어는 가격이 변동되지 않은 그대로가 업데이트됐고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.445,
                "end": 55.219
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 구글스토어는 25퍼센트 가격이 상승된 상태로 업데이트가 돼 가지고 그 상태 때문에 가격이 바뀌지 않은 걸로 약간 논란이 오전에 있었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.229,
                "end": 66.270
            },
            {
                "speaker_id": "1",
                "transcription": "근데 어 오전에 있었던 내용에 대해서 뭐 따로 공지가 단 하나도 없는 상태입니다 현재.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.280,
                "end": 74.066
            }
        ]
    },
    "summary": "남자는 쿠키런 킹덤 논란이 오늘 3개 있었다며 첫 번째 논란은 임시 점검 보상이 사람에 따라 1번, 2번, 3번 다르게 들어와서 불만을 카페에 쓰면 글이 무차별적으로 삭제되는 상황이 있었다고 하고 두 번째 논란은 5시간 동안 임시 점검해서 가격 변동이 생겼는데 오전 업데이트 후 앱스토어는 가격 변동 없이 그대로 업데이트됐고 구글스토어는 25퍼센트 가격이 상승된 상태로 업데이트돼서 논란이 있었다고 하며 이 내용에 대해서 현재 공지가 단 하나도 없는 상태라고 한다.",
