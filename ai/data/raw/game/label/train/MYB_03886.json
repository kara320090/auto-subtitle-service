        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 되고 뱀파랑 목화가 두 개가 쿨 돌아오는 대로 바로 쓸 거거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.413
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 자 목화 스킬 썼죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.423,
                "end": 9.328
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 살아남아서 목화가 돌아가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.338,
                "end": 12.449
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 중요한 거는 자동을 그대로 납두면 캡틴캐비어가 스킬을 일찍 쓰기 때문에 자동을 꺼줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.459,
                "end": 18.065
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 9시에 맞춰서 쓸 거예요 왜냐 딱총에 맞춰서 쓰기 위해서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.075,
                "end": 22.106
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 돌아가다가",
