        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "역시나 몰라서 라즈베리로 선택해서 몇 개 강화하고 나서 나머지는 전부 다 올 쿨로 파밍하고 있는 상태고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.098
            },
            {
                "speaker_id": "1",
                "transcription": "한 가지 주의할 점은 여러분들 강화하다가 첫 번째, 두 번째가 피해 감소가 안 나왔다고 절대 삭제하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.108,
                "end": 14.306
            },
            {
                "speaker_id": "1",
                "transcription": "특별 토핑은 마지막 단계에 있어서 피가 6퍼센트가 뜰 수도 있기 때문에 12강까지 전부다 해라 이게 가장 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.316,
                "end": 21.545
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 또 하나 더 자 인어 선택권 상자 가지고 있는데 어떤 거 선택하나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.555,
                "end": 27.208
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 날까지 가지고 계세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.218,
                "end": 29.098
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.108,
                "end": 29.757
            },
            {
                "speaker_id": "1",
                "transcription": "가지고 있다가 운 좋게 뽑기로 만약에 이 3개를 다 모으면은 나중에 5000크리스탈로 교환할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.767,
                "end": 37.187
            },
            {
                "speaker_id": "1",
                "transcription": "이 뽑기 기간이 거의 끝날 때쯤까지 얘네들 뽑아보고 다 뽑히면서 은 크리스탈 5000개로 바꾸고 예 만약에 안 뽑힌 게 있으면은 그 나머지 하나를 선택하면 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.197,
                "end": 47.693
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여러분들 궁금한 점은 댓글에 남겨주시면 요새 제가 최대한 댓글 전부다 확인하고 댓글 다 달아드리고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.703,
                "end": 56.191
            },
            {
                "speaker_id": "1",
                "transcription": "네 궁금한 점은 댓글에 남겨 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.201,
                "end": 59.313
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트는 9월 8일로 확정이 되어있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.323,
                "end": 62.332
            },
            {
                "speaker_id": "1",
                "transcription": "자 공지사항 보면은 박하사탕 성장 이벤트가 되어있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.342,
                "end": 66.078
            },
            {
                "speaker_id": "1",
                "transcription": "9월 8일 2시에 끝나기 때문에 업데이트도 2시부터 7시까지 진행이 되고 그날 제가 업데이트 리뷰도 진행하도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.088,
                "end": 74.563
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕 등급 달성 이벤트도 진행 중이니까 네 여유가 되는 분들은 보상에 맞춰서 달성을 해주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.573,
                "end": 81.223
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕 자체가 뭐 쓰레기 쿠키는 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.233,
                "end": 83.727
            },
            {
                "speaker_id": "1",
                "transcription": "네 지금 이렇게 활용될 수 있는 조합이 있기 때문에 어 필요하신 분들은 키워서 3딜덱 저격으로 뭐 쓰는 분도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.737,
                "end": 92.349
            },
            {
                "speaker_id": "1",
                "transcription": "자 영상은 여기서 마치겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.359,
                "end": 94.757
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.767,
                "end": 111.718
            }
        ]
    },
    "summary": "특별 토핑은 마지막 단계에 있어서 피가 6퍼센트가 뜰 수도 있기 때문에 강화하다가 피해 감소가 안 나왔다고 절대 삭제하면 안 되고 12강까지 전부 해야 하며 인어 선택 상자는 나중에 5000크리스탈로 교환할 수가 있기 때문에 마지막 날까지 가지고 있어야 하며 9월 8일 2시부터 7시까지 업데이트 진행이 되고 그날 업데이트 리뷰도 진행이 된다.",
