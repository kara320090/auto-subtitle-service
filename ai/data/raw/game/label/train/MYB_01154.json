            },
            {
                "speaker_id": "1",
                "transcription": "와 3개씩 10만",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.251,
                "end": 4.879
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 저게 어마 무시한 평딜인건 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.889,
                "end": 8.717
            },
            {
                "speaker_id": "1",
                "transcription": "요새 나오는 친구들은 뭐 저 정도는 다 나오고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.727,
                "end": 11.705
            },
            {
                "speaker_id": "1",
                "transcription": "오 평딜은 그저 그렇고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.715,
                "end": 22.325
            },
            {
                "speaker_id": "1",
                "transcription": "200만 그니까 여러분들이 봐야 될 포인트는 스토리 모드에서 좋을까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.335,
                "end": 29.893
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 뭐 사기일 거 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.903,
                "end": 31.434
            },
            {
                "speaker_id": "1",
                "transcription": "스토리 모드는 답정너다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.444,
                "end": 33.095
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 기존 덱들이 요거거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.105,
                "end": 36.627
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 바다요정을 넣어서 가볼게요.",
                "sound_type": [
                    2,
