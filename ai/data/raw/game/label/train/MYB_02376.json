        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 스타더스트는 뭐 승급 높으면 좋은 건 맞아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.480
            },
            {
                "speaker_id": "1",
                "transcription": "제 부계정도 보니까 제 부계정도 스타더스트 지금 2성인가 3성이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.490,
                "end": 9.672
            },
            {
                "speaker_id": "1",
                "transcription": "근데도 뭐 뭐 초월 높은 사람 잡기도 해요.",
                "sound_type": [
                    2
                ],
                "start": 9.682,
                "end": 13.467
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트가 중요한 게 아니라 진짜 절대적으로 스킬 타이밍이 진짜 더 중요해서 진짜 모든 덱에 공통이 많이 되는 쿠키라 스타더스트 스타더스트 블파 한방덱에 스타더스트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.477,
                "end": 26.822
            },
            {
                "speaker_id": "1",
                "transcription": "캡사덱에 스타더스트 주스덱에 스타더스트 한방덱에는 뭐 끼지 않고 그리고 스타더스트는 여러분들 가장 중요한 게 수호 성전에서도 정말 메인으로 쓰고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.832,
                "end": 40.859
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보시는 요런 덱도 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.869,
                "end": 43.162
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트랑 달빛이 고정이야 그래서 승급이 낮은 분들도 메인 수호 성전 덱 세팅할 때 이런 식으로 2개는 그냥 고정이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.172,
                "end": 52.290
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림이랑 같이 써서 요렇게 더 시너지 좋게 쓰기도 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.300,
                "end": 56.471
            },
            {
                "speaker_id": "1",
                "transcription": "추가적으로 길드 토벌전에서도 여기서도 씁니다 스타더스트를.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.481,
                "end": 61.140
            },
            {
                "speaker_id": "1",
                "transcription": "지금 모든 컨텐츠에서 다 써 얘도 좋고 그다음에 토벌전에서도 좋고 월드 탐험에서도 심지어 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.150,
                "end": 68.297
            },
            {
                "speaker_id": "1",
                "transcription": "거의 만능 중에 만능이다.",
                "sound_type": [
                    2
                ],
                "start": 68.307,
                "end": 70.505
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 키워야 되는 쿠키고 단순히 제가 리뷰하는 거는 5초월 리뷰예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.515,
                "end": 75.402
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 초월의 등급을 떠나서 얘는 제가 올린 쿠키 티어 영상에서도 얘는 0티어라고 제가 제일 위에 올려놨거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.412,
                "end": 84.264
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 반드시 키워야 되는 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.274,
                "end": 87.233
            },
            {
                "speaker_id": "1",
                "transcription": "더 추가적으로 여기 부 옵션 여러분들 세팅할 때 말씀드리고 싶은 거는 이 쿨 같은 경우에는 아레나에서 상대 쿠키가 땅바닥에 있을 때 때리는 그런 형식으로 세팅해도 되고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.243,
                "end": 98.368
            },
            {
                "speaker_id": "1",
                "transcription": "두 번째로 뭐 상대 쿠키가 스킬 발동될 때 나도 이제 무적 효과를 늘리기 위해서 같이 뜨게끔 쿨타임 세팅해도 되고 여러분들 조합이 워낙 다양하니까 정답이 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.378,
                "end": 108.580
            },
            {
                "speaker_id": "1",
                "transcription": "그거는 맞춰서 하시면 되고 그다음에 중요한 거는 이 치명타 확률입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 108.590,
                "end": 112.525
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 확률이 높으면 높을수록 치명타가 될 경우 수면 상태에 빠지고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 112.535,
                "end": 117.433
            }
        ]
    },
    "summary": "화자는 게임 내에 있는 모든 콘텐츠에서 쓰이는 캐릭터이기 때문에 반드시 키워야 하는 캐릭터라고 이야기한다.",
