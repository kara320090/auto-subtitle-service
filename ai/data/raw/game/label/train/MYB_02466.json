        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 스킬풀 들어오는대로 소르베 제외하고 나머지 다 눌러주시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.796
            },
            {
                "speaker_id": "1",
                "transcription": "소르베는 41초나 40초에 누를 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.806,
                "end": 8.539
            },
            {
                "speaker_id": "1",
                "transcription": "자 다 눌러주시고 자 아까 제가 처음에 방깎애기를 했죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.549,
                "end": 14.574
            },
            {
                "speaker_id": "1",
                "transcription": "여기 부분이 중요해요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.584,
                "end": 16.138
            },
            {
                "speaker_id": "1",
                "transcription": "자 밀키웨이를 초반에 57초에 너무 빨리 눌러버리면 애클리어 스킬 쓰고 조금 시간 이따가 이제 에클리어 딜이 딱 들어가거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.148,
                "end": 24.550
            },
            {
                "speaker_id": "1",
                "transcription": "근데 밀키웨이를 그다음에 바로 써버리면",
                "sound_type": [
                    2
