        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 상대방분 이등분이시고 자 상대 클로티드 있는 덱 그 아포가토덱이 지금 현재 엄청나게 많이 유행하고 있는데 클로티드덱이 아포가토덱을 되게 잘 막아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 15.160
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 지는 경우가 여러분들 좀 많이 있을 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
