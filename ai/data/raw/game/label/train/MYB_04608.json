        "term": [
            {
                "speaker_id": "1",
                "transcription": "요런게 좀 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.618
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 보자 내 예상에는 트로피컬 소다 제도 별로 많이 안 했을 거 같아",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.628,
                "end": 6.604
            },
            {
                "speaker_id": "1",
                "transcription": "오 거의 다 해가시네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.614,
                "end": 8.785
            },
            {
                "speaker_id": "1",
                "transcription": "마지막을 향해서 거의 다 가고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.795,
                "end": 11.427
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 600개나 있는데 이거 왜 안 하세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.437,
                "end": 13.928
            },
            {
                "speaker_id": "1",
                "transcription": "이게 여러분들 이거 귀찮아서 안 하는 분들 있는데 이거 보면은 시간당 생성량이 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.938,
                "end": 19.950
            },
            {
                "speaker_id": "1",
                "transcription": "정확히 스태미너 젤리만 비교하자면은 4시간당 20개 생성해요 저는 이것도 오픈을 많이 해주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.960,
                "end": 27.747
            },
            {
                "speaker_id": "1",
                "transcription": "사실 이 분의 영상 하이라이트는 누구도 따라올 수 없는 이 5초월 포스 지금 현시점에서 내가 볼 때는 킹덤 유저 중에 이렇게 한 사람은 세 손가락 안에 들지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.757,
                "end": 39.746
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 여러분들 나중에 다 올 풀스펙 되면은 이거 크리스탈 대체로 보 줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.756,
                "end": 46.300
            }
        ]
    },
