        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 새롭게 대천사 토벌 신규 공속 슈크림 덱이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.357
            },
            {
                "speaker_id": "1",
                "transcription": "자 공속 보물을 사용하면 어떤 이점이 있냐 은포크를 사용하는 덱보다 호밀 맛 쿠키가 스킬을 한 번 더 쓴다 망토 보물의 적용은 오징어 먹물하고 호밀이 받는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.367,
                "end": 16.509
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 구성은 슈크림 덱 최신랑 동일해요 다만 공속 보물을 허용했기 때문에 토핑 수치 옵션이 살 바뀌었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.519,
                "end": 26.053
            },
            {
                "speaker_id": "1",
                "transcription": "자 마카롱 맛 쿠키 같은 경우에는 풀타임이 24점 5로 완벽하게 똑같이 맞춰 주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.063,
                "end": 31.653
            },
            {
                "speaker_id": "1",
                "transcription": "자 오징어먹물 맛 쿠키 같은 경우에는 공속을 5에서 7 사이 여러분들이 3라즈에 2애플 젤리로 세팅을 해 주시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.663,
                "end": 40.531
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 벚꽃 맛 쿠키는 쿨타임은 8에서 8점 5퍼센트 마찬가지로 벚꽃 맛 쿠키는 3라지 2애플 젤리",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.541,
                "end": 47.343
            },
            {
                "speaker_id": "1",
                "transcription": "호밀 맛 쿠키 같은 경우에는 풀타임은 4점 5에서 5점 5 사이 공속은 4에서 6 사이 3라즈 2애플 젤리로 어 추천을 드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.353,
                "end": 59.423
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 슈크림 맛 쿠키 같은 경우에는 쿨은 그냥 여러분들 높으면 높을수록 좋은데 가급적이면 8퍼센트 후반대는 맞춰 주시는 게 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.433,
                "end": 68.018
            },
            {
                "speaker_id": "1",
                "transcription": "공속은 있으면 좋을 것 같아요 그리고 나머지 여유가 된다면은 공격과 치명 신경 써주시고 나머지도 마찬가지입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.028,
                "end": 75.707
            },
            {
                "speaker_id": "1",
                "transcription": "여유가 되는 대로 부 옵션은 공치 신경 써서 해주시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.717,
                "end": 82.666
            }
        ]
    },
    "summary": "새로 나온 슈크림 덱에서 쿠키들의 능력치를 각각 다르게 설정해야 한다.",
