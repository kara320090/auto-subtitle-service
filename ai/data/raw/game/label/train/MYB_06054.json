        "term": [
            {
                "speaker_id": "1",
                "transcription": "아닌가 아직 모르겠고.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.503
            },
            {
                "speaker_id": "1",
                "transcription": "야 왜 이렇게 끊기냐.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.513,
                "end": 6.068
            },
            {
                "speaker_id": "1",
                "transcription": "야 잠깐만 아이 왜 끊겨 이렇게.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.078,
                "end": 11.229
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 초월해도 이기는데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 11.239,
                "end": 14.474
            },
            {
                "speaker_id": "1",
                "transcription": "야 노초월로 이겼어 시너지로.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.484,
                "end": 17.628
            },
            {
                "speaker_id": "1",
                "transcription": "야 이건 인정 해야지.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.638,
                "end": 19.865
            },
            {
                "speaker_id": "1",
                "transcription": "맞지 너무 단단하고 너무 좋은데.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.875,
                "end": 22.800
            },
            {
                "speaker_id": "1",
                "transcription": "물론 1초월은 그렇게 차이가 크게 나는 건 아닌데 단단하게 그냥 이겼는데 휘낭시랑 얘랑 시너지 엄청 좋네.",
                "sound_type": [
                    2
                ],
                "start": 22.810,
                "end": 29.604
            },
            {
                "speaker_id": "1",
                "transcription": "이건 내가 스펙이 오히려 낮은데 이긴 거거든요 확실히 야 이건 진짜 좋은 거 맞지 난 단순 얘 딜만 놓고 보면 별로라 생각할 수도 있는데 야 이런 시너지 보면은 초월된 소환덱이랑 가봅니다.",
                "sound_type": [
                    2
                ],
                "start": 29.614,
                "end": 44.129
            },
            {
                "speaker_id": "1",
                "transcription": "초월 소환덱한테는 어떻게 될지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.139,
                "end": 46.666
            }
        ]
    },
    "summary": "시너지로 노초월을 이겼다며 스펙이 낮은 데도 이긴거여서 인정해야 한다며 휘낭시가 시너지가 엄청 좋다며 초월된 소환덱이랑 가본다고 한다.",
