        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 나온 신규 슈퍼피 캡사이신맛 쿠키 여러분들 활용법에 대해서 저와 리뷰하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 7.886
            },
            {
                "speaker_id": "1",
                "transcription": "방덱만 봐도 여러분들 모든 아레나 덱 주스덱이 정말 많아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.896,
                "end": 12.025
            },
            {
                "speaker_id": "1",
                "transcription": "주스덱도 이따가 리뷰할 거지만 주스덱을 효과적으로 잘 막고 뭐 기타 여러 덱을 되게 잘 막습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.035,
                "end": 18.691
            },
            {
                "speaker_id": "1",
                "transcription": "파란색과 방덱 보시면 아시겠지만 여러 덱을 골고루 다 잘 막아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.701,
                "end": 23.626
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 기존에 웨어울프보다 상위호환으로 나왔고 티어 물어보시는 분들 또한 기존에 웨어울프가 아레나에서는 0티어였는데 그거보다 더 좋게 나왔기 때문에 당연히 티어도 0티어다",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.636,
                "end": 35.149
            },
            {
                "speaker_id": "1",
                "transcription": "그 캡사이신 없으면 못하나요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.159,
                "end": 37.571
            },
            {
                "speaker_id": "1",
                "transcription": "방덱에서는 어쩔 수 없이 여러분들이 캡사이신 못 빱는 분들은 웨어울프로 일단은 쓰고 있다가 캡사이신 뽑으면은 2탱 조합으로 해서 세팅하면 좋고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.581,
                "end": 47.883
            },
            {
                "speaker_id": "1",
                "transcription": "또 질문이 아니 지금 퓨바가 BTS보다 힐량도 좋고 더 좋은데 0티어인데 퓨바는 왜 안 쓰나요",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.893,
                "end": 55.082
            },
            {
                "speaker_id": "1",
                "transcription": "얘 자체가 원래 힐량도 나쁘지 않아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 55.092,
                "end": 57.896
            },
            {
                "speaker_id": "1",
                "transcription": "퓨바보다는 확실히 힐량이 좋은 건 아니지만 얘 보면은 능력치에 아군 대상에게 걸려있는 디버프가 일정 개수가 3개 거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 57.906,
                "end": 65.311
            },
            {
                "speaker_id": "1",
                "transcription": "3개 이상 버프 걸리고 그러면",
                "sound_type": [
                    2,
                    5
                ],
                "start": 65.321,
                "end": 68.133
            }
        ]
    },
    "summary": "캡사이신 못 빱는 분들은 웨어울프로 쓰고 있다가 캡사이신을 뽑으면 2탱 조합으로 세팅하면 좋다.",
