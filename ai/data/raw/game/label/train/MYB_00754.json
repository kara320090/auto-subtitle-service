        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 상대방 분이 레어 무공비라도 어떤 식으로 잡는지 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.701
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나는 현재 두 가지의 형식의 방덱이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.711,
                "end": 8.344
            },
            {
                "speaker_id": "1",
                "transcription": "1탱 코랄 3딜덱 또는 이렇게 2탱 용과덱 자 2탱 용과덱 같은 경우에는 이 과전류 덱으로 되게 쉽게 잡을 수가 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.354,
                "end": 17.451
            },
            {
                "speaker_id": "1",
                "transcription": "관건은 뭐냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.461,
                "end": 19.011
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 어 1분 지나서 용과한테만 버틸 수만 있다면 무난하게 그냥 이길 수 있는 구도로 가져가고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.021,
                "end": 28.058
            },
            {
                "speaker_id": "1",
                "transcription": "2탱은 웬만해선 전부 다 네 다 이기는 구도로 가져갈 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.068,
                "end": 34.260
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 딜러들이 생존을 했죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.270,
                "end": 37.367
            },
            {
                "speaker_id": "1",
                "transcription": "파르페가 죽어도 어 딜러만 생존하면은 이길 수 있는 그림이 나오고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.612,
                "end": 42.529
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 극딜 조합으로 무난하게 이기는 그림이 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.539,
                "end": 47.329
            },
            {
                "speaker_id": "1",
                "transcription": "완벽하게 극상성 카운터로 과전류 덱을 이렇게 사용할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.339,
                "end": 53.250
            },
            {
                "speaker_id": "1",
                "transcription": "2탱 방덱이 현재 많이 없는 이유도",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.252,
                "end": 56.733
            }
        ]
    },
    "summary": "상대방이 레어 무공비라도 과전류 덱에서 1분 지나서 용과한테만 버틸 수 있으면 무난하게 이길 수 있다.",
