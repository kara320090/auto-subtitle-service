        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 기레이브잖아. 지금.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.204
            },
            {
                "speaker_id": "1",
                "transcription": "영화 보는 거 같아. 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.214,
                "end": 3.203
            },
            {
                "speaker_id": "1",
                "transcription": "나 지금 뽕 차 올랐잖아. 지금",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.213,
                "end": 5.793
            },
            {
                "speaker_id": "1",
                "transcription": "나 클매 됐잖아. 아하하하하하",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.803,
                "end": 7.612
            },
            {
                "speaker_id": "1",
                "transcription": "아 지금 석화 진행중이야. 미치겠어. 지금 다른 게임 못해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.622,
                "end": 13.991
            },
            {
                "speaker_id": "1",
                "transcription": "석화되서 우와 진짜 수염 그려야겠네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.001,
                "end": 18.252
            },
            {
                "speaker_id": "1",
                "transcription": "우와 아 그러니까 죽을 사람 살 사람 거꾸로 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.262,
                "end": 25.782
            },
            {
                "speaker_id": "1",
                "transcription": "아니 근데 세상에 어떤 게임이 NPC가 따라 나와 주면은 같이 싸우니까 좋아하잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.792,
                "end": 31.394
            },
            {
                "speaker_id": "1",
                "transcription": "근데 나는 이 게임을 시작한 이후로 누가 나 따라 나선다고 하면은 진짜 극구 도시락 싸 들고 말려야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.404,
                "end": 37.419
            },
            {
                "speaker_id": "1",
                "transcription": "자꾸 나 따라서 뒤질까봐 걱정돼 가지고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.429,
                "end": 40.700
            }
        ]
    },
    "summary": "20대 여성이 게임을 하고 나서 브금을 끝까지 듣고 감동의 여운을 계속 이야기하고 있다.",
