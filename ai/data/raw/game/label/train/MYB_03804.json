        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.089
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.099,
                "end": 6.393
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.393,
                "end": 10.946
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱은 어떤 게 좋냐면 방 덱 보면 아시겠지만 거의 모든 덱을 다 막습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.946,
                "end": 16.726
            },
            {
                "speaker_id": "1",
                "transcription": "근데 요 덱 같은 경우에는 제가 스펙 때문에 제가 이긴 거고 웬만해선 요 덱도 이 덱한테는 좀 뚫리는 경향이 커요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.726,
                "end": 23.739
            },
            {
                "speaker_id": "1",
                "transcription": "근데 웬만해선 모든 덱을 다 잘 막는다 웬만해서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.749,
                "end": 27.570
            },
            {
                "speaker_id": "1",
                "transcription": "공 덱으로도 상당히 좋거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.580,
                "end": 29.790
            },
            {
                "speaker_id": "1",
                "transcription": "공 덱으로도 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.800,
                "end": 31.446
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱은 장단점이 딱 정해져 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.456,
                "end": 33.793
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 클로티드 정석 덱한테 확실히 약합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.786,
                "end": 37.065
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 아까 본 것처럼 샤벳 덱한테도 약해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.075,
                "end": 39.903
            },
            {
                "speaker_id": "1",
                "transcription": "근데 공격 덱에서 보통 방 덱에 샤벳 덱 넣은 사람은 거의 없고 클로티드 정석 덱은 극상위 30등 안쪽이나 그 위쪽에서 많이 세팅을 해 놓고 여러분들이 볼 때 마스터나 뭐 그마 3까지는 클로티드 정석 덱을 해 놓은 사람은 많이 없을 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.913,
                "end": 62.395
            }
        ]
    },
    "summary": "방 덱에 샤벳 덱 넣은 사람은 거의 없고 마스터나 그마 3까지는 클로티드 정석 덱을 해 놓은 사람은 많이 없다고 한다.",
