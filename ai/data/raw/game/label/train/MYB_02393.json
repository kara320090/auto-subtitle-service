        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "대단해",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 6.043
            },
            {
                "speaker_id": "1",
                "transcription": "야 그래도 조금 살았다고 40만 나오네.",
                "sound_type": [
                    2
                ],
                "start": 6.043,
                "end": 9.150
            },
            {
                "speaker_id": "1",
                "transcription": "아 충격적이다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.150,
                "end": 11.635
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 여러분들 칠리 리뷰는 결론은 이겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.640,
                "end": 16.880
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 아무리 딜이 상향됐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.883,
                "end": 18.540
            },
            {
                "speaker_id": "1",
                "transcription": "기존보다 엄청나게 그래도 딜이 좀 많이 올라간 느낌이긴 한데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.540,
                "end": 22.623
            },
            {
                "speaker_id": "1",
                "transcription": "중요한 건 상대방한테 딜을 1도 못 넣습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.623,
                "end": 25.330
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뭐 상향됐다고 아시는 분들 얘는 진짜 절대 쓰지 마시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.330,
                "end": 29.979
            },
            {
                "speaker_id": "1",
                "transcription": "네 초반에도 얘는 아예 키우지 마세요. 별사탕 조금이라도 주는 거조차 아까우니까 그냥 예능용으로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.989,
                "end": 36.659
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 진짜 쓰레기 3대장이 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.669,
                "end": 39.949
            },
            {
                "speaker_id": "1",
                "transcription": "절대 키우면 안 되는 3대장을 제가 일단 알려드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.959,
                "end": 43.106
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째 무화과 맛 쿠키 두 번째 검볼다이버 자 세 번째 칠리만 쿠키 자 이 절대 키우면 안 되는 3대장 중에 하나가 상향이 돼서 제가 리뷰해 봤는데 그대로입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.106,
                "end": 55.563
            },
            {
                "speaker_id": "1",
                "transcription": "성능은 아직도 최악의 쿠키다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.563,
                "end": 58.088
            },
            {
                "speaker_id": "1",
                "transcription": "고렇게 보시면 알 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.096,
                "end": 59.350
            },
            {
                "speaker_id": "1",
                "transcription": "암튼 이렇게 칠리 진짜 기적의 딜 에 리뷰를 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.350,
                "end": 81.210
            }
        ]
    },
    "summary": "화자가 칠리가 딜이 상향됐다는 이야기를 듣고 리뷰를 해보았는데 기존과 다를 바가 없다는 결론을 내리며 쿠키런 킹덤의 쓰레기 3대장은 무화과 맛 쿠키와 검볼다이버, 칠리맛 쿠키라고 알려주고 있다.",
