        "term": [
            {
                "speaker_id": "1",
                "transcription": "어이 거기 거짓말쟁이.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.084
            },
            {
                "speaker_id": "2",
                "transcription": "이야 살았어. 이번에야말로 꼼짝도 않고 죽는 줄 알았다고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.094,
                "end": 12.963
            },
            {
                "speaker_id": "2",
                "transcription": "너희가 나타나줘서 정말 다행이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.973,
                "end": 19.001
            },
            {
                "speaker_id": "2",
                "transcription": "뭐야 그 표정 맙소사 이 몸이 누군지 아직도 모른단 말이야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.011,
                "end": 23.970
            },
            {
                "speaker_id": "2",
                "transcription": "나야 마을 마을 제일의 사냥꾼 올가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.980,
                "end": 27.369
            },
            {
                "speaker_id": "1",
                "transcription": "그러시겠지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.379,
                "end": 29.472
            },
            {
                "speaker_id": "2",
                "transcription": "뭐야 반응이 너무 건조해서 못 알아본 줄 알았잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.482,
                "end": 32.460
            },
            {
                "speaker_id": "2",
                "transcription": "뭐 지금이라도 알면 됐어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.470,
                "end": 34.373
            },
            {
                "speaker_id": "2",
                "transcription": "이제 좀 풀어주지 않겠어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.383,
                "end": 36.403
            },
            {
                "speaker_id": "3",
                "transcription": "신경 쓰실 사안이 아닌 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.413,
                "end": 39.369
            },
            {
                "speaker_id": "3",
                "transcription": "일월딸이여 지나가시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.379,
                "end": 42.866
            }
        ]
    },
    "summary": "마을 제일의 사냥꾼 올가가 등장해서 반응이 너무 건조해서 못 알아본 줄 알았다고 말한다.",
