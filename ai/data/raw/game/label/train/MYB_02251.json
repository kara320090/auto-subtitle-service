        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 출시된 마법 사탕 라떼맛 쿠키와 마들렌맛 쿠키를 동시에 이용하는 라떼맛 쿠키 공속덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.838
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 보면은 힐러가 없죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.848,
                "end": 10.076
            },
            {
                "speaker_id": "1",
                "transcription": "원래 라뗏맛 쿠키 자리에 뭐 BTS나 퓨어바닐라가 들어가야 되는데 힐러가 없이 이 호루라기 보물 자체가 아군의 쿠키가 죽었을 때 아군 전체의 최대 체력을 30퍼센트 회복시킵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.086,
                "end": 22.910
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 라떼맛 쿠키의 마법 사탕이 있는 기본적으로 10강 이상을 여러분들 하게 되면 공격력이 20퍼센트만큼 체력을 회복시켜주는데 거기다가 라떼맛 쿠키가 죽을 때도 체력을 회복을 해 주고 그다음에 한테 침묵 효과도 주는 스킬을 쓰는 그런 효과를 가질 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.920,
                "end": 40.698
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 세팅을 보게 되면 무공비, 공속, 호루라기 부분인데 공속 보물은 여러분들 퀸아망이랑 마들렌이 가져갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.708,
                "end": 48.513
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기 보물은 라떼맛 쿠키랑 달빛술사가 가져갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.523,
                "end": 52.357
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 같은 경우에는 올 쿨하면은 너무 쉽게 잘 녹기 때문에 3쿨, 2아몬드로 주고 피감은 여러분들 능력껏 높게 쿨도 높으면 높을수록 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.367,
                "end": 63.445
            },
            {
                "speaker_id": "1",
                "transcription": "자 퀸아망 쿠키는 올 아몬드고 쿨 세팅은 2.8퍼센트 미만 정보 보기를 통해서 퀸아망 쿠키의 4초인 걸 꼭 확인하셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.455,
                "end": 72.498
            },
            {
                "speaker_id": "1",
                "transcription": "2.8퍼센트가 넘어가면은 3초 쿠키가 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.508,
                "end": 76.159
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 공속은 망토 보물 받을 수 있을 정도로 올려주시구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.169,
                "end": 80.563
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 마들렛맛 쿠키는 올 라즈 공속 망토 받을 수 있게 피감, 공, 치 요 3개 걸러주시면 되구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.573,
                "end": 87.657
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛술사 같은 경우에는 올 라즈입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.667,
                "end": 90.264
            },
            {
                "speaker_id": "1",
                "transcription": "쿨은 높을수록 좋은 것 같구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.274,
                "end": 92.325
            },
            {
                "speaker_id": "1",
                "transcription": "자 라뗏맛을 쿠키는 피감이 너무 높으면 안 되기 때문에 적당히 초반에 1턴 지나고 죽을 정도로 여러분들 상황에 맞춰서 피감 주시면 되고 쿨 높게 그다음에 공, 치 높게 여유가 되면 해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.335,
                "end": 105.185
            },
            {
                "speaker_id": "1",
                "transcription": "라떼는 마탕 10강 네 10강 이상 써 주시면 좋을 것 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 105.195,
                "end": 114.100
            }
        ]
    },
    "summary": "라떼맛 쿠키 공속덱은 힐러가 없고 호루라기 보물이 아군의 체력을 30퍼센트 회복시키고 세팅은 공속 보물은 퀸아망과 마들렌이고 호루라기 보물은 라떼맛 쿠키랑 달빛술사가 가져간다.",
