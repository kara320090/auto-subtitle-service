        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 길드 토벌전 보스 이렇게 3마리가 됐고 신규 보스 운명의 대천사랑 덩어리진 감초 바다의 심연 이렇게 나왔는데 자 기존 보스는 뭐 똑같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 10.373
            },
            {
                "speaker_id": "1",
                "transcription": "근데 중요한 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.383,
                "end": 11.840
            },
            {
                "speaker_id": "1",
                "transcription": "기존에 쓰던 감초 덱이 이제 쓰지 못하게 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.850,
                "end": 15.336
            },
            {
                "speaker_id": "1",
                "transcription": "목화 덱으로 다시 갈아타야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.346,
                "end": 16.730
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 감초 맛 쿠키가 기존에 쓰였던 이유는 버그가 있었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.740,
                "end": 20.634
            },
            {
                "speaker_id": "1",
                "transcription": "여기 스킬 내용에는 용의 공격 속도를 늦춰 준다는 내용이 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.644,
                "end": 25.581
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 기존에 감초가 쓰였던 이유는 용의 공격 속도 1초가 감소되는 버그가 있었는데 이번에 패치가 되면서 해결이 됐기 때문에 감초 덱은 다시 사라졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.591,
                "end": 36.729
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 목화 덱으로 가야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.739,
                "end": 38.519
            },
            {
                "speaker_id": "1",
                "transcription": "한번 보여드릴게요 어떤 식으로 이제 좀 됐는지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.529,
                "end": 41.532
            },
            {
                "speaker_id": "1",
                "transcription": "자 원래 기존에는 어떻게 했냐면 감초 스킬 누르고 그다음에 에클레어 누르고 그다음에 자동 전투 끄고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.542,
                "end": 50.600
            }
        ]
    },
    "summary": "기존 보스는 똑같지만 기존에 쓰던 감초 덱을 더 이상 쓰지 못하고 목화 덱으로 갈아타야 하고 화자가 어떤 식으로 되는지 한번 보여 주고 있다.",
