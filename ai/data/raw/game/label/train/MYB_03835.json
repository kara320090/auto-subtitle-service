        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분들이 유튜브를 신청만 하면 문화상품권이나 다양한 상품으로 교환 가능한 캐시가 자동으로 적립되는 어플을 알려드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.271
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 유튜브의 수많은 광고를 자동으로 건너뛰기를 해주기 때문에 귀찮게 건너뛰기를 직접 누를 필요도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.281,
                "end": 14.747
            },
            {
                "speaker_id": "1",
                "transcription": "이미 100만 다운로드가 넘은 어플로 유튜브를 보면서 쌓인 캐시는 상점에서 다양한 기프티콘으로 교환 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.757,
                "end": 21.710
            },
            {
                "speaker_id": "1",
                "transcription": "룰렛 이벤트로 다양한 상품을 더 뽑을 수도 있고 친구 초대를 통해 캐시를 더 많이 쌓을 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.720,
                "end": 27.650
            },
            {
                "speaker_id": "1",
                "transcription": "가입할 때 추천인 엔디러너 추가를 하면 7000캐시를 무료로 받을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.660,
                "end": 32.894
            },
            {
                "speaker_id": "1",
                "transcription": "유튜브를 보면서 자동으로 쌓이는 캐시를 포기할 이유는 없겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.904,
                "end": 37.670
            },
            {
                "speaker_id": "1",
                "transcription": "고정 댓글에 있는 튜브 캐시 링크를 통해서 다운로드 해보세요.",
                "sound_type": [
                    2,
                    3
                ],
