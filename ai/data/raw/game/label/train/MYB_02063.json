        "term": [
            {
                "speaker_id": "1",
                "transcription": "잠시 후",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.643
            },
            {
                "speaker_id": "1",
                "transcription": "자 랜덤 열심히 돌려서 드디어 가장 좋은 버프 3개를 제가 뽑아 놨습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.653,
                "end": 6.845
            },
            {
                "speaker_id": "1",
                "transcription": "자 치명타 피해가 75퍼센트 증가되는 이 옵션 대신에 공격력 50퍼센트 증가도 나름 비슷하게 좋다고 하니까 가장 좋은 이 버프 3개 제외 하고도 여러분들 맞춰서 한 번 해보시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.855,
                "end": 19.437
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 세팅같은 경우에는 호루라기 무공비급 시계구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.447,
                "end": 23.331
            },
            {
                "speaker_id": "1",
                "transcription": "자 호루라기 같은 경우에는 독버섯하고 주스가 받으면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.341,
                "end": 27.148
            },
            {
                "speaker_id": "1",
                "transcription": "모든 쿠키들 전부다 쿨 5퍼센트로 맞춰주셔야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.158,
                "end": 31.375
            },
            {
                "speaker_id": "1",
                "transcription": "자 모든 쿠키 올 라즈베리로 세팅을 해 주시구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.385,
                "end": 35.223
            },
            {
                "speaker_id": "1",
                "transcription": "공속은 뭐 있으면 더 좋다고 보고 공속이 좀 더 있어야 되는 거는 호밀맛 쿠키 공속을 신경 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.233,
                "end": 41.739
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 해로운 효과도 와이번 보스 스턴 패턴이 있기 때문에 해로감은 석류랑 호밀한테 더 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.749,
                "end": 49.018
            },
            {
                "speaker_id": "1",
                "transcription": "중요한 메인 딜러랑 주스랑 독버섯 그리고 호밀이기 때문에 공 치 위주로 더 주셔도 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.028,
                "end": 56.168
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 길드는 결정 길드의 류수정님 수정님 길드거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.178,
                "end": 61.438
            },
            {
                "speaker_id": "1",
                "transcription": "네 수정님 조합으로 한 번 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
