        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피시에서 즐길 때 녹스 앱 플레이어 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.031
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.041,
                "end": 6.385
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.395,
                "end": 10.295
            },
            {
                "speaker_id": "1",
                "transcription": "자 관련된 이미지도 보면은 마카롱맛 쿠키의 이미지가 이렇게 제대로 나와 있으 나와 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.305,
                "end": 16.451
            },
            {
                "speaker_id": "1",
                "transcription": "보면 이 조그만한 마카롱 애들을 엄청나게 데리고 다니면서 이렇게 되어있고 스킬 능력을 보면 네 뭐 이런 스킬 능력이 있다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.461,
                "end": 26.494
            },
            {
                "speaker_id": "1",
                "transcription": "해석은 제가 안 해가지고 나와봐야 될 것 같은데 마법형이다 이거 하나 확실히 알 수 있고 가운데 네 가운데에 어 중렬에 쓰이는 쿠키다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.504,
                "end": 37.529
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 보이고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.539,
                "end": 39.597
            },
            {
                "speaker_id": "1",
                "transcription": "마법형 스킬 파우더나 이런 거 좀 준비를 해 놔야 될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.607,
                "end": 43.403
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 자체는 하나만 나오기 때문에 2개 이상 키울 부담은 일단 없을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.413,
                "end": 49.275
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 이거 관련해서 아직 잘 모르시는 분들을 위해서 오븐 브레이크 가서 마카롱 맛 쿠키 실제로 어떤 이미지인지 미리 사전 체험을 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.285,
                "end": 60.117
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.127,
                "end": 62.278
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 마카롱 막 소환해서 앞으로 막 소환되는 거 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.288,
                "end": 67.007
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저게 소환되는 건지 잘 모르겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.017,
                "end": 68.742
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 오븐 브레이크에서는 달리면 한 마리씩 약간 내 동료가 되어줘라 약간 이런 느낌으로 한 마리씩 모으는 다음에 저 카운터가 다 되면은 변신해서 가거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.752,
                "end": 78.489
            },
            {
                "speaker_id": "1",
                "transcription": "그",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.499,
                "end": 79.100
            }
        ]
    },
    "summary": "화자가 오븐 브레이크 가서 마카롱 맛 쿠키 실제로 어떤 이미지인지 미리 보여드리겠다고 이야기하고 있다.",
