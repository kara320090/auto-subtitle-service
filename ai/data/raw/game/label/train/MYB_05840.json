        "term": [
            {
                "speaker_id": "1",
                "transcription": "약간 세게 들어오는 것도 있죠 이것도 내가 볼 때는 그냥 증표 덱이 이길 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.491
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱 같은 경우에도 많이 죽었 죽은 이유가 진짜 워낙 그 단단하기 때문에 올 피감 두르고 그런 게 많아서 야 이거 봐 공속덱이 저렇게 두드려 팼는데 아니 보셨어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.501,
                "end": 21.310
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱이 저렇게 딜을 많이 열심히 넣는데 근데 탱커들이 워낙 체력이 많고 방어력이 좋으니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.320,
                "end": 28.694
            },
            {
                "speaker_id": "1",
                "transcription": "닳지도 않아 피가 거의 오 증표 덱이다 자 증표 덱 나왔을 때는 요걸로 하시면 되는데 단점이 일단은 최소 무승부 생각이에요 이렇게 가면은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.704,
                "end": 41.370
            },
            {
                "speaker_id": "1",
                "transcription": "근데 나는 무승부가 싫어요 하시는 분들은 1번 덱으로 가시면 돼요 단 질 수도 있어요 이거 너무 공격적인 세팅이고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.380,
                "end": 48.007
            },
            {
                "speaker_id": "1",
                "transcription": "자 클로티드랑 휘낭시에랑 같이 야 잠깐만 잘못 넣었다 아 야 이거 클로티드랑 같이 넣었어야 되는데 아 이것도 무승부 느낌이 쎄하다 잠시만요",
                "sound_type": [
                    2,
                    3
                ],
