        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이게 여기서 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.933
            },
            {
                "speaker_id": "1",
                "transcription": "와 야 소르베가 크탈 뽑기에서 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.943,
                "end": 20.421
            },
            {
                "speaker_id": "1",
                "transcription": "우와 축하드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.431,
                "end": 22.111
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 축하드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.121,
                "end": 24.176
            },
            {
                "speaker_id": "1",
                "transcription": "야 이게 진짜 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.186,
                "end": 25.720
            },
            {
                "speaker_id": "1",
                "transcription": "야 나 오늘 오늘 왜 이래?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.730,
                "end": 27.545
            },
            {
                "speaker_id": "1",
                "transcription": "오오 날이다 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.555,
                "end": 29.680
            },
            {
                "speaker_id": "1",
                "transcription": "야 0.25퍼센트를 뚫어버렸어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.690,
                "end": 32.975
            },
            {
                "speaker_id": "1",
                "transcription": "그니까요 스페셜에서 뽑았다는 게 기적이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.985,
                "end": 35.837
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이 확률 제가 0.025퍼센트를 뚤었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.847,
                "end": 40.703
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 내가 그냥 하는 말이 아니라 진짜 스페셜 뽑기 이게 확률이 다르다니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.713,
                "end": 48.820
            },
            {
                "speaker_id": "1",
                "transcription": "그 크림 유니콘 때도 진짜 엄청 안 나왔고 마카롱도 엄청 안 나왔거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.830,
                "end": 53.629
            },
            {
