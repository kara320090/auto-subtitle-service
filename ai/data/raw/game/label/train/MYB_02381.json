        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 씨 백 135만 와 그래도 안 쓰일 거 같은데 자 이제 실전으로 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.720
            },
            {
                "speaker_id": "1",
                "transcription": "아 야 여기에 야 이 쟁쟁한 스타더스트랑 달빛술사를 제치고 이거 너무 전력 손실이 어마무시하게 나는 거 같은데요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.730,
                "end": 16.604
            },
            {
                "speaker_id": "1",
                "transcription": "야 칠리덱이 나올 수 있을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.614,
                "end": 18.629
            },
            {
                "speaker_id": "1",
                "transcription": "야 그렇다고 해서 칠리가 스타더스트보단 좋 좋지는 않을 거 아니야",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.639,
                "end": 22.775
            },
            {
                "speaker_id": "1",
                "transcription": "와 이거 진짜 막막하네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.785,
                "end": 24.936
            },
            {
                "speaker_id": "1",
                "transcription": "일단 스타더스트 자리에 넣어볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.946,
                "end": 27.200
            },
            {
                "speaker_id": "1",
                "transcription": "자 마라랑 찰떡궁합일 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.210,
                "end": 29.315
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 얘도 치명타를 증가시켜 주기 때문에 치명타 확률이 높아져서 찰떡궁합이 될 수도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.325,
                "end": 36.276
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 보면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.286,
                "end": 37.848
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 아레나에서 하면은 패작 의심 받아가지고 저 신고당할 수 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.858,
                "end": 41.824
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 아 제 부계정 패러 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.834,
                "end": 45.044
            },
            {
                "speaker_id": "1",
                "transcription": "칠리덱으로 과연 팰 수 있을지 자 부계정한테 실험 삼아 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.054,
                "end": 51.210
            },
            {
                "speaker_id": "1",
                "transcription": "출발",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.220,
                "end": 53.666
            }
        ]
    },
