        "term": [
            {
                "speaker_id": "1",
                "transcription": "동영상은 크리스탈, 코인, 별사탕 그리고 무지개 큐브 관련된 각종 재화의 수급처 그리고 중요성에 대해서 언급을 할 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.963
            },
            {
                "speaker_id": "1",
                "transcription": "자 고인물분들은 다 알고 있기 때문에 굳이 영상을 볼 필요는 없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.973,
                "end": 14.941
            },
            {
                "speaker_id": "1",
                "transcription": "초보자분들 복귀 유저분들 그리고 중급자분들이라도 재화의 가치나 사용처에 대해서 잘 모르는 분들한테 도움을 주기 위해서 제작을 해봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.951,
                "end": 25.562
            },
            {
                "speaker_id": "1",
                "transcription": "자 가장 기초적인 코인부터 언급을 해볼게요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.572,
                "end": 29.329
            },
            {
                "speaker_id": "1",
                "transcription": "자 코인같은 경우에 어떻게 많이 버나요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.339,
                "end": 31.930
            },
            {
                "speaker_id": "1",
                "transcription": "가장 초보자분들 초반에 코인을 버는 것보다도 안 쓰는 게 일단 제일 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.940,
                "end": 38.646
            },
            {
                "speaker_id": "1",
                "transcription": "무슨 소리냐 자 초보자분들은 쿠키성 레벨 12레벨까지 쿠키성을 레벨업에 집중 투자하는 게 가장 중요하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.656,
                "end": 45.821
            },
            {
                "speaker_id": "1",
                "transcription": "그 전까지는 자 토핑강화 12강의 무리한 투자 또는 랜드마크 무리하게 레벨업해서 코인을 너무 무리하게 소모하지 마시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.831,
                "end": 55.501
