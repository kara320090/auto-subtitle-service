        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "모바일 게임을 플레이한 만큼 혜택을 받을 수 있는 플레이오 앱을 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.798
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 쌓이는 잼을 코인으로 교환해 상점에서 기프트카드, 문화상품권 등 다양한 상품으로 구매 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.808,
                "end": 9.792
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 시청하고 가입한 신규 유저분들한테는 특별 시크릿코드 플오ND러너를 입력하면 10000잼을 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.802,
                "end": 16.908
            },
            {
                "speaker_id": "1",
                "transcription": "추가로 플레이오의 자체적인 퀘스트들이 있어서 게임을 진행하면서도 다양한 잼을 추가로 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.918,
                "end": 22.843
            },
            {
                "speaker_id": "1",
                "transcription": "게임하고도 기프트카드, 문화상품권 무료로 얻고 너무나 좋은 기회 아닌가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.853,
                "end": 27.314
            },
            {
                "speaker_id": "1",
                "transcription": "다운로드 링크는 고정 댓글을 참고하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.324,
                "end": 29.784
            },
            {
                "speaker_id": "1",
                "transcription": "자 먼저 첫 번째 덱을 갈 건데요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.794,
                "end": 32.361
            },
            {
                "speaker_id": "1",
                "transcription": "네 저는 3딜덱으로 이 덱을 한번 잡아 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.371,
                "end": 36.649
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대는 스타더스트 그다음에 블랙펄 그리고 락스타가 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.659,
                "end": 42.589
            },
            {
                "speaker_id": "1",
                "transcription": "상성상 사실 이거는 지는 상성이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.599,
                "end": 45.439
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 아셔야 될 게 상대방은 락스타 그다음에 스타더스트, 블랙펄 이렇게 되어있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.449,
                "end": 51.146
            },
            {
                "speaker_id": "1",
                "transcription": "상성상 이렇게 이깁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.157,
                "end": 52.813
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 원탱덱으로 되어있을 때 이렇게 3딜 극딜덱으로 되어있으면은 아마 제가 질 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.813,
                "end": 58.607
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 상성을 파악할 때 어떨 때 어떤 덱으로 들어가는지 여러분들 아래나하면서 하나씩 파악하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.617,
                "end": 65.980
            },
            {
                "speaker_id": "1",
                "transcription": "지금 제가 이렇게 앞에 홀리베리가 녹아서 없어졌죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.990,
                "end": 71.666
            }
        ]
    },
    "summary": "모바일 게임을 플레이한 만큼 혜택을 받을 수 있는 플레이오 앱을 추천하며 3딜덱으로 스타더스트, 블랙펄, 락스타를 가진 상대와 대결했을 때 상성상 지는 상성이다.",
