        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 나무 그 다음에 젤리빈 각설탕 네 무난하고 열차 안 멈출 정도 그리고 이 계정 주인분 테크 올리는 것도 부담되죠 지금?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.598
            },
            {
                "speaker_id": "1",
                "transcription": "올려야 될지 말지는 어떻게 결정하냐면 앞에 재고가 열차가 멈추지 않을 정도고 레벨 업을 했을 이 기간 2일 6시간 동안 얘가 멈춰있어도 앞에 재고가 타격이 없으면 올려도 상관은 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.608,
                "end": 23.933
            },
            {
                "speaker_id": "1",
                "transcription": "근데 지금 11에서 12단계에서는 엄청난 하이테크를 쫙쫙 끝까지 다 여는 목표보다도 일단 12성 쿠키성 레벨 먼저 올린다 고 생각으로 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.943,
                "end": 33.880
            },
            {
                "speaker_id": "1",
                "transcription": "재고 상태를 나쁘지 않기 때문에 다음 쿠키를 보면은 그래도 이분 과금을 한 게 느낌이 나죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.880,
                "end": 39.699
            },
            {
                "speaker_id": "1",
                "transcription": "한 달 차인데 여러분들 이거 싹 다 요렇게 어느 정도 스펙이 이 정도 나왔다는 건 과즘한 티가 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.709,
                "end": 46.971
            },
            {
                "speaker_id": "1",
                "transcription": "아레나는 이거보다는 공속이랑은 얘랑은 안 맞거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.981,
                "end": 52.599
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 이 덱은 시계를 차야 돼요 시계도 12렙이시네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.609,
                "end": 56.557
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 이렇게 쓰고 싶으시면은 낫 들고 가야 되는데 보통 이게 피감이 너무 낮으면 시작하자마자 다 전멸되고 죽는 경우가 많으면 낫보다 부활이 더 좋은 경우도 있으니까 이거는 직접 테스트를 해보시고 현재 지금 요렇게 해도 피감 너무 낮거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.567,
                "end": 71.599
            },
            {
                "speaker_id": "1",
                "transcription": "차라리 이렇게 해서 빨리 죽을 바에는 어 휘낭시에도 쿨 섞고 아몬드랑 같이 껴서 쓰세요 알겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.609,
                "end": 77.670
            },
            {
                "speaker_id": "1",
                "transcription": "얘를 만약에 진짜 쓸 거면은 뭐 어느 정도 피감 있는 라즈 많으니까 뭐 라즈 세팅해 주고 얘 같은 경우에도 피감이 너무 안 나오면 어쩔 수 없지 뭐 어느 정도 피감을 섞어주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.680,
                "end": 89.922
            },
            {
                "speaker_id": "1",
                "transcription": "지금 덱을 나누지 마시고 이거 하나만 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.932,
                "end": 93.548
            },
            {
                "speaker_id": "1",
                "transcription": "바요보다도 얘를 먼저 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.558,
                "end": 95.613
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 수호의 성전 얘기도 하셨는데 요거 어떻게 세팅하냐면 1 2 3 4 5가 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 95.623,
                "end": 100.676
            },
            {
                "speaker_id": "1",
                "transcription": "토핑을 분산해 봤자 의미가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.686,
                "end": 103.683
            },
            {
                "speaker_id": "1",
                "transcription": "첫 번째 덱에 메인 덱으로 이렇게 세팅하고 정말 얘네한테 모든 걸 몰아주시고 2 3 4 5는 어느 정도 뭐 딜 몰빵 덱 대충 마무리하는 덱 요런식으로 여유되는 거 최대한을 높은 것들 위주로 해놓고 방법은 얘가 가다가 딜이 너무 쎄거나 특정 뭐 보호막 많거나 그런 곳에서는 나머지 그냥 대체로 맞아주고 넘어가고 다시 원래 덱으로 와서 세팅해 주고 그런 식으로 가고 지금 원힐텍보다는 유지력 좋게 제가 볼 때는 차라리 저라면 이렇게 할 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 103.693,
                "end": 137.087
            },
            {
                "speaker_id": "1",
                "transcription": "캡캐덱은 따로 만드세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 137.097,
                "end": 139.415
            },
            {
                "speaker_id": "1",
                "transcription": "딜을 그냥 폭딜을 넣을 수 있는 덱은 따로 얘 어차피 이거 이게 옛날에는 레벨만 60레벨로 해줬는데이제는 요거 쓰면은 스킬 레벨까지 다 올려주기 때문에 그래도 모양새 갖춰놓고 하는 거랑 안 하는 거랑 차이가 좀 있어서 네 요거대로 좀 해보시면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 139.425,
                "end": 158.233
            }
        ]
    },
