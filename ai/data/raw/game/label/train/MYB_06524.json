        "term": [
            {
                "speaker_id": "1",
                "transcription": "원래 이런 거 박스 하나가 있어야지 집고 올라가고 뭐 하고가 있으니까.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.066
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그 방 한 칸에서는 아무것도 안 되는 거예요.",
                "sound_type": [
                    2
                ],
                "start": 4.076,
                "end": 6.682
            },
            {
                "speaker_id": "1",
                "transcription": "자꾸 그래 가지고서는 아 이거 뭐야 그랬는데 저기서 갖고 오는 거였구먼?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.692,
                "end": 14.798
            },
            {
                "speaker_id": "1",
                "transcription": "응 박스를 찾았죠?",
                "sound_type": [
                    2,
                    4,
                    5
                ],
                "start": 14.808,
                "end": 32.838
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 문에다 껴 놓으면 안 되나",
                "sound_type": [
                    2,
                    4
                ],
                "start": 32.848,
                "end": 38.456
            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 그런 생각이 어차피 집고 올라갈 수 없는 높인데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.466,
                "end": 50.400
            }
        ]
    },
    "summary": "다른 방에서 구해온 박스를 문이 열고 닫히는 곳에 끼워 놓으면 안 될까 하는 생각이 갑자기 들었다.",
