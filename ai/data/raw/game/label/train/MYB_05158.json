        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 아휴 하필 나와도 쓰레기만 다 잔뜩 나왔네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.733
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 아까 누가 그랬어 이 오징어랑 고래가 보상 쓰레기라고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.743,
                "end": 8.244
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 버프 얻을 수 있나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.254,
                "end": 9.949
            },
            {
                "speaker_id": "1",
                "transcription": "여러 효과 중에 한 가지만 선택할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.959,
                "end": 11.688
            },
            {
                "speaker_id": "1",
                "transcription": "마음의 효과가 없으면 새로 고침으로 리스트를 교체할 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.698,
                "end": 14.955
            },
            {
                "speaker_id": "1",
                "transcription": "블랙코인으로 얻을 수 있는 효과도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.965,
                "end": 16.810
            },
            {
                "speaker_id": "1",
                "transcription": "제단 효과들은 2번 항해에서만 효과가 발휘된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.820,
                "end": 20.749
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러면 저는 공격력 증가 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.759,
                "end": 23.744
            },
            {
                "speaker_id": "1",
                "transcription": "어 뭐야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.754,
                "end": 24.501
            },
            {
                "speaker_id": "1",
                "transcription": "바다 왼쪽 이동 가능한 조작 패드가 있을 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.511,
                "end": 27.724
            },
            {
                "speaker_id": "1",
                "transcription": "패드 터치해서 잘 해보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.734,
                "end": 29.312
            },
            {
                "speaker_id": "1",
                "transcription": "어 번개 내려치는 순간 대시 주황색 표시되는 부분이 보이지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.322,
                "end": 33.682
            },
            {
                "speaker_id": "1",
                "transcription": "오 오 오 오 오 오 오 오.",
                "sound_type": [
                    2,
