        "term": [
            {
                "speaker_id": "1",
                "transcription": "태호야 너 어쩌다 이렇게 됐니 왜 안되지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 16.182
            },
            {
                "speaker_id": "1",
                "transcription": "아 준내 멋있어 부부싸움 했나봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.192,
                "end": 31.882
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 자꾸 토르갈 멍멍 소리나요 귀여워 패자에서 듣고 멍.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.892,
                "end": 39.368
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 액션 져주면 딴 게임하면 이런 액션 못 채워서 나 어떻게 하냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.378,
                "end": 53.690
            },
            {
                "speaker_id": "1",
                "transcription": "태호랑 똑같네 눈눈눈눈 눈조심 태호야 왜 이렇게 반갑지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.700,
                "end": 67.123
            },
            {
                "speaker_id": "1",
                "transcription": "애를 둘이나 업고 왔네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.133,
                "end": 77.439
            },
            {
                "speaker_id": "1",
                "transcription": "아이씨 태호야 근육 좀 키웠네 태호 근육 좀 보세요 여러분 고구마처럼 생겼네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.449,
                "end": 91.850
            },
            {
                "speaker_id": "1",
                "transcription": "오이다 됐네 태호.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.860,
                "end": 107.400
            }
        ]
    },
    "summary": "게임에서 격렬한 전투를 벌이고 있는데 너무 멋있고 딴 게임하면 이런 액션을 못 봐서 아쉽다.",
