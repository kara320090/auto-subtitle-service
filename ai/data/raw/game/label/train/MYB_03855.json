        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 확실한 거 하나는 야 얘 미쳤어 진짜 안 죽어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.820
            },
            {
                "speaker_id": "1",
                "transcription": "아 서리가 터졌고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.830,
                "end": 9.060
            },
            {
                "speaker_id": "1",
                "transcription": "내가 불리하다 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.070,
                "end": 10.876
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 터져도 최종적으로 얼마나 피해를 주는지까지 한번 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.886,
                "end": 15.251
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 진 거 같애요 확실히?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.261,
                "end": 16.943
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 공속이 느려지니까 상대방을 죽이지 못하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.953,
                "end": 20.531
            },
            {
                "speaker_id": "1",
                "transcription": "요거는 지네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.541,
                "end": 22.228
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱 자체가 되게 좋아요 그리고 상대적으로.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.238,
                "end": 24.753
            },
            {
                "speaker_id": "1",
                "transcription": "와 확실히 얘가 왜 600만이나 나왔냐면는 얘네가 다 살아서 그래요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.763,
                "end": 31.375
            }
        ]
    },
