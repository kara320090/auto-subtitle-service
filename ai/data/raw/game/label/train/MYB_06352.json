        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 하나 더 말씀드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.815
            },
            {
                "speaker_id": "1",
                "transcription": "오이스터맛 쿠키 정말 중요하고 핵심적인 쿠키인데 이거 완품으로 뽑기 어려운 분들 지금 크렘 공화국 에피소드 2장에서 여러분들 오이스터 조각을 주거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.825,
                "end": 11.981
            },
            {
                "speaker_id": "1",
                "transcription": "빛조각 뿐만 아니라 오이스터 조각도 주기 때문에 귀찮더라도 요거 스토리 쭉 다 깨시는 게 중요하다고 생각합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.991,
                "end": 19.925
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 1장 같은 경우에도 100퍼센트 완료하면은 여러분들 깃털을 이렇게 크리스탈로 교환 가능하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.935,
                "end": 25.594
            },
            {
                "speaker_id": "1",
                "transcription": "이거 100퍼센트 귀찮아서 안 하는 분들 있을 텐데 요거 요렇게 바꿔주시면 되고 100퍼센트 완료가 안 되는 분들은 1차부터 다시 다 쭉 보면서 깃털 소모 안 한 거 보시면 되고 옆에 뜨는 퀘스트 꼭 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.604,
                "end": 37.772
            },
            {
                "speaker_id": "1",
                "transcription": "퀘스트 안 하면은 다시 또 1차로 반복해서 노가다를 많이 하셔야 되기 때문에 반드시 옆에 뜨는 퀘스트도 완료해서 여러분들 보상 다 받으시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.782,
                "end": 47.145
            },
            {
                "speaker_id": "1",
                "transcription": "자 이벤트 여러분들 모르는 분도 있어서 이렇게 알려드릴 겸 영상을 찍어 봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.155,
                "end": 52.279
            },
            {
                "speaker_id": "1",
                "transcription": "구독 좋아요 한 번씩만 부탁드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.289,
                "end": 54.522
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
