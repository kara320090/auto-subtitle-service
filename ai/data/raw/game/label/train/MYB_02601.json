        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 푸룬주스맛 쿠키 일단",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.550
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 5성까지만 하고 제가 비교를 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.560,
                "end": 6.388
            },
            {
                "speaker_id": "1",
                "transcription": "일단 얘 같은 경우에는 부룬주스 병을 가장 뒤에 있는 적에게 던진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.398,
                "end": 11.354
            },
            {
                "speaker_id": "1",
                "transcription": "중독을 건다 일단은 푸른 젤리 소환수 체력은 피격 횟수로 감소가 되고 푸룬젤리 소환수는 일정 시간마다 몸에서 푸룬가스를 퍼트린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.364,
                "end": 22.560
            },
            {
                "speaker_id": "1",
                "transcription": "중독 걸고 그리고 독으로 만들어진 푸룬젤리 소환수는 모든 도트 효과를 면역하고 보호막과 체력 회복에 영향을 받지 않는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.570,
                "end": 31.100
            },
            {
                "speaker_id": "1",
                "transcription": "중독은 일단 76.9퍼센트 10초 마다 10초 동안 2초 동안 야 얘는 딱 봐도 토벌에서 좋아 보이지 않나요. 여러분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.110,
                "end": 39.017
            },
            {
                "speaker_id": "1",
                "transcription": "중독 피해 대형 푸룬 주스 중독 10초 동안 1초 마다 92.3 중독 피해 증가 10초 동안 중독 피해 30퍼센트 증가 그리고 끈적한 점액 15초 동안 디버프 해제 시 해당 디버프만 삭제되고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.027,
                "end": 54.317
            },
            {
                "speaker_id": "1",
                "transcription": "푸룬젤리 소환은 공격력에 시전자의 공력력에 95퍼센트 체력 피격 횟수 30번",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.327,
                "end": 61.528
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 20초 동안 2초마다 45.99퍼센트 피해",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.538,
                "end": 67.000
            }
        ]
    },
