            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런 그림으로 나가는 걸 볼 수가 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.762
            },
            {
                "speaker_id": "1",
                "transcription": "네 이런 식으로 대미지는 좋아 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.772,
                "end": 6.860
            },
            {
                "speaker_id": "1",
                "transcription": "스토리에서 무난하게 딜러로 쓰기에는 괜찮다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.870,
                "end": 10.658
            },
            {
                "speaker_id": "1",
                "transcription": "제가 어제 생방송 리뷰 때는 아레나 실전을 많이 못 해봤는데 밤새 제가 많은 경험을 한번 쌓아봤습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.668,
                "end": 20.368
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로도 많이 이제 데이터를 쌓아봤고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.378,
                "end": 23.310
            },
            {
                "speaker_id": "1",
                "transcription": "실전으로도 많이 제가 들어가면서 경험을 쌓아봤습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.320,
                "end": 27.324
            },
            {
                "speaker_id": "1",
                "transcription": "이것저것 덱 테스트도 많이 해봤어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.334,
                "end": 30.255
            },
            {
                "speaker_id": "1",
                "transcription": "결론을 말씀드리면은 샤이닝글러터맛 쿠키를 쓰는 가장 효율적인 방법은 현재로서는 이 조합이 가장 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.265,
                "end": 38.767
            },
            {
                "speaker_id": "1",
                "transcription": "근데 중요한 점이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.777,
                "end": 40.169
            },
            {
                "speaker_id": "1",
                "transcription": "자 샤이닝글리터가 쿠키는 호루라기를 받아서 쿠키에 쓰는 게 가장 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.179,
                "end": 45.215
            },
            {
                "speaker_id": "1",
                "transcription": "보통 라즈베리를 쓰는 게 저는 가장 좋았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.225,
                "end": 48.640
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 같은 경우에는 홀리베리 쿨 용과 라즈",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.650,
                "end": 51.966
            }
        ]
    },
    "summary": "스토리에서 무난하게 딜러로 쓰기에는 괜찮다며 어제 많은 실전 경험을 하면서 느낀점의 결론과 얘기하며 샤이님글리터 쿠키는 호루라기를 받아서 쿠키에 쓰는 게 가장 좋다며 하고 본인은 라즈베리를 쓰는 게 가장 좋았다고 한다.",
