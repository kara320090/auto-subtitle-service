        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 아레나 기준에 어떤 조합이 가장 좋은지 어떤 쿠키를 키워야 되는지 그리고 어떤 세팅을 해야 되는지 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.958
            },
            {
                "speaker_id": "1",
                "transcription": "제가 아레나를 하루에 몇백 판씩 하면서 쌓인 노하우와 자 그리고 방어덱으로도 어떻게 해야 되는지도 제가 알려드리면 자 일단 기본적으로 방어덱은 한방덱을 막는 게 가장 중요한 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.968,
                "end": 21.211
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 한방덱을 막는 방법에는 무공비 대신에 레어 무공비급을 쓰고 2탱으로 하는게 가장 무난하고 저처럼 원탱으로 하되 한방덱이 들어오게끔 유도한 다음에 극단적인 공격적인 세팅으로 한방덱을 막아내는 방법도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.221,
                "end": 37.989
            },
            {
                "speaker_id": "1",
                "transcription": "간단하게 제 방덱을 소개하면은 홀리베리 올 쿨, 스타더스트는 3라즈 3초로 이렇게 세팅을 했고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.999,
                "end": 44.879
            },
            {
                "speaker_id": "1",
                "transcription": "10.4퍼센트 이상 넘어가면 3초가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.889,
                "end": 47.750
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 달빛술사는 올 라즈베리로 좀 공격적인 세팅 특이하게 블랙펄을 아몬드로 했는데 그 이유는 호루라기를 스타더스트와 달빛술사한테 줘서 초반에 이 두 쿠키가 극단적인 극딜로 상대 쿠키를 좀 잘라주는 역할로 쓰기 위해서 일부러 호루라기를 받지 않기 위해서 아몬드를 썼다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.760,
                "end": 68.935
            },
            {
                "speaker_id": "1",
                "transcription": "피해감소를 높이기 위한 올 아몬드 세팅도 했다는 점 자 스냅 드래곤은 올 쿨로 세팅을 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.945,
                "end": 74.967
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 여러분들만의 방덱을 구성해도 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.970,
                "end": 78.303
            },
            {
                "speaker_id": "1",
                "transcription": "가장 좋은 조합 추천을 이제 할 텐데 그 전에 자 초보자분들 이런 조합 추천 영상 하면은 항상 나오는 말이 아 저는 스펙이 낮아서 러너님 영상 추천해주는 건 좋은데 따라 할 수가 없어라는 질문이 가장 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.313,
                "end": 92.566
            }
        ]
    },
    "summary": "한방덱을 막는 방법에는 무공비 대신에 레어 무공비급을 쓰고 2탱으로 하는게 가장 무난하고 저처럼 원탱으로 하되 한방덱이 들어오게끔 유도한 다음에 극단적인 공격적인 세팅으로 한방덱을 막아내는 방법도 있고 제 방덱을 소개하자면 홀리베리 올 쿨, 스타더스트는 3라즈, 달빛술사는 올 라즈베리, 블랙펄은 올 아몬드로 세팅을 했다.",
