    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상은 쿠키런 킹덤에 나온 모든 쿠키들의 토핑을 추천드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.478
            },
            {
                "speaker_id": "1",
                "transcription": "중요하게 활용되는 쿠키들을 좀 더 상세하게 설명을 드리고 일반적으로 활용되지 않는 쿠키들은 무난한 토핑을 추천드리도록 할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.488,
                "end": 14.997
            },
            {
                "speaker_id": "1",
                "transcription": "모바일 게임을 플레이한 만큼 혜택을 받을 수 있는 플레이오 앱을 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.007,
                "end": 18.980
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 쌓이는 잼을 코인으로 교환해 상점에서 기프트카드, 문화상품권 등 다양한 상품으로 구매 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.990,
                "end": 25.080
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 시청하고 가입한 신규 유저분들한테는 특별 시크릿코드 플오ND러너를 인력하면 10000잼을 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.080,
                "end": 31.992
            },
            {
                "speaker_id": "1",
                "transcription": "추가로 플레이오의 자체적인 퀘스들이 있어서 게임을 진행하면서도 다양한 잼을 추가로 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.002,
                "end": 37.918
            },
            {
                "speaker_id": "1",
                "transcription": "게임하고도 기프트카드, 문화상품권 무료로 얻고 너무나 좋은 기회 아닌가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.928,
                "end": 42.534
            },
            {
                "speaker_id": "1",
                "transcription": "다운로드 링크는 고정 댓글을 참고하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.544,
                "end": 44.654
            },
            {
                "speaker_id": "1",
                "transcription": "자 먼저 다크카카오 쿠키는 올 아몬드 토핑 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.664,
                "end": 48.718
            },
            {
                "speaker_id": "1",
                "transcription": "활용 가치가 많이 없어서 무난한 아몬드 토핑 출연드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.728,
                "end": 52.704
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리 아주 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.714,
                "end": 54.631
            },
            {
                "speaker_id": "1",
                "transcription": "올 쿨 토핑 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.641,
                "end": 56.099
            },
            {
                "speaker_id": "1",
                "transcription": "부옵션 중에서는 피해감소 중요하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.109,
                "end": 59.146
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임도 높으면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.140,
                "end": 61.025
            },
            {
                "speaker_id": "1",
                "transcription": "권장은 22퍼센트 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.035,
                "end": 63.580
            },
            {
                "speaker_id": "1",
                "transcription": "필요에 따라서 방어덱으로 올 아몬드도 쓰는 경우도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.590,
                "end": 67.632
            },
            {
                "speaker_id": "1",
                "transcription": "피해감소가 너무 낮다면 아몬드 토핑으로 섞어서 사용해도 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.642,
                "end": 72.753
            },
            {
                "speaker_id": "1",
                "transcription": "자 퓨어바닐라 쿠키도 부상효과 감소 때문에 대체 불가능한 쿠키로 여러분들 키워주시면 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.763,
                "end": 79.593
            },
            {
                "speaker_id": "1",
                "transcription": "일반적으로 쿨 토핑세트를 추천드리고 피해감소 높게 쿨 타임도 높으면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.600,
                "end": 85.152
            },
            {
                "speaker_id": "1",
                "transcription": "자 보통 일반적으로 2힐러 체제로 쓸 때는 아몬드 토핑하고 섞어서 쓰는 경우가 많고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.162,
                "end": 91.024
            },
            {
                "speaker_id": "1",
                "transcription": "1분 타이밍 때 힐이 들어가는 걸 노리기 위해서 쿨 3개, 아몬드 2개를 껴서 보통 쿨타임을 17퍼센트로 맞추는 경우도 많이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.034,
                "end": 100.533
            }
        ]
    },
    "summary": "이번 영상은 쿠키런 킹덤에 나온 모든 쿠키들의 토핑을 추천드리도록 하겠고 모바일 게임을 플레이한 만큼 혜택을 받을 수 있는 플레이오 앱을 추천드리고 다크카카오 쿠키는 활용 가치가 많이 없어 올 아몬드 토핑 추천하며 홀리베리는 올 쿨 토핑, 부옵션은 피해감소로 필요에 따라 방어덱으로 올 아몬드도 쓰는 경우가 있고 퓨어바닐라는 부상효과 감소 때문에 대체 불가능한 쿠키로 올 쿨 토핑세트를 추천한다.",
