        "term": [
            {
                "speaker_id": "1",
                "transcription": "오호 야 여러분들 이겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.752
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 원했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.752,
                "end": 7.648
            },
            {
                "speaker_id": "1",
                "transcription": "환상적이구만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.658,
                "end": 9.044
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 이쁜데요 여러분들? 좋아요 좋아요 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.044,
                "end": 12.216
            },
            {
                "speaker_id": "1",
                "transcription": "일단 스킨 디즈니 쿠키 뽑기는 성스킨 리뷰까지 해서 마무리 짓도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.220,
                "end": 20.128
            },
            {
                "speaker_id": "1",
                "transcription": "미션해가지고 이렇게 모을 수도 있고 그리고 어차피 이벤트나 이런 것도 할 게 많은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.128,
                "end": 26.706
            },
            {
                "speaker_id": "1",
                "transcription": "이거 하면 나중에 레전드 쿠키 1종 받을 수 있으니깐 이거 미션 꼭 하시면 될 것 같습니다 귀찮아도.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.716,
                "end": 33.580
            },
            {
                "speaker_id": "1",
                "transcription": "이거 소원별 이벤트 하다 보면은 요 밑에 버그가 있다는데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.576,
                "end": 36.766
            },
            {
                "speaker_id": "1",
                "transcription": "버그가 없는 것 같아요. 이거 다 되고 있네?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.776,
                "end": 38.911
            },
            {
                "speaker_id": "1",
                "transcription": "예 이것도 하나씩 하면서 여러분들 보상 챙겨주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.921,
                "end": 43.670
            },
            {
                "speaker_id": "1",
                "transcription": "뽑기 리뷰는 여기서 마치겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.680,
                "end": 49.566
            }
        ]
    },
    "summary": "화자가 디즈니 쿠키 뽑기를 마무리 짓는다고 설명하고 있다.",
