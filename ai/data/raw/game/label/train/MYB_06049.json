                    3
                ],
                "start": 10.819,
                "end": 12.229
            },
            {
                "speaker_id": "1",
                "transcription": "상대방 분도 클로티드를 쓰는데 얘가 확실히 메인으로 활약하니까 차이가 심하네.",
                "sound_type": [
