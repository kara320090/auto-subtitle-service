        "term": [
            {
                "speaker_id": "1",
                "transcription": "잠시 후",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 0.686
            },
            {
                "speaker_id": "2",
                "transcription": "자 얘는 23.4에 3퍼센트 맞췄고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.696,
                "end": 3.880
            },
            {
                "speaker_id": "2",
                "transcription": "얘는 뭐 능력 되면 공 치 높여주고 밀키웨이 24.4에다가 12퍼센트대",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.890,
                "end": 8.830
            },
            {
                "speaker_id": "2",
                "transcription": "피감은 없어도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.830,
                "end": 10.050
            },
            {
                "speaker_id": "2",
                "transcription": "세팅이 잘 맞춰지면 없어도 잘 돌아가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.050,
                "end": 13.620
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 캡틴 캐비어는 23.7에 7퍼센트대나 6퍼센트 후반대",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.620,
                "end": 18.790
            },
            {
                "speaker_id": "2",
                "transcription": "오징어 먹물은 9퍼센트 이상",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.790,
                "end": 20.832
            },
            {
                "speaker_id": "2",
                "transcription": "목화는 24.5",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.840,
                "end": 22.071
            },
            {
                "speaker_id": "2",
                "transcription": "일단 제일 먼저 요거 목화 하시고 네 스킬 연출 요거 예 예약하면 뜨거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.081,
                "end": 28.330
            },
            {
                "speaker_id": "2",
                "transcription": "그때 바로 캡틴 눌러주고 그다음에 밀키 예약",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.320,
                "end": 31.820
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 10초 대까지 가만히 보기만 하면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.830,
                "end": 34.544
            },
            {
                "speaker_id": "2",
                "transcription": "누를 것 없이",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.550,
                "end": 35.699
            },
            {
                "speaker_id": "2",
                "transcription": "스킬 순서를 밀키, 목화, 도넛, 요렇게 가면은 그게 가장 이상적으로 딜이 잘 나와요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.709,
                "end": 41.688
            },
            {
                "speaker_id": "2",
                "transcription": "여기서 얘 예약을 눌러요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.698,
                "end": 45.334
            },
            {
                "speaker_id": "2",
                "transcription": "예 스킬 나가 거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.344,
                "end": 46.482
            },
            {
                "speaker_id": "2",
                "transcription": "나가면 도넛 누르지 마시고 목화 예약했다가 요때에 같이 누르고 그다음에 여기서는 연타해서 그냥 누르세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.492,
                "end": 57.466
            }
        ]
    },
    "summary": "세팅이 잘 맞춰지면 피감은 없어도 잘 돌아간다.",
