        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단은 2주년 왕케이크 들개 요거 세팅 먼저 알려드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.645
            },
            {
                "speaker_id": "1",
                "transcription": "일단 보물은 누런 비그, 호루라기, 시계 요렇게 됐는데 뭐 이거 레벨 낮아도 이거 끼고 어느 정도 세팅을 한 6 레벨 정도라도 끼고 하면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.655,
                "end": 15.730
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면은 이 보물 자체가 너무 사기적이라 일단 중요한 건 세팅할 때 뱀파이어하고 호밀이 공격력이 높아야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.740,
                "end": 23.036
            },
            {
                "speaker_id": "1",
                "transcription": "감초가 공격력이 더 높으면 안 되기 때문에 여러분들 전투력이 높은 거 아니라 여기서 이 공격력이 이 나머지 두 쿠키보다 얘가 낮아야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.046,
                "end": 31.718
            },
            {
                "speaker_id": "1",
                "transcription": "일단 세팅을 보면은 얘는 올 쿨이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.728,
                "end": 34.511
            },
            {
                "speaker_id": "1",
                "transcription": "이 케이크 들개는 피감은 다 필요 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.521,
                "end": 36.667
            },
            {
                "speaker_id": "1",
                "transcription": "쿨만 어느 정도 높게 최대한 높게 그리고 공치 여러분들 여유가 되면은 해줄 수 있으면 해주고 에클레어도 그냥 쿨 높게 공치 여러분들 능력껏 감초는 쿨 11 퍼센트 대 뭐 이렇게 해서 4 라즈베리랑 1쿨 해서 이렇게 세팅해주시면 되고 호밀 같은 경우에도 공치 높게랑 쿨 여러분들 가능하면은 세팅해주시고 뱀파이어도 마찬가지 쿨 여러분들 능력껏 최대한 좀 높게랑 공치 요렇게 세팅만 해주고 빌드는 제가 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.677,
                "end": 67.143
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이게 정말 중요하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.153,
                "end": 69.359
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 중요한 게 도트딜 그게 중요한 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.369,
                "end": 73.219
            },
            {
                "speaker_id": "1",
                "transcription": "도트딜이 나올 때까지 좀 리를 어 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.229,
                "end": 76.621
            },
            {
                "speaker_id": "1",
                "transcription": "어 야 잠깐만 이거 어때요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.631,
                "end": 78.300
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 한번 가보겠습니다 빌드.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.310,
                "end": 79.954
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 소땨님이 만드신 조합이랑 빌드예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.964,
                "end": 83.031
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 처음에 배속 끄고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.041,
                "end": 85.096
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어 예약입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.106,
                "end": 86.360
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어 예약하고 에클레어 쓰면은 밀키웨이 바로 예약해주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.370,
                "end": 92.375
            }
        ]
    },
    "summary": "2주년 왕케이크 들개 세팅을 알려드리면 보물 3가지는 레벨 6 정도까지 끼면 좋고 피감은 필요 없고 쿨만 최대한 높게 공치는 여유가 되는 만큼 하고 소따님이 만든 조합이랑 빌드에서 배속은 끄고 에클레어 예약하고 쓰면 바로 밀키웨이를 예약한다.",
