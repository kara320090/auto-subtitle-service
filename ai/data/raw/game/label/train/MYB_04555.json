        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹텀을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.348
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 MAC 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.358,
                "end": 6.480
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.505,
                "end": 11.540
            },
            {
                "speaker_id": "1",
                "transcription": "한번 다른 것도 재고 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.520,
                "end": 14.280
            },
            {
                "speaker_id": "1",
                "transcription": "젤리빈 재고 1000개 스윗젤리 잼 700개 달고나 잼 494개 나머지 재고도 비정상적이네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.280,
                "end": 22.950
            },
            {
                "speaker_id": "1",
                "transcription": "거의 버그 급입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.960,
                "end": 24.276
            },
            {
                "speaker_id": "1",
                "transcription": "솔방울새 인형 500개 도토리 440개 뻐꾹 시계는 적당히 많은 편이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.286,
                "end": 30.281
            },
            {
                "speaker_id": "1",
                "transcription": "드림캐처랑 나머지 적당히 많은 편.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.291,
                "end": 32.299
            },
            {
                "speaker_id": "1",
                "transcription": "갓 구운 빵집도 250개 잼 파이 250개 자 이것도 250개 작업을 하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.296,
                "end": 39.040
            },
            {
                "speaker_id": "1",
                "transcription": "이분 취미가 자릿수 맞추기입니다 하나씩.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.040,
                "end": 42.232
            },
            {
                "speaker_id": "1",
                "transcription": "레스토랑도 젤리 스튜 350개 곰 젤리 버거 350개 그다음에 350개 작업을 하고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.232,
                "end": 49.700
            },
            {
                "speaker_id": "1",
                "transcription": "자 데브시스터즈 관계자분들 이 특정 재고 모으는 거에 특별한 취미가 있는 분들을 위해서 창고를 그냥 더 늘려주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.720,
                "end": 58.166
            },
            {
                "speaker_id": "1",
                "transcription": "이분이 원하는 건 그냥 모든 재고 350개 다 맞추고 1000개 맞추고 이런 걸로 재미를 느끼시는 분 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.160,
                "end": 65.310
            },
            {
                "speaker_id": "1",
                "transcription": "세상에나 400개 작업을 하고 있네요. 400개. 400개.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.320,
                "end": 69.130
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 캔디 꽃다발도 400개 작업을 하고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.140,
                "end": 72.625
            },
            {
                "speaker_id": "1",
                "transcription": "밀키우야 가공소도 400개 작업이 들어가고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.635,
                "end": 76.025
            },
            {
                "speaker_id": "1",
                "transcription": "버터도 250개 드래곤 인형이 무슨 283개 오크통 쉼터도 보틀이 288개 얘 먼저 350개 채울 생각이신가 봐요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.035,
                "end": 85.789
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 재고만큼은 진짜 레전드 자 이벤트도 봐주세요 해서 이벤트도 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.799,
                "end": 91.060
            },
            {
                "speaker_id": "1",
                "transcription": "야 모범생이네. 싹 다 하셨어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.070,
                "end": 93.184
            },
            {
                "speaker_id": "1",
                "transcription": "네 이미 다 받으셨고요. 이분.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.194,
                "end": 95.231
            },
            {
                "speaker_id": "1",
                "transcription": "야 이것도 랭커분이시네. 금손이야 28등 22등 야 뭐야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.241,
                "end": 100.803
            },
            {
                "speaker_id": "1",
                "transcription": "승급도 그렇게 많이 높지 않은데 완전 랭커분.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.813,
                "end": 103.020
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐만 이거 다 하셨어요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 103.030,
                "end": 105.228
            },
            {
                "speaker_id": "1",
                "transcription": "이거 다 하시면은 크탈 7000개에다가 다양한 보상 다 받을 수 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 105.238,
                "end": 111.700
            }
        ]
    },
    "summary": "거의 버그급으로 재고들이 많고 진짜 레전드 급이다.",
