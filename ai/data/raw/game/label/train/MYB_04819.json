                    5
                ],
                "start": 0.000,
                "end": 2.220
            },
            {
                "speaker_id": "1",
                "transcription": "야 2성을 향해서 가네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.230,
                "end": 3.447
            },
            {
                "speaker_id": "1",
                "transcription": "이분 참고로 여러분들 무과금입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.457,
                "end": 6.417
            },
            {
                "speaker_id": "1",
                "transcription": "야 무과금인데 나 지금 하나, 둘, 3개 다 뽑았어 좋은 거.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.427,
                "end": 11.452
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 캡틴캐비어로 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.462,
                "end": 20.179
            },
            {
                "speaker_id": "1",
                "transcription": "오오 야 야 미쳤다 이 계정 뭐야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.189,
                "end": 25.424
            },
            {
                "speaker_id": "1",
                "transcription": "이거 지금 이 페이스는 옛날에 내가 그 다크카카오 첫날 5성 찍었던 페이스네.",
                "sound_type": [
