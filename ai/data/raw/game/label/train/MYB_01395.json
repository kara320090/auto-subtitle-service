        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 요새 생방송이나 영상 댓글에 가장 많이 나오는 질문 락스타가 좋나요, 스냅이 좋나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.683
            },
            {
                "speaker_id": "1",
                "transcription": "복귀 유저라 BTS 쓰는데 락스타가 좋나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.693,
                "end": 9.621
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 퓨어 바닐라가 좋나요, 락스타가 좋나요, 스냅 쿠키가 좋나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.631,
                "end": 13.036
            },
            {
                "speaker_id": "1",
                "transcription": "뭘 써야 될까요 자 이런 질문들에 대해서 제가 어 오늘 정리를 다 해드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.046,
                "end": 19.326
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 어 딜러나 탱크 같은 경우에는 제가 쿠키 티어 정리를 통해서 여러분들이 대충 키워야 될 쿠키를 알고 있지만 힐러 같은 경우에는 자 이렇게 제가 티어 정리를 해 놨어도 어떤 힐러를 키워야 될지 분간이 잘 안되는 분도 있기 때문에 자 초보자분들뿐만 아니라 통합적으로 어 중점적으로 키워야 될 쿠키 위주로 설명을 해 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.336,
                "end": 42.069
            },
            {
                "speaker_id": "1",
                "transcription": "자 가장 중요한 건 여러분들 스냅 드래곤을 가장 먼저 키워야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.079,
                "end": 47.884
            },
            {
                "speaker_id": "1",
                "transcription": "핵심이 되는 1순위, 0순위라고 생각하시면 되구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.894,
                "end": 51.966
            },
            {
                "speaker_id": "1",
                "transcription": "자 2순위로는 락스타 맛 쿠키로 생각하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.976,
                "end": 55.977
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나나 모든 콘텐츠 그다음에 토벌까지 생각해서 락스타 맛 쿠키의 승급도 상당히 중요하기 때문에 여러분들이 지금 스페셜 뽑기에서 락스타 맛 쿠키 뽑기 최대한 해서 승급 올려주는 것도 되게 중요하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.987,
                "end": 69.276
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 3순위로는 퓨어 바닐라 쿠키가 중요하구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.286,
                "end": 73.141
            },
            {
                "speaker_id": "1",
                "transcription": "부상 효과 감소 이거를 대체할 만한 쿠키가 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.151,
                "end": 78.239
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어 바닐라를 버리면 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.249,
                "end": 80.766
            }
        ]
    },
    "summary": "0순위로는 먼저 스냅 드래곤을 키워야 하고 2순위는 락스타 맛 쿠키로 승급을 올려주는 게 중요하며 3순위는 퓨어 바닐라 쿠키인데 부상 효과 감소를 대체할 만한 다른 쿠키가 없으므로 절대 버리면 안 된다.",
