        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 난 이제부터 수장으로 자경단과 지원단을 이끌어갈 생각이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.489
            },
            {
                "speaker_id": "1",
                "transcription": "달리밀에서 베어러에 대한 인식이 완전히 바꾸기까지는 시간이 걸리겠지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.499,
                "end": 9.650
            },
            {
                "speaker_id": "1",
                "transcription": "암튼 이제 새로운 세상의 실현이 그리 멀지 않았다고 난 믿어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.660,
                "end": 14.400
            },
            {
                "speaker_id": "1",
                "transcription": "하루 중 하늘이 가장 어두운 건 동이 트기 직전이니까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.410,
                "end": 17.870
            },
            {
                "speaker_id": "1",
                "transcription": "삼국동맹 다른 길을 걷던 우리가 사상 초유의 사태를 수습하고자 협력을 맹세했다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.880,
                "end": 23.633
            }
        ]
    },
    "summary": "여자에게 게임 캐릭터가 편지를 보냈는데 루보르는 이제부터 수장으로 자경단과 지원단을 이끌고 새로운 세상의 실현이 멀지 않았다고 편지를 썼고 바이런은 다른 길을 걷던 우리가 초유의 사태로 협력을 맹세했다고 편지를 보냈다.",
