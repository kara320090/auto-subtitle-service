        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "왕국에서 상자를 선물하고 보상도 많이 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.692
            },
            {
                "speaker_id": "1",
                "transcription": "꾸미기 게임답게 아기자기하고 귀여운 요소들이 엄청나게 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.702,
                "end": 8.190
            },
            {
                "speaker_id": "1",
                "transcription": "귀여운 열기구를 타고 다니면서 친구 왕국을 날아다닐 수도 있고 축제 선물 상자가 맵에 랜덤으로 뿌려지기 때문에 수많은 선물상자에서 많은 재화를 무료로 파밍 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.200,
                "end": 19.601
            },
            {
                "speaker_id": "1",
                "transcription": "아 나는 꾸미기 별로 관심이 없는데도 할 만한가요라고 하시는 분들 꾸미기 말고도 다양한 미니게임이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.611,
                "end": 26.239
            },
            {
                "speaker_id": "1",
                "transcription": "과금 요소 없이 순수 실력으로만 즐길 수 있는 미니게임 브릿지나 낚시 게임 같은 모양으로 성장시키는 퍼즐게임 등 매주마다 새롭게 업데이트되어 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.249,
                "end": 35.712
            },
            {
                "speaker_id": "1",
                "transcription": "꾸미기도 친구들끼리 같이 4명이서 땅을 합쳐서 공동 왕국 꾸미기가 가능하고 버프를 함께 레벨 업해서 더 발전시킬 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.722,
                "end": 44.009
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그럼 꾸미기 게임에서 생산도 하고 재화도 부족할 텐데 스트레스는 없을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.019,
                "end": 49.552
            },
            {
                "speaker_id": "1",
                "transcription": "생산 스트레스는 타 게임에 비해서 엄청나게 낮은 수준입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.562,
                "end": 52.994
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 내가 부족한 재화를 친구가 대신 채워줄 수 있고 생산시스템도 동시에 5개가 생산되고 대기열도 여러 개 생성 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.004,
                "end": 61.856
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 제가 팁 영상이나 여러분들께 도움될 만한 정보 또는 제가 발전하는 모습 영상으로 같이 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.866,
                "end": 69.368
            },
            {
                "speaker_id": "1",
                "transcription": "고정 댓글에 다운로드 링크로 같이 하실 분은 게임닉 ND러너 친추 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.378,
                "end": 74.474
            },
            {
                "speaker_id": "1",
                "transcription": "서버가 다르면 저와 친추가 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.484,
                "end": 76.874
            },
            {
                "speaker_id": "1",
                "transcription": "저는 드림 서버1에서 하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.884,
                "end": 79.045
            },
            {
                "speaker_id": "1",
                "transcription": "서버 선택도 굉장히 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.055,
                "end": 81.519
            },
            {
                "speaker_id": "1",
                "transcription": "저도 자리날 때 친추 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.529,
                "end": 86.866
            }
        ]
    },
    "summary": "꾸미기 게임답게 아기자기하고 귀여운 요소들이 엄청나게 많은데 나는 꾸미기 별로 관심이 없는데도 할 만한가요라고 하시는 분들 꾸미기 말고도 다양한 미니게임이 있습니다고 하는데 과금 요소 없이 순수 실력으로만 즐길 수 있는 미니게임 브릿지나 낚시 게임 같은 모양으로 성장시키는 퍼즐게임 등 매주마다 새롭게 업데이트되어 나온다고 하고 생산 스트레스는 타 게임에 비해서 엄청나게 낮은 수준인데 왜냐하면 내가 부족한 재화를 친구가 대신 채워줄 수 있고 생산시스템도 동시에 5개가 생산되고 대기열도 여러 개 생성 가능하다고 한다.",
