        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤 하나의 유형만 많이 찍는다고 아레나에서 승률이 엄청나게 높아지지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.281
            },
            {
                "speaker_id": "1",
                "transcription": "골고루 다 찍어주셔야 되고요 5까지 다 찍어주시고 나중에 공, 체, 방 이 순서대로 서서히 다 높여 주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.291,
                "end": 14.477
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 그중에서도 이 치명타 피해 증가는 반드시 만렙까지 먼저 찍어주는 게 중요하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.487,
                "end": 20.682
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 피해 증가는 딜러들의 치명타가 터졌을 때 상대 쿠키한테 피해를 높여 주는 것도 있지만 아군의 힐 자체도 치명타만큼 힐량이 증가된다 이거를 아셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.692,
                "end": 32.098
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 상점에서도 여러분들 반드시 해서는 안 될 행동 자 별사탕 모자르다고 메달로 별사탕 사는 분들 절대 하시면 안 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.108,
                "end": 40.585
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 영혼석을 사시는데 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.595,
                "end": 43.742
            },
            {
                "speaker_id": "1",
                "transcription": "자 뽑기 마일리지도 마찬가지 마일리지 쓸데없다 하시는 분들은 보물 만렙 될 때까지 보물 뽑기권을 쓰시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.752,
                "end": 50.404
            },
            {
                "speaker_id": "1",
                "transcription": "절대 무지개 큐브에다가 마일리지 쓰시면 절대 안됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.414,
                "end": 53.797
            },
            {
                "speaker_id": "1",
                "transcription": "네 가장 최악의 행동입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.807,
                "end": 55.965
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 보물 뽑기는 절대 크리스탈로 뽑으면 안되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.975,
                "end": 58.931
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 뽑기로 하시고 쌓인 마일리지를 보물 뽑기권으로 교환해서 뽑으시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.941,
                "end": 64.675
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 절대 또 해서는 안 될 행동들 자 월화수목금에는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.685,
                "end": 69.166
            }
        ]
    },
    "summary": "토핑을 하나의 유형만 많이 찍으면 안 되고 골고루 다 찍어줘야 되고 치명타 피해 감소는 만렙까지 꼭 찍어줘야 하며 별사탕 모자르다고 메달로 별사탕 사면 절대 안 되고 무지개 큐브에다가 마일리지 쓰는 것이 가장 최악의 행동이고 보물 뽑기도 절대 크리스탈로 하면 안 된다.",
