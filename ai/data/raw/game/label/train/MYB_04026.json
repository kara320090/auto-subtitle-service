        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 출시 된 신규 보물 국왕의 열정이 맺힌 베리 열매 목걸이 요거 만랩 찍고 제가 리뷰 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.970
            },
            {
                "speaker_id": "1",
                "transcription": "자 설명만 보면 되게 좋아 보여요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.980,
                "end": 9.807
            },
            {
                "speaker_id": "1",
                "transcription": "체력 보호막 15퍼센트 체력 보호막인데 이게 레벨 업 할 수록 올라가거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.817,
                "end": 14.090
            },
            {
                "speaker_id": "1",
                "transcription": "1레벨은 15퍼센트인데 만랩까지 찍어보고 피해 감소도 점점 올라갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.100,
                "end": 19.521
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 좀 지긋지긋하게 안 나오는 걸로 해야 얘가 상대적으로 잘 나오지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.531,
                "end": 24.603
            },
            {
                "speaker_id": "1",
                "transcription": "어 저 이걸로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.613,
                "end": 26.237
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 100개부터 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.247,
                "end": 28.750
            },
            {
                "speaker_id": "1",
                "transcription": "출발 야 전략 성공 쓰레기 보물 끼니까 상대적으로 목걸이 잘나와",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.760,
                "end": 37.366
            }
        ]
    },
