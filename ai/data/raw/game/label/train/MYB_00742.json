    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "스킬 대상은 이동 속도 감소, 과전류, 물속성 피해 증가 디버프를 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.050
            },
            {
                "speaker_id": "1",
                "transcription": "과전류 덱도 되게 많이 사용될 수 있고 그리고 물속성 피해 증가가 걸려 있기 때문에 지금 현재 쓰고 있는 코랄 3딜덱 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.060,
                "end": 16.720
            },
            {
                "speaker_id": "1",
                "transcription": "그 3딜 덱에 뭐 들어가서 한번 써볼 가치가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.730,
                "end": 20.940
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스킬 사용 중 프릴해파리맛 쿠키는 땅에 숨어들어 받는 피해가 감소하고 스킬 사용 중에는 뭐 피해가 감소하고 공격 속도 증감에 영향을 받지 않는다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.950,
                "end": 33.796
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이제 전투 불능 상태 이건 죽었다는 뜻이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.806,
                "end": 37.966
            },
            {
                "speaker_id": "1",
                "transcription": "죽었을 때 아기 해파리 모습으로 팀을 따라다니면서 주기적으로 아군을 회복한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.976,
                "end": 44.896
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 샤벳상어 마법 사탕이 나오고 상어 모습으로 최전방에 위치한 적에게 범위 피해를 줄 때 추가 피해를 준다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.906,
                "end": 52.691
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 최대 체력 비례 고정 피해 대상을 강하게 물어뜯고 추가 피해와 부상, 받는 회복 감소 디버프를 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.701,
                "end": 60.458
            },
            {
                "speaker_id": "1",
                "transcription": "이게 얼마나 많이 주는지가 관건인데 이게 너무 진짜 극심하게 많이 주면은 어쩔 수 없이 강제로 힐러를 퓨어바닐라를 다시 쓸 수도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.468,
                "end": 70.641
            },
            {
                "speaker_id": "1",
                "transcription": "이게 얼마나 많이 주느냐에 따라 다르긴 한데 좀 봐야 될 포인트지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.651,
                "end": 75.676
            },
            {
                "speaker_id": "1",
                "transcription": "자 요러고 인연의 홀에는 프릴해파리가 추가가 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.686,
                "end": 79.398
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 수영 기능이 추가가 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.408,
                "end": 82.168
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 쿠키는 물길에서 공중 부양을 할 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.178,
                "end": 86.114
            },
            {
                "speaker_id": "1",
                "transcription": "잘 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.124,
                "end": 86.920
            },
            {
                "speaker_id": "1",
                "transcription": "이게 막 공중 부양 이렇게 할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.930,
                "end": 89.313
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사, 바다요정 쿠키에 신규 BGM 추가 그리고 마일리지 상점에 락스타랑 블랙레모네이드맛 쿠키 영혼석이 추가가 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.323,
                "end": 97.924
            },
            {
                "speaker_id": "1",
                "transcription": "락스타는 아직도 좋게 쓰이고 있으니까 네 초보자분들 시작할 때 마일리지로 이제 락스타 구매해서 이제 스타트하기에 좋게 됐네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 97.934,
                "end": 107.152
            },
            {
                "speaker_id": "1",
                "transcription": "래레모네이드는 뭐 초보자분들이 반드시 사서 시작해야 되는 그런 쿠키는 아니기 때문에 뭐 얘는 중요한 포인트는 아니지만 얘는 되게 중요하다. 왜냐면 락스타는 토벌에서도 필수 쿠키라 자 일단 뭐 공지까지 같이 봤는데 자 현재 해파리가 나오게 되면 제가 미리 아레나 세팅을 해놨는데 물속성 피해 증가라는 얘기가 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 107.162,
                "end": 129.200
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 해파리가 만약에 물속성 피해 증가가 진짜 많이 추가가 된다면은 스타더스트 자리에 넣어서 쓸 수도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 129.210,
                "end": 137.474
            },
            {
                "speaker_id": "1",
                "transcription": "아니면은 박하사탕이랑 같이 넣어서 바다요정이나 다른 뭐 블랙펄이랑 같이 시너지 좋게 써보는 가치도 충분히 있을 것 같다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 137.484,
                "end": 146.196
            },
            {
                "speaker_id": "1",
                "transcription": "또는 과전류 덱에서 과전류 관련된 얘기도 있으니까 프릴해파리가 죽어서 힐을 해주는 능력이 있잖아요. 그래서 블랙펄 자리나 아니면 달빛 자리에 넣어서 과전류 대미지를 주거나 죽어서 실론나이트한테 최대한 힐을 더 주는 생존을 더 유리하게 만드는 그런 세팅으로 사용할 수도 있고 또는 이 과전류 덱이 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 146.206,
                "end": 167.367
            },
            {
                "speaker_id": "1",
                "transcription": "락스타나 아니면은 블랙펄 자리에 넣어서 과전류 덱에 한번 써볼 가치도 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 167.377,
                "end": 171.798
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 샤벳상어 같은 경우에는 지금 현재 쓰이고 있는 정석 덱 조합에 딜러로 한번 써볼 가치도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 171.808,
                "end": 179.072
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 파르페 같이 쓰는 투힐 조합에서도 다양하게 한번 써볼 시도는 해 볼 수 있지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 179.082,
                "end": 185.698
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이렇게 뭐 코랄 조합뿐만 아니라 샤벳상어는 말 그대로 앞에 탱커를 저격하는 조합이기 때문에 굳이 코랄 조합 말고도 용과랑 같이 쓰는 이 투탱에서 클로티드 자리에 샤벳을 넣어서 앞에 탱커 최대한 빨리 녹이는 조합으로도 일단은 시도해 볼 가치도 있을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 185.708,
                "end": 204.553
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 업데이트는 9월 8일이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 204.563,
                "end": 207.442
            },
            {
                "speaker_id": "1",
                "transcription": "업데이트 리뷰 방송 진행하니까 쿠키가 출시되는 순간 쿠키 티어는 또 새롭게 제가 제작해서 최신화해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 207.452,
                "end": 216.891
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 구독, 좋아요 한 번씩만 부탁드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 216.901,
                "end": 219.589
            },
            {
                "speaker_id": "1",
                "transcription": "네 업데이트 리뷰 날 뵙도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 219.599,
                "end": 226.066
            }
        ]
    },
    "summary": "남성이 업데이트 내용을 읽어주며 쿠키가 출시되는 순간 쿠키 티어는 새롭게 제작해서 최신화한다고 하며 업데이트 리뷰 날 뵙자고 한다.",
