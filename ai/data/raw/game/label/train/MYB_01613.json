        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 야 카드 2개부터 시작 자 시작은 어디로 갈까 야 어디 아까 내 맘대로 해서 틀렸거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.277
            },
            {
                "speaker_id": "1",
                "transcription": "이제 여러분들 의견으로 좀 가보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.287,
                "end": 9.193
            },
            {
                "speaker_id": "1",
                "transcription": "표정 읽고 가보자 표정을 야 어떻게 읽고 가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.203,
                "end": 12.733
            },
            {
                "speaker_id": "1",
                "transcription": "고르면 표정이 바뀐다고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.743,
                "end": 14.071
            },
            {
                "speaker_id": "1",
                "transcription": "어 오 그러네 표정이 좀 다르네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.081,
                "end": 18.116
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이거 뭐 훼이크일 수도 있잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.126,
                "end": 20.685
            },
            {
                "speaker_id": "1",
                "transcription": "한 번 해 볼까 야 이거 한 번만 골라보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.695,
                "end": 23.125
            },
            {
                "speaker_id": "1",
                "transcription": "너 뭐야",
