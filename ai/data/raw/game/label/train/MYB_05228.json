                ],
                "start": 0.000,
                "end": 1.130
            },
            {
                "speaker_id": "2",
                "transcription": "뭐 좀 과장된 감이 없지 않아 있지만",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.140,
                "end": 4.596
            },
            {
                "speaker_id": "3",
                "transcription": "검은 바다가 그만큼 위험한 곳이라는 건 모두가 알고 있는 사실이니",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.606,
                "end": 10.175
            },
            {
                "speaker_id": "1",
                "transcription": "아 그럼 검블다이브맛 쿠키는 어떻게 됐어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.185,
                "end": 13.663
            },
            {
                "speaker_id": "1",
                "transcription": "그 동료들을 찾았데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.673,
                "end": 15.515
            },
            {
                "speaker_id": "4",
                "transcription": "음 그건 나중에 직접 만나서 물어 보지 그러냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.525,
                "end": 20.843
            },
            {
                "speaker_id": "2",
                "transcription": "그러려면 얼른 커서 멋진 선원이 되어야겠고 말이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.853,
                "end": 25.913
            },
            {
                "speaker_id": "3",
                "transcription": "자자 비도 그쳤으니 이제 일하자고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.923,
                "end": 29.941
            },
            {
                "speaker_id": "2",
                "transcription": "말단 선원께서는 갑판 청소 먼저 해 주시고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.951,
                "end": 33.460
            },
            {
                "speaker_id": "1",
                "transcription": "우 맨날 청소만 시키고 출항은 언제 해?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.470,
                "end": 38.933
            }
        ]
    },
    "summary": "과장된 감은 있지만 검은 바다가 그만큼 위험하다는 건 모두가 알고 있고 검블다이브맛 쿠키의 행방은 만나서 물어보기로 한다.",
