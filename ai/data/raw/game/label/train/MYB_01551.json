        "term": [
            {
                "speaker_id": "1",
                "transcription": "대난투는 승급 낮으면 답 없냐고요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.031
            },
            {
                "speaker_id": "1",
                "transcription": "근데 확실히 내가 부계정으로도 해보니까 진짜 승급이 너무 낮잖아요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.041,
                "end": 7.179
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스펙 차 나면은 상성도 안 통하긴 해.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.189,
                "end": 10.176
            },
            {
                "speaker_id": "1",
                "transcription": "내가 올린 그 공식이나 뭐 그것도 승급 차이가 너무 나면은 상성이 안 먹히긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.186,
                "end": 15.800
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 어느 정도까지는 승급 차를 상성이 극복을 해주데 너무 차이가 나면 안 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.810,
                "end": 21.595
            },
            {
                "speaker_id": "1",
                "transcription": "너무 차이가 나면 야 이제 나오겠네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.605,
                "end": 29.100
            }
        ]
    },
    "summary": "화자가 너무 승급 차이가 많이 나면 성성도 안 통하긴 한다고 이야기한다.",
