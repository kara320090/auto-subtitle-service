        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 판 좀 힘들 거 같은 데요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.241
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 메인 딜러가 죽어버려서 아 이거 이길 수 있네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.251,
                "end": 9.577
            },
            {
                "speaker_id": "1",
                "transcription": "네 이렇게 돼도 이런 식으로 이기는 그림이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.587,
                "end": 16.511
            },
            {
                "speaker_id": "1",
                "transcription": "을프덱도 이기는 덱으로 공격으로 쓸 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.521,
                "end": 21.801
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이제 실전에서 써볼게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.811,
                "end": 24.295
            },
            {
                "speaker_id": "1",
                "transcription": "네 연습 모드로 한 분들 다 랭커분들이에요.",
                "sound_type": [
                    2
                ],
                "start": 24.305,
                "end": 27.200
            },
            {
                "speaker_id": "1",
                "transcription": "저 금화 다신 분들 다 상위권에 있는 분들한테 들어간 거고 자 실전에서도 마라덱은 진짜 공격으로 쓸 수 있는지 바로 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
