        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "다 오픈하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.635
            },
            {
                "speaker_id": "1",
                "transcription": "오로라 재료 그렇게 많이 안 들어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.645,
                "end": 2.345
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 하나 팁을 드리자면 이거 환경 요소 때문에 이렇게 돼 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.355,
                "end": 5.946
            },
            {
                "speaker_id": "1",
                "transcription": "여 비어 있는 꾸미기 장소에다가 여기다가 환경 점수용 하나 딱 만드세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.956,
                "end": 12.101
            },
            {
                "speaker_id": "1",
                "transcription": "환경 점수 미션으로 나오는 퀘스트가 미션 미션이 새로 나왔다 그러면 요거 들어가서 환경 점수 미션 딱 클리어하고 다시 원래대로 돌아오고 그게 낫습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.111,
                "end": 21.418
            },
            {
                "speaker_id": "1",
                "transcription": "랜드마크 레벨 업 같은 경우에는 지금 이렇게 많이 하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.428,
                "end": 25.676
            },
            {
                "speaker_id": "1",
                "transcription": "이게 지금부터 십이성도 안 됐는데 레벨 업하고 하면은 코인 부족 오로라 재료 부족하니까 얘는 십이성 가고 나서 그때 가서 하시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.686,
                "end": 35.788
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 얘 같은 경우에는 멈추지 말고 지속적으로 해줘야 되는 이유가 곰젤리 열기구는 고기 젤리 소모당 토핑 조각 수급률이 가장 좋은 콘텐츠예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.798,
                "end": 46.175
            },
            {
                "speaker_id": "1",
                "transcription": "가장 멀리 있는 지역으로 탐사를 쉬지 말고 보내주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.185,
                "end": 52.033
            }
        ]
    },
    "summary": "환경 요소 때문에 이렇게 돼 있는데 비어 있는 꾸미기 장소에 환경 점수용 하나 만들고 미션이 나오는 퀘스트가 나오면 들어가서 미션 클리어하고 원래대로 돌아오는게 낫고 랜드마크 레벨 업은 지금 이렇게 많이 하지 말고 코인 오로라 재료 부족하니까 십이성 가고 하시면 되고 얘는 멈추기 말고 지속적으로 해줘야 되는 이유가 곰젤리 열기구는 고기 젤리 소모당 토핑 조각 수급률이 가장 좋기 때문에 가장 멀리 있는 지역으로 탐사를 쉬지 말고 보내라.",
