                "transcription": "오딘의 도미넌트.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.945,
                "end": 3.473
            },
            {
                "speaker_id": "1",
                "transcription": "오딘이 그 말 타고 여 발 6개 달린 말 탄 그 사람이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.483,
                "end": 7.158
            },
            {
                "speaker_id": "1",
                "transcription": "그 소환수죠?",
