        "term": [
            {
                "speaker_id": "1",
                "transcription": "배를 돌려라.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.341
            },
            {
                "speaker_id": "1",
                "transcription": "일단 후퇴, 후퇴한다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 1.351,
                "end": 4.466
            },
            {
                "speaker_id": "2",
                "transcription": "살짝 빠져나왔다고 바다가 이렇게나 잔잔하다니.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 4.476,
                "end": 10.955
            },
            {
                "speaker_id": "3",
                "transcription": "아 뭐에 홀리기라도 한 건지.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 10.965,
                "end": 14.589
            },
            {
                "speaker_id": "4",
                "transcription": "으악 정말 큰일 나는 줄 알았네.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 14.599,
                "end": 18.980
            },
            {
                "speaker_id": "5",
                "transcription": "그런 폭풍우는 난생 처음 봅니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 18.990,
                "end": 21.332
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 이대로 돌아갑니까?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 21.342,
                "end": 23.565
            },
            {
                "speaker_id": "3",
                "transcription": "그건 샤크 호 선원 자존심이 허락하지 않는데요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 23.575,
                "end": 27.546
            },
            {
                "speaker_id": "4",
                "transcription": "맞, 맞아요.",
