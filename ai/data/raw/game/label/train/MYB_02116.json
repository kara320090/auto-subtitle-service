        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 용과 드래곤 업데이트가 바로 내일입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.242
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 시즌3 아레나가 이제 얼마 남지 않았기 때문에 여러분들이 리그 보상을 최대한 높게 받기 위해서 제가 이번 영상에서는 공격팀과 방어팀 어떤 걸 설정해야 여러분들이 좀 더 좋을지 추천을 해드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.252,
                "end": 18.479
            },
            {
                "speaker_id": "1",
                "transcription": "자 먼저 방어팀 도대체 뭘 해야 될까요 방어해놓은 거마다 다 뚫립니다 뭐 그런 분들이 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.489,
                "end": 25.183
            },
            {
                "speaker_id": "1",
                "transcription": "자 방어덱을 제가 추천을 드리면은 2가지를 추천드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.193,
                "end": 29.032
            },
            {
                "speaker_id": "1",
                "transcription": "하나는 자 방어덱 같은 경우에는 이 찰스덱을 추천드립니다.",
