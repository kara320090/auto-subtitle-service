        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 해서 무과금 계정 모든 쿠키 없는 쿠키 싹 다 뽑았습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.944
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신, 스타더스트, 달빛도 뽑았고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.954,
                "end": 9.525
            },
            {
                "speaker_id": "1",
                "transcription": "용과 드래곤도 뽑았고요 이제 남 부럽지 않은 계정 됐어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.535,
                "end": 14.215
            },
            {
                "speaker_id": "1",
                "transcription": "원하는 거 다 마음대로 하세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.225,
                "end": 16.572
            },
            {
                "speaker_id": "1",
                "transcription": "무과금이지만 무과금 아닌 그런 원하는 세팅 다 할 수 있어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.582,
                "end": 20.597
            },
            {
                "speaker_id": "1",
                "transcription": "나름 진짜 대박 났습니다.",
                "sound_type": [
                    2
                ],
                "start": 20.607,
                "end": 22.395
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 액션운 뽑기는 여기서 끝",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.405,
                "end": 28.700
            }
        ]
    },
    "summary": "돈을 들이지 않고 모든 쿠키를 뽑게 되었다.",
