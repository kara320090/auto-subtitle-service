        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 가저 회복하는 애들은 아니네?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.087
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 애들이 많아서 광역 딜러가 무조건 좋다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.097,
                "end": 7.550
            },
            {
                "speaker_id": "2",
                "transcription": "열차가 흔들리겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.550,
                "end": 9.419
            },
            {
                "speaker_id": "1",
                "transcription": "야 무슨 첫판에 10억이 나오니?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.420,
                "end": 12.523
            },
            {
                "speaker_id": "1",
                "transcription": "거의 9억 나왔어 첫판에 야 이거 재밌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.533,
                "end": 16.958
            },
            {
                "speaker_id": "1",
                "transcription": "야 그냥 무한 폭딜이야.",
