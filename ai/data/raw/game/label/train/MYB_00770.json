    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그리고 스킬 파우더도 이제 개편이 돼서 선택적으로 여러분들 파밍이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.702
            },
            {
                "speaker_id": "1",
                "transcription": "프릴 해파리는 마법형이나 지원형 느낌이 강하기 때문에 여러분들이 파우더가 부족하다면 선택적으로 모아두시는 것도 추천드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.845,
                "end": 14.162
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여러분들 마법 사탕 만들 때 이 사탕 결정 부족한데 어디서 파밍 하나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.172,
                "end": 19.655
            },
            {
                "speaker_id": "1",
                "transcription": "저 얘기도 되게 많거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.680,
                "end": 20.997
            },
            {
                "speaker_id": "1",
                "transcription": "자 설탕 결정 같은 경우에는 이렇게 마스터 모드에서 여러분들 각각의 유형별로 파밍이 가능하고 자 케이크 타워에서도 여러분들 층마다 오를 때 순수의 설탕 결정 모을 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.005,
                "end": 33.881
            },
            {
                "speaker_id": "1",
                "transcription": "자 무엇보다 아레나가 이제 얼마 안 남았거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.891,
                "end": 36.665
            },
            {
                "speaker_id": "1",
                "transcription": "프릴 해파리 업데이트가 다음 주예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.682,
                "end": 39.112
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 아레나 귀찮아서 안 하시는 분들 이제는 진짜 해야 될 때 입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.122,
                "end": 43.713
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 한 번에 받는 실질 보상 말고도 티어가 오를 때마다 얻는 이 티어 보상들도 누적해서 받으면 크리스털 몇 만개 될 수 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.723,
                "end": 53.336
            },
            {
                "speaker_id": "1",
                "transcription": "이거 다 받으시고 또 하나 메달 상점에 들어가서 리그 상점에 리그 상점에서 따로 구매할 수 있는 것도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.346,
                "end": 60.323
            },
            {
                "speaker_id": "1",
                "transcription": "이 시즌 얼마 안 남아서 이거 아직 모르시는 분들은 들어가서 메달 여유 있으면 구매하시길 바라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.333,
                "end": 67.056
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 프릴 해파리가 출시되어도 여러분들 크림슨 코랄 쿠키 자체는 정말 0티어고 필수 쿠키라 반드시 뽑아야 되는 쿠키거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.066,
                "end": 75.921
            },
            {
                "speaker_id": "1",
                "transcription": "이거 보석 인어 쿠키들 뽑기 매일매일 광고 보면은 뽑기권 얻을 수 있어서 이것도 매일매일 반드시 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.931,
                "end": 84.042
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 운 좋으면은 이렇게 인어 쿠키를 얻을 수 있고 네 크리스털 무지개 큐브 다양하게 얻을 수 있으니까 이것도 놓치지 말고 반드시 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.052,
                "end": 93.650
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이 특별 토핑 어떤 것 선택하나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.660,
                "end": 97.040
            },
            {
                "speaker_id": "1",
                "transcription": "질문하신 분들 자 이번에 나온 특별 토핑은 바다 요정도 올쿨로 쓰고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.050,
                "end": 102.917
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄도 올쿨로 쓰고 크림슨 코랄도 올쿨로 쓰고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.927,
                "end": 107.279
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕은 현재 아몬드로 쓰고 있지만 뭐 엄청난 필수 쿠키가 아닌 상태고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 107.289,
                "end": 112.492
            },
            {
                "speaker_id": "1",
                "transcription": "셔벗 상어는 이제 마법사탕으로 출시되면 예전에는 올쿨로도 셔벗 상어 썼는데 그거는 나와봐야 알 것 같고 지금 현재 쓰이고 있는 이 핵심 쿠키들이 전부다 올쿨로 쓰고 있기 때문에 쿨토핑 선택해도 여러분들 전혀 문제가 없을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 112.502,
                "end": 128.366
            }
        ]
    },
    "summary": "프릴 해파리 업데이트가 다음 주이기 때문에 아레나 귀찮아서 안 하셨던 분들도 이제는 정말 해야 할 때이고 프릴 해파리가 업데이트 되더라도 크림슨 코랄은 0티어이기 때문에 반드시 뽑아야 하는 쿠키이다.",
