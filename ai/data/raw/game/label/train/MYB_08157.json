                ],
                "start": 10.096,
                "end": 17.396
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그거를 하나씩 막 다 잡고 있는데 저 위에서 계속 쾅쾅거려서 미치겠는 거예요 시끄러워서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.406,
                "end": 23.382
            },
            {
                "speaker_id": "1",
                "transcription": "그래 갖고 어찌 어찌 정리를 다 했다 다 잡고 나니까 그만 두들기는 거야.",
                "sound_type": [
                    2,
