        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 수호의 성전 시즌 23입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.304
            },
            {
                "speaker_id": "1",
                "transcription": "이번 시즌 특별 규칙은 돌격형 타입의 체력 공격력 증가 침투형 타입 공격력 증가고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.314,
                "end": 8.413
            },
            {
                "speaker_id": "1",
                "transcription": "자 팀은 제가 이번에는 3가지로 운영해서 할 건데 좀 더 자세한 공략들은 고정 댓글에 스페셜 길드의 @이름1님 공략들이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.423,
                "end": 17.188
            },
            {
                "speaker_id": "1",
                "transcription": "상세 토핑 관련된 것도 정보 있으니까 그거 참고해 보셔도 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.198,
                "end": 21.923
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 메인 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.933,
                "end": 23.265
            },
            {
                "speaker_id": "1",
                "transcription": "메인 덱은 무공비 공속 그다음에 낫보물이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.275,
                "end": 26.504
            },
            {
                "speaker_id": "1",
                "transcription": "망토 보물은 타르트타탕하고 망고한테 가야 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.514,
                "end": 30.068
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다요정은 잼스톤 몇 강부터 쓸 수 있나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.078,
                "end": 32.555
            },
            {
                "speaker_id": "1",
                "transcription": "보니까 7 레벨에서 10 레벨 사이인 분들도 기존보다 훨씬 더 길록 높게 기록 갱신했다는 얘기가 나오고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.565,
                "end": 40.126
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄보다는 바다요정이 확실히 수호 성전에서는 더 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.136,
                "end": 44.430
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 바다요정 잼스톤이 아예 없다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.440,
                "end": 46.712
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들은 블랙펄 쓰거나 아니면 달빛술사 아니면 오징어먹물 어 요렇게 광역 딜러로 대체하고 타르트타탕이나 망고가 없어도 마찬가지로 블랙펄, 달빛, 오징어먹물 등 광역 딜러로 대체해 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.722,
                "end": 61.147
            },
            {
                "speaker_id": "1",
                "transcription": "대체가 안 되는 게 슈크림하고 도넛입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.157,
                "end": 64.337
            },
            {
                "speaker_id": "1",
                "transcription": "정 도넛이 안되면은 뭐 코랄이나 홀리베리 뭐 이런 걸로 대체하시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.347,
                "end": 69.597
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림이 정 없다 하시는 분들은 퓨어바닐라, 스냅드래곤 이런 쿠키로 대체해 주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.607,
                "end": 76.106
            },
            {
                "speaker_id": "1",
                "transcription": "자 토핑 설명 보면은 자 도넛은 올 쿨 세팅해서 쿨 높게 공속은 망토 봄을 안 받는 범위 내에서 저는 최대한 올려줬고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.116,
                "end": 84.689
            },
            {
                "speaker_id": "1",
                "transcription": "여유되면은 치명타 확률 높게 자 망고는 공속 망토 받아야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.699,
                "end": 89.111
            },
            {
                "speaker_id": "1",
                "transcription": "쿨 높게 치명타 확률은 높게 자 바다요정은 3 라즈, 2 애플젤리 아 쿨 2에서 3퍼센트 공속은 망토 안 받는 범위 내에서 예 그다음에 치명타 확률 높게 자 타르트는 공속 망토 받는 범위 내에서 치명타 확률과 공격력 높게 자 슈크림은 3 애플젤리, 2 라즈 쿨 높게 공속은 2에서 3퍼센트 하나 줬고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.121,
                "end": 111.435
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 확률 높게 자 두 번째 공속 덱이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 111.445,
                "end": 115.180
            },
            {
                "speaker_id": "1",
                "transcription": "부적은 상대의 몹들의 보호막을 타수 보호막을 제거하는 용도입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 115.190,
                "end": 119.555
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 필요하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 119.565,
                "end": 120.623
            },
            {
                "speaker_id": "1",
                "transcription": "망토 저격이 중요합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 120.633,
                "end": 122.402
            },
            {
                "speaker_id": "1",
                "transcription": "망토는 퀸아망하고 웨어울프로 봤고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 122.412,
                "end": 125.548
            },
            {
                "speaker_id": "1",
                "transcription": "어 공속 덱에 들어가는 쿠키가 없어요 하시는 분들은 여러분들이 가지고 있는 공속 덱 쿠키를 넣어주시면 되고 자 퀸아망은 올 애플젤리 망토를 받아야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 125.558,
                "end": 136.122
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 여유되면은 치명타 확률 자 마라는 공속 받지 않는 범위 내에서 치명타 확률 높게 자 웨어울프는 공속 받아야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 136.132,
                "end": 143.749
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 높게 그리고 웨어울프는 피감을 좀 줘야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 143.759,
                "end": 146.985
            },
            {
                "speaker_id": "1",
                "transcription": "없으면은 죽을 수도 있기 때문에 100퍼센트 이상 또 스펙 낮은 분들은 20퍼센트 이상까지라도 주셔야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 146.995,
                "end": 153.183
            },
            {
                "speaker_id": "1",
                "transcription": "소르베도 망토 안 받는 범위 내에서 높게 그담에 치명타 확률 높게 자 서리여왕은 올 라즈베리 망토 안 받는 범위 내에서 높게 치명타율이나 공격 높게 자 그러고 1번 2번 덱도 여러분들 어떤 쿠키가 죽어요 하시는 분들 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 153.193,
                "end": 168.714
            },
            {
                "speaker_id": "1",
                "transcription": "피감을 높여 주시면 되고 간혹 가다 이런 질문도 있어요. 부활 보물을 안 썼는데 어떻게 쿠키가 부활하나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 168.724,
                "end": 173.949
            },
            {
                "speaker_id": "1",
                "transcription": "그거는 유물 길드 유물에 부활 효과가 있는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 173.959,
                "end": 177.327
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 마지막 3번 덱은 맨 마지막 클리어 용도로 쓰는 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 177.337,
                "end": 181.344
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1님 공략 보면은 구미호로도 쓰지만 구미호 보다는 다크초코가 무난하게 사람들이 더 많기 때문에 요걸로 해도 되고 다크초코는 아예 토핑을 안 껴도 되고 라즈로 껴도 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 181.354,
                "end": 193.274
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 주시고 밀키는 토벌 그대로 가져오시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 193.284,
                "end": 197.482
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임 높게 자 그다음에 캡세신은 이게 공속 토핑 껴서 써 줬는데 망토 받을 수 있게끔만 해 주시고 3 라즈, 2 애플젤리나 공속 토핑 써서 세팅해 주시면 돼요.;",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 197.492,
                "end": 210.011
            },
            {
                "speaker_id": "1",
                "transcription": "자 교체 타이밍이나 이런 거는 제가 영상 하면서 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 210.021,
                "end": 216.433
            }
        ]
    },
