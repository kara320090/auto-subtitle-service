        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여기서 중요한 건 락스타가 제일 먼저 죽어서 1분 타이밍 때 나머지 쿠키들의 체력을 채워주냐",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.294
            },
            {
                "speaker_id": "1",
                "transcription": "피감을 적당히 낮춰줘야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.304,
                "end": 9.580
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 쿠키런 킹덤이 피감이 높은 게 좋은 게 아니라 적절한 타이밍에 죽어줄 쿠키는 죽어줘야 승률이 좋은 그림이 나오기도 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.590,
                "end": 19.261
            },
            {
                "speaker_id": "1",
                "transcription": "자 보게 되면은 보이나요? 이 그림을 원하는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.271,
                "end": 23.654
            },
            {
                "speaker_id": "1",
                "transcription": "내 쿠키는 브레스에 다 죽어요 이렇게만 생각하지 마시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.664,
                "end": 27.569
            },
            {
                "speaker_id": "1",
                "transcription": "요런 그림을 나올 수 있게끔 락스타 피감을 조절을 해주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.579,
                "end": 31.857
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 낮춰줄 피감은 낮춰주고 올려줄 피감은 올려주고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.867,
                "end": 35.971
            },
            {
                "speaker_id": "1",
                "transcription": "자 요런 식으로 되게 되면 승률은 완전히 올려줄 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.981,
                "end": 41.355
            },
            {
                "speaker_id": "1",
                "transcription": "내 쿠키는 왜 자꾸만 1분 타이밍에 다 녹는가",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.365,
                "end": 44.530
            },
            {
                "speaker_id": "1",
                "transcription": "그거는 여러분들이 설정 하나만 바꿔주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.540,
                "end": 48.038
            },
            {
                "speaker_id": "1",
                "transcription": "오히려 피감을 올려주는 게 아니라 낮춰줘서 이길 수 있는 그림을 만들 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.048,
                "end": 55.833
            }
        ]
    },
    "summary": "화자가 락스타가 제일 먼저 죽어 1분 타이밍 때 나머지 쿠키들의 체력을 채워주냐가 중요하며 쿠키런에서 피감이 높다고 좋은 것이 아니라 적절한 타이밍에 죽어야 될 쿠키들은 죽어주는 게 승률을 올릴 수 있는 길이라고 말하고 있다.",
