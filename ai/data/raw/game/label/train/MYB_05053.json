        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이거 바꿔볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.671
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱 같은 경우에는 원제작자가 @이름1 님이 어 제작한 걸로 알려져 있고 어 공개적으로 이걸 오픈한 분은 이제 @이름2 님이 이미 오픈을 하신 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.681,
                "end": 14.515
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래서 이제 @이름3 님이 저한테 알려주신 건데 확실히 좋은 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.525,
                "end": 19.642
            },
            {
                "speaker_id": "1",
                "transcription": "아까 테스트로 여러 번 해봤는데 승률이 거의 100퍼센트입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.652,
                "end": 23.823
            },
            {
                "speaker_id": "1",
                "transcription": "투탱덱 상대로 거의 지지 않는 덱 지지 않는 덱으로 여러분들이 써도 상당히 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.833,
                "end": 31.626
            },
            {
                "speaker_id": "1",
                "transcription": "서리 여왕은 딜러의 역할보다 확실히 얼려서 상대 쿨타임을 흐르지 않게끔 스킬을 쓰기 이제 지연시키는 역할 그런 역할이라고 보면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.636,
                "end": 42.762
            },
            {
                "speaker_id": "1",
                "transcription": "자 투탱도 다 들어가 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.772,
                "end": 45.378
            },
            {
                "speaker_id": "1",
                "transcription": "자 워낙 서리 여왕이 몸이 약하기 때문에 최대한 에 최대한 피해 감소를 높여주는 게 좋은 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.388,
                "end": 56.301
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이 덱 같은 경우 원탱에서도 아까 통하긴 했는데 질 때가 있대요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.311,
                "end": 61.541
            },
            {
                "speaker_id": "1",
                "transcription": "질 때가 있기 때문에 어 제가 제가 올린 용구한방덱이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.551,
                "end": 67.203
            },
            {
                "speaker_id": "1",
                "transcription": "용구한방덱 영상 보시면 그 용구한방덱은 원탱덱은 전부 다 이기거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.213,
                "end": 72.933
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 용구 덱으로 원탱덱 잡고 그 세팅이나 이런 거 유튜브에 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.943,
                "end": 76.759
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 투탱방덱은 이 덱으로 가고 그러면은 거의 뭐 모든 공략이 되지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.769,
                "end": 83.033
            }
        ]
    },
    "summary": "투탱덱 상대로 거의 지지 않는 덱이며 이 덱의 서리 여왕은 딜러 역할보다는 얼려서 상대 쿨타임을 지연시키는 역할이 크며 몸이 약하기 때문에 피해 감소를 높여주는 게 중요하다.",
