    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "더 편한 기능은 바쁘신 분들 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.905
            },
            {
                "speaker_id": "1",
                "transcription": "한번 채우기 눌러서 보유 수량이 가장 적은 생산품 우선에서 채울 수 있고 제작 시간이 가장 짧은 걸로도 채울 수가 있고 긴 걸로 채울 수 있고 여러분들 선택해서 편하게 한 번만 누르면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.222,
                "end": 14.357
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 요렇게 전부 다 채워진다는 점이 정말 편합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.585,
                "end": 18.422
            },
            {
                "speaker_id": "1",
                "transcription": "요거 꼭 업그레이드하시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.935,
                "end": 21.275
            },
            {
                "speaker_id": "1",
                "transcription": "중간에 좀 바뀐 부분 몇 가지를 제가 설명을 드리면은 이 생산품 자체가 10개가 모일 동안은 곰 젤리 열차에 여기 등장하지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.542,
                "end": 30.572
            },
            {
                "speaker_id": "1",
                "transcription": "10개가 재고가 모이는 순간 여기서 이제 등장하게 되는 구조가 되었고 생산품 관련된 밸런스가 좀 조정돼서 아마 과거보다는 확실하게 여러분들 스트레스가 좀 덜할 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.985,
                "end": 44.117
            },
            {
                "speaker_id": "1",
                "transcription": "하나 더 말씀드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.472,
                "end": 45.930
            },
            {
                "speaker_id": "1",
                "transcription": "이 쿠키 하우스 아까 질문한 분이 있는 데 이게 분리한 거랑 합친 거랑 차이가 뭔가요라고 이제 물어보신 분이 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.175,
                "end": 53.800
            },
            {
                "speaker_id": "1",
                "transcription": "평소에는 별사탕을 생산할 때는 합쳐 놓으나 분리해서 놓으나 차이가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.157,
                "end": 59.262
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 이 업그레이드 할 때만큼은 여러분들 분리해서 하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.610,
                "end": 64.237
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면은 합쳐놓게 되면은 이 건설 시간이 2배가 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.472,
                "end": 67.982
            },
            {
                "speaker_id": "1",
                "transcription": "레벨 업 하면은 1일 17시간이 2배가 되잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.250,
                "end": 70.775
            },
            {
                "speaker_id": "1",
                "transcription": "근데 얘를 분리하게 되면은 반이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.132,
                "end": 73.462
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 한마디로 합쳐 놓으면은 그 시간 동안 별사탕 생산을 못하고 묶여놓게 되는 데 별사탕 생산 손실을 안 보기 위해서는 각각 분리해서 하는 게 좋고 나는 귀찮다 하시는 분들은 그냥 합쳐놓고 하시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.627,
                "end": 86.947
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키성 레벨 12레벨 일 때는 쿠키 하우스 레벨 권장은 10레벨입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.250,
                "end": 92.322
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키성 레벨이 13 정도 되면은 쿠키 하우스 레벨은 11 정도 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.665,
                "end": 97.967
            },
            {
                "speaker_id": "1",
                "transcription": "정답은 아니고 추천이라는 점 아 토핑 관련돼서도 물어보셔서 지금 말씀드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.175,
                "end": 104.017
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 강화는 여러분들이 어떻게 하셔야 되냐면은 공격력, 공격 속도, 치명타 확률, 쿨타임, 피해 감소",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 104.125,
                "end": 112.041
            }
        ]
    },
    "summary": "한번 채우기 눌러서 보유 수량이 가장 적은 생산품 우선, 제작 시간이 가장 짧은 것, 긴 것 중에 선택해서 편하게 한 번만 누르면 전부 다 채워진다는 점이 정말 편하니까 꼭 업그레이드해야 하며 생산품 10개가 모일 동안은 곰 젤리 열차에 등장하지 않고 생산품 관련된 밸런스가 좀 조정돼서 과거보다는 확실히 스트레스가 덜하며 쿠키하우스는 별사탕을 생산할 때는 합쳐 놓으나 분리해서 놓으나 차이가 없지만 업그레이드 할 때만큼은 합쳐놓게 되면 이 건설 시간이 2배이기 때문에 분리하는 게 좋고 쿠키성 레벨 12레벨 일 때는 쿠키 하우스 레벨 권장은 10레벨, 13 정도 되면은 쿠키 하우스 레벨은 11 정도가 추천되며 토핑 강화와 관련된 공격력, 공격 속도, 치명타 확률, 쿨타임, 피해 감소에 대해서도 남성이 말하려고 한다.",
