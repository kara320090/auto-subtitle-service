        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "토를 바퀴가 없는 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.216
            },
            {
                "speaker_id": "1",
                "transcription": "이미 이거 덱 같은 경우에는 2시즌 전에 썼던 덱인데 일단은 모노클이 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.226,
                "end": 8.717
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 기존에는 옛날에는 깃털이 들어갔지만 모노클이 좀 들어갔다는 점 왜냐하면 소르베나 이제 서리 디버프 같은 게 어 모노클에 의해서 지워지기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.727,
                "end": 18.141
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 자구마 같은 경우에는 쿨 없이 그냥 피감만 신경 써 주시면 되고 근데 내가 진짜 리뷰 영상 찍을 때 마다 아니 48.9퍼센트를 어떻게 맞추란 말이야 이렇게 댓글에 쓰는 분들 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.151,
                "end": 30.919
            },
            {
                "speaker_id": "1",
                "transcription": "근데 극한으로 최대한 맞추는 이유는 상위권에서는 이렇게 세팅 안 하고 여러분들한테 리뷰로 뭐 40퍼센트도 할 수 있습니다라고 보여줬을 때 제가 지는 모습밖에 못 보여드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.929,
                "end": 42.779
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 상대방 분들도 저보다 더 좋은 스펙으로 피감을 세팅한 분들도 있기 때문에 제가 요렇게 높게 세팅한 이유는 상대방들하고 썼을 때 이길 수 있는 그런 스펙이 돼야 하기 때문에 요렇게 한 거고 여러분들 능력껏 맞춰주시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.789,
                "end": 59.373
            },
            {
                "speaker_id": "1",
                "transcription": "피감이나 쿨세팅 이런 거는 뭐 여러분들 능력껏 맞춰주시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.383,
                "end": 64.310
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 휘낭시에 같은 경우에도 쿨 19퍼센트, 20퍼센트 이상 맞춰주시면 되고 피감도 마찬가지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.320,
                "end": 70.793
            },
            {
                "speaker_id": "1",
                "transcription": "절대 영상에서 여러분들한테 27퍼센트까지 요구하는 게 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.803,
                "end": 76.046
            },
            {
                "speaker_id": "1",
                "transcription": "능력껏 하시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.056,
                "end": 77.631
            },
            {
                "speaker_id": "1",
                "transcription": "자 클로티드도 마찬가지 피감을 여러분들 능력껏",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.641,
                "end": 80.718
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.728,
                "end": 81.568
            },
            {
                "speaker_id": "1",
                "transcription": "쿨은 8퍼센트 가까이 넘기거나 그러면 좋긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.578,
                "end": 85.010
            },
            {
                "speaker_id": "1",
                "transcription": "공속이랑 쿨은 가급적 있으면 좋고 그다음에 블랙펄도 8퍼센트 이상이랑 피감은 능력껏",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.020,
                "end": 91.632
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키는 쿨타임 24.1퍼센트 쿨을 많이 주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.642,
                "end": 96.562
            },
            {
                "speaker_id": "1",
                "transcription": "저는 이거 서브 쿨 토핑으로 맞춰서 이렇게 됐는데 좀 좋은 옵션은 공격력, 치명타 확률 그다음에 공속 이 3가지 있으면 더 좋습니다.",
                "sound_type": [
