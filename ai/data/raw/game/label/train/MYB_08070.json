        "term": [
            {
                "speaker_id": "1",
                "transcription": "아무튼 이게 그 아이의 이 아이의 가치다 모르겠으면 그 돈 들고 꺼져라고 할머니가 사줬나 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.498
            },
            {
                "speaker_id": "1",
                "transcription": "음 할머니가 던진 돈이 반짝반짝 빛났는데 나도 살아있어도 되는구나 하고 그때 처음으로 생각했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.508,
                "end": 12.546
            },
            {
                "speaker_id": "1",
                "transcription": "그 뒤로 난 할머니 옆에 있기로 결심했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.556,
                "end": 14.842
            },
            {
                "speaker_id": "1",
                "transcription": "계속 그저 죽을 때까지 옆에 있을 거야",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.852,
                "end": 17.389
            },
            {
                "speaker_id": "1",
                "transcription": "착하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.399,
                "end": 18.980
            },
            {
                "speaker_id": "1",
                "transcription": "계속 울기만 하면 부분에서 웃으면서 굳이 기츠라고 쓰시는 거 보니까 저랑 고츠를 아주 동일시 하나 본데 저는 울보가 아니에요.",
                "sound_type": [
                    2,
