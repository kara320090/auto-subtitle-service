        "term": [
            {
                "speaker_id": "1",
                "transcription": "이것도 맞고 이것도 맞고 아 또 바보같이 썼어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.121
            },
            {
                "speaker_id": "2",
                "transcription": "조슈아는 지읒이 슈퍼 아머인가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.131,
                "end": 10.204
            },
            {
                "speaker_id": "1",
                "transcription": "아윽 아 무슨 말 하는 거예요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.214,
                "end": 12.982
            },
            {
                "speaker_id": "1",
                "transcription": "무우수 님 진짜 챙피하게 여기 지금 오늘 애들이 없긴 해 19금 게임이라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.992,
                "end": 17.377
            },
            {
                "speaker_id": "1",
                "transcription": "마음껏 하시죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.387,
                "end": 20.240
            },
            {
                "speaker_id": "1",
                "transcription": "애들이 없긴 하네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.250,
                "end": 23.802
            },
            {
                "speaker_id": "1",
                "transcription": "조슈아 생각은 안 물어 보죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.812,
                "end": 26.082
            },
            {
                "speaker_id": "2",
                "transcription": "정이요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.092,
                "end": 27.543
            },
            {
                "speaker_id": "1",
                "transcription": "아 아 나만 이상한 사람 만들고 나만 이상한 사람 만들고",
