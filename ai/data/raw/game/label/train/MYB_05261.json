        "term": [
            {
                "speaker_id": "1",
                "transcription": "배달하는 쿠키 연구 같은 경우에는 자 잘 되어 있고 요거 대장간 먼저 하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.649
            },
            {
                "speaker_id": "1",
                "transcription": "대장간은 만렙을 찍어 주시는 게 최우선입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.659,
                "end": 8.266
            },
            {
                "speaker_id": "1",
                "transcription": "이런 기본 재료 찍는 것보다도 이런 거 먼저 찍는 게 더 중요해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.276,
                "end": 12.416
            },
            {
                "speaker_id": "1",
                "transcription": "대장간이 업그레이드의 최우선 순위입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.426,
                "end": 14.769
            },
            {
                "speaker_id": "1",
                "transcription": "모든 기본 재료는 싹 다 가속되는 거라 얘 레벨을 많이 올리주 올려주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.779,
                "end": 19.815
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 요건 어이구야 어유 성실 그 자체네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.825,
                "end": 23.340
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 연구 자체를 집중적으로 잘 많이 하셨구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.350,
                "end": 26.025
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 꾸준히 한 느낌이 여기서 나오네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.035,
                "end": 29.793
            },
            {
                "speaker_id": "1",
                "transcription": "이제 방어력만 이제 다 올리면은 연구소도 졸업이 머지않았다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.803,
                "end": 35.200
            }
        ]
    },
    "summary": "화자가 대장간이 업그레이드의 최우선 순위라 쿠키 연구는 대장간 만렙이 중요하고 방어력만 다 올리면 연구소 졸업이 머지않았다고 한다.",
