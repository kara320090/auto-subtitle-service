        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 첫 번째 깃털이고 160만에다가 가운데가 가려져 있는데 이럴 때 원래 3번으로 들어가긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.988
            },
            {
                "speaker_id": "1",
                "transcription": "근데 가운데가 에스프레소면 2번 덱으로 하면 그냥 이기는데 만약에 클로티드면 2번 덱이 막히는 경우도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.992,
                "end": 13.824
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그냥 일단은 에스프레소인 거 같아서 한 번 이걸로 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.824,
                "end": 18.304
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 들어갔는데 상대가 에스프레소다 이러면 성공입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.308,
                "end": 22.776
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드이면 승률이 좀 떨어지기 때문에 요렇게 쓰시면 되고 가운데 딱 봤는데 에스프레소에요 하면 들어가면 승률 엄청나게 높게 쓰일 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.780,
                "end": 38.052
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이 덱이 이길 수 있는 이유는 자 일단 요렇게 상대의 딜러를 잘라줄 수 있고 아포가토 같은 경우에는 진짜 상대의 저격해서 딜러를 죽여줄 수 있기 때문에 이렇게 승리할 수 있는 요소가 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.052,
                "end": 56.218
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 공격 보면 흑당이 원래 올 아몬드라고 해도 공격력이 좋은데 올 라즈로 세팅하니까 그냥 딜이 미쳐 날뛰게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.228,
                "end": 67.166
            }
        ]
    },
