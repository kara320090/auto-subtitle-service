        "term": [
            {
                "speaker_id": "1",
                "transcription": "진짜 하나하나 너무너무 아껴서 해야지. 이걸 어떡하면 좋누?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.811
            },
            {
                "speaker_id": "1",
                "transcription": "쩐다 쩔어. 그쵸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.821,
                "end": 10.325
            },
            {
                "speaker_id": "1",
                "transcription": "이 크리스탈이구나 이게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.335,
                "end": 11.910
            },
            {
                "speaker_id": "1",
                "transcription": "아 이게 크리스탈이에요? 이게 이게 크리스탈이죠 이거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.922,
                "end": 14.782
            },
            {
                "speaker_id": "1",
                "transcription": "아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.792,
                "end": 16.922
            },
            {
                "speaker_id": "1",
                "transcription": "이거랑.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.932,
                "end": 19.733
            },
            {
                "speaker_id": "1",
                "transcription": "각 마을에 하나씩 각 나라에 하나씩 있는 거죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.743,
                "end": 33.615
            },
            {
                "speaker_id": "1",
                "transcription": "야 이제부터 크게 진전돼서 돌아올 수 없대요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.626,
                "end": 35.890
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 잠깐 은신처에 가자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.910,
                "end": 40.533
            }
        ]
    },
    "summary": "여자 게임 유튜버는 자신이 가리키는 것이 크리스탈인지와 크리스탈이 각 나라에 하나씩 있는지 물어본 후 게임에서 이제부터 크게 진전돼서 돌아올 수 없다고 하니 잠깐 은신처에 간다고 얘기한다.",
