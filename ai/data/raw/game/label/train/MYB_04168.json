        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 스킬 이펙트가 나오죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.294
            },
            {
                "speaker_id": "1",
                "transcription": "초반에 보면은 아직 출시되지 않은 쿠키도 미리보기로 알 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.304,
                "end": 8.451
            },
            {
                "speaker_id": "1",
                "transcription": "네 홀리베리도 이렇게 나와있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.461,
                "end": 10.494
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.504,
                "end": 11.869
            },
            {
                "speaker_id": "1",
                "transcription": "세인트 릴리 스킬 이펙트 전과 후 비교를 제가 편집으로 알려드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.879,
                "end": 18.393
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 막고 나서 퓨바 자 먼저 골드 치즈부터 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.403,
                "end": 23.646
            },
            {
                "speaker_id": "1",
                "transcription": "골드 치즈 이펙트 자 골드 치즈는 이렇게 날나가는 모습이다 보셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.656,
                "end": 29.904
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 튬을 아이 세인트 릴리 보셨나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.914,
                "end": 32.884
            },
            {
                "speaker_id": "1",
                "transcription": "각각 요렇게 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.894,
                "end": 35.113
            },
            {
                "speaker_id": "1",
                "transcription": "네 세인트 릴리도 확실히 과거랑은 완전히 달라졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.123,
                "end": 38.235
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 신규 고대로 나올 가능성도 좀 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.245,
                "end": 41.504
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 확인이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.514,
                "end": 44.200
            }
        ]
    },
