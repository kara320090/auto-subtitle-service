        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 얘가 넣으면은 좋긴 한데 너무 좀 약간 너무 수비적이라 아 와베를 쓸라면은 용과 타이밍을 계산을 너무 잘해야 되네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 34.090
            },
            {
                "speaker_id": "1",
                "transcription": "내가 볼 때 와베 쓰려면은 용과 이 타이밍 조절 잘 해야 될거 같애.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.100,
                "end": 39.121
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 넣으면은 장점 한방덱은 막아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.131,
                "end": 42.080
            },
            {
                "speaker_id": "1",
                "transcription": "근데 다른 정석덱한테는 뚫려.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.090,
                "end": 44.351
            },
            {
                "speaker_id": "1",
                "transcription": "근데 물론 이 아레나에서는 가려놓으니까 와베인지 모르니까 사람들이 이제 한방덱인지 어떻게 됐는지 모르니까 그렇긴 한데 투힐덱을 보여달라고요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.361,
                "end": 54.860
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그렇하면 딜이 너무 부족해지지 않을까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.870,
                "end": 57.596
            },
            {
                "speaker_id": "1",
                "transcription": "이거 완전 홀베 홀베 믿고 가야 되는데 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.606,
                "end": 63.800
            }
        ]
    },
    "summary": "남성이 와베를 쓰려면 용과 타이밍을 잘 계산해야 된다고 하며 장점은 한방덱은 막으나 다른 정석덱한테는 뚫린다고 한다.",
