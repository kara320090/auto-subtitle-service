                ],
                "start": 14.757,
                "end": 19.376
            },
            {
                "speaker_id": "1",
                "transcription": "제 방어 성공률이 나쁘지 않거든요 지금 보면은 보면 거의 다 연승이었어요.",
                "sound_type": [
