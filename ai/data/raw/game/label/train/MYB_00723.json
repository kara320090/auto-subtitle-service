                ],
                "start": 0.000,
                "end": 1.199
            },
            {
                "speaker_id": "2",
                "transcription": "그래 해파리는 여러분들 안 죽는 게 중요한 거 같아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.209,
                "end": 6.262
            },
            {
                "speaker_id": "2",
                "transcription": "안 죽고 속박을 걸어 주는 게 정말 중요한 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.272,
                "end": 11.405
            },
            {
                "speaker_id": "2",
                "transcription": "잘 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.415,
                "end": 15.271
            },
            {
                "speaker_id": "2",
                "transcription": "여러분들 여기서 여러분들 관전 포인트가 중요한 게 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.281,
                "end": 18.830
            },
            {
                "speaker_id": "2",
                "transcription": "얘 해파리 모드로 됐잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.840,
                "end": 20.895
            },
            {
                "speaker_id": "2",
                "transcription": "여기서 결과 창에서 힐량이 보이지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.905,
                "end": 24.088
            },
            {
                "speaker_id": "2",
                "transcription": "힐러로서의 기능이 거의 없다 보시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.098,
                "end": 26.504
            },
            {
                "speaker_id": "2",
                "transcription": "얘는 피감 최대한 많이 주고 속박을 많이 걸어서 내 딜러가 상대 묶여 있는 상태에서 폭 딜러 가지고 죽일 생각을 해야지 힐러로 빨리 전환시키려고 쓰는 거는 차라리 그렇게 생각할 거면 다른 힐러 넣는 게 맞는 거 같아요.",
                "sound_type": [
