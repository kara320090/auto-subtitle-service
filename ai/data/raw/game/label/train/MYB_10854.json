            {
                "speaker_id": "1",
                "transcription": "장군도 죽었고 아버지도 죽었고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.394,
                "end": 30.402
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 베어러들도 참 순하다.",
