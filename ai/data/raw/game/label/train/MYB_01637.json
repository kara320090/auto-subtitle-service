        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쉽게 뚫리는 상황이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.347
            },
            {
                "speaker_id": "1",
                "transcription": "피의 양 보면서는 실론 나이트 딜이 엄청나죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.357,
                "end": 5.181
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방 거의 풀초리죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.191,
                "end": 8.279
            },
            {
                "speaker_id": "1",
                "transcription": "자 가장 중요한 거는 실론 나이트가 오래 살아남아야 되고 여러분들 스펙이 다 다양하기 때문에 스펙은 어 피감은 여러분들 상황에 맞춰서 따로 다 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.289,
                "end": 22.062
            },
            {
                "speaker_id": "1",
                "transcription": "네 생존 순서에 맞춰서 자 요렇게 실론 나이트가 마무리 에픽 쿠키가 4개가 있고 레전드 쿠키 하나라도 이길 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.072,
                "end": 33.242
            },
            {
                "speaker_id": "1",
                "transcription": "다른 구간 전부 다 그마까지도 지금 실론 나이트 한 방 덱 다 쓰고 있다고 하니까 뭐 짐 파훼법 자체가 나오기 전까지 여러분들이 최대한 누릴 거는 누려라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.252,
                "end": 45.823
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 네 쓰는 게 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.833,
                "end": 49.430
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 나중에 파훼법이 나오기 시작하면은 이제 또 안 먹히기 시작할 거거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.440,
                "end": 56.733
            }
        ]
    },
    "summary": "남성이 실론 나이트의 딜이 엄청나고 오래 살아남아야 하며 파훼법이 나오기 전까지 이렇게 쓰는 것이 좋다고 한다.",
