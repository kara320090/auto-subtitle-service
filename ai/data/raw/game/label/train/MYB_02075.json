            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이것도 이것도 에클레어 한 번더 써 주구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.559
            },
            {
                "speaker_id": "1",
                "transcription": "자 주스 되고 여기도 마찬가지 자 여기도 쿨 8퍼센트로 맞춰주시면은 되구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.569,
                "end": 11.284
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 8퍼센트 아니더라도 7퍼센트 후반대도 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.294,
                "end": 15.340
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 써 주고 밀키웨이까지 자 아몬드이기 때문에 네 이렇게 마지막 스킬 한번 더",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.350,
                "end": 24.252
            },
            {
                "speaker_id": "2",
                "transcription": "야 이 차가 흔들리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.262,
                "end": 26.479
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 끝까지 살아남아서 최종 딜이 4.37 4.4억 정도 나오거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.489,
                "end": 34.438
            },
            {
                "speaker_id": "1",
                "transcription": "제가 돌렸을 때 자 딜 차이가 로얄마가린에서만 1000만에서 2000만 선 정도 난다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.448,
                "end": 40.161
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막으로 최고 점 4.5억 이상 썸네일에 나온 것처럼 최고점으로 나오는 거 마지막으로 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.171,
                "end": 48.662
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 로얄마가린 출시 이후에 여러분들 반드시 키워야 될 쿠키가 됐습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.672,
                "end": 53.815
            },
            {
                "speaker_id": "1",
                "transcription": "기존에 에일리언도넛보다 토핑라이드도 전체적으로 쉬워지고 다음에 토벌 빌드도 좀 더 쉬워지 지긴 했거든요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 53.825,
                "end": 63.504
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 어 선택이 아닌 필수 쿠키로 여러분 키워야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 63.514,
                "end": 68.963
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기 자 이것도 하고 46초 되자마자 밀키 그리고 주스 누르구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 68.973,
                "end": 76.073
            },
            {
                "speaker_id": "1",
                "transcription": "44초 이후에는 뭐 소르베 언제 눌러도 상관 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.083,
                "end": 80.152
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 딜이 좀 더 잘 나올라면은 평타 더 많이 때리고 죽는게 낫기 때문에 40초에 눌러주는 게 더 좋긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.162,
                "end": 88.735
            },
            {
                "speaker_id": "1",
                "transcription": "여기 가고 네 써 주구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.745,
                "end": 94.513
            },
            {
                "speaker_id": "1",
                "transcription": "자 로얄마가린은 쿨 도는대로 바로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 94.523,
                "end": 98.671
            },
            {
                "speaker_id": "1",
                "transcription": "바로 바로 써 주구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.681,
                "end": 100.492
            },
            {
                "speaker_id": "1",
                "transcription": "구래도 이것도 나갈 때",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 100.502,
                "end": 108.300
            }
        ]
    },
