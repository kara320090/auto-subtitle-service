        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 먼저 잘 짜졌네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.057
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 하지만 이긴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.067,
                "end": 8.359
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 이기면 되는데 아 이거 질 것 같다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.369,
                "end": 11.676
            },
            {
                "speaker_id": "1",
                "transcription": "근데 질 것 같다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.686,
                "end": 15.054
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 지는 그림인데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.064,
                "end": 19.535
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 졌네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.545,
                "end": 21.384
            },
            {
                "speaker_id": "1",
                "transcription": "저거는 용과 쿨이 높은 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.394,
                "end": 23.629
            },
            {
                "speaker_id": "1",
                "transcription": "저거는 쿨이 9퍼센트 쿨이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.639,
                "end": 26.258
            },
            {
                "speaker_id": "1",
                "transcription": "쿨을 더 높이는 게 정답인 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.268,
                "end": 28.772
            },
            {
                "speaker_id": "1",
                "transcription": "저도 뭐 이거 제가 8퍼센트로 맞춘 이유는 얘가 9퍼센트로 해 버리면은 30초 전에 써 버려요 브레스를.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.782,
                "end": 38.147
            },
            {
                "speaker_id": "1",
                "transcription": "타이밍이 되게 일찍 써 버려서 얘는 망해 버리고 이 조합에서는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.157,
                "end": 41.864
            },
            {
                "speaker_id": "1",
                "transcription": "근데 반대로 이 조합 같은 경우에는 얘가 9퍼센트가 넘어야지만 미러전에서 유리합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.874,
                "end": 49.217
            },
            {
                "speaker_id": "1",
                "transcription": "네 스냅 드래곤 이용한 2가지 덱도 추천드렸습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.227,
                "end": 54.000
            },
            {
                "speaker_id": "1",
                "transcription": "따라 해 보시면 좋을 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.010,
                "end": 60.200
            }
        ]
    },
    "summary": "남자는 상대와의 게임에서 졌는데 이 조합 같은 경우 쿨이 9퍼센트가 넘어야 미러전에서 유리하다며 쿨을 더 높이는 게 정답인 것 같다고 한다.",
