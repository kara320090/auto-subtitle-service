        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 야 퓨바 왜 이렇게 잘 나와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.831
            },
            {
                "speaker_id": "1",
                "transcription": "자 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.841,
                "end": 2.675
            },
            {
                "speaker_id": "1",
                "transcription": "저는 개인적으로 퓨바보다는 블랙펄을 뽑아드려야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.685,
                "end": 6.523
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 너무 사기이기 때문에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.533,
                "end": 11.975
            },
            {
                "speaker_id": "1",
                "transcription": "바요까지 야 근데 되게 잘 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.985,
                "end": 14.131
            },
            {
                "speaker_id": "1",
                "transcription": "잘 맡겨주셨네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.141,
                "end": 15.314
            },
            {
                "speaker_id": "1",
                "transcription": "잘 나오네요 지금.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.324,
                "end": 21.614
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 야 바요 뭐야 아 5초월 축하드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.624,
                "end": 24.903
            },
            {
                "speaker_id": "1",
                "transcription": "야 바요 5초월까지 제가 손으로 많이 나왔어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.913,
                "end": 29.279
            },
            {
                "speaker_id": "1",
                "transcription": "아 축하드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.289,
                "end": 30.466
            },
            {
                "speaker_id": "1",
                "transcription": "아 지금 약간 타이밍인가 봐 되게 잘 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.476,
                "end": 32.775
            },
            {
                "speaker_id": "1",
                "transcription": "근데 하필이면은 좀 블랙펄 좀 나오지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.785,
                "end": 36.271
            },
            {
                "speaker_id": "1",
                "transcription": "캡틴캐비어 0티어 근데 당장은 무조건 지금 당장 필요하다 이런 느낌은 아닌 거 같아요 일단.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.281,
                "end": 41.597
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 지금 저 블랙펄 레전드 쿠키의 존재감이 너무나 막강해가지고 그게 가려졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.607,
                "end": 47.434
            },
            {
                "speaker_id": "1",
                "transcription": "근데 바요도 뭐 일단은 5성 찍어놓으면은 좋은 이유가 토벌에서도 상당히 스펙 찍어놓으면 좋기 때문에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.444,
                "end": 54.692
            },
            {
                "speaker_id": "1",
                "transcription": "오 3조각 아주 좋습니다 3조각 어디야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.702,
                "end": 57.840
            },
            {
                "speaker_id": "1",
                "transcription": "레전드 고대 하나 더 먹자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.850,
                "end": 62.216
            },
            {
                "speaker_id": "1",
                "transcription": "올 5초월까지 이제 얼마 어우 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.226,
                "end": 65.773
            },
            {
                "speaker_id": "1",
                "transcription": "어우 좋아요 저거 일단 모션 보고 가자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.783,
                "end": 67.891
            },
            {
                "speaker_id": "1",
                "transcription": "이거 최대한 보고 가야 약간 흐름 타가지고 잘 나올 수 있을 거 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.901,
                "end": 73.133
            }
        ]
    },
    "summary": "뽑기에서 타이밍인지 바요가 너무 잘 나와서 바요를 5초월까지 성공시켰고 바요도 토벌에서 좋지만 지금은 워낙 블랙펄 레전드 쿠키가 존재감이 막강해서 가려졌다.",
