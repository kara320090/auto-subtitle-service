        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 1분 40초 기록 단축이 어마무시하게 됐네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.019
            },
            {
                "speaker_id": "1",
                "transcription": "야 1판 했는데 바로 7등 이야 이게 말이 됩니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.029,
                "end": 12.826
            },
            {
                "speaker_id": "1",
                "transcription": "자 1판 더 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.836,
                "end": 14.394
            },
            {
                "speaker_id": "1",
                "transcription": "아니 1판 해봤는데 이런 기록이 나왔다 이거 몇 판 해보면은 더 기록이 좋겠는데 네 한번 더 바로 출발을 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.404,
                "end": 23.724
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 운과 뭐 좀 더 기록이 잘 나오면은 더 좋은 기록도 나올 수 있으니까 좀 몇 판 더 돌려볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.734,
                "end": 31.167
            },
            {
                "speaker_id": "1",
                "transcription": "치명을 더 주는 게 아니라 그냥 치명 터지게 그냥 운이 좋을 때까지 리게임 하는 게 낫지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.177,
                "end": 38.929
            },
            {
                "speaker_id": "1",
                "transcription": "타르트가 이 수호 성전에서 근데 이렇게 기록적인 이유가 내가 볼 때는 여러분들 이게 야 이거 뭐야 되게 많이 걸렸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.939,
                "end": 48.168
            },
            {
                "speaker_id": "1",
                "transcription": "인연 홀 때문에 그런 게 커 내가 볼 때는 인연 버프 끝나면은 이 기록 절대 안 나와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.178,
                "end": 55.000
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 근데 이 조합은 쓰이지 않을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.010,
                "end": 57.184
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 이런 거 보는 거 안 지루하냐구요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.194,
                "end": 59.524
            },
            {
                "speaker_id": "1",
                "transcription": "이런 거 내가 집에서 틀어놓자나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.534,
                "end": 61.798
            },
            {
                "speaker_id": "1",
                "transcription": "나는 이런 거 하면은 집에서 이거 안 보지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.808,
                "end": 64.872
            },
            {
                "speaker_id": "1",
                "transcription": "이거 딱 틀어놓고 화장실 갔다 오거나 아니면 뭐 정수기에 물 뜨러 가거나 아니면 침대에 누워 있거나 핸드폰 들고 유트브 보거나 다 그렇지 않나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.882,
                "end": 77.294
            },
            {
                "speaker_id": "1",
                "transcription": "야 누가 이거 틀어놓고 이거 화면 뚫어지게 이렇게 보고 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.304,
                "end": 80.972
            },
            {
                "speaker_id": "1",
                "transcription": "게임을 보라고 있는 게 아니라 그냥 딴짓하라고 있는 그런 거잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.982,
                "end": 86.052
            },
            {
                "speaker_id": "1",
                "transcription": "맞잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.062,
                "end": 86.790
            },
            {
                "speaker_id": "1",
                "transcription": "누가 이거 게임을 보고 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.800,
                "end": 88.697
            },
            {
                "speaker_id": "1",
                "transcription": "아 이번 판은 좀 아하 자 일단 이렇게 야 이거 조금 기갱 좀 해보고 싶다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.707,
                "end": 98.195
            },
            {
                "speaker_id": "1",
                "transcription": "한번만 더 해보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.205,
                "end": 99.359
            },
            {
                "speaker_id": "1",
                "transcription": "욕심난다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.369,
                "end": 100.327
            },
            {
                "speaker_id": "1",
                "transcription": "어 이거 기갱 가능하나 이거 아 아 기갱 못 했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.337,
                "end": 110.900
            }
        ]
    },
    "summary": "1판 해봤는데 이런 기록이 나오면 몇 판 해보면은 더 기록이 좋게 나올 것 같고 인연 버프 끝나면은 이 기록은 절대 안 나올 것 같다.",
