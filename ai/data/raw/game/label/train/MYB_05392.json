    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 이기는 그림 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.712
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 마찬가지 딜량은 뭐 상관없는데 회복량 자체가 크림 유니콘이 정말 엄청나게 높다는 거 그다음에 또 들어가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.722,
                "end": 15.062
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 2, 2, 1덱이라도 요 덱으로 빡세게 안 해도 네 그래도 셀 수 있다는 게 되게 강점이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.072,
                "end": 22.626
            },
            {
                "speaker_id": "1",
                "transcription": "요새 보면 와일드베리가 방덱에 되게 많이 보이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.636,
                "end": 26.420
            },
            {
                "speaker_id": "1",
                "transcription": "어 되게 와베가 안정적으로 방덱으로 많이 쓰이는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.430,
                "end": 31.172
            },
            {
                "speaker_id": "1",
                "transcription": "아까 제가 소개해 드린 방덱도 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.182,
                "end": 34.695
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 제가 세팅했을 때 토벌 때문에 토핑을 많이 뺐겼음에도 불구하고 승률이 되게 좋게 나왔거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.705,
                "end": 42.185
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 따라 하실 수 있으시면 그것도 방덱으로 써도 좋고 공덱으로도 저도 나쁘지 않게 사용을 했거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.195,
                "end": 50.165
            },
            {
                "speaker_id": "1",
                "transcription": "공덱으로도 써도 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.175,
                "end": 53.590
            },
            {
                "speaker_id": "1",
                "transcription": "타이밍이 정말 이쁘네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.600,
                "end": 55.433
            },
            {
                "speaker_id": "1",
                "transcription": "이게 보면은 되게 안정적으로 돌아간다는 거 크림 유니콘이 기가 막히게 또 힐 타이밍이 들어와서 아주 좋게 사용할 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.443,
                "end": 64.428
            },
            {
                "speaker_id": "1",
                "transcription": "상대방이랑 똑같은 5성이고 똑같은 세팅인데 힐 차이가 여러분 어마무시하게 많이 벌어진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.438,
                "end": 72.021
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음도 다음 덱 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.031,
                "end": 73.973
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음 덱 상대 일단 무지성으로 일단은 다 들어가도 승률이 되게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.983,
                "end": 82.315
            },
            {
                "speaker_id": "1",
                "transcription": "다만 상대가 이제 제가 확실히 파악한 거는 어 서리덱한테 좀 약한 거 같아요. 서리덱",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.325,
                "end": 89.983
            },
            {
                "speaker_id": "1",
                "transcription": "서리덱 방덱이 거의 없어서 어 많이 지지는 않는데 제가 진 거는 그때 졌어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 89.993,
                "end": 98.354
            },
            {
                "speaker_id": "1",
                "transcription": "요거는 야 이거는 좀 치명 터져서 좀 터진 거 같다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 98.364,
                "end": 104.266
            }
        ]
    },
    "summary": "요즘에 와일드베리가 방덱에 많이 보이는데 아까 소개해 드린 방법으로 공덱과 방덱을 모두 세팅해도 좋지만 상대가 서리덱인 경우에는 약할 수 있다.",
