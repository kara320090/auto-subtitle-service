        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "전반적으로 킹덤에 시간 투자가 좀 많이 힘드신 상태인 것 같아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.520
            },
            {
                "speaker_id": "1",
                "transcription": "귀찮더라도 지금 우선순위를 왕국 운영에다가 시간을 더 많이 투자해 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.520,
                "end": 9.530
            },
            {
                "speaker_id": "1",
                "transcription": "알겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.530,
                "end": 10.130
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 어느 정도 게임에 대한 약간 약간 스트레스가 줄어 많이 줄어들거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.130,
                "end": 15.160
            },
            {
                "speaker_id": "1",
                "transcription": "재고 문제 해결 먼저 하시고 그다음에 토핑작 착실히 하다가 이 아레나나 요런 거에 세팅하는 거 조금씩 관심 가져 가지고 세팅하세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.160,
                "end": 24.150
            },
            {
                "speaker_id": "1",
                "transcription": "지금 상태로는 2개 덱은 맞출 수 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.150,
                "end": 27.250
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제 재고 상태나 이런 게 좀 스트레스 많이 받으실 거라 자동 생산 건물 효율이 이거 그냥 직장인분들이나 바쁘신 분들은 이 보유 수량이 적은 생산품 우선 먼저 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.250,
                "end": 37.780
            },
            {
                "speaker_id": "1",
                "transcription": "이것만 딱 눌러 주세요. 그냥",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.780,
                "end": 39.120
            },
            {
                "speaker_id": "1",
                "transcription": "이걸로만 계속 하잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.120,
                "end": 40.680
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 최소한 열차 멈추는 거 최소한 할 수 있긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.680,
                "end": 43.490
            },
            {
                "speaker_id": "1",
                "transcription": "아 돈 주고 생산하는 거요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.490,
                "end": 45.730
            },
            {
                "speaker_id": "1",
                "transcription": "나무는 별로 같고 좀 과금에 여유가 있으면은 저는 각설탕만 할 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.730,
                "end": 50.290
            },
            {
                "speaker_id": "1",
                "transcription": "젤리빈까지는 솔직히 시간 투자 좀만 하면 되고 저라면은 각설탕을 살 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.290,
                "end": 55.670
            },
            {
                "speaker_id": "1",
                "transcription": "네 일단 @이름1 님은 계평 여기서 마칠게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.670,
                "end": 60.420
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 마무리 짓겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.420,
                "end": 66.966
            }
        ]
    },
    "summary": "왕국 운영에만 시간을 투자해 주시면 게임 스트레스가 줄어들 거고 재고 해결이 되면 아레나에 관심을 가지셔서 세팅하시면 되며 돈을 주고 생산을 하고 싶을 때는 각설탕을 추천해 드린다.",
