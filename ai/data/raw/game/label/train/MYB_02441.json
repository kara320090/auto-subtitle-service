        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 밀키웨이 써주시고 그다음에 에클레어까지 자 여기서 중요합니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 5.064
            },
            {
                "speaker_id": "1",
                "transcription": "도넛이 쿨이 이제 다 됐죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.074,
                "end": 6.940
            },
            {
                "speaker_id": "1",
                "transcription": "도넛을 쓰면 안 되고 밀키웨이를 예약을 걸 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.950,
                "end": 11.553
            },
            {
                "speaker_id": "1",
                "transcription": "자 밀키웨이 예약 걸어서 도넛 발동을 멈춰주고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.563,
                "end": 14.397
            },
            {
                "speaker_id": "1",
                "transcription": "도넛은 어제 쓰냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.407,
                "end": 15.686
            },
            {
                "speaker_id": "1",
                "transcription": "28초에 도넛 씁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.696,
                "end": 17.717
            },
            {
                "speaker_id": "1",
                "transcription": "자 28초가 됐을 때 도넛 써주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.727,
                "end": 20.168
            },
            {
                "speaker_id": "1",
                "transcription": "자 주스는 쿨 돌아오는 대로 밀키웨이가 예약되어 있지만 주스는 처음부터 끝까지 쿨 도는 대로 바로바로 써준다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.178,
                "end": 28.085
            },
            {
                "speaker_id": "1",
                "transcription": "주스 바로 써주시고 밀키 써주고 에클레어 한 번 더 발동되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.095,
                "end": 32.702
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기도 중요합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.712,
                "end": 34.111
            },
            {
                "speaker_id": "1",
                "transcription": "자 도넛 쿨이 벌써 또 왔죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.121,
                "end": 36.158
            },
            {
                "speaker_id": "1",
                "transcription": "바로바로 도넛 쓰는 게 아니라 일단은 밀키웨이 예약하고 주스 쿨 도는 대로 바로 먼저 써주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.168,
                "end": 42.734
            },
            {
                "speaker_id": "1",
                "transcription": "자 도넛은 밀키웨이 발동될 때 같이 눌러줄 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.744,
                "end": 46.500
            },
            {
                "speaker_id": "1",
                "transcription": "두 개 같이",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.510,
                "end": 49.300
            }
        ]
    },
