        "term": [
            {
                "speaker_id": "1",
                "transcription": "단계를 높이면 쭉쭉 건설 다 해주시는 걸 목표로 지금은 당장 급한 게 아니니까 아까 말한 랜드마크 우선으로 지어주셔야 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 10.000
            },
            {
                "speaker_id": "1",
                "transcription": "자 연구소 잘 찍었고요 하나 찍고 요고 대장간 중요해서 만렙 찍어야 해요 13단계까지 다 찍고 올라오세요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.010,
                "end": 17.105
            },
            {
                "speaker_id": "1",
                "transcription": "저 끝까지 쭉 올라가야 하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.115,
                "end": 19.055
            },
            {
                "speaker_id": "1",
                "transcription": "이 뒤에 보면 연구 가속이라는 게 있어요 이거 레벨 올릴수록 연구 가속이 돼서 빨리 올릴 수 있는 거거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.065,
                "end": 25.665
            },
            {
                "speaker_id": "1",
                "transcription": "얘까지 찍을 수 있게끔 가급적이면 이 단계 노움 연구소 단계를 끝까지 올라와서 연구 가속 얘네 먼저 만렙을 찍고 추가적으로 찍어야 될 게 대장간 기본 재료 생산 대수 계속 찍어줘야 되고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.675,
                "end": 38.604
            },
            {
                "speaker_id": "1",
                "transcription": "우유 찍어줘야 되고 여기 보면 재료 생산 가속이나 솜사탕 제가 말한 거 우선으로 먼저 찍어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.614,
                "end": 46.358
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 쿠키 연구 같은 경우에도 얘네 하나씩 찍고 다 올라가세요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.368,
                "end": 50.591
            },
            {
                "speaker_id": "1",
                "transcription": "시간이 여유가 되면 얘네 같은 경우에는 연구원들이 시간이 작게 걸리거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.601,
                "end": 55.595
            },
            {
                "speaker_id": "1",
                "transcription": "5씩 다 찍어주시면 돼요 천천히 쿠키 연구보다는 왕국 연구에 올인을 먼저 다 하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.605,
                "end": 61.649
            },
            {
                "speaker_id": "1",
                "transcription": "여기다가 올인한다 하시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.659,
                "end": 63.596
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 연구는 얘를 레벨업 하면 쿠키 그런 체력이나 공급력이나 방어력이 올라가고 끝인데 시간이 지날수록",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.606,
                "end": 72.431
            },
            {
                "speaker_id": "1",
                "transcription": "이득을 보는 연구가 아니에요 일단은 쿠키 스펙이 올라가는 장점이 있지만 왕국 연구는 얘는 시간이 지날수록 차이가 나더라고 격차가 나거든요 그래서 빨리빨리 찍어 주는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.441,
                "end": 84.698
            },
            {
                "speaker_id": "1",
                "transcription": "창고가 147 이분 보면 쿠키 뽑기에 되게 많이 투자 된 게 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.708,
                "end": 90.666
            }
        ]
    },
