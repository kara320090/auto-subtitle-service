        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 블랙펄도 자 잼스톤 리뷰 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.853
            },
            {
                "speaker_id": "1",
                "transcription": "야 17강이 한계네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.863,
                "end": 6.974
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 진짜 자 일단은 초월 효과는 다 받을 수 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.984,
                "end": 10.708
            },
            {
                "speaker_id": "1",
                "transcription": "소용돌이 적으로 모인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.718,
                "end": 13.058
            },
            {
                "speaker_id": "1",
                "transcription": "적이 소용돌이로 모이고요 블펄 체력 증가 타격 횟수 증가 공격력 증가 피해량 증가는 다 받을 수 있고 일단 초월 리더 효과 같은 경우에는 적의 피해 감소 무시가 20퍼센트까지 증가되고 그다음에 공격력 감소 증원은 이제 50개까지 필요가 50개까지 되고 다음에 물 감옥 시간이 2.5초 해로운 효과 감소 20퍼센트 무시 물 감옥 피해는 2.5초마다 이렇게 피해가 추가가 되고 증오도 이렇게 획득되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.068,
                "end": 42.867
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 맹렬한 증오라고 해서 아군 쿠키 사망 시 증오 획득량이 1개가 증가된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.877,
                "end": 47.746
            },
            {
                "speaker_id": "1",
                "transcription": "5개까지 증축되고",
