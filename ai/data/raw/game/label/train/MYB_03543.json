        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 무슨 케이크 타워 조각도 주네 참 별의별 것 다 주는구만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.750
            },
            {
                "speaker_id": "1",
                "transcription": "아 포춘쿠키 나오는 거 나중에 한 번에 보자고요 오케이 알겠습니다 이거 나중에 한번에 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.750,
                "end": 13.598
            },
            {
                "speaker_id": "1",
                "transcription": "아 다음으로 넘어갑시다 자 5단계 진입 야 야 야 이거 완전 운인데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.608,
                "end": 21.316
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 완전 핵운이에요 바로 넘어 갔어 거의.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.326,
                "end": 26.511
            },
            {
                "speaker_id": "1",
                "transcription": "야 나 뭐야 핵운이야 벌써 또 또 넘어갔어.",
