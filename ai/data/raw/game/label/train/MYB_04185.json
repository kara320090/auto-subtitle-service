        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 대난투 관련 조합 추천입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.693
            },
            {
                "speaker_id": "1",
                "transcription": "1번덱 2번덱 3번덱 여러분들 세팅 가능하신 분은 어 최대한 따라해 보시고 없는 쿠키가 있다면은 여러분들 사양에 맞게 대체 쿠키 넣어서 해보시는 수밖에 없을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.703,
                "end": 13.743
            },
            {
                "speaker_id": "1",
                "transcription": "보물 같은 경우에 1번덱은 증표, 시계, 무공비 어 자구마 아몬드 그다음에 휘낭시에 아몬드 대난투는 부옵션이 달리지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.753,
                "end": 22.952
            },
            {
                "speaker_id": "1",
                "transcription": "12강 토핑 종류만 맞혀주시면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.962,
                "end": 25.136
            },
            {
                "speaker_id": "1",
                "transcription": "흑당맛 쿠키는 아몬드 블랙펄은 3 라즈 2 아몬드 비티에스 쿠키는 올 쿨입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.146,
                "end": 31.939
            },
            {
                "speaker_id": "1",
                "transcription": "자 두 번째 덱 같은 경우에는 아몬드 그다음에 아몬드 캡틴캐비어 라즈 라즈 뱀파도 라즈 자 마지막 아몬드 그다음에 다크 아몬드 웨어 아몬드 그다음에 에스프레소 라즈 아 오징어먹물 라즈입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.949,
                "end": 46.913
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 상성 관계나 이런 거 어떻게 되냐고 물어보시는데 일단 전체적으로 설명드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.923,
                "end": 51.975
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에가 있는 덱은 보통 어떤 덱이 들어가냐면 상대가 이렇게 앞에 보이는 게 다크카카오랑 찰스가 있다 그러면은 휘낭시에로 맞춰주시고 상대가 휘낭시에가 보이면은 이 와베가 들어간 요 덱으로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.985,
                "end": 65.957
            },
            {
                "speaker_id": "1",
                "transcription": "고렇게 저는 세팅해서 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.967,
                "end": 67.548
            },
            {
                "speaker_id": "1",
                "transcription": "아 그리고 이 덱은 언제 들어가냐 아 다크랑 크런치초코칩 있으면 어 요 덱으로 맞춰서 들어가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.558,
                "end": 74.255
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 덱엔 요걸로 들어간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.265,
                "end": 77.800
            }
        ]
    },
    "summary": "휘낭시에가 있는 덱은 다크카카오랑 찰스가 있으면 휘낭시에로 맞추고 상대가 휘낭시에가 보이면 와베가 들어간 덱으로 간다.",
