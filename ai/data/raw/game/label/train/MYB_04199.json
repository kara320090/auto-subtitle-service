    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "가자 캡캐",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.962
            },
            {
                "speaker_id": "1",
                "transcription": "야 봐 봤어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.972,
                "end": 7.660
            },
            {
                "speaker_id": "1",
                "transcription": "이게 그래서 선택이 중요해 내가 잘 깨던 상태에서 갑자기 막히잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.670,
                "end": 12.450
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때는 그냥 덱 상태를 완전히 좀 바꿔줘도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.460,
                "end": 17.398
            },
            {
                "speaker_id": "1",
                "transcription": "마탕 쿠키 뭐 먼저 키워야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.408,
                "end": 18.988
            },
            {
                "speaker_id": "1",
                "transcription": "현재로서는 옛날엔 뱀파가 0 0순위였었는데 웨어울프 10강, 호밀 10강, 오먹은 1강 이상 요게 일단 필수 0 순위예요 현재로서는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.998,
                "end": 29.512
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 캡틴 캐비어 너무 좋지 않아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.522,
                "end": 31.526
            },
            {
                "speaker_id": "1",
                "transcription": "아니 난 그냥 캡틴 캐비어가 절대적인 0 티어야 초보자분들한테",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.536,
                "end": 36.358
            },
            {
                "speaker_id": "1",
                "transcription": "이거 써 본 사람만 알지 바다 요정 없으면 여기에다 에클레어 넣으면 딱이에요 그냥",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.368,
                "end": 40.587
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 게임 중에 뭐가 제일 재밌으신가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.597,
                "end": 43.583
            },
            {
                "speaker_id": "1",
                "transcription": "어 오븐 브레이크랑 킹덤 중에 뭐가 재밌냐 이 말씀이시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.593,
                "end": 48.633
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 오븐 브레이크 컨텐츠가 더 재밌다고 했는데 어 오븐 브레이크는 현재 진짜 운영 이슈 때문에 진짜 이런 말 하기 그런데 온갖 정이 다 떨어졌어요 정 떨어졌어요 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.643,
                "end": 61.346
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤으로 좀 비유를 해볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.356,
                "end": 63.311
            },
            {
                "speaker_id": "1",
                "transcription": "패치를 어떻게 했냐면 지금 얘 하나 얻는데 1시간 30분인데 애를 24시간으로 바꾼 거라 보시면 될 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.321,
                "end": 70.265
            },
            {
                "speaker_id": "1",
                "transcription": "1강 올리는데 1주일 최소 1강 올리는데 아 24시간까지는 너무 심하고 한 12시간",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.275,
                "end": 77.752
            },
            {
                "speaker_id": "1",
                "transcription": "이제 앞으로 근데 데브는 그 얘기는 절대 못 하지 그 당당하게 거기 방송에서 그랬거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.762,
                "end": 85.251
            },
            {
                "speaker_id": "1",
                "transcription": "약간 소과금, 무과금러분들을 위해서 과금러분들이나 고인물분들이 약간 이해를 해줘야 된다는 명분으로 약간 그런 패치를 했거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.261,
                "end": 93.715
            },
            {
                "speaker_id": "1",
                "transcription": "이제 그런 소리 못 하지 그게 다 거짓말인 게 드러났으니까",
                "sound_type": [
                    2
                ],
                "start": 93.725,
                "end": 97.626
            },
            {
                "speaker_id": "1",
                "transcription": "마법 사탕을 만들기 힘들게 만들어서 무과금러분들이 막 마탕을 파밍 열심히 해서 4, 5일 만에 만렙 찍는 걸 방지하기 위해서 그렇게 시간을 만들었고 과금 유도를 더 하기 위한 패치를 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.636,
                "end": 110.315
            },
            {
                "speaker_id": "1",
                "transcription": "용안이랑 스킨 뽑는데 50만 원 가까이 썼는데 아깝다고요 많이 쓰셨네 50만 원",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.325,
                "end": 116.845
            },
            {
                "speaker_id": "1",
                "transcription": "골드 치즈가 먼저 나올까요 세인트 릴리가 먼저 나올까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 116.855,
                "end": 120.151
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 어 세인트 릴리가 더 먼저 나올 것 같은데 저렇게 스킬 이펙트 먼저 바뀌면은 그 쿠키가 여태까지 다 나왔거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 120.161,
                "end": 128.982
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들어 다크 카카오를 예시로 들면은 어느 날 러너님 다크 카카오 스킬 이펙트 바뀌었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 128.992,
                "end": 135.289
            },
            {
                "speaker_id": "1",
                "transcription": "이 얘기 나와서 어그로 엄청 끌렸거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 135.299,
                "end": 137.528
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 나서 진짜 다크 카카오가 출시 됐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 137.538,
                "end": 140.442
            },
            {
                "speaker_id": "1",
                "transcription": "또 이번에도 만약에 지금 현 상황에서 세인트 릴리가 저렇게 됐다는 건 신규 고대 쿠키로 나올 가능성이 있다는 소리죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 140.452,
                "end": 150.349
            },
            {
                "speaker_id": "1",
                "transcription": "아 스토리에서 에스프레소 괜찮은데 좀 진짜 엄청 좋게 느껴질라면 마법 사탕 달아야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 150.359,
                "end": 158.013
            },
            {
                "speaker_id": "1",
                "transcription": "유출좌가 예전에 다음 뽑기 결정이 사죄의 빛이라고 한 적이 있어요 사죄의 빛",
                "sound_type": [
                    2,
                    3
                ],
                "start": 158.023,
                "end": 164.115
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들 중요한 게 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 164.125,
                "end": 165.500
            },
            {
                "speaker_id": "1",
                "transcription": "고대 쿠키가 나오면은 신규 에피소드가 열립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 165.510,
                "end": 169.525
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 이제 스토리도 새롭게 나오고 홀리베리때 랜드 마크가 나왔었거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 169.535,
                "end": 175.984
            },
            {
                "speaker_id": "1",
                "transcription": "오로라 재료 생성하는 랜드 마크 나왔잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 175.994,
                "end": 178.479
            },
            {
                "speaker_id": "1",
                "transcription": "세인트 릴리 나오면은 랜드 마크가 뭐 나올라나 여러분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 178.489,
                "end": 182.646
            },
            {
                "speaker_id": "1",
                "transcription": "아 같이 계정 키우는 분들 저랑 차이 많이 나나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 182.656,
                "end": 187.828
            },
            {
                "speaker_id": "1",
                "transcription": "이제 점점 많이 많이 따라 잡혔죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 187.838,
                "end": 190.647
            },
            {
                "speaker_id": "1",
                "transcription": "저도 하루에 1시간밖에 거의 투자 안 하긴 하는 데 야금야금 따라가고 있을 걸 여러분들하고 스펙 차이가",
                "sound_type": [
                    2,
                    3
                ],
                "start": 190.657,
                "end": 199.443
            },
            {
                "speaker_id": "1",
                "transcription": "딸크 이상한 요란한 기술 쓰거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 199.453,
                "end": 202.645
            },
            {
                "speaker_id": "1",
                "transcription": "야 스킬 끊김 장난 아니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 202.655,
                "end": 207.752
            },
            {
                "speaker_id": "1",
                "transcription": "야 스킬 끊김 때문에 딸크가 스킬을 못 쓰고 있어요 바보가 됐어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 207.762,
                "end": 213.125
            },
            {
                "speaker_id": "1",
                "transcription": "와 이걸 이렇게 쉽게 깨다니 자 일단 요렇게 클리어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 213.135,
                "end": 218.302
            },
            {
                "speaker_id": "1",
                "transcription": "아 설마 크탈 만개 떠라 제발",
                "sound_type": [
                    2,
                    3
                ],
                "start": 218.312,
                "end": 221.266
            }
        ]
    },
    "summary": "마탕 쿠키는 웨어울프 10강, 호밀 10강, 오징어 먹물은 1강 이상부터 키우는 게 좋고 캡틴 캐비어는 초보자들에게 너무 좋은 아이템입니다.",
