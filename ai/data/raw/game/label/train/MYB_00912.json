        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "1강 또는 10강까지 먼저 찍어주시거나 30강까지 찍어주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.279
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 수호성전, 아레나, 토벌 모든 덱에서 다 쓰이기 때문에 반드시 얘를 먼저 찍어주시고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.289,
                "end": 11.808
            },
            {
                "speaker_id": "1",
                "transcription": "그다음은 슈크림 얘는 스토리 그리고 수호성전 이런 데서 많이 활용되기 때문에 10강 그다음에 망고맛 쿠키는 이제 사해권이나 아니면 여유가 있는 분들 찍어주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.818,
                "end": 22.749
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 집중적으로 하시는 분들은 실론나이트 10강 이상이라도 먼저 찍어주시면 한방덱 또는 네 정석덱에서도 그래도 활용 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.759,
                "end": 30.543
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페도 락스타랑 스냅 드래곤이 있는 분들도 10강 이상 찍어주시면 아레나에서 활용 가능하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.553,
                "end": 37.054
            },
            {
                "speaker_id": "1",
                "transcription": "자 화면에 보이는 것처럼 도넛 , 캡틴, 오먹 이런 한방덱류는 감초 토벌전과도 겹치는 쿠키들이기 때문에 같이 키워주면은 상당히 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.064,
                "end": 46.255
            },
            {
                "speaker_id": "1",
                "transcription": "자 결론만 말씀드리면 현재 여러분들이 반드시 키워야 되는 쿠키들 딱 집어서 말씀해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.265,
                "end": 52.335
            },
            {
                "speaker_id": "1",
                "transcription": "자 전방에는 홀리베리 딜러에는 용과, 블랙펄, 스타더스트 자 후방에는 스냅 드래곤 자 그리고 2힐러에는 스타더스트 제가 집어드린 거 위주로 집중적으로 키우면 절대 손해는 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.335,
                "end": 65.562
            },
            {
                "speaker_id": "1",
                "transcription": "더 여유가 있을 때 키우면 좋은 거를 추가적으로 말씀드리면 달빛술사, 소르베, 실론나이트, 파르페, 샤이닝글리터 정도가 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.562,
                "end": 75.334
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정도 키우면은 좋지만 아직 활용이 뚜렷하게 나오진 않고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.344,
                "end": 80.721
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 오늘은 네 확실하게 키워서 손해 안 보고 좋을 거 같은 거 위주로 정리를 했고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.731,
                "end": 86.407
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트는 8월 30일날 이루어 질 거 같아서 업데이트 이후에도 큰 변화가 일여나면 또 한 번 정리해 보도록 하겠습니다 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.417,
                "end": 97.200
            }
        ]
    },
    "summary": "반드시 키워야 될 쿠키로는 전방에는 홀리베리 딜러에는 용과, 블랙펄, 스타더스트 후방에는 스냅 드래곤 그리고 2힐러에는 스타더스트 이렇게 집중적으로 키우면 절대 손해는 없다.",
