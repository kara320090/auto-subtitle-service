                ],
                "start": 0.000,
                "end": 10.066
            },
            {
                "speaker_id": "1",
                "transcription": "스토리용으로는 사용하는 거는 뭐 무난하게 좋을 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.076,
                "end": 13.630
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 광역 딜에다가 딜 추가 딜 더 주는 거라 문제시 아레나에서 좋냐가 관건이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.640,
                "end": 19.423
            },
            {
                "speaker_id": "1",
                "transcription": "그 바요 대체로 써보자 일단 여러분들 네 올 쿨로해서 바요 대체로 써볼게요.",
                "sound_type": [
                    2,
