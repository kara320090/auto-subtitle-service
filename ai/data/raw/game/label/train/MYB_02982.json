        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 3개나 건졌어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.679
            },
            {
                "speaker_id": "1",
                "transcription": "아 이것도 건지나 싶었는데 야 이거 여러분들 아주 좋죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.694,
                "end": 6.173
            },
            {
                "speaker_id": "1",
                "transcription": "이 정도면은 정말 환상적으로 떴다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.166,
                "end": 9.280
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 여기에 피가 붙으면 얼마나 와 야 종결이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.290,
                "end": 13.853
            },
            {
                "speaker_id": "1",
                "transcription": "이거 진짜 종결이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.866,
                "end": 15.613
            },
            {
                "speaker_id": "1",
                "transcription": "와 야 잠깐만 나 대박 났네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.680,
                "end": 17.593
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 왜 이래 나 진짜 엄청 잘 나오네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.603,
                "end": 21.200
            }
        ]
    },
    "summary": "영상에서는 3개를 건져 이 정도면 환상적이라고 했고 피가 붙어 종결이 됐다면서 엄청 잘 나와서 대박이라고 말한다.",
