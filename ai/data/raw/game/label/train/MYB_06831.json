                    2
                ],
                "start": 0.000,
                "end": 2.796
            },
            {
                "speaker_id": "1",
                "transcription": "여기 어 방구석 인디 게임실에 가서 찜도 눌러 하트도 눌러줘야지.",
                "sound_type": [
