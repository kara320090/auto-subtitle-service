            },
            {
                "speaker_id": "1",
                "transcription": "갑자기 그거 생각난다.",
                "sound_type": [
                    2
                ],
                "start": 13.206,
                "end": 14.481
            },
            {
                "speaker_id": "1",
                "transcription": "나 그때 화이트데이 한다고 무서울까 봐 막 북북춤 노인 스킨이랑 비키니 다 사놓고 귀신 나와서 울고 껐잖아.",
                "sound_type": [
                    2
                ],
                "start": 14.491,
