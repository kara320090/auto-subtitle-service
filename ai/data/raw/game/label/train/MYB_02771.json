        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 이거 후반부까지 가죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.806
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 덱의 안정성이 되게 중요한 게 빙결덱입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.816,
                "end": 7.768
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 여러분들이 이제 궁금한 거는 횃불 보물을 빙결덱으로 써가지고 더 좋게 쓰일 수 있지 않을까라고 생각할 수 있는데 자 바꿔서 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.778,
                "end": 16.948
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 기억해야 될 거는 딱 하나예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.958,
                "end": 19.586
            },
            {
                "speaker_id": "1",
                "transcription": "빙결덱은 죽지 않고 버티면서 상대 딜러를 끊어주는 게 중요하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.596,
                "end": 23.843
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 딜을 좀 더 넣어가지고 어떻게는 상대 딜러를 빨리 죽여야 되는 게 목적이 절대 아니고 얘는",
                "sound_type": [
