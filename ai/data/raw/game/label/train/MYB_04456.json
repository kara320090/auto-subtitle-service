        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 웨어울프 쿠키가 엄청난 상향을 하기 전에 한번 더 빨리 상향 전에 리뷰를 한번 해보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.002
            },
            {
                "speaker_id": "1",
                "transcription": "네 5초월로 바로 다 되고 자 전투력을 보면 되게 낮지만 네 아몬드로 일단 세팅을 해 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.012,
                "end": 14.444
            },
            {
                "speaker_id": "1",
                "transcription": "일단 얘는 쿨타임이 11초거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.454,
                "end": 16.446
            },
            {
                "speaker_id": "1",
                "transcription": "11초로 보면은 2퍼센트 이상 주면은 일반 쿨타임이 8초가 되네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.456,
                "end": 20.965
            },
            {
                "speaker_id": "1",
                "transcription": "지금 뭐 쿨타임이 상관이 없을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.975,
                "end": 23.714
            },
            {
                "speaker_id": "1",
                "transcription": "시작 쿨타임 바꾸려며 너무 많이 가기 때문에 그냥 뭐 편하게 세팅하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.724,
                "end": 28.547
            },
            {
                "speaker_id": "1",
                "transcription": "자 스토리에서 가볍게 얼마나 안 좋은 건지 지금은 진짜 아무도 안 쓰거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.557,
                "end": 34.777
            },
            {
                "speaker_id": "1",
                "transcription": "자 요걸로 가 볼게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.787,
                "end": 36.748
            },
            {
                "speaker_id": "1",
                "transcription": "과연 웨어울프는 얼마나 좀 안 좋을 까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.758,
                "end": 39.383
            },
            {
                "speaker_id": "1",
                "transcription": "자 웨어 울프 아몬드로 때리면 그냥 하루 종일 걸리거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.393,
                "end": 43.041
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 그냥 라즈베리로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.051,
                "end": 45.615
            },
            {
                "speaker_id": "1",
                "transcription": "자 라즈베리 세팅을 하면은 전투력은 24만이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.625,
                "end": 49.024
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.034,
                "end": 50.228
            },
            {
                "speaker_id": "1",
                "transcription": "자 상향 전에 웨어울프는 얼마나 안 좋은 것인가 출발",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.238,
                "end": 57.566
            }
        ]
    },
    "summary": "화자가 상향 전에 웨어울프는 얼마나 좋지 않은 것에 대해서 이야기하고 있다.",
