                ],
                "start": 0.000,
                "end": 4.087
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 레벨은 5레벨도 괜찮아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.097,
                "end": 6.847
            },
            {
                "speaker_id": "1",
                "transcription": "얘를 일단 12성까지 찍는 게 중요합니다.",
