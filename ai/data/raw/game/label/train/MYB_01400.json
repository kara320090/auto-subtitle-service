        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "천명을 따르라.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.326
            },
            {
                "speaker_id": "2",
                "transcription": "자 앞에 탱커가 원래 없어져야 되는데 단단하게 다 버텨 버립니다.",
                "sound_type": [
                    2
                ],
                "start": 1.336,
                "end": 7.271
            },
            {
                "speaker_id": "2",
                "transcription": "한방덱이 무용지물이 돼 버려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.281,
                "end": 13.289
            },
            {
                "speaker_id": "3",
                "transcription": "분노를 느껴봐라.",
                "sound_type": [
                    2
                ],
                "start": 13.299,
                "end": 14.402
            },
            {
                "speaker_id": "4",
                "transcription": "신들의 목소리를 담아 내가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.412,
                "end": 16.934
            },
            {
                "speaker_id": "2",
                "transcription": "이런 식으로 한방덱이 아무짝에도 쓸모 없어져 버린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.944,
                "end": 23.700
            },
            {
                "speaker_id": "2",
                "transcription": "이런 상황이 나오다 보니 무공비급이 사용되지 않는 정말 특이한 현상이 나오고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.710,
                "end": 30.454
            },
            {
                "speaker_id": "2",
                "transcription": "자 뭐 일부 유저는 이렇게 쓰고 있습니다. 하지만 다른 데 보면은 다 보면은 레어 무공비급으로 다 도배를 해 놓고 있습니다. 자 그러면은 이 레어 무공비급 됐을 때 예를 어떻게 뚫냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.464,
                "end": 44.588
            },
            {
                "speaker_id": "2",
                "transcription": "대부분 이렇게 형식으로 되어 있는 덱들은 안에 소르베를 품고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.598,
                "end": 48.756
            },
            {
                "speaker_id": "2",
                "transcription": "제가 그래서 이번 영상에서는 예를 뚫는 조합까지 소개를 해 드리려고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.766,
                "end": 53.740
            },
            {
                "speaker_id": "2",
                "transcription": "자 허브맛 쿠키를 쓰는 조합도 있지만 아 소르베를 상대가 품고 있기 때문에 그거 안 쓰고도 저는 모노클을 쓰는 덱으로 알려드릴 거고 그리고 허브맛 쿠키로 뭐 여유가 되면 키우면 좋지만 현재 스킬 파우더가 퓨어 바닐라, 락스타도 무조건 키워야 되는 쿠키들이라 아마 부족한 분들도 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.750,
                "end": 72.949
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 여러분들 세팅할 때 모노클, 깃털, 시계 이렇게 하시고 실논나이트 같은 경우에는 쿨 최대한 여러분들 가능한 높게, 피감 높게 홀리베리 같은 경우에는 쿨, 피감이랑 쿨.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.959,
                "end": 83.939
            },
            {
                "speaker_id": "2",
                "transcription": "그다음에 락스타는 22.3 퍼센트 이상 그다음에 소르베는 얘는 쿨은 높으면 높을수록 그냥 좋은데 가급적이면 권장은 최소 그래도 23 퍼센트 이상 권장입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.949,
                "end": 94.984
            },
            {
                "speaker_id": "2",
                "transcription": "피감은 가능한 높게 그다음에 스냅도 가능한 쿨 높게 요렇게 해서 요 조합으로 레어 무공비급 아 조합들 들어가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 94.994,
                "end": 106.333
            }
        ]
    },
    "summary": "소르베를 품고 있는 덱을 뚫기 위해 모노클, 깃털, 시계를 장착하고 실논나이트, 홀리베리, 락스타, 스냅 쿠키를 어떻게 세팅하는지 알려준다.",
