        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러면 락스타가 스킬 발동 안 하고 푸룬주스 예약을 해서 얘는 스킬 지연이 일어나고 있죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.998
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 중요합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.008,
                "end": 6.580
            },
            {
                "speaker_id": "1",
                "transcription": "에클리어가 이제 스킬을 쓰고 나서 요 11자가 보이죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.590,
                "end": 10.359
            },
            {
                "speaker_id": "1",
                "transcription": "이 11자가 보일 때 락스타를 눌러줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.369,
                "end": 13.157
            },
            {
                "speaker_id": "1",
                "transcription": "11자가 보일 때 락스타 눌러줘서 자 피가 깎이자마자 바로 체력이 차져.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.167,
                "end": 19.098
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 하는 이유는 에클리어가 피가 깎이자마자 힐을 채워 가지고 내가 좀 더 생존을 더 오래 하기 위해서 그리고 푸룬주스도 피가 깎이자마자 락스타 힐을 받아서 좀 더 체력이 바로바로 차서 낮은 피해 감소라도 좀 더 잘 버티기 위해서 이렇게 타이밍을 맞춘 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.108,
                "end": 35.894
            },
            {
                "speaker_id": "1",
                "transcription": "자 보면 체력이 꽉 찼죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.904,
                "end": 38.641
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 풀피 상태에서 브레스를 막기 위해서 요렇게 락스타 타이밍을 정한 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.651,
                "end": 43.653
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 살아남고요.",
                "sound_type": [
                    2
                ],
                "start": 43.663,
                "end": 47.500
            }
        ]
    },
