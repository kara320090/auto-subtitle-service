    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 서리여왕 그리고 소르베 쿠키를 이용한 정말 무상성 거의 승률 100퍼센트 덱이거든요 현 시점에서는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.195
            },
            {
                "speaker_id": "1",
                "transcription": "거의 지금 30등 안에 있는 분 전부 다 이 덱으로 다 잡히는 상황이라 여러분들이 나중에 키워서 세팅하면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.205,
                "end": 14.525
            },
            {
                "speaker_id": "1",
                "transcription": "일단 보물은 망토 보물 무공비 시계고 세팅을 보여드리면 좀 약간 토핑 난이도가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.535,
                "end": 20.504
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 대충 어떻게 여러분들에 맞춰서 해도 괜찮을 거 같거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.514,
                "end": 24.180
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 자체는 찰스부터가 좀 쿨입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.190,
                "end": 27.870
            },
            {
                "speaker_id": "1",
                "transcription": "보통은 아몬드 쓰는데 올 쿨로 해서 쿨타임 거의 19퍼센트대 맞춰 주시면 될 것 같고 공속 망토 받고 최대한 맞춰 주면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.880,
                "end": 35.732
            },
            {
                "speaker_id": "1",
                "transcription": "근데 굳이 안 맞춰 줘도 올 쿨만 해도 공속 망토만 받게 해도 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.742,
                "end": 41.293
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 소르베 같은 경우에는 올 쿨.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.303,
                "end": 42.976
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임은 이게 세팅이 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.986,
                "end": 45.322
            },
            {
                "speaker_id": "1",
                "transcription": "소르베는 27.4퍼센트 맞춰주면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.332,
                "end": 49.584
            },
            {
                "speaker_id": "1",
                "transcription": "빨리빨리 쿨 돌게끔.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.594,
                "end": 50.842
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게든 맞춰 주시면 좋을 것 같고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.852,
                "end": 52.977
            },
            {
                "speaker_id": "1",
                "transcription": "서리여왕 같은 경우에는 세트 효과 포함해서 25.2.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.987,
                "end": 55.968
            },
            {
                "speaker_id": "1",
                "transcription": "25.2 이상 맞춰주시면 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.978,
                "end": 58.638
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 블랙펄 같은 경우에는 쿨 8퍼센트 이상 공속 망토 받게끔.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.648,
                "end": 63.018
            },
            {
                "speaker_id": "1",
                "transcription": "올 애플젤리 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.028,
                "end": 64.360
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 애플젤리가 힘들면 올 라즈로 하셔야 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.370,
                "end": 68.148
            },
            {
                "speaker_id": "1",
                "transcription": "애플젤리 하는 게 더 딜이 좋기 때문에 이렇게 세팅하고 크림 유니콘은 쿨 2개 그 다음에 애플젤리 섞어서 쿨타임 15퍼센트 이상 이렇게 세팅을 해주시면 되고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.158,
                "end": 77.759
            },
            {
                "speaker_id": "1",
                "transcription": "아마 여러분들 세팅하기가 난이도가 힘들 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.769,
                "end": 80.254
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 피감 조금 낮춰도 내가 볼 때는 괜찮을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.264,
                "end": 82.894
            },
            {
                "speaker_id": "1",
                "transcription": "왜나면 정신 없이 상대를 얼리고 하기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.904,
                "end": 87.033
            }
        ]
    },
    "summary": "지금 30등 안에 있는 분 전부 다 이 덱으로 다 잡히는 상황이라 여러분들이 나중에 키워서 세팅하면 좋을 것 같다.",
