        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "일곱 난쟁이 그런 느낌이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.644
            },
            {
                "speaker_id": "1",
                "transcription": "가면이 다 다르게 생겼네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.654,
                "end": 3.557
            },
            {
                "speaker_id": "2",
                "transcription": "우리가 잘못했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.567,
                "end": 4.818
            },
            {
                "speaker_id": "2",
                "transcription": "널 팔 생각을 하다니 우리의 실수였다고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.828,
                "end": 7.323
            },
            {
                "speaker_id": "3",
                "transcription": "돌아와 줘 이번에는 잘 놀아줄게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.333,
                "end": 9.503
            },
            {
                "speaker_id": "3",
                "transcription": "잘 씻겨줄게 잘 먹여줄게 잘 먹어줄게.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.513,
                "end": 12.872
            },
            {
                "speaker_id": "4",
                "transcription": "다른 녀석들은 너의 맛과 비교가 안 돼.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.882,
                "end": 16.423
            },
            {
                "speaker_id": "5",
                "transcription": "네 골의 맛은 언제나 최고였어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.433,
                "end": 18.607
            },
            {
                "speaker_id": "5",
                "transcription": "뇌를 파 먹힐 때 너의 표정은 언제나 아름다웠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.617,
                "end": 21.335
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 징 징그럽다 좀 너무 역한데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.345,
                "end": 23.690
            },
            {
                "speaker_id": "6",
                "transcription": "그러니까 크리스티나",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.700,
                "end": 25.494
            },
            {
                "speaker_id": "7",
                "transcription": "우리에게로 돌아와라 지금 당장",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.504,
                "end": 27.649
            },
            {
                "speaker_id": "2",
                "transcription": "성대한 식사를 시작해보자꾸나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.659,
                "end": 30.779
            },
            {
                "speaker_id": "8",
                "transcription": "정말 놀라우리만치 화가 나지 않는 걸.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.789,
                "end": 34.126
            },
            {
                "speaker_id": "9",
                "transcription": "돈 받는 입장이라 전에 차마 말을 못한 건데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.136,
                "end": 37.007
            },
            {
                "speaker_id": "9",
                "transcription": "정 너희 정말 역겨워.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.017,
                "end": 39.458
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래서 이런 걸 내린 거구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.468,
                "end": 42.627
            },
            {
                "speaker_id": "1",
                "transcription": "징그럽다 진짜 토할 것 같지 않아요 여러분?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.637,
                "end": 47.096
            },
            {
                "speaker_id": "1",
                "transcription": "약간 표현일 뿐인데 되게 잘 만들었다는 반증인 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.106,
                "end": 51.000
            }
        ]
    },
    "summary": "가면이 다 다르게 생겼고 일곱 난쟁이 느낌이라고 하고 난쟁이 캐릭터들이 크리스티나에게 돌아오라고 합니다.",
