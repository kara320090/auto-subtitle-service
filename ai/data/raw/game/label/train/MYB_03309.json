        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 여러분들 아마 화면 보시면은 쫄들이 저 마지막에 다 죽었거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.375
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 토핑 조절을 해야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.717,
                "end": 5.947
            },
            {
                "speaker_id": "1",
                "transcription": "조정을 어떻게 하냐면은 쫄들이 막 마지막에 다 몰살돼서 없는 경우가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.070,
                "end": 10.212
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 웨어울프 치명타 확률이랑 공격력을 낮추거나 오징어 먹물의 공격력을 좀 낮춰야 되는 경우가 있어요 이거는 일반적으로 다른 분들한테 해당되는 경우는 아닌 데 상위권 길드 같은 경우에는 제가 말씀드린 세팅에서 공격력 치명타 확률 같은 경우에는 쫄들이 몰살돼서 죽냐 안 죽냐 그걸 보고 여러분들이 따로 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.480,
                "end": 33.500
            }
        ]
    },
    "summary": "쫄들이 마지막에 다 몰살돼서 없는 경우에는 토핑 조절을 해야 하는데 웨어울프 치명타 확률이랑 공격력을 낮추거나 오징어 먹물의 공격력을 좀 낮춰야 되는 경우가 일반적이며 상위권 길드 같은 경우에는 세팅에서 공격력, 치명타 확률을 쫄들이 몰살돼서 죽냐 안 죽냐를 보고 따로 맞춰줘야 된다.",
