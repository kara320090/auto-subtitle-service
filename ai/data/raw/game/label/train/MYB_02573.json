                    2,
                    5
                ],
                "start": 1.721,
                "end": 3.285
            },
            {
                "speaker_id": "2",
                "transcription": "오케이 뭐 요런 식으로 클리어",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.295,
                "end": 6.080
            },
            {
                "speaker_id": "2",
                "transcription": "프룬주스는 아레나에서 쓸 때는 아몬드 써야 될 것 같아요. 아몬드 아니면은 다 터지기 때문에",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.090,
                "end": 12.643
            },
            {
                "speaker_id": "2",
                "transcription": "자 일단 요런 식으로",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.653,
                "end": 14.201
            },
            {
                "speaker_id": "2",
                "transcription": "야 뭐야 같은 팀이었어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.211,
                "end": 15.736
            },
            {
                "speaker_id": "2",
                "transcription": "방금 보신 거와 같이 깃발 안 줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.746,
                "end": 18.357
            },
            {
                "speaker_id": "2",
                "transcription": "그마1이라 안 보이는듯 그마 1은 안 보여요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 18.367,
                "end": 20.800
            },
            {
                "speaker_id": "2",
                "transcription": "아",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.810,
                "end": 21.718
            },
            {
                "speaker_id": "2",
                "transcription": "그마 1은 저격해서 못 들어가게 가려지구나",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.728,
                "end": 24.268
            },
            {
                "speaker_id": "2",
                "transcription": "자 일단은 학교가 다른 분한테 가겠습니다.",
