        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 캐러멜 빠르게 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.155
            },
            {
                "speaker_id": "1",
                "transcription": "아 야 이거 너무 하구만 키위 안 받아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.165,
                "end": 5.857
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 쓰레기네 자 꽝 나왔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.857,
                "end": 8.166
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 이거 무슨 대성공 같은 거 없어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.176,
                "end": 10.767
            },
            {
                "speaker_id": "1",
                "transcription": "헤 야 뭐야 대성공 나오면은 야 만 개도 주네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.777,
                "end": 14.868
            },
            {
                "speaker_id": "1",
                "transcription": "왐마 이거 뭐야 헤 30개도 줘 야 이거 대박도 나오는구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.878,
                "end": 19.805
            },
            {
                "speaker_id": "1",
                "transcription": "아 제발 아 이런 쓰레기 말고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.815,
                "end": 23.694
            },
            {
                "speaker_id": "1",
                "transcription": "아 나도 좀 대박을 좀 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
