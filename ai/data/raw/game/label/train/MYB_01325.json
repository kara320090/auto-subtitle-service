        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 파르페 마탕 리뷰 바로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.794
            },
            {
                "speaker_id": "1",
                "transcription": "30강 자 파르페 마탕 30강 하면요. 아군한테 파르페라프 버프 부여 그리고 자기 자신과 공격력이 높은 한 명에서 디버프면요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.804,
                "end": 16.319
            },
            {
                "speaker_id": "1",
                "transcription": "페르페라프 버프가 부여된 쿠키는 체력 회복의 최대 체력을 초과할 경우에는 체력 보호막까지 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.329,
                "end": 23.240
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 파르페 쿠키 함께 있을 경우에는 아군 쿠키 스킬 일반 공격이 치명타로 적용 될 경우에는 회복 능력 증가 버프도 부여되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.250,
                "end": 33.427
            },
            {
                "speaker_id": "1",
                "transcription": "디버프 면역이 4초다. 생각보다 되게 짧네 자 그리고 강화 효과는 아군 전체 체력 회복이 증가된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.437,
                "end": 41.083
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.093,
                "end": 42.947
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 일단 아레나에서 힐량이 좋기 때문에 풀로 그냥 올 풀로 버텨보겠습니다.",
                "sound_type": [
