        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 웨어올프 대체할 게 있나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.297
            },
            {
                "speaker_id": "1",
                "transcription": "3탱 덱은 웨어울프도 약간 핵심적인 거라 대체라기보다는 그냥 다른 덱이 만들어지는 거죠 웨올프가 3탱 텍에서 빠지면.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.307,
                "end": 12.212
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요거 같은 경우에는 그냥 스펙 찍누가 됐습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.222,
                "end": 15.173
            },
            {
                "speaker_id": "1",
                "transcription": "원래는 이게 앞에 터지면서 하나씩 잘려 나가면서 지는 그림인데 이것도 그냥 어떻게 이겼네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.183,
                "end": 21.940
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 3탱 덱 소르베도 상당히 좋다.",
                "sound_type": [
                    2
                ],
                "start": 21.940,
                "end": 25.250
            }
        ]
    },
    "summary": "스펙 찍누가 돼서 이겼고 3탱 덱 소르베도 상당히 좋다고 한다.",
