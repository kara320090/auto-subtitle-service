        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "절 먼저 실론덱부터 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.991
            },
            {
                "speaker_id": "1",
                "transcription": "가운데는 당연히 소르베가 있을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.001,
                "end": 4.404
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방은 허브덱이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.414,
                "end": 6.317
            },
            {
                "speaker_id": "1",
                "transcription": "자 상성상 제가 불리합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.327,
                "end": 8.896
            },
            {
                "speaker_id": "1",
                "transcription": "소르베가 있기 때문에 어 제가 소르베의 서리 디버프가 상대 허브에 의해서 다 무력화가 될 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.906,
                "end": 16.659
            },
            {
                "speaker_id": "1",
                "transcription": "디버프 제거로 인해서 네 그럼에도 불구하고 어떤 결과가 나오냐",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.669,
                "end": 23.841
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사가 이제 많이 사람들이 이제 그게 티어가 낮아졌다고 안 좋게 보는 분들이 좀 많긴한데 제가 말씀드리고 싶은 거는 여전히 0티어다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.851,
                "end": 36.255
            },
            {
                "speaker_id": "1",
                "transcription": "네 압도적으로 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.265,
                "end": 38.492
            },
            {
                "speaker_id": "1",
                "transcription": "많이 쓰고 있다. 이렇게 보시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.502,
                "end": 41.151
            },
            {
                "speaker_id": "1",
                "transcription": "보시는 거와 같이 스무스하게 이길 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.161,
                "end": 45.458
            },
            {
                "speaker_id": "1",
                "transcription": "네 허브가 있다고 해서 소르베 써도 이렇게 이길 수가 있는 그림이 나오고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.468,
                "end": 51.166
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대 소르베 풀 초월인 분 요분한테 한 번 다시 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.176,
                "end": 56.727
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 여러분들 가운데가 가려져있기 때문에 가운데가 어떤 쿠키인지 달빛술사, 스타더스트인지 잘 모르죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.737,
                "end": 64.511
            },
            {
                "speaker_id": "1",
                "transcription": "가운데가 가려져도 어떤 그림으로 가는지 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.521,
                "end": 68.807
            },
            {
                "speaker_id": "1",
                "transcription": "자 달빛술사를 이용해서 이렇게 딜을 넣고 네",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.817,
                "end": 77.666
            }
        ]
    },
