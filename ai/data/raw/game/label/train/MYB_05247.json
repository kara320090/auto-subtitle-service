        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그냥 딱 정의를 내릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.111
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 없으면 찐따 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.121,
                "end": 8.335
            },
            {
                "speaker_id": "1",
                "transcription": "최종적으로 얻고자 하는 목표는 이거잖아요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.345,
                "end": 10.524
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키 레전드 쿠키 키워야 될까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.534,
                "end": 13.095
            },
            {
                "speaker_id": "1",
                "transcription": "존나 이걸 정보를 얻기 위해서 영상 보실 텐데 없으면 거의 찐따 되는 느낌으로 엄청나게 사기적으로 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.105,
                "end": 19.814
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서만큼은 딱 이것 때문에 사기예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.824,
                "end": 22.913
            },
            {
                "speaker_id": "1",
                "transcription": "피감 무시 40퍼센트 그다음에 공포 효과 얘는 승급이 낮아도 쿠키 1성인데 쓸만할까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.923,
                "end": 29.008
            },
            {
                "speaker_id": "1",
                "transcription": "네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.018,
                "end": 29.519
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 1성이라도 아니면 승급이 없더라도 네 여러분들이 쓸만하니까 반드시 써 주셨으면 좋고 스토리 모드에서도 나쁘지 않을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.529,
                "end": 39.056
            },
            {
                "speaker_id": "1",
                "transcription": "전체 광역딜기 때문에 나쁘지 않게 쓸 수 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.066,
                "end": 42.917
            },
            {
                "speaker_id": "1",
                "transcription": "한마디 진짜 사기적인 쿠키다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.927,
                "end": 45.043
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 보면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.053,
                "end": 47.000
            },
            {
                "speaker_id": "1",
                "transcription": "네 블랙펄 레전드 쿠키 리뷰는 여기서 마치고 네 꼭 키우시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.010,
                "end": 67.300
            }
        ]
    },
    "summary": "화자가 블랙펄 레전드 쿠키는 사기적으로 좋기 때문에 꼭 키우라고 한다.",
