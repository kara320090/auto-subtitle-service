        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 어 그래도 이기네요. 웨어울프 3탱 덱한테 약한데 세팅만 잘하면은 이기는 건 무리없다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 12.329
            },
            {
                "speaker_id": "1",
                "transcription": "막히는 걸 보여드릴게요. 크런치 초코칩이 딱 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.339,
                "end": 15.717
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱한테 가면 어떤 식으로 지는지 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.727,
                "end": 18.727
            },
            {
                "speaker_id": "1",
                "transcription": "네 크런치초코칩이 들어간 덱이나 오이스터 덱한테 들어가게 된다면",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.737,
                "end": 23.664
            },
            {
                "speaker_id": "2",
                "transcription": "내가 앞서가겠다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.674,
                "end": 24.822
            },
            {
                "speaker_id": "3",
                "transcription": "겨울이 오고 있어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.832,
                "end": 25.779
            },
            {
                "speaker_id": "4",
                "transcription": "사라져라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.789,
                "end": 26.292
            },
            {
                "speaker_id": "5",
                "transcription": "검은 바다를 느껴 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
