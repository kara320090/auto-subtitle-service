        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 해도 44초에 눌러도 빌드는 안 깨지고 끝까지 갈 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.342
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 4.4에서 4.5억사이로 나올 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.352,
                "end": 13.894
            },
            {
                "speaker_id": "1",
                "transcription": "자 로열마가린 아몬드로해서 진행해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.904,
                "end": 18.413
            },
            {
                "speaker_id": "1",
                "transcription": "자 빌드는 똑같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.423,
                "end": 20.554
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 처음에 로열마가린 소르베 써주시구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 20.564,
                "end": 23.774
            },
            {
                "speaker_id": "1",
                "transcription": "어 그 다음에 주스 에클레어 자 그리고 57초때 밀키웨이 써 주시면 되구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 23.784,
                "end": 31.213
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 바로 주스랑 로열마가린 바로 써 주세요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 31.223,
                "end": 35.132
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 에클레어 써 주시구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 35.142,
                "end": 38.670
            },
            {
                "speaker_id": "1",
                "transcription": "바로 46초 되자마자 밀키 써 주구요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 38.680,
                "end": 42.109
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 마찬가지 소르베 44초부터 쓸 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 42.119,
                "end": 46.156
            },
            {
                "speaker_id": "1",
                "transcription": "40초에서 44초 사이에 쓰면은 아 빌드는 그대로 유지가 돼요.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 46.166,
                "end": 51.550
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 써 주고 자 소르베 그냥 40초에 안 누르고 미리 써 주겠습니다.",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 51.560,
                "end": 57.717
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 딱히 빌드가 깨지지 않기 때문에 자 밀키웨이 이제부터 밀키웨이랑 나머지 빠르기 쿨 도는대로 바로 바로",
                "sound_type": [
                    2,
                    3,
                    4,
                    5
                ],
                "start": 57.727,
                "end": 65.574
            },
            {
                "speaker_id": "1",
                "transcription": "바로 바로 써 줄게요.",
