        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 또 한 번의 속박을 걸어 주고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.392
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 상대를 날려 버릴 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.402,
                "end": 8.488
            },
            {
                "speaker_id": "1",
                "transcription": "또 속박을 걸어 버리고 하나씩 하나씩 이렇게 네 속박을 걸어서 네 이기는 구도가 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.498,
                "end": 22.504
            },
            {
                "speaker_id": "1",
                "transcription": "프릴해파리는 무조건 일찍 죽는 것보다도 오래 살아남아서 상대 딜러를 묶어서 속박해 주는 용도로 해 줘도 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.514,
                "end": 31.355
            },
            {
                "speaker_id": "1",
                "transcription": "일찍 죽어서 라즈베리 세팅으로 아군한테 힐러 개념으로 힐을 더 채워 주는 전략도 좋아 보입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.365,
                "end": 38.527
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 바다요정으로 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.537,
                "end": 40.615
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤은 블랙펄로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.625,
                "end": 42.917
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다요정 잼스톤도 상관은 없는데 승률은 제가 해 보니까 블랙펄 쪽이 더 승률이 좋았고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.927,
                "end": 50.231
            },
            {
                "speaker_id": "1",
                "transcription": "자 시작하자마자 이렇게 숙박을 걸어 주고 네 파도를 치게 되면 상대 딜러들이 순삭 해버렸죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.241,
                "end": 60.459
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 압도적으로 상대 딜러들이 순삭 해버린다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.469,
                "end": 69.566
            }
        ]
    },
    "summary": "남성이 프릴해파리는 일찍 죽는 것도 오래 살아남는 것도 전략 방법이 있고 다음으로 바다요정을 설명한다.",
