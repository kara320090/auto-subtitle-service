        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 깜짝이야. 아이 다크 카카오인 줄 알았네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.030
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베까지 나오면은 뭐 완벽하죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.030,
                "end": 8.308
            },
            {
                "speaker_id": "1",
                "transcription": "저도 떡 좋아해?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.318,
                "end": 10.050
            },
            {
                "speaker_id": "1",
                "transcription": "달 토끼 나왔구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.050,
                "end": 17.260
            },
            {
                "speaker_id": "1",
                "transcription": "좋아요 좋아요 좋아요 달 토끼.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.270,
                "end": 20.470
            },
            {
                "speaker_id": "1",
                "transcription": "달 토끼는 솔직히 말해서 좋다고 말하기는 힘들고 그냥 약간 컬렉션용이죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.460,
                "end": 25.300
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 뭐 채운다는 느낌?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.300,
                "end": 26.672
            },
            {
                "speaker_id": "1",
                "transcription": "진군하라 쿠키들이여.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.682,
                "end": 28.937
            },
            {
                "speaker_id": "1",
                "transcription": "실론 나이트 한물간 실론 나이트 실론 나이트 쿠키 티어 보신 분들 아시겠지만 지금 아예 안 쓰인다 안 쓰입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.947,
                "end": 43.582
            },
            {
                "speaker_id": "1",
                "transcription": "빛나는 은색 갑옷의 맹세를 잊지 마라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.592,
                "end": 48.650
            },
            {
                "speaker_id": "1",
                "transcription": "닥초가 잘 나오네요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 48.650,
                "end": 50.170
            },
            {
                "speaker_id": "1",
                "transcription": "다크초코 쟤 일자리 잃었잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.170,
                "end": 52.670
            },
            {
                "speaker_id": "1",
                "transcription": "예언자맛 쿠키가 토벌에서 좋게 쓰이기 때문에.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.670,
                "end": 56.823
            }
        ]
    },
    "summary": "달 토끼 캐릭터는 컬렉션용이고 실론 나이트 쿠키는 사람들이 아예 쓰지 않는 캐릭터이다.",
