        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 한번 아레나 실전으로 제가 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.062
            },
            {
                "speaker_id": "1",
                "transcription": "자 제일 먼저 네 5번 덱으로 보여 드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.072,
                "end": 7.250
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베 같은 경우에 들어가기 전에 왜 이렇게 소르베가 많이 떴나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.260,
                "end": 12.392
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베의 역할 같은 경우에는 공격력이 높은 순서대로 적을 나누어 공격하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.402,
                "end": 18.378
            },
            {
                "speaker_id": "1",
                "transcription": "자 16초동안 대상의 공격 속도가 감소하죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.388,
                "end": 21.825
            },
            {
                "speaker_id": "1",
                "transcription": "공격 속도 감소로 인해서 용과드래곤의 공격 타이밍 1분 지나서 브레스 타이밍과 상대의 메인 딜러들의 공유 타이밍을 꼬아 놓는다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.835,
                "end": 30.956
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 소르베 같은 경우에는 올 쿨로 해가지고 너무 약한 거 아닌가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.966,
                "end": 35.830
            },
            {
                "speaker_id": "1",
                "transcription": "자 호루라기를 받기 때문에 호루라기 같은 경우에는 피해 감소 20퍼센트를 받습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.840,
                "end": 41.379
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 소르베가 피해 감소 20퍼센트가 있기 때문에 쉽게 죽지는 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.389,
                "end": 46.935
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 어",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.945,
                "end": 51.233
            }
        ]
    },
    "summary": "5번 덱으로 아레나 실전을 보여주면서 소르베의 토핑은 쿨이라고 설명합니다.",
