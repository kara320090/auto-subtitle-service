        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 참 이 뭐 고인물들이나 초창기 때부터 했던 사람들은 오로라 재료 몇천 개 소다 재료도 다 뚫어놓고 몇천 개씩 쌓여 있는데 이제 그런 거를 약간 해결해 줄 아이디어가 없는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 13.051
            },
            {
                "speaker_id": "1",
                "transcription": "모든 성장 요소를 다 끝낸 사람이 은근 좀 많아지고 있어요 고인물분들은.",
                "sound_type": [
