        "term": [
            {
                "speaker_id": "1",
                "transcription": "열쇠가 부족해요 자연으로 충전하는 거는 한계가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.237
            },
            {
                "speaker_id": "1",
                "transcription": "자 화학 선생님도 이렇게 야 확실히 버티는 것 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.247,
                "end": 10.868
            },
            {
                "speaker_id": "1",
                "transcription": "예전에는 스킬 쿨타임 한 바퀴 돌면은 다 녹았는데 이렇게 승리했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.878,
                "end": 17.750
            },
            {
                "speaker_id": "1",
                "transcription": "야 열쇠 30개씩 들고 스킬 파우더 요렇게 선택할 수 있고 이거는 어 그런데 생각보다 어 너무 좀 생각보다는 좀 보상이 좀 그러네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.750,
                "end": 30.181
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 나오는 몬스터들이 좀 더 센 애들이긴 합니다.",
                "sound_type": [
                    2,
                    3
                ],
