        "term": [
            {
                "speaker_id": "1",
                "transcription": "아유 왜 이래",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 0.901
            },
            {
                "speaker_id": "2",
                "transcription": "물러설 수 없어요. 물러설 수 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.911,
                "end": 3.160
            },
            {
                "speaker_id": "3",
                "transcription": "달빛이여 내 활을",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.170,
                "end": 5.005
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 졌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.015,
                "end": 7.178
            },
            {
                "speaker_id": "1",
                "transcription": "이 5초월의 위엄이 느껴진다고 어디서 느꼈냐면은 제가 서리 여왕 자체가 제일 먼저 죽었잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.188,
                "end": 13.356
            },
            {
                "speaker_id": "1",
                "transcription": "근데 웬만해선 죽진 않아요.",
                "sound_type": [
                    2
                ],
                "start": 13.366,
                "end": 14.984
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐? 세팅 자체가 서리 여왕 피감이 50이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.994,
                "end": 18.372
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 원래 잘 죽진 않는데 와 이런 질문 있어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.382,
                "end": 21.248
            },
            {
                "speaker_id": "1",
                "transcription": "아이 도대체 이 짝퉁은 왜 쓰는 겁니까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.258,
                "end": 24.473
            },
            {
                "speaker_id": "1",
                "transcription": "이거 자체가 왜 쓰이냐면은 무공비급을 굳이 안 써도 얘네들 쿠키들 시너지로 쿠키 죽이기에는 딜 자체가 충분해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.483,
                "end": 33.222
            },
            {
                "speaker_id": "1",
                "transcription": "딜이 부족해서 못 죽인다라기보다는 45퍼센트의 이 공격력 증가와 나머지 쿠키 딜 그다음에 1분 지났을 때 100퍼센트 공증 딜로만으로도 충분히 상대 쿠키들을 죽일 수 있는 그런 공격력이 나오기 때문에 그 45퍼센트의 공격력과 방어력 30퍼센트 정도의 방어력 증가로 덱의 안정성을 높여주는 그런 덱을 쓰는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.232,
                "end": 57.166
            }
        ]
    },
    "summary": "남성은 게임 세팅을 보여주면서 왜 이렇게 했는지 자세히 설명해 주고 있다.",
