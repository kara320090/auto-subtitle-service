        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안데레 사이코. 대전 게임?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.819
            },
            {
                "speaker_id": "1",
                "transcription": "아 그러면은 저 철권 같이 싸우는 거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.829,
                "end": 7.722
            },
            {
                "speaker_id": "1",
                "transcription": "아 나올만 하다. 이런 게임 나올만 하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.732,
                "end": 15.839
            },
            {
                "speaker_id": "1",
                "transcription": "야 근데 진짜 이번에 파판16 하기 전에는 파이널판타지 그거 완전 씹덕 게임 아니야 이러고 파판이라고 하면 딱 생각난 게 뭐였냐면 딱 진짜 금태양이었거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.849,
                "end": 25.540
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 파판을 제대로 처음 알았던 게 얼마나 좋을까 그 뮤직비디오 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.550,
                "end": 31.210
            },
            {
                "speaker_id": "1",
                "transcription": "그거 였었거든요. 그래 갖고 무조건 그럴 거라고만 생각했고 시리즈가 이어지는 줄 알았어요.",
                "sound_type": [
                    2
                ],
                "start": 31.220,
                "end": 36.986
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아니더라고. 음 아 히오스 느낌.",
                "sound_type": [
                    2
                ],
                "start": 36.996,
                "end": 41.119
            },
            {
                "speaker_id": "1",
                "transcription": "아 진짜 나한테는 진짜 정말 최고야. 좋아.",
                "sound_type": [
                    2
                ],
                "start": 41.129,
                "end": 53.366
            }
        ]
    },
