        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 축하드려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.785
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트가 아니 이게 진짜 달라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.795,
                "end": 5.007
            },
            {
                "speaker_id": "1",
                "transcription": "다른 쿠키보다 스타더스트를 강조하냐면은 이게 업데이트 때문에 버그 수정 때문에 얘가 좀 딜도 조금 미세하지만 그래도 차이가 달라졌고 얘는 어느 조합이든 어느 콘텐츠든 활용 가치가 좋아서 어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.017,
                "end": 19.151
            },
            {
                "speaker_id": "1",
                "transcription": "아 하필이면 얜 진짜 요새 쓰지도 않는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.161,
                "end": 27.735
            },
            {
                "speaker_id": "1",
                "transcription": "아니 서리는 여러분들 진짜 아예 안 쓰여요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.745,
                "end": 30.619
            },
            {
                "speaker_id": "1",
                "transcription": "아 또 나왔어. 나오지 말라니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.629,
                "end": 33.764
            },
            {
                "speaker_id": "1",
                "transcription": "이 자리에 만약에 달빛 나왔으면은 참 나오지 말라니까 또 나와버렸어 얘.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.774,
                "end": 39.933
            }
        ]
    },
    "summary": "스타더스트는 업데이트 이후 차이가 생겼고 활용 가치가 좋아서 강조하고 서리는 아예 안 쓰인다.",
