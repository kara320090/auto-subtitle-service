        "term": [
            {
                "speaker_id": "1",
                "transcription": "엄청나게 손해를 보고 있고 킹덤에서 가장 중요한 포인트를 놓치고 있는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.534
            },
            {
                "speaker_id": "1",
                "transcription": "지금이라도 고기젤리 소모해서 토핑 강화나 토핑 스펙업에 집중을 해주시면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.544,
                "end": 11.577
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 절대 해서는 안 되는 행동 중에 또 3번째 제가 강조드리고 싶은 점 자 노움 연구소입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.587,
                "end": 17.815
            },
            {
                "speaker_id": "1",
                "transcription": "자 노움 연구소 보면 쿠키 연구 쪽에만 먼저 투자하는 분들 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.825,
                "end": 22.128
            },
            {
                "speaker_id": "1",
                "transcription": "자 왕국 연구랑 쿠키 연구중에 뭘 연구를 먼저 하냐 왕국 연구쪽에 먼저 투자를 하셔야 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.138,
                "end": 28.777
            },
            {
                "speaker_id": "1",
                "transcription": "비교를 해드리자면 왕국 연구를 먼저 한 사람이 쿠키 연구한 사람보다 나중에 코인이 훨씬 더 많아 지게 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.787,
                "end": 35.590
            },
            {
                "speaker_id": "1",
                "transcription": "시간이 지날 수록 이득을 보는 생산쪽이 이득을 많이 보기 때문에 훨씬 더 코인이 부유하게 된다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.600,
                "end": 43.134
            },
            {
                "speaker_id": "1",
                "transcription": "집어서 제가 말씀드리자면 예 연구 가속이 정말 중요합니다 많이 찍어주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.144,
                "end": 48.705
            },
            {
                "speaker_id": "1",
                "transcription": "네 솜사탕, 우유 많이 찍어주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.715,
                "end": 51.836
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 연구에서도 절대 해서는 안 될 행동이 하나만 몰빵으로 많이 찍는겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.846,
                "end": 56.400
            }
        ]
    },
    "summary": "왕국 연구를 먼저 한 사람이 쿠키 연구한 사람보다 나중에 코인이 훨씬 더 많아 지게 되므로 왕국 연구에 먼저 투자를 해야 하고 쿠키 연구에서도 하나의 유형만 많이 찍으면 안 된다.",
