    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 이것도 보시면 아시겠지만 되게 나쁘지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.001
            },
            {
                "speaker_id": "1",
                "transcription": "나쁘지 않게 클로티드가 이렇게 쓰이고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.011,
                "end": 12.537
            },
            {
                "speaker_id": "1",
                "transcription": "요런 그림으로 나쁘지 않죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.547,
                "end": 13.988
            },
            {
                "speaker_id": "1",
                "transcription": "에스프레소가 제가 일부러 좀 피감 확 좀 낮췄거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.998,
                "end": 17.012
            },
            {
                "speaker_id": "1",
                "transcription": "낮춰서 죽는 그림이 나와도 그래도 이기는 그림이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.022,
                "end": 22.095
            },
            {
                "speaker_id": "1",
                "transcription": "근데 얘 같은 경우는 저는 그 올 아몬드로 했는데 제가 볼 때는 요것도 나쁘지는 않을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.105,
                "end": 30.471
            },
            {
                "speaker_id": "1",
                "transcription": "또 확실히 힐량을 많이 채워주기 때문에 올 애플젤리 해도 나쁘지 않을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.481,
                "end": 35.052
            },
            {
                "speaker_id": "1",
                "transcription": "방어덱 그다음에 공덱 두 개로 이렇게 리뷰를 해드렸는데 제가 안타까운 거는 이 호밀이랑 우유 관련된 덱을 제가 어제도 좀 연구를 해봤는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.062,
                "end": 45.327
            },
            {
                "speaker_id": "1",
                "transcription": "얘네 둘은 일반적으로 지금 무지성으로 가거나 뭐 그럴 수 있는 덱들이 나오지 않는 상황이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.337,
                "end": 51.628
            },
            {
                "speaker_id": "1",
                "transcription": "좀 약간 특정덱 저격으로는 쓰일 수 있어도 와 이 덱 세팅해서 가면 거의 웬만큼 승률이 높게 나온다 그런 덱이 아직은 나오지 않는 상태 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.638,
                "end": 61.292
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 길드 토벌전 때문에 지금 많이 힘드실 텐데 그래도 요렇게 세팅해서 아레나 한번 해보시는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.302,
                "end": 74.300
            }
        ]
    },
    "summary": "에스프레소의 피감을 낮추고 힐량을 많이 채워주는 애플젤리를 사용하면 이길 수 있으며 호밀과 우유 관련 덱은 승률이 높게 나오는 덱이 아직 나오지 않았지만 아레나를 이렇게 세팅해 보는 걸 추천한다.",
