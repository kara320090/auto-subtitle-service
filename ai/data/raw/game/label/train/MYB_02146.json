            },
            {
                "speaker_id": "1",
                "transcription": "밀키웨이 살아 주구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.622,
                "end": 12.725
            },
            {
                "speaker_id": "1",
                "transcription": "찍기 전에 밀키",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.735,
                "end": 16.031
            },
            {
                "speaker_id": "1",
                "transcription": "쟤는 스킬 쓰고 죽었으면 됐습니다.",
                "sound_type": [
