                    5
                ],
                "start": 16.041,
                "end": 18.088
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요런 식으로 끝을 내면은 4.1억 매판 나옵니다.",
                "sound_type": [
                    2,
