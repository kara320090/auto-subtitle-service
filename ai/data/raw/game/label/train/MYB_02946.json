            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 잘 보이죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.566
            },
            {
                "speaker_id": "1",
                "transcription": "지금도 좀 이제 떨어졌고 웨어울프가 디버프를 먹게 되면은 좀 떨어지는 경우도 생깁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.576,
                "end": 9.415
            },
            {
                "speaker_id": "1",
                "transcription": "많이 떨어졌죠 이렇게는.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.425,
                "end": 10.964
            },
            {
                "speaker_id": "1",
                "transcription": "1.9억 나오신 분도 편차가 1.6억부터 1.9억까지 편차가 무려 3천만이나 나와요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.974,
                "end": 17.695
            },
            {
                "speaker_id": "1",
                "transcription": "자 연습 모드로 다시 한번 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.705,
                "end": 20.662
            },
            {
                "speaker_id": "1",
                "transcription": "자 마카롱 그다음 목화 그다음에 오징어먹물 자 그리고 웨어울프는 자 여기 라인에 라인 왔을 때 웨어울프 홀베 바로 눌러주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.672,
                "end": 34.546
            },
            {
                "speaker_id": "1",
                "transcription": "올 자동 네 요렇게 눌러 주시고 여러분들 봐야 될 거는 오징어먹물을 요 카운트 감초 토벌전이 전 개인적으로 좀 패치가 됐으면 좋겠어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.556,
                "end": 46.056
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 이게 너무나 큰 스트레스를 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.066,
                "end": 49.227
            },
            {
                "speaker_id": "1",
                "transcription": "편차가 무려 3천만이나 나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.237,
                "end": 51.548
            },
            {
                "speaker_id": "1",
                "transcription": "기존에는 편차가 나도 1000만 정도밖에 차이가 안 났거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.558,
                "end": 55.902
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 1.5억이라든지 뭐 잘 나면 1.6억 잘 안 나오면 1.5억 편차가 1000만 점밖에 안 됐지만 지금은 편차가 무려 3천만이나 나기 때문에 아 너무나 게임을 하는 입장에서 스트레스가 많이 받게 되는 경우가 생겼습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.912,
                "end": 72.940
            },
            {
                "speaker_id": "1",
                "transcription": "네 좀 약간 감초가 쫄 때문에 스트레스를 덜 받게끔 좀 그렇게 됐으면 좋겠네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.950,
                "end": 81.040
            },
            {
                "speaker_id": "1",
                "transcription": "자 지금도 1.77 나왔는데 저 같은 경우에도 1.84 그다음에 잘 안 나면 1.6 저도 편차가 2천만 이렇게 나오고 있고 치명 때문에 이렇게 쫄이 살고 죽고에 따라서 편차가 엄청나게 크기 때문에 너무 내가 지금 잘못된 건가. 이러기보다는 그냥 쫄이 지금 살고 죽고에 따라 운빨이 크다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 81.050,
                "end": 101.844
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 101.854,
                "end": 105.366
            }
        ]
    },
    "summary": "남성이 쫄 때문에 스트레스를 받고 점수 편차가 무려 3천만이나 나기 때문에 카운트 감초 토벌전이 패치가 됐으면 좋겠다고 한다.",
