    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "모바일 게임을 플레이한 만큼 혜택을 받을 수 있는 플레이오 앱을 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.986
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 쌓이는 잼을 코인으로 교환해 상점에서 기프트카드, 문화상품권 등 다양한 상품으로 구매 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.986,
                "end": 9.966
            },
            {
                "speaker_id": "1",
                "transcription": "영상을 시청하고 가입한 신규 유저분들한테는 특별 시크릿코드 플오ND러너를 입력하면 10000잼을 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.973,
                "end": 17.004
            },
            {
                "speaker_id": "1",
                "transcription": "추가로 플레이오의 자체적인 퀘스트들이 있어서 게임을 진행하면서도 다양한 잼을 추가로 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.014,
                "end": 22.763
            },
            {
                "speaker_id": "1",
                "transcription": "게임하고도 기프트카드, 문화상품권 무료로 얻고 너무나 좋은 기회 아닌가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.773,
                "end": 27.432
            },
            {
                "speaker_id": "1",
                "transcription": "다운로드 링크는 고정 댓글을 참고하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.442,
                "end": 29.648
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방분은 블랙레모네이드와 샤이닝글리터 조합이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.658,
                "end": 34.658
            },
            {
                "speaker_id": "1",
                "transcription": "자 확실히 이 조합도 앞의 탱커를 녹이는 극딜 조합의 하나의 일종인데 자 보세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.668,
                "end": 41.435
            },
            {
                "speaker_id": "1",
                "transcription": "시작과 동시에 어디갔죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.445,
                "end": 43.675
            },
            {
                "speaker_id": "1",
                "transcription": "상대방 스펙이 어느 정도 되지만 시작과 동시에 다 날아갔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.685,
                "end": 47.964
            },
            {
                "speaker_id": "1",
                "transcription": "마치 유사 한방덱과 비슷한 느낌이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.974,
                "end": 50.915
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 한방에 다 날아갔고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.925,
                "end": 53.042
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 땐 바다요정 평가가 지금 좀 많이 안 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.052,
                "end": 56.360
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 1분 지나서까지 버티게 되면은 상대방의 용과 드래곤이나 상대 딜러한테 죽기 때문에 버틸 수가 없어서 많이 약합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.360,
                "end": 65.526
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 1분 전에 승부를 볼 수 있다면 이렇게 막강하게 쓸 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.526,
                "end": 71.691
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 바다요정의 활용법은 1분 지나서까지 장기전으로 가자는 목적이 아니라",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.701,
                "end": 77.733
            }
        ]
    },
    "summary": "모바일 게임을 플레이한 만큼 혜택을 받을 수 있는 플레이오 앱을 추천하며 바다요정은 1분 지나서까지 버티게 되면 상대방의 용과 드래곤이나 상대 딜러한테 죽기 때문에 버틸 수가 없어서 많이 약하지만 그 전에 승부를 볼 수 있다면 막강하게 쓸 수 있다.",
