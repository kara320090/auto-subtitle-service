        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 이분은 끝났네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.637
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 토벌만 조금 봐드리면 됐었고 나머지 수호의 성전은 됐고 뭐 아레나는 알아서 잘하고 계시고 왕국 운영에서는 딱 하나 흠이 있었다면 고기 젤리 타워가 없었어요 이분.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.647,
                "end": 15.399
            },
            {
                "speaker_id": "1",
                "transcription": "아 고기 젤리 타워가 없는 거는 캐치 빨리 하길 잘했다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.409,
                "end": 18.320
            },
            {
                "speaker_id": "1",
                "transcription": "이게 하루에 만랩 있는 사람하고 없는 사람하고 하루에 고기 젤리가 30개 이상 차이가 나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.330,
                "end": 24.284
            },
            {
                "speaker_id": "1",
                "transcription": "마지막으로 왕국 저장소에 얼파탑이요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.290,
                "end": 26.570
            },
            {
                "speaker_id": "1",
                "transcription": "야 불러오기 하면 되지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.580,
                "end": 28.457
            },
            {
                "speaker_id": "1",
                "transcription": "괜히 날아갈까 봐 나 진짜 심장 두근두근이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.467,
                "end": 31.577
            },
            {
                "speaker_id": "1",
                "transcription": "우와 야 이거 섬네일이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.587,
                "end": 33.950
            },
            {
                "speaker_id": "1",
                "transcription": "계정 평가 내가 요새 유튜브에 업로드 안 하는데 내가 이 분은 업로드할게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.950,
                "end": 39.385
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 계평 시온님 계평은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.390,
                "end": 41.829
            },
            {
                "speaker_id": "1",
                "transcription": "야 편집으로 들어갈 가능성이 99퍼센트입니다.",
                "sound_type": [
