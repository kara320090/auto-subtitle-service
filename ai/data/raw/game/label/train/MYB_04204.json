                ],
                "start": 2.906,
                "end": 18.604
            },
            {
                "speaker_id": "1",
                "transcription": "아니 잠깐만 무슨 나 다이아 지금 봤는데 160만개 실화냐 이거 재료랑 다이아랑 길드 뽑기 모으는 게 취미여서 열심히 모으면서 즐기고 있습니다.",
                "sound_type": [
