        "term": [
            {
                "speaker_id": "1",
                "transcription": "세계로의 초대 디즈니 한정 테마가 추가된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.160
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 제가 볼 때는 맨 처음에 업데이트가 되고 나면은 되게 혼란이 올 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.170,
                "end": 8.755
            },
            {
                "speaker_id": "1",
                "transcription": "보스가 많아지기 때문에 공략이나 이런 게 정말 중요할 거 같고 길드 보상이 정말 많이 늘어나기 때문에 여러분들 더 이상 길드를 가볍게 봐서는 안 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.765,
                "end": 19.817
            },
            {
                "speaker_id": "1",
                "transcription": "일단 제가 볼 때는 신쿠가 안 나와서 좀 다행이라고 생각해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.827,
                "end": 23.928
            },
            {
                "speaker_id": "1",
                "transcription": "너무 좀 부담이거든요 신쿠까지 또 나오면 업데이트 리뷰 때 자세히 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.938,
                "end": 28.948
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트는 8월 11일 저녁 아마 7시에 오픈이 될 거 같은데 리뷰 때 뵙도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.958,
                "end": 35.500
            }
        ]
    },
    "summary": "한 남자가 게임 업데이트 공지를 읽고 보스가 많아지고 보상이 늘어나 길드의 중요성이 증가하고 처음에 게임 플레이 할 때는 혼란이 올 거 같다고 말한다.",
