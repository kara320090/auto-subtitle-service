        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 샤이닝이 일찍 죽어서 지는 그림이 나왔다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.552
            },
            {
                "speaker_id": "1",
                "transcription": "자 정리를 하자면 샤이닝글리터맛 쿠키는 아직 승급이 낮아서 얘 아레나에서 죽지만 않는다면은 나름을 유용하게 쓸 수는 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.562,
                "end": 18.893
            },
            {
                "speaker_id": "1",
                "transcription": "방금 전판처럼 일찍 죽는 그림이 나오면은 승패가 좀 크게 알리지만 저는 샤이닝글리터맛 쿠키가 반드시 0티어로 쓰이기 보다는 하나의 공격 옵션으로 유용하게 그냥 사용되는 쿠키다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.903,
                "end": 32.648
            },
            {
                "speaker_id": "1",
                "transcription": "0티어 보다는 1티어에 가깝다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.658,
                "end": 34.745
            },
            {
                "speaker_id": "1",
                "transcription": "오히려 락스타맛 쿠키가 저는 0티어라고 봅니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.755,
                "end": 38.939
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 절대적인 0티어로 출시됐다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.949,
                "end": 41.392
            },
            {
                "speaker_id": "1",
                "transcription": "샤이닝글리터맛 쿠키 일단 리뷰는 여기서 마치고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.402,
                "end": 44.828
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 좋은 조합은 따로 영상으로 올리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.838,
                "end": 48.318
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
