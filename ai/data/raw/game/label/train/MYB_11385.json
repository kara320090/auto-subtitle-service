                    3,
                    5
                ],
                "start": 3.793,
                "end": 6.372
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 내가 이 손으로 조슈아를 죽였는데 이 손으로 이렇게 게임을 하다니.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.382,
                "end": 20.908
            },
            {
                "speaker_id": "1",
                "transcription": "아 내가 조슈아를 죽인 손이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.918,
                "end": 50.770
            },
            {
                "speaker_id": "1",
                "transcription": "미친 이건가?",
