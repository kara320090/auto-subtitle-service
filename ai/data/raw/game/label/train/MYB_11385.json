                    5
                ],
                "start": 69.707,
                "end": 71.507
            },
            {
                "speaker_id": "1",
                "transcription": "연출 봐 진짜 개지리네 미쳤나 봐 진짜.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.517,
                "end": 74.917
            },
            {
                "speaker_id": "1",
