        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 미친 이걸 어떻게 참아?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.591
            },
            {
                "speaker_id": "1",
                "transcription": "나 진짜 딴 게임 못 해 이제.",
                "sound_type": [
