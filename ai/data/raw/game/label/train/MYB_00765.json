        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아직 끝난 건 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.494
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 역전이 될 수도 있다.",
                "sound_type": [
                    2
                ],
                "start": 1.504,
                "end": 5.556
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페 써 가지고 이런 식으로도 박하 대신에도 사용이 가능하고요.",
                "sound_type": [
                    2
                ],
                "start": 5.566,
                "end": 10.953
            },
            {
                "speaker_id": "1",
                "transcription": "대신에 중요한 점은 아군의 딜러들이 초반에 잘리면 안되기 때문에 피감이 좀 더 높아야 된다.",
                "sound_type": [
                    2
                ],
                "start": 10.963,
                "end": 17.327
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄 같은 경우에도 얘는 올쿨을 쓰기 때문에 여러분들이 23퍼센트만 맞추는 게 아니라 피감 높게 그 다음에 치피감 높게 이거 세팅을 높게 해주시는 게 중요해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.345,
                "end": 28.102
            },
            {
                "speaker_id": "1",
                "transcription": "죽지 않기 위해서 스타 더스트도 마찬가지 저는 피감이 좀 낮게 세팅이 됐는데 피감 높게 세팅해 주시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.135,
                "end": 35.490
            },
            {
                "speaker_id": "1",
                "transcription": "이 박하사탕 덱 세팅을 운영할 때는요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.500,
                "end": 37.832
            },
            {
                "speaker_id": "1",
                "transcription": "자 분명 이 질문도 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.842,
                "end": 39.774
            },
            {
                "speaker_id": "1",
                "transcription": "저는 박하사탕도 안 키웠고 파르페도 없는데 뭐 퓨어 바닐라 대체로 가능할까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.784,
                "end": 45.656
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 여러분들이 쓰실 거면은 퓨어 바닐라도 올 아몬드 세팅을 해서 쓸 수는 있지만 파르페랑 박하사탕보다는 승률이 완전 떨어지고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.666,
                "end": 55.900
            },
            {
                "speaker_id": "1",
                "transcription": "또 하나 박하사탕 맛 쿠키를 그래서 키워야 될까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.910,
                "end": 59.194
            },
            {
                "speaker_id": "1",
                "transcription": "박하사탕 맛 쿠키는 제가 승급이 낮아도 좋은지 부계정을 통해서 한 번 해봤는데 좋냐 나쁘냐는 결국에는 버틸 수가 있어야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.204,
                "end": 68.330
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 3딜덱의 딜을 맨 처음에 견딜만한 토핑 능력이 안 되면 여러분들이 키워봤자",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.340,
                "end": 74.466
            }
        ]
    },
    "summary": "파르페를 써서 박하 대신에 사용 가능하고 파르페나 블랙펄이나 스타 더스트나 모두 피감이 높아야 하며 박하사탕을 키워야 할 지 여부는 박하사탕이 처음에 버틸 수가 있는지 살펴봐야 한다.",
