        "term": [
            {
                "speaker_id": "1",
                "transcription": "역시나 전부 다 15렙 만렙 풍요의 분수도 만렙 야 보물 뽑기권도 2000개나 모으셨네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.059
            },
            {
                "speaker_id": "1",
                "transcription": "아 쿨, 피, 아몬드 얼마나 있는지 볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.069,
                "end": 9.799
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 확실히 이게 피감도 높은 상태에서 쿨도 이렇게 어느 정도 있는 게 중요하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.809,
                "end": 14.893
            },
            {
                "speaker_id": "1",
                "transcription": "6퍼센트에 이렇게 되어 있으면은 진짜 예술이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.903,
                "end": 18.750
            },
            {
                "speaker_id": "1",
                "transcription": "와 이건 나 진짜 너무 갖고 싶다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.760,
                "end": 20.955
            },
            {
                "speaker_id": "1",
                "transcription": "이건 거의 종결급에 가까운 거죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.965,
                "end": 23.495
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 이게 나오기 힘들거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.505,
                "end": 25.052
            },
            {
                "speaker_id": "1",
                "transcription": "야 심지어 이거 세 개나 있네 이게 진짜 쿨 높으면서 피감 높은 게 진짜 귀하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.062,
                "end": 30.909
            },
            {
                "speaker_id": "1",
                "transcription": "쿨은",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.919,
                "end": 31.800
            }
        ]
    },
    "summary": "화자가 쿨 높으면서 피감 높은 게 귀하다고 이야기하고 있다.",
