        "term": [
            {
                "speaker_id": "1",
                "transcription": "확실히 딜적인 면이 확실히 올라갔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.302
            },
            {
                "speaker_id": "1",
                "transcription": "그게 보이네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.312,
                "end": 3.417
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 됐고 중요한 거는 아레나거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.427,
                "end": 7.695
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 아레나에서 좀 쓰고 싶은 부분은 현재 여러분들이 어떤 용도로 감초가 쓰이는지를 알고 계셔야 되는 게 토벌에서 캡틴캐비어 자리를 지금 감초맛 쿠키가 들어가서 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.705,
                "end": 21.674
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 캡틴캐비어의 그 방어력 감소가 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.684,
                "end": 25.905
            },
            {
                "speaker_id": "1",
                "transcription": "요거 즉 8초 동안 42퍼센트고 중점 1개인데 방어력 감소가 40퍼센트 중첩은 한 번밖에 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.915,
                "end": 33.783
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 중요한 거는 얘는 12초 동안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.793,
                "end": 36.710
            },
            {
                "speaker_id": "1",
                "transcription": "12초 동안 40퍼센트 캡틴캐비어 덱에서 감초가 저 자리에 들어갔을 때 어떻게 될지 고거 한번 좀 보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.720,
                "end": 45.815
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요 덱 막강한데 요 덱한테 들어가 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.825,
                "end": 48.891
            },
            {
                "speaker_id": "1",
                "transcription": "웬만해서 이 덱한테 다 녹거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.901,
                "end": 51.791
            }
        ]
    },
