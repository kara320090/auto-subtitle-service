                    2,
                    3
                ],
                "start": 11.572,
                "end": 13.685
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐만 이거 변신해서 야",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.695,
                "end": 17.085
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 쿨타임 알았다 쿨타임 1퍼센트 아니면은 미세하게 주거나 아예 쿨 없어도 1분 타이밍 딱 알맞게 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.095,
                "end": 24.877
            },
            {
                "speaker_id": "1",
                "transcription": "용과 토핑은 올 라즈에 쿨 그냥 거의 없어야 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.887,
                "end": 29.367
            },
            {
                "speaker_id": "1",
                "transcription": "타이밍 예술이네.",
                "sound_type": [
                    2,
                    3
