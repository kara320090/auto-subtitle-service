        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 용과가 말하는 게 링딩동으로 들린다구요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.298
            },
            {
                "speaker_id": "1",
                "transcription": "아 자꾸 그렇게 들리잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.308,
                "end": 11.562
            },
            {
                "speaker_id": "1",
                "transcription": "와 뭐야?",
