        "term": [
            {
                "speaker_id": "1",
                "transcription": "골백번을 떨궜겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.300
            },
            {
                "speaker_id": "1",
                "transcription": "가주님을 속이는 죄는 그렇게 큽니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.310,
                "end": 3.326
            },
            {
                "speaker_id": "1",
                "transcription": "극진이도 호필하는군 좋은 일이지 자신이 위하려는 사람이 있다는 건 동료 그런 발상은 없었다만 그편으로 생각하니 마음이 좀 편하군.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.336,
                "end": 14.331
            },
            {
                "speaker_id": "1",
                "transcription": "어 싫어 결국 해방되기 위해서는 왕 앞까지 가야 한다는 거 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.341,
                "end": 18.648
            },
            {
                "speaker_id": "1",
                "transcription": "가서 주세요 해도 그냥은 안 주겠지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.658,
                "end": 21.374
            },
            {
                "speaker_id": "1",
                "transcription": "걱정마라 니 머리 색은 붉으니까 잡아먹으려 들진 않을 거다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.384,
                "end": 26.589
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 퉁퉁 불은 여성의 시체가 떠 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.599,
                "end": 33.893
            },
            {
                "speaker_id": "1",
                "transcription": "그 품에는 무언가를 꼭 쥐고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.903,
                "end": 35.879
            },
            {
                "speaker_id": "1",
                "transcription": "아까 고양이 그거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.889,
                "end": 37.601
            },
            {
                "speaker_id": "1",
                "transcription": "햄이네 아이씨 미친놈",
