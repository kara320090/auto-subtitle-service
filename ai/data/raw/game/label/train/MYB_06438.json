        "term": [
            {
                "speaker_id": "1",
                "transcription": "아이 나도 처음으로 다시 되돌아가지 않아서 레버가 그죠?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.166
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 게임들은 저거 레버 막 빙글빙글 돌아가 버리잖아.",
                "sound_type": [
                    2
                ],
                "start": 4.176,
                "end": 15.438
            },
            {
                "speaker_id": "1",
                "transcription": "안전하게 합시다. 무궁화 꽃이 피었겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 15.448,
                "end": 22.419
            },
            {
                "speaker_id": "1",
                "transcription": "나도 할 때는 한다.",
                "sound_type": [
                    2
                ],
                "start": 22.429,
                "end": 25.277
            },
            {
                "speaker_id": "1",
                "transcription": "달려.",
