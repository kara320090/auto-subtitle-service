                    2,
                    3
                ],
                "start": 13.146,
                "end": 20.325
            },
            {
                "speaker_id": "2",
                "transcription": "동생 지켜 동생 없으면 앞으로 불은 누가 끄고 라면은 누가 끓여?",
                "sound_type": [
