        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.190
            },
            {
                "speaker_id": "1",
                "transcription": "원도우와 맥버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.200,
                "end": 6.556
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.566,
                "end": 11.056
            },
            {
                "speaker_id": "1",
                "transcription": "자자 22렙 4일차에 22레벨이면 솔직히 빠른 거 절대 아니고 정말 즐겜하는 사람 기준입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.066,
                "end": 19.581
            },
            {
                "speaker_id": "1",
                "transcription": "저 같은 경우는 방송 생방송에서만 거의 테크를 지금 올리면서 하고 있기 때문에 저는 이 왕국 꾸미기 같은 거는 초반에는 딱히 큰 의미가 있다고 생각하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.591,
                "end": 30.716
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저는 다른 거는 모르겠는데 이거 깔끔해야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.726,
                "end": 35.435
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 이번에 BTS 관련된 꾸미기도 많고 랜드마크도 많이 나왔기 때문에 아 그리고 이렇게 단계 올릴 수 있잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.445,
                "end": 44.623
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 올려주는 게 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.633,
                "end": 46.306
            },
            {
                "speaker_id": "1",
                "transcription": "무조건 기본 재료 생산에서 첫 번째 게 좋은 게 아니라 이런 거 얘도 두 번째 게 더 효율이 제일 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.316,
                "end": 54.866
            }
        ]
    },
