        "term": [
            {
                "speaker_id": "1",
                "transcription": "드래곤 라이딩이라 그거 재밌겠는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.830
            },
            {
                "speaker_id": "2",
                "transcription": "어 홀리 아니 핑키스윗베리맛 쿠키님.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.840,
                "end": 9.229
            },
            {
                "speaker_id": "1",
                "transcription": "너 용의 협곡 변방의 드래곤 라이더 부족 출신이지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.239,
                "end": 14.769
            },
            {
                "speaker_id": "1",
                "transcription": "거기 부족장이랑 같이 베리 주스 마신 것도 한참 옛날이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.779,
                "end": 19.970
            },
            {
                "speaker_id": "1",
                "transcription": "듣기로는 더 이상 드래곤 라이더는 없고 와이번을 잡아 길러 타고 다닌다고 하던데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.980,
                "end": 28.005
            },
            {
                "speaker_id": "1",
                "transcription": "선대 라이더가 죽은 이후로 드래곤의 말을 할 수 있는 자가 나타나지 않았다지?",
                "sound_type": [
