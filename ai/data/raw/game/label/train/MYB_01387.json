        "term": [
            {
                "speaker_id": "1",
                "transcription": "오 이제 이렇게 빨간 물약 나오면은 저러면은 이제 5 초월 됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.543
            },
            {
                "speaker_id": "1",
                "transcription": "자 나머지는 고급으로.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.553,
                "end": 6.973
            },
            {
                "speaker_id": "1",
                "transcription": "근데 슈프림 슈크림 마탕은 왜 만들어라는 건가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.983,
                "end": 13.346
            },
            {
                "speaker_id": "1",
                "transcription": "수호 성전 때문에 그래요 수호 성전.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.356,
                "end": 15.141
            },
            {
                "speaker_id": "1",
                "transcription": "수호 성전에서는 슈크림 대체가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.151,
                "end": 18.242
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 수호 성전은 60 클리어하는 거는 지금 누구나 다 하는 거라 시간 단축이 지금 문제거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.252,
                "end": 25.857
            },
            {
                "speaker_id": "1",
                "transcription": "티어 올리려면.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.867,
                "end": 27.275
            },
            {
                "speaker_id": "1",
                "transcription": "그럴라면은 슈크림이 절대적으로 필요해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.285,
                "end": 29.887
            },
            {
                "speaker_id": "2",
                "transcription": "용을 사냥하고 싶다면.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.897,
                "end": 33.465
            },
            {
                "speaker_id": "1",
                "transcription": "아 깜짝이야.",
                "sound_type": [
                    2
                ],
                "start": 33.475,
                "end": 34.520
            },
            {
                "speaker_id": "2",
                "transcription": "두려워하지 않는.",
