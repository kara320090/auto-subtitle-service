        "term": [
            {
                "speaker_id": "1",
                "transcription": "아이참 시누이가 참 이게 아이구 참 큰 시누이가 미안해 미안하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.453
            },
            {
                "speaker_id": "1",
                "transcription": "아이구 못된 손 아휴 아이 그러니까 시누이가 좋은 거 보여주네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.463,
                "end": 14.592
            },
            {
                "speaker_id": "1",
                "transcription": "시누이한테 이런 거 보다가 들켰네 아이구 이런.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.602,
                "end": 18.522
            },
            {
                "speaker_id": "1",
                "transcription": "아이 올케한테 타이밍 미쳤다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.532,
                "end": 21.510
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 이거 중요한 장면입니다 난 널 지키기 위해 살거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.520,
                "end": 28.286
            },
            {
                "speaker_id": "1",
                "transcription": "우리 자막에 좀 더 집중해봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.296,
                "end": 31.300
            }
        ]
    },
    "summary": "게임 엔딩을 보는데 올케가 방송에 들어와서 들켰고 지금 중요한 장면이니 자막에 집중했으면 한다.",
