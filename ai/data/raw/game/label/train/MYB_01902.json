        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "부족한 재화가 크게 손실 없이 할 수 있는데 특히 지금 보면 별사탕이 아마 다 키우기에는 부족할 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.216
            },
            {
                "speaker_id": "1",
                "transcription": "11성이고 그러면 쿠키하우스 레벨이 9레벨 원래 보통이라면 쿠키성 얘를",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.226,
                "end": 16.088
            },
            {
                "speaker_id": "1",
                "transcription": "12까지 빨리 올리고 쿠키하우스도 9레벨까지 안 올리더라도 12레벨 찍고 다 10레벨 다 찍어주고 이런 과정 거쳐야 되거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.098,
                "end": 25.215
            },
            {
                "speaker_id": "1",
                "transcription": "일단 우선 순위를 정해드리면 쿠키성 얘 11레벨까지 최우선 순위 1순위로 해서 얘 집중해 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.225,
                "end": 33.269
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키하우스 레벨 10레벨 전부 다 찍어주셔야 하거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.279,
                "end": 37.085
            },
            {
                "speaker_id": "1",
                "transcription": "그거에 먼저 우선순위를 해 주시는 목표로 가 주셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.095,
                "end": 41.408
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 요고 영토 확장은 잠깐 우선 순위 조금 뒤로 하고 랜드마크랑 쿠키 하우스 먼저 갑시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.418,
                "end": 49.123
            },
            {
                "speaker_id": "1",
                "transcription": "이거 배치 하셔야 되고 아시다시피 쿠키런 킹덤은 건설 상점에 나와 있는 건 선택이 아니라 필수로 다 지어줘야 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.133,
                "end": 58.574
            },
            {
                "speaker_id": "1",
                "transcription": "별사탕 진짜 부족하니까 일단 요고 다 지어주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.584,
                "end": 62.180
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 다 지어 주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.190,
                "end": 63.808
            },
            {
                "speaker_id": "1",
                "transcription": "알겠죠 이분은 시간이 없어서 가지고 왕국 운영에 생산이나 이런 거에 집중할 수 있는 시간이 없잖아요 그러면 그럴수록 더 많이 얘네들을 신경 많이 써서 지어주셔야 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.818,
                "end": 76.066
            },
            {
                "speaker_id": "1",
                "transcription": "알겠죠 요고는 레벨업 중요해요 얘는 무조건 쭉쭉 올려주세요 쿠키 체력은 상당히 중요하기 때문에 이거 랜드마크는 안 꺼내 놓으면 적용 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.076,
                "end": 87.159
            },
            {
                "speaker_id": "1",
                "transcription": "이거 지어 주셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.169,
                "end": 88.786
            },
            {
                "speaker_id": "1",
                "transcription": "이거 3차 크리스탈인데 정확히 비교를 해드리면 이게 없는 사람과 만렙으로 가지고 있는 사람이 하루에 고기젤리 소모가 30개에서 40개 정도 차이가 나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.796,
                "end": 98.888
            },
            {
                "speaker_id": "1",
                "transcription": "한 달 기준으로 40개씩 30일이면 1200개 가지고 토핑 조각으로 바꾸고 이렇게 하면 계속 계속 남들하고 토핑 스펙 차이가 나요 나는 고기젤리를",
                "sound_type": [
