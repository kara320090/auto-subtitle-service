        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 이벤트 시작과 동시에 저 끝냈습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.700
            },
            {
                "speaker_id": "1",
                "transcription": "과금의 힘으로 이벤트 첫날 자 14일 남은 거 여러분들 저 2시간 컷했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.710,
                "end": 13.297
            },
            {
                "speaker_id": "1",
                "transcription": "이벤트 완료 자 일단 크탈 3000개랑 야 이렇게 이것도 주네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.307,
                "end": 20.013
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이벤트는 끝나갔다 오늘 5초월 5성을 찍으면은 크탈을 무려 7500개 이렇게 대체로 받을 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.023,
                "end": 28.503
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 에픽 선택 상자도 크탈로 대체해서 받을 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.513,
                "end": 34.281
            },
            {
                "speaker_id": "1",
                "transcription": "이거 아시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.291,
                "end": 35.530
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 이벤트 첫날 올클리어 마치도록 하겠습니다.",
