        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러니까 나 아쉬워서 그래. 지금.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.628
            },
            {
                "speaker_id": "1",
                "transcription": "이게 아까도 말씀드렸지만 지금 아니면 못 느끼는 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.638,
                "end": 6.275
            },
            {
                "speaker_id": "1",
                "transcription": "2회차 때는 넘기거든. 이 브금 딱 들으면서 사람들이랑 이 얘기를 할 수 있는 이 시간이 소중한 거지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.285,
                "end": 12.437
            },
            {
                "speaker_id": "1",
                "transcription": "끝날 때가 됐나 보네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.447,
                "end": 14.935
            },
            {
                "speaker_id": "1",
                "transcription": "아하하하하 그걸 욕 먹을 만 했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.945,
                "end": 19.298
            },
            {
                "speaker_id": "1",
                "transcription": "디스 안 당했어요?",
