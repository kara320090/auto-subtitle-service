        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "너무나 딜이 세게 들어오면은 내가 터져버린다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.732
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 치명 그리고 얼마만큼의 폭딜이 그냥 수반적으로 들어가서 피가 못 버티고 터져버리냐 뭐 그런 싸움이 돼버렸어요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.742,
                "end": 12.588
            },
            {
                "speaker_id": "1",
                "transcription": "이번에는 달빛 술사로 들어가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.598,
                "end": 15.875
            },
            {
                "speaker_id": "1",
                "transcription": "다만 블펄이 원래 21퍼센트로 맞춰야 되는데 귀찮아서 그냥 그대로 가겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 15.885,
                "end": 21.588
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 쓸 때는 21퍼 맞춰서 세트 효과 더해서는 맞춰서 가시는 게 저는 무난한 승률이 가장 좋았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.598,
                "end": 28.895
            },
            {
                "speaker_id": "1",
                "transcription": "이게 쿠키 토핑 세팅하는 칸이 좀 더 있으면 좋겠는데 더 이상 세팅하는 칸이 없기 때문에 아 세팅이 힘드네요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.905,
                "end": 42.955
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대 락스타가 시작하자마자 두 번째 스킬 밖에서 죽어버렸고요.",
                "sound_type": [
                    2
                ],
                "start": 42.965,
                "end": 50.125
            },
            {
                "speaker_id": "1",
                "transcription": "네 저는 블랙펄이 이렇게 터져버렸고.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.135,
                "end": 58.566
            }
        ]
    },
    "summary": "딜이 세게 들어오면은 내가 터져버리고 블펄 쓸 때는 21퍼센트 맞춰서 세트 효과를 맞춰서 가는 게 승률이 가장 좋다.",
