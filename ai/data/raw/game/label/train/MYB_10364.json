        "term": [
            {
                "speaker_id": "1",
                "transcription": "걔는 드래곤으로 변신을 하는 거고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 1.650
            },
            {
                "speaker_id": "1",
                "transcription": "타이탄은?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.660,
                "end": 2.721
            },
            {
                "speaker_id": "1",
                "transcription": "아 달메키아 공화국의 후고 쿠프카가 현현한 모습.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.731,
                "end": 7.238
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 근데 거의 귀족처럼 대우받으면서 살고 있는 거 같아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.248,
                "end": 10.995
            },
            {
                "speaker_id": "1",
                "transcription": "각 나라마다 도미넌트를 취급하는 게 약간 다른 게 얘는 완전 귀족처럼 성주고 막 이렇게 살고 있고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.005,
                "end": 19.306
            },
            {
                "speaker_id": "1",
                "transcription": "걔 방금 걔는 드래곤은 왕자고 흑기사 같은 거는 왕이잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.316,
                "end": 26.473
            },
            {
                "speaker_id": "1",
                "transcription": "근데 질이 가지고 있는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.483,
                "end": 31.066
            }
        ]
    },
    "summary": "여자 게임 유튜버는 누구는 성주에 귀족 급으로 대우받으면서 사는 반면 드래곤은 달라서 각 나라마다 도미넌트의 취급이 다르다고 생각한다.",
