        "term": [
            {
                "speaker_id": "1",
                "transcription": "스킬 능력부터 잠깐 보고 가면은 밤하늘의 별들이 쏟아지며 적들에게 피해 증가 디버프입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.334
            },
            {
                "speaker_id": "1",
                "transcription": "달빛이 환하게 빛나며 적들에게 달빛 피해를 주고 수면 효과를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.344,
                "end": 9.192
            },
            {
                "speaker_id": "1",
                "transcription": "수면이 걸리지 않는 적은 졸음 상태가 되고 대상이 수면이 걸릴 수 있는 상태가 될 때 수 졸음이 수면으로 발동된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.202,
                "end": 16.203
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 달빛술사는 꿈에서 깨어날 때 자신의 체력을 회복하는 능력 적이 거는 수면을 이롭게 받아 들여서 수면 종료하면 자신의 체력을 회복한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.213,
                "end": 24.644
            },
            {
                "speaker_id": "1",
                "transcription": "꿈을 꾸는 달빛술사 쿠키는 잠식에 걸리지 않는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.654,
                "end": 28.355
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 최대 체력 비례의 상한선 30만 이렇게 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.365,
                "end": 31.629
            },
            {
                "speaker_id": "1",
                "transcription": "피해 증가는 12초 동안 피해 증가 25퍼센트가 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.639,
                "end": 35.650
            },
            {
                "speaker_id": "1",
                "transcription": "별빛 지속 피해량 1.8초 동안 최대 와 열 번 동안 피해 1회 피해량은 108.5퍼센트 별빛 추가 피해 최대 체력 비례 피해가 있는 5.5퍼센트 별빛 피해 감소 야 피해 감소 또 나왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.660,
                "end": 51.311
            },
            {
                "speaker_id": "1",
                "transcription": "블랙홀처럼 그리고 달빛 피해량은 쿠키 피해량 자체가 공격력이 125퍼센트 플러스 체력 비례 고정 피해 3퍼센트에다가 수면 2초 동안 와",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.321,
                "end": 62.666
            }
        ]
    },
    "summary": "발화자는 달빛술사의 피해량, 공격력 등 스킬 능력을 알아보고 있습니다.",
