                    2,
                    3
                ],
                "start": 47.462,
                "end": 64.206
            },
            {
                "speaker_id": "1",
                "transcription": "힘으로 다 해결하는 편. 아까 내가 눌렀던 거네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.216,
                "end": 76.747
            },
            {
                "speaker_id": "1",
                "transcription": "무너졌나 본데?",
