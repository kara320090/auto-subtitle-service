        "term": [
            {
                "speaker_id": "1",
                "transcription": "자. 와 그러니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.738
            },
            {
                "speaker_id": "1",
                "transcription": "아으 이렇게 문을 여는 거였구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.748,
                "end": 14.563
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 해서 그렇다 한들 앞으로는 물이 없는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.573,
                "end": 23.149
            },
            {
                "speaker_id": "1",
                "transcription": "어 잠수정. 아 깜짝이야 뭐야. 개 같은 거 있지 않았어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.159,
                "end": 36.955
            },
            {
                "speaker_id": "1",
                "transcription": "방금 뭐 지나갔는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.965,
                "end": 47.452
            },
            {
                "speaker_id": "1",
                "transcription": "얼탱구리.",
