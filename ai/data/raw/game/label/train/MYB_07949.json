        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 끝까지 올라간 다음에 푹 찍 엔딩은 아니겠지?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 12.897
            },
            {
                "speaker_id": "1",
                "transcription": "배고파?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.907,
                "end": 24.482
            },
            {
                "speaker_id": "1",
                "transcription": "마법사의 공.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.492,
                "end": 30.280
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 게임은 낙사가 없어서 이렇게 올라가면서 싸워도 간 떨리지가 않는다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.290,
                "end": 37.351
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 멋있는 거 구경하는 느낌.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.361,
                "end": 57.483
            },
            {
                "speaker_id": "1",
                "transcription": "기계 같은 거 다루기가 어려운 게 애가 뭘 하려고 하는 건지 알 수가 없어서 대충 이제 동지부여 가은 거랑 싸우면 뭘 하겠다 뭐 이제 움직임이 보이잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.493,
                "end": 72.051
            },
            {
                "speaker_id": "1",
                "transcription": "근데 저런 기계는 그게 안 보여서.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.061,
                "end": 82.710
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 얼마전에 할 때도 두 번째 모드랑 싸우는 데 힘들었거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.720,
                "end": 88.866
            }
        ]
    },
    "summary": "유튜버는 게임을 하면서 이 게임은 낙사가 없어서 멋있는 거 구경하는 느낌이고 상대가 기계가 나오게 되면 뭘 하려는지 예측하기 어려워서 싸우기 어렵다고 구독자들에게 말합니다.",
