        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇지 에라 모르겠다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.656
            },
            {
                "speaker_id": "1",
                "transcription": "아 아 제발 풀 아 양동이 제발 오 호 호 오우 죽다 살았다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.666,
                "end": 13.019
            },
            {
                "speaker_id": "1",
                "transcription": "오우 진짜 너무 간절했어 야 잠깐만 이거 잘하면 마무리 될 수 있을 거 같아 잠깐만 집중해봐 풀 집중해봐 야 근데 없는데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.029,
                "end": 22.555
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막 도전입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.565,
                "end": 24.042
            },
            {
                "speaker_id": "1",
                "transcription": "자 빠르게 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.052,
                "end": 25.236
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 나 이제 알았어 나 진짜 깰 수 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.246,
                "end": 27.578
            },
            {
                "speaker_id": "1",
                "transcription": "깨야지만 이유가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.588,
                "end": 29.007
            },
            {
                "speaker_id": "1",
                "transcription": "이거 깨면은 양 전용 무슨 스킨을 준다고 하는데 한번 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.017,
                "end": 33.045
            },
            {
                "speaker_id": "1",
                "transcription": "저도 정확히는 몰라요.",
