        "term": [
            {
                "speaker_id": "1",
                "transcription": "넣어버립니다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.068
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 해서 여러분들 세팅할 때 이번 영상의 포인트는 밀키 이렇게 피가 안 높아도 20퍼센트도 가능하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.078,
                "end": 8.777
            },
            {
                "speaker_id": "1",
                "transcription": "4.1억이 나온다 이 20퍼센트도 얘 쿨 공속은 24.9 아니더라도 24.3에다가 공속 더 높게 해도 4.1억 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.787,
                "end": 17.396
            },
            {
                "speaker_id": "1",
                "transcription": "도넛 피감 47.8로도 그렇게 생존했었거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.406,
                "end": 21.675
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 에클레어 같은 경우에는 당연히 피감하고 체력 높아야 생존을 더 잘하는 거고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.685,
                "end": 26.291
            },
            {
                "speaker_id": "1",
                "transcription": "주스는 메테오를 2방 맞냐 3방 맞냐는 제가 해보니까 이 주스 쿨에 따라 달라요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.301,
                "end": 32.078
            },
            {
                "speaker_id": "1",
                "transcription": "너무 많이 주면 안 되고 너무 적게 줘도 안 되고 22.7에서 24.3 사이 그리고 공속은 주니까 저는 안 맞았는데 공석 주는 건 비추고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.088,
                "end": 42.287
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 좀 더 세심하게 볼 때는 주스가 평타를 넣고 스킬 쓰느냐 평타를 넣기 전에 스킬 써서 평타 손해를 보냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.297,
                "end": 50.655
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 여러분들 체크해봐가지고 손해 보는지 확인해보시보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.665,
                "end": 55.507
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 영상은 여기서 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.517,
                "end": 75.000
            }
        ]
    },
    "summary": "토벌에서 밀키 캐릭터가 피가 높지 않아도 높은 점수가 가능하다고 말한다.",
