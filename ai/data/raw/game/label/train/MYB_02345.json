        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "키런 킹덤에 출시된 모든 보물들의 티어를 정리해 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.709
            },
            {
                "speaker_id": "1",
                "transcription": "보물 티어의 기준은 아레나 컨텐츠와 길드 컨텐츠로 각각 나누어 진행해 보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.719,
                "end": 8.839
            },
            {
                "speaker_id": "1",
                "transcription": "보물의 종류는 3가지로 나누어집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.849,
                "end": 11.203
            },
            {
                "speaker_id": "1",
                "transcription": "일반 보물 뽑기 권으로 얻는 일반 보물과 길드 뽑기에서 영웅의 햇불 재화를 사용해서 얻는 길드 보물이 있고 다람쥐 상점에서 얻는 스페셜 보물이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.213,
                "end": 21.112
            },
            {
                "speaker_id": "1",
                "transcription": "일반 보물 길드 보물은 길드 토벌전이나 아레나에서 활용될 때가 있지만 스페셜 보물은 예능용 보물이라 뽑지 않아도 상관은 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.122,
                "end": 30.008
            },
            {
                "speaker_id": "1",
                "transcription": "일반 보물 뽑기는 크리스탈로 뽑으면 손해입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.018,
                "end": 32.698
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키를 뽑고 쌓이는 마일리지를 보물 뽑기 권으로 바꿔서 뽑는 게 크리스탈 대비 더 효율적이고 이득입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.708,
                "end": 39.619
            },
            {
                "speaker_id": "1",
                "transcription": "가장 중요한 점은 보물의 등급과 티어는 전혀 무관하며 커먼 보물이라도 0 티어가 될 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.629,
                "end": 47.371
            },
            {
                "speaker_id": "1",
                "transcription": "현재 보물의 티어는 4월 14일 기준 유행하는 아레나 조합과 토벌전 대표 조합을 기준으로 제작된 점을 알아주셨으면 좋겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.381,
                "end": 55.784
            },
            {
                "speaker_id": "1",
                "transcription": "추후에 업데이트를 통해 조합이 바뀌면 티어도 바뀔 수 있으니 최신 티어를 확인해 주시길 바랍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.794,
                "end": 63.366
            }
        ]
    },
    "summary": "화자는 보물의 종류와 얻는 방법 등을 소개하며 현재 날짜를 기준으로 보물의 단계를 정리해서 알려준다.",
