        "term": [
            {
                "speaker_id": "1",
                "transcription": "파르페가 아주 크게 야 진짜 어마 무시하게 크게 작용하겠네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 12.233
            },
            {
                "speaker_id": "1",
                "transcription": "봐 보세요. 소르베가 아무것도 못해 거의 소르베덱한테 너무 극강인데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.243,
                "end": 29.772
            },
            {
                "speaker_id": "1",
                "transcription": "와 잠깐만 야 이거 용과는 죽지 않았다. 네 30초 용은 죽지 않는다. 아 근데 이건 난 되게 좋게 잘 나왔다고 봐요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.782,
                "end": 39.009
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면은 나는 기존에 내가 되게 비판적으로 했던 게 뭐였냐면은 쿠키런 킹덤은 킬러 자리를 대체할 게 너무 없었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.019,
                "end": 48.140
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키 같은 경우에도 BTS 말고는 대체해서 쓸 게 아무것도 없었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.150,
                "end": 53.794
            },
            {
                "speaker_id": "1",
                "transcription": "퓨어바닐라 고대 쿠키라 키울 것도 없지 초보자분들이 근데 이제는 스냅드래곤은 무료로 뽑기로 가능하지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.804,
                "end": 60.620
            },
            {
                "speaker_id": "1",
                "transcription": "파르페는 이제 초보자분들이 기존 에픽이니까 뽑아서 마탕으로 키울 수 있지.",
                "sound_type": [
                    2,
                    3
                ],
