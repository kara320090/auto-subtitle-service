        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 본게임을 들어가 보면 될 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.861
            },
            {
                "speaker_id": "1",
                "transcription": "마을에 어마무시한 우유맛 키 뽑기 기원하면서 보물부터 일단 다 가도록 하겠습니다.",
