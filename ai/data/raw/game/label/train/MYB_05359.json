                    3,
                    5
                ],
                "start": 3.871,
                "end": 10.414
            },
            {
                "speaker_id": "1",
                "transcription": "신보물도 이번에 딱히 지금 쓰이고 있진 않네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.424,
                "end": 13.449
            },
            {
                "speaker_id": "1",
                "transcription": "원래 신규 보물이 어 이게 뭐야 4개나 나왔어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.459,
                "end": 16.290
            },
            {
                "speaker_id": "1",
                "transcription": "원래 신규 보물이 좋으면 바로 바로 실전에 투입되어서 많이 쓰이는데 현재로써 따로 쓰이고 있는 분야가 딱히 없는 상태입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.300,
                "end": 25.685
            },
            {
                "speaker_id": "1",
                "transcription": "스킨 뽑기에서 에스프레소 스킨을 원한다.",
                "sound_type": [
