        "term": [
            {
                "speaker_id": "1",
                "transcription": "부계정 키우기 오늘 7일차 리뷰 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.251
            },
            {
                "speaker_id": "1",
                "transcription": "제가 좀 몇 개는 해놨거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.261,
                "end": 5.549
            },
            {
                "speaker_id": "1",
                "transcription": "왕국도 조금 넓혀놨고 그다음에 보시는 거와 같이 해변도 많이 넓혀놨습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.559,
                "end": 12.842
            },
            {
                "speaker_id": "1",
                "transcription": "지금 쿠키성이 오늘 7일차인데 이렇게 8렙으로 넘어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.842,
                "end": 18.213
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 여러분들 지금 코인이 좀 남아도는데 허튼 데다가 많이 안 쓰면은 원래 이 정도 남는 게 정상이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.223,
                "end": 24.268
            },
            {
                "speaker_id": "1",
                "transcription": "가끔 가다가 왕국 레벨업 하는데 코인이 부족하다는 분들 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.278,
                "end": 28.102
            },
            {
                "speaker_id": "1",
                "transcription": "그런 분들은 뭔가 좀 토핑 강화 같은 데다가 잘못 쓰고 있는 겁니다.",
                "sound_type": [
                    2,
