        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.043
            },
            {
                "speaker_id": "1",
                "transcription": "방치형 모바일 게임을 편하게 모니터링 가능하며 핸드폰 발열이나 배터리 부족으로 인한 불편함도 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.053,
                "end": 8.142
            },
            {
                "speaker_id": "1",
                "transcription": "PC에서 큰 화면에 초고화질로 몰입할 수 있는 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.152,
                "end": 12.337
            },
            {
                "speaker_id": "1",
                "transcription": "자 제일 먼저 캡사이신 방덱 이쪽으로 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.347,
                "end": 16.541
            },
            {
                "speaker_id": "1",
                "transcription": "자 대부분의 방덱은 여러분들 보시는 거와 같이 캡사이신 홀리베리 세팅으로 많이 되어 있을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.551,
                "end": 22.910
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 이 덱의 가장 큰 장점 달빛수사와 네 블랙펄의 스킬 타이밍이 정말 예술이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.920,
                "end": 31.746
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 보시면 되고 상대방 분이 BTS보다는 퓨어 바닐라도 되어 있을 때 승률이 더 높긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.756,
                "end": 41.200
            }
        ]
    },
    "summary": "이 덱의 가장 큰 장점은 달빛수사와 블랙펄의 스킬 타이밍이 정말 예술이라고 남자가 말하고 있다.",
