                    5
                ],
                "start": 13.744,
                "end": 20.544
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 우와 스킨 뽑기도 진짜 안 하셨구나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.554,
                "end": 25.030
            },
            {
                "speaker_id": "1",
                "transcription": "이거 무과금으로 하신 거거든요.",
