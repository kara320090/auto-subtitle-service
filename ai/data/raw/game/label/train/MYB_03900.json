        "term": [
            {
                "speaker_id": "1",
                "transcription": "비빔면이랑 삼겹살 먹었다구요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.237
            },
            {
                "speaker_id": "1",
                "transcription": "환상의 콜라보를 해서 드셨구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.247,
                "end": 5.188
            },
            {
                "speaker_id": "1",
                "transcription": "어 비빔면에 삼겹살이라 배고프다 나도.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.198,
                "end": 8.527
            },
            {
                "speaker_id": "1",
                "transcription": "오 오이스터까지 여러분들 이분 난리 났다 난리 났어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.537,
                "end": 13.837
            },
            {
                "speaker_id": "1",
                "transcription": "근데 나는 비빔면에 삼겹살도 좋지만 저는 김치말이 소면이랑 삼겹살 조합도 상당히 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.847,
                "end": 21.339
            },
            {
                "speaker_id": "1",
                "transcription": "오야 오이스터 뭐야?",
