    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤에 예언자 맛 쿠키가 출시되고 나서 많은 분들이 예측하기에는 마도시가 나올 것이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.036
            },
            {
                "speaker_id": "1",
                "transcription": "마도시 관련된 거는 달빛 술사가 나올 것이다 이렇게 예측을 해왔는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.046,
                "end": 11.575
            },
            {
                "speaker_id": "1",
                "transcription": "이미 유출된 내용으로 예언자 맛 쿠키도 예측이 됐었고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.585,
                "end": 15.581
            },
            {
                "speaker_id": "1",
                "transcription": "2주년 업데이트로 마도시 그리고 달빛 술사가 예고되어있는 상태입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.591,
                "end": 21.558
            },
            {
                "speaker_id": "1",
                "transcription": "물론 공식적으로 나온 상황은 아니고 이미 유출하는 분이 자료를 다 뽑아서 이제 뭐 다 퍼졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.568,
                "end": 28.882
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤에 조금 관심을 가지고 있는 분이라면 대부분 소식을 다 접했을 텐데 유출된 내용을 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.892,
                "end": 35.740
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 달빛 술사 능력이 이렇게 유출이 됐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.750,
                "end": 40.050
            },
            {
                "speaker_id": "1",
                "transcription": "보면은 마법 형으로 출시가 되고 가운데, 가운데 배열이 되고 레전더리 등급으로 출시되고 출시 일자도 이렇게 되어있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.060,
                "end": 48.865
            },
            {
                "speaker_id": "1",
                "transcription": "1월 19일 2023년.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.875,
                "end": 50.729
            },
            {
                "speaker_id": "1",
                "transcription": "우측에 보면은 실제로 능력까지 유출이 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.739,
                "end": 54.860
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 이름은 밤 하늘의 꿈 이렇게 보이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.870,
                "end": 57.770
            },
            {
                "speaker_id": "1",
                "transcription": "달빛 술사가 밤 하늘 위에서 잠이 들어 꿈을 꾼다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.780,
                "end": 61.733
            },
            {
                "speaker_id": "1",
                "transcription": "밤 하늘의 별들이 쏟아지며 적들에게 피해를 입힌다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.743,
                "end": 65.787
            },
            {
                "speaker_id": "1",
                "transcription": "달빛 술사가 나오면 어떤 식으로 되는지 대충 예측을 해봤을 때는 어떻게 되냐면은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.797,
                "end": 71.791
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키 아시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.801,
                "end": 73.326
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키의 능력을 살짝 보게 되면은.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.336,
                "end": 76.585
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 블랙펄 쿠키의 스킬 능력을 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.595,
                "end": 80.840
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 스킬 발동하면은 블랙펄이 이렇게 앞으로 갔다가 이렇게 돌아오면서 제자리 오죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.846,
                "end": 86.133
            },
            {
                "speaker_id": "1",
                "transcription": "달빛 술사도 마찬가지 달빛 술사 이미지가 이렇게 있으면 그믐달을 타고 이렇게 쭉 날아가는 형식으로 갔다가 이렇게 돌아오는 형식으로 되지 않을까 옛날부터 제가 이렇게 예측을 해왔는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.143,
                "end": 97.849
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 그런 능력이 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.859,
                "end": 100.630
            },
            {
                "speaker_id": "1",
                "transcription": "밤 하늘의 별들이 쏟아지며 적들에게 피해를 입힌다 이렇게 되어 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.640,
                "end": 104.724
            },
            {
                "speaker_id": "1",
                "transcription": "이후 달빛이 환하게 빛나며 적들에게 달빛 피해를 주고 달빛 피해 저거 상당히 딜이 세겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 104.734,
                "end": 113.054
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 수면을 건다 이것도 예측이 되었던 부분입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.064,
                "end": 117.373
            },
            {
                "speaker_id": "1",
                "transcription": "수면을 건다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 117.373,
                "end": 118.460
            },
            {
                "speaker_id": "1",
                "transcription": "좀 새로운 상태 이상인 것 같아요 수면 피해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 118.460,
                "end": 121.236
            },
            {
                "speaker_id": "1",
                "transcription": "달빛 술사는 꿈에서 깨어날 때 자신의 체력을 회복하며 적이 거는 수면을 이롭게 받아들여 수면이 종료되면 자신의 체력을 회복한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 121.246,
                "end": 133.797
            },
            {
                "speaker_id": "1",
                "transcription": "상대방이 수면을 거는 달빛 술사가 똑같이 있으면은 나쁘게 받아들이지 않고 회복하는 이렇게 받아들이는 특이한 컨셉이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 133.807,
                "end": 142.090
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 정말 사기적인 쿠키가 될 것 같고 현재 아직도 수많은 모든 아레나 유저가 BTS 쿠키 필수로 다 쓰고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 142.100,
                "end": 151.315
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 이게 문제가 뭐냐면 2주년 때 BTS 쿠키 뽑을 수가 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 151.325,
                "end": 156.282
            },
            {
                "speaker_id": "1",
                "transcription": "패치가 되면 종료가 되기 때문에 더 이상 뽑을 수 없는 쿠키가 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 156.292,
                "end": 160.639
            },
            {
                "speaker_id": "1",
                "transcription": "수많은 복귀 유저분들이나 신규 유저분들 입장에서 아직도 아레나에서 BTS 쿠키가 0티어로 쓰이고 있다면은 게임에 치명적인 영향을 미칠 수 있기 때문에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 160.649,
                "end": 171.463
            },
            {
                "speaker_id": "1",
                "transcription": "제가 생각하기에는 달빛 술사 쿠키가 등장함으로써 BTS 쿠키의 시대는 끝나지 않을까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 171.473,
                "end": 179.750
            }
        ]
    },
    "summary": "남성 화자가 쿠키런 킹덤 게임에서 유출된 달빛 술사 쿠키의 능력을 소개하며 새로운 상태 이상이 될 것 같다 말하고 사기적인 쿠키가 있겠지만 패치가 종료되면 BTS 쿠키는 더 이상 뽑을 수 없기 때문에 치명적인 영향을 미칠 수 있을 거라고 말한다.",
