                    5
                ],
                "start": 0.000,
                "end": 3.660
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 어차피 많이 뽑다 보면 5 초월이 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.660,
                "end": 5.890
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 초월이 넘어가면 얘는 이제 빨간 영혼석 물약이 나오거든요?",
                "sound_type": [
