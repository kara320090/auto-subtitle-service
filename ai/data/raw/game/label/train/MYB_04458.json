        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 야 이거 진짜 답답하다 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.322
            },
            {
                "speaker_id": "1",
                "transcription": "어느 세월에 잡아 못 잡는 거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.332,
                "end": 4.491
            },
            {
                "speaker_id": "1",
                "transcription": "제한 시간 안에 아니 얘를 도대체 얼마나 상향시켜줘야 조으 좋게 쓰일까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.501,
                "end": 8.860
            },
            {
                "speaker_id": "1",
                "transcription": "야 딜이 진짜 똥이야 이런 말하기 그런데 자 여러분들 더 이상 못 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.870,
                "end": 14.027
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 그 시간이 아깝기 때문에 나가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
