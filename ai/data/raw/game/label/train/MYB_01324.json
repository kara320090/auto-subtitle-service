        "term": [
            {
                "speaker_id": "1",
                "transcription": "어 망고 활용한 한방덱이 따로 나오면은 그건 따로 리뷰 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.620
            },
            {
                "speaker_id": "1",
                "transcription": "제 일부러 안 했어요. 한방덱으로는 일부러 아레나 정석덱으로 제가 따로 찾아볼라고 제가 한번 영상 찍기 전에 구상해 본 거 한번 해봤는데 아주 예쁜 그림으로 잘됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.630,
                "end": 15.981
            },
            {
                "speaker_id": "1",
                "transcription": "토벌은 제가 스무스하게 해 봤는데 마탕이 없을 때는 2억 9700 30강 마탕 찍는 순간 3억이 올라서 6억이 됐다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.991,
                "end": 24.296
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서도 요덱으로 되게 좋아요. 어떤 그림이냐면은 피해 증가 얘가 묻히고요 용과 브레스로 1분 타임 때 상대 싹 다 녹여버리는 그림 다만 상대가 소르베가 있으면 스킬 꼬여가지고 지는 그림 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.306,
                "end": 37.652
            },
            {
                "speaker_id": "1",
                "transcription": "망고 마탕 토벌에 진심인 분이라면 할 가치가 있다. 아레나에서도 좋고 토벌에서도 좋고 이제 망고 리뷰는 여기서 마무리",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.662,
                "end": 52.900
            }
        ]
    },
