        "term": [
            {
                "speaker_id": "1",
                "transcription": "낮은 애들한테만 들어가야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.005
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 아무 상대한테 다 들어가면 되는 게 아니라 상대가 락스타가 있는 락스타가 있는 2탱커 조합한테 들어가면은 극딜 조합으로 상대를 죽일 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.015,
                "end": 14.748
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방이 지금 락스타랑 이렇게 블랙펄 쿠키 쓰는데 보시면 아시겠지만 블랙펄이 잼스톤 20강이 넘는 분이에요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.758,
                "end": 23.298
            },
            {
                "speaker_id": "1",
                "transcription": "그럼에도 불구하고 순삭으로 녹일 수가 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.308,
                "end": 26.205
            },
            {
                "speaker_id": "1",
                "transcription": "자 다른 분도 가겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 26.215,
                "end": 27.510
            },
            {
                "speaker_id": "1",
                "transcription": "이번엔 대놓고 락스타인 게 보이죠?",
                "sound_type": [
                    2
                ],
                "start": 27.520,
                "end": 30.119
            },
            {
                "speaker_id": "1",
                "transcription": "일단 너무나 감사하죠.",
                "sound_type": [
                    2
                ],
                "start": 30.129,
                "end": 31.859
            },
            {
                "speaker_id": "1",
                "transcription": "바로 들어가면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 31.869,
                "end": 33.748
            },
            {
                "speaker_id": "1",
                "transcription": "락스타가 아니라 달빛술사나",
                "sound_type": [
