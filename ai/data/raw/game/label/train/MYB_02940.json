    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상은 길드 토벌전 감초 보스 토벌전 영상입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.353
            },
            {
                "speaker_id": "1",
                "transcription": "자 먼저 세팅부터 알려드리면 망토 보물을 쓰게 되고 여기서 여러분들 하나 아셔야 될 게 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.363,
                "end": 10.533
            },
            {
                "speaker_id": "1",
                "transcription": "감초 토벌전 같은 경우에는 보스 이제 쫄이 나오는데 쫄한테 들어가는 데미지가 보스 체력을 닳게 하는 그런 특이한 구조의 이제 보스 토벌전이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.543,
                "end": 23.051
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들이 이제 딜을 너무 높게 세팅을 하게 되면은 쫄을 일찍 죽이게 돼서 오히려 손해 보는 일이 나오게 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.061,
                "end": 31.358
            },
            {
                "speaker_id": "1",
                "transcription": "제가 보여드리는 세팅 그대로 따라 하지 마시고 좀 바꿔서 여러분들만의 그런 세팅을 꼭 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.368,
                "end": 38.795
            },
            {
                "speaker_id": "1",
                "transcription": "빌드 자체는 되게 쉬워요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.805,
                "end": 40.363
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 진행되고 5번만 터치되는 쉬운 빌든데 세팅만큼은 여러분들 능력껏 각자 상황에 맞게 바꿔주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.373,
                "end": 49.836
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리 같은 경우에는 자 쿨타임 같은 경우에는 여러분들이 꼭 맞춰 주시면은 자동으로 편하게 따라 하실 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.846,
                "end": 56.601
            },
            {
                "speaker_id": "1",
                "transcription": "다만 여기서 이제 공격력과 치명타 요 옵션은 제가 일부러 뺏어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.611,
                "end": 61.137
            },
            {
                "speaker_id": "1",
                "transcription": "토벌에서 쫄이 너무 쉽게 죽기 때문에 아예 저는 없는 상태이지만 스펙이 낮은 분들은 당연히 공격력과 치명타 확률이 있는 게 더 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.147,
                "end": 70.189
            },
            {
                "speaker_id": "1",
                "transcription": "자 피해감소는 여러분들 홀리베리 안 죽을 정도로 세팅해 주시고 웨어울프 같은 경우에는 쿨 9퍼센트 공속은 7퍼센트 이렇게 맞췄습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.199,
                "end": 78.853
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 요것도 공치 여러분들 쫄 안 죽는 범위내에서 각자 세팅을 하시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.863,
                "end": 84.108
            },
            {
                "speaker_id": "1",
                "transcription": "자 마카롱은 쿨타임 한 24.5퍼센트 이상 공속은 한 줄 더 줬고 공치도 마찬가지 너무 과하게 많이 주면 쫄이 다 죽어서 손해 볼 수도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.118,
                "end": 94.245
            },
            {
                "speaker_id": "1",
                "transcription": "자 오먹같은 경우에도 죽는다면 피감 주시면 되고 공속은 12퍼센트 가까이 그다음에 공치 여러분 능력껏 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 94.255,
                "end": 102.697
            },
            {
                "speaker_id": "1",
                "transcription": "목화 같은 경우에는 24.3퍼센트 근처 그리고 공치 능력껏 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 102.707,
                "end": 109.600
            }
        ]
    },
    "summary": "남성이 준비한 이번 영상은 감초 보스 토벌전으로 쫄이 나오는데 쫄한테 들어가는 데미지가 보스 체력을 다 닳게 하는 그런 특이한 구조라서 쫄을 일찍 죽여서 오히려 손해 보는 일이 나오므로 각자 상황에 맞게 바꿔서 세팅해야 하며 남성은 망토 보물을 쓰게 된다고 한다.",
