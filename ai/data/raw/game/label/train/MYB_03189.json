        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "안 한지 오래된 거 같은 각성탈 때문에 고생한 거 생각나네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.298
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 각설탕이 참 여럿 사람 스트레스 많이 주게했죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.308,
                "end": 8.981
            },
            {
                "speaker_id": "1",
                "transcription": "저거 모자르면은 뭐 계속 다른 생산품 생산을 못하니까 뉴비는 보물을 뭘 뽑아야 할까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.991,
                "end": 16.495
            },
            {
                "speaker_id": "1",
                "transcription": "맨 처음에 선택하는 거 무공비급, 부활, 공속 요 3개?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.505,
                "end": 21.166
            },
            {
                "speaker_id": "1",
                "transcription": "처음에 신보는 처음에 안 뽑아도 되나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.176,
                "end": 24.077
            },
            {
                "speaker_id": "1",
                "transcription": "신보 아 신보도 괜찮죠 그냥 공속을 만약에 하나 뽑아 놓으면은 무공비급, 부활, 호루라기 이렇게 뽑으세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.087,
                "end": 32.435
            },
            {
                "speaker_id": "1",
                "transcription": "딱 하나만 뽑아놓으세요 하나만.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.445,
                "end": 34.352
            },
            {
                "speaker_id": "1",
                "transcription": "공속은 자 뽑기 바로 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.362,
                "end": 37.500
            }
        ]
    },
    "summary": "각성탕이 없으면 다른 생산품 생산을 못하기 때문에 각성탕 때문에 고생한 사람이 많고 뉴비들은 처음에 무공비급, 부활, 공속 선택하면 됩니다.",
