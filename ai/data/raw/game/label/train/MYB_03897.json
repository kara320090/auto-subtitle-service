        "term": [
            {
                "speaker_id": "1",
                "transcription": "음유시인 다 됐기 때문에 고급으로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.159
            },
            {
                "speaker_id": "1",
                "transcription": "오 다크 카카오 저 진짜 잘 뽑죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.169,
                "end": 5.963
            },
            {
                "speaker_id": "1",
                "transcription": "바로 하나 나왔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.973,
                "end": 7.208
            },
            {
                "speaker_id": "1",
                "transcription": "말하는 대로 잘 나와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.218,
                "end": 8.946
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 소르베 하나 더 뽑으면은 진짜 소름이지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.956,
                "end": 19.952
            },
            {
                "speaker_id": "1",
                "transcription": "하나만 더 뽑을게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.962,
                "end": 22.651
            },
            {
                "speaker_id": "1",
                "transcription": "와 난 진짜 처음이야 크탈 뽑기로 소르베 뽑은 거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.661,
                "end": 25.873
            },
            {
                "speaker_id": "1",
                "transcription": "어우 우리의 홀베 예 홀베도 뭐 언젠가 상향되겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.883,
                "end": 31.817
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 홀리베리가 저번 시즌에 잠깐 반짝였거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.827,
                "end": 36.694
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐 아레나 1티어까지 올라갔다가 지금 다시 곤두박질쳤습니다.",
                "sound_type": [
                    2,
                    3
                ],
