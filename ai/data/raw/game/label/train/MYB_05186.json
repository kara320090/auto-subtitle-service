        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아까는 처음이라 놀라서 그렇지 다시 가면 잘할 수 있습니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.830
            },
            {
                "speaker_id": "2",
                "transcription": "수 숨 돌렸으니 이제 괜찮습니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 4.840,
                "end": 7.136
            },
            {
                "speaker_id": "3",
                "transcription": "다들 조용 너희들이 이 배에 오를 때 내가 가장 먼저 한 말이 뭔지 기억하나?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 7.146,
                "end": 14.009
            },
            {
                "speaker_id": "4",
                "transcription": "어디 가서 사고치지 마라.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 14.019,
                "end": 16.134
            },
            {
                "speaker_id": "5",
                "transcription": "우린 해적이 아니라 해군이다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 16.144,
                "end": 18.584
            },
            {
                "speaker_id": "2",
                "transcription": "저한테는 아무 말 안 했는데요.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 18.594,
                "end": 20.535
            },
            {
                "speaker_id": "3",
                "transcription": "에 바다를 만만하게 보지 말라는 거였지.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 20.545,
                "end": 24.332
            },
            {
                "speaker_id": "3",
                "transcription": "아무래도 이 일은 나 혼자 해결해야 할 것 같다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 24.342,
                "end": 29.254
            },
            {
                "speaker_id": "5",
                "transcription": "대회 때처럼 또 혼자 다 하시려고요?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 29.264,
                "end": 32.070
            },
            {
                "speaker_id": "3",
                "transcription": "애초에 내 일이었어.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 32.080,
                "end": 34.598
            },
            {
                "speaker_id": "3",
                "transcription": "별 일 아닐 것 같아서 같이 나들이나 나오자고 한 거지.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 34.608,
                "end": 39.136
            },
            {
                "speaker_id": "5",
                "transcription": "그게 무슨",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 39.146,
                "end": 40.852
            },
            {
                "speaker_id": "4",
                "transcription": "자자 진정하라고 우리 캡틴은 정말 걱정도 많으시다니까.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 40.862,
                "end": 46.889
            },
            {
                "speaker_id": "3",
                "transcription": "거 그럼 니가 선정하든지.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 46.899,
                "end": 49.199
            },
            {
                "speaker_id": "4",
                "transcription": "아이 그건 좀 헤헷.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 49.209,
                "end": 51.800
            },
            {
                "speaker_id": "3",
                "transcription": "내 걱정은 마라.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 51.810,
                "end": 53.069
            },
            {
                "speaker_id": "3",
                "transcription": "잠수정을 타고 갈 생각이니까.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 53.079,
                "end": 55.661
            },
            {
                "speaker_id": "4",
                "transcription": "예이, 알겠습니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 55.671,
                "end": 57.881
            },
            {
                "speaker_id": "4",
                "transcription": "그렇게까지 말씀하시면 더 말릴 수야 없죠.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 57.891,
                "end": 61.615
            },
            {
                "speaker_id": "4",
                "transcription": "캡틴이 무사 귀환할 때까지 우린 배 잘 지키고 있겠습니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 61.625,
                "end": 67.466
            }
        ]
    },
    "summary": "캡틴은 바다를 만만하게 보지 말라며 혼자 해결해야 할 것 같다고 이야기한다.",
