        "term": [
            {
                "speaker_id": "1",
                "transcription": "받는 돈에 비하면 그 값어치가 많긴 많네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.944
            },
            {
                "speaker_id": "1",
                "transcription": "바깥에서 아주 그냥 목숨 걸고 싸우고 집에 들어와도 1000원 주는데 여기서 어떻게 올라가냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.954,
                "end": 13.012
            },
            {
                "speaker_id": "1",
                "transcription": "나가는 길이 어디야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.022,
                "end": 16.035
            },
            {
                "speaker_id": "1",
                "transcription": "여기 어떻게 가.",
                "sound_type": [
                    2
                ],
                "start": 16.045,
                "end": 19.217
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 이어지는 길이 있는 거 같은데 어 모자람 없이 모.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.227,
                "end": 32.942
            },
            {
                "speaker_id": "1",
                "transcription": "모자람 없이 여기서 이렇게 가면 또 포라바 방목지라는 거 알려주는 퀘스트인가보다.",
                "sound_type": [
                    2,
