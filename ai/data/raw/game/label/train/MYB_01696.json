        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 과금은 얼마나 하시나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.207
            },
            {
                "speaker_id": "1",
                "transcription": "1달 기준",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.217,
                "end": 2.825
            },
            {
                "speaker_id": "2",
                "transcription": "부캐들 현질하는 거는 제외하고 1달에 한 100에서 150은 하는 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.835,
                "end": 8.170
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 이 게임의 운영에 대해서 어떻게 생각하시나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.180,
                "end": 11.247
            },
            {
                "speaker_id": "2",
                "transcription": "아직은 여전히 토벌전에 대해서 아직은 베커가 아직 관심이 조금 없는 거 같고 콘텐츠를 내달라는 기대는 안 하고 지금 있는 콘텐츠를 조금씩 보완해 나가면서 조금씩 제대로 된 콘텐츠를 하나하나씩 다시 만들어 가는 게 좋지 않나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.257,
                "end": 24.608
            },
            {
                "speaker_id": "1",
                "transcription": "제일 좋아하는 쿠키 뭔가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.618,
                "end": 26.302
            },
            {
                "speaker_id": "2",
                "transcription": "제일 좋아하는 쿠키 서리 여왕입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.312,
                "end": 28.242
            },
            {
                "speaker_id": "1",
                "transcription": "아 서리 여왕을 제일 좋아하신다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.252,
                "end": 30.550
            },
            {
                "speaker_id": "1",
                "transcription": "데브한테 일침 한번 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.560,
                "end": 32.542
            },
            {
                "speaker_id": "2",
                "transcription": "데브한테 일침을 놔줄 유저가 아직 남아있다는 게 되게 소중하게 느껴야 되는데 일침을 놔주는 사람조차도 없으면은 그건 정말 망겜이 됐다는 의미이기 때문에 지금이라도 저는 정신을 차려주면 좋겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.552,
                "end": 44.169
            },
            {
                "speaker_id": "1",
                "transcription": "군인이신데 그마 1유지 어떻게 하시나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.179,
                "end": 46.753
            },
            {
                "speaker_id": "2",
                "transcription": "아 이게 저는 방덱을 짜는 거를 되게 중요하게 생각을 하는 게 약간 조금 까다로운 분들이 있으면은 그거를 녹화를 해가지고 상대방 쿨을 따서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.763,
                "end": 55.800
            }
        ]
    },
    "summary": "남성은 1달에 100에서 150 정도 과금하고 게임의 운영은 토벌전에 대한 관심이 아직 없는 거 같아서 조금씩 제대로 된 콘텐츠를 다시 만들어 가길 바란다고 답변한 후 그마 1 유지는 방덱 짜는 걸 중요하게 생각해서 상대방의 쿨을 딴다고 말한다.",
