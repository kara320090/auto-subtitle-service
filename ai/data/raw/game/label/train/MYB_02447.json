        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상은 빙결덱 관련 조합 두 가지를 알려 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.796
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 제일 여러분들이 눈에 띄는 거는 무공 비급이 아닌 왜 레어 등급의 무공 비급을 썼냐 여러분들 지금 현재 상황이 어떻냐면은 지금 제 랭킹 기준으로 탑 30 그마 안에서도 빙결덱이 단 한 명도 공격이 들어오지 않고 있는 상황입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.806,
                "end": 23.200
            },
            {
                "speaker_id": "1",
                "transcription": "왜 그렇냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.210,
                "end": 24.079
            },
            {
                "speaker_id": "1",
                "transcription": "현재 여러분들 방덱이 어떤 식으로 세팅돼 있냐면 캡사이신이 올 라즈베리예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.089,
                "end": 29.884
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 이제 스타더스트랑 달빛술사가 공격이 들어오게 되면 딜을 감당을 거의 못합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.894,
                "end": 36.497
            },
            {
                "speaker_id": "1",
                "transcription": "거의 순식간에 녹아버리는 상황 때문에 최상위권에서도 빙결덱을 쓰기가 참 부담스러운 상황입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.507,
                "end": 43.419
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요즘에는 빙결덱에 그냥 무공 비급만 쓰지 않고 레어 무공 비급을 써가지고 소르베나 이제 서리여왕이 쉽게 그냥 녹아내리는 걸 방지할라고 방어력 30퍼센트가 붙은 레어 무공 비급을 사용을 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.429,
                "end": 59.903
            },
            {
                "speaker_id": "1",
                "transcription": "자 4번 5번 이렇게 둘 다 레어 무공 비급을 쓸 거고 물론 이런 분들 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.913,
                "end": 64.333
            },
            {
                "speaker_id": "1",
                "transcription": "아 저는 피해 감소가 워낙 높게 잘 세팅이 돼 있어서 그냥 일반 무공 비급을 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.343,
                "end": 70.227
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 말리지는 않지만 정말 소르베가 요새 그냥 시작하자마자 녹는 경우도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.237,
                "end": 76.154
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 가급적이면은 어 레어 무공 비급 써서 생존율을 높여 주는 것도 좋은 방법이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.164,
                "end": 83.666
            }
        ]
    },
    "summary": "방덱이 어떤 식으로 세팅돼 있냐면 캡사이신이 올 라즈베리고 거기다가 스타더스트랑 달빛술사가 공격이 들어오게 되면 딜 감당을 거의 못한다고 남자가 설명하고 있다.",
