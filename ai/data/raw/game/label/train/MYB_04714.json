        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 야 이거 너무 단단한데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.622
            },
            {
                "speaker_id": "1",
                "transcription": "와 이거 너무 단단하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.632,
                "end": 6.571
            },
            {
                "speaker_id": "1",
                "transcription": "모노클 덱한테 피감 높게 세팅한 올 아몬드 덱은 안 통한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.581,
                "end": 11.126
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거는 안 통하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.136,
                "end": 15.310
            },
            {
                "speaker_id": "1",
                "transcription": "야 완전 아몬드 덱한테는 힘드네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.320,
                "end": 17.968
            },
            {
                "speaker_id": "1",
                "transcription": "자 공속 덱한테 1번 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.978,
                "end": 19.703
            },
            {
                "speaker_id": "1",
                "transcription": "3탱 1힐 덱은 힘들죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.713,
                "end": 21.921
            },
            {
                "speaker_id": "1",
                "transcription": "원래 용구 덱이 3탱 덱한테는 힘들어서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.931,
                "end": 24.069
            },
            {
                "speaker_id": "1",
                "transcription": "방금 덱은 아마 일반 용구 덱도 힘들었을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.079,
                "end": 29.145
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 공속 덱도 앞에 찰스가 없으면은 1방에 순삭한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.155,
                "end": 34.832
            },
            {
                "speaker_id": "1",
                "transcription": "딜량을 보게 되면 요렇게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.842,
                "end": 37.966
            }
        ]
    },
