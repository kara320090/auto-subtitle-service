        "term": [
            {
                "speaker_id": "1",
                "transcription": "던지는 게 그냥 폭딜이야 요 봐야 요 봐 근데 이거는 요 크런치 덱 상대일 때 그때 요렇게 뻥딜이 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 10.086
            },
            {
                "speaker_id": "1",
                "transcription": "회복량 자체는 낮아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.086,
                "end": 11.946
            },
            {
                "speaker_id": "1",
                "transcription": "지금 제가 방 덱으로 해놓은 요 크런치 덱이 정말 엄청나게 방 덱으로 좋고 사람들이 많이 쓰거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.956,
                "end": 18.168
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱 같은 경우에는 보시는 것 같이 방 덱 승률이 엄청 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.178,
                "end": 22.762
            },
            {
                "speaker_id": "1",
                "transcription": "지금 요렇게 좋은데 요거거를 뚫기 위해서 한 거예요 일단 애초에 만든 이유는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.772,
                "end": 28.746
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 덱이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.753,
                "end": 29.746
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱한테 지는지 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.761,
                "end": 32.333
            },
            {
                "speaker_id": "1",
                "transcription": "보통 아주 정석 덱 중에 정석 덱이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.333,
                "end": 36.393
            },
            {
                "speaker_id": "1",
                "transcription": "자색 고구마 휘낭시에 클로티드 블랙펄 자 이 정석 덱 상대로도 어떻게 되는지 봐야 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.446,
                "end": 49.541
            }
        ]
    },
    "summary": "자색 고구마 휘낭시에 클로티드 블랙펄 정석 덱 상대로 어떻게 되는지 봐야 될 것 같다고 한다.",
