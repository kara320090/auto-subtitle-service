            },
            {
                "speaker_id": "1",
                "transcription": "일단 이렇게 되는 거 자체가 이거 내가 볼 때 쿠키 죽을것 같은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.752,
                "end": 11.895
            },
            {
                "speaker_id": "1",
                "transcription": "스텝 다 꼬이고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.895,
                "end": 34.412
            },
            {
                "speaker_id": "1",
                "transcription": "이거 야 잠깐만 이거 9천만 나왔었다고요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.412,
                "end": 37.180
            },
            {
                "speaker_id": "1",
                "transcription": "감초는 9천만은 아니죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.180,
                "end": 39.615
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 감초는 다 뜯어고쳐야 될 것 같은데 근데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.617,
                "end": 42.495
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 이분은 아레나에 진심인게 느껴져서 이거 다 해체해야 되는데 세팅 제가 해드려요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.495,
                "end": 48.562
            },
            {
                "speaker_id": "1",
                "transcription": "이거 다 빼야돼 아레나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.562,
                "end": 50.460
            },
            {
                "speaker_id": "1",
                "transcription": "지금 해도 저장을 못해가지고 근데 둘 중에 하나만 맞출 수 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.460,
                "end": 55.112
            },
            {
                "speaker_id": "1",
