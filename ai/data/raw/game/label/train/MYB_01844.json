        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 스냅 드래곤을 이용한 아레나 덱 추천입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.068
            },
            {
                "speaker_id": "1",
                "transcription": "두 가지 덱인데 정말 제가 무지성으로 써봤는데 승률이 어마 무시하게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.078,
                "end": 11.035
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로도 좋거든요 그냥 모든 덱을 다 막습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.045,
                "end": 15.111
            },
            {
                "speaker_id": "1",
                "transcription": "뚫린거는 제가 토벌 하느라 토핑을 빼놨을 때",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.121,
                "end": 19.050
            },
            {
                "speaker_id": "1",
                "transcription": "그때 뚫린건데 한방덱 빙결덱 그리고 정석덱 모든 종류를 다 막아내서 되게 승률이 좋았다 그리고 공덱으로도 상당히 좋았다",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.060,
                "end": 31.291
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 볼 때 스펙이 좋아서 그런 거 아니냐",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.301,
                "end": 34.949
            },
            {
                "speaker_id": "1",
                "transcription": "물론 다른 분들 스펙 좋은 분들이 들어왔을 때도 보시는 거와 같이 다 막았습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.959,
                "end": 41.566
            }
        ]
    },
