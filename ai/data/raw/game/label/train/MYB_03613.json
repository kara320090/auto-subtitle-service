        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 대천사 토벌덱 최종판입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.695
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 뭐 여러분들이 따라 할 수 없으면 그냥 다른 쉬운 버전 여러분들이 찾아서 하시면 되시고 지금 제가 추천드리는 이유는 그나마 가장 저는 잘 나왔고 참사도 없는 상태로 할 수 있는 방법이라 여러분들한테 소개해 드리려고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.705,
                "end": 18.359
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 토핑 보게 되면은 마카롱 같은 경우에는 쿨타임 23.9 이상 23.9 이상 그다음에 공 치 여러분들 능력껏 주시면 되고 오징어 먹물이 좀 중요하긴 해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.369,
                "end": 28.801
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임을 2퍼센트에서 4퍼센트 사이 그 정도 주시면서 공 속은 가능한 한 13퍼센트 이상주면은 좋긴 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.811,
                "end": 37.107
            },
            {
                "speaker_id": "1",
                "transcription": "공 속을 너무 높게 못 주는 분들은 이 빌드대로 한번 해보시고 그래도 잘 안된다 하시면은 그냥 다른 빌드하시면 되고 세팅은 요게 가장 좋을 거 같아요. 13퍼센트 이상으로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.117,
                "end": 48.022
            },
            {
                "speaker_id": "1",
                "transcription": "공 치 여러분들 능력껏 해주시고 블랙베리는 15.5퍼센트 이상 15.3퍼센트도 된다고 하는데 그냥 권장은 15.5퍼센트 이상 공 속은 좀 줘도 되고 뭐 없어도 되는 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.032,
                "end": 61.030
            },
            {
                "speaker_id": "1",
                "transcription": "있으면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.040,
                "end": 62.306
            },
            {
                "speaker_id": "1",
                "transcription": "벚꽃 맛 쿠키는 제가 추천드리는 건 쿨 8퍼센트 이상 따라 해 주시면 좋을 거 같고 그다음 호밀은 쿨타임 한 줄 그냥 1퍼센트에서 2퍼센트 사이 한 줄 공 속도 여러분들 뭐 2퍼센트에서 3퍼센트 나 여러분들 능력껏 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.316,
                "end": 77.269
            },
            {
                "speaker_id": "1",
                "transcription": "그 이상 줘도 상관없어요.",
