        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 슬슬 마무리 지읍시다.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.599
            },
            {
                "speaker_id": "1",
                "transcription": "이제 장점과 단점이 확실하게 드러나는 덱이라 마무리 영상을 보고 이렇게 생각하는 분 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.609,
                "end": 8.066
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 라떼를 키워야 되나 마들렌을 키워야 되나 일단은 먼저 마들렌을 키우세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.076,
                "end": 13.632
            },
            {
                "speaker_id": "1",
                "transcription": "마들렌은 마탕 30강을 찍고 그러고나서 여유가 되시는 분들은 라떼 키워서 이렇게 라떼 공속덱까지 쓸 수 있으면은 써라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.642,
                "end": 22.478
            },
            {
                "speaker_id": "1",
                "transcription": "근데 솔직히 얘를 이렇게 쓰는 거 말고도 지금 다른 덱도 많아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.488,
                "end": 26.988
            },
            {
                "speaker_id": "1",
                "transcription": "라떼 자리에 뱀파 쓰는 덱도 있고 블랙펄 쓰는 덱도 있고 그래서 여러분들이 그 보고 골라서 써 주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.998,
                "end": 35.130
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 퓨바가 있는 덱한테 승률이 워낙 좋기 때문에 저격용으로 공덱으로 세팅해서 쓰기 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.140,
                "end": 41.504
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 요렇게 리뷰는 끝",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.514,
                "end": 61.533
            }
        ]
    },
    "summary": "마들렌은 마탕 30강을 찍고 라떼 공속덱까지 쓸 수 있으면 쓰는데 다른 덱도 많기 때문에 골라서 사용하기 바란다.",
