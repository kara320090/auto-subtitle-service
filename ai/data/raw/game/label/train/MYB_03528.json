        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 현재 피해 집중만 있죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 1.170
            },
            {
                "speaker_id": "1",
                "transcription": "다른 버프가 없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 1.170,
                "end": 3.450
            },
            {
                "speaker_id": "1",
                "transcription": "우측 하단에 보면은 버프 표시 보면은 따로 지금 되는 게 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.450,
                "end": 9.290
            },
            {
                "speaker_id": "1",
                "transcription": "네 상대가 기절되는 것도 아닙니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.290,
                "end": 11.750
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 밀치기만 하고 끝나는 게 원래 기본 스킬이고 에 피해 집중을 통해서 아군을 보호해 주는 역할을 하는 거는 맞아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.750,
                "end": 20.480
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 뭐 홀리 베리 시드 같은 신규 버프 뭐 상향된 거는 아직 적용되지 않았다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.480,
                "end": 28.458
            }
        ]
    },
    "summary": "우측 하단 버프 표시를 봤을 때 되는 게 없었고 기본 스킬과 피해 집중으로 아군을 보호해 주는 역할만 해 주고 있으며 홀리 베리 시드 같은 신규 버프가 적용되지 않았다.",
