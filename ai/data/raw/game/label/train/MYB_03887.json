        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 자 9시 됐죠 이때 캡틴캐비어 발동 자 그다음에 목화맛 쿠키랑 이 딱총을 연타를 해주실 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.396
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 자 요런 식으로 써주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.406,
                "end": 14.304
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파는 마지막에 쓸 수가 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.314,
                "end": 16.814
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 보시는 거와 같이 1.19억 제가 나온 건 1.22억인가 어 최고점을 봤거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.824,
                "end": 23.795
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 해서 뱀파딜 목화딜 소르베는 4천만 대 이상 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.805,
                "end": 28.928
            },
            {
                "speaker_id": "1",
                "transcription": "4천 백만 4천 2백만까지도 더 나오게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.938,
                "end": 32.495
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 빌드예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.505,
                "end": 33.729
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 여러분들 봤을 때 되게 어려워 보이는 면도 없지 않아 있어요 솔직히.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.739,
                "end": 38.769
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 중요한 점은 굳이 이런 케이크 드래곤을 내가 쳐야 되나요라고 생각할 수 있는데 어 아까 말씀드렸다시피 대천사랑 감초를 치다가 남은 인원으로 이제 더 이상 토벌 진행해도 마무리를 못할 때 케이크 드래곤을 억지로 해야 될 때 그때가 있을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.779,
                "end": 55.557
            },
            {
                "speaker_id": "1",
                "transcription": "그때 요 세팅을 통해서 여러분들 하면은 저단계에서는 엄청나게 쉽게 할 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.567,
                "end": 61.129
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 쉽게 한다는 뜻이 빌드가 쉽다는 게 아니라 엄청나게 딜을 많이 넣을 수 있습니다 세팅을 잘 하시면 빌드대로 하시면.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.139,
                "end": 67.771
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에 보여드릴 거는 이 17 18 요것도 목화 쿨 높여주면은 할 수 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.781,
                "end": 73.664
            },
            {
                "speaker_id": "1",
                "transcription": "그러다가 이제 더 이상 못 버티는 단계가 옵니다 뭐 30단계 넘어서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.674,
                "end": 77.316
            },
            {
                "speaker_id": "1",
                "transcription": "고단계에서도 제가 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.326,
                "end": 81.958
            }
        ]
    },
