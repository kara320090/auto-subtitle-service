        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 버티고 뭐 이런 식으로 문난하게 소르베가 이기는 그림이 보인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 14.643
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대분도 랭커분이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.653,
                "end": 16.741
            },
            {
                "speaker_id": "1",
                "transcription": "소르베가 요런 식으로 네 호루라기랑 무공비 보물로 부활 깃털 보물을 안 써도 이런 식의 활용으로 잘 쓰고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.751,
                "end": 25.855
            },
            {
                "speaker_id": "1",
                "transcription": "너무나 활용하기가 좋은 상태예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.865,
                "end": 28.282
            },
            {
                "speaker_id": "1",
                "transcription": "특히 나 이 소르베가 기존에는 옛날에 자리가 이 자리에 뭐가 왔었냐면은 스타더스트랑 달빛술사가 들어와서 낄 자리도 없었어요.",
                "sound_type": [
                    2
                ],
                "start": 28.292,
                "end": 37.396
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 스타더스트나 달빛술사가 들어오는 순간 용과랑 같이 쓰면은 호루라기를 받는 대상이 용과랑 그 나머지 딜러가 돼서 소르베를 같이 쓰기에는 호루라기가 없으면은 너무 쉽게 죽어서 잘 죽는 경향때문에 끼기가 힘들었거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 37.406,
                "end": 52.891
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 락스타 출시되니까 호루라기를 대놓고 이렇게 용과랑 단둘이 받을 수 있는 상황이 되다 보니까 안정적으로 더 쓸 수 있는 상황이 만들어졌다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 52.901,
                "end": 61.820
            },
            {
                "speaker_id": "1",
                "transcription": "게다가 힐러가 2마리가 되니까 생존이 보장돼서 1분 지나서 좀 더 강한 딜을 넣고 딜러들의 공격 타이밍도 꼬아 놓을 수 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 61.828,
                "end": 70.080
            },
            {
                "speaker_id": "1",
                "transcription": "활용 가치가 너무나 좋아졌습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 70.100,
                "end": 72.391
            },
            {
                "speaker_id": "1",
                "transcription": "자 다른 분도 다시 또 가보겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 72.401,
                "end": 74.653
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대 스타더스트랑 달빛술사",
                "sound_type": [
                    2,
                    3,
                    5
                ],
