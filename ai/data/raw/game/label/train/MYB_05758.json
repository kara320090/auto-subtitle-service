                "end": 11.398
            },
            {
                "speaker_id": "1",
                "transcription": "에스프레소랑 같이 써봤는데 올 라즈해도 약간 딜부족으로 상대를 죽이지 못하더라구요.",
                "sound_type": [
                    2,
