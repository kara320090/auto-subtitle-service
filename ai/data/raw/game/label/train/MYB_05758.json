                ],
                "start": 11.408,
                "end": 17.187
            },
            {
                "speaker_id": "1",
                "transcription": "상당히 좀 쓰기가 애매하다 아 약간 좀 부족한 느낌의 그런 상태인거 같아요.",
                "sound_type": [
