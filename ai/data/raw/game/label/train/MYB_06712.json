                ],
                "start": 0.000,
                "end": 2.450
            },
            {
                "speaker_id": "1",
                "transcription": "그마나 있는 묘지기들은 인형이 무섭다고 이곳에 접근조차 하질 않으려고 해요.",
                "sound_type": [
