                    3,
                    5
                ],
                "start": 34.347,
                "end": 44.355
            },
            {
                "speaker_id": "2",
                "transcription": "2주 동안이나 여러분들 발전할 때 큰 도움이 되겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.482,
                "end": 47.682
            },
            {
                "speaker_id": "2",
                "transcription": "자 아무튼 11 다시 23이 정말 난이도가 쉬워졌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.885,
                "end": 50.145
            },
            {
                "speaker_id": "2",
                "transcription": "요게 포인트입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.420,
                "end": 51.310
            },
            {
                "speaker_id": "2",
                "transcription": "그리고 이것도 확인해 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.455,
                "end": 52.890
            },
            {
                "speaker_id": "2",
                "transcription": "정말 극악으로 많이 고통받았던 11 다시 27 여기도 한번 보도록 하겠습니다.",
