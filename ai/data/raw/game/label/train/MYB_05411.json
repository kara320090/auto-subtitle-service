        "term": [
            {
                "speaker_id": "1",
                "transcription": "아니 근데 진짜 크림 유니콘 이거 확률이 이상하게 난 진짜 너무 안 나오는 거 같아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.830
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야. 쿠키런 빵 3탄 나왔다구요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.840,
                "end": 14.197
            },
            {
                "speaker_id": "1",
                "transcription": "오 그냥 많이 사서 한번 영상 찍어 볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.207,
                "end": 17.926
            },
            {
                "speaker_id": "1",
                "transcription": "그거 근데 나는 집 근처 편의점은 아예 대놓고 문에 쿠키런 킹덤 빵, 포켓몬 빵 없습니다 그냥 적혀 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.936,
                "end": 25.862
            },
            {
                "speaker_id": "1",
                "transcription": "요새는 그거 뗐나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.872,
                "end": 27.104
            },
            {
                "speaker_id": "1",
                "transcription": "저 갈 때마다 맨날 그거 없 오 좋아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.114,
                "end": 29.929
            },
            {
                "speaker_id": "1",
                "transcription": "나와도 기쁘지 않은 고대 쿠키 진짜 0순위가 홀베야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.939,
                "end": 34.497
            },
            {
                "speaker_id": "1",
                "transcription": "나와도 아무 감흥 없는 쿠키 0순위",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.507,
                "end": 39.633
            }
        ]
    },
    "summary": "크림 유니콘은 잘 나오지 않고 나와도 아무 감흥 없는 고대 쿠키 0순위 홀베만 뽑힌다.",
