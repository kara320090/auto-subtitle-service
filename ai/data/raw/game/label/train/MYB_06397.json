        "term": [
            {
                "speaker_id": "1",
                "transcription": "개 무서워.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.542
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 나 지금 못 지나가게 생겼어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.552,
                "end": 2.661
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 해야지 지나갈 수 있을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.671,
                "end": 4.309
            },
            {
                "speaker_id": "1",
                "transcription": "차 배터리가 다 닳을 때까지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.319,
                "end": 7.808
            },
            {
                "speaker_id": "2",
                "transcription": "우와 진짜?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.818,
                "end": 11.158
            },
            {
                "speaker_id": "1",
                "transcription": "어 네 맞아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.168,
                "end": 14.190
            },
            {
                "speaker_id": "1",
                "transcription": "코드님 어서 와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.200,
                "end": 15.274
            },
            {
                "speaker_id": "1",
                "transcription": "21개월 동안 구독해 주셔서 고마워요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.284,
                "end": 17.533
            },
            {
                "speaker_id": "1",
                "transcription": "앙 감사합니다아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.543,
                "end": 19.662
            },
            {
                "speaker_id": "1",
                "transcription": "어서 오세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.672,
                "end": 20.834
            },
            {
                "speaker_id": "1",
                "transcription": "되돌아가기 해볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.844,
                "end": 22.820
            },
            {
                "speaker_id": "1",
                "transcription": "루트가 직선 루트예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.830,
                "end": 36.183
            },
            {
                "speaker_id": "1",
                "transcription": "다른 길이 없는 거 같애.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.193,
                "end": 38.674
            },
            {
                "speaker_id": "1",
                "transcription": "여기 숨어 있다가 저 차가 와서 손전등을 비추고 절로 간 거 같거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.684,
                "end": 49.368
            },
            {
                "speaker_id": "1",
                "transcription": "근데 아마 저 차보다 빨리 내가 지나올 순 없었을 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.378,
                "end": 55.163
            },
            {
                "speaker_id": "1",
                "transcription": "제가 거 궁금한 거는 아까 전에 그 총 맞기 전에 구조물이 하나 있었거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.173,
                "end": 65.684
            },
            {
                "speaker_id": "1",
                "transcription": "근데 거기를 점프를 해봤는데 뭐 타지거나 들어가지거나 이런 건 없었거든?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.694,
                "end": 70.318
            },
            {
                "speaker_id": "1",
                "transcription": "한 번만 다시 가볼게요.",
