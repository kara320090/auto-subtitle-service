        "term": [
            {
                "speaker_id": "1",
                "transcription": "옛날에 블없찐이라고 혹시 아시나요?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.030
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 없으면 약간 찐따 소리 듣던 그때 기억하시는 분 있죠?",
                "sound_type": [
                    2
                ],
                "start": 3.040,
                "end": 7.429
            },
            {
                "speaker_id": "1",
                "transcription": "그거 보다 좀 더 심하다 보시면 됩니다.",
                "sound_type": [
                    2
                ],
                "start": 7.439,
                "end": 9.622
            },
            {
                "speaker_id": "1",
                "transcription": "달빛술사 없으면은 그냥 져야 돼요.",
                "sound_type": [
                    2
                ],
                "start": 9.632,
                "end": 12.314
            },
            {
                "speaker_id": "1",
                "transcription": "거의 진짜 그 정도 급이야.",
