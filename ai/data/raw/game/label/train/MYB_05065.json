            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.698,
                "end": 8.432
            },
            {
                "speaker_id": "1",
                "transcription": "딜로 거의 녹아버리는 구조죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.442,
                "end": 10.417
            },
            {
                "speaker_id": "1",
                "transcription": "자 바다요정 죽으면서 포션 역할하고 자 이거 또 써 주고 자 요렇게 이기는 그림",
                "sound_type": [
