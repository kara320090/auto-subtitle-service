        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 야 야 잠깐만 너무 안 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.645
            },
            {
                "speaker_id": "1",
                "transcription": "일단 마을 한 바퀴 돌고 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.655,
                "end": 15.279
            },
            {
                "speaker_id": "1",
                "transcription": "데브는 브금 하나만 잘 만드는 거 같다고요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.289,
                "end": 17.682
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 데브 게임하는 것 중의 하나가 브금도 브금인데 쿠키들 이미지를 정말 잘 뽑아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.692,
                "end": 24.983
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 아기자기한 게임을 제가 좋아하는데 그런 면에서는 최고야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.993,
                "end": 28.671
            },
            {
                "speaker_id": "1",
                "transcription": "저는 게임을 하는 이유는 솔직히 운영은 마음에 안 들지만 이 아기자기한 게임성 너무 좋아서 하는 것도 크지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.681,
                "end": 43.593
            },
            {
                "speaker_id": "1",
                "transcription": "오케이 자 일단 초월 됐기 때문에 음유로 넘어가서 3성 찍을게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.603,
                "end": 49.799
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 나왔고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.809,
                "end": 52.519
            }
        ]
    },
    "summary": "화자가 데브 게임 하는 이유는 브금도 브금이지만 아기자기한 게임을 좋아하는데 그런 면에서 쿠키들의 이미지를 잘 뽑기 때문에 한다고 한다.",
