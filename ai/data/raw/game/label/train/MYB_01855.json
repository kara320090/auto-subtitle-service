        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래도 돌격형이 안 나온 게 어디야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.743
            },
            {
                "speaker_id": "1",
                "transcription": "돌격형이 연속으로 5연속으로 나왔나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.753,
                "end": 6.186
            },
            {
                "speaker_id": "1",
                "transcription": "4연속으로 나왔나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.196,
                "end": 7.439
            },
            {
                "speaker_id": "1",
                "transcription": "돌격형 안 나오고 그래도 다른 유형 나온 게 어디야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.449,
                "end": 11.420
            },
            {
                "speaker_id": "1",
                "transcription": "자 쭉쭉 바로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.430,
                "end": 15.066
            },
            {
                "speaker_id": "1",
                "transcription": "나는 데브가 파우더 가지고 욕 안 먹을 수 있는 방법이 그게 있었으면 좋겠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.076,
                "end": 21.010
            },
            {
                "speaker_id": "1",
                "transcription": "파우더 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.020,
                "end": 22.166
            },
            {
                "speaker_id": "1",
                "transcription": "계속 한쪽 유형만 나오면 욕먹으니까 파우더 정말 안 쓰는 유형들 교환할 수 있는 거?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.176,
                "end": 28.456
            },
            {
                "speaker_id": "1",
                "transcription": "약간 그런 시스템 있으면은 좀 좋지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.466,
                "end": 31.578
            },
            {
                "speaker_id": "1",
                "transcription": "그 교역소 통해서 교환하는 거 말고 그냥 자유롭게 정말 그냥 쓰잘데기없는 쌓이는 거 자유롭게 교환했으면 좋겠어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.588,
                "end": 40.316
            },
            {
                "speaker_id": "1",
                "transcription": "아니 보면은 진짜 몇 천 개씩 막 한쪽만 유형이 쌓이는 게 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.326,
                "end": 45.044
            },
            {
                "speaker_id": "1",
                "transcription": "그런 거 자유롭게 좀 교환하면은 얼마나 좋을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.054,
                "end": 47.993
            },
            {
                "speaker_id": "1",
                "transcription": "아니면은 난 그냥 파우더 그냥 다 통판 그냥 하나로 그냥 다 그냥 만들었으면 좋겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.003,
                "end": 54.366
            }
        ]
    },
    "summary": "남자는 파우더 안 쓰는 유형들은 자유롭게 교환할 수 있는 시스템이 있으면 좋을 것 같다며 아니면 파우더를 하나로 만들었으면 좋겠다고 한다.",
