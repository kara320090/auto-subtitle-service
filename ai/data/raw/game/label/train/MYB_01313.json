        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 제일 중요한 거 여기부터 할게요. 용토벌부터 리뷰",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.695
            },
            {
                "speaker_id": "1",
                "transcription": "아예 0강일 때는 여러분들 얘로 했을 때 토벌 딜이 3억 나왔습니다. 2석 9700 나왔거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.705,
                "end": 11.171
            },
            {
                "speaker_id": "1",
                "transcription": "30강을 하고 나서 얼마나 나오는지 비교를 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.181,
                "end": 14.469
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 세팅은 무궁 비, 호루라기, 시계고요. 밀크웨이 네 요거는 쿨공석 여러분들 최대한 높게 요거 완벽한 빌트는 또 공략을 찍어서 영상으로 만들 거고 빌드는 스페셜 빌드의 @이름1 님의 만드신 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.479,
                "end": 27.782
            },
            {
                "speaker_id": "1",
                "transcription": "간단히 리뷰 영상이다 그렇게 알아주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.792,
                "end": 30.554
            },
            {
                "speaker_id": "1",
                "transcription": "로얄은 쿨 5퍼센트, 피감은 뭐 좀 더 낮아도 될것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.564,
                "end": 34.974
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 락스타는 3 아몬드, 2 애플젤리 쿨 5퍼센트 그다음에 주스는 피감 요 정도에다가 쿨24.2 근처 물론 주스를 주문 높게 망고는 5 아몬드 쿨 높게 피감 요 정도 특별 토핑은 저는 올 아몬드로 선택했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.984,
                "end": 51.798
            },
            {
                "speaker_id": "1",
                "transcription": "토벌뿐만 아니라 아레나에도 아몬드 쓰여서 네 요런 식으로",
                "sound_type": [
                    2,
