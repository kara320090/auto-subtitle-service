        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 마들렌하고 얘네 둘이서 그냥 다 해 먹습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.803
            },
            {
                "speaker_id": "1",
                "transcription": "야 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.813,
                "end": 8.954
            },
            {
                "speaker_id": "1",
                "transcription": "아 근데 특별 토핑은 여러분들 아몬드 얘 못 끼잖아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.964,
                "end": 13.218
            },
            {
                "speaker_id": "1",
                "transcription": "특별 토핑 어차피 얘만 낄 수 있잖아요 지금 그렇죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.228,
                "end": 16.139
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 마들렌도 특별 토핑 받을 수 있으면은 당연히",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.149,
                "end": 20.314
            },
            {
                "speaker_id": "1",
                "transcription": "아몬드인데 일단은 특별 토핑은 여러분들 아몬드 선택은 조금 기다려 보고 기다려 보고 선택하는 게 나은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.324,
                "end": 28.212
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 뭐 퀸아망 라즈 조합도 뭐 갑자기 튀어나올 수도 있기 때문에 조합이 갖춰지기 전까지 세팅이 되기 전까지는 좀 애매한 포지션인 것 같았는데 세팅이 완성되니까 역시나 정말 사기적이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.222,
                "end": 40.845
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱이 다시 부활했다 이렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.855,
                "end": 44.326
            },
            {
                "speaker_id": "1",
                "transcription": "퀸아망 쿠키 여러분들 에픽 등급이라 키우기도 레전드 고대보다 쉬우니까 캡사이신보다도 더 좋게 활용할 수 있으니까 예 0티어로 쓸 수 있을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.336,
                "end": 53.887
            },
            {
                "speaker_id": "1",
                "transcription": "키워 보시기 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.897,
                "end": 55.478
            },
            {
                "speaker_id": "1",
                "transcription": "예 사기적으로 좋네요.",
                "sound_type": [
                    2,
                    3
                ],
