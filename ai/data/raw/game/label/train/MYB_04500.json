        "term": [
            {
                "speaker_id": "1",
                "transcription": "야야야 이거 너무했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.621
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 계정은 소멸되겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.631,
                "end": 7.338
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 삭제할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.348,
                "end": 8.627
            },
            {
                "speaker_id": "1",
                "transcription": "어 다신 보지 말자 자 환생 다시 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.637,
                "end": 13.324
            },
            {
                "speaker_id": "1",
                "transcription": "다시 스타트 블랙펄있는 계정 있는 데 굳이 리세해야 할 이유가는 없죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.334,
                "end": 17.943
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 제가 한마디만 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.953,
                "end": 20.164
            },
            {
                "speaker_id": "1",
                "transcription": "부계정 키우기는 여러분들 본 계정을 열심히 할 수 있는데 시간이 좀 더 남아서 나는 하겠다하는 분들한테 추천드린거지 노언님 저 본계정도 할 시간도 없어요하시는 분들한테는 절대 추천하잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.174,
                "end": 33.721
            },
            {
                "speaker_id": "1",
                "transcription": "부계정 키우느라 본계정 소홀해질 것 같으면은 시작 조차하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.731,
                "end": 38.408
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 부계정 키우기 시간 엄청 잡아 먹거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.418,
                "end": 41.310
            },
            {
                "speaker_id": "1",
                "transcription": "본계보다 시간을 더 많이 걸려서 그냥 본계에 잘 키우고 있습니다 나는 그냥 뭐 따로 불만 없습니다 하시면은 부계 굳이 안 키워도 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.320,
                "end": 50.349
            },
            {
                "speaker_id": "1",
                "transcription": "야 누구야 스틸한 사람 누구야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.359,
                "end": 55.266
            }
        ]
    },
