        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 스토리 덱 좀 봐달라고 하셨죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.568
            },
            {
                "speaker_id": "1",
                "transcription": "이거 깨실 때는 이 라즈베리가 공격력이 가장 높은 쿠키한테 딜이 들어가거든요 그러면 지금 보면 공격력이 가장 높은 애가 얘죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.578,
                "end": 11.094
            },
            {
                "speaker_id": "1",
                "transcription": "공격력이 얘가 가장 높게 하거나 뭐 얘가 높게 하게 해서 올 아몬드 세팅을 해 가지고 쟤가 검술 공격이 들어와도 안 죽게끔 세팅하면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.104,
                "end": 20.704
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나 보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.714,
                "end": 22.287
            },
            {
                "speaker_id": "1",
                "transcription": "근데 진짜 이런 말 하기 그런데 초호화네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.297,
                "end": 24.970
            },
            {
                "speaker_id": "1",
                "transcription": "시작한 지를 얼마 안 된 분이지만 다크 카카오도 있고 블랙펄도 있고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.980,
                "end": 29.900
            }
        ]
    },
    "summary": "남자는 이거 깰 때 라즈베리가 공격력이 가장 높은 쿠키한테 딜이 들어가기 때문에 공격력을 가장 높게 하거나 올 아몬드 세팅을 해서 검술 공격이 들어와도 안 죽게끔 세팅하면 된다고 한다.",
