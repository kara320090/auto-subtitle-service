    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 아까 했을 때는 못 이겼는데 아 솔직히 이거는 좀 운 짝으로 이긴 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.009
            },
            {
                "speaker_id": "1",
                "transcription": "네 샤벳상어가 정말 캐리를 잘해줬네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.019,
                "end": 8.117
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 겨우겨우 잘 버티면서 이기는 그림이 나왔다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.127,
                "end": 11.383
            },
            {
                "speaker_id": "1",
                "transcription": "아 제가 말씀드리고 싶은 거는 눈설탕이 좋아서 제가 이렇게 이기기 좋으니까 쓰라고 하는 건 절대 아니고 이게 많이 활용 가치가 눈설탕이 소원 덱에서도 낮아진다를 보여드릴라고 지금 하고 있는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.393,
                "end": 23.658
            },
            {
                "speaker_id": "1",
                "transcription": "자 요 덱한테 한번 들어가 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.668,
                "end": 25.793
            },
            {
                "speaker_id": "1",
                "transcription": "아까 거의 전멸당했었는데 원 템 덱은 클러티드가 좋거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.803,
                "end": 30.417
            },
            {
                "speaker_id": "1",
                "transcription": "근데 해보나 마나 정말 이 가운데서 못 버틸 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.427,
                "end": 33.631
            },
            {
                "speaker_id": "1",
                "transcription": "상대방이 이 서리여왕이나 소르베가 너무나 단단하기 때문에",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.641,
                "end": 38.022
            },
            {
                "speaker_id": "1",
                "transcription": "자 클로티드가 앞에 전방의 휘낭시에를 뒤로 밀어줘서 소원 몹들이 전방에 있는 이 가운데에 있는 딜러들을 집중적으로 타격할 수가 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.032,
                "end": 48.634
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 죽일 수만 있다면은 클러티드 소원 덱도 상당히 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.644,
                "end": 53.068
            },
            {
                "speaker_id": "1",
                "transcription": "근데 문제는 죽지가 않아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.078,
                "end": 55.129
            },
            {
                "speaker_id": "1",
                "transcription": "워낙 피감작도 잘 돼있고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.139,
                "end": 57.674
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 못 버티면은 죽 집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.684,
                "end": 59.713
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 자 못 버티면 집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.723,
                "end": 65.117
            },
            {
                "speaker_id": "1",
                "transcription": "어 이러면 이긴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.127,
                "end": 68.291
            }
        ]
    },
