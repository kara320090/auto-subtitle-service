                "end": 11.245
            },
            {
                "speaker_id": "1",
                "transcription": "자 용과, 홀리베리덱 요것도 한번 비교해서 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.255,
                "end": 16.135
            },
            {
                "speaker_id": "1",
                "transcription": "상위권에서는 2, 1, 2 덱이 없어요.",
