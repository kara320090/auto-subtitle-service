    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이거는 어떻게 되지 와 장관 겨우 이겼네 이건.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.336
            },
            {
                "speaker_id": "1",
                "transcription": "치명타는 못 피해 가네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.346,
                "end": 10.681
            },
            {
                "speaker_id": "1",
                "transcription": "이거 하나 팁을 드릴게요 여러분들.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.691,
                "end": 13.323
            },
            {
                "speaker_id": "1",
                "transcription": "아 여기에 뭐가 있는지 모르겠다 거울이라 생각하면 돼요 좌우반전으로.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.333,
                "end": 17.235
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 되어 있으면 이 자리에 흑당이 있다는 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.245,
                "end": 20.339
            },
            {
                "speaker_id": "1",
                "transcription": "여러분 궁금하면 이렇게 껴보면 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.349,
                "end": 22.486
            },
            {
                "speaker_id": "1",
                "transcription": "와베를 넣는 순간 자리가 스위치 바뀝니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.496,
                "end": 24.889
            },
            {
                "speaker_id": "1",
                "transcription": "와베가 있으면 소환덱으로 가면 막힐 가능성이 좀 크거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.899,
                "end": 27.340
            },
            {
                "speaker_id": "1",
                "transcription": "근데 흑당이 있으면 그나마 소환덱이 쓸 수 있는 가능성이 커지고 하나씩 넣어 보면 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.350,
                "end": 32.745
            },
            {
                "speaker_id": "1",
                "transcription": "자리가 바뀌면 일단 와베 가능성이 좀 큰 거고 저 자리에 또 이제 올 수 있는 게 크런치 초코칩도 쓸 수 있고 되게 다양하게 쓸 수도 있긴 하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.755,
                "end": 42.289
            },
            {
                "speaker_id": "1",
                "transcription": "보통 크런치 초코칩은 바뀌어요 요렇게 바뀌죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.299,
                "end": 46.156
            },
            {
                "speaker_id": "1",
                "transcription": "와베랑 크런치 초코칩은 이제 똑같은 위치로 바뀐다고 여러분들이 알고 계시면 되고 요거는 확실하게 와베가 아닌 걸 알고 이제 흑당인 걸 알고 이제 가면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.166,
                "end": 57.414
            },
            {
                "speaker_id": "1",
                "transcription": "흑당이 뒤로 밀려나면 얘 혼자 남거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.424,
                "end": 60.101
            },
            {
                "speaker_id": "1",
                "transcription": "그때 밀고 와서 가운데까지 소환덱이 죽일 수 있으니까.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.111,
                "end": 64.800
            }
        ]
    },
    "summary": "한 남자가 전투 게임 시작 전 보이지 않는 팀 정보의 구성에 대해 알 수 있는 팁을 주고 있다.",
