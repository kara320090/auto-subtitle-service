        "term": [
            {
                "speaker_id": "1",
                "transcription": "예언자 쿠키는 스페셜 뽑기나 고급 뽑기에서도 나오긴 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.230
            },
            {
                "speaker_id": "1",
                "transcription": "낮은 확률로 근데 이벤트 뽑기에서 뽑으시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.230,
                "end": 8.910
            },
            {
                "speaker_id": "1",
                "transcription": "아마 승급하기가 너무 어려울 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.910,
                "end": 11.730
            },
            {
                "speaker_id": "1",
                "transcription": "너무 지금 저도 다른 상대방 쿠키는 5초월인데 저는 4성이거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.730,
                "end": 17.360
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 아마 얘가 생존하기도 조금 힘들고 딜도 약해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.360,
                "end": 22.660
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 5초월끼리 싸움해서 좀 상대적으로 초월이 많이 낮기 때문에 이런 식으로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.660,
                "end": 35.208
            }
        ]
    },
    "summary": "예언자 쿠키는 스페셜이나 고급 뽑기에서 낮은 확률로 나오긴 하지만 이벤트 뽑기에서 해도 되고 승급하기가 어려워서 생존하기 힘들고 딜도 약하며 초월이 낮다.",
