        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 그리고 뭐 해시태그와 함께 자신이 찾은 힌트와 사진을 공유한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.680
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 BTS 추억도 잊지 말고 공유",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.690,
                "end": 8.324
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 세계 곳곳에 숨겨진 힌트를 모두 찾아서 정답인 BTS의 메시지를 밝혀 달라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.334,
                "end": 13.648
            },
            {
                "speaker_id": "1",
                "transcription": "아 쿠키런 킹덤에서 코드를 입력하고 인게임 보상과 콜라보 아트북 한정판을 획득할 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.658,
                "end": 19.800
            },
            {
                "speaker_id": "1",
                "transcription": "자 뭐 이런 식으로 수수께끼고 최종적으로 보상 자체가 너무 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.810,
                "end": 24.586
            },
            {
                "speaker_id": "1",
                "transcription": "크리스탈 9000개, BTS 콜라보레이션 뽑기 14개, 그다음 BTS 쿠키 영혼석 선택상자",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.596,
                "end": 30.340
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 중요한 포인트는 BTS 쿠키는 영혼석을 얻어서 일단은 승급을 하는 시스템으로 나온다는 거",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.350,
                "end": 36.827
            },
            {
                "speaker_id": "1",
                "transcription": "저는 그냥 디즈니 쿠키처럼 따로 승급하는 걸로 나오지 않는 줄 알았는데 이번에 나오는 쿠키들은 영혼석이 등장한다는 거 보니까 다른 일반 쿠키처럼 요렇게 승급이 있는 형태로 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.837,
                "end": 49.001
            },
            {
                "speaker_id": "1",
                "transcription": "고거를 확인할 수가 있을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.011,
                "end": 51.138
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음 이벤트 내용을 보게 되면은 7일간의 깜짝 선물 해서",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.148,
                "end": 55.820
            },
            {
                "speaker_id": "1",
                "transcription": "자 보상을 보게 되면은 전설 뽑기권, 쿠키 커터, 무지개 큐브, 자 오로라 재료랑 그다음에 태엽, 그다음에 크리스탈 3000개, 그다음에 별사탕이랑 코인이랑 그다음에 에픽 선택권 상자",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.830,
                "end": 67.656
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 13시에 이렇게 우편함으로 뿌리는데 이거 놓치지 말고 접속만 해서 보상 다 받으시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.666,
                "end": 75.512
            },
            {
                "speaker_id": "1",
                "transcription": "보상을 받을 수 있는 이벤트",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.522,
                "end": 77.399
            },
            {
                "speaker_id": "1",
                "transcription": "어 크리스탈 공짜로 주는 거니까 뭐 구독해서 달성해서 보상을 받으시면 될 것 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.409,
                "end": 82.795
            },
            {
                "speaker_id": "1",
                "transcription": "자 이벤트 기간이나 이런 거 자세하게 보면은 10월 6일부터 10월 21일까지고 이 해당 댓글 영상에 여러분들 댓글 남기면은 이벤트 200명 추첨해서 크리스탈 3000개를 준다고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.805,
                "end": 95.014
            },
            {
                "speaker_id": "1",
                "transcription": "10월 13일 날 업데이트를 하게 되는데 이번에 업데이트 시간이 좀 바뀌었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.024,
                "end": 99.635
            },
            {
                "speaker_id": "1",
                "transcription": "자 업데이트 시간은 10월 13일 오전 5시부터 10시까지 5시간 동안 진행됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 99.645,
                "end": 105.623
            },
            {
                "speaker_id": "1",
                "transcription": "어 제가 업데이트 날 리뷰를 할 거니까 여기에 구독, 좋아요 1번씩만 부탁드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 105.633,
                "end": 110.813
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 110.823,
                "end": 115.633
            }
        ]
    },
    "summary": "남자는 수수께끼가 해시태그와 함께 자신이 찾은 힌트와 사진을 공유, BTS 추억도 잊지 말고 공유 등등이고 최종적으로 보상 자체가 너무 좋고 중요한 포인트는 BTS 쿠키는 영혼석을 얻어서 일단 승급을 하는 시스템으로 나온다는 것이라고 하며 그다음 이벤트 내용은 7일간의 깜짝 선물인데 13시에 우편함으로 뿌리니까 놓치지 말고 접속해서 보상 다 받으면 될 것 같다고 한다.",
