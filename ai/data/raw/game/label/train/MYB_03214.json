        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 빌드는 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.662
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 쭉 오고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.107,
                "end": 2.980
            },
            {
                "speaker_id": "1",
                "transcription": "단 이거는 자동을 끄고 하는 게 더 좋거든요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.435,
                "end": 6.425
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 정말 빌드는 별로 없기 때문에 자동 꺼도 여러분들 별로 불편한 게 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.817,
                "end": 11.670
            },
            {
                "speaker_id": "1",
                "transcription": "아포 에클 예언자 이 순서를 쓰세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.757,
                "end": 14.140
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 요고 밀키웨이를 써주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.150,
                "end": 16.100
            },
            {
                "speaker_id": "1",
                "transcription": "자 밀키웨이 써줬죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.995,
                "end": 18.015
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 이 밀키웨이가 이제 디버프 방깎이 들어갈 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.280,
                "end": 21.625
            },
            {
                "speaker_id": "1",
                "transcription": "이거 숫자가 13 정도 떴을 때 뱀파이어 누르면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.892,
                "end": 25.416
            }
        ]
    },
    "summary": "빌드는 정말 간단해서 자동을 끄고 하는 게 더 좋고 아포, 에클, 예언자 순서로 쓴 다음 밀키웨이를 써서 디버프 방깎이 들어가고 숫자가 13이 되면 뱀파이어를 누르면 된다.",
