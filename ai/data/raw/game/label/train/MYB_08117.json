                ],
                "start": 28.283,
                "end": 41.296
            },
            {
                "speaker_id": "1",
                "transcription": "엘든링 같은 경우에는 스토리를 풀어 주다 말았잖아요.",
                "sound_type": [
                    2,
                    3
                ],
