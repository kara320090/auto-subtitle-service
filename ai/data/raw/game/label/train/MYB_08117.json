                    3
                ],
                "start": 23.468,
                "end": 28.273
            },
            {
                "speaker_id": "1",
                "transcription": "근데 엔딩을 보고 나서 나올만한 건덕지가 있으면 나오지 않을까요?",
                "sound_type": [
