        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 2주년 케이크 들개파티 두 번째 보스 공략 가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.573
            },
            {
                "speaker_id": "1",
                "transcription": "흑당맛 쿠키 버그가 고쳐졌기 때문에 신규 덱으로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.583,
                "end": 8.640
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기를 버섯하고 오먹이 받게끔 설정해서 갈 거고 딜이 가장 좋기 때문에 쟤네 둘한테 주겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.650,
                "end": 16.160
            },
            {
                "speaker_id": "1",
                "transcription": "밀키웨이는 5라즈 네 그다음에 쿨은 5퍼센트 이상 맞춰주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.170,
                "end": 20.844
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 아셔야 될 게 쿠키런 킹덤은 쿨타임 요 30퍼센트 더해가지고 적용되는 게 25퍼센트 그 다음에 요거 5퍼센트 해서 쿠키런 킹덤에서 쿨타임은 맥스가 60퍼센트가 한계거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.854,
                "end": 35.863
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이거 넘어 봤자 의미가 없어요. 그래서 5퍼센트 라즈 이렇게 세팅해주고 공, 치. 캡틴비어도 5퍼센트 공, 치.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.873,
                "end": 43.773
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음 공속 그 다음 달빛은 3라즈 2애플젤리인데 여러분들 뭐 스펙이 낮으면은 호루라기가 얘네 둘한테 받을 수 있으면은 5라즈 해도 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.783,
                "end": 53.425
            },
            {
                "speaker_id": "1",
                "transcription": "버섯은 5퍼센트의 공, 치 그 다음에 오먹도 5퍼센트 공, 치.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.435,
                "end": 58.116
            },
            {
                "speaker_id": "1",
                "transcription": "자 이걸로 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.126,
                "end": 61.400
            }
        ]
    },
