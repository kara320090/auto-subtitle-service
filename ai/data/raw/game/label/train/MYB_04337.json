                    3
                ],
                "start": 6.292,
                "end": 18.559
            },
            {
                "speaker_id": "1",
                "transcription": "이거 스킬 안 쓰고 가만히 냅두면은 어떻게 될까?",
                "sound_type": [
                    2,
                    3
                ],
