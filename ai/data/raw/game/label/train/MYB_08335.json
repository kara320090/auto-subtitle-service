        "term": [
            {
                "speaker_id": "1",
                "transcription": "헤 어떻게 합니까 오토케스트라 어느 쪽에서 오는지 알 수 없어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.252
            },
            {
                "speaker_id": "1",
                "transcription": "마을을 방어하자 마을의 전력은 얼마 안 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.262,
                "end": 13.407
            },
            {
                "speaker_id": "1",
                "transcription": "방어에 집중해도 밀리는 건 시간 문제다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.417,
                "end": 16.159
            },
            {
                "speaker_id": "1",
                "transcription": "이게 물량막기가 되겠구만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.169,
                "end": 19.057
            },
            {
                "speaker_id": "1",
                "transcription": "응 시간이 늘어지면은 우리가 불리하니까 광산을 내가 가서 다 쓸어버리겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.067,
                "end": 30.526
            },
            {
                "speaker_id": "1",
                "transcription": "여길 부탁한다 내가 광산에 가서 다 쓸어버려 주지 어떻게 산 채로 다 박살을 내줄까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.536,
                "end": 39.596
            },
            {
                "speaker_id": "1",
                "transcription": "나 정도면 산도 옮길 수 있는데.",
                "sound_type": [
                    2
