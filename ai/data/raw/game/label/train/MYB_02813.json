        "term": [
            {
                "speaker_id": "1",
                "transcription": "자주 나오지 않거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.479
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때는 이렇게 참사가 나도 벚꽃덱보다는 딜이 더 잘 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.489,
                "end": 6.735
            },
            {
                "speaker_id": "1",
                "transcription": "자 시작할 때 이것도 마찬가지로 마카롱 예약을 해주고요 이거 근데 복잡해 보여도 여러분들 손에 익으면은 나름 이제 쉽게 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.745,
                "end": 15.198
            },
            {
                "speaker_id": "1",
                "transcription": "처음 설명 들을 때야 어렵지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.208,
                "end": 17.304
            },
            {
                "speaker_id": "1",
                "transcription": "자 보스 출현하면 슈크림, 블랙베리 예약하고 그다음에 마카롱 쓰고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.314,
                "end": 22.888
            },
            {
                "speaker_id": "1",
                "transcription": "호밀은 자동으로 나가게끔.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.898,
                "end": 24.720
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 블랙베리 다시 눌러주고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.730,
                "end": 28.791
            }
        ]
    },
