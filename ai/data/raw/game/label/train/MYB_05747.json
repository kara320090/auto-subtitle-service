        "term": [
            {
                "speaker_id": "1",
                "transcription": "도망쳐 보시죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.069
            },
            {
                "speaker_id": "2",
                "transcription": "빛이 인도하실 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.079,
                "end": 2.735
            },
            {
                "speaker_id": "3",
                "transcription": "아 좀 아쉽다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.745,
                "end": 5.469
            },
            {
                "speaker_id": "3",
                "transcription": "이게 버티기가 힘드네 그쵸?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.479,
                "end": 9.539
            },
            {
                "speaker_id": "3",
                "transcription": "버티기가 힘든 게 좀 아쉽네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.549,
                "end": 11.648
            },
            {
                "speaker_id": "3",
                "transcription": "이게 딜이 나쁘지는 않은데 아 버티기가 힘들어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.658,
                "end": 20.479
            },
            {
                "speaker_id": "3",
                "transcription": "제가 원하는 대로의 그림은 에스프레소 라떼맛 쿠키 2개가 동시에 스킬 쓰면서 상대 쿠키를 1마리라도 잡아주는 그림을 봤는데 그 잡아주는 딜이 좀 부족하네요 확실히.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.489,
                "end": 33.664
            },
            {
                "speaker_id": "3",
                "transcription": "뒤를 바라보는 느낌으로 좀 둘 다 아몬드를 좀 껴서 버텨보면서 한번 가볼까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.660,
                "end": 40.120
            },
            {
                "speaker_id": "3",
                "transcription": "네 이 정도로 한번 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.124,
                "end": 42.478
            },
            {
                "speaker_id": "3",
                "transcription": "버티고 모아서 한 번에 녹이자 버티고 좀만 버티자 1분까지 버티면 돼 자 버티는 게 목적입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.488,
                "end": 62.430
            },
            {
                "speaker_id": "3",
                "transcription": "자 요거 쓰면은 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.440,
                "end": 66.509
            },
            {
                "speaker_id": "4",
                "transcription": "선생님이 하는 거 잘 봐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.519,
                "end": 68.289
            },
            {
                "speaker_id": "5",
                "transcription": "퍼레이드를 시작할게.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.299,
                "end": 69.640
            },
            {
                "speaker_id": "6",
                "transcription": "어둠으로 사라져라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.650,
                "end": 72.252
            },
            {
                "speaker_id": "3",
                "transcription": "아 죽지가 않네요 지금 딜이 좀 부족하긴 하네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.261,
                "end": 75.940
            },
            {
                "speaker_id": "3",
                "transcription": "아 딜이 좀 아쉽네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 75.940,
                "end": 77.930
            },
            {
                "speaker_id": "5",
