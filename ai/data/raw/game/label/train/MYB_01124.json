    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이런식으로 유용하게 가능하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.179
            },
            {
                "speaker_id": "1",
                "transcription": "자 어 이번에는 레어 무공비급 이걸로 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.189,
                "end": 6.556
            },
            {
                "speaker_id": "1",
                "transcription": "자 이게 중요한 점이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.566,
                "end": 8.788
            },
            {
                "speaker_id": "1",
                "transcription": "아 그래서는 @계정1님 바다요정은 잼스톤 키우라는 거예요 말라는 거예요 이 질문하는 분들 있죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.798,
                "end": 14.794
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 자체는 확실히 초월이 높고 잼스톤이 높아야지만 확실히 효과를 더 많이 볼 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.804,
                "end": 21.737
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 약간 딜러적으로 쓰고 정석덱으로 여러분들이 메인으로 쓸 거면은 확실히 초월이 높고 잼스톤도 높아야지만 효과가 높을 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.747,
                "end": 29.680
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 블랙펄 같은 경우에는 무난하게 정석덱으로 쓰기 너무 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.690,
                "end": 33.991
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이 조합 자체도 블랙펄로 똑같이 3딜덱으로도 쓸 수도 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.001,
                "end": 38.701
            },
            {
                "speaker_id": "1",
                "transcription": "그렇기 때문에 여러분들 이거는 이미 잼스톤을 바다요정에 올인했거나 나는 유독 바다요정이 초월이 높거나 하시는 분들한테 아 이렇게도 바다요정이 쓸 수 있구나 이거를 참고해서 쓰면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.711,
                "end": 51.849
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 무공비덱으로 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.859,
                "end": 54.319
            },
            {
                "speaker_id": "1",
                "transcription": "상대 올 초월이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.329,
                "end": 55.465
            },
            {
                "speaker_id": "1",
                "transcription": "다 초월이 높습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.475,
                "end": 56.717
            },
            {
                "speaker_id": "1",
                "transcription": "자 상대방은 블랙펄과 스타더스트덱이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.727,
                "end": 59.215
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 여러분들이 이제 이번 업데이트에서 중점적으로 봐야 될 거는 그래서 블랙펄이 좋냐 바다요정이 좋냐를 비교할 때 가장 핵심적으로 봐야 될 포인트는 뭐냐면은 어차피 둘 다 활용할 수 있는 덱은 아레나에 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.225,
                "end": 73.603
            },
            {
                "speaker_id": "1",
                "transcription": "다만 여러분들이 선택해야 될 점은 뭐냐 내가 좀 더 더 스펙이 더 높고 잼스톤을 투자해서 올릴 수 있는 어 그런 상황에 맞게끔 써주시면 될 것 같은데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.613,
                "end": 90.800
            }
        ]
    },
    "summary": "바다요정 자체는 딜러적으로 쓰고 정석덱으로 메인으로 쓸 거면 확실히 초월이 높고 잼스톤도 높아야지만 효과가 높을 것 같고 블랙펄 같은 경우에는 무난하게 정석덱으로 쓰기 너무 좋기에 이렇게도 바다요정이 쓸 수 있구나 이거를 참고해서 쓰면 좋을 것 같다.",
