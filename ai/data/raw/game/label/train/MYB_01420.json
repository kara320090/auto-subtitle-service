                    5
                ],
                "start": 33.947,
                "end": 40.262
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 릴레이 보스 대격전에서도 자 스펙이 낮은 유저분들도 달빛술사는 아주 유용하게 활용가치가 뛰어납니다.",
                "sound_type": [
