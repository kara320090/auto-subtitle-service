                    5
                ],
                "start": 25.168,
                "end": 33.937
            },
            {
                "speaker_id": "1",
                "transcription": "자 왜 이렇게 말했냐면 자 수호성전에서도 달빛술사는 굳건히 메인 조합으로 쓰이고 있고요.",
                "sound_type": [
