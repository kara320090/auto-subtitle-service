        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "뱀파 쿨 얘 없애세요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.659
            },
            {
                "speaker_id": "1",
                "transcription": "쿨이 있으면은 상대 그림자 뱀파를 물거나 공격이 헛방으로 들어갈 가능성이 좀 있기 때문에 그리고 이거 아레나에서 진다고 하시는데 보통 상대 뱀파 있으면은 쿨 있는 상태로 들어가면 안 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.669,
                "end": 14.935
            },
            {
                "speaker_id": "1",
                "transcription": "차라리 아몬드로 들어가세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.945,
                "end": 16.290
            },
            {
                "speaker_id": "1",
                "transcription": "들어가실 때 유동적으로 바꿔서 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.300,
                "end": 18.833
            },
            {
                "speaker_id": "1",
                "transcription": "에스프레소도 올 라즈로 할 거면은 얘 쿨이 높은 게 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.843,
                "end": 22.639
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 휘낭시에 얘 지금 버프를 받게 되잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.649,
                "end": 25.879
            },
            {
                "speaker_id": "1",
                "transcription": "쿨이 지금은 막 못해도 막 7, 8퍼센트 돼야 되게 좋거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.889,
                "end": 30.383
            },
            {
                "speaker_id": "1",
                "transcription": "쿨이 높으면 높을수록 좋기 때문에 어느 정도 쿨은 좀 챙겨 주시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.393,
                "end": 35.293
            },
            {
                "speaker_id": "1",
                "transcription": "상대 요새 추세는 에스프레소가 싹 다 이제 약간 쿨 높은 쪽으로 다 바뀌어 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.303,
                "end": 39.610
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 4라즈에 막 쿨까지 붙여있고 먼저 공격권을 가져가서 네 쿠키들을 죽이는 쪽으로 가기 때문에 지금 트렌드에 이게 쿨 없고 되게 늦게 공격하는 쪽으로 가면은 되게 불리하게 시작하게 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.620,
                "end": 53.933
            },
            {
                "speaker_id": "1",
                "transcription": "모노클도 한번 써 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.943,
                "end": 55.738
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘이 일찍 죽거나 그래서 깃털 쓴 거라면은 차라리 모노클이 나은 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.748,
                "end": 60.585
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱은 이거 옛날에 제가 리뷰한 거 이거 리뷰한 거 보고 따라 하신 거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.595,
                "end": 65.684
            },
            {
                "speaker_id": "1",
                "transcription": "계정 주인분 이거 올 아몬드로 하셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.694,
                "end": 67.925
            },
            {
                "speaker_id": "1",
                "transcription": "그래야 스킬 순서가 뒤에가 더 이쁘고 나중에 휘낭이 얘네가 스킬 연계되고 얘가 마지막에 공격해서 상대 죽이는 그림 나와서 이 덱을 지금 쓰실 거면은 여기 아몬드 세팅하셔야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.935,
                "end": 80.255
            },
            {
                "speaker_id": "1",
                "transcription": "지금 바요가 내가 볼 때 이거 24.9면은 터져요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.265,
                "end": 85.200
            }
        ]
    },
    "summary": "뱀파는 쿨이 있으면 공격이 헛방이 될 가능성이 있기 때문에 아몬드로 들어가는 게 좋고 에스프레소를 올 라즈로 하는 경우에는 쿨이 높은 게 좋으며 계정 주인에게는 아몬드 세팅을 하라고 권고한다.",
