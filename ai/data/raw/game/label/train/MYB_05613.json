        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "얘 피감 더 주시고 아몬드, 아몬드, 아몬드, 쿨, 쿨 하세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.267
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 안정적으로 하고 싶다면 그리고 얘 모노클보다는 낫이 더 좋아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.277,
                "end": 7.871
            },
            {
                "speaker_id": "1",
                "transcription": "지금 몇 웨이브 어디까지 가셨어요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.881,
                "end": 10.317
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 간 거예요 28?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.327,
                "end": 13.781
            },
            {
                "speaker_id": "1",
                "transcription": "아 28까지만 간 거예요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.791,
                "end": 15.932
            },
            {
                "speaker_id": "1",
                "transcription": "이걸로 제가 대충 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.942,
                "end": 18.627
            },
            {
                "speaker_id": "1",
                "transcription": "너무 피감이 낮긴 한데 그래도 되지 않을까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.637,
                "end": 21.164
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 이거 가지고 이거는 깰 거 같은데 28까지 자 연습하기로 보여 드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.174,
                "end": 25.947
            },
            {
                "speaker_id": "1",
                "transcription": "야 초반에 여기 저는 다 그냥 유물 효과로 지나가는데 야 이게 극혐이구나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.957,
                "end": 33.790
            },
            {
                "speaker_id": "1",
                "transcription": "아 그쵸 초반 이렇게 보니까 어렵죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.800,
                "end": 36.200
            },
            {
                "speaker_id": "1",
                "transcription": "아 진태님 진태님은 이거 어디까지 뚫기 원해요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.210,
                "end": 39.987
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 내가 진짜 각 잡고 세팅을 해드리던가.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.997,
                "end": 43.339
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 진심으로 지금 웨이브 높게 가고 싶으시면은 아마 아레나 이런 거 싹 다 빼와서 아예 그냥 다 뜯어 고쳐야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.349,
                "end": 52.063
            },
            {
                "speaker_id": "1",
                "transcription": "아 60까지는 내가 볼 때는 좀 지금 토핑으론 좀 많이 힘들지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.073,
                "end": 57.040
            },
            {
                "speaker_id": "1",
                "transcription": "이거 60 웨이브는 다른 랭커분들이 도와줘도 힘들걸요 토핑이나 저기 키운 게 너무.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.050,
                "end": 67.866
            }
        ]
    },
    "summary": "한 남자가 게임에서 시청자 계정으로 연습 게임을 진행 하면서 퀘스트를 어디까지 깨고 싶은지 묻는다.",
