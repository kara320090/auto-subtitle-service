        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 해서 이 밀키웨이가 피감이 잘 높지 않으면은 죽을 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.184
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 피감 높으면은 이렇게 살아서 한 번 더 스킬 씁니다.",
                "sound_type": [
                    2
                ],
                "start": 5.194,
                "end": 9.083
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 되고 자 밀키웨이랑 도넛이 끝까지 살아남았죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.093,
                "end": 14.871
            },
            {
                "speaker_id": "1",
                "transcription": "네 살아남아서 스킬 한 번 더 써서 마지막 딜까지 더 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.881,
                "end": 21.238
            },
            {
                "speaker_id": "1",
                "transcription": "자 최종적으로 이 두 마리 쿠키가 남아서 끝까지 딜을 넣어서 4억 딜이 넘는 딜이 나온다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.248,
                "end": 29.467
            },
            {
                "speaker_id": "1",
                "transcription": "자 딜표를 보면 야 무려 주스가 3.5억이 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.477,
                "end": 34.037
            },
            {
                "speaker_id": "1",
                "transcription": "4억 딜에 자기 혼자 3.5억을 다 넣고 있어요.",
                "sound_type": [
                    2
                ],
                "start": 34.047,
                "end": 37.498
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 얼마나 주스의 사기적인 딜량이 나오는지 확인할 수가 있습니다.",
                "sound_type": [
                    2
                ],
                "start": 37.508,
                "end": 43.233
            }
        ]
    },
