        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 스칼렛 님 계정 평가 시작합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.133
            },
            {
                "speaker_id": "1",
                "transcription": "이분은 좀 특이한 사연 가지고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.143,
                "end": 5.359
            },
            {
                "speaker_id": "1",
                "transcription": "이분 예전에 계정 평가 출연했던 분인데 1년 전에 계정을 네 개를 돌리는 분으로 소개했던 분이고 왜 네 개가 됐냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.369,
                "end": 14.343
            },
            {
                "speaker_id": "1",
                "transcription": "자녀 분 두 개, 아내분 거 그리고 본인 거, 가족의 계정을 몽땅 혼자 관리하셨던 그 아버지분 어떻게 킹덤을 가족이 전부 다 시작을 했었는데 나머지 이제 가족분들이 힘들다고 손을 놔버려서 아 안 되겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.353,
                "end": 31.702
            },
            {
                "speaker_id": "1",
                "transcription": "네 개를 내가 혼자 다 해야 되 내가 관리해야 되겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.712,
                "end": 34.884
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 킹덤을 남들은 계정 하나 하기 힘든데 혼자서 네 계정을 다 관리하셨던 위대한 분입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.894,
                "end": 42.884
            },
            {
                "speaker_id": "1",
                "transcription": "위대한 분 왕국 운영에 문제점이 없는지 아레나 덱에 추가하면 좋은 덱이 있는지 앞으로 뭘 해야 되는지 조언을 듣고 싶습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.894,
                "end": 50.382
            },
            {
                "speaker_id": "1",
                "transcription": "네 개를 돌릴 때는 시간이 돼서 왕국 운영까지 가능했는데 시간 여유가 없다 보니 운영이 안 되서 계정 두 개는 포기하게 됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.392,
                "end": 60.646
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.656,
                "end": 63.785
            },
            {
                "speaker_id": "1",
                "transcription": "원도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.795,
                "end": 67.308
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
