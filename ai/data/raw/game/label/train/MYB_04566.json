            },
            {
                "speaker_id": "1",
                "transcription": "되게 딜은 의미가 없었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.620,
                "end": 6.680
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나에서 한번 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.680,
                "end": 8.455
            },
            {
                "speaker_id": "1",
                "transcription": "요즘 나온 덱한테 옛날 나온 이 기억나시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.465,
                "end": 12.346
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 이 덱에다가 변형된 덱이 많았어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.356,
                "end": 15.236
            },
            {
                "speaker_id": "1",
                "transcription": "스파클링 자리에다가 아몬드맛 쿠키나 퓨어바닐라 쓰거나 다양한 덱이 많이 쓰였는데 대표적으로 가장 강력했던 폭딜 이거 한번 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.246,
                "end": 25.900
            },
            {
                "speaker_id": "1",
                "transcription": "자 5초월 덱이에요. 5초월로 도배된 최고의 스펙으로 꾸렸습니다.",
                "sound_type": [
