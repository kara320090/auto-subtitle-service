        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠런키런을 PC에서 즐길 때 녹스 엠플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.842
            },
            {
                "speaker_id": "1",
                "transcription": "방치형 모바일 게임을 편하게 모니터링 가능하며 핸드폰 발열이나 배터리 부족으로 인한 불편함도 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.852,
                "end": 8.163
            },
            {
                "speaker_id": "1",
                "transcription": "PC에서 큰 화면에 초고화질로 몰입할 수 있는 녹스엠플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.173,
                "end": 12.332
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 토핑 보면 블루베리는 쿨 여러분들 능력껏 주시는 좋을 것 같아요. 많이 주면 줄 수록 좋을 것 같고 그 다음에 캡사이신 같은 경우에는 피감도 최대한 여러분들 줄 수 있을 만큼 주고 공격력 치명타 확률 신경 써서 높여 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.342,
                "end": 28.469
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스터는 뭐 쿨 15퍼센트도 괜찮고 더 높아도 상관 없는데 저는 이 가운데 쯤에 준 이유는 피해 치명타 확률을 최대한 신경 많이 쓰는 토핑을 끼워 넣었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.479,
                "end": 40.470
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 확률이 어 높을 수록 상당히 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.480,
                "end": 43.639
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 달빛술사가 가장 중요한 포인트입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.649,
                "end": 46.484
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 만약에 그냥 누군가가 캡사이신 토핑 뭐 쓰면 좋나요라고 물어봤을 때 어 @이름1님 그냥 아몬 라즈베리 쓴다 이렇게만 말해주면 쓰 그 쓴 사람은 아마 왜 난 다지지 약간 이런 식으로 생각할 수가 있는 게 달빛술사가 토핑 쿨을 어떻게 세팅 하느냐에 따라서 승률이 엄청나게 차이납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.494,
                "end": 68.040
            },
            {
                "speaker_id": "1",
                "transcription": "저도 맨 처음에 올 라즈 썼을 때 승률이 많이 높지는 않아요. 거의 한 60퍼센트 50퍼센트 70퍼센트 상위권에서 그렸는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.050,
                "end": 76.443
            }
        ]
    },
    "summary": "블루베리는 여러분 능력껏 주시는 게 좋고 많이 주면 좋고 캡사이신 같은 경우에는 피감도 최대한 줄 수 있을 만큼 주고 공격력 치명타 확률 신경 써서 높여 주면 스타더스터는 쿨 15퍼센트도 괜찮고 더 높아도 상관없는데 저는 이 가운데쯤에 준 이유는 피해 치명타 확률을 최대한 신경 많이 쓰는 토핑을 끼워 넣었다.",
