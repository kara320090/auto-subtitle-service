        "term": [
            {
                "speaker_id": "1",
                "transcription": "다만 그 대가로 영혼에 주박이 새겨집니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.372
            },
            {
                "speaker_id": "1",
                "transcription": "이 주박으로 해당 개체는 가주님께 거역할 수 없게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.382,
                "end": 7.087
            },
            {
                "speaker_id": "1",
                "transcription": "한시적인 영역 종 영적 종속 상대라 영적 종속 상태라고 볼 수 있습니다.",
                "sound_type": [
