                    3
                ],
                "start": 7.097,
                "end": 13.808
            },
            {
                "speaker_id": "2",
                "transcription": "노예가 되었다 이 말인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.818,
                "end": 15.803
            },
            {
                "speaker_id": "3",
                "transcription": "잠깐 노예라니?",
