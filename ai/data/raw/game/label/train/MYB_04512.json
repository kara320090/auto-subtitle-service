                ],
                "start": 5.944,
                "end": 10.247
            },
            {
                "speaker_id": "1",
                "transcription": "스킨은 지금 스킨은 다 안 뽑았는데 이건 극한의 효율을 위한 겁니다.",
                "sound_type": [
                    2,
