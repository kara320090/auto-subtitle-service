            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거는 진 거 같진 않네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.738
            },
            {
                "speaker_id": "1",
                "transcription": "네 요렇게 이기는 그림이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.748,
                "end": 9.243
            },
            {
                "speaker_id": "1",
                "transcription": "제가 써본 후기를 말씀드리면은 일단 토벌에서는 얘를 쓰면은 감초에서는 너무나 쎄 가지고 감초 쫄이 죽어버리는 현상 때문에 예상과는 다르게 메인으로 쓰는 덱으로 토벌 덱이 나오진 않고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.253,
                "end": 24.719
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서는 글세요 특정 덱으로는 뭐 쓸 것 같기는 한데 상황을 지켜봐야 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.729,
                "end": 31.588
            },
            {
                "speaker_id": "1",
                "transcription": "지금 원하는 거는 뭐 티어 몇 티어냐? 당장 키워야 되냐? 그러기에는 뭐 당장 키워야 될 쿠키는 리뷰 당일날에서는 좀 지켜봐야 되는 쿠키다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.598,
                "end": 41.198
            },
            {
                "speaker_id": "1",
                "transcription": "일단 그것보다는 스냅 드레곤이 워낙 완전 사기라 그거 먼저 뽑아야 되고 뽑기는 힘들겠지만.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.208,
                "end": 47.007
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 나중에 티어를 보고 쓰임새가 있으면 키워라 자 일단 타르트 쿠키는 리뷰 여기서 끝",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.017,
                "end": 58.666
            }
        ]
    },
    "summary": "리뷰 내용은 타르트 쿠키는 키워야 할지는 조금 더 지켜봐야 할 쿠키라고 결론이 나왔고, 그것보다는 스냅 드레곤이 워낙 사기 덱이라 뽑기는 힘들겠지만, 그거 먼저 뽑아야 한다고 했다.",
