        "term": [
            {
                "speaker_id": "1",
                "transcription": "준비되셨어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.901
            },
            {
                "speaker_id": "2",
                "transcription": "알엠 쿠키는 이걸로 할게요 스킨 뽑은 걸로 그래도.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.911,
                "end": 6.757
            },
            {
                "speaker_id": "3",
                "transcription": "준비한 것 다 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.767,
                "end": 8.350
            },
            {
                "speaker_id": "2",
                "transcription": "슈가 쿠키는 이걸로.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.360,
                "end": 11.603
            },
            {
                "speaker_id": "4",
                "transcription": "이번 곡도 기대해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.613,
                "end": 13.067
            },
            {
                "speaker_id": "2",
                "transcription": "아직 스킨 많이 못 뽑 못 뽑았네요 제가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.077,
                "end": 17.559
            },
            {
                "speaker_id": "5",
                "transcription": "우리 더 자주 만나요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.569,
                "end": 20.602
            },
            {
                "speaker_id": "2",
                "transcription": "그다음에 지민 쿠키도 근데 오리지널이 더 예쁜 거 같다 이 스킨은?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.612,
                "end": 26.139
            },
            {
                "speaker_id": "6",
                "transcription": "저 준비됐어요.",
