        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 클로티드 이제 자 요거 뱀파가 뒤에서 깨무는데 사실 아프지는 않아요 지금 초반에는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.674
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘이 워낙 아몬드에다가 단단하기 때문에 자 이게 진짜 포인트거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.684,
                "end": 18.055
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 바요가 때리고 터뜨리고 이게 바로 포인트입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.065,
                "end": 23.999
            },
            {
                "speaker_id": "1",
                "transcription": "저거 포인트하면 웬만해선 다 터져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.009,
                "end": 26.827
            },
            {
                "speaker_id": "1",
                "transcription": "2 1 2덱 상대로 하면은 저 한 번에 공격 모아주고 터뜨리면은 대부분 쿠키 2 3개는 다 날라가거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.837,
                "end": 34.881
            },
            {
                "speaker_id": "1",
                "transcription": "저거 때문에 되게 이 덱 자체를 공격덱으로 여러분이 활용하게 되면은 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.891,
                "end": 41.996
            },
            {
                "speaker_id": "1",
                "transcription": "2 2 1덱 그런 구조에서는 상대가 에클레어가 있으면 내가 먼저 터뜨려지는 경우 때문에 저는 선호하지 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.006,
                "end": 51.050
            },
            {
                "speaker_id": "1",
                "transcription": "만약 상대가 2 2 1이면 보통은 저는 이걸로 많이 가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.060,
                "end": 53.824
            },
            {
                "speaker_id": "1",
                "transcription": "가운데 열이 다 오픈 되어 있지 않는 한 저런 식으로 터뜨릴 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.834,
                "end": 57.699
            },
            {
                "speaker_id": "1",
                "transcription": "160만 미만에 2 1 2 이것도 한번 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.709,
                "end": 61.597
            },
            {
                "speaker_id": "1",
                "transcription": "요거는 요거 또 이제 시청자분들 중에 아니 바다요정 자리에 서리여왕 넣으면 어떤가요 서리여왕은 넣으면 스킬 연계가 조금 이상해져요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.607,
                "end": 75.052
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 원하는 만큼 그런 시원한 딜이 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.062,
                "end": 78.521
            },
            {
                "speaker_id": "1",
                "transcription": "아 제가 볼 때는 서리여왕을 쓸 바에는 네 바다요정을 쓰는 게 훨씬 더 좋지 않나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.531,
                "end": 85.101
            },
            {
                "speaker_id": "1",
                "transcription": "자 펑 터지고 자 이런 그림 제가 원하는 그림은 딱 이거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.111,
                "end": 90.475
            },
            {
                "speaker_id": "1",
                "transcription": "2 1 2덱들은 대부분 저런 식으로 그냥 펑 터지는 그림이 많이 나오기 때문에 되게 유리하게 가져갈 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 90.485,
                "end": 97.540
            },
            {
                "speaker_id": "1",
                "transcription": "네 바요클은 11.8퍼센트 이상 쿨 맞춰 주시면은 스킬 순서가 아주 이쁘게 아주 이쁘게 돌아가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.550,
                "end": 105.801
            },
            {
                "speaker_id": "1",
                "transcription": "자 이런식으로 펑 터뜨리는 바요 에스프레소 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.811,
                "end": 112.400
            }
        ]
    },
