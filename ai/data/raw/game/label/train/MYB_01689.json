    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 오늘은 제가 할 거는 이 드림 가든하고 드림 브릿지 이벤트에 대해서 중점적으로 할 건데 드림 가든은 뭐냐면 같은 식물을 이렇게 맞춰서 성장시켜서 최종 단계까지 진화시키고 그리고 다 맞추면은 이렇게 보상을 얻는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 16.430
            },
            {
                "speaker_id": "1",
                "transcription": "이 게임은 재화를 얻을 수 있는 이벤트가 많이 열리거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.440,
                "end": 20.697
            },
            {
                "speaker_id": "1",
                "transcription": "매주마다 새롭게 열리기 때문에 여러분들이 재화 수급처가 꽉 막히거나 과금을 무조건 해야 하는 건 아니기 때문에 천천히 힐링하면서 게임을 하면서 하기 좋다 그렇게 보시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.707,
                "end": 34.203
            },
            {
                "speaker_id": "1",
                "transcription": "일단 요렇게 다 못 맞추면은 시간 되면은 다시 맞추면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.213,
                "end": 37.507
            },
            {
                "speaker_id": "1",
                "transcription": "오늘은 하이라이트 제가 지금 랭킹이 없습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.517,
                "end": 40.586
            },
            {
                "speaker_id": "1",
                "transcription": "몇 등까지 가는지 자 오늘 영상에서 도전을 가보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.596,
                "end": 44.436
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 처음을 제가 소개해 드리면은 요렇게 맞춰서 가면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.446,
                "end": 48.866
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 좀 더 빨리 할라면은 원래는 이렇게 맞추면은 걸어가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.876,
                "end": 53.082
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 이렇게 걸어가거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.092,
                "end": 54.367
            },
            {
                "speaker_id": "1",
                "transcription": "이게 퍼펙트로 맞추면은 이게 뛰어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.377,
                "end": 57.019
            },
            {
                "speaker_id": "1",
                "transcription": "근데 시간이 좀 아깝잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.029,
                "end": 58.398
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이렇게 맞추고 나서 나갔다가 들어오면은 바로 다음으로 넘어가져 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 58.408,
                "end": 62.718
            },
            {
                "speaker_id": "1",
                "transcription": "요걸 이용해서 빠르게 빠르게 넘어가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.728,
                "end": 65.600
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 여기 스테이지가 총 10장까지 있는데 클리어할 때마다 보상을 얻습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.610,
                "end": 71.780
            },
            {
                "speaker_id": "1",
                "transcription": "첫단계는 이렇게 코인만 받고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.790,
                "end": 73.971
            },
            {
                "speaker_id": "1",
                "transcription": "2번째 2장 1장부터는 크리스털까지 얻을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 73.981,
                "end": 77.074
            },
            {
                "speaker_id": "1",
                "transcription": "자 2번째 장부터는 보조가 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.084,
                "end": 79.654
            },
            {
                "speaker_id": "1",
                "transcription": "내 오직 감으로 맞춰야 되기 때문에 저도 이제 숙련이 됐기 때문에 빠르게 어디까지 가나 시작하는 분들도 한번 요거 도전해 보면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.664,
                "end": 90.554
            },
            {
                "speaker_id": "1",
                "transcription": "정확도가 중요하지만 떨어지지 않는 게 더 중요하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 90.564,
                "end": 93.912
            },
            {
                "speaker_id": "1",
                "transcription": "자 보상을 최대한 많이 챙겨서 쭉쭉 쉬워 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.922,
                "end": 97.055
            },
            {
                "speaker_id": "1",
                "transcription": "보는 사람 입장에서는 아니 저거 쉬운데 뭘 못할까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 97.065,
                "end": 101.046
            },
            {
                "speaker_id": "1",
                "transcription": "저도 맨 처음에 그랬습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 101.056,
                "end": 102.602
            },
            {
                "speaker_id": "1",
                "transcription": "보기에는 너무 쉬웠어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 102.612,
                "end": 103.748
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 지금 보는 거와 같이 엄청 조그마하죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 103.758,
                "end": 106.928
            },
            {
                "speaker_id": "1",
                "transcription": "저기를 감각적으로 맞춰서 가야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 106.938,
                "end": 110.809
            },
            {
                "speaker_id": "1",
                "transcription": "처음에는 쉬워 보이지만 상당히 난이도가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 110.819,
                "end": 114.700
            }
        ]
    },
    "summary": "남성은 같은 식물을 맞춰서 성장시켜 최종 단계까지 진화시키고 맞추면 보상을 얻는 드림 가든과 드림 브릿지 이벤트를 중점적으로 할 것이고 현재 랭킹이 없기 때문에 몇 등까지 가는지 도전하려고 한다.",
