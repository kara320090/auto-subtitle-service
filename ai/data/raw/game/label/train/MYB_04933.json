        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아레나도 볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.183
            },
            {
                "speaker_id": "1",
                "transcription": "나보다 강한 적이랑 할 때는 부활이 더 좋을 때도 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.193,
                "end": 4.702
            },
            {
                "speaker_id": "1",
                "transcription": "낫이나 부활 이렇게 2개 왔다 갔다 해보시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.712,
                "end": 8.821
            },
            {
                "speaker_id": "1",
                "transcription": "아 휘낭시에 아레나에서 완전 좋은 건 맞는데 주력으로 키워야 될 쿠키는 일단은 얘예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.831,
                "end": 14.956
            },
            {
                "speaker_id": "1",
                "transcription": "스토리에서도 중요하고 얘 소다 제도에서도 써야되니까 얘네를 집중적으로 키워야 되니까 휘낭시에는 나중에 키우세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.966,
                "end": 21.657
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 좋다고 해서 지금 이렇게 하신 것 같은데 지금은 얘에 별사탕이나 스킬파우더는 쓸 때가 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.667,
                "end": 28.605
            },
            {
                "speaker_id": "1",
                "transcription": "케이크타워는 지형이 저렇게 힐러가 없을 때는 그냥 저렇게 칠리힐 쓰지 마시고 왕의추뽀 얘가 상향을 받았고 못 쓸 애는 아니거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.615,
                "end": 38.600
            },
            {
                "speaker_id": "1",
                "transcription": "너무 아프다 싶으면은 부활이나 뿔 쓰시면 되고 그리고 현상수배는 절대 크탈 쓰지 마세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.610,
                "end": 44.559
            },
            {
                "speaker_id": "1",
                "transcription": "스킬파우더 부족해가지고 이거 그냥 못 참고 하시는 분들 저도 뭔 느낌인지 아는데 그게 진짜 너무 손해예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.569,
                "end": 50.988
            },
            {
                "speaker_id": "1",
                "transcription": "핵과금러분들은 저렇게 다 써도 뭐 말리진 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.998,
                "end": 56.033
            }
        ]
    },
    "summary": "나보다 강한 적이랑 할 때는 부활이 좋을 때도 있으니 낫이나 부활을 왔다 갔다 해보면 되고 휘낭시에가 아레나에서 좋은 건 맞는데 주력으로 키워야 될 쿠키는 아니고 휘낭시에에 별사탕이나 스킬파우더는 쓸 때가 아니고 현상수배에 절대 크탈 쓰지 말고 스킬파우커 부족해서 못 참고 하는 분들 많은데 너무 손해고 핵과금러분들은 저렇게 다 써도 말리진 않겠다.",
