        "term": [
            {
                "speaker_id": "1",
                "transcription": "압도적으로 이기는 그림을 보여 주죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.377
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 각각의 상성 약점도 다 존재 하거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.387,
                "end": 6.307
            },
            {
                "speaker_id": "1",
                "transcription": "이 댁 같은 경우에는 치명적인 약점은 뭐냐면 아 요 덱한테 약합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.317,
                "end": 10.973
            },
            {
                "speaker_id": "1",
                "transcription": "예 올 애플 젤리 4초 스타더스트한테 약하고요 3초 달빛 술사한테 요 덱한테 되게 약합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.983,
                "end": 17.768
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 요 덱도 마찬가지 3초 달빛 술사 4초 스타더스트 댁한테 약하다 하지만 뭐 요 덱 같은 경우에는 뭐 변수가 워낙 많기 때문에 저는 4번 아니면 2번을 여러분들한테 가장 많이 추천드립니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.778,
                "end": 32.067
            },
            {
                "speaker_id": "1",
                "transcription": "자 다음 영상은 용과드래곤 관련된 영상 준비해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 32.077,
                "end": 37.288
            },
            {
