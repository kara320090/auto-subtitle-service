        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이걸 야 올 5초월을 뚫는다고?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.230
            },
            {
                "speaker_id": "1",
                "transcription": "버프가 근데 큰게 좋을게 아니라 얘가 오이스터도 있고 마카롱도 있어서 공격력이 엄청나게 증가되는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.240,
                "end": 10.450
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 중첩이 되거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.460,
                "end": 12.054
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱이 주는 공격력 버프가 20퍼센트 정도 된고 중첩되면 오이스터가 치명타 확률하고 치명타 피해량 증가시켜주고 치명타에 확률도 증가시켜 주니까 소환덱 자체의 공격력이 전체적으로 엄청나게 증가되는 건 맞아요.",
                "sound_type": [
