        "term": [
            {
                "speaker_id": "1",
                "transcription": "전투인 것 같은데 턴젠 거 같은데 이거 뭐하는 거지 약간 이랬었어요.",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 4.362
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이걸 골랐던 것 같아.",
                "sound_type": [
                    2
                ],
                "start": 4.372,
                "end": 6.551
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 너무 감사드리고 유튜브에도 올려보도록 할게요. 아 너무 감사합니다.",
                "sound_type": [
                    2
                ],
                "start": 6.561,
                "end": 12.020
            },
            {
                "speaker_id": "1",
                "transcription": "음 어 암튼 그래서 이제 요거를 유튜브에다 올려야겠네요.",
                "sound_type": [
                    2
                ],
                "start": 12.030,
                "end": 18.393
            },
            {
                "speaker_id": "1",
                "transcription": "근데 잠깐만 나 다행히 오늘 녹화했다.",
                "sound_type": [
                    2
                ],
                "start": 18.403,
                "end": 20.939
            },
            {
                "speaker_id": "1",
                "transcription": "아 감사합니다 신이시여. 오늘 녹화했네요 진짜.",
