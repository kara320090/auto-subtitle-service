        "term": [
            {
                "speaker_id": "1",
                "transcription": "지금껏 싸워본 중에 가장 싱겁게 끝난 싸움이기도 했으니 아주 못 믿을 말은 아니지만",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.726
            },
            {
                "speaker_id": "1",
                "transcription": "용과드래곤 쿠키 나와 여러번 싸워봤으니 너도 알고 있겠지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.736,
                "end": 16.040
            },
            {
                "speaker_id": "1",
                "transcription": "네가 용으로 변신해도 내 열정의 방패가 널 납작하게 만들 수 있다는거 허튼 짓은 할 생각 말아.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.050,
                "end": 25.590
            },
            {
                "speaker_id": "2",
                "transcription": "하 거 참 이렇게 신뢰가 부족해서야 거래할 수 있겠어?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 25.600,
                "end": 31.105
            },
            {
                "speaker_id": "2",
                "transcription": "표정 좀 풀지 그래.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.115,
                "end": 32.795
            },
            {
                "speaker_id": "2",
                "transcription": "어차피 지금 나는 너희랑 똑같은 쿠키잖아?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.805,
                "end": 35.964
            },
            {
                "speaker_id": "1",
                "transcription": "하하 말은 잘하네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.974,
                "end": 39.683
            },
            {
                "speaker_id": "1",
                "transcription": "동맹을 위한 동맹이라 이거지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.693,
                "end": 43.982
            },
            {
                "speaker_id": "1",
                "transcription": "좋아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.992,
                "end": 44.886
            },
            {
                "speaker_id": "1",
                "transcription": "잘 부탁해 용과드래곤 쿠키 함께 용의 협곡으로 가보자고.",
                "sound_type": [
                    2,
                    3,
                    5
