    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "40대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "딜러에 집중되어 있기 때문에 홀리베리가 일찍 터져서 없어집니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.180
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 아레나 진행하면서 상성 파악은 각각 천천히 해보시면 되니까 하나하나 천천히 파악해보시면 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.180,
                "end": 15.416
            },
            {
                "speaker_id": "1",
                "transcription": "원탱한테 가면은 얘는 힐러가 부족하기 때문에 죽는 경우가 아까 홀리베리가 일찍 죽고 딜러들이 쉽게 빨리 녹는 경우가 있기 때문에 가급적이면은 2탱한테만 극딜 조합을 써라 그렇게 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.426,
                "end": 33.375
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 보시면 아시겠지만 극딜 조합으로 쓰면은 상대 탱커도 없어지고 딜러들이 하나하나 순삭해서 없어지는 그림을 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.385,
                "end": 45.759
            },
            {
                "speaker_id": "1",
                "transcription": "시원시원하게 이기는 그림을 볼 수가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.769,
                "end": 48.845
            },
            {
                "speaker_id": "1",
                "transcription": "각각의 장, 단점을 확실히 여러분들 알고 게임을 하시면 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.855,
                "end": 53.069
            },
            {
                "speaker_id": "1",
                "transcription": "자 역시 4번은 원탱 말고 2탱한테 가라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.079,
                "end": 56.419
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에는 1번덱을 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.429,
                "end": 58.138
            },
            {
                "speaker_id": "1",
                "transcription": "자 아까 말씀드렸죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.148,
                "end": 59.254
            },
            {
                "speaker_id": "1",
                "transcription": "상대방 보니까 블랙펄, 블랙펄 위치가 똑같네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 59.264,
                "end": 62.329
            },
            {
                "speaker_id": "1",
                "transcription": "가운데가 가려졌죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.339,
                "end": 63.636
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들 여기서 놀라운 거는 전투력을 보니까 저보다 무려 20만이나 더 높아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.646,
                "end": 68.777
            },
            {
                "speaker_id": "1",
                "transcription": "앞에 스타더스트가 아니라 이거는 3딜덱이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.787,
                "end": 72.004
            },
            {
                "speaker_id": "1",
                "transcription": "아까 3딜덱은 뭐라 그랬어요 제가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.014,
                "end": 74.438
            },
            {
                "speaker_id": "1",
                "transcription": "락스타 덱이 우위다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.448,
                "end": 76.068
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 전투력을 보고도 덱이 어떤 건지 파악이 충분히 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.078,
                "end": 80.640
            },
            {
                "speaker_id": "1",
                "transcription": "네 딱 그 유추가 딱 됐죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.650,
                "end": 83.036
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 아레나를 할 때 상대가 가려졌다고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.046,
                "end": 86.533
            }
        ]
    },
    "summary": "아레나 진행하면서 상성은 하나하나 천천히 파악하여 각각의 장, 단점을 확실히 알고 게임을 하면 좋고 전투력을 보고도 덱이 어떤 건지 파악이 충분히 가능하다.",
