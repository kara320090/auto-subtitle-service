        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "고기 젤리가 곧 토핑 조각이기 때문에 고기 젤리 소모하는 게 상당히 중요하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.252
            },
            {
                "speaker_id": "1",
                "transcription": "토핑을 얻으면은 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.630,
                "end": 6.775
            },
            {
                "speaker_id": "1",
                "transcription": "근데 어디서 얻냐면은 아몬드랑 거의 라즈베리가 동시에 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.190,
                "end": 11.732
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 나머지 쿨 토핑작은 어디서 하나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.935,
                "end": 13.937
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 해도 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.127,
                "end": 15.100
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 하면은 이제 고기 젤리 소모가 적고 여기는 고기 젤리 소모가 좀 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.502,
                "end": 19.207
            },
            {
                "speaker_id": "1",
                "transcription": "여기는 15가 되는데 보상이 조금 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.582,
                "end": 22.320
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 조각이 여기는 2개가 나와요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.740,
                "end": 24.295
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 토핑 얻을 확률도 좀 증가가 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.620,
                "end": 27.095
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 여러분들이 선택해서 고기 젤리 소모를 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.345,
                "end": 30.655
            },
            {
                "speaker_id": "1",
                "transcription": "고기 젤리가 정말 부족하시다면은 요거를 하는 방법도 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.972,
                "end": 33.987
            },
            {
                "speaker_id": "1",
                "transcription": "크탈로 구매하는 건데 크탈까지 구매하면서까지 고기 젤리를 소모하고 싶다 하시는 분들은 두 번째까지는 제가 추천드려요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.387,
                "end": 40.070
            },
            {
                "speaker_id": "1",
                "transcription": "세 번째는 한번 증가하는데 300크리스탈까지 들기 때문에 얘는 좀 비추입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.255,
                "end": 44.958
            }
        ]
    },
    "summary": "고기 젤리가 곧 토핑 조각이기 때문에 고기 젤리 소모하는 게 상당히 중요한데 여기서 하면 토핑 조각이 2개가 나오고 에픽 토핑 얻을 확률도 증가되는데 각자 선택해서 고기 젤리 소모를 하면 되고 고기 젤리가 정말 부족하다면 크탈로 구매하는 건데 두 번째까지는 괜찮지만 세 번째는 한번 증가하는데 300크리스탈까지 들기 때문에 비추이다.",
