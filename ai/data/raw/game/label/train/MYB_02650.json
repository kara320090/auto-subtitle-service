                    2,
                    3
                ],
                "start": 11.108,
                "end": 14.327
            },
            {
                "speaker_id": "3",
                "transcription": "조금만 기다려 들뜨는 건 나도 마찬가지라고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.337,
                "end": 19.260
            },
            {
                "speaker_id": "2",
                "transcription": "이제 준비다 된 거지? 빨리 가자고",
