        "term": [
            {
                "speaker_id": "1",
                "transcription": "우유 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 0.681
            },
            {
                "speaker_id": "1",
                "transcription": "씁 아쉽게도 우유는 맛탕이 나왔음에도 불구하고 지금 딱히 뭐 메인으로 쓰이는 데는 없네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.691,
                "end": 6.662
            },
            {
                "speaker_id": "1",
                "transcription": "심지어 길드 토벌전에서도 어느 정도 쓰이나 싶었는데 안 쓰이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.672,
                "end": 11.315
            },
            {
                "speaker_id": "1",
                "transcription": "러너 님 붕어빵에 팥 넣어요 슈크림 넣어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.325,
                "end": 14.084
            },
            {
                "speaker_id": "1",
                "transcription": "저는 무조건 붕어빵은 약간 팥?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.094,
                "end": 16.963
            },
            {
                "speaker_id": "1",
                "transcription": "팥을 좋아해 가지고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.973,
                "end": 18.866
            }
        ]
    },
    "summary": "화자가 우유는 메인으로 쓰이는 데가 없어 아쉽다고 하며 붕어빵에는 팥을 좋아한다고 한다.",
