        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "어딜 가나 주목받을 수밖에 없는 쿠키생",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.554
            },
            {
                "speaker_id": "2",
                "transcription": "우와 이게 다 환영하러 나온",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 3.564,
                "end": 7.022
            },
            {
                "speaker_id": "1",
                "transcription": "용감한 쿠키 그러고 있으면 되나?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 7.032,
                "end": 9.655
            },
            {
                "speaker_id": "1",
                "transcription": "멀뚱하게 서 있으면 멋이 안 나잖아.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 9.665,
                "end": 12.201
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 등을 돌리고 고개를 살짝 젖히면 좋은 각도가 나오지.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 12.211,
                "end": 17.880
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 이렇게 무심한 듯 차갑게 풍성한 머리칼을 쓸어 넘기는 포즈는 어떤가?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 17.890,
                "end": 25.164
            },
            {
                "speaker_id": "2",
                "transcription": "그건 불가능해.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 25.174,
                "end": 26.953
            },
            {
                "speaker_id": "3",
                "transcription": "저 쿠키는 누군데 마들렌맛 쿠키님이랑 같이 있는 거지?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 26.963,
                "end": 30.421
            },
            {
                "speaker_id": "4",
                "transcription": "자세히 보니 단순한데 매력 있어.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 30.431,
                "end": 33.605
            },
            {
                "speaker_id": "5",
                "transcription": "건강하게 구워진 반죽 보면 볼수록 빠져들어.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 33.615,
                "end": 38.145
            },
            {
                "speaker_id": "6",
                "transcription": "아까보다 쿠키들이 더 많아졌어.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 38.155,
                "end": 40.394
            },
            {
                "speaker_id": "6",
                "transcription": "왜 이러는",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 40.404,
                "end": 41.777
            },
            {
                "speaker_id": "7",
                "transcription": "비공정이 착륙하는 걸 보고 모여든 게 아닐까 합니다.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 41.787,
                "end": 44.914
            },
            {
                "speaker_id": "7",
                "transcription": "게다가 마들렌맛 쿠키님은 저희 공화국의 유명 쿠키시죠.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 44.924,
                "end": 50.808
            },
            {
                "speaker_id": "8",
                "transcription": "소울 잼의 안전이 걱정되는군.",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 50.818,
                "end": 53.153
            },
            {
                "speaker_id": "8",
                "transcription": "빨리 빠져나갈 수는 없나?",
                "sound_type": [
                    1,
                    2,
                    3
                ],
                "start": 53.163,
                "end": 56.800
            }
        ]
    },
    "summary": "남자는 환영하러 나온 시민들을 보며 안전을 걱정하며 빨리 빠져나가려고 하고 있습니다.",
