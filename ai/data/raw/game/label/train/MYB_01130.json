        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "보게 되면 스킬 쿨타임이 지금 얘가 17초 쿠키라 브레스 타이밍을 훨씬 더 지나치게 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 8.419
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 지금 파르페랑 다르게 얘가 스킬 타이밍이 안 돌아와 그게 가장 큰 차이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.429,
                "end": 17.774
            },
            {
                "speaker_id": "1",
                "transcription": "그니까 한 마디로 정리했을 때 여러분들이 아니 박하가 구리다가 아니라 왜 자꾸 죽냐가 파르페랑의 차이에서 뭐냐면 파르페는 똑같은 쿨타임 22퍼센트에서 용과 브레스 전에 스킬을 써가지고 아군한테 힐을 용과 브레스에 맞춰서 딱 써주거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.784,
                "end": 35.260
            },
            {
                "speaker_id": "1",
                "transcription": "근데 박하는 쿨을 진짜 극쿨로 더 줘야 될 거 같은데 야 28.7 나와야 되네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.260,
                "end": 40.819
            },
            {
                "speaker_id": "1",
                "transcription": "28.7 이상 돼야지만 쿨타임, 일반 쿨타임 최저네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.829,
                "end": 44.801
            },
            {
                "speaker_id": "1",
                "transcription": "28.7 이상 일단 맞췄어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.811,
                "end": 47.200
            },
            {
                "speaker_id": "1",
                "transcription": "자 이걸로 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.200,
                "end": 50.400
            }
        ]
    },
    "summary": "파르페랑 다르게 스킬 타이밍이 안 돌아오는 게 큰 차이고 28.7 이상 돼야지만 쿨타임이 일반 쿨타임 최저다.",
