        "term": [
            {
                "speaker_id": "1",
                "transcription": "보면은 되게 하나도 안 아프죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.682
            },
            {
                "speaker_id": "1",
                "transcription": "저 덱이 실제로 리뷰 때 보신 분들은 아시겠지만 이 덱이 원 원래는 진짜 엄청나게 폭딜덱이예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.692,
                "end": 10.949
            },
            {
                "speaker_id": "1",
                "transcription": "근데 거의 상처가 거의 안 나고 거의 뭐 퍼펙으로 이기죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.959,
                "end": 16.984
            },
            {
                "speaker_id": "1",
                "transcription": "완벽한 상성입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.994,
                "end": 18.183
            },
            {
                "speaker_id": "1",
                "transcription": "블루파이 덱이 있다?",
                "sound_type": [
                    2
                ],
                "start": 18.193,
                "end": 19.509
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 여러분들 요 세팅해 놓고",
                "sound_type": [
                    2,
                    5
