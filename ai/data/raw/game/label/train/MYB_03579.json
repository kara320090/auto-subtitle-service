        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 케이크 타워 200층까지 리뷰갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.950
            },
            {
                "speaker_id": "1",
                "transcription": "거의 200층 이상에는 뭐가 존재할 것인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.950,
                "end": 6.147
            },
            {
                "speaker_id": "1",
                "transcription": "자 위쪽으로 아 뭐 무난 무난하게 올라갈 수 있을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.157,
                "end": 11.916
            },
            {
                "speaker_id": "1",
                "transcription": "스펙만 되시면 뭐 몹들이 막 사기적으로 너무 아프고 그런 거는 어느 정도 버티면서 스펙 되면은 올라갈 수 있을 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.926,
                "end": 23.838
            },
            {
                "speaker_id": "1",
                "transcription": "케이크 타워 보상 구린 것 같다 어느 정도 동의합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.848,
                "end": 29.129
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 저는 기대하는 거는 저 위층에는 엄청나게 좋지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.139,
                "end": 34.443
            },
            {
                "speaker_id": "1",
                "transcription": "저 100층까지는 돌파 썼습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.453,
                "end": 36.720
            },
            {
                "speaker_id": "1",
                "transcription": "이미 거기까지 올라가 봤어야 돼 한마디로 200층까지 올라가 봐야지만 돌파로 200층까지 갈 수 있는 것 같습니다.",
                "sound_type": [
                    2,
