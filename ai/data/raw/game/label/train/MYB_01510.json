        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 하나 하나라도 좀 뽑아볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.384
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 완품 하나는 나오겠죠. 뭐",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.394,
                "end": 5.894
            },
            {
                "speaker_id": "1",
                "transcription": "조각이라도 하나 채워서 나오겠지 아흐",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.904,
                "end": 12.117
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 너무하네 아 크런치 네 샤이닝글리터 이번에 슈퍼에픽으로 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.127,
                "end": 20.093
            },
            {
                "speaker_id": "1",
                "transcription": "이 오븐브레이크에서는 그냥 일반 에픽인데 옆집에서 건너오면서 등급이 업그레이드가 됐어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.103,
                "end": 28.193
            },
            {
                "speaker_id": "1",
                "transcription": "약간 외형도 살짝 바꼈습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.203,
                "end": 30.407
            },
            {
                "speaker_id": "1",
                "transcription": "아 제발 아 씨 하나라도 좀 보고 싶은데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.417,
                "end": 40.233
            }
        ]
    },
    "summary": "화자가 이번에 슈퍼에픽으로 나왔고 등급이 업그레이드가 돼고 외형도 약간 바뀌었다고 하며 뽑기가 잘 되지 않아서 아쉬워한다.",
