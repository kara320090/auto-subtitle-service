        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 얘는 징그럽게 왜 이렇게 많이 나왔어 이거 버그 아니야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.636
            },
            {
                "speaker_id": "1",
                "transcription": "야 이 진짜 쓸모도 없는 저거 무적 보물 왜 있는 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.646,
                "end": 7.503
            },
            {
                "speaker_id": "1",
                "transcription": "징글징글하게 나왔네.",
