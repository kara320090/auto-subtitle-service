                    2,
                    3,
                    5
                ],
                "start": 7.513,
                "end": 9.061
            },
            {
                "speaker_id": "1",
                "transcription": "자 스킨 뽑기도 바로 갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.071,
                "end": 12.655
            },
            {
                "speaker_id": "1",
                "transcription": "자 요거 하나 나왔네요.",
