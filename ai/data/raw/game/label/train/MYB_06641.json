        "term": [
            {
                "speaker_id": "1",
                "transcription": "도시는 그나마 안전하지만 이런 촌락은 이리들의 위협에 그대로 노출되어 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.613
            },
            {
                "speaker_id": "1",
                "transcription": "마을 안에서 몇 번 더 습격 받을지도 모르겠군.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.623,
                "end": 7.369
            },
            {
                "speaker_id": "1",
                "transcription": "사람을 경계하도록 해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.379,
                "end": 8.825
            },
            {
                "speaker_id": "2",
                "transcription": "걱정하실 필요 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.835,
                "end": 10.786
            },
            {
                "speaker_id": "2",
                "transcription": "접근하는 인간을 모조리 배제하면 이리 역시 함께 배제될 테니까요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.796,
                "end": 15.199
            },
            {
                "speaker_id": "2",
                "transcription": "이리가 변장하는 건 인간 그렇다면 인간을 파괴할 뿐입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.209,
                "end": 19.097
            },
            {
                "speaker_id": "1",
                "transcription": "그건 어떤 의미로는 정답이긴 하다만 아니 아니지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.107,
                "end": 23.168
            },
            {
                "speaker_id": "1",
                "transcription": "무분별한 학살은 부디 지양해 줘.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.178,
                "end": 27.633
            }
        ]
    },
    "summary": "화자는 이리가 변장하는 건 인간이고 인간을 파괴할 뿐이라며, 무분별한 학살은 부디 지양해 달라고 말한다.",
