        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이 덱의 단점은 앞에 탱커들이 샤벳에 의해서 그냥 너무 녹아난다는 점이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 11.786
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳한테는 너무 약하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.796,
                "end": 13.851
            },
            {
                "speaker_id": "1",
                "transcription": "아마 마스터 쪽에 가면은 실론덱이 많을 거예요 실론덱",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.861,
                "end": 17.861
            },
            {
                "speaker_id": "1",
                "transcription": "샤벳이 정말 앞라인 녹이는데 중요하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.871,
                "end": 21.953
            },
            {
                "speaker_id": "1",
                "transcription": "실론덱 또한 제가 볼 때 1번 아니면 3번으로 한번 가 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.963,
                "end": 25.174
            },
            {
                "speaker_id": "1",
                "transcription": "저 지금 상대분이 하신 저 덱 저 세팅이 정말 제가 봤을 때 저희 무난하고 여러 덱 잘 먹는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.184,
                "end": 33.714
            },
            {
                "speaker_id": "1",
                "transcription": "2, 2, 1 덱이나 아니면은 2, 2, 2, 1, 2 덱이나",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.724,
                "end": 43.352
            },
            {
                "speaker_id": "1",
                "transcription": "저 덱이 괜찮은데 이거 소환덱 세팅 잘 되어있는 덱한테는 여지없이 녹아 내려요 어쩔 수 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.362,
                "end": 50.683
            },
            {
                "speaker_id": "1",
                "transcription": "저거는 잘 막아 주긴 하는데 소환덱을 완벽하게 막아주진 못하고 소환덱 세팅 그냥 대충 하신 분들은 다 막아내는 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.693,
                "end": 61.355
            },
            {
                "speaker_id": "1",
                "transcription": "2, 1, 2 클로티드가 원래 되게 소환덱이 잘 못 뚫기도 하거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.365,
                "end": 66.066
            }
        ]
    },
    "summary": "유튜버는 이 덱의 단점은 앞에 탱커들이 샤벳에 의해서 그냥 너무 녹아난다는 점이고 마스터 쪽에 가면 실론덱이 많을 거라고 합니다.",
