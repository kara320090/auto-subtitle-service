    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그다음에 여러분이 아셔야 될 게 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.488
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 뿔이나 나머지 낫 이런 건 안 쓰이나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.498,
                "end": 6.586
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 중심으로 설명한 이유는 선택권을 가지고 집중적으로 뽑아라 이런 취지로 말씀드린거고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.596,
                "end": 12.720
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 보물의 중요도에서만 본다면 이 낫 보물이 정말 유용하게 많이 쓰이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.730,
                "end": 19.062
            },
            {
                "speaker_id": "1",
                "transcription": "만렙을 최대한 찍어주시고 쓰시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.072,
                "end": 21.576
            },
            {
                "speaker_id": "1",
                "transcription": "뿔 같은 경우에는 초반에 에픽 보물이 없을 때 정말 유용하게 쓸 수 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.586,
                "end": 26.369
            },
            {
                "speaker_id": "1",
                "transcription": "초반 초보자분들이 쓰다가 나중에 에픽 보물 좋은 걸로 갈아타시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.379,
                "end": 31.119
            },
            {
                "speaker_id": "1",
                "transcription": "자 동전 주머니나 이런 마법 금고 같은 경우에는 쓸 데가 있나요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.129,
                "end": 35.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 월드탐험에서 여러분들 이렇게 마법금고나 동전 주머니를 세팅해서 가면 정말 미세하지만 코인을 추가로 더 얻을 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.316,
                "end": 44.943
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 솜사탕이나 기타 다른 보물들도 때에 따라서는 쓰일 때도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.953,
                "end": 51.258
            },
            {
                "speaker_id": "1",
                "transcription": "특히나 레어 무공비급도 유용하게 쓰일 때가 정말 많아서 티어로 따지자면 얘가 거의 1티어급이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.268,
                "end": 58.527
            },
            {
                "speaker_id": "1",
                "transcription": "활용가치가 얘도 좀 많이 있는 편이라서 얘도 뽑으면 레벨업은 꾸준히 해주시는 게 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.537,
                "end": 65.177
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 옛날에는 새총이나 이런 거는 정말 필수였거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 65.187,
                "end": 69.386
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐하면 방어력 깎는 쿠키들이 많지 않다 보니까 정말 좋았는데 현재는 신규 쿠키들이 방어력 감소 쿠키들이 너무나 많습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.396,
                "end": 76.632
            },
            {
                "speaker_id": "1",
                "transcription": "활용 가치는 좀 많이 낮아졌습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.642,
                "end": 79.194
            },
            {
                "speaker_id": "1",
                "transcription": "그밖에 에픽에 이런 튜브나 점액이는 하나도 안 쓰여요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.204,
                "end": 84.306
            },
            {
                "speaker_id": "1",
                "transcription": "아까 언급한 6가지 보물 그리고 낫이나 레어 무공비급 커먼 시계는 0티어급 필수 나머지 두개도 토핑작 할 때 필요하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.316,
                "end": 93.280
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 여러분들 궁금하신 분들도 있을까봐 말씀드리는데 스페셜 등급에 스노우 볼이나 두드리 폭죽은 아예 안 쓰입니다 단순 예능용이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.290,
                "end": 103.233
            }
        ]
    },
