        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 휘낭시에맛 쿠키 초월까지 하고 리뷰해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.374
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 70렙까지 바로 맥스 찍어주고 스킬 파우더도 방어형 파우더 싹 다 찍어보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.384,
                "end": 12.146
            },
            {
                "speaker_id": "1",
                "transcription": "초월을 하게 되면은 대략적으로 4에서 5퍼센트 정도 능력치가 올라가는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.156,
                "end": 18.908
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 스킬 설명을 보게 되면 15초 쿠키네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.918,
                "end": 22.534
            },
            {
                "speaker_id": "1",
                "transcription": "전투의 시작부터 자신이 쓰러지는 순간까지 아군 쿠키 하나를 충실하게 호위한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.544,
                "end": 28.215
            },
            {
                "speaker_id": "1",
                "transcription": "호위는 클로티드 크림 쿠키 우선이지만 없는 경우 공격력이 가장 높은 아군 쿠키가 대상이 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.225,
                "end": 34.416
            },
            {
                "speaker_id": "1",
                "transcription": "스킬을 사용하면 자신과 호위를 받는 쿠키에게 체력 회복, 피해 감소, 치명타 피해 감소, 공격력 증가, 빛의 방패 효과 부여 어마무시하게 사기적인 버프를 다 주고 적들에게 범위 피해를 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.426,
                "end": 45.555
            },
            {
                "speaker_id": "1",
                "transcription": "빛의 방패는 보호막 역할을 하며 빛의 방패가 사라질 때 빛의 방패에 피해를 준 적에게 빛의 심판을 내린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.565,
                "end": 53.125
            },
            {
                "speaker_id": "1",
                "transcription": "엄청나게 사기적인 스킬이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.135,
                "end": 55.013
            },
            {
                "speaker_id": "1",
                "transcription": "1회 피해량은 389퍼센트, 체력 회복은 공격력의 80퍼센트, 클로티드 크림 대상일 경우에는 공격력의 120퍼센트 클로티드랑 같이 쓰면 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.023,
                "end": 65.264
            },
            {
                "speaker_id": "1",
                "transcription": "피해 감소는 15초 동안 무려 20퍼센트, 이건 되게 높은 수치거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.274,
                "end": 71.010
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 피해 감소는 15초 동안 20퍼센트, 공격력 증가는 15초 동안 14.7퍼센트, 빛의 방패는 5초 동안 시전자 최대 체력의 12.7퍼센트 장난 아니네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.020,
                "end": 80.383
            },
            {
                "speaker_id": "1",
                "transcription": "빛의 심판, 빛의 방패가 받은 피해의 50퍼센트만큼 고정을 피해준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.393,
                "end": 85.212
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 스킬 설명 보면 진짜 핵사기인데요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.222,
                "end": 88.447
            },
            {
                "speaker_id": "1",
                "transcription": "휘낭시에 그래도 앞에 전방이니까 피해 감소 당연히 아몬드를 주는 게 낫겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.457,
                "end": 93.235
            },
            {
                "speaker_id": "1",
                "transcription": "아몬드 좀 많이 줘보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.245,
                "end": 96.866
            }
        ]
    },
    "summary": "이번에 새로 나온 휘낭시에맛 쿠키는 어마무시하게 사기적인 버프를 다 주고 적들에게 범위 피해를 주며 클로티드 크림 대상일 경우에는 그 효과가 더 늘어난다며 같이 쓰는 게 좋을 것 같다고 이야기한다.",
