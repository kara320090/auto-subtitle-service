        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.110
            },
            {
                "speaker_id": "1",
                "transcription": "원도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.123,
                "end": 6.300
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.310,
                "end": 10.339
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음인설탕노움의 케이크 가게 타이쿤 이벤트 이렇게 출시가 되네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.349,
                "end": 17.181
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키들의 즐거운 연말을 위해 달콤한 케이크를 만들어주세요 요렇게 나와있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.191,
                "end": 23.076
            },
            {
                "speaker_id": "1",
                "transcription": "저도 뭐 이게 정확히 어떤 식으로 나올지는 저도 모르겠어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.086,
                "end": 27.208
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 공식 사이트 거기에 올려져 있는 걸 보면은 케이크 타이쿤 미니 게임 추가 이렇게 되어 있거든요 이것도 미니 게임 형태로 출시될 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.218,
                "end": 37.902
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 나와봐야 알 거 같습니다 뭐 다양한 보상을 주는 형식으로 출시될 가능성이 상당히 높다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.912,
                "end": 44.467
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 혼돈의 케이크 타워가 무려 200층도 아니고 250층으로 확장됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.477,
                "end": 50.640
            },
            {
                "speaker_id": "1",
                "transcription": "기존에 150층에서 무려 100층이나 확장된 형태로 어 솔직히 이거 마스터 모드나 이런 걸로 추가될 줄 알았거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.640,
                "end": 58.350
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그런 거 없이 그냥 그냥 층수 자체만 무식하게 250층으로 확장된 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.350,
                "end": 63.834
            },
            {
                "speaker_id": "1",
                "transcription": "근데 250층까지 올라가기 힘드니까 층 돌파하기로 이미 도달한 특정 구간을 한 번에 돌파할 수 있는 층 돌파 시스템 어 고게 생긴다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.844,
                "end": 74.700
            },
            {
                "speaker_id": "1",
                "transcription": "난이도는 상당히 높을 걸로 저는 예상이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.710,
                "end": 78.904
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 여러분들이 이번 업데이트에서 포인트 잡아야 할 부분이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.914,
                "end": 83.163
            },
            {
                "speaker_id": "1",
                "transcription": "소르베맛 쿠키가 슈퍼 에픽으로 나오는데 이게 과연 정말 얼마나 사기일까 요게 관전 포인트고 두 번째 음유시인맛 쿠키도 제 2의 마카롱맛 쿠키처럼 토보로 필수로 쓰이는가 아니면 아레나에서도 쓰이는 진짜 필수 쿠키인가 요거를 좀 테스트를 해봐야 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.173,
                "end": 100.074
            },
            {
                "speaker_id": "1",
                "transcription": "이 버프같거든요 딱 봐도 버프로 활성화 된 그런 엄청난 특수 효과 같은 느낌인데 사기적인 느낌이 정말 물씬 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.084,
                "end": 110.505
            },
            {
                "speaker_id": "1",
                "transcription": "예 아무튼 11월 30일 업데이트 공지는 요렇게 되어있고 음 아직 출시되지 않은 음유시인맛 쿠키를 미리 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 110.515,
                "end": 119.420
            },
            {
                "speaker_id": "1",
                "transcription": "자 옆집에서 음유시인 어떻게 쓰는지 제가 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 119.430,
                "end": 125.347
            },
            {
                "speaker_id": "1",
                "transcription": "자 음유시인맛 쿠키 같은 경우에는 자 처음 보면 노란 색깔 이펙트가 나오죠 이거는 점수를 올려주는 그런 스킬 중에 하나입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 125.357,
                "end": 132.749
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 점수가 올라가는 모션으로 한 번 나오구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 132.759,
                "end": 136.709
            },
            {
                "speaker_id": "1",
                "transcription": "바뀌면서 나오거든요 자 빨간색 빨간색 보니까 장파죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 136.719,
                "end": 140.974
            },
            {
                "speaker_id": "1",
                "transcription": "파괴 빨간 색깔 음표가 나오면서 장파 파괴를 나타낸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 140.984,
                "end": 146.133
            }
        ]
    },
