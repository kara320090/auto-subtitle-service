        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 힘을 빼앗긴 지금은 계약을 되돌리는게 우선 홀리베리 쿠키 녀석한테 있는 영웅의 빛.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 9.845
            },
            {
                "speaker_id": "1",
                "transcription": "녀석을 잘 구슬려서 용의협곡까지 가져간다면 방법이 있을지도",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.855,
                "end": 18.635
            },
            {
                "speaker_id": "2",
                "transcription": "혼자 뭐라 중얼대는 거야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.645,
                "end": 20.953
            },
            {
                "speaker_id": "2",
                "transcription": "그래서 그 용언의 계약자가 뭔데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.963,
                "end": 24.022
            },
            {
                "speaker_id": "1",
                "transcription": "너희 하찮은 쿠키들은 설명해도 못 알아들을 거다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.032,
                "end": 27.498
            },
            {
                "speaker_id": "1",
                "transcription": "용의 생명력을 가져야만 이해할 수 있는 복잡하고도 중요한",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.508,
                "end": 32.169
            },
            {
                "speaker_id": "3",
                "transcription": "홀리베리 쿠키님 말할 때까지 두드려볼까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.179,
                "end": 36.782
            },
            {
                "speaker_id": "1",
                "transcription": "아까 내가 왜 베리 숲속에서 왜 끙끙대고 있냐고 물었지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.792,
                "end": 40.261
            },
            {
                "speaker_id": "3",
                "transcription": "음?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.271,
                "end": 41.866
            }
        ]
    },
    "summary": "홀리베리가 가지고 있는 영웅의빛을 가지고 용의협곡으로 가려고 한다.",
