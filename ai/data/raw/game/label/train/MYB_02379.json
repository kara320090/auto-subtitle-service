                    3,
                    5
                ],
                "start": 25.947,
                "end": 28.419
            },
            {
                "speaker_id": "1",
                "transcription": "그래 2 점 8 퍼센트는 줘보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.429,
                "end": 31.063
            },
            {
                "speaker_id": "1",
                "transcription": "데 얘는 치명타 확률에 비례해서 치명타 피해가 증가돼서 애플 젤리를 써야 되겠네요.",
                "sound_type": [
