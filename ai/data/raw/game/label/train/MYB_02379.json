                ],
                "start": 2.971,
                "end": 8.233
            },
            {
                "speaker_id": "1",
                "transcription": "PC에서 큰 화면에 초고화질로 몰입할 수 있는 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.243,
                "end": 13.239
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 실제로 얼마나 좋은지 가보고 아레나에서도 실제로 쓸 수 있는지까지 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.249,
                "end": 19.722
            },
            {
                "speaker_id": "1",
                "transcription": "자 칠리는 지금 현재 쿨타임이 12초죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.725,
                "end": 23.040
            },
            {
                "speaker_id": "1",
                "transcription": "12초 쿠키니까 자 도넛이랑 똑같네요.",
                "sound_type": [
