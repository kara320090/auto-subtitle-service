        "term": [
            {
                "speaker_id": "1",
                "transcription": "한판 꽤나 기네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.145
            },
            {
                "speaker_id": "1",
                "transcription": "아 레벨은 저번에 맥스 찍었으면은 만렙으로 돼있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.145,
                "end": 6.130
            },
            {
                "speaker_id": "1",
                "transcription": "한판만 더 해볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.130,
                "end": 7.562
            },
            {
                "speaker_id": "1",
                "transcription": "약간 좀 재밌긴 하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.562,
                "end": 9.115
            },
            {
                "speaker_id": "1",
                "transcription": "근데 내가 홀리베리를 하는 이유가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.115,
                "end": 11.267
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 약간 몸집이 커가지고 젤리먹는 그 약간 범위가 좀 큰 느낌이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.267,
                "end": 18.027
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들도 홀리베리 해보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.027,
                "end": 19.477
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 젊어진 느낌들 걸?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.477,
                "end": 21.660
            },
            {
                "speaker_id": "1",
                "transcription": "실제로 오븐브레이크에서는 쿠키가 먹는 몸집에 그 젤리 판정 자체가 좀 달라요 쿠키마다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.660,
                "end": 28.822
            },
            {
                "speaker_id": "1",
                "transcription": "킹덤은 어떨지 모르겠는데 오븐은 그래.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.822,
                "end": 33.145
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 왜 자꾸 부딪히는 거야 저기",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.145,
                "end": 37.866
            }
        ]
    },
