        "term": [
            {
                "speaker_id": "1",
                "transcription": "밝은 행성단이 클라이브에게",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.744
            },
            {
                "speaker_id": "1",
                "transcription": "자치령도에는 이제 도착했으려나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.754,
                "end": 4.462
            },
            {
                "speaker_id": "1",
                "transcription": "곤란한 일이 생기면 언제든지 연락해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.472,
                "end": 6.274
            },
            {
                "speaker_id": "1",
                "transcription": "특별 가격으로 모실테니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.284,
                "end": 7.929
            },
            {
                "speaker_id": "1",
                "transcription": "이변 후 각지의 상황",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.939,
                "end": 10.051
            },
            {
                "speaker_id": "1",
                "transcription": "돌의 검의 보고야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.061,
                "end": 11.244
            },
            {
                "speaker_id": "1",
                "transcription": "각지의 상황을 조사 중인데 이 기분 나쁜 하늘이 바람의 대륙 전역을 뒤덮는 바람에 사람들이 불안에 떨고 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.254,
                "end": 17.874
            },
            {
                "speaker_id": "1",
                "transcription": "자치령이 파괴된 이야기도 점점 퍼지고 있고 에텔 웅덩이와 아카시아도 늘어나고 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.884,
                "end": 23.270
            },
            {
                "speaker_id": "1",
                "transcription": "계속해서 상황을 파악해 둘게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.280,
                "end": 25.087
            },
            {
                "speaker_id": "1",
                "transcription": "아 이제 최종전 가나 보다.",
                "sound_type": [
                    2,
                    3
                ],
