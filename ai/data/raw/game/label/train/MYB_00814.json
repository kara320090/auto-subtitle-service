            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이제 정리를 해보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.626
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 러너 님 바다요정 30강은 어떻게 바로 키워야 됩니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.636,
                "end": 5.519
            },
            {
                "speaker_id": "1",
                "transcription": "제 개인적인 생각입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.529,
                "end": 7.407
            },
            {
                "speaker_id": "1",
                "transcription": "이 설명을 듣고 여러분이 판단하시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.417,
                "end": 9.882
            },
            {
                "speaker_id": "1",
                "transcription": "당장 최우선 필수라고는 생각은 안 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.892,
                "end": 14.229
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 충분히 달빛술사가 대신해서 3딜덱으로 쓸 수도 있는 상황이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.239,
                "end": 19.288
            },
            {
                "speaker_id": "1",
                "transcription": "그보다도 저는 블랙펄을 좀 더 현시점에서는 더 먼저 키워야 되지 않나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.298,
                "end": 25.675
            },
            {
                "speaker_id": "1",
                "transcription": "결과적으로 지금 쓰는 거는 블랙펄의 리더 효과를 쓰고 달빛술사로 방덱을 해놔도 바다요정 관련된 덱 들어오는 것도 막을 수 있고 무과금이나 소과금러분들은 분명히 선택을 해야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.685,
                "end": 38.942
            },
            {
                "speaker_id": "1",
                "transcription": "제 생각에는 바다요정 30강 찍으면 분명 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.952,
                "end": 43.003
            },
            {
                "speaker_id": "1",
                "transcription": "활용하기에는 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.013,
                "end": 44.310
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 블랙펄이 더 우선이지 않나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.320,
                "end": 47.763
            },
            {
                "speaker_id": "1",
                "transcription": "나름 괜찮다 이걸 보여드리고 싶었고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.773,
                "end": 50.642
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 크림슨코랄이 나와서 바다요정의 생존 그래도 어느 정도 올라갔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.652,
                "end": 55.900
            },
            {
                "speaker_id": "1",
                "transcription": "궁금한 점 있으면 댓글에 남겨 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.910,
                "end": 59.052
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.062,
                "end": 71.400
            }
        ]
    },
