        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 상대의 딜러는 죽었죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.059
            },
            {
                "speaker_id": "1",
                "transcription": "부활 보물이 아니더라도 낫 보물 들고 가도 충분히 성능이 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.059,
                "end": 9.282
            },
            {
                "speaker_id": "1",
                "transcription": "가장 무난하게 여러분들이 쓸 때 좋은 거 같아요. 이렇게 세팅하는 게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.292,
                "end": 14.256
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱도 상대가 클로티트 덱이거나 그럴 때 음 상대가 이제 안 죽으면은 지는 경우가 나오는데 근데 방덱 보니까 저 캡틴캐비어 덱이 되게 많이 보이는 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.266,
                "end": 26.875
            },
            {
                "speaker_id": "1",
                "transcription": "근데 낫으로 들어가면은 부활덱한테 이기는 경우가 더 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.885,
                "end": 31.440
            },
            {
                "speaker_id": "1",
                "transcription": "저는 그래서 낫으로 들어가고 똑같이 부활로 들어가는 것 보다 저는 낫을 더 많이 이용해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.442,
                "end": 38.500
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 아레나 달리실 때 여러분들 덱을 너무 많이 만들지 마시고 하나만 주력해서 하시는 게 좋은 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.520,
                "end": 46.859
            },
            {
                "speaker_id": "1",
                "transcription": "다른 상위권이나 좀 더 위쪽 그마쪽에서는 자색고구마, 캡틴 덱이 상당히 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.869,
                "end": 52.795
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 구간은 170만이죠? 요거는 확실히 캡틴캐비어 약간 토핑 자체가 라즈 토핑으로 되어 있는 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.805,
                "end": 61.300
            },
            {
                "speaker_id": "1",
                "transcription": "170만이라는 전투력 자체는 나오기가 힘들어요. 아몬드로는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.306,
                "end": 67.800
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 자 요것도 겨우겨우 이긴 거 같네요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.820,
                "end": 74.766
            }
        ]
    },
