        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "3라즈 2애프젤리가 더 느리냐.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.407
            },
            {
                "speaker_id": "1",
                "transcription": "와 야 이거 뭐냐?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.417,
                "end": 8.845
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 올 애플젤리네 이번 시즌도 야 이거 여러분들 올 애플젤리 시즌인데요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.855,
                "end": 21.236
            },
            {
                "speaker_id": "1",
                "transcription": "야 올 애플젤리가 답인데?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.246,
                "end": 23.106
            },
            {
                "speaker_id": "1",
                "transcription": "한 번만 더 해볼게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 23.106,
                "end": 24.034
            },
            {
                "speaker_id": "1",
                "transcription": "재수가 없어서 이렇게 결과가 나왔을 수도 있으니까 슈크림은 대체로 하려면은 그냥 일반적으로 무난하게 퓨어바닐라로 대체하시면 되고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.044,
                "end": 35.342
            },
            {
                "speaker_id": "1",
                "transcription": "타르트는 만약에 없으면은 그냥 무난하게 용과 쓰시면 돼요 용과.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.352,
                "end": 40.560
            },
            {
                "speaker_id": "1",
                "transcription": "대신에 보물은 공속 빼고 낫 보물 쓰시면 돼요 낫.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 40.560,
                "end": 44.570
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 용과 쓰기도 힘들다 하시면은 그냥 광역 딜러 다른 거로 쓰시면 되고 낫 보물 쓰세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 44.580,
                "end": 58.753
            }
        ]
    },
    "summary": "이번 시즌도 올 애플젤리 시즌으로 재수가 없어서 그런 걸 수도 있으니 한 번만 더 시도해보겠다.",
