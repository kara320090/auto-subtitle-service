        "term": [
            {
                "speaker_id": "1",
                "transcription": "앞에 탱커로 쓸 때 무난하게 대체할 때는 올 아몬드 아몬드도 아몬드 라일락도 그냥 무난하게는 네 아몬드나 라즈로 쓰면 될 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.075
            },
            {
                "speaker_id": "1",
                "transcription": "음유시인은 올 쿨 자 달토끼 앞에 있어서 쿨이나 뭐 아몬드 섞어서 쓰시면 될 것 같고 검볼다이버 올 쿨 얘는 스토리에서 초반에 대체로 쓸 거면은요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.085,
                "end": 20.211
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 아몬드로 쓰시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.221,
                "end": 22.199
            },
            {
                "speaker_id": "1",
                "transcription": "자 민트초코 올 쿨 무화과 라즈베리 네 코코아도 울 쿨 네 얘네 테일즈랑 소닉은 그냥 뭐 라즈로 그냥 재미 삼아 쓰시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.209,
                "end": 33.001
            },
            {
                "speaker_id": "1",
                "transcription": "예 스냅드래곤은 올 쿨로 쓰시고 쿨타임이 가장 중요하고 나머지 공치, 공속 이 3개에 중에서 주면 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.011,
                "end": 40.054
            },
            {
                "speaker_id": "1",
                "transcription": "BTS 쿠키도 있으시면은 스냅드래곤에 밀려서 가치는 크게 없지만 현재는 쿨타임이 제일 중요하고 똑같이 공치, 공속 이렇게 나머지 이 레어 쿠키나 커먼 쿠키는 그 통합적으로 말하면은 앞에 전방에 있 된 탱커는 아몬드 가운데 있는 딜러는 쿨이나 라즈 힐러 계열은 쿨 토핑 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.064,
                "end": 59.483
            },
            {
                "speaker_id": "1",
                "transcription": "제가 통합적으로 하나만 더 말씀드리면은 피해 감소 그다음에 쿨타임의 조합에 따라 어 세팅되니까 맞춰주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.493,
                "end": 66.783
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 여유가 될 때 공격력, 치명타 확률 등을 해 주시는 게 좋다.",
                "sound_type": [
                    2,
