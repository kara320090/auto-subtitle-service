        "term": [
            {
                "speaker_id": "1",
                "transcription": "그럴 경우에 다시 부활할 가능성이 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.248
            },
            {
                "speaker_id": "1",
                "transcription": "스파클링 같은 경우에도 이제 공속 덱 같은 거에서 같이 쓰이기도 했지만 거의 안 쓰인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.258,
                "end": 8.578
            },
            {
                "speaker_id": "1",
                "transcription": "석류맛 쿠키는 토벌에서 유용하게 쓰입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.588,
                "end": 11.958
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 쓰일 때가 있기 때문에 키우시면 되고 얘도 토벌에서도 쓰입니다?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.968,
                "end": 16.116
            },
            {
                "speaker_id": "1",
                "transcription": "대천사에서나 아니면 감초에서도 쓰이는 경우가 있기 때문에 토벌을 생각하면은 키우는 것도 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.126,
                "end": 22.814
            },
            {
                "speaker_id": "1",
                "transcription": "자 파르페 같은 경우에는 이제 아예 쓸모가 거의 없어진 상태인데 힐량 자체는 좋은데 해로운 효과 감소 자체가 어차피 BTS 쿠키나 아니면 캡틴캐비어 같이 자체적으로 해로운 효과 감소 수치가 있는 쿠키들이 이제 나오기 때문에 얘의 가치가 엄청나게 떨어졌어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.824,
                "end": 41.765
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 쓰이는 경우에는 소환 덱 자리에는 BTS 쿠키나 파르페가 쓰이기도 해서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.775,
                "end": 47.166
            }
        ]
    },
