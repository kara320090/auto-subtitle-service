        "term": [
            {
                "speaker_id": "1",
                "transcription": "추가적으로 이 락스타 자리에 스타더스트가 들어올 수도 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.380
            },
            {
                "speaker_id": "1",
                "transcription": "아니면은 샤이닝글리터 쓰는 조합도 있고 뭐 다른 소르베를 여기에 넣어서 쓰는 사람도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.380,
                "end": 8.853
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 그거는 변수가 좀 더 다양하게 있는 거 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.853,
                "end": 12.630
            },
            {
                "speaker_id": "1",
                "transcription": "변수없이 가장 승률 좋은 3개를 여러분들한테 소개해드리는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.640,
                "end": 17.394
            },
            {
                "speaker_id": "1",
                "transcription": "추가적인 질문이 있는 분들은 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.404,
                "end": 21.348
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 정말 사기적인 0티어 최고의 쿠키가 되었거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.358,
                "end": 25.860
            },
            {
                "speaker_id": "1",
                "transcription": "꼭 키워주시면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.870,
                "end": 28.402
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다, 여러분들.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.412,
                "end": 29.826
            },
            {
                "speaker_id": "1",
                "transcription": "좋아요 구독 한 번씩만 부탁드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.833,
                "end": 47.166
            }
        ]
    },
    "summary": "추가적으로 이 락스타 자리에 스타더스트가 들어올 수도 있고 샤이닝글리터나 소르베를 쓰는 사람도 있지만 그건 변수가 더 다양하게 있기에 가장 승률 좋은 3개를 알려준 것이며 블랙펄이 0티어 최고의 쿠기가 됐기에 꼭 키워주면 좋을 거 같다.",
