        "term": [
            {
                "speaker_id": "1",
                "transcription": "토핑이 좀 어느 정도 많이 있으시네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.905
            },
            {
                "speaker_id": "1",
                "transcription": "덱 세팅하기에는 좋게 되어 있으시네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.915,
                "end": 4.713
            },
            {
                "speaker_id": "1",
                "transcription": "지금 바요가 세팅 잘 되어 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.723,
                "end": 6.594
            },
            {
                "speaker_id": "1",
                "transcription": "제 유튜브에 제가 이번에 바요 이 덱으로 써서 올라왔는데 상당히 좋거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.604,
                "end": 12.084
            },
            {
                "speaker_id": "1",
                "transcription": "토핑도 지금 좋으신 상태라 제가 볼 때는 흑당도 어느 정도 세팅 다 되어 있으실 수 있으니까 크림 유니콘이랑 흑당이랑 받고 바요가 3성이기 때문에 이거 쓸만해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.094,
                "end": 23.076
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 요거 올 아몬드 얘 올 아몬드 얘 올 아몬드 그다음에 필요한 거는 4초 바요 얘를 만약에 너무 죽는다 싶으면은 3라즈, 1아몬드, 1 초코 요렇게 해서 4초 바요 만들고 요 세팅도 해 보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.086,
                "end": 37.953
            },
            {
                "speaker_id": "1",
                "transcription": "상당히 그래도 나름 괜찮거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.963,
