        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 정리하자면 전방 탱커로는 크림슨코랄 필수다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.928
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 딜러로는 블랙펄, 달빛, 스타더스트 네 요 3개가 현재 3대장급으로 엄청나게 좋게 쓰이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.938,
                "end": 10.510
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정은 조건부입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.520,
                "end": 12.097
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤 20강 그리고 초월도 달아야지만 그때서야 0티어다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.107,
                "end": 15.860
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 용과드래곤은 홀리베리랑 투탱으로 쓸 때만 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.870,
                "end": 19.869
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 힐러로는 스냅드래곤이 압도적인 0티어다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.879,
                "end": 22.944
            },
            {
                "speaker_id": "1",
                "transcription": "박하도 파르페랑 마찬가지로 현재 스냅이랑 같이 2 힐러로 좋게 쓰이고 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.954,
                "end": 27.779
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 정리해서 여러분들 알고 계시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.789,
                "end": 30.401
            },
            {
                "speaker_id": "1",
                "transcription": "네 추가적으로 궁금한 사항이 있다면 여러분들 댓글에 남겨주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.411,
                "end": 34.611
            },
            {
                "speaker_id": "1",
                "transcription": "제가 다 읽고 답변을 다 해 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.621,
                "end": 38.158
            },
            {
                "speaker_id": "1",
                "transcription": "자 키워야 될 게 정말 많아 보이지만 여러분들 상황에 맞게 질문을 해 주시면 그거에 맞게끔 제가 네는 친절하게 답변을 달아 드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.168,
                "end": 47.549
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기서 영상은 마치도록 할게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 47.559,
                "end": 49.993
            },
            {
                "speaker_id": "1",
                "transcription": "감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.003,
                "end": 53.933
            }
        ]
    },
    "summary": "남성이 정리하자면 전방 탱커로는 크림슨코랄이 필수이며 딜러는 블랙펄, 달빛, 스타더스트 그리고 힐러는 스냅드래곤, 박하, 파르페가 좋게 쓰이고 있으며 질문해 주면 답변을 달아 준다고 하며 영상을 마친다.",
