        "term": [
            {
                "speaker_id": "1",
                "transcription": "맞아 맞아 @계정1 님 보고 싶어서 오늘 처음 온 사람도 있는데 @계정2 이 날 찾아서 이렇게 와줬는데 자 오늘은 아직 방종할 시간 멀었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.351
            },
            {
                "speaker_id": "1",
                "transcription": "왜 그러냐면 지금 저희 방송 보시는 분들이 방종이라는 그 말이 발작 버튼 이어 가지고 난리가 나요 방종할까 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.361,
                "end": 17.463
            },
            {
                "speaker_id": "1",
                "transcription": "아니 방송 글쎄 8시가 생방송 시작이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.473,
                "end": 20.800
            },
            {
                "speaker_id": "1",
                "transcription": "제가 보통 30분에서 1시간씩 일찍 킨단 말이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.810,
                "end": 25.002
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그렇게 키는데 5시부터 와 가지고 지각이라고 소리 지르면서 문 열으라고 막 그래요 5시부터.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.012,
                "end": 32.281
            },
            {
                "speaker_id": "2",
                "transcription": "쉬지 말라고 한 적 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.291,
                "end": 34.441
            },
            {
                "speaker_id": "2",
                "transcription": "쉬라고 해도 게임 해야 하니까 방송하겠다고 하신 건 @계정1 님 이십니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.451,
                "end": 39.395
            },
            {
                "speaker_id": "1",
                "transcription": "그건 맞지 그것도 신작이 나오고 요즘은 신작 쓰나미니까 열심히 해야 겠겠겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.405,
                "end": 47.033
            }
        ]
    },
    "summary": "방송 보는 사람들은 방종이란 단어가 발작 버튼이다.",
