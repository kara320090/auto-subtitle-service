        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 댕댕고 게임을 제가 플레이 해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 9.089
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거를 깨시면 기프트 카드 5000원을 드린다고 하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.099,
                "end": 13.640
            },
            {
                "speaker_id": "1",
                "transcription": "고정 댓글 확인해서 인증만 하면 바로 드린다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.650,
                "end": 17.360
            },
            {
                "speaker_id": "1",
                "transcription": "제가 한번 가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.370,
                "end": 19.350
            },
            {
                "speaker_id": "1",
                "transcription": "난이도가 예전에 나온 게임보다 훨씬 더 좀 더 쉽다고 하니까 제가 한번 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.360,
                "end": 25.641
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거는 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.651,
                "end": 27.002
            },
            {
                "speaker_id": "1",
                "transcription": "같은 그림 세 개를 딱 맞춰주면 없어지고 세 개를 맞춰주면 없어지고 세 개를 맞춰주면 없어지고 세 개를 맞춰주면 없어지고 이지하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.012,
                "end": 34.223
            },
            {
                "speaker_id": "1",
                "transcription": "이거 난이도가 이제 올라갔죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.233,
                "end": 36.401
            },
            {
                "speaker_id": "1",
                "transcription": "이거를 깨면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.411,
                "end": 37.587
            },
            {
                "speaker_id": "1",
                "transcription": "깨면 기프트 카드 5000원 드린다고 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.597,
                "end": 39.819
            },
            {
                "speaker_id": "1",
                "transcription": "저도 도전해 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.829,
                "end": 41.311
            },
            {
                "speaker_id": "1",
                "transcription": "아 난이도가 쉬운 이유가 있겠네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.321,
                "end": 43.272
            },
            {
                "speaker_id": "1",
                "transcription": "전에는 여기에 쌍으로 두 개가 있었는데 이번에는 하나가 아니라 위 쪽에 있고요.",
                "sound_type": [
                    2,
