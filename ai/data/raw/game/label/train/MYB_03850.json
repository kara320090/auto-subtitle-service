        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 되고 딜용은 아닌 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.385
            },
            {
                "speaker_id": "1",
                "transcription": "활용 가치가 얼마나 뛰어난가 고거를 좀 테스트해 봐야 될 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.395,
                "end": 7.543
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.553,
                "end": 13.012
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.022,
                "end": 16.323
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.333,
                "end": 20.186
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱이 지금 가장 무난하게 랭커 분들 많이 쓰이고 요 덱도 제가 미리 방송 전에 세팅 해봤거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.196,
                "end": 25.945
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 나쁘지 않은 덱이라 요거 크런치 초코칩 대신에 요거 한번 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.955,
                "end": 31.078
            },
            {
                "speaker_id": "1",
                "transcription": "현재 유용하게 쓰이는 덱한테 껴서 여기서 모노클 덱한테 좋은지 스타트 한번 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.088,
                "end": 37.077
            },
            {
                "speaker_id": "1",
                "transcription": "가보자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.087,
                "end": 39.121
            },
            {
                "speaker_id": "1",
                "transcription": "자 솔방울 자 바로 기절 주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.131,
                "end": 46.375
            }
        ]
    },
