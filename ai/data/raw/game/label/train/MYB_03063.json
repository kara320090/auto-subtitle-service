        "term": [
            {
                "speaker_id": "1",
                "transcription": "자색고구마도 있으면 좋죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.750
            },
            {
                "speaker_id": "2",
                "transcription": "피크닉 가기 좋은 날씨야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.760,
                "end": 22.679
            },
            {
                "speaker_id": "1",
                "transcription": "에픽 탱커 중 가장 좋은 녀석은 누구인가요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.689,
                "end": 36.713
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 스토리에서는 홀리베리랑 뭐 망치 와베 요런 게 좋고 그다음에 아레나에서는 홀리베리, 와베, 휘낭시에, 자색고구마나 뭐 찰스도 씁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.723,
                "end": 48.508
            },
            {
                "speaker_id": "3",
                "transcription": "추억은 밤하늘의 별자리처럼 아름다워",
                "sound_type": [
