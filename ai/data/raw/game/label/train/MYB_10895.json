                    5
                ],
                "start": 0.000,
                "end": 1.253
            },
            {
                "speaker_id": "1",
                "transcription": "그거는 저거잖아. 그 호포웨",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.263,
                "end": 10.841
            },
            {
                "speaker_id": "1",
                "transcription": "이미 있는 건데 쓰진 않았을 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.851,
                "end": 21.039
            },
            {
                "speaker_id": "1",
                "transcription": "아아 아아유 아 잠깐 잠깐 나 키 꼬인다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.049,
                "end": 60.094
            },
            {
                "speaker_id": "1",
                "transcription": "잠깐만 나 꼬인다고 손 꼬인다고 좀 봐달라고 씨.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.104,
                "end": 63.947
            },
            {
                "speaker_id": "1",
                "transcription": "아 옆이 아우 씨 아 왜 이렇게 갑자기 못해졌지.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.957,
                "end": 74.662
            },
            {
                "speaker_id": "1",
                "transcription": "요 밑에 개로 바뀌어 있어 가지고 그거 신경 쓰다가 포션 한 개 남았음.",
