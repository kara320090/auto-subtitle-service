            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "목화 에클레어 오먹 도넛 키워야 되거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.706
            },
            {
                "speaker_id": "1",
                "transcription": "도넛은 한방덱에도 많이 쓰이고 얘는 필수로 가지고 있으면 좋은 애라 불파는 왜 불파 한방덱 쓰시나 불파 뺍시다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.716,
                "end": 13.163
            },
            {
                "speaker_id": "1",
                "transcription": "불파 한방덱은 메인으로 쓰는 건 아니니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.173,
                "end": 15.801
            },
            {
                "speaker_id": "1",
                "transcription": "제가 뺄거 정해 드릴게요 이거 접속하시은 불파 빼시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.811,
                "end": 20.611
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 와베 빼세요 아까 4개 정도 말한 애들 있죠 걔네들을 집어 넣으시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.621,
                "end": 25.852
            },
            {
                "speaker_id": "1",
                "transcription": "오먹 같은 맛탕쿠키는 빼세요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.862,
                "end": 29.086
            },
            {
                "speaker_id": "1",
                "transcription": "어차피 오먹 맛탕 하려면 50레벨 이상은 자기가 무조건 키워야 하는 거라",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.096,
                "end": 34.343
            },
            {
                "speaker_id": "1",
                "transcription": "아레나는 @이름1님 유튜브에 보면 공속덱 좋은 덱들 많으니까 토핑을 분산 시키지 마세요",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.353,
                "end": 42.073
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 분산시키지 말고 집중해서 덱 여러 개 운영하는 거보다는 딱 2개 2개에다가 최고의 세팅을 해서 운영하는 게 제일 좋아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.083,
                "end": 52.131
            },
            {
                "speaker_id": "1",
                "transcription": "보면 토핑 상태가 좋지가 않거든요 그냥 냉정하게 아직 피감이나 이런 게 많이 없기 때문에 토핑작 잘 되기 전까지는 조금",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.141,
                "end": 60.804
            },
            {
                "speaker_id": "1",
                "transcription": "덱 운영을 2개 정도로 딱 고정해서 가장 좋은 거는 토핑 세팅이 좀 쉬운 한방덱 그리고 정석덱 하나에다가 그다음에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.814,
                "end": 70.583
            },
            {
                "speaker_id": "1",
                "transcription": "따로 공속덱 키워 놨으니까 공속덱 이 3개만 어떻게든 세팅 해놓으면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 70.593,
                "end": 77.509
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱은 사실 추천은 안 하는데 이분은 이미 너무 많이 키워 놨어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.519,
                "end": 82.840
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱을 쓰겠다는 의지가 피나맛 쿠키에서도 드러납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.850,
                "end": 88.270
            },
            {
                "speaker_id": "1",
                "transcription": "어느 정도 세팅은 다 해놓으신 거니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 88.280,
                "end": 90.700
            }
        ]
    },
    "summary": "남자가 유튜브 시청자들의 게임 속 세팅을 도와주고 있다.",
