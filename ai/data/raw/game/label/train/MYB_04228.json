        "term": [
            {
                "speaker_id": "1",
                "transcription": "오로라 재료를 좀 균형을 맞춰주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.447
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 따로 만들 거는 제가 이따가 보고 하고는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.457,
                "end": 8.324
            },
            {
                "speaker_id": "1",
                "transcription": "한 번에 모아서 뽑기 한번 시원하게 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.334,
                "end": 12.526
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱맛 뽑기 노려서 뽑을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.536,
                "end": 15.437
            },
            {
                "speaker_id": "1",
                "transcription": "아레나에서 좋은지는 이미 해봤고 스토리에서 좋은지 한번 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.447,
                "end": 19.695
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.705,
                "end": 21.605
            },
            {
                "speaker_id": "1",
                "transcription": "마카롱 뽑고 갈게요.",
