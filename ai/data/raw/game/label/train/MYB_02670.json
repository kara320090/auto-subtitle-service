        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 잘 되어있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.347
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 이상적으로 다 잘 하고 있는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.357,
                "end": 3.495
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 랜드마크도 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.505,
                "end": 6.435
            },
            {
                "speaker_id": "1",
                "transcription": "이 분은 내가 볼 땐 계평이 필요없는 분이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.445,
                "end": 9.321
            },
            {
                "speaker_id": "1",
                "transcription": "내가 볼 때 왕꾸 그냥",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.331,
                "end": 10.779
            },
            {
                "speaker_id": "1",
                "transcription": "구경하는 느낌으로 보면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.789,
                "end": 13.348
            },
            {
                "speaker_id": "1",
                "transcription": "이거 고기 타워가 왜 없어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.358,
                "end": 15.487
            },
            {
                "speaker_id": "1",
                "transcription": "고기타워 잠깐만 필수인데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.497,
                "end": 17.435
            },
            {
                "speaker_id": "1",
                "transcription": "고기 타워랑 나머지 다 건설하셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.445,
                "end": 19.942
            },
            {
                "speaker_id": "1",
                "transcription": "아니 스펙이 이렇게 좋은데 고기타워가 없어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.952,
                "end": 22.929
            },
            {
                "speaker_id": "1",
                "transcription": "아 뭐야 계정 주인분 몰랐어요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.939,
                "end": 25.083
            },
            {
                "speaker_id": "1",
                "transcription": "아 지금 보니까 주인분 반응 보니까 몰랐네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.093,
                "end": 29.079
            },
            {
                "speaker_id": "1",
                "transcription": "나머지도 다 지어주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.089,
                "end": 30.171
            },
            {
                "speaker_id": "1",
                "transcription": "저거 진짜 손실 엄청나",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.181,
                "end": 32.884
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 볼 거는 쿠키 하우스 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.894,
                "end": 36.123
            },
            {
                "speaker_id": "1",
                "transcription": "15 랩이니까 내가 볼 땐 쿠키 하우스 레벨도 한 11랩 이상 되셨겠지 뭐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.133,
                "end": 40.404
            },
            {
                "speaker_id": "1",
                "transcription": "11랩, 12랩, 14랩",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.414,
                "end": 43.108
            },
            {
                "speaker_id": "1",
                "transcription": "별사탕은 부족한 거 없으실 거고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.118,
                "end": 45.327
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 생산쪽 보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.337,
                "end": 47.081
            },
            {
                "speaker_id": "1",
                "transcription": "누구야 이거 왜 이렇게 부족해.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.091,
                "end": 47.990
            },
            {
                "speaker_id": "1",
                "transcription": "기본 재료가 엄청 부족하시네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.000,
                "end": 50.955
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 많이 부족하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.965,
                "end": 53.248
            },
            {
                "speaker_id": "1",
                "transcription": "도끼가 1100개",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.258,
                "end": 55.255
            },
            {
                "speaker_id": "1",
                "transcription": "아니 잠깐만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.265,
                "end": 56.671
            },
            {
                "speaker_id": "1",
                "transcription": "야 나 도토리 램프 3000개인 사람은 또 처음 봤네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.681,
                "end": 59.523
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이거 왜 이렇게 많이 지으셨죠?",
                "sound_type": [
