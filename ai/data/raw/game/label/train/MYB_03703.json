                    5
                ],
                "start": 3.071,
                "end": 6.344
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.354,
                "end": 10.213
            },
            {
                "speaker_id": "1",
                "transcription": "은근 한번 들어가 볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.223,
                "end": 11.558
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 가고 펑 한 번에 그냥 여러분들 이분이 스펙이 낮은 게 아니거든요?",
                "sound_type": [
