            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 랭커분도 이 덱으로 다 잡는 그림이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.317
            },
            {
                "speaker_id": "1",
                "transcription": "자 딜은 이렇게 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.327,
                "end": 5.738
            },
            {
                "speaker_id": "1",
                "transcription": "딜러가 3마리나 있기 때문에 그냥 상대가 암만 피감이 높다 해도 다 녹아 나는 그림이다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.748,
                "end": 13.445
            },
            {
                "speaker_id": "1",
                "transcription": "야 잠깐만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.455,
                "end": 14.278
            },
            {
                "speaker_id": "1",
                "transcription": "야 왜 왜 이래.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.288,
                "end": 15.600
            },
            {
                "speaker_id": "1",
                "transcription": "잠시만 방어 뭔데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.600,
                "end": 16.955
            },
            {
                "speaker_id": "1",
                "transcription": "아 자 바로 바꿀게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.965,
                "end": 19.017
            },
            {
                "speaker_id": "1",
                "transcription": "자 무적 덱으로 바꾸겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.027,
                "end": 20.393
            },
            {
                "speaker_id": "1",
                "transcription": "순간 토핑 다 빼놓은 거 몰라가지고 참사 났는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.403,
                "end": 23.583
            },
            {
                "speaker_id": "1",
                "transcription": "자 이걸로 바꿀게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.593,
                "end": 26.308
            },
            {
                "speaker_id": "1",
                "transcription": "아 순간 방덱 진짜 뚫려 있었네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.318,
                "end": 28.944
            },
            {
                "speaker_id": "1",
                "transcription": "맛집이었네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.954,
                "end": 30.579
            },
            {
                "speaker_id": "1",
                "transcription": "자 복수 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.589,
                "end": 31.913
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 왠지 스승님일 것 같은데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.923,
                "end": 34.087
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱을 만드신 분은 여러분들 그 스페셜 길드의 @계정1님인데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.097,
                "end": 37.884
            },
            {
                "speaker_id": "1",
                "transcription": "아 자 스승님과의 대결.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.894,
                "end": 40.598
            },
            {
                "speaker_id": "1",
                "transcription": "제가 미러전 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.608,
                "end": 42.619
            },
            {
                "speaker_id": "1",
                "transcription": "똑같은 덱이 만났을 때 어떻게 바뀌는지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.629,
                "end": 45.836
            },
            {
                "speaker_id": "1",
                "transcription": "자 어렵게 터지고 터지고 터지고.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.846,
                "end": 49.217
            },
            {
                "speaker_id": "1",
                "transcription": "나는 버텼다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.227,
                "end": 51.421
            },
            {
                "speaker_id": "1",
                "transcription": "자 미러전으로 만나면?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.431,
                "end": 54.099
            },
            {
                "speaker_id": "1",
                "transcription": "버티는 사람 크리티컬이 많이 터지는 사람이 이긴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.109,
                "end": 57.542
            },
            {
                "speaker_id": "1",
                "transcription": "네 이런 식으로.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.552,
                "end": 59.467
            },
            {
                "speaker_id": "1",
                "transcription": "자 미러전은 치명타 망겜이 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.477,
                "end": 63.193
            },
            {
                "speaker_id": "1",
                "transcription": "네 스승님과의 대결.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.203,
                "end": 65.222
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 운빨로 한번 이겼고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.232,
                "end": 67.441
            },
            {
                "speaker_id": "1",
                "transcription": "자 잠깐만 이 분도 스승님?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.451,
                "end": 69.576
            },
            {
                "speaker_id": "1",
                "transcription": "자 스승님과 2차전 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.586,
                "end": 71.652
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 가장 큰 장점이 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.662,
                "end": 73.956
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱은 정말 빨리 끝나거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.966,
                "end": 75.717
            },
            {
                "speaker_id": "1",
                "transcription": "기다릴 필요 없이 그냥 한 20초 안에 끝난다는 점.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.727,
                "end": 80.151
            },
            {
                "speaker_id": "1",
                "transcription": "자 버티자 버티자 버티자 버티자 버티자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.161,
                "end": 82.697
            },
            {
                "speaker_id": "1",
                "transcription": "자 버텼습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.707,
                "end": 86.219
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 운빨로 이겼어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.229,
                "end": 87.686
            },
            {
                "speaker_id": "1",
                "transcription": "스승님과의 대결 2차전도 운빨로 이겼다는 점.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.696,
                "end": 91.649
            },
            {
                "speaker_id": "1",
                "transcription": "어마 무시하게 빠르게 끝난다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 91.659,
                "end": 93.395
            },
            {
                "speaker_id": "1",
                "transcription": "자 스승님과의 3차전.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 93.405,
                "end": 96.682
            },
            {
                "speaker_id": "1",
                "transcription": "자 3연속 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.692,
                "end": 98.004
            },
            {
                "speaker_id": "1",
                "transcription": "운빨로 이기는 게임.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.014,
                "end": 99.977
            },
            {
                "speaker_id": "1",
                "transcription": "자 치명타가 누가 더 잘 터지냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 99.987,
                "end": 102.362
            },
            {
                "speaker_id": "1",
                "transcription": "자 스승님과의 3차전은?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 102.372,
                "end": 105.130
            },
            {
                "speaker_id": "1",
                "transcription": "버텨 버텨 버텨 버텨.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.140,
                "end": 109.000
            }
        ]
