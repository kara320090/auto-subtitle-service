                "start": 0.000,
                "end": 4.661
            },
            {
                "speaker_id": "1",
                "transcription": "맞추고 뽑기.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.671,
                "end": 9.709
            },
            {
                "speaker_id": "1",
                "transcription": "그러네 폭발형이 진짜 안 나오긴 했어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.719,
                "end": 12.660
            },
            {
                "speaker_id": "1",
                "transcription": "너무 안 나온 느낌이긴 하다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.670,
                "end": 16.331
            },
            {
                "speaker_id": "1",
                "transcription": "딸기맛도 포지션이 좀 이상하다. 딸기맛이 무슨 형이죠?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 16.341,
                "end": 20.045
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야? 야 네가 왜 방어야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.055,
                "end": 23.016
            },
            {
                "speaker_id": "1",
                "transcription": "나는 딱 그 이미지를 떠올렸을 때는 무조건 돌격형인 줄 알았는데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.026,
                "end": 28.383
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 요거 받지는 않을게요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 28.393,
                "end": 30.550
            },
            {
                "speaker_id": "1",
                "transcription": "오 바요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.560,
                "end": 31.985
            },
            {
                "speaker_id": "1",
                "transcription": "그 소르베나 좀 달빛 좀 나와주지 제발.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 31.995,
                "end": 38.099
            },
            {
                "speaker_id": "1",
                "transcription": "아 없으면 안 나왔어요. 그래도 조각으로라도.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 38.109,
                "end": 44.033
