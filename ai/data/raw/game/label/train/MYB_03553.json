        "term": [
            {
                "speaker_id": "1",
                "transcription": "까 여러분 늦게 온 분들 런 지금 뭔 상황이에요 지금 뭐예요 막 이러는 분도 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.385
            },
            {
                "speaker_id": "1",
                "transcription": "까 블랙펄이 지금 버그가 있어가지고 쓰지 마세요 간단하게 한 줄만 요약하면은 버그가 있으니까 썼다가 피해 볼 수 있는 상황이 있으니까 쓰지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.395,
                "end": 13.185
            },
            {
                "speaker_id": "1",
                "transcription": "평타 딜 오류가 있어서 데브가 정상적이라면 지금 긴급 공지 때리고 점검해야 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.195,
                "end": 19.997
            },
            {
                "speaker_id": "1",
                "transcription": "야 이게 뭔 일이냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.007,
                "end": 21.836
            },
            {
                "speaker_id": "1",
                "transcription": "야 2주년 전에 이거 웬일이야 무슨 일이야 이거.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.846,
                "end": 25.051
            },
            {
                "speaker_id": "1",
                "transcription": "야 2023년 첫 업데이트가 참 이게 업데이트 날 방송 2번 안 켭니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.061,
                "end": 31.096
            },
            {
                "speaker_id": "1",
                "transcription": "네 그냥 사람들이 모르고 자기도 모르게 악용으로 제재받을 수 있을지 모르니까 좀 알리는 목적으로 제가 키긴 했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.106,
                "end": 41.227
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 쓰지 말라고 여러분들한테 말하는 거니까 그러니까 지금 버그에 대한 설명을 살짝 하자면 평타 딜에 추가 딜이 들어가는 뭐 그런 형식이라고 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.237,
                "end": 50.590
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 잘못 건드려서 그래가지고 지금 걷잡을 수 없이 지금 사태가 커졌는데 예 지금 뭐 이 문제는 좀 심각한 것 같으니까",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.590,
                "end": 60.708
            }
        ]
    },
    "summary": "발화자는 게임에 버그가 걸리는 상황을 유저들에게 알리기 위해 방송을 하고 있습니다.",
