        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 @계정1님 뽑기 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.294
            },
            {
                "speaker_id": "1",
                "transcription": "지금 상태가 어 레전드 쿠키 바다 요정 없으시고 이거는 뭐 무조건 뽑아드리죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.304,
                "end": 10.199
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 한번 뽑기 다 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.209,
                "end": 12.879
            },
            {
                "speaker_id": "1",
                "transcription": "바로 출발 마일리지로 무공비 12렙 끝나면 남은 걸로 뭐 사시나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.889,
                "end": 21.898
            },
            {
                "speaker_id": "1",
                "transcription": "그때부터 이제 선택이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.908,
                "end": 23.505
            },
            {
                "speaker_id": "1",
                "transcription": "그때부터는 솔직히 저는 시간권이나 인연작이나 그 여러분들의 선택에 따라 하시면 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.515,
                "end": 28.961
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 다음 신규 보물을 존버한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.971,
                "end": 31.855
            },
            {
                "speaker_id": "1",
                "transcription": "보면은 신규 보물도 이제 슬슬 나올 때가 돼가고 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.865,
                "end": 35.175
            },
            {
                "speaker_id": "1",
                "transcription": "보통 신규 보물이 나오면은 마일리지가 만렙까지 한 찍는데 20만에서 30만 마일리지까지 쓰이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.185,
                "end": 41.626
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 그거 존버하는 것도 하나의 방법입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.636,
                "end": 44.491
            },
            {
                "speaker_id": "1",
                "transcription": "아 마일리지로는 보물 뽑기 해 달라 알겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.501,
                "end": 50.666
            }
        ]
    },
    "summary": "영상 속 화자는 마일리지로 무공비 12렙 끝나면 뭐 사냐는 질문을 받고 시간권이나 인연작을 사거나 다음 신규 보물을 기다리는 것도 방법이라고 답변하고 있다.",
