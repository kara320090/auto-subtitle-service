        "term": [
            {
                "speaker_id": "1",
                "transcription": "회복 시간이 필요한가 넘어지면?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 1.535
            },
            {
                "speaker_id": "1",
                "transcription": "그게 아니라 배터리가 없어.",
                "sound_type": [
                    2
                ],
                "start": 1.545,
                "end": 5.708
            },
            {
                "speaker_id": "1",
                "transcription": "액박 패드 배터리가 없는데 넘어져서 못 일어나.",
                "sound_type": [
                    2
                ],
                "start": 5.718,
                "end": 11.639
            },
            {
                "speaker_id": "1",
                "transcription": "뚱뚱해서 그래.",
                "sound_type": [
                    2
                ],
                "start": 11.649,
                "end": 12.355
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 하는 거지.",
                "sound_type": [
                    2
                ],
                "start": 12.365,
                "end": 13.546
            },
            {
                "speaker_id": "1",
                "transcription": "회복 시간이 필요한가?",
                "sound_type": [
                    2
                ],
                "start": 13.556,
                "end": 14.821
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 건전지는 회복 시간이 필요한 가봐요.",
                "sound_type": [
                    2
                ],
                "start": 14.831,
                "end": 19.022
            },
            {
                "speaker_id": "1",
                "transcription": "하하 배터리가 다 됐구나.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 19.032,
                "end": 24.325
            },
            {
                "speaker_id": "1",
                "transcription": "이왕 이렇게 된 거 잠깐 누워 있는 애들 좀 보고 계세요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.335,
                "end": 28.762
            },
            {
                "speaker_id": "1",
                "transcription": "화장실 갔다 오는 길에 배터리도 갈아올게요.",
                "sound_type": [
                    2
                ],
                "start": 28.762,
                "end": 30.780
            },
            {
                "speaker_id": "1",
                "transcription": "저거를 아 이걸 눌렀어야 됐구나.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 30.790,
                "end": 39.120
            },
            {
                "speaker_id": "1",
                "transcription": "됐으면 땡 땡땡땡 아 알겠어.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 39.130,
                "end": 56.632
            },
            {
                "speaker_id": "1",
                "transcription": "어떻게 하는건지 알 것 같아.",
                "sound_type": [
                    2,
                    4
                ],
                "start": 56.642,
                "end": 59.700
            }
        ]
    },
