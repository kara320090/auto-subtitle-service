    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "한 마디로 1.6억도 충분히 나올 수 있습니다. 치명만 잘 터지면.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.434
            },
            {
                "speaker_id": "1",
                "transcription": "자 분명히 이 영상 보고 분명히 이런 생각 들 수 있어요. 아 나는 호밀 계속 죽는데 러너님 어떻게 방법이 없나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.444,
                "end": 11.495
            },
            {
                "speaker_id": "1",
                "transcription": "자 지금 이제 하는 빌드는 호밀이 죽는 거를 가정하고 하는 거예요. 그래도 딜이 다 들어가서 잘 나오거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.505,
                "end": 18.357
            },
            {
                "speaker_id": "1",
                "transcription": "잘 보세요 이것도.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.367,
                "end": 19.613
            },
            {
                "speaker_id": "1",
                "transcription": "자 이것도 마카롱을 눌러주시고 자 벚꽃 예약에 얘는 호밀이 죽어도 되는 빌드입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.623,
                "end": 26.402
            },
            {
                "speaker_id": "1",
                "transcription": "자 벚꽃 되면 자 슈크림 바로 누르고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.412,
                "end": 30.567
            },
            {
                "speaker_id": "1",
                "transcription": "자 마카롱 예약에다가 나갈 때 호밀이랑 같이 눌러주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.577,
                "end": 34.404
            },
            {
                "speaker_id": "1",
                "transcription": "자 오먹은 자동으로 자 여기서 차이는 뭐냐면은 호밀을 좀 더 일찍 눌러줘서 마지막 스킬 다 들어가고 죽게끔 만드는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.414,
                "end": 43.720
            },
            {
                "speaker_id": "1",
                "transcription": "자 마카롱 예약하고 그 다음에 슈크림 눌러주시고 자 벚꽃 들어가구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.730,
                "end": 50.391
            },
            {
                "speaker_id": "1",
                "transcription": "다시 마카롱 야 여기는 빌드 다 똑같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.401,
                "end": 52.528
            },
            {
                "speaker_id": "1",
                "transcription": "다만 여기서 다릅니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.538,
                "end": 54.526
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 비석 깨주고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.536,
                "end": 56.628
            },
            {
                "speaker_id": "1",
                "transcription": "자 깨졌죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 56.638,
                "end": 57.535
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 오먹 눌러 주시고 자 여기서 아까는 7시에 있었죠? 얘는 6시 반 했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.545,
                "end": 63.260
            },
            {
                "speaker_id": "1",
                "transcription": "6시 반.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.270,
                "end": 64.925
            },
            {
                "speaker_id": "1",
                "transcription": "조금 더 일찍 눌러줘요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.935,
                "end": 67.400
            }
        ]
    },
    "summary": "화자는 호밀이 죽어도 되는 빌드에서 호밀을 키우는 방법을 설명한다.",
