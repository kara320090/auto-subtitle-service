        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이제 초반에 중요한 거는 여러분들 우선 순위가 1순위가 무조건 쿠키성이 제일 먼저 가야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.015
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키성 레벨을 올리면 생산할 수 있는 건물들도 엄청나게 늘어나고 쿠키하우스도 지을 수 있는 것도 늘어나고 다양한 콘텐츠가 다 열리게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.025,
                "end": 17.180
            },
            {
                "speaker_id": "1",
                "transcription": "나는 존버의 개념으로 쿠키성 레벨을 안 올리고 머물러 있으면 절대 안 되고 쿠키성 레벨을 올리기 위해서는 재화가 절대적으로 필요한 두 가지가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.190,
                "end": 26.533
            },
            {
                "speaker_id": "1",
                "transcription": "코인과 오로라 재료예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.543,
                "end": 28.401
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 여러분들이 오로라 재료를 막 쓰면 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.411,
                "end": 31.198
            },
            {
                "speaker_id": "1",
                "transcription": "항상 오로라 재료가 쓰이는 게 있으니까 쿠키성 레벨이 올라가면은 몇 개가 필요한지 일단 체크를 하고 코인도 막 쓰면 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.208,
                "end": 39.599
            },
            {
                "speaker_id": "1",
                "transcription": "코인도 최대한 아끼면서 쿠키성 레벨업에 써야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.609,
                "end": 43.987
            },
            {
                "speaker_id": "1",
                "transcription": "몇백만 코인 있으니까 그냥 다 써야지 해가지고 쿠키하우스 레벨 막 올리고 랜드마크 레벨도 막 올리고 토핑 강화를 그냥 12강까지 그냥 싹 다 해버린 사람이 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.997,
                "end": 54.648
            },
            {
                "speaker_id": "1",
                "transcription": "그게 가장 큰 잘못이기 때문에 쿠키성 12성까지는 6강으로 일단은 그냥 쭉 가시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 54.658,
                "end": 61.109
            },
            {
                "speaker_id": "1",
                "transcription": "코인이 많이 부족해질 수 있기 때문에 절대 막 쓰시면 안 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.119,
                "end": 66.330
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천 드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.340,
                "end": 69.614
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 69.624,
                "end": 72.785
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.795,
                "end": 77.660
            },
            {
                "speaker_id": "1",
                "transcription": "영토 확장을 할 때 최단 루트로 요렇게 뚫으셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.670,
                "end": 81.090
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 뚫어가지고 소다 제도 오픈하고 소다 제도를 오픈하면은 장점이 뭐가 있냐 왜 이거 왜 안 하셨지 아이고 나 또 이렇게 안 하신 분은 처음 봤네 이거",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 81.100,
                "end": 94.766
            }
        ]
    },
    "summary": "초반에 중요한 거는 1순위가 쿠키성이 제일 먼저 가야 되고 그래야 생산할 수 있는 건물도 늘어나고 쿠키하우스도 짓고 다양한 콘텐츠가 열리고 쿠키성 레벨을 올리기 위해 필요한 두 가지가 코인과 오로라 졔료이고 쿠키성 레벨이 올라가면 몇 개가 필요한지 체크해서 막 쓰면 안 되고 쿠키성 12성까지는 6강으로 쭉 하면 되고 코인이 많이 부족해질 수 있기 때문에 막 쓰면 안 된다.",
