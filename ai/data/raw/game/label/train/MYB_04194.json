        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 요렇게 아진제과님이 만드신 이 공략 정말 좋거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.239
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들도 이제 하셔야 될 때입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.249,
                "end": 12.964
            },
            {
                "speaker_id": "1",
                "transcription": "지금만 봐도 저도 아직 만점밖에 안 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.974,
                "end": 16.321
            },
            {
                "speaker_id": "1",
                "transcription": "근데 1등 분이랑 벌써 만점 차이가 나죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.331,
                "end": 19.388
            },
            {
                "speaker_id": "1",
                "transcription": "지금이라도 늦지 않았으니까 슬슬 올라오셔서 아직 보상 안 받으신 분 있으시면은 석상 보상 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.398,
                "end": 26.327
            },
            {
                "speaker_id": "1",
                "transcription": "이쁘게 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.337,
                "end": 28.321
            },
            {
                "speaker_id": "1",
                "transcription": "네 일단 여기서 대난투 조합 추천 영상 마무리 짓겠 짓도록 하겠습니다.",
                "sound_type": [
