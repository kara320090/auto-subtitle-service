                    5
                ],
                "start": 19.183,
                "end": 28.244
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 22개의 쿠키 명함을 뚫어 주시면 좋을 것 같고 제일 중요한 건 스토리 진행할 수 있는 쿠키들 위주로 뽑아 주세요.",
                "sound_type": [
