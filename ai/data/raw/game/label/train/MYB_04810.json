                    5
                ],
                "start": 6.867,
                "end": 19.173
            },
            {
                "speaker_id": "1",
                "transcription": "대리 뽑기를 신청하려고 뽑기하고 싶어도 욕망을 참고 참다가 욕망을 억누르지 못하고 세네 번 뽑았는데 이것마저 망해서 신청하게 되었습니다.",
                "sound_type": [
