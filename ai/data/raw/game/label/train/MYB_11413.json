                    2,
                    5
                ],
                "start": 9.436,
                "end": 17.595
            },
            {
                "speaker_id": "1",
                "transcription": "죽이기 전에도 이렇게 흡수해서 가져가긴 했었는데 이게 완전 제거가 됐나 봐요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.605,
                "end": 22.835
            },
            {
                "speaker_id": "1",
                "transcription": "아이고 이 할아버지 너무 신구 닮았어요.",
                "sound_type": [
