        "quality": "HD",
        "length": 300.733,
        "format": "MP4",
        "date": "2023-08-12",
        "license": "개인 방송",
        "agreement_score": 2
    },
    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 수호의 성전 2일밖에 안 남았습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.125
            },
            {
                "speaker_id": "1",
                "transcription": "이번 영상은 수호성전에서 가장 좋은 망고를 활용한 조합을 알려드리도록 하겠습니다.",
                "sound_type": [
                    2
                ],
                "start": 2.135,
                "end": 8.070
            },
            {
                "speaker_id": "1",
                "transcription": "자 망고맛 쿠키가 없더라도 대체 쿠키를 다 제가 일일이 알려드릴 거고요.",
                "sound_type": [
                    2
                ],
                "start": 8.080,
                "end": 12.760
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 보상 자체가 크리스탈과 무지개 큐브를 준비했기 때문에 여러분들 반드시 참여해서 점수를 세워주셔야 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 12.770,
                "end": 20.444
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번 시즌은 치명타 피해 증가기 때문에 애플젤리가 많이 쓰이는 시즌입니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.454,
                "end": 25.392
            },
            {
                "speaker_id": "1",
                "transcription": "토핑 자체가 애플젤리가 많이 쓰여도 라즈베리를 섞어서 써도 괜찮다는 점 참고해주시고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.402,
                "end": 31.860
            },
            {
                "speaker_id": "1",
                "transcription": "먼저 보물은 구공비 공속 시계보물을 쓰게 되고 시계보물은 여러분들 에픽시계가 만렙이 아니면 커먼시계를 쓰면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.870,
                "end": 42.017
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이 조합이나 두 번째 조합도 쓸 텐테 견우직녀 님이 만드신 공략을 참고해서 제작했다는 점 알려드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.027,
                "end": 50.965
            },
            {
                "speaker_id": "1",
                "transcription": "고정댓글에 견우직녀 님이 만드신 링크 제가 걸어놨거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.975,
                "end": 55.999
            },
            {
                "speaker_id": "1",
                "transcription": "들어가서 좀 더 구체적으로 확인해보실 수 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.009,
                "end": 59.228
            },
            {
                "speaker_id": "1",
                "transcription": "자 공속 보물을 받는 대상이 정말 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.238,
                "end": 61.955
            },
            {
                "speaker_id": "1",
                "transcription": "망고랑 타르트타탕이 받아야됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.965,
                "end": 64.790
            },
            {
                "speaker_id": "1",
                "transcription": "오먹이 공속을 받으면 절대 안 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.800,
                "end": 67.484
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 세팅을 보게 되면 여러분들 다섯 쿠키를 전부 다 애플젤리를 쓰는데 아 저는 러너님 애플젤리가 이렇게 많지 않습니다 하시는 분들 라즈베리를 섞어도 괜찮습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.494,
                "end": 78.149
            },
            {
                "speaker_id": "1",
                "transcription": "3라즈 2애플젤리라도 섞어서 써주시면 되지만 가급적이면 슈크림만큼은 5애플젤리로 가장 신경을 써주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.159,
                "end": 87.303
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 메인딜러도 웬만하면 가급적이면 애플젤리로 구성을 해주시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 87.313,
                "end": 93.376
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 자체는 도넛은 피감이 없죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.386,
                "end": 96.587
            },
            {
                "speaker_id": "1",
                "transcription": "색에 따라서 피감을 줘야하는 분들도 있고 안줘도 되는 분들이 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 96.597,
                "end": 100.398
            },
            {
                "speaker_id": "1",
                "transcription": "자 그거는 여러분들 상황에 맞춰서 주시면 되고 너무 잘 죽는다 하시면 아몬드라도 끼워서 안 죽게 만들주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 100.408,
                "end": 107.897
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿨타임은 가급적이면 높게 공속은 적당히 공속 주시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 107.907,
                "end": 112.004
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 여유되면 공치 자 망고는 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 112.014,
                "end": 115.274
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임 높게 그리고 공속은 망토 적용 받게끔 최대한 많이 주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 115.284,
                "end": 120.175
            },
            {
                "speaker_id": "1",
                "transcription": "나머지는 공치 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 120.185,
                "end": 122.285
            },
            {
                "speaker_id": "1",
                "transcription": "피감도 마찬가지 죽는 분들은 피감 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 122.295,
                "end": 125.916
            },
            {
                "speaker_id": "1",
                "transcription": "자 오징어먹물도 죽으면은 피감을 좀 주시면 되고 안 죽으면 안 주셔도 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 125.926,
                "end": 131.474
            },
            {
                "speaker_id": "1",
                "transcription": "자 오징어먹물은 공속망토를 받지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 131.484,
                "end": 134.515
            },
            {
                "speaker_id": "1",
                "transcription": "망토를 받지 않는 범위 내에서 공속을 최대한 높게 줬고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 134.525,
                "end": 138.444
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임도 가급적이면 높게 무조건 쿨공속이 높아야 좋냐 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 138.454,
                "end": 143.002
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 스펙에 따라서 상황에 따라서 다를 수 있지만 쿨은 높은 게 좋아보여요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 143.012,
                "end": 148.515
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 공격력 치명타 높게 세팅을 해주시구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 148.525,
                "end": 152.519
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 공격력과 치명타 확률 둘 중에 하나를 선택해서 높게 세팅을 하는 걸 선택해야 된다면 치명타 확률 쪽을 더 높게 세팅해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 152.529,
                "end": 161.836
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 타르트는 쿨은 전혀 신경 안 써도 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 161.846,
                "end": 165.182
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임 높여 봤자 이득되는 게 없고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 165.192,
                "end": 167.978
            },
            {
                "speaker_id": "1",
                "transcription": "공속만 높여 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 167.988,
                "end": 169.648
            },
            {
                "speaker_id": "1",
                "transcription": "전체적인 쿨감소가 있기 때문에 공속을 높여줘야 빠르게 스킬이 나가서 시간단축에 유리하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 169.658,
                "end": 176.423
            },
            {
                "speaker_id": "1",
                "transcription": "자 공속과 공격력 치명타 확률 세 가지 신경써주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 176.433,
                "end": 181.143
            },
            {
                "speaker_id": "1",
                "transcription": "슈크림은 쿨 가급적이면 높게 치명타 확률 높게 써주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 181.153,
                "end": 186.811
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 기록경신 할 때는 타르트는 무조건 넣어주시는 게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 186.821,
                "end": 191.202
            },
            {
                "speaker_id": "1",
                "transcription": "공속을 받을 수 있게끔 타르트를 넣어주시고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 191.212,
                "end": 194.331
            },
            {
                "speaker_id": "1",
                "transcription": "두 쿠키가 없다면 달빛술사나 블랙펄이나 광역 딜러를 넣어서 공속을 둘 중에 하나 주시면 기록경신 하는데 유리하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 194.341,
                "end": 203.092
            },
            {
                "speaker_id": "1",
                "transcription": "만약 공속을 못 쓴다 하시는 분들은 용과 드래곤을 넣고 달빛술사를 넣고 여기다 낫 보물을 넣고 가시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 203.102,
                "end": 210.411
            },
            {
                "speaker_id": "1",
                "transcription": "또다른 질문 여러분 저는 망고 마탕이 낮은데 가능할까요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 210.421,
                "end": 214.919
            },
            {
                "speaker_id": "1",
                "transcription": "망고마탕은 10강만 돼도 정말 유용하게 쓸 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 214.929,
                "end": 218.507
            },
            {
                "speaker_id": "1",
                "transcription": "10강 미만이다 너무 마탕이 낮다 하시는 분들은 차라리 달빛술사가 더 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 218.517,
                "end": 224.178
            },
            {
                "speaker_id": "1",
                "transcription": "참고해서 써주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 224.188,
                "end": 226.709
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 2번은 60웨이브 기록 단축을 위해서 반드시 넣어주면 좋은 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 226.719,
                "end": 232.029
            },
            {
                "speaker_id": "1",
                "transcription": "5초 정도라도 더 단축하고 싶다하시는 분들은 요 세팅을 넣어주시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 232.039,
                "end": 236.760
            },
            {
                "speaker_id": "1",
                "transcription": "자 교체타이밍은 있다가 제가 영상을 통해서 언제 각각 조회되는지 교체 타이밍은 따로 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 236.770,
                "end": 243.650
            },
            {
                "speaker_id": "1",
                "transcription": "봉우르 우공비 호루라기 화관이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 243.660,
                "end": 246.431
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기는 호밀하고 캡틴캐비어가 받습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 246.441,
                "end": 249.693
            },
            {
                "speaker_id": "1",
                "transcription": "자 화관같은 경우에는 캡틴캐비어가 받고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 249.703,
                "end": 252.678
            },
            {
                "speaker_id": "1",
                "transcription": "토핑세팅은 밀키웨이는 피감없이 그냥 쿨공속만 여러분들 능력껏 높게 세팅해 주시면 되고 자 캡틴 캐피어는 쿨 공치 높게 여러분 능력껏 세팅해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 252.688,
                "end": 263.307
            },
            {
                "speaker_id": "1",
                "transcription": "자 오이스터는 피감이나 나머지 상관없이 그냥 여러분들 능력껏 쿨타임 최대로 많이 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 263.317,
                "end": 269.213
            },
            {
                "speaker_id": "1",
                "transcription": "자 호밀도 마찬가지 최대한 쿨공치 여러분 능력껏 많이 주시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 269.223,
                "end": 274.907
            },
            {
                "speaker_id": "1",
                "transcription": "자 아몬드도 그냥 여러분들 올 라즈베리 공속 많이 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 274.917,
                "end": 279.434
            },
            {
                "speaker_id": "1",
                "transcription": "망토보물을 쓰는 게 아니니까 공속 순서 상관없이 공속 많이 주시면 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 279.444,
                "end": 284.799
            },
            {
                "speaker_id": "1",
                "transcription": "자 이덱은 마지막 보스를 정말 5초만에 끝낼 수 있는 덱이기 때문에 따로 세팅을 해주시면 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 284.809,
                "end": 291.711
            },
            {
                "speaker_id": "1",
                "transcription": "망고덱을 쓰지 않더라도 달빛술사 넣어서 다른 덱을 쓰더라도 60웨이브에서 5초 정도 더 줄일 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 291.721,
                "end": 300.733
            }
