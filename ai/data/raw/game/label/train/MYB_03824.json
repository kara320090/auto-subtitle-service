        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 무슨 솔방울 왜 이렇게 세냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 7.099
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이렇게만 보면 솔방울이 무슨 그냥 딜러 자체예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.109,
                "end": 13.666
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 마무리 혹시나 이 영상 보고 솔방울이 좋네 그럼 이거 뽑아서 내가 쓰고 있는 다른 덱에 그냥 넣어서 써봐야지 잘 안 나올 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.676,
                "end": 23.500
            },
            {
                "speaker_id": "1",
                "transcription": "그 효율이 기존 덱보다 안 좋고 특정으로 딱 만들어진 덱에서만 좀 유용하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.500,
                "end": 29.906
            },
            {
                "speaker_id": "1",
                "transcription": "저거 아마 아레나에서 저 크런치 덱 잡기 어려운 분들 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.917,
                "end": 33.593
            },
            {
                "speaker_id": "1",
                "transcription": "저 덱 자격하려고 예 잘 잡아서 쓰이기 시작해 가지고 예 허브 맛 쿠키는 다들 가지고 있잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.593,
                "end": 43.386
            },
            {
                "speaker_id": "1",
                "transcription": "어 소르베가 없으면은 조금 힘들겠지만 활용하면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.396,
                "end": 47.636
            },
            {
                "speaker_id": "1",
                "transcription": "어이구야 가자 던져 던져 던져 던져",
                "sound_type": [
                    2,
