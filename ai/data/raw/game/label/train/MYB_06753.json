                ],
                "start": 3.704,
                "end": 5.033
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 마을 놈들이라도 써먹던가 저번에 붙잡은 녀석 있잖아 그 도둑",
                "sound_type": [
