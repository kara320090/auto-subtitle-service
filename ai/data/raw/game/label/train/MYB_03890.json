        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 터졌을 때는 자 요런 식으로 나가고 끝이 납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.225
            },
            {
                "speaker_id": "1",
                "transcription": "아까 했던 빌드에서 추가되는 게 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.235,
                "end": 12.742
            },
            {
                "speaker_id": "1",
                "transcription": "똑같이 하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.752,
                "end": 13.985
            },
            {
                "speaker_id": "1",
                "transcription": "1억 7백만 1억 천만까지도 나오는 세팅이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.995,
                "end": 19.104
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 소르베가 토벌에 등장했다는 점 충격적이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.114,
                "end": 22.970
            },
            {
                "speaker_id": "1",
                "transcription": "반드시 해야 되는 건 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.980,
                "end": 24.755
            },
            {
                "speaker_id": "1",
                "transcription": "기존에 벨벳 케이크용 조합이 있지만 세팅 가능하신 분은 요거 따라 해 보시면 좋을 거 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.765,
                "end": 31.344
            },
            {
                "speaker_id": "1",
                "transcription": "네 벨벳 케이크 들고 온 소르베 리뷰는 마치도록 하겠습니다.",
