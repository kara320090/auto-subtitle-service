        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와 딜이 세다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.471
            },
            {
                "speaker_id": "1",
                "transcription": "아 여러분들 보이나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.481,
                "end": 5.846
            },
            {
                "speaker_id": "1",
                "transcription": "딜이 그냥 진짜 무지막하게 들어가네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.856,
                "end": 8.814
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.824,
                "end": 15.241
            },
            {
                "speaker_id": "1",
                "transcription": "좋은 거는 다 넣어놔서 이거 야 진짜",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.251,
                "end": 19.319
            },
            {
                "speaker_id": "1",
                "transcription": "와 야 이거 뭐 게임 터지는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.329,
                "end": 22.429
            },
            {
                "speaker_id": "1",
                "transcription": "여기까지 일단 써본 리뷰 달빛술사랑 블랙펄 같이 쓰면 게임 터진다 느낌",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.439,
                "end": 27.302
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 올 쿨로도 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.312,
                "end": 29.081
            },
            {
                "speaker_id": "1",
                "transcription": "아까 홀리베리로 세팅해서 해달라는 분 계셨거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.091,
                "end": 32.328
            },
            {
                "speaker_id": "1",
                "transcription": "야 너 뭐야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.338,
                "end": 33.427
            },
            {
                "speaker_id": "1",
                "transcription": "뭔 끔찍한 혼종 토핑을 야 올 피해감에서 48퍼센트로 달라진 점은 홀리시드 버프를 받고 그리고 기절 피해도 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.437,
                "end": 43.000
            }
        ]
    },
    "summary": "발화자가 딜이 너무 세서 놀랍다고 이야기하며 다른 토핑도 설정해 보겠다고 합니다.",
