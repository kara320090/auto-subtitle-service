        "term": [
            {
                "speaker_id": "1",
                "transcription": "대치 인도하실 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.160
            },
            {
                "speaker_id": "2",
                "transcription": "진짜 바다를 보여주마.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.180,
                "end": 2.539
            },
            {
                "speaker_id": "3",
                "transcription": "자 이렇게 마무리. 상대가 좀 공격적인 세팅이라 제가 좀 녹는 그림이 나왔어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.569,
                "end": 12.500
            },
            {
                "speaker_id": "3",
                "transcription": "자 여러분들 쿠폰 보상 받고 여러분들이 키워야 될 쿠키 아레나 보면은 딱 답이 나오죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.480,
                "end": 18.445
            },
            {
                "speaker_id": "3",
                "transcription": "찰스 자색 고구마, 캡틴캐비어, 뭐 클로티드 크림도 좋지만 얘는 되게 나중에 스펙 좀 높을 때 활용하는 게 좋은 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.455,
                "end": 27.665
            },
            {
                "speaker_id": "3",
                "transcription": "블랙펄이야 뭐 말할 것도 없이 0티어이기 때문에 나머지 뭐 휘낭시에도 아레나에서 0티어이기 때문에 반드시 키워주면 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.675,
                "end": 36.262
            },
            {
                "speaker_id": "3",
                "transcription": "네 요렇게 쿠폰과 아레나 보상 잘 받으시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.272,
                "end": 41.639
            },
            {
                "speaker_id": "3",
                "transcription": "구독과 좋아요 한번씩만 부탁드립니다. 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.649,
                "end": 50.833
            }
        ]
    },
    "summary": "쿠폰 보상 받고 키워야 될 쿠키 아레나 보면은 딱 답이 나온다.",
