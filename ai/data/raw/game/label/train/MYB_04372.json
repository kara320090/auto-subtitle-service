            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피시에서 즐길 때 녹스플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.372
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.382,
                "end": 6.365
            },
            {
                "speaker_id": "1",
                "transcription": "더 보기 및 고정 댓글 고정 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.375,
                "end": 10.284
            },
            {
                "speaker_id": "1",
                "transcription": "자 빌드는 정말 간단해서 자 쭉 갈게요. 1배속으로 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.294,
                "end": 15.934
            },
            {
                "speaker_id": "1",
                "transcription": "자 여기까지 계단이 보이죠? 계단 보이면 이 땅바닥에 보면 이 빨간색 기둥에 벽돌이 보일 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.944,
                "end": 22.159
            },
            {
                "speaker_id": "1",
                "transcription": "요 벽돌 벽돌이 두 번째 거 벽돌에서 자 보면은 이 벽돌 요 라인있죠? 오른쪽 라인 이 두 번째 벽돌 오른쪽 라인 요 선 빨간색 선을 밟고 조금 지나갔을 때 이때 보이나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.169,
                "end": 37.794
            },
            {
                "speaker_id": "1",
                "transcription": "이때 쓰시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.804,
                "end": 38.733
            },
            {
                "speaker_id": "1",
                "transcription": "이 빨간색 벽돌 라인 살짝 지나갔을 때 근데 이거는 사람 마다 뭐 공속이나 쿨이 좀 미세하게 다르기 때문에 여러분들이 요거 여러분들 기준에 맞춰서 다해보셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.743,
                "end": 50.768
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 해보고 블펄 예약을 주고 보스 출현 뜨면은 호밀, 벚꽃 순서대로 순서를 눌러주시고 그다음에 오징어 먹물 자동으로 나오고 그다음에 마카롱 맛 쿠키 스킬이 또 자동으로 나오고",
                "sound_type": [
                    2,
                    5
                ],
                "start": 50.778,
                "end": 64.926
            },
            {
                "speaker_id": "1",
                "transcription": "그다음부터는 연타 계속해주시면 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 64.936,
                "end": 66.772
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 쿨타임 도는 데로 계속 눌러주시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 66.782,
                "end": 69.814
            },
            {
                "speaker_id": "1",
                "transcription": "따로 어려운 거 없죠? 계속 눌러주시면 되고 그다음에 30초 부분에 30초 부분에 이제 벚꽃 맛 쿠키만 스킬을 따로 안 눌러줍니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 69.824,
                "end": 80.989
            },
            {
                "speaker_id": "1",
                "transcription": "자동으로 나가게",
                "sound_type": [
                    2,
                    5
                ],
                "start": 80.999,
                "end": 82.278
            },
            {
                "speaker_id": "1",
                "transcription": "네 여기서는 벚꽃 맛 쿠키 먼저 스킬 쓰면 침묵이 걸리기 때문에 자 이렇게 오징어 먹물 먼저 써주고 이렇게 되면은",
                "sound_type": [
                    2,
                    5
                ],
                "start": 82.288,
                "end": 90.275
            },
            {
                "speaker_id": "1",
                "transcription": "자 빌드가 성공했는지 안 성공했는지는 이 보스가 침묵이 걸릴 때 벚꽃 맛 쿠가 침묵 걸리지 않아야 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 90.285,
                "end": 97.724
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 성공한 거예요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 97.734,
                "end": 99.022
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 연타 할 때 벚꽃 맛 쿠키 빼고 나머지 쿠키 4개만 연타 계속해주시면 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 99.032,
                "end": 104.713
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음에는 그냥 어려운 거 없이 전부 다 그냥 다 연타로 막 눌러주면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 104.723,
                "end": 112.733
            }
        ]
    },
    "summary": "남성은 영상 속 빌드는 간단하다고 했고 빨간색 벽돌 라인 살짝 지나갔을 때 쓰면 되는데 사람마다 공속이나 쿨이 미세하게 다르기 때문에 다해봐야 한다고 했고 블펄 예약하고 호밀, 벚꽃 순서대로 눌러주고 오징어 먹물, 마카롱 맛 쿠키 쓰고 30초 부분부터는 벚꽃만 빼고 연타로 계속 눌러준다고 했다.",
