        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "스킬 한 번 쓸 때마다 날아가죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.250
            },
            {
                "speaker_id": "1",
                "transcription": "와 안정적이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.260,
                "end": 8.749
            },
            {
                "speaker_id": "1",
                "transcription": "앞에가 우유가 아니면은 뭐 승률은 거의 뭐 100퍼센트라고 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.759,
                "end": 15.054
            },
            {
                "speaker_id": "1",
                "transcription": "근데 우유가 아닌지는 여러분들 다 티가 나거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.064,
                "end": 18.843
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면은 앞에 우유가 들어가면은 휘낭시에랑 자리가 바뀌기 때문에 여러분들이 그거는 골라서 가면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.853,
                "end": 26.089
            },
            {
                "speaker_id": "1",
                "transcription": "딜량 자체가 이렇게.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.099,
                "end": 27.837
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 여러분 왜 블랙펄이 이렇게 더 높냐고 생각할 수도 있는데 얘는 단일 딜인데도 이렇게 되는 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.847,
                "end": 35.144
            },
            {
                "speaker_id": "1",
                "transcription": "한 명한테만 공격되는 거고 블랙펄은 5쿠키한테 상대 다 전부 다 딜이 들어가는데도 호밀의 딜이 그렇게 차이가 많이 나는 건 아니라서 얼마나 강력한지 볼 수가 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.154,
                "end": 48.400
            },
            {
                "speaker_id": "1",
                "transcription": "5초월.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.410,
                "end": 51.066
            }
        ]
    },
    "summary": "남성 화자가 앞에가 우유가 아니면 승률은 거의 100퍼센트라고 보면 되고 블랙펄은 5쿠키한테 전부 다 딜이 들어가는데도 호밀의 딜이 차이가 많이 나는 건 아니라서 얼마나 강력한 지 볼 수 있다고 말한다.",
