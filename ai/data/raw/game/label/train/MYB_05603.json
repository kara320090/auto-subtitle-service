        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이건 질 거 같은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.597
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거는 질 거 같다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.607,
                "end": 6.113
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 이거 바요가 터졌으면은 답이 없어요 이거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.123,
                "end": 10.878
            },
            {
                "speaker_id": "1",
                "transcription": "요거는 시작부터 바요가 터져서 조금 오바가 됐네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.888,
                "end": 18.423
            },
            {
                "speaker_id": "1",
                "transcription": "요거 같은 경우에는 이게 투탱에다가 이렇게 있으면은 바요랑 자구마 일 수 있거든요?",
                "sound_type": [
                    2
                ],
                "start": 18.433,
                "end": 23.935
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그런 경우에는 바요랑 에스프레소 있으면은 저 일단은 똑같이 비슷한 경우는 안 들어가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.945,
                "end": 30.060
            },
            {
                "speaker_id": "1",
                "transcription": "그럴 때는 또 경우의 수가 나눠져 가지고 좀 확실하게 좀 이기는 경우에만 가 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.070,
                "end": 36.367
            },
            {
                "speaker_id": "1",
                "transcription": "바요 터지면은 답이 없긴 한데 야 터지는 경우는 처음 봤네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.377,
                "end": 43.261
            },
            {
                "speaker_id": "1",
                "transcription": "보통은 바요 터지지 않고 나중에 터져도 나중에 터지는데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.271,
                "end": 53.433
            }
        ]
    },
    "summary": "한 남자가 게임에서 바요가 터지면 이길 수가 없다고 말한다.",
