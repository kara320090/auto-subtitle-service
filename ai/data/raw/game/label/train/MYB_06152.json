                ],
                "start": 0.000,
                "end": 3.100
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 되면 앞 여기가 꼬이지 않고 이기는 경우가 많이 나와요.",
                "sound_type": [
                    2,
                    3,
