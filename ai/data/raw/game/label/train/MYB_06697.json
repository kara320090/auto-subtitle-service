                ],
                "start": 2.206,
                "end": 3.722
            },
            {
                "speaker_id": "2",
                "transcription": "저희들은 그것들을 회수하기 위해 이 나라에 발을 디뎠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.732,
                "end": 6.865
            },
            {
                "speaker_id": "2",
                "transcription": "그 가치는 어떠한 보화와도 비교할 수 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.875,
                "end": 10.009
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게까지 말할 정도면 보통 비싼 게 아닌가 봐?",
