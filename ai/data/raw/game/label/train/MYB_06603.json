        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 때리시려는이래 미쳤나봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.861
            },
            {
                "speaker_id": "1",
                "transcription": "장작을 때시려는 겁니까? 굴뚝이 보이지 않습니다만",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.871,
                "end": 5.063
            },
            {
                "speaker_id": "1",
                "transcription": "우리 할아버지가 비버거든.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.073,
                "end": 8.051
            },
            {
                "speaker_id": "1",
                "transcription": "밝혀진 출생의 비밀",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.061,
                "end": 9.784
            },
            {
                "speaker_id": "1",
                "transcription": "일본에 그거 생각난다 뭐지 아버지였나 어머니가 마린 이상한 무슨 이상한 영상을 저번에 한 번 받은 적이 있었는데 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.794,
                "end": 19.902
            },
            {
                "speaker_id": "1",
                "transcription": "정말 비버가 지은 게 아닌지요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.912,
                "end": 22.194
            },
            {
                "speaker_id": "1",
                "transcription": "야 너 끈질겨.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.204,
                "end": 24.159
            },
            {
                "speaker_id": "1",
                "transcription": "이리 사냥꾼 올가가 파티에서 제외되었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.169,
                "end": 26.832
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 나쁘네 얘 갖다버리고 싶어 왜 이렇게 인성이 쓰레기야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.842,
                "end": 30.321
            },
            {
                "speaker_id": "1",
                "transcription": "나쁘네 나한테 잘하잖아 나둬야지 뭐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.331,
                "end": 35.733
            }
        ]
    },
