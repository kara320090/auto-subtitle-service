    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 박하사탕 리뷰 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.256
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 신규 쿠키고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.266,
                "end": 4.661
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 5초월까지 올렸고 자 설명을 보게 되면 박하 수염고래를 불러낸다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.671,
                "end": 9.733
            },
            {
                "speaker_id": "1",
                "transcription": "자 아군 쿠키를 회복시키고 피해 감소와 해로운 효과가 감소하는 버프를 주고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.743,
                "end": 13.843
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 물속성 피해를 입히고 피해량의 일부 만큼 아군을 회복시켜 준다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.853,
                "end": 18.930
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 아군에게 체력 보호막도 주고 그리고 체력 회복량은 공경력의 170퍼센트, 해로운 효과 감소 같은 경우에는 35퍼센트, 피해 감소는 15초 동안 14.5퍼센트다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.940,
                "end": 30.500
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 체력 보호막은 최대 체력의 15퍼센트다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.500,
                "end": 33.759
            },
            {
                "speaker_id": "1",
                "transcription": "물 침성 피해도 607.4퍼센트다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.769,
                "end": 36.423
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 체력 보호막이랑 체력 회복 되게 많이 주는 거 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.433,
                "end": 41.086
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 박하사탕은 올 풀로 가보도록 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.080,
                "end": 45.773
            },
            {
                "speaker_id": "1",
                "transcription": "월드 탐험에서는 여러분들 좋게 쓰일 거 같아요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.783,
                "end": 48.348
            },
            {
                "speaker_id": "1",
                "transcription": "힐량 자체도 뭐 락스타랑 비슷하다고 하니까 그렇게 써보시면 될 거 같고 바로 친구 대전으로 바로 넘어가겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.358,
                "end": 56.700
            }
        ]
    },
    "summary": "박하사탕은 새롭게 나온 신규 쿠키이고 체력보호막과 체력회복을 많이 주는 거 같다.",
