        "term": [
            {
                "speaker_id": "1",
                "transcription": "가장 많이 쓰이는 블랙펄 휘낭시에 소르베 이거 세 마리가 나왔으면 좋겠습니다 개인적으로.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.212
            },
            {
                "speaker_id": "1",
                "transcription": "예 요렇게 투표 일정이 이렇게 나와 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.222,
                "end": 8.718
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 데코 배경 왕국 내 의자 데코가 네 방향 모두 회전이 가능하도록 개선하였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.728,
                "end": 15.482
            },
            {
                "speaker_id": "1",
                "transcription": "이제서야 게임 출시 2년 만에 되는 거 아닙니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.492,
                "end": 18.951
            },
            {
                "speaker_id": "1",
                "transcription": "아 일단은 이게 중요한 의미가 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.961,
                "end": 21.807
            },
            {
                "speaker_id": "1",
                "transcription": "아 얘네가 기술적으로 이제 4방향을 도전한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.817,
                "end": 26.373
            },
            {
                "speaker_id": "1",
                "transcription": "이제 왕국에 있는 모든 건물들 모든 랜드마크",
