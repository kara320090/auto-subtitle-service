        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 피씨에서 즐길 때 녹스 앱 플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.257
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 번전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.267,
                "end": 6.411
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱 플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.421,
                "end": 10.289
            },
            {
                "speaker_id": "1",
                "transcription": "네 노움 연구소도 천천히 하시는 분이죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.299,
                "end": 13.730
            },
            {
                "speaker_id": "1",
                "transcription": "빡세게 돌리고 그러진 않은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.740,
                "end": 16.594
            },
            {
                "speaker_id": "1",
                "transcription": "이분이 여러분들 이 수많은 것 중에 왜 풍요의 분수 생산 가속을 찍어줬는지 이유 알겠죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.604,
                "end": 23.450
            },
            {
                "speaker_id": "1",
                "transcription": "재화를 모으기 위해서 특히나 그중에서도 빛조각을 모으기 위해서 풍요의 분수 생산은 특별하게 만렙을 찍어줬다 고거 파악이 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.460,
                "end": 33.565
            },
            {
                "speaker_id": "1",
                "transcription": "자 뭐 이런 거는 딱히 제가 뭐 지적은 안 할게요 왜냐면 이분 즐기는 관점이 다르기 때문에 설마 랜드마크 레벨은 다 만렙이시겠죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.575,
                "end": 41.910
            },
            {
                "speaker_id": "1",
                "transcription": "얘는 그래도 만렙 찍어주는 게 좋을 것 같습니다 시계탑 쿠키 하우스 레벨 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.920,
                "end": 46.419
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 9렙에 레벨업은 이 쿠키성 10레벨에서 올릴 수 있는 최대로 올려주신 상태입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.429,
                "end": 53.847
            },
            {
                "speaker_id": "1",
                "transcription": "혹시 뭐 쿠키성 이거 레벨업 안 하는 이유가 퐁드파티세리를 건설 일부러 안 하시네 따로 제가 뭐 터치는 안 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.857,
                "end": 62.984
            },
            {
                "speaker_id": "1",
                "transcription": "다 저저 고기 타워 아직 안 지으셨다고요 해골성이랑 나 이거 알겠어 얘 왜 안 짓는지 알 것 같아 크리스탈을 쓰기 때문에 안 지었다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.994,
                "end": 73.366
            }
        ]
    },
    "summary": "크리스탈을 쓰기 때문에 고기타워와 해골성을 안 지었다.",
