        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 어이가 없어가지고 내가 진짜 너무 말이 안 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.340
            },
            {
                "speaker_id": "1",
                "transcription": "아니 이렇게 할 거면 그냥 쿠키런 달리는 거 그걸 내세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.350,
                "end": 8.128
            },
            {
                "speaker_id": "1",
                "transcription": "차라리 그걸 우려 먹어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.138,
                "end": 9.727
            },
            {
                "speaker_id": "1",
                "transcription": "고기젤리 소모해서 그나마 노력해가지고 점수 올릴 수 있는 거로 바꾸세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.737,
                "end": 14.689
            },
            {
                "speaker_id": "1",
                "transcription": "와 진짜 이거 너무한 거 아니냐 진짜?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.699,
                "end": 17.930
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 강하게 비난 좀 하겠습니다.",
