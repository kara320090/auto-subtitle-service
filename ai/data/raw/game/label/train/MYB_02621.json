        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 캡사이신맛 쿠키 자 승급하고 리뷰 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.908
            },
            {
                "speaker_id": "1",
                "transcription": "자 초월까지 출발",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.918,
                "end": 8.495
            },
            {
                "speaker_id": "1",
                "transcription": "굿굿굿",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.505,
                "end": 13.014
            },
            {
                "speaker_id": "1",
                "transcription": "바로 2초월까지",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.024,
                "end": 18.830
            },
            {
                "speaker_id": "1",
                "transcription": "아 캠을 제가 여러분들 갑자기 캠 켜서 죄송한데 제가 1초월 되면은 캠 킨다고 아까 입방정해서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.840,
                "end": 26.632
            },
            {
                "speaker_id": "1",
                "transcription": "자 반갑습니다. 여러분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.642,
                "end": 28.491
            },
            {
                "speaker_id": "1",
                "transcription": "오랜만에 캠을 또 키게 됐네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.501,
                "end": 30.652
            },
            {
                "speaker_id": "1",
                "transcription": "일단 스킬 만렙 야 뭐야 올라가는 거 보이세요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.662,
                "end": 34.606
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 피해량 증가 실시간으로 올라가는 거 레전드네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.616,
                "end": 39.204
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 빨간색으로 표시하니까 더 세보여 그쵸",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.214,
                "end": 42.654
            },
            {
                "speaker_id": "1",
                "transcription": "일단 능력을 보게 되면은 캡사이신맛 쿠키 쓰면은 마그마의 힘이 넘쳐서 변신한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.664,
                "end": 48.576
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 제일 중요한 게 적에게 화상과 마그마 디버프 요 마그마 디버프는 불속성 요거는 속성 패치 됐죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.586,
                "end": 55.849
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 변신 중 스킬 끊김을 포함한 스킬 시전 방해 효과에 강해지는 거는 뭐 항상 붙어 있는 거고 변신이 끝나면은 마왕 상태가 되어 최후의 일격을 가한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.859,
                "end": 65.415
            },
            {
                "speaker_id": "1",
                "transcription": "이거 불사 상태죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.425,
                "end": 66.171
            },
            {
                "speaker_id": "1",
                "transcription": "전투 불능 상태가 죽은 걸 말하거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.181,
                "end": 68.842
            },
            {
                "speaker_id": "1",
                "transcription": "죽고 나면은 불사 상태가 되고 디버프를 제거한다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.852,
                "end": 72.157
            },
            {
                "speaker_id": "1",
                "transcription": "쿨타임은 감소되어스킬을 처음에 빨리 쓴다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.167,
                "end": 74.809
            },
            {
                "speaker_id": "1",
                "transcription": "1회 피해량은 공격력의 61퍼센트고 마그마 폭발 피해량이 183퍼센트 마그마 디버프는 20초 동안 불속성 피해 증가 20퍼센트 중첩 3개",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.819,
                "end": 85.446
            },
            {
                "speaker_id": "1",
                "transcription": "화상 피해량은 16초 마다 1초 마다 27퍼센트 야 마왕 피해량이 뭐야 682퍼센트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 85.456,
                "end": 92.352
            },
            {
                "speaker_id": "1",
                "transcription": "화상 피해량도 54퍼센트 16초 동안 화상 피해도 주고 마왕 마그마 폭발 피해량 공격력의 130 마그마 디버프 개수에 따라 20퍼센트 추가 피해 불사는 6초 동안 지속 1회 발동",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 92.362,
                "end": 107.933
            }
        ]
    },
