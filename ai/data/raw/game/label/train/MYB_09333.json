        "term": [
            {
                "speaker_id": "1",
                "transcription": "비슷한 일은 어딘가에서 일어나고 있을 거야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.020
            },
            {
                "speaker_id": "1",
                "transcription": "인간의 욕심은 끝이 없고 같은 실수를 반복한다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.020,
                "end": 7.026
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 네가 마더 크리스털을 파괴해 준다면 이런 짓을 꾸미는 놈들이 사라질 수도 있겠지.",
