    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "되게 중요하다고 생각합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.210
            },
            {
                "speaker_id": "1",
                "transcription": "이제 재고를 한 번 볼까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.210,
                "end": 3.884
            },
            {
                "speaker_id": "1",
                "transcription": "자 오로라 재료는 여유가 그렇게 많지는 않으신 편입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.894,
                "end": 7.605
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 나무 좋고 백설탕, 비스킷, 젤리베리가 유독 많으시네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.615,
                "end": 14.038
            },
            {
                "speaker_id": "1",
                "transcription": "아이구야 이 분 뭐야 재고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.048,
                "end": 16.241
            },
            {
                "speaker_id": "1",
                "transcription": "모범생이네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.251,
                "end": 17.332
            },
            {
                "speaker_id": "1",
                "transcription": "아 이 분 이렇게 성실하게 게임하는데 뭐 아레나에서 어떤 게 큰 문제로 다가오신 거지?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.342,
                "end": 23.421
            },
            {
                "speaker_id": "1",
                "transcription": "지금 보면은 테크도 쫙쫙 다 잘 올리셨고 왕국 운영면에서는 내가 뭐 이렇게 해라 저렇게 해라 할게 뭐 딱히 없네 잘하시네요 뭐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.431,
                "end": 33.350
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키 같은 경우에는 스펙 이렇게 되어 있고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.360,
                "end": 36.712
            },
            {
                "speaker_id": "1",
                "transcription": "70렙도 다 많이 찍어 주셨고 이것만 봐도 딱 알 수 있는 거는 일단 쿠키 하우스 레벨이 잘 올라갔다 요거랑 왕국 성장도 잘 돼있다 이거를 쫌 쿠키 레벨 보면은 얼추 알아볼 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.722,
                "end": 49.611
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 분은 보면은 보시다시피 웬만큼 다 성장이 다 되어 있다 왜 블랙베리가 70렙이 찍혀있냐 이거는 네 토벌에서 블랙베리가 천사 토벌에서 쓰이기 때문에 네 스킬 파우더가 부족한가?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.621,
                "end": 63.233
            },
            {
                "speaker_id": "1",
                "transcription": "아이구야 이거 상위권 길드 분들도 마법 파우더 부족해서 블랙베리 키우지 못하는 분들이 쫌 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.243,
                "end": 69.467
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 파우더 수급 문제를 데브가 쪼끔 편하게 해 주면 좋지 않나",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 69.477,
                "end": 74.421
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나에서 문제다 이렇게 하시는데 토핑 보자.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 74.431,
                "end": 80.366
            }
        ]
    },
    "summary": "남성은 이 분은 테크도 다 잘 올리셨고 왕국 운영면에서는 뭐라 할게 딱히 없고 잘하신다고 말한다.",
