        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단은 뱀파가 물어주구요 음",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.307
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파가 살아서 예 이렇게 딜러들이랑 탱커들도 다 순삭 당했죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.317,
                "end": 12.592
            },
            {
                "speaker_id": "1",
                "transcription": "네, 이렇게 뱀파가 죽으면은 여러분들 요거 호루라기 보물이 모든 아군 쿠키의 최대 체력을 30퍼센트 회복시켜줍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.602,
                "end": 22.470
            },
            {
                "speaker_id": "1",
                "transcription": "호루라기 적용되는 쿠키들을 그렇기 때문에 힐러가 없어도 아군 전체의 체력이 찬다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.480,
                "end": 28.199
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱을 만드신 스페셜 길드의 리사 님은 이걸 위해서 만들었어요 특히 공속덱 방덱 된 거는 이거 랭킹 높은 그마1 구간에서야 공속덱, 방덱이 많지 실질적으로 제가 부계정으로 보니까 웬만해서는 다 다른 지역에서는 다 아직도 이런 형식의 덱들이 많아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.209,
                "end": 48.002
            },
            {
                "speaker_id": "1",
                "transcription": "다 홀리베리, 스타더스트 달빛 웬만해서 이런 덱이 많기 때문에 여러분들 요 조합을 가지고 요런 형식으로 되어있는 덱한테 가면은 승률이 아마 가장 높지 않을까 100퍼센트는 아니에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 48.012,
                "end": 59.626
            },
            {
                "speaker_id": "1",
                "transcription": "제가 아까 해 보니까 지는 분도 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.636,
                "end": 61.720
            },
            {
                "speaker_id": "1",
                "transcription": "근데 대략적으로 10판 중에 1판 지고 아 90퍼센트의 승률이 나오거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.730,
                "end": 66.996
            },
            {
                "speaker_id": "1",
                "transcription": "제가 최근에 리뷰한 영상들 보면은 대략적으로 승률이 뭐 한 70퍼센트, 80퍼센트, 70퍼센트 이 정도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.006,
                "end": 76.139
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 덱 자체는 거의 90퍼센트 이상이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 76.149,
                "end": 80.653
            },
            {
                "speaker_id": "1",
                "transcription": "아 제가 써 본 덱 중에서는 승률이 가장 높았습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 80.663,
                "end": 84.643
            },
            {
                "speaker_id": "1",
