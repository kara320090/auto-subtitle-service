        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이건 지는 그림인데 아 이거는 지는 그림 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.039
            },
            {
                "speaker_id": "1",
                "transcription": "지는 그림이지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.049,
                "end": 9.978
            },
            {
                "speaker_id": "1",
                "transcription": "야 이걸 이기네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.988,
                "end": 14.205
            },
            {
                "speaker_id": "1",
                "transcription": "아 레어 무공비급이라 단단하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.215,
                "end": 17.435
            },
            {
                "speaker_id": "1",
                "transcription": "이 덱 같은 경우에는 뒤에 있는 딜러를 순삭시키는 그림으로 가져가야 되는데 약간 억지로 억지로 이건 이겼네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.445,
                "end": 24.719
            },
            {
                "speaker_id": "1",
                "transcription": "아 나왔다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.729,
                "end": 25.685
            },
            {
                "speaker_id": "1",
                "transcription": "블루파이 한방덱이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.695,
                "end": 26.919
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 되어있는 보물 세팅은 블파 한방덱인데 심지어 한방덱도 뚫어냅니다.",
                "sound_type": [
                    2,
