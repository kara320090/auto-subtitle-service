        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이분 진짜 레전드로 뽑아 드렸습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.789
            },
            {
                "speaker_id": "1",
                "transcription": "자 다크카카오 3개, 홀리베리 하나, 퓨어바닐라 2개, 바다요정 1개, 클로티드 하나",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.799,
                "end": 9.359
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 크림 유니콘 5성도 됐고 캡틴캐비어도 5성 됐고 검볼다이 3성 됐고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.369,
                "end": 15.815
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 무과금 계정으로 20만 개 모아서 저한테 맡겨 주신 건데 아까 레전드 전설",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.825,
                "end": 22.246
            },
            {
                "speaker_id": "1",
                "transcription": "정말 레전드 전설이 됐습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.256,
                "end": 24.347
            },
            {
                "speaker_id": "1",
                "transcription": "야아 역시 이분도 마찬가지 나팔을 믿으세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.357,
                "end": 28.304
            },
            {
                "speaker_id": "1",
                "transcription": "나팔 마을에 꾸미신 분들은 대부분 대박 났어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.314,
                "end": 31.764
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 일단 별의수호자님 무과금 계정",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.774,
                "end": 35.022
            },
            {
                "speaker_id": "1",
                "transcription": "디즈니 이제 콜라보 때 시작한 분",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.032,
                "end": 37.232
            },
            {
                "speaker_id": "1",
                "transcription": "네 깔끔하게 마무리 짓도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.242,
                "end": 40.304
            },
            {
                "speaker_id": "1",
                "transcription": "정말 잘 나왔어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
