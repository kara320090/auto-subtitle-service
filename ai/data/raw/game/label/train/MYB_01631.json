        "term": [
            {
                "speaker_id": "1",
                "transcription": "기존과는 다른 컨셉으로 야 근데 확실히 이렇게 브레스 타이밍으로 상대 딜러를 끊어주면은 지금 상대 보면은 초월이 다 높죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 11.831
            },
            {
                "speaker_id": "1",
                "transcription": "이런 네 조합으로도 이길 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.841,
                "end": 15.442
            },
            {
                "speaker_id": "1",
                "transcription": "맨 처음에 이 조합을 예능으로 시작했지만 딜러가 없어서 별로라 생각했거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.452,
                "end": 21.813
            },
            {
                "speaker_id": "1",
                "transcription": "야 근데 이걸 버텨버리네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.823,
                "end": 24.698
            },
            {
                "speaker_id": "1",
                "transcription": "보이죠 아니 상대가 용과가 5초월인데 5초월인데도 불구하고 야 이거를 이렇게 끝내버릴 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.708,
                "end": 36.261
            },
            {
                "speaker_id": "1",
                "transcription": "용과 하나에 몰빵 했다.",
                "sound_type": [
                    2,
                    3
                ],
