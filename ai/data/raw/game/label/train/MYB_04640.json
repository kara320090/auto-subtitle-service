        "term": [
            {
                "speaker_id": "1",
                "transcription": "마지막으로 제 무과금 부계정 여태까지 모아왔던 크리스탈, 쿠키 커터 전부 다 뽑기로 날려보고 영상을 마쳐보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.464
            },
            {
                "speaker_id": "1",
                "transcription": "제 부계정같은 경우에는 무과금인데 그래도 운이 좋아서 레전드 고대 쿠키가 많습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.474,
                "end": 13.877
            },
            {
                "speaker_id": "1",
                "transcription": "다만 자주 안 해서 블랙펄 쿠키가 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.887,
                "end": 17.160
            },
            {
                "speaker_id": "1",
                "transcription": "자 바로 가겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.170,
                "end": 18.380
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키 하나만 좀 나와줬으면 좋겠네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.390,
                "end": 21.214
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 아 이 계정이 되게 운이 좋은 계정이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.224,
                "end": 26.125
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 모았다가 가끔 뽑기할 때 꼭 대박나는 그런 계정입니다.",
                "sound_type": [
