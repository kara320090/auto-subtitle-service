        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이런 식으로 샤이닝글리터를 활용해서 쓸 수 있다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 3.497
            },
            {
                "speaker_id": "1",
                "transcription": "자 분명히 이런 질문도 있을 겁니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.507,
                "end": 5.169
            },
            {
                "speaker_id": "1",
                "transcription": "@이름1님 저 샤글 승급 낮은데 어떻게 할까요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 5.179,
                "end": 8.420
            },
            {
                "speaker_id": "1",
                "transcription": "샤글은 보니까 이 조합 자체가 2성, 3성인 분들도 충분히 쓸 수 있고요.",
                "sound_type": [
                    2
                ],
                "start": 8.430,
                "end": 14.320
            },
            {
                "speaker_id": "1",
                "transcription": "물론 최상위군에서는 힘들지만 그에 맞게 티어가 낮은 구간에서 샤글 낮더라도 해파리 조합 카운터로 쓸 수가 있습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.330,
                "end": 22.809
            },
            {
                "speaker_id": "1",
                "transcription": "자 대놓고 해파리가 나왔네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.819,
                "end": 25.183
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 바로 들어갈 수 있는데 이번에는 퓨어바닐라로 들어갈 거고요.",
                "sound_type": [
