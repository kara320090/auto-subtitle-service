        "term": [
            {
                "speaker_id": "1",
                "transcription": "여캠인가? 여캠 조명 같은 게 있는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.750
            },
            {
                "speaker_id": "1",
                "transcription": "몰라 저 쓰러졌어. 지금 바닥에.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.760,
                "end": 10.754
            },
            {
                "speaker_id": "1",
                "transcription": "어우 저 뭐 있다. 물고기를 부리는 우주인 복을 입은 거 같은 원가가 있는데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.764,
                "end": 19.050
            },
            {
                "speaker_id": "1",
                "transcription": "해마? 뭐야 이게?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.060,
                "end": 25.494
            },
            {
                "speaker_id": "1",
                "transcription": "아 나 물에서 이제 숨 쉴 수 있나 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.504,
                "end": 34.218
            },
            {
                "speaker_id": "1",
                "transcription": "나 이제 물에서 안 죽나 봐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.228,
                "end": 40.931
            },
            {
                "speaker_id": "1",
                "transcription": "물귀신이 도와줘 가지고. 아 근데 방금 전에 그 물귀신한테 잡혀가는 연출 진짜 무서웠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.941,
                "end": 46.652
            },
            {
                "speaker_id": "1",
                "transcription": "님들도 조금 쫄았죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.662,
                "end": 48.043
            },
            {
                "speaker_id": "1",
                "transcription": "여기 여기도 지금 여기 코드 꽂힌 그런 실험체 같은 애들이 있네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.053,
                "end": 55.100
            }
        ]
    },
