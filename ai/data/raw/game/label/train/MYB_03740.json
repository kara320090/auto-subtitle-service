        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 네 네 승리 아 좀 좀 더 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.140
            },
            {
                "speaker_id": "1",
                "transcription": "음 자 일단 다른 분 야 이거 왜 이기는 거야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.150,
                "end": 11.572
            },
            {
                "speaker_id": "1",
                "transcription": "정말 여러분들 이거 사기입니다. 이런 리뷰가 아니란 말이에요. 여러분들",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.582,
                "end": 15.539
            },
            {
                "speaker_id": "1",
                "transcription": "네 일단은 좀 더 가보겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.549,
                "end": 17.654
            },
            {
                "speaker_id": "1",
                "transcription": "질 때까지 가볼게요. 앞에 탱커들이 작아지기 때문에 피감이 무려 20퍼센트나 높아진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.664,
                "end": 22.891
            },
            {
                "speaker_id": "1",
                "transcription": "치명타 피해도 15퍼센트나 증가되기 때문에 탱커의 생존력은 확실히 증가될 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.901,
                "end": 28.812
            },
            {
                "speaker_id": "1",
                "transcription": "보물이 적용되는 거",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.822,
                "end": 31.291
            }
        ]
    },
    "summary": "한 남성이 게임상에서 본인이 의도치 않게 자꾸 이기게 되자 이런 리뷰가 아니라고 한다. 본인이 질때까지 계속 가본다고 하며 보물이 적용되면 앞에 탱커들이 작아지기 때문에 피감이 무려 20퍼센트나 높아지고 피명타 피해도 15퍼센트 증가도니다고 생존력을 확실히 증가될 수 있다고 한다.",
