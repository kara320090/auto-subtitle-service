        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤 화면으로 넘어와서 그렇다면 여러분들 복귀 유저분들과 신규 유저분들 기존 유저분들이 어떤 걸 해야 되냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.098
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 스킬 파우더가 이제 많이 모자랄 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.108,
                "end": 9.694
            },
            {
                "speaker_id": "1",
                "transcription": "지금 현상 수배에서 요일별 보상을 보게 되면 마법 형이 나오는 스킬 파우더는.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.704,
                "end": 15.613
            },
            {
                "speaker_id": "1",
                "transcription": "화요일, 금요일 그다음에 일요일에 모든 스킬 파우더가 나오기 때문에 이거 마법 형은 좀 미리 부족하신 분들 챙겨두는 게 중요한 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.623,
                "end": 24.260
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 블루파이 쿠키를 쿠키런 오븐 브레이크에서 한번 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.270,
                "end": 29.630
            },
            {
                "speaker_id": "1",
                "transcription": "자 출시됐을 때 어떤 식으로 나올지 제가 한번 실제로 쓰는 모습을 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.640,
                "end": 36.570
            },
            {
                "speaker_id": "1",
                "transcription": "블루 파이 쿠키는 오븐 브레이크에서는 이런 식으로 나와요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.580,
                "end": 39.699
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 되게 킹덤이랑은 다르게 이제 달리기랑 스킬 능력 자체가 킹덤에서 나오는 거랑 좀 다르지만 여러분들 볼 때 되게 블루 파이가 실제로는 이런 형식으로 게임에서 구성돼서 나올 거라는 거.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.709,
                "end": 58.220
            },
            {
                "speaker_id": "1",
                "transcription": "좀 미리 파악을 하고 미리 보면 좋을 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.230,
                "end": 62.140
            },
            {
                "speaker_id": "1",
                "transcription": "이런 식으로 마법사들의 도시 출시할 때 같이 나올 예정일 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.140,
                "end": 69.791
            }
        ]
    },
    "summary": "남성 화자가 쿠키런 킹덤 게임 복귀 유저와 신규 유저, 기존 유저들이 스킬 파우더를 모을 수 있게 요일 보상을 받는 법을 알려주고 블루파이 쿠키가 실제 어떻게 쓰이는지 보여주고 있다.",
