        "term": [
            {
                "speaker_id": "1",
                "transcription": "순간 이동한 다음에 쓰던지 안전할 때 쓰면 되잖아요라고 치트치고 싶을 텐데 원래 게임 못하는 사람들은 지케툰밖에 몰라요.",
                "sound_type": [
                    2,
