                    5
                ],
                "start": 0.000,
                "end": 7.145
            },
            {
                "speaker_id": "1",
                "transcription": "남의 지툰 신경 안 씁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.155,
                "end": 10.662
            },
            {
                "speaker_id": "1",
                "transcription": "나중에 생각이 들어요 아 그래야 됐었지 하고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.672,
                "end": 17.058
            },
            {
                "speaker_id": "1",
                "transcription": "이게 바로 매운맛이랄까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.068,
                "end": 20.801
            },
            {
                "speaker_id": "1",
                "transcription": "패턴 보고 때려 넣으라고 그 답답해 하면서 하는데 그걸 볼 줄 알았으면",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.811,
                "end": 36.972
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 그리고 게임 못 하는 사람 특 뽀록에 즐거워 함 뽀록에 행복해 함",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.982,
                "end": 43.573
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 이 게임 좋아해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.583,
                "end": 50.871
            },
            {
                "speaker_id": "1",
                "transcription": "잘 못해도 멋있어 보이고 아무튼 그럼",
                "sound_type": [
                    2,
