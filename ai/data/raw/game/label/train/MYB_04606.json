        "term": [
            {
                "speaker_id": "1",
                "transcription": "원체 바쁘신 분이다 보니까 좀 약간 요런 거는 다 확장해주는게 좋은 거 같아요 요거",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.061
            },
            {
                "speaker_id": "1",
                "transcription": "아니 뭐 테크는 다 오픈하셨는데 나머지 돌릴 시간이 많이 없으신 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.071,
                "end": 11.597
            },
            {
                "speaker_id": "1",
                "transcription": "재고 상태야 뭐 완벽합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.607,
                "end": 13.829
            },
            {
                "speaker_id": "1",
                "transcription": "아레나는 원래 랭커분이셔서 뭐 아시겠지만 이 분 칭호 자체가 전설의 그랜드마스터 원래 달성하신 분입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.839,
                "end": 22.909
            },
            {
                "speaker_id": "1",
                "transcription": "아 토핑 구경 좀 해볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.919,
                "end": 24.354
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 저 궁금한 게 토핑 구경이었거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.364,
                "end": 26.628
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 핵과금 하는 유저의 토핑 상태 자 5.9, 5.9, 5.9, 5.8, 5.8, 5.8 역시 이제 밑에 거에서 착용된 거 최상위 옵션 한 번 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.638,
                "end": 39.794
            },
            {
                "speaker_id": "1",
                "transcription": "자 6, 3, 2 자 3, 6, 2 이거는 옛날에 이벤트 토핑으로 준 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.804,
                "end": 44.613
            },
            {
                "speaker_id": "1",
                "transcription": "이 페스츄리 토핑 이벤트 성장 이벤트에서 뿌렸던 이벤트 옵션이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.623,
                "end": 50.358
            },
            {
                "speaker_id": "1",
                "transcription": "3, 6, 1 이벤트 토핑입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.368,
                "end": 52.854
            },
            {
                "speaker_id": "1",
                "transcription": "마지막 부옵션 제외하고 뿌렸던 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 52.864,
                "end": 55.364
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 다음에 3, 6, 2 자 이것도 이벤트 토핑으로 뿌렸던 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 55.374,
                "end": 59.717
            },
            {
                "speaker_id": "1",
                "transcription": "야 이것도 뭐 상당하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.727,
                "end": 62.004
            },
            {
                "speaker_id": "1",
                "transcription": "6, 2.8, 2 자 6퍼센트가 많죠.",
                "sound_type": [
                    2,
                    3
                ],
