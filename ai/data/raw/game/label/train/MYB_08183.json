            },
            {
                "speaker_id": "1",
                "transcription": "야 초코 메테오레인 꽉",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.279,
                "end": 24.769
            },
            {
                "speaker_id": "1",
                "transcription": "아 미친놈 아 몇 번을 쏘는 거야 죽는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.779,
                "end": 29.039
            },
            {
                "speaker_id": "1",
                "transcription": "야 진짜 미친놈이네 이거 야야 미치광이야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.049,
                "end": 36.579
            },
            {
                "speaker_id": "1",
                "transcription": "그만 야 미안해 내가 미안해 내가 잘못했어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.589,
                "end": 43.159
            },
            {
                "speaker_id": "1",
                "transcription": "아 미안하다고 이 자식 얘 멈춰 놓아야 되나 봐 얘 안 되겠다 얘 어떡하니.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 43.169,
                "end": 46.794
            },
            {
                "speaker_id": "1",
                "transcription": "야야야야야야야 야야야야야야야야야야 이 자식아",
