                    2,
                    3
                ],
                "start": 46.804,
                "end": 50.930
            },
            {
                "speaker_id": "1",
                "transcription": "야야 야들아 그만해 이 자식아 죽는다고 진짜 그만해 그만 그만 멈춰",
                "sound_type": [
                    2,
                    3
