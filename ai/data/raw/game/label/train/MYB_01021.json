        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "공격 속도가 높으면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.717
            },
            {
                "speaker_id": "1",
                "transcription": "자 1번 조합은 어느 때 들어 가냐 방덱으로 사용해도 좋고요.",
                "sound_type": [
                    2
                ],
                "start": 1.727,
                "end": 5.972
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 사용할 때는 스타더스트, 블랙펄 가려주시면 되고 자 1번덱 같은 경우에는 무난하게 레어 무공비급 방덱 2탱한테 들어가는 걸 추천드리고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.982,
                "end": 15.806
            },
            {
                "speaker_id": "1",
                "transcription": "자 2번 덱이 가장 무난하게 사용하기는 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.816,
                "end": 18.732
            },
            {
                "speaker_id": "1",
                "transcription": "자 홀리베리 같은 경우에는 올 쿨, 용과는 쿨 높게 라즈베리, 락스타도 피감 권장 20퍼센트 치명타 5퍼센트 쿨타임은 22.3퍼센트 이상 세트 효과 더해서요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.742,
                "end": 30.305
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 세트 효과 더해서 21퍼센트, 스냅 드래곤은 올 쿨 자 이 조합은 1탱, 2탱 가릴 것 없이 무난하게 가장 쓰기 좋은 대표 조합이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.315,
                "end": 39.989
            },
            {
                "speaker_id": "1",
                "transcription": "세 번째는 홀리베리, 스타더스트, 달빛술사를 이용한 덱입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.999,
                "end": 44.503
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄 자리에는 용과가 들어와도 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.513,
                "end": 47.371
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 홀용스달스가 초보자분들이 가장 세팅을 많이 하는 조합입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 47.381,
                "end": 53.099
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 홀용스달스는 기본적으로 블루베리 올 쿨, 용과는 올 라즈, 스타더스트는 4 애플젤리 1 쿨하거나 아니면 5 애플젤리로 쿨 높게 또는 쿨 낮게",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.109,
                "end": 65.400
            }
        ]
    },
    "summary": "한 남성이 방송에서 여러 가지 조합 중에서 가장 무난하게 사용하기 좋은 조합을 추천하는데 그 조합은 홀리베리는 올 쿨, 용과는 쿨 높게 라즈베리, 락스타는 피감 권장 20퍼센트에 치명타 5퍼센트와 세트 효과 더해서 쿨타임 22.3퍼센트 이상, 블랙펄은 세트 효과 더해서 21퍼센트, 스냅 드래곤은 올 쿨 조합이라고 설명한다.",
