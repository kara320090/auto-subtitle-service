        "term": [
            {
                "speaker_id": "1",
                "transcription": "쥬스 이게 이렇게 얻기 힘듭니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.936
            },
            {
                "speaker_id": "1",
                "transcription": "야 근데 기간 왜 이렇게 짧아요 여러분들?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.946,
                "end": 6.166
            },
            {
                "speaker_id": "1",
                "transcription": "34일밖에 안 되는데 어 34일이야.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.176,
                "end": 10.702
            },
            {
                "speaker_id": "1",
                "transcription": "설마 저거 뒤에 또 레전드 나오는 거 아니지?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.712,
                "end": 13.396
            },
            {
                "speaker_id": "1",
                "transcription": "나 지금 봤네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.406,
                "end": 15.057
            },
            {
                "speaker_id": "1",
                "transcription": "느낌이 싸하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.067,
                "end": 17.253
            },
            {
                "speaker_id": "1",
                "transcription": "34일 뒤에 레전드 각이다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.263,
                "end": 19.425
            },
            {
                "speaker_id": "1",
                "transcription": "슈에 슈에일 거 같다. 아 느낌이 딱 그 느낌일 거 같긴 하다.",
