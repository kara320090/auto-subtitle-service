        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "퓨바 같은 경우 슈크림도 그냥 따로 타이밍 맞추지 마시고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 5.637
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 바로바로 써 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.647,
                "end": 8.518
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 블랙펄이 죽었잖아요?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 8.528,
                "end": 10.212
            },
            {
                "speaker_id": "1",
                "transcription": "죽어도 상관없습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.222,
                "end": 11.753
            },
            {
                "speaker_id": "1",
                "transcription": "네 깨는 데는 아무 지장이 없다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.763,
                "end": 14.513
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트 같은 경우에는 자체적인 피감이 있어서 잘 죽지 않고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.523,
                "end": 19.119
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 힐러들이 계속 힐 해주면서 버티면서 요렇게 마무리 해 주면 클리어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.129,
                "end": 28.266
            }
        ]
    },
    "summary": "한 남성이 게임에서 퓨바, 슈크림, 블랙펄, 스타더스트 등 각 쿠키에 맞춰서 공격 방법을 알려주고 게임 시 힐러들이 계속 힐을 해 주니까 버티면서 마무리하면 된다고 이야기한다.",
