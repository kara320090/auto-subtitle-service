                    5
                ],
                "start": 0.000,
                "end": 1.930
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리도 좀 조정 좀 해줘야 돼. 밸런스 패치",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.940,
                "end": 5.156
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 너무 찬밥이라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.166,
                "end": 7.642
            },
            {
                "speaker_id": "1",
                "transcription": "야 나 그거 봤어.",
                "sound_type": [
                    2
                ],
                "start": 7.652,
                "end": 9.120
            },
            {
                "speaker_id": "1",
                "transcription": "공카에 누가 홀리베리랑 퓨어 바닐라 동시에 떴다고 자랑 스샷 올렸는데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.130,
                "end": 13.542
            },
            {
                "speaker_id": "1",
                "transcription": "댓글에 하나도 안 부러움 막 이러면서 막 댓글 달리는 거 보고 되게 야 그게 만약 블랙펄하고 막 소르베 동시에 떴으면은 사람들이 막 주작 이럴 텐데.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.552,
                "end": 23.531
            },
            {
                "speaker_id": "1",
                "transcription": "야 퓨어 바닐라 홀리베리 같이 뜨니까 사람들이 하나도 안 부럽다고 그냥 지나가더라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.541,
                "end": 29.896
