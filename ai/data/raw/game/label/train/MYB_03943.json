        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 사양 패치될 눈설탕맛 쿠키 실제로 좋은지 아니면 실전에 쓰일 수 있는지 리뷰를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.833
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 다른 거 보다 추가된 부분이 딱 하나 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.843,
                "end": 11.060
            },
            {
                "speaker_id": "1",
                "transcription": "서리가 추가됐습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.070,
                "end": 12.795
            },
            {
                "speaker_id": "1",
                "transcription": "타격당 13.4퍼센트 확률로 15초 동안 대상의 공격 속도를 감소시키고 그다음에 빙결 피해량도 50퍼센트 증가시킨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.805,
                "end": 21.470
            },
            {
                "speaker_id": "1",
                "transcription": "자 공격 속도 느리게 해주는 것 정말 좋고 그다음 빙결 피해량도 늘려주는 것도 정말 중요한데 문제가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.480,
                "end": 29.394
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 눈설탕맛 쿠키가 정말 실전에 쓰일려면은 어떤 자리를 뺏어야 되냐면은 현재 요렇게 많이 쓰이고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.404,
                "end": 37.520
            },
            {
                "speaker_id": "1",
                "transcription": "서리랑 이 소르베랑 같이 쓰이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.530,
                "end": 40.042
            },
            {
                "speaker_id": "1",
                "transcription": "그러면 이 조합을 깨고 눈설탕맛 쿠키가 블랙펄 자리에 들어오던지 아니면 서리를 자리를 뺏던지 이 둘 중에 하나에 역할로 들어가야 되는데 고거를 한번 비교를 해보고 만약에 저 자리 뺏기가 힘들다면 지금 현실적으로 들어갈 수 있는 방법은 이 소원 덱이 좋은지 한번 봐야 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.052,
                "end": 61.304
            },
            {
                "speaker_id": "1",
                "transcription": "이 눈설탕 자리에 오이스터가 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.314,
                "end": 63.665
            },
            {
                "speaker_id": "1",
                "transcription": "오이스터보다도 더 좋은지도 체크해 볼 포인트입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.675,
                "end": 67.731
            },
            {
                "speaker_id": "1",
                "transcription": "월드 탐험에서 느낌적인 느낌 한번 보도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 67.741,
                "end": 71.872
            },
            {
                "speaker_id": "1",
                "transcription": "라즈베리로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.882,
                "end": 73.273
            },
            {
                "speaker_id": "1",
                "transcription": "일단은 전투력 자체가 45만이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.283,
                "end": 75.700
            },
            {
                "speaker_id": "1",
                "transcription": "평타가 9만 역시 평타가 더 높아지죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.710,
                "end": 80.359
            },
            {
                "speaker_id": "1",
                "transcription": "스노우킹도 확실히 딜이 더 들어가고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.369,
                "end": 85.291
            }
        ]
    },
