            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "미지의 쿠키가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.735
            },
            {
                "speaker_id": "1",
                "transcription": "아니 그러면 어떻게 다음 업데이트가 프릴 해파리인 걸 알 수가 있을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.745,
                "end": 8.022
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 쿠키런 킹덤 스페셜 에피소드에 나오는 쿠키들을 보면 프릴 해파리 맛 쿠키가 등장하게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.047,
                "end": 14.860
            },
            {
                "speaker_id": "1",
                "transcription": "프릴 해파리를 제외한 나머지 쿠키들은 게스트 쿠키나 슈퍼 에픽으로 이미 출시가 됐고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.875,
                "end": 21.032
            },
            {
                "speaker_id": "1",
                "transcription": "자 프릴 해파리의 외형을 보게 되면 이미 크림슨 코랄이 전방 슈퍼 에픽으로 출시됐기 때문에 제 생각에는 지원형이나 마법형으로 출시될 가능성이 상당히 커 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.095,
                "end": 33.410
            },
            {
                "speaker_id": "1",
                "transcription": "자 이미 회복형으로는 스냅 드래곤, 락스타 맛 쿠키가 있기 때문에 지원형이나 마법형으로 출시가 된다면 공격적인 면이나 버프형으로 쓰임새가 있지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.420,
                "end": 44.982
            },
            {
                "speaker_id": "1",
                "transcription": "현재 아레나는 정말 극강의 극딜덱 위주로 세팅이 되어있고 자 다른 분들이 사용하는 덱들의 형태를 보게 되면 거의 덱이 고정화되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.015,
                "end": 56.136
            },
            {
                "speaker_id": "1",
                "transcription": "1탱에는 크림슨 코랄 탐 딜러 그리고 킬러 한 마리 이런 구도가 쭉 이어지고 있기 때문에 제 개인적인 생각은 2, 3딜러의 구조에서 딜러가 하나 빠지고 지원형이 하나 들어가서 좀 더 공격적으로 활용할 수 있는 에픽이 출시되지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.146,
                "end": 73.352
            },
            {
                "speaker_id": "1",
                "transcription": "자 물론 락스타 맛 쿠키가 좀 더 공격적으로 쓸 수 있는 회복형이기는 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.362,
                "end": 79.630
            },
            {
                "speaker_id": "1",
                "transcription": "자신을 제외한 아군한테 치명타 확률을 올려주는 쿠키로 활용은 가능하지만 하나의 단점은 올쿨 토핑 세팅으로 활용할 시에 피해 감소를 무작정 높여서 쓰면 다른 딜러보다 늦게 죽으면 락스타 맛 쿠키가 죽었을 때 앙코르 공연하는 시점이 애매해질 수도 있기 때문에 락스타 맛 쿠키를 3딜 덱에서는 많이 안 쓰는 편이거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.640,
                "end": 104.021
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 프릴 해파리가 나와서 이 3딜 덱에 하나의 대체 쿠키로 들어가서 잘 활용될 수 있는 가능성이 있지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 104.031,
                "end": 111.361
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 하나의 가능성은 현재 토벌덱 감초 네 용 토벌에서 토벌 관련 쿠키로 등장할 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 111.371,
                "end": 120.433
            }
        ]
    },
    "summary": "프릴 해파리를 제외한 나머지 쿠키들은 이미 출시가 되었기 때문에 다음 업데이트 쿠키는 프릴 해파리인 것을 예상할 수 있으며 지원형이나 마법형으로 출시될 가능성이 높다.",
