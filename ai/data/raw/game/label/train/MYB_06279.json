                    2,
                    3,
                    5
                ],
                "start": 11.587,
                "end": 15.477
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 보게나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.487,
                "end": 16.844
            },
            {
                "speaker_id": "2",
                "transcription": "아니 이건 너무한 거 아닙니까?",
