        "term": [
            {
                "speaker_id": "1",
                "transcription": "하지만 세상에 공짜는 없지 않은가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.787
            },
            {
                "speaker_id": "1",
                "transcription": "건물을 빌려주는 내 입장도 생각해 줘야지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.797,
                "end": 6.069
            },
            {
                "speaker_id": "2",
                "transcription": "알겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.079,
                "end": 8.613
            },
            {
                "speaker_id": "2",
                "transcription": "그런데 얼마입니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.623,
                "end": 11.577
            },
            {
                "speaker_id": "1",
                "transcription": "내가 그럴 줄 알고 새 계약서를 준비해 왔네.",
