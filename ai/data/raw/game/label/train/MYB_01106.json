        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이렇게 보고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.048
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 결론을 말씀드리면 바다요정과 잘 쓰기 위해서는 아레나에서 스타더스트 그 다음에 달빛술사 홀리베리 드래곤 이 다섯 쿠키 이 조합 외에는 바다요정과 관련된 아레나 조합을 하기가 매우 힘듭니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 1.058,
                "end": 13.868
            },
            {
                "speaker_id": "1",
                "transcription": "활용가치가 아레나에서는 조금 낮다 이렇게 보시면 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.878,
                "end": 16.686
            },
            {
                "speaker_id": "1",
                "transcription": "자 블랙펄 같은 경우에는 정말 다양한 조합으로 쓸 수 있고 어떠한 쿠키와도 시너지 좋게 쓸 수 있는데 대표적으로 스타더스트와 정말 잘 어울리게 쓸 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.696,
                "end": 25.432
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 락스타랑도 묶여서 아주 활용 가치가 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.442,
                "end": 29.043
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 블랙펄 키우시는 분들은 스타더스트랑 같이 키우셔서 락스타까지 묶어서 같이 활용하면은 여러개 종류를 여러 개를 만들면서 쓸 수가 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.053,
                "end": 38.407
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 또 하나 더 이 특별토핑 얘기도 질문이 많이 나와서 말씀드리면 블랙펄은 쿨토핑을 많이 쓰게 되거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.417,
                "end": 46.264
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 여러분들이 진짜 어쩔 수 없이 당장 선택해야 된다 아 쿨토핑이 너무 부족하다는 분들은 지금 바다요정 특별토핑을 저는 쿨토핑을 추천드리되 나머지 라지나 다른 토핑은 추천드리지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.274,
                "end": 58.662
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 다음 신규쿠키 나오면은 고르는 게 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.672,
                "end": 62.143
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 지금 고른다면 쿨토핑이 낫다 이렇게 보시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.153,
                "end": 66.061
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이것이 질문도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 66.071,
                "end": 67.857
            },
            {
                "speaker_id": "1",
                "transcription": "두 개의 레전더리 선택 상자에서 어떤 걸 선택해야 되냐 이 두 개 중에는 당연히 블랙홀이 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.867,
                "end": 73.035
            },
            {
                "speaker_id": "1",
                "transcription": "만약에 달빛술사까지 선택되어서 하나도 없다 하신 분들도 저는 블랙펄를 선택 할 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.045,
                "end": 79.176
            },
            {
                "speaker_id": "1",
                "transcription": "이건 제 기준이기 때문에 달빛술사를 유용하게 쓸 수도 있지만 리더효과 때문에 우선적으로 블랙펄을 먼저 선택할 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 79.186,
                "end": 88.733
            }
        ]
    },
    "summary": "바다요정과 잘 쓰기 위해서는 아레나에서 스타더스트 그 다음에 달빛술사 홀리베리 드래곤 이 다섯 쿠키 이 조합이 좋고 블랙펄 같은 경우에는 정말 다양한 조합으로 쓸 수 있고 어떠한 쿠키와도 시너지 좋게 쓸 수 있는데 대표적으로 스타더스이고, 블랙펄 키우시는 분들은 스타더스트랑 같이 키우셔서 락스타까지 묶어서 같이 활용하면은 여러개 종류를 여러 개를 만들면서 쓸 수가 있고 두 개의 레전더리 선택 상자에서 어떤 걸 선택해야 되냐면 리더효과 때문에 우선적으로 블랙펄을 먼저 선택할 것 같습니다.",
