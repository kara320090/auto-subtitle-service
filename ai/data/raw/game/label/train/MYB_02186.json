        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 분명히 1, 2, 3, 4, 5번 소개해 드리면 이런 질문 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.432
            },
            {
                "speaker_id": "1",
                "transcription": "러너님 스타더스트가 없는데 대체 없나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.432,
                "end": 6.117
            },
            {
                "speaker_id": "1",
                "transcription": "저 달빛 없는데 대체 없나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.117,
                "end": 8.092
            },
            {
                "speaker_id": "1",
                "transcription": "소르베 없는데 대체 없나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.092,
                "end": 9.805
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 중요한 점은 스타더스트가 없는 자리에 다른 쿠키가 들어 온다 뭐 블랙펄이나 다른게 들어와도 괜찮긴 한데 지금 토핑 세팅이 맞춰진 거는 서로 상호작용하는 스킬 관계에 의해서 좋다고 추천드리는 거지 대체로 뭐 스타더스트 대신에 블랙펄이나 다른 쿠키가 들어간다고 해서 동일한 승률이 나오진 않습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.807,
                "end": 32.692
            },
            {
                "speaker_id": "1",
                "transcription": "그거만 참고해 주시면 될 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.692,
                "end": 34.620
            },
            {
                "speaker_id": "1",
                "transcription": "일단 이렇게 해서 제가 이번에 추천드릴 거는 4번 덱이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.622,
                "end": 39.040
            },
            {
                "speaker_id": "1",
                "transcription": "이거 마지막으로 퓨바가 살면은 어떤식으로 이긴다.",
