        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "일단 어 와일드베리가 출시 된 이후에는 가장 중요한 목적은 한방덱을 잘 막을 수 있도록 출시 된 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.035
            },
            {
                "speaker_id": "1",
                "transcription": "무난하게 실론나이트 한방덱이 활개 치는 걸 막아라 그런 느낌으로 창과 방패를 동시에 출시했다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.045,
                "end": 19.767
            },
            {
                "speaker_id": "1",
                "transcription": "네 그렇게 보시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.777,
                "end": 22.095
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 제가 이거 추천 드린 거는 공격덱으로 뭐 무지성으로 좋다 이런 게 아니라 방덱용입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.105,
                "end": 28.976
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱류를 정말 잘 막고 그리고 이제 정석덱이 들어와도 어느 정도 수비가 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.986,
                "end": 35.227
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 기존의 정석덱한테 뚫리는 모습이 종종 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.237,
                "end": 40.089
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 오늘 또 제가 이번 영상에서 보여드릴 거는 컨셉상 정말 우주 수비 모드로 보여줄 수 있는 그런 컨셉인데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.099,
                "end": 48.294
            },
            {
                "speaker_id": "1",
                "transcription": "앞에는 아군의 치명타 피해도 증가 시켜주고 그 다음에 변신 중 피해 감소 15퍼센트 증가 자 홀리베리 같은 경우에는 아군의 피해를 35퍼센트까지 흡수해 주죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.304,
                "end": 60.022
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 뒤에는 무한 힐을 공급 그 다음에 체력 보호막도 홀리베리 그 다음에 스냅드래곤 퓨어바닐라가 체력 보호막 3중 체력 보호막입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.032,
                "end": 68.624
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 용과 드래곤 자체 피해 감소도 있죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.634,
                "end": 71.482
            },
            {
                "speaker_id": "1",
                "transcription": "한마디로 정말 단단한 덱인데 공격하는 거는 용과 드래곤 혼자 딜을 넣을 수 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 71.492,
                "end": 77.694
            },
            {
                "speaker_id": "1",
                "transcription": "한번 요 컨셉으로 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.704,
                "end": 80.550
            },
            {
                "speaker_id": "1",
                "transcription": "홀리베리 올 쿨 네 와일드베리 올 아몬드 그 다음에 용과 올 라즈 쿨 퓨어는 2 아몬드 3 쿨 그 다음에 스냅드래곤 올 쿨 자 상대방분 와일드베리덱인데 이거 한번 가보겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.560,
                "end": 95.900
            }
        ]
    },
