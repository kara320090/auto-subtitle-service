        "term": [
            {
                "speaker_id": "1",
                "transcription": "그렇잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.319
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이제 여기까지도 약간 괴물로 변한 느낌었는데 이게 너무 신기했어.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.329,
                "end": 9.142
            },
            {
                "speaker_id": "1",
                "transcription": "시바가 되는 건 약간 마법 공주, 마법 소녀 막 이런 이미지의 느낌이어서 여자가 이렇게 변신하는 거에 대해서는 이제 얘랑 베네딕타랑 둘 다 그냥 그러려니 했거든?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.152,
                "end": 18.822
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이게 진짜 충격이었어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.832,
                "end": 20.331
            },
            {
                "speaker_id": "1",
                "transcription": "할아버지라니 완전 무슨 신 같은 존재의 모습으로 변하는 게.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.341,
                "end": 24.386
            },
            {
                "speaker_id": "1",
                "transcription": "아 그러니까 신화에 나오는 존재.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.396,
                "end": 26.302
            },
            {
                "speaker_id": "1",
                "transcription": "아 그런 게 너무 재밌었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.312,
                "end": 28.049
            },
            {
                "speaker_id": "1",
                "transcription": "가루다도 그렇고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.059,
                "end": 29.103
            },
            {
                "speaker_id": "1",
                "transcription": "근데 이 가루다가 베네딕타랑 너무 찰떡이지 않아요 여러분?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.113,
                "end": 34.133
            }
        ]
    },
    "summary": "여자 게임 유튜버는 다른 캐릭터들은 괴물로 변한 느낌이었는데 시바라는 캐릭터는 마법 소녀 같은 이미지라고 얘기하고 가루다라는 캐릭터와 베네딕타라는 캐릭터가 찰떡이라고 얘기한다.",
