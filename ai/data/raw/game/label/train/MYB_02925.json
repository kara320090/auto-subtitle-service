        "term": [
            {
                "speaker_id": "1",
                "transcription": "여러분들이 키워주셔야 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.682
            },
            {
                "speaker_id": "1",
                "transcription": "하나 더 말씀드리면은 이 달빛 전용 토핑 이거 어떤 걸로 해야 되냐고 물어보신 분들 이 달빛 전용 토핑 같은 경우에는 공용으로 블루파이 그다음에 밀키웨이, 달빛술사 3개가 같이 쓸 수 있는데 쿨로 하면은 좀 중요하냐면은 피해 감소 높은 상태에서 쿨도 높아야 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.692,
                "end": 21.159
            },
            {
                "speaker_id": "1",
                "transcription": "그래야 좀 쿨 세팅 하는데 여유가 생기고 당연히 마찬가지로 공격력과 치명타 확률도 높으면 그마만큼 엄청나게 딜이 세지기 때문에 이런 토핑도 쓸 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.169,
                "end": 33.076
            },
            {
                "speaker_id": "1",
                "transcription": "나머지 쿨을 어느 정도 채워주면은 피해 감소 공격력 치명타 확률 이렇게 해서 딜을 더 높여줄 수 있게끔 세팅도 가능하기 때문에 제 개인적인 생각은 달빛은 쿨 토핑 파밍을 먼저 이렇게 해주시고 나중에 좀 이제 하나가 완성되고 더 이상 이제 좀 여유가 있다 하면은 그때는 뭐 라즈나 뭐 여러분들 원하는 대로 하는 게 더 좋지 않나. 이건 제 개인적인 생각입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.086,
                "end": 58.772
            },
            {
                "speaker_id": "1",
                "transcription": "아레나뿐만 아니라 수호 성전에서도 진짜 엄청나게 사기적으로 쓰이고 있거든요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 58.782,
                "end": 65.336
            },
            {
                "speaker_id": "1",
                "transcription": "수호 성전에서도 필수. 뭐 추후에 나오는 대난투 같은 콘텐츠에서도 얘는 필수로 쓰이는 쿠키일 거라 여러분들이 육성 우선순위를 가장 최우선으로 키워주시면 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
