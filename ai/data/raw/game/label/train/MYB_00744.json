    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아무튼 스킬 이펙트가 좀 많이 좀 달라졌습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.017
            },
            {
                "speaker_id": "1",
                "transcription": "세인트릴리도 바뀌었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.027,
                "end": 4.905
            },
            {
                "speaker_id": "1",
                "transcription": "이게 이제 조만간 골드치즈뿐 아니라 세인트릴리도 출시가 임박한 걸 확인할 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.915,
                "end": 12.323
            },
            {
                "speaker_id": "1",
                "transcription": "아니 @이름1님 골드치즈가 나오면은 뭐 뭐가 바뀔 것 같나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 12.333,
                "end": 17.576
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 제가 생각할 때 골드치즈가 나오면은 어떤 영향이 있냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.586,
                "end": 22.932
            },
            {
                "speaker_id": "1",
                "transcription": "제가 쿠키런 킹덤 2년 반 동안 하면서 모든 쿠키의 리뷰를 하나도 빠짐없이 전부 다 해왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.942,
                "end": 30.051
            },
            {
                "speaker_id": "1",
                "transcription": "근데 제가 하나 공통점으로 말할 수 있는 건 고대 쿠키는 전방 탱커는 처음 출시됐을 때 사기적으로 나온 적이 없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 30.061,
                "end": 39.161
            },
            {
                "speaker_id": "1",
                "transcription": "슈퍼 에픽 같은 경우에는 딜러가 처음 나왔을 때 어마무시하게 사기적으로 나온 경우가 대부분 많습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.171,
                "end": 46.433
            },
            {
                "speaker_id": "1",
                "transcription": "예를 들어 스타더스트 나왔을 때부터 0티어, 샤이닝글리터 아 얘는 나왔을 때부터 0 티어라기보다는 승급이 올라가고 나서 좋아진 케이스고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 46.443,
                "end": 57.156
            },
            {
                "speaker_id": "1",
                "transcription": "자 레전드 쿠키 같은 경우에는 나왔을 때부터 사기였습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.166,
                "end": 61.743
            },
            {
                "speaker_id": "1",
                "transcription": "자 드래곤 등급은 나오자마자 완전 사기 하지만 고대 쿠키의 탱커들은 홀리베리는 처음 나왔을 때 딸기크레페보다도 성능이 안 좋아서 강제 상향을 3번, 4번이나 받고 나서야 사람들이 쪼끔 쓰기 시작했고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.753,
                "end": 77.431
            },
            {
                "speaker_id": "1",
                "transcription": "그 이후에 2주년 때 대대적인 엄청난 상향을 받고 지금의 0티어가 되어 사용되고 있었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.441,
                "end": 85.175
            },
            {
                "speaker_id": "1",
                "transcription": "다크카카오도 처음에는 출시됐을 때 물론 좋게 썼지만 다른 신규 쿠키들처럼 엄청난 사기적인 쿠키로 출시되진 않았었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 85.185,
                "end": 95.150
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 골드치즈는 다를 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 95.160,
                "end": 98.098
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 사격형으로 나올 가능성이 크고 아무래도 딜러로 나올 가능성이 크죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.108,
                "end": 104.028
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여러분들 쿠키런 킹덤 많이 하신 분들 지금 모든 쿠키 중에 지금 제일 사기적인 쿠키가 뭐라고 생각하시나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 104.038,
                "end": 111.214
            },
            {
                "speaker_id": "1",
                "transcription": "가장 현재 거의 문제적인 쿠키라 생각할 정도로 심각하게 좋다 생각하는 거는 딱 하나 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 111.224,
                "end": 119.501
            },
            {
                "speaker_id": "1",
                "transcription": "스타더스트예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 119.511,
                "end": 120.523
            },
            {
                "speaker_id": "1",
                "transcription": "아니 @이름1님 스타더스트가 좋은 게 뭔 상관인가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 120.533,
                "end": 124.567
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 아레나를 보게 되면 스타더스트를 대부분 많이 사용하게 되는데 자 스타더스트는 다른 쿠키와는 다르게 스킬 피해가 치명타로 적용될 경우 적은 수면 상태에 빠진다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 124.577,
                "end": 138.442
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 수면 상태에 빠지고 안 빠지고에 따라서 엄청나게 승률 차이가 벌어지고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 138.452,
                "end": 144.652
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 수면 상태에 빠진 것뿐 아니라 수면에 걸리면은 푸른 유성의 대미지가 추가로 들어갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 144.662,
                "end": 152.052
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 아레나는 보시는 거와 같이 스타더스트가 없으면은 필수인 아레나가 되어버렸고 여전히 스타더스트가 출시된 지 엄청나게 오래됐지만 아레나를 지배하고 있고 다른 신규 쿠키들이 나와도 압도적으로 슈퍼 에픽 중에서 대체 불가능의 그런 쿠키가 되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 152.062,
                "end": 173.222
            },
            {
                "speaker_id": "1",
                "transcription": "제 예상인데 이 스타더스트를 끌어내릴 쿠키는 아무래도 골드치즈가 되지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 173.232,
                "end": 179.639
            },
            {
                "speaker_id": "1",
                "transcription": "조심스럽게 예측을 하고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 179.649,
                "end": 181.443
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 스타더스트를 끌어낼 수 있는 유일한 방법은 어떤 게 있냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 181.453,
                "end": 186.096
            },
            {
                "speaker_id": "1",
                "transcription": "자 원래 블랙펄은 잼스톤 능력에 상대편에 치명타 확률을 낮춘다는 능력이 있었지만 업데이트 당일날 그 내용이 변경되었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 186.106,
                "end": 195.037
            },
            {
                "speaker_id": "1",
                "transcription": "아무래도 제 생각은 골드치즈 업데이트를 염두에 두고 그 능력은 빠지고 골드치즈가 상대편에 치명타 확률을 낮춰서 스타더스트를 대체하는 새로운 딜러 형태로 나오지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 195.047,
                "end": 208.466
            },
            {
                "speaker_id": "1",
                "transcription": "또 대체 불가능한 능력 중에 하나가 별의 표식이거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 208.476,
                "end": 212.423
            },
            {
                "speaker_id": "1",
                "transcription": "별의 표식 같은 경우에는 상대방에게 버프 금지, 공격력 감소, 회복량 감소, 피해 증가 디버프입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 212.433,
                "end": 218.864
            },
            {
                "speaker_id": "1",
                "transcription": "근데 여기에 스타더스트를 대체할 수 있으려면은 이런 기본적인 능력에다가 치명타 확률을 낮춘다는 디버프가 추가가 된다면은 스타더스트는 더 이상 쓸 필요가 없게 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 218.874,
                "end": 230.091
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 제가 예측하기에는 자 아무래도 9월 8일 날 업데이트에는 프릴해파리가 스타더스트를 저격해서 나오는 건 절대 아닐 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 230.101,
                "end": 238.722
            },
            {
                "speaker_id": "1",
                "transcription": "다가올 9월 말 업데이트에는 골드치즈가 나와서 아마 스타더스트를 저격하는 대대적인 대규모 업데이트가 되지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 238.732,
                "end": 247.323
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 여러분들이 그렇게 원하던 광산 업데이트 골드치즈가 나오면 광산 업데이트도 항상 언급되던 콘텐츠이기 때문에 이것도 나오면서 데브시스터즈에서 언급했었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 247.333,
                "end": 259.554
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 이 콘텐츠가 재미없는 그냥 단순히 파밍 하는 콘텐츠가 아니라 의미 있는 콘텐츠로 다시 만들겠다. 그렇게 언급을 했기 때문에 기대해 볼만한 콘텐츠지 않을까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 259.564,
                "end": 272.333
            }
        ]
    },
    "summary": "남성이 조만간 골드치즈와 세인트릴리 출시가 임박한 걸 확인할 수가 있으며 골드치즈가 나오면 어떤 영향이 있는지 예상해 본다.",
