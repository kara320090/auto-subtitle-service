        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 BTS랑 쿠키런 킹덤이 콜라보 한다고 되어 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.764
            },
            {
                "speaker_id": "1",
                "transcription": "자 용감한 쿠키가 깨알 이렇게 점프 뛰면서 보고 있고 딸기 맛 쿠키도 있는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.774,
                "end": 10.586
            },
            {
                "speaker_id": "1",
                "transcription": "자 그러고 요것 또한 관련된 이미지로는 처음에 나왔던 이미지들입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.596,
                "end": 16.224
            },
            {
                "speaker_id": "1",
                "transcription": "커밍 순 이미지가 또 올라왔었습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.234,
                "end": 19.010
            },
            {
                "speaker_id": "1",
                "transcription": "자 이미 쿠키런 킹덤에는 파르페 맛 쿠키처럼 무대에서 노래도 부르는 이런 쿠키가 이미 나왔었고 쿠키런 오븐 브레이크에서도 팝핑 캔디 맛 쿠키라고 해서 이미 이런 식으로 컨셉이 나오긴 했습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.020,
                "end": 33.818
            },
            {
                "speaker_id": "1",
                "transcription": "슈퍼 아이돌의 시상식 룩 해서 팝핑 캔디 맛 쿠키가 이미 이런 식으로 나왔는데 BTS 관련돼서 또 이번에 쿠키들이 출시가 되니까 기대가 많이 되네요.",
