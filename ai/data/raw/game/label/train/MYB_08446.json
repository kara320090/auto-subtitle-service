        "term": [
            {
                "speaker_id": "1",
                "transcription": "이번 시즌은 조졌고 저는",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 3.747
            },
            {
                "speaker_id": "1",
                "transcription": "음 부탁있어요.",
                "sound_type": [
                    2
                ],
                "start": 3.747,
                "end": 7.025
            },
            {
                "speaker_id": "1",
                "transcription": "이제 별걸 다 시키네 나한테 야채 씨앗을 전달해 달래.",
                "sound_type": [
                    2
                ],
                "start": 7.025,
                "end": 13.750
            },
            {
                "speaker_id": "1",
                "transcription": "식량을 자급할 수 있어야만 되니까 대부분 베어라가 이주했고 자신의 힘으로 살아가는 경험을 해보지 못했어.",
                "sound_type": [
                    2
                ],
                "start": 13.750,
                "end": 22.990
            },
            {
                "speaker_id": "1",
                "transcription": "노예로 살아왔기 때문에",
                "sound_type": [
                    2
                ],
                "start": 22.992,
                "end": 26.807
            },
            {
                "speaker_id": "1",
                "transcription": "스스로 행동해야 한다는 걸 배워야 한다.",
                "sound_type": [
                    2
                ],
                "start": 26.810,
                "end": 30.090
            },
            {
                "speaker_id": "1",
                "transcription": "작물을 재배하는 기쁨과 식량을 얻는 고마움을 알면 베어라들도 점점 변하지 않을까 해서 말이야.",
                "sound_type": [
                    2
                ],
                "start": 30.090,
                "end": 36.385
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 또 구구절절 얘기하면 또 어쩔 수 없이 세계 최고 악당인 시드께서 야채 씨앗을 배달해 줘야 되지 않을까요?",
                "sound_type": [
                    2
                ],
                "start": 36.385,
                "end": 47.030
            },
            {
                "speaker_id": "1",
                "transcription": "그러니까 이젠 난 진짜 뭐 잡아 달라는 부탁도 아니고 나보고",
                "sound_type": [
                    2
                ],
                "start": 47.030,
                "end": 53.200
            }
        ]
    },
    "summary": "야채 씨앗을 배달해 달라고 시드에게 부탁하고 있습니다.",
