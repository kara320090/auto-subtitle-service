        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 썸네일 보고 들어오신 분들 무지개 큐브 3만개를 뿌린다고요 아니 러너님 너무 어그로 심한거 아닌 가요라고 생각하는 분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.228
            },
            {
                "speaker_id": "1",
                "transcription": "진짜로 3만개를 뿌립니다 자 무지개 큐브 3000개 쿠폰 10명에게 제가 나눠드릴거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.238,
                "end": 13.260
            },
            {
                "speaker_id": "1",
                "transcription": "3000천개 정말이 쩨쩨한거 아닌가요 자 3000천개는 무지개 큐브 데브시스커즈에서 파는 패키지 가격 25000원에 해당하는 가격이고요 절대 작은 가격이 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.270,
                "end": 25.699
            },
            {
                "speaker_id": "1",
                "transcription": "아니 러너님 근데 왜 이렇게 많이 뿌리는 건가요 자 27일까지 제가 플레이오 웹 광고가 이제 끝나기 때문에 이벤트로 대량으로 뿌릴 거고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.709,
                "end": 35.396
            },
            {
                "speaker_id": "1",
                "transcription": "자 받는 방법은 정말 간단합니다 자 여러분들 고정 댓글에 있는 플레이오 다운로드 링크로 다운로드 받으시면 화면에 요렇게 다운로드가 되고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 35.406,
                "end": 44.562
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 들어가서 여러분들이 해야 할 거는 시크릿 코드만 입력해 주시면 끝납니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.572,
                "end": 49.412
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 우측 하단에 프로필을 누르시고요 우측 상단에 이 톱니바퀴를 눌러주세요 자 그러면 가운데 시크릿 코드가 보이죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.422,
                "end": 57.297
            },
            {
                "speaker_id": "1",
                "transcription": "이걸 눌러서 플오ND러너 이것만 입력해 주시면 끝 자 이것까지 30초 정도밖에 안 걸립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.307,
                "end": 65.431
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 8월 27일 라이브 방송에서 10명을 직접 뽑도록 하겠습니다 자 주의해야 될 거는 반드시 신규 가입자만 가능하고요 시크릿 코드 입력해 주신 분들만 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.441,
                "end": 78.367
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 하나 여러분들 패키지 구매를 해야 되는데 비싸서 구매 못하는 분들 아니면 무료로 과금하고 싶은데 구매 못하는 분들 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.365,
                "end": 87.285
            },
            {
                "speaker_id": "1",
                "transcription": "아까 말씀드린 플레이오 앱에 시크릿 코드를 입력하면 만 잼을 드리고 여러분들 게임만 하면은 자동으로 쌓이는 그 포인트로 이렇게 상점에서 구글 기프트 카드나 문화상품권으로 교환해서 무료로 과금할 수도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.295,
                "end": 101.471
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 여러분들이 게임할 때 광고가 뭐 따로 뜨냐 그런 거 전혀 없이 자동으로 포인트가 쌓인다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.481,
                "end": 108.342
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 업데이트도 다가오고 그리고 패키지 상점에서 만 원 미만의 킹덤패스라던지 그리고 스타터 패키지 같은 경우에는 정말 혜자니까 여러분들이 구매하는 걸 저는 추천드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 108.352,
                "end": 119.790
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 아직도 블랙펄 아직 못 뽑은 분들 무지개 큐브 당첨되셔서 뽑으시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 119.800,
                "end": 126.132
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3만개 이벤트 네 고정 댓글 자세하게 확인해 보시고 많이 참가해 주시길 바랍니다 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 126.142,
                "end": 136.833
            }
        ]
    },
