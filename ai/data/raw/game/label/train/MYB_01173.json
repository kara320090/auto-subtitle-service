        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이번엔 안 나왔습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.140
            },
            {
                "speaker_id": "1",
                "transcription": "아 이번에도 또 안 나왔어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.150,
                "end": 5.618
            },
            {
                "speaker_id": "1",
                "transcription": "야 갑자기 안 나와 이거 왜 이래",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.628,
                "end": 7.581
            },
            {
                "speaker_id": "1",
                "transcription": "야 잠깐만 어디 갔어 특별 토핑 왜 이래",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.591,
                "end": 10.613
            },
            {
                "speaker_id": "1",
                "transcription": "야 지금 몇 개야 나 좀 안 나온거 같은데?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.623,
                "end": 13.349
            },
            {
                "speaker_id": "1",
                "transcription": "자 하나 더 추가 야 이거 50개 나와야 확률값인데 어디 갔어?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.359,
                "end": 19.481
            },
            {
                "speaker_id": "1",
                "transcription": "자 하나 더 추가 자 하나 더 추가 자 이번에도 하나 더",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.491,
                "end": 23.552
            },
            {
                "speaker_id": "1",
                "transcription": "마지막은 61개 한번에 다 까겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.562,
                "end": 25.829
            },
            {
                "speaker_id": "1",
                "transcription": "자 마지막 61개 2개 최종적으로 43개에 이렇게 나왔고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.839,
                "end": 34.038
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 에픽 영혼 상자는 10개 그다음에 이 샤이닝 뽑기는 3000개 확률업 커터 카드는 23개",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.048,
                "end": 41.718
            },
            {
                "speaker_id": "1",
                "transcription": "제가 마일리지가 없었는데 마일리지도 엄청나게 나왔다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.728,
                "end": 45.444
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 샤이닝 뽑기 뭐 간단하게 해볼까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.454,
                "end": 47.666
            },
            {
                "speaker_id": "1",
                "transcription": "뭐야 아니 이거 이렇게 선물을 주네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.676,
                "end": 49.654
            },
            {
                "speaker_id": "1",
                "transcription": "아니 뭐 난 필요가 없는데 어어 없는 사람한테나 주지 아니 저걸 이렇게 준다고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.664,
                "end": 56.300
            }
        ]
    },
    "summary": "화자가 50개씩 상자를 열면서 특별 토핑의 개수를 보고 최종적으로 43개가 나왔으며 다른 아이템들도 여러 개 나왔지만 샤이닝 뽑기를 간단하게 해보겠다 했는데 예상치 못한 선물이 나왔다.",
