        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "본인 자체의 생존도 올라가기 때문에 힐량이 높아질수록 토벌의 세팅 난이도도 내려간다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 7.045
            },
            {
                "speaker_id": "1",
                "transcription": "락스타의 승급도 상당히 중요하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.055,
                "end": 9.561
            },
            {
                "speaker_id": "1",
                "transcription": "뿐만 아니라 자 아레나에서 락스타 덱을 사용할 때 락스타가 승급이 높으면 나머지 애들의 생존도 높아지기 때문에 올려주시면 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.571,
                "end": 18.939
            },
            {
                "speaker_id": "1",
                "transcription": "자 락스타는 제가 티어 분류 표에서 이렇게 0 티어로 에픽으로서는 유일하게 0 티어에 분류하고 있기 때문에 키워도 손해가 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.949,
                "end": 28.126
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 마지막으로 많은 질문이 나왔던 부분 자 런의 트로피컬 락 특별 토핑은 뭘 선택해야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.136,
                "end": 34.859
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 존버하시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.869,
                "end": 37.048
            },
            {
                "speaker_id": "1",
                "transcription": "다음 신쿠 나올 때까지 존버해 주시구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.058,
                "end": 39.466
            },
            {
                "speaker_id": "1",
                "transcription": "이 특별 토핑은 피해 감소 뭐 5 퍼센트 후반대가 나오면은 토핑 조각 10,000개 이상의 가치를 가지기 때문에 정말 막 선택하지 마시고 가급적이면 신규 쿠키가 다음에 나올 때 그 쿠키가 폭발형으로 나오기 때문에 어디서 쓰이는지 보고 결정하는 게 가장 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.476,
                "end": 56.756
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 길트 뽑기도 저는 쓰지 말고 가지고 있는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.766,
                "end": 60.902
            },
            {
                "speaker_id": "1",
                "transcription": "보물도 이제 슬슬 나올 때가 됐어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.912,
                "end": 63.349
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 스타더스트 뽑기권 요거 바꿔서 쓰는 거 괜찮나요 물어보시는 분도 있는데 스타더스트는 아직도 0 티어기 때문에 스타더스트 많이 뽑아두는 거 나쁘지 않다 생각합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.359,
                "end": 74.546
            },
            {
                "speaker_id": "1",
                "transcription": "버그 수정 이후에도 0 티어로 여전히 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.556,
                "end": 78.899
            },
            {
                "speaker_id": "1",
                "transcription": "티어 표에서도 여전히 0 티어로 자기 매김하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 78.909,
                "end": 82.858
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 뿌리는 그 무지개 큐브 3,000개 그거 댓글 참여 이벤트해 주시면 좋을 것 같구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.868,
                "end": 89.810
            },
            {
                "speaker_id": "1",
                "transcription": "다양한 이벤트 이거 이제 일주일도 안 남은 곳도 있으니까 다 참여해서 받아주시면 좋을 것 같애요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.820,
                "end": 97.839
            },
            {
                "speaker_id": "1",
                "transcription": "자 궁금한 점이 있으면 댓글에 더 남겨주시구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 97.849,
                "end": 101.103
            },
            {
                "speaker_id": "1",
                "transcription": "이벤트 보상, 접속 보상 다 챙겨 받아 가시길 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 101.113,
                "end": 105.733
            },
            {
                "speaker_id": "1",
                "transcription": "영상은 여기서 마치도록 할게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 105.743,
                "end": 113.333
            }
        ]
    },
    "summary": "락스타의 승급이 중요하며 특별 토핑은 신규 쿠기가 나올 때 어디에 쓰이는지 보고 결정하는 게 좋고 스타더스트는 0 티어이기 때문에 많이 뽑는 게 좋으며 이벤트 참여도 많이 하라고 한다.",
