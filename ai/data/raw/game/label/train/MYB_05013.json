        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이보다 더 좋은 힐량과 버프를 가진 쿠키들에 의해 티어가 밀려난 상태입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.652
            },
            {
                "speaker_id": "1",
                "transcription": "그다음 홀리베리 쿠키는 모든 콘텐츠에서 밀려난 고대 쿠키로 2티어입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.662,
                "end": 9.377
            },
            {
                "speaker_id": "1",
                "transcription": "출시부터 왜 이게 고대 등급인가라는 의문이 들던 쿠키로 상향을 두 번이나 받았음에도 불구하고 현재는 잘 쓰이지 않는 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.387,
                "end": 17.570
            },
            {
                "speaker_id": "1",
                "transcription": "고대 등급이라 뽑기 확률은 0.054퍼센트로 엄청나게 낮지만 나오면 전혀 기쁘지 않은 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.580,
                "end": 24.811
            },
            {
                "speaker_id": "1",
                "transcription": "다음은 전설 등급 쿠키 티어입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.821,
                "end": 26.829
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키는 출시하자마자 엄청난 딜량과 사기적인 능력으로 0티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.839,
                "end": 32.309
            },
            {
                "speaker_id": "1",
                "transcription": "스킬 능력에 상대방의 피해 감소 무시와 심해의 공포 디버프까지 붙어서 5초월 바다 요정보다 2성 블랙펄 쿠키의 딜이 더 높을 정도로 사기적인 딜과 디버프 능력을 가진 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.319,
                "end": 44.381
            },
            {
                "speaker_id": "1",
                "transcription": "그다음 바다 요정 쿠키는 출시부터 지금까지 모든 콘텐츠에서 좋은 0티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.391,
                "end": 49.845
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄 쿠키에 밀려서 가장 좋은 전설 쿠키는 아니지만 기절 3초와 광역 폭딜의 능력은 딜러로서 0티어를 유지하고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.855,
                "end": 58.203
            },
            {
                "speaker_id": "1",
                "transcription": "그다음 서리 여왕 쿠키는 아레나에서 유용에게 활용되는 1티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.213,
                "end": 62.342
            },
            {
                "speaker_id": "1",
                "transcription": "보스 몹에 빙결 상태 이상 면역인 경우가 많아 빙결 종료 후 들어가는 피해량이 들어가지 않는 딜 손실 때문에 다른 레전드보다는 활용 가치가 낮지만 아레나에서만큼은 아직도 유용하게 활용됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 62.352,
                "end": 74.092
            },
            {
                "speaker_id": "1",
                "transcription": "다음은 슈퍼 에픽 쿠키 티어입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.102,
                "end": 76.016
            },
            {
                "speaker_id": "1",
                "transcription": "클로티드 크림 쿠키는 소환덱, 정석덱, 토벌덱 등 다양한 조합에서 활용되는 1티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 76.026,
                "end": 81.711
            },
            {
                "speaker_id": "1",
                "transcription": "가장 가까운 적에게 버프 금지와 빛의 감옥을 걸고 범위 피해가 상당합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 81.721,
                "end": 87.054
            },
            {
                "speaker_id": "1",
                "transcription": "그다음 오이스터 맛 쿠키는 대표적으로 토벌덱, 소환덱에 메인으로 쓰이는 1티어 쿠키입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 87.064,
                "end": 92.533
            },
            {
                "speaker_id": "1",
                "transcription": "아군의 치명타 확률과 치명타 피해를 증가시켜 주는 쿠키로 한방덱에서도 사용됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.543,
                "end": 98.298
            }
        ]
    },
    "summary": "홀리베리 쿠키는 뽑기 확률은 0. 054퍼센트로 낮지만 2티어로 현재는 잘 쓰이지 않는 쿠키, 블랙펄 쿠키는 출시하자마자 엄청난 딜량과 사기적인 능력인 0티어 쿠키, 바다 요정 쿠키는 모든 콘텐츠에서 좋은 0티어 쿠키, 서리 여왕 쿠키는 아레나에서 유용에게 활용되는 1티어 쿠키, 클로티드 크림 쿠키는 소환덱, 정석덱, 토벌덱 등 다양한 조합에서 활용되는 1티어 쿠키, 오이스터 맛 쿠키는 토벌덱, 소환덱에 메인으로 쓰이는 1티어 쿠키라고 한다.",
