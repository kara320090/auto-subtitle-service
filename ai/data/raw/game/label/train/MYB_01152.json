            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번에 새롭게 나온 바다요정 잼스톤 자 이거 30강까지 도전을 해볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.715
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤 강화를 하면은 차오르는 해일 피해량 증가 리더 효과도 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.725,
                "end": 10.241
            },
            {
                "speaker_id": "1",
                "transcription": "아까 못 본 분들 위해서 다시 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.251,
                "end": 14.864
            },
            {
                "speaker_id": "1",
                "transcription": "자 요런 식으로 강화 성공되면은 요런 식으로 나오구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.874,
                "end": 21.875
            },
            {
                "speaker_id": "1",
                "transcription": "대성공 뜨면 다음에 강화 확률이 100퍼센트가 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.885,
                "end": 25.047
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이렇게 해서 19강까지 최대한 올렸구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.057,
                "end": 28.408
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤을 하면은 여러분들 일단 10강까지 하면은 네 피해 감소 일부 무시 딜과 해일과 솟구치는 마음 이런 피해 감소 딜이 들어갑니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.418,
                "end": 38.719
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 침묵 효과도 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.729,
                "end": 39.988
            },
            {
                "speaker_id": "1",
                "transcription": "리더 효과로는 물 속성 공격 피해량이 36.2퍼센트 증가된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 39.998,
                "end": 44.970
            },
            {
                "speaker_id": "1",
                "transcription": "네 해일 2중첩 1개 획득하고 해일 2중첩시 스킬이 강화된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.980,
                "end": 49.563
            },
            {
                "speaker_id": "1",
                "transcription": "아 파도 기절 시간 각종 피해량이 추가가 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.573,
                "end": 53.314
            },
            {
                "speaker_id": "1",
                "transcription": "네 30강까지 하면은 확실히 좋긴하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 53.324,
                "end": 56.579
            },
            {
                "speaker_id": "1",
                "transcription": "최대 체력 비례 고정 피해까지 생기고 초월 효과로는 요렇게 치명타 피해 증가 피해 감소 증가 그다음에 기절 추가도 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 56.589,
                "end": 65.587
            },
            {
                "speaker_id": "1",
                "transcription": "바다요정 체력 증가 공격력 증가도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.597,
                "end": 67.709
            },
            {
                "speaker_id": "1",
                "transcription": "자 한번 일단 스토리부터 먼저 가볼게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.719,
                "end": 72.466
            }
        ]
    },
