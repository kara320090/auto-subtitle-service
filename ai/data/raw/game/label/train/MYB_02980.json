        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기에 진짜 피 붙으면 레전드.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.532
            },
            {
                "speaker_id": "1",
                "transcription": "아 너무 아쉬워.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.542,
                "end": 8.756
            },
            {
                "speaker_id": "1",
                "transcription": "피, 쿨 주세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.766,
                "end": 11.102
            },
            {
                "speaker_id": "1",
                "transcription": "하나만 건져도 되거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.112,
                "end": 13.213
            },
            {
                "speaker_id": "1",
                "transcription": "제가 오 잠깐만 제발 쿨 아 제발 오 하나 건졌습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.223,
                "end": 21.450
            },
            {
                "speaker_id": "1",
                "transcription": "이런 걸 원하는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.520,
                "end": 22.970
            },
            {
                "speaker_id": "1",
                "transcription": "네 저런 걸 건질라고 강화를 하는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.020,
                "end": 25.891
            },
            {
                "speaker_id": "1",
                "transcription": "그 여러분들도 강화했을 때 피, 쿨 저렇게 붙은 걸 노리세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.901,
                "end": 29.630
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 꽝 저런 게 있어야 이제 리뷰할 때 쿨 토핑 쫌 편하게 쓸 수 있어서 오 잠만 야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.710,
                "end": 39.533
            }
        ]
    },
    "summary": "영상에서는 피 붙으면 레전드지만 하나는 건졌다면서 이런 걸 건지려고 강화하는 거고 시청자도 강화할 때 피와 쿨이 붙은 걸 노리라고 말한다.",
