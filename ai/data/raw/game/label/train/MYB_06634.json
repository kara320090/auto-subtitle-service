        "term": [
            {
                "speaker_id": "1",
                "transcription": "우와 잘 해놨다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.454
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 잘 그려 놨다 그치?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.464,
                "end": 4.841
            },
            {
                "speaker_id": "2",
                "transcription": "당신들은 경고를 어겼습니다. 배제하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.851,
                "end": 7.597
            },
            {
                "speaker_id": "3",
                "transcription": "거짓말쟁이 거짓말쟁이 올가다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.607,
                "end": 11.703
            },
            {
                "speaker_id": "4",
                "transcription": "하지만 셋 다 빨강 머리가 아닌데.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.713,
                "end": 14.490
            },
            {
                "speaker_id": "5",
                "transcription": "머리를 피로 적시면 빨강 머리가 돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.500,
                "end": 17.456
            },
            {
                "speaker_id": "5",
                "transcription": "그럼 장로 놈들도 이것들이 올가라 믿겠지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.466,
                "end": 20.907
            },
            {
                "speaker_id": "1",
                "transcription": "뭔가 기가 맨날 이상한 것만 맨날 말하라 그러고 뒤진다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.917,
                "end": 25.595
            },
            {
                "speaker_id": "1",
                "transcription": "야 근면, 성실, 정직 아니 시민 이름 어떻게 되는데요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.605,
                "end": 34.802
            },
            {
                "speaker_id": "1",
                "transcription": "뚱땡이가 피가 제일 많을 거 같지?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.812,
                "end": 36.750
            },
            {
                "speaker_id": "1",
                "transcription": "역시 그러면 성실한 애부터 죽이자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.760,
                "end": 40.690
            },
            {
                "speaker_id": "1",
                "transcription": "일단 보호막을 씌워야 될 거 같고 아와하락을",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.700,
                "end": 51.400
            }
        ]
    },
    "summary": "화자는 시민 이름이 근면, 성실, 정직인데 뚱땡이가 피가 제일 많을 거 같다며 성실한 애부터 죽이자고 말한다.",
