        "term": [
            {
                "speaker_id": "1",
                "transcription": "190층 보스 얼마나 세냐면 오우야 생각보다는그래도 뭐 쉽게는 클리어가 되네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 15.337
            },
            {
                "speaker_id": "1",
                "transcription": "아직까지는 되게 쉬운 느낌이 강합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.347,
                "end": 17.860
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 올라가야 되는 이유는 혼돈의 케이크 파편 요게 중요하거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.860,
                "end": 21.653
            },
            {
                "speaker_id": "1",
                "transcription": "저 파편을 통해서 여러분들 케이크 타고 레벨업 하는 게 중요합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.653,
                "end": 25.613
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 191층 상자 보상 봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.628,
                "end": 29.360
            },
            {
                "speaker_id": "1",
                "transcription": "어 요렇게 되어 있네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.353,
                "end": 30.833
            },
            {
                "speaker_id": "1",
                "transcription": "제가 볼 때에는 이거 선택하려고 한다면 요 2번째가 낫지 않을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.840,
                "end": 34.573
            },
            {
                "speaker_id": "1",
                "transcription": "8개 열쇠 더 해서 가는 것도 나쁘지 않아 보이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.586,
                "end": 40.040
            },
            {
                "speaker_id": "1",
                "transcription": "일단 요렇게 190층까지 리뷰는 마치고 그다음은 191층부터 200층 돌파하는 것까지 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.040,
                "end": 62.695
            }
        ]
    },
