        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 오늘 영상은 아레나 조합 추천 영상입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.244
            },
            {
                "speaker_id": "1",
                "transcription": "현재 제가 가장 좋은 조합으로 추천드리는 영상이고 자 상위권을 보게 되면 상위권에서 자 보시는 것 같이 락스타와 파르페맛 쿠키를 활용한 투힐 조합이 방덱으로 보이는 걸 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.254,
                "end": 16.734
            },
            {
                "speaker_id": "1",
                "transcription": "자 제가 설정한 이 방덱이 공덱으로도 활용되는 조합이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.744,
                "end": 21.070
            },
            {
                "speaker_id": "1",
                "transcription": "자 투힐 조합이고 앞에는 홀리베리가 고정 나머지 빈 2자리는 여러분들이 딜러로 고정해 주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.080,
                "end": 28.740
            },
            {
                "speaker_id": "1",
                "transcription": "편하게도 호루라기는 당연히 지원형",
                "sound_type": [
                    2,
