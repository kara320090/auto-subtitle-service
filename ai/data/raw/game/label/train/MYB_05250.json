        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿠키런 킹덤을 PC에서 즐길 때 녹스 앱플레이어를 추천드립니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.841
            },
            {
                "speaker_id": "1",
                "transcription": "윈도우와 맥 버전에서 가상키 설정과 멀티 지원도 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.851,
                "end": 6.274
            },
            {
                "speaker_id": "1",
                "transcription": "더보기 및 고정 댓글 전용 링크를 통해서 녹스 앱플레이어 다운로드 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.284,
                "end": 10.864
            },
            {
                "speaker_id": "1",
                "transcription": "이제 본격적으로 뽑기로 가 볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.874,
                "end": 13.356
            },
            {
                "speaker_id": "1",
                "transcription": "다른 거보다 나는 미니 게임 기대하고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.366,
                "end": 17.204
            },
            {
                "speaker_id": "1",
                "transcription": "진짜 미니 게임이 이제 어떤 면에서 기대가 되는 거냐면은 이제 반복되고 약간 지루하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.214,
                "end": 24.296
            },
            {
                "speaker_id": "1",
                "transcription": "숙제 같다는 그런 얘기가 많잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.306,
                "end": 26.921
            },
            {
                "speaker_id": "1",
                "transcription": "그런 걸 좀 해소시켜 줄 컨텐츠일까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.931,
                "end": 29.853
            },
            {
                "speaker_id": "1",
                "transcription": "자 레전드 아하 하나 자 크림 유니콘 좋고요.",
