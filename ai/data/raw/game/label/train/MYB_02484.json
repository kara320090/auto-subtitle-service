    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 향대가 스킬 써서 쿠키들이 이렇게 생존해서 제가 못 잡는 상황이 나오죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 9.033
            },
            {
                "speaker_id": "1",
                "transcription": "네 요로케 제가 지는 그림이 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.043,
                "end": 13.915
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 요런 경우는 어떤 경우냐 그래서 더더욱 여러분들이 좀 신경 써야 될게 블루파이와 쿠키 공격력 그 나머지 쿠키들의 부 옵션으로 공격력도 여유가 되면 좀 더 챙겨주는 게 좀 중요하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.925,
                "end": 29.089
            },
            {
                "speaker_id": "1",
                "transcription": "물론 여러분이 마스터 구간에서는 잘 먹혀요. 제 부계정도 해보니까 여기 완전 극상에서는 피감이 워낙 잘 돼 있고 단단하기 때문에 안 죽는 변수가 생겨요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.099,
                "end": 41.036
            },
            {
                "speaker_id": "1",
                "transcription": "하지만 제가 해 보니까 그마3부터 여기 밑에는 피 감소가 상대방분들이 완벽하지가 않기 때문에 딜러들 쿠키가 상대적으로 약해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 41.046,
                "end": 50.116
            },
            {
                "speaker_id": "1",
                "transcription": "승률이 매우 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.126,
                "end": 51.940
            },
            {
                "speaker_id": "1",
                "transcription": "어 거의 90퍼센트 이상 80퍼센트 90퍼센트 이상의 승률을 가져가고 상위권에서는 내 이미 이제 막는 세팅이나 좀 더 토핑 좋은 분들은 어 스펙 차이가 나면 막히는 분들이 조금 있어서 승률이 다소 떨어지는 경우도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.950,
                "end": 68.306
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 가장 중요한 점이 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.316,
                "end": 70.483
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱은 깃털 덱한테는 절대 들어가면 안 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.493,
                "end": 74.017
            },
            {
                "speaker_id": "1",
                "transcription": "들어갈 수 있는 덱은 깃털이 없는 덱한테만 들어 갈 수 있다는 점 깃털 있는 덱한테 들어가면 그냥 안 통하고 그냥 지는 경우가 90퍼센트일 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 74.027,
                "end": 84.121
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 반드시 보물 확인을 하고 여러분들 들어가셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 84.131,
                "end": 91.471
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분 본 것 같이 상대 딜러를 잡아내야 돼요. 지금 방금도 달빛소가 터져서 죽어 버렸죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.481,
                "end": 100.233
            }
        ]
    },
    "summary": "여러분이 신경 써야 될게 블루파이와 쿠키 공격력 나머지 쿠키들의 부 옵션으로 공격력도 여유가 되면 챙겨주는 게 중요하고 제가 해 보니까 그마3부터 피 감소가 상대방이 완벽하지 않기 때문에 딜러 쿠키가 상대적으로 약하고 승률이 매우 좋다.",
