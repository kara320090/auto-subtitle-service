        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 상대방은 네 투 힐러네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.703
            },
            {
                "speaker_id": "2",
                "transcription": "없어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.713,
                "end": 4.273
            },
            {
                "speaker_id": "1",
                "transcription": "이거는 이기기 힘들 거 같은데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.283,
                "end": 7.358
            },
            {
                "speaker_id": "1",
                "transcription": "공덱으로 굳이 쓰라는 게 아닙니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.368,
                "end": 10.051
            },
            {
                "speaker_id": "1",
                "transcription": "방덱으로 쓰는데 공덱으로 썼을 때도 어떤지 제가 보여드리는 거기 때문에",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.061,
                "end": 14.918
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들이 뭐 얘를 하나의 공덱으로 완성시키기 위해서 올인한다. 그런 개념보다",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.928,
                "end": 21.621
            },
            {
                "speaker_id": "1",
                "transcription": "한방덱을 막기 위한 용도로 이 세팅은 해보는 게 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.631,
                "end": 25.360
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 알고 계시면 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.370,
                "end": 27.135
            },
            {
                "speaker_id": "3",
                "transcription": "빛이 인도하실 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.145,
                "end": 28.778
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 이거는 약간 여러분들 딜찍누로 이기는 느낌이네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.788,
                "end": 34.100
            }
        ]
    },
    "summary": "남성이 이 덱은 공덱으로 굳이 쓰지 말고 한방덱을 막기 위한 용도로 쓰는 게 좋다고 하며 지금은 딜찍누로 이기는 느낌이라고 합니다.",
