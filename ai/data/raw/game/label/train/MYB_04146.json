        "term": [
            {
                "speaker_id": "1",
                "transcription": "근데 1대 1을 클로티드 이기는 게 있을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.055
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 내가 볼 때 1대 1 최강자 클로티드 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.065,
                "end": 5.930
            },
            {
                "speaker_id": "1",
                "transcription": "얘 이기는 쿠키 있을까요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.940,
                "end": 7.428
            },
            {
                "speaker_id": "1",
                "transcription": "절대 못 이길 거 같은데 어떤 쿠키가 와도.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.438,
                "end": 9.757
            },
            {
                "speaker_id": "1",
                "transcription": "아 우유가 이긴다구요 우유가 한 번 가봅시다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.767,
                "end": 12.589
            },
            {
                "speaker_id": "1",
                "transcription": "얘가 최강자 같은데 뱀파가 이기 아 뱀파가 이기겠다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.599,
                "end": 17.605
            },
            {
                "speaker_id": "1",
                "transcription": "아 뱀파는 이기겠네.",
