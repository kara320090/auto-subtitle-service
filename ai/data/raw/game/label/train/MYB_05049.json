        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 나 그 블랙펄 제도 해서 그런지 이제 약간 용쿠랑 커먼 애들이 옛날처럼 그 쓰레기 느낌이 안 난다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 6.592
            },
            {
                "speaker_id": "1",
                "transcription": "그 슈퍼 커먼을 경험하고 난 이후로는 얘네가 커먼같이 안 보여.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.602,
                "end": 11.334
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 그 슈퍼 커먼 그 약간 아우라 그게 막 그게 느껴져요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.344,
                "end": 15.471
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 워낙 진짜 그 약간 충격적어가지고 적당히 셌어야지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 15.481,
                "end": 21.171
            },
            {
                "speaker_id": "1",
                "transcription": "옛날에 막 대리 뽑기 할 때 보면은 진짜 잘 나올 때는 만 개 가지고 3개 나온 사람도 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.181,
                "end": 26.226
            },
            {
                "speaker_id": "1",
                "transcription": "이런 레전드 쿠키 뽑기 같은 류 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 26.236,
                "end": 28.581
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 막판에 몰아 나오는 경우도 엄청 많았고 심지어 이 뽑기 한 번 눌렀을 때 뭐 카페 같은 데에 돌아다니는 거 보니까 3개도 나온 사람 있더만.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.591,
                "end": 36.557
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 진짜 극악의 확률이지만 진짜 버그급으로 나올 때가 있긴 해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.567,
                "end": 43.266
            }
        ]
    },
    "summary": "블랙펄 제도를 해서인지 몰라도 용기 쿠키랑 커먼 애들이 쓰레기 느낌이 나지 않고 슈퍼 커먼 아우라가 느껴지며 대리 뽑기를 할 때 진짜 잘 나올 때는 레전드 쿠키가 3개 나온 사람도 있다고 한다.",
