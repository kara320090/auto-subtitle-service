        "term": [
            {
                "speaker_id": "1",
                "transcription": "저게 누적되니까 어마무시합니다 무시 못해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 5.577
            },
            {
                "speaker_id": "1",
                "transcription": "저 모노클 시너지 받아서 다시 또 저는 체력 다 쭉 차오르고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.587,
                "end": 12.691
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 식의 그림으로 좀 이기는 그림이 나온다",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.701,
                "end": 16.570
            },
            {
                "speaker_id": "1",
                "transcription": "자 또 다른 그림 보여 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.580,
                "end": 18.872
            },
            {
                "speaker_id": "1",
                "transcription": "상대가 근데 낫 들고 공속덱이나 공속 망토 보물이나 이런 거 있으면은 들어가면 안 될 것 같고 보통 이 덱이 좀 많이 좀 유리하다 싶은 거는 이렇게 클로티드랑 서리 여왕 있는 덱들 있죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.882,
                "end": 32.671
            },
            {
                "speaker_id": "1",
                "transcription": "요런 덱한테는 제 경험상 되게 강했거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.681,
                "end": 37.355
            },
            {
                "speaker_id": "1",
                "transcription": "아니면 투탱에다가 가운데 두 개 가려주고 마지막 이제 목화 있거나",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.365,
                "end": 44.433
            }
        ]
    },
    "summary": "유튜버는 상대가 낫 들거나 공속덱이나 공속 망토 보물 등이 있으면 안 되고 보통 클로티드랑 서리 여왕 있는 덱들이 유리하다고 합니다.",
