        "term": [
            {
                "speaker_id": "1",
                "transcription": "뭐 스타더스트 올 애플젤리로서 써도 됩니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 2.803
            },
            {
                "speaker_id": "2",
                "transcription": "앞서 가겠다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 2.813,
                "end": 3.871
            },
            {
                "speaker_id": "1",
                "transcription": "올 애플젤리 써도 승률 되게 좋게 나옵니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 3.881,
                "end": 6.672
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 선택해서 잘 맞는 거 세팅해서 쓰시면 돼요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 6.682,
                "end": 10.326
            },
            {
                "speaker_id": "1",
                "transcription": "저도 원래 어제 리뷰할 때 애플젤리 썼는데 뭐 승률 자체가 통하는 사람 있고 안 통하는 사람도 있고 각각 나뉘어지기 때문에 캡사이신 한방 덱은 없나요",
                "sound_type": [
                    2,
                    5
                ],
                "start": 10.336,
                "end": 21.212
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 캡사이신을 안 써도 돼요. 왜냐면",
                "sound_type": [
                    2,
                    5
                ],
                "start": 21.222,
                "end": 24.329
            },
            {
                "speaker_id": "1",
                "transcription": "도넛 쿠키랑 밀키웨이가 방깎이나 이런 거 해주는 게 더좋습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.339,
                "end": 29.514
            },
            {
                "speaker_id": "1",
                "transcription": "방깎을 해주고 뒤에 있는 딜러들이 때려주는 게 더 좋아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 29.524,
                "end": 34.202
            },
            {
                "speaker_id": "3",
                "transcription": "달빛이 내 활이 되어주렴",
                "sound_type": [
                    2,
                    5
                ],
                "start": 34.212,
                "end": 37.940
            },
            {
                "speaker_id": "2",
                "transcription": "내가 앞서 가겠다.",
                "sound_type": [
                    2,
                    5
                ],
