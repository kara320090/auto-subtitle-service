        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이 덱은 그냥 투탱 덱에 다 들어가면 될 것 같아요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 0.000,
                "end": 4.014
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 이 일 이 덱도 제가 들어가 봤는데 원탱 덱을 제외하고 네 전부 다 아까 해보니까 다 성능이 좋더라고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 4.024,
                "end": 13.227
            },
            {
                "speaker_id": "1",
                "transcription": "자 보여드리겠습니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 13.237,
                "end": 14.701
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단은 콘셉트 자체가 확실합니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 14.711,
                "end": 17.370
            },
            {
                "speaker_id": "1",
                "transcription": "일단 30초까지 최대한 버티고 버텨서 실론나이트의 독무대가 펼쳐집니다.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 17.380,
                "end": 24.256
            },
            {
                "speaker_id": "1",
                "transcription": "가뜩이나 파르페랑 스냅 드래곤 그리고 락스타 다 힐러들 중에서도 거의 영티어급으로 좋은 애들이라 죽지 않고 다 버텨주죠.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 24.266,
                "end": 35.757
            },
            {
                "speaker_id": "1",
                "transcription": "30초까지 실론나이트가 죽지 않고 버텨주면은 성공이고요.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 35.767,
                "end": 40.629
            },
            {
                "speaker_id": "1",
                "transcription": "30초 이후에 하나씩 다 죽어주면서 실론나이트가 이제 폭주 모드 정말 어 크레이지 모드가 발동되면서 네",
                "sound_type": [
                    2
                ],
                "start": 40.639,
                "end": 51.466
            }
        ]
    },
    "summary": "이 덱은 원탱 덱을 제외하고 전부 다 해봤는데 성능이 좋았고 콘셉트가 확실해서 일단 30초까지 최대한 버티면 실론나이트의 독무대가 펼쳐지기 때문에 영티어급 좋은 애들은 죽지 않고 버티다가 30초 이후에 다 죽으면 실론나이트의 크레이지 모드가 발동된다.",
