        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단 자동 전투 끄고 첫 번째 그다음에 자 요 가르마 요기 상태에서 스킬 쓰는데 여기 가르마 잘 못 맞추겠다 하시는 분들은 요 돌아가는 빛이 왔다 갔다 이렇게 시계 방향으로 돌고 있거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 13.444
            },
            {
                "speaker_id": "1",
                "transcription": "요게 여섯 시 오기 전에 이때 눌러주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.454,
                "end": 17.725
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 하고 자동 누르고 에클레어 눌러주고 보스 출현 뜨면 자동 끄고 다음에 아포가토 늘러주고요. 그 다음에 자동 눌러주면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.735,
                "end": 28.797
            },
            {
                "speaker_id": "1",
                "transcription": "자 자동으로 하고 그 다음에 해야 될 거는 이제 다크초코가 스킬 쓰게 됩니다. 다크 초코가 스킬을 쓰게 되면은 에클레어 자동 걸어주고 이 아포가토가 쿨타임 차는 대로 스킬 한 번 눌러 주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.807,
                "end": 45.191
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어가 스킬 쓰면은 뱀파이어 자동을 걸어주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 45.201,
                "end": 51.394
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 자동 걸고 뱀파이어가 스킬 쓰면 바로 광클 해서 목화 눌러주면 끝이예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 51.404,
                "end": 57.980
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 눌러주면은 토벌 끝입니다. 이렇게 뱀파가 부활해서 한 번 더 스킬 써주고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 57.990,
                "end": 67.000
            }
        ]
    },
    "summary": "이번 전투는 가르마를 못 맞추겠다면 옆의 시계 버튼으로 타이밍을 맞추며 에클레어 다음 보스 뜨면 아포가토 그다음 다크 초코가 스킬 쓰게 하고 에클레어 다음 아포가토로 공격한 뒤 에클레어 그리고 뱀파이어 자동 걸어주면 토벌이 끝나게 된다.",
