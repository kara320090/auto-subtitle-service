        "term": [
            {
                "speaker_id": "1",
                "transcription": "그러면은 이제 이거는 필수로 키워야 되나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.862
            },
            {
                "speaker_id": "1",
                "transcription": "완전 필수로 키워야 되는 거고 1단계부터 모든 9단계까지 이 세팅 하나로 모든 게 다 가능하고 그다음에 토핑 설정도 이번에 패치돼 가지고 되게 편하게 되어있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.872,
                "end": 14.360
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 제가 오픈을 다 해봤습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.370,
                "end": 17.212
            },
            {
                "speaker_id": "1",
                "transcription": "여기서부터 여기까지 3만 7500개인가요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.222,
                "end": 20.316
            },
            {
                "speaker_id": "1",
                "transcription": "다 이렇게 크탈 써서 열었는데 굳이 안 열어도 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.326,
                "end": 23.325
            },
            {
                "speaker_id": "1",
                "transcription": "이 앞에 줄만 해서 세팅해서 저장해 놓으면은 혹시나 뭐 토핑이 다른 데 쓰일지라도 불러 와서 토벌하면 되니까 자 일단 이렇게 대천사 토벌 덱 추천 덱 리뷰는 여기서 마치도록 할게요.",
