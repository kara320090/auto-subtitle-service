    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "심지어 이제 아레나에서도 쓰이고 있거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.222
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나에서는 어떻게 쓰이는지 제가 리뷰를 해보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.232,
                "end": 7.452
            },
            {
                "speaker_id": "1",
                "transcription": "장난으로 예능덱으로 쓰이는 게 아니라 진지하게 이제 쓰이고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.462,
                "end": 12.212
            },
            {
                "speaker_id": "1",
                "transcription": "보물 세팅은 모노클로 했는데 가리는 게 에클레어가 있을 수 있으니까 저렇게 모노틀 들고 가는 거고 와그 같은 경우에는 피해 감소랑 치명타 확률 좀 많이 신경 써 줬습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 12.222,
                "end": 21.994
            },
            {
                "speaker_id": "1",
                "transcription": "와베가 이제 핵 펀치 한 방으로 치명타 터지면 상대가 엄청나게 피해가 크기 때문에 이렇게 세팅해 줬고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.004,
                "end": 27.419
            },
            {
                "speaker_id": "1",
                "transcription": "다크카카오 같은 경우에는 쿨타임 6.3퍼센트 이상 그 다음에 피감 많이 신경 써 줬고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.429,
                "end": 32.320
            },
            {
                "speaker_id": "1",
                "transcription": "이게 제일 중요한 것 같아요 바요 이 덱을 굳이 쓰고 싶으신 분들은 바요 피감 진짜 30퍼센트 중반대는 만들어 주는 게 중요한 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.330,
                "end": 40.334
            },
            {
                "speaker_id": "1",
                "transcription": "아몬드 2개랑 라즈 2개랑 쿨 이렇게 해서 11.8퍼센트 이상 4초 바요 이렇게 해서 세팅을 해주시면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.344,
                "end": 47.877
            },
            {
                "speaker_id": "1",
                "transcription": "그 다음에 버섯멍도 아몬드 껴 가지고 피감 좀 높게 세팅해서 해 주시는 게 좋은 것 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.887,
                "end": 54.423
            },
            {
                "speaker_id": "1",
                "transcription": "굳이 뭐 나는 피감 잘 안 된다 하시면은 라즈 하나 포기해서라도 피감 좀 챙겨서 해 주시면 좋을 것 같고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.433,
                "end": 60.808
            },
            {
                "speaker_id": "1",
                "transcription": "목화는 피감이랑 쿨 높게 세팅해서 써 주면 좋을 것 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.818,
                "end": 66.369
            },
            {
                "speaker_id": "1",
                "transcription": "한번 보여드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.379,
                "end": 68.688
            },
            {
                "speaker_id": "1",
                "transcription": "투탱 요 덱한테 보여드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.698,
                "end": 70.644
            },
            {
                "speaker_id": "1",
                "transcription": "이 독버섯을 굳이 얘를 써야 되나요 라고 말씀해 주실 수 있는데 제가 방덱이 나름 단단하거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.654,
                "end": 77.715
            },
            {
                "speaker_id": "1",
                "transcription": "잘 안 뚫렸습니다 여태까지 근데 야 독버섯한테 뚫리더라고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.725,
                "end": 83.836
            },
            {
                "speaker_id": "1",
                "transcription": "네 그것도 좀 몇 번 연속으로 뚫리다 보니까 네 저도 되게 신기했는데 제 톡방 오픈 톡방에 같이 계신 분이 이거를 쓰는 거 알려주셨어요 어떻게 쓰는지",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.846,
                "end": 102.666
            }
        ]
    },
    "summary": "유튜버는 독버섯이 아레나에서 어떻게 쓰이는지 직접 게임을 해보며 자신은 나름 방덱이 든든한 편인데도 독버섯한테 뚫렸다고 합니다.",
