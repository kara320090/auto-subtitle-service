        "term": [
            {
                "speaker_id": "1",
                "transcription": "두 번째 레전드가 나왔네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.426
            },
            {
                "speaker_id": "1",
                "transcription": "자 피, 쿨 아주 상큼한 어 연속으로 아주 좋게 나오고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.486,
                "end": 9.633
            },
            {
                "speaker_id": "1",
                "transcription": "저 정도면은 실전에서 바로 쓸 수 있는 레잔드 토핑.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.720,
                "end": 15.746
            },
            {
                "speaker_id": "1",
                "transcription": "자 피감 오 잘 나오고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 15.761,
                "end": 19.460
            },
            {
                "speaker_id": "1",
                "transcription": "어 야 왜 웬일이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
