    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이게 과금을 정말 제가 패키지 다 샀거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.866
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 4단계, 5단계가 끝이에요 한 주에.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.876,
                "end": 7.717
            },
            {
                "speaker_id": "1",
                "transcription": "앞으로 과금을 한 3주 더 해야돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 7.727,
                "end": 10.278
            },
            {
                "speaker_id": "1",
                "transcription": "엄두도 안 납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.288,
                "end": 11.553
            },
            {
                "speaker_id": "1",
                "transcription": "거의 한 200만 원 들어가요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.562,
                "end": 13.153
            },
            {
                "speaker_id": "1",
                "transcription": "와 아까 채팅창 봤는데 무과금이 만드려면은 30강까지 7개월 걸린다고 했나요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.153,
                "end": 17.875
            },
            {
                "speaker_id": "1",
                "transcription": "제가 결론적으로 말씀드리자면은 블랙펄은 강화하는 게 맞는 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.885,
                "end": 23.146
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 이 피감 무시가 정말 사기인 거 같습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.146,
                "end": 26.321
            },
            {
                "speaker_id": "1",
                "transcription": "이 리더 효과가 점점 스톤 레벨을 올리면은 피감 무시 수치가 점점 올라가거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.331,
                "end": 32.344
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 여러분들 이 전설 영혼 조각도 점점 더 많이 부족해지고 결정도 많이 들어가고 실패도 하는 경우 때문에 아무래도 제 개인적인 생각은 더 준비를 많이 하셔야 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.354,
                "end": 44.080
            },
            {
                "speaker_id": "1",
                "transcription": "저거 수급처가 길드 토벌전에서 메달 교환소에서 이거 구입하는 거 또는 해상 무역 센터에서 이거 교환 저도 이제 사야 될 거 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.080,
                "end": 53.322
            },
            {
                "speaker_id": "1",
                "transcription": "이게 모자를 수도 있어서 아레나에서 메달 상점에서 여기서 구매하는 거 각각 이 세 군데에서 구매를 해야되지 않나.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.332,
                "end": 61.523
            },
            {
                "speaker_id": "1",
                "transcription": "여기서 구매하는 거는 조금 저는 너무 아깝다 생각 들고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 61.533,
                "end": 65.660
            },
            {
                "speaker_id": "1",
                "transcription": "잼스톤 22강 리뷰는 여기서 마치도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 65.670,
                "end": 73.133
            }
        ]
    },
    "summary": "패키지를 다 샀지만 한 주에 4단계, 5단계가 끝이라 200만 원이 들어가며 결론적으로 스톤 레벨을 올리면 피감 무시 수치가 점점 올라가기에 블랙펄을 강화하는 게 맞고 전설 영혼 조각과 결정이 계속 필요하기 때문에 모자를 수도 있어서 준비를 더 많이 해야될 거 같다.",
