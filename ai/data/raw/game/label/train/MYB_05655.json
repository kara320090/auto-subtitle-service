        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 일단은 121단계 이렇게 와 봤는데 체력이 5억 5000입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.488
            },
            {
                "speaker_id": "1",
                "transcription": "반사 피해 요거 스킬이나 이런 거는 다 동일해요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.498,
                "end": 7.085
            },
            {
                "speaker_id": "1",
                "transcription": "한번 제가 실전에서 보여 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.095,
                "end": 10.965
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 빌드는 감초 덱 써서 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 10.975,
                "end": 14.057
            },
            {
                "speaker_id": "1",
                "transcription": "자 121단계 자 감초, 에클",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.067,
                "end": 18.760
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 토벌 빌드는 제 유튜브에 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.770,
                "end": 21.948
            },
            {
                "speaker_id": "1",
                "transcription": "자 자동 껐다가 다시 깎고 있다가 자동",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.958,
                "end": 26.019
            },
            {
                "speaker_id": "1",
                "transcription": "자 중요한 게 아까 말씀 드렸던 방깎 있죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 26.029,
                "end": 28.917
            },
            {
                "speaker_id": "1",
                "transcription": "제 다크 초코가 방깎을 걸었어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 28.927,
                "end": 31.540
            },
            {
                "speaker_id": "1",
                "transcription": "그건 보이나요? 요 3 표시 보이죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 31.550,
                "end": 33.859
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 딱총 보물이 발동하면 방깎 하나 더 추가되죠?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 33.869,
                "end": 37.259
            },
            {
                "speaker_id": "1",
                "transcription": "용 밑에 프로필 밑에 요거 보면은 방깎이 몇 개 들어가는지 여러분들이 실시간으로 확인할 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 37.269,
                "end": 44.210
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 용이 지금 때리는 이 휘두르는 공격력은 공격력 6억이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.220,
                "end": 49.626
            },
            {
                "speaker_id": "1",
                "transcription": "스치면 죽습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 49.636,
                "end": 50.988
            },
            {
                "speaker_id": "1",
                "transcription": "근데 어떻게 이렇게 안 죽나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 50.998,
                "end": 52.756
            },
            {
                "speaker_id": "1",
                "transcription": "초보자 분들은 어떻게 왜 안 죽나 생각할 수 있지만 이 용이 이 할퀴기나 이 때리는 요런 것들은 3인 공격이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.766,
                "end": 60.621
            },
            {
                "speaker_id": "1",
                "transcription": "그러기 때문에 감초 3마리 쫄이 그 6억 딜을 다 막아 주는 겁니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.631,
                "end": 64.348
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 쫄의 중요성을 왜 목화맛 쿠키나 네 감초맛 쿠키가 토벌에서 쓰는지 그 이유가 그 6억 딜 그 딜량을 막아 주는 용도다 그렇게 아시면 되고.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.358,
                "end": 77.517
            },
            {
                "speaker_id": "1",
                "transcription": "그 안 맞으면은 쿠키가 그냥 즉사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.527,
                "end": 80.772
            },
            {
                "speaker_id": "1",
                "transcription": "네 즉사해 버려요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.782,
                "end": 83.366
            },
            {
                "speaker_id": "1",
                "transcription": "그러고 얘네 쫄도 휘두르는 딜이 엄청납니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.376,
                "end": 86.126
            },
            {
                "speaker_id": "1",
                "transcription": "그냥 스치면 죽어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 86.136,
                "end": 92.233
            }
        ]
    },
    "summary": "화자는 121단계를 감초 덱 빌드를 써서 시작하고 화자의 다크 초코가 방깎을 걸었고 용 프로필 밑에 방깎이 몇 개 들어가는지 실시간으로 확인 가능하고 감초 3마리 쫄이 용이 휘두르는 6억 딜을 막아 주고 휘두르는 힘도 세서 꼭 필요하다.",
