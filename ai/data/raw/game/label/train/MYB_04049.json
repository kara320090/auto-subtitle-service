        "term": [
            {
                "speaker_id": "1",
                "transcription": "음유시인도 약간 되게 안 나오는 편이긴 하네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.053
            },
            {
                "speaker_id": "1",
                "transcription": "자 이제 그냥 크탈 뽑기로 갈게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.063,
                "end": 7.283
            },
            {
                "speaker_id": "1",
                "transcription": "5초월까지 음유시인 찍자",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.293,
                "end": 9.221
            },
            {
                "speaker_id": "1",
                "transcription": "나오던 안 나오던 근데 보통 업데이트 되고 나서 지금 1시간이 지났거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.231,
                "end": 18.459
            },
            {
                "speaker_id": "1",
                "transcription": "이쯤 되면은 뭐 카톡 방이라던지 다른 데서 채팅 창이 이거 사기적이면 미쳤습니다 뭐 사기입니다 0티어입니다 이런 얘기가 올라오는데",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.469,
                "end": 28.497
            },
            {
                "speaker_id": "1",
                "transcription": "조용한 거 보니까 이거 느낌이 싸하다 여러분들",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.507,
                "end": 32.165
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 5초월까지 쭉 달릴 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.175,
                "end": 41.750
            },
            {
                "speaker_id": "1",
                "transcription": "아 여러분도 이렇게 잘 안 나옵니까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 41.760,
                "end": 50.300
            },
            {
                "speaker_id": "1",
                "transcription": "저만 안 나오는 거 아니죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.310,
                "end": 51.815
            },
            {
                "speaker_id": "1",
                "transcription": "아 아 너 말고 서리여왕아",
                "sound_type": [
                    2,
                    3
