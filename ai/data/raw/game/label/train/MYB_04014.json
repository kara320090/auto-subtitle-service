        "term": [
            {
                "speaker_id": "1",
                "transcription": "숲에 이상한 기운이 감돈다 했더니 네 녀석이 숲을 얼어붙게 만들 있었군",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.615
            },
            {
                "speaker_id": "1",
                "transcription": "생명의 활 시위로 처단하리라",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.625,
                "end": 9.220
            },
            {
                "speaker_id": "2",
                "transcription": "그런 게 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.230,
                "end": 11.288
            },
            {
                "speaker_id": "2",
                "transcription": "전 소르베 맛 쿠키에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.298,
                "end": 13.988
            },
            {
                "speaker_id": "2",
                "transcription": "천년나무 쿠키님을 만나러 왔는데 갑자기 숲에 불이났어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.998,
                "end": 19.312
            },
            {
                "speaker_id": "2",
                "transcription": "불을 끄려고 급하게 힘을 쓰다보니 이렇게 됐지만 숲을 얼리려던 건 절대 아니에요.",
                "sound_type": [
                    2,
