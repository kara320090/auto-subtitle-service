        "term": [
            {
                "speaker_id": "1",
                "transcription": "여기에도 뭐 약간 그러 카드 같은 게 어디 있나 본데?",
                "sound_type": [
                    2
                ],
                "start": 0.000,
                "end": 9.887
            },
            {
                "speaker_id": "1",
                "transcription": "일로 와 봐 일로 와 봐 아 유리 안 부셔도 되네 들어갈 수 있네",
                "sound_type": [
                    2,
                    5
                ],
                "start": 9.897,
                "end": 20.976
            },
            {
                "speaker_id": "1",
                "transcription": "아우씨 깜짝이야 아 이걸 누르는 거구나 아 확인 아 이제 알았어",
                "sound_type": [
                    2,
                    5
                ],
                "start": 20.986,
                "end": 27.809
            },
            {
                "speaker_id": "1",
                "transcription": "드론 가지고 저 눌르면서 가는 거구나",
                "sound_type": [
                    2
                ],
                "start": 27.819,
                "end": 30.103
            },
            {
                "speaker_id": "1",
                "transcription": "야 이 약간 다운시키는 거 어떻게 하지?",
                "sound_type": [
                    2,
                    5
                ],
                "start": 30.113,
                "end": 33.475
            },
            {
                "speaker_id": "2",
                "transcription": "안녕히 계세요 여러분.",
