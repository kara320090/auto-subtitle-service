                    3,
                    5
                ],
                "start": 8.408,
                "end": 19.321
            },
            {
                "speaker_id": "1",
                "transcription": "저 자리에 락스타가 낫지 않나 원래 락스타가 더 좋은데 지금 리뷰 자체가 박하사탕 리뷰라서 억지로 넣고 있습니다.",
