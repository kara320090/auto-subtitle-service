        "term": [
            {
                "speaker_id": "1",
                "transcription": "그래가가지고 거기 보면 바다 있죠? 그게 바다요정이구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.765
            },
            {
                "speaker_id": "2",
                "transcription": "아 왼쪽에 퓨바랑 홀베는 아 네 대체",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.775,
                "end": 7.342
            },
            {
                "speaker_id": "1",
                "transcription": "서리 저거는 빼기 귀찮아서",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.352,
                "end": 9.676
            },
            {
                "speaker_id": "2",
                "transcription": "아 네 이거 다크카카오 대체",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.686,
                "end": 11.873
            },
            {
                "speaker_id": "1",
                "transcription": "오이스터도 적어놨구요. 퓨어 같은 경우는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.883,
                "end": 14.057
            },
            {
                "speaker_id": "2",
                "transcription": "오이 그리고 이 십칠 번 이거는 열일곱 번째 지금 계정 맡긴거죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.067,
                "end": 18.625
            },
            {
                "speaker_id": "1",
                "transcription": "이번이 열일곱 번째 대리 뽑기가 되겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.635,
                "end": 21.395
            },
            {
                "speaker_id": "2",
                "transcription": "알겠습니다. 자 일단 오늘 뽑기 포인트가 뭔가요? 어떤 거를 원하시죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.405,
                "end": 27.400
            }
        ]
    },
    "summary": "필드에 바다는 바다요정을 나타내며 다크카카오도 대체되어 있고 오이스터와 퓨어도 있으며 열일곱 번째는 대리뽑기가 열일곱 번째라는 의미이다.",
