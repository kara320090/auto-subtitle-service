        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 이번 판은 지는 그림이 나올 거 같네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.252
            },
            {
                "speaker_id": "1",
                "transcription": "아까랑 좀 다르게 아까 이분이랑 해서는 어 아까 뭐 기적의 승리가 나왔는데 이번 판은 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.262,
                "end": 14.437
            },
            {
                "speaker_id": "1",
                "transcription": "캡틴 캐비어랑 이 덱한테 조금 약한 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.437,
                "end": 17.119
            },
            {
                "speaker_id": "1",
                "transcription": "찰스 있는 캡틴 캐비어 덱한테 이건 좀 약한 모습을 보이는 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 17.129,
                "end": 22.112
            },
            {
                "speaker_id": "1",
                "transcription": "블랙펄이 죽지 않으면은 좋은데 저 덱한데는 좀 취약한 거 같습니다.",
                "sound_type": [
