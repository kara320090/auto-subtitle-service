            },
            {
                "speaker_id": "2",
                "transcription": "식사가 끝나면 마법 연구소로 가볼까?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.058,
                "end": 7.287
            },
            {
                "speaker_id": "2",
                "transcription": "에스프레소맛 쿠키를 만나 연구가 어떻게 진행되고 있는지 알아보자.",
                "sound_type": [
