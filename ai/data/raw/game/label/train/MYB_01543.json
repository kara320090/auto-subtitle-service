        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 이거 이기나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.603
            },
            {
                "speaker_id": "1",
                "transcription": "어 잠깐만 이거 이기는 그림인가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.613,
                "end": 6.015
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 아마 질 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.025,
                "end": 9.299
            },
            {
                "speaker_id": "1",
                "transcription": "네 요런 식으로 앞에 캡사이신이 보이면은 들어가지 말아라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.309,
                "end": 14.405
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 이렇게 가려진 덱도 많은데 2, 2, 1 덱은 제가 들어가는 건 웬만해서는 비춥니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.415,
                "end": 20.019
            },
            {
                "speaker_id": "1",
                "transcription": "자 마라텍 음 보통은 앞의 홀리베리, 용과 뒤에는 저 스타더스트랑 닻빛 덱이 많을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.029,
                "end": 30.159
            },
            {
                "speaker_id": "1",
                "transcription": "네 제가 해보니까 승률은 뭐 뒤에 달빛, 스타더스트 덱일 때는 뭐 상위권에서도 나쁘지 않은 승률이 나오긴 해요 한 60퍼센트 70퍼센트 승를 1분 전까지 소르베가 죽지만 않는다면 어느 정도 승률은 잘 나오는 거 같아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 30.169,
                "end": 46.944
            },
            {
                "speaker_id": "1",
                "transcription": "네 그래서 뭐 나쁘지 않다고 보는데 어 여러분들한테는 웬만해서는 아까 말씀드린 대로 2, 1, 2 덱한테만 들어가라 네 요런 식으로 2, 2, 1 덱이 아니라 2, 2, 1 덱이라도 그래도 뭐 승률은 어느 정도 괜찮게 나온다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 46.954,
                "end": 64.126
            },
            {
                "speaker_id": "1",
                "transcription": "제가 방덱으로 일부러 밤 사이에 일단 해놓고 자 봤어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 64.136,
                "end": 68.538
            },
            {
                "speaker_id": "1",
                "transcription": "어느 덱한테 약하고 어느 덱한테 강한지 방덱 승률도 나름 괜찮았고 은근히 많을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 68.548,
                "end": 75.263
            },
            {
                "speaker_id": "1",
                "transcription": "자 다시 한 번 또 2, 1, 2 덱한테 가보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 75.273,
                "end": 79.002
            },
            {
                "speaker_id": "1",
                "transcription": "2, 1, 2 덱한테는 거의 지는 경우가 없다고 합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.012,
                "end": 83.580
            },
            {
                "speaker_id": "1",
                "transcription": "스펙에 상관없이 네 웬만해서는 다 이기는 경우가 나오고 네 압도적인 승리가 되는 게 대부분의 흐름으로 나오기 때문에 네",
                "sound_type": [
                    2,
                    3
                ],
                "start": 83.590,
                "end": 98.333
            }
        ]
    },
    "summary": "2, 1, 2 덱에서는 스펙에 상관없이 웬만해서는 다 이기는 경우가 나오고 압도적인 승리가 되는 게 대부분의 흐름이다.",
