        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "대장간이 중요해졌네 대장간 보시면 재고가 순식간에 밑바닥을 치네요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 6.388
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 자 그다음에 보상을 다 받고 아이스크림 트럭 하나 더 주는데",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.388,
                "end": 13.124
            },
            {
                "speaker_id": "1",
                "transcription": "저거 뭐야?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.124,
                "end": 14.665
            },
            {
                "speaker_id": "1",
                "transcription": "야 뭐야? 생산이 더블?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.675,
                "end": 16.900
            },
            {
                "speaker_id": "1",
                "transcription": "아 이거 또 주는 거구나?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.910,
                "end": 18.322
            },
            {
                "speaker_id": "1",
                "transcription": "야 이거 빨리 하세요. 더블 생산이야. 이거 빨리 미션 클리어 해가지고 2개 만드세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.332,
                "end": 22.964
            },
            {
                "speaker_id": "1",
                "transcription": "야 나는 이거 그냥 다른 건물인 줄 데코인 줄 알았는데 생산 건물을 주는 거구나?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.964,
                "end": 27.324
            },
            {
                "speaker_id": "1",
                "transcription": "빨리 2개 만드세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 27.334,
                "end": 29.314
            },
            {
                "speaker_id": "1",
                "transcription": "5만점 채워가지고 2개로 생산하는 게 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.324,
                "end": 32.484
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 유리하겠죠? 야 5만 점까지는 여러분들 노빠꾸로 쭉 달리세요 그냥.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.491,
                "end": 36.808
            },
            {
                "speaker_id": "1",
                "transcription": "와 이거 중요한 포인트네 저거 일단 달려서 2배력 해서 반드시 해야 됩니다 이거 포인트.",
                "sound_type": [
