        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 업데이트 이후에 쿠키 티어가 상당히 많이 바뀌었습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.300
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신맛 쿠키 티어가 좀 내려갔고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.310,
                "end": 6.221
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 마법 사탕이 출시된 라떼맛 쿠키, 마들렌맛 쿠키 티어가 엄청나게 많이 올랐습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.231,
                "end": 13.237
            },
            {
                "speaker_id": "1",
                "transcription": "자 이번 영상에서는 어떤 쿠키를 키워야 될지 방향성에 대해서 제가 알려드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 13.247,
                "end": 18.996
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 아레나를 기준으로 말씀을 드릴게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.006,
                "end": 21.692
            },
            {
                "speaker_id": "1",
                "transcription": "현재 대유행 중인 이 공속덱이 엄청나게 0티어로 올라와서 여러분들이 마들렌맛 쿠키랑 퀸아망 쿠키를 키우면 아레나에서 상당히 좋게 쓸 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.702,
                "end": 32.508
            },
            {
                "speaker_id": "1",
                "transcription": "현재 랭커 분들 대부분 다 고속덱을 필수로 다 사용하고 있는 상황입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.518,
                "end": 36.740
            },
            {
                "speaker_id": "1",
                "transcription": "방어덱을 보게 되면은 현재 어떤 덱이 유행한지 어떤 덱이 좋은지 트렌드를 알 수 있는데 다시 이렇게 한방덱이 부활했습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.750,
                "end": 44.952
            },
            {
                "speaker_id": "1",
                "transcription": "자 마들렌 공속덱을 뚫을 수 있는 요 한방덱이 다시 나왔구요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 44.962,
                "end": 49.322
            },
            {
                "speaker_id": "1",
                "transcription": "그다음에 블루파이 한방덱도 현재 여전히 활약 중입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 49.332,
                "end": 53.860
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 이제 와일드베리랑 홀리베리를 같이 쓰는 덱으로 이제 공속덱을 뚫는 조합도 나왔고 당연히 공속덱도 공덱으로 많이 사용되고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.870,
                "end": 63.377
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 캡사이신덱 같은 경우에도 이제 잘 쓰는 분도 있지만 대부분 캡사이신덱은 티어가 좀 떨어졌어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 63.387,
                "end": 70.717
            },
            {
                "speaker_id": "1",
                "transcription": "승률이 많이 낮아졌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 70.727,
                "end": 72.674
            },
            {
                "speaker_id": "1",
                "transcription": "자 웨어울프덱도 상당히 좀 티어가 기존보다는 좀 떨어졌다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 72.684,
                "end": 77.143
            },
            {
                "speaker_id": "1",
                "transcription": "자 그래서 뭘 키워야 되냐?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 77.153,
                "end": 78.702
            },
            {
                "speaker_id": "1",
                "transcription": "자 현재 캡사이신은 승급이 아주 높아도 활용이 잘 되지 못하고 있는 상황입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 78.712,
                "end": 84.273
            },
            {
                "speaker_id": "1",
                "transcription": "지금 제일 메인으로 쓰고 있는 게 공속덱을 많이 쓰고 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 84.283,
                "end": 88.680
            },
            {
                "speaker_id": "1",
                "transcription": "자 아레나를 좋아하시는 분들은 마들렌맛 쿠키를 무조건 키워야 될 것 같구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 88.690,
                "end": 93.159
            },
            {
                "speaker_id": "1",
                "transcription": "마법 사탕은 10강 이상 찍어주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 93.169,
                "end": 96.094
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 퀸아망맛 쿠키도 여러분들 필수로 키워주셔야 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 96.104,
                "end": 100.512
            },
            {
                "speaker_id": "1",
                "transcription": "승급을 굳이 높여줘야 되나요라고 질문 하시는 분들 마들렌 쿠키보다 퀸아망 쿠키가 공격력을 높게 세팅해야 얘가 스타더스트 별의 표식을 먼저 맞아주기 때문에 그 세팅이 좀 중요하거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 100.522,
                "end": 113.831
            },
            {
                "speaker_id": "1",
                "transcription": "승급을 높여주는 게 유리하다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 113.841,
                "end": 115.968
            },
            {
                "speaker_id": "1",
                "transcription": "일단 그래서 먼저 말씀드린 마들렌하고 퀸아망은 현재 아레나 공속덱의 메인이기 때문에 반드시 좀 키워주는 게 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 115.978,
                "end": 124.144
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 캡사이신에 대해서 좀 이제 좀 중요하게 말씀드리고 싶은 게 캡사이신은 지금 필수가 아닌 게 됐어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 124.154,
                "end": 130.360
            },
            {
                "speaker_id": "1",
                "transcription": "방어덱에 해 놔도 어차피 공속덱에 뚫리고 공격덱으로 쓰기에도 약간 포지션이 애매해져서 당장은 필요한 게 아닙니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 130.370,
                "end": 137.886
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 캡사이신 안 키워도 되겠네라고 생각할 수도 있는데 중요한 건 이벤트에서 이번에 캡사이신맛 쿠키 그래도 보상을 받을 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 137.896,
                "end": 147.617
            },
            {
                "speaker_id": "1",
                "transcription": "이거 보면은 요게 관련된 보상을 얻을 수 있고 여러분들이 되게 보상을 좋은 걸 많이 얻을 수가 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 147.627,
                "end": 153.838
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신은 승급을 지금 기회에 많이 올려주는 게 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 153.848,
                "end": 158.111
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐 다음 업데이트가 용과 드래곤이라는 얘기가 돌고 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 158.121,
                "end": 162.230
            },
            {
                "speaker_id": "1",
                "transcription": "유출된 내용에 따르면 용과 드래곤 쿠키가 나온다는 얘기가 있는데 그게 중요한 이유는 재도 불속성일 가능성이 크거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 162.240,
                "end": 170.157
            },
            {
                "speaker_id": "1",
                "transcription": "불과 관련된 쿠키라 나중에 용과 드래곤이랑 캡사이신이랑 같이 불속성 덱으로 또 다시 부활할 수가 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 170.167,
                "end": 178.769
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신은 이번 시즌에는 승급을 올리는 좀 키워놓는 용도로만 여러분들 열심히 파밍을 하시면 될 것 같애요 이벤트로.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 178.779,
                "end": 186.766
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 열심히 하면은 주사위 이벤트 많이 할 수 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 186.776,
                "end": 190.170
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 승급을 많이 올려놓자.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 190.180,
                "end": 191.844
            },
            {
                "speaker_id": "1",
                "transcription": "자 티어는 낮지만 어 충분히 다음 업데이트에 용과 드래곤 업데이트로 좋은 활약을 할 수 있는 여지가 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 191.854,
                "end": 198.253
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키의 티어는 낮아졌지만 키워는 놔야 된다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 198.263,
                "end": 201.043
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 나머지 쿠키들 중에 좀 키워야 될 것 자 다크 카카오는 지금 현재 쓰이지 않습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 201.053,
                "end": 206.286
            },
            {
                "speaker_id": "1",
                "transcription": "키울 필요 없고 홀리베리, 퓨바는 당연히 절대적인 0티어입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 206.296,
                "end": 210.255
            },
            {
                "speaker_id": "1",
                "transcription": "필수로 쓰이기 때문에 반드시 키워야 놔야 되고 자 그리고 달빛술사 같은 경우에는 공격덱에 필수로 들어가기 때문에 반드시 키우세요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 210.265,
                "end": 217.988
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 바다요정 뭐 상향된다는 얘기가 있었지만 유출은 사실이 아니었던 걸로 자 서리는 이제 불파한방덱에 쓰이고 스타더스트 같은 경우에는 뭐 여러 덱에 잘 쓰이기 때문에 있으시는 분들은 계속 키워주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 217.998,
                "end": 231.138
            },
            {
                "speaker_id": "1",
                "transcription": "자 소르베 쿠키는 빙결덱으로 쓰는 분도 있지만 상당히 좀 티어가 전 보다도 더 떨어질 것 같구요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 231.148,
                "end": 237.542
            },
            {
                "speaker_id": "1",
                "transcription": "자 라떼 쿠키는 제가 업로드가 영상을 보시면은 활용 방법이 있습니다 아레나에서.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 237.552,
                "end": 243.170
            },
            {
                "speaker_id": "1",
                "transcription": "좀 활용되지는 않지만 쓰임새 있게 쓰는 분도 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 243.180,
                "end": 247.110
            },
            {
                "speaker_id": "1",
                "transcription": "자 마라맛 쿠키 같은 경우에는 이벤트용으로 이번에 쓰이고 있거든요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 247.120,
                "end": 251.414
            },
            {
                "speaker_id": "1",
                "transcription": "캡사이신맛, 마라맛 쿠키 사탕골렘 이벤트에서 쓰이고 있어서 그래도 마법 사탕 10강 이상은 찍어주는 게 좋다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 251.424,
                "end": 258.719
            },
            {
                "speaker_id": "1",
                "transcription": "자 그다음 마들렌은 현재 0티어라 필수로 키워야 된다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 258.729,
                "end": 261.641
            },
            {
                "speaker_id": "1",
                "transcription": "자 그 외에 토벌에 쓰이거나 아레나에서 특정 덱에 쓰이는 쿠키들이 있는데 그거는 영상 보고 골라서 키워주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 261.651,
                "end": 271.866
            }
        ]
    },
    "summary": "업데이트 이후에 쿠키 티어가 바뀌었는데 캡사이신맛 쿠키 티어가 내려갔고 라떼맛 쿠키, 마들렌맛 쿠키 티어가 많이 올랐고 마들렌맛 쿠키랑 퀸아망 쿠키를 키워야 하고 용과 드래곤 얘기가 돌고 있기 때문에 캡사이신 쿠키도 키워야 할 것이다.",
