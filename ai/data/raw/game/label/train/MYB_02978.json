        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 다 받았죠.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 0.919
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 바로 강화까지 보여드릴게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.933,
                "end": 2.866
            },
            {
                "speaker_id": "1",
                "transcription": "그래 블루파이 모션 먼저 보고 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.926,
                "end": 4.806
            },
            {
                "speaker_id": "2",
                "transcription": "마도서를 만졌다가는",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.860,
                "end": 6.620
            },
            {
                "speaker_id": "1",
                "transcription": "요고 보고 싶어서 기다린 분도 있으니까.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.620,
                "end": 19.220
            },
            {
                "speaker_id": "1",
                "transcription": "요렇게 나옵니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 19.235,
                "end": 20.733
            },
            {
                "speaker_id": "1",
                "transcription": "블루파이맛 쿠키는 가잣 제발 잘 떠야 돼.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.786,
                "end": 24.066
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들이 여기서 옵션 중에 중요하게 볼 건 피해 감소랑 쿨입니다 이 2개가 잘 나오면 성공이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.140,
                "end": 30.360
            },
            {
                "speaker_id": "1",
                "transcription": "자 첫 번째 거 12강까지 바로 가요.",
