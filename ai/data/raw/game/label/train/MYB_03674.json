        "term": [
            {
                "speaker_id": "1",
                "transcription": "마지막에 터지는 건 그냥 여러분들 어쩔 수 없으니까 뭐 다 사는 경우도 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.763
            },
            {
                "speaker_id": "1",
                "transcription": "또 운이기 때문에 터져서 문제가 되는 건 아닙니다.",
                "sound_type": [
                    2
                ],
                "start": 4.773,
                "end": 7.949
            },
            {
                "speaker_id": "1",
                "transcription": "야 호밀이 3100만이나 났네.",
                "sound_type": [
                    2,
                    5
                ],
                "start": 7.959,
                "end": 10.490
            },
            {
                "speaker_id": "1",
                "transcription": "지금 빌드가 세세하게 막 다 아직 막 바뀌고 있고 그러긴 한데 제가 볼 때는 가장 이게 쉽습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.500,
                "end": 16.941
            },
            {
                "speaker_id": "1",
                "transcription": "가장 높은 딜이 나오는 빌드 중에서 가장 그나마 쉽게 좀 만든 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.951,
                "end": 22.115
            },
            {
                "speaker_id": "1",
                "transcription": "물론 이거보다 딜이 덜 나오면서 쉽게 만든 버전도 있지만 좀 스펙이 낮더라도 천사 토벌 좀 더 딜 높게 세팅하고자 하시는 분들은 요거 한번 따라서 해보시면 좋을 거 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 22.125,
                "end": 34.830
            },
            {
                "speaker_id": "1",
                "transcription": "좀 더 좋은 빌드가 나오면은 그때 또다시 제가 또 찍어 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 34.840,
                "end": 52.291
            }
        ]
    },
    "summary": "화자가 천사 토벌 빌드에서 가장 높은 딜이 나오고 그나마 쉽게 만든 거라고 하면서 좀 더 좋은 빌드가 나오면 그때 또다시 찍어 본다고 한다.",
