                "end": 4.558
            },
            {
                "speaker_id": "1",
                "transcription": "이게 4라즈 1쿨이 맞추기 빡세",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.568,
                "end": 7.615
            },
            {
                "speaker_id": "1",
                "transcription": "아 이런 식으로 되네?",
