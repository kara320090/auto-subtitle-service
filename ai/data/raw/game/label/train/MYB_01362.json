    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "복귀한 지는 얼마나 됐어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.626
            },
            {
                "speaker_id": "1",
                "transcription": "복귀한 지는 좀 그래도 8일 차네 근데 왜 용과 드래곤이 왜 있어?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.636,
                "end": 6.318
            },
            {
                "speaker_id": "1",
                "transcription": "근데 뽑은 지 얼마 안 됐구나.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.328,
                "end": 8.170
            },
            {
                "speaker_id": "1",
                "transcription": "어그로는 아니야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.180,
                "end": 9.620
            },
            {
                "speaker_id": "1",
                "transcription": "이게 보면은 2021년 3월 25일까지 딱 돼 있고 이게 만약에 쭉 했으면은 이게 더 거기에 찍혀야 되는데 딱 여기서 끊겼어 진짜 여기서 접은 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.648,
                "end": 20.260
            },
            {
                "speaker_id": "1",
                "transcription": "780일 만에 복귀해서 진짜 한 거야.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.260,
                "end": 22.628
            },
            {
                "speaker_id": "1",
                "transcription": "7월 달에 복구해서 한 거 맞아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.638,
                "end": 25.111
            },
            {
                "speaker_id": "1",
                "transcription": "근데 운 좋게 기가 막히게 용과 드래곤을 뽑은 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.121,
                "end": 29.020
            },
            {
                "speaker_id": "1",
                "transcription": "일단 쿠키성은 야 애기애기 하다 6레벨.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.040,
                "end": 33.120
            },
            {
                "speaker_id": "1",
                "transcription": "쿠키 하우스 리벨은 3레벨 자 일단은 제가 방향은 제시해 드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.140,
                "end": 39.758
            },
            {
                "speaker_id": "1",
                "transcription": "지금은 옛날과 다르게 옛날 초창기 때 할 때는 쿠키성 막 존버 레벨이 있었어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 39.768,
                "end": 45.898
            },
            {
                "speaker_id": "1",
                "transcription": "막 6레벨에서 생산 최대한 많이 하고 버티고 코인 모아서 8레벨 가라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 45.908,
                "end": 52.564
            },
            {
                "speaker_id": "1",
                "transcription": "8레벨에서 존버해라.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.574,
                "end": 54.098
            },
            {
                "speaker_id": "1",
                "transcription": "10레벨에 존버해라.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.108,
                "end": 55.610
            },
            {
                "speaker_id": "1",
                "transcription": "희한한 테크 단계가 있었는데 옛날에는",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 55.620,
                "end": 58.666
            }
        ]
    },
    "summary": "780일 만에 복귀한 사람이 운 좋게 용과 드래곤을 뽑았고 옛날 초창기 땐 희한한 쿠키성 존버 레벨이 있었지만 방향을 제시하고자 한다.",
