    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "20대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 또는 태엽 장치도 여러분들 모을 수가 있는 기회입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.943
            },
            {
                "speaker_id": "1",
                "transcription": "아 @이름1님 그러면 대무역 시대 이벤트를 좀 덜 하고 다음 길드 무역을 누리라는 건가요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.953,
                "end": 9.644
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 여러분들 이걸 아셔야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 9.654,
                "end": 11.505
            },
            {
                "speaker_id": "1",
                "transcription": "대무역 시대랑 길드 무역 이벤트는 주기가 어떻게 되냐면 자 대무역 시대가 끝나고 40일에서 50일이 지나면 길드 무역을 합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.515,
                "end": 20.676
            },
            {
                "speaker_id": "1",
                "transcription": "그러고 나서 길드 무역이 끝나고 다시 40일에서 50일 지나면 대무역 시대가 열리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 20.686,
                "end": 25.826
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 반복되는 이벤트인데 여러분들이 재고를 대무역 시대에다가 올인하게 되면 나중에 엄청나게 후회할 수가 있어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 25.836,
                "end": 33.882
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 33.892,
                "end": 34.571
            },
            {
                "speaker_id": "1",
                "transcription": "자 무과금 유저분들 아니 과금러들은 도대체 어떻게 이겨요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.581,
                "end": 38.735
            },
            {
                "speaker_id": "1",
                "transcription": "이런 질문 항상 많이 받는데 자 토핑 조각 무과금으로도 3만 개 4만 개 벌 수 있는 유일한 콘텐츠가 길드 무역 콘텐츠입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.745,
                "end": 48.048
            },
            {
                "speaker_id": "1",
                "transcription": "자 실제로 길드 무역 콘텐츠에서는 여러분들이 이런 재고들을 전부 다 토핑으로 교환할 수가 있어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.058,
                "end": 54.832
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 재고들을 무의미하게 전부 다 쓰는 게 아니라 미리미리 모아두셔야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.842,
                "end": 60.388
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 주스나 인삼이나 이런 케이크 다 토핑 조각으로 교환될 수 있는 재고들이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.398,
                "end": 66.828
            },
            {
                "speaker_id": "1",
                "transcription": "그렇다고 해서 특정 재고만 모아두는 게 아니라 골고루 전부 다 잘 모아둬야 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 66.838,
                "end": 72.591
            },
            {
                "speaker_id": "1",
                "transcription": "왜냐면 길드 무역에서 교환할 때 특정 재화가 부족하면 코인 소모를 통해서 새로고침 할 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 72.601,
                "end": 79.383
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 하면은 코인 부족한 분들한텐 너무나 손해가 크고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.393,
                "end": 83.415
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 지금부터라도 대무역 시대에 재고를 낭비하지 말고 저는 쭉 재고를 모으는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 83.425,
                "end": 91.281
            },
            {
                "speaker_id": "1",
                "transcription": "당연히 대무역 시대에서 받을 수 있는 어 납품 점수에 따른 보상 여기까지는 전부 다 받으셔야 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 91.291,
                "end": 96.781
            },
            {
                "speaker_id": "1",
                "transcription": "제가 말하는 건 여러분들이 보유한 재고를 너무나 과하게 투자하지 말라는 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 96.791,
                "end": 102.636
            },
            {
                "speaker_id": "1",
                "transcription": "단순히 보이는 크리스탈 보상도 좋아 보이지만 무리하게 해서 상위 재고 전부 다 납품해서 비워버리면 길드 무역 때 정말 큰 후회를 하게 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 102.646,
                "end": 112.791
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 또 하나 @이름1님 전 그래도 대무역 보상을 꼭 받아야 되겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 112.801,
                "end": 117.001
            },
            {
                "speaker_id": "1",
                "transcription": "하시는 분들은 평일에 교환하지 마세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 117.011,
                "end": 119.202
            },
            {
                "speaker_id": "1",
                "transcription": "평일에 하면 20퍼센트 코인 보너스가 없기 때문에 주말에 버프 받아서 교환하시면 되고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 119.212,
                "end": 125.278
            },
            {
                "speaker_id": "1",
                "transcription": "가급적이면 제가 추천드리는 거는 상위 재고는 납품하면은 물론 대무역 점수는 올라가지만 나중에 길드 무역을 위해서 정말 많이 모아두는 걸 추천드립니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 125.288,
                "end": 137.432
            },
            {
                "speaker_id": "1",
                "transcription": "자 쿠키런 킹덤은 가장 중요한 게 토핑 게임이에요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 137.442,
                "end": 140.883
            },
            {
                "speaker_id": "1",
                "transcription": "자 최종적으로 토핑이 강해야 내 스펙도 정말 세지기 때문에 제가 항상 1순위로 강조하는 게 토핑 조각, 토핑 스펙 높여라 이건데 단순히 크리스탈 보상에 눈이 멀어 가지고 재고를 다 쓰면은 길드 무역 때 진짜 너무나 후회하는 분들을 많이 봐서 그렇습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 140.893,
                "end": 159.177
            },
            {
                "speaker_id": "1",
                "transcription": "물론 그렇다고 해서 길드 무역 대충 하라는 건 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 159.187,
                "end": 162.544
            },
            {
                "speaker_id": "1",
                "transcription": "소원 나무 일일 미션 그리고 열차 열심히 돌려주시고 재고 좀 넘치는 거 위주로 교환을 해 주시고 이런 작업을 해서 받을 수 있을 만큼은 받아주는 게 좋고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 162.554,
                "end": 173.552
            },
            {
                "speaker_id": "1",
                "transcription": "다만 너무나 과하게 하실 필요는 절대 없다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 173.562,
                "end": 177.652
            },
            {
                "speaker_id": "1",
                "transcription": "재고 생산 지금부터라도 열심히 해서 재고 쌓아주시면 나중에 길드 무역 때 정말 @이름1님 말 듣고 쌓아두길 잘했다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 177.662,
                "end": 186.442
            },
            {
                "speaker_id": "1",
                "transcription": "이 소리 바로 나올 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 186.452,
                "end": 188.108
            },
            {
                "speaker_id": "1",
                "transcription": "제가 재고 쌓는 방법을 쪼끔 말씀드리면은 자 기본 재고가 부족해서 요렇게 뭐 10단계까지 업그레이드하시는 분 있는데 그럴 필요는 초반에는 없고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 188.118,
                "end": 198.007
            },
            {
                "speaker_id": "1",
                "transcription": "물론 다른 거 다 업그레이드하고 여유가 있는 분들은 10단계 찍어줘도 뭐 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 198.017,
                "end": 202.849
            },
            {
                "speaker_id": "1",
                "transcription": "자 기본 재료가 없으면은 이 첫 번째 단계로 하는 게 중요해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 202.859,
                "end": 205.948
            },
            {
                "speaker_id": "1",
                "transcription": "자 첫 번째 단계 이득 보는 거는 나무, 젤리빈, 각설탕 자 여러분 비스킷 풍차는 두 번째 단계가 확실히 더 이득입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 205.958,
                "end": 213.312
            },
            {
                "speaker_id": "1",
                "transcription": "자 요러고 젤리베리도 두 번째 자 우유는 첫 번째 단계가 이득이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 213.322,
                "end": 217.687
            },
            {
                "speaker_id": "1",
                "transcription": "자 솜사탕도 첫 번째가 이득이에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 217.697,
                "end": 219.654
            },
            {
                "speaker_id": "1",
                "transcription": "자 중요한 거는 여러분들 게임 접속했을 때 자 귀찮더라도 효율이 좋은 단계를 집중적으로 생산을 해 주시고 그러고 장기적으로 시간을 비울 때는 두 번째, 세 번째 단계로 돌려주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 219.664,
                "end": 231.865
            },
            {
                "speaker_id": "1",
                "transcription": "자 특히나 이런 잼가게 같은 경우에 귀찮아서 뒤쪽으로 많이 돌리는 분들 많죠.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 231.875,
                "end": 237.474
            },
            {
                "speaker_id": "1",
                "transcription": "접속했을 때는 앞쪽 그러고 쪼끔 시간 비워둘 때는 뒤쪽 자 나머지도 똑같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 237.484,
                "end": 243.512
            },
            {
                "speaker_id": "1",
                "transcription": "이 원칙만 지키시면은 재고는 쌓일 수밖에 없어요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 243.522,
                "end": 246.815
            },
            {
                "speaker_id": "1",
                "transcription": "보통 많이 재고가 비는 분들은 어 접속해서도 귀찮아서 뒤쪽 장기적으로 비울 때도 뒤쪽 이러다 보면 은 앞쪽 재고가 빵꾸가 나는 경우가 많기 때문에 자 또 하나 테크를 올려야 되나요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 246.825,
                "end": 258.902
            },
            {
                "speaker_id": "1",
                "transcription": "아까 말씀드렸듯이 테크를 올려두면은 어 대무역 점수도 증가되고 또는 길드 무역 때도 토핑 조각 얻는 데에 정말 좋기 때문에 최대한 많이 늘리면서 테크도 높여주시면 좋다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 258.912,
                "end": 271.038
            },
            {
                "speaker_id": "1",
                "transcription": "물론 테크 단계는 무조건 뚫어놓으라는 게 아니에요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 271.048,
                "end": 274.436
            },
            {
                "speaker_id": "1",
                "transcription": "앞에 재고가 어느 정도 여유가 있을 때 한 삼사십 개 정도 쌓아뒀을 때 테크를 올리시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 274.446,
                "end": 280.223
            },
            {
                "speaker_id": "1",
                "transcription": "재고가 앞에도 다 부족한데 테크만 무조건 올린다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 280.233,
                "end": 283.187
            },
            {
                "speaker_id": "1",
                "transcription": "이러면은 어 열차도 멈추고 스트레스를 많이 받기 때문에 최대한 앞에 재고 많이 쌓아두고 뭐 여유될 때 테크 올려주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 283.197,
                "end": 290.824
            },
            {
                "speaker_id": "1",
                "transcription": "자 무역수에 배 보내는 것도 무조건 마지막 단계까지 꽉꽉 채워서 보내는 게 좋냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 290.834,
                "end": 296.413
            },
            {
                "speaker_id": "1",
                "transcription": "이것도 자기 재고에 따라 다르고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 296.423,
                "end": 298.566
            },
            {
                "speaker_id": "1",
                "transcription": "재고가 여유 있는 분들은 최대한 높게 점수 채워서 보내는 게 유리하지만 열차가 막히고 재고가 부족한 분들은 상황에 맞게 적당히 보내주시는 걸 추천드려요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 298.576,
                "end": 310.533
            }
        ]
    },
