        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 아레나 샤벳 상어를 이용한 공속덱 하나 추천해 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.538
            },
            {
                "speaker_id": "1",
                "transcription": "자 승률이 엄청나게 좋고 지금 현재 아레나 상위권에서도 거의 다 먹히는 조합 같아서 자 세팅을 알려드리면 휘낭시에 같은 경우에는 올클 요렇게 세팅해 주시고 공속 같은 경우에는 망토는 흑당맛 쿠키랑 크림유니콘한테 공속이 적용되면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.548,
                "end": 20.582
            },
            {
                "speaker_id": "1",
                "transcription": "흑당은 올라즈 공속 같은 경우에는 망토보물이랑 쓸 때 흑당은 5.3퍼센트 이상 되면은 스킬을 쓸 때 여덟 발에서 아홉 발로 한발 더 추가가 되기 때문에 굳이 신경 써서 맞출 때 5.3퍼센트 이상 맞춘다고 그렇게 생각해서 세팅해 주시면 좋고 피감 좀 더 신경 써주면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 20.592,
                "end": 40.268
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 에클레어 같은 경우에는 피감 높게 그다음 쿨타임은 저는 쿨이 부족해서 저는 8퍼센트 근처 안 되겠습니다 하시는 분들은 그냥 피감만 신경을 좀 더 써주고 얘는 가능한 대로 최대한 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 40.264,
                "end": 52.580
            },
            {
                "speaker_id": "1",
                "transcription": "2퍼센트 3퍼센트 된다고 해서 무조건 안 된다 못 쓴다가 아니라 피감 신경 쓰고 쿨은 높으면 높을수록 좋은 거니까 그거 알아두시고 샤벳 상어도 마찬가지 피감이랑 쿨 이렇게 세팅해주시는데 쿨타임이 아마 부족한 사람도 있을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.590,
                "end": 67.846
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 따라가려고 쿨 주면 좋을 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 67.856,
                "end": 71.032
            },
            {
                "speaker_id": "1",
                "transcription": "피감 44퍼인데 어느 정도 잘 버티는 것 같아요 그래도 나름.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 71.040,
                "end": 74.348
            },
            {
                "speaker_id": "1",
                "transcription": "크림 유니콘이 좀 중요한데 얘는 당연히 망토 보물 받아야 되니까 공격속도가 팀 내에 두 번째 안에 쿨타임은 높으면 높을수록 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 74.348,
                "end": 82.098
            },
            {
                "speaker_id": "1",
                "transcription": "피감도 높으면 높을수록 좋은데 이거 크림 유니콘 같은 경우에는 아몬드 4개에다가 쿨 섞어서 쿨 더 높게 세팅해서 쓰는 분도 있다는 점 이게 무조건 정답이 아니라는 점은 참고해 주시면 될 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 82.108,
                "end": 94.972
            },
            {
                "speaker_id": "1",
                "transcription": "자 이거 한번 세팅 유용한 덱 가보도록 할게요.",
