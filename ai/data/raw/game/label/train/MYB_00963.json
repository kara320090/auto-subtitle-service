        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 연동 보상으로 1단계 미션 달성 자 2단계 달성 3단계 달성 자 미션을 달성하면은 보상을 받을 수 있고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 8.379
            },
            {
                "speaker_id": "1",
                "transcription": "자 요렇게 받을 수가 있고요 자 우주선을 요렇게 설치할 수 있고 레벨업을 하려면 네 요렇게 아이템이 필요합니다 우주선 수리 키트",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.389,
                "end": 18.265
            },
            {
                "speaker_id": "1",
                "transcription": "지구 복원 단계 3단계 달성 네 빠르게 달성 자 요렇게 스킨도 받을 수 있다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 18.265,
                "end": 24.697
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들 무지개 큐브 많이 부족하시죠 이번에 새롭게 나온 전설 스킨 뽑기 블랙펄 신규 레전드 스킨이 나왔습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.707,
                "end": 32.559
            },
            {
                "speaker_id": "1",
                "transcription": "자 여러분들한테 이벤트로 무지개 큐브 3000개를 무료로 드리고 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 32.569,
                "end": 37.172
            },
            {
                "speaker_id": "1",
                "transcription": "자 무지개 큐브 3000개는 데브시스터즈에서 파는 가격으로 거의 2만 5000원 가격에 해당하는 가격인데 제가 무료로 나눠드리고 있는데 받는 방법은 정말 간단합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 37.182,
                "end": 48.872
            },
            {
                "speaker_id": "1",
                "transcription": "자 고정 댓글에 있는 플레이오 앱을 다운로드 받으시고 우측 하단에 있는 프로필을 누르시고 우측 상단에 톱니바퀴를 누르면 시크릿 코드를 입력하는 데가 나옵니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 48.882,
                "end": 58.956
            },
            {
                "speaker_id": "1",
                "transcription": "여기에 플오ND러너를 입력해 주시면 끝입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 58.966,
                "end": 63.381
            },
            {
                "speaker_id": "1",
                "transcription": "자 플레이오 앱은 도대체 어떤걸까 자 여러분들이 게임만 해도 자동으로 쌓이는 잼을 가지고 자 상점에서 원하는 기프트 카드나 문화상품권으로 교환이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.391,
                "end": 74.724
            },
            {
                "speaker_id": "1",
                "transcription": "자 게임하는데 여러분들한테 따로 광고가 뜨지도 않고요 방해하는 요소가 단 하나도 없습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 74.734,
                "end": 80.843
            },
            {
                "speaker_id": "1",
                "transcription": "자 시크릿 코드 입력하신 분들만 제가 라이브 방송에서 랜덤으로 추첨을 통해서 드리고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 80.853,
                "end": 86.597
            },
            {
                "speaker_id": "1",
                "transcription": "자세한 이벤트 확인은 고정 댓글을 확인해 주세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 86.607,
                "end": 89.512
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 미션을 달성하고 나면 레벨업이 가능합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 89.522,
                "end": 92.872
            },
            {
                "speaker_id": "1",
                "transcription": "자 레벨업해서 별사탕을 얻을 수 있는 랜드마크 자 이렇게 10레벨까지 반파된 우주선",
                "sound_type": [
                    2,
                    3
                ],
                "start": 92.882,
                "end": 98.873
            },
            {
                "speaker_id": "1",
                "transcription": "별사탕받는 랜드마크 공짜로 받을 수 있고 자 쿠키를 이렇게 태우면 비행기가 타고 날라간다 네 이런 모습을 볼 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 98.883,
                "end": 108.787
            },
            {
                "speaker_id": "1",
                "transcription": "자 이렇게 브릭시티 하우스도 이렇게 따로 바꿀 수가 있다 자여러분들 미션을 지구 복원 10단계 15단계까지 받아야 놀이 테마까지 받을 수가 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 108.787,
                "end": 119.464
            },
            {
                "speaker_id": "1",
                "transcription": "자 지구 복원 단계 15단계는 짧은 시간 동안 금방할 수 있는 건 아니예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 119.474,
                "end": 124.255
            },
            {
                "speaker_id": "1",
                "transcription": "저도 5단계까지 올리는데 생각보다 오랜 시간을 걸렸거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 124.265,
                "end": 128.476
            },
            {
                "speaker_id": "1",
                "transcription": "15단계까지 하시려면 브릭시티 다운 받고 좀 오랜 시간을 투자를 하셔야 되기 때문에 천천히 올려주시면 될 것 같고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 128.486,
                "end": 135.952
            },
            {
                "speaker_id": "1",
                "transcription": "자 최종적으로 쿠키성 보상 화면에 보이는 것처럼 한정 스킨을 받을 수 있고 자 그리고 한정 꾸미기템도 여러분들 오픈할 수 있으니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 135.962,
                "end": 144.812
            },
            {
                "speaker_id": "1",
                "transcription": "혹시나 귀찮더라도 15단계까지라도 여러분들 하셔서 꼭 받으시길 바라고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 144.815,
                "end": 150.431
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 크리스탈 쿠폰 3000개도 아직 사용 가능한 거 있습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 150.441,
                "end": 154.648
            },
            {
                "speaker_id": "1",
                "transcription": "아직 사용 안 한분들 화면에 보이는 크리스탈 쿠폰 입력해 보시고요 제가 준비한 무지개 큐브 이벤트도 고정 댓글에 있으니까 고정 댓글 확인해 보시기 바랍니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 154.658,
                "end": 166.604
            },
            {
                "speaker_id": "1",
                "transcription": "자 브릭시티 런칭 기간 이벤트 관련된 소식은 여기서 마치도록 할게요 감사합니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 166.614,
                "end": 174.266
            }
        ]
    },
    "summary": "연동 보상으로 미션을 달성하면 보상을 받을 수 있고 15단계까지 하려면 브릭시티 받고 시간이 오래 걸리지만 귀찮더라도 천천히 꼭 다 하셔서 보상 받으시면 좋겠다.",
