        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "와 야 그래도 10억은 그냥 우습게 넘네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 4.769
            },
            {
                "speaker_id": "1",
                "transcription": "솔직히 버프가 살짝 아쉽긴 했는데 메인이 2개가 있었고 하나가 조금 아쉬웠지만 10억이 그냥 이렇게 넘는다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.779,
                "end": 11.337
            },
            {
                "speaker_id": "1",
                "transcription": "여기 좀 더 높은 걸로 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.347,
                "end": 13.070
            },
            {
                "speaker_id": "1",
                "transcription": "지금 24등 된 것도 빌드 똑같이 했고 버프가 조금 더 좋았을 때 됐거든요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.080,
                "end": 19.092
            },
            {
                "speaker_id": "1",
                "transcription": "다시 한번 보여드릴게요 버프 좀 좋은 걸로 가져가서.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.102,
                "end": 21.450
            },
            {
                "speaker_id": "1",
                "transcription": "야 이게 나오네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.460,
                "end": 23.844
            },
            {
                "speaker_id": "1",
                "transcription": "여러분들 종결 보여드릴게요 내가 지금 계속 코인을 쓰는 이유.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 23.854,
                "end": 27.520
            },
            {
                "speaker_id": "1",
                "transcription": "와 이거 나오면 그냥 그 판 여러분들 진짜 무조건 해야돼.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 27.530,
                "end": 31.392
            },
            {
                "speaker_id": "1",
                "transcription": "제가 나온 거 아니고 시청자분이 나 나온 거 와 도트딜 없이 이거 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 31.402,
                "end": 36.520
            },
            {
                "speaker_id": "1",
                "transcription": "야 도트딜 차이 심하네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 36.530,
                "end": 38.701
            },
            {
                "speaker_id": "1",
                "transcription": "아 그냥 여러분들 그냥 도트딜이 짱이네.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 38.711,
                "end": 42.274
            },
            {
                "speaker_id": "1",
                "transcription": "도트 미만 잡이야 진짜.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 42.284,
                "end": 47.083
            }
        ]
    },
    "summary": "버프가 아쉽긴 했지만 10억이 그냥 넘어서 좀 더 높은 걸로 가보면 도트딜이 최고다.",
