        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "그런 게 다 있어.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 1.675
            },
            {
                "speaker_id": "1",
                "transcription": "정지 통화하고 싶 통과하고 싶다면 장로님의 허락을 받도록 그래 그래 이것 좀 봐줄래?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 1.685,
                "end": 7.142
            },
            {
                "speaker_id": "1",
                "transcription": "반지를 식별하였습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 7.152,
                "end": 8.946
            },
            {
                "speaker_id": "1",
                "transcription": "무엇을 도와드릴까요 장로님?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 8.956,
                "end": 10.929
            },
            {
                "speaker_id": "1",
                "transcription": "지금 이것들이 너에게 장로라고 한 건가?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.939,
                "end": 13.732
            },
            {
                "speaker_id": "1",
                "transcription": "반지에 내재된 마력에만 반응하도록 제작된 듯 보입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.742,
                "end": 17.489
            },
            {
                "speaker_id": "1",
                "transcription": "사람을 분간하는 능력조차 없는 낮은 수준의 싸구려군요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.499,
                "end": 21.166
            },
            {
                "speaker_id": "1",
                "transcription": "덕분에 반지만 있으면 아무런 소란 없이 통과할 수 있으니까 된 거 아니야?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 21.176,
                "end": 25.564
            },
            {
                "speaker_id": "1",
                "transcription": "그럼 이제 길 좀 터줘 좀 지나가게 이 마을은 이제 지긋지긋하다고 그 부분 만큼만 동감입니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.574,
                "end": 33.733
            }
        ]
    },
    "summary": "여성이 반지를 보여주고 통과하는 과정에 대해서 이야기한다.",
