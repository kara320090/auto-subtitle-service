        "term": [
            {
                "speaker_id": "1",
                "transcription": "야 이걸 야 못 버티나 보네.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 2.766
            },
            {
                "speaker_id": "1",
                "transcription": "야 소환텍 이게 어마무시하게 세진 것 같은데?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 2.776,
                "end": 6.278
            },
            {
                "speaker_id": "1",
                "transcription": "슈퍼 소환덱 되는 느낌이야.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 6.288,
                "end": 8.399
            },
            {
                "speaker_id": "1",
                "transcription": "상황 정리를 하자면 이 자리에 원래 힐러 자리였거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.409,
                "end": 11.555
            },
            {
                "speaker_id": "1",
                "transcription": "근데 힐러가 소환덱의 약간 유지력을 강하게 만드는 주는 역할이었는데 그거 살짝 버리고 얘가 체력을 좀 보완해 주는 거예요. 이 두 개로",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 11.565,
                "end": 20.288
            },
            {
                "speaker_id": "1",
                "transcription": "그러면서 얘가 공격력하고 치명타 확률 올려주고 오이스터가 치명타 확률하고 치명타 피해량 증가되니까 뚫려 버리네.",
                "sound_type": [
                    2,
