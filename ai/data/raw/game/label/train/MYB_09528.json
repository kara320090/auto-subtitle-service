                ],
                "start": 0.000,
                "end": 4.707
            },
            {
                "speaker_id": "2",
                "transcription": "아 아 그래도 전역은 시켜주겠지.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 4.717,
                "end": 8.740
            },
            {
                "speaker_id": "2",
                "transcription": "전역 안 시켜주고 눈 치우라고 하면 안 되긴 하지 그죠?",
                "sound_type": [
                    2,
                    3
