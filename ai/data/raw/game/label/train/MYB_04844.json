    "video": {
        "speakers_info": [
            {
                "speaker_id": "1",
                "age": "30대",
                "gender": "남성"
            }
        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 한번 바로 아레나에서 보여 드리도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 3.187
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 아레나에서도 하고 제 친구 목록에서도 랭커분들 어 제가 테스트를 다 해서 어느 정도의 승률이 나오는지 제가 비교를 해 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 3.197,
                "end": 14.108
            },
            {
                "speaker_id": "1",
                "transcription": "자 우유맛 쿠키가 도대체 왜 갑자기 아레나에서 왜 쓰이냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.118,
                "end": 18.239
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 왜 뱀파이어한테 특별히 좋냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 18.249,
                "end": 21.086
            },
            {
                "speaker_id": "1",
                "transcription": "뱀파이어맛 쿠키가 스킬을 쓰게 되면은 우유가 도발 상태가 되면 어 이 후방에 들어갈 딜이 우유맛 쿠키가 대신 맞아 줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 21.096,
                "end": 29.710
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 뱀파가 바보가 돼요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 29.720,
                "end": 32.391
            },
            {
                "speaker_id": "1",
                "transcription": "네 그걸 이용해서 우유맛 쿠키덱이 쓰이고 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.401,
                "end": 36.325
            },
            {
                "speaker_id": "1",
                "transcription": "한 뱀파 딜 한 두세 번 우유가 대신 맞기 때문에 뒤쪽에 쿠키들 생존력을 높여 줄 수 있고",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.335,
                "end": 43.905
            },
            {
                "speaker_id": "1",
                "transcription": "거기다가 부활 같은 경우에도 최대한 뒤쪽 쿠키가 맞아서 즉사하는 걸 방지해서 높은 승률로 가져갈 수 있다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 43.915,
                "end": 51.299
            },
            {
                "speaker_id": "1",
                "transcription": "뭐 고런 컨셉으로 알 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 51.309,
                "end": 53.539
            },
            {
                "speaker_id": "1",
                "transcription": "자 이 덱 같은 경우에는 자막에 보이는 분들이 어 제작한 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 53.549,
                "end": 57.406
            },
            {
                "speaker_id": "1",
                "transcription": "공속 망토랑 증표 요 덱도 가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.416,
                "end": 60.954
            },
            {
                "speaker_id": "1",
                "transcription": "자 요것도 들어가면은 지금 보면은 뱀파 공속 증표 공속덱",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 60.964,
                "end": 68.167
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱 자체가 아직도 방덱으로 많이 보이는데 여러분들 이제 하나 좀 세팅으로 하실 분들은 이렇게 해서 쓰면은 좋을 것 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.177,
                "end": 78.866
            }
        ]
    },
    "summary": "남자는 아레나에서도 하고 친구 목록에서도 랭커분들 테스트를 다 해서 승률을 비교해 보겠다고 하고 아레나에서 우유맛 쿠키덱의 컨셉은 뱀파이어맛 쿠키가 스킬을 쓰게 되면 우유가 도발 상태가 되면 후방에 들어갈 딜이 우유맛 쿠키가 대신 맞아 줘서 뱀파가 바보가 된다고 하고 뱀파 딜 두세 번 우유가 대신 맞기 때문에 뒤쪽 쿠키들 생존력을 높여 주고 부활 같은 경우에도 뒤쪽 쿠키가 맞아서 즉사하는 걸 방지해서 높은 승률로 가져갈 수 있다고 한다.",
