        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "네 깔끔하게 이기는 요런 게 정확히 어 의도한 구조입니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 4.724
            },
            {
                "speaker_id": "1",
                "transcription": "네 소르베가 부활하면서 딜러 1명씩 용과도 죽여 주면서 하나씩 죽여 나가는 그림 자 이 실론나이트 덱도 지금 어마무시하게 많이 쓰고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 4.734,
                "end": 14.735
            },
            {
                "speaker_id": "1",
                "transcription": "요 덱도 너무 좋게 쓰고 있고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.745,
                "end": 16.730
            },
            {
                "speaker_id": "1",
                "transcription": "러너 님 무공비 대신에 깃털에서 더 좋지 않나 이거는 제가 봤을 때 어떤 게 더 좋냐는 그냥 흐름의 차이예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.740,
                "end": 23.174
            },
            {
                "speaker_id": "1",
                "transcription": "어떤 구조로 흘러가냐.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.184,
                "end": 24.929
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 무공비 같은 경우에는 게임 구도가 죽지 않고 그냥 단단하게 끝까지 1분 지나서까지 생존하면서 소르베가 스킬 쓰면서 가는 구조로 가는 게 무공비의 특징이고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 24.939,
                "end": 35.799
            },
            {
                "speaker_id": "1",
                "transcription": "자 그리고 깃털 같은 경우에는 1분대에 상대 브레스를 맞고 이 두 쿠키가 전부 다 죽어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 35.809,
                "end": 42.216
            },
            {
                "speaker_id": "1",
                "transcription": "그러고 나서 소르베가 부활하고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.226,
                "end": 44.800
            },
            {
                "speaker_id": "1",
                "transcription": "소르베의 스킬을 쓰고 락스타가 죽고 나머지의 쿠키들의 피를 다 채워줍니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 44.810,
                "end": 50.476
            },
            {
                "speaker_id": "1",
                "transcription": "그래서 소르베 스킬 쓰고 상대 앞에 탱커나 딜러나 용과 쿠키를 죽이면서 이기는 그림으로 갑니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 50.486,
                "end": 57.462
            },
            {
                "speaker_id": "1",
                "transcription": "자 나머지 요 덱 리뷰까지 가 보도록 하겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 57.472,
                "end": 61.280
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 샤이닝을 라즈로 쓰는 게 그나마 승률이 좋았고요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 61.290,
                "end": 64.536
            },
            {
                "speaker_id": "1",
                "transcription": "어 초월이 높아야지만 승률이 좀 더 나오는 것 같습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 64.546,
                "end": 68.126
            },
            {
                "speaker_id": "1",
                "transcription": "확실히 호르라기를 받지 않으면은 어 쉽게 죽기 때문에 용과나 다른 딜러 3마리가 같이 끼어 있을 때 호루라기를 받지 못하는 상황에서는 쓰기 애매하다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 68.136,
                "end": 77.841
            },
            {
                "speaker_id": "1",
                "transcription": "투 힐 조합에서 네 요렇게 써야 될 것 같아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 77.851,
                "end": 82.400
            }
        ]
    },
    "summary": "실로나이트와 소르베 덱을 잘 활용한다고 하고 깃털을 사용하는 것에 대해서 설명하고 있습니다.",
