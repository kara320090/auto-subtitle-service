                "start": 1.927,
                "end": 5.062
            },
            {
                "speaker_id": "1",
                "transcription": "일단 확실한 거는 바다요정 키운 사람한테는 무조건 좋은 거는 확실해요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 5.072,
                "end": 9.315
            },
            {
                "speaker_id": "1",
                "transcription": "바요 키운 사람이 많이 없을 테니까 스타더스트랑도 시너지 좋은지 요걸로도 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 9.325,
                "end": 14.718
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 일단 무난하게 사람들이 많이 하는 4 애플젤리 1 쿨 세팅으로 갈게요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 14.728,
                "end": 19.293
            },
            {
                "speaker_id": "1",
                "transcription": "봐야 될 것 같고요.",
