        "term": [
            {
                "speaker_id": "1",
                "transcription": "아 진짜 갈수록 주 무슨 막 알 수가 없네?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 2.919
            },
            {
                "speaker_id": "1",
                "transcription": "그리고 웃기 거는 저런 장면이 나오잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 2.929,
                "end": 6.275
            },
            {
                "speaker_id": "1",
                "transcription": "그러면은 화면 보느라고 내용을 다시 보러 가야 돼요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 6.285,
                "end": 11.316
            },
            {
                "speaker_id": "1",
                "transcription": "후고 덕분에 잠깐 정신 차리긴 했는데 음",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.326,
                "end": 17.245
            },
            {
                "speaker_id": "1",
                "transcription": "내용을 하마터면 놓칠 뻔 했잖아.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 17.255,
                "end": 22.198
            },
            {
                "speaker_id": "1",
                "transcription": "아 예쁘다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.208,
                "end": 27.178
            },
            {
                "speaker_id": "1",
                "transcription": "아 청순 미인이 역시 최고야.",
                "sound_type": [
