        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "확실히 정말 요 덱이 제가 여러 덱을 세팅해 보면서 해봤지만 안정성 면에서 좋습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 0.000,
                "end": 16.789
            },
            {
                "speaker_id": "1",
                "transcription": "보통 예언자덱이라고 하면은 퓨바 대신에 여기에 블랙펄 넣어가지고 좀 더 공격적으로 세팅할 수도 있거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 16.799,
                "end": 23.918
            },
            {
                "speaker_id": "1",
                "transcription": "그렇게 안 하고 안전하게 최대한 아군을 보호하면서 모노클까지 있는 요 덱이 좋은 거 같애요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 23.928,
                "end": 32.517
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 여러분들이 지금 중요한 건 이거잖아요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 32.527,
                "end": 34.755
            },
            {
                "speaker_id": "1",
                "transcription": "도대체 아레나 세팅 어떻게 되냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 34.765,
                "end": 36.545
            },
            {
                "speaker_id": "1",
                "transcription": "승률 좋은 덱이 뭐냐?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 36.555,
                "end": 38.565
            },
            {
                "speaker_id": "1",
                "transcription": "아레나 좀 대충해 보신 분들 알겠지만 대충 세팅하면 계속 연패합니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 38.575,
                "end": 42.929
            },
            {
                "speaker_id": "1",
                "transcription": "저도 이거 세팅하기 전에는 대충 그냥 피감 넣고 쿨 그냥 대충 세팅해서 할 때는 거의 패배를 엄청 많이 했어요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 42.939,
                "end": 52.597
            },
            {
                "speaker_id": "1",
                "transcription": "근데 그렇게 하지 마시고 어느 정도 세팅되는 거 따라 하시는 게 여러분들 좀 티켓도 아끼면서 좋을 거예요.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 52.607,
                "end": 62.523
            },
            {
                "speaker_id": "1",
                "transcription": "세팅 되어있는 덱을 따라 하는 게 확실히 시간도 아끼면서 여러분들이 좀 좋게 아레나 스트레스 안 받을 수 있습니다.",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 62.533,
                "end": 74.666
            }
        ]
    },
    "summary": "남성이 소개하는 덱은 안정성에서 좋고 아레나 세팅은 대충 하면 연패함으로 어느 정도 세팅되는 거 따라 하면 티켓과 시간을 아끼고 좋게 아레나를 할 수 있다고 설명한다.",
