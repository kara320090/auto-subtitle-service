        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "이거 혼자도 가능하네요 굳이 석류 없어도 뱀파 혼자 그냥 얘 그냥 하나만 잘 키워도 와.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 10.751
            },
            {
                "speaker_id": "1",
                "transcription": "장관이네요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 10.761,
                "end": 11.714
            },
            {
                "speaker_id": "1",
                "transcription": "아무튼 엄청난 딜량이 돌아왔고 뭐 솔직히 이번 리뷰에 가장 하이라이트는 토벌이거든요?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 11.724,
                "end": 19.574
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 먼저 리뷰 보여드리겠습니다 아레나는 뭐 쓰이는 덱도 분명히 있을 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 19.584,
                "end": 24.315
            },
            {
                "speaker_id": "1",
                "transcription": "그런데 제일 중요한 건 여러분들이 토벌 덱에서 쓰이냐 그게 중요하죠?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 24.325,
                "end": 28.108
            },
            {
                "speaker_id": "1",
                "transcription": "자 토벌 덱 세팅 일단 간단하게 보여드리면은 다크 초코는 전에 쓰던 대로 그대로 가시면 되고 아포가토는 좀 바뀐 게 쿨타임만 5퍼센트대 맞춰주면 됩니다 공속 필요 없이 쿨만 5퍼센트.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.118,
                "end": 40.223
            },
            {
                "speaker_id": "1",
                "transcription": "에클레어 같은 경우에는 그냥 3.2에서 3.8 사이 쿨, 공속은 5퍼센트 줬고 그다음에 목화는 29퍼센트 이상.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.233,
                "end": 47.439
            },
            {
                "speaker_id": "1",
                "transcription": "그다음 뱀파는 쿨 8퍼센트 이상 그리고 나머지 공, 치 줬는데 지금 리뷰 때는 수동 컨을 보여드릴 거예요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 47.449,
                "end": 54.618
            },
            {
                "speaker_id": "1",
                "transcription": "자동 컨도 이미 빌드가 나왔지만 리뷰니까 여러분들이 중요한 거는 뱀파가 이제 쓰이냐 안 쓰이냐가 중요하잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 54.628,
                "end": 60.850
            },
            {
                "speaker_id": "1",
                "transcription": "그거 위해서 리뷰로 보여드리겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 60.860,
                "end": 63.183
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 이것도 시작할 때 에클레어 요 모서리.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 63.193,
                "end": 69.000
            }
        ]
    },
    "summary": "제일 중요한 건 토벌 덱에서 뱀파가 쓰이는지 안 쓰이는지 궁금할 것이라며 토벌 덱에 대한 간단한 세팅 소개와 함께 수동으로 컨트롤한다고 한다.",
