        "term": [
            {
                "speaker_id": "1",
                "transcription": "쿨 라즈 라즈 쿨쿨 인데 쿨 높여주시고",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 3.342
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱은 세팅을 하나 제대로 세팅 하나 해주시면 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 3.352,
                "end": 8.358
            },
            {
                "speaker_id": "1",
                "transcription": "도넛도 이게 피감이 막 그렇게 엄청나게 요구하지는 않거든요?",
                "sound_type": [
                    2,
                    3,
                    5
                ],
                "start": 8.368,
                "end": 13.456
            },
            {
                "speaker_id": "1",
                "transcription": "얘 신전에 넣으세요 여기에 오목 넣으면 돼요",
                "sound_type": [
                    2,
                    3
                ],
                "start": 13.466,
                "end": 16.674
            },
            {
                "speaker_id": "1",
                "transcription": "10꽉 만 채우면 될 거 같은 데 내가 볼 때 공속덱 세팅 지금 잘 돼 있잖아요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 16.684,
                "end": 22.622
            },
            {
                "speaker_id": "1",
                "transcription": "공속덱 아레나덱을 여기다가 써도 될 거 같은데 공속덱 하나는 이렇게라도 한 번 해보세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.632,
                "end": 28.317
            },
            {
                "speaker_id": "1",
                "transcription": "이거 아까 제가 말한 토핑 올 애플젤리 라즈 라즈 라즈 라즈 해도 그걸 하고 싶은 데 애플젤리가 워낙 없으니까 최대한 맞춰서 해보시고 나는 라즈가 진짜 없다 하시면 얘는 쿨로 가세요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 28.327,
                "end": 40.351
            },
            {
                "speaker_id": "1",
                "transcription": "토벌을 안 하시는구나 지금",
                "sound_type": [
                    2,
                    3
                ],
                "start": 40.361,
                "end": 42.381
            },
            {
                "speaker_id": "1",
                "transcription": "토벌 얼마 나오세요 딜 5000만 진심을 다해서 내가 세팅해도 이거 어차피 아레나나 다른 거 하려면 다 빼야 하는데 저장이 안 돼 있어서 리셋일 거 같거든요?",
                "sound_type": [
