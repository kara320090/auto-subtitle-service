        ],
        "term": [
            {
                "speaker_id": "1",
                "transcription": "자 수호 성전 신조합 자 요렇게 타르트가 들어간 조합이고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 0.000,
                "end": 5.544
            },
            {
                "speaker_id": "1",
                "transcription": "자 일단 영상이 올라가는 시점에서는 아마 인연의 홀이 이제 끝나서 여러분들 더 이상 이 버프를 받을 수가 없을 겁니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 5.554,
                "end": 14.781
            },
            {
                "speaker_id": "1",
                "transcription": "그래도 저 버프를 받지 못해서 앞으로 수호 성전 메인 조합은 아마 이 조합으로 가지 않을까?",
                "sound_type": [
                    2,
                    3
                ],
                "start": 14.791,
                "end": 22.415
            },
            {
                "speaker_id": "1",
                "transcription": "롱비그 그다음에 망토 시계를 쓰고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 22.425,
                "end": 25.920
            },
            {
                "speaker_id": "1",
                "transcription": "망토 같은 경우에는 라르트랑 오징어 먹물을 받게 됩니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 25.930,
                "end": 29.898
            },
            {
                "speaker_id": "1",
                "transcription": "이렇게 토핑 같은 경우에는 3라즈, 2애플젤리 도넛 같은 경우에는 쿨 높게 높으면 높을수록 좋고 치명 그다음에 공격력 9옵션, 네 그리고 달빛술사도 조심해야 될 거는 공속은 망토 보물이 적용 받지 않게끔 오먹이랑 타르트 보다 낮게 쿨은 어느 정도 있게끔 세팅 해주시고 공치 오먹은 네 3라즈, 2애플젤리 쿨, 공속 높게 저는 공격 더 높게 세팅했는데 치명타 더 높게 세팅하면 좋습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 29.908,
                "end": 59.296
            },
            {
                "speaker_id": "1",
                "transcription": "타르트는 공속 높게 공치 높게 세팅해 주고 슈크림은 57퍼센트 이상 해줘야 맥스로 치명타 확률 다 100퍼센트에 맞춰지기 때문에 9옵션 최대한 신경써서 57 넘겨주시는 게 좋고요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 59.306,
                "end": 73.379
            },
            {
                "speaker_id": "1",
                "transcription": "3라즈, 2애플젤리 쓰이는 분도 있는데 그냥 저는 올 애플젤리로 가도록 하겠습니다.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 73.389,
                "end": 79.808
            },
            {
                "speaker_id": "1",
                "transcription": "최대한 쿨 높여서 저는 가볼게요.",
                "sound_type": [
                    2,
                    3
                ],
                "start": 79.818,
                "end": 82.534
            },
            {
                "speaker_id": "1",
                "transcription": "다음 시즌도 이렇게 될지 모르겠지만 일단 이번 시즌은 이게 가장 좋은 조합이니까",
                "sound_type": [
                    2,
                    3
                ],
                "start": 82.544,
                "end": 89.166
            }
        ]
    },
